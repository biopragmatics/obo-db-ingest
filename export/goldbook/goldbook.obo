property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:16229
name: acute effect
def: "Effect of finite duration occurring rapidly \(usually in the first \\\(\\pu\{24 h\}\\\) or up to \\\(\\pu\{14 d\}\\\)\) following a single dose or short exposure to a substance or radiation."
property_value: mito:isMentionedBy doi:10.1351/pac200779091583
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:16230
name: acute exposure
def: "Exposure of short duration."
