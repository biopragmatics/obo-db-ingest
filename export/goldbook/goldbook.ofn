AnnotationAssertion(rdfs:label goldbook:T06269 "template")
AnnotationAssertion(dcterms:description goldbook:T06269 "The nucleic acid single strand that is copied during replication or transcription.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06269 goldbook:R05300)
AnnotationAssertion(rdfs:seeAlso goldbook:T06269 goldbook:T06436)
AnnotationAssertion(mito:isMentionedBy goldbook:T06269 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06269 "current"^^xsd:string)
Declaration(Class(goldbook:T06270))
AnnotationAssertion(rdfs:label goldbook:T06270 "temporary poisoning")
AnnotationAssertion(dcterms:description goldbook:T06270 "Weak and reversible adsorption of a poison, such that removal of the poison from the fluid phase results in restoration of the original catalytic activity.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06270 goldbook:A00155)
AnnotationAssertion(rdfs:seeAlso goldbook:T06270 goldbook:P04706)
AnnotationAssertion(mito:isMentionedBy goldbook:T06270 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06270 "current"^^xsd:string)
