    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10354">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder characterized by the complete or partial absence of pigment in the skin, hair and eyes, due to an absence of or defect in tyrosinase, a copper-containing enzyme involved in the production of melanin.</dcterms:description>
