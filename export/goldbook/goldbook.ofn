Declaration(Class(goldbook:E02124))
AnnotationAssertion(rdfs:label goldbook:E02124 "enols")
AnnotationAssertion(dcterms:description goldbook:E02124 "Alkenols; the term refers specifically to vinylic alcohols, which have the structure $\\ce{HOCR'=CR2}$. Enols are tautomeric with aldehydes ($\\ce{R'} = \\ce{H}$) or ketones ($\\ce{R'\\! eq H}$).")
AnnotationAssertion(rdfs:seeAlso goldbook:E02124 goldbook:A00204)
AnnotationAssertion(rdfs:seeAlso goldbook:E02124 goldbook:A00208)
AnnotationAssertion(rdfs:seeAlso goldbook:E02124 goldbook:K03386)
