Declaration(Class(goldbook:T06287))
AnnotationAssertion(rdfs:label goldbook:T06287 "tetracyclines")
AnnotationAssertion(dcterms:description goldbook:T06287 "A subclass of polyketides having an octahydrotetracene-2-carboxamide skeleton, substituted with many hydroxy and other groups, e.g. chlortetracycline:")
AnnotationAssertion(rdfs:seeAlso goldbook:T06287 goldbook:P04734)
AnnotationAssertion(mito:isMentionedBy goldbook:T06287 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06287 "current"^^xsd:string)
Declaration(Class(goldbook:T06289))
AnnotationAssertion(rdfs:label goldbook:T06289 "tetrahedral intermediate")
AnnotationAssertion(dcterms:description goldbook:T06289 "A reaction intermediate in which the bond arrangement around an initially double-bonded carbon atom (typically a carbonyl carbon atom) has been transformed from trigonal to tetrahedral. For example, aldol in the condensation reaction of acetaldehyde (but most tetrahedral intermediates have a more fleeting existence).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06289 goldbook:C01238)
AnnotationAssertion(rdfs:seeAlso goldbook:T06289 goldbook:I03096)
AnnotationAssertion(mito:isMentionedBy goldbook:T06289 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06289 "current"^^xsd:string)
Declaration(Class(goldbook:T06290))
AnnotationAssertion(rdfs:label goldbook:T06290 "<i>tetrahedro</i>-")
AnnotationAssertion(dcterms:description goldbook:T06290 "An affix used in names to denote four atoms bound into a tetrahedron.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06290 doi:10.1515/pac-2014-0718)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06290 "current"^^xsd:string)
Declaration(Class(goldbook:T06291))
AnnotationAssertion(rdfs:label goldbook:T06291 "tetrapyrroles")
AnnotationAssertion(dcterms:description goldbook:T06291 "Natural pigments containing four pyrrole rings joined by one-carbon units linking position 2 of one pyrrole ring to position 5 of the next. porphyrins are macrocyclic tetrapyrroles. E.g. bilin (a linear tetrapyrrole).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06291 goldbook:P04765)
AnnotationAssertion(mito:isMentionedBy goldbook:T06291 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06291 "current"^^xsd:string)
Declaration(Class(goldbook:T06292))
AnnotationAssertion(rdfs:label goldbook:T06292 "tetraterpenoids")
AnnotationAssertion(dcterms:description goldbook:T06292 "Terpenoids having a $\\ce{C40}$ skeleton.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06292 goldbook:T06279)
AnnotationAssertion(rdfs:seeAlso goldbook:T06292 goldbook:C00857)
AnnotationAssertion(rdfs:seeAlso goldbook:T06292 goldbook:C00858)
AnnotationAssertion(rdfs:seeAlso goldbook:T06292 goldbook:X06697)
AnnotationAssertion(mito:isMentionedBy goldbook:T06292 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06292 "current"^^xsd:string)
Declaration(Class(goldbook:T06293))
AnnotationAssertion(rdfs:label goldbook:T06293 "texture")
AnnotationAssertion(dcterms:description goldbook:T06293 "The detailed geometry of the void space in the particles of a catalyst.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06293 goldbook:C00876)
AnnotationAssertion(mito:isMentionedBy goldbook:T06293 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06293 "current"^^xsd:string)
Declaration(Class(goldbook:T06295))
AnnotationAssertion(rdfs:label goldbook:T06295 "thermal analysis")
AnnotationAssertion(dcterms:description goldbook:T06295 "A group of techniques in which a physical property of a substance and/or its reaction product is measured as a function of temperature while the substance is subjected to a controlled temperature program.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06295 goldbook:E02131)
AnnotationAssertion(rdfs:seeAlso goldbook:T06295 goldbook:P04869)
AnnotationAssertion(mito:isMentionedBy goldbook:T06295 doi:10.1351/pac199466122487)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06295 "current"^^xsd:string)
Declaration(Class(goldbook:T06296))
AnnotationAssertion(rdfs:label goldbook:T06296 "thermal black")
AnnotationAssertion(dcterms:description goldbook:T06296 "A special type of carbon black produced by pyrolysis of gaseous hydrocarbons in a preheated chamber in the absence of air. Thermal black consists of relatively large individual spheres (\\(100{-}500\\ \\rm{nm}\\) diameter) and aggregates of a small number of pseudospherical particles. The preferred alignment of the layer planes is parallel to the surface of the spheres.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06296 goldbook:C00824)
AnnotationAssertion(rdfs:seeAlso goldbook:T06296 goldbook:H02889)
AnnotationAssertion(rdfs:seeAlso goldbook:T06296 goldbook:P04961)
AnnotationAssertion(mito:isMentionedBy goldbook:T06296 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06296 "current"^^xsd:string)
Declaration(Class(goldbook:T06297))
AnnotationAssertion(rdfs:label goldbook:T06297 "thermal column")
AnnotationAssertion(dcterms:description goldbook:T06297 "A large body of moderator, adjacent to or inside a reactor to provide thermal neutrons for experiments.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06297 goldbook:M03961)
AnnotationAssertion(rdfs:seeAlso goldbook:T06297 goldbook:N04239)
AnnotationAssertion(rdfs:seeAlso goldbook:T06297 goldbook:T06307)
AnnotationAssertion(mito:isMentionedBy goldbook:T06297 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06297 "current"^^xsd:string)
Declaration(Class(goldbook:T06300))
AnnotationAssertion(rdfs:label goldbook:T06300 "thermal conductivity detector")
AnnotationAssertion(dcterms:description goldbook:T06300 "In general, two cells arranged in a bridge configuration detect the change in thermal conductivity of the gas at the output of the column. This detector is sensitive to any substance with thermal conductivity different from that of the carrier gas. The lowest detectable limit is between \\(0.5\\) and \\(100\\ \\rm{ppmv}\\). The linear dynamic range is of the order of \\(10^{3}\\). This type of detector is often used for measuring components at relatively high concentrations.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06300 goldbook:B00736)
AnnotationAssertion(rdfs:seeAlso goldbook:T06300 goldbook:C00863)
AnnotationAssertion(rdfs:seeAlso goldbook:T06300 goldbook:T06299)
AnnotationAssertion(mito:isMentionedBy goldbook:T06300 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06300 "current"^^xsd:string)
Declaration(Class(goldbook:T06302))
AnnotationAssertion(rdfs:label goldbook:T06302 "thermal fission")
AnnotationAssertion(dcterms:description goldbook:T06302 "Fission caused by thermal neutrons.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06302 goldbook:N04229)
AnnotationAssertion(rdfs:seeAlso goldbook:T06302 goldbook:T06307)
AnnotationAssertion(mito:isMentionedBy goldbook:T06302 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06302 "current"^^xsd:string)
Declaration(Class(goldbook:T06303))
AnnotationAssertion(rdfs:label goldbook:T06303 "thermal ionization")
AnnotationAssertion(dcterms:description goldbook:T06303 "Takes place when an atom or molecule interacts with a heated surface or is in a gaseous environment at high temperature. Examples of the latter may be a capillary arc plasma, a microwave plasma or an inductively coupled plasma.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06303 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06303 "current"^^xsd:string)
Declaration(Class(goldbook:T06304))
AnnotationAssertion(rdfs:label goldbook:T06304 "thermal lensing")
AnnotationAssertion(dcterms:description goldbook:T06304 "A technique that determines the alteration in the refractive index of a medium as a result of the temperature rise in the path of a laser beam absorbed by the medium. The lens produced (usually divergent) causes a change (usually a decrease) in the irradiance measured along the laser beam axis.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06304 goldbook:L03459)
AnnotationAssertion(rdfs:seeAlso goldbook:T06304 goldbook:P04656)
AnnotationAssertion(rdfs:seeAlso goldbook:T06304 goldbook:R05240)
AnnotationAssertion(mito:isMentionedBy goldbook:T06304 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06304 "current"^^xsd:string)
Declaration(Class(goldbook:T06306))
AnnotationAssertion(rdfs:label goldbook:T06306 "thermally-induced transition")
AnnotationAssertion(dcterms:description goldbook:T06306 "A transition that is induced by a change in temperature.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06306 goldbook:S06062)
AnnotationAssertion(mito:isMentionedBy goldbook:T06306 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06306 "current"^^xsd:string)
Declaration(Class(goldbook:T06307))
AnnotationAssertion(rdfs:label goldbook:T06307 "thermal neutrons")
AnnotationAssertion(dcterms:description goldbook:T06307 "Neutrons in thermal equilibrium with the medium in which they exist, in general at room temperature.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06307 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06307 "current"^^xsd:string)
Declaration(Class(goldbook:T06309))
AnnotationAssertion(rdfs:label goldbook:T06309 "thermoacoustimetry")
AnnotationAssertion(dcterms:description goldbook:T06309 "A technique in which the characteristics of imposed acoustic waves are measured as a function of temperature after passing through a substance (and/or its reaction product(s)) whilst the substance is subjected to a controlled temperature program.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06309 goldbook:P04869)
AnnotationAssertion(mito:isMentionedBy goldbook:T06309 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06309 "current"^^xsd:string)
Declaration(Class(goldbook:T06312))
AnnotationAssertion(rdfs:label goldbook:T06312 "thermochromism")
AnnotationAssertion(dcterms:description goldbook:T06312 "A thermally induced transformation of a molecular structure or of a system (e.g. of a solution), thermally reversible, that produces a spectral change, typically, but not necessarily, of visible colour.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06312 goldbook:T06446)
AnnotationAssertion(rdfs:seeAlso goldbook:T06312 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:T06312 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06312 "current"^^xsd:string)
Declaration(Class(goldbook:T06313))
AnnotationAssertion(rdfs:label goldbook:T06313 "thermocouple")
AnnotationAssertion(dcterms:description goldbook:T06313 "A device based on the thermoelectric effect, by which two junctions between dissimilar conductors (metallic or heavily doped semiconductors) kept at different temperatures generate an electric potential.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06313 goldbook:E01935)
AnnotationAssertion(mito:isMentionedBy goldbook:T06313 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06313 "current"^^xsd:string)
Declaration(Class(goldbook:T06316))
AnnotationAssertion(rdfs:label goldbook:T06316 "thermodynamic control")
AnnotationAssertion(dcterms:description goldbook:T06316 "The term characterizes conditions that lead to reaction products in a proportion governed by the equilibrium constant for their interconversion and/or for the interconversion of reaction intermediates formed in or after the rate-limiting step. (Some workers prefer to describe this phenomenon as 'equilibrium control'.)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06316 "equilibrium control")
AnnotationAssertion(rdfs:seeAlso goldbook:T06316 goldbook:E02177)
AnnotationAssertion(rdfs:seeAlso goldbook:T06316 goldbook:I03096)
AnnotationAssertion(rdfs:seeAlso goldbook:T06316 goldbook:K03398)
AnnotationAssertion(rdfs:seeAlso goldbook:T06316 goldbook:R05140)
AnnotationAssertion(mito:isMentionedBy goldbook:T06316 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06316 "current"^^xsd:string)
Declaration(Class(goldbook:T06319))
AnnotationAssertion(rdfs:label goldbook:T06319 "thermodynamic isotope effect")
AnnotationAssertion(dcterms:description goldbook:T06319 "The effect of isotopic substitution on an equilibrium constant is referred to as a thermodynamic (or equilibrium) isotope effect. For example, the effect of isotopic substitution in reactant A that participates in the equilibrium: \\[\\rm{A}+\\rm{B}\\rightleftharpoons \\rm{C}\\] is the ratio \\(\\frac{K^{\\rm{l}}}{K^{\\rm{h}}}\\) of the equilibrium constant for the reaction in which A contains the light isotope to that in which it contains the heavy isotope. The ratio can be expressed as the equilibrium constant for the isotopic exchange reaction: \\[\\rm{A}^{\\rm{l}}+\\rm{C}^{\\rm{h}}\\rightleftharpoons \\rm{A}^{\\rm{h}}+\\rm{C}^{\\rm{l}}\\] in which reactants such as B that are not isotopically substituted do not appear. The potential energy surfaces of isotopic molecules are identical to a high degree of approximation, so thermodynamic isotope effects can only arise from the effect of isotopic mass on the nuclear motions of the reactants and products, and can be expressed quantitatively in terms of partition function ratios for nuclear motion: \\[\\frac{K^{\\rm{l}}}{K^{\\rm{h}}} = \\frac{(Q_{\\rm{nuc}}^{\\rm{l}}/Q_{\\rm{nuc}}^{\\rm{h}})_{\\rm{C}}}  {(Q_{\\rm{nuc}}^{\\rm{l}}/Q_{\\rm{nuc}}^{\\rm{h}})_{\\rm{A}}}\\] Although the nuclear partition function is a product of the translational, rotational and vibrational partition functions, the isotope effect is determined almost entirely by the last named, specifically by vibrational modes involving motion of isotopically different atoms. In the case of light atoms (i.e. protium vs. deuterium or tritium) at moderate temperatures, the isotope effect is dominated by zero-point energy differences.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06319 "equilibrium isotope effect")
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:D01648)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:E02177)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:I03327)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:I03343)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:I03338)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:P04435)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:P04439)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:P04903)
AnnotationAssertion(rdfs:seeAlso goldbook:T06319 goldbook:T06513)
AnnotationAssertion(mito:isMentionedBy goldbook:T06319 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06319 "current"^^xsd:string)
Declaration(Class(goldbook:T06321))
AnnotationAssertion(rdfs:label goldbook:T06321 "thermodynamic temperature")
AnnotationAssertion(dcterms:description goldbook:T06321 "Base quantity in the system of quantities upon which SI is based.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06321 goldbook:B00609)
AnnotationAssertion(mito:isMentionedBy goldbook:T06321 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06321 "current"^^xsd:string)
Declaration(Class(goldbook:T06322))
AnnotationAssertion(rdfs:label goldbook:T06322 "thermoelectrometry")
AnnotationAssertion(dcterms:description goldbook:T06322 "A technique in which an electrical characteristic of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program. The most common measurements are of resistance, conductance or capacitance.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06322 goldbook:C01243)
AnnotationAssertion(rdfs:seeAlso goldbook:T06322 goldbook:P04869)
AnnotationAssertion(rdfs:seeAlso goldbook:T06322 goldbook:R05315)
AnnotationAssertion(mito:isMentionedBy goldbook:T06322 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06322 "current"^^xsd:string)
Declaration(Class(goldbook:T06324))
AnnotationAssertion(rdfs:label goldbook:T06324 "thermogravimetry")
AnnotationAssertion(dcterms:description goldbook:T06324 "A technique in which the mass of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:T06324 "TG")
AnnotationAssertion(rdfs:seeAlso goldbook:T06324 goldbook:P04869)
AnnotationAssertion(mito:isMentionedBy goldbook:T06324 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06324 "current"^^xsd:string)
Declaration(Class(goldbook:T06325))
AnnotationAssertion(rdfs:label goldbook:T06325 "thermoluminescence")
AnnotationAssertion(dcterms:description goldbook:T06325 "Luminescence arising from a reaction between species trapped in a rigid matrix and released as a result of an increase in temperature.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06325 goldbook:L03641)
AnnotationAssertion(mito:isMentionedBy goldbook:T06325 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06325 "current"^^xsd:string)
Declaration(Class(goldbook:T06326))
AnnotationAssertion(rdfs:label goldbook:T06326 "thermolysis")
AnnotationAssertion(dcterms:description goldbook:T06326 "The uncatalysed cleavage of one or more covalent bonds resulting from exposure of a compound to a raised temperature, or a process in which such cleavage is an essential part.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06326 goldbook:B00697)
AnnotationAssertion(rdfs:seeAlso goldbook:T06326 goldbook:P04961)
AnnotationAssertion(mito:isMentionedBy goldbook:T06326 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06326 "current"^^xsd:string)
Declaration(Class(goldbook:T06327))
AnnotationAssertion(rdfs:label goldbook:T06327 "thermomagnetometry")
AnnotationAssertion(dcterms:description goldbook:T06327 "A technique in which a magnetic characteristic of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06327 goldbook:P04869)
AnnotationAssertion(mito:isMentionedBy goldbook:T06327 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06327 "current"^^xsd:string)
Declaration(Class(goldbook:T06328))
AnnotationAssertion(rdfs:label goldbook:T06328 "thermomechanical measurement")
AnnotationAssertion(dcterms:description goldbook:T06328 "A technique in which the deformation of a substance (and/or its reaction product(s)) under non-oscillatory load is measured as a function of temperature whilst the substance is subjected to a controlled temperature program.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06328 goldbook:P04869)
AnnotationAssertion(mito:isMentionedBy goldbook:T06328 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06328 "current"^^xsd:string)
Declaration(Class(goldbook:T06331))
AnnotationAssertion(rdfs:label goldbook:T06331 "thermometric titration")
AnnotationAssertion(dcterms:description goldbook:T06331 "An analytical method in which one reactant (the titrant) is added continuously or stepwise to an adiabatic or isoperibol vessel containing another reactant. The enthalpy change(s) of the ensuing reaction(s) causes a temperature change which, when plotted versus volume of titrant, may be used to find the titration endpoint(s). This is the preferred term for experiments producing plots of temperature versus volume of titrant in which the main goal is a quantitative determination. Nonetheless, when a calorimetric vessel is used, such that the heat capacity is known, thermodynamic parameters may also be estimated from such experiments. An acceptable synonym in that case is enthalpimetric titration. The use of the adjective thermometric is justified because of widespread historical and current usage, and because a titration of necessity implies a chemical reaction. The term  'thermometric enthalpy titration' has been used, but is not recommended. A method in which the titrant is a catalyst for an indicator reaction that occurs after the endpoint for the analyte reaction should be called a thermometric titration with catalytic endpoint detection, not a 'catalytic thermometric titration'.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06331 "enthalpimetric titration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06331 "thermometric enthalpy titration")
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:A00141)
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:E02141)
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:H02753)
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:C01380)
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:T06329)
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:T06386)
AnnotationAssertion(rdfs:seeAlso goldbook:T06331 goldbook:T06387)
AnnotationAssertion(mito:isMentionedBy goldbook:T06331 doi:10.1351/pac199466122487)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06331 "current"^^xsd:string)
Declaration(Class(goldbook:T06332))
AnnotationAssertion(rdfs:label goldbook:T06332 "thermoparticulate analysis")
AnnotationAssertion(dcterms:description goldbook:T06332 "A thermoanalytical technique in which the release of particulate matter from a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06332 goldbook:P04869)
AnnotationAssertion(mito:isMentionedBy goldbook:T06332 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06332 "current"^^xsd:string)
Declaration(Class(goldbook:T06333))
AnnotationAssertion(rdfs:label goldbook:T06333 "thermophile")
AnnotationAssertion(dcterms:description goldbook:T06333 "An organism that can tolerate high temperatures and that grows optimally at temperatures above \\(45\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:T06333 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06333 "current"^^xsd:string)
Declaration(Class(goldbook:T06335))
AnnotationAssertion(rdfs:label goldbook:T06335 "thermopile")
AnnotationAssertion(dcterms:description goldbook:T06335 "Several thermocouples connected in series to increase the magnitude of the electric potential.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06335 goldbook:E01935)
AnnotationAssertion(rdfs:seeAlso goldbook:T06335 goldbook:T06313)
AnnotationAssertion(mito:isMentionedBy goldbook:T06335 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06335 "current"^^xsd:string)
Declaration(Class(goldbook:T06336))
AnnotationAssertion(rdfs:label goldbook:T06336 "thermoptometry")
AnnotationAssertion(dcterms:description goldbook:T06336 "A technique in which an optical characteristic of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program. Measurements of total light, light of specific wavelength(s), refractive index and luminescence lead to thermophotometry, thermospectrometry, thermorefractometry and thermoluminescence, respectively; observation under the microscope leads to thermomicroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06336 goldbook:L03641)
AnnotationAssertion(rdfs:seeAlso goldbook:T06336 goldbook:P04869)
AnnotationAssertion(rdfs:seeAlso goldbook:T06336 goldbook:R05240)
AnnotationAssertion(rdfs:seeAlso goldbook:T06336 goldbook:T06325)
AnnotationAssertion(rdfs:seeAlso goldbook:T06336 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:T06336 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06336 "current"^^xsd:string)
Declaration(Class(goldbook:T06337))
AnnotationAssertion(rdfs:label goldbook:T06337 "thermosonimetry")
AnnotationAssertion(dcterms:description goldbook:T06337 "A technique in which the sound emitted by a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06337 goldbook:P04869)
AnnotationAssertion(mito:isMentionedBy goldbook:T06337 doi:10.1351/pac198557111737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06337 "current"^^xsd:string)
Declaration(Class(goldbook:T06338))
AnnotationAssertion(rdfs:label goldbook:T06338 "thermosphere")
AnnotationAssertion(dcterms:description goldbook:T06338 "Atmospheric shell extending from the top of the mesosphere to outer space. It is a region of more or less steadily increasing temperature with height, starting at \\(70\\) or \\(80\\ \\rm{km}\\). It includes the exosphere and most or all of the ionosphere (not the D region).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06338 goldbook:M03855)
AnnotationAssertion(mito:isMentionedBy goldbook:T06338 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06338 "current"^^xsd:string)
Declaration(Class(goldbook:T06342))
AnnotationAssertion(rdfs:label goldbook:T06342 "thickness of diffusion layer")
AnnotationAssertion(dcterms:description goldbook:T06342 "The distance from the electrode where the ratio \\[\\frac{c\\,-\\,c_{\\rm{e}}}{c_{0}\\,-\\,c_{\\rm{e}}}\\] reaches a given value. (\\(c_{\\rm{e}}\\) is the interfacial concentration, \\(c\\) is the concentration, \\(c_{0}\\) is the value in the bulk solution.) If this ratio is selected as, say, 0.99 the corresponding thickness of the diffusion layer is denoted by \\(\\delta_{0.99}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06342 goldbook:D01716)
AnnotationAssertion(rdfs:seeAlso goldbook:T06342 goldbook:D01725)
AnnotationAssertion(rdfs:seeAlso goldbook:T06342 goldbook:I03083)
AnnotationAssertion(mito:isMentionedBy goldbook:T06342 doi:10.1351/pac198153101827)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06342 "current"^^xsd:string)
Declaration(Class(goldbook:T06343))
AnnotationAssertion(rdfs:label goldbook:T06343 "thickness of electrical double layer")
AnnotationAssertion(dcterms:description goldbook:T06343 "The length characterizing the decrease with distance of the potential in the double layer = characteristic Debye length in the corresponding electrolyte solution = \\(\\kappa^{-1}\\):\\[\\frac{1}{\\kappa } = \\sqrt{\\frac{\\varepsilon_{\\rm{r}}\\varepsilon_{0}RT}{F^{2}\\sum _{i}c_{i}z_{i}^{2} }}\\]&nbsp;&nbsp;\\[\\frac{1}{\\kappa } = \\sqrt{\\frac{\\varepsilon_{\\rm{r}}RT}{4\\pi F^{2}\\sum _{i}c_{i}z_{i}^{2} }}\\](rationalized four-quantity system)&nbsp;&nbsp;(three-quantity electrostatic system) where \\(\\varepsilon\\) = static permittivity = \\(\\varepsilon_{\\rm{r}}\\varepsilon_{0}\\), \\(\\varepsilon_{\\rm{r}}\\) = relative static permittivity of solution; \\(\\varepsilon_{0}\\) = permittivity of vacuum, \\(R\\) = gas constant, \\(T\\) = thermodynamic temperature, \\(F\\) = Faraday constant, \\(z_{\\rm{i}}\\) = concentration of species \\(i\\), \\(z_{\\rm{i}}\\) = ionic charge on species \\(i\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06343 goldbook:D01533)
AnnotationAssertion(rdfs:seeAlso goldbook:T06343 goldbook:F02325)
AnnotationAssertion(rdfs:seeAlso goldbook:T06343 goldbook:G02579)
AnnotationAssertion(rdfs:seeAlso goldbook:T06343 goldbook:P04507)
AnnotationAssertion(rdfs:seeAlso goldbook:T06343 goldbook:P04508)
AnnotationAssertion(rdfs:seeAlso goldbook:T06343 goldbook:T06321)
AnnotationAssertion(mito:isMentionedBy goldbook:T06343 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06343 "current"^^xsd:string)
Declaration(Class(goldbook:T06344))
AnnotationAssertion(rdfs:label goldbook:T06344 "thickness of reaction layer")
AnnotationAssertion(dcterms:description goldbook:T06344 "When a kinetic current flows, the concentrations of the electroactive substance B and its precursor C at very small distances from the electrode surface are influenced both by mass transfer and by the finite rate of establishment of the chemical equilibrium. As the distance from the electrode surface increases, the chemical equilibrium is more and more nearly attained. The thickness of the reaction layer is the distance from the electrode surface beyond which deviations from the chemical equilibrium between C and B are taken to be negligibly small.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06344 goldbook:C01023)
AnnotationAssertion(rdfs:seeAlso goldbook:T06344 goldbook:E01940)
AnnotationAssertion(rdfs:seeAlso goldbook:T06344 goldbook:K03399)
AnnotationAssertion(mito:isMentionedBy goldbook:T06344 doi:10.1351/pac198557101491)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06344 "current"^^xsd:string)
Declaration(Class(goldbook:T06345))
AnnotationAssertion(rdfs:label goldbook:T06345 "thin film")
AnnotationAssertion(dcterms:description goldbook:T06345 "A film whose thickness is of the order of a characteristic scale or smaller. Since a film may 'look' operationally thin or thick, according to the procedure applied, it is also recommended that the measurement procedure employed be specified (e.g. ellipsometrically thin film, optically thin film, etc.). It is recommended that the physical specification of the film thickness be used, whenever possible (e.g. thick compared to the electron mean free path, thin compared to the optical wavelength, etc.)")
AnnotationAssertion(rdfs:seeAlso goldbook:T06345 goldbook:C00977)
AnnotationAssertion(rdfs:seeAlso goldbook:T06345 goldbook:F02366)
AnnotationAssertion(rdfs:seeAlso goldbook:T06345 goldbook:M03778)
AnnotationAssertion(rdfs:seeAlso goldbook:T06345 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:T06345 doi:10.1351/pac199466081667)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06345 "current"^^xsd:string)
Declaration(Class(goldbook:T06347))
AnnotationAssertion(rdfs:label goldbook:T06347 "thio")
AnnotationAssertion(dcterms:description goldbook:T06347 "This prefix properly denotes replacement of an oxygen by a sulfur, e.g. $\\ce{PhC(=S)NH2}$, thiobenzamide. See also entries prefixed thio-.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06347 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06347 "current"^^xsd:string)
Declaration(Class(goldbook:T06348))
AnnotationAssertion(rdfs:label goldbook:T06348 "thioacetals")
AnnotationAssertion(dcterms:description goldbook:T06348 "A term including monothioacetals having the structure $\\ce{R2C(OR')(SR')}$ (subclass monothioketals, $\\ce{R}  eq \\ce{H}$); and dithioacetals having the structure $\\ce{R2C(SR')2}$ (subclass dithioketals, $\\ce{R}  eq \\ce{H}, \\ce{R'}  eq \\ce{H}$).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06348 goldbook:T06355)
AnnotationAssertion(mito:isMentionedBy goldbook:T06348 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06348 "current"^^xsd:string)
Declaration(Class(goldbook:T06349))
AnnotationAssertion(rdfs:label goldbook:T06349 "thioaldehydes")
AnnotationAssertion(dcterms:description goldbook:T06349 "Compounds in which the oxygen of an aldehyde has been replaced by divalent sulfur, $\\ce{RC(=S)H}$, e.g. $\\ce{CH3CH2C(=S)H propanethial}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06349 goldbook:A00208)
AnnotationAssertion(mito:isMentionedBy goldbook:T06349 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06349 "current"^^xsd:string)
Declaration(Class(goldbook:T06350))
AnnotationAssertion(rdfs:label goldbook:T06350 "thioaldehyde <i>S</i>-oxides")
AnnotationAssertion(dcterms:description goldbook:T06350 "Compounds having the structure $\\ce{RC(=S=O)H}$. (Also known by the disapproved term 'sulfines' which includes thioaldehyde S-oxides and thioketone S-oxides).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06350 "sulfines")
AnnotationAssertion(rdfs:seeAlso goldbook:T06350 goldbook:T06357)
AnnotationAssertion(mito:isMentionedBy goldbook:T06350 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06350 "current"^^xsd:string)
Declaration(Class(goldbook:T06351))
AnnotationAssertion(rdfs:label goldbook:T06351 "thioanhydrides")
AnnotationAssertion(dcterms:description goldbook:T06351 "Compounds having the structure acyl-S-acyl. Also called diacylsulfanes, e.g. $\\ce{CH3C(=O)SC(=S)CH2CH3}$ acetic thiopropanoic thioanhydride.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06351 "acid thioanhydrides")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06351 "diacylsulfanes")
AnnotationAssertion(rdfs:seeAlso goldbook:T06351 goldbook:A00123)
AnnotationAssertion(mito:isMentionedBy goldbook:T06351 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06351 "current"^^xsd:string)
Declaration(Class(goldbook:T06352))
AnnotationAssertion(rdfs:label goldbook:T06352 "thiocarboxylic acids")
AnnotationAssertion(dcterms:description goldbook:T06352 "Compounds in which one or both oxygens of a carboxy group have been replaced by divalent sulfur $\\ce{RC(=O)SH}$ or $\\ce{RC(=S)OH}$ monothiocarboxylic acids, $\\ce{RC(=S)SH}$ dithiocarboxylic acids.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06352 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06352 "current"^^xsd:string)
Declaration(Class(goldbook:T06353))
AnnotationAssertion(rdfs:label goldbook:T06353 "thiocyanates")
AnnotationAssertion(dcterms:description goldbook:T06353 "Salts and esters of thiocyanic acid $\\ce{HSC#N}$, e.g. $\\ce{CH3SC#N}$ methyl thiocyanate.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06353 goldbook:E02219)
AnnotationAssertion(rdfs:seeAlso goldbook:T06353 goldbook:I03320)
AnnotationAssertion(mito:isMentionedBy goldbook:T06353 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06353 "current"^^xsd:string)
Declaration(Class(goldbook:T06354))
AnnotationAssertion(rdfs:label goldbook:T06354 "thioethers")
AnnotationAssertion(dcterms:description goldbook:T06354 "Former name for sulfides $\\ce{RSR}$ ($\\ce{R}  eq \\ce{H}$).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06354 goldbook:S06102)
AnnotationAssertion(mito:isMentionedBy goldbook:T06354 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06354 "current"^^xsd:string)
Declaration(Class(goldbook:T06355))
AnnotationAssertion(rdfs:label goldbook:T06355 "thiohemiacetals")
AnnotationAssertion(dcterms:description goldbook:T06355 "Compounds of structure $\\ce{R2C(SR')OH}$ or $\\ce{R2C(OR')SH}$ (monothiohemiacetals), or $\\ce{R2C(SR')SH}$ (dithiohemiacetals), $\\ce{R'}  eq \\ce{H}$.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06355 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06355 "current"^^xsd:string)
Declaration(Class(goldbook:T06356))
AnnotationAssertion(rdfs:label goldbook:T06356 "thioketones")
AnnotationAssertion(dcterms:description goldbook:T06356 "Compounds in which the oxygen of a ketone has been replaced by divalent sulfur $\\ce{R2C=S}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{CH3C(=S)CH2CH3}$ butane-2-thione.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06356 goldbook:K03386)
AnnotationAssertion(mito:isMentionedBy goldbook:T06356 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06356 "current"^^xsd:string)
Declaration(Class(goldbook:T06357))
AnnotationAssertion(rdfs:label goldbook:T06357 "thioketone <i>S</i>-oxides")
AnnotationAssertion(dcterms:description goldbook:T06357 "Compounds having the structure $\\ce{R2C=S=O}$ ($\\ce{R}  eq \\ce{H}$). (Also known by the disapproved term 'sulfines' which comprises thioaldehyde S-oxides and thioketone S-oxides.)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06357 "sulfines")
AnnotationAssertion(rdfs:seeAlso goldbook:T06357 goldbook:T06350)
AnnotationAssertion(mito:isMentionedBy goldbook:T06357 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06357 "current"^^xsd:string)
Declaration(Class(goldbook:T06358))
AnnotationAssertion(rdfs:label goldbook:T06358 "thiolates")
AnnotationAssertion(dcterms:description goldbook:T06358 "Derivatives of thiols, in which a metal (or other cation) replaces the hydrogen attached to sulfur, e.g. $\\ce{CH3S^{-}Na^{+}}$ sodium methanethiolate.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06358 goldbook:C00907)
AnnotationAssertion(rdfs:seeAlso goldbook:T06358 goldbook:T06359)
AnnotationAssertion(mito:isMentionedBy goldbook:T06358 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06358 "current"^^xsd:string)
Declaration(Class(goldbook:T06359))
AnnotationAssertion(rdfs:label goldbook:T06359 "thiols")
AnnotationAssertion(dcterms:description goldbook:T06359 "Compounds having the structure $\\ce{RSH}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{MeCH2SH}$ ethanethiol. Also known by the term 'mercaptans' (abandoned by IUPAC).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06359 "mercaptans")
AnnotationAssertion(mito:isMentionedBy goldbook:T06359 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06359 "current"^^xsd:string)
Declaration(Class(goldbook:T06361))
AnnotationAssertion(rdfs:label goldbook:T06361 "third body")
AnnotationAssertion(dcterms:description goldbook:T06361 "A species, other than the reactant itself, which brings about the energization of a molecule that can undergo a unimolecular process, or brings about a combination reaction between atoms or radicals. In the latter case a third body is also called a chaperon.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06361 goldbook:C00973)
AnnotationAssertion(rdfs:seeAlso goldbook:T06361 goldbook:M03989)
AnnotationAssertion(mito:isMentionedBy goldbook:T06361 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06361 "current"^^xsd:string)
Declaration(Class(goldbook:T06366))
AnnotationAssertion(rdfs:label goldbook:T06366 "threshold energy")
AnnotationAssertion(dcterms:description goldbook:T06366 "Potential energy gap between reactants and the transition state, sometimes involving the zero point energies, but usually not.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06366 goldbook:C01393)
AnnotationAssertion(rdfs:seeAlso goldbook:T06366 goldbook:R05163)
AnnotationAssertion(rdfs:seeAlso goldbook:T06366 goldbook:T06468)
AnnotationAssertion(mito:isMentionedBy goldbook:T06366 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06366 "current"^^xsd:string)
Declaration(Class(goldbook:T06367))
AnnotationAssertion(rdfs:label goldbook:T06367 "through-bond electron transfer")
AnnotationAssertion(dcterms:description goldbook:T06367 "Intramolecular electron transfer for which the relevant electronic interaction between the donor and acceptor sites is mediated by through-bond interaction, i.e. via the covalent bonds interconnecting these sites, as opposed to through-space interaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06367 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:T06367 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:T06367 goldbook:T06369)
AnnotationAssertion(mito:isMentionedBy goldbook:T06367 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06367 "current"^^xsd:string)
Declaration(Class(goldbook:T06369))
AnnotationAssertion(rdfs:label goldbook:T06369 "through-space electron transfer")
AnnotationAssertion(dcterms:description goldbook:T06369 "Electron transfer for which the relevant electronic interaction between the donor and acceptor sites is mediated either by direct orbital overlap or by superexchange interaction via intervening molecular entities not covalently bound to the donor or acceptor sites.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06369 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:T06369 goldbook:S06141)
AnnotationAssertion(rdfs:seeAlso goldbook:T06369 goldbook:T06367)
AnnotationAssertion(mito:isMentionedBy goldbook:T06369 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06369 "current"^^xsd:string)
Declaration(Class(goldbook:T06371))
AnnotationAssertion(rdfs:label goldbook:T06371 "TICT emission")
AnnotationAssertion(dcterms:description goldbook:T06371 "Electronic emission emanating from a TICT state.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:T06371 "TICT")
AnnotationAssertion(rdfs:seeAlso goldbook:T06371 goldbook:T06372)
AnnotationAssertion(rdfs:seeAlso goldbook:T06371 goldbook:T06537)
AnnotationAssertion(mito:isMentionedBy goldbook:T06371 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06371 "current"^^xsd:string)
Declaration(Class(goldbook:T06372))
AnnotationAssertion(rdfs:label goldbook:T06372 "TICT state")
AnnotationAssertion(dcterms:description goldbook:T06372 "The acronym derives from Twisted Internal Charge Transfer state, proposed to be responsible for strongly Stokes-shifted fluorescence from certain aromatics, particularly in a polar medium.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:T06372 "TICT")
AnnotationAssertion(rdfs:seeAlso goldbook:T06372 goldbook:S06027)
AnnotationAssertion(rdfs:seeAlso goldbook:T06372 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:T06372 goldbook:T06537)
AnnotationAssertion(mito:isMentionedBy goldbook:T06372 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06372 "current"^^xsd:string)
Declaration(Class(goldbook:T06375))
AnnotationAssertion(rdfs:label goldbook:T06375 "time")
AnnotationAssertion(dcterms:description goldbook:T06375 "Base quantity in the system of quantities upon which SI is based.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06375 goldbook:B00609)
AnnotationAssertion(mito:isMentionedBy goldbook:T06375 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06375 "current"^^xsd:string)
Declaration(Class(goldbook:T06376))
AnnotationAssertion(rdfs:label goldbook:T06376 "time constant")
AnnotationAssertion(dcterms:description goldbook:T06376 "If the output of a detector changes exponentially with time, the time required for it to change from its initial value by the fraction \\(1 - \\exp(-t/\\tau _{\\rm{c}})\\) (for \\(t=\\tau _{\\rm{c}}\\)) of the final value, is called the time constant.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06376 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06376 "current"^^xsd:string)
Declaration(Class(goldbook:T06377))
AnnotationAssertion(rdfs:label goldbook:T06377 "time-correlated single photon counting")
AnnotationAssertion(dcterms:description goldbook:T06377 "A technique for the measurement of the time histogram of a sequence of photons with respect to a periodic event, e.g. a flash from a repetitive nanosecond lamp or a CW operated laser (mode locked laser). The essential part is a time-to-amplitude-converter (TAC) which transforms the arrival time between a start and a stop pulse into a voltage. Sometimes called single photon timing.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06377 "single photon timing")
AnnotationAssertion(rdfs:seeAlso goldbook:T06377 goldbook:L03447)
AnnotationAssertion(rdfs:seeAlso goldbook:T06377 goldbook:L03459)
AnnotationAssertion(rdfs:seeAlso goldbook:T06377 goldbook:M03958)
AnnotationAssertion(rdfs:seeAlso goldbook:T06377 goldbook:ST06775)
AnnotationAssertion(mito:isMentionedBy goldbook:T06377 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06377 "current"^^xsd:string)
Declaration(Class(goldbook:T06378))
AnnotationAssertion(rdfs:label goldbook:T06378 "time-dependent stoichiometry")
AnnotationAssertion(dcterms:description goldbook:T06378 "A state in which if intermediates are formed in significant amounts during the course of a reaction, the overall stoichiometric equation does not apply throughout.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06378 goldbook:S06021)
AnnotationAssertion(mito:isMentionedBy goldbook:T06378 doi:10.1351/pac198153030753)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06378 "current"^^xsd:string)
Declaration(Class(goldbook:T06379))
AnnotationAssertion(rdfs:label goldbook:T06379 "time-independent stoichiometry")
AnnotationAssertion(dcterms:description goldbook:T06379 "A state in which the stoichiometric equation applies throughout the course of the reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06379 goldbook:S06021)
AnnotationAssertion(mito:isMentionedBy goldbook:T06379 doi:10.1351/pac198153030753)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06379 "current"^^xsd:string)
Declaration(Class(goldbook:T06380))
AnnotationAssertion(rdfs:label goldbook:T06380 "time of centrifugation")
AnnotationAssertion(dcterms:description goldbook:T06380 "The time difference from switching on until switching off. The time for deceleration is not included.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06380 doi:10.1351/pac199466040897)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06380 "current"^^xsd:string)
Declaration(Class(goldbook:T06382))
AnnotationAssertion(rdfs:label goldbook:T06382 "time-of-flight mass spectrometer")
AnnotationAssertion(dcterms:description goldbook:T06382 "An arrangement using the fact that ions of different mass/charge need different times to travel through a certain distance in a field-free region after they have all been initially given the same translational energy.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06382 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06382 "current"^^xsd:string)
Declaration(Class(goldbook:T06383))
AnnotationAssertion(rdfs:label goldbook:T06383 "time")
AnnotationAssertion(dcterms:description goldbook:T06383 "The time in which a certain viscosity or yield stress is reached after discontinuation of a shear. These times depend on the values of viscosity or yield stress chosen by the experimenter.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06383 goldbook:V06627)
AnnotationAssertion(rdfs:seeAlso goldbook:T06383 goldbook:Y06727)
AnnotationAssertion(mito:isMentionedBy goldbook:T06383 doi:10.1351/pac197951051213)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06383 "current"^^xsd:string)
Declaration(Class(goldbook:T06384))
AnnotationAssertion(rdfs:label goldbook:T06384 "time-resolved microwave conductivity")
AnnotationAssertion(dcterms:description goldbook:T06384 "Technique allowing the quantitative and qualitative detection of radiation-induced changes in the real, \\(\\Delta \\rm{Re}\\sigma\\), and imaginary, \\(\\Delta \\rm{Im}\\sigma\\), components of the conductivity of a medium by time-resolved measurement of changes in the microwave absorption resulting from the formation of mobile charges or from changes in the dipole moment or polarizability of molecules on excitation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:T06384 "TRMC")
AnnotationAssertion(rdfs:comment goldbook:T06384 "From \\(\\Delta \\rm{Re}\\sigma\\) (corresponding to a change in the dielectric loss, \\(\\Delta \\varepsilon''\\)) the product of the yield and the mobility of charges carriers or the dipole moment change can be determined. From \\(\\Delta \\rm{Im}\\sigma\\) (corresponding to a change in the relative permittivity, \\(\\Delta \\varepsilon'\\)) the product of the yield and the change in molecular polarizability can be determined."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:T06384 goldbook:D01761)
AnnotationAssertion(rdfs:seeAlso goldbook:T06384 goldbook:M03955)
AnnotationAssertion(rdfs:seeAlso goldbook:T06384 goldbook:P04711)
AnnotationAssertion(rdfs:seeAlso goldbook:T06384 goldbook:R05273)
AnnotationAssertion(mito:isMentionedBy goldbook:T06384 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06384 "current"^^xsd:string)
Declaration(Class(goldbook:T06385))
AnnotationAssertion(rdfs:label goldbook:T06385 "time-resolved spectroscopy")
AnnotationAssertion(dcterms:description goldbook:T06385 "The recording of spectra at a series of time intervals after the excitation of the system with a light pulse (or other perturbation) of appropriately short duration.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06385 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06385 "current"^^xsd:string)
Declaration(Class(goldbook:T06395))
AnnotationAssertion(rdfs:label goldbook:T06395 "topochemical reaction")
AnnotationAssertion(dcterms:description goldbook:T06395 "A reversible or irreversible reaction that involves the introduction of a guest species into a host structure and that results in significant structural modifications to the host, for example, the breakage of bonds. Example: The insertion of lithium at \\(50\\,^{\\unicode{x26ac}}\\rm{C}\\) into the spinel $\\ce{Li[Mn2]O4}$ with symmetry \\(F\\,\\rm{d3m}\\) to yield a layered structure with symmetry \\(P\\bar{3}\\,\\rm{m1}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06395 "topotactic reaction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06395 "insertion reaction")
AnnotationAssertion(rdfs:seeAlso goldbook:T06395 goldbook:G02711)
AnnotationAssertion(rdfs:seeAlso goldbook:T06395 goldbook:I03058)
AnnotationAssertion(mito:isMentionedBy goldbook:T06395 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06395 "current"^^xsd:string)
Declaration(Class(goldbook:T06396))
AnnotationAssertion(rdfs:label goldbook:T06396 "topomerization")
AnnotationAssertion(dcterms:description goldbook:T06396 "The identity reaction leading to exchange of the positions of identical ligands. The indistinguishable molecular entities involved are called topomers. For example in the reaction below the two identical ligating atoms $\\ce{N_{\\rm{a}}}$ and $\\ce{N_{\\rm{b}}}$ are interchanged by rotation about the $\\ce{C-aryl}$ bond but may be identified by NMR spectroscopy. This is a degenerate isomerization.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06396 goldbook:I02940)
AnnotationAssertion(rdfs:seeAlso goldbook:T06396 goldbook:I03295)
AnnotationAssertion(rdfs:seeAlso goldbook:T06396 goldbook:L03518)
AnnotationAssertion(rdfs:seeAlso goldbook:T06396 goldbook:S05848)
AnnotationAssertion(mito:isMentionedBy goldbook:T06396 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06396 "current"^^xsd:string)
Declaration(Class(goldbook:T06399))
AnnotationAssertion(rdfs:label goldbook:T06399 "topotactic transition")
AnnotationAssertion(dcterms:description goldbook:T06399 "A transition in which the crystal lattice of the product phase shows one or more crystallographically equivalent, orientational relationships to the crystal lattice of the parent phase. Example: Transitions in which the anionic array is unchanged during the transition but cation reorganization occurs, as in:")
AnnotationAssertion(rdfs:seeAlso goldbook:T06399 goldbook:C00907)
AnnotationAssertion(mito:isMentionedBy goldbook:T06399 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06399 "current"^^xsd:string)
Declaration(Class(goldbook:T06401))
AnnotationAssertion(rdfs:label goldbook:T06401 "torquoselectivity")
AnnotationAssertion(dcterms:description goldbook:T06401 "The preference for 'inward' or 'outward' rotation of substituents in conrotatory or disrotatory electrocyclic ring opening reactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06401 goldbook:E01948)
AnnotationAssertion(mito:isMentionedBy goldbook:T06401 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06401 "current"^^xsd:string)
Declaration(Class(goldbook:T06402))
AnnotationAssertion(rdfs:label goldbook:T06402 "torr")
AnnotationAssertion(dcterms:description goldbook:T06402 "Non-SI unit of pressure, \\(\\rm{torr}\\approx 133.322\\ \\rm{Pa}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:T06402 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06402 "current"^^xsd:string)
Declaration(Class(goldbook:T06404))
AnnotationAssertion(rdfs:label goldbook:T06404 "torsional stereoisomers")
AnnotationAssertion(dcterms:description goldbook:T06404 "Stereoisomers that can be interconverted (actually or conceptually) by torsion about a bond axis. This includes E,Z-isomers of alkenes, atropisomers and rotamers.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06404 goldbook:S05984)
AnnotationAssertion(rdfs:seeAlso goldbook:T06404 goldbook:A00224)
AnnotationAssertion(rdfs:seeAlso goldbook:T06404 goldbook:A00511)
AnnotationAssertion(rdfs:seeAlso goldbook:T06404 goldbook:R05407)
AnnotationAssertion(mito:isMentionedBy goldbook:T06404 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06404 "current"^^xsd:string)
Declaration(Class(goldbook:T06406))
AnnotationAssertion(rdfs:label goldbook:T06406 "torsion angle")
AnnotationAssertion(dcterms:description goldbook:T06406 "In a chain of atoms A-B-C-D, the dihedral angle between the plane containing the atoms A,B,C and that containing B,C,D. In a Newman projection the torsion angle is the angle (having an absolute value between 0° and 180°) between bonds to two specified (fiducial) groups, one from the atom nearer (proximal) to the observer and the other from the further (distal) atom. The torsion angle between groups A and D is then considered to be positive if the bond A-B is rotated in a clockwise direction through less than 180° in order that it may eclipse the bond C-D: a negative torsion angle requires rotation in the opposite sense. Stereochemical arrangements corresponding to torsion angles between 0° and ±90° are called syn (s), those corresponding to torsion angles between ±90° and 180° anti (a). Similarly, arrangements corresponding to torsion angles between 30° and 150° or between -30° and -150° are called clinal (c) and those between 0° and 30° or 150° and 180° are called periplanar (p). The two types of terms can be combined so as to define four ranges of torsion angle; 0° to 30° synperiplanar (sp); 30° to 90° and -30° to -90° synclinal (sc); 90° to 150°, and -90° to -150° anticlinal (ac); ±150° to 180° antiperiplanar (ap).  The synperiplanar conformation is also known as the syn- or cis-conformation; antiperiplanar as anti or trans and synclinal as gauche or skew. For macromolecular usage the symbols \\(\\rm{T}\\), \\(\\rm{C}\\), \\(\\rm{G}^{+}\\), \\(\\rm{G}^{-}\\), \\(\\rm{A}^{+}\\) and \\(\\rm{A}^{-}\\) are recommended (ap, sp, +sc, -sc, +ac and -ac respectively).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:N04134)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:A00381)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:C01258)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:D01730)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:E01884)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:F02356)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:G02593)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:S05709)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:S06216)
AnnotationAssertion(rdfs:seeAlso goldbook:T06406 goldbook:C01092)
AnnotationAssertion(mito:isMentionedBy goldbook:T06406 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06406 "current"^^xsd:string)
Declaration(Class(goldbook:T06409))
AnnotationAssertion(rdfs:label goldbook:T06409 "total consumption time")
AnnotationAssertion(dcterms:description goldbook:T06409 "The time necessary to consume the prepared sample completely (in \\(\\mathrm{s}\\)). It is equal to the volume of the prepared sample divided by the rate of fluid consumption.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06409 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06409 "current"^^xsd:string)
Declaration(Class(goldbook:T06410))
AnnotationAssertion(rdfs:label goldbook:T06410 "total ion current")
AnnotationAssertion(dcterms:description goldbook:T06410 "(after mass analysis): The sum of the separate ion currents carried by the different ions contributing to the spectrum (this is sometimes called the reconstructed ion current).(before mass analysis): The sum of all the separate ion currents for ions of the same sign before mass analysis.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06410 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06410 "current"^^xsd:string)
Declaration(Class(goldbook:T06411))
AnnotationAssertion(rdfs:label goldbook:T06411 "totally porous packing")
AnnotationAssertion(dcterms:description goldbook:T06411 "Packing in which the stationary phase permeates each porous particle.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06411 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06411 "current"^^xsd:string)
Declaration(Class(goldbook:T06413))
AnnotationAssertion(rdfs:label goldbook:T06413 "total retention volume")
AnnotationAssertion(dcterms:description goldbook:T06413 "The volume of mobile phase entering the column between sample injection and the emergence of the peak maximum of the sample component of interest, or the corresponding time. It includes the hold-up volume (time): \\[t_{\\rm{R}}=\\frac{V_{\\rm{R}}}{F_{\\rm{c}}}\\] where \\(F_{c}\\) is the mobile phase flow rate at column temperature.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06413 "time")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:T06413 "retention time")
AnnotationAssertion(mito:isMentionedBy goldbook:T06413 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06413 "current"^^xsd:string)
Declaration(Class(goldbook:T06414))
AnnotationAssertion(rdfs:label goldbook:T06414 "toxicity")
AnnotationAssertion(dcterms:description goldbook:T06414 "Capacity to cause injury to a living organism defined with reference to the quantity of substance administered or absorbed, the way in which the substance is administered (inhalation, ingestion, topical application, injection) and distributed in time (single or repeated doses), the type and severity of injury, the time needed to produce the injury, the nature of the organism(s) affected and other relevant conditions.Adverse effects of a substance on a living organism defined with reference to the quantity of substance administered or absorbed, the way in which the substance is administered (inhalation, ingestion, topical application, injection) and distributed in time (single or repeated doses), the type and severity of injury, the time needed to produce the injury, the nature of the organism(s) affected, and other relevant conditions.Measure of incompatibility of a substance with life: this quantity may be expressed as the reciprocal of the absolute value of median lethal dose (\\(\\frac{1}{\\rm{LD}_{50}}\\)) or concentration (\\(\\frac{1}{\\rm{LC}_{50}}\\)).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06414 goldbook:M03810)
AnnotationAssertion(mito:isMentionedBy goldbook:T06414 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06414 "current"^^xsd:string)
Declaration(Class(goldbook:T06415))
AnnotationAssertion(rdfs:label goldbook:T06415 "toxicodynamics")
AnnotationAssertion(dcterms:description goldbook:T06415 "Study of toxic actions on living systems, including the reactions with and binding to cell constituents, and the biochemical and physiological consequences of these actions.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06415 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06415 "current"^^xsd:string)
Declaration(Class(goldbook:T06416))
AnnotationAssertion(rdfs:label goldbook:T06416 "toxicokinetics")
AnnotationAssertion(dcterms:description goldbook:T06416 "Process of the uptake of potentially toxic substances by the body, the biotransformation they undergo, the distribution of the substances and their metabolites in the tissues, and the elimination of the substances and their metabolites from the body. Both the amounts and the concentrations of the substances and their metabolites are studied. The term has essentially the same meaning as pharmacokinetics, but the latter term should be restricted to the study of pharmaceutical substances.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06416 goldbook:B00667)
AnnotationAssertion(rdfs:seeAlso goldbook:T06416 goldbook:E02038)
AnnotationAssertion(rdfs:seeAlso goldbook:T06416 goldbook:PT06835)
AnnotationAssertion(rdfs:seeAlso goldbook:T06416 goldbook:UT06806)
AnnotationAssertion(mito:isMentionedBy goldbook:T06416 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06416 "current"^^xsd:string)
Declaration(Class(goldbook:T06417))
AnnotationAssertion(rdfs:label goldbook:T06417 "toxicology")
AnnotationAssertion(dcterms:description goldbook:T06417 "Scientific discipline involving the study of the actual or potential danger presented by the harmful effects of substances (poisons) on living organisms and ecosystems, of the relationship of such harmful effects to exposure, and of the mechanisms of action, diagnosis, prevention and treatment of intoxications.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06417 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06417 "current"^^xsd:string)
Declaration(Class(goldbook:T06418))
AnnotationAssertion(rdfs:label goldbook:T06418 "toxin")
AnnotationAssertion(dcterms:description goldbook:T06418 "Poisonous substance produced by a biological organism such as a microbe, animal or plant.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06418 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06418 "current"^^xsd:string)
Declaration(Class(goldbook:T06419))
AnnotationAssertion(rdfs:label goldbook:T06419 "toxinology")
AnnotationAssertion(dcterms:description goldbook:T06419 "Scientific discipline involving the study of the chemistry, biochemistry, pharmacology and toxicology of toxins.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06419 goldbook:T06417)
AnnotationAssertion(mito:isMentionedBy goldbook:T06419 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06419 "current"^^xsd:string)
Declaration(Class(goldbook:T06420))
AnnotationAssertion(rdfs:label goldbook:T06420 "traceability")
AnnotationAssertion(dcterms:description goldbook:T06420 "The property of a result or measurement whereby it can be related to appropriate standards, generally international or national standards, through an unbroken chain of comparisons.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06420 doi:10.1351/pac199567101699)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06420 "current"^^xsd:string)
Declaration(Class(goldbook:T06421))
AnnotationAssertion(rdfs:label goldbook:T06421 "trace element")
AnnotationAssertion(dcterms:description goldbook:T06421 "Any element having an average concentration of less than about 100 parts per million atoms (\\(\\rm{ppma}\\)) or less than \\(100\\ \\frac{\\unicode[Times]{x3BC}\\rm{g}}{\\rm{g}}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:T06421 doi:10.1351/pac197951112243)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06421 "current"^^xsd:string)
Declaration(Class(goldbook:T06422))
AnnotationAssertion(rdfs:label goldbook:T06422 "tracer")
AnnotationAssertion(dcterms:description goldbook:T06422 "A foreign substance mixed with or attached to a given substance to enable the distribution or location of the latter to be determined subsequently. There are several types of tracers which are used: (i) A physical tracer is one that is attached by physical means to the object being traced; (ii) A chemical tracer is a chemical with properties similar to those of the substance being traced with which it is mixed homogeneously; (iii) An isotopic tracer is a unique isotope, either radioactive or an enriched, uncommon stable isotope, of the element to be traced; (iv) A radioactive tracer is a physical or chemical tracer having radioactivity as its distinctive property which allows detection at small concentrations and hence after large transport distances. The composition of aerosols in the troposphere has been used as a qualitative tracer of air masses. The elemental analyses (determined by neutron activation, X-ray fluorescence, etc.) of the aerosols transported from various sources or source regions sometimes have characteristic patterns which are used to define qualitatively the origin of tropospheric aerosols collected in other geographical regions.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:X06710)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:A00093)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:I03350)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:N04116)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:R05077)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:R05089)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:R05092)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:S05900)
AnnotationAssertion(rdfs:seeAlso goldbook:T06422 goldbook:T06522)
AnnotationAssertion(mito:isMentionedBy goldbook:T06422 doi:10.1351/pac199062112167)
AnnotationAssertion(mito:isMentionedBy goldbook:T06422 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06422 "current"^^xsd:string)
Declaration(Class(goldbook:T06429))
AnnotationAssertion(rdfs:label goldbook:T06429 "track")
AnnotationAssertion(dcterms:description goldbook:T06429 "The path of an ionizing particle as revealed by a track detector.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06429 goldbook:T06430)
AnnotationAssertion(mito:isMentionedBy goldbook:T06429 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06429 "current"^^xsd:string)
Declaration(Class(goldbook:T06430))
AnnotationAssertion(rdfs:label goldbook:T06430 "track detector")
AnnotationAssertion(dcterms:description goldbook:T06430 "A detector which makes the paths of ionizing particles visible, either directly (e.g. cloud chamber) or after suitable treatment (photographic emulsion, polymers).")
AnnotationAssertion(rdfs:seeAlso goldbook:T06430 goldbook:E02065)
AnnotationAssertion(rdfs:seeAlso goldbook:T06430 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:T06430 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06430 "current"^^xsd:string)
Declaration(Class(goldbook:T06431))
AnnotationAssertion(rdfs:label goldbook:T06431 "trajectory")
AnnotationAssertion(dcterms:description goldbook:T06431 "A path taken by a reaction system over potential-energy surface or a diagram or mathematical description that represents that path. A trajectory can also be called a reaction path.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06431 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:T06431 goldbook:R05174)
AnnotationAssertion(mito:isMentionedBy goldbook:T06431 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06431 "current"^^xsd:string)
Declaration(Class(goldbook:T06433))
AnnotationAssertion(rdfs:label goldbook:T06433 "<i>trans-</i>")
AnnotationAssertion(dcterms:description goldbook:T06433 "A prefix designating two groups directly across a central atom from each other, i.e. in the polar positions on a sphere, not now generally recommended for precise nomenclature purposes.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06433 goldbook:C00930)
AnnotationAssertion(mito:isMentionedBy goldbook:T06433 doi:10.1515/pac-2014-0718)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06433 "current"^^xsd:string)
Declaration(Class(goldbook:T06434))
AnnotationAssertion(rdfs:label goldbook:T06434 "transannular strain")
AnnotationAssertion(dcterms:description goldbook:T06434 "In medium-sized ring compounds, the strain due to repulsive nonbonded interactions between substituents or hydrogen atoms attached to non-adjacent ring atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06434 goldbook:N04183)
AnnotationAssertion(rdfs:seeAlso goldbook:T06434 goldbook:S06037)
AnnotationAssertion(mito:isMentionedBy goldbook:T06434 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06434 "current"^^xsd:string)
Declaration(Class(goldbook:T06436))
AnnotationAssertion(rdfs:label goldbook:T06436 "transcription")
AnnotationAssertion(dcterms:description goldbook:T06436 "The process by which the genetic information encoded in a linear sequence of nucleotides in one strand of DNA is copied into an exactly complementary sequence of RNA.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06436 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:T06436 goldbook:R05386)
AnnotationAssertion(rdfs:seeAlso goldbook:T06436 goldbook:N04255)
AnnotationAssertion(rdfs:seeAlso goldbook:T06436 goldbook:ST06775)
AnnotationAssertion(mito:isMentionedBy goldbook:T06436 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06436 "current"^^xsd:string)
Declaration(Class(goldbook:T06437))
AnnotationAssertion(rdfs:label goldbook:T06437 "transducer")
AnnotationAssertion(dcterms:description goldbook:T06437 "An analytical instrument which provides an output quantity having a given relationship to the input quantity.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06437 goldbook:A00333)
AnnotationAssertion(mito:isMentionedBy goldbook:T06437 doi:10.1351/pac198961091657)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06437 "current"^^xsd:string)
Declaration(Class(goldbook:T06438))
AnnotationAssertion(rdfs:label goldbook:T06438 "transduction")
AnnotationAssertion(dcterms:description goldbook:T06438 "The transfer of genetic information from one bacterium to another by means of a transducing bacteriophage. When the phage is grown on the first host, a fragment of the host DNA can be incorporated into the phage particles. This foreign DNA can be transferred to the second host upon infection with progeny phage from the first experiment.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06438 goldbook:D01597)
AnnotationAssertion(mito:isMentionedBy goldbook:T06438 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06438 "current"^^xsd:string)
Declaration(Class(goldbook:T06439))
AnnotationAssertion(rdfs:label goldbook:T06439 "transfer")
AnnotationAssertion(dcterms:description goldbook:T06439 "Movement of a component within a system or across its boundary. It may be expressed using different kinds of quantities, e.g rates of change \\(\\frac{\\rm{d}Q}{\\rm{d}t}\\) or \\(\\frac{\\Delta Q}{\\Delta t}\\). Examples are: mass rate, \\(\\frac{\\rm{d}m_{\\rm{B}}}{\\rm{d}t}\\) or \\(\\frac{\\Delta m_{\\rm{B}}}{\\Delta t}\\); substance rate, \\(\\frac{\\rm{d}n_{\\rm{B}}}{\\rm{d}t}\\) or \\(\\frac{\\Delta n_{\\rm{B}}}{\\Delta t}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:T06439 doi:10.1351/pac199264101569)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06439 "current"^^xsd:string)
Declaration(Class(goldbook:T06440))
AnnotationAssertion(rdfs:label goldbook:T06440 "transfer")
AnnotationAssertion(dcterms:description goldbook:T06440 "The action of moving material between containers, or containers between transport devices. This term is of particular importance in clinical chemistry.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06440 doi:10.1351/pac198961091657)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06440 "current"^^xsd:string)
Declaration(Class(goldbook:T06441))
AnnotationAssertion(rdfs:label goldbook:T06441 "transferability")
AnnotationAssertion(dcterms:description goldbook:T06441 "Transferability assumes invariance of properties, associated conceptually with an atom or a fragment present in a variety of molecules. The property, such as electronegativity, nucleophilicity, NMR chemical shift, etc. is held as retaining a similar value in all these occurrences.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06441 goldbook:C01036)
AnnotationAssertion(rdfs:seeAlso goldbook:T06441 goldbook:E01990)
AnnotationAssertion(rdfs:seeAlso goldbook:T06441 goldbook:N04251)
AnnotationAssertion(mito:isMentionedBy goldbook:T06441 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06441 "current"^^xsd:string)
Declaration(Class(goldbook:T06442))
AnnotationAssertion(rdfs:label goldbook:T06442 "transfer activity coefficient")
AnnotationAssertion(dcterms:description goldbook:T06442 "A term used to quantify the difference in the free energy of a solute ion in two different standard states often in two different liquid phases. The relationship is \\(\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}} =  u \\ R\\ T\\ \\ln \\mathit{\\gamma}_{\\rm{t}}\\) where \\(\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}}\\) is the transfer Gibbs energy and \\( u \\) is the number of ions in the solute.")
AnnotationAssertion(rdfs:comment goldbook:T06442 "It should not be confused with the mass transfer coefficient which represents the specific rate of transfer of a species from one phase to another."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:T06442 "It does not necessarily imply the physical transfer of a solute between two liquid phases."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:T06442 goldbook:C01124)
AnnotationAssertion(rdfs:seeAlso goldbook:T06442 goldbook:F02515)
AnnotationAssertion(rdfs:seeAlso goldbook:T06442 goldbook:P04438)
AnnotationAssertion(mito:isMentionedBy goldbook:T06442 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06442 "current"^^xsd:string)
Declaration(Class(goldbook:T06443))
AnnotationAssertion(rdfs:label goldbook:T06443 "transferases")
AnnotationAssertion(dcterms:description goldbook:T06443 "Enzymes that catalyse reactions in which a group is transferred from one compound to another. Groups that are transferred are $\\ce{C}$, aldehydic or ketonic residues, acyl, glycosyl, alkyl, nitrogenous, phosphorus and sulfur containing groups.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06443 goldbook:E02159)
AnnotationAssertion(mito:isMentionedBy goldbook:T06443 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06443 "current"^^xsd:string)
Declaration(Class(goldbook:T06444))
AnnotationAssertion(rdfs:label goldbook:T06444 "transfer line")
AnnotationAssertion(dcterms:description goldbook:T06444 "Line provided to carry the sample to be analysed from the sample point to the analytical unit without altering the composition of the sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:T06444 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06444 "current"^^xsd:string)
Declaration(Class(goldbook:T06445))
AnnotationAssertion(rdfs:label goldbook:T06445 "transfer RNA")
AnnotationAssertion(dcterms:description goldbook:T06445 "A single-stranded RNA molecule containing about 70-90 nucleotides, folded by intrastrand base pairing into a characteristic secondary ('cloverleaf') structure that carries a specific amino acid and matches it to its corresponding codon on an mRNA during protein synthesis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:T06445 "tRNA")
AnnotationAssertion(rdfs:seeAlso goldbook:T06445 goldbook:R05386)
AnnotationAssertion(rdfs:seeAlso goldbook:T06445 goldbook:B00607)
AnnotationAssertion(rdfs:seeAlso goldbook:T06445 goldbook:C01123)
AnnotationAssertion(rdfs:seeAlso goldbook:T06445 goldbook:M03857)
AnnotationAssertion(rdfs:seeAlso goldbook:T06445 goldbook:N04255)
AnnotationAssertion(mito:isMentionedBy goldbook:T06445 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:T06445 "current"^^xsd:string)
Declaration(Class(goldbook:T06446))
AnnotationAssertion(rdfs:label goldbook:T06446 "transformation")
AnnotationAssertion(dcterms:description goldbook:T06446 "The conversion of a substrate into a particular product, irrespective of reagents or mechanisms involved. For example, the transformation of aniline ($\\ce{C6H5NH2}$) into N-phenylacetamide ($\\ce{C6H5NHCOCH3}$) may be effected by use of acetyl chloride or acetic anhydride or ketene. A transformation is distinct from a reaction, the full description of which would state or imply all the reactants and all the products.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06446 goldbook:M03804)
AnnotationAssertion(rdfs:seeAlso goldbook:T06446 goldbook:S06082)
