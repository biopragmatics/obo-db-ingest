Declaration(Class(goldbook:15499))
AnnotationAssertion(rdfs:label goldbook:15499 "Bateman function")
AnnotationAssertion(dcterms:description goldbook:15499 "Equation expressing the build up and decay in concentration of a substance (usually in plasma) based on first-order uptake and elimination in a one-compartment model, having the form \\[C = [fDk_{\\rm{a}}/V(k_{\\rm{a}} - k_{\\rm{e}})] [\\exp(-k_{\\rm{e}}t) - \\exp(-k_{\\rm{a}}t)] \\]where \\(C\\) is the concentration and \\(D\\) the dose of the substance, \\(f\\) the fraction absorbed, and \\(V\\) the volume of distribution. \\(k_{\\rm{a}}\\) and \\(k_{\\rm{e}}\\) are the first-order rate constants of uptake and elimination, respectively, and \\(t\\) is time.")
Declaration(Class(goldbook:15500))
AnnotationAssertion(rdfs:label goldbook:15500 "benchmark guidance value")
AnnotationAssertion(dcterms:description goldbook:15500 "Biological monitoring guidance value set at the \\(90^{\\rm{th}}\\) percentile of available biological monitoring results collected from a representative sample of workplaces with good occupational hygiene practices.")
Declaration(Class(goldbook:15501))
AnnotationAssertion(rdfs:label goldbook:15501 "benchmark response")
AnnotationAssertion(dcterms:description goldbook:15501 "Response, expressed as an excess of background, at which a benchmark dose or benchmark concentration is set.")
Declaration(Class(goldbook:15502))
AnnotationAssertion(rdfs:label goldbook:15502 "benign")
AnnotationAssertion(dcterms:description goldbook:15502 """Of a disease, producing no persisting harmful effects.
Tumor that does not invade other tissues (see metastasis ), having lost growth control but not positional control.Note: Such a tumor is not carcinogenic but may cause mechanical damage to adjacent tissues.""")
Declaration(Class(goldbook:15503))
AnnotationAssertion(rdfs:label goldbook:15503 "beryllium disease")
AnnotationAssertion(dcterms:description goldbook:15503 "Serious and usually permanent lung damage resulting from chronic inhalation of beryllium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15503 "berylliosis")
Declaration(Class(goldbook:15504))
AnnotationAssertion(rdfs:label goldbook:15504 "biased sample")
AnnotationAssertion(dcterms:description goldbook:15504 "Any sample that is not a random sample.")
Declaration(Class(goldbook:15505))
AnnotationAssertion(rdfs:label goldbook:15505 "bilirubin")
AnnotationAssertion(dcterms:description goldbook:15505 "Orange-yellow pigment, a breakdown product of heme-containing proteins (hemoglobin, myoglobin, cytochromes), which circulates in the blood plasma bound to albumin or as water-soluble glucuronide conjugates, and is excreted in the bile by the liver.")
Declaration(Class(goldbook:15506))
AnnotationAssertion(rdfs:label goldbook:15506 "bioaccumulation potential")
AnnotationAssertion(dcterms:description goldbook:15506 "Ability of living organisms to concentrate a substance obtained either directly from the environment or indirectly through its food.")
Declaration(Class(goldbook:15507))
AnnotationAssertion(rdfs:label goldbook:15507 "biochemical mechanism")
AnnotationAssertion(dcterms:description goldbook:15507 "Reaction or series of reactions, usually enzyme-catalyzed, associated with a specific physiological event in a living organism.")
Declaration(Class(goldbook:15508))
AnnotationAssertion(rdfs:label goldbook:15508 "bioelimination")
AnnotationAssertion(dcterms:description goldbook:15508 "Removal, usually from the aqueous phase, of a test substance in the presence of living organisms by biological processes supplemented by physicochemical reactions.")
Declaration(Class(goldbook:15509))
AnnotationAssertion(rdfs:label goldbook:15509 "bioinactivation")
AnnotationAssertion(dcterms:description goldbook:15509 "Metabolic conversion of a xenobiotic to a less toxic derivative.")
Declaration(Class(goldbook:15510))
AnnotationAssertion(rdfs:label goldbook:15510 "biokinetics")
AnnotationAssertion(dcterms:description goldbook:15510 "Science of the movements involved in the distribution of substances.")
Declaration(Class(goldbook:15511))
AnnotationAssertion(rdfs:label goldbook:15511 "biological cycle")
AnnotationAssertion(dcterms:description goldbook:15511 "Complete circulatory process through which a substance passes in the biosphere. It may involve transport through the various media (air, water, soil), followed by environmental transformation, and carriage through various ecosystems.")
Declaration(Class(goldbook:15512))
AnnotationAssertion(rdfs:label goldbook:15512 "biological preparation")
AnnotationAssertion(dcterms:description goldbook:15512 "Compound derived from living organisms and their products for use in medicine or as a pesticide, etc.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15512 "biopreparation")
Declaration(Class(goldbook:15513))
AnnotationAssertion(rdfs:label goldbook:15513 "biological specimen")
AnnotationAssertion(dcterms:description goldbook:15513 """Organ, tissue (including blood), secretion, or excretion product taken from an organism as a sample reflecting the state of the whole organism.
Organism taken as a sample reflecting the state of a population or their environment.""")
Declaration(Class(goldbook:15514))
AnnotationAssertion(rdfs:label goldbook:15514 "biological warfare")
AnnotationAssertion(dcterms:description goldbook:15514 "Military operations using any organism (bacteria, virus, or other disease-causing organism) or toxin found in nature, to kill, injure, or incapacitate human beings, animals, or plants.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15514 "germ warfare")
Declaration(Class(goldbook:15515))
AnnotationAssertion(rdfs:label goldbook:15515 "biopsy")
AnnotationAssertion(dcterms:description goldbook:15515 "Excision of a small piece of living tissue for microscopic or biochemical examination; usually performed to establish a diagnosis.")
Declaration(Class(goldbook:15516))
AnnotationAssertion(rdfs:label goldbook:15516 "biostatic")
AnnotationAssertion(dcterms:description goldbook:15516 "Adjective applied to a substance that arrests the growth or multiplication of living organisms.")
Declaration(Class(goldbook:15517))
AnnotationAssertion(rdfs:label goldbook:15517 "biota")
AnnotationAssertion(dcterms:description goldbook:15517 "All living organisms as a totality.")
Declaration(Class(goldbook:15518))
AnnotationAssertion(rdfs:label goldbook:15518 "2,3-bis(sulfanyl)propan-1-ol")
AnnotationAssertion(dcterms:description goldbook:15518 "Metal chelator that has been used in the treatment of arsenic, antimony, gold, mercury, and lead poisoning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15518 "2")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15518 "3-dimercaptopropan-1-ol")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15518 "British anti-Lewisite")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15518 "dimercaprol")
Declaration(Class(goldbook:15519))
AnnotationAssertion(rdfs:label goldbook:15519 "bolus")
AnnotationAssertion(dcterms:description goldbook:15519 """Single dose of a substance, originally a large pill.
Dose of a substance administered by a single rapid intravenous injection.
Concentrated mass of food ready to be swallowed.""")
Declaration(Class(goldbook:15520))
AnnotationAssertion(rdfs:label goldbook:15520 "botanical pesticide")
AnnotationAssertion(dcterms:description goldbook:15520 "Substance with activity against pests, that is produced naturally within a plant and may act as a defense against predators.")
Declaration(Class(goldbook:15521))
AnnotationAssertion(rdfs:label goldbook:15521 "botulism")
AnnotationAssertion(dcterms:description goldbook:15521 "Acute food poisoning caused by botulinum toxin produced in food by the bacterium Clostridium botulinum and characterized by muscle weakness and paralysis; disturbances of vision, swallowing, and speech; and a high mortality rate.")
Declaration(Class(goldbook:15522))
AnnotationAssertion(rdfs:label goldbook:15522 "brady-")
AnnotationAssertion(dcterms:description goldbook:15522 "Prefix meaning slow as in bradycardia or bradypnoea.")
Declaration(Class(goldbook:15523))
AnnotationAssertion(rdfs:label goldbook:15523 "bradypnoea")
AnnotationAssertion(dcterms:description goldbook:15523 "Abnormally slow breathing.")
Declaration(Class(goldbook:15524))
AnnotationAssertion(rdfs:label goldbook:15524 "breathing zone")
AnnotationAssertion(dcterms:description goldbook:15524 "Space within a radius of \\(\\pu{0.5 m}\\) from a person’s face.")
Declaration(Class(goldbook:15525))
AnnotationAssertion(rdfs:label goldbook:15525 "bronchoconstriction")
AnnotationAssertion(dcterms:description goldbook:15525 "Narrowing of the air passages through the bronchi of the lungs.")
Declaration(Class(goldbook:15526))
AnnotationAssertion(rdfs:label goldbook:15526 "bronchodilation")
AnnotationAssertion(dcterms:description goldbook:15526 "Expansion of the air passages through the bronchi of the lungs.")
Declaration(Class(goldbook:15527))
AnnotationAssertion(rdfs:label goldbook:15527 "bronchospasm")
AnnotationAssertion(dcterms:description goldbook:15527 "Intermittent violent contraction of the air passages of the lungs.")
Declaration(Class(goldbook:15528))
AnnotationAssertion(rdfs:label goldbook:15528 "builder")
AnnotationAssertion(dcterms:description goldbook:15528 "Material that enhances or maintains the cleaning efficiency of a surfactant, in a detergent, principally by inactivating water hardness; complex phosphates (especially sodium tripolyphosphate, i.e., pentasodium triphosphate), sodium carbonate, and sodium silicate are the builders most commonly used.")
Declaration(Class(goldbook:15529))
AnnotationAssertion(rdfs:label goldbook:15529 "byssinosis")
AnnotationAssertion(dcterms:description goldbook:15529 "Pneumoconiosis caused by inhalation of dust and associated microbial contaminants and observed in cotton, flax, and hemp workers.")
Declaration(Class(goldbook:15530))
AnnotationAssertion(rdfs:label goldbook:15530 "bystander exposure")
AnnotationAssertion(dcterms:description goldbook:15530 "Liability of members of the general public to come in contact with substances arising from operations or processes carried out by other individuals in their vicinity.")
Declaration(Class(goldbook:15531))
AnnotationAssertion(rdfs:label goldbook:15531 "cacosmia")
AnnotationAssertion(dcterms:description goldbook:15531 "Imagined perception of vile odors, including coprosmia (smelling feces) and necrosmia (the smell of death).")
Declaration(Class(goldbook:15532))
AnnotationAssertion(rdfs:label goldbook:15532 "calcification")
AnnotationAssertion(dcterms:description goldbook:15532 "Form of mineralization in which organic tissue becomes hardened by deposition of calcium salts within its substance.")
Declaration(Class(goldbook:15533))
AnnotationAssertion(rdfs:label goldbook:15533 "carbonylhemoglobin")
AnnotationAssertion(dcterms:description goldbook:15533 "Compound that is formed between carbon monoxide and hemoglobin in the blood of animals and humans and is incapable of transporting oxygen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15533 "carboxyhemoglobin")
Declaration(Class(goldbook:15534))
AnnotationAssertion(rdfs:label goldbook:15534 "carcinogenicity test")
AnnotationAssertion(dcterms:description goldbook:15534 "Long-term (chronic) test designed to detect any possible carcinogenic effect of a test substance.")
Declaration(Class(goldbook:15535))
AnnotationAssertion(rdfs:label goldbook:15535 "cardiotoxic")
AnnotationAssertion(dcterms:description goldbook:15535 "Chemically harmful to the cells of the heart.")
Declaration(Class(goldbook:15536))
AnnotationAssertion(rdfs:label goldbook:15536 "carrier-linked prodrug")
AnnotationAssertion(dcterms:description goldbook:15536 "Compound that contains a temporary linkage between a given active substance and a transient carrier group, the latter producing improved physicochemical or pharmacokinetic properties and easily removable in vivo.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15536 "carrier prodrug")
Declaration(Class(goldbook:15537))
AnnotationAssertion(rdfs:label goldbook:15537 "carrier substance")
AnnotationAssertion(dcterms:description goldbook:15537 "Substance that binds to another substance and transfers it from one site to another.")
Declaration(Class(goldbook:15538))
AnnotationAssertion(rdfs:label goldbook:15538 "case cohort study")
AnnotationAssertion(dcterms:description goldbook:15538 "Variant of the case control study in which the controls are drawn from the same cohort as the cases but are identified before the cases develop; some of the controls may later become cases.")
Declaration(Class(goldbook:15539))
AnnotationAssertion(rdfs:label goldbook:15539 "case control study")
AnnotationAssertion(dcterms:description goldbook:15539 "Study that starts with the identification of persons with the disease (or other outcome variable) of interest, and a suitable control (comparison, reference) group of persons without the disease. The relationship of an attribute to the disease is examined by comparing the diseased and non-diseased with regard to how frequently the attribute is present or, if quantitative, the levels of the attribute, in the two groups.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15539 "case comparison study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15539 "case compeer study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15539 "case history study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15539 "case referent study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15539 "retrospective study")
Declaration(Class(goldbook:15540))
AnnotationAssertion(rdfs:label goldbook:15540 "catatonia")
AnnotationAssertion(dcterms:description goldbook:15540 "Behavior marked by excessive and sometimes violent motor activity and excitement, or by generalized inhibition or stupor, that may occur in schizophrenia, mood disorders, or organic brain syndromes.")
Declaration(Class(goldbook:15541))
AnnotationAssertion(rdfs:label goldbook:15541 "cell cycle")
AnnotationAssertion(dcterms:description goldbook:15541 "Regulated biochemical steps that cells go through involving DNA replication and cell division, usually depicted as a sequential cyclical series of events.")
Declaration(Class(goldbook:15542))
AnnotationAssertion(rdfs:label goldbook:15542 "cell-mediated hypersensitivity")
AnnotationAssertion(dcterms:description goldbook:15542 "State in which an individual reacts with allergic effects caused by the reaction of antigen-specific T-lymphocytes following exposure to a certain substance (allergen) after having been exposed previously to the same substance or chemical group.")
Declaration(Class(goldbook:15543))
AnnotationAssertion(rdfs:label goldbook:15543 "cell proliferation")
AnnotationAssertion(dcterms:description goldbook:15543 "Rapid increase in cell number.")
Declaration(Class(goldbook:15544))
AnnotationAssertion(rdfs:label goldbook:15544 "cell strain")
AnnotationAssertion(dcterms:description goldbook:15544 "Cells having specific properties or markers derived from a primary culture or cell line.")
Declaration(Class(goldbook:15545))
AnnotationAssertion(rdfs:label goldbook:15545 "censored data")
AnnotationAssertion(dcterms:description goldbook:15545 "Sample observations for which the complete distribution is not known.")
Declaration(Class(goldbook:15546))
AnnotationAssertion(rdfs:label goldbook:15546 "certified reference material")
AnnotationAssertion(dcterms:description goldbook:15546 "Reference material, accompanied by documentation issued by an authoritative body and referring to valid procedures used to obtain a specified property value with uncertainty and traceability.")
Declaration(Class(goldbook:15547))
AnnotationAssertion(rdfs:label goldbook:15547 "chain of custody")
AnnotationAssertion(dcterms:description goldbook:15547 "Sequence of responsibility for a substance from the manufacturer to the distributor, to the user, or to the person(s) ultimately responsible for waste disposal. This term is also used in controlled transmission of samples from collection to analysis, especially of samples of materials used for medico-legal or forensic purposes.")
Declaration(Class(goldbook:15548))
AnnotationAssertion(rdfs:label goldbook:15548 "chelation therapy")
AnnotationAssertion(dcterms:description goldbook:15548 "Treatment with a chelating agent to enhance the elimination or reduce the toxicity of a metal ion.")
Declaration(Class(goldbook:15549))
AnnotationAssertion(rdfs:label goldbook:15549 "chemesthesis")
AnnotationAssertion(dcterms:description goldbook:15549 "Sensations that arise when chemical compounds activate receptor mechanisms for other effectors, such as light, pain, pressure, and heat, in the eye, skin, nose, mouth, and throat; for example, the burning feeling from chili pepper, the cooling from the menthol in mouthwash, and the stinging feeling of carbonation.")
Declaration(Class(goldbook:15550))
AnnotationAssertion(rdfs:label goldbook:15550 "chemical conversion")
AnnotationAssertion(dcterms:description goldbook:15550 "Change from one chemical species to another.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15550 "conversion")
Declaration(Class(goldbook:15551))
AnnotationAssertion(rdfs:label goldbook:15551 "chemical safety")
AnnotationAssertion(dcterms:description goldbook:15551 "Practical certainty that there will be no exposure of organisms to toxic amounts of any substance or group of substances: This implies attaining an acceptably low risk of exposure to potentially toxic substances.")
Declaration(Class(goldbook:15552))
AnnotationAssertion(rdfs:label goldbook:15552 "chemical warfare")
AnnotationAssertion(dcterms:description goldbook:15552 "Military operations using the toxic properties of chemical agents to kill, injure, or incapacitate human beings, animals, or plants.")
Declaration(Class(goldbook:15553))
AnnotationAssertion(rdfs:label goldbook:15553 "chemophobia")
AnnotationAssertion(dcterms:description goldbook:15553 "Irrational fear of chemicals.")
Declaration(Class(goldbook:15554))
AnnotationAssertion(rdfs:label goldbook:15554 "chemosis")
AnnotationAssertion(dcterms:description goldbook:15554 "Chemically induced swelling around the eye caused by edema of the conjunctiva.")
Declaration(Class(goldbook:15555))
AnnotationAssertion(rdfs:label goldbook:15555 "chemosteriliser")
AnnotationAssertion(dcterms:description goldbook:15555 "Substance used to sterilize mites, insects, rodents, or other animals.")
Declaration(Class(goldbook:15556))
AnnotationAssertion(rdfs:label goldbook:15556 "cholinesterase inhibitor")
AnnotationAssertion(dcterms:description goldbook:15556 "Substance that inhibits the action of acetylcholinesterase (EC 3.1.1.7) and related enzymes which catalyze the hydrolysis of choline esters: Such a substance causes hyperactivity in parasympathetic nerves.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15556 "anticholinesterase")
Declaration(Class(goldbook:15557))
AnnotationAssertion(rdfs:label goldbook:15557 "chromatin")
AnnotationAssertion(dcterms:description goldbook:15557 "Stainable complex of DNA and proteins present in the nucleus of a eukaryotic cell.")
Declaration(Class(goldbook:15558))
AnnotationAssertion(rdfs:label goldbook:15558 "chromosomal aberration")
AnnotationAssertion(dcterms:description goldbook:15558 "Abnormality of chromosome number or structure.")
Declaration(Class(goldbook:15559))
AnnotationAssertion(rdfs:label goldbook:15559 "chronic toxicity test")
AnnotationAssertion(dcterms:description goldbook:15559 "Study in which organisms are observed during the greater part of the life span and in which exposure to the test agent takes place over the whole observation time or a substantial part thereof.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15559 "long-term toxicity test")
Declaration(Class(goldbook:15560))
AnnotationAssertion(rdfs:label goldbook:15560 "chronotoxicology")
AnnotationAssertion(dcterms:description goldbook:15560 "Study of the influence of biological rhythms on the toxicity of substances or of the influence of a toxicant on biological rhythms.")
Declaration(Class(goldbook:15561))
AnnotationAssertion(rdfs:label goldbook:15561 "ciguateratoxin poisoning")
AnnotationAssertion(dcterms:description goldbook:15561 "Serious illness caused by eating carnivorous fish such as snappers and barracuda that have become contaminated by toxins produced by the microalga, Gambierdiscus toxicus; gastrointestinal symptoms may accompany a wide variety of neurological symptoms, including ataxia, vertigo, flaccid paralysis, respiratory arrest, and reversed perception of hot and cold; the neurological symptoms may persist for many years.")
Declaration(Class(goldbook:15562))
AnnotationAssertion(rdfs:label goldbook:15562 "circadian")
AnnotationAssertion(dcterms:description goldbook:15562 "Relating to or exhibiting an approximately \\(\\pu{24\\!\\mbox{-}h}\\) periodicity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15562 "nychthemeral")
Declaration(Class(goldbook:15563))
AnnotationAssertion(rdfs:label goldbook:15563 "circulation of substances")
AnnotationAssertion(dcterms:description goldbook:15563 "Movement of xenobiotic substances in the environment with air flow, river current, sediment flow, etc.")
Declaration(Class(goldbook:15564))
AnnotationAssertion(rdfs:label goldbook:15564 "cirrhosis")
AnnotationAssertion(dcterms:description goldbook:15564 """Liver disease defined by histological examination and characterized by increased fibrous tissue, abnormal morphological and physiological changes such as loss of functional liver cells, and increased resistance to blood flow through the liver (portal hypertension).
Chronic interstitial inflammation and fibrosis of an organ.""")
Declaration(Class(goldbook:15565))
AnnotationAssertion(rdfs:label goldbook:15565 "cirrhotic")
AnnotationAssertion(dcterms:description goldbook:15565 "Describing an organ showing cirrhosis.")
Declaration(Class(goldbook:15566))
AnnotationAssertion(rdfs:label goldbook:15566 "clastogenesis")
AnnotationAssertion(dcterms:description goldbook:15566 "Formation (or generation) of chromosomal breaks and (or) consequent gain, loss, or rearrangement of pieces of chromosomes.")
Declaration(Class(goldbook:15567))
AnnotationAssertion(rdfs:label goldbook:15567 "clinical toxicology")
AnnotationAssertion(dcterms:description goldbook:15567 "Scientific study involving research, education, prevention, and treatment of diseases caused by substances such as drugs and toxins.")
Declaration(Class(goldbook:15568))
AnnotationAssertion(rdfs:label goldbook:15568 "clonic")
AnnotationAssertion(dcterms:description goldbook:15568 "Pertaining to alternate muscular contraction and relaxation in rapid succession.")
Declaration(Class(goldbook:15569))
AnnotationAssertion(rdfs:label goldbook:15569 "cluster sampling")
AnnotationAssertion(dcterms:description goldbook:15569 """A method of sampling in which the population is divided into aggregates (or clusters) of items bound together in a certain manner. A sample of these clusters is taken at random, and all the items which constitute them are included in the sample.
A sampling method in which each unit selected is a group of persons (all persons in a city block, a family, etc.) rather than an individual.""")
Declaration(Class(goldbook:15570))
AnnotationAssertion(rdfs:label goldbook:15570 "cocarcinogen")
AnnotationAssertion(dcterms:description goldbook:15570 "Chemical, physical, or biological factor that intensifies the effect of a carcinogen.")
Declaration(Class(goldbook:15571))
AnnotationAssertion(rdfs:label goldbook:15571 "Codex Alimentarius")
AnnotationAssertion(dcterms:description goldbook:15571 "Collection of internationally adopted food standards drawn up by the Codex Alimentarius Commission, the principal body implementing the joint FAO/WHO Food Standards Program.")
Declaration(Class(goldbook:15572))
AnnotationAssertion(rdfs:label goldbook:15572 "cohort")
AnnotationAssertion(dcterms:description goldbook:15572 "Component of the population born during a particular period and identified by period of birth so that its characteristics (such as causes of death and numbers still living) can be ascertained as it enters successive time and age periods. The term 'cohort' has broadened to describe any designated group of persons followed or traced over a period of time, as in the term cohort study (prospective study).")
Declaration(Class(goldbook:15573))
AnnotationAssertion(rdfs:label goldbook:15573 "cohort analysis")
AnnotationAssertion(dcterms:description goldbook:15573 "Tabulation and analysis of morbidity or mortality rates in relationship to the ages of a specific group of people (cohort), identified by their birth period, and followed as they pass through different ages during part or all of their life span. In certain circumstances such as studies of migrant populations, cohort analysis may be performed according to duration of residence in a country rather than year of birth, in order to relate health or mortality experience to duration of exposure.")
Declaration(Class(goldbook:15574))
AnnotationAssertion(rdfs:label goldbook:15574 "cohort study")
AnnotationAssertion(dcterms:description goldbook:15574 "Analytic study in epidemiology in which subsets of a defined population can be identified who are, have been, or in the future may be exposed or not exposed, or exposed in different degrees, to a factor or factors hypothesized to influence the probability of occurrence of a given disease or other outcome. The main feature of the method is observation of a large population for a prolonged period (years), with comparison of incidence rates of the given disease in groups that differ in exposure levels.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15574 "concurrent study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15574 "follow-up study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15574 "incidence study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15574 "longitudinal study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15574 "prospective study")
Declaration(Class(goldbook:15575))
AnnotationAssertion(rdfs:label goldbook:15575 "combined effect of poisons")
AnnotationAssertion(dcterms:description goldbook:15575 "Simultaneous or successive effect of two or more poisons on the organism by the same route of exposure.")
Declaration(Class(goldbook:15576))
AnnotationAssertion(rdfs:label goldbook:15576 "comet assay")
AnnotationAssertion(dcterms:description goldbook:15576 "Means of measuring DNA damage, particularly DNA strand breaks. A cell is embedded in agar and exposed to a DNA-damaging agent. The cell is then permeabilized with a detergent, and an electric field is applied. If the cell’s genomic DNA has been broken into small fragments, these fragments move out of the cell by electrophoresis and form a streak or 'tail' leading away from the cell which looks like a comet.")
Declaration(Class(goldbook:15577))
AnnotationAssertion(rdfs:label goldbook:15577 "comparative genomics")
AnnotationAssertion(dcterms:description goldbook:15577 "Study of the relationship of genome structure and function across different biological species.")
Declaration(Class(goldbook:15578))
AnnotationAssertion(rdfs:label goldbook:15578 "compartmentalise")
AnnotationAssertion(dcterms:description goldbook:15578 "Separate into compartments.")
Declaration(Class(goldbook:15579))
AnnotationAssertion(rdfs:label goldbook:15579 "competent authority")
AnnotationAssertion(dcterms:description goldbook:15579 "In the context of European Community Council Directive 79/831/EEC, the Sixth Amendment to the European Community Council Directive 67/548/EEC relating to the Classification, Packaging and Labeling of Dangerous Substances, official government organization or group receiving and evaluating notifications of new substances.")
Declaration(Class(goldbook:15580))
AnnotationAssertion(rdfs:label goldbook:15580 "competent bacteria")
AnnotationAssertion(dcterms:description goldbook:15580 "Culture of bacteria (or yeast) treated in such a way that their ability to take up DNA molecules without transduction or conjugation has been enhanced.")
Declaration(Class(goldbook:15581))
AnnotationAssertion(rdfs:label goldbook:15581 "complete mineralisation")
AnnotationAssertion(dcterms:description goldbook:15581 "Complete breakdown of a complex organic compound to carbon dioxide, water, oxides, and oxidative inorganic products such as nitrate or sulfate.")
Declaration(Class(goldbook:15582))
AnnotationAssertion(rdfs:label goldbook:15582 "comprehensive effect of poisons")
AnnotationAssertion(dcterms:description goldbook:15582 "Simultaneous or successive effect made on an organism by poisons entering from different media, air, water, or food or through the skin.")
Declaration(Class(goldbook:15583))
AnnotationAssertion(rdfs:label goldbook:15583 "computational toxicology")
AnnotationAssertion(dcterms:description goldbook:15583 "Application of mathematical and computer models to predict adverse effects and to better understand the mechanism(s) through which a given chemical causes harm.")
Declaration(Class(goldbook:15584))
AnnotationAssertion(rdfs:label goldbook:15584 "concentration–effect curve")
AnnotationAssertion(dcterms:description goldbook:15584 "Graph of the relation between exposure concentration and the magnitude of the resultant biological change.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15584 "exposure–effect curve")
Declaration(Class(goldbook:15585))
AnnotationAssertion(rdfs:label goldbook:15585 "concentration–effect relationship")
AnnotationAssertion(dcterms:description goldbook:15585 "Association between exposure concentration and the resultant magnitude of the continuously graded change produced, either in an individual or in a population.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15585 "exposure–effect relationship")
Declaration(Class(goldbook:15586))
AnnotationAssertion(rdfs:label goldbook:15586 "concurrent validity")
AnnotationAssertion(dcterms:description goldbook:15586 "Measurement and its criterion refer to the same point in time.")
Declaration(Class(goldbook:15587))
AnnotationAssertion(rdfs:label goldbook:15587 "confounding")
AnnotationAssertion(dcterms:description goldbook:15587 """Situation in which the effects of two processes are not distinguishable from one another: The distortion of the apparent effect of an exposure on risk brought about by the association of other factors which can influence the outcome.
Relationship between the effects of two or more causal factors as observed in a set of data, such that it is not logically possible to separate the contribution which any single causal factor has made to an effect.
Situation in which a measure of the effect of an exposure on risk is distorted because of the association of exposure with other factor(s) which influence the outcome under study.""")
Declaration(Class(goldbook:15588))
AnnotationAssertion(rdfs:label goldbook:15588 "confounding variable")
AnnotationAssertion(dcterms:description goldbook:15588 "Changing factor that can cause or prevent the outcome of interest, is not an intermediate variable, and is associated with the factor under investigation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15588 "confounder")
Declaration(Class(goldbook:15589))
AnnotationAssertion(rdfs:label goldbook:15589 "conjunctiva")
AnnotationAssertion(dcterms:description goldbook:15589 "Mucous membrane that covers the eyeball and lines the under-surface of the eyelid.")
Declaration(Class(goldbook:15590))
AnnotationAssertion(rdfs:label goldbook:15590 "conjunctivitis")
AnnotationAssertion(dcterms:description goldbook:15590 "Inflammation of the conjunctiva.")
Declaration(Class(goldbook:15591))
AnnotationAssertion(rdfs:label goldbook:15591 "conservative assessment of risk")
AnnotationAssertion(dcterms:description goldbook:15591 "Assessment of risk that assumes the worst possible case scenario and therefore gives the highest possible value for risk: Risk management decisions based on this value will maximize safety.")
Declaration(Class(goldbook:15592))
AnnotationAssertion(rdfs:label goldbook:15592 "construct validity")
AnnotationAssertion(dcterms:description goldbook:15592 "Extent to which a measurement corresponds to theoretical concepts (constructs) concerning the phenomenon under study; for example, if on theoretical grounds, the phenomenon should change with age, a measurement with construct validity would reflect such a change.")
Declaration(Class(goldbook:15593))
AnnotationAssertion(rdfs:label goldbook:15593 "contact poison")
AnnotationAssertion(dcterms:description goldbook:15593 """Chemical that injures the target organism through physical contact and skin absorption rather than through ingestion or inhalation.
Pesticide (herbicide) that causes injury to only the plant tissue to which it is applied or which is not appreciably translocated within plants.""")
Declaration(Class(goldbook:15594))
AnnotationAssertion(rdfs:label goldbook:15594 "containment")
AnnotationAssertion(dcterms:description goldbook:15594 "Process by which possible release, discharge, or spill of a toxic substance during normal use or after an accident is prevented by appropriate action.")
Declaration(Class(goldbook:15595))
AnnotationAssertion(rdfs:label goldbook:15595 "content validity")
AnnotationAssertion(dcterms:description goldbook:15595 "Extent to which the measurement incorporates the domain of the phenomenon under study; for example, a measurement of functional health status should embrace activities of daily living, occupational, family, and social functioning, etc.")
Declaration(Class(goldbook:15596))
AnnotationAssertion(rdfs:label goldbook:15596 "contraindication")
AnnotationAssertion(dcterms:description goldbook:15596 "Any condition that renders some particular line of treatment improper or undesirable.")
Declaration(Class(goldbook:15597))
AnnotationAssertion(rdfs:label goldbook:15597 "control group")
AnnotationAssertion(dcterms:description goldbook:15597 "Selected subjects of study, identified as a rule before a study is done, which comprises humans, animals, or other species who do not have the disease, intervention, procedure, or whatever is being studied, but in all other respects are as nearly identical to the test group as possible.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15597 "comparison group")
Declaration(Class(goldbook:15598))
AnnotationAssertion(rdfs:label goldbook:15598 "matched control")
AnnotationAssertion(dcterms:description goldbook:15598 "Control (individual or group or case) selected to be similar to a study individual or group, or case, in specific characteristics: some commonly used matching variables are age, sex, race, and socioeconomic status.")
Declaration(Class(goldbook:15599))
AnnotationAssertion(rdfs:label goldbook:15599 "core grade")
AnnotationAssertion(dcterms:description goldbook:15599 "Quality rating, based on standard evaluation criteria established by the U.S. Office of Pesticide Programs regulatory agencies, given to toxicological studies after submission by registrants.")
Declaration(Class(goldbook:15600))
AnnotationAssertion(rdfs:label goldbook:15600 "count mean diameter")
AnnotationAssertion(dcterms:description goldbook:15600 "Mean of the diameters of all particles in a population.")
Declaration(Class(goldbook:15601))
AnnotationAssertion(rdfs:label goldbook:15601 "count median diameter")
AnnotationAssertion(dcterms:description goldbook:15601 "Calculated diameter in a population of particles in a gas or liquid phase above which there are as many particles with larger diameters as there are particles below it with smaller diameters.")
Declaration(Class(goldbook:15602))
AnnotationAssertion(rdfs:label goldbook:15602 "crepitations")
AnnotationAssertion(dcterms:description goldbook:15602 "Abnormal respiratory sounds heard on auscultation of the chest, produced by passage of air through passages which contain secretion or exudate or which are constricted by spasm or a thickening of their walls.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15602 "crackles")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15602 "râles")
Declaration(Class(goldbook:15603))
AnnotationAssertion(rdfs:label goldbook:15603 "criterion")
AnnotationAssertion(dcterms:description goldbook:15603 "Validated set of data used as a basis for judgment.")
Declaration(Class(goldbook:15604))
AnnotationAssertion(rdfs:label goldbook:15604 "criterion validity")
AnnotationAssertion(dcterms:description goldbook:15604 "Extent to which the measurement correlates with an external criterion of the phenomenon under study.")
Declaration(Class(goldbook:15605))
AnnotationAssertion(rdfs:label goldbook:15605 "critical concentration")
AnnotationAssertion(dcterms:description goldbook:15605 "Concentration of a substance at and above which adverse functional changes, reversible or irreversible, occur in a cell or an organ.")
Declaration(Class(goldbook:15606))
AnnotationAssertion(rdfs:label goldbook:15606 "critical dose")
AnnotationAssertion(dcterms:description goldbook:15606 "Dose of a substance at and above which adverse functional changes, reversible or irreversible, occur in a cell or an organ.")
Declaration(Class(goldbook:15607))
AnnotationAssertion(rdfs:label goldbook:15607 "critical effect")
AnnotationAssertion(dcterms:description goldbook:15607 "For deterministic effects, the first adverse effect that appears when the threshold (critical) concentration or dose is reached in the critical organ: Adverse effects with no defined threshold concentration are regarded as critical.")
Declaration(Class(goldbook:15608))
AnnotationAssertion(rdfs:label goldbook:15608 "critical end-point")
AnnotationAssertion(dcterms:description goldbook:15608 "Toxic effect used by the USEPA as the basis for a reference dose.")
Declaration(Class(goldbook:15609))
AnnotationAssertion(rdfs:label goldbook:15609 "critical group")
AnnotationAssertion(dcterms:description goldbook:15609 "Part of a target population most in need of protection because it is most susceptible to a given toxicant.")
Declaration(Class(goldbook:15610))
AnnotationAssertion(rdfs:label goldbook:15610 "critical organ")
AnnotationAssertion(dcterms:description goldbook:15610 "Organ that first attains the critical concentration of a substance and exhibits the critical effect under specified circumstances of exposure and for a given population.")
Declaration(Class(goldbook:15611))
AnnotationAssertion(rdfs:label goldbook:15611 "critical organ concentration")
AnnotationAssertion(dcterms:description goldbook:15611 "Mean concentration of a substance in the critical organ at the time the substance reaches its critical concentration in the most sensitive type of cell in the organ.")
Declaration(Class(goldbook:15612))
AnnotationAssertion(rdfs:label goldbook:15612 "cross-sectional study")
AnnotationAssertion(dcterms:description goldbook:15612 "Study that examines the relationship between diseases (or other health-related characteristics) and other variables of interest as they exist in a defined population at one particular time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15612 "disease frequency survey")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15612 "prevalence study")
Declaration(Class(goldbook:15613))
AnnotationAssertion(rdfs:label goldbook:15613 "cumulative death rate")
AnnotationAssertion(dcterms:description goldbook:15613 "Proportion of a defined group that dies within the specified time period (e.g., month, year).")
Declaration(Class(goldbook:15614))
AnnotationAssertion(rdfs:label goldbook:15614 "cumulative effect")
AnnotationAssertion(dcterms:description goldbook:15614 "Overall change that occurs after repeated doses of a substance or radiation.")
Declaration(Class(goldbook:15615))
AnnotationAssertion(rdfs:label goldbook:15615 "cumulative incidence")
AnnotationAssertion(dcterms:description goldbook:15615 "Number or proportion of individuals in a group who experience the onset of a health-related event during a specified time interval.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15615 "incidence proportion")
Declaration(Class(goldbook:15616))
AnnotationAssertion(rdfs:label goldbook:15616 "cumulative incidence rate")
AnnotationAssertion(dcterms:description goldbook:15616 "Proportion of the cumulative incidence to the total population.")
Declaration(Class(goldbook:15617))
AnnotationAssertion(rdfs:label goldbook:15617 "cumulative incidence ratio")
AnnotationAssertion(dcterms:description goldbook:15617 "Value obtained by dividing the cumulative incidence rate in the exposed population by the cumulative incidence rate in the unexposed population.")
Declaration(Class(goldbook:15618))
AnnotationAssertion(rdfs:label goldbook:15618 "cumulative median lethal dose")
AnnotationAssertion(dcterms:description goldbook:15618 "Estimate of the total administered amount of a substance that is associated with the death of half a population of animals when the substance is administered repeatedly in doses which are generally fractions of the median lethal dose.")
Declaration(Class(goldbook:15619))
AnnotationAssertion(rdfs:label goldbook:15619 "cumulative risk")
AnnotationAssertion(dcterms:description goldbook:15619 """Probability of a common harmful effect associated with concurrent exposure by all relevant pathways and routes of exposure to a group of substances that share a common chemical mechanism of toxicity.
Total probability of a harmful effect over time.""")
Declaration(Class(goldbook:15620))
AnnotationAssertion(rdfs:label goldbook:15620 "cyanotoxin")
AnnotationAssertion(dcterms:description goldbook:15620 "Toxin produced by Cyanobacteria, sometimes called blue–green algae.")
Declaration(Class(goldbook:15621))
AnnotationAssertion(rdfs:label goldbook:15621 "cyclooxygenase specific inhibitors")
AnnotationAssertion(dcterms:description goldbook:15621 "Substances, such as aspirin and ibuprofen, that block the activity of cyclooxygenase (COX), an enzyme that is responsible for the formation of prostanoids (including prostaglandins, prostacyclin, and thromboxane); inhibition of COX can provide relief from inflammation and pain.")
Declaration(Class(goldbook:15622))
AnnotationAssertion(rdfs:label goldbook:15622 "cytochrome P420")
AnnotationAssertion(dcterms:description goldbook:15622 "Inactive derivative of cytochrome P450 found in microsomal preparations.")
Declaration(Class(goldbook:15623))
AnnotationAssertion(rdfs:label goldbook:15623 "cytochrome P448")
AnnotationAssertion(dcterms:description goldbook:15623 "Obsolete term for cytochrome P450 I, A1, and A2, one of the major families of the cytochromes P450 hemoproteins.")
Declaration(Class(goldbook:15624))
AnnotationAssertion(rdfs:label goldbook:15624 "cytoplasm")
AnnotationAssertion(dcterms:description goldbook:15624 "Fundamental substance or matrix of the cell (within the plasma membrane) which surrounds the nucleus, endoplasmic reticulum, mitochondria, and other organelles.")
Declaration(Class(goldbook:15625))
AnnotationAssertion(rdfs:label goldbook:15625 "decipol")
AnnotationAssertion(dcterms:description goldbook:15625 "Unit of perceived air quality.")
Declaration(Class(goldbook:15626))
AnnotationAssertion(rdfs:label goldbook:15626 "decompensation")
AnnotationAssertion(dcterms:description goldbook:15626 "Explicit pathophysiological changes following compensation for adverse effects.")
Declaration(Class(goldbook:15627))
AnnotationAssertion(rdfs:label goldbook:15627 "decontamination")
AnnotationAssertion(dcterms:description goldbook:15627 "Process of rendering harmless (by neutralization, elimination, removal, etc.) a potentially toxic substance in the natural environment, laboratory areas, the workplace, other indoor areas, clothes, food, water, sewage, etc.")
Declaration(Class(goldbook:15628))
AnnotationAssertion(rdfs:label goldbook:15628 "dehydrogenase")
AnnotationAssertion(dcterms:description goldbook:15628 "Enzyme that catalyzes oxidation of compounds by removing hydrogen.")
Declaration(Class(goldbook:15629))
AnnotationAssertion(rdfs:label goldbook:15629 "delayed effect")
AnnotationAssertion(dcterms:description goldbook:15629 "Consequence occurring after a latent period following the end of exposure to a toxic substance or other harmful environmental factor.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15629 "latent effect")
Declaration(Class(goldbook:15630))
AnnotationAssertion(rdfs:label goldbook:15630 "dental fluorosis")
AnnotationAssertion(dcterms:description goldbook:15630 "Tooth enamel malformations due to excessive fluoride exposure during dental development.")
Declaration(Class(goldbook:15631))
AnnotationAssertion(rdfs:label goldbook:15631 "deoxyribonucleic acid cloning")
AnnotationAssertion(dcterms:description goldbook:15631 "Replication of DNA sequences ligated into a suitable vector in an appropriate host organism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15631 "DNA cloning")
Declaration(Class(goldbook:15632))
AnnotationAssertion(rdfs:label goldbook:15632 "deoxyribonucleic acid repair")
AnnotationAssertion(dcterms:description goldbook:15632 "Restoration of the molecular structure of DNA after it has been damaged by a chemical or physical agent: This may involve direct DNA damage reversal, base excision repair, nucleotide excision repair, mismatch repair, or double-strand break repair")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15632 "DNA repair")
Declaration(Class(goldbook:15633))
AnnotationAssertion(rdfs:label goldbook:15633 "dependence")
AnnotationAssertion(dcterms:description goldbook:15633 """A psychic craving for a drug or other substance that may or may not be accompanied by a physical dependency.
Reliance on a drug or other substance to maintain health.""")
Declaration(Class(goldbook:15634))
AnnotationAssertion(rdfs:label goldbook:15634 "depilatory")
AnnotationAssertion(dcterms:description goldbook:15634 "Substance causing loss of hair.")
Declaration(Class(goldbook:15635))
AnnotationAssertion(rdfs:label goldbook:15635 "dermal")
AnnotationAssertion(dcterms:description goldbook:15635 "Pertaining to the skin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15635 "cutaneous")
Declaration(Class(goldbook:15636))
AnnotationAssertion(rdfs:label goldbook:15636 "dermal irritation")
AnnotationAssertion(dcterms:description goldbook:15636 "Skin reaction resulting from a single or multiple exposure to a physical or chemical entity at the same site, characterized by the presence of inflammation; it may result in cell death.")
Declaration(Class(goldbook:15637))
AnnotationAssertion(rdfs:label goldbook:15637 "descriptive epidemiology")
AnnotationAssertion(dcterms:description goldbook:15637 "Study of the occurrence of disease or other health-related characteristics in populations, including general observations concerning the relationship of disease to basic characteristics such as age, sex, race, occupation, and social class; it may also be concerned with geographic location. The major characteristics in descriptive epidemiology can be classified under the headings: individuals, time, and place.")
Declaration(Class(goldbook:15638))
AnnotationAssertion(rdfs:label goldbook:15638 "desquamation")
AnnotationAssertion(dcterms:description goldbook:15638 "Shedding of an outer layer of skin in scales or shreds.")
Declaration(Class(goldbook:15639))
AnnotationAssertion(rdfs:label goldbook:15639 "detriment")
AnnotationAssertion(dcterms:description goldbook:15639 "Estimated measure of the expected harm or loss associated with an adverse event, usually in a manner chosen to facilitate meaningful addition over different events. It is generally the integrated product of arbitrary values of risk and hazard and is often expressed in terms such as costs in U.S. dollars, loss in expected years of life or loss in productivity, and is needed for numerical exercises such as cost-benefit analysis.")
Declaration(Class(goldbook:15640))
AnnotationAssertion(rdfs:label goldbook:15640 "developmental toxicity")
AnnotationAssertion(dcterms:description goldbook:15640 "Adverse effects on the developing organism (including structural abnormality, altered growth, or functional deficiency or death) resulting from exposure through conception, gestation (including organogenesis), and postnatally up to the time of sexual maturation.")
Declaration(Class(goldbook:15641))
AnnotationAssertion(rdfs:label goldbook:15641 "diaphoresis")
AnnotationAssertion(dcterms:description goldbook:15641 "Profuse perspiration.")
Declaration(Class(goldbook:15642))
AnnotationAssertion(rdfs:label goldbook:15642 "discharge standard")
AnnotationAssertion(dcterms:description goldbook:15642 "Maximum amount of a pollutant released from a given source to a specified medium which is acceptable under specified circumstances.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15642 "discharge release limit")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15642 "effluent standard")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15642 "emission standard")
Declaration(Class(goldbook:15643))
AnnotationAssertion(rdfs:label goldbook:15643 "discordance")
AnnotationAssertion(dcterms:description goldbook:15643 "Any difference in a character between individuals due to genetic differences such as may occur in dizygotic twins, or between matched pairs in a case cohort study.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15643 "genetic discordance")
Declaration(Class(goldbook:15644))
AnnotationAssertion(rdfs:label goldbook:15644 "disease")
AnnotationAssertion(dcterms:description goldbook:15644 "Literally, dis-ease, lack of ease; pathological condition that presents a group of symptoms peculiar to it and which establishes the condition as an abnormal entity different from other normal or pathological body states.")
Declaration(Class(goldbook:15645))
AnnotationAssertion(rdfs:label goldbook:15645 "disposition")
AnnotationAssertion(dcterms:description goldbook:15645 """Natural tendency shown by an individual or group of individuals, including any tendency to acquisition of specific diseases, often due to hereditary factors.
Total of the processes of absorption of a chemical into the circulatory systems, distribution throughout the body, biotransformation, and excretion.""")
Declaration(Class(goldbook:15646))
AnnotationAssertion(rdfs:label goldbook:15646 "dissipation")
AnnotationAssertion(dcterms:description goldbook:15646 "Reduction in the amount of a pesticide or other compound that has been applied to plants, soil, etc. (used when it is not clear whether this is by mineralization degradation, binding, or leaching).")
Declaration(Class(goldbook:15647))
AnnotationAssertion(rdfs:label goldbook:15647 "distribution volume")
AnnotationAssertion(dcterms:description goldbook:15647 "Theoretical volume of a body compartment throughout which a substance is calculated to be distributed.")
Declaration(Class(goldbook:15648))
AnnotationAssertion(rdfs:label goldbook:15648 "diuresis")
AnnotationAssertion(dcterms:description goldbook:15648 "Excretion of urine, especially in excess.")
Declaration(Class(goldbook:15649))
AnnotationAssertion(rdfs:label goldbook:15649 "diuretic")
AnnotationAssertion(dcterms:description goldbook:15649 "Agent that increases urine production.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15649 "micturitic")
Declaration(Class(goldbook:15650))
AnnotationAssertion(rdfs:label goldbook:15650 "dominant half life")
AnnotationAssertion(dcterms:description goldbook:15650 "Half life of a fraction of a substance in a specific organ or compartment if it defines approximately the overall clearance rate for that substance at a specific time point.")
Declaration(Class(goldbook:15651))
AnnotationAssertion(rdfs:label goldbook:15651 "dominant lethal mutation")
AnnotationAssertion(dcterms:description goldbook:15651 "Genetic change occurring in a germ cell that does not cause dysfunction of the gamete but which is lethal to the fertilized egg or developing embryo which develops from it.")
Declaration(Class(goldbook:15652))
AnnotationAssertion(rdfs:label goldbook:15652 "duplicate portion sampling method")
AnnotationAssertion(dcterms:description goldbook:15652 "Study in which test persons consume their ordinary diet but, for each meal, they prepare for subsequent analysis a duplicate portion of all food as prepared, served, and consumed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15652 "duplicate diet study")
Declaration(Class(goldbook:15653))
AnnotationAssertion(rdfs:label goldbook:15653 "duplicate samples")
AnnotationAssertion(dcterms:description goldbook:15653 "Two samples taken under the same or comparable conditions.")
Declaration(Class(goldbook:15654))
AnnotationAssertion(rdfs:label goldbook:15654 "dysfunction")
AnnotationAssertion(dcterms:description goldbook:15654 "Abnormal, impaired, or incomplete functioning of an organism, organ, tissue, or cell.")
Declaration(Class(goldbook:15655))
AnnotationAssertion(rdfs:label goldbook:15655 "ectoparasiticide")
AnnotationAssertion(dcterms:description goldbook:15655 "Substance intended to kill parasites living on the exterior of the host.")
Declaration(Class(goldbook:15656))
AnnotationAssertion(rdfs:label goldbook:15656 "elimination half life")
AnnotationAssertion(dcterms:description goldbook:15656 "Period taken for the plasma concentration of a substance to decrease by half.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15656 "elimination half time")
Declaration(Class(goldbook:15657))
AnnotationAssertion(rdfs:label goldbook:15657 "eliminator")
AnnotationAssertion(dcterms:description goldbook:15657 "Substance that contributes to the elimination of a poison from an organism.")
Declaration(Class(goldbook:15658))
AnnotationAssertion(rdfs:label goldbook:15658 "embryotoxicity")
AnnotationAssertion(dcterms:description goldbook:15658 """Production by a substance of toxic effects in progeny in the first period of pregnancy between conception and the fetal stage.
Any toxic effect on the conceptus as a result of prenatal exposure during the embryonic stages of development: These effects may include malformations and variations, malfunctions, altered growth, prenatal death, and altered postnatal function.""")
Declaration(Class(goldbook:15659))
AnnotationAssertion(rdfs:label goldbook:15659 "embryotropic effect")
AnnotationAssertion(dcterms:description goldbook:15659 "Change in the embryo and the regulation of its development.")
Declaration(Class(goldbook:15660))
AnnotationAssertion(rdfs:label goldbook:15660 "emission and exposure control")
AnnotationAssertion(dcterms:description goldbook:15660 "Technical and administrative procedures and specifications applied for the monitoring, reduction, or elimination of emissions from a source or exposure to a target.")
Declaration(Class(goldbook:15661))
AnnotationAssertion(rdfs:label goldbook:15661 "endocon")
AnnotationAssertion(dcterms:description goldbook:15661 "Portion of a conjugated metabolite that is derived from a natural product (such as a sugar, amino acid, or other organic acid) of the metabolizing organism.")
Declaration(Class(goldbook:15662))
AnnotationAssertion(rdfs:label goldbook:15662 "endoplasmic reticulum")
AnnotationAssertion(dcterms:description goldbook:15662 "Intracellular complex of membranes in which proteins and lipids, as well as molecules for export, are synthesized and in which the biotransformation reactions of the monooxygenase enzyme systems occur.")
Declaration(Class(goldbook:15663))
AnnotationAssertion(rdfs:label goldbook:15663 "endothelial")
AnnotationAssertion(dcterms:description goldbook:15663 "Pertaining to the layer of flat cells lining the inner surface of blood and lymphatic vessels, and the surface lining of serous and synovial membranes.")
Declaration(Class(goldbook:15664))
AnnotationAssertion(rdfs:label goldbook:15664 "enteritis")
AnnotationAssertion(dcterms:description goldbook:15664 "Intestinal inflammation.")
Declaration(Class(goldbook:15665))
AnnotationAssertion(rdfs:label goldbook:15665 "enterohepatic circulation")
AnnotationAssertion(dcterms:description goldbook:15665 "Cyclical process involving intestinal reabsorption of a substance that has been excreted through the bile, followed by transfer back to the liver, making it available for biliary excretion again.")
Declaration(Class(goldbook:15666))
AnnotationAssertion(rdfs:label goldbook:15666 "environment")
AnnotationAssertion(dcterms:description goldbook:15666 "Aggregate, at a given moment, of all external conditions and influences to which a system under study is subjected.")
Declaration(Class(goldbook:15667))
AnnotationAssertion(rdfs:label goldbook:15667 "environmental damage")
AnnotationAssertion(dcterms:description goldbook:15667 "Adverse effects to the natural environment.")
Declaration(Class(goldbook:15668))
AnnotationAssertion(rdfs:label goldbook:15668 "environmental exposure level")
AnnotationAssertion(dcterms:description goldbook:15668 "Level (concentration or amount or a time integral of either) of a substance to which an organism or other component of the environment is exposed in its natural surroundings.")
Declaration(Class(goldbook:15669))
AnnotationAssertion(rdfs:label goldbook:15669 "environmental health")
AnnotationAssertion(dcterms:description goldbook:15669 "Human welfare and its influence by the environment, including technical and administrative measures for improving the human environment from a health point of view.")
Declaration(Class(goldbook:15670))
AnnotationAssertion(rdfs:label goldbook:15670 "environmental health impact assessment")
AnnotationAssertion(dcterms:description goldbook:15670 "Estimate of the adverse effects to health or risks likely to follow from a proposed or expected environmental change or development.")
Declaration(Class(goldbook:15671))
AnnotationAssertion(rdfs:label goldbook:15671 "environmental health criteria documents")
AnnotationAssertion(dcterms:description goldbook:15671 "Critical publications of IPCS containing reviews of methodologies and existing knowledge—expressed, if possible, in quantitative terms—of selected substances (or groups of substances) on identifiable, immediate, and long-term effects on human health and welfare.")
Declaration(Class(goldbook:15672))
AnnotationAssertion(rdfs:label goldbook:15672 "environmental hygiene")
AnnotationAssertion(dcterms:description goldbook:15672 "Practical control measures used to improve the basic environmental conditions affecting human health, for example, clean water supply, human and animal waste disposal, protection of food from biological contamination, and housing conditions, all of which are concerned with the quality of the human environment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15672 "environmental sanitation")
Declaration(Class(goldbook:15673))
AnnotationAssertion(rdfs:label goldbook:15673 "environmental medicine")
AnnotationAssertion(dcterms:description goldbook:15673 "Specialty devoted to the prevention and management of environmentally induced injury, illness, and disability, and the promotion of the health of individuals, families, and communities by ensuring a healthy environment.")
Declaration(Class(goldbook:15674))
AnnotationAssertion(rdfs:label goldbook:15674 "environmental protection")
AnnotationAssertion(dcterms:description goldbook:15674 """Actions taken to prevent or minimize adverse effects to the natural environment.
Complex of measures including monitoring of environmental pollution, development and practice of environmental protection principles (legal, technical, and hygienic), including risk assessment, risk management, and risk communication.""")
Declaration(Class(goldbook:15675))
AnnotationAssertion(rdfs:label goldbook:15675 "epigastric")
AnnotationAssertion(dcterms:description goldbook:15675 "Pertaining to the upper-middle region of the abdomen.")
Declaration(Class(goldbook:15676))
AnnotationAssertion(rdfs:label goldbook:15676 "epileptiform")
AnnotationAssertion(dcterms:description goldbook:15676 "Occurring in severe or sudden spasms, as in convulsion or epilepsy.")
Declaration(Class(goldbook:15677))
AnnotationAssertion(rdfs:label goldbook:15677 "epithelioma")
AnnotationAssertion(dcterms:description goldbook:15677 "Any tumor derived from epithelium.")
Declaration(Class(goldbook:15678))
AnnotationAssertion(rdfs:label goldbook:15678 "eschar")
AnnotationAssertion(dcterms:description goldbook:15678 "Slough or dry scab on an area of skin that has been burnt.")
Declaration(Class(goldbook:15679))
AnnotationAssertion(rdfs:label goldbook:15679 "estimated daily intake")
AnnotationAssertion(dcterms:description goldbook:15679 "Prediction of the daily intake of a residue of a potentially harmful agent based on the most realistic estimation of the residue levels in food and the best available food consumption data for a specific population: Residue levels are estimated taking into account known uses of the agent, the range of contaminated commodities, the proportion of a commodity treated, and the quantity of home-grown or imported commodities.")
Declaration(Class(goldbook:15680))
AnnotationAssertion(rdfs:label goldbook:15680 "estimated environmental concentration")
AnnotationAssertion(dcterms:description goldbook:15680 "Predicted concentration of a substance, typically a pesticide, within an environmental compartment based on estimates of quantities released, discharge patterns, and inherent disposition of the substance (fate and distribution) as well as the nature of the specific receiving ecosystems.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15680 "predicted exposure concentration (PEC)")
Declaration(Class(goldbook:15681))
AnnotationAssertion(rdfs:label goldbook:15681 "estimated exposure concentration")
AnnotationAssertion(dcterms:description goldbook:15681 "Measured or calculated amount or mass concentration of a substance to which an organism is likely to be exposed, considering exposure by all sources and routes.")
Declaration(Class(goldbook:15682))
AnnotationAssertion(rdfs:label goldbook:15682 "estimated exposure dose")
AnnotationAssertion(dcterms:description goldbook:15682 "Measured or calculated dose of a substance to which an organism is likely to be exposed, considering exposure by all sources and routes.")
Declaration(Class(goldbook:15683))
AnnotationAssertion(rdfs:label goldbook:15683 "estimated maximum daily intake")
AnnotationAssertion(dcterms:description goldbook:15683 "Prediction of the maximum daily intake of a residue of a potentially harmful agent based on assumptions of average food consumption per person and maximum residues in the edible portion of a commodity, corrected for the reduction or increase in residues resulting from preparation, cooking, or commercial processing.")
Declaration(Class(goldbook:15684))
AnnotationAssertion(rdfs:label goldbook:15684 "etiology")
AnnotationAssertion(dcterms:description goldbook:15684 """Science dealing with the cause or origin of disease.
In individuals, the cause or origin of disease.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15684 "aetiology")
Declaration(Class(goldbook:15685))
AnnotationAssertion(rdfs:label goldbook:15685 "eukaryote")
AnnotationAssertion(dcterms:description goldbook:15685 "Cell or organism with the genetic material packed in a membrane-surrounded structurally discrete nucleus and with well-developed cell organelles.")
Declaration(Class(goldbook:15686))
AnnotationAssertion(rdfs:label goldbook:15686 "European Inventory of Existing Chemical Substances")
AnnotationAssertion(dcterms:description goldbook:15686 "List of all substances supplied either singly or as components in preparations to persons in a Member State of the European Community on any occasion between 1 January 1971 and 18 September 1981.")
Declaration(Class(goldbook:15687))
AnnotationAssertion(rdfs:label goldbook:15687 "excess lifetime risk")
AnnotationAssertion(dcterms:description goldbook:15687 "Additional or excess risk incurred over the lifetime of an individual by exposure to a toxic substance.")
Declaration(Class(goldbook:15688))
AnnotationAssertion(rdfs:label goldbook:15688 "exchange transfusion")
AnnotationAssertion(dcterms:description goldbook:15688 "Method of active artificial elimination of toxicity consisting in complete replacement of blood of the patient by donor blood.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15688 "blood substitution")
Declaration(Class(goldbook:15689))
AnnotationAssertion(rdfs:label goldbook:15689 "excretion rate")
AnnotationAssertion(dcterms:description goldbook:15689 "Amount of substance and (or) its metabolites that is excreted divided by time of excretion.")
Declaration(Class(goldbook:15690))
AnnotationAssertion(rdfs:label goldbook:15690 "exocon")
AnnotationAssertion(dcterms:description goldbook:15690 "Portion of a conjugated metabolite that is derived from the parent molecule.")
Declaration(Class(goldbook:15691))
AnnotationAssertion(rdfs:label goldbook:15691 "exogenous")
AnnotationAssertion(dcterms:description goldbook:15691 "Resulting from causes or derived from materials external to an organism.")
Declaration(Class(goldbook:15692))
AnnotationAssertion(rdfs:label goldbook:15692 "exothelium")
AnnotationAssertion(dcterms:description goldbook:15692 "Layer of flattened epithelial cells external to an organ or tissue.")
Declaration(Class(goldbook:15693))
AnnotationAssertion(rdfs:label goldbook:15693 "expected environmental concentration")
AnnotationAssertion(dcterms:description goldbook:15693 "Calculated concentrations of a substance, typically a pesticide, in various environmental compartments based on calculations using maximum-exposure scenarios.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15693 "expected exposure concentration (EEC)")
Declaration(Class(goldbook:15694))
AnnotationAssertion(rdfs:label goldbook:15694 "explant")
AnnotationAssertion(dcterms:description goldbook:15694 "Living tissue removed from its normal environment and transferred to an artificial medium for growth.")
Declaration(Class(goldbook:15695))
AnnotationAssertion(rdfs:label goldbook:15695 "exposed")
AnnotationAssertion(dcterms:description goldbook:15695 "Subject to a factor that is under study in the environment, for instance, an environmental hazard.")
Declaration(Class(goldbook:15696))
AnnotationAssertion(rdfs:label goldbook:15696 "exposed group")
AnnotationAssertion(dcterms:description goldbook:15696 "People (or other organisms) who have been exposed to a supposed cause of a disease or health state of interest, or possess a characteristic that is a determinant of the health outcome of interest.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15696 "exposed")
Declaration(Class(goldbook:15697))
AnnotationAssertion(rdfs:label goldbook:15697 "exposure limit")
AnnotationAssertion(dcterms:description goldbook:15697 "General term defining an administrative substance concentration or intensity of exposure that should not be exceeded.")
Declaration(Class(goldbook:15698))
AnnotationAssertion(rdfs:label goldbook:15698 "exposure ratio")
AnnotationAssertion(dcterms:description goldbook:15698 "In a case control study, value obtained by dividing the rate at which persons in the case group are exposed to a risk factor (or to a protective factor) by the rate at which persons in the control group are exposed to the risk factor (or to the protective factor) of interest.")
Declaration(Class(goldbook:15699))
AnnotationAssertion(rdfs:label goldbook:15699 "exposure surface")
AnnotationAssertion(dcterms:description goldbook:15699 "Surface on a target where a substance (e.g., a pesticide) is present.")
Declaration(Class(goldbook:15700))
AnnotationAssertion(rdfs:label goldbook:15700 "exposure test")
AnnotationAssertion(dcterms:description goldbook:15700 "Determination of the level, concentration, or uptake of a potentially toxic compound and (or) its metabolite(s) in biological samples from an organism (blood, urine, hair, etc.) and the interpretation of the results to estimate the absorbed dose or degree of environmental pollution; or the measuring of biochemical effects, usually not direct adverse effects of the substance, and relating them to the quantity of substance absorbed, or to its concentration in the environment.")
Declaration(Class(goldbook:15701))
AnnotationAssertion(rdfs:label goldbook:15701 "external validity")
AnnotationAssertion(dcterms:description goldbook:15701 "Generalizability of the results of a particular study, beyond the limits of the population actually studied.")
Declaration(Class(goldbook:15702))
AnnotationAssertion(rdfs:label goldbook:15702 "extracellular space")
AnnotationAssertion(dcterms:description goldbook:15702 "Volume within a tissue, outside cells, and excluding vascular and lymphatic space.")
Declaration(Class(goldbook:15703))
AnnotationAssertion(rdfs:label goldbook:15703 "extracellular volume")
AnnotationAssertion(dcterms:description goldbook:15703 "Volume of fluid outside the cells but within the outer surface of an organism.")
Declaration(Class(goldbook:15704))
AnnotationAssertion(rdfs:label goldbook:15704 "extraction ratio")
AnnotationAssertion(dcterms:description goldbook:15704 "Amount of substance extracted from a source divided by the total contained within the source.")
Declaration(Class(goldbook:15705))
AnnotationAssertion(rdfs:label goldbook:15705 "extra risk")
AnnotationAssertion(dcterms:description goldbook:15705 "Probability that an agent produces an observed response, as distinguished from the probability that the response is caused by a spontaneous event unrelated to the agent.")
Declaration(Class(goldbook:15706))
AnnotationAssertion(rdfs:label goldbook:15706 "extraneous residue limit")
AnnotationAssertion(dcterms:description goldbook:15706 "Refers to a pesticide residue or contaminant arising from environmental sources (including former agricultural uses) other than the use of a pesticide or contaminant substance directly or indirectly on the commodity. It is the maximum concentration of a pesticide residue or contaminant that is recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food, agricultural commodity, or animal feed.")
Declaration(Class(goldbook:15707))
AnnotationAssertion(rdfs:label goldbook:15707 "extrapyramidal movement disorders")
AnnotationAssertion(dcterms:description goldbook:15707 "Involuntary movement disorders mediated by signaling through neurons outside the pyramidal (corticospinal) tract, often describing side effects of psychiatric medications.")
Declaration(Class(goldbook:15708))
AnnotationAssertion(rdfs:label goldbook:15708 "fertility")
AnnotationAssertion(dcterms:description goldbook:15708 "Ability to conceive and to produce offspring: For litter-bearing species, the number of offspring per litter is used as a measure of fertility.")
Declaration(Class(goldbook:15709))
AnnotationAssertion(rdfs:label goldbook:15709 "fertility toxicant")
AnnotationAssertion(dcterms:description goldbook:15709 "Produces abnormalities of male or female reproductive functions or impairs reproductive capacity.")
Declaration(Class(goldbook:15710))
AnnotationAssertion(rdfs:label goldbook:15710 "fetotoxicity")
AnnotationAssertion(dcterms:description goldbook:15710 "Toxicity to the fetus.")
Declaration(Class(goldbook:15711))
AnnotationAssertion(rdfs:label goldbook:15711 "fibrosis")
AnnotationAssertion(dcterms:description goldbook:15711 "Abnormal formation of fibrous tissue.")
Declaration(Class(goldbook:15712))
AnnotationAssertion(rdfs:label goldbook:15712 "fiducial limit")
AnnotationAssertion(dcterms:description goldbook:15712 "Form of confidence limit given as a stated probability, for example, \\(P = \\pu{0.95}\\).")
Declaration(Class(goldbook:15713))
AnnotationAssertion(rdfs:label goldbook:15713 "first-order chemical reaction")
AnnotationAssertion(dcterms:description goldbook:15713 """Chemical reaction where the initial rate is directly proportional to the concentration of one of the reactants.
Any process in which a variable decreases with time at a constant fractional amount.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15713 "first-order reaction")
Declaration(Class(goldbook:15714))
AnnotationAssertion(rdfs:label goldbook:15714 "fixed dose procedure")
AnnotationAssertion(dcterms:description goldbook:15714 "Acute toxicity test in which a substance is tested initially at a small number (3 or 4) predefined doses to identify which produces evident toxicity without lethality: The test may be repeated at one or more higher or lower defined discriminating doses to satisfy the criteria.")
Declaration(Class(goldbook:15715))
AnnotationAssertion(rdfs:label goldbook:15715 "fluorosis")
AnnotationAssertion(dcterms:description goldbook:15715 "Adverse effects of fluoride, as in dental or skeletal fluorosis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15715 "fluoridosis")
Declaration(Class(goldbook:15716))
AnnotationAssertion(rdfs:label goldbook:15716 "foci")
AnnotationAssertion(dcterms:description goldbook:15716 "Small groups of cells distinguishable, in appearance or histochemically, from the surrounding tissue: indicative of an early stage of a lesion that may lead to the formation of a neoplastic nodule.")
Declaration(Class(goldbook:15717))
AnnotationAssertion(rdfs:label goldbook:15717 "food additive")
AnnotationAssertion(dcterms:description goldbook:15717 "Any substance, not normally consumed as a food by itself and not normally used as a typical ingredient of a given food, whether or not it has nutritive value, that is added intentionally to food for a technological (including organoleptic) purpose in the manufacture, processing, preparation, treatment, packing, packaging, transport, or holding of the food. Addition results, or may be reasonably expected to result (directly or indirectly), in the substance or its byproducts becoming a component of, or otherwise affecting, the characteristics of the food to which it is added.")
Declaration(Class(goldbook:15718))
AnnotationAssertion(rdfs:label goldbook:15718 "food allergy")
AnnotationAssertion(dcterms:description goldbook:15718 "Hypersensitivity reaction to substances in the diet to which an individual has previously been sensitized.")
Declaration(Class(goldbook:15719))
AnnotationAssertion(rdfs:label goldbook:15719 "food intolerance")
AnnotationAssertion(dcterms:description goldbook:15719 "Physiologically based reproducible, unpleasant (adverse) reaction to a specific food or food ingredient that is not immunologically based.")
Declaration(Class(goldbook:15720))
AnnotationAssertion(rdfs:label goldbook:15720 "food web")
AnnotationAssertion(dcterms:description goldbook:15720 "Network of food chains.")
Declaration(Class(goldbook:15721))
AnnotationAssertion(rdfs:label goldbook:15721 "forced diuresis")
AnnotationAssertion(dcterms:description goldbook:15721 "Method of stimulating diuresis based on performing hydrational therapy, sometimes with parallel introduction of diuretics, with the aim of achieving increased clearance of a toxic substance in urine.")
Declaration(Class(goldbook:15722))
AnnotationAssertion(rdfs:label goldbook:15722 "founder effect")
AnnotationAssertion(dcterms:description goldbook:15722 "Changes in allelic frequencies that occur when a small group is separated from a large population and establishes a colony in a new location.")
Declaration(Class(goldbook:15723))
AnnotationAssertion(rdfs:label goldbook:15723 "fumigant")
AnnotationAssertion(dcterms:description goldbook:15723 "Substance that is vaporized in order to kill or repel pests.")
Declaration(Class(goldbook:15724))
AnnotationAssertion(rdfs:label goldbook:15724 "fungus preparation")
AnnotationAssertion(dcterms:description goldbook:15724 "Substance obtained from fungi that has an insecticidal effect reflecting the pathogenicity of the fungi for insects.")
Declaration(Class(goldbook:15725))
AnnotationAssertion(rdfs:label goldbook:15725 "gametocide")
AnnotationAssertion(dcterms:description goldbook:15725 "Substance intended to kill gametes.")
Declaration(Class(goldbook:15726))
AnnotationAssertion(rdfs:label goldbook:15726 "gastroenteritis")
AnnotationAssertion(dcterms:description goldbook:15726 "Inflammation of the stomach and intestine.")
Declaration(Class(goldbook:15727))
AnnotationAssertion(rdfs:label goldbook:15727 "gastrointestinal")
AnnotationAssertion(dcterms:description goldbook:15727 "Pertaining to or communicating with the stomach and intestine.")
Declaration(Class(goldbook:15728))
AnnotationAssertion(rdfs:label goldbook:15728 "gavage")
AnnotationAssertion(dcterms:description goldbook:15728 "Administration of materials directly into the stomach by esophageal intubation.")
Declaration(Class(goldbook:15729))
AnnotationAssertion(rdfs:label goldbook:15729 "gene map")
AnnotationAssertion(dcterms:description goldbook:15729 "Map showing the positions in the genome of genes or other genetic markers, either relative to each other or as a physical map of absolute distances.")
Declaration(Class(goldbook:15730))
AnnotationAssertion(rdfs:label goldbook:15730 "generally regarded as safe")
AnnotationAssertion(dcterms:description goldbook:15730 "Phrase used to describe the USFDA philosophy that justifies approval of food additives that may not meet the usual test criteria for safety but have been used extensively and have not demonstrated that they cause any harm to consumers.")
Declaration(Class(goldbook:15731))
AnnotationAssertion(rdfs:label goldbook:15731 "genetically modified organism")
AnnotationAssertion(dcterms:description goldbook:15731 "Bacterium, plant, or animal whose DNA has been deliberately altered.")
Declaration(Class(goldbook:15732))
AnnotationAssertion(rdfs:label goldbook:15732 "genetic polymorphism")
AnnotationAssertion(dcterms:description goldbook:15732 "Existence of inter-individual differences in DNA sequences coding for one specific gene, giving rise to different functional and (or) morphological traits.")
Declaration(Class(goldbook:15733))
AnnotationAssertion(rdfs:label goldbook:15733 "genetic susceptibility")
AnnotationAssertion(dcterms:description goldbook:15733 "Predisposition to a particular disease or sensitivity to a substance due to the presence of a specific allele or combination of alleles in an individual’s genome.")
Declaration(Class(goldbook:15734))
AnnotationAssertion(rdfs:label goldbook:15734 "genetic toxicology")
AnnotationAssertion(dcterms:description goldbook:15734 "Study of chemically or physically induced changes to the structure of DNA, including epigenetic phenomena or mutations that may or may not be heritable.")
Declaration(Class(goldbook:15735))
AnnotationAssertion(rdfs:label goldbook:15735 "germ-free animal")
AnnotationAssertion(dcterms:description goldbook:15735 "Animal grown under sterile conditions in the period of postnatal development: Such animals are usually obtained by Caesarean operation and kept in special sterile boxes in which there are no viable microorganisms (sterile air, food, and water are supplied).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15735 "axenic animal")
Declaration(Class(goldbook:15736))
AnnotationAssertion(rdfs:label goldbook:15736 "germinal aplasia")
AnnotationAssertion(dcterms:description goldbook:15736 "Complete failure of gonad development.")
Declaration(Class(goldbook:15737))
AnnotationAssertion(rdfs:label goldbook:15737 "glomerular")
AnnotationAssertion(dcterms:description goldbook:15737 "Pertaining to a tuft or cluster, as of a plexus of capillary blood vessels or nerve fibers, especially referring to the capillaries of the glomerular of the kidney.")
Declaration(Class(goldbook:15738))
AnnotationAssertion(rdfs:label goldbook:15738 "glomerular filtration")
AnnotationAssertion(dcterms:description goldbook:15738 "Formation of an ultrafiltrate of the blood occurring in the glomerulus of the kidney.")
Declaration(Class(goldbook:15739))
AnnotationAssertion(rdfs:label goldbook:15739 "glomerular filtration rate")
AnnotationAssertion(dcterms:description goldbook:15739 "Volume of ultrafiltrate formed in the kidney tubules from the blood passing through the glomerular capillaries divided by time of filtration.")
Declaration(Class(goldbook:15740))
AnnotationAssertion(rdfs:label goldbook:15740 "glue-sniffing")
AnnotationAssertion(dcterms:description goldbook:15740 "Inhalation of solvent vapor from plastic cements or other adhesives in order to become intoxicated.")
Declaration(Class(goldbook:15741))
AnnotationAssertion(rdfs:label goldbook:15741 "gnotobiota")
AnnotationAssertion(dcterms:description goldbook:15741 "Specifically and entirely known microfauna and microflora of a specially reared laboratory animal.")
Declaration(Class(goldbook:15742))
AnnotationAssertion(rdfs:label goldbook:15742 "gnotobiote")
AnnotationAssertion(dcterms:description goldbook:15742 "Specially reared laboratory animal whose microflora and microfauna are specifically known in their entirety.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15742 "gnotobiont")
Declaration(Class(goldbook:15743))
AnnotationAssertion(rdfs:label goldbook:15743 "goiter")
AnnotationAssertion(dcterms:description goldbook:15743 "Noncancerous enlargement of the thyroid gland, visible as a swelling at the front of the neck, that is often associated with iodine deficiency.")
Declaration(Class(goldbook:15744))
AnnotationAssertion(rdfs:label goldbook:15744 "goitrogen")
AnnotationAssertion(dcterms:description goldbook:15744 "Any substance (such as thiouracil) that induces the formation of a goiter.")
Declaration(Class(goldbook:15745))
AnnotationAssertion(rdfs:label goldbook:15745 "gonadotropic")
AnnotationAssertion(dcterms:description goldbook:15745 "Pertaining to effects on sex glands and on the systems that regulate them.")
Declaration(Class(goldbook:15746))
AnnotationAssertion(rdfs:label goldbook:15746 "good agricultural practice")
AnnotationAssertion(dcterms:description goldbook:15746 "Nationally authorized safe uses of pesticides under actual conditions necessary for effective and reliable pest control.")
Declaration(Class(goldbook:15747))
AnnotationAssertion(rdfs:label goldbook:15747 "graminicide")
AnnotationAssertion(dcterms:description goldbook:15747 "Pesticide (herbicide) used for the control of weedy grasses (Gramineae).")
Declaration(Class(goldbook:15748))
AnnotationAssertion(rdfs:label goldbook:15748 "ground treatment of plants")
AnnotationAssertion(dcterms:description goldbook:15748 "Dusting or spraying of plants with pesticides by hand, by special machines, or by apparatus fixed to tractors or driven by them.")
Declaration(Class(goldbook:15749))
AnnotationAssertion(rdfs:label goldbook:15749 "guideline for exposure limits")
AnnotationAssertion(dcterms:description goldbook:15749 "Scientifically judged quantitative value (a concentration or number) of an environmental constituent that ensures aesthetically pleasing air, water, or food and from which no adverse effect is expected concerning noncarcinogenic endpoints, or that gives an acceptably low estimate of lifetime cancer risk from those substances which are proven human carcinogens or carcinogens with at least limited evidence of human carcinogenicity.")
Declaration(Class(goldbook:15750))
AnnotationAssertion(rdfs:label goldbook:15750 "guideline value")
AnnotationAssertion(dcterms:description goldbook:15750 "Quantitative measure (a concentration or a number) of a constituent of an environmental medium that ensures aesthetically pleasing air, water, or food and does not result in a significant risk to the user.")
Declaration(Class(goldbook:15751))
AnnotationAssertion(rdfs:label goldbook:15751 "guides to air quality")
AnnotationAssertion(dcterms:description goldbook:15751 "Sets of atmospheric concentrations and exposure times that are associated with specific effects of varying degrees of pollution on humans, animals, vegetation, and the environment in general.")
Declaration(Class(goldbook:15752))
AnnotationAssertion(rdfs:label goldbook:15752 "guides to environmental quality")
AnnotationAssertion(dcterms:description goldbook:15752 "Sets of concentrations, numbers and exposure times that are associated with the specific effects of factors in environmental media on humans, animals, vegetation, and the environment in general.")
Declaration(Class(goldbook:15753))
AnnotationAssertion(rdfs:label goldbook:15753 "harmful occupational factor")
AnnotationAssertion(dcterms:description goldbook:15753 "Component of the work environment, the effect of which on a worker under certain conditions leads to ill health or reduction of working ability.")
Declaration(Class(goldbook:15754))
AnnotationAssertion(rdfs:label goldbook:15754 "harmful substance")
AnnotationAssertion(dcterms:description goldbook:15754 "Substance that, following contact with an organism, can cause ill health or adverse effects either at the time of exposure or later in the life of the present and future generations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15754 "noxious substance")
Declaration(Class(goldbook:15755))
AnnotationAssertion(rdfs:label goldbook:15755 "hazard communication standard")
AnnotationAssertion(dcterms:description goldbook:15755 "U.S. OSHA standard requiring all employers to inform employees of the hazard of substances in the workplace and the steps necessary to avoid harm.")
Declaration(Class(goldbook:15756))
AnnotationAssertion(rdfs:label goldbook:15756 "hazardous production factor")
AnnotationAssertion(dcterms:description goldbook:15756 "Production factor the effect of which on a worker under certain conditions results in injury or some impairment of health.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15756 "hazard at work")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15756 "hazardous occupational factor")
Declaration(Class(goldbook:15757))
AnnotationAssertion(rdfs:label goldbook:15757 "health")
AnnotationAssertion(dcterms:description goldbook:15757 """State of complete physical, mental, and social well-being, and not merely the absence of disease or infirmity.
State of dynamic balance in which an individual’s or a group’s capacity to cope with the circumstances of living is at an optimal level.
State characterized by anatomical, physiological, and psychological integrity; ability to perform personally valued family, work, and community roles; ability to deal with physical, biological, psychological, and social stress; a feeling of well-being; and freedom from the risk of disease and untimely death.
In ecology, a sustainable steady state in which humans and other living organisms can coexist indefinitely.""")
Declaration(Class(goldbook:15758))
AnnotationAssertion(rdfs:label goldbook:15758 "health advisory level")
AnnotationAssertion(dcterms:description goldbook:15758 "In the United States, nonregulatory health-based reference level of chemical traces (usually in ppm, i.e., \\(\\pu{mg L-1}\\)) in drinking water at which there are no adverse health risks when ingested over various periods of time.")
Declaration(Class(goldbook:15759))
AnnotationAssertion(rdfs:label goldbook:15759 "health-based exposure limit")
AnnotationAssertion(dcterms:description goldbook:15759 "Maximum concentration or intensity of exposure that can be tolerated without significant effect (based on only scientific and not economic evidence concerning exposure levels and associated health effects).")
Declaration(Class(goldbook:15760))
AnnotationAssertion(rdfs:label goldbook:15760 "health hazard")
AnnotationAssertion(dcterms:description goldbook:15760 "Any factor or exposure that may adversely affect health.")
Declaration(Class(goldbook:15761))
AnnotationAssertion(rdfs:label goldbook:15761 "healthy worker effect")
AnnotationAssertion(dcterms:description goldbook:15761 "Epidemiological phenomenon observed initially in studies of occupational diseases: Workers usually exhibit lower overall disease and death rates than the general population, due to the fact that the old, severely ill, and disabled are ordinarily excluded from employment. Death rates in the general population may be inappropriate for comparison, if this effect is not taken into account.")
Declaration(Class(goldbook:15762))
AnnotationAssertion(rdfs:label goldbook:15762 "hematemesis")
AnnotationAssertion(dcterms:description goldbook:15762 "Vomiting of blood.")
Declaration(Class(goldbook:15763))
AnnotationAssertion(rdfs:label goldbook:15763 "hematotoxicity")
AnnotationAssertion(dcterms:description goldbook:15763 "Adverse changes in blood caused by exposure to chemicals.")
Declaration(Class(goldbook:15764))
AnnotationAssertion(rdfs:label goldbook:15764 "hematuria")
AnnotationAssertion(dcterms:description goldbook:15764 "Presence of blood in the urine.")
Declaration(Class(goldbook:15766))
AnnotationAssertion(rdfs:label goldbook:15766 "hemochromatosis")
AnnotationAssertion(dcterms:description goldbook:15766 "Hereditary disorder affecting iron metabolism in which excessive amounts of iron accumulate in the body tissues.")
Declaration(Class(goldbook:15767))
AnnotationAssertion(rdfs:label goldbook:15767 "hemoglobinuria")
AnnotationAssertion(dcterms:description goldbook:15767 "Presence of free hemoglobin in the urine.")
Declaration(Class(goldbook:15768))
AnnotationAssertion(rdfs:label goldbook:15768 "hemolysin")
AnnotationAssertion(dcterms:description goldbook:15768 "Substance that damages the membrane of erythrocytes causing the release of hemoglobin.")
Declaration(Class(goldbook:15769))
AnnotationAssertion(rdfs:label goldbook:15769 "hemolysis")
AnnotationAssertion(dcterms:description goldbook:15769 "Release of hemoglobin from erythrocytes, and its appearance in the plasma.")
Declaration(Class(goldbook:15770))
AnnotationAssertion(rdfs:label goldbook:15770 "hemoperfusion")
AnnotationAssertion(dcterms:description goldbook:15770 "Passing blood through a column of charcoal or adsorbent resin for the removal of drugs or toxins.")
Declaration(Class(goldbook:15771))
AnnotationAssertion(rdfs:label goldbook:15771 "hemosiderin")
AnnotationAssertion(dcterms:description goldbook:15771 "Insoluble iron(III) hydroxide-based pigment deposited in cells in conditions of iron overload.")
Declaration(Class(goldbook:15772))
AnnotationAssertion(rdfs:label goldbook:15772 "hepatic")
AnnotationAssertion(dcterms:description goldbook:15772 "Pertaining to the liver.")
Declaration(Class(goldbook:15773))
AnnotationAssertion(rdfs:label goldbook:15773 "hepatotoxic")
AnnotationAssertion(dcterms:description goldbook:15773 "Poisonous to liver cells.")
Declaration(Class(goldbook:15774))
AnnotationAssertion(rdfs:label goldbook:15774 "herbicide")
AnnotationAssertion(dcterms:description goldbook:15774 "Substance intended to kill plants.")
Declaration(Class(goldbook:15775))
AnnotationAssertion(rdfs:label goldbook:15775 "heterozygote")
AnnotationAssertion(dcterms:description goldbook:15775 "Organism that has different allelic forms of a specified gene on each of a pair of homologous chromosomes or describing the genome of that organism.")
Declaration(Class(goldbook:15776))
AnnotationAssertion(rdfs:label goldbook:15776 "Hill plot")
AnnotationAssertion(dcterms:description goldbook:15776 "Graphical method for analyzing binding of a molecule \\(\\ce{A}\\) to a macromolecule \\(\\ce{P}\\) with \\(n\\) binding sites. A Hill plot of \\(\\log[\\theta/(1 - \\theta)]\\) vs. \\(\\log[\\ce{A}]\\) has a slope of 1 if binding is noncooperative and \\(\\gt 1\\) for cooperative binding, where \\(\\theta = [\\ce{A}]_{\\rm{bound}}/n[\\ce{P}]_{\\rm{total}}\\) is the fraction of sites occupied.")
Declaration(Class(goldbook:15777))
AnnotationAssertion(rdfs:label goldbook:15777 "histogenic origin")
AnnotationAssertion(dcterms:description goldbook:15777 "Germ cell layer of the embryo from which a given adult tissue develops.")
Declaration(Class(goldbook:15778))
AnnotationAssertion(rdfs:label goldbook:15778 "histology")
AnnotationAssertion(dcterms:description goldbook:15778 "Study (usually microscopic) of the anatomy of tissues and their cellular and subcellular structure.")
Declaration(Class(goldbook:15779))
AnnotationAssertion(rdfs:label goldbook:15779 "histopathology")
AnnotationAssertion(dcterms:description goldbook:15779 "Microscopic pathological study of the anatomy and cell structure of tissues in disease to reveal abnormal or adverse structural changes.")
Declaration(Class(goldbook:15780))
AnnotationAssertion(rdfs:label goldbook:15780 "hit-and-run effect")
AnnotationAssertion(dcterms:description goldbook:15780 "Toxicity that follows a single exposure to a substance.")
Declaration(Class(goldbook:15781))
AnnotationAssertion(rdfs:label goldbook:15781 "homology")
AnnotationAssertion(dcterms:description goldbook:15781 """Similarity of anatomical structures in different species because of shared ancestry
Similarity of DNA or RNA nucleotide sequences, or of protein amino-acid sequences, supporting the hypothesis that they share a common ancestor.Note: Homology among DNA or RNA nucleotide sequences, or among protein amino-acid sequences, is often concluded on the basis of sequence similarity. In general, if there are almost identical sequences, it is likely that they are homologous. However, it is possible that highly similar sequences were not derived from a common ancestor, i.e., they are similar but not homologous.""")
Declaration(Class(goldbook:15782))
AnnotationAssertion(rdfs:label goldbook:15782 "homozygote")
AnnotationAssertion(dcterms:description goldbook:15782 "Organism that has the same allelic form of a specified gene on each of a pair of homologous chromosomes or describing the genome of that organism.")
Declaration(Class(goldbook:15783))
AnnotationAssertion(rdfs:label goldbook:15783 "human ecology")
AnnotationAssertion(dcterms:description goldbook:15783 "Interrelationship between humans and the entire environment—physical, biological, socioeconomic, and cultural, including the interrelationships between individual humans or groups of humans and other human groups or groups of other species.")
Declaration(Class(goldbook:15784))
AnnotationAssertion(rdfs:label goldbook:15784 "human equivalent dose")
AnnotationAssertion(dcterms:description goldbook:15784 "Human dose of an agent that is believed to induce the same magnitude of a toxic effect that the known animal dose has induced.")
Declaration(Class(goldbook:15785))
AnnotationAssertion(rdfs:label goldbook:15785 "human exposure threshold")
AnnotationAssertion(dcterms:description goldbook:15785 "Generic value of exposure to a substance, or a group of substances falling within a defined structural class, below which there is expected to be no appreciable risk to human health.")
Declaration(Class(goldbook:15786))
AnnotationAssertion(rdfs:label goldbook:15786 "hygiene")
AnnotationAssertion(dcterms:description goldbook:15786 "Science of health and its preservation.")
Declaration(Class(goldbook:15787))
AnnotationAssertion(rdfs:label goldbook:15787 "hyper-")
AnnotationAssertion(dcterms:description goldbook:15787 "Prefix meaning above or excessive: when used with the suffix '-emia' refers to blood and with the suffix '-uria' refers to urine, for example, 'hyperbilirubinemia'.")
Declaration(Class(goldbook:15788))
AnnotationAssertion(rdfs:label goldbook:15788 "hyperemia")
AnnotationAssertion(dcterms:description goldbook:15788 "Excessive amount of blood in any part of the body.")
Declaration(Class(goldbook:15789))
AnnotationAssertion(rdfs:label goldbook:15789 "hyperalimentation")
AnnotationAssertion(dcterms:description goldbook:15789 "Ingestion or administration of nutrients in excess of optimal amounts.")
Declaration(Class(goldbook:15790))
AnnotationAssertion(rdfs:label goldbook:15790 "hyperbilirubinemia")
AnnotationAssertion(dcterms:description goldbook:15790 "Excessive concentration of bilirubin in the blood.")
Declaration(Class(goldbook:15791))
AnnotationAssertion(rdfs:label goldbook:15791 "hypercalcemia")
AnnotationAssertion(dcterms:description goldbook:15791 "Excessive concentration of calcium in the blood.")
Declaration(Class(goldbook:15792))
AnnotationAssertion(rdfs:label goldbook:15792 "hyperglycemia")
AnnotationAssertion(dcterms:description goldbook:15792 "Excessive concentration of glucose in the blood.")
Declaration(Class(goldbook:15793))
AnnotationAssertion(rdfs:label goldbook:15793 "hyperkalemia")
AnnotationAssertion(dcterms:description goldbook:15793 "Excessive concentration of potassium in the blood.")
Declaration(Class(goldbook:15794))
AnnotationAssertion(rdfs:label goldbook:15794 "hypernatremia")
AnnotationAssertion(dcterms:description goldbook:15794 "Excessive concentration of sodium in the blood.")
Declaration(Class(goldbook:15795))
AnnotationAssertion(rdfs:label goldbook:15795 "hyperparathyroidism")
AnnotationAssertion(dcterms:description goldbook:15795 "Abnormally increased parathyroid gland activity that affects, and is affected by, plasma calcium concentration.")
Declaration(Class(goldbook:15796))
AnnotationAssertion(rdfs:label goldbook:15796 "hypertension")
AnnotationAssertion(dcterms:description goldbook:15796 "Persistently high blood pressure in the arteries or in a circuit, for example, pulmonary hypertension or hepatic portal hypertension.")
Declaration(Class(goldbook:15797))
AnnotationAssertion(rdfs:label goldbook:15797 "hypervitaminosis")
AnnotationAssertion(dcterms:description goldbook:15797 "Condition resulting from the ingestion of an excess of one or more vitamins.")
Declaration(Class(goldbook:15798))
AnnotationAssertion(rdfs:label goldbook:15798 "hypo-")
AnnotationAssertion(dcterms:description goldbook:15798 "Prefix meaning under, deficient: when used with the suffix '-emia' refers to blood and with the suffix '-uria' refers to urine, for example, 'hypocalcemia'.")
Declaration(Class(goldbook:15799))
AnnotationAssertion(rdfs:label goldbook:15799 "hypocalcemia")
AnnotationAssertion(dcterms:description goldbook:15799 "Abnormally low calcium concentration in the blood.")
Declaration(Class(goldbook:15800))
AnnotationAssertion(rdfs:label goldbook:15800 "hypokalemia")
AnnotationAssertion(dcterms:description goldbook:15800 "Abnormally low potassium concentration in the blood.")
Declaration(Class(goldbook:15801))
AnnotationAssertion(rdfs:label goldbook:15801 "hypomagnesemia")
AnnotationAssertion(dcterms:description goldbook:15801 "Abnormally low magnesium concentration in the blood.")
Declaration(Class(goldbook:15802))
AnnotationAssertion(rdfs:label goldbook:15802 "hyponatremia")
AnnotationAssertion(dcterms:description goldbook:15802 "Abnormally low sodium concentration in the blood.")
Declaration(Class(goldbook:15803))
AnnotationAssertion(rdfs:label goldbook:15803 "hypovolemic")
AnnotationAssertion(dcterms:description goldbook:15803 "Pertaining to an abnormally decreased volume of circulating fluid (plasma) in the body.")
Declaration(Class(goldbook:15804))
AnnotationAssertion(rdfs:label goldbook:15804 "iatrogenic")
AnnotationAssertion(dcterms:description goldbook:15804 "Any adverse condition resulting from medical treatment.")
Declaration(Class(goldbook:15805))
AnnotationAssertion(rdfs:label goldbook:15805 "icterus")
AnnotationAssertion(dcterms:description goldbook:15805 "Excess of bile pigment in the blood and consequent deposition and retention of bile pigment in the skin and the sclera.")
Declaration(Class(goldbook:15806))
AnnotationAssertion(rdfs:label goldbook:15806 "idiosyncrasy")
AnnotationAssertion(dcterms:description goldbook:15806 "Genetically based unusually high sensitivity of an organism to the effect of certain substances.")
Declaration(Class(goldbook:15807))
AnnotationAssertion(rdfs:label goldbook:15807 "immediately-dangerous-to-life-or-health-concentration")
AnnotationAssertion(dcterms:description goldbook:15807 "According to the U.S. NIOSH, the maximum exposure concentration from which one could escape within \\(\\pu{30 min}\\) without any escape-impairing symptoms or any irreversible health effects.")
Declaration(Class(goldbook:15808))
AnnotationAssertion(rdfs:label goldbook:15808 "in silico")
AnnotationAssertion(dcterms:description goldbook:15808 "Phrase applied to data generated and analyzed using computer modeling and information technology.")
Declaration(Class(goldbook:15809))
AnnotationAssertion(rdfs:label goldbook:15809 "incidence rate")
AnnotationAssertion(dcterms:description goldbook:15809 "Measure of the frequency at which new events occur in a population.")
Declaration(Class(goldbook:15810))
AnnotationAssertion(rdfs:label goldbook:15810 "indication")
AnnotationAssertion(dcterms:description goldbook:15810 "Quantity value provided by a measuring instrument or a measuring system.")
Declaration(Class(goldbook:15811))
AnnotationAssertion(rdfs:label goldbook:15811 "indirect exposure")
AnnotationAssertion(dcterms:description goldbook:15811 """Exposure to a substance in a medium or vehicle other than the one originally receiving the substance.
Exposure of people to a substance by contact with a person directly exposed.""")
Declaration(Class(goldbook:15812))
AnnotationAssertion(rdfs:label goldbook:15812 "individual protective device")
AnnotationAssertion(dcterms:description goldbook:15812 "Device for individual use for protection of the whole body, eyes, respiratory pathways, or skin of workers against hazardous and harmful production factors.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15812 "personal protective device (PPD)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15812 "personal protective equipment (PPE)")
Declaration(Class(goldbook:15813))
AnnotationAssertion(rdfs:label goldbook:15813 "individual risk")
AnnotationAssertion(dcterms:description goldbook:15813 "Probability that an individual person will experience an adverse effect.")
Declaration(Class(goldbook:15814))
AnnotationAssertion(rdfs:label goldbook:15814 "inert chemical")
AnnotationAssertion(dcterms:description goldbook:15814 "Substance that is not generally reactive.")
Declaration(Class(goldbook:15815))
AnnotationAssertion(rdfs:label goldbook:15815 "inert ingredient")
AnnotationAssertion(dcterms:description goldbook:15815 "Any intentionally added ingredient of a mixture that does not contribute to the desired biological effect: This definition does not include impurities and does not imply that the inert ingredient has no biological effects.")
Declaration(Class(goldbook:15816))
AnnotationAssertion(rdfs:label goldbook:15816 "infusion")
AnnotationAssertion(dcterms:description goldbook:15816 "Therapeutic introduction of a fluid other than blood, as a (usually saline) solution, into a vein.")
Declaration(Class(goldbook:15817))
AnnotationAssertion(rdfs:label goldbook:15817 "ingestion")
AnnotationAssertion(dcterms:description goldbook:15817 """Process of taking food and drink into the body by mouth.
Process of taking in particles by a phagocytic cell.""")
Declaration(Class(goldbook:15818))
AnnotationAssertion(rdfs:label goldbook:15818 "inhalation")
AnnotationAssertion(dcterms:description goldbook:15818 "Act of drawing in of air, vapor, or gas and any suspended particulates into the lung.")
Declaration(Class(goldbook:15819))
AnnotationAssertion(rdfs:label goldbook:15819 "inherently biodegradable")
AnnotationAssertion(dcterms:description goldbook:15819 "Class of compounds for which there is unequivocal evidence of biodegradation (primary or ultimate) in any test of biodegradability.")
Declaration(Class(goldbook:15820))
AnnotationAssertion(rdfs:label goldbook:15820 "intake")
AnnotationAssertion(dcterms:description goldbook:15820 "Amount of a substance that is taken into the body, regardless of whether or not it is absorbed: The total daily intake is the sum of the daily intake by an individual from food, drinking-water, and inhaled air.")
Declaration(Class(goldbook:15821))
AnnotationAssertion(rdfs:label goldbook:15821 "integral indicator of toxic effect")
AnnotationAssertion(dcterms:description goldbook:15821 "Parameter (such as body weight or temperature) characterizing the overall changes in the general state of the organism exposed to a toxic substance.")
Declaration(Class(goldbook:15822))
AnnotationAssertion(rdfs:label goldbook:15822 "intermittent effect")
AnnotationAssertion(dcterms:description goldbook:15822 "Biological change that comes and goes at intervals.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15822 "discontinuous effect")
Declaration(Class(goldbook:15823))
AnnotationAssertion(rdfs:label goldbook:15823 "internal validity")
AnnotationAssertion(dcterms:description goldbook:15823 "Selection and comparison of index and comparison groups in such a manner that, apart from sampling error, the observed differences between these groups with respect to dependent variables under study may be attributed only to the hypothesized effect under investigation.")
Declaration(Class(goldbook:15824))
AnnotationAssertion(rdfs:label goldbook:15824 "interpolation")
AnnotationAssertion(dcterms:description goldbook:15824 "Estimation of a value between two known data points.")
Declaration(Class(goldbook:15825))
AnnotationAssertion(rdfs:label goldbook:15825 "interpretation")
AnnotationAssertion(dcterms:description goldbook:15825 "Evaluation of the observations from an investigation or study in order to determine their significance for human health, for the environment or for both.")
Declaration(Class(goldbook:15826))
AnnotationAssertion(rdfs:label goldbook:15826 "interspecies dose conversion")
AnnotationAssertion(dcterms:description goldbook:15826 "Process of extrapolating from the doses of one animal species to another, for example, from rodent dose to human equivalent.")
Declaration(Class(goldbook:15827))
AnnotationAssertion(rdfs:label goldbook:15827 "interstitial fluid")
AnnotationAssertion(dcterms:description goldbook:15827 "Aqueous solution filling the narrow spaces between cells.")
Declaration(Class(goldbook:15828))
AnnotationAssertion(rdfs:label goldbook:15828 "interstitial pneumonia")
AnnotationAssertion(dcterms:description goldbook:15828 "Chronic form of pneumonia involving increase of the interstitial tissue and decrease of the functional lung tissue.")
Declaration(Class(goldbook:15829))
AnnotationAssertion(rdfs:label goldbook:15829 "intervention study")
AnnotationAssertion(dcterms:description goldbook:15829 "Epidemiological investigation designed to test a hypothesized cause–effect relationship by intentional change of a supposed causal factor in a population.")
Declaration(Class(goldbook:15830))
AnnotationAssertion(rdfs:label goldbook:15830 "intestinal reabsorption")
AnnotationAssertion(dcterms:description goldbook:15830 "Absorption further down the intestinal tract of a substance or substances that have been absorbed before and subsequently excreted into the intestinal tract, usually through the bile.")
Declaration(Class(goldbook:15831))
AnnotationAssertion(rdfs:label goldbook:15831 "intoxication")
AnnotationAssertion(dcterms:description goldbook:15831 """Poisoning: pathological process with clinical signs and symptoms caused by a substance of exogenous or endogenous origin.
Drunkenness following consumption of beverages containing ethanol or other compounds affecting the central nervous system.""")
Declaration(Class(goldbook:15832))
AnnotationAssertion(rdfs:label goldbook:15832 "intrinsic activity")
AnnotationAssertion(dcterms:description goldbook:15832 "Maximal stimulatory effect induced by a compound in relation to that of a given reference compound.")
Declaration(Class(goldbook:15833))
AnnotationAssertion(rdfs:label goldbook:15833 "intrinsic clearance")
AnnotationAssertion(dcterms:description goldbook:15833 "Volume of plasma or blood from which a substance is completely removed in a period of time under unstressed conditions.")
Declaration(Class(goldbook:15834))
AnnotationAssertion(rdfs:label goldbook:15834 "intrinsic factor")
AnnotationAssertion(dcterms:description goldbook:15834 "Specific protein required for the absorption of \\(\\ce{vitamin B_{12}}\\) and secreted by cells in the gastric glands of the stomach.")
Declaration(Class(goldbook:15835))
AnnotationAssertion(rdfs:label goldbook:15835 "irreversible alteration")
AnnotationAssertion(dcterms:description goldbook:15835 "Change from normal structure or function that persists or progresses after cessation of exposure of the organism.")
Declaration(Class(goldbook:15836))
AnnotationAssertion(rdfs:label goldbook:15836 "irritant")
AnnotationAssertion(dcterms:description goldbook:15836 """n., Substance that causes inflammation following immediate, prolonged, or repeated contact with skin, mucous membrane, or other biological material.
Note: A substance capable of causing inflammation on first contact is called a primary irritant.
adj., Causing inflammation following immediate, prolonged, or repeated contact with skin, mucous membrane, or other tissues.""")
Declaration(Class(goldbook:15837))
AnnotationAssertion(rdfs:label goldbook:15837 "isotonic")
AnnotationAssertion(dcterms:description goldbook:15837 "Denoting a liquid exerting the same osmotic pressure or chemical potential of water (water potential) as another liquid with which it is being compared.")
Declaration(Class(goldbook:15838))
AnnotationAssertion(rdfs:label goldbook:15838 "itai-itai disease")
AnnotationAssertion(dcterms:description goldbook:15838 "Illness (renal osteomalacia) observed in the Toyama prefecture of Japan, resulting from the ingestion of cadmium-contaminated rice.")
Declaration(Class(goldbook:15839))
AnnotationAssertion(rdfs:label goldbook:15839 "jaundice")
AnnotationAssertion(dcterms:description goldbook:15839 "Pathological condition characterized by deposition of bile pigment in the skin and mucous membranes, including the conjunctivae, resulting in yellow appearance of the patient or animal.")
Declaration(Class(goldbook:15840))
AnnotationAssertion(rdfs:label goldbook:15840 "joint effect")
AnnotationAssertion(dcterms:description goldbook:15840 "Simultaneous or successive effect of factors of diverse types (chemical, physical, biological) on an organism.")
Declaration(Class(goldbook:15841))
AnnotationAssertion(rdfs:label goldbook:15841 "kairomone")
AnnotationAssertion(dcterms:description goldbook:15841 "Semiochemical that is produced by one organism inducing a response in an organism of another species that is unfavorable to the emitter.")
Declaration(Class(goldbook:15842))
AnnotationAssertion(rdfs:label goldbook:15842 "kinetics")
AnnotationAssertion(dcterms:description goldbook:15842 "Branch of chemistry concerned with measuring and studying rates of chemical reactions.")
Declaration(Class(goldbook:15843))
AnnotationAssertion(rdfs:label goldbook:15843 "ketosis")
AnnotationAssertion(dcterms:description goldbook:15843 "Pathological increase in the production of ketone bodies, for example, following blockage or failure of carbohydrate metabolism.")
Declaration(Class(goldbook:15844))
AnnotationAssertion(rdfs:label goldbook:15844 "knock-down")
AnnotationAssertion(dcterms:description goldbook:15844 "Technique used to decrease the expression of a particular gene in a cell or living organism in order to define its function.")
Declaration(Class(goldbook:15845))
AnnotationAssertion(rdfs:label goldbook:15845 "knock-in")
AnnotationAssertion(dcterms:description goldbook:15845 "Technique used to express an exogenous gene or to overexpress an endogenous gene in a living organism in order to define its function.")
Declaration(Class(goldbook:15846))
AnnotationAssertion(rdfs:label goldbook:15846 "knock-out")
AnnotationAssertion(dcterms:description goldbook:15846 "Technique used to inactivate a particular gene in a living organism in order to define its function.")
Declaration(Class(goldbook:15847))
AnnotationAssertion(rdfs:label goldbook:15847 "lacrimator")
AnnotationAssertion(dcterms:description goldbook:15847 "Substance that irritates the eyes and causes the production of tears or increases the flow of tears.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15847 "lachrymator")
Declaration(Class(goldbook:15848))
AnnotationAssertion(rdfs:label goldbook:15848 "larvicide")
AnnotationAssertion(dcterms:description goldbook:15848 "Substance intended to kill larvae.")
Declaration(Class(goldbook:15849))
AnnotationAssertion(rdfs:label goldbook:15849 "laryngospasm")
AnnotationAssertion(dcterms:description goldbook:15849 "Reflex spasmodic closure of the sphincter of the larynx, particularly the glottic sphincter.")
Declaration(Class(goldbook:15850))
AnnotationAssertion(rdfs:label goldbook:15850 "lassitude")
AnnotationAssertion(dcterms:description goldbook:15850 "Weakness; exhaustion.")
Declaration(Class(goldbook:15851))
AnnotationAssertion(rdfs:label goldbook:15851 "lavage")
AnnotationAssertion(dcterms:description goldbook:15851 "Irrigation or washing out of a hollow organ or cavity such as the stomach, intestines, or lungs.")
Declaration(Class(goldbook:15852))
AnnotationAssertion(rdfs:label goldbook:15852 "laxative")
AnnotationAssertion(dcterms:description goldbook:15852 "Substance that causes evacuation of the intestinal contents.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15852 "cathartic")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15852 "purgative")
Declaration(Class(goldbook:15853))
AnnotationAssertion(rdfs:label goldbook:15853 "lead colic")
AnnotationAssertion(dcterms:description goldbook:15853 "Chronic intestinal pains and constipation caused by lead poisoning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15853 "painters’ colic")
Declaration(Class(goldbook:15854))
AnnotationAssertion(rdfs:label goldbook:15854 "lesion")
AnnotationAssertion(dcterms:description goldbook:15854 """Area of pathologically altered tissue.
Injury or wound.
Infected patch of skin.""")
Declaration(Class(goldbook:15856))
AnnotationAssertion(rdfs:label goldbook:15856 "life-long exposure")
AnnotationAssertion(dcterms:description goldbook:15856 "Subjection to a potentially toxic substance during the whole lifetime.")
Declaration(Class(goldbook:15857))
AnnotationAssertion(rdfs:label goldbook:15857 "limacide")
AnnotationAssertion(dcterms:description goldbook:15857 "Substance intended to kill mollusks including the gastropod mollusk, Limax.")
Declaration(Class(goldbook:15858))
AnnotationAssertion(rdfs:label goldbook:15858 "limited evidence")
AnnotationAssertion(dcterms:description goldbook:15858 "According to the USEPA’s Guidelines for Carcinogen Risk Assessment, 'limited evidence' is a collection of facts and accepted scientific inferences that suggests that an agent may be causing an effect, but this suggestion is not strong enough to be considered established fact.")
Declaration(Class(goldbook:15859))
AnnotationAssertion(rdfs:label goldbook:15859 "linearised multistage model")
AnnotationAssertion(dcterms:description goldbook:15859 "Sequence of steps in which (a) a multistage model is fitted to tumor incidence data; (b) the maximum linear term consistent with the data is calculated; (c) the low-dose slope of the dose–response function is equated to the coefficient of the maximum linear term; and (d) the resulting slope is then equated to the upper bound of potency.")
Declaration(Class(goldbook:15860))
AnnotationAssertion(rdfs:label goldbook:15860 "macroscopic pathology")
AnnotationAssertion(dcterms:description goldbook:15860 "Study of changes associated with disease that are visible to the naked eye without the need for a microscope.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15860 "gross pathology")
Declaration(Class(goldbook:15861))
AnnotationAssertion(rdfs:label goldbook:15861 "mainstream smoke")
AnnotationAssertion(dcterms:description goldbook:15861 "Smoke that is inhaled by the smoker.")
Declaration(Class(goldbook:15862))
AnnotationAssertion(rdfs:label goldbook:15862 "malaise")
AnnotationAssertion(dcterms:description goldbook:15862 "Vague feeling of bodily discomfort.")
Declaration(Class(goldbook:15863))
AnnotationAssertion(rdfs:label goldbook:15863 "malignancy")
AnnotationAssertion(dcterms:description goldbook:15863 "Population of cells showing both uncontrolled growth and a tendency to invade and destroy other tissues.")
Declaration(Class(goldbook:15864))
AnnotationAssertion(rdfs:label goldbook:15864 "mania")
AnnotationAssertion(dcterms:description goldbook:15864 "Emotional disorder (mental illness) characterized by an expansive and elated state (euphoria), rapid speech, flight of ideas, decreased need for sleep, distractibility, grandiosity, poor judgment, and increased motor activity.")
Declaration(Class(goldbook:15865))
AnnotationAssertion(rdfs:label goldbook:15865 "margin of exposure")
AnnotationAssertion(dcterms:description goldbook:15865 "Ratio of the no-observed-adverse-effect level (NOAEL) to the theoretical or estimated exposure dose (EED) or concentration (EEC).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15865 "margin of safety (MOS)")
Declaration(Class(goldbook:15866))
AnnotationAssertion(rdfs:label goldbook:15866 "mass mean diameter")
AnnotationAssertion(dcterms:description goldbook:15866 "Diameter of a spherical particle with a mass equal to the mean mass of all the particles in a population.")
Declaration(Class(goldbook:15867))
AnnotationAssertion(rdfs:label goldbook:15867 "mass median diameter")
AnnotationAssertion(dcterms:description goldbook:15867 "Diameter of a spherical particle with the median mass of all the particles in a population.")
Declaration(Class(goldbook:15868))
AnnotationAssertion(rdfs:label goldbook:15868 "maximum average daily concentration of an atmospheric pollutant")
AnnotationAssertion(dcterms:description goldbook:15868 "Highest of the average daily concentrations recorded at a definite point of measurement during a certain period of observation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15868 "peak daily average concentration of an air pollutant")
Declaration(Class(goldbook:15869))
AnnotationAssertion(rdfs:label goldbook:15869 "maximum contaminant level")
AnnotationAssertion(dcterms:description goldbook:15869 "Under the Safe Drinking Water Act (USA), primary MCL is a regulatory concentration for drinking water which takes into account both adverse effects (including sensitive populations) and technological feasibility (including natural background levels): Secondary MCL is a regulatory concentration based on 'welfare', such as taste and staining, rather than health, but also takes into account technical feasibility.")
Declaration(Class(goldbook:15870))
AnnotationAssertion(rdfs:label goldbook:15870 "maximum exposure limit")
AnnotationAssertion(dcterms:description goldbook:15870 "Occupational exposure limit legally defined in the United Kingdom under COSHH as the maximum concentration of an airborne substance, averaged over a reference period, to which employees may be exposed by inhalation under any circumstances, and set on the advice of the HSC Advisory Committee on Toxic Substances.")
Declaration(Class(goldbook:15871))
AnnotationAssertion(rdfs:label goldbook:15871 "maximum residue limit")
AnnotationAssertion(dcterms:description goldbook:15871 "Maximum contents of a pesticide residue (expressed as \\(\\pu{mg kg-1}\\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted in or on food commodities and animal feeds.")
Declaration(Class(goldbook:15872))
AnnotationAssertion(rdfs:label goldbook:15872 "maximum residue limit for veterinary drugs")
AnnotationAssertion(dcterms:description goldbook:15872 "Maximum contents of a drug residue (expressed as \\(\\pu{mg kg-1}\\) or \\(\\pu{\\upmu g kg-1}\\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food commodities and animal feeds.")
Declaration(Class(goldbook:15873))
AnnotationAssertion(rdfs:label goldbook:15873 "maximum velocity")
AnnotationAssertion(dcterms:description goldbook:15873 "In Michaelis–Menten kinetics, the maximum rate of conversion of a substrate when its concentration is not rate-limiting.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15873 "maximum rate")
Declaration(Class(goldbook:15874))
AnnotationAssertion(rdfs:label goldbook:15874 "mercurialism")
AnnotationAssertion(dcterms:description goldbook:15874 "Chronic poisoning caused by exposure to mercury, often by breathing its vapor but also by skin absorption and, less commonly, by ingestion.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15874 "Mad Hatter syndrome")
Declaration(Class(goldbook:15875))
AnnotationAssertion(rdfs:label goldbook:15875 "mesothelioma")
AnnotationAssertion(dcterms:description goldbook:15875 "Malignant tumor of the mesothelium of the pleura, pericardium, or peritoneum, that may be caused by exposure to asbestos fibers and some other fibers.")
Declaration(Class(goldbook:15876))
AnnotationAssertion(rdfs:label goldbook:15876 "metabolic enzymes")
AnnotationAssertion(dcterms:description goldbook:15876 "Proteins that catalyze chemical transformations of body constituents and, in more common usage, of xenobiotics.")
Declaration(Class(goldbook:15877))
AnnotationAssertion(rdfs:label goldbook:15877 "metabolic model")
AnnotationAssertion(dcterms:description goldbook:15877 "Analysis and theoretical reconstruction of the way in which the body deals with a specific substance, showing the proportion of the intake that is absorbed, the proportion that is stored and in what tissues, the rate of breakdown in the body and the subsequent fate of the metabolic products, and the rate at which it is eliminated by different organs as unchanged substance or metabolites.")
Declaration(Class(goldbook:15878))
AnnotationAssertion(rdfs:label goldbook:15878 "metabolic transformation")
AnnotationAssertion(dcterms:description goldbook:15878 "Biotransformation of a substance that takes place within a living organism.")
Declaration(Class(goldbook:15879))
AnnotationAssertion(rdfs:label goldbook:15879 "metastasis")
AnnotationAssertion(dcterms:description goldbook:15879 """Movement of bacteria or body cells, especially cancer cells, from one part of the body to another, resulting in change in location of a disease or of its symptoms from one part of the body to another.
Growth of pathogenic microorganisms or of abnormal cells distant from the site of their origin in the body.""")
Declaration(Class(goldbook:15880))
AnnotationAssertion(rdfs:label goldbook:15880 "methemoglobin")
AnnotationAssertion(dcterms:description goldbook:15880 "Derivative of hemoglobin that is formed when the iron(II) in the heme porphyrin is oxidized to iron(III); this derivative cannot transport dioxygen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15880 "methaemoglobin")
Declaration(Class(goldbook:15881))
AnnotationAssertion(rdfs:label goldbook:15881 "methemoglobinaemia")
AnnotationAssertion(dcterms:description goldbook:15881 "Presence of methaemoglobin in the blood in greater than normal proportion.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15881 "methaemoglobinaemia")
Declaration(Class(goldbook:15882))
AnnotationAssertion(rdfs:label goldbook:15882 "methemoglobin-forming substance")
AnnotationAssertion(dcterms:description goldbook:15882 "Substance capable of oxidizing directly or indirectly the iron(II) in hemoglobin to iron(III) to form methemoglobin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15882 "methaemoglobin-forming substance")
Declaration(Class(goldbook:15883))
AnnotationAssertion(rdfs:label goldbook:15883 "microalbuminuria")
AnnotationAssertion(dcterms:description goldbook:15883 "Chronic presence of albumin in slight excess in urine.")
Declaration(Class(goldbook:15884))
AnnotationAssertion(rdfs:label goldbook:15884 "micromercurialism")
AnnotationAssertion(dcterms:description goldbook:15884 "Early or subclinical effects of exposure to elemental mercury detected at the low exposure levels.")
Declaration(Class(goldbook:15885))
AnnotationAssertion(rdfs:label goldbook:15885 "microproteinaemia")
AnnotationAssertion(dcterms:description goldbook:15885 "Chronic presence of microprotein (alpha-1 and beta-2 microglobulin) in blood, indicating proximal renal tubule damage.")
Declaration(Class(goldbook:15886))
AnnotationAssertion(rdfs:label goldbook:15886 "midstream sampling")
AnnotationAssertion(dcterms:description goldbook:15886 "Taking an aliquot of a flowing liquid, such as urine, avoiding initial and terminal flow periods which are likely to be unrepresentative.")
Declaration(Class(goldbook:15887))
AnnotationAssertion(rdfs:label goldbook:15887 "minimal risk level")
AnnotationAssertion(dcterms:description goldbook:15887 "Estimate of the daily human exposure to a hazardous substance that is likely to be without appreciable risk of adverse noncancer health effects over a specified duration of exposure: This substance-specific estimate is used by ATSDR health assessors to identify contaminants and potential health effects that may be of concern at hazardous waste sites.")
Declaration(Class(goldbook:15888))
AnnotationAssertion(rdfs:label goldbook:15888 "miscible")
AnnotationAssertion(dcterms:description goldbook:15888 "Liquid substances capable of mixing without separation into two phases; refers to liquid mixtures.")
Declaration(Class(goldbook:15889))
AnnotationAssertion(rdfs:label goldbook:15889 "miticide")
AnnotationAssertion(dcterms:description goldbook:15889 "Substance intended to kill mites.")
Declaration(Class(goldbook:15890))
AnnotationAssertion(rdfs:label goldbook:15890 "mitochondrion")
AnnotationAssertion(dcterms:description goldbook:15890 "Eukaryote cytoplasmic organelle that is bounded by an outer membrane and an inner membrane; the inner membrane has folds called cristae that are the center of ATP synthesis in oxidative phosphorylation in the animal cell and supplement ATP synthesis by the chloroplasts in photosynthetic cells.")
Declaration(Class(goldbook:15891))
AnnotationAssertion(rdfs:label goldbook:15891 "molluskicide")
AnnotationAssertion(dcterms:description goldbook:15891 "Substance intended to kill mollusks.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15891 "limacide")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15891 "molluscicide")
Declaration(Class(goldbook:15892))
AnnotationAssertion(rdfs:label goldbook:15892 "monooxygenase")
AnnotationAssertion(dcterms:description goldbook:15892 "Enzyme that catalyzes reactions between an organic compound and molecular oxygen in which one atom of the oxygen molecule is incorporated into the organic compound and one atom is reduced to water; involved in the metabolism of many natural and foreign compounds giving both unreactive products and products of different or increased toxicity from that of the parent compound.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15892 "mixed-function oxidase (MFO)")
Declaration(Class(goldbook:15893))
AnnotationAssertion(rdfs:label goldbook:15893 "morbidity")
AnnotationAssertion(dcterms:description goldbook:15893 "Any departure, subjective or objective, from a state of physiological or psychological well-being: In this sense, 'sickness', 'illness', and 'morbid condition' are similarly defined and synonymous.")
Declaration(Class(goldbook:15894))
AnnotationAssertion(rdfs:label goldbook:15894 "morbidity rate")
AnnotationAssertion(dcterms:description goldbook:15894 "Term (to be avoided) used loosely to refer to incidence or prevalence rates of disease.")
Declaration(Class(goldbook:15895))
AnnotationAssertion(rdfs:label goldbook:15895 "morbidity survey")
AnnotationAssertion(dcterms:description goldbook:15895 "Method for the estimation of the prevalence and (or) incidence of a disease or diseases in a population.")
Declaration(Class(goldbook:15896))
AnnotationAssertion(rdfs:label goldbook:15896 "mortality study")
AnnotationAssertion(dcterms:description goldbook:15896 "Investigation dealing with death rates or proportion of deaths attributed to specific causes as a measure of response.")
Declaration(Class(goldbook:15897))
AnnotationAssertion(rdfs:label goldbook:15897 "mucociliary transport")
AnnotationAssertion(dcterms:description goldbook:15897 "Process of removal of particles from the bronchi of the lungs in a mucus stream moved by cilia, thus contributing to uptake from the gastrointestinal tract.")
Declaration(Class(goldbook:15898))
AnnotationAssertion(rdfs:label goldbook:15898 "multicompartment model")
AnnotationAssertion(dcterms:description goldbook:15898 "Product of a compartmental analysis requiring more than two compartments.")
Declaration(Class(goldbook:15899))
AnnotationAssertion(rdfs:label goldbook:15899 "multifactorial disease")
AnnotationAssertion(dcterms:description goldbook:15899 "Illness with pathogenesis dependent on complex interplay of genetic and (or) environmental factors.")
Declaration(Class(goldbook:15900))
AnnotationAssertion(rdfs:label goldbook:15900 "multiple screening")
AnnotationAssertion(dcterms:description goldbook:15900 "Procedure that has evolved by combining single screening tests, and is the logical corollary of mass screening.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15900 "multiphasic screening")
Declaration(Class(goldbook:15901))
AnnotationAssertion(rdfs:label goldbook:15901 "multipotent")
AnnotationAssertion(dcterms:description goldbook:15901 "Of a cell, capable of giving rise to several different kinds of structure or types of cell.")
Declaration(Class(goldbook:15902))
AnnotationAssertion(rdfs:label goldbook:15902 "multistage cluster sampling")
AnnotationAssertion(dcterms:description goldbook:15902 "Cluster sampling with more than two stages, each sampling being made on aggregates (or clusters) in which the clusters already obtained by the preceding sampling have been divided.")
Declaration(Class(goldbook:15903))
AnnotationAssertion(rdfs:label goldbook:15903 "multistage model")
AnnotationAssertion(dcterms:description goldbook:15903 "Dose–response model for cancer death estimation of the form \\[P = 1 - \\exp [-(q_{0} + q_{1}d_{1} + q_{2}d_{2} + \\ldots + q_{k}d_{k})]\\] where \\(P\\) is the probability of cancer death from a continuous dose rate, \\(d_{i}\\) , of group (or stage) \\(i = 0, 1, 2 \\ldots\\), the \\(q\\)’s are constants, and \\(k\\) is the number of dose groups (or, if less than the number of dose groups, \\(k\\) is the number of biological stages believed to be required in the carcinogenesis process). With the multistage model, it is assumed that cancer is initiated by cell mutations in a finite series of steps.")
Declaration(Class(goldbook:15904))
AnnotationAssertion(rdfs:label goldbook:15904 "murine")
AnnotationAssertion(dcterms:description goldbook:15904 "Of or belonging to the family of rats and mice (Muridae).")
Declaration(Class(goldbook:15905))
AnnotationAssertion(rdfs:label goldbook:15905 "myalgia")
AnnotationAssertion(dcterms:description goldbook:15905 "Pain or tenderness in a muscle or group of muscles.")
Declaration(Class(goldbook:15906))
AnnotationAssertion(rdfs:label goldbook:15906 "myasthenia")
AnnotationAssertion(dcterms:description goldbook:15906 "Muscular weakness.")
Declaration(Class(goldbook:15907))
AnnotationAssertion(rdfs:label goldbook:15907 "mycotoxin")
AnnotationAssertion(dcterms:description goldbook:15907 "Toxin produced by a fungus.")
Declaration(Class(goldbook:15908))
AnnotationAssertion(rdfs:label goldbook:15908 "nanotoxicology")
AnnotationAssertion(dcterms:description goldbook:15908 "Scientific discipline involving the study of the actual or potential danger presented by the harmful effects of nanoparticles on living organisms and ecosystems, of the relationship of such harmful effects to exposure, and of the mechanisms of action, diagnosis, prevention, and treatment of intoxications.")
Declaration(Class(goldbook:15909))
AnnotationAssertion(rdfs:label goldbook:15909 "natriuretic")
AnnotationAssertion(dcterms:description goldbook:15909 "Substance increasing the rate of excretion of sodium ion in the urine.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15909 "saluretic")
Declaration(Class(goldbook:15910))
AnnotationAssertion(rdfs:label goldbook:15910 "natural occurrence")
AnnotationAssertion(dcterms:description goldbook:15910 "Presence of a substance in nature, as distinct from presence resulting from inputs from human activities.")
Declaration(Class(goldbook:15911))
AnnotationAssertion(rdfs:label goldbook:15911 "negligible risk")
AnnotationAssertion(dcterms:description goldbook:15911 """Probability of adverse effects occurring that can reasonably be described as trivial.
Probability of adverse effects occurring that is so low that it cannot be reduced appreciably by increased regulation or investment of resources.""")
Declaration(Class(goldbook:15912))
AnnotationAssertion(rdfs:label goldbook:15912 "nematicide")
AnnotationAssertion(dcterms:description goldbook:15912 "Substance intended to kill nematodes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15912 "nematocide")
Declaration(Class(goldbook:15913))
AnnotationAssertion(rdfs:label goldbook:15913 "neoplasia")
AnnotationAssertion(dcterms:description goldbook:15913 "New and abnormal formation of tissue as a tumor or growth by cell proliferation that is faster than normal and continues after the initial stimulus that initiated the proliferation has ceased.")
Declaration(Class(goldbook:15914))
AnnotationAssertion(rdfs:label goldbook:15914 "nephritis")
AnnotationAssertion(dcterms:description goldbook:15914 "Inflammation of the kidney, leading to kidney failure, usually accompanied by proteinuria, hematuria, edema, and hypertension.")
Declaration(Class(goldbook:15915))
AnnotationAssertion(rdfs:label goldbook:15915 "nephropathy")
AnnotationAssertion(dcterms:description goldbook:15915 "Any disease or abnormality of the kidney.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15915 "renopathy")
Declaration(Class(goldbook:15916))
AnnotationAssertion(rdfs:label goldbook:15916 "nephrosis")
AnnotationAssertion(dcterms:description goldbook:15916 "Disease of the kidneys marked by degeneration of renal tubular epithelium.")
Declaration(Class(goldbook:15917))
AnnotationAssertion(rdfs:label goldbook:15917 "nephrotoxic")
AnnotationAssertion(dcterms:description goldbook:15917 "Chemically harmful to the cells of the kidney.")
Declaration(Class(goldbook:15918))
AnnotationAssertion(rdfs:label goldbook:15918 "nitrosative stress")
AnnotationAssertion(dcterms:description goldbook:15918 "Adverse effects occurring when the generation of reactive nitrogen species in a system exceeds the system’s ability to neutralize and eliminate them; nitrosative stress may lead to nitrosylation reactions that can alter protein structure, thus inhibiting normal function.")
Declaration(Class(goldbook:15919))
AnnotationAssertion(rdfs:label goldbook:15919 "no-acceptable-daily-intake-allocated")
AnnotationAssertion(dcterms:description goldbook:15919 "This expression is applicable to a substance for which the available information is not sufficient to establish its safety, or when the specifications for identity and purity are not adequate, or when the available data show that the substance is hazardous and should not be used.")
Declaration(Class(goldbook:15920))
AnnotationAssertion(rdfs:label goldbook:15920 "nodule")
AnnotationAssertion(dcterms:description goldbook:15920 "Small node or boss that is solid and can be detected by touch.")
Declaration(Class(goldbook:15921))
AnnotationAssertion(rdfs:label goldbook:15921 "no-effect dose")
AnnotationAssertion(dcterms:description goldbook:15921 "Amount of a substance that has no effect on the organism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15921 "subthreshold dose")
Declaration(Class(goldbook:15922))
AnnotationAssertion(rdfs:label goldbook:15922 "no-effect level")
AnnotationAssertion(dcterms:description goldbook:15922 "Maximum dose (of a substance) that produces no detectable changes under defined conditions of exposure.")
Declaration(Class(goldbook:15923))
AnnotationAssertion(rdfs:label goldbook:15923 "non-bioenvironmental transformation")
AnnotationAssertion(dcterms:description goldbook:15923 "Change in the chemical or physical nature of a substance occurring as a result of physicochemical conditions and independent of any biological system.")
Declaration(Class(goldbook:15924))
AnnotationAssertion(rdfs:label goldbook:15924 "nonionising radiation")
AnnotationAssertion(dcterms:description goldbook:15924 "Electromagnetic radiation of low energy that is not capable of causing ionization.")
Declaration(Class(goldbook:15925))
AnnotationAssertion(rdfs:label goldbook:15925 "nonoccupational exposure")
AnnotationAssertion(dcterms:description goldbook:15925 "Environmental exposure outside the workplace to substances that are otherwise associated with particular work environments and (or) activities and processes that occur there.")
Declaration(Class(goldbook:15927))
AnnotationAssertion(rdfs:label goldbook:15927 "nosocomial")
AnnotationAssertion(dcterms:description goldbook:15927 "Associated with a hospital or infirmary, especially used of diseases that may result from treatment in such an institution.")
Declaration(Class(goldbook:15928))
AnnotationAssertion(rdfs:label goldbook:15928 "nutritional table method")
AnnotationAssertion(dcterms:description goldbook:15928 "Procedure for evaluating the dietary intake of a large number of people.")
Declaration(Class(goldbook:15929))
AnnotationAssertion(rdfs:label goldbook:15929 "nychthemeral")
AnnotationAssertion(dcterms:description goldbook:15929 "Relating to or exhibiting a nychthemeron or \\(\\pu{24\\!\\mbox{-}h}\\) period.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15929 "circadian")
Declaration(Class(goldbook:15930))
AnnotationAssertion(rdfs:label goldbook:15930 "objective environment")
AnnotationAssertion(dcterms:description goldbook:15930 "Actual physical, chemical, and social environment as described by objective measurements, such as noise levels in decibels and concentrations of air pollutants.")
Declaration(Class(goldbook:15931))
AnnotationAssertion(rdfs:label goldbook:15931 "occupational environment")
AnnotationAssertion(dcterms:description goldbook:15931 "Surrounding conditions at a workplace.")
Declaration(Class(goldbook:15932))
AnnotationAssertion(rdfs:label goldbook:15932 "occupational exposure")
AnnotationAssertion(dcterms:description goldbook:15932 "Experience of substances, intensities of radiation, etc., or other conditions while at work.")
Declaration(Class(goldbook:15933))
AnnotationAssertion(rdfs:label goldbook:15933 "occupational exposure limit")
AnnotationAssertion(dcterms:description goldbook:15933 "Regulatory level of exposure to substances, intensities of radiation, etc., or other conditions, specified appropriately in relevant government legislation or related codes of practice.")
Declaration(Class(goldbook:15934))
AnnotationAssertion(rdfs:label goldbook:15934 "occupational exposure standard")
AnnotationAssertion(dcterms:description goldbook:15934 """Level of exposure to substances, intensities of radiation, etc., or other conditions considered to represent specified good practice and a realistic criterion for the control of exposure by appropriate plant design, engineering controls, and, if necessary, the addition and use of personal protective clothing.
In UK, health-based exposure limit defined under COSHH Regulations as the concentration of any airborne substance, averaged over a reference period, at which, according to current knowledge, there is no evidence that it is likely to be injurious to employees, if they are exposed by inhalation, day after day, to that concentration, and set on the advice of the HSE Advisory Committee on Toxic Substances.""")
Declaration(Class(goldbook:15935))
AnnotationAssertion(rdfs:label goldbook:15935 "occupational hygiene")
AnnotationAssertion(dcterms:description goldbook:15935 "Identification, assessment, and control of physicochemical and biological factors in the workplace that may affect the health or well-being of those at work and in the surrounding community.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15935 "industrial hygiene")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15935 "occupational safety and health")
Declaration(Class(goldbook:15936))
AnnotationAssertion(rdfs:label goldbook:15936 "occupational medicine")
AnnotationAssertion(dcterms:description goldbook:15936 "Specialty devoted to the prevention and management of occupational injury, illness, and disability, and the promotion of the health of workers, their families, and their communities.")
Declaration(Class(goldbook:15937))
AnnotationAssertion(rdfs:label goldbook:15937 "ocular")
AnnotationAssertion(dcterms:description goldbook:15937 "Pertaining to the eye.")
Declaration(Class(goldbook:15938))
AnnotationAssertion(rdfs:label goldbook:15938 "odds")
AnnotationAssertion(dcterms:description goldbook:15938 "Ratio of the probability of occurrence of an event to that of non-occurrence, or the ratio of the probability that something is so, to the probability that it is not so.")
Declaration(Class(goldbook:15939))
AnnotationAssertion(rdfs:label goldbook:15939 "odds ratio")
AnnotationAssertion(dcterms:description goldbook:15939 "Quotient obtained by dividing one set of odds by another. The terms 'odds' or 'odds ratio' are defined differently according to the situation under discussion. Consider the following notation for the distribution of a binary exposure and a disease in a population or a sample. \\[\\begin{array}{l c c} & Exposed & Nonexposed \\\\ \\rm{Disease} & a & b \\\\ \\rm{No\\ disease} & c & d \\\\ \\end{array}\\] The odds ratio (cross-product ratio) is \\(ad/bc\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15939 "cross-product ratio")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15939 "relative odds")
Declaration(Class(goldbook:15940))
AnnotationAssertion(rdfs:label goldbook:15940 "odor threshold")
AnnotationAssertion(dcterms:description goldbook:15940 "In principle, the lowest concentration of an odorant in the air that can be detected by a human being.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15940 "odor detection threshold")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15940 "odour threshold")
Declaration(Class(goldbook:15941))
AnnotationAssertion(rdfs:label goldbook:15941 "olf")
AnnotationAssertion(dcterms:description goldbook:15941 "Unit used to measure scent emission of people and objects; one olf is defined as the scent emission of an 'average person', a sitting adult who takes an average of \\(\\pu{0.7}\\) baths per day and whose skin has a total area of \\(\\pu{1.8 m2}\\); the scent emission of an object or person is measured by specially trained personnel comparing it to normed scents.")
Declaration(Class(goldbook:15942))
AnnotationAssertion(rdfs:label goldbook:15942 "olfactometer")
AnnotationAssertion(dcterms:description goldbook:15942 "Apparatus for testing the power of the sense of smell.")
Declaration(Class(goldbook:15943))
AnnotationAssertion(rdfs:label goldbook:15943 "oligozoospermia")
AnnotationAssertion(dcterms:description goldbook:15943 "Sperm concentration less than a reference value.")
Declaration(Class(goldbook:15944))
AnnotationAssertion(rdfs:label goldbook:15944 "oliguria")
AnnotationAssertion(dcterms:description goldbook:15944 "Excretion of a diminished amount of urine in relation to fluid intake.")
Declaration(Class(goldbook:15945))
AnnotationAssertion(rdfs:label goldbook:15945 "-omics, -omes")
AnnotationAssertion(dcterms:description goldbook:15945 "Neologism referring to the fields of study in biology ending in the suffix -omics, such as genomics or proteomics: The related neologism -omes are the objects of study of the field such as the genome or proteome, respectively.")
Declaration(Class(goldbook:15946))
AnnotationAssertion(rdfs:label goldbook:15946 "oncogene")
AnnotationAssertion(dcterms:description goldbook:15946 "Gene that can cause neoplastic (see neoplasia) transformation of a cell; oncogenes are slightly changed equivalents of normal genes known as proto-oncogenes.")
Declaration(Class(goldbook:15947))
AnnotationAssertion(rdfs:label goldbook:15947 "oncogenesis")
AnnotationAssertion(dcterms:description goldbook:15947 "Production or causation of tumors.")
Declaration(Class(goldbook:15948))
AnnotationAssertion(rdfs:label goldbook:15948 "oncogenic")
AnnotationAssertion(dcterms:description goldbook:15948 "Capable of producing tumors in animals, either benign (noncancerous) or malignant (cancerous).")
Declaration(Class(goldbook:15949))
AnnotationAssertion(rdfs:label goldbook:15949 "one-hit model")
AnnotationAssertion(dcterms:description goldbook:15949 "Dose-response model of the form \\[P = 1 - {\\rm{e}}^{-bd}\\] where \\(P\\) is the probability of cancer death from a continuous dose rate, \\(d\\), and \\(b\\) is a constant.")
Declaration(Class(goldbook:15950))
AnnotationAssertion(rdfs:label goldbook:15950 "onycholysis")
AnnotationAssertion(dcterms:description goldbook:15950 "Loosening or detachment of the nail from the nail bed following some destructive process.")
Declaration(Class(goldbook:15951))
AnnotationAssertion(rdfs:label goldbook:15951 "ophthalmic")
AnnotationAssertion(dcterms:description goldbook:15951 "Pertaining to the eye.")
Declaration(Class(goldbook:15952))
AnnotationAssertion(rdfs:label goldbook:15952 "organ dose")
AnnotationAssertion(dcterms:description goldbook:15952 "Amount of a substance or physical agent (radiation) absorbed by an organ.")
Declaration(Class(goldbook:15953))
AnnotationAssertion(rdfs:label goldbook:15953 "organelle")
AnnotationAssertion(dcterms:description goldbook:15953 "Microstructure or separated compartment within a cell that has a specialized function.")
Declaration(Class(goldbook:15954))
AnnotationAssertion(rdfs:label goldbook:15954 "organic carbon partition coefficient")
AnnotationAssertion(dcterms:description goldbook:15954 "Measure of the tendency for organic substances to be adsorbed by soil or sediment, expressed as: \\[K_{\\rm{oc}} = \\frac{(\\ce{mass adsorbed substance})/(\\ce{mass organic carbon})}{(\\ce{mass concentration of absorbed substance})}\\]")
Declaration(Class(goldbook:15955))
AnnotationAssertion(rdfs:label goldbook:15955 "osteo-")
AnnotationAssertion(dcterms:description goldbook:15955 "Prefix meaning pertaining to bone.")
Declaration(Class(goldbook:15956))
AnnotationAssertion(rdfs:label goldbook:15956 "osteodystrophy")
AnnotationAssertion(dcterms:description goldbook:15956 "Abnormal development of bone.")
Declaration(Class(goldbook:15957))
AnnotationAssertion(rdfs:label goldbook:15957 "osteomalacia")
AnnotationAssertion(dcterms:description goldbook:15957 "Condition marked by softening of the bones (due to impaired mineralization, with excess accumulation of osteoid), with pain, tenderness, muscular weakness, anorexia, and loss of weight, resulting from deficiency of vitamin D and calcium.")
Declaration(Class(goldbook:15958))
AnnotationAssertion(rdfs:label goldbook:15958 "osteoporosis")
AnnotationAssertion(dcterms:description goldbook:15958 "Significant decrease in bone mass with increased porosity and increased tendency to fracture.")
Declaration(Class(goldbook:15959))
AnnotationAssertion(rdfs:label goldbook:15959 "ovicide")
AnnotationAssertion(dcterms:description goldbook:15959 "Substance intended to kill eggs.")
Declaration(Class(goldbook:15960))
AnnotationAssertion(rdfs:label goldbook:15960 "para-occupational exposure")
AnnotationAssertion(dcterms:description goldbook:15960 """Exposure of a worker’s family to substances carried from the workplace to the home.
Exposure of visitors to substances in the workplace.""")
Declaration(Class(goldbook:15961))
AnnotationAssertion(rdfs:label goldbook:15961 "parasympathetic")
AnnotationAssertion(dcterms:description goldbook:15961 "Of, relating to, or affecting the parasympathetic nervous system which stimulates digestive secretions, slows the heart, constricts the pupils of the eyes, and dilates blood vessels.")
Declaration(Class(goldbook:15962))
AnnotationAssertion(rdfs:label goldbook:15962 "parasympatholytic")
AnnotationAssertion(dcterms:description goldbook:15962 "Producing effects resembling those caused by interruption of the parasympathetic nerve; also called anticholinergic.")
Declaration(Class(goldbook:15963))
AnnotationAssertion(rdfs:label goldbook:15963 "parenteral dosage")
AnnotationAssertion(dcterms:description goldbook:15963 "Method of introducing substances into an organism avoiding the gastrointestinal tract (subcutaneously, intravenously, intramuscularly, etc.).")
Declaration(Class(goldbook:15964))
AnnotationAssertion(rdfs:label goldbook:15964 "passive smoking")
AnnotationAssertion(dcterms:description goldbook:15964 "Inhalation of sidestream smoke by people who do not smoke themselves.")
Declaration(Class(goldbook:15965))
AnnotationAssertion(rdfs:label goldbook:15965 "penetration")
AnnotationAssertion(dcterms:description goldbook:15965 """Action of entering or passing through a cell membrane.
Ability or power to enter or pass through a cell membrane.""")
Declaration(Class(goldbook:15966))
AnnotationAssertion(rdfs:label goldbook:15966 "percutaneous")
AnnotationAssertion(dcterms:description goldbook:15966 "Through the skin following application on the skin.")
Declaration(Class(goldbook:15967))
AnnotationAssertion(rdfs:label goldbook:15967 "perfusion")
AnnotationAssertion(dcterms:description goldbook:15967 """Act of pouring over or through, especially the passage of a fluid through the vessels of a specific organ.
Liquid poured over or through an organ or tissue.""")
Declaration(Class(goldbook:15968))
AnnotationAssertion(rdfs:label goldbook:15968 "peritoneal dialysis")
AnnotationAssertion(dcterms:description goldbook:15968 "Method of artificial detoxication in which a toxic substance from the body is transferred into liquid that is instilled into the peritoneum.")
Declaration(Class(goldbook:15969))
AnnotationAssertion(rdfs:label goldbook:15969 "permeability coefficient")
AnnotationAssertion(dcterms:description goldbook:15969 "Quantity defining the permeability of molecules across a cell membrane and expressed as \\[P = \\frac{KD}{\\Delta x}\\] where \\(K\\) is the partition coefficient, \\(D\\) is the diffusion coefficient, and \\(\\Delta x\\) is the thickness of the cell membrane.")
Declaration(Class(goldbook:15970))
AnnotationAssertion(rdfs:label goldbook:15970 "permeable")
AnnotationAssertion(dcterms:description goldbook:15970 "Of a membrane, allowing a given substance to pass through.")
Declaration(Class(goldbook:15971))
AnnotationAssertion(rdfs:label goldbook:15971 "permissible exposure limit")
AnnotationAssertion(dcterms:description goldbook:15971 "Recommendation by U.S. OSHA for a time-weighted average concentration that must not be exceeded during any \\(\\pu{8\\!\\mbox{-}h}\\) work shift of a \\(\\pu{40\\!\\mbox{-}h}\\) working week.")
Declaration(Class(goldbook:15972))
AnnotationAssertion(rdfs:label goldbook:15972 "personal monitoring")
AnnotationAssertion(dcterms:description goldbook:15972 "Type of environmental monitoring in which an individual’s exposure to a substance is measured and evaluated.")
Declaration(Class(goldbook:15973))
AnnotationAssertion(rdfs:label goldbook:15973 "personal protective device")
AnnotationAssertion(dcterms:description goldbook:15973 "Equipment (clothing, gloves, hard hat, respirator, etc.) worn by an individual to prevent exposure to a potentially toxic substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15973 "individual protective device (IPD)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15973 "personal protective equipment (PPE)")
Declaration(Class(goldbook:15974))
AnnotationAssertion(rdfs:label goldbook:15974 "personal sampler")
AnnotationAssertion(dcterms:description goldbook:15974 "Compact, portable instrument for individual air sampling, measuring, or both, the content of a harmful substance in the respiration zone of a working person.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15974 "individual monitor")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15974 "individual sampler")
Declaration(Class(goldbook:15975))
AnnotationAssertion(rdfs:label goldbook:15975 "pest")
AnnotationAssertion(dcterms:description goldbook:15975 "Organism that may harm public health, attacks food and other materials essential to mankind, or otherwise affects human beings adversely.")
Declaration(Class(goldbook:15976))
AnnotationAssertion(rdfs:label goldbook:15976 "phase III reaction")
AnnotationAssertion(dcterms:description goldbook:15976 "Further metabolism of conjugated metabolites produced by phase II reactions.")
Declaration(Class(goldbook:15977))
AnnotationAssertion(rdfs:label goldbook:15977 "phenome")
AnnotationAssertion(dcterms:description goldbook:15977 "Complete phenotypic description of an organism (by analogy with genome).")
Declaration(Class(goldbook:15978))
AnnotationAssertion(rdfs:label goldbook:15978 "photo-irritation")
AnnotationAssertion(dcterms:description goldbook:15978 "Inflammation of the skin caused by exposure to light, especially that due to metabolites formed in the skin by photolysis.")
Declaration(Class(goldbook:15979))
AnnotationAssertion(rdfs:label goldbook:15979 "phototoxicity")
AnnotationAssertion(dcterms:description goldbook:15979 "Adverse effects produced by exposure to light energy, especially those produced in the skin.")
Declaration(Class(goldbook:15980))
AnnotationAssertion(rdfs:label goldbook:15980 "physical map")
AnnotationAssertion(dcterms:description goldbook:15980 "Map showing how much DNA, measured in base pairs, separates two genes.")
Declaration(Class(goldbook:15981))
AnnotationAssertion(rdfs:label goldbook:15981 "piscicide")
AnnotationAssertion(dcterms:description goldbook:15981 "Substance intended to kill fish.")
Declaration(Class(goldbook:15982))
AnnotationAssertion(rdfs:label goldbook:15982 "placentation")
AnnotationAssertion(dcterms:description goldbook:15982 """Formation of a placenta in the uterus.
Type or structure of a placenta.
In botany, arrangement of placentas within the plant ovary.""")
Declaration(Class(goldbook:15983))
AnnotationAssertion(rdfs:label goldbook:15983 "plumbism")
AnnotationAssertion(dcterms:description goldbook:15983 "Chronic poisoning caused by absorption of lead or lead salts.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15983 "saturnism")
Declaration(Class(goldbook:15984))
AnnotationAssertion(rdfs:label goldbook:15984 "pneumoconiosis")
AnnotationAssertion(dcterms:description goldbook:15984 "Usually fibrosis of the lungs that develops owing to (prolonged) inhalation of inorganic or organic dusts.")
Declaration(Class(goldbook:15985))
AnnotationAssertion(rdfs:label goldbook:15985 "pneumonitis")
AnnotationAssertion(dcterms:description goldbook:15985 "Inflammation of the lung.")
Declaration(Class(goldbook:15986))
AnnotationAssertion(rdfs:label goldbook:15986 "point mutation")
AnnotationAssertion(dcterms:description goldbook:15986 "Change in a single base pair in DNA.")
Declaration(Class(goldbook:15987))
AnnotationAssertion(rdfs:label goldbook:15987 "poison-bearing")
AnnotationAssertion(dcterms:description goldbook:15987 "Containing a poison.")
Declaration(Class(goldbook:15988))
AnnotationAssertion(rdfs:label goldbook:15988 "poisoning")
AnnotationAssertion(dcterms:description goldbook:15988 "Morbid condition produced by a poison.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15988 "intoxication")
Declaration(Class(goldbook:15989))
AnnotationAssertion(rdfs:label goldbook:15989 "polyclonal antibody")
AnnotationAssertion(dcterms:description goldbook:15989 "Antibody produced by a number of different cell types.")
Declaration(Class(goldbook:15990))
AnnotationAssertion(rdfs:label goldbook:15990 "polydipsia")
AnnotationAssertion(dcterms:description goldbook:15990 "Chronic excessive thirst.")
Declaration(Class(goldbook:15991))
AnnotationAssertion(rdfs:label goldbook:15991 "polyuria")
AnnotationAssertion(dcterms:description goldbook:15991 "Excessive production and discharge of urine.")
Declaration(Class(goldbook:15992))
AnnotationAssertion(rdfs:label goldbook:15992 "population at risk")
AnnotationAssertion(dcterms:description goldbook:15992 "Persons who can and may develop an adverse health effect and who are potentially exposed to a substance under study. People already having chronic disease are excluded from the population at risk in studies of the incidence of the adverse effect.")
Declaration(Class(goldbook:15993))
AnnotationAssertion(rdfs:label goldbook:15993 "population critical concentration")
AnnotationAssertion(dcterms:description goldbook:15993 "Concentration of a substance in the critical organ at which a specified percentage of the exposed population has reached the individual critical organ concentration.")
Declaration(Class(goldbook:15994))
AnnotationAssertion(rdfs:label goldbook:15994 "population effect")
AnnotationAssertion(dcterms:description goldbook:15994 "Absolute number or incidence rate of cases occurring in a group of people.")
Declaration(Class(goldbook:15995))
AnnotationAssertion(rdfs:label goldbook:15995 "porphyria")
AnnotationAssertion(dcterms:description goldbook:15995 "Disturbance of porphyrin metabolism characterized by increased formation, accumulation, and excretion of porphyrins and their precursors.")
Declaration(Class(goldbook:15996))
AnnotationAssertion(rdfs:label goldbook:15996 "porphyrin")
AnnotationAssertion(dcterms:description goldbook:15996 "Natural pigment containing a fundamental skeleton of four pyrrole nuclei united through the α-positions by four methine groups to form a macrocyclic structure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15996 "porphin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15996 "porphine")
Declaration(Class(goldbook:15997))
AnnotationAssertion(rdfs:label goldbook:15997 "posology")
AnnotationAssertion(dcterms:description goldbook:15997 "Pharmacological study of the choice of appropriate dose of a drug in relation to the physiological factors, such as age, that may influence its effect.")
Declaration(Class(goldbook:15998))
AnnotationAssertion(rdfs:label goldbook:15998 "post-translational modification")
AnnotationAssertion(dcterms:description goldbook:15998 "Processes by which proteins are biochemically modified within a cell following their synthesis on the ribosomes.")
Declaration(Class(goldbook:15999))
AnnotationAssertion(rdfs:label goldbook:15999 "practical certainty")
AnnotationAssertion(dcterms:description goldbook:15999 "Numerically specified low risk of exposure to a potentially toxic substance (e.g., 1 in \\(\\pu{1000}\\)) or socially acceptable low risk of adverse effects from such an exposure applied to decision making in regard to chemical safety.")
Declaration(Class(goldbook:16000))
AnnotationAssertion(rdfs:label goldbook:16000 "precordial")
AnnotationAssertion(dcterms:description goldbook:16000 "Pertaining to the region over the heart and lower thorax.")
Declaration(Class(goldbook:16001))
AnnotationAssertion(rdfs:label goldbook:16001 "predictive validity")
AnnotationAssertion(dcterms:description goldbook:16001 "Reliability of a measurement expressed in terms of its ability to predict the criterion.")
Declaration(Class(goldbook:16002))
AnnotationAssertion(rdfs:label goldbook:16002 "predictive value")
AnnotationAssertion(dcterms:description goldbook:16002 "Percentage of positive results that are true positives or of negative results that are true negatives.")
Declaration(Class(goldbook:16003))
AnnotationAssertion(rdfs:label goldbook:16003 "premature ovarian failure")
AnnotationAssertion(dcterms:description goldbook:16003 "Follicular depletion by the age of 35 years.")
Declaration(Class(goldbook:16004))
AnnotationAssertion(rdfs:label goldbook:16004 "preneoplastic")
AnnotationAssertion(dcterms:description goldbook:16004 "Before the formation of a tumor.")
Declaration(Class(goldbook:16005))
AnnotationAssertion(rdfs:label goldbook:16005 "prior informed consent")
AnnotationAssertion(dcterms:description goldbook:16005 "Concept in law and medicine that states that before one is subjected to a risk, especially a risk of bodily harm, one is entitled to be fully informed well in advance of the nature of that risk in order to make an informed decision about whether to accept it or not.")
Declaration(Class(goldbook:16006))
AnnotationAssertion(rdfs:label goldbook:16006 "primary protection standard")
AnnotationAssertion(dcterms:description goldbook:16006 "Accepted maximum level of a pollutant (or its indicator) in the target organism, or some part thereof, or an accepted maximum intake of a pollutant or nuisance into the target under specified circumstances.")
Declaration(Class(goldbook:16007))
AnnotationAssertion(rdfs:label goldbook:16007 "procarcinogen")
AnnotationAssertion(dcterms:description goldbook:16007 "Substance that has to be metabolized before it becomes a carcinogen.")
Declaration(Class(goldbook:16008))
AnnotationAssertion(rdfs:label goldbook:16008 "progression")
AnnotationAssertion(dcterms:description goldbook:16008 "Increase in the size of a tumor or spread of cancer in the body.")
Declaration(Class(goldbook:16009))
AnnotationAssertion(rdfs:label goldbook:16009 "prokaryote")
AnnotationAssertion(dcterms:description goldbook:16009 "Unicellular organism, characterized by the absence of a membrane-enclosed nucleus.")
Declaration(Class(goldbook:16010))
AnnotationAssertion(rdfs:label goldbook:16010 "pro-pesticide")
AnnotationAssertion(dcterms:description goldbook:16010 "Substance applied in a form that is not active as a pesticide and which becomes active once it enters an organism and undergoes chemical modification.")
Declaration(Class(goldbook:16011))
AnnotationAssertion(rdfs:label goldbook:16011 "proportional mortality rate")
AnnotationAssertion(dcterms:description goldbook:16011 "Proportion of observed deaths from a specified condition in a defined population divided by the proportion of deaths expected from this condition in a standard population, expressed either on an age-specific basis or after age adjustment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16011 "proportional mortality ratio")
Declaration(Class(goldbook:16012))
AnnotationAssertion(rdfs:label goldbook:16012 "proteinuria")
AnnotationAssertion(dcterms:description goldbook:16012 "Excretion of excessive amounts of protein (derived from blood plasma or kidney tubules) in the urine.")
Declaration(Class(goldbook:16013))
AnnotationAssertion(rdfs:label goldbook:16013 "pseudo-acceptable daily intake")
AnnotationAssertion(dcterms:description goldbook:16013 "Intake for a substance derived by applying a thousandfold uncertainty factor to the lowest low-effect level for noncarcinogenic endpoints.")
Declaration(Class(goldbook:16014))
AnnotationAssertion(rdfs:label goldbook:16014 "pseudoadaptation")
AnnotationAssertion(dcterms:description goldbook:16014 "Apparent adaptation of an organism to changing conditions of the environment (especially chemical) associated with stresses in biochemical systems that exceed the limits of normal (homeostatic) mechanisms.")
Declaration(Class(goldbook:16015))
AnnotationAssertion(rdfs:label goldbook:16015 "public health impact assessment")
AnnotationAssertion(dcterms:description goldbook:16015 "Applying risk assessment to a specific target population of known size, giving as the end product a quantitative statement about the number of people likely to be affected in a particular population.")
Declaration(Class(goldbook:16016))
AnnotationAssertion(rdfs:label goldbook:16016 "pyrexia")
AnnotationAssertion(dcterms:description goldbook:16016 "Condition in which the temperature of a human being or mammal is above normal.")
Declaration(Class(goldbook:16017))
AnnotationAssertion(rdfs:label goldbook:16017 "quantal")
AnnotationAssertion(dcterms:description goldbook:16017 "Describing a condition that can be expressed only as 'occurring' or 'not occurring', such as death.")
Declaration(Class(goldbook:16018))
AnnotationAssertion(rdfs:label goldbook:16018 "radiation toxicology")
AnnotationAssertion(dcterms:description goldbook:16018 "Scientific study involving research, education, prevention, and treatment of diseases caused by ionizing or nonionizing radiation.")
Declaration(Class(goldbook:16019))
AnnotationAssertion(rdfs:label goldbook:16019 "rate difference")
AnnotationAssertion(dcterms:description goldbook:16019 "Absolute difference between two rates.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16019 "excess rate")
Declaration(Class(goldbook:16020))
AnnotationAssertion(rdfs:label goldbook:16020 "ratticide")
AnnotationAssertion(dcterms:description goldbook:16020 "Substance intended to kill rats.")
Declaration(Class(goldbook:16021))
AnnotationAssertion(rdfs:label goldbook:16021 "reabsorption")
AnnotationAssertion(dcterms:description goldbook:16021 "Absorption by a living organism of a substance which it has previously absorbed and then released (e.g., the uptake of a substance from the proximal renal tubule following glomerular filtration).")
Declaration(Class(goldbook:16022))
AnnotationAssertion(rdfs:label goldbook:16022 "reactive nitrogen species")
AnnotationAssertion(dcterms:description goldbook:16022 "Radical nitrogen-based molecules that can act to facilitate nitrosylation reactions; reactive nitrogen species include dioxidonitrogen(\\(\\ce{^{.}}\\)) (nitrogen dioxide, nitryl radical) \\(\\ce{NO^{.}}\\), oxidonitrogen(\\(\\ce{^{.}}\\)) (nitrogen monoxide, nitrosyl radical) \\(\\ce{NO^{.}}\\) oxidonitrogen(1+) (nitrosyl cation) \\(\\ce{NO^{+}}\\), hydroxyoxidonitrogen (nitrous acid) \\(\\ce{HNO2}\\), and oxidonitrate(1-) \\(\\ce{NO^{-}}\\).")
Declaration(Class(goldbook:16023))
AnnotationAssertion(rdfs:label goldbook:16023 "readily biodegradable")
AnnotationAssertion(dcterms:description goldbook:16023 "Arbitrary classification of substances that have passed certain specified screening tests for ultimate biodegradability; these tests are so stringent that such compounds will be rapidly and completely biodegraded in a wide variety of aerobic environments.")
Declaration(Class(goldbook:16024))
AnnotationAssertion(rdfs:label goldbook:16024 "recalcitrance")
AnnotationAssertion(dcterms:description goldbook:16024 "Ability of a substance to remain in a particular environment in an unchanged form.")
Declaration(Class(goldbook:16025))
AnnotationAssertion(rdfs:label goldbook:16025 "receptor-mediated endocytosis")
AnnotationAssertion(dcterms:description goldbook:16025 "Endocytosis of a substance and its receptor following receptor binding.")
Declaration(Class(goldbook:16026))
AnnotationAssertion(rdfs:label goldbook:16026 "recessive gene")
AnnotationAssertion(dcterms:description goldbook:16026 "Allele which in the heterozygous state is expected to have no effect on the phenotype of the organism which carries it.")
Declaration(Class(goldbook:16027))
AnnotationAssertion(rdfs:label goldbook:16027 "recommended exposure level")
AnnotationAssertion(dcterms:description goldbook:16027 "Highest allowable regulatory airborne concentration.")
Declaration(Class(goldbook:16028))
AnnotationAssertion(rdfs:label goldbook:16028 "reconstitution")
AnnotationAssertion(dcterms:description goldbook:16028 "Restoration to original form of a substance previously altered for preservation and storage.")
Declaration(Class(goldbook:16029))
AnnotationAssertion(rdfs:label goldbook:16029 "recycling")
AnnotationAssertion(dcterms:description goldbook:16029 "Process or method allowing for the recovery of some value from a waste, either as reusable material or as energy.")
Declaration(Class(goldbook:16030))
AnnotationAssertion(rdfs:label goldbook:16030 "reference concentration")
AnnotationAssertion(dcterms:description goldbook:16030 "An estimate (with uncertainty spanning perhaps an order of magnitude) of a continuous inhalation exposure to the human population (including sensitive subgroups which include children, asthmatics, and the elderly) that is likely to be without an appreciable risk of deleterious effects during a lifetime.")
Declaration(Class(goldbook:16031))
AnnotationAssertion(rdfs:label goldbook:16031 "reference distribution")
AnnotationAssertion(dcterms:description goldbook:16031 "Statistical distribution of reference values.")
Declaration(Class(goldbook:16032))
AnnotationAssertion(rdfs:label goldbook:16032 "reference individual")
AnnotationAssertion(dcterms:description goldbook:16032 "Person selected with the use of defined criteria for comparative purposes in a clinical study.")
Declaration(Class(goldbook:16033))
AnnotationAssertion(rdfs:label goldbook:16033 "reference interval")
AnnotationAssertion(dcterms:description goldbook:16033 "Area between and including two reference limits, for example, the percentiles \\(\\pu{2.5}\\) and \\(\\pu{97.5}\\).")
Declaration(Class(goldbook:16034))
AnnotationAssertion(rdfs:label goldbook:16034 "reference limit")
AnnotationAssertion(dcterms:description goldbook:16034 "Boundary value defined so that a stated fraction of the reference values is less than or exceeds that boundary value with a stated probability.")
Declaration(Class(goldbook:16035))
AnnotationAssertion(rdfs:label goldbook:16035 "reference population")
AnnotationAssertion(dcterms:description goldbook:16035 "Group of all reference individuals used to establish criteria against which a population that is being studied can be compared.")
Declaration(Class(goldbook:16036))
AnnotationAssertion(rdfs:label goldbook:16036 "reference sample group")
AnnotationAssertion(dcterms:description goldbook:16036 "Selected reference individuals, statistically adequate numerically to represent the reference population.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16036 "reference group")
Declaration(Class(goldbook:16037))
AnnotationAssertion(rdfs:label goldbook:16037 "reference value")
AnnotationAssertion(dcterms:description goldbook:16037 "Quantity value, generally accepted as having a suitably small measurement uncertainty, to be used as a basis for comparison with values of quantities of the same kind.")
Declaration(Class(goldbook:16038))
AnnotationAssertion(rdfs:label goldbook:16038 "regulatory dose")
AnnotationAssertion(dcterms:description goldbook:16038 "Term used by the USEPA to describe the expected dose resulting from human exposure to a substance at the level at which it is regulated in the environment.")
Declaration(Class(goldbook:16039))
AnnotationAssertion(rdfs:label goldbook:16039 "regulatory sequence")
AnnotationAssertion(dcterms:description goldbook:16039 "DNA sequence to which specific proteins bind to activate or repress the expression of a gene.")
Declaration(Class(goldbook:16040))
AnnotationAssertion(rdfs:label goldbook:16040 "relative excess risk")
AnnotationAssertion(dcterms:description goldbook:16040 "Measure that can be used in comparison of adverse reactions to drugs, or other exposures, based solely on the component of risk due to the exposure or drug under investigation, removing the risk due to background exposure experienced by all in the population. The relative excess risk, \\(R\\), is given by \\[R = (R_{1} - R_{0})/(R_{2} - R_{0})\\] where \\(R_{1}\\) is the rate in the population, \\(R_{2}\\) is the rate in the comparison population, and \\(R_{0}\\) is the rate in the general population.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16040 "comparative risk")
Declaration(Class(goldbook:16041))
AnnotationAssertion(rdfs:label goldbook:16041 "relative systemic availability")
AnnotationAssertion(dcterms:description goldbook:16041 "Quantity of metabolizable substance divided by product of quantity of absorbed substance and exposure.")
Declaration(Class(goldbook:16042))
AnnotationAssertion(rdfs:label goldbook:16042 "remedy")
AnnotationAssertion(dcterms:description goldbook:16042 "Anything, such as a medicine or therapy, that relieves pain, cures disease, or corrects a disorder.")
Declaration(Class(goldbook:16043))
AnnotationAssertion(rdfs:label goldbook:16043 "renal plasma flow")
AnnotationAssertion(dcterms:description goldbook:16043 "Volume of plasma passing through the kidneys in unit time.")
Declaration(Class(goldbook:16044))
AnnotationAssertion(rdfs:label goldbook:16044 "repellent")
AnnotationAssertion(dcterms:description goldbook:16044 "Substance used mainly to repel blood-sucking insects in order to protect humans and animals.")
Declaration(Class(goldbook:16045))
AnnotationAssertion(rdfs:label goldbook:16045 "replicate sampling")
AnnotationAssertion(dcterms:description goldbook:16045 "Act of taking multiple samples concurrently under comparable conditions.")
Declaration(Class(goldbook:16046))
AnnotationAssertion(rdfs:label goldbook:16046 "reserve capacity")
AnnotationAssertion(dcterms:description goldbook:16046 "Physiological or biochemical capacity that may be available to maintain homeostasis when the body or an organism is exposed to an environmental change.")
Declaration(Class(goldbook:16047))
AnnotationAssertion(rdfs:label goldbook:16047 "reservoir")
AnnotationAssertion(dcterms:description goldbook:16047 "Storage compartment from which a substance may be released with subsequent biological effects.")
Declaration(Class(goldbook:16048))
AnnotationAssertion(rdfs:label goldbook:16048 "residual risk")
AnnotationAssertion(dcterms:description goldbook:16048 "Health risk remaining after risk reduction actions are implemented.")
Declaration(Class(goldbook:16049))
AnnotationAssertion(rdfs:label goldbook:16049 "residue")
AnnotationAssertion(dcterms:description goldbook:16049 "Contaminant remaining in an organism or in other material such as food or packaging, following exposure.")
Declaration(Class(goldbook:16050))
AnnotationAssertion(rdfs:label goldbook:16050 "resorptive effect")
AnnotationAssertion(dcterms:description goldbook:16050 "Action of a substance after its reabsorption from the gut into the blood.")
Declaration(Class(goldbook:16051))
AnnotationAssertion(rdfs:label goldbook:16051 "respirable dust")
AnnotationAssertion(dcterms:description goldbook:16051 "Mass fraction of dust (particles) that penetrates to the unciliated airways of the lung (the alveolar region).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16051 "respirable particles")
Declaration(Class(goldbook:16052))
AnnotationAssertion(rdfs:label goldbook:16052 "retrospective study")
AnnotationAssertion(dcterms:description goldbook:16052 "Research design used to test etiological hypotheses in which inferences about exposure to the putative causal factor(s) are derived from data relating to characteristics of the persons or organisms under study or to events or experiences in their past.")
Declaration(Class(goldbook:16053))
AnnotationAssertion(rdfs:label goldbook:16053 "returned effect of poisons")
AnnotationAssertion(dcterms:description goldbook:16053 "Enhancement of the dose–effect relationship for a poison following repeated exposure to decreasing doses.")
Declaration(Class(goldbook:16054))
AnnotationAssertion(rdfs:label goldbook:16054 "reverse mutation")
AnnotationAssertion(dcterms:description goldbook:16054 "Mutation in a mutant allele which makes it capable of producing the nonmutant phenotype; this may result from restoration of the original DNA sequence of the gene or from production of a new DNA sequence which has the same effect.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16054 "back mutation")
Declaration(Class(goldbook:16055))
AnnotationAssertion(rdfs:label goldbook:16055 "reverse transcription")
AnnotationAssertion(dcterms:description goldbook:16055 "Process by which an RNA molecule is used as a template to make a single-stranded DNA copy.")
Declaration(Class(goldbook:16056))
AnnotationAssertion(rdfs:label goldbook:16056 "reversible alteration")
AnnotationAssertion(dcterms:description goldbook:16056 "Change from normal structure or function, induced by a substance or other agent(s), that returns to normal status or within normal limits after cessation of exposure.")
Declaration(Class(goldbook:16057))
AnnotationAssertion(rdfs:label goldbook:16057 "rhabdomyolysis")
AnnotationAssertion(dcterms:description goldbook:16057 "Acute, fulminating, potentially lethal disease of skeletal muscle that causes disintegration of striated muscle fibers as evidenced by myoglobin in the blood and urine.")
Declaration(Class(goldbook:16058))
AnnotationAssertion(rdfs:label goldbook:16058 "rhonchus")
AnnotationAssertion(dcterms:description goldbook:16058 "Harsh crepitation in the throat, often resembling snoring.")
Declaration(Class(goldbook:16059))
AnnotationAssertion(rdfs:label goldbook:16059 "risk associated with a lifetime exposure")
AnnotationAssertion(dcterms:description goldbook:16059 "Probability of the occurrence of a specified undesirable event following exposure of an individual person from a given population to a specified substance at a defined level for the expected lifetime of the average member of that population.")
Declaration(Class(goldbook:16060))
AnnotationAssertion(rdfs:label goldbook:16060 "risk aversion")
AnnotationAssertion(dcterms:description goldbook:16060 "Tendency of an individual person to avoid risk.")
Declaration(Class(goldbook:16061))
AnnotationAssertion(rdfs:label goldbook:16061 "risk communication")
AnnotationAssertion(dcterms:description goldbook:16061 "Interpretation and communication of risk assessments in terms that are comprehensible to the general public or to others without specialist knowledge.")
Declaration(Class(goldbook:16062))
AnnotationAssertion(rdfs:label goldbook:16062 "risk <i>de minimis</i>")
AnnotationAssertion(dcterms:description goldbook:16062 "Risk that is negligible and too small to be of societal concern (usually assumed to be a probability below \\(\\pu{E-5}\\) or \\(\\pu{E-6}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16062 "de minimis risk")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16062 "negligible risk")
Declaration(Class(goldbook:16063))
AnnotationAssertion(rdfs:label goldbook:16063 "risk evaluation")
AnnotationAssertion(dcterms:description goldbook:16063 "Establishment of a qualitative or quantitative relationship between risks and benefits, involving the complex process of determining the significance of the identified hazards and estimated risks to those organisms or people concerned with or affected by them.")
Declaration(Class(goldbook:16064))
AnnotationAssertion(rdfs:label goldbook:16064 "risk identification")
AnnotationAssertion(dcterms:description goldbook:16064 "Recognition of a potential hazard and definition of the factors required to assess the probability of exposure of organisms or people to that hazard and of harm resulting from such exposure.")
Declaration(Class(goldbook:16065))
AnnotationAssertion(rdfs:label goldbook:16065 "risk marker")
AnnotationAssertion(dcterms:description goldbook:16065 "Attribute that is associated with an increased probability of occurrence of a disease or other specified outcome and that can be used as an indicator of this increased risk.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16065 "risk indicator")
Declaration(Class(goldbook:16066))
AnnotationAssertion(rdfs:label goldbook:16066 "risk monitoring")
AnnotationAssertion(dcterms:description goldbook:16066 "Process of following up the decisions and actions within risk management in order to check whether the aims of reduced exposure and risk are achieved.")
Declaration(Class(goldbook:16067))
AnnotationAssertion(rdfs:label goldbook:16067 "risk perception")
AnnotationAssertion(dcterms:description goldbook:16067 "Subjective perception of the gravity or importance of the risk based on a person’s knowledge of different risks and the moral, economic, and political judgment of their implications.")
Declaration(Class(goldbook:16068))
AnnotationAssertion(rdfs:label goldbook:16068 "risk phrases")
AnnotationAssertion(dcterms:description goldbook:16068 "Word groups identifying potential health or environmental hazards required under CPL Directives (European Community); may be incorporated into Safety Data Sheets.")
Declaration(Class(goldbook:16069))
AnnotationAssertion(rdfs:label goldbook:16069 "risk-specific dose")
AnnotationAssertion(dcterms:description goldbook:16069 "Amount of exposure corresponding to a specified level of risk.")
Declaration(Class(goldbook:16070))
AnnotationAssertion(rdfs:label goldbook:16070 "rodenticide")
AnnotationAssertion(dcterms:description goldbook:16070 "Substance intended to kill rodents.")
Declaration(Class(goldbook:16071))
AnnotationAssertion(rdfs:label goldbook:16071 "route of exposure")
AnnotationAssertion(dcterms:description goldbook:16071 "Means by which a toxic agent gains access to an organism by administration through the gastrointestinal tract (ingestion), lungs (inhalation), skin (topical), or by other routes such as intravenous, subcutaneous, intramuscular, or intraperitoneal routes.")
Declaration(Class(goldbook:16072))
AnnotationAssertion(rdfs:label goldbook:16072 "S9 fraction")
AnnotationAssertion(dcterms:description goldbook:16072 "Supernatant fraction obtained from an organ (usually liver) homogenate by centrifuging at \\(\\pu{9000 g}\\) for \\(\\pu{20 min}\\) in a suitable medium; this fraction contains cytosol and microsomes.")
Declaration(Class(goldbook:16073))
AnnotationAssertion(rdfs:label goldbook:16073 "safety pharmacology")
AnnotationAssertion(dcterms:description goldbook:16073 "Science directed to the discovery, development, and safe therapeutic use of biologically active substances as a result of the identification, monitoring, and characterization of potentially undesirable pharmacodynamic activities of these substances in nonclinical studies.")
Declaration(Class(goldbook:16074))
AnnotationAssertion(rdfs:label goldbook:16074 "sarcoma")
AnnotationAssertion(dcterms:description goldbook:16074 "Malignant tumor arising in a connective tissue and composed primarily of anaplastic cells resembling supportive tissue.")
Declaration(Class(goldbook:16075))
AnnotationAssertion(rdfs:label goldbook:16075 "saturable elimination")
AnnotationAssertion(dcterms:description goldbook:16075 "Elimination that becomes concentration-independent at a concentration at which the elimination process is functioning maximally.")
Declaration(Class(goldbook:16076))
AnnotationAssertion(rdfs:label goldbook:16076 "saturnia")
AnnotationAssertion(dcterms:description goldbook:16076 "Pain in a joint resulting from lead poisoning.")
Declaration(Class(goldbook:16077))
AnnotationAssertion(rdfs:label goldbook:16077 "saturnism")
AnnotationAssertion(dcterms:description goldbook:16077 "Intoxication caused by lead.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16077 "plumbism")
Declaration(Class(goldbook:16078))
AnnotationAssertion(rdfs:label goldbook:16078 "scotoma")
AnnotationAssertion(dcterms:description goldbook:16078 "Area of diminished or lost vision within the visual field, surrounded by an area of less affected or normal vision.")
Declaration(Class(goldbook:16079))
AnnotationAssertion(rdfs:label goldbook:16079 "secretion")
AnnotationAssertion(dcterms:description goldbook:16079 """Process by which a substance such as a hormone or enzyme produced in a cell is passed through a plasma membrane to the outside, for example, the intestinal lumen or the blood (internal secretion).

Solid, liquid, or gaseous material passed from the inside of a cell through a plasma membrane to the outside as a result of cell activity.""")
Declaration(Class(goldbook:16080))
AnnotationAssertion(rdfs:label goldbook:16080 "self-cleaning of water")
AnnotationAssertion(dcterms:description goldbook:16080 "Water purification by natural biological and physicochemical processes.")
Declaration(Class(goldbook:16081))
AnnotationAssertion(rdfs:label goldbook:16081 "self-purification of the atmosphere")
AnnotationAssertion(dcterms:description goldbook:16081 "Purification of the atmosphere from contaminants by natural biological and physicochemical processes.")
Declaration(Class(goldbook:16082))
AnnotationAssertion(rdfs:label goldbook:16082 "semiochemical")
AnnotationAssertion(dcterms:description goldbook:16082 "Substance produced by plants or animals, or a synthetic analogue thereof, that evokes a behavioral response in individuals of the producing species or other species (e.g., allomones, kairomones, pheromones, and synomones).")
Declaration(Class(goldbook:16083))
AnnotationAssertion(rdfs:label goldbook:16083 "semipermeable membrane")
AnnotationAssertion(dcterms:description goldbook:16083 "Membrane that will preferentially allow certain molecules or ions to pass through it while preventing the passage of others.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16083 "differentially permeable membrane")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16083 "selectively membrane")
Declaration(Class(goldbook:16084))
AnnotationAssertion(rdfs:label goldbook:16084 "sensory effect level")
AnnotationAssertion(dcterms:description goldbook:16084 """Intensity, where the detection threshold level is defined as the lower limit of the perceived intensity range (by convention, the lowest concentration that can be detected in \\(\\pu{50\\%}\\) of the cases in which it is present).
Quality, where the recognition threshold level is defined as the lowest concentration at which the sensory effect can be recognized correctly in \\(\\pu{50\\%}\\) of the cases.
Acceptability and annoyance, where the nuisance threshold level is defined as the concentration at which not more than a small proportion of the population, less than \\(\\pu{5\\%}\\), experiences annoyance for a small part of the time, less than \\(\\pu{2\\%}\\).Note: Since annoyance will be influenced by a number of factors, a nuisance threshold level cannot be set on the basis of concentration alone.""")
Declaration(Class(goldbook:16085))
AnnotationAssertion(rdfs:label goldbook:16085 "short-term exposure limit")
AnnotationAssertion(dcterms:description goldbook:16085 "Fifteen-minute time-weighted average (TWA) exposure recommended by ACGIH which should not be exceeded at any time during a workday, even if the \\(\\pu{8 h}\\) TWA is within the threshold limit value: time-weighted average, TLV-TWA.")
Declaration(Class(goldbook:16086))
AnnotationAssertion(rdfs:label goldbook:16086 "side-effect")
AnnotationAssertion(dcterms:description goldbook:16086 "Action of a drug other than that desired for beneficial pharmacological effect.")
Declaration(Class(goldbook:16087))
AnnotationAssertion(rdfs:label goldbook:16087 "siderosis")
AnnotationAssertion(dcterms:description goldbook:16087 """Pneumoconiosis resulting from the inhalation of iron dust.
Excess of iron in the urine, blood, or tissues, characterized by hemosiderin granules in urine and iron deposits in tissues.""")
Declaration(Class(goldbook:16088))
AnnotationAssertion(rdfs:label goldbook:16088 "sidestream smoke")
AnnotationAssertion(dcterms:description goldbook:16088 "Cloud of small particles and gases that is given off from the end of a burning tobacco product (cigarette, pipe, cigar) between puffs and is not directly inhaled by the smoker.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16088 "environmental tobacco smoke (ETS)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16088 "secondhand smoke")
Declaration(Class(goldbook:16089))
AnnotationAssertion(rdfs:label goldbook:16089 "sign")
AnnotationAssertion(dcterms:description goldbook:16089 "Objective evidence of a disease, deformity, or an effect induced by an agent, perceptible to an examining physician.")
Declaration(Class(goldbook:16090))
AnnotationAssertion(rdfs:label goldbook:16090 "silicosis")
AnnotationAssertion(dcterms:description goldbook:16090 "Pneumoconiosis resulting from inhalation of silica dust.")
Declaration(Class(goldbook:16091))
AnnotationAssertion(rdfs:label goldbook:16091 "simulation test")
AnnotationAssertion(dcterms:description goldbook:16091 "Procedure designed to predict the rate of biodegradation of a compound under relevant environmental conditions.")
Declaration(Class(goldbook:16092))
AnnotationAssertion(rdfs:label goldbook:16092 "skeletal fluorosis")
AnnotationAssertion(dcterms:description goldbook:16092 "Osteosclerosis due to fluoride.")
Declaration(Class(goldbook:16093))
AnnotationAssertion(rdfs:label goldbook:16093 "slimicide")
AnnotationAssertion(dcterms:description goldbook:16093 "Substance intended to kill slime-producing organisms.")
Declaration(Class(goldbook:16094))
AnnotationAssertion(rdfs:label goldbook:16094 "slope factor")
AnnotationAssertion(dcterms:description goldbook:16094 "Value, in inverse concentration or dose units, derived from the slope of a dose-response curve; in practice, limited to carcinogenic effects with the curve assumed to be linear at low concentrations or doses.")
Declaration(Class(goldbook:16095))
AnnotationAssertion(rdfs:label goldbook:16095 "societal risk")
AnnotationAssertion(dcterms:description goldbook:16095 "Total probability of harm to a human population including the probability of adverse effects to health of descendants and the probability of disruption resulting from loss of services such as industrial plant or loss of material goods and electricity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16095 "population risk")
Declaration(Class(goldbook:16096))
AnnotationAssertion(rdfs:label goldbook:16096 "soil partition coefficient")
AnnotationAssertion(dcterms:description goldbook:16096 "Experimental ratio of a substance’s concentration in the soil to that in the aqueous (dissolved) soil phase at equilibrium: It is valid only for the specific concentration and solid/solution ratio of the test.")
Declaration(Class(goldbook:16097))
AnnotationAssertion(rdfs:label goldbook:16097 "solvent abuse")
AnnotationAssertion(dcterms:description goldbook:16097 "Deliberate inhalation (or drinking) of volatile solvents, in order to become intoxicated.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16097 "solvent sniffing")
Declaration(Class(goldbook:16098))
AnnotationAssertion(rdfs:label goldbook:16098 "specific death rate")
AnnotationAssertion(dcterms:description goldbook:16098 "Death rate computed for a subpopulation of individual organisms or people having a specified characteristic or attribute, and named accordingly.")
Declaration(Class(goldbook:16099))
AnnotationAssertion(rdfs:label goldbook:16099 "specific pathogen free")
AnnotationAssertion(dcterms:description goldbook:16099 "Describing an animal removed from its mother under sterile conditions just prior to term and subsequently reared and kept under sterile conditions.")
Declaration(Class(goldbook:16100))
AnnotationAssertion(rdfs:label goldbook:16100 "spreader")
AnnotationAssertion(dcterms:description goldbook:16100 "Agent used in some pesticide formulations to extend the even disposition of the active ingredient.")
Declaration(Class(goldbook:16101))
AnnotationAssertion(rdfs:label goldbook:16101 "stability half life")
AnnotationAssertion(dcterms:description goldbook:16101 "Time required for the amount of a substance in a formulation to decrease, for any reason, by one-half (\\(\\pu{50\\%}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16101 "stability half time")
Declaration(Class(goldbook:16102))
AnnotationAssertion(rdfs:label goldbook:16102 "standard morbidity ratio")
AnnotationAssertion(dcterms:description goldbook:16102 "Ratio of the number of patients with a particular disease observed in a study group or population to the total number of people in the group or population multiplied by \\(\\pu{100}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16102 "standardized morbidity ratio")
Declaration(Class(goldbook:16103))
AnnotationAssertion(rdfs:label goldbook:16103 "standard mortality ratio")
AnnotationAssertion(dcterms:description goldbook:16103 "Ratio of the number of deaths observed in the study group or population to the number of deaths that would be expected if the study population had the same specific rates as the standard population, multiplied by \\(\\pu{100}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16103 "standardized mortality ratio")
Declaration(Class(goldbook:16104))
AnnotationAssertion(rdfs:label goldbook:16104 "stannosis")
AnnotationAssertion(dcterms:description goldbook:16104 "Pneumoconiosis resulting from inhalation of tin dust.")
Declaration(Class(goldbook:16105))
AnnotationAssertion(rdfs:label goldbook:16105 "subchronic")
AnnotationAssertion(dcterms:description goldbook:16105 "Repeated over a short period, usually about \\(\\pu{10\\%}\\) of the life span; an imprecise term used to describe exposures of intermediate duration.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16105 "semichronic")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16105 "subacute")
Declaration(Class(goldbook:16106))
AnnotationAssertion(rdfs:label goldbook:16106 "subchronic effect")
AnnotationAssertion(dcterms:description goldbook:16106 "Biological change resulting from an environmental alteration lasting about \\(\\pu{10\\%}\\) of the lifetime of the test organism.")
Declaration(Class(goldbook:16107))
AnnotationAssertion(rdfs:label goldbook:16107 "subchronic toxicity test")
AnnotationAssertion(dcterms:description goldbook:16107 "Animal experiment serving to study the effects produced by the test substance when administered in repeated doses (or continually in food, drinking water, air) over a period of up to about 90 days.")
Declaration(Class(goldbook:16108))
AnnotationAssertion(rdfs:label goldbook:16108 "subclinical effect")
AnnotationAssertion(dcterms:description goldbook:16108 "Biological change with detectable symptoms following exposure to an agent known to cause disease either before symptoms of the disease occur or when they are absent.")
Declaration(Class(goldbook:16109))
AnnotationAssertion(rdfs:label goldbook:16109 "subfertility")
AnnotationAssertion(dcterms:description goldbook:16109 "Fertility below the normal range for a given species.")
Declaration(Class(goldbook:16110))
AnnotationAssertion(rdfs:label goldbook:16110 "subjective environment")
AnnotationAssertion(dcterms:description goldbook:16110 "Surrounding conditions as perceived by persons living in these conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16110 "perceived environment")
Declaration(Class(goldbook:16111))
AnnotationAssertion(rdfs:label goldbook:16111 "sufficient evidence")
AnnotationAssertion(dcterms:description goldbook:16111 "According to the USEPA’s Guidelines for Carcinogen Risk Assessment, sufficient evidence is a collection of facts and scientific references that is definite enough to establish that an adverse effect is caused by the agent in question.")
Declaration(Class(goldbook:16112))
AnnotationAssertion(rdfs:label goldbook:16112 "suggested no-adverse-response level")
AnnotationAssertion(dcterms:description goldbook:16112 "Maximum dose or concentration that on current understanding is likely to be tolerated by an exposed organism without producing any harm.")
Declaration(Class(goldbook:16113))
AnnotationAssertion(rdfs:label goldbook:16113 "suicide reaction")
AnnotationAssertion(dcterms:description goldbook:16113 "Formation of irreversible cleavage complexes (also referred to as 'suicide complexes') leading to cell death.")
Declaration(Class(goldbook:16114))
AnnotationAssertion(rdfs:label goldbook:16114 "summary sheet")
AnnotationAssertion(dcterms:description goldbook:16114 "Two-to-four page summary of a risk assessment.")
Declaration(Class(goldbook:16115))
AnnotationAssertion(rdfs:label goldbook:16115 "summation")
AnnotationAssertion(dcterms:description goldbook:16115 "Process of addition of separate postsynaptic responses caused by stimuli that are adjacent in time and space.")
Declaration(Class(goldbook:16116))
AnnotationAssertion(rdfs:label goldbook:16116 "Superfund")
AnnotationAssertion(dcterms:description goldbook:16116 "Federal authority, established by the U.S. Comprehensive Environmental Response, Compensation, and Liability Act (CERCLA) in 1980, to respond directly to releases or threatened releases (such as from landfills or waste disposal areas) of hazardous substances that may endanger health or welfare.")
Declaration(Class(goldbook:16117))
AnnotationAssertion(rdfs:label goldbook:16117 "superoxide dismutase")
AnnotationAssertion(dcterms:description goldbook:16117 "Enzymatic antioxidant that removes the potentially toxic superoxide ion (\\(\\ce{O2^{-}}\\)) by disproportionating it to \\(\\ce{O2}\\) and hydrogen peroxide (\\(\\ce{H2O2}\\)).")
Declaration(Class(goldbook:16118))
AnnotationAssertion(rdfs:label goldbook:16118 "surrogate")
AnnotationAssertion(dcterms:description goldbook:16118 "Relatively well studied toxicant whose properties are assumed to apply to an entire chemically and toxicologically related class.")
Declaration(Class(goldbook:16119))
AnnotationAssertion(rdfs:label goldbook:16119 "susceptible")
AnnotationAssertion(dcterms:description goldbook:16119 "Describing a group of organisms more vulnerable to a given exposure than the majority of the population to which they belong.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16119 "vulnerable")
Declaration(Class(goldbook:16120))
AnnotationAssertion(rdfs:label goldbook:16120 "sympatholytic")
AnnotationAssertion(dcterms:description goldbook:16120 """adj., Blocking transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues.
n., Agent that blocks transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16120 "anti-adrenergic")
Declaration(Class(goldbook:16121))
AnnotationAssertion(rdfs:label goldbook:16121 "symptom")
AnnotationAssertion(dcterms:description goldbook:16121 "Any subjective evidence of a disease or an effect induced by a substance as perceived by the affected subject.")
Declaration(Class(goldbook:16122))
AnnotationAssertion(rdfs:label goldbook:16122 "symptomatology")
AnnotationAssertion(dcterms:description goldbook:16122 "General description of all of the signs and symptoms of exposure to a toxicant.")
Declaration(Class(goldbook:16123))
AnnotationAssertion(rdfs:label goldbook:16123 "synergist")
AnnotationAssertion(dcterms:description goldbook:16123 "Substance that contributes more than additively to a mutual effect with another substance.")
Declaration(Class(goldbook:16124))
AnnotationAssertion(rdfs:label goldbook:16124 "synomone")
AnnotationAssertion(dcterms:description goldbook:16124 "Semiochemical that is produced by one organism inducing a response in an organism of another species that is favorable to both the emitter and the responding organism.")
Declaration(Class(goldbook:16125))
AnnotationAssertion(rdfs:label goldbook:16125 "synteny")
AnnotationAssertion(dcterms:description goldbook:16125 "Property of genes which reside on the same chromosome.")
Declaration(Class(goldbook:16126))
AnnotationAssertion(rdfs:label goldbook:16126 "systematic sample")
AnnotationAssertion(dcterms:description goldbook:16126 "Subset selected according to some simple rule such as specified date or alphabetic classification.")
Declaration(Class(goldbook:16127))
AnnotationAssertion(rdfs:label goldbook:16127 "tachy-")
AnnotationAssertion(dcterms:description goldbook:16127 "Prefix meaning rapid as in tachycardia and tachypnoea.")
Declaration(Class(goldbook:16128))
AnnotationAssertion(rdfs:label goldbook:16128 "tachypnoea")
AnnotationAssertion(dcterms:description goldbook:16128 "Abnormally fast breathing.")
Declaration(Class(goldbook:16129))
AnnotationAssertion(rdfs:label goldbook:16129 "taeniacide")
AnnotationAssertion(dcterms:description goldbook:16129 "Substance intended to kill tapeworms.")
Declaration(Class(goldbook:16130))
AnnotationAssertion(rdfs:label goldbook:16130 "target population")
AnnotationAssertion(dcterms:description goldbook:16130 """Collection of individuals, items, measurements, etc. about which inferences are required: The term is sometimes used to indicate the population from which a sample is drawn and sometimes to denote any reference population about which inferences are needed.
Group of persons for whom an intervention is planned.""")
Declaration(Class(goldbook:16131))
AnnotationAssertion(rdfs:label goldbook:16131 "temporary acceptable daily intake")
AnnotationAssertion(dcterms:description goldbook:16131 "Value for the acceptable daily intake (ADI) proposed for guidance when data are sufficient to conclude that use of the substance is safe over the relatively short period of time required to generate and evaluate further safety data, but are insufficient to conclude that use of the substance is safe over a lifetime.")
Declaration(Class(goldbook:16132))
AnnotationAssertion(rdfs:label goldbook:16132 "temporary maximum residue limit")
AnnotationAssertion(dcterms:description goldbook:16132 "Regulatory value established for a specified, limited time when only a temporary acceptable daily intake has been established for the pesticide concerned or, with the existence of an agreed acceptable daily intake, the available residue data are inadequate for firm maximum residue recommendations.")
Declaration(Class(goldbook:16133))
AnnotationAssertion(rdfs:label goldbook:16133 "testing of chemicals")
AnnotationAssertion(dcterms:description goldbook:16133 """In toxicology, evaluation of the therapeutic and potentially toxic effects of substances by their application through relevant routes of exposure with appropriate organisms or biological systems so as to relate effects to dose following application.
In chemistry, qualitative or quantitative analysis by the application of one or more fixed methods and comparison of the results with established standards.""")
Declaration(Class(goldbook:16134))
AnnotationAssertion(rdfs:label goldbook:16134 "theoretical maximum daily intake")
AnnotationAssertion(dcterms:description goldbook:16134 "Predicted maximum daily intake of a residue, assuming that it is present at the maximum residue level and that average daily consumption of foods per person is represented by assessed regional diets: It is expressed in milligrams of residue per person per day.")
Declaration(Class(goldbook:16135))
AnnotationAssertion(rdfs:label goldbook:16135 "therapeutic cloning")
AnnotationAssertion(dcterms:description goldbook:16135 "Generation and manipulation of stem cells with the objective of deriving cells of a particular organ or tissue to treat a disease.")
Declaration(Class(goldbook:16136))
AnnotationAssertion(rdfs:label goldbook:16136 "threshold")
AnnotationAssertion(dcterms:description goldbook:16136 "Dose or exposure concentration below which a defined effect will not occur.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16136 "threshold concentration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16136 "threshold dose")
Declaration(Class(goldbook:16137))
AnnotationAssertion(rdfs:label goldbook:16137 "threshold limit value–ceiling")
AnnotationAssertion(dcterms:description goldbook:16137 "As defined by ACGIH, concentration of a potentially toxic substance that should not be exceeded during any part of the working exposure.")
Declaration(Class(goldbook:16138))
AnnotationAssertion(rdfs:label goldbook:16138 "threshold limit value–short-term exposure limit")
AnnotationAssertion(dcterms:description goldbook:16138 "As defined by ACGIH, concentration to which it is believed that workers can be exposed continuously for a short period of time without suffering from (1) irritation, (2) chronic or irreversible tissue damage, or (3) narcosis of sufficient degree to increase the likelihood of accidental injury, impair self-rescue or materially reduce work efficiency, and provided that the daily TLV-TWA is not exceeded.")
Declaration(Class(goldbook:16139))
AnnotationAssertion(rdfs:label goldbook:16139 "threshold limit value–time-weighted average")
AnnotationAssertion(dcterms:description goldbook:16139 "As defined by ACGIH, time-weighted average concentration for a conventional \\(\\pu{8\\!\\mbox{-}h}\\) workday and a \\(\\pu{40\\!\\mbox{-}h}\\) workweek, to which it is believed nearly all workers may be repeatedly exposed, day after day, without adverse effect.")
Declaration(Class(goldbook:16140))
AnnotationAssertion(rdfs:label goldbook:16140 "threshold of toxicological concern")
AnnotationAssertion(dcterms:description goldbook:16140 "Human exposure threshold value for a group of chemicals below which there should be no appreciable risk to human health.")
Declaration(Class(goldbook:16141))
AnnotationAssertion(rdfs:label goldbook:16141 "thyrotoxicosis")
AnnotationAssertion(dcterms:description goldbook:16141 "Condition resulting from excessive concentrations of thyroid hormones, as in hyperthyroidism, characterized by bulging eyes and rapid heart rate.")
Declaration(Class(goldbook:16142))
AnnotationAssertion(rdfs:label goldbook:16142 "tidal volume")
AnnotationAssertion(dcterms:description goldbook:16142 "Quantity of air or test gas that is inhaled and exhaled during one respiratory cycle.")
Declaration(Class(goldbook:16143))
AnnotationAssertion(rdfs:label goldbook:16143 "time-weighted-average-exposure")
AnnotationAssertion(dcterms:description goldbook:16143 "Concentration in the exposure medium at each measured time interval multiplied by that time interval and divided by the total time of observation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16143 "time-weighted-average concentration (TWAC)")
Declaration(Class(goldbook:16144))
AnnotationAssertion(rdfs:label goldbook:16144 "tissue dose")
AnnotationAssertion(dcterms:description goldbook:16144 "Amount of a substance or physical agent (radiation) absorbed by a tissue.")
Declaration(Class(goldbook:16145))
AnnotationAssertion(rdfs:label goldbook:16145 "tolerable daily intake")
AnnotationAssertion(dcterms:description goldbook:16145 "Estimate of the amount of a potentially harmful substance (e.g., contaminant) in food or drinking water that can be ingested daily over a lifetime without appreciable health risk.")
Declaration(Class(goldbook:16146))
AnnotationAssertion(rdfs:label goldbook:16146 "tolerable risk")
AnnotationAssertion(dcterms:description goldbook:16146 "Probability of suffering disease or injury that can, for the time being, be tolerated, taking into account the associated benefits, and assuming that the risk is minimized by appropriate control procedures.")
Declaration(Class(goldbook:16147))
AnnotationAssertion(rdfs:label goldbook:16147 "tolerable weekly intake")
AnnotationAssertion(dcterms:description goldbook:16147 "Estimate of the amount of a potentially harmful substance (e.g., a contaminant) in food or drinking water that can be ingested weekly over a lifetime without appreciable health risk.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16147 "provisional tolerable weekly intake (PTWI)")
Declaration(Class(goldbook:16148))
AnnotationAssertion(rdfs:label goldbook:16148 "tonic")
AnnotationAssertion(dcterms:description goldbook:16148 """Characterized by tension, especially muscular tension.
Medical preparation that increases or restores normal muscular tension.""")
Declaration(Class(goldbook:16149))
AnnotationAssertion(rdfs:label goldbook:16149 "topical")
AnnotationAssertion(dcterms:description goldbook:16149 "Applied directly to the surface of the body.")
Declaration(Class(goldbook:16150))
AnnotationAssertion(rdfs:label goldbook:16150 "torsade de pointes")
AnnotationAssertion(dcterms:description goldbook:16150 "Potentially lethal form of ventricular tachycardia following chronic abuse of alcohol and mainly due to hypomagnesemia.")
Declaration(Class(goldbook:16151))
AnnotationAssertion(rdfs:label goldbook:16151 "total diet study")
AnnotationAssertion(dcterms:description goldbook:16151 """Study designed to establish the pattern of pesticide residue intake by a person consuming a defined diet.
Study undertaken to show the range and amount of various foodstuffs in a typical diet or to estimate the total amount of a specific substance in a typical diet.""")
Declaration(Class(goldbook:16152))
AnnotationAssertion(rdfs:label goldbook:16152 "total terminal residue")
AnnotationAssertion(dcterms:description goldbook:16152 "Summation of levels of all the residues of a defined pesticide in a food.")
Declaration(Class(goldbook:16153))
AnnotationAssertion(rdfs:label goldbook:16153 "toxemia")
AnnotationAssertion(dcterms:description goldbook:16153 """Condition in which the blood contains toxins produced by body cells at a local source of infection or derived from the growth of microorganisms.
Pregnancy-related condition characterized by high blood pressure, swelling, and fluid retention, and proteins in the urine.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16153 "blood poisoning")
Declaration(Class(goldbook:16154))
AnnotationAssertion(rdfs:label goldbook:16154 "toxic dose")
AnnotationAssertion(dcterms:description goldbook:16154 "Amount of a substance that produces intoxication without lethal outcome.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16154 "superthreshold dose")
Declaration(Class(goldbook:16155))
AnnotationAssertion(rdfs:label goldbook:16155 "toxicity test")
AnnotationAssertion(dcterms:description goldbook:16155 "Experimental study of the adverse effects of exposure of a living organism to a substance for a defined duration under defined conditions.")
Declaration(Class(goldbook:16156))
AnnotationAssertion(rdfs:label goldbook:16156 "toxicogenomics")
AnnotationAssertion(dcterms:description goldbook:16156 "Scientific subdiscipline that combines toxicology with genomics to determine how an organism’s genetic make-up influences its response to a toxic substance.")
Declaration(Class(goldbook:16157))
AnnotationAssertion(rdfs:label goldbook:16157 "toxicological data sheet")
AnnotationAssertion(dcterms:description goldbook:16157 "Document that gives in a uniform manner data relating to the toxicology of a substance, its production and application, properties and methods of identification.")
Declaration(Class(goldbook:16158))
AnnotationAssertion(rdfs:label goldbook:16158 "toxicometry")
AnnotationAssertion(dcterms:description goldbook:16158 "Term sometimes used to indicate a combination of investigative methods and techniques for making a quantitative assessment of toxicity and the hazards of potentially toxic substances.")
Declaration(Class(goldbook:16159))
AnnotationAssertion(rdfs:label goldbook:16159 "toxicophobia")
AnnotationAssertion(dcterms:description goldbook:16159 "Morbid dread of poisons.")
Declaration(Class(goldbook:16160))
AnnotationAssertion(rdfs:label goldbook:16160 "toxicophoric group")
AnnotationAssertion(dcterms:description goldbook:16160 "Structural moiety that upon metabolic activation exerts toxic effects: The presence of a toxicophoric group indicates only potential and not necessarily actual toxicity of a drug or other substances.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16160 "toxogenic group")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16160 "toxophoric group")
Declaration(Class(goldbook:16161))
AnnotationAssertion(rdfs:label goldbook:16161 "toxicovigilance")
AnnotationAssertion(dcterms:description goldbook:16161 "Active process of identification, investigation, and evaluation of various toxic effects in the community with a view to taking measures to reduce or control exposure(s) involving the substance(s) which produces these effects.")
Declaration(Class(goldbook:16162))
AnnotationAssertion(rdfs:label goldbook:16162 "toxification")
AnnotationAssertion(dcterms:description goldbook:16162 "Metabolic conversion of a potentially toxic substance to a product that is more toxic.")
Declaration(Class(goldbook:16163))
AnnotationAssertion(rdfs:label goldbook:16163 "tracer substance")
AnnotationAssertion(dcterms:description goldbook:16163 "Substance that can be tracked through one or more reactions or systems, often by detecting an incorporated isotope.")
Declaration(Class(goldbook:16164))
AnnotationAssertion(rdfs:label goldbook:16164 "transcriptome")
AnnotationAssertion(dcterms:description goldbook:16164 "Total mRNA expressed in a cell or tissue at a given point in time.")
Declaration(Class(goldbook:16165))
AnnotationAssertion(rdfs:label goldbook:16165 "transcriptomics")
AnnotationAssertion(dcterms:description goldbook:16165 "Global analysis of gene expression to identify and evaluate changes in synthesis of mRNA after chemical exposure.")
Declaration(Class(goldbook:16166))
AnnotationAssertion(rdfs:label goldbook:16166 "transformed cell")
AnnotationAssertion(dcterms:description goldbook:16166 "Cell that has become genetically altered spontaneously or by incorporation of foreign DNA to produce a cell with an extended lifetime in culture.")
Declaration(Class(goldbook:16167))
AnnotationAssertion(rdfs:label goldbook:16167 "transgene")
AnnotationAssertion(dcterms:description goldbook:16167 "Gene from one source that has been incorporated into the genome of another organism.")
Declaration(Class(goldbook:16168))
AnnotationAssertion(rdfs:label goldbook:16168 "treatability")
AnnotationAssertion(dcterms:description goldbook:16168 "In relation to waste water, the amenability of substances to removal without adversely affecting the normal operation of biological treatment processes (such as a sewage treatment plant).")
Declaration(Class(goldbook:16169))
AnnotationAssertion(rdfs:label goldbook:16169 "triage")
AnnotationAssertion(dcterms:description goldbook:16169 """Process for sorting people into groups based on their need for or likely benefit from immediate medical treatment.
Note: Triage is used in hospital emergency rooms, on battlefields, and at disaster sites when limited medical resources must be allocated.
System used to allocate a scarce commodity, such as food, to those most likely to benefit from it.
Process in which things are ranked in terms of importance or priority.""")
Declaration(Class(goldbook:16170))
AnnotationAssertion(rdfs:label goldbook:16170 "trueness")
AnnotationAssertion(dcterms:description goldbook:16170 "Closeness of agreement between the average of a theoretically infinite number of replicate measured quantity values and a reference quantity value.")
Declaration(Class(goldbook:16171))
AnnotationAssertion(rdfs:label goldbook:16171 "tubular reabsorption")
AnnotationAssertion(dcterms:description goldbook:16171 "Transfer of solutes from the renal tubule lumen to the tubular epithelial cell and normally from there to the peritubular fluid.")
Declaration(Class(goldbook:16172))
AnnotationAssertion(rdfs:label goldbook:16172 "tumorigenic")
AnnotationAssertion(dcterms:description goldbook:16172 "Able to cause tumors.")
Declaration(Class(goldbook:16173))
AnnotationAssertion(rdfs:label goldbook:16173 "tumor progression")
AnnotationAssertion(dcterms:description goldbook:16173 "Sequence of changes by which a benign tumor develops from the initial lesion to a malignant stage.")
Declaration(Class(goldbook:16174))
AnnotationAssertion(rdfs:label goldbook:16174 "tumor suppressor gene")
AnnotationAssertion(dcterms:description goldbook:16174 "Gene that serves to protect cells from entering a cancerous state.")
Declaration(Class(goldbook:16175))
AnnotationAssertion(rdfs:label goldbook:16175 "two-compartment model")
AnnotationAssertion(dcterms:description goldbook:16175 "Product of compartmental analysis requiring two compartments.")
Declaration(Class(goldbook:16176))
AnnotationAssertion(rdfs:label goldbook:16176 "ulcer")
AnnotationAssertion(dcterms:description goldbook:16176 "Defect, often associated with inflammation, occurring locally or at the surface of an organ or tissue owing to sloughing of necrotic tissue.")
Declaration(Class(goldbook:16177))
AnnotationAssertion(rdfs:label goldbook:16177 "uncertainty")
AnnotationAssertion(dcterms:description goldbook:16177 "Parameter characterizing the dispersion of the quantity values being attributed to a measurand, based on the information used.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16177 "measurement uncertainty")
Declaration(Class(goldbook:16178))
AnnotationAssertion(rdfs:label goldbook:16178 "unit risk")
AnnotationAssertion(dcterms:description goldbook:16178 "Upper-bound excess lifetime cancer risk estimated to result from continuous exposure to an agent at a concentration of \\(\\pu{1 \\upmu g L-1}\\) in water, or \\(\\pu{1 \\upmu g m-3}\\) in air.")
Declaration(Class(goldbook:16179))
AnnotationAssertion(rdfs:label goldbook:16179 "upper boundary")
AnnotationAssertion(dcterms:description goldbook:16179 "Estimate of the plausible upper limit to the true value of a quantity.")
Declaration(Class(goldbook:16180))
AnnotationAssertion(rdfs:label goldbook:16180 "urticaria")
AnnotationAssertion(dcterms:description goldbook:16180 "Vascular reaction of the skin marked by the transient appearance of smooth, slightly elevated patches (wheals, hives) that are redder or paler than the surrounding skin and often attended by severe itching.")
Declaration(Class(goldbook:16181))
AnnotationAssertion(rdfs:label goldbook:16181 "vacuole")
AnnotationAssertion(dcterms:description goldbook:16181 "Membrane-bound cavity within a cell.")
