[Term]
id: goldbook:13833
name: lamella
def: "Organized structure extended in two dimensions and of uniform thickness resembling a thin layer\, a plate\, or a membrane."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-12
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13834
name: lamellar block copolymer
def: "Assembly of block copolymer molecules in which like blocks are segregated in lamella."
comment: "Individual lamellae are usually of a thickness of \(\pu{5\!-\! 100 nm}\)."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-12
property_value: hasStatus "current" xsd:string
