property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15496
name: bactericide
def: "Substance intended to kill bacteria."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15497
name: bagassosis
def: "Lung disease caused by the inhalation of dust from sugar-cane residues."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15498
name: basal lamina
def: "Triple-layered structure on which epithelium sits\: It consists of an electron-dense layer \(lamina densa\) between two electron-transparent layers \(lamina lucida\). The lamina densa is composed of type IV collagen\, and the lamina lucida contains the glycoprotein laminin."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15499
name: Bateman function
def: "Equation expressing the build up and decay in concentration of a substance \(usually in plasma\) based on first-order uptake and elimination in a one-compartment model\, having the form \\\[C = \[fDk_\{\\rm\{a\}\}/V\(k_\{\\rm\{a\}\} - k_\{\\rm\{e\}\}\)\] \[\\exp\(-k_\{\\rm\{e\}\}t\) - \\exp\(-k_\{\\rm\{a\}\}t\)\] \\\]where \\\(C\\\) is the concentration and \\\(D\\\) the dose of the substance\, \\\(f\\\) the fraction absorbed\, and \\\(V\\\) the volume of distribution. \\\(k_\{\\rm\{a\}\}\\\) and \\\(k_\{\\rm\{e\}\}\\\) are the first-order rate constants of uptake and elimination\, respectively\, and \\\(t\\\) is time."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15500
name: benchmark guidance value
def: "Biological monitoring guidance value set at the \\\(90^\{\\rm\{th\}\}\\\) percentile of available biological monitoring results collected from a representative sample of workplaces with good occupational hygiene practices."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15501
name: benchmark response
def: "Response\, expressed as an excess of background\, at which a benchmark dose or benchmark concentration is set."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15502
name: benign
def: "Of a disease\, producing no persisting harmful effects. Tumor that does not invade other tissues \(see metastasis \)\, having lost growth control but not positional control.Note\: Such a tumor is not carcinogenic but may cause mechanical damage to adjacent tissues."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string
