AnnotationAssertion(dcterms:description goldbook:15699 "Surface on a target where a substance (e.g., a pesticide) is present.")
AnnotationAssertion(mito:isMentionedBy goldbook:15699 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15699 "current"^^xsd:string)
Declaration(Class(goldbook:15700))
AnnotationAssertion(rdfs:label goldbook:15700 "exposure test")
AnnotationAssertion(dcterms:description goldbook:15700 "Determination of the level, concentration, or uptake of a potentially toxic compound and (or) its metabolite(s) in biological samples from an organism (blood, urine, hair, etc.) and the interpretation of the results to estimate the absorbed dose or degree of environmental pollution; or the measuring of biochemical effects, usually not direct adverse effects of the substance, and relating them to the quantity of substance absorbed, or to its concentration in the environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:15700 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15700 "current"^^xsd:string)
Declaration(Class(goldbook:15701))
AnnotationAssertion(rdfs:label goldbook:15701 "external validity")
AnnotationAssertion(dcterms:description goldbook:15701 "Generalizability of the results of a particular study, beyond the limits of the population actually studied.")
AnnotationAssertion(mito:isMentionedBy goldbook:15701 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15701 "current"^^xsd:string)
Declaration(Class(goldbook:15702))
AnnotationAssertion(rdfs:label goldbook:15702 "extracellular space")
AnnotationAssertion(dcterms:description goldbook:15702 "Volume within a tissue, outside cells, and excluding vascular and lymphatic space.")
AnnotationAssertion(mito:isMentionedBy goldbook:15702 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15702 "current"^^xsd:string)
Declaration(Class(goldbook:15703))
AnnotationAssertion(rdfs:label goldbook:15703 "extracellular volume")
AnnotationAssertion(dcterms:description goldbook:15703 "Volume of fluid outside the cells but within the outer surface of an organism.")
AnnotationAssertion(mito:isMentionedBy goldbook:15703 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15703 "current"^^xsd:string)
Declaration(Class(goldbook:15704))
AnnotationAssertion(rdfs:label goldbook:15704 "extraction ratio")
AnnotationAssertion(dcterms:description goldbook:15704 "Amount of substance extracted from a source divided by the total contained within the source.")
AnnotationAssertion(mito:isMentionedBy goldbook:15704 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15704 "current"^^xsd:string)
Declaration(Class(goldbook:15705))
AnnotationAssertion(rdfs:label goldbook:15705 "extra risk")
AnnotationAssertion(dcterms:description goldbook:15705 "Probability that an agent produces an observed response, as distinguished from the probability that the response is caused by a spontaneous event unrelated to the agent.")
AnnotationAssertion(mito:isMentionedBy goldbook:15705 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15705 "current"^^xsd:string)
Declaration(Class(goldbook:15706))
AnnotationAssertion(rdfs:label goldbook:15706 "extraneous residue limit")
AnnotationAssertion(dcterms:description goldbook:15706 "Refers to a pesticide residue or contaminant arising from environmental sources (including former agricultural uses) other than the use of a pesticide or contaminant substance directly or indirectly on the commodity. It is the maximum concentration of a pesticide residue or contaminant that is recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food, agricultural commodity, or animal feed.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15706 "ERL")
AnnotationAssertion(rdfs:comment goldbook:15706 "The mass content is expressed in milligrams of pesticide residue or contaminant per kilogram of commodity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15706 goldbook:15571)
AnnotationAssertion(mito:isMentionedBy goldbook:15706 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15706 "current"^^xsd:string)
Declaration(Class(goldbook:15707))
AnnotationAssertion(rdfs:label goldbook:15707 "extrapyramidal movement disorders")
AnnotationAssertion(dcterms:description goldbook:15707 "Involuntary movement disorders mediated by signaling through neurons outside the pyramidal (corticospinal) tract, often describing side effects of psychiatric medications.")
AnnotationAssertion(mito:isMentionedBy goldbook:15707 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15707 "current"^^xsd:string)
Declaration(Class(goldbook:15708))
AnnotationAssertion(rdfs:label goldbook:15708 "fertility")
AnnotationAssertion(dcterms:description goldbook:15708 "Ability to conceive and to produce offspring: For litter-bearing species, the number of offspring per litter is used as a measure of fertility.")
AnnotationAssertion(rdfs:comment goldbook:15708 "Reduced fertility is sometimes referred to as subfertility."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15708 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15708 "current"^^xsd:string)
Declaration(Class(goldbook:15709))
AnnotationAssertion(rdfs:label goldbook:15709 "fertility toxicant")
AnnotationAssertion(dcterms:description goldbook:15709 "Produces abnormalities of male or female reproductive functions or impairs reproductive capacity.")
AnnotationAssertion(mito:isMentionedBy goldbook:15709 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15709 "current"^^xsd:string)
Declaration(Class(goldbook:15710))
AnnotationAssertion(rdfs:label goldbook:15710 "fetotoxicity")
AnnotationAssertion(dcterms:description goldbook:15710 "Toxicity to the fetus.")
AnnotationAssertion(mito:isMentionedBy goldbook:15710 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15710 "current"^^xsd:string)
Declaration(Class(goldbook:15711))
AnnotationAssertion(rdfs:label goldbook:15711 "fibrosis")
AnnotationAssertion(dcterms:description goldbook:15711 "Abnormal formation of fibrous tissue.")
AnnotationAssertion(mito:isMentionedBy goldbook:15711 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15711 "current"^^xsd:string)
Declaration(Class(goldbook:15712))
AnnotationAssertion(rdfs:label goldbook:15712 "fiducial limit")
AnnotationAssertion(dcterms:description goldbook:15712 "Form of confidence limit given as a stated probability, for example, \\(P = \\pu{0.95}\\).")
AnnotationAssertion(rdfs:comment goldbook:15712 "In toxicology, the terms \"fiducial limits\" and \"confidence limits\" are generally considered to be synonymous."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15712 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15712 "current"^^xsd:string)
Declaration(Class(goldbook:15713))
AnnotationAssertion(rdfs:label goldbook:15713 "first-order chemical reaction")
AnnotationAssertion(dcterms:description goldbook:15713 "Chemical reaction where the initial rate is directly proportional to the concentration of one of the reactants. Any process in which a variable decreases with time at a constant fractional amount.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15713 "first-order reaction")
AnnotationAssertion(mito:isMentionedBy goldbook:15713 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15713 "current"^^xsd:string)
Declaration(Class(goldbook:15714))
AnnotationAssertion(rdfs:label goldbook:15714 "fixed dose procedure")
AnnotationAssertion(dcterms:description goldbook:15714 "Acute toxicity test in which a substance is tested initially at a small number (3 or 4) predefined doses to identify which produces evident toxicity without lethality: The test may be repeated at one or more higher or lower defined discriminating doses to satisfy the criteria.")
AnnotationAssertion(mito:isMentionedBy goldbook:15714 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15714 "current"^^xsd:string)
Declaration(Class(goldbook:15715))
AnnotationAssertion(rdfs:label goldbook:15715 "fluorosis")
AnnotationAssertion(dcterms:description goldbook:15715 "Adverse effects of fluoride, as in dental or skeletal fluorosis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15715 "fluoridosis")
AnnotationAssertion(mito:isMentionedBy goldbook:15715 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15715 "current"^^xsd:string)
Declaration(Class(goldbook:15716))
AnnotationAssertion(rdfs:label goldbook:15716 "foci")
AnnotationAssertion(dcterms:description goldbook:15716 "Small groups of cells distinguishable, in appearance or histochemically, from the surrounding tissue: indicative of an early stage of a lesion that may lead to the formation of a neoplastic nodule.")
AnnotationAssertion(mito:isMentionedBy goldbook:15716 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15716 "current"^^xsd:string)
Declaration(Class(goldbook:15717))
AnnotationAssertion(rdfs:label goldbook:15717 "food additive")
AnnotationAssertion(dcterms:description goldbook:15717 "Any substance, not normally consumed as a food by itself and not normally used as a typical ingredient of a given food, whether or not it has nutritive value, that is added intentionally to food for a technological (including organoleptic) purpose in the manufacture, processing, preparation, treatment, packing, packaging, transport, or holding of the food. Addition results, or may be reasonably expected to result (directly or indirectly), in the substance or its byproducts becoming a component of, or otherwise affecting, the characteristics of the food to which it is added.")
AnnotationAssertion(rdfs:comment goldbook:15717 "The term does not include \"contaminants\" or substances added to food for maintaining or improving nutritional qualities."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15717 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15717 "current"^^xsd:string)
Declaration(Class(goldbook:15718))
AnnotationAssertion(rdfs:label goldbook:15718 "food allergy")
AnnotationAssertion(dcterms:description goldbook:15718 "Hypersensitivity reaction to substances in the diet to which an individual has previously been sensitized.")
AnnotationAssertion(mito:isMentionedBy goldbook:15718 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15718 "current"^^xsd:string)
Declaration(Class(goldbook:15719))
AnnotationAssertion(rdfs:label goldbook:15719 "food intolerance")
AnnotationAssertion(dcterms:description goldbook:15719 "Physiologically based reproducible, unpleasant (adverse) reaction to a specific food or food ingredient that is not immunologically based.")
AnnotationAssertion(mito:isMentionedBy goldbook:15719 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15719 "current"^^xsd:string)
Declaration(Class(goldbook:15720))
AnnotationAssertion(rdfs:label goldbook:15720 "food web")
AnnotationAssertion(dcterms:description goldbook:15720 "Network of food chains.")
AnnotationAssertion(mito:isMentionedBy goldbook:15720 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15720 "current"^^xsd:string)
Declaration(Class(goldbook:15721))
AnnotationAssertion(rdfs:label goldbook:15721 "forced diuresis")
AnnotationAssertion(dcterms:description goldbook:15721 "Method of stimulating diuresis based on performing hydrational therapy, sometimes with parallel introduction of diuretics, with the aim of achieving increased clearance of a toxic substance in urine.")
AnnotationAssertion(mito:isMentionedBy goldbook:15721 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15721 "current"^^xsd:string)
Declaration(Class(goldbook:15722))
AnnotationAssertion(rdfs:label goldbook:15722 "founder effect")
AnnotationAssertion(dcterms:description goldbook:15722 "Changes in allelic frequencies that occur when a small group is separated from a large population and establishes a colony in a new location.")
AnnotationAssertion(mito:isMentionedBy goldbook:15722 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15722 "current"^^xsd:string)
Declaration(Class(goldbook:15723))
AnnotationAssertion(rdfs:label goldbook:15723 "fumigant")
AnnotationAssertion(dcterms:description goldbook:15723 "Substance that is vaporized in order to kill or repel pests.")
AnnotationAssertion(mito:isMentionedBy goldbook:15723 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15723 "current"^^xsd:string)
Declaration(Class(goldbook:15724))
AnnotationAssertion(rdfs:label goldbook:15724 "fungus preparation")
AnnotationAssertion(dcterms:description goldbook:15724 "Substance obtained from fungi that has an insecticidal effect reflecting the pathogenicity of the fungi for insects.")
AnnotationAssertion(mito:isMentionedBy goldbook:15724 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15724 "current"^^xsd:string)
Declaration(Class(goldbook:15725))
AnnotationAssertion(rdfs:label goldbook:15725 "gametocide")
AnnotationAssertion(dcterms:description goldbook:15725 "Substance intended to kill gametes.")
AnnotationAssertion(mito:isMentionedBy goldbook:15725 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15725 "current"^^xsd:string)
Declaration(Class(goldbook:15726))
AnnotationAssertion(rdfs:label goldbook:15726 "gastroenteritis")
AnnotationAssertion(dcterms:description goldbook:15726 "Inflammation of the stomach and intestine.")
AnnotationAssertion(mito:isMentionedBy goldbook:15726 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15726 "current"^^xsd:string)
Declaration(Class(goldbook:15727))
AnnotationAssertion(rdfs:label goldbook:15727 "gastrointestinal")
AnnotationAssertion(dcterms:description goldbook:15727 "Pertaining to or communicating with the stomach and intestine.")
AnnotationAssertion(mito:isMentionedBy goldbook:15727 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15727 "current"^^xsd:string)
Declaration(Class(goldbook:15728))
AnnotationAssertion(rdfs:label goldbook:15728 "gavage")
AnnotationAssertion(dcterms:description goldbook:15728 "Administration of materials directly into the stomach by esophageal intubation.")
AnnotationAssertion(mito:isMentionedBy goldbook:15728 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15728 "current"^^xsd:string)
Declaration(Class(goldbook:15729))
AnnotationAssertion(rdfs:label goldbook:15729 "gene map")
AnnotationAssertion(dcterms:description goldbook:15729 "Map showing the positions in the genome of genes or other genetic markers, either relative to each other or as a physical map of absolute distances.")
AnnotationAssertion(mito:isMentionedBy goldbook:15729 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15729 "current"^^xsd:string)
Declaration(Class(goldbook:15730))
AnnotationAssertion(rdfs:label goldbook:15730 "generally regarded as safe")
AnnotationAssertion(dcterms:description goldbook:15730 "Phrase used to describe the USFDA philosophy that justifies approval of food additives that may not meet the usual test criteria for safety but have been used extensively and have not demonstrated that they cause any harm to consumers.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15730 "GRAS")
AnnotationAssertion(mito:isMentionedBy goldbook:15730 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15730 "current"^^xsd:string)
Declaration(Class(goldbook:15731))
AnnotationAssertion(rdfs:label goldbook:15731 "genetically modified organism")
AnnotationAssertion(dcterms:description goldbook:15731 "Bacterium, plant, or animal whose DNA has been deliberately altered.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15731 "GMO")
AnnotationAssertion(mito:isMentionedBy goldbook:15731 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15731 "current"^^xsd:string)
Declaration(Class(goldbook:15732))
AnnotationAssertion(rdfs:label goldbook:15732 "genetic polymorphism")
AnnotationAssertion(dcterms:description goldbook:15732 "Existence of inter-individual differences in DNA sequences coding for one specific gene, giving rise to different functional and (or) morphological traits.")
AnnotationAssertion(mito:isMentionedBy goldbook:15732 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15732 "current"^^xsd:string)
Declaration(Class(goldbook:15733))
AnnotationAssertion(rdfs:label goldbook:15733 "genetic susceptibility")
AnnotationAssertion(dcterms:description goldbook:15733 "Predisposition to a particular disease or sensitivity to a substance due to the presence of a specific allele or combination of alleles in an individual’s genome.")
AnnotationAssertion(rdfs:seeAlso goldbook:15733 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:15733 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15733 "current"^^xsd:string)
Declaration(Class(goldbook:15734))
AnnotationAssertion(rdfs:label goldbook:15734 "genetic toxicology")
AnnotationAssertion(dcterms:description goldbook:15734 "Study of chemically or physically induced changes to the structure of DNA, including epigenetic phenomena or mutations that may or may not be heritable.")
AnnotationAssertion(mito:isMentionedBy goldbook:15734 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15734 "current"^^xsd:string)
Declaration(Class(goldbook:15735))
AnnotationAssertion(rdfs:label goldbook:15735 "germ-free animal")
AnnotationAssertion(dcterms:description goldbook:15735 "Animal grown under sterile conditions in the period of postnatal development: Such animals are usually obtained by Caesarean operation and kept in special sterile boxes in which there are no viable microorganisms (sterile air, food, and water are supplied).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15735 "axenic animal")
AnnotationAssertion(mito:isMentionedBy goldbook:15735 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15735 "current"^^xsd:string)
Declaration(Class(goldbook:15736))
AnnotationAssertion(rdfs:label goldbook:15736 "germinal aplasia")
AnnotationAssertion(dcterms:description goldbook:15736 "Complete failure of gonad development.")
AnnotationAssertion(mito:isMentionedBy goldbook:15736 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15736 "current"^^xsd:string)
Declaration(Class(goldbook:15737))
AnnotationAssertion(rdfs:label goldbook:15737 "glomerular")
AnnotationAssertion(dcterms:description goldbook:15737 "Pertaining to a tuft or cluster, as of a plexus of capillary blood vessels or nerve fibers, especially referring to the capillaries of the glomerular of the kidney.")
AnnotationAssertion(mito:isMentionedBy goldbook:15737 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15737 "current"^^xsd:string)
Declaration(Class(goldbook:15738))
AnnotationAssertion(rdfs:label goldbook:15738 "glomerular filtration")
AnnotationAssertion(dcterms:description goldbook:15738 "Formation of an ultrafiltrate of the blood occurring in the glomerulus of the kidney.")
AnnotationAssertion(mito:isMentionedBy goldbook:15738 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15738 "current"^^xsd:string)
Declaration(Class(goldbook:15739))
AnnotationAssertion(rdfs:label goldbook:15739 "glomerular filtration rate")
AnnotationAssertion(dcterms:description goldbook:15739 "Volume of ultrafiltrate formed in the kidney tubules from the blood passing through the glomerular capillaries divided by time of filtration.")
AnnotationAssertion(mito:isMentionedBy goldbook:15739 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15739 "current"^^xsd:string)
Declaration(Class(goldbook:15740))
AnnotationAssertion(rdfs:label goldbook:15740 "glue-sniffing")
AnnotationAssertion(dcterms:description goldbook:15740 "Inhalation of solvent vapor from plastic cements or other adhesives in order to become intoxicated.")
AnnotationAssertion(rdfs:seeAlso goldbook:15740 goldbook:16097)
AnnotationAssertion(mito:isMentionedBy goldbook:15740 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15740 "current"^^xsd:string)
Declaration(Class(goldbook:15741))
AnnotationAssertion(rdfs:label goldbook:15741 "gnotobiota")
AnnotationAssertion(dcterms:description goldbook:15741 "Specifically and entirely known microfauna and microflora of a specially reared laboratory animal.")
AnnotationAssertion(mito:isMentionedBy goldbook:15741 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15741 "current"^^xsd:string)
Declaration(Class(goldbook:15742))
AnnotationAssertion(rdfs:label goldbook:15742 "gnotobiote")
AnnotationAssertion(dcterms:description goldbook:15742 "Specially reared laboratory animal whose microflora and microfauna are specifically known in their entirety.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15742 "gnotobiont")
AnnotationAssertion(mito:isMentionedBy goldbook:15742 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15742 "current"^^xsd:string)
Declaration(Class(goldbook:15743))
AnnotationAssertion(rdfs:label goldbook:15743 "goiter")
AnnotationAssertion(dcterms:description goldbook:15743 "Noncancerous enlargement of the thyroid gland, visible as a swelling at the front of the neck, that is often associated with iodine deficiency.")
AnnotationAssertion(mito:isMentionedBy goldbook:15743 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15743 "current"^^xsd:string)
Declaration(Class(goldbook:15744))
AnnotationAssertion(rdfs:label goldbook:15744 "goitrogen")
AnnotationAssertion(dcterms:description goldbook:15744 "Any substance (such as thiouracil) that induces the formation of a goiter.")
AnnotationAssertion(mito:isMentionedBy goldbook:15744 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15744 "current"^^xsd:string)
Declaration(Class(goldbook:15745))
AnnotationAssertion(rdfs:label goldbook:15745 "gonadotropic")
AnnotationAssertion(dcterms:description goldbook:15745 "Pertaining to effects on sex glands and on the systems that regulate them.")
AnnotationAssertion(mito:isMentionedBy goldbook:15745 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15745 "current"^^xsd:string)
Declaration(Class(goldbook:15746))
AnnotationAssertion(rdfs:label goldbook:15746 "good agricultural practice")
AnnotationAssertion(dcterms:description goldbook:15746 "Nationally authorized safe uses of pesticides under actual conditions necessary for effective and reliable pest control.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15746 "GAP")
AnnotationAssertion(rdfs:comment goldbook:15746 "It encompasses a range of levels of pesticide applications up to the highest authorized use, applied in a manner that leaves a residue which is the smallest amount practicable. Authorized safe uses include nationally registered or recommended uses, that take into account public and occupational health and environmental safety considerations. Actual conditions include any stage in the production, storage, transport, distribution, and processing of food commodities and animal feed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15746 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15746 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15746 "current"^^xsd:string)
Declaration(Class(goldbook:15747))
AnnotationAssertion(rdfs:label goldbook:15747 "graminicide")
AnnotationAssertion(dcterms:description goldbook:15747 "Pesticide (herbicide) used for the control of weedy grasses (Gramineae).")
AnnotationAssertion(rdfs:seeAlso goldbook:15747 goldbook:15774)
AnnotationAssertion(mito:isMentionedBy goldbook:15747 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15747 "current"^^xsd:string)
Declaration(Class(goldbook:15748))
AnnotationAssertion(rdfs:label goldbook:15748 "ground treatment of plants")
AnnotationAssertion(dcterms:description goldbook:15748 "Dusting or spraying of plants with pesticides by hand, by special machines, or by apparatus fixed to tractors or driven by them.")
AnnotationAssertion(mito:isMentionedBy goldbook:15748 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15748 "current"^^xsd:string)
Declaration(Class(goldbook:15749))
AnnotationAssertion(rdfs:label goldbook:15749 "guideline for exposure limits")
AnnotationAssertion(dcterms:description goldbook:15749 "Scientifically judged quantitative value (a concentration or number) of an environmental constituent that ensures aesthetically pleasing air, water, or food and from which no adverse effect is expected concerning noncarcinogenic endpoints, or that gives an acceptably low estimate of lifetime cancer risk from those substances which are proven human carcinogens or carcinogens with at least limited evidence of human carcinogenicity.")
AnnotationAssertion(mito:isMentionedBy goldbook:15749 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15749 "current"^^xsd:string)
Declaration(Class(goldbook:15750))
AnnotationAssertion(rdfs:label goldbook:15750 "guideline value")
AnnotationAssertion(dcterms:description goldbook:15750 "Quantitative measure (a concentration or a number) of a constituent of an environmental medium that ensures aesthetically pleasing air, water, or food and does not result in a significant risk to the user.")
AnnotationAssertion(mito:isMentionedBy goldbook:15750 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15750 "current"^^xsd:string)
Declaration(Class(goldbook:15751))
AnnotationAssertion(rdfs:label goldbook:15751 "guides to air quality")
AnnotationAssertion(dcterms:description goldbook:15751 "Sets of atmospheric concentrations and exposure times that are associated with specific effects of varying degrees of pollution on humans, animals, vegetation, and the environment in general.")
AnnotationAssertion(mito:isMentionedBy goldbook:15751 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15751 "current"^^xsd:string)
Declaration(Class(goldbook:15752))
AnnotationAssertion(rdfs:label goldbook:15752 "guides to environmental quality")
AnnotationAssertion(dcterms:description goldbook:15752 "Sets of concentrations, numbers and exposure times that are associated with the specific effects of factors in environmental media on humans, animals, vegetation, and the environment in general.")
AnnotationAssertion(mito:isMentionedBy goldbook:15752 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15752 "current"^^xsd:string)
Declaration(Class(goldbook:15753))
AnnotationAssertion(rdfs:label goldbook:15753 "harmful occupational factor")
AnnotationAssertion(dcterms:description goldbook:15753 "Component of the work environment, the effect of which on a worker under certain conditions leads to ill health or reduction of working ability.")
