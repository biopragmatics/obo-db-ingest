AnnotationAssertion(dcterms:description goldbook:14289 "Latex obtained as a product of an emulsion, mini-emulsion, micro-emulsion, or dispersion polymerization.")
Declaration(Class(goldbook:14290))
AnnotationAssertion(rdfs:label goldbook:14290 "equivalent particle diameter")
AnnotationAssertion(dcterms:description goldbook:14290 "Diameter of a hypothetical spherical particle of the same composition that, using a given particle-size determination method, would give the same diameter as a substance composed of spherical or nonspherical particles at the same concentration.")
Declaration(Class(goldbook:14291))
AnnotationAssertion(rdfs:label goldbook:14291 "number-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14291 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{N}} \\right\\rangle = \\bar d_{\\rm{N}} = \\frac{\\Sigma N_{i} d_{i}}{\\Sigma N_{i}}\\]")
Declaration(Class(goldbook:14292))
AnnotationAssertion(rdfs:label goldbook:14292 "surface-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14292 "Calculated using the following equation: \\[\\left\\langle {d_{\\rm{s}}} \\right\\rangle = \\bar d_{\\rm{s}} = \\frac{\\Sigma {N_{i}} {d_{i}^{3}}}{\\Sigma {N_{i}} {d_{i}^{2}}}\\]")
Declaration(Class(goldbook:14293))
AnnotationAssertion(rdfs:label goldbook:14293 "mass-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14293 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{m}} \\right\\rangle = \\bar d_{\\rm{m}} = \\frac{\\Sigma {N_{i}} {d_{i}^{4}}}{\\Sigma {N_{i}} {d_{i}^{3}}}\\]")
Declaration(Class(goldbook:14294))
AnnotationAssertion(rdfs:label goldbook:14294 "z-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14294 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{z}} \\right\\rangle = \\bar d_{\\rm{z}} = \\frac{\\Sigma N_{i} d_{i}^{5}}{\\Sigma N_{i}d_{i}^{4}}\\]")
Declaration(Class(goldbook:14295))
AnnotationAssertion(rdfs:label goldbook:14295 "volume-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14295 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{v}} \\right\\rangle = \\bar d_{\\rm{v}} = \\left(\\frac{\\Sigma N_{i} d_{i}^{3}}{\\Sigma N_{i}}\\right)^{1/3}\\]")
Declaration(Class(goldbook:14296))
AnnotationAssertion(rdfs:label goldbook:14296 "particle-diameter dispersity")
AnnotationAssertion(dcterms:description goldbook:14296 "Calculated using the following equation: \\[Ɖ_{\\rm{d}} = \\left\\langle d_{\\rm{m}} \\right\\rangle /\\!\\left\\langle d_{\\rm{N}} \\right\\rangle = \\bar d_{\\rm{m}}/\\bar d_{\\rm{N}} = \\frac{\\Sigma N_{i}\\Sigma N_{i} d_{i}^{4}}{\\Sigma N_{i} d_{i} \\Sigma N_{i} d_{i}^{3}}\\]")
Declaration(Class(goldbook:14297))
