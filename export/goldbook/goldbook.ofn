AnnotationAssertion(dcterms:description goldbook:16046 "Physiological or biochemical capacity that may be available to maintain homeostasis when the body or an organism is exposed to an environmental change.")
AnnotationAssertion(rdfs:seeAlso goldbook:16046 goldbook:15695)
AnnotationAssertion(mito:isMentionedBy goldbook:16046 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16046 "current"^^xsd:string)
Declaration(Class(goldbook:16047))
AnnotationAssertion(rdfs:label goldbook:16047 "reservoir")
AnnotationAssertion(dcterms:description goldbook:16047 "Storage compartment from which a substance may be released with subsequent biological effects.")
AnnotationAssertion(mito:isMentionedBy goldbook:16047 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16047 "current"^^xsd:string)
Declaration(Class(goldbook:16048))
AnnotationAssertion(rdfs:label goldbook:16048 "residual risk")
AnnotationAssertion(dcterms:description goldbook:16048 "Health risk remaining after risk reduction actions are implemented.")
AnnotationAssertion(mito:isMentionedBy goldbook:16048 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16048 "current"^^xsd:string)
Declaration(Class(goldbook:16049))
