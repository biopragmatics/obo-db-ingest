property_value: mito:isMentionedBy doi:10.1515/pac-2019-0404
property_value: hasStatus "current" xsd:string
consider: goldbook:09230

[Term]
id: goldbook:09247
name: electron flooding
def: "Irradiation of a sample with low-energy electrons in order to change or stabilize the charging potential."
