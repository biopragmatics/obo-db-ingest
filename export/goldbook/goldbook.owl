    <!-- http://dx.doi.org/10.1351/goldbook.15471 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15471">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Widespread origin of emissions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>distributed source</oboInOwl:hasRelatedSynonym>
        <rdfs:label>area source</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15472 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15472">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area between a curve and the abscissa (horizontal axis) in a plot of (concentration \(\times\) time) vs. time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>AUMC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>area under the moment curve</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AUMC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15473 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15473">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological condition characterized by gray-bluish or black pigmentation of tissues (such as skin, retina, mucous membranes, internal organs) caused by the accumulation of metallic silver, due to reduction of a silver compound which has entered the organism during (prolonged) administration or exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>argyrosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>argyria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15474 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15474">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic arsenical poisoning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>arseniasis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15476 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15476">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hardening and thickening of the walls of the arteries.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>arteriosclerosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15487"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15477 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15477">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pain in a joint.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>arthralgia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15478 -->

