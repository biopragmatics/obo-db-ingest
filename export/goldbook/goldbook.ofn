Declaration(Class(goldbook:10795))
AnnotationAssertion(rdfs:label goldbook:10795 "hermaphroditism")
AnnotationAssertion(dcterms:description goldbook:10795 "State of being hermaphrodite.")
Declaration(Class(goldbook:10796))
AnnotationAssertion(rdfs:label goldbook:10796 "hernia")
