AnnotationAssertion(obo:goldbook#hasStatus goldbook:13403 "current"^^xsd:string)
Declaration(Class(goldbook:13404))
AnnotationAssertion(rdfs:label goldbook:13404 "lymphocyte homing receptor")
AnnotationAssertion(dcterms:description goldbook:13404 "Cell surface glycoprotein on lymphocytes and other leukocytes that mediates adhesion to specialized blood vessels, the high endothelial venules.")
AnnotationAssertion(rdfs:comment goldbook:13404 "Several different classes of lymphocyte homing receptors have been identified, and they appear to bind to different surface molecules (addressins) on high endothelial venules in different tissues."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13404 goldbook:12846)
AnnotationAssertion(rdfs:seeAlso goldbook:13404 goldbook:13212)
