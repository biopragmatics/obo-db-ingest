AnnotationAssertion(dcterms:description goldbook:GT07138 "Reaction in which one or more species of block are connected to the main chain of a macromolecule as side-chains having constitutional or configurational features that differ from those in the main chain.")
AnnotationAssertion(rdfs:seeAlso goldbook:GT07138 goldbook:B00682)
AnnotationAssertion(mito:isMentionedBy goldbook:GT07138 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:GT07138 "current"^^xsd:string)
Declaration(Class(goldbook:GT07386))
AnnotationAssertion(rdfs:label goldbook:GT07386 "gated photochromism")
AnnotationAssertion(dcterms:description goldbook:GT07386 "Special form of photochromism in which one or both forms of a photochromic system are transformed reversibly, either chemically or electrochemically, into a non-photochromic form.")
