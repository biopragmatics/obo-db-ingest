Declaration(Class(goldbook:C00776))
AnnotationAssertion(rdfs:label goldbook:C00776 "calibration component")
AnnotationAssertion(dcterms:description goldbook:C00776 "A component of a calibration mixture, present in the gaseous or vapour state, quantitatively and qualitatively defined, and used directly for testing and for calibration.")
AnnotationAssertion(mito:isMentionedBy goldbook:C00776 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00776 "current"^^xsd:string)
Declaration(Class(goldbook:C00778))
AnnotationAssertion(rdfs:label goldbook:C00778 "calibration function")
AnnotationAssertion(dcterms:description goldbook:C00778 "The functional (not statistical) relationship for the chemical measurement process, relating the expected value of the observed (gross) signal or response variable \\(E(y)\\) to the analyte amount \\(x\\). The corresponding graphical display for a single analyte is referred to as the calibration curve. When extended to additional variables or analytes which occur in multicomponent analysis, the 'curve' becomes a calibration surface or hypersurface.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00778 goldbook:C01030)
AnnotationAssertion(rdfs:seeAlso goldbook:C00778 goldbook:E02272)
AnnotationAssertion(rdfs:seeAlso goldbook:C00778 goldbook:V06600)
AnnotationAssertion(mito:isMentionedBy goldbook:C00778 doi:10.1351/pac199567101699)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00778 "current"^^xsd:string)
Declaration(Class(goldbook:C00779))
AnnotationAssertion(rdfs:label goldbook:C00779 "calibration gas mixture")
AnnotationAssertion(dcterms:description goldbook:C00779 "A gas mixture of known composition, generally comprising one or more calibration components and a complementary gas.")
AnnotationAssertion(mito:isMentionedBy goldbook:C00779 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00779 "current"^^xsd:string)
Declaration(Class(goldbook:C00780))
