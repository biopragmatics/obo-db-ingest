Declaration(Class(goldbook:H02845))
AnnotationAssertion(rdfs:label goldbook:H02845 "homogeneity")
AnnotationAssertion(dcterms:description goldbook:H02845 "The degree to which a property or a constituent is uniformly distributed throughout a quantity of material. A material may be homogeneous with respect to one analyte or property but heterogeneous with respect to another. The degree of heterogeneity (the opposite of homogeneity) is the determining factor of sampling error.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:H02845 "material heterogeneity")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:H02845 "material homogeneity")
