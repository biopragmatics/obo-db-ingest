AnnotationAssertion(dcterms:description goldbook:11749 "Stage with four orthogonal side arms elevated above the floor, where two opposite arms have sidewalls and the other two arms have no walls; used as research tool for anxiety.")
AnnotationAssertion(rdfs:comment goldbook:11749 "Rodents normally preferentially avoid the arms without walls, but during anxiolytic treatment they tend to spend more time on them, or enter them more often."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11749 goldbook:11598)
AnnotationAssertion(mito:isMentionedBy goldbook:11749 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11749 "current"^^xsd:string)
