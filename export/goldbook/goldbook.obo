consider: goldbook:08028

[Term]
id: goldbook:08108
name: quality improvement
def: "Part of quality management focused on increasing the ability to fulfil requirements for quality."
comment: "The requirements can be related to any aspect such as effectiveness, efficiency, or object traceability."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0819
property_value: hasStatus "current" xsd:string
