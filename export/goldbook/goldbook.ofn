AnnotationAssertion(rdfs:label goldbook:K03417 "krypton ion laser")
AnnotationAssertion(dcterms:description goldbook:K03417 "A CW or pulsed laser emitting lines from \\(337\\) to \\(859\\ \\rm{nm}\\) from singly ionized krypton. Principal emissions are at \\(530.9\\), \\(568.2\\), \\(647.1\\) and \\(752.5\\ \\rm{nm}\\).")
