Declaration(Class(goldbook:S05590))
AnnotationAssertion(rdfs:label goldbook:S05590 "semicoke")
AnnotationAssertion(dcterms:description goldbook:S05590 "A carbonaceous material intermediate between a fusible mesophase pitch and a non-deformable green coke produced by incomplete carbonization at temperatures between the onset of fusion (of coal, ca. \\(620\\ \\rm{K}\\)), and complete devolatilization. Semicoke still contains volatile matter, therefore.")
AnnotationAssertion(rdfs:comment goldbook:S05590 "Semicoke may be conceived as covering a continuous range from coal that has not yet been fused to coke breeze. Semicoke can also be used as a filler in carbon mixtures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05590 goldbook:C00840)
AnnotationAssertion(rdfs:seeAlso goldbook:S05590 goldbook:C01121)
AnnotationAssertion(rdfs:seeAlso goldbook:S05590 goldbook:C01143)
AnnotationAssertion(rdfs:seeAlso goldbook:S05590 goldbook:F02363)
