AnnotationAssertion(dcterms:description goldbook:16157 "Document that gives in a uniform manner data relating to the toxicology of a substance, its production and application, properties and methods of identification.")
AnnotationAssertion(rdfs:comment goldbook:16157 "The data sheet may also include recommendations on protective measures."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16157 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16157 "current"^^xsd:string)
