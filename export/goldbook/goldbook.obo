[Term]
id: goldbook:C01022
name: chemical element
def: "A species of atoms; all atoms with the same number of protons in the atomic nucleus.A pure chemical substance composed of atoms with the same number of protons in the atomic nucleus. Sometimes this concept is called the elementary substance as distinct from the chemical element as defined under \(1\)\, but mostly the term chemical element is used for both concepts."
synonym: "element" []
property_value: mito:isMentionedBy doi:10.1515/pac-2014-0718
property_value: hasStatus "current" xsd:string
