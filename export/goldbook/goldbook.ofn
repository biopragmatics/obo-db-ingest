AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00514 "current"^^xsd:string)
Declaration(Class(goldbook:A00515))
AnnotationAssertion(rdfs:label goldbook:A00515 "attenuation")
AnnotationAssertion(dcterms:description goldbook:A00515 "The reduction of a radiation quantity upon passage of radiation through matter resulting from interactions of the radiation with the matter it traverses.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00515 goldbook:R05048)
AnnotationAssertion(mito:isMentionedBy goldbook:A00515 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00515 "current"^^xsd:string)
Declaration(Class(goldbook:A00518))
AnnotationAssertion(rdfs:label goldbook:A00518 "attractive–mixed–repulsive classification")
AnnotationAssertion(dcterms:description goldbook:A00518 "A classification of potential-energy surfaces in which a highly attractive surface is at one extreme and a highly repulsive surface is at the other. The energy release in intermediate cases is referred to as mixed.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:A00518 "AMR")
AnnotationAssertion(rdfs:seeAlso goldbook:A00518 goldbook:P04780)
AnnotationAssertion(mito:isMentionedBy goldbook:A00518 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00518 "current"^^xsd:string)
Declaration(Class(goldbook:A00519))
AnnotationAssertion(rdfs:label goldbook:A00519 "attractive potential-energy surface")
AnnotationAssertion(dcterms:description goldbook:A00519 "A potential-energy surface for a process A + B–C in which the initial descent of the system into the product valley is associated with a substantial decrease in the A–B distance and with little separation between the products A–B and C. In terms of a potential-energy profile, the energy barrier occurs in the early stage of the reaction path. Attractive surfaces are also called early-downhill surfaces, and the barrier in such a surface is called a Type-I barrier.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00519 "early-downhill surface")
AnnotationAssertion(rdfs:seeAlso goldbook:A00519 goldbook:P04779)
AnnotationAssertion(rdfs:seeAlso goldbook:A00519 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:A00519 goldbook:R05174)
AnnotationAssertion(mito:isMentionedBy goldbook:A00519 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00519 "current"^^xsd:string)
Declaration(Class(goldbook:A00520))
AnnotationAssertion(rdfs:label goldbook:A00520 "Auger effect")
AnnotationAssertion(dcterms:description goldbook:A00520 "The emission of an electron from an atom accompanying the filling of a vacancy in an inner electron shell.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00520 goldbook:A00493)
AnnotationAssertion(rdfs:seeAlso goldbook:A00520 goldbook:E01975)
AnnotationAssertion(mito:isMentionedBy goldbook:A00520 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00520 "current"^^xsd:string)
Declaration(Class(goldbook:A00521))
AnnotationAssertion(rdfs:label goldbook:A00521 "Auger electron")
AnnotationAssertion(dcterms:description goldbook:A00521 "Electron originating in the Auger effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00521 goldbook:A00520)
AnnotationAssertion(rdfs:seeAlso goldbook:A00521 goldbook:E01975)
AnnotationAssertion(mito:isMentionedBy goldbook:A00521 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00521 "current"^^xsd:string)
Declaration(Class(goldbook:A00522))
AnnotationAssertion(rdfs:label goldbook:A00522 "Auger electron spectroscopy")
AnnotationAssertion(dcterms:description goldbook:A00522 "Any technique in which a specimen is bombarded with \\(\\mathrm{keV}\\)-energy electrons or X-rays, and the energy distribution of the electrons produced through radiationless de-excitation of the atoms in the sample (Auger electrons) is recorded. The derivative curve may also be recorded.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00522 goldbook:A00521)
AnnotationAssertion(mito:isMentionedBy goldbook:A00522 doi:10.1351/pac198355122023)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00522 "current"^^xsd:string)
Declaration(Class(goldbook:A00523))
AnnotationAssertion(rdfs:label goldbook:A00523 "Auger electron yield")
AnnotationAssertion(dcterms:description goldbook:A00523 "The fraction of the atoms having a vacancy in an inner orbital which relax by emission of an Auger electron.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00523 goldbook:A00521)
AnnotationAssertion(mito:isMentionedBy goldbook:A00523 doi:10.1351/pac197951112243)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00523 "current"^^xsd:string)
Declaration(Class(goldbook:A00524))
AnnotationAssertion(rdfs:label goldbook:A00524 "Auger yield")
AnnotationAssertion(dcterms:description goldbook:A00524 "For a given excited state of a specified atom the probability that the de-excitation occurs by the Auger effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00524 goldbook:A00520)
AnnotationAssertion(rdfs:seeAlso goldbook:A00524 goldbook:A00493)
AnnotationAssertion(rdfs:seeAlso goldbook:A00524 goldbook:E02257)
