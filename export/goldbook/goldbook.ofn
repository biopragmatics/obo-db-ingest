AnnotationAssertion(dcterms:description goldbook:12160 "Increase in the diameter of the lumen of the blood vessels as a result of relaxation of smooth muscles in the vessel walls.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12160 "vasodilatation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12160 "vasodilation")
AnnotationAssertion(rdfs:comment goldbook:12160 "This results in a decrease in vascular resistance followed by a decrease of blood pressure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12160 goldbook:12157)
AnnotationAssertion(mito:isMentionedBy goldbook:12160 doi:10.1515/pac-2015-0103)
