AnnotationAssertion(rdfs:label goldbook:13539 "passive hemagglutination")
AnnotationAssertion(dcterms:description goldbook:13539 "Method of measuring antibody titer, in which antigen-coated erythrocytes are agglutinated by adding antibody specific for the antigen.")
AnnotationAssertion(rdfs:seeAlso goldbook:13539 goldbook:13127)
AnnotationAssertion(rdfs:seeAlso goldbook:13539 goldbook:13745)
AnnotationAssertion(mito:isMentionedBy goldbook:13539 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13539 "current"^^xsd:string)
