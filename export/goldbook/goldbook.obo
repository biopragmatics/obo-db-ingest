name: coherent structure
def: "If the net of an ordered adsorbed phase is in registry with the lattice of the adsorbent the structure is called coherent\, if not it is called incoherent."
property_value: mito:isMentionedBy doi:10.1351/pac197646010071
property_value: hasStatus "current" xsd:string
