AnnotationAssertion(obo:goldbook#hasStatus goldbook:13542 "current"^^xsd:string)
Declaration(Class(goldbook:13543))
AnnotationAssertion(rdfs:label goldbook:13543 "pattern recognition receptor")
AnnotationAssertion(dcterms:description goldbook:13543 "Receptor found on many different cell types in the immune system that enables them to recognize pathogen-associated molecular patterns (PAMPs). Amongst the large number of different PRRs are the mannose receptor (CD206), macrophage scavenger receptor (CD204), and the toll-like receptors (TLRs).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13543 "PRR")
AnnotationAssertion(rdfs:comment goldbook:13543 "Many of the NOD-like receptors (NLRs) are thought to serve as PRRs."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13543 goldbook:13494)
AnnotationAssertion(rdfs:seeAlso goldbook:13543 goldbook:13271)
AnnotationAssertion(rdfs:seeAlso goldbook:13543 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13543 goldbook:13542)
AnnotationAssertion(rdfs:seeAlso goldbook:13543 goldbook:13747)
AnnotationAssertion(mito:isMentionedBy goldbook:13543 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13543 "current"^^xsd:string)
Declaration(Class(goldbook:13544))
AnnotationAssertion(rdfs:label goldbook:13544 "pauci-immune")
AnnotationAssertion(dcterms:description goldbook:13544 "Referring to vasculitis characterized by relatively little deposition of immunoglobulin (Ig) and complement factors, usually describing a form of glomerulonephritis.")
AnnotationAssertion(rdfs:seeAlso goldbook:13544 goldbook:13174)
AnnotationAssertion(rdfs:seeAlso goldbook:13544 goldbook:13776)
AnnotationAssertion(mito:isMentionedBy goldbook:13544 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13544 "current"^^xsd:string)
Declaration(Class(goldbook:13545))
AnnotationAssertion(rdfs:label goldbook:13545 "pemphigus")
AnnotationAssertion(dcterms:description goldbook:13545 "Rare, serious autoimmune disease marked by successive outbreaks of blisters, which appear suddenly and disappear, leaving pigmented spots.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13545 "pemphigus vulgaris")
AnnotationAssertion(rdfs:comment goldbook:13545 "Other mucous membranes, as well as the skin, are usually affected and the disease may be fatal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13545 goldbook:12919)
AnnotationAssertion(mito:isMentionedBy goldbook:13545 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13545 "current"^^xsd:string)
Declaration(Class(goldbook:13546))
AnnotationAssertion(rdfs:label goldbook:13546 "peptide tetramer")
AnnotationAssertion(dcterms:description goldbook:13546 "Structure consisting of four identical major histocompatibility complex (MHC)-encoded peptides, presenting four binding sites for biotin attached to the tail of the MHC molecule, and held together by fluorescent streptavidin.")
AnnotationAssertion(rdfs:seeAlso goldbook:13546 goldbook:13430)
AnnotationAssertion(mito:isMentionedBy goldbook:13546 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13546 "current"^^xsd:string)
