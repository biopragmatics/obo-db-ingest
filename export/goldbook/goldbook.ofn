AnnotationAssertion(mito:isMentionedBy goldbook:11804 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11804 "current"^^xsd:string)
Declaration(Class(goldbook:11805))
AnnotationAssertion(rdfs:label goldbook:11805 "dominant hemisphere")
AnnotationAssertion(dcterms:description goldbook:11805 "Cerebralhemisphere containing the representation of speech and controlling arm and leg preference in skilled movements.")
AnnotationAssertion(rdfs:comment goldbook:11805 "Usually the left hemisphere."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11805 goldbook:11671)
AnnotationAssertion(mito:isMentionedBy goldbook:11805 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11805 "current"^^xsd:string)
