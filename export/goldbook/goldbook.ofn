Declaration(Class(goldbook:11315))
AnnotationAssertion(rdfs:label goldbook:11315 "transposition of the great arteries")
AnnotationAssertion(dcterms:description goldbook:11315 "Congenital cardiovascular malformation in which the position of the chief blood vessels of the heart (aorta and pulmonary artery) is reversed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11315 "transposition of the great vessels")
AnnotationAssertion(rdfs:comment goldbook:11315 "Survival then depends on a crossflow of blood between the right and left sides of the heart, as through a ventricular septal defect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11315 goldbook:10552)
AnnotationAssertion(rdfs:seeAlso goldbook:11315 goldbook:10416)
AnnotationAssertion(rdfs:seeAlso goldbook:11315 goldbook:10549)
AnnotationAssertion(rdfs:seeAlso goldbook:11315 goldbook:10914)
AnnotationAssertion(rdfs:seeAlso goldbook:11315 goldbook:11157)
AnnotationAssertion(rdfs:seeAlso goldbook:11315 goldbook:11365)
