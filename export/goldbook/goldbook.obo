[Term]
id: goldbook:C01175
name: colloidal electrolyte
def: "An electrolyte which gives ions of which at least one is of colloidal size. This term therefore includes hydrophobic sols\, ionic association colloids\, and polyelectrolytes."
property_value: mito:isMentionedBy doi:10.1351/pac197231040577
property_value: hasStatus "current" xsd:string
