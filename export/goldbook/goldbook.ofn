AnnotationAssertion(dcterms:description goldbook:11807 "Procedure using birds to study acute and delayed neurotoxicity, notably of organophosphates.")
AnnotationAssertion(rdfs:comment goldbook:11807 "After exposure to the substance, the birds are closely observed with regard to motor activity, gait changes, motor coordination, and related parameters."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11807 goldbook:11883)
AnnotationAssertion(rdfs:seeAlso goldbook:11807 goldbook:11884)
