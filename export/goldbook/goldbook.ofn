AnnotationAssertion(rdfs:label goldbook:R05416 "rotaxanes")
AnnotationAssertion(dcterms:description goldbook:R05416 "Molecules in which a ring encloses another, rod-like molecule having end groups too large to pass through the ring opening, and thus holds the rod-like molecule in position without covalent bonding.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05416 goldbook:C00904)
AnnotationAssertion(mito:isMentionedBy goldbook:R05416 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05416 "current"^^xsd:string)
Declaration(Class(goldbook:R05417))
AnnotationAssertion(rdfs:label goldbook:R05417 "rotenoids")
AnnotationAssertion(dcterms:description goldbook:R05417 "Naturally occurring substances containing a cis-fused tetrahydrochromeno[3,4-b]chromene nucleus. Many rotenoids contain an additional ring, e.g rotenone:")
AnnotationAssertion(rdfs:seeAlso goldbook:R05417 goldbook:N04256)
AnnotationAssertion(mito:isMentionedBy goldbook:R05417 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05417 "current"^^xsd:string)
Declaration(Class(goldbook:R05418))
AnnotationAssertion(rdfs:label goldbook:R05418 "rotometer")
AnnotationAssertion(dcterms:description goldbook:R05418 "A device, based on Stokes law, for measuring rate of fluid flow. It is a tapered vertical tube having a circular cross-section in which a float moves in a vertical path to a height dependent upon the rate of fluid flow upward through the tube.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05418 goldbook:S06028)
AnnotationAssertion(mito:isMentionedBy goldbook:R05418 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05418 "current"^^xsd:string)
Declaration(Class(goldbook:R05419))
AnnotationAssertion(rdfs:label goldbook:R05419 "roughness factor")
AnnotationAssertion(dcterms:description goldbook:R05419 "The ratio: \\[f_{\\rm{r}}=\\frac{A_{\\rm{r}}}{A_{\\rm{g}}}\\] where \\(A_{\\rm{r}}\\) is the real (true, actual) surface (interface) area and \\(A_{\\rm{g}}\\) is the geometric surface (interface) area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:R05419 "rugosity")
AnnotationAssertion(rdfs:seeAlso goldbook:R05419 goldbook:E02282)
