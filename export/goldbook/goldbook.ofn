AnnotationAssertion(obo:goldbook#hasStatus goldbook:13361 "current"^^xsd:string)
Declaration(Class(goldbook:13362))
AnnotationAssertion(rdfs:label goldbook:13362 "killer cell immunoglobulin-like receptor")
AnnotationAssertion(dcterms:description goldbook:13362 "Receptor expressed on natural killer (NK) cells that binds to major histocompatibility complex (MHC) class I molecules on target cells; binding MHC class I inhibits the signaling that would otherwise lead to target cell killing.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13362 "KIR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13362 "killer inhibitory receptor")
AnnotationAssertion(rdfs:comment goldbook:13362 "If immunoreceptor tyrosine-based inhibitory motif (ITIM) sequences are present in the KIR cytoplasmic domain, MHC class I molecule binding is inhibitory to the killer cell. KIRs lacking ITIMs can associate with immunoreceptor tyrosine-based activation motif (ITAM)-containing adaptor molecules, in which case binding of MHC class I molecules can activate the killer cell."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13362 goldbook:13313)
AnnotationAssertion(rdfs:seeAlso goldbook:13362 goldbook:13314)
