    <!-- http://dx.doi.org/10.1351/goldbook.15528 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15528">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Material that enhances or maintains the cleaning efficiency of a surfactant, in a detergent, principally by inactivating water hardness; complex phosphates (especially sodium tripolyphosphate, i.e., pentasodium triphosphate), sodium carbonate, and sodium silicate are the builders most commonly used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>builder</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15529 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15529">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pneumoconiosis caused by inhalation of dust and associated microbial contaminants and observed in cotton, flax, and hemp workers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>byssinosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15984"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15530 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15530">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Liability of members of the general public to come in contact with substances arising from operations or processes carried out by other individuals in their vicinity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bystander exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15531 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15531">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Imagined perception of vile odors, including coprosmia (smelling feces) and necrosmia (the smell of death).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cacosmia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15532 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15532">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of mineralization in which organic tissue becomes hardened by deposition of calcium salts within its substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>calcification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15533 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15533">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound that is formed between carbon monoxide and hemoglobin in the blood of animals and humans and is incapable of transporting oxygen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>carboxyhemoglobin</oboInOwl:hasRelatedSynonym>
        <rdfs:label>carbonylhemoglobin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15534 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15534">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Long-term (chronic) test designed to detect any possible carcinogenic effect of a test substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>carcinogenicity test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15535 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15535">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemically harmful to the cells of the heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cardiotoxic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15536 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15536">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound that contains a temporary linkage between a given active substance and a transient carrier group, the latter producing improved physicochemical or pharmacokinetic properties and easily removable in vivo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>carrier prodrug</oboInOwl:hasRelatedSynonym>
        <rdfs:label>carrier-linked prodrug</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15537 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15537">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that binds to another substance and transfers it from one site to another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>carrier substance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15538 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15538">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variant of the case control study in which the controls are drawn from the same cohort as the cases but are identified before the cases develop; some of the controls may later become cases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>case cohort study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15539"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15539 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15539">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study that starts with the identification of persons with the disease (or other outcome variable) of interest, and a suitable control (comparison, reference) group of persons without the disease. The relationship of an attribute to the disease is examined by comparing the diseased and non-diseased with regard to how frequently the attribute is present or, if quantitative, the levels of the attribute, in the two groups.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>case comparison study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>case compeer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>case history study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>case referent study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retrospective study</oboInOwl:hasRelatedSynonym>
        <rdfs:label>case control study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15540 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15540">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Behavior marked by excessive and sometimes violent motor activity and excitement, or by generalized inhibition or stupor, that may occur in schizophrenia, mood disorders, or organic brain syndromes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>catatonia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15541 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15541">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regulated biochemical steps that cells go through involving DNA replication and cell division, usually depicted as a sequential cyclical series of events.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cell cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15542 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15542">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State in which an individual reacts with allergic effects caused by the reaction of antigen-specific T-lymphocytes following exposure to a certain substance (allergen) after having been exposed previously to the same substance or chemical group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cell-mediated hypersensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15543 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15543">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rapid increase in cell number.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cell proliferation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15544 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15544">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cells having specific properties or markers derived from a primary culture or cell line.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cell strain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15545 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15545">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sample observations for which the complete distribution is not known.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>censored data</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15546 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15546">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reference material, accompanied by documentation issued by an authoritative body and referring to valid procedures used to obtain a specified property value with uncertainty and traceability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>CRM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>certified reference material</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16177"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15546"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15547 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15547">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of responsibility for a substance from the manufacturer to the distributor, to the user, or to the person(s) ultimately responsible for waste disposal. This term is also used in controlled transmission of samples from collection to analysis, especially of samples of materials used for medico-legal or forensic purposes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chain of custody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15548 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15548">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Treatment with a chelating agent to enhance the elimination or reduce the toxicity of a metal ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chelation therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15549 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15549">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sensations that arise when chemical compounds activate receptor mechanisms for other effectors, such as light, pain, pressure, and heat, in the eye, skin, nose, mouth, and throat; for example, the burning feeling from chili pepper, the cooling from the menthol in mouthwash, and the stinging feeling of carbonation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chemesthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15550 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15550">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change from one chemical species to another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>conversion</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chemical conversion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15551 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15551">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Practical certainty that there will be no exposure of organisms to toxic amounts of any substance or group of substances: This implies attaining an acceptably low risk of exposure to potentially toxic substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chemical safety</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15552 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15552">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Military operations using the toxic properties of chemical agents to kill, injure, or incapacitate human beings, animals, or plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chemical warfare</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15553 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15553">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Irrational fear of chemicals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chemophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15554 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15554">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemically induced swelling around the eye caused by edema of the conjunctiva.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chemosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15555 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15555">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to sterilize mites, insects, rodents, or other animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chemosteriliser</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15556 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15556">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that inhibits the action of acetylcholinesterase (EC 3.1.1.7) and related enzymes which catalyze the hydrolysis of choline esters: Such a substance causes hyperactivity in parasympathetic nerves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>anticholinesterase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cholinesterase inhibitor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15961"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15557 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15557">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stainable complex of DNA and proteins present in the nucleus of a eukaryotic cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chromatin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15685"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15558 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15558">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormality of chromosome number or structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chromosomal aberration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15559 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15559">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study in which organisms are observed during the greater part of the life span and in which exposure to the test agent takes place over the whole observation time or a substantial part thereof.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>long-term toxicity test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chronic toxicity test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15445"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15560 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15560">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the influence of biological rhythms on the toxicity of substances or of the influence of a toxicant on biological rhythms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>chronotoxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15561 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15561">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serious illness caused by eating carnivorous fish such as snappers and barracuda that have become contaminated by toxins produced by the microalga, Gambierdiscus toxicus; gastrointestinal symptoms may accompany a wide variety of neurological symptoms, including ataxia, vertigo, flaccid paralysis, respiratory arrest, and reversed perception of hot and cold; the neurological symptoms may persist for many years.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ciguateratoxin poisoning</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15562 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15562">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to or exhibiting an approximately \(\pu{24\!\mbox{-}h}\) periodicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>nychthemeral</oboInOwl:hasRelatedSynonym>
        <rdfs:label>circadian</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15563 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15563">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of xenobiotic substances in the environment with air flow, river current, sediment flow, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>circulation of substances</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15564 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15564">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Liver disease defined by histological examination and characterized by increased fibrous tissue, abnormal morphological and physiological changes such as loss of functional liver cells, and increased resistance to blood flow through the liver (portal hypertension). Chronic interstitial inflammation and fibrosis of an organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cirrhosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15711"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15796"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15565 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15565">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing an organ showing cirrhosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cirrhotic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15564"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15566 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15566">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation (or generation) of chromosomal breaks and (or) consequent gain, loss, or rearrangement of pieces of chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>clastogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15567 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15567">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scientific study involving research, education, prevention, and treatment of diseases caused by substances such as drugs and toxins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Often refers specifically to the application of toxicological principles to the treatment of human poisoning.</rdfs:comment>
        <rdfs:label>clinical toxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15568 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15568">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to alternate muscular contraction and relaxation in rapid succession.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>clonic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15569 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15569">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method of sampling in which the population is divided into aggregates (or clusters) of items bound together in a certain manner. A sample of these clusters is taken at random, and all the items which constitute them are included in the sample. A sampling method in which each unit selected is a group of persons (all persons in a city block, a family, etc.) rather than an individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cluster sampling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15570 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15570">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical, physical, or biological factor that intensifies the effect of a carcinogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cocarcinogen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15571 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15571">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of internationally adopted food standards drawn up by the Codex Alimentarius Commission, the principal body implementing the joint FAO/WHO Food Standards Program.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>Codex Alimentarius</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15572 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15572">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of the population born during a particular period and identified by period of birth so that its characteristics (such as causes of death and numbers still living) can be ascertained as it enters successive time and age periods. The term &apos;cohort&apos; has broadened to describe any designated group of persons followed or traced over a period of time, as in the term cohort study (prospective study).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cohort</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15574"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15573 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15573">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tabulation and analysis of morbidity or mortality rates in relationship to the ages of a specific group of people (cohort), identified by their birth period, and followed as they pass through different ages during part or all of their life span. In certain circumstances such as studies of migrant populations, cohort analysis may be performed according to duration of residence in a country rather than year of birth, in order to relate health or mortality experience to duration of exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cohort analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15893"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15574 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15574">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Analytic study in epidemiology in which subsets of a defined population can be identified who are, have been, or in the future may be exposed or not exposed, or exposed in different degrees, to a factor or factors hypothesized to influence the probability of occurrence of a given disease or other outcome. The main feature of the method is observation of a large population for a prolonged period (years), with comparison of incidence rates of the given disease in groups that differ in exposure levels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>concurrent study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>follow-up study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>incidence study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>longitudinal study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prospective study</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cohort study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15809"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15575 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15575">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simultaneous or successive effect of two or more poisons on the organism by the same route of exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>combined effect of poisons</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15576 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15576">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Means of measuring DNA damage, particularly DNA strand breaks. A cell is embedded in agar and exposed to a DNA-damaging agent. The cell is then permeabilized with a detergent, and an electric field is applied. If the cell’s genomic DNA has been broken into small fragments, these fragments move out of the cell by electrophoresis and form a streak or &apos;tail&apos; leading away from the cell which looks like a comet.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>comet assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15577 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15577">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the relationship of genome structure and function across different biological species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>comparative genomics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15578 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15578">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Separate into compartments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>compartmentalise</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15579 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15579">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In the context of European Community Council Directive 79/831/EEC, the Sixth Amendment to the European Community Council Directive 67/548/EEC relating to the Classification, Packaging and Labeling of Dangerous Substances, official government organization or group receiving and evaluating notifications of new substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>competent authority</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15580 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15580">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Culture of bacteria (or yeast) treated in such a way that their ability to take up DNA molecules without transduction or conjugation has been enhanced.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>competent bacteria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15581 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15581">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete breakdown of a complex organic compound to carbon dioxide, water, oxides, and oxidative inorganic products such as nitrate or sulfate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>complete mineralisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15582 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15582">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simultaneous or successive effect made on an organism by poisons entering from different media, air, water, or food or through the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>comprehensive effect of poisons</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15583 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15583">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of mathematical and computer models to predict adverse effects and to better understand the mechanism(s) through which a given chemical causes harm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>computational toxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15584 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15584">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graph of the relation between exposure concentration and the magnitude of the resultant biological change.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>exposure–effect curve</oboInOwl:hasRelatedSynonym>
        <rdfs:label>concentration–effect curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15681"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15585 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15585">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Association between exposure concentration and the resultant magnitude of the continuously graded change produced, either in an individual or in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>exposure–effect relationship</oboInOwl:hasRelatedSynonym>
        <rdfs:label>concentration–effect relationship</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15681"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15586 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15586">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurement and its criterion refer to the same point in time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>concurrent validity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15587 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15587">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Situation in which the effects of two processes are not distinguishable from one another: The distortion of the apparent effect of an exposure on risk brought about by the association of other factors which can influence the outcome. Relationship between the effects of two or more causal factors as observed in a set of data, such that it is not logically possible to separate the contribution which any single causal factor has made to an effect. Situation in which a measure of the effect of an exposure on risk is distorted because of the association of exposure with other factor(s) which influence the outcome under study.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>confounding</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15588 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15588">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Changing factor that can cause or prevent the outcome of interest, is not an intermediate variable, and is associated with the factor under investigation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>confounder</oboInOwl:hasRelatedSynonym>
        <rdfs:label>confounding variable</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15589 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15589">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mucous membrane that covers the eyeball and lines the under-surface of the eyelid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>conjunctiva</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15590 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15590">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the conjunctiva.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>conjunctivitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15589"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15591 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15591">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assessment of risk that assumes the worst possible case scenario and therefore gives the highest possible value for risk: Risk management decisions based on this value will maximize safety.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>conservative assessment of risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15592 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15592">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extent to which a measurement corresponds to theoretical concepts (constructs) concerning the phenomenon under study; for example, if on theoretical grounds, the phenomenon should change with age, a measurement with construct validity would reflect such a change.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>construct validity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15593 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15593">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical that injures the target organism through physical contact and skin absorption rather than through ingestion or inhalation. Pesticide (herbicide) that causes injury to only the plant tissue to which it is applied or which is not appreciably translocated within plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>contact poison</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15774"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15594 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15594">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which possible release, discharge, or spill of a toxic substance during normal use or after an accident is prevented by appropriate action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>containment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15595 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15595">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extent to which the measurement incorporates the domain of the phenomenon under study; for example, a measurement of functional health status should embrace activities of daily living, occupational, family, and social functioning, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>content validity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15596 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15596">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any condition that renders some particular line of treatment improper or undesirable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>contraindication</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15597 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15597">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Selected subjects of study, identified as a rule before a study is done, which comprises humans, animals, or other species who do not have the disease, intervention, procedure, or whatever is being studied, but in all other respects are as nearly identical to the test group as possible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>comparison group</oboInOwl:hasRelatedSynonym>
        <rdfs:label>control group</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15598 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15598">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Control (individual or group or case) selected to be similar to a study individual or group, or case, in specific characteristics: some commonly used matching variables are age, sex, race, and socioeconomic status.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>matched control</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15599 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15599">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quality rating, based on standard evaluation criteria established by the U.S. Office of Pesticide Programs regulatory agencies, given to toxicological studies after submission by registrants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>core grade</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15600 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15600">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mean of the diameters of all particles in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>count mean diameter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15866"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15601 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15601">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated diameter in a population of particles in a gas or liquid phase above which there are as many particles with larger diameters as there are particles below it with smaller diameters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>count median diameter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15867"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15602 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15602">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal respiratory sounds heard on auscultation of the chest, produced by passage of air through passages which contain secretion or exudate or which are constricted by spasm or a thickening of their walls.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>crackles</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>râles</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Auscultation is the process of listening for sounds within the body by ear unassisted or using a stethoscope.</rdfs:comment>
        <rdfs:label>crepitations</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16058"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15603 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15603">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Validated set of data used as a basis for judgment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>criterion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15604 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15604">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extent to which the measurement correlates with an external criterion of the phenomenon under study.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>criterion validity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15605 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15605">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance at and above which adverse functional changes, reversible or irreversible, occur in a cell or an organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>critical concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15606 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15606">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose of a substance at and above which adverse functional changes, reversible or irreversible, occur in a cell or an organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>critical dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15607 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15607">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For deterministic effects, the first adverse effect that appears when the threshold (critical) concentration or dose is reached in the critical organ: Adverse effects with no defined threshold concentration are regarded as critical.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>critical effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15605"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15610"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15608 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15608">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxic effect used by the USEPA as the basis for a reference dose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>critical end-point</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15609 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15609">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of a target population most in need of protection because it is most susceptible to a given toxicant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>critical group</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16119"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15610 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15610">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organ that first attains the critical concentration of a substance and exhibits the critical effect under specified circumstances of exposure and for a given population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>critical organ</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15605"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15607"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15611 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15611">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mean concentration of a substance in the critical organ at the time the substance reaches its critical concentration in the most sensitive type of cell in the organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>critical organ concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15605"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15610"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15612 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15612">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study that examines the relationship between diseases (or other health-related characteristics) and other variables of interest as they exist in a defined population at one particular time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>disease frequency survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prevalence study</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Disease prevalence rather than incidence is normally recorded in a cross-sectional study and the temporal sequence of cause and effect cannot necessarily be determined.</rdfs:comment>
        <rdfs:label>cross-sectional study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15613 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15613">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportion of a defined group that dies within the specified time period (e.g., month, year).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>It may refer to all deaths or to deaths from a specific cause or specific causes.</rdfs:comment>
        <rdfs:label>cumulative death rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16098"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15614 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15614">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Overall change that occurs after repeated doses of a substance or radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cumulative effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15615 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15615">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number or proportion of individuals in a group who experience the onset of a health-related event during a specified time interval.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>incidence proportion</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This interval is generally the same for all members of the group, but, as in lifetime incidence, it may vary from person to person without reference to age.</rdfs:comment>
        <rdfs:label>cumulative incidence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15616 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15616">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportion of the cumulative incidence to the total population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cumulative incidence rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15615"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15617 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15617">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value obtained by dividing the cumulative incidence rate in the exposed population by the cumulative incidence rate in the unexposed population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cumulative incidence ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15616"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15618 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15618">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the total administered amount of a substance that is associated with the death of half a population of animals when the substance is administered repeatedly in doses which are generally fractions of the median lethal dose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cumulative median lethal dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15619 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15619">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability of a common harmful effect associated with concurrent exposure by all relevant pathways and routes of exposure to a group of substances that share a common chemical mechanism of toxicity. Total probability of a harmful effect over time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cumulative risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15620 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15620">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxin produced by Cyanobacteria, sometimes called blue–green algae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cyanotoxin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15621 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15621">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substances, such as aspirin and ibuprofen, that block the activity of cyclooxygenase (COX), an enzyme that is responsible for the formation of prostanoids (including prostaglandins, prostacyclin, and thromboxane); inhibition of COX can provide relief from inflammation and pain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cyclooxygenase specific inhibitors</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15622 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15622">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inactive derivative of cytochrome P450 found in microsomal preparations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cytochrome P420</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15623 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15623">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Obsolete term for cytochrome P450 I, A1, and A2, one of the major families of the cytochromes P450 hemoproteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>During the monooxygenation of certain substances, often a detoxification process, these iso-enzymes may produce intermediates which can initiate mutations, cancer, immunotoxic reactions, and adverse effects.</rdfs:comment>
        <rdfs:label>cytochrome P448</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15624 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15624">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fundamental substance or matrix of the cell (within the plasma membrane) which surrounds the nucleus, endoplasmic reticulum, mitochondria, and other organelles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>cytoplasm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15662"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15890"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15953"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15625 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15625">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unit of perceived air quality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>decipol</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15626 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15626">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Explicit pathophysiological changes following compensation for adverse effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>decompensation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15627 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15627">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of rendering harmless (by neutralization, elimination, removal, etc.) a potentially toxic substance in the natural environment, laboratory areas, the workplace, other indoor areas, clothes, food, water, sewage, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>decontamination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15628 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15628">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that catalyzes oxidation of compounds by removing hydrogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>dehydrogenase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15629 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15629">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consequence occurring after a latent period following the end of exposure to a toxic substance or other harmful environmental factor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>latent effect</oboInOwl:hasRelatedSynonym>
        <rdfs:label>delayed effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15630 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15630">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tooth enamel malformations due to excessive fluoride exposure during dental development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>dental fluorosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15631 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15631">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Replication of DNA sequences ligated into a suitable vector in an appropriate host organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>DNA cloning</oboInOwl:hasRelatedSynonym>
        <rdfs:label>deoxyribonucleic acid cloning</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15632 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15632">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Restoration of the molecular structure of DNA after it has been damaged by a chemical or physical agent: This may involve direct DNA damage reversal, base excision repair, nucleotide excision repair, mismatch repair, or double-strand break repair</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>DNA repair</oboInOwl:hasRelatedSynonym>
        <rdfs:label>deoxyribonucleic acid repair</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15633 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15633">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A psychic craving for a drug or other substance that may or may not be accompanied by a physical dependency. Reliance on a drug or other substance to maintain health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>dependence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15634 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15634">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance causing loss of hair.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>depilatory</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15635 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15635">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>cutaneous</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dermal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15636 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15636">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin reaction resulting from a single or multiple exposure to a physical or chemical entity at the same site, characterized by the presence of inflammation; it may result in cell death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>dermal irritation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15637 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15637">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the occurrence of disease or other health-related characteristics in populations, including general observations concerning the relationship of disease to basic characteristics such as age, sex, race, occupation, and social class; it may also be concerned with geographic location. The major characteristics in descriptive epidemiology can be classified under the headings: individuals, time, and place.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>descriptive epidemiology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15638 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15638">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Shedding of an outer layer of skin in scales or shreds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>desquamation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15639 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15639">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimated measure of the expected harm or loss associated with an adverse event, usually in a manner chosen to facilitate meaningful addition over different events. It is generally the integrated product of arbitrary values of risk and hazard and is often expressed in terms such as costs in U.S. dollars, loss in expected years of life or loss in productivity, and is needed for numerical exercises such as cost-benefit analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>detriment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15448"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15640 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15640">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects on the developing organism (including structural abnormality, altered growth, or functional deficiency or death) resulting from exposure through conception, gestation (including organogenesis), and postnatally up to the time of sexual maturation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>developmental toxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15641 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15641">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Profuse perspiration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>diaphoresis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15642 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15642">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum amount of a pollutant released from a given source to a specified medium which is acceptable under specified circumstances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>discharge release limit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>effluent standard</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>emission standard</oboInOwl:hasRelatedSynonym>
        <rdfs:label>discharge standard</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15643 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15643">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any difference in a character between individuals due to genetic differences such as may occur in dizygotic twins, or between matched pairs in a case cohort study.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>genetic discordance</oboInOwl:hasRelatedSynonym>
        <rdfs:label>discordance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15538"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15644 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15644">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Literally, dis-ease, lack of ease; pathological condition that presents a group of symptoms peculiar to it and which establishes the condition as an abnormal entity different from other normal or pathological body states.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15645 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15645">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Natural tendency shown by an individual or group of individuals, including any tendency to acquisition of specific diseases, often due to hereditary factors. Total of the processes of absorption of a chemical into the circulatory systems, distribution throughout the body, biotransformation, and excretion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>disposition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15646 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15646">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reduction in the amount of a pesticide or other compound that has been applied to plants, soil, etc. (used when it is not clear whether this is by mineralization degradation, binding, or leaching).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>dissipation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15647 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15647">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theoretical volume of a body compartment throughout which a substance is calculated to be distributed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>distribution volume</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15648 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15648">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excretion of urine, especially in excess.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>diuresis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15649 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15649">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that increases urine production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>micturitic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>diuretic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15650 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15650">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Half life of a fraction of a substance in a specific organ or compartment if it defines approximately the overall clearance rate for that substance at a specific time point.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>dominant half life</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15651 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15651">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genetic change occurring in a germ cell that does not cause dysfunction of the gamete but which is lethal to the fertilized egg or developing embryo which develops from it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Induction of a dominant lethal event after exposure to a chemical substance (dominant lethal test) indicates that the substance has affected germinal tissue of the test species.</rdfs:comment>
        <rdfs:label>dominant lethal mutation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15652 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15652">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study in which test persons consume their ordinary diet but, for each meal, they prepare for subsequent analysis a duplicate portion of all food as prepared, served, and consumed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>duplicate diet study</oboInOwl:hasRelatedSynonym>
        <rdfs:label>duplicate portion sampling method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15653 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15653">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two samples taken under the same or comparable conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>duplicate samples</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16045"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15654 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15654">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal, impaired, or incomplete functioning of an organism, organ, tissue, or cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>dysfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15655 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15655">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill parasites living on the exterior of the host.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ectoparasiticide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15656 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15656">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period taken for the plasma concentration of a substance to decrease by half.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>elimination half time</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>May also be applied to other body compartments such as blood, specific organs, or tissues.</rdfs:comment>
        <rdfs:label>elimination half life</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15657 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15657">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that contributes to the elimination of a poison from an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>eliminator</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15658 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15658">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production by a substance of toxic effects in progeny in the first period of pregnancy between conception and the fetal stage. Any toxic effect on the conceptus as a result of prenatal exposure during the embryonic stages of development: These effects may include malformations and variations, malfunctions, altered growth, prenatal death, and altered postnatal function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>embryotoxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15659 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15659">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in the embryo and the regulation of its development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>embryotropic effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15660 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15660">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technical and administrative procedures and specifications applied for the monitoring, reduction, or elimination of emissions from a source or exposure to a target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>emission and exposure control</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15661 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15661">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of a conjugated metabolite that is derived from a natural product (such as a sugar, amino acid, or other organic acid) of the metabolizing organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>endocon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15662 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15662">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intracellular complex of membranes in which proteins and lipids, as well as molecules for export, are synthesized and in which the biotransformation reactions of the monooxygenase enzyme systems occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>May be isolated as microsomes following cell fractionation procedures.</rdfs:comment>
        <rdfs:label>endoplasmic reticulum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15663 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15663">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the layer of flat cells lining the inner surface of blood and lymphatic vessels, and the surface lining of serous and synovial membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>endothelial</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15664 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15664">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intestinal inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>enteritis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15665 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15665">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cyclical process involving intestinal reabsorption of a substance that has been excreted through the bile, followed by transfer back to the liver, making it available for biliary excretion again.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>enterohepatic circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15666 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15666">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aggregate, at a given moment, of all external conditions and influences to which a system under study is subjected.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>environment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15667 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15667">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects to the natural environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>environmental damage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15668 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15668">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Level (concentration or amount or a time integral of either) of a substance to which an organism or other component of the environment is exposed in its natural surroundings.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EEL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>environmental exposure level</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15668"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15669 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15669">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Human welfare and its influence by the environment, including technical and administrative measures for improving the human environment from a health point of view.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>environmental health</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15670 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15670">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the adverse effects to health or risks likely to follow from a proposed or expected environmental change or development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>environmental health impact assessment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15671 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15671">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Critical publications of IPCS containing reviews of methodologies and existing knowledge—expressed, if possible, in quantitative terms—of selected substances (or groups of substances) on identifiable, immediate, and long-term effects on human health and welfare.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>environmental health criteria documents</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15672 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15672">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Practical control measures used to improve the basic environmental conditions affecting human health, for example, clean water supply, human and animal waste disposal, protection of food from biological contamination, and housing conditions, all of which are concerned with the quality of the human environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>environmental sanitation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>environmental hygiene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15673 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15673">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specialty devoted to the prevention and management of environmentally induced injury, illness, and disability, and the promotion of the health of individuals, families, and communities by ensuring a healthy environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>environmental medicine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15674 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15674">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Actions taken to prevent or minimize adverse effects to the natural environment. Complex of measures including monitoring of environmental pollution, development and practice of environmental protection principles (legal, technical, and hygienic), including risk assessment, risk management, and risk communication.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>environmental protection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16061"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15675 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15675">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the upper-middle region of the abdomen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>epigastric</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15676 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15676">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurring in severe or sudden spasms, as in convulsion or epilepsy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>epileptiform</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15677 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15677">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any tumor derived from epithelium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>epithelioma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15678 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15678">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Slough or dry scab on an area of skin that has been burnt.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>eschar</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15679 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15679">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prediction of the daily intake of a residue of a potentially harmful agent based on the most realistic estimation of the residue levels in food and the best available food consumption data for a specific population: Residue levels are estimated taking into account known uses of the agent, the range of contaminated commodities, the proportion of a commodity treated, and the quantity of home-grown or imported commodities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EDI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The EDI is expressed in \(\pu{mg}\) residue per person.</rdfs:comment>
        <rdfs:label>estimated daily intake</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15820"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15679"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15680 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15680">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Predicted concentration of a substance, typically a pesticide, within an environmental compartment based on estimates of quantities released, discharge patterns, and inherent disposition of the substance (fate and distribution) as well as the nature of the specific receiving ecosystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EEC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>predicted exposure concentration (PEC)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>estimated environmental concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15693"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15680"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15681 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15681">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measured or calculated amount or mass concentration of a substance to which an organism is likely to be exposed, considering exposure by all sources and routes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EEC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>estimated exposure concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15681"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15682 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15682">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measured or calculated dose of a substance to which an organism is likely to be exposed, considering exposure by all sources and routes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EED</oboInOwl:hasRelatedSynonym>
        <rdfs:label>estimated exposure dose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15682"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EED</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15683 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15683">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prediction of the maximum daily intake of a residue of a potentially harmful agent based on assumptions of average food consumption per person and maximum residues in the edible portion of a commodity, corrected for the reduction or increase in residues resulting from preparation, cooking, or commercial processing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EMDI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The EMDI is expressed in \(\pu{mg}\) residue per person.</rdfs:comment>
        <rdfs:label>estimated maximum daily intake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15683"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EMDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15684 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15684">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science dealing with the cause or origin of disease. In individuals, the cause or origin of disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>aetiology</oboInOwl:hasRelatedSynonym>
        <rdfs:label>etiology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15685 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15685">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell or organism with the genetic material packed in a membrane-surrounded structurally discrete nucleus and with well-developed cell organelles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The term includes all organisms except archaebacteria, eubacteria, and cyanobacteria (until recently classified as cyanophyta or blue–green algae).</rdfs:comment>
        <rdfs:label>eukaryote</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16009"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15686 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15686">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>List of all substances supplied either singly or as components in preparations to persons in a Member State of the European Community on any occasion between 1 January 1971 and 18 September 1981.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EINECS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>European Inventory of Existing Chemical Substances</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15686"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EINECS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15687 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15687">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Additional or excess risk incurred over the lifetime of an individual by exposure to a toxic substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>excess lifetime risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15688 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15688">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of active artificial elimination of toxicity consisting in complete replacement of blood of the patient by donor blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>blood substitution</oboInOwl:hasRelatedSynonym>
        <rdfs:label>exchange transfusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15689 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15689">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of substance and (or) its metabolites that is excreted divided by time of excretion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>excretion rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15690 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15690">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of a conjugated metabolite that is derived from the parent molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exocon</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15691 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15691">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Resulting from causes or derived from materials external to an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exogenous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15692 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15692">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Layer of flattened epithelial cells external to an organ or tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exothelium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15693 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15693">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated concentrations of a substance, typically a pesticide, in various environmental compartments based on calculations using maximum-exposure scenarios.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>EEC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>expected exposure concentration (EEC)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>EEC models assume a maximum number of applications per growing season at the maximum rate of application according to the application methods stated on the product label.</rdfs:comment>
        <rdfs:label>expected environmental concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15693"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15694 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15694">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Living tissue removed from its normal environment and transferred to an artificial medium for growth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>explant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15695 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15695">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subject to a factor that is under study in the environment, for instance, an environmental hazard.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exposed</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15696 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15696">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>People (or other organisms) who have been exposed to a supposed cause of a disease or health state of interest, or possess a characteristic that is a determinant of the health outcome of interest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>exposed</oboInOwl:hasRelatedSynonym>
        <rdfs:label>exposed group</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15697 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15697">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>General term defining an administrative substance concentration or intensity of exposure that should not be exceeded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exposure limit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15698 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15698">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a case control study, value obtained by dividing the rate at which persons in the case group are exposed to a risk factor (or to a protective factor) by the rate at which persons in the control group are exposed to the risk factor (or to the protective factor) of interest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exposure ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15539"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15699 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15699">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface on a target where a substance (e.g., a pesticide) is present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exposure surface</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15700 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15700">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of the level, concentration, or uptake of a potentially toxic compound and (or) its metabolite(s) in biological samples from an organism (blood, urine, hair, etc.) and the interpretation of the results to estimate the absorbed dose or degree of environmental pollution; or the measuring of biochemical effects, usually not direct adverse effects of the substance, and relating them to the quantity of substance absorbed, or to its concentration in the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>exposure test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15701 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15701">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generalizability of the results of a particular study, beyond the limits of the population actually studied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>external validity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15702 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15702">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume within a tissue, outside cells, and excluding vascular and lymphatic space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>extracellular space</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15703 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15703">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of fluid outside the cells but within the outer surface of an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>extracellular volume</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15704 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15704">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of substance extracted from a source divided by the total contained within the source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>extraction ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15705 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15705">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability that an agent produces an observed response, as distinguished from the probability that the response is caused by a spontaneous event unrelated to the agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>extra risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15706 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15706">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Refers to a pesticide residue or contaminant arising from environmental sources (including former agricultural uses) other than the use of a pesticide or contaminant substance directly or indirectly on the commodity. It is the maximum concentration of a pesticide residue or contaminant that is recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food, agricultural commodity, or animal feed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>ERL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The mass content is expressed in milligrams of pesticide residue or contaminant per kilogram of commodity.</rdfs:comment>
        <rdfs:label>extraneous residue limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15571"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15706"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ERL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15707 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15707">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involuntary movement disorders mediated by signaling through neurons outside the pyramidal (corticospinal) tract, often describing side effects of psychiatric medications.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>extrapyramidal movement disorders</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15708 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15708">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to conceive and to produce offspring: For litter-bearing species, the number of offspring per litter is used as a measure of fertility.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Reduced fertility is sometimes referred to as subfertility.</rdfs:comment>
        <rdfs:label>fertility</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15709 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15709">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Produces abnormalities of male or female reproductive functions or impairs reproductive capacity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>fertility toxicant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15710 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15710">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxicity to the fetus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>fetotoxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15711 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15711">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal formation of fibrous tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>fibrosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15712 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15712">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of confidence limit given as a stated probability, for example, \(P = \pu{0.95}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>In toxicology, the terms &quot;fiducial limits&quot; and &quot;confidence limits&quot; are generally considered to be synonymous.</rdfs:comment>
        <rdfs:label>fiducial limit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15713 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15713">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical reaction where the initial rate is directly proportional to the concentration of one of the reactants. Any process in which a variable decreases with time at a constant fractional amount.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>first-order reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>first-order chemical reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15714 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15714">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute toxicity test in which a substance is tested initially at a small number (3 or 4) predefined doses to identify which produces evident toxicity without lethality: The test may be repeated at one or more higher or lower defined discriminating doses to satisfy the criteria.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>fixed dose procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15715 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15715">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects of fluoride, as in dental or skeletal fluorosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>fluoridosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fluorosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15716 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15716">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small groups of cells distinguishable, in appearance or histochemically, from the surrounding tissue: indicative of an early stage of a lesion that may lead to the formation of a neoplastic nodule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>foci</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15717 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15717">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any substance, not normally consumed as a food by itself and not normally used as a typical ingredient of a given food, whether or not it has nutritive value, that is added intentionally to food for a technological (including organoleptic) purpose in the manufacture, processing, preparation, treatment, packing, packaging, transport, or holding of the food. Addition results, or may be reasonably expected to result (directly or indirectly), in the substance or its byproducts becoming a component of, or otherwise affecting, the characteristics of the food to which it is added.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The term does not include &quot;contaminants&quot; or substances added to food for maintaining or improving nutritional qualities.</rdfs:comment>
        <rdfs:label>food additive</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15718 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15718">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypersensitivity reaction to substances in the diet to which an individual has previously been sensitized.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>food allergy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15719 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15719">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physiologically based reproducible, unpleasant (adverse) reaction to a specific food or food ingredient that is not immunologically based.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>food intolerance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15720 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15720">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Network of food chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>food web</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15721 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15721">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of stimulating diuresis based on performing hydrational therapy, sometimes with parallel introduction of diuretics, with the aim of achieving increased clearance of a toxic substance in urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>forced diuresis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15722 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15722">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Changes in allelic frequencies that occur when a small group is separated from a large population and establishes a colony in a new location.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>founder effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15723 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15723">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that is vaporized in order to kill or repel pests.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>fumigant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15724 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15724">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance obtained from fungi that has an insecticidal effect reflecting the pathogenicity of the fungi for insects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>fungus preparation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15725 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15725">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill gametes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>gametocide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15726 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15726">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the stomach and intestine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>gastroenteritis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15727 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15727">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to or communicating with the stomach and intestine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>gastrointestinal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15728 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15728">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Administration of materials directly into the stomach by esophageal intubation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>gavage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15729 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15729">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Map showing the positions in the genome of genes or other genetic markers, either relative to each other or as a physical map of absolute distances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>gene map</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15730 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15730">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phrase used to describe the USFDA philosophy that justifies approval of food additives that may not meet the usual test criteria for safety but have been used extensively and have not demonstrated that they cause any harm to consumers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>GRAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>generally regarded as safe</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15730"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15731 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15731">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bacterium, plant, or animal whose DNA has been deliberately altered.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>GMO</oboInOwl:hasRelatedSynonym>
        <rdfs:label>genetically modified organism</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15731"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GMO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15732 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15732">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Existence of inter-individual differences in DNA sequences coding for one specific gene, giving rise to different functional and (or) morphological traits.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>genetic polymorphism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15733 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15733">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Predisposition to a particular disease or sensitivity to a substance due to the presence of a specific allele or combination of alleles in an individual’s genome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>genetic susceptibility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15734 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15734">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of chemically or physically induced changes to the structure of DNA, including epigenetic phenomena or mutations that may or may not be heritable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>genetic toxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15735 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15735">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal grown under sterile conditions in the period of postnatal development: Such animals are usually obtained by Caesarean operation and kept in special sterile boxes in which there are no viable microorganisms (sterile air, food, and water are supplied).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>axenic animal</oboInOwl:hasRelatedSynonym>
        <rdfs:label>germ-free animal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15736 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15736">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete failure of gonad development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>germinal aplasia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15737 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15737">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to a tuft or cluster, as of a plexus of capillary blood vessels or nerve fibers, especially referring to the capillaries of the glomerular of the kidney.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>glomerular</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15738 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15738">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of an ultrafiltrate of the blood occurring in the glomerulus of the kidney.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>glomerular filtration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15739 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15739">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of ultrafiltrate formed in the kidney tubules from the blood passing through the glomerular capillaries divided by time of filtration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>glomerular filtration rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15740 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15740">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inhalation of solvent vapor from plastic cements or other adhesives in order to become intoxicated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>glue-sniffing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16097"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15741 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15741">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specifically and entirely known microfauna and microflora of a specially reared laboratory animal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>gnotobiota</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15742 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15742">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specially reared laboratory animal whose microflora and microfauna are specifically known in their entirety.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>gnotobiont</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gnotobiote</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15743 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15743">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Noncancerous enlargement of the thyroid gland, visible as a swelling at the front of the neck, that is often associated with iodine deficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>goiter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15744 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15744">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any substance (such as thiouracil) that induces the formation of a goiter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>goitrogen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15745 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15745">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to effects on sex glands and on the systems that regulate them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>gonadotropic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15746 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15746">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nationally authorized safe uses of pesticides under actual conditions necessary for effective and reliable pest control.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>GAP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It encompasses a range of levels of pesticide applications up to the highest authorized use, applied in a manner that leaves a residue which is the smallest amount practicable. Authorized safe uses include nationally registered or recommended uses, that take into account public and occupational health and environmental safety considerations. Actual conditions include any stage in the production, storage, transport, distribution, and processing of food commodities and animal feed.</rdfs:comment>
        <rdfs:label>good agricultural practice</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15746"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GAP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15747 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15747">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pesticide (herbicide) used for the control of weedy grasses (Gramineae).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>graminicide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15774"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15748 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15748">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dusting or spraying of plants with pesticides by hand, by special machines, or by apparatus fixed to tractors or driven by them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ground treatment of plants</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15749 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15749">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scientifically judged quantitative value (a concentration or number) of an environmental constituent that ensures aesthetically pleasing air, water, or food and from which no adverse effect is expected concerning noncarcinogenic endpoints, or that gives an acceptably low estimate of lifetime cancer risk from those substances which are proven human carcinogens or carcinogens with at least limited evidence of human carcinogenicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>guideline for exposure limits</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15750 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15750">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative measure (a concentration or a number) of a constituent of an environmental medium that ensures aesthetically pleasing air, water, or food and does not result in a significant risk to the user.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>guideline value</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15751 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15751">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sets of atmospheric concentrations and exposure times that are associated with specific effects of varying degrees of pollution on humans, animals, vegetation, and the environment in general.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>guides to air quality</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15752 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15752">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sets of concentrations, numbers and exposure times that are associated with the specific effects of factors in environmental media on humans, animals, vegetation, and the environment in general.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>guides to environmental quality</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15753 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15753">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of the work environment, the effect of which on a worker under certain conditions leads to ill health or reduction of working ability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>harmful occupational factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15754 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15754">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that, following contact with an organism, can cause ill health or adverse effects either at the time of exposure or later in the life of the present and future generations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>noxious substance</oboInOwl:hasRelatedSynonym>
        <rdfs:label>harmful substance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15755 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15755">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>U.S. OSHA standard requiring all employers to inform employees of the hazard of substances in the workplace and the steps necessary to avoid harm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hazard communication standard</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15756 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15756">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production factor the effect of which on a worker under certain conditions results in injury or some impairment of health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>hazard at work</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hazardous occupational factor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hazardous production factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15757 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15757">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of complete physical, mental, and social well-being, and not merely the absence of disease or infirmity. State of dynamic balance in which an individual’s or a group’s capacity to cope with the circumstances of living is at an optimal level. State characterized by anatomical, physiological, and psychological integrity; ability to perform personally valued family, work, and community roles; ability to deal with physical, biological, psychological, and social stress; a feeling of well-being; and freedom from the risk of disease and untimely death. In ecology, a sustainable steady state in which humans and other living organisms can coexist indefinitely.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>health</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15758 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15758">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In the United States, nonregulatory health-based reference level of chemical traces (usually in ppm, i.e., \(\pu{mg L-1}\)) in drinking water at which there are no adverse health risks when ingested over various periods of time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>HAL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Such levels are established for 1 day, 10 days, long-term and life-time exposure periods. They allow for a wide margin of safety.</rdfs:comment>
        <rdfs:label>health advisory level</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15758"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HAL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15759 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15759">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum concentration or intensity of exposure that can be tolerated without significant effect (based on only scientific and not economic evidence concerning exposure levels and associated health effects).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>health-based exposure limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15760 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15760">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any factor or exposure that may adversely affect health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>health hazard</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15761 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15761">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epidemiological phenomenon observed initially in studies of occupational diseases: Workers usually exhibit lower overall disease and death rates than the general population, due to the fact that the old, severely ill, and disabled are ordinarily excluded from employment. Death rates in the general population may be inappropriate for comparison, if this effect is not taken into account.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>healthy worker effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15762 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15762">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vomiting of blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hematemesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15763 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15763">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse changes in blood caused by exposure to chemicals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hematotoxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15764 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15764">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of blood in the urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hematuria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15766 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15766">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hereditary disorder affecting iron metabolism in which excessive amounts of iron accumulate in the body tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The disorder is characterized by diabetes mellitus, liver dysfunction, and a bronze pigmentation of the skin.</rdfs:comment>
        <rdfs:label>hemochromatosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15767 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15767">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of free hemoglobin in the urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hemoglobinuria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15768 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15768">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that damages the membrane of erythrocytes causing the release of hemoglobin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hemolysin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15769 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15769">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Release of hemoglobin from erythrocytes, and its appearance in the plasma.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hemolysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15770 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15770">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Passing blood through a column of charcoal or adsorbent resin for the removal of drugs or toxins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hemoperfusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15771 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15771">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Insoluble iron(III) hydroxide-based pigment deposited in cells in conditions of iron overload.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hemosiderin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15772 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15772">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the liver.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hepatic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15773 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15773">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Poisonous to liver cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hepatotoxic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15774 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15774">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>herbicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15775 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15775">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that has different allelic forms of a specified gene on each of a pair of homologous chromosomes or describing the genome of that organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>heterozygote</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15776 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15776">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graphical method for analyzing binding of a molecule \(\ce{A}\) to a macromolecule \(\ce{P}\) with \(n\) binding sites. A Hill plot of \(\log[\theta/(1 - \theta)]\) vs. \(\log[\ce{A}]\) has a slope of 1 if binding is noncooperative and \(\gt 1\) for cooperative binding, where \(\theta = [\ce{A}]_{\rm{bound}}/n[\ce{P}]_{\rm{total}}\) is the fraction of sites occupied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>Hill plot</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15777 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15777">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Germ cell layer of the embryo from which a given adult tissue develops.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>histogenic origin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15778 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15778">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study (usually microscopic) of the anatomy of tissues and their cellular and subcellular structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>histology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15779 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15779">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Microscopic pathological study of the anatomy and cell structure of tissues in disease to reveal abnormal or adverse structural changes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>histopathology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15780 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15780">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxicity that follows a single exposure to a substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hit-and-run effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15781 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15781">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Similarity of anatomical structures in different species because of shared ancestry Similarity of DNA or RNA nucleotide sequences, or of protein amino-acid sequences, supporting the hypothesis that they share a common ancestor.Note: Homology among DNA or RNA nucleotide sequences, or among protein amino-acid sequences, is often concluded on the basis of sequence similarity. In general, if there are almost identical sequences, it is likely that they are homologous. However, it is possible that highly similar sequences were not derived from a common ancestor, i.e., they are similar but not homologous.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>homology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15782 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15782">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that has the same allelic form of a specified gene on each of a pair of homologous chromosomes or describing the genome of that organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>homozygote</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15783 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15783">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interrelationship between humans and the entire environment—physical, biological, socioeconomic, and cultural, including the interrelationships between individual humans or groups of humans and other human groups or groups of other species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>human ecology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15784 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15784">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Human dose of an agent that is believed to induce the same magnitude of a toxic effect that the known animal dose has induced.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>human equivalent dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15785 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15785">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generic value of exposure to a substance, or a group of substances falling within a defined structural class, below which there is expected to be no appreciable risk to human health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>human exposure threshold</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15786 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15786">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science of health and its preservation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hygiene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15787 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15787">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prefix meaning above or excessive: when used with the suffix &apos;-emia&apos; refers to blood and with the suffix &apos;-uria&apos; refers to urine, for example, &apos;hyperbilirubinemia&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyper-</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15798"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15788 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15788">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive amount of blood in any part of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyperemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15789 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15789">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ingestion or administration of nutrients in excess of optimal amounts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyperalimentation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15790 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15790">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive concentration of bilirubin in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyperbilirubinemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15791 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15791">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive concentration of calcium in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypercalcemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15792 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15792">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive concentration of glucose in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyperglycemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15793 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15793">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive concentration of potassium in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyperkalemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15794 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15794">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive concentration of sodium in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypernatremia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15795 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15795">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally increased parathyroid gland activity that affects, and is affected by, plasma calcium concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyperparathyroidism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15796 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15796">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Persistently high blood pressure in the arteries or in a circuit, for example, pulmonary hypertension or hepatic portal hypertension.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypertension</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15797 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15797">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition resulting from the ingestion of an excess of one or more vitamins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypervitaminosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15798 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15798">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prefix meaning under, deficient: when used with the suffix &apos;-emia&apos; refers to blood and with the suffix &apos;-uria&apos; refers to urine, for example, &apos;hypocalcemia&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypo-</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15787"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15799 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15799">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low calcium concentration in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypocalcemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15800 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15800">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low potassium concentration in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypokalemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15801 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15801">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low magnesium concentration in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypomagnesemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15802 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15802">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low sodium concentration in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hyponatremia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15803 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15803">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to an abnormally decreased volume of circulating fluid (plasma) in the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>hypovolemic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15804 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15804">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any adverse condition resulting from medical treatment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>iatrogenic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15805 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15805">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excess of bile pigment in the blood and consequent deposition and retention of bile pigment in the skin and the sclera.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>icterus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15806 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15806">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genetically based unusually high sensitivity of an organism to the effect of certain substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>idiosyncrasy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15807 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15807">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>According to the U.S. NIOSH, the maximum exposure concentration from which one could escape within \(\pu{30 min}\) without any escape-impairing symptoms or any irreversible health effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>IDLHC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immediately-dangerous-to-life-or-health-concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15681"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15807"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IDLHC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15808 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15808">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phrase applied to data generated and analyzed using computer modeling and information technology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>in silico</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15809 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15809">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure of the frequency at which new events occur in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>This is the value obtained by dividing the number of new events that occur in a defined period by the population at risk of experiencing the event during this period, sometimes expressed as person-time.</rdfs:comment>
        <rdfs:label>incidence rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15810 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15810">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity value provided by a measuring instrument or a measuring system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>indication</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15811 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15811">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exposure to a substance in a medium or vehicle other than the one originally receiving the substance. Exposure of people to a substance by contact with a person directly exposed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>indirect exposure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15812 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15812">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device for individual use for protection of the whole body, eyes, respiratory pathways, or skin of workers against hazardous and harmful production factors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>IPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>personal protective device (PPD)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>personal protective equipment (PPE)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>individual protective device</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15812"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IPD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15813 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15813">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability that an individual person will experience an adverse effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>individual risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15814 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15814">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that is not generally reactive.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>inert chemical</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15815 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15815">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any intentionally added ingredient of a mixture that does not contribute to the desired biological effect: This definition does not include impurities and does not imply that the inert ingredient has no biological effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>inert ingredient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15443"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15816 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15816">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Therapeutic introduction of a fluid other than blood, as a (usually saline) solution, into a vein.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>infusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15817 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15817">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of taking food and drink into the body by mouth. Process of taking in particles by a phagocytic cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ingestion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15818 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15818">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Act of drawing in of air, vapor, or gas and any suspended particulates into the lung.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>inhalation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15819 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15819">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of compounds for which there is unequivocal evidence of biodegradation (primary or ultimate) in any test of biodegradability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>inherently biodegradable</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15820 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15820">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of a substance that is taken into the body, regardless of whether or not it is absorbed: The total daily intake is the sum of the daily intake by an individual from food, drinking-water, and inhaled air.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>intake</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15821 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15821">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parameter (such as body weight or temperature) characterizing the overall changes in the general state of the organism exposed to a toxic substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>integral indicator of toxic effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15822 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15822">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological change that comes and goes at intervals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>discontinuous effect</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intermittent effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15823 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15823">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Selection and comparison of index and comparison groups in such a manner that, apart from sampling error, the observed differences between these groups with respect to dependent variables under study may be attributed only to the hypothesized effect under investigation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>internal validity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15824 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15824">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimation of a value between two known data points.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>interpolation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15825 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15825">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evaluation of the observations from an investigation or study in order to determine their significance for human health, for the environment or for both.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>interpretation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15826 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15826">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of extrapolating from the doses of one animal species to another, for example, from rodent dose to human equivalent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>interspecies dose conversion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15827 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15827">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aqueous solution filling the narrow spaces between cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>interstitial fluid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15828 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15828">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic form of pneumonia involving increase of the interstitial tissue and decrease of the functional lung tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>interstitial pneumonia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15829 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15829">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epidemiological investigation designed to test a hypothesized cause–effect relationship by intentional change of a supposed causal factor in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>intervention study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15830 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15830">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absorption further down the intestinal tract of a substance or substances that have been absorbed before and subsequently excreted into the intestinal tract, usually through the bile.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>intestinal reabsorption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15831 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15831">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Poisoning: pathological process with clinical signs and symptoms caused by a substance of exogenous or endogenous origin. Drunkenness following consumption of beverages containing ethanol or other compounds affecting the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>intoxication</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15691"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15832 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15832">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximal stimulatory effect induced by a compound in relation to that of a given reference compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>intrinsic activity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15833 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15833">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of plasma or blood from which a substance is completely removed in a period of time under unstressed conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>intrinsic clearance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15834 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15834">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific protein required for the absorption of \(\ce{vitamin B_{12}}\) and secreted by cells in the gastric glands of the stomach.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>intrinsic factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15835 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15835">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change from normal structure or function that persists or progresses after cessation of exposure of the organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>irreversible alteration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15836 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15836">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n., Substance that causes inflammation following immediate, prolonged, or repeated contact with skin, mucous membrane, or other biological material. Note: A substance capable of causing inflammation on first contact is called a primary irritant. adj., Causing inflammation following immediate, prolonged, or repeated contact with skin, mucous membrane, or other tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>irritant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15837 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15837">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Denoting a liquid exerting the same osmotic pressure or chemical potential of water (water potential) as another liquid with which it is being compared.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>isotonic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16193"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15838 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15838">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Illness (renal osteomalacia) observed in the Toyama prefecture of Japan, resulting from the ingestion of cadmium-contaminated rice.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Damage occurred to the renal and skeleto-articular systems, the latter being very painful (&quot;itai&quot; means &quot;ouch&quot; in Japanese and refers to the intense pain caused by the condition).</rdfs:comment>
        <rdfs:label>itai-itai disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15839 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15839">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological condition characterized by deposition of bile pigment in the skin and mucous membranes, including the conjunctivae, resulting in yellow appearance of the patient or animal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>jaundice</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15840 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15840">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simultaneous or successive effect of factors of diverse types (chemical, physical, biological) on an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>joint effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15841 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15841">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semiochemical that is produced by one organism inducing a response in an organism of another species that is unfavorable to the emitter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>kairomone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16082"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16124"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15842 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15842">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Branch of chemistry concerned with measuring and studying rates of chemical reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>kinetics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15843 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15843">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological increase in the production of ketone bodies, for example, following blockage or failure of carbohydrate metabolism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ketosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15844 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15844">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique used to decrease the expression of a particular gene in a cell or living organism in order to define its function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>knock-down</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15845 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15845">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique used to express an exogenous gene or to overexpress an endogenous gene in a living organism in order to define its function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>In mammalian toxicology, this technique is most readily applied to the mouse.</rdfs:comment>
        <rdfs:label>knock-in</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15691"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15846 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15846">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique used to inactivate a particular gene in a living organism in order to define its function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>In mammalian toxicology, this technique is most readily applied to the mouse.</rdfs:comment>
        <rdfs:label>knock-out</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15847 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15847">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that irritates the eyes and causes the production of tears or increases the flow of tears.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>lachrymator</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lacrimator</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15848 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15848">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill larvae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>larvicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15849 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15849">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reflex spasmodic closure of the sphincter of the larynx, particularly the glottic sphincter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>laryngospasm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15850 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15850">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Weakness; exhaustion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>lassitude</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15851 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15851">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Irrigation or washing out of a hollow organ or cavity such as the stomach, intestines, or lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>lavage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15852 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15852">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that causes evacuation of the intestinal contents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>cathartic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>purgative</oboInOwl:hasRelatedSynonym>
        <rdfs:label>laxative</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15853 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15853">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic intestinal pains and constipation caused by lead poisoning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>painters’ colic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lead colic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15854 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15854">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area of pathologically altered tissue. Injury or wound. Infected patch of skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>lesion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15856 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15856">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subjection to a potentially toxic substance during the whole lifetime.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>life-long exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15857 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15857">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill mollusks including the gastropod mollusk, Limax.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>limacide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15858 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15858">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>According to the USEPA’s Guidelines for Carcinogen Risk Assessment, &apos;limited evidence&apos; is a collection of facts and accepted scientific inferences that suggests that an agent may be causing an effect, but this suggestion is not strong enough to be considered established fact.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>limited evidence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15859 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15859">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of steps in which (a) a multistage model is fitted to tumor incidence data; (b) the maximum linear term consistent with the data is calculated; (c) the low-dose slope of the dose–response function is equated to the coefficient of the maximum linear term; and (d) the resulting slope is then equated to the upper bound of potency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>linearised multistage model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15903"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15860 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15860">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of changes associated with disease that are visible to the naked eye without the need for a microscope.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>gross pathology</oboInOwl:hasRelatedSynonym>
        <rdfs:label>macroscopic pathology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15861 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15861">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Smoke that is inhaled by the smoker.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mainstream smoke</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15862 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15862">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vague feeling of bodily discomfort.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>malaise</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15863 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15863">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Population of cells showing both uncontrolled growth and a tendency to invade and destroy other tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>A malignancy is life-threatening.</rdfs:comment>
        <rdfs:label>malignancy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15864 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15864">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emotional disorder (mental illness) characterized by an expansive and elated state (euphoria), rapid speech, flight of ideas, decreased need for sleep, distractibility, grandiosity, poor judgment, and increased motor activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mania</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15865 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15865">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the no-observed-adverse-effect level (NOAEL) to the theoretical or estimated exposure dose (EED) or concentration (EEC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>MOE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>margin of safety (MOS)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>margin of exposure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15682"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15865"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MOE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15866 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15866">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diameter of a spherical particle with a mass equal to the mean mass of all the particles in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mass mean diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15867 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15867">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diameter of a spherical particle with the median mass of all the particles in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mass median diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15868 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15868">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highest of the average daily concentrations recorded at a definite point of measurement during a certain period of observation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>peak daily average concentration of an air pollutant</oboInOwl:hasRelatedSynonym>
        <rdfs:label>maximum average daily concentration of an atmospheric pollutant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15869 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15869">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Under the Safe Drinking Water Act (USA), primary MCL is a regulatory concentration for drinking water which takes into account both adverse effects (including sensitive populations) and technological feasibility (including natural background levels): Secondary MCL is a regulatory concentration based on &apos;welfare&apos;, such as taste and staining, rather than health, but also takes into account technical feasibility.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>MCL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MCL Goals (MCLG) under the Safe Drinking Water Act do not consider feasibility and are zero for all human and animal carcinogens.</rdfs:comment>
        <rdfs:label>maximum contaminant level</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MCL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15870 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15870">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occupational exposure limit legally defined in the United Kingdom under COSHH as the maximum concentration of an airborne substance, averaged over a reference period, to which employees may be exposed by inhalation under any circumstances, and set on the advice of the HSC Advisory Committee on Toxic Substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>MEL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>maximum exposure limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15870"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15871 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15871">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum contents of a pesticide residue (expressed as \(\pu{mg kg-1}\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted in or on food commodities and animal feeds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>MRL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MRLs are based on data obtained following good agricultural practice and foods derived from commodities that comply with the respective MRLs are intended to be toxicologically acceptable.</rdfs:comment>
        <rdfs:label>maximum residue limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15571"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15746"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15871"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MRL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15872 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15872">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum contents of a drug residue (expressed as \(\pu{mg kg-1}\) or \(\pu{\upmu g kg-1}\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food commodities and animal feeds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>MRL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The MRL is based on the type and amount of residue considered to be without any toxicological hazard for human health as expressed by the acceptable daily intake (ADI) or on the basis of a temporary ADI that uses an additional uncertainty factor. It also takes into account other relevant public health risks as well as food technological aspects.</rdfs:comment>
        <rdfs:label>maximum residue limit for veterinary drugs</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15571"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15872"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MRL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15873 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15873">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In Michaelis–Menten kinetics, the maximum rate of conversion of a substrate when its concentration is not rate-limiting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>maximum rate</oboInOwl:hasRelatedSynonym>
        <rdfs:label>maximum velocity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15550"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15874 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15874">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic poisoning caused by exposure to mercury, often by breathing its vapor but also by skin absorption and, less commonly, by ingestion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>Mad Hatter syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Central nervous system damage usually predominates.</rdfs:comment>
        <rdfs:label>mercurialism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15875 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15875">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malignant tumor of the mesothelium of the pleura, pericardium, or peritoneum, that may be caused by exposure to asbestos fibers and some other fibers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mesothelioma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15876 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15876">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proteins that catalyze chemical transformations of body constituents and, in more common usage, of xenobiotics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>metabolic enzymes</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15877 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15877">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Analysis and theoretical reconstruction of the way in which the body deals with a specific substance, showing the proportion of the intake that is absorbed, the proportion that is stored and in what tissues, the rate of breakdown in the body and the subsequent fate of the metabolic products, and the rate at which it is eliminated by different organs as unchanged substance or metabolites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>metabolic model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15878 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15878">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biotransformation of a substance that takes place within a living organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>metabolic transformation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15879 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15879">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of bacteria or body cells, especially cancer cells, from one part of the body to another, resulting in change in location of a disease or of its symptoms from one part of the body to another. Growth of pathogenic microorganisms or of abnormal cells distant from the site of their origin in the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>metastasis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15880 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15880">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Derivative of hemoglobin that is formed when the iron(II) in the heme porphyrin is oxidized to iron(III); this derivative cannot transport dioxygen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>methaemoglobin</oboInOwl:hasRelatedSynonym>
        <rdfs:label>methemoglobin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15765"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15881 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15881">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of methaemoglobin in the blood in greater than normal proportion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>methaemoglobinaemia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>methemoglobinaemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15882 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15882">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance capable of oxidizing directly or indirectly the iron(II) in hemoglobin to iron(III) to form methemoglobin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>methaemoglobin-forming substance</oboInOwl:hasRelatedSynonym>
        <rdfs:label>methemoglobin-forming substance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15883 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15883">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic presence of albumin in slight excess in urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>microalbuminuria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15884 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15884">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Early or subclinical effects of exposure to elemental mercury detected at the low exposure levels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>micromercurialism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15885 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15885">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic presence of microprotein (alpha-1 and beta-2 microglobulin) in blood, indicating proximal renal tubule damage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>microproteinaemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15886 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15886">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Taking an aliquot of a flowing liquid, such as urine, avoiding initial and terminal flow periods which are likely to be unrepresentative.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>midstream sampling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15887 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15887">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the daily human exposure to a hazardous substance that is likely to be without appreciable risk of adverse noncancer health effects over a specified duration of exposure: This substance-specific estimate is used by ATSDR health assessors to identify contaminants and potential health effects that may be of concern at hazardous waste sites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>MRL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>minimal risk level</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15887"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MRL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15888 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15888">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Liquid substances capable of mixing without separation into two phases; refers to liquid mixtures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>miscible</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15889 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15889">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill mites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>miticide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15890 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15890">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Eukaryote cytoplasmic organelle that is bounded by an outer membrane and an inner membrane; the inner membrane has folds called cristae that are the center of ATP synthesis in oxidative phosphorylation in the animal cell and supplement ATP synthesis by the chloroplasts in photosynthetic cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The mitochondrial matrix within the inner membrane contains ribosomes, many oxidative enzymes, and a circular DNA molecule that carries the genetic information for a number of these enzymes.</rdfs:comment>
        <rdfs:label>mitochondrion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15891 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15891">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill mollusks.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>limacide</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>molluscicide</oboInOwl:hasRelatedSynonym>
        <rdfs:label>molluskicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15892 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15892">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that catalyzes reactions between an organic compound and molecular oxygen in which one atom of the oxygen molecule is incorporated into the organic compound and one atom is reduced to water; involved in the metabolism of many natural and foreign compounds giving both unreactive products and products of different or increased toxicity from that of the parent compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>mixed-function oxidase (MFO)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Such enzymes are the main catalysts of phase I reactions in the metabolism of xenobiotics by the endoplasmic reticulum or by preparations of microsomes.</rdfs:comment>
        <rdfs:label>monooxygenase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15662"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15893 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15893">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any departure, subjective or objective, from a state of physiological or psychological well-being: In this sense, &apos;sickness&apos;, &apos;illness&apos;, and &apos;morbid condition&apos; are similarly defined and synonymous.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>morbidity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15894 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15894">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term (to be avoided) used loosely to refer to incidence or prevalence rates of disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>morbidity rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15895 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15895">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for the estimation of the prevalence and (or) incidence of a disease or diseases in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>morbidity survey</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15896 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15896">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Investigation dealing with death rates or proportion of deaths attributed to specific causes as a measure of response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mortality study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15897 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15897">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of removal of particles from the bronchi of the lungs in a mucus stream moved by cilia, thus contributing to uptake from the gastrointestinal tract.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mucociliary transport</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15898 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15898">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Product of a compartmental analysis requiring more than two compartments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>multicompartment model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15899 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15899">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Illness with pathogenesis dependent on complex interplay of genetic and (or) environmental factors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>multifactorial disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15900 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15900">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure that has evolved by combining single screening tests, and is the logical corollary of mass screening.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>multiphasic screening</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Multiple (or multiphasic) screening implies the administration of a number of tests, in combination, to large groups of people.</rdfs:comment>
        <rdfs:comment>Where much time and effort have been spent by a population in attending for a single test such as mass radiography, it is natural to consider the economy of offering other tests at the same time.</rdfs:comment>
        <rdfs:label>multiple screening</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15901 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15901">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of a cell, capable of giving rise to several different kinds of structure or types of cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>multipotent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15902 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15902">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cluster sampling with more than two stages, each sampling being made on aggregates (or clusters) in which the clusters already obtained by the preceding sampling have been divided.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>multistage cluster sampling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15903 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15903">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose–response model for cancer death estimation of the form \[P = 1 - \exp [-(q_{0} + q_{1}d_{1} + q_{2}d_{2} + \ldots + q_{k}d_{k})]\] where \(P\) is the probability of cancer death from a continuous dose rate, \(d_{i}\) , of group (or stage) \(i = 0, 1, 2 \ldots\), the \(q\)’s are constants, and \(k\) is the number of dose groups (or, if less than the number of dose groups, \(k\) is the number of biological stages believed to be required in the carcinogenesis process). With the multistage model, it is assumed that cancer is initiated by cell mutations in a finite series of steps.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>multistage model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15904 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15904">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of or belonging to the family of rats and mice (Muridae).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>murine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15905 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15905">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pain or tenderness in a muscle or group of muscles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>myalgia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15906 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15906">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Muscular weakness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>myasthenia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15907 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15907">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxin produced by a fungus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>mycotoxin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15908 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15908">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scientific discipline involving the study of the actual or potential danger presented by the harmful effects of nanoparticles on living organisms and ecosystems, of the relationship of such harmful effects to exposure, and of the mechanisms of action, diagnosis, prevention, and treatment of intoxications.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nanotoxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15909 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15909">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance increasing the rate of excretion of sodium ion in the urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>saluretic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>natriuretic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15910 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15910">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of a substance in nature, as distinct from presence resulting from inputs from human activities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The contamination of the natural environment by some man-made compounds may be so widespread that it is practically impossible to get access to biota with a truly natural level; only &quot;normal&quot; levels can be measured, those which are usually prevalent in places where there is no obvious local contamination.</rdfs:comment>
        <rdfs:label>natural occurrence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15911 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15911">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability of adverse effects occurring that can reasonably be described as trivial. Probability of adverse effects occurring that is so low that it cannot be reduced appreciably by increased regulation or investment of resources.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>negligible risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15912 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15912">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill nematodes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>nematocide</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nematicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15913 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15913">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>New and abnormal formation of tissue as a tumor or growth by cell proliferation that is faster than normal and continues after the initial stimulus that initiated the proliferation has ceased.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>neoplasia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15914 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15914">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the kidney, leading to kidney failure, usually accompanied by proteinuria, hematuria, edema, and hypertension.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nephritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15764"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15796"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16012"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15915 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15915">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any disease or abnormality of the kidney.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>renopathy</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nephropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15916 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15916">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease of the kidneys marked by degeneration of renal tubular epithelium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nephrosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15917 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15917">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemically harmful to the cells of the kidney.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nephrotoxic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15918 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15918">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects occurring when the generation of reactive nitrogen species in a system exceeds the system’s ability to neutralize and eliminate them; nitrosative stress may lead to nitrosylation reactions that can alter protein structure, thus inhibiting normal function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nitrosative stress</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15919 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15919">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>This expression is applicable to a substance for which the available information is not sufficient to establish its safety, or when the specifications for identity and purity are not adequate, or when the available data show that the substance is hazardous and should not be used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The basis for the use of the expression should be determined before action is taken; in the first two cases above, not being able to allocate an ADI does not mean that the substance is unsafe.</rdfs:comment>
        <rdfs:label>no-acceptable-daily-intake-allocated</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15920 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15920">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small node or boss that is solid and can be detected by touch.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nodule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15921 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15921">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of a substance that has no effect on the organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>NED</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subthreshold dose</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is lower than the threshold of harmful effect and is estimated while establishing the threshold of harmful effect.</rdfs:comment>
        <rdfs:label>no-effect dose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16136"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15921"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NED</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15922 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15922">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum dose (of a substance) that produces no detectable changes under defined conditions of exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>NEL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This term tends to be substituted by no-observed-adverse-effect level (NOAEL) or no-observed-effect level (NOEL).</rdfs:comment>
        <rdfs:label>no-effect level</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15922"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15923 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15923">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in the chemical or physical nature of a substance occurring as a result of physicochemical conditions and independent of any biological system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>non-bioenvironmental transformation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15924 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15924">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electromagnetic radiation of low energy that is not capable of causing ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nonionising radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15925 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15925">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Environmental exposure outside the workplace to substances that are otherwise associated with particular work environments and (or) activities and processes that occur there.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nonoccupational exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15927 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15927">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Associated with a hospital or infirmary, especially used of diseases that may result from treatment in such an institution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>nosocomial</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15928 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15928">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure for evaluating the dietary intake of a large number of people.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>For each record of quantity of food consumed during a certain time period, the daily intake of the substance in question is calculated by multiplying the substance concentration in the food item (as obtained from the nutritional table) by the quantity of food consumed and dividing by the time of observation.</rdfs:comment>
        <rdfs:comment>The accuracy of the method depends on the accuracy with which records of the food consumption can be established and the accuracy of the nutritional tables specifying the concentration of various nutrients, vitamins, essential, and non-essential substances including pesticide residues.</rdfs:comment>
        <rdfs:label>nutritional table method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15929 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15929">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to or exhibiting a nychthemeron or \(\pu{24\!\mbox{-}h}\) period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>circadian</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nychthemeral</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15930 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15930">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Actual physical, chemical, and social environment as described by objective measurements, such as noise levels in decibels and concentrations of air pollutants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>objective environment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15931 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15931">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surrounding conditions at a workplace.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>occupational environment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15932 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15932">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experience of substances, intensities of radiation, etc., or other conditions while at work.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>occupational exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15933 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15933">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regulatory level of exposure to substances, intensities of radiation, etc., or other conditions, specified appropriately in relevant government legislation or related codes of practice.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>OEL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>occupational exposure limit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15933"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>OEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15934 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15934">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Level of exposure to substances, intensities of radiation, etc., or other conditions considered to represent specified good practice and a realistic criterion for the control of exposure by appropriate plant design, engineering controls, and, if necessary, the addition and use of personal protective clothing. In UK, health-based exposure limit defined under COSHH Regulations as the concentration of any airborne substance, averaged over a reference period, at which, according to current knowledge, there is no evidence that it is likely to be injurious to employees, if they are exposed by inhalation, day after day, to that concentration, and set on the advice of the HSE Advisory Committee on Toxic Substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>OES</oboInOwl:hasRelatedSynonym>
        <rdfs:label>occupational exposure standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15934"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>OES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15935 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15935">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Identification, assessment, and control of physicochemical and biological factors in the workplace that may affect the health or well-being of those at work and in the surrounding community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>industrial hygiene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>occupational safety and health</oboInOwl:hasRelatedSynonym>
        <rdfs:label>occupational hygiene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15936 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15936">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specialty devoted to the prevention and management of occupational injury, illness, and disability, and the promotion of the health of workers, their families, and their communities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>occupational medicine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15937 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15937">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ocular</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15938 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15938">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the probability of occurrence of an event to that of non-occurrence, or the ratio of the probability that something is so, to the probability that it is not so.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>odds</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15939 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15939">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quotient obtained by dividing one set of odds by another. The terms &apos;odds&apos; or &apos;odds ratio&apos; are defined differently according to the situation under discussion. Consider the following notation for the distribution of a binary exposure and a disease in a population or a sample. \[\begin{array}{l c c} &amp; Exposed &amp; Nonexposed \\ \rm{Disease} &amp; a &amp; b \\ \rm{No\ disease} &amp; c &amp; d \\ \end{array}\] The odds ratio (cross-product ratio) is \(ad/bc\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>OR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cross-product ratio</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>relative odds</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The disease-odds (rate-odds) ratio for a cohort or cross-section is the ratio of the odds in favor of disease among the exposed population (\(a/c\)) to the odds in favor of disease among the unexposed (\(b/d\)), which is equal to \(ad/bc\) and hence is equal to the exposure-odds ratio for the cohort or cross-section.</rdfs:comment>
        <rdfs:comment>The exposure-odds ratio for a set of case control data is the ratio of the odds in favor of exposure among the cases (\(a/b\)) to the odds in favor of exposure among non-cases (\(c/d\)), which is equal to \(ad/(bc)\). With incident cases, unbiased subject selection, and a &quot;rare&quot; disease (say, under \(\pu{2\%}\) cumulative incidence rate over the study period), \(ad/bc\) is an approximate estimate of the risk ratio. With incident cases, unbiased subject selection, and density sampling of controls, \(ad/bc\) is an estimate of the ratio of the person-time incidence rates (force of morbidity) in the exposed and unexposed. No rarity assumption is required for this.</rdfs:comment>
        <rdfs:comment>The prevalence-odds ratio refers to an odds ratio derived cross-sectionally, as, for example, an odds ratio derived from studies of prevalent (rather than incident) cases.</rdfs:comment>
        <rdfs:comment>The risk-odds ratio is the ratio of the odds in favor of getting disease, if exposed, to the odds in favor of getting disease if not exposed. The odds ratio derived from a cohort study is an estimate of this.</rdfs:comment>
        <rdfs:label>odds ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15939"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>OR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15940 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15940">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In principle, the lowest concentration of an odorant in the air that can be detected by a human being.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>odor detection threshold</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>odour threshold</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In practice, a panel of &quot;sniffers&quot; is often used, and the threshold taken as the concentration at which $\pu{50\%}$ of the panel can detect the odorant (although some workers have also used $\pu{100\%}$ thresholds). The odor concentration at the detection threshold may be defined as one odor unit.</rdfs:comment>
        <rdfs:label>odor threshold</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15941 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15941">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unit used to measure scent emission of people and objects; one olf is defined as the scent emission of an &apos;average person&apos;, a sitting adult who takes an average of \(\pu{0.7}\) baths per day and whose skin has a total area of \(\pu{1.8 m2}\); the scent emission of an object or person is measured by specially trained personnel comparing it to normed scents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The olf should not be confused with the of unit of scent immission (as opposed to emission), the decipol, which also takes into account the ventilation system’s air volume flow.</rdfs:comment>
        <rdfs:label>olf</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15625"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15942 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15942">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for testing the power of the sense of smell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>olfactometer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15943 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15943">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sperm concentration less than a reference value.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>oligozoospermia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15944 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15944">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excretion of a diminished amount of urine in relation to fluid intake.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>oliguria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15945 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15945">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neologism referring to the fields of study in biology ending in the suffix -omics, such as genomics or proteomics: The related neologism -omes are the objects of study of the field such as the genome or proteome, respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>-omics, -omes</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15946 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15946">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene that can cause neoplastic (see neoplasia) transformation of a cell; oncogenes are slightly changed equivalents of normal genes known as proto-oncogenes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>oncogene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15913"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15947 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15947">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production or causation of tumors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>oncogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15948 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15948">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capable of producing tumors in animals, either benign (noncancerous) or malignant (cancerous).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>oncogenic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15502"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15949 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15949">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose-response model of the form \[P = 1 - {\rm{e}}^{-bd}\] where \(P\) is the probability of cancer death from a continuous dose rate, \(d\), and \(b\) is a constant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>one-hit model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15950 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15950">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loosening or detachment of the nail from the nail bed following some destructive process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>onycholysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15951 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15951">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ophthalmic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15952 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15952">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of a substance or physical agent (radiation) absorbed by an organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>organ dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15953 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15953">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Microstructure or separated compartment within a cell that has a specialized function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>organelle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15954 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15954">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure of the tendency for organic substances to be adsorbed by soil or sediment, expressed as: \[K_{\rm{oc}} = \frac{(\ce{mass adsorbed substance})/(\ce{mass organic carbon})}{(\ce{mass concentration of absorbed substance})}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The \(K_{\rm{oc}}\) is substance-specific and is largely independent of soil properties.</rdfs:comment>
        <rdfs:label>organic carbon partition coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15955 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15955">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prefix meaning pertaining to bone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>osteo-</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15956 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15956">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal development of bone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>osteodystrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15957 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15957">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition marked by softening of the bones (due to impaired mineralization, with excess accumulation of osteoid), with pain, tenderness, muscular weakness, anorexia, and loss of weight, resulting from deficiency of vitamin D and calcium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>osteomalacia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15958 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15958">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Significant decrease in bone mass with increased porosity and increased tendency to fracture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>osteoporosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15959 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15959">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill eggs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ovicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15960 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15960">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exposure of a worker’s family to substances carried from the workplace to the home. Exposure of visitors to substances in the workplace.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>para-occupational exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15961 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15961">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of, relating to, or affecting the parasympathetic nervous system which stimulates digestive secretions, slows the heart, constricts the pupils of the eyes, and dilates blood vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>parasympathetic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15962 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15962">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Producing effects resembling those caused by interruption of the parasympathetic nerve; also called anticholinergic.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>parasympatholytic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15963 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15963">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of introducing substances into an organism avoiding the gastrointestinal tract (subcutaneously, intravenously, intramuscularly, etc.).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>parenteral dosage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15964 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15964">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inhalation of sidestream smoke by people who do not smoke themselves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>passive smoking</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16088"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15965 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15965">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Action of entering or passing through a cell membrane. Ability or power to enter or pass through a cell membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>penetration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15966 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15966">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Through the skin following application on the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>percutaneous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15967 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15967">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Act of pouring over or through, especially the passage of a fluid through the vessels of a specific organ. Liquid poured over or through an organ or tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>perfusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15968 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15968">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of artificial detoxication in which a toxic substance from the body is transferred into liquid that is instilled into the peritoneum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Effectively, this represents the employment of the peritoneum surrounding the abdominal cavity as a dialyzing membrane for the purpose of removing waste products or toxins accumulated as a result of renal failure.</rdfs:comment>
        <rdfs:label>peritoneal dialysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15969 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15969">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity defining the permeability of molecules across a cell membrane and expressed as \[P = \frac{KD}{\Delta x}\] where \(K\) is the partition coefficient, \(D\) is the diffusion coefficient, and \(\Delta x\) is the thickness of the cell membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>SI units \(\pu{m s-1}\); frequently used units \(\pu{cm s-1}\), with units \(\pu{cm2 s-1}\) for \(D\), and \(\pu{cm}\) for \(\Delta x\).</rdfs:comment>
        <rdfs:label>permeability coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15970 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15970">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of a membrane, allowing a given substance to pass through.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>When applied to nonbiological membranes with no qualification, the term normally refers to water.</rdfs:comment>
        <rdfs:label>permeable</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15971 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15971">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recommendation by U.S. OSHA for a time-weighted average concentration that must not be exceeded during any \(\pu{8\!\mbox{-}h}\) work shift of a \(\pu{40\!\mbox{-}h}\) working week.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>PEL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>permissible exposure limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16143"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15971"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15972 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15972">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of environmental monitoring in which an individual’s exposure to a substance is measured and evaluated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>This is normally carried out using a personal sampler.</rdfs:comment>
        <rdfs:label>personal monitoring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15974"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15973 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15973">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equipment (clothing, gloves, hard hat, respirator, etc.) worn by an individual to prevent exposure to a potentially toxic substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>PPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>individual protective device (IPD)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>personal protective equipment (PPE)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>personal protective device</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15973"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PPD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15974 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15974">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compact, portable instrument for individual air sampling, measuring, or both, the content of a harmful substance in the respiration zone of a working person.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>individual monitor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>individual sampler</oboInOwl:hasRelatedSynonym>
        <rdfs:label>personal sampler</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15975 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15975">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that may harm public health, attacks food and other materials essential to mankind, or otherwise affects human beings adversely.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>pest</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15976 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15976">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Further metabolism of conjugated metabolites produced by phase II reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>phase III reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15977 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15977">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete phenotypic description of an organism (by analogy with genome).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>phenome</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15978 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15978">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the skin caused by exposure to light, especially that due to metabolites formed in the skin by photolysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>photo-irritation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15979 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15979">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects produced by exposure to light energy, especially those produced in the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>phototoxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15980 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15980">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Map showing how much DNA, measured in base pairs, separates two genes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Not to be confused with a genetic map which shows the position of genes in relation to each other, based on the frequency of crossing overs.</rdfs:comment>
        <rdfs:label>physical map</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15981 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15981">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill fish.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>piscicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15982 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15982">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of a placenta in the uterus. Type or structure of a placenta. In botany, arrangement of placentas within the plant ovary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>placentation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15983 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15983">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic poisoning caused by absorption of lead or lead salts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>saturnism</oboInOwl:hasRelatedSynonym>
        <rdfs:label>plumbism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15984 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15984">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Usually fibrosis of the lungs that develops owing to (prolonged) inhalation of inorganic or organic dusts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Cause-specific types of pneumoconiosis are:anthracosis: from coal dustasbestosis: from asbestos dustbyssinosis: from cotton dustsiderosis: from iron dustsilicosis: from silica duststannosis: from tin dust</rdfs:comment>
        <rdfs:label>pneumoconiosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15985 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15985">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the lung.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>pneumonitis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15986 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15986">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in a single base pair in DNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>point mutation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15987 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15987">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Containing a poison.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>poison-bearing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15988 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15988">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Morbid condition produced by a poison.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>intoxication</oboInOwl:hasRelatedSynonym>
        <rdfs:label>poisoning</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15989 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15989">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody produced by a number of different cell types.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>polyclonal antibody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15990 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15990">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic excessive thirst.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>polydipsia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15991 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15991">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive production and discharge of urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>polyuria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15992 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15992">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Persons who can and may develop an adverse health effect and who are potentially exposed to a substance under study. People already having chronic disease are excluded from the population at risk in studies of the incidence of the adverse effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>population at risk</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15993 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15993">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance in the critical organ at which a specified percentage of the exposed population has reached the individual critical organ concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>PCC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The percentage is indicated by PCC-10 for \(\pu{10\%}\), PCC-50 for \(\pu{50\%}\), etc. (similar to the use of the term median lethal dose (\(\pu{LD_{50}}\)).</rdfs:comment>
        <rdfs:label>population critical concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15993"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PCC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15994 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15994">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absolute number or incidence rate of cases occurring in a group of people.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>population effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15995 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15995">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disturbance of porphyrin metabolism characterized by increased formation, accumulation, and excretion of porphyrins and their precursors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>porphyria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15996 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15996">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Natural pigment containing a fundamental skeleton of four pyrrole nuclei united through the α-positions by four methine groups to form a macrocyclic structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>porphin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>porphine</oboInOwl:hasRelatedSynonym>
        <rdfs:label>porphyrin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15997 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15997">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pharmacological study of the choice of appropriate dose of a drug in relation to the physiological factors, such as age, that may influence its effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>posology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15998 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15998">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Processes by which proteins are biochemically modified within a cell following their synthesis on the ribosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>post-translational modification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15999 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15999">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Numerically specified low risk of exposure to a potentially toxic substance (e.g., 1 in \(\pu{1000}\)) or socially acceptable low risk of adverse effects from such an exposure applied to decision making in regard to chemical safety.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>practical certainty</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16000 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16000">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the region over the heart and lower thorax.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>precordial</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16001 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16001">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reliability of a measurement expressed in terms of its ability to predict the criterion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>predictive validity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16002 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16002">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Percentage of positive results that are true positives or of negative results that are true negatives.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>predictive value</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16003 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16003">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Follicular depletion by the age of 35 years.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>premature ovarian failure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16004 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16004">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Before the formation of a tumor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>preneoplastic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16005 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16005">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concept in law and medicine that states that before one is subjected to a risk, especially a risk of bodily harm, one is entitled to be fully informed well in advance of the nature of that risk in order to make an informed decision about whether to accept it or not.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>PIC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>prior informed consent</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16005"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PIC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16006 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16006">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Accepted maximum level of a pollutant (or its indicator) in the target organism, or some part thereof, or an accepted maximum intake of a pollutant or nuisance into the target under specified circumstances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>primary protection standard</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16007 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16007">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that has to be metabolized before it becomes a carcinogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>procarcinogen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16008 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16008">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in the size of a tumor or spread of cancer in the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>progression</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16009 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16009">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unicellular organism, characterized by the absence of a membrane-enclosed nucleus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Prokaryotes include bacteria, blue–green algae, and mycoplasmas.</rdfs:comment>
        <rdfs:label>prokaryote</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16010 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16010">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance applied in a form that is not active as a pesticide and which becomes active once it enters an organism and undergoes chemical modification.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>pro-pesticide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16011 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16011">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportion of observed deaths from a specified condition in a defined population divided by the proportion of deaths expected from this condition in a standard population, expressed either on an age-specific basis or after age adjustment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>proportional mortality ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:label>proportional mortality rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16012 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16012">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excretion of excessive amounts of protein (derived from blood plasma or kidney tubules) in the urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>proteinuria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16013 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16013">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intake for a substance derived by applying a thousandfold uncertainty factor to the lowest low-effect level for noncarcinogenic endpoints.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>PADI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pseudo-acceptable daily intake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PADI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16014 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16014">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparent adaptation of an organism to changing conditions of the environment (especially chemical) associated with stresses in biochemical systems that exceed the limits of normal (homeostatic) mechanisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Essentially, there is a temporary concealed pathology that later on can be manifested in the form of explicit pathological changes sometimes referred to as &quot;decompensation&quot;.</rdfs:comment>
        <rdfs:label>pseudoadaptation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16015 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16015">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Applying risk assessment to a specific target population of known size, giving as the end product a quantitative statement about the number of people likely to be affected in a particular population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>public health impact assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16016 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16016">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which the temperature of a human being or mammal is above normal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>pyrexia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16017 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16017">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing a condition that can be expressed only as &apos;occurring&apos; or &apos;not occurring&apos;, such as death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>quantal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16018 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16018">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scientific study involving research, education, prevention, and treatment of diseases caused by ionizing or nonionizing radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>radiation toxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16019 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16019">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absolute difference between two rates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>RD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>excess rate</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In comparisons of exposed and unexposed groups, the term excess rate may be used as a synonym for rate difference.</rdfs:comment>
        <rdfs:label>rate difference</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16019"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16020 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16020">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill rats.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ratticide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16021 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16021">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absorption by a living organism of a substance which it has previously absorbed and then released (e.g., the uptake of a substance from the proximal renal tubule following glomerular filtration).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reabsorption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16022 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16022">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radical nitrogen-based molecules that can act to facilitate nitrosylation reactions; reactive nitrogen species include dioxidonitrogen(\(\ce{^{.}}\)) (nitrogen dioxide, nitryl radical) \(\ce{NO^{.}}\), oxidonitrogen(\(\ce{^{.}}\)) (nitrogen monoxide, nitrosyl radical) \(\ce{NO^{.}}\) oxidonitrogen(1+) (nitrosyl cation) \(\ce{NO^{+}}\), hydroxyoxidonitrogen (nitrous acid) \(\ce{HNO2}\), and oxidonitrate(1-) \(\ce{NO^{-}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>RNS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>reactive nitrogen species</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RNS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16023 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16023">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Arbitrary classification of substances that have passed certain specified screening tests for ultimate biodegradability; these tests are so stringent that such compounds will be rapidly and completely biodegraded in a wide variety of aerobic environments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>readily biodegradable</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16024 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16024">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a substance to remain in a particular environment in an unchanged form.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>recalcitrance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16025 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16025">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Endocytosis of a substance and its receptor following receptor binding.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>receptor-mediated endocytosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16026 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16026">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Allele which in the heterozygous state is expected to have no effect on the phenotype of the organism which carries it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>recessive gene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16027 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16027">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highest allowable regulatory airborne concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>REL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This exposure concentration is not expected to injure workers. It may be expressed as a ceiling limit or as a time-weighted average (TWA).</rdfs:comment>
        <rdfs:label>recommended exposure level</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16028 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16028">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Restoration to original form of a substance previously altered for preservation and storage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reconstitution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16029 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16029">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process or method allowing for the recovery of some value from a waste, either as reusable material or as energy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>recycling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16030 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16030">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An estimate (with uncertainty spanning perhaps an order of magnitude) of a continuous inhalation exposure to the human population (including sensitive subgroups which include children, asthmatics, and the elderly) that is likely to be without an appreciable risk of deleterious effects during a lifetime.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>RfC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It can be derived from various types of human or animal data such as NOAEL, LOAEL, or benchmark concentration, with uncertainty factors generally applied to reflect limitations of the data used. It is generally used in USEPA’s noncancer health assessments.</rdfs:comment>
        <rdfs:label>reference concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16030"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RfC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16031 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16031">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Statistical distribution of reference values.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reference distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16032 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16032">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Person selected with the use of defined criteria for comparative purposes in a clinical study.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reference individual</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16033 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16033">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area between and including two reference limits, for example, the percentiles \(\pu{2.5}\) and \(\pu{97.5}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reference interval</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16034 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16034">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Boundary value defined so that a stated fraction of the reference values is less than or exceeds that boundary value with a stated probability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reference limit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16035 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16035">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of all reference individuals used to establish criteria against which a population that is being studied can be compared.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reference population</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16036 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16036">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Selected reference individuals, statistically adequate numerically to represent the reference population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>reference group</oboInOwl:hasRelatedSynonym>
        <rdfs:label>reference sample group</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16037 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16037">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity value, generally accepted as having a suitably small measurement uncertainty, to be used as a basis for comparison with values of quantities of the same kind.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reference value</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16038 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16038">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term used by the USEPA to describe the expected dose resulting from human exposure to a substance at the level at which it is regulated in the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>regulatory dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16039 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16039">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>DNA sequence to which specific proteins bind to activate or repress the expression of a gene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>regulatory sequence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16040 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16040">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure that can be used in comparison of adverse reactions to drugs, or other exposures, based solely on the component of risk due to the exposure or drug under investigation, removing the risk due to background exposure experienced by all in the population. The relative excess risk, \(R\), is given by \[R = (R_{1} - R_{0})/(R_{2} - R_{0})\] where \(R_{1}\) is the rate in the population, \(R_{2}\) is the rate in the comparison population, and \(R_{0}\) is the rate in the general population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>RER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>comparative risk</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Rate is used here as in epidemiology.</rdfs:comment>
        <rdfs:label>relative excess risk</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16040"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RER</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16041 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16041">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity of metabolizable substance divided by product of quantity of absorbed substance and exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>relative systemic availability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16042 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16042">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anything, such as a medicine or therapy, that relieves pain, cures disease, or corrects a disorder.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>remedy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16043 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16043">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of plasma passing through the kidneys in unit time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>renal plasma flow</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16044 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16044">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used mainly to repel blood-sucking insects in order to protect humans and animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>This term may also be used for substances used to repel mammals, birds, rodents, mites, plant pests, etc.</rdfs:comment>
        <rdfs:label>repellent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16045 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16045">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Act of taking multiple samples concurrently under comparable conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Replicate sampling may be accomplished by taking samples adjacent in time or space.</rdfs:comment>
        <rdfs:label>replicate sampling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16046 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16046">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physiological or biochemical capacity that may be available to maintain homeostasis when the body or an organism is exposed to an environmental change.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reserve capacity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16047 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16047">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Storage compartment from which a substance may be released with subsequent biological effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reservoir</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16048 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16048">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Health risk remaining after risk reduction actions are implemented.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>residual risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16049 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16049">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Contaminant remaining in an organism or in other material such as food or packaging, following exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>residue</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16050 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16050">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Action of a substance after its reabsorption from the gut into the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>resorptive effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16051 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16051">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of dust (particles) that penetrates to the unciliated airways of the lung (the alveolar region).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>respirable particles</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This fraction is represented by a cumulative log-normal curve having a median aerodynamic diameter of \(\pu{4 \upmu m}\), standard deviation \(\pu{2 \upmu m}\) (values for humans).</rdfs:comment>
        <rdfs:label>respirable dust</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16052 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16052">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Research design used to test etiological hypotheses in which inferences about exposure to the putative causal factor(s) are derived from data relating to characteristics of the persons or organisms under study or to events or experiences in their past.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The essential feature is that some of the persons under study have the disease or other outcome condition of interest, and their characteristics and past experiences are compared with those of other, unaffected persons. Persons who differ in the severity of the disease may also be compared.</rdfs:comment>
        <rdfs:label>retrospective study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16053 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16053">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enhancement of the dose–effect relationship for a poison following repeated exposure to decreasing doses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>returned effect of poisons</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16054 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16054">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mutation in a mutant allele which makes it capable of producing the nonmutant phenotype; this may result from restoration of the original DNA sequence of the gene or from production of a new DNA sequence which has the same effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>back mutation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>reverse mutation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16055 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16055">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which an RNA molecule is used as a template to make a single-stranded DNA copy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reverse transcription</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16056 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16056">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change from normal structure or function, induced by a substance or other agent(s), that returns to normal status or within normal limits after cessation of exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>reversible alteration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16057 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16057">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute, fulminating, potentially lethal disease of skeletal muscle that causes disintegration of striated muscle fibers as evidenced by myoglobin in the blood and urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>rhabdomyolysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16058 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16058">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Harsh crepitation in the throat, often resembling snoring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>rhonchus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16059 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16059">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability of the occurrence of a specified undesirable event following exposure of an individual person from a given population to a specified substance at a defined level for the expected lifetime of the average member of that population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk associated with a lifetime exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16060 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16060">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tendency of an individual person to avoid risk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk aversion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16061 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16061">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interpretation and communication of risk assessments in terms that are comprehensible to the general public or to others without specialist knowledge.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk communication</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16062 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16062">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Risk that is negligible and too small to be of societal concern (usually assumed to be a probability below \(\pu{E-5}\) or \(\pu{E-6}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>de minimis risk</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>negligible risk</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In the United States, this is a legal term used to mean &quot;negligible risk to the individual&quot;.</rdfs:comment>
        <rdfs:comment>This term can also mean &quot;virtually safe&quot;.</rdfs:comment>
        <rdfs:label>risk &lt;i&gt;de minimis&lt;/i&gt;</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16063 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16063">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Establishment of a qualitative or quantitative relationship between risks and benefits, involving the complex process of determining the significance of the identified hazards and estimated risks to those organisms or people concerned with or affected by them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16064 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16064">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recognition of a potential hazard and definition of the factors required to assess the probability of exposure of organisms or people to that hazard and of harm resulting from such exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk identification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16065 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16065">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attribute that is associated with an increased probability of occurrence of a disease or other specified outcome and that can be used as an indicator of this increased risk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>risk indicator</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A risk marker is not necessarily a causal factor.</rdfs:comment>
        <rdfs:label>risk marker</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16066 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16066">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of following up the decisions and actions within risk management in order to check whether the aims of reduced exposure and risk are achieved.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk monitoring</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16067 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16067">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subjective perception of the gravity or importance of the risk based on a person’s knowledge of different risks and the moral, economic, and political judgment of their implications.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk perception</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16068 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16068">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Word groups identifying potential health or environmental hazards required under CPL Directives (European Community); may be incorporated into Safety Data Sheets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk phrases</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16069 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16069">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of exposure corresponding to a specified level of risk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>risk-specific dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16070 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16070">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill rodents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>rodenticide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16071 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16071">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Means by which a toxic agent gains access to an organism by administration through the gastrointestinal tract (ingestion), lungs (inhalation), skin (topical), or by other routes such as intravenous, subcutaneous, intramuscular, or intraperitoneal routes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>route of exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16072 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16072">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Supernatant fraction obtained from an organ (usually liver) homogenate by centrifuging at \(\pu{9000 g}\) for \(\pu{20 min}\) in a suitable medium; this fraction contains cytosol and microsomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>S9 fraction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16073 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16073">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science directed to the discovery, development, and safe therapeutic use of biologically active substances as a result of the identification, monitoring, and characterization of potentially undesirable pharmacodynamic activities of these substances in nonclinical studies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>safety pharmacology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16074 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16074">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malignant tumor arising in a connective tissue and composed primarily of anaplastic cells resembling supportive tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>sarcoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15460"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16075 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16075">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Elimination that becomes concentration-independent at a concentration at which the elimination process is functioning maximally.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>saturable elimination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16076 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16076">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pain in a joint resulting from lead poisoning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>saturnia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16077 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16077">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intoxication caused by lead.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>plumbism</oboInOwl:hasRelatedSynonym>
        <rdfs:label>saturnism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16078 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16078">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area of diminished or lost vision within the visual field, surrounded by an area of less affected or normal vision.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>scotoma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16079 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16079">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a substance such as a hormone or enzyme produced in a cell is passed through a plasma membrane to the outside, for example, the intestinal lumen or the blood (internal secretion).  Solid, liquid, or gaseous material passed from the inside of a cell through a plasma membrane to the outside as a result of cell activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>secretion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16080 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16080">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Water purification by natural biological and physicochemical processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>self-cleaning of water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16081 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16081">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Purification of the atmosphere from contaminants by natural biological and physicochemical processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>self-purification of the atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16082 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16082">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance produced by plants or animals, or a synthetic analogue thereof, that evokes a behavioral response in individuals of the producing species or other species (e.g., allomones, kairomones, pheromones, and synomones).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>semiochemical</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16124"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16083 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16083">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane that will preferentially allow certain molecules or ions to pass through it while preventing the passage of others.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>differentially permeable membrane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>selectively membrane</oboInOwl:hasRelatedSynonym>
        <rdfs:label>semipermeable membrane</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16084 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16084">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intensity, where the detection threshold level is defined as the lower limit of the perceived intensity range (by convention, the lowest concentration that can be detected in \(\pu{50\%}\) of the cases in which it is present). Quality, where the recognition threshold level is defined as the lowest concentration at which the sensory effect can be recognized correctly in \(\pu{50\%}\) of the cases. Acceptability and annoyance, where the nuisance threshold level is defined as the concentration at which not more than a small proportion of the population, less than \(\pu{5\%}\), experiences annoyance for a small part of the time, less than \(\pu{2\%}\).Note: Since annoyance will be influenced by a number of factors, a nuisance threshold level cannot be set on the basis of concentration alone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>sensory effect level</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16085 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16085">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fifteen-minute time-weighted average (TWA) exposure recommended by ACGIH which should not be exceeded at any time during a workday, even if the \(\pu{8 h}\) TWA is within the threshold limit value: time-weighted average, TLV-TWA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>STEL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Workers can be exposed to a maximum of four STEL periods per \(\pu{8 h}\) shift, with at least \(\pu{60 min}\) between exposure periods.</rdfs:comment>
        <rdfs:label>short-term exposure limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16139"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16143"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16085"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>STEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16086 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16086">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Action of a drug other than that desired for beneficial pharmacological effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>side-effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16087 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16087">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pneumoconiosis resulting from the inhalation of iron dust. Excess of iron in the urine, blood, or tissues, characterized by hemosiderin granules in urine and iron deposits in tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>siderosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15984"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16088 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16088">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cloud of small particles and gases that is given off from the end of a burning tobacco product (cigarette, pipe, cigar) between puffs and is not directly inhaled by the smoker.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>environmental tobacco smoke (ETS)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>secondhand smoke</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This is the smoke that gives rise to passive inhalation on the part of bystanders.</rdfs:comment>
        <rdfs:label>sidestream smoke</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16089 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16089">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Objective evidence of a disease, deformity, or an effect induced by an agent, perceptible to an examining physician.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>sign</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16090 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16090">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pneumoconiosis resulting from inhalation of silica dust.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>silicosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15984"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16091 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16091">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure designed to predict the rate of biodegradation of a compound under relevant environmental conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>simulation test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16092 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16092">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Osteosclerosis due to fluoride.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>skeletal fluorosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16093 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16093">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill slime-producing organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Used on paper stock, water cooling systems, paving stones, etc.</rdfs:comment>
        <rdfs:label>slimicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16094 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16094">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value, in inverse concentration or dose units, derived from the slope of a dose-response curve; in practice, limited to carcinogenic effects with the curve assumed to be linear at low concentrations or doses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The product of the slope factor and the exposure is taken to reflect the probability of producing the related effect.</rdfs:comment>
        <rdfs:label>slope factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16095 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16095">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total probability of harm to a human population including the probability of adverse effects to health of descendants and the probability of disruption resulting from loss of services such as industrial plant or loss of material goods and electricity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>population risk</oboInOwl:hasRelatedSynonym>
        <rdfs:label>societal risk</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16096 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16096">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental ratio of a substance’s concentration in the soil to that in the aqueous (dissolved) soil phase at equilibrium: It is valid only for the specific concentration and solid/solution ratio of the test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>soil partition coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15954"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16097 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16097">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deliberate inhalation (or drinking) of volatile solvents, in order to become intoxicated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>solvent sniffing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>solvent abuse</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16098 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16098">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Death rate computed for a subpopulation of individual organisms or people having a specified characteristic or attribute, and named accordingly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>specific death rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16099 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16099">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing an animal removed from its mother under sterile conditions just prior to term and subsequently reared and kept under sterile conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>SPF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>specific pathogen free</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16099"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SPF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16100 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16100">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent used in some pesticide formulations to extend the even disposition of the active ingredient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>spreader</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16101 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16101">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time required for the amount of a substance in a formulation to decrease, for any reason, by one-half (\(\pu{50\%}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>stability half time</oboInOwl:hasRelatedSynonym>
        <rdfs:label>stability half life</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16102 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16102">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the number of patients with a particular disease observed in a study group or population to the total number of people in the group or population multiplied by \(\pu{100}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>SMR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>standardized morbidity ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This ratio is usually expressed as a percentage.</rdfs:comment>
        <rdfs:label>standard morbidity ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16102"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SMR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16103 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16103">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the number of deaths observed in the study group or population to the number of deaths that would be expected if the study population had the same specific rates as the standard population, multiplied by \(\pu{100}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>SMR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>standardized mortality ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This ratio is usually expressed as a percentage.</rdfs:comment>
        <rdfs:label>standard mortality ratio</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16103"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SMR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16104 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16104">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pneumoconiosis resulting from inhalation of tin dust.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>stannosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15984"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16105 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16105">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Repeated over a short period, usually about \(\pu{10\%}\) of the life span; an imprecise term used to describe exposures of intermediate duration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>semichronic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subacute</oboInOwl:hasRelatedSynonym>
        <rdfs:label>subchronic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16106 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16106">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological change resulting from an environmental alteration lasting about \(\pu{10\%}\) of the lifetime of the test organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>In practice with experimental animals, such an effect is usually identified as resulting from multiple or continuous exposures occurring over three months (90 days). Sometimes a subchronic effect is distinguished from a subacute effect on the basis of its lasting for a much longer time.</rdfs:comment>
        <rdfs:label>subchronic effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16105"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16107 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16107">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal experiment serving to study the effects produced by the test substance when administered in repeated doses (or continually in food, drinking water, air) over a period of up to about 90 days.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>subchronic toxicity test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16108 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16108">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological change with detectable symptoms following exposure to an agent known to cause disease either before symptoms of the disease occur or when they are absent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>subclinical effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15644"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16109 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16109">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fertility below the normal range for a given species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>subfertility</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16110 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16110">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surrounding conditions as perceived by persons living in these conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>perceived environment</oboInOwl:hasRelatedSynonym>
        <rdfs:label>subjective environment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16111 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16111">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>According to the USEPA’s Guidelines for Carcinogen Risk Assessment, sufficient evidence is a collection of facts and scientific references that is definite enough to establish that an adverse effect is caused by the agent in question.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>sufficient evidence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16112 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16112">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum dose or concentration that on current understanding is likely to be tolerated by an exposed organism without producing any harm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>SNARL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>suggested no-adverse-response level</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16112"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SNARL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16113 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16113">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of irreversible cleavage complexes (also referred to as &apos;suicide complexes&apos;) leading to cell death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>suicide reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16114 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16114">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two-to-four page summary of a risk assessment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>summary sheet</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16115 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16115">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of addition of separate postsynaptic responses caused by stimuli that are adjacent in time and space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Excitation of a synapse evokes a graded potential change in the postsynaptic membrane that may be below the threshold required to trigger an impulse. If two or more such potentials are caused either nearly simultaneously, at different synapses on the same neuron (spatial summation), or in rapid succession at the same synapse (temporal summation), the summed response may be sufficient to trigger a postsynaptic impulse. Summation may occur between excitatory potentials, inhibitory potentials, or between an excitatory and an inhibitory potential.</rdfs:comment>
        <rdfs:label>summation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16116 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16116">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Federal authority, established by the U.S. Comprehensive Environmental Response, Compensation, and Liability Act (CERCLA) in 1980, to respond directly to releases or threatened releases (such as from landfills or waste disposal areas) of hazardous substances that may endanger health or welfare.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>Superfund</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16117 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16117">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzymatic antioxidant that removes the potentially toxic superoxide ion (\(\ce{O2^{-}}\)) by disproportionating it to \(\ce{O2}\) and hydrogen peroxide (\(\ce{H2O2}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>superoxide dismutase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16118 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16118">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relatively well studied toxicant whose properties are assumed to apply to an entire chemically and toxicologically related class.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>surrogate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16119 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16119">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing a group of organisms more vulnerable to a given exposure than the majority of the population to which they belong.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>vulnerable</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Susceptibility may reflect gender, age, physiological status, or genetic constitution of the organisms at risk.</rdfs:comment>
        <rdfs:label>susceptible</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16120 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16120">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>adj., Blocking transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues. n., Agent that blocks transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>anti-adrenergic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sympatholytic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16121 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16121">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any subjective evidence of a disease or an effect induced by a substance as perceived by the affected subject.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16122 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16122">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>General description of all of the signs and symptoms of exposure to a toxicant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Signs are the overt (observable) responses associated with exposure (such as convulsions, death, etc.), whereas symptoms are covert (subjective) responses (such as nausea, headache, etc.).</rdfs:comment>
        <rdfs:label>symptomatology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16123 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16123">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that contributes more than additively to a mutual effect with another substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>synergist</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16124 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16124">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semiochemical that is produced by one organism inducing a response in an organism of another species that is favorable to both the emitter and the responding organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>synomone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16082"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16125 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16125">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Property of genes which reside on the same chromosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>synteny</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16126 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16126">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subset selected according to some simple rule such as specified date or alphabetic classification.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>systematic sample</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16127 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16127">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prefix meaning rapid as in tachycardia and tachypnoea.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tachy-</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16128"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16128 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16128">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally fast breathing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tachypnoea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15523"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16129 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16129">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill tapeworms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>taeniacide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16130 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16130">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of individuals, items, measurements, etc. about which inferences are required: The term is sometimes used to indicate the population from which a sample is drawn and sometimes to denote any reference population about which inferences are needed. Group of persons for whom an intervention is planned.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>target population</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16131 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16131">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value for the acceptable daily intake (ADI) proposed for guidance when data are sufficient to conclude that use of the substance is safe over the relatively short period of time required to generate and evaluate further safety data, but are insufficient to conclude that use of the substance is safe over a lifetime.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>A higher-than-normal safety factor is used when establishing a temporary ADI, and an expiration date is established by which time appropriate data to resolve the safety issue should be available.</rdfs:comment>
        <rdfs:label>temporary acceptable daily intake</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16132 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16132">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regulatory value established for a specified, limited time when only a temporary acceptable daily intake has been established for the pesticide concerned or, with the existence of an agreed acceptable daily intake, the available residue data are inadequate for firm maximum residue recommendations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>temporary maximum residue limit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16133 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16133">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In toxicology, evaluation of the therapeutic and potentially toxic effects of substances by their application through relevant routes of exposure with appropriate organisms or biological systems so as to relate effects to dose following application. In chemistry, qualitative or quantitative analysis by the application of one or more fixed methods and comparison of the results with established standards.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>testing of chemicals</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16134 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16134">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Predicted maximum daily intake of a residue, assuming that it is present at the maximum residue level and that average daily consumption of foods per person is represented by assessed regional diets: It is expressed in milligrams of residue per person per day.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TMDI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>theoretical maximum daily intake</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15871"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16134"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TMDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16135 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16135">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generation and manipulation of stem cells with the objective of deriving cells of a particular organ or tissue to treat a disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>therapeutic cloning</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16136 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16136">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose or exposure concentration below which a defined effect will not occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>threshold concentration</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>threshold dose</oboInOwl:hasRelatedSynonym>
        <rdfs:label>threshold</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15681"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16137 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16137">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>As defined by ACGIH, concentration of a potentially toxic substance that should not be exceeded during any part of the working exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TLV-C</oboInOwl:hasRelatedSynonym>
        <rdfs:label>threshold limit value–ceiling</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16137"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TLV-C</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16138 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16138">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>As defined by ACGIH, concentration to which it is believed that workers can be exposed continuously for a short period of time without suffering from (1) irritation, (2) chronic or irreversible tissue damage, or (3) narcosis of sufficient degree to increase the likelihood of accidental injury, impair self-rescue or materially reduce work efficiency, and provided that the daily TLV-TWA is not exceeded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TLV–STEL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is not a separate independent exposure guideline; rather, it supplements the TLV-TWA limit where there are recognized acute effects from a substance whose toxic effects are primarily of a chronic nature. TLV-STELs are recommended only where toxic effects have been reported from high short-term exposures in either humans or animals.</rdfs:comment>
        <rdfs:label>threshold limit value–short-term exposure limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16138"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TLV–STEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16139 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16139">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>As defined by ACGIH, time-weighted average concentration for a conventional \(\pu{8\!\mbox{-}h}\) workday and a \(\pu{40\!\mbox{-}h}\) workweek, to which it is believed nearly all workers may be repeatedly exposed, day after day, without adverse effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TLV–TWA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>threshold limit value–time-weighted average</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16143"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16139"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TLV–TWA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16140 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16140">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Human exposure threshold value for a group of chemicals below which there should be no appreciable risk to human health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TTC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>threshold of toxicological concern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16140"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TTC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16141 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16141">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition resulting from excessive concentrations of thyroid hormones, as in hyperthyroidism, characterized by bulging eyes and rapid heart rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>thyrotoxicosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16142 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16142">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity of air or test gas that is inhaled and exhaled during one respiratory cycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tidal volume</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16143 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16143">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration in the exposure medium at each measured time interval multiplied by that time interval and divided by the total time of observation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TWAE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>time-weighted-average concentration (TWAC)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For occupational exposure, a working shift of \(\pu{8\!\mbox{-}h}\) is commonly used as the averaging time.</rdfs:comment>
        <rdfs:label>time-weighted-average-exposure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16143"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TWAE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16144 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16144">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of a substance or physical agent (radiation) absorbed by a tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tissue dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16145 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16145">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the amount of a potentially harmful substance (e.g., contaminant) in food or drinking water that can be ingested daily over a lifetime without appreciable health risk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TDI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Acceptable daily intake is normally used for substances not known to be harmful, such as food additives.</rdfs:comment>
        <rdfs:comment>For regulation of substances that cannot be easily avoided, a provisionally tolerable weekly intake (PTWI) may be applied as a temporary limit.</rdfs:comment>
        <rdfs:label>tolerable daily intake</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16147"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16145"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16146 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16146">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability of suffering disease or injury that can, for the time being, be tolerated, taking into account the associated benefits, and assuming that the risk is minimized by appropriate control procedures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tolerable risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16147 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16147">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the amount of a potentially harmful substance (e.g., a contaminant) in food or drinking water that can be ingested weekly over a lifetime without appreciable health risk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TWI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>provisional tolerable weekly intake (PTWI)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tolerable weekly intake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16147"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TWI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16148 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16148">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characterized by tension, especially muscular tension. Medical preparation that increases or restores normal muscular tension.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tonic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16149 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16149">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Applied directly to the surface of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>topical</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16150 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16150">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Potentially lethal form of ventricular tachycardia following chronic abuse of alcohol and mainly due to hypomagnesemia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>torsade de pointes</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16151 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16151">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study designed to establish the pattern of pesticide residue intake by a person consuming a defined diet. Study undertaken to show the range and amount of various foodstuffs in a typical diet or to estimate the total amount of a specific substance in a typical diet.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>total diet study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16152 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16152">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Summation of levels of all the residues of a defined pesticide in a food.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>total terminal residue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16049"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16153 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16153">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which the blood contains toxins produced by body cells at a local source of infection or derived from the growth of microorganisms. Pregnancy-related condition characterized by high blood pressure, swelling, and fluid retention, and proteins in the urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>blood poisoning</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toxemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16154 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16154">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of a substance that produces intoxication without lethal outcome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>superthreshold dose</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toxic dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16155 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16155">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental study of the adverse effects of exposure of a living organism to a substance for a defined duration under defined conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>toxicity test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16156 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16156">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scientific subdiscipline that combines toxicology with genomics to determine how an organism’s genetic make-up influences its response to a toxic substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>toxicogenomics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16157 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16157">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Document that gives in a uniform manner data relating to the toxicology of a substance, its production and application, properties and methods of identification.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The data sheet may also include recommendations on protective measures.</rdfs:comment>
        <rdfs:label>toxicological data sheet</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16158 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16158">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term sometimes used to indicate a combination of investigative methods and techniques for making a quantitative assessment of toxicity and the hazards of potentially toxic substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>toxicometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16159 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16159">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Morbid dread of poisons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>toxicophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16160 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16160">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural moiety that upon metabolic activation exerts toxic effects: The presence of a toxicophoric group indicates only potential and not necessarily actual toxicity of a drug or other substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>toxogenic group</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>toxophoric group</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toxicophoric group</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16161 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16161">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Active process of identification, investigation, and evaluation of various toxic effects in the community with a view to taking measures to reduce or control exposure(s) involving the substance(s) which produces these effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>toxicovigilance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16162 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16162">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metabolic conversion of a potentially toxic substance to a product that is more toxic.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>toxification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16163 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16163">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that can be tracked through one or more reactions or systems, often by detecting an incorporated isotope.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tracer substance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16164 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16164">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total mRNA expressed in a cell or tissue at a given point in time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>transcriptome</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16165 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16165">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Global analysis of gene expression to identify and evaluate changes in synthesis of mRNA after chemical exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>transcriptomics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16166 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16166">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell that has become genetically altered spontaneously or by incorporation of foreign DNA to produce a cell with an extended lifetime in culture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>transformed cell</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16167 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16167">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene from one source that has been incorporated into the genome of another organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>transgene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16168 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16168">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In relation to waste water, the amenability of substances to removal without adversely affecting the normal operation of biological treatment processes (such as a sewage treatment plant).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>treatability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16169 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16169">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process for sorting people into groups based on their need for or likely benefit from immediate medical treatment. Note: Triage is used in hospital emergency rooms, on battlefields, and at disaster sites when limited medical resources must be allocated. System used to allocate a scarce commodity, such as food, to those most likely to benefit from it. Process in which things are ranked in terms of importance or priority.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>triage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16170 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16170">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Closeness of agreement between the average of a theoretically infinite number of replicate measured quantity values and a reference quantity value.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>trueness</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16171 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16171">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transfer of solutes from the renal tubule lumen to the tubular epithelial cell and normally from there to the peritubular fluid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tubular reabsorption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16172 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16172">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Able to cause tumors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tumorigenic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16173 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16173">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of changes by which a benign tumor develops from the initial lesion to a malignant stage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>tumor progression</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15502"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16174 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16174">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene that serves to protect cells from entering a cancerous state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>According to Knudson’s &quot;two-hit&quot; hypothesis, both alleles of a particular tumor suppressor gene must acquire a mutation before the cell will enter a transformed state.</rdfs:comment>
        <rdfs:label>tumor suppressor gene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16175 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16175">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Product of compartmental analysis requiring two compartments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>two-compartment model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15898"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16176 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16176">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defect, often associated with inflammation, occurring locally or at the surface of an organ or tissue owing to sloughing of necrotic tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ulcer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16177 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16177">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parameter characterizing the dispersion of the quantity values being attributed to a measurand, based on the information used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>measurement uncertainty</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The parameter may be, for example, a standard deviation or the half width of an interval, having a stated coverage probability.</rdfs:comment>
        <rdfs:label>uncertainty</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16178 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16178">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Upper-bound excess lifetime cancer risk estimated to result from continuous exposure to an agent at a concentration of \(\pu{1 \upmu g L-1}\) in water, or \(\pu{1 \upmu g m-3}\) in air.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>The interpretation of unit risk is as follows: if unit risk = \(\pu{1.5E-6 \upmu g L-1}\), \(\pu{1.5}\) excess tumors are expected to develop per \(\pu{1000000}\) or \(\pu{E6}\) people if exposed daily for a lifetime to \(\pu{1 \upmu g}\) of the chemical in \(\pu{1 L}\) of drinking water.</rdfs:comment>
        <rdfs:label>unit risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16179 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16179">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the plausible upper limit to the true value of a quantity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>This is usually not a statistical confidence limit.</rdfs:comment>
        <rdfs:label>upper boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16180 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16180">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vascular reaction of the skin marked by the transient appearance of smooth, slightly elevated patches (wheals, hives) that are redder or paler than the surrounding skin and often attended by severe itching.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>urticaria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16181 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16181">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane-bound cavity within a cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>vacuole</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16182 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16182">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Expression of the degree to which a measurement measures what it purports to measure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>validity of a measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16183 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16183">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degree to which the inferences drawn, especially generalizations extending beyond the study sample, are warranted when account is taken of the study methods, the representativeness of the study sample, and the nature of the population from which it is drawn.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>validity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16184 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16184">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in the caliber of the blood vessels, leading to an increased blood flow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>vasodilation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16185 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16185">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance(s) used to formulate active ingredients for administration or use.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>In this context, it is a general term for solvents, suspending agents, etc.</rdfs:comment>
        <rdfs:label>vehicle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16186 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16186">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of supplying a building or room with fresh air. Process of exchange of air between the ambient atmosphere and the lungs. In physiology, the amount of air inhaled per day. Oxygenation of blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ventilation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16187 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16187">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Irregular heartbeat characterized by uncoordinated contractions of the ventricle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ventricular fibrillation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16188 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16188">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill intestinal worms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>vermicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16189 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16189">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>adj., Producing blisters on the skin. n., Substance that causes blisters on the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>vesicant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16190 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16190">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Human exposure over a lifetime to a carcinogen which has been estimated, using mathematical modeling, to result in a very low incidence of cancer, somewhere between zero and a specified incidence (e.g., 1 cancer in \(\pu{1000000}\) exposed people).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>VSD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>virtually safe dose</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16190"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VSD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16191 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16191">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to control viruses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>antiviral</oboInOwl:hasRelatedSynonym>
        <rdfs:label>virucide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16192 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16192">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease marked by weight loss and atrophy of muscular and other connective tissues that is not directly related to a decrease in food and water consumption.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>wasting syndrome</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16193 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16193">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difference in free energy or chemical potential (per unit molal volume) between pure water and water in cells and solutions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>water potential</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16194 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16194">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extent to which the available biomedical data support the hypothesis that a substance causes a defined toxic effect such as cancer in humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>weight-of-evidence for toxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16195 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16195">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Space measuring up to \(\pu{2 m}\) over the level of the floor or platform that contains a worker’s permanent or temporary station.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>working zone</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16196 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16196">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hyperkeratotic disease in cattle following exposure to chlorinated dibenzo-p-dioxins, naphthalenes, and related compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>x-disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16197 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16197">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Kinetics of a reaction in which the rate is independent of the concentration(s) of the reactants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>zero-order kinetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15842"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16198 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16198">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>zoocide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16199 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16199">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecular species that can rapidly be converted from inactive into active form by light. Typically, photocaged compounds have a covalently attached group that can be photocleaved by electromagnetic radiation of a specific wavelength.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>An example is the photorelease of nucleotides from their attachment to 1-(4,5-dimethoxy-2-nitrophenyl) ethyl ester.</rdfs:comment>
        <rdfs:comment>Electromagnetic radiation activated caged compounds (photocages) are widely used in biochemistry for a rapid photoinduced introduction of a variety of compounds to biological systems with spatial and temporal control, allowing the time-resolved study of the ensuing events.</rdfs:comment>
        <rdfs:label>caged compound</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16214"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16200 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16200">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electronic absorption corresponding to a charge-transfer transition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <oboInOwl:hasRelatedSynonym>CT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CT absorption</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In some cases, the charge-transfer absorption band(s) may be strongly obscured by the local absorptions of the donor and acceptor systems.</rdfs:comment>
        <rdfs:label>charge-transfer absorption</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16200"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16201 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16201">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photoinduced geometric isomerization about a double bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>Geometrical isomerization of a \(\ce{C-C}\) double bond is called a cis/trans isomerization in 1,2-disubstituted alkenes. \(E/Z\) isomerization is a more general designation applying also to higher substituted alkenes.</rdfs:comment>
        <rdfs:comment>In a \(\ce{C-C}\) double bond, a geometrical cis/trans (or \(E/Z\)) isomerization implies a \(\pu{180\!^{\circ}}\) rotation (except when modified by steric interactions), whereas in other bonds the mechanism might be different, e.g., in azocompounds, a cis/trans photoisomerization may occur through an inversion at a \(\ce{N}\) center.</rdfs:comment>
        <rdfs:comment>Photochemical pathways for cis/trans isomerization have the advantage over thermal and catalytic methods of giving equilibrium cis/trans mixtures (photostationary states) rich in thermodynamically unstable isomers.</rdfs:comment>
        <rdfs:label>cis/trans photoisomerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16202 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16202">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Efficiency of light emission for solid-state light-emitting devices, such as organic light-emitting devices (OLEDs). Analogous to emission quantum yield.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>external quantum efficiency</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16203 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16203">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Squared modulus of the overlap integral between the vibrational wave functions (\(\mathit{\Theta}\)) for the initial (0) and final (\(\rm{e}\)) state of a given electronic transition. \[\left\vert \int \mathit{\Theta} _{\rm{v&apos;}}^{(\rm{e})} \mathit{\Theta} _{\rm{v}}^{(0)} dQ \right\vert^{2}\] where the integration is over all nuclear coordinates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>Franck–Condon factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16205 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16205">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Correlation of the Stokes-shift, \(\Delta \tilde{ u}\), between the absorption and emission maxima, and the orientation polarizability \(f(\varepsilon_{\rm{r}},n)\) of the solvent,\[\Delta \tilde{ u} = 2 \frac{(\boldsymbol{\mu}_{\rm{exc}} - \boldsymbol{\mu}_{\rm{gr}})^{2}}{c h r^{3}} f(\varepsilon_{\rm{r}},n) + {\rm{const.}}\]with \(\boldsymbol{\mu}_{\rm{exc}}\) and \(\boldsymbol{\mu}_{\rm{gr}}\) the excited- and ground-state dipole moments of the dissolved molecule, respectively, \(c\) the speed of light, \(h\) the Planck constant, \(r\) the radius of the cavity in which the solute resides, and \(\varepsilon_{\rm{r}}\) the &apos;relative static permittivity&apos; (formerly called dielectric constant). The expression of the Stokes shift depends only on the absolute magnitude of the difference between dipole moments and not on the angle between the dipoles. The above equation is sometimes called the Lippert equation. The orientation polarizability is given by\[f(\varepsilon_{\rm{r}},n) = \frac{(\varepsilon_{\rm{r}} - 1)}{(2\varepsilon_{\rm{r}} + 1)} - \frac{(n^{2} - 1)}{(2n^{2} + 1)}\]with \(\varepsilon_{\rm{r}}\) the relative static permittivity and \(n\) the refractive index of the solvent, \(f(\varepsilon_{\rm{r}},n)\) ranges from \(\pu{0.001}\) in cyclohexane to \(\pu{0.320}\) in water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>The assumptions made in theories of solvatochromic shifts, together with the uncertainty over the size and shape of the cavity radius \(r\), explain the inaccuracies in the determined excited-state dipole moments.</rdfs:comment>
        <rdfs:comment>\(\Delta \tilde{\nu}\) as a function of \(f(\varepsilon_{\rm{r}},n)\) (Lippert plot), is used to determine the difference in dipole moment (\(\boldsymbol{\mu}_{\rm{exc}} - \boldsymbol{\mu}_{\rm{gr}}\)) between a molecule in the equilibrated excited state and in the ground state, as a measure of the change in charge distribution brought about by light absorption. In this method, it is assumed that the dipole moments do not depend on solvent polarity. A linear variation is not always observed because only dipole-dipole interactions are taken into account and the solute polarizability is neglected.</rdfs:comment>
        <rdfs:label>Lippert–Mataga equation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16206 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16206">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Caged fluorophores displaying a high fluorescent enhancement after photolysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>photocaged fluorescent molecules</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16199"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16207 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16207">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photoinduced substitution in an aromatic compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>photochemical aromatic substitution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16209"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16215"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16216"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16208 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16208">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photosubstitution in electron-rich aromatic compounds, upon reaction with electron-deficient olefins, occurring in polar solvents through an electron-transfer pathway.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <oboInOwl:hasRelatedSynonym>photo-EOCAS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In nonpolar solvents, the reaction follows a different course.</rdfs:comment>
        <rdfs:label>aromatic substitution photochemical electrophile-olefin combination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16209"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16210"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16216"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16209 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16209">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photoinduced electron-transfer reaction of an aromatic electron-acceptor in the presence of an olefinic electron donor and a nucleophile, leading to aromatic substitution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <oboInOwl:hasRelatedSynonym>photo-NOCAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>photochemical nucleophile-olefin combination - aromatic substitution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16210"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16210 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16210">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regioselective combination of a radical, an olefin, and an arene via a photoinduced electron-transfer pathway.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <oboInOwl:hasRelatedSynonym>photo-ROCAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>aromatic substitution photochemical radical-olefin combination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16209"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16211 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16211">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photochemical induction of molecular chirality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>photochirogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16212 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16212">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A special case of phototautomerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>photoenolisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16217"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16213 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16213">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photoinduced change in refractive index.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>photorefractive effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16214 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16214">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Release of a reactive species by photolysis of a molecular entity. The release may be induced by direct excitation, by triplet sensitization, or by photoinduced electron transfer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <oboInOwl:hasRelatedSynonym>PPG</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Bioactive molecular species that are inactivated by a photoremovable protecting group are often called caged compounds or photocages (e.g., ATP).</rdfs:comment>
        <rdfs:comment>Photoremovable protecting groups have numerous applications in synthesis (&quot;orthogonal deprotection&quot;), biochip production, imaging, time-resolved X-ray crystallography, etc. When excited with pulsed lasers, photoremovable protecting groups that release bioactive molecular species such as neurotransmitters rapidly can provide spatial and temporal control of their concentration, so that physiological response times can be determined.</rdfs:comment>
        <rdfs:label>photoremovable protecting group</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16199"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16214"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PPG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16215 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16215">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nucleophilic substitution in a substrate through processes that involve electron transfer steps. The reaction occurs through chain steps. The most extensively used method of initiation is photoinitiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>Many types of compounds, i.e., aliphatic and aromatic species, such as perfluoroalkyl-, cycloalkyl-, neopentyl-, bridgehead-, and alkylmercury halides, as well as carbanions derived from various compounds, are substrates in \(S_{\rm{RN}}1\) reactions.</rdfs:comment>
        <rdfs:label>photostimulated unimolecular radical nucleophilic substitution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16216 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16216">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photochemical process leading to a substitution reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:label>photosubstitution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16217 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16217">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photoisomerization of the general form \[\ce{G-X-Y=Z [h u] X=Y-Z-G}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>The commonest case, when \(\rm{G} = \ce{H^{+}}\), is also known as &quot;prototropy&quot;.</rdfs:comment>
        <rdfs:label>phototautomerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16218 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16218">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The negative of the standard Gibbs energy change (i.e., \(-\Delta G^{\circ}\)) for outer-sphere electron transfer in polar solvents, where the electrostatic work terms in the expression used for the calculation of the Gibbs energy of photoinduced electron transfer are in general negligibly small.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>The work term might not be negligibly small even in polar solvents for large molecules undergoing a large change in dipole moment upon electron transfer.</rdfs:comment>
        <rdfs:label>polar driving force</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16219 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16219">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In absorption experiments, polarization spectroscopy is performed with polarized light on anisotropic samples.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>Spectroscopy with natural (unpolarized) light on anisotropic samples will show directional effects, since the electric vectors of natural light are not isotropic, but are restricted to a plane perpendicular to the beam. In two-photon processes, for example, luminescence measured with linear polarizers in both beams, an aligned sample is not required since it will be created by the exciting photon through photoselection. However, aligned samples allow a larger number of independent experiments to be recorded and thus contain more information.</rdfs:comment>
        <rdfs:label>polarisation spectroscopy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16221 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16221">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Derivative of fluence, \(H_{\rm{o}}\), with respect to wavelength, _010366_.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779030293"/>
        <rdfs:comment>All spectral terms may also be defined as derivatives with respect to frequency, \(\nu\), or wavenumber, \(\tilde{\nu}\), and are referred to, when necessary, as in terms of wavelength or frequency or wavenumber, respectively.</rdfs:comment>
        <rdfs:label>spectral fluence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16224 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16224">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the correlations between phenotypic trends and genetic variation across population groups and the application of the results of such a study to control of health problems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>genetic epidemiology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16225 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16225">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value obtained by dividing the probability of occurrence of a specific effect in one group by the probability of occurrence of the same effect in another group, or the value obtained by dividing the probability of occurrence of one potentially hazardous event by the probability of occurrence of another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Calculation of such ratios is used in choosing between options in risk management.</rdfs:comment>
        <rdfs:label>risk ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16226 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16226">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the measure of the effects (e.g., \(\pu{LD_{50}}\), \(\pu{LC_{50}}\), NOEC) to the estimated exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>TER</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is the reciprocal of a risk quotient or hazard quotient.</rdfs:comment>
        <rdfs:label>toxicity exposure ratio</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16226"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TER</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16228 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16228">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain entanglement with topology similar to that of a bowtie.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779101801"/>
        <oboInOwl:hasRelatedSynonym>butterfly entanglement</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bowtie entanglement</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16229 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16229">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Effect of finite duration occurring rapidly (usually in the first \(\pu{24 h}\) or up to \(\pu{14 d}\)) following a single dose or short exposure to a substance or radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:label>acute effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16230 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16230">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exposure of short duration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:label>acute exposure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16232"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16231 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16231">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Long-term (in relation to exposure or effect).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:comment>In clinical medicine, long-established or long-lasting.</rdfs:comment>
        <rdfs:comment>In experimental toxicology, chronic refers to mammalian studies lasting considerably more than 90 days or to studies occupying a large part of the lifetime of an organism.</rdfs:comment>
        <rdfs:label>chronic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16232 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16232">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Continued exposures occurring over an extended period of time, or a significant fraction of the test species’ or of the group of individuals’, or of the population’s lifetime.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <oboInOwl:hasRelatedSynonym>long-term exposure</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chronic exposure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16230"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16233 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16233">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Statistical lower CL on the concentration that produces a defined response (called the benchmark response or BMR, usually \(\pu{5\%}\) or \(\pu{100\%}\)) for an adverse effect compared to background, defined as \(\pu{0\%}\).Dose–response curve showing BMC and BMCL (BMC 10 % lower CL).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <oboInOwl:hasRelatedSynonym>BMC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>benchmark concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16233"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BMC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16234 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16234">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mathematical modeling of kinetic behavior of a substance, based on measured physiological parameters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <oboInOwl:hasRelatedSynonym>PBPK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>toxicologically based pharmacokinetic modeling</oboInOwl:hasRelatedSynonym>
        <rdfs:label>physiologically based pharmacokinetic modeling</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16234"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PBPK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16235 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16235">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenomenon committed to a particular outcome determined by fundamental physical principles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <oboInOwl:hasRelatedSynonym>deterministic process</oboInOwl:hasRelatedSynonym>
        <rdfs:label>deterministic effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16236 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16236">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to or arising from chance and hence obeying the laws of probability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:label>stochastic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16237 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16237">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in biochemistry, morphology, physiology, growth, development, or lifespan of an organism which results in impairment of functional capacity or impairment of capacity to compensate for additional stress or increase in susceptibility to other environmental influences.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:label>effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16238 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16238">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Derivative with respect to time of the concentration or amount of a substance in the body, or a part thereof, resulting from elimination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:label>elimination rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16239 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16239">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change occurring at the site of contact between an organism and a toxicant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:label>local effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16240 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16240">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>This is the preferred term for a substance that is considered to be toxic under circumstances which are thought likely to happen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:comment>This word comes from the Greek toxikos &quot;of or for the bow&quot; and was originally applied to the poison used to tip arrows. The term &quot;poison&quot; is nearly a synonym, but tends to be applied to substances that may be deliberately used for poisoning, such as pesticides, and often has overtones of criminal use.</rdfs:comment>
        <rdfs:label>toxicant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16241 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16241">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any drug or remedy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779091583"/>
        <rdfs:comment>This definition depends on usage. Any substance, e.g., herbs, willow bark, or honey, may be used as a drug or a remedy and, as always, the end effect will depend on the dose.</rdfs:comment>
        <rdfs:label>medicine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16242 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16242">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion of solid electrically charged particles, commonly larger in size range than colloidal particles (of approximate diameter range \(\pu{{1}{-}{1000} nm}\)) (dispersed phase), in water or an aqueous solution (continuous, liquid phase).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779010081"/>
        <rdfs:comment>Suspension can be a uniform system, i.e., an optically equable (uniform) mixture of both phases, or a combined system in which a part of the liquid phase of the equilibrated suspension eqs is separated from the rest of the suspension. By sedimentation of particles, a concentrated phase (sediment) can be formed, in which particles are still surrounded by the intrinsic liquid phase, the eqs. Both parts remain in physical and electrical contact.</rdfs:comment>
        <rdfs:label>suspension of solid charged particles</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16243 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16243">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Galvanic cell containing, as its essential component, a uniform or combined suspension or one of its separated parts alone, the eqs or sediment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779010081"/>
        <rdfs:label>suspension potentiometric cell</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16244 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16244">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrochemical potential that arises at the reference electrode–measurement solution interface when, during a potentiometric measurement, the filling solution of the salt bridge of the reference electrode contacts the charged particles of a suspension.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779010081"/>
        <rdfs:comment>The value of the anomalous liquid junction potential can exceed significantly the commonly occurring liquid junction potential, depending on the suspension species and the concentration of the filling solution. The contact between the electrolyte in the reference electrode (or its salt bridge) and the charged particles can change the ion arrangement around the particles and modify the approximate equality of the ion transport numbers in the electrolyte diffusion front (e.g., by ion exchange of \(\ce{H^{+}}\) or \(\ce{OH^{-}}\)); this ion exchange will diminish the suppression of the diffusion potential.</rdfs:comment>
        <rdfs:label>anomalous liquid junction potential</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16245 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16245">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>General mathematical expression form of any ion X activity: \[\rm{p(ion\ X)} = {\rm{pX}} = -\lg {\rm{a_{X}}} = -\lg ({\rm{m_{X}} \gamma_{X}/m^{\circ}})\], analogously to \[\pu{pH} = -\lg {\rm{a_{H}}} = -\lg ({\rm{m_{H}} \gamma_{H}/m^{\circ}})\].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779010081"/>
        <rdfs:comment>Practical pIon measurement with the proper reversible ISE can be carried out by means of a galvanic cell, composed correspondently to cell V. The accuracy and uncertainty of results obtained with ISEs depend analogously as in pH measurement for all on validity of standard solutions used, if the common guidelines for potentiometric measurement are taken in account.</rdfs:comment>
        <rdfs:comment>The term &quot;pIon&quot; is used mainly in the literature, oriented to the practical routine work.</rdfs:comment>
        <rdfs:label>pIon</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16246 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16246">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Readings on a pH-meter scale obtained for a suspension of soil (in water or electrolyte) by any method for potentiometric pH measurement, performed in a manner analogous to the pH measurement in solutions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779010081"/>
        <oboInOwl:hasRelatedSynonym>soil suspension pH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>suspension soil pH</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most of the reported &quot;suspension (soil) pH&quot; values have no known quantitative connection with the hydrogen ion activity in suspensions; nevertheless, they are more or less repeatable characteristic values of the measured suspensions.</rdfs:comment>
        <rdfs:label>suspension pH</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16247 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16247">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Atom that is part of two or more rings in a polycyclic molecule and that is separated from another bridgehead atom by bridges all of which contain at least one other atom.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2018-1010"/>
        <oboInOwl:hasRelatedSynonym>bridgehead</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bridgehead atom</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16248 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16248">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Feature of a reaction in which only one molecular entity is involved.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2018-1010"/>
        <rdfs:label>unimolecular</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16249 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16249">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process for converting a starting initiator or chain transfer agent into a macro-initiator or macro-chain-transfer agent during reversible-deactivation polymerization (RDP).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2020-1211"/>
        <rdfs:comment>In RAFT polymerization, initialization is sometimes known as the pre-equilibrium step.</rdfs:comment>
        <rdfs:label>initialisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.08912"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.08935"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.08947"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.08962"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.08963"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16250 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16250">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule or compound designed to support, transport, and/or deliver one or several active species in order to take advantage of their specificity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2020-0502"/>
        <rdfs:label>conjugate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16251 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16251">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Negative Napierian logarithm of the ratio of the intensity of radiation scattered (\(I_{\rm{s}}\)) by a non-absorbing sample to the incident intensity (\(I_{0}\)), divided by the path-length, \(l\). \[s = -\ln(I_{s}/I_{0})/l\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2019-0203"/>
        <rdfs:comment>SI unit: \(\pu{m-1}\).</rdfs:comment>
        <rdfs:label>scattering coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.08278"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16252 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16252">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For an optical fibre, \(n_{\rm{o}}\) sin \(\theta_{\alpha}\), where \(n_{\rm{o}}\) is the refractive index of the exterior medium and \(\theta_{\alpha}\) is the maximum input half angle that can support propagation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2019-0203"/>
        <oboInOwl:hasRelatedSynonym>NA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>numerical aperture</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.16252"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16253 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16253">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Activity of a specified radionuclide (\(\ce{R}\)) in a material (\(\ce{M}\)) divided by amount of substance of that material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2019-0302"/>
        <rdfs:comment>If the term &apos;molar activity&apos; is used without qualification, it should be made clear whether it refers to a material or a radionuclide. See: molar activity of a radionuclide.</rdfs:comment>
        <rdfs:comment>The SI unit of molar activity is \(\pu{Bq mol-1}\), but molar activity is often expressed in unit \(\pu{Ci mmol-1}\). (Curie, symbol \(\pu{Ci}\), is a former unit of activity equal to exactly \(\pu{3.7E10 Bq}\).)</rdfs:comment>
        <rdfs:label>molar activity (material)</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.08763"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16254 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16254">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Response of an ion-selective electrode according to a local thermodynamic equilibrium, over a given range of activity (or concentration) that follows the Nernst equation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2018-0109"/>
        <rdfs:comment>For the Nernstian response, the potential difference of the ion-selective electrode cell is proportional to the decadic logarithm of the ionic activity of a given species (\(a_{\rm{A}}\)) with coefficient \((RT/z_{\rm{A}}F)/\log_{10}(\rm{e})\) (about \(0.0592/z_{\rm{A}}\,\pu{V}\) at \(\pu{298.15 K}\)), where \(R\) is the gas constant, \(T\) the thermodynamic temperature, \(F\) the Faraday constant, and \(z_{\rm{A}}\) the electron number of an electrochemical reaction of species \(\ce{A}\).</rdfs:comment>
        <rdfs:comment>Nernstian response implies ideal sensitivity, but not necessarily ideal selectivity, since interfering ions may also give a Nernstian response when they are present as the sole potential determining species.</rdfs:comment>
        <rdfs:label>Nernstian response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09063"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09068"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16256 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16256">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique in chromatography in which the sample is chemically derivatized before entering the column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <rdfs:label>pre-column derivatisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16257 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16257">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of the mobile phase divided by volume of the stationary phase in a column in counter-current chromatography.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <rdfs:comment>It is recommended that phase ratio in counter-current chromatography be given the subscript V (i.e. \(\beta_{\rm{V}} = V_{\rm{M}}/V_{\rm{S}}\)) to emphasize phase volume ratio.</rdfs:comment>
        <rdfs:comment>The \(\beta\) in counter-current chromatography has been defined as the ratio of planetary radius (\(r\)) over main rotor radius (\(R\)), \(\beta = r/R\).</rdfs:comment>
        <rdfs:comment>The stationary phase volume retention ratio (\(S_{\rm{f}}\)) has been defined as the ratio of the volume of stationary phase (\(V_{\rm{s}}\)) to the total column/coil volume (\(V_{\rm{c}}\)), \(S_{\rm{f}} = V_{\rm{s}}/V_{\rm{c}}\).</rdfs:comment>
        <rdfs:label>phase volume ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09887"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16258 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16258">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sum of the interparticle volume of the column and intraparticle volume of the column: \(V_{\rm{t}} = V_{0} + V_{\rm{i}}\)</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <rdfs:comment>In the definition of \(V_{\rm{t}}\) the extra-column volume of the system (\(V_{\rm{ext}}\)) is neglected. If it is not negligible, it must also be added: \[V_{\rm{t}} = V_{0} + V_{\rm{i}} + V_{\rm{ext}}\]</rdfs:comment>
        <rdfs:label>total mobile-phase volume in column</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16259 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16259">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Retention time of a sample component, the molecules of which are smaller than the largest pores of the particles of the stationary phase but larger than the smallest pores.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <rdfs:comment>The retention time is related to the retention volume (in size-exclusion chromatography) (\(V_{\rm{R}}\)) and the flow rate (\(F_{\rm{c}}\)) by \(t_{\rm{R}} = V_{\rm{R}}/F_{\rm{c}}\) .</rdfs:comment>
        <rdfs:label>retention time</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09963"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16260 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16260">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Retention time of a sample component the molecules of which are smaller than the smallest pores of the particles of the stationary phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <rdfs:comment>The total mobile phase time is related to the total mobile phase volume (in size-exclusion chromatography) (\(V_{\rm{t}}\)) and the flow rate (\(F_{\rm{c}}\)) by \(t_{\rm{t}} = V_{\rm{t}}/F_{\rm{c}}\) .</rdfs:comment>
        <rdfs:label>total mobile phase time</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16261 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16261">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phase in lung development beginning in utero (about \(\pu{32}\) to \(\pu{36}\) weeks in the human fetus) and lasting until about eight years of age.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>alveolar phase</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In this phase, the terminal alveolar saccules subdivide several more times, giving rise to the mature alveoli.</rdfs:comment>
        <rdfs:label>alveolar period</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10359"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10862"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16262 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16262">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fibroblast-derived bone-forming cell that produces a collagen type-I-rich matrix; this matrix calcifies to become bone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>osteoblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10719"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16263 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16263">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Feature marking the point in the abdominal wall where the umbilical cord entered the fetus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>belly button</oboInOwl:hasRelatedSynonym>
