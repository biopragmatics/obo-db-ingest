Declaration(Class(goldbook:I02933))
AnnotationAssertion(rdfs:label goldbook:I02933 "ideal adsorbed state")
AnnotationAssertion(dcterms:description goldbook:I02933 "The adsorbed state in a system following Langmuir's isotherm.")
AnnotationAssertion(mito:isMentionedBy goldbook:I02933 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02933 "current"^^xsd:string)
Declaration(Class(goldbook:I02938))
AnnotationAssertion(rdfs:label goldbook:I02938 "ideal mixture")
AnnotationAssertion(dcterms:description goldbook:I02938 "A mixture of substances B, C, ... is called an ideal mixture when \\(a_{\\rm{B}}=x_{\\rm{B}}\\), \\(a_{\\rm{C}}=x_{\\rm{C}}\\), ... or \\(f_{\\rm{B}}=1\\), \\(f_{\\rm{C}}=1\\) where \\(a_{\\rm{B}}\\) and \\(f_{\\rm{B}}\\) are the relative activity and the activity coefficient, respectively, of a substance B in a liquid or solid mixture.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02938 goldbook:A00116)
AnnotationAssertion(rdfs:seeAlso goldbook:I02938 goldbook:R05256)
AnnotationAssertion(mito:isMentionedBy goldbook:I02938 doi:10.1351/pac199466030533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02938 "current"^^xsd:string)
Declaration(Class(goldbook:I02940))
AnnotationAssertion(rdfs:label goldbook:I02940 "identity reaction")
AnnotationAssertion(dcterms:description goldbook:I02940 "A chemical reaction whose products are chemically identical with the reactants, for example the bimolecular self exchange reaction of $\\ce{CH3I}$ with $\\ce{I^{-}}$.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:I02940 "degenerate chemical reaction")
AnnotationAssertion(rdfs:seeAlso goldbook:I02940 goldbook:M03989)
