Declaration(Class(goldbook:H02895))
AnnotationAssertion(rdfs:label goldbook:H02895 "hydrocracking unit")
AnnotationAssertion(dcterms:description goldbook:H02895 "Used in the thermal decomposition of heavy (high molecular weight) hydrocarbons to smaller (low molecular weight) hydrocarbons; high pressures of hydrogen and a special catalyst are employed. Sulfur compounds in the fuel are reduced to $\\ce{H2S}$, and the final hydrocarbon product can be obtained relatively sulfur-free.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02895 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:H02895 goldbook:D01547)
