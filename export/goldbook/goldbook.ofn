Declaration(Class(goldbook:A00029))
AnnotationAssertion(rdfs:label goldbook:A00029 "absorbance matching")
AnnotationAssertion(dcterms:description goldbook:A00029 "A procedure where the concentration of a known analyte may be determined by diluting the sample with solvent until the absorbance matches the absorbance of the analyte in the reference cell. This method is particularly useful if the Beer-Lambert law does not hold.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00029 goldbook:B00626)
AnnotationAssertion(rdfs:seeAlso goldbook:A00029 goldbook:A00028)
AnnotationAssertion(mito:isMentionedBy goldbook:A00029 doi:10.1351/pac198860091449)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00029 "current"^^xsd:string)
