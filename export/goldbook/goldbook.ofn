AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14282 "nanogel")
Declaration(Class(goldbook:14283))
AnnotationAssertion(rdfs:label goldbook:14283 "polymer network particle")
AnnotationAssertion(dcterms:description goldbook:14283 "Particle having any shape and composed of a polymer network and possibly species of finite molar mass.")
Declaration(Class(goldbook:14284))
