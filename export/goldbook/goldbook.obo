[Term]
id: goldbook:I03153
name: <i>in vitro</i>
def: "In glass\, referring to a study in the laboratory usually involving isolated organ\, tissue\, cell\, or biochemical systems."
property_value: mito:isMentionedBy doi:10.1351/pac199365092003
property_value: hasStatus "current" xsd:string
