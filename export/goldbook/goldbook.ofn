AnnotationAssertion(rdfs:seeAlso goldbook:P04399 goldbook:S06199)
AnnotationAssertion(mito:isMentionedBy goldbook:P04399 doi:10.1351/pac199466122527)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04399 "current"^^xsd:string)
