AnnotationAssertion(rdfs:seeAlso goldbook:AT07329 goldbook:T06503)
AnnotationAssertion(mito:isMentionedBy goldbook:AT07329 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:AT07329 "current"^^xsd:string)
