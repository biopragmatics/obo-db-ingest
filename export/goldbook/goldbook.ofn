AnnotationAssertion(rdfs:label goldbook:H02758 "heavy water")
AnnotationAssertion(dcterms:description goldbook:H02758 "Water containing a significant fraction (up to 100 per cent) of deuterium in the form of $\\ce{D2O}$ or $\\ce{HDO}$.")
