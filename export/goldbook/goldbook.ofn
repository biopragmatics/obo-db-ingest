AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10689 "herniation of intestines")
Declaration(Class(goldbook:10690))
AnnotationAssertion(rdfs:label goldbook:10690 "evocation")
AnnotationAssertion(dcterms:description goldbook:10690 "Specific induction of a tissue within a developing embryo that results from the action of a single hormone or other chemical (the evocator).")
Declaration(Class(goldbook:10691))
AnnotationAssertion(rdfs:label goldbook:10691 "excurrent")
AnnotationAssertion(dcterms:description goldbook:10691 "Pertaining to a vessel (or opening) conveying fluid outwards.")
Declaration(Class(goldbook:10692))
AnnotationAssertion(rdfs:label goldbook:10692 "exencephaly")
