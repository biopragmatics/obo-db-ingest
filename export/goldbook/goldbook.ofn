AnnotationAssertion(mito:isMentionedBy goldbook:C01271 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01271 "current"^^xsd:string)
Declaration(Class(goldbook:C01273))
AnnotationAssertion(rdfs:label goldbook:C01273 "conjunctive name")
