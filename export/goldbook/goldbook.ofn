Declaration(Class(goldbook:09427))
AnnotationAssertion(rdfs:label goldbook:09427 "shots per pixel")
AnnotationAssertion(dcterms:description goldbook:09427 "Number of ion pulses incident at each pixel in an image for one raster frame in secondary ion mass spectrometry.")
Declaration(Class(goldbook:09428))
AnnotationAssertion(rdfs:label goldbook:09428 "SIMS ion image")
