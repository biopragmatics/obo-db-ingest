AnnotationAssertion(dcterms:description goldbook:12061 "Procedure in which a test subject stands in front of a plate with 48 square holes and an equal number of fitted pegs, each having a cylindrical upper part and square base, and is asked to fit the pegs into the holes as quickly as possible by turning them 180 degrees, first with one hand and in a subsequent trial with the other hand.")
AnnotationAssertion(rdfs:comment goldbook:12061 "The test measures eye-to-hand coordination and gives information about right/left-handedness."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12061 goldbook:11925)
AnnotationAssertion(mito:isMentionedBy goldbook:12061 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12061 "current"^^xsd:string)
