property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13259
name: immune deviation
def: "Regulatory mechanism of the preferential activation of one aspect \(cellular or humoral\) of the adaptive immune system at the expense of the other."
comment: "Although not a form of true tolerance, this regulatory mechanism may be involved in the induction and maintenance of self-tolerance."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-11-06-03
property_value: hasStatus "current" xsd:string
