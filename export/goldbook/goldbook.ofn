AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02696 "current"^^xsd:string)
Declaration(Class(goldbook:G02697))
AnnotationAssertion(rdfs:label goldbook:G02697 "green coke")
AnnotationAssertion(dcterms:description goldbook:G02697 "Green coke (raw coke) is the primary solid carbonization product from high boiling hydrocarbon fractions obtained at temperatures below \\(900\\ \\rm{K}\\). It contains a fraction of matter that can be released as volatiles during subsequent heat treatment at temperatures up to approximately \\(1600\\ \\rm{K}\\). This mass fraction, the so-called volatile matter, is in the case of green coke between 4 and 15 wt.%, but it depends also on the heating rate.")
AnnotationAssertion(rdfs:comment goldbook:G02697 "Raw coke is an equivalent term to green coke although it is now less frequently used. The so-called volatile matter of green coke depends on temperature and time of coking, but also on the method for its determination."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02697 goldbook:R05158)
AnnotationAssertion(rdfs:seeAlso goldbook:G02697 goldbook:C00840)
AnnotationAssertion(rdfs:seeAlso goldbook:G02697 goldbook:C01142)
AnnotationAssertion(rdfs:seeAlso goldbook:G02697 goldbook:C01144)
AnnotationAssertion(rdfs:seeAlso goldbook:G02697 goldbook:M03722)
AnnotationAssertion(mito:isMentionedBy goldbook:G02697 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02697 "current"^^xsd:string)
Declaration(Class(goldbook:G02698))
AnnotationAssertion(rdfs:label goldbook:G02698 "greenhouse effect")
AnnotationAssertion(dcterms:description goldbook:G02698 "Heating effect produced by certain gases (e.g. $\\ce{CO2}$, $\\ce{O3}$, etc.), which by virtue of their characteristic infrared absorption, lower the earth to space transmission of long wavelength radiation but allow transmission of shorter wavelength radiation inward from the sun to the earth.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02698 goldbook:IT07399)
AnnotationAssertion(rdfs:seeAlso goldbook:G02698 goldbook:T06477)
AnnotationAssertion(rdfs:seeAlso goldbook:G02698 goldbook:W06659)
