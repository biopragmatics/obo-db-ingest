AnnotationAssertion(dcterms:description goldbook:11876 "Questionnaire type of psychological test for ages 18 and older. The RF version has 338 true–false statements with seven validity and ten personality scales that may be used in either an individual or group format.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11876 "MMPI")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11876 "MMPI-2-RF")
AnnotationAssertion(rdfs:comment goldbook:11876 "This test has been used outside clinical psychology in legal cases, to screen applicants for certain jobs, and to evaluate treatments for substance abuse."^^xsd:string)
