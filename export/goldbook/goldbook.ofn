Declaration(Class(goldbook:I03327))
AnnotationAssertion(rdfs:label goldbook:I03327 "isotope effect")
AnnotationAssertion(dcterms:description goldbook:I03327 "The effect on the rate or equilibrium constant of two reactions that differ only in the isotopic composition of one or more of their otherwise chemically identical components is referred to as a kinetic isotope effect or a thermodynamic (or equilibrium) isotope effect, respectively.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03327 goldbook:E02177)
AnnotationAssertion(rdfs:seeAlso goldbook:I03327 goldbook:K03405)
AnnotationAssertion(rdfs:seeAlso goldbook:I03327 goldbook:T06319)
