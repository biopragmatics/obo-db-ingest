Declaration(Class(goldbook:11212))
AnnotationAssertion(rdfs:label goldbook:11212 "sex-determining region Y protein")
AnnotationAssertion(dcterms:description goldbook:11212 "Transcription factor coded by a gene on the Y chromosome that initiates development of the male sex organs (i.e., testicular differentiation) in the embryo.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11212 "SRY protein")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11212 "testis-determining factor (TDF)")
Declaration(Class(goldbook:11213))
