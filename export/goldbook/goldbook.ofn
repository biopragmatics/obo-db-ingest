Declaration(Class(goldbook:13460))
AnnotationAssertion(rdfs:label goldbook:13460 "minor histocompatibility antigen")
AnnotationAssertion(dcterms:description goldbook:13460 "Non-major histocompatibility complex (MHC)-encoded cell surface processed peptide which, in association with MHC-encoded molecules, contributes to graft rejection, albeit not usually as severe as that due to MHC mismatch.")
AnnotationAssertion(rdfs:seeAlso goldbook:13460 goldbook:13179)
AnnotationAssertion(rdfs:seeAlso goldbook:13460 goldbook:13430)
AnnotationAssertion(mito:isMentionedBy goldbook:13460 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13460 "current"^^xsd:string)
Declaration(Class(goldbook:13461))
AnnotationAssertion(rdfs:label goldbook:13461 "mitogen")
AnnotationAssertion(dcterms:description goldbook:13461 "Substance that induces lymphocyte transformation or, more generally, mitosis and cell proliferation.")
AnnotationAssertion(rdfs:comment goldbook:13461 "Mitogens most commonly employed in immunotoxicology assays include the T-cell mitogens concanavalin A (ConA) and phytohemagglutinin (PHA). Mitogens routinely used for assessing B-cell proliferation include pokeweed mitogen (PWM), which can also act on T cells, and Escherichia coil lipopolysaccharide (LPS)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13461 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13461 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13461 goldbook:13034)
AnnotationAssertion(rdfs:seeAlso goldbook:13461 goldbook:13325)
AnnotationAssertion(rdfs:seeAlso goldbook:13461 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13461 goldbook:13572)
AnnotationAssertion(rdfs:seeAlso goldbook:13461 goldbook:13584)
AnnotationAssertion(mito:isMentionedBy goldbook:13461 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13461 "current"^^xsd:string)
Declaration(Class(goldbook:13462))
AnnotationAssertion(rdfs:label goldbook:13462 "mitogen-activated protein kinase")
AnnotationAssertion(dcterms:description goldbook:13462 "Member of a kinase network in which 'upstream' kinases activate 'downstream' kinases that, in response to phosphorylation, translocate to the nucleus and activate transcription factors.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13462 "MAPK")
AnnotationAssertion(rdfs:comment goldbook:13462 "These include the extracellular regulated kinases (Erk), stress-activated protein kinase (SAPK or p38), and the kinase of the c-jun oncoprotein (JNK)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13462 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13462 "current"^^xsd:string)
Declaration(Class(goldbook:13463))
AnnotationAssertion(rdfs:label goldbook:13463 "mitophagy")
AnnotationAssertion(dcterms:description goldbook:13463 "Autophagy-related pathway specific for mitochondria; it can be subdivided into macromitophagy and micromitophagy depending upon the degree of mitophagy.")
AnnotationAssertion(rdfs:seeAlso goldbook:13463 goldbook:12929)
AnnotationAssertion(mito:isMentionedBy goldbook:13463 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13463 "current"^^xsd:string)
Declaration(Class(goldbook:13464))
AnnotationAssertion(rdfs:label goldbook:13464 "mixed lymphocyte response")
AnnotationAssertion(dcterms:description goldbook:13464 "T-cell-proliferative response induced by cells expressing allogeneic major histocompatibility complex (MHC) molecules.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13464 "MLR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13464 "mixed lymphocyte response")
AnnotationAssertion(rdfs:seeAlso goldbook:13464 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13464 goldbook:12862)
AnnotationAssertion(rdfs:seeAlso goldbook:13464 goldbook:13434)
AnnotationAssertion(mito:isMentionedBy goldbook:13464 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13464 "current"^^xsd:string)
Declaration(Class(goldbook:13465))
AnnotationAssertion(rdfs:label goldbook:13465 "mixed connective tissue disease")
AnnotationAssertion(dcterms:description goldbook:13465 "Human autoimmune disease in which the immune system attacks the body, producing symptoms that combine features of polymyositis, systemic lupus erythematosus (SLE), and systemic scleroderma, and thus being considered as an overlap syndrome.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13465 "MCTD")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13465 "Sharp’s syndrome")
AnnotationAssertion(rdfs:comment goldbook:13465 "MCTD commonly causes joint pain/swelling, Raynaud phenomenon, muscle inflammation, and scarring of the skin of the hand. It does not typically cause kidney disease or seizures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13465 "Distinguishing laboratory characteristics are a positive, speckled anti-nuclear antibody (ANA) and an anti-U1-RNP antibody."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13465 goldbook:13632)
AnnotationAssertion(rdfs:seeAlso goldbook:13465 goldbook:12898)
AnnotationAssertion(rdfs:seeAlso goldbook:13465 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13465 goldbook:13271)
AnnotationAssertion(rdfs:seeAlso goldbook:13465 goldbook:13660)
AnnotationAssertion(rdfs:seeAlso goldbook:13465 goldbook:13708)
AnnotationAssertion(rdfs:seeAlso goldbook:13465 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:13465 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13465 "current"^^xsd:string)
Declaration(Class(goldbook:13466))
AnnotationAssertion(rdfs:label goldbook:13466 "molecular mimicry")
AnnotationAssertion(dcterms:description goldbook:13466 "Concept that identity or similarity of epitopes expressed by a pathogen and by a self molecule may lead to production of antibodies reacting to the self-antigen.")
AnnotationAssertion(rdfs:comment goldbook:13466 "This may explain how some autoimmune diseases develop."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13466 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13466 goldbook:12914)
AnnotationAssertion(mito:isMentionedBy goldbook:13466 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13466 "current"^^xsd:string)
Declaration(Class(goldbook:13467))
AnnotationAssertion(rdfs:label goldbook:13467 "monocyte")
AnnotationAssertion(dcterms:description goldbook:13467 "Mononuclear phagocyte found in blood and which is the precursor of the tissue macrophage.")
AnnotationAssertion(rdfs:comment goldbook:13467 "Formed in the bone marrow from the promonocyte, monocytes are transported to tissues, as of the lung and liver, where they develop into macrophages."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13467 "Formerly called large mononuclear leukocyte and hyaline or transitional leukocyte."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13467 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13467 goldbook:13379)
AnnotationAssertion(rdfs:seeAlso goldbook:13467 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13467 goldbook:13560)
AnnotationAssertion(mito:isMentionedBy goldbook:13467 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13467 "current"^^xsd:string)
Declaration(Class(goldbook:13468))
AnnotationAssertion(rdfs:label goldbook:13468 "monokine")
AnnotationAssertion(dcterms:description goldbook:13468 "Alternative name for a cytokine produced by monocytes.")
AnnotationAssertion(rdfs:seeAlso goldbook:13468 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:13468 goldbook:13467)
AnnotationAssertion(mito:isMentionedBy goldbook:13468 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13468 "current"^^xsd:string)
Declaration(Class(goldbook:13469))
AnnotationAssertion(rdfs:label goldbook:13469 "mononuclear phagocyte system")
AnnotationAssertion(dcterms:description goldbook:13469 "Network of phagocytic cells throughout the body. System comprising blood monocytes and tissue macrophages.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13469 "MPS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13469 "reticuloendothelial system (RES)")
AnnotationAssertion(rdfs:seeAlso goldbook:13469 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13469 goldbook:13467)
AnnotationAssertion(rdfs:seeAlso goldbook:13469 goldbook:13560)
AnnotationAssertion(mito:isMentionedBy goldbook:13469 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13469 "current"^^xsd:string)
Declaration(Class(goldbook:13470))
AnnotationAssertion(rdfs:label goldbook:13470 "mouse IgE test")
AnnotationAssertion(dcterms:description goldbook:13470 "Procedure in which serum immunoglobulin E (IgE) levels are measured in mice following topical exposure to a test substance. Substances that cause a significant increase in IgE are considered to be potential respiratory allergens.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13470 "MIGET")
AnnotationAssertion(rdfs:seeAlso goldbook:13470 goldbook:12857)
AnnotationAssertion(rdfs:seeAlso goldbook:13470 goldbook:13288)
AnnotationAssertion(mito:isMentionedBy goldbook:13470 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13470 "current"^^xsd:string)
Declaration(Class(goldbook:13471))
AnnotationAssertion(rdfs:label goldbook:13471 "mouse ear-swelling test")
AnnotationAssertion(dcterms:description goldbook:13471 "Test for sensitization in which the test substance is applied topically to the ear of a mouse for three consecutive days. The change in ear thickness is then measured following challenge on day 8.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13471 "MEST")
AnnotationAssertion(rdfs:seeAlso goldbook:13471 goldbook:12997)
AnnotationAssertion(mito:isMentionedBy goldbook:13471 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13471 "current"^^xsd:string)
Declaration(Class(goldbook:13472))
AnnotationAssertion(rdfs:label goldbook:13472 "mucocutaneous")
AnnotationAssertion(dcterms:description goldbook:13472 "Pertaining to or affecting the mucous membranes and/or the skin.")
AnnotationAssertion(mito:isMentionedBy goldbook:13472 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13472 "current"^^xsd:string)
Declaration(Class(goldbook:13473))
AnnotationAssertion(rdfs:label goldbook:13473 "mucosa")
AnnotationAssertion(dcterms:description goldbook:13473 "Moist tissue that lines some organs and body cavities, including the nose, mouth, lungs, and digestive tract.")
AnnotationAssertion(mito:isMentionedBy goldbook:13473 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13473 "current"^^xsd:string)
Declaration(Class(goldbook:13474))
AnnotationAssertion(rdfs:label goldbook:13474 "mucosa-associated lymphoid tissue")
AnnotationAssertion(dcterms:description goldbook:13474 "Secondary lymphoid tissue present in the surface mucosa of the respiratory tract and bronchus (BALT), gastrointestinal tract (GALT), nasal passages (NALT), larynx (LALT), conjunctiva (CALT), and genitourinary tract, and in the skin sub-epidermis (SALT).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13474 "MALT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13474 "bronchus-associated lymphoid tissue (BALT)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13474 "nasal-associated lymphoid tissue (NALT)")
AnnotationAssertion(rdfs:comment goldbook:13474 "MALT plays an important part in limiting entry of pathogens through the mucosal surfaces."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13474 goldbook:13189)
AnnotationAssertion(rdfs:seeAlso goldbook:13474 goldbook:13663)
AnnotationAssertion(rdfs:seeAlso goldbook:13474 goldbook:13473)
AnnotationAssertion(mito:isMentionedBy goldbook:13474 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13474 "current"^^xsd:string)
Declaration(Class(goldbook:13475))
AnnotationAssertion(rdfs:label goldbook:13475 "mucosal addressin cell adhesion molecule-1")
AnnotationAssertion(dcterms:description goldbook:13475 "Protein involved in trafficking of lymphocytes to mucosal endothelium.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:13475 "MAdCAM-1")
AnnotationAssertion(rdfs:comment goldbook:13475 "Expression of MAdCAM-1 is induced in the murine endothelial cell line bEnd.3 by tumor necrosis factor α (TNF-α), interleukin (IL)-1, and bacterial lipopolysaccharide (LPS)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13475 goldbook:13338)
AnnotationAssertion(rdfs:seeAlso goldbook:13475 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13475 goldbook:13473)
AnnotationAssertion(rdfs:seeAlso goldbook:13475 goldbook:13762)
AnnotationAssertion(mito:isMentionedBy goldbook:13475 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13475 "current"^^xsd:string)
Declaration(Class(goldbook:13476))
AnnotationAssertion(rdfs:label goldbook:13476 "mucosal tolerance")
AnnotationAssertion(dcterms:description goldbook:13476 "State of lymphocyte hyporesponsiveness to protein antigens applied across mucosal surfaces by oral or nasal instillation.")
AnnotationAssertion(rdfs:seeAlso goldbook:13476 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13476 goldbook:13473)
AnnotationAssertion(mito:isMentionedBy goldbook:13476 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13476 "current"^^xsd:string)
Declaration(Class(goldbook:13477))
AnnotationAssertion(rdfs:label goldbook:13477 "multiple myeloma")
AnnotationAssertion(dcterms:description goldbook:13477 "Plasma cell malignancy resulting in high levels of monoclonal immunoglobulin (Ig) in serum and of free light chains (Bence–Jones protein) in urine.")
AnnotationAssertion(rdfs:seeAlso goldbook:13477 goldbook:12947)
AnnotationAssertion(rdfs:seeAlso goldbook:13477 goldbook:13576)
AnnotationAssertion(rdfs:seeAlso goldbook:13477 goldbook:13386)
AnnotationAssertion(rdfs:seeAlso goldbook:13477 goldbook:13483)
AnnotationAssertion(mito:isMentionedBy goldbook:13477 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13477 "current"^^xsd:string)
Declaration(Class(goldbook:13478))
AnnotationAssertion(rdfs:label goldbook:13478 "multiplex immunoassay")
AnnotationAssertion(dcterms:description goldbook:13478 "Type of particle immunoassay employing sets of microspheres with various physicochemical features, each labeled with a different antibody. The method allows detection in a single measurement of an array of 100 or more proteins.")
AnnotationAssertion(rdfs:seeAlso goldbook:13478 goldbook:13537)
AnnotationAssertion(mito:isMentionedBy goldbook:13478 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13478 "current"^^xsd:string)
Declaration(Class(goldbook:13479))
AnnotationAssertion(rdfs:label goldbook:13479 "multipotent progenitor cell")
AnnotationAssertion(dcterms:description goldbook:13479 "Undifferentiated stem cell, obtained from adult bone marrow or other non-embryonic tissue sources, that possesses the ability to differentiate into a variety of cell types, especially into cells of a closely related family of cells that are expanded in vitro and deposited in master cell banks for 'off-the-shelf' use, with potential hematopoiesis-inducing and immunomodulating activities.")
AnnotationAssertion(rdfs:comment goldbook:13479 "Allogeneic multipotent adult progenitor cells (MAPCs) are non-immunogenic due to the lack of major histocompatibility complex (MHC) molecule expression, and so elicit no immune response upon administration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13479 "In vivo, bone marrow-derived adult stem cells are capable of maturing into a broad range of cell types and may help to restore the immune system by producing multiple therapeutic molecules in response to inflammation and tissue damage."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13479 goldbook:12862)
AnnotationAssertion(rdfs:seeAlso goldbook:13479 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13479 goldbook:13271)
AnnotationAssertion(rdfs:seeAlso goldbook:13479 goldbook:13434)
AnnotationAssertion(mito:isMentionedBy goldbook:13479 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13479 "current"^^xsd:string)
Declaration(Class(goldbook:13480))
AnnotationAssertion(rdfs:label goldbook:13480 "murine local lymph node assay")
AnnotationAssertion(dcterms:description goldbook:13480 "Predictive test of sensitization in which a test substance is applied topically to the skin of mice (usually three times at daily intervals) and the weight of the local draining lymph nodes is measured at six days. Usually lymphoproliferation in the nodes is measured following injection of [\\(\\ce{^{3}H}\\)]thymidine or bromodeoxyuridine.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13480 "LLNA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13480 "local lymph node assay (LLNA)")
AnnotationAssertion(rdfs:seeAlso goldbook:13480 goldbook:13103)
AnnotationAssertion(rdfs:seeAlso goldbook:13480 goldbook:13419)
AnnotationAssertion(mito:isMentionedBy goldbook:13480 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13480 "current"^^xsd:string)
Declaration(Class(goldbook:13481))
AnnotationAssertion(rdfs:label goldbook:13481 "acquired myasthenia gravis")
AnnotationAssertion(dcterms:description goldbook:13481 "Autoimmune disease characterized by muscle weakness usually affecting ocular and oropharyngeal muscles due to an autoimmune attack against components of the neuromuscular junction (e.g., the nicotinic acetylcholine receptor).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13481 "acquired myasthenia gravis")
AnnotationAssertion(rdfs:comment goldbook:13481 "This disease may be idiopathic, paraneoplastic [thymic tumor or lung (Lambert–Eaton myasthenic syndrome) tumor, etc.], or drug-induced (e.g., D-penicillamine)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13481 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13481 goldbook:13371)
AnnotationAssertion(rdfs:seeAlso goldbook:13481 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13481 goldbook:13249)
AnnotationAssertion(rdfs:seeAlso goldbook:13481 goldbook:13734)
AnnotationAssertion(mito:isMentionedBy goldbook:13481 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13481 "current"^^xsd:string)
Declaration(Class(goldbook:13482))
AnnotationAssertion(rdfs:label goldbook:13482 "myelodysplastic syndrome")
AnnotationAssertion(dcterms:description goldbook:13482 "Diverse collection of hematological conditions united by ineffective production (or dysplasia) of myeloid blood cells and risk of transformation to acute myelogenous leukemia (AML). Anemia requiring chronic blood transfusion is frequently present.")
AnnotationAssertion(rdfs:seeAlso goldbook:13482 goldbook:12838)
AnnotationAssertion(rdfs:seeAlso goldbook:13482 goldbook:13484)
AnnotationAssertion(rdfs:seeAlso goldbook:13482 goldbook:13753)
AnnotationAssertion(mito:isMentionedBy goldbook:13482 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13482 "current"^^xsd:string)
Declaration(Class(goldbook:13483))
AnnotationAssertion(rdfs:label goldbook:13483 "myeloma")
AnnotationAssertion(dcterms:description goldbook:13483 "Tumor composed of cells derived from hematopoietic cells (see hematopoiesis) of the bone marrow, or from mast cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:13483 goldbook:12947)
AnnotationAssertion(rdfs:seeAlso goldbook:13483 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13483 goldbook:13442)
AnnotationAssertion(rdfs:seeAlso goldbook:13483 goldbook:13477)
AnnotationAssertion(mito:isMentionedBy goldbook:13483 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13483 "current"^^xsd:string)
Declaration(Class(goldbook:13484))
AnnotationAssertion(rdfs:label goldbook:13484 "myeloid")
AnnotationAssertion(dcterms:description goldbook:13484 "Referring to the nonlymphocytic groups of white blood cells, including granulocytes, monocytes, and platelets.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13484 "myelogenous")
AnnotationAssertion(rdfs:comment goldbook:13484 "Acute myelogenous leukemia (AML) is also known as acute myeloid leukemia."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13484 goldbook:12838)
AnnotationAssertion(rdfs:seeAlso goldbook:13484 goldbook:13467)
AnnotationAssertion(rdfs:seeAlso goldbook:13484 goldbook:13580)
AnnotationAssertion(mito:isMentionedBy goldbook:13484 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13484 "current"^^xsd:string)
Declaration(Class(goldbook:13485))
AnnotationAssertion(rdfs:label goldbook:13485 "myeloid stem cell")
AnnotationAssertion(dcterms:description goldbook:13485 "One of two groups of stem cells produced in the bone marrow. Myeloid stem cells may mature into several types of blood cells, including acidic basophils, eosinophils, erythrocytes, macrophages, megakaryocytes, and neutrophils.")
AnnotationAssertion(rdfs:seeAlso goldbook:13485 goldbook:12943)
AnnotationAssertion(rdfs:seeAlso goldbook:13485 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13485 goldbook:13117)
AnnotationAssertion(rdfs:seeAlso goldbook:13485 goldbook:13127)
AnnotationAssertion(rdfs:seeAlso goldbook:13485 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13485 goldbook:13449)
AnnotationAssertion(rdfs:seeAlso goldbook:13485 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:13485 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13485 "current"^^xsd:string)
Declaration(Class(goldbook:13486))
AnnotationAssertion(rdfs:label goldbook:13486 "myeloid tissue")
AnnotationAssertion(dcterms:description goldbook:13486 "Tissue within red bone marrow that produces the blood cells. It is found around the blood vessels and contains various cell types that are precursors of the blood cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:13486 goldbook:12959)
AnnotationAssertion(mito:isMentionedBy goldbook:13486 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13486 "current"^^xsd:string)
Declaration(Class(goldbook:13487))
AnnotationAssertion(rdfs:label goldbook:13487 "myeloma protein")
AnnotationAssertion(dcterms:description goldbook:13487 "Monoclonal antibody secreted by myeloma cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:13487 goldbook:13483)
AnnotationAssertion(mito:isMentionedBy goldbook:13487 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13487 "current"^^xsd:string)
Declaration(Class(goldbook:13488))
AnnotationAssertion(rdfs:label goldbook:13488 "myeloperoxidase")
AnnotationAssertion(dcterms:description goldbook:13488 "Enzyme found in azurophilic granules of neutrophils, the major target of antineutrophil cytoplasmic autoantibody (ANCA).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13488 "MPO")
AnnotationAssertion(rdfs:comment goldbook:13488 "MPO autoantibodies are diagnostic markers for microscopic polyangiitis, rapidly progressive glomerulonephritis, and Goodpasture disease or syndrome."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13488 "MPO autoantibodies are also found in patients exposed to silica or drugs (e.g., hydralazine, propylthiouracil, D-penicillamine) as well as in some patients with Wegener granulomatosis (WG) and other autoimmune diseases."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13488 goldbook:13178)
AnnotationAssertion(rdfs:seeAlso goldbook:13488 goldbook:13782)
AnnotationAssertion(rdfs:seeAlso goldbook:13488 goldbook:12896)
AnnotationAssertion(rdfs:seeAlso goldbook:13488 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13488 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13488 goldbook:13174)
AnnotationAssertion(rdfs:seeAlso goldbook:13488 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:13488 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13488 "current"^^xsd:string)
Declaration(Class(goldbook:13489))
AnnotationAssertion(rdfs:label goldbook:13489 "myelopoiesis")
AnnotationAssertion(dcterms:description goldbook:13489 "Process of formation and development of myeloid blood cells in the bone marrow.")
AnnotationAssertion(rdfs:seeAlso goldbook:13489 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13489 goldbook:13484)
AnnotationAssertion(mito:isMentionedBy goldbook:13489 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13489 "current"^^xsd:string)
Declaration(Class(goldbook:13490))
AnnotationAssertion(rdfs:label goldbook:13490 "myelosuppression")
AnnotationAssertion(dcterms:description goldbook:13490 "Decrease in myeloid cells, including pancytopenia, anemia, leukopenia, lymphopenia, thrombocytopenia, and other blood dyscrasias.")
AnnotationAssertion(rdfs:seeAlso goldbook:13490 goldbook:12955)
AnnotationAssertion(rdfs:seeAlso goldbook:13490 goldbook:13382)
AnnotationAssertion(rdfs:seeAlso goldbook:13490 goldbook:13409)
AnnotationAssertion(rdfs:seeAlso goldbook:13490 goldbook:13484)
AnnotationAssertion(rdfs:seeAlso goldbook:13490 goldbook:13532)
AnnotationAssertion(mito:isMentionedBy goldbook:13490 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13490 "current"^^xsd:string)
Declaration(Class(goldbook:13491))
AnnotationAssertion(rdfs:label goldbook:13491 "autoimmune myositis")
AnnotationAssertion(dcterms:description goldbook:13491 "Rare systemic inflammatory myopathy, including primary polymyositis, primary dermatomyositis, myositis associated with malignancy, childhood dermatomyositis, and myositis with multisystem autoimmune disease [e.g., mixed connective tissue disease (MCTD), systemic sclerosis (SSc)].")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13491 "autoimmune myositis")
AnnotationAssertion(rdfs:comment goldbook:13491 "Autoantibodies against aminoacyl-tRNA synthetases (e.g., anti-Jo-1), signal recognition particles (e.g., anti-SRP54), nuclear helicase (anti-Mi-2), tRNA and tRNA–protein complexes (e.g., anti-Mas), and translation factor (anti-KJ) have been described as myositis-specific."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13491 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13491 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13491 goldbook:13465)
AnnotationAssertion(rdfs:seeAlso goldbook:13491 goldbook:13708)
AnnotationAssertion(rdfs:seeAlso goldbook:13491 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:13491 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13491 "current"^^xsd:string)
Declaration(Class(goldbook:13492))
AnnotationAssertion(rdfs:label goldbook:13492 "NACHT domain-, leucine-rich repeat (LRR)-, and pyrin (N-terminal homology) domain (PYD)-containing protein 3")
AnnotationAssertion(dcterms:description goldbook:13492 "NOD-like receptor (NLR), found in certain inflammasomes, that binds to aggregated proteins and the peptides that compose them. Its activation leads to the generation of inflammatory cytokines, such as interleukin (IL)-1, and neurotoxic factors.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13492 "cryopyrin")
AnnotationAssertion(rdfs:comment goldbook:13492 "Mutations in NALP3 are responsible for the autoinflammatory diseases familial cold autoinflammatory syndrome, Muckle–Wells syndrome and neonatal onset multisystem inflammatory disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13492 goldbook:13494)
AnnotationAssertion(rdfs:seeAlso goldbook:13492 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:13492 goldbook:13333)
AnnotationAssertion(rdfs:seeAlso goldbook:13492 goldbook:13338)
AnnotationAssertion(mito:isMentionedBy goldbook:13492 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13492 "current"^^xsd:string)
Declaration(Class(goldbook:13493))
AnnotationAssertion(rdfs:label goldbook:13493 "N-nucleotides")
AnnotationAssertion(dcterms:description goldbook:13493 "Non-templated nucleotides added to the junctions between antibody and T-cell receptor (TCR) variable (V) gene, diversity (D) gene, and joining (J) gene segments during gene rearrangement.")
AnnotationAssertion(rdfs:seeAlso goldbook:13493 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13493 goldbook:13098)
AnnotationAssertion(rdfs:seeAlso goldbook:13493 goldbook:13354)
AnnotationAssertion(rdfs:seeAlso goldbook:13493 goldbook:13772)
AnnotationAssertion(mito:isMentionedBy goldbook:13493 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13493 "current"^^xsd:string)
Declaration(Class(goldbook:13494))
AnnotationAssertion(rdfs:label goldbook:13494 "NOD-like receptor")
AnnotationAssertion(dcterms:description goldbook:13494 "Any of a large family of cytoplasmic proteins containing a nucleotide-binding domain and leucine-rich repeats (LRRs), involved in regulation of inflammation and apoptosis; many family members are thought to function as pattern recognition receptors (PRRs).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13494 "NLR")
AnnotationAssertion(rdfs:seeAlso goldbook:13494 goldbook:13492)
AnnotationAssertion(rdfs:seeAlso goldbook:13494 goldbook:13543)
AnnotationAssertion(mito:isMentionedBy goldbook:13494 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13494 "current"^^xsd:string)
Declaration(Class(goldbook:13495))
AnnotationAssertion(rdfs:label goldbook:13495 "N-region")
AnnotationAssertion(dcterms:description goldbook:13495 "Highly variable region on the H-chain of immunoglobulins.")
AnnotationAssertion(rdfs:seeAlso goldbook:13495 goldbook:13198)
AnnotationAssertion(rdfs:seeAlso goldbook:13495 goldbook:13773)
AnnotationAssertion(mito:isMentionedBy goldbook:13495 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13495 "current"^^xsd:string)
Declaration(Class(goldbook:13496))
AnnotationAssertion(rdfs:label goldbook:13496 "naïve lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13496 "Mature T cell or B cell that has not yet been activated (see lymphocyte activation) by encounter with antigen.")
AnnotationAssertion(rdfs:seeAlso goldbook:13496 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13496 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13496 goldbook:13401)
AnnotationAssertion(mito:isMentionedBy goldbook:13496 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13496 "current"^^xsd:string)
Declaration(Class(goldbook:13497))
AnnotationAssertion(rdfs:label goldbook:13497 "natural autoantibodies")
AnnotationAssertion(dcterms:description goldbook:13497 "Part of the naturally occurring repertoire of polyreactive antibodies that bind to autoantigens with low affinity. They are mainly of immunoglobulin M (IgM) isotype and produced by CD5+ B lymphocytes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13497 "NAA")
AnnotationAssertion(rdfs:comment goldbook:13497 "Natural antibodies and their producing cells may have a physiological role in the following processes: (i) first line of protection against external invaders, (ii) elimination of degraded autoantigens and senescent cells, and (iii) tolerization (see tolerance) of T cells by presenting autoantigens, thereby in protecting from development of pathological autoimmunity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13497 "In contrast, natural autoantibodies may become pathogenic in clonal B cell disorders, e.g., monoclonal anti-I antibodies in cold agglutinin disease cause autoimmune hemolytic anemia."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:12975)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:12914)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:12920)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:12925)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:13293)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:13347)
AnnotationAssertion(rdfs:seeAlso goldbook:13497 goldbook:13302)
AnnotationAssertion(mito:isMentionedBy goldbook:13497 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13497 "current"^^xsd:string)
Declaration(Class(goldbook:13498))
AnnotationAssertion(rdfs:label goldbook:13498 "natural immunity")
AnnotationAssertion(dcterms:description goldbook:13498 "Host defense mechanisms that do not require prior exposure to antigen.")
AnnotationAssertion(rdfs:comment goldbook:13498 "Nonimmunological defense may involve the actions of macrophages and natural killer (NK) cells, mucocutaneous or integumental barriers, the action of cilia or microvilli, or physiological processes, e.g., urinary outflow, vascular perfusion of tissues, or the presence of native flora, which \"outcompete\" pathogens."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13498 goldbook:13226)
AnnotationAssertion(rdfs:seeAlso goldbook:13498 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13498 goldbook:13499)
AnnotationAssertion(mito:isMentionedBy goldbook:13498 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13498 "current"^^xsd:string)
Declaration(Class(goldbook:13499))
AnnotationAssertion(rdfs:label goldbook:13499 "natural killer cell")
AnnotationAssertion(dcterms:description goldbook:13499 "Large granular lymphocyte which does not rearrange nor express either immunoglobulin or T-cell receptor (TCR) genes but is able to recognize and destroy certain tumor and virally infected cells in a major histocompatibility complex (MHC) molecule- and antibody-independent manner.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13499 "NK")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13499 "NK cell")
AnnotationAssertion(rdfs:seeAlso goldbook:13499 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13499 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13499 goldbook:13434)
AnnotationAssertion(mito:isMentionedBy goldbook:13499 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13499 "current"^^xsd:string)
Declaration(Class(goldbook:13500))
AnnotationAssertion(rdfs:label goldbook:13500 "natural killer cell activity assay")
AnnotationAssertion(dcterms:description goldbook:13500 "Immunotoxicity test in which lymphoid tissue or blood that has been treated with a test compound is co-incubated with target cells. The cytotoxic effect on target cells is measured, e.g., with the chromium release assay. It is used under circumstances where differences from untreated cells are attributed to natural killer (NK) cell activity.")
AnnotationAssertion(rdfs:seeAlso goldbook:13500 goldbook:13004)
AnnotationAssertion(rdfs:seeAlso goldbook:13500 goldbook:13414)
AnnotationAssertion(rdfs:seeAlso goldbook:13500 goldbook:13499)
AnnotationAssertion(mito:isMentionedBy goldbook:13500 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13500 "current"^^xsd:string)
Declaration(Class(goldbook:13501))
AnnotationAssertion(rdfs:label goldbook:13501 "natural killer T cell")
AnnotationAssertion(dcterms:description goldbook:13501 "Lymphoid cells with a morphology and granule content intermediate between T cells and natural killer (NK) cells.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13501 "NKT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13501 "NKT cell")
AnnotationAssertion(rdfs:comment goldbook:13501 "NKT cells express low levels of \\(\\upalpha{:}\\upbeta\\) T-cell receptor with an invariant α chain and very restricted \\(\\ce{\\upbeta\\ chain}\\) specificity, recognize lipid and glycolipid antigens presented by the nonclassical MHC-like molecule CD1d, and are potent producers of interleukin (IL)-4 and IFN-γ."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13501 goldbook:13163)
AnnotationAssertion(rdfs:seeAlso goldbook:13501 goldbook:13430)
AnnotationAssertion(rdfs:seeAlso goldbook:13501 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13501 goldbook:13338)
AnnotationAssertion(rdfs:seeAlso goldbook:13501 goldbook:13499)
AnnotationAssertion(rdfs:seeAlso goldbook:13501 goldbook:12825)
AnnotationAssertion(mito:isMentionedBy goldbook:13501 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13501 "current"^^xsd:string)
Declaration(Class(goldbook:13502))
AnnotationAssertion(rdfs:label goldbook:13502 "natural resistance-associated macrophage protein")
AnnotationAssertion(dcterms:description goldbook:13502 "Iron transporter that plays a critical role in macrophage activation and differentiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13502 "NRAMP-1")
AnnotationAssertion(rdfs:comment goldbook:13502 "Allele 3 of the NRAMP-1 promoter is associated with autoimmune disorders [e.g., rheumatoid arthritis (RA), juvenile rheumatoid arthritis, diabetes mellitus type 1, multiple sclerosis]."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13502 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13502 goldbook:13092)
AnnotationAssertion(rdfs:seeAlso goldbook:13502 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13502 goldbook:13651)
AnnotationAssertion(mito:isMentionedBy goldbook:13502 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13502 "current"^^xsd:string)
Declaration(Class(goldbook:13503))
AnnotationAssertion(rdfs:label goldbook:13503 "negative selection")
AnnotationAssertion(dcterms:description goldbook:13503 "Deletion by apoptosis in the thymus of T cells that recognize self-peptides presented by self-major histocompatibility complex (MHC) molecules, thus preventing the development of autoimmune T cells. Negative selection of developing B cells is also thought to occur if they encounter high levels of self-antigen in the bone marrow.")
AnnotationAssertion(rdfs:seeAlso goldbook:13503 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13503 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13503 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13503 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13503 goldbook:13434)
AnnotationAssertion(rdfs:seeAlso goldbook:13503 goldbook:12914)
AnnotationAssertion(mito:isMentionedBy goldbook:13503 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13503 "current"^^xsd:string)
Declaration(Class(goldbook:13504))
AnnotationAssertion(rdfs:label goldbook:13504 "neoantigen")
AnnotationAssertion(dcterms:description goldbook:13504 "Antigen newly expressed on a tumor or virally infected cell, or arising after macromolecule-hapten binding.")
AnnotationAssertion(mito:isMentionedBy goldbook:13504 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13504 "current"^^xsd:string)
Declaration(Class(goldbook:13505))
AnnotationAssertion(rdfs:label goldbook:13505 "neonatal tolerance")
AnnotationAssertion(dcterms:description goldbook:13505 "Tolerance to specific foreign antigens induced by the exposure of a bird or mammal to the foreign antigens during embryonic or neonatal life, depending upon species.")
AnnotationAssertion(rdfs:seeAlso goldbook:13505 goldbook:13302)
AnnotationAssertion(mito:isMentionedBy goldbook:13505 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13505 "current"^^xsd:string)
Declaration(Class(goldbook:13506))
AnnotationAssertion(rdfs:label goldbook:13506 "autoimmune nephritis")
AnnotationAssertion(dcterms:description goldbook:13506 "Inflammation of the kidney due to immunological reaction to renal antigens.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13506 "autoimmune nephritis")
AnnotationAssertion(rdfs:comment goldbook:13506 "Common examples are anti-glomerular basement membrane disease (Goodpasture disease or syndrome), autoimmune tubulointerstitial nephritis with antibody to tubular basement membrane, or occurring as part of systemic autoimmune diseases independent of renal autoantigens [lupus nephritis in systemic lupus erythematosus (SLE), interstitial nephritis in Sjögren syndrome, nephritis in ANCA-associated vasculitis, cryoglobulinemic vasculitis, or hypocomplementemic urticarial vasculitis syndrome]."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:12897)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:13178)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:13680)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:12914)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:13061)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:13709)
AnnotationAssertion(rdfs:seeAlso goldbook:13506 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:13506 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13506 "current"^^xsd:string)
Declaration(Class(goldbook:13507))
AnnotationAssertion(rdfs:label goldbook:13507 "autoimmune neuropathy")
AnnotationAssertion(dcterms:description goldbook:13507 "Autoimmune disease of the nervous system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13507 "autoimmune neuropathy")
AnnotationAssertion(rdfs:comment goldbook:13507 "More and more neuropathies are described as autoimmune or possibly autoimmune in nature. Little is known about xenobiotics in the pathogenesis, but infections may play an important role in the initiation of some diseases."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13507 "Autoimmune neuropathies may be manifested at the neuromuscular junction, as central nervous system diseases (e.g., multiple sclerosis, paraneoplastic autoimmune syndromes, stiff-person syndrome, as well as manifestations of systemic autoimmune diseases), and diseases of the peripheral nerves (e.g., various forms of acute and chronic demyelinating neuropathies)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13507 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13507 goldbook:13535)
AnnotationAssertion(rdfs:seeAlso goldbook:13507 goldbook:13708)
AnnotationAssertion(mito:isMentionedBy goldbook:13507 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13507 "current"^^xsd:string)
Declaration(Class(goldbook:13508))
AnnotationAssertion(rdfs:label goldbook:13508 "neutralization")
AnnotationAssertion(dcterms:description goldbook:13508 "Blocking by an antibody of the effects of a virus.")
AnnotationAssertion(mito:isMentionedBy goldbook:13508 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13508 "current"^^xsd:string)
Declaration(Class(goldbook:13509))
AnnotationAssertion(rdfs:label goldbook:13509 "neutropenia")
AnnotationAssertion(dcterms:description goldbook:13509 "Abnormally low concentration of neutrophils in the blood.")
AnnotationAssertion(rdfs:comment goldbook:13509 "Neutropenia is associated with an increased risk of infection."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13509 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:13509 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13509 "current"^^xsd:string)
Declaration(Class(goldbook:13510))
AnnotationAssertion(rdfs:label goldbook:13510 "neutrophil")
AnnotationAssertion(dcterms:description goldbook:13510 "Granular leukocyte, the major circulating phagocytic polymorphonuclear granulocyte, having a nucleus with three to five lobes and fine cytoplasmic granules stainable by neutral dyes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13510 "polymorphonuclear leucocyte")
AnnotationAssertion(rdfs:comment goldbook:13510 "The cells have properties of chemotaxis, adherence to immune complexes, and phagocytosis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13510 "The cells are involved in a variety of inflammatory processes including late-phase allergic reactions and are also able to mediate antibody-dependent cellular cytotoxicity (ADCC)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13510 goldbook:12858)
AnnotationAssertion(rdfs:seeAlso goldbook:13510 goldbook:12879)
AnnotationAssertion(rdfs:seeAlso goldbook:13510 goldbook:13000)
AnnotationAssertion(rdfs:seeAlso goldbook:13510 goldbook:13257)
AnnotationAssertion(rdfs:seeAlso goldbook:13510 goldbook:13379)
AnnotationAssertion(rdfs:seeAlso goldbook:13510 goldbook:13560)
AnnotationAssertion(rdfs:seeAlso goldbook:13510 goldbook:13562)
AnnotationAssertion(mito:isMentionedBy goldbook:13510 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13510 "current"^^xsd:string)
Declaration(Class(goldbook:13511))
AnnotationAssertion(rdfs:label goldbook:13511 "neutrophil activation")
AnnotationAssertion(dcterms:description goldbook:13511 "Change in morphology and behavior of a neutrophil resulting from exposure to a cytokine, chemokine, cellular ligand, or soluble factor.")
AnnotationAssertion(rdfs:seeAlso goldbook:13511 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:13511 goldbook:13401)
AnnotationAssertion(rdfs:seeAlso goldbook:13511 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:13511 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13511 "current"^^xsd:string)
Declaration(Class(goldbook:13512))
AnnotationAssertion(rdfs:label goldbook:13512 "nitric oxide")
AnnotationAssertion(dcterms:description goldbook:13512 "Generic term for nitrogen monoxide species, including nitrosonium ion, nitric oxide radical, etc., that can function in a cell-signaling capacity.")
AnnotationAssertion(mito:isMentionedBy goldbook:13512 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13512 "current"^^xsd:string)
Declaration(Class(goldbook:13513))
AnnotationAssertion(rdfs:label goldbook:13513 "nondepleting antibody")
AnnotationAssertion(dcterms:description goldbook:13513 "Cell surface antibody that does not provoke attack by killer cells and thus does not provoke depletion of a group of cells in the body, usually referring to B cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:13513 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13513 goldbook:13361)
AnnotationAssertion(mito:isMentionedBy goldbook:13513 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13513 "current"^^xsd:string)
Declaration(Class(goldbook:13514))
AnnotationAssertion(rdfs:label goldbook:13514 "non-Hodgkin lymphoma")
AnnotationAssertion(dcterms:description goldbook:13514 "Any of various malignant lymphomas characterized by the absence of Reed–Sternberg cells and producing symptoms similar to those of Hodgkin disease.")
AnnotationAssertion(rdfs:seeAlso goldbook:13514 goldbook:13220)
AnnotationAssertion(rdfs:seeAlso goldbook:13514 goldbook:13641)
AnnotationAssertion(rdfs:seeAlso goldbook:13514 goldbook:13417)
AnnotationAssertion(mito:isMentionedBy goldbook:13514 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13514 "current"^^xsd:string)
Declaration(Class(goldbook:13515))
AnnotationAssertion(rdfs:label goldbook:13515 "non-obese diabetic mouse")
AnnotationAssertion(dcterms:description goldbook:13515 "Genetically modified mouse with a susceptibility to spontaneous development of automimmune diabetes mellitus type I.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:13515 "NOD")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13515 "NOD mouse")
AnnotationAssertion(rdfs:seeAlso goldbook:13515 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13515 goldbook:13092)
AnnotationAssertion(mito:isMentionedBy goldbook:13515 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13515 "current"^^xsd:string)
Declaration(Class(goldbook:13516))
AnnotationAssertion(rdfs:label goldbook:13516 "non-self")
AnnotationAssertion(dcterms:description goldbook:13516 "Of, relating to, or designating a cell or tissue that has not been produced by the individual organism.")
AnnotationAssertion(rdfs:comment goldbook:13516 "Non-self molecules are identified by the immune system as foreign or abnormal, thus provoking an immune response."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13516 goldbook:13271)
AnnotationAssertion(mito:isMentionedBy goldbook:13516 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13516 "current"^^xsd:string)
Declaration(Class(goldbook:13517))
AnnotationAssertion(rdfs:label goldbook:13517 "nuclear factor of activated T cells")
AnnotationAssertion(dcterms:description goldbook:13517 "Transcription factor involved in rapid cell response to stress, such as injury or invading pathogens, and in cell proliferation and survival.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:13517 "NFAT")
AnnotationAssertion(mito:isMentionedBy goldbook:13517 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13517 "current"^^xsd:string)
Declaration(Class(goldbook:13518))
AnnotationAssertion(rdfs:label goldbook:13518 "nuclear factor kappa-light-chain-enhancer of activated B cells")
AnnotationAssertion(dcterms:description goldbook:13518 "Protein complex that controls the transcription of genes involved in cytokine production, cellular adhesion, inflammation, and apoptosis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13518 "NFκB")
AnnotationAssertion(rdfs:comment goldbook:13518 "NFκB is found in almost all animal cell types and is involved in cellular responses to stimuli such as stress, cytokines, free radicals, ultraviolet irradiation, oxidized low-density lipoprotein (LDL), and bacterial or viral antigens."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13518 goldbook:13336)
AnnotationAssertion(rdfs:seeAlso goldbook:13518 goldbook:13065)
AnnotationAssertion(mito:isMentionedBy goldbook:13518 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13518 "current"^^xsd:string)
Declaration(Class(goldbook:13519))
AnnotationAssertion(rdfs:label goldbook:13519 "nucleotide-binding oligomerization domain-containing protein 1, 2")
AnnotationAssertion(dcterms:description goldbook:13519 "Members of a family of human intracellular proteins involved in the detection of invasive bacteria and activation of the $\\ce{NF\\kappa B}$ transcription factor pathway.")
AnnotationAssertion(rdfs:comment goldbook:13519 "In epithelial cells, NOD1 is essential for sensing intracellular Gram-negative bacteria through a tripeptide motif in the bacterial peptidoglycan."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13519 goldbook:13518)
AnnotationAssertion(mito:isMentionedBy goldbook:13519 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13519 "current"^^xsd:string)
Declaration(Class(goldbook:13520))
AnnotationAssertion(rdfs:label goldbook:13520 "nucleotide-binding oligomerization domain-containing protein-like receptor")
AnnotationAssertion(dcterms:description goldbook:13520 "Cytosolic protein that contains a central nucleotide-binding oligomerization domain, an N-terminal effector-binding domain and C-terminal leucine-rich repeats (LRRs).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13520 "NLR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13520 "NOD-like receptor protein (NLRP)")
AnnotationAssertion(rdfs:comment goldbook:13520 "NOD-like receptors have been implicated as mediators of protective immune responses against intracellular pathogens."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13520 "Genetic associations of polymorphisms in NOD-like receptor genes with complex chronic inflammatory barrier diseases, such as Crohn disease and asthma, and with rare auto-inflammatory syndromes including familial cold urticaria, Muckle–Wells syndrome and Blau syndrome have been described."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13520 goldbook:12953)
AnnotationAssertion(rdfs:seeAlso goldbook:13520 goldbook:13053)
