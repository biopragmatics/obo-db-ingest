AnnotationAssertion(rdfs:seeAlso goldbook:O04291 goldbook:P04405)
AnnotationAssertion(rdfs:seeAlso goldbook:O04291 goldbook:P04562)
AnnotationAssertion(rdfs:seeAlso goldbook:O04291 goldbook:Q05003)
AnnotationAssertion(rdfs:seeAlso goldbook:O04291 goldbook:S06011)
AnnotationAssertion(rdfs:seeAlso goldbook:O04291 goldbook:S06121)
