    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10765 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10765">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time from conception to birth, during which a fetus develops.</dcterms:description>
