AnnotationAssertion(obo:goldbook#hasStatus goldbook:13172 "current"^^xsd:string)
Declaration(Class(goldbook:13173))
AnnotationAssertion(rdfs:label goldbook:13173 "giant cell")
AnnotationAssertion(dcterms:description goldbook:13173 "Large multinucleate cell derived from fused macrophages and often present in granulomas.")
