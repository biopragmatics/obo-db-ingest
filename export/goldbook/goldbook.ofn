Declaration(Class(goldbook:12974))
AnnotationAssertion(rdfs:label goldbook:12974 "CD4+/CD25+ T cell")
AnnotationAssertion(dcterms:description goldbook:12974 "Subtype of CD4+ regulatory T cell (Treg) with potential role in the regulation of immune homeostasis.")
AnnotationAssertion(rdfs:comment goldbook:12974 "These cells seem to be important in preventing the development of autoimmune diseases (depletion leads to the spontaneous development of various autoimmune diseases in genetically susceptible animals; transfer prevents the development of organ-specific autoimmunity)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12974 "Activated T cells may also have this phenotype. Treg cells may be further distinguished by positivity for a protein marker Foxp3."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12974 goldbook:13401)
AnnotationAssertion(rdfs:seeAlso goldbook:12974 goldbook:12973)
AnnotationAssertion(rdfs:seeAlso goldbook:12974 goldbook:13141)
