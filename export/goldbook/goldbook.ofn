AnnotationAssertion(dcterms:description goldbook:13553 "Monocyte produced by the bone marrow from hematopoietic stem cell precursors, circulating in the bloodstream for about one to three days before moving into tissues throughout the body.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13553 "PBMC")
AnnotationAssertion(rdfs:comment goldbook:13553 "PBMCs constitute between \\(\\pu{3}\\) to \\(\\pu{8\\%}\\) of the leukocytes in the blood. In the tissues monocytes mature into different types of macrophages at different anatomical locations [see macrophage, resident(ial)]."^^xsd:string)
