AnnotationAssertion(rdfs:label goldbook:G02576 "gas analysis installation")
AnnotationAssertion(dcterms:description goldbook:G02576 "An assembly for the purpose of determining one or more components in a gaseous mixture. It generally comprises the following elements: sample probe, region of primary treatment of the gases, region of secondary treatment of gases, points for venting to the atmosphere and for calibration sample injection, transfer line and the analytical unit.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02576 goldbook:T06444)
AnnotationAssertion(mito:isMentionedBy goldbook:G02576 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02576 "current"^^xsd:string)
