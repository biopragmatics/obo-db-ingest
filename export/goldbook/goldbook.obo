consider: goldbook:09192
consider: goldbook:09273

[Term]
id: goldbook:09272
name: radial sectioning
def: "Sample preparation in which a sample is polished by a cylinder in order to expose compositional changes below the original sample surface\, with the intent that the depth of these layers can be related to the position on the surface created by the cylinder."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0404
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09273
name: range straggling
def: "Standard deviation of the projected ranges of energetic ions or atoms of a given energy."
comment: "Used in energetic-ion analysis, Rutherford backscattering spectrometry, and secondary-ion mass spectrometry."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0404
property_value: hasStatus "current" xsd:string
