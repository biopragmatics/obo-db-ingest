Declaration(Class(goldbook:CT06818))
AnnotationAssertion(rdfs:label goldbook:CT06818 "compartmental analysis")
AnnotationAssertion(dcterms:description goldbook:CT06818 "Mathematical process leading to a model of transport of a substance in terms of compartments and rate constants, usually taking the form \\[C=A\\ \\rm{e}^{-\\alpha\\ t}+B\\ \\rm{e}^{-\\beta \\ t}\\rm{...}\\] where each exponential term represents one experiment. \\(C\\) is the substance concentration; \\(A\\), \\(B\\),… are proportionality constants; \\(\\alpha \\), \\(\\beta \\),… are rate constants; and \\(t\\) is time.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06818 goldbook:S06072)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06818 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06818 "current"^^xsd:string)
