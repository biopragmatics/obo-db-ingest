[Term]
id: goldbook:C01027
name: chemical isotope exchange
def: "Exchange of isotopes between different types of molecules or ions in the course of a chemical reaction."
property_value: mito:isMentionedBy doi:10.1351/pac198254081533
property_value: hasStatus "current" xsd:string
