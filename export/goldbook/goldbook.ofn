AnnotationAssertion(rdfs:label goldbook:15626 "decompensation")
AnnotationAssertion(dcterms:description goldbook:15626 "Explicit pathophysiological changes following compensation for adverse effects.")
AnnotationAssertion(mito:isMentionedBy goldbook:15626 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15626 "current"^^xsd:string)
Declaration(Class(goldbook:15627))
AnnotationAssertion(rdfs:label goldbook:15627 "decontamination")
AnnotationAssertion(dcterms:description goldbook:15627 "Process of rendering harmless (by neutralization, elimination, removal, etc.) a potentially toxic substance in the natural environment, laboratory areas, the workplace, other indoor areas, clothes, food, water, sewage, etc.")
AnnotationAssertion(mito:isMentionedBy goldbook:15627 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15627 "current"^^xsd:string)
