Declaration(Class(goldbook:PT06838))
AnnotationAssertion(rdfs:label goldbook:PT06838 "pinocytosis")
AnnotationAssertion(dcterms:description goldbook:PT06838 "Type of endocytosis in which soluble materials are taken up by the cell and incorporated into vesicles for digestion.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06838 goldbook:ET06822)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06838 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06838 "current"^^xsd:string)
Declaration(Class(goldbook:PT06839))
AnnotationAssertion(rdfs:label goldbook:PT06839 "plasma")
AnnotationAssertion(dcterms:description goldbook:PT06839 "Fluid component of blood in which the blood cells and platelets are suspended. Synonym: blood plasma.Fluid component of semen produced by the accessory glands, the seminal vesicles, the prostate, and the bulbo-urethral glands.Cell substance outside the nucleus, i.e., the cytoplasm.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06839 goldbook:N04256)
