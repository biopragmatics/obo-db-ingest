AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10665 "visceral pericardium")
Declaration(Class(goldbook:10666))
AnnotationAssertion(rdfs:label goldbook:10666 "epidemiology")
AnnotationAssertion(dcterms:description goldbook:10666 "Study of the distribution and determinants of health-related states or events in specified populations and the application of this study for the control of health problems.")
Declaration(Class(goldbook:10667))
AnnotationAssertion(rdfs:label goldbook:10667 "epidermis")
AnnotationAssertion(dcterms:description goldbook:10667 "In vertebrates, protective outer stratified squamous layer of the skin consisting mainly of keratinocytes.")
Declaration(Class(goldbook:10668))
