Declaration(Class(goldbook:10698))
AnnotationAssertion(rdfs:label goldbook:10698 "external genitalia")
AnnotationAssertion(dcterms:description goldbook:10698 "Genitalia visible outside the body.")
Declaration(Class(goldbook:10699))
AnnotationAssertion(rdfs:label goldbook:10699 "extracellular matrix")
AnnotationAssertion(dcterms:description goldbook:10699 "Mesh of molecules, secreted by cells into the surrounding extracellular space.")
Declaration(Class(goldbook:10700))
