AnnotationAssertion(mito:isMentionedBy goldbook:R05419 doi:10.1351/pac198658030437)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05419 "current"^^xsd:string)
Declaration(Class(goldbook:R05420))
AnnotationAssertion(rdfs:label goldbook:R05420 "rovibronic state")
AnnotationAssertion(dcterms:description goldbook:R05420 "A state corresponding to a particular rotational sublevel of a particular vibrational level of a particular electronic state.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05420 goldbook:ET07026)
AnnotationAssertion(mito:isMentionedBy goldbook:R05420 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05420 "current"^^xsd:string)
