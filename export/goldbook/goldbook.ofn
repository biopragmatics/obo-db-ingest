AnnotationAssertion(mito:isMentionedBy goldbook:13453 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13453 "current"^^xsd:string)
Declaration(Class(goldbook:13454))
AnnotationAssertion(rdfs:label goldbook:13454 "mesenteric lymph node")
AnnotationAssertion(dcterms:description goldbook:13454 "Lymph node lying between layers of the mesentery.")
AnnotationAssertion(rdfs:seeAlso goldbook:13454 goldbook:13397)
AnnotationAssertion(mito:isMentionedBy goldbook:13454 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13454 "current"^^xsd:string)
Declaration(Class(goldbook:13455))
AnnotationAssertion(rdfs:label goldbook:13455 "metabolic activation")
AnnotationAssertion(dcterms:description goldbook:13455 "Formation of one or more chemically reactive intermediate(s) as a result of modification of a molecule by the xenobiotic-metabolizing enzymes of liver and other organs.")
AnnotationAssertion(rdfs:comment goldbook:13455 "This may lead to acute cell damage and recognition of the damaged cell by the immune system as non-self."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13455 "The reactive intermediate can also act as a hapten."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13455 goldbook:13271)
AnnotationAssertion(rdfs:seeAlso goldbook:13455 goldbook:13516)
AnnotationAssertion(mito:isMentionedBy goldbook:13455 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13455 "current"^^xsd:string)
Declaration(Class(goldbook:13456))
AnnotationAssertion(rdfs:label goldbook:13456 "microautophagy")
AnnotationAssertion(dcterms:description goldbook:13456 "Process in which lysosomes directly engulf cytoplasm by invagination, protrusion, and/or septation of the lysosomal limiting membrane.")
AnnotationAssertion(rdfs:seeAlso goldbook:13456 goldbook:12929)
AnnotationAssertion(rdfs:seeAlso goldbook:13456 goldbook:13422)
AnnotationAssertion(mito:isMentionedBy goldbook:13456 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13456 "current"^^xsd:string)
Declaration(Class(goldbook:13457))
AnnotationAssertion(rdfs:label goldbook:13457 "microfold cell")
AnnotationAssertion(dcterms:description goldbook:13457 "Cell found in the follicle-associated epithelium of the Peyer’s patch that has the unique ability to sample antigen from the lumen of the small intestine and deliver it via transcytosis to antigen-presenting cells (APCs) and lymphocytes located in a unique pocket-like structure on their basolateral side.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13457 "M cell")
AnnotationAssertion(rdfs:seeAlso goldbook:13457 goldbook:13559)
AnnotationAssertion(rdfs:seeAlso goldbook:13457 goldbook:12888)
AnnotationAssertion(rdfs:seeAlso goldbook:13457 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13457 goldbook:13751)
AnnotationAssertion(mito:isMentionedBy goldbook:13457 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13457 "current"^^xsd:string)
Declaration(Class(goldbook:13458))
AnnotationAssertion(rdfs:label goldbook:13458 "microglobulin")
AnnotationAssertion(dcterms:description goldbook:13458 "Any small globular protein found on the surface of many cells, including lymphocytes, and in the blood plasma distinct from albumin.")
AnnotationAssertion(rdfs:seeAlso goldbook:13458 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13458 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13458 "current"^^xsd:string)
Declaration(Class(goldbook:13459))
AnnotationAssertion(rdfs:label goldbook:13459 "microscopic polyangiitis")
AnnotationAssertion(dcterms:description goldbook:13459 "ANCA-associated necrotizing, pauci-immune vasculitis of the small vessels (capillaries, venules, arterioles) frequently associated with rapidly progressive glomerulonephritis and/or hemorrhagic alveolitis as well as autoantibodies against myeloperoxidase.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13459 "MPA")
AnnotationAssertion(rdfs:seeAlso goldbook:13459 goldbook:12896)
AnnotationAssertion(rdfs:seeAlso goldbook:13459 goldbook:12868)
