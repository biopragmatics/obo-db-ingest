AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00493 "current"^^xsd:string)
Declaration(Class(goldbook:A00495))
AnnotationAssertion(rdfs:label goldbook:A00495 "atomic laser")
AnnotationAssertion(dcterms:description goldbook:A00495 "A gas laser which is pumped using energy transfer from other atoms or molecules. Examples are the helium-neon ($\\ce{HeNe}$) and the copper vapour laser.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00495 goldbook:C01338)
