[Term]
id: goldbook:11434
name: decision tree
def: "The result of a recursive partitioning classification method that shows at each branching point the value of the property responsible for the split and the resulting classifications after the split."
property_value: mito:isMentionedBy doi:10.1515/pac-2012-1204
property_value: hasStatus "current" xsd:string
