Declaration(Class(goldbook:S05935))
AnnotationAssertion(rdfs:label goldbook:S05935 "star macromolecule")
AnnotationAssertion(dcterms:description goldbook:S05935 "A macromolecule containing a single branch point from which linear chains (arms) emanate.")
AnnotationAssertion(rdfs:comment goldbook:S05935 "A star macromolecule with \\(n\\) linear chains (arms) attached to the branch point is termed an \\(n\\)-star macromolecule, e.g. five-star macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05935 "If the arms of a star macromolecule are identical with respect to constitution and degree of polymerization, the macromolecule is termed a regular star macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05935 "If different arms of a star macromolecule are composed of different monomeric units, the macromolecule is termed a variegated star macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05935 goldbook:B00728)
