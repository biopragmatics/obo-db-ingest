Declaration(Class(goldbook:11895))
AnnotationAssertion(rdfs:label goldbook:11895 "mydriasis")
AnnotationAssertion(dcterms:description goldbook:11895 "Dilation of the pupil.")
AnnotationAssertion(rdfs:comment goldbook:11895 "Mydriasis can be a physiological response to light, a sign of brain trauma, or caused by drugs such as atropine."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11895 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11895 goldbook:11877)
AnnotationAssertion(mito:isMentionedBy goldbook:11895 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11895 "current"^^xsd:string)
Declaration(Class(goldbook:11896))
AnnotationAssertion(rdfs:label goldbook:11896 "myelin")
AnnotationAssertion(dcterms:description goldbook:11896 "Electrically insulating lipoprotein layers that are produced by glial cells and surround the axons of the neurons.")
AnnotationAssertion(rdfs:comment goldbook:11896 "It is produced by oligodendrocytes in the central nervous system and by Schwann cells in the peripheral nervous system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11896 goldbook:12064)
AnnotationAssertion(rdfs:seeAlso goldbook:11896 goldbook:11627)
AnnotationAssertion(rdfs:seeAlso goldbook:11896 goldbook:11785)
