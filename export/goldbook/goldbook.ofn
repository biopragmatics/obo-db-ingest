Declaration(Class(goldbook:S05592))
AnnotationAssertion(rdfs:label goldbook:S05592 "semiconductor detector")
AnnotationAssertion(dcterms:description goldbook:S05592 "A radiation detector using a semiconductor, in which free electric charges are produced along the path of an ionizing particle, in combination with a high voltage and electrodes to collect the induced electric charges.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05592 goldbook:R05054)
AnnotationAssertion(rdfs:seeAlso goldbook:S05592 goldbook:S05591)
AnnotationAssertion(mito:isMentionedBy goldbook:S05592 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05592 "current"^^xsd:string)
Declaration(Class(goldbook:S05597))
AnnotationAssertion(rdfs:label goldbook:S05597 "semiconductor-metal transition")
AnnotationAssertion(dcterms:description goldbook:S05597 "Any transition from a semiconductor to a metallic state under the influence of a temperature or pressure change or both. Examples:$\\ce{Ti2O3}$: band-edge crossing in a semiconductor to semimetal transition.SmS: localized level crossing a band edge. In SmS hydrostatic pressure above the critical pressure \\(P_{\\rm{c}}\\approx 0.65\\ \\mathrm{GPa}\\) broadens the Sm-5d band to make the band edge cross the Sm-\\(4\\rm{f}^{6}\\) level.A localized-itinerant transition.A switching transition.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05597 goldbook:C01397)
AnnotationAssertion(rdfs:seeAlso goldbook:S05597 goldbook:L03608)
AnnotationAssertion(rdfs:seeAlso goldbook:S05597 goldbook:S05591)
AnnotationAssertion(rdfs:seeAlso goldbook:S05597 goldbook:S06205)
AnnotationAssertion(mito:isMentionedBy goldbook:S05597 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05597 "current"^^xsd:string)
Declaration(Class(goldbook:S05598))
AnnotationAssertion(rdfs:label goldbook:S05598 "semi-interpenetrating polymer network")
AnnotationAssertion(dcterms:description goldbook:S05598 "Polymer comprising one or more polymer networks and one or more linear or branched polymers characterized by the penetration on a molecular scale of at least one of the networks by at least some of the linear or branched macromolecules.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:S05598 "SIPN")
AnnotationAssertion(rdfs:comment goldbook:S05598 "A SIPN is distinguished from an IPN because the constituent linear or branched macromolecules can, in principle, be separated from the constituent polymer network(s) without breaking chemical bonds; it is a polymer blend."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05598 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:S05598 goldbook:P04736)
AnnotationAssertion(rdfs:seeAlso goldbook:S05598 goldbook:P04742)
AnnotationAssertion(mito:isMentionedBy goldbook:S05598 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05598 "current"^^xsd:string)
