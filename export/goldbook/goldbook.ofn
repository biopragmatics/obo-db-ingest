Declaration(Class(goldbook:10709))
AnnotationAssertion(rdfs:label goldbook:10709 "feminization")
AnnotationAssertion(dcterms:description goldbook:10709 "Development of female characteristics as part of normal female maturation, or, in a male, pathologically as a result of endocrine imbalance.")
Declaration(Class(goldbook:10710))
AnnotationAssertion(rdfs:label goldbook:10710 "female fertility")
AnnotationAssertion(dcterms:description goldbook:10710 """Ability to conceive (see conception).
Production of live offspring.""")
Declaration(Class(goldbook:10711))
AnnotationAssertion(rdfs:label goldbook:10711 "male fertility")
AnnotationAssertion(dcterms:description goldbook:10711 "Ability to induce conception.")
Declaration(Class(goldbook:10712))
AnnotationAssertion(rdfs:label goldbook:10712 "Fertility Assessment by Continuous Breeding")
AnnotationAssertion(dcterms:description goldbook:10712 "Reproductive toxicity test in rodents in which female animals are repeatedly mated and frequency and size of litter and other parameters are measured; second or later generation fertility is also studied.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10712 "Reproductive Assessment by Continuous Breeding (RACB)")
Declaration(Class(goldbook:10713))
AnnotationAssertion(rdfs:label goldbook:10713 "fertilization")
AnnotationAssertion(dcterms:description goldbook:10713 "In reproductive biology, union of male and female gametes to form a zygote from which an embryo can develop.")
Declaration(Class(goldbook:10714))
AnnotationAssertion(rdfs:label goldbook:10714 "fetal alcohol syndrome")
AnnotationAssertion(dcterms:description goldbook:10714 "Condition developing in the fetus and resulting in congenital abnormalities, caused by alcohol intake by the mother during pregnancy, typically characterized by decreased cognitive development, stunted growth and a characteristic facies.")
Declaration(Class(goldbook:10715))
AnnotationAssertion(rdfs:label goldbook:10715 "fetal pole")
AnnotationAssertion(dcterms:description goldbook:10715 "Thickening on the margin of the yolk sac of a fetus during pregnancy.")
Declaration(Class(goldbook:10716))
AnnotationAssertion(rdfs:label goldbook:10716 "FETAX")
AnnotationAssertion(dcterms:description goldbook:10716 "Assay for teratogenicity using embryos of the frog, Xenopus laevis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10716 "frog embryo teratogenesis assay Xenopus")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10716 "frog embryo teratogenesis assay <em>Xenopus</em>")
Declaration(Class(goldbook:10717))
AnnotationAssertion(rdfs:label goldbook:10717 "fetoscopy")
AnnotationAssertion(dcterms:description goldbook:10717 "Procedure in which a fetus may be directly observed in utero, using a fiber-optic endoscope (fetoscope) introduced through a small incision in the abdomen under local anesthesia.")
Declaration(Class(goldbook:10718))
AnnotationAssertion(rdfs:label goldbook:10718 "fetus")
AnnotationAssertion(dcterms:description goldbook:10718 "Young mammal within the uterus of the mother, from the visible completion of characteristic organogenesis until birth.")
Declaration(Class(goldbook:10719))
AnnotationAssertion(rdfs:label goldbook:10719 "fibroblast")
AnnotationAssertion(dcterms:description goldbook:10719 "Flat fibrous tissue cell, with stellate or spindle shape, associated with the formation of collagen fibers and intercellular extracellular matrix.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10719 "desmocyte")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10719 "fibrocyte")
Declaration(Class(goldbook:10720))
AnnotationAssertion(rdfs:label goldbook:10720 "fibroblast growth factor")
AnnotationAssertion(dcterms:description goldbook:10720 "Any member of a family of more than twenty protein growth factors involved in angiogenesis, wound healing, and, in early embryonic development, induction of mesoderm, patterning and morphogenesis, and development of the limbs and brain.")
Declaration(Class(goldbook:10721))
AnnotationAssertion(rdfs:label goldbook:10721 "fish embryo test")
AnnotationAssertion(dcterms:description goldbook:10721 "Procedure in which fish (often zebrafish, Danio rerio) eggs and embryos are exposed to a test chemical and subsequent development or death of the animals is studied.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10721 "fish embryo acute toxicity test")
Declaration(Class(goldbook:10722))
AnnotationAssertion(rdfs:label goldbook:10722 "fish reproduction assay")
AnnotationAssertion(dcterms:description goldbook:10722 "Procedure in which sexually mature male and spawning female fish are exposed to a test substance and multiple endpoints, including egg production, endocrine activity, vitellogenin, and gonadal histopathology are measured.")
Declaration(Class(goldbook:10723))
AnnotationAssertion(rdfs:label goldbook:10723 "fish sexual development test")
AnnotationAssertion(dcterms:description goldbook:10723 "Procedure in which fish are exposed from the time of fertilization of the egg until sexual differentiation is completed and markers of possible endocrine disruptor activity are studied, including vitellogenin concentration, gonadal histopathology, sex ratios, and the occurrence of intersex.")
Declaration(Class(goldbook:10724))
AnnotationAssertion(rdfs:label goldbook:10724 "fistula")
AnnotationAssertion(dcterms:description goldbook:10724 "Permanent abnormal passage from an internal organ to the body surface or between two internal organs or structures.")
Declaration(Class(goldbook:10725))
AnnotationAssertion(rdfs:label goldbook:10725 "fitness")
AnnotationAssertion(dcterms:description goldbook:10725 "Ability to survive and reproduce.")
Declaration(Class(goldbook:10726))
AnnotationAssertion(rdfs:label goldbook:10726 "hepatic flexure")
AnnotationAssertion(dcterms:description goldbook:10726 "Bend between the ascending colon and the transverse colon.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10726 "right colic flexure")
Declaration(Class(goldbook:10727))
AnnotationAssertion(rdfs:label goldbook:10727 "foetus")
AnnotationAssertion(dcterms:description goldbook:10727 "Alternative spelling of fetus found in British English usage.")
Declaration(Class(goldbook:10728))
AnnotationAssertion(rdfs:label goldbook:10728 "folic acid")
AnnotationAssertion(dcterms:description goldbook:10728 "Water-soluble B vitamin involved in breakdown of carbohydrates, releasing energy and promoting biosynthesis.")
Declaration(Class(goldbook:10729))
AnnotationAssertion(rdfs:label goldbook:10729 "follicle")
AnnotationAssertion(dcterms:description goldbook:10729 """Small, secretory sac, such as the dental follicles that enclose the teeth before eruption or the hair follicles within the epidermis.
Fluid- or colloid-filled ball of cells in some glands such as the thyroid gland and the ovaries.""")
Declaration(Class(goldbook:10730))
AnnotationAssertion(rdfs:label goldbook:10730 "follicle-stimulating hormone")
AnnotationAssertion(dcterms:description goldbook:10730 "Hormone secreted by the anterior pituitary that stimulates the Graafian follicles of the ovary and subsequent follicular maturation, and in the male contributes to inducing spermatogenesis.")
Declaration(Class(goldbook:10731))
AnnotationAssertion(rdfs:label goldbook:10731 "follicle-stimulating hormone releasing hormone")
AnnotationAssertion(dcterms:description goldbook:10731 "Hormone, released by the hypothalamus, inducing the secretion of follicle-stimulating hormone and luteinizing hormone by the pituitary gland.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10731 "gonadoliberin")
Declaration(Class(goldbook:10732))
AnnotationAssertion(rdfs:label goldbook:10732 "follicular atresia")
AnnotationAssertion(dcterms:description goldbook:10732 "Degeneration and resorption of an ovarian follicle before it reaches maturity and ruptures.")
Declaration(Class(goldbook:10733))
AnnotationAssertion(rdfs:label goldbook:10733 "follicular phase")
AnnotationAssertion(dcterms:description goldbook:10733 "First half of the human menstrual cycle, during which one or more follicles in the ovary may mature, culminating in ovulation.")
Declaration(Class(goldbook:10734))
AnnotationAssertion(rdfs:label goldbook:10734 "fontanelle")
AnnotationAssertion(dcterms:description goldbook:10734 "Any of several soft spots in specific locations on the skull of the newborn where the bones have not yet fused and the brain is covered by skin and a tough membrane.")
Declaration(Class(goldbook:10735))
AnnotationAssertion(rdfs:label goldbook:10735 "foramen")
AnnotationAssertion(dcterms:description goldbook:10735 "Opening, hole.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10735 "foramina")
Declaration(Class(goldbook:10736))
AnnotationAssertion(rdfs:label goldbook:10736 "foramen magnum")
AnnotationAssertion(dcterms:description goldbook:10736 "Large foramen in the base of the skull, through which the spinal cord passes.")
Declaration(Class(goldbook:10737))
AnnotationAssertion(rdfs:label goldbook:10737 "foramen ovale")
AnnotationAssertion(dcterms:description goldbook:10737 """In the fetal heart, opening that allows shunting of blood between the right and left atria and normally closes at birth.
One of the larger foramina in the base of the skull.""")
Declaration(Class(goldbook:10738))
AnnotationAssertion(rdfs:label goldbook:10738 "forward genetics")
AnnotationAssertion(dcterms:description goldbook:10738 "Approach to genetic investigation in which the aim is to identify the gene that governs a particular function.")
Declaration(Class(goldbook:10739))
AnnotationAssertion(rdfs:label goldbook:10739 "fossa")
AnnotationAssertion(dcterms:description goldbook:10739 "In anatomy, a depression or hollow, often in a bone.")
Declaration(Class(goldbook:10740))
AnnotationAssertion(rdfs:label goldbook:10740 "fossa ovalis")
AnnotationAssertion(dcterms:description goldbook:10740 "Oval depression in the heart, on the lower part of the septum of the right atrium.")
Declaration(Class(goldbook:10741))
AnnotationAssertion(rdfs:label goldbook:10741 "frontonasal dysplasia")
AnnotationAssertion(dcterms:description goldbook:10741 "Congenital malformation of the midface in which the nose has a flat, wide appearance, the eyes may be wide-set, and there is a groove of varying size, running down the middle of the face across the nose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10741 "frontonasal dysostosis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10741 "frontonasal malformation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10741 "median cleft face syndrome")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10741 "Tessier cleft numbers 0/14")
Declaration(Class(goldbook:10742))
AnnotationAssertion(rdfs:label goldbook:10742 "functional genomics")
AnnotationAssertion(dcterms:description goldbook:10742 "Development and implementation of technologies to characterize the mechanisms through which genes and their products function and interact with each other and with the environment.")
Declaration(Class(goldbook:10743))
AnnotationAssertion(rdfs:label goldbook:10743 "fundus")
AnnotationAssertion(dcterms:description goldbook:10743 "Part of a hollow organ (e.g., the uterus) that is furthest from its opening.")
Declaration(Class(goldbook:10744))
AnnotationAssertion(rdfs:label goldbook:10744 "gall bladder")
AnnotationAssertion(dcterms:description goldbook:10744 "Pear-shaped muscular sac underneath the liver that stores bile secreted by the liver before its release into the duodenum.")
Declaration(Class(goldbook:10745))
AnnotationAssertion(rdfs:label goldbook:10745 "gamete")
AnnotationAssertion(dcterms:description goldbook:10745 "Reproductive cell (e.g., sperm or egg) containing a haploid set of chromosomes.")
Declaration(Class(goldbook:10746))
AnnotationAssertion(rdfs:label goldbook:10746 "gamete intrafallopian transfer")
AnnotationAssertion(dcterms:description goldbook:10746 "Technique of assisted reproduction by placing eggs and sperm into a woman’s Fallopian tubes in order that fertilization may occur there.")
Declaration(Class(goldbook:10747))
AnnotationAssertion(rdfs:label goldbook:10747 "gametogenesis")
AnnotationAssertion(dcterms:description goldbook:10747 "Development of male or female gametes to maturity.")
Declaration(Class(goldbook:10748))
AnnotationAssertion(rdfs:label goldbook:10748 "gastroschisis")
AnnotationAssertion(dcterms:description goldbook:10748 "Congenital defect characterized by a fissure in the anterior abdominal wall through which the small and (or) large intestine protrude.")
Declaration(Class(goldbook:10749))
AnnotationAssertion(rdfs:label goldbook:10749 "gastrula")
AnnotationAssertion(dcterms:description goldbook:10749 "Embryonic stage that develops from two to three germ layers during gastrulation.")
Declaration(Class(goldbook:10750))
AnnotationAssertion(rdfs:label goldbook:10750 "gastrulation")
AnnotationAssertion(dcterms:description goldbook:10750 "Stage of embryo development in which the two-layered blastula transforms into the gastrula by developing ectoderm and endoderm, as well as a third layer (mesoderm), through the movement of specific cells.")
Declaration(Class(goldbook:10751))
AnnotationAssertion(rdfs:label goldbook:10751 "gene product")
AnnotationAssertion(dcterms:description goldbook:10751 "Both the messenger RNA resulting from transcription of a gene and the proteins and peptides translated from that mRNA.")
Declaration(Class(goldbook:10752))
AnnotationAssertion(rdfs:label goldbook:10752 "gene silencing")
AnnotationAssertion(dcterms:description goldbook:10752 "Prevention of the expression of a specific gene.")
Declaration(Class(goldbook:10753))
