    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11138 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11138">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a family of hormones, based on the 21-carbon pregnane skeleton, involved in maintaining gestation and regulating the ovarian cycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>gestagen</oboInOwl:hasRelatedSynonym>
        <rdfs:label>progestogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10764"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11055"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11136"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11137"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11139 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11139">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hormone released from the anterior pituitary gland that stimulates milk production after childbirth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>prolactin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11140 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11140">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Falling or slipping out of place of an organ or other body part.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Uterine prolapse occurs when the ligaments holding the uterus weaken and the uterus slips down into, or even protrudes from, the vagina.</rdfs:comment>
        <rdfs:label>prolapse</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11141 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11141">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of cells in the vertebrate embryo that represent the earliest stage of development of the kidney.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pronephros</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11142 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11142">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Haploid nucleus formed by either the head of the sperm or the nucleus of the oocyte after fertilization but before their nuclei fuse to form the diploid zygotic nucleus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pronucleus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10608"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11143 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11143">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First phase of meiosis or mitosis in which thickening and orientation of the chromosomes occurs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>prophase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11144 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11144">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Most forward part of the brain that includes most of the cerebral cortex, the thalamus and hypothalamus, and the basal ganglia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>forebrain</oboInOwl:hasRelatedSynonym>
        <rdfs:label>prosencephalon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10453"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11298"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11145 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11145">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Male exocrine gland whose secretion contributes alkaline fluid to the ejaculate (see ejaculation).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The alkaline environment facilitates sperm transport and prolongs the survival of sperm in the acidic environment of the vagina.</rdfs:comment>
        <rdfs:label>prostate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10641"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10693"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11146 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11146">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small, basic (arginine-rich) protein involved in sperm maturation and DNA packaging during spermatogenesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>protamine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11240"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11147 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11147">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any enzyme catalyzing protein phosphorylation, often for the purpose of signal transduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>protein kinase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11219"/>
    </owl:Class>
    


