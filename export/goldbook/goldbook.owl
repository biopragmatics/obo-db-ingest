        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15526"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15526 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15526">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Expansion of the air passages through the bronchi of the lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
