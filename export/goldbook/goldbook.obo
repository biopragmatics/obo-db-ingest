[Term]
id: goldbook:14938
name: population fluctuation
def: "Variations over time in the size of a population."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-08-07-09
property_value: hasStatus "current" xsd:string
consider: goldbook:14932

[Term]
id: goldbook:14939
name: population growth rate
def: "Change in population size \\\(\\Delta N\\\) during a specified time period \\\(\\Delta t\\\) \\\[\\Delta N/\\Delta t = \(b - d\)N\\\] where \\\(N\\\) is population size\, \\\(b\\\) is per capita birth rate\, and \\\(d\\\) is per capita death rate."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-08-07-09
property_value: hasStatus "current" xsd:string
