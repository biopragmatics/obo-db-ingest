    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11012 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11012">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nerve cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>neuron</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11013 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11013">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Opening at either the cranial (caudal) or anterior (rostral) end of the neural tube before it completes closure in the early embryonic stage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>neuropore</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10569"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11189"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11014 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11014">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of several protein growth factors that regulates development, maintenance, and function of the vertebrate nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
