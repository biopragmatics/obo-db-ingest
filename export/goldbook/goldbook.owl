        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10774 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10774">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biochemical breakdown of glucose into pyruvic acid with the production of ATP.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>If the resulting pyruvate is not used efficiently in aerobic metabolism, it may then be converted to ethanol (fermentation) or lactic acid (anaerobic glycolysis).</rdfs:comment>
        <rdfs:label>glycolysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10775 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10775">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organ in animals that produces gametes, i.e., the testis or the ovary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gonad</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10776 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10776">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glycopeptide hormone, produced by the fetal placenta, that maintains the function of the corpus luteum during the first few weeks of pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>gonadotrophin</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gonadotropin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10777 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10777">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any factor from the hypothalamus that stimulates the anterior pituitary to release both follicle-stimulating hormone and luteinizing hormone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>gonadoliberin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>luteinizing hormone-releasing hormone (LHRH)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gonadotropin-releasing hormone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10730"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10778 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10778">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mature ovarian follicle within which an oocyte attains full size and which ruptures during ovulation to release the ovum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>vesicular ovarian follicle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Graafian follicle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11056"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10779 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10779">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>White blood cell, distinct from a lymphocyte, containing cytoplasmic granules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>granulocyte</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10780 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10780">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to cells of the cumulus oophorus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>granulosa</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10578"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10781 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10781">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regions of the brain and spinal cord that are made up primarily of cell bodies and dendrites of nerve cells rather than of myelinated axons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>grey matter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10985"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11380"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10782 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10782">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Naturally occurring or genetically engineered protein or steroid hormone that binds to a receptor to regulate cell growth, proliferation, or differentiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>growth factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10783 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10783">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Peptide hormone secreted by the anterior pituitary that stimulates growth, energy metabolism, and cell proliferation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>GH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somatotropic hormone (STH)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somatotropin</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Human growth hormone (hGH) isolated from cadavers or produced by recombinant technology is used clinically to treat deficiency of the hormone and other growth disorders, and inappropriately to enhance athletic performance.</rdfs:comment>
        <rdfs:label>growth hormone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10783"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10784 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10784">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance produced in the hypothalamus that regulates release of growth hormone by the anterior pituitary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>GHRF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>growth hormone releasing factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10783"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10784"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GHRF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10785 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10785">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fetal mesenchyme ligament that passes through the anterior abdominal wall and connects the lower pole of each developing gonad with the developing scrotum in men, and with the developing labia majora in women.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>In men, it guides descent of the testes into the scrotum.</rdfs:comment>
        <rdfs:label>gubernaculum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11197"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10786 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10786">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State in which a cell contains only one set of chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>monoploid</oboInOwl:hasRelatedSynonym>
        <rdfs:label>haploid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10787 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10787">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to blood or blood vessels. Situated, in common with the heart and major blood vessels, on the ventral side of the body with respect to the vertebral column or its embryonic precursors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hemal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10788 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10788">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Benign tumor formed by a vascular malformation present at birth or developing during life, in which proliferation of blood vessels leads to a vascular tangle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Hemangioma in the brain (central nervous system cavernous hemangioma) can be accompanied with multiple neurological symptoms, ranging from headache to seizures.</rdfs:comment>
        <rdfs:comment>Hemangiomas can occur anywhere in the body but are most frequently noticed in the skin and subcutaneous tissues; most hemangiomas present at birth undergo spontaneous regression.</rdfs:comment>
        <rdfs:label>hemangioma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10789 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10789">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development of each of the types of blood cell from common precursor cells, located mainly in the bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hemopoiesis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hematopoiesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10790 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10790">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital partial absence of all or part of the distal half of a limb.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hemimelia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10612"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10791 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10791">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital defect of the vertebral column in which one side of a vertebra fails to develop completely due to failure of the chondrification center to form on that side.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The resulting wedge-shaped vertebra can cause an angle in the spine leading to kyphosis, scoliosis, or lordosis.</rdfs:comment>
        <rdfs:label>hemivertebra</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10511"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10879"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10900"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11196"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10792 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10792">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Severe form of anemia in a fetus or newborn infant caused by incompatibility with the mother’s blood type, typically when the mother is rhesus factor negative (Rh -ve) and produces antibodies which attack (Rh +ve) fetal blood through the placenta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>erythroblastosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>erythroblastosis fetalis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hemolytic disease of the newborn</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10388"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11185"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10793 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10793">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enlargement of the liver and spleen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hepatosplenomegaly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10794 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10794">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having the reproductive organs and many of the secondary sex characteristics of both sexes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Pseudohermaphroditism is a state in which the person is of an unambiguous gonadal sex (possessing either testes or ovaries) but has ambiguous external genitalia.</rdfs:comment>
        <rdfs:label>hermaphrodite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10755"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10795 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10795">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of being hermaphrodite.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hermaphroditism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10794"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11149"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10796 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10796">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protrusion of an organ or structure through an abnormal opening in connective tissue or in the muscle wall of the cavity in which it is normally enclosed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hernia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10797 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10797">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hernia of a part of the stomach through a rupture of the diaphragm at the esophageal opening.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hiatus hernia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hiatal hernia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10604"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10796"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10798 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10798">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Family of viruses including herpes simplex types 1 and 2, and herpes zoster (also called varicella zoster).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Herpes viruses cause several infections, all characterized by blisters and ulcers, including chickenpox, shingles, genital herpes, and cold sores or fever blisters.</rdfs:comment>
        <rdfs:label>herpes</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10799 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10799">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Short-term in vivo procedure in which the androgenic or antiandrogenic effects of a test substance are studied in castrated, peripubertal male rodents, as indicated by changes in the weights of androgen-dependent tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Hershberger bioassay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10385"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10800 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10800">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural component of the limbic system of the vertebrate brain involved in short-term and long-term memory and spatial navigation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hippocampus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10801 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10801">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence of nerve ganglia throughout all or part of the gastrointestinal tract, causing dysregulation of intestinal motility.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>aganglionic megacolon</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>congenital aganglionic megacolon</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Hirschsprung syndrome</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10802 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10802">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of excessive bodily and facial hair.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hypertrichosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hirsutism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10803 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10803">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Birth defect in which the embryonic forebrain fails to divide completely to form the cerebral hemispheres.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>arhinencephaly</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This results in varying degrees of mental impairment and abnormal development of eye, nose, and lip.</rdfs:comment>
        <rdfs:label>holoprosencephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10504"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11144"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10804 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10804">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a class of closely similar DNA sequences occurring in various genes and involved in regulating pattern formation, segmentation, and morphogenesis during embryonic development in many species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>homeobox</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10806"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10973"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10805 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10805">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene containing a homeobox sequence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>homeobox gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10804"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10806 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10806">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Replacement of part of one segment of an insect or other segmented animal by a structure characteristic of a different segment, especially through mutation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>homeosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10807 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10807">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having the same relationship, relative position, or structure. (Of organs) Similar in position, structure, and evolutionary origin but not necessarily in function. (Of chromosomes) Pairing at meiosis and having the same structural features and pattern of genes. (Of a series of chemical compounds) Having the same functional group(s) but differing in structure by a fixed group of atoms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>homologous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10808 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10808">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crossing over between two similar or identical strands of DNA, resulting in exchange of corresponding stretches of DNA between two sister chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>homologous recombination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10809 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10809">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which larvae of the honey bee (Apis mellifera) are exposed to a test chemical in the diet and subsequent mortality is recorded daily up to the \(\pu{72\!\!{-}\!h}\) \(\pu{LD_{50}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>honey bee larval toxicity test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10810 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10810">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance formed in one organ or part of the body and carried in the blood to another organ or part where it selectively alters functional activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hormone</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10811 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10811">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>International research project that started in 1990 with the goal of determining the base-pair sequence of the human genome. The project was declared complete in 2003.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>HGP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>HGP also involved studying the genome of a number of organisms other than humans, including insects, fish, plants, and other mammals.</rdfs:comment>
        <rdfs:label>Human Genome Project</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10811"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HGP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10812 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10812">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vesicular or polycystic mass resulting from the proliferation of the trophoblast, with hydropic degeneration and avascularity of the chorionic villi.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The abnormal tissue typically results from gene expression from paternally derived chromosomes and a loss of maternal chromosomes.</rdfs:comment>
        <rdfs:label>hydatidiform mole</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10450"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10519"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10818"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11104"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11368"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10813 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10813">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare condition in which the brain’s cerebral hemispheres are replaced by sacs filled with cerebrospinal fluid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hydranencephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10504"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10814 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10814">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Accumulation of serous fluid in a sacculated cavity; specifically, such an accumulation in the space of the tunica vaginalis testis, or in a separate pocket along the spermatic cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hydrocele</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11207"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11332"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10815 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10815">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Accumulation of excess cerebrospinal fluid within the ventricles of the brain; head enlargement and brain damage may occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hydrocephalus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10816 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10816">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Microcephaly with excess cerebrospinal fluid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hydromicrocephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10817 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10817">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Swelling of the funnel-shaped part of the kidney, where urine is collected to enter the ureter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Hydronephrosis may be a congenital deformity or the consequence of an obstruction in the ureter.</rdfs:comment>
        <rdfs:label>hydronephrosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10818 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10818">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gross edema of the entire body, with severe anemia, occurring in hemolytic disease of the newborn.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hydrops</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10388"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10638"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10792"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10819 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10819">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dilation of a ureter with fluid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ureterectasia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hydroureter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10820 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10820">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Accumulation of fluid in a sac, cyst, or bursa.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hydroma</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hygroma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10482"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10582"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10821 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10821">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thin, membranous fold of highly variable appearance that, before its rupture, partly occludes the opening of the vagina.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hymen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10822 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10822">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Second pharyngeal or branchial arch of the developing embryo, from which different tissues around the neck, ear, and face will develop.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hyoid arch</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10471"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11086"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10823 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10823">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ventral to the long axis of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypaxial</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10824 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10824">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extension of a limb or part of a limb beyond the normal limit.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hyperextension</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10825 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10825">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Flexion of a limb or part of a limb beyond the normal limit.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hyperflexion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10826 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10826">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal multiplication or increase in the number of normal cells in a tissue or organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hyperplasia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10827 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10827">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally wide space between two organs, especially referring to the eyes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypertelorism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10828 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10828">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enlargement of an organ or tissue as a result of the increase in the size of its cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypertrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10829 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10829">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Innermost of the three primary germ layers, adjacent to the blastocyst cavity, that develops into the endoderm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypoblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10763"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10830 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10830">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inadequate functioning of the testes or ovaries as manifested by deficiencies in gametogenesis or in secretion of gonadal hormones.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Primary hypogonadism refers to a defect that is inherent in the gonad while secondary hypogonadism refers to a defect lying outside the gonad, often an endocrine effect.</rdfs:comment>
        <rdfs:label>hypogonadism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10657"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10831 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10831">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Underdevelopment or atrophy of a tissue or organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypoplasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10832 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10832">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Birth defect in which the urethra opens on the underside of the penis, or into the vagina.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypospadias</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11343"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10833 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10833">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region at the base of the brain containing specialized nerve cells that help activate, control, and integrate peripheral autonomic mechanisms, endocrine activities, and some somatic functions such as body temperature, sleep, and appetite.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypothalamus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11226"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10834 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10834">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low dioxygen content or tension. Deficiency of dioxygen in the inspired air, in blood, or in tissues, short of anoxia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>hypoxia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10835 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10835">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder of keratinization, characterized by dryness and scaling of the skin, often associated with other defects and with abnormalities of lipid metabolism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>fish-scale disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fish-skin disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>xeroderma</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ichthyosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10874"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10836 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10836">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Twins resulting from one zygote that, at an early stage of embryonic development, separated into two independently growing cell aggregations giving rise to two individuals of the same sex and identical genetic constitution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>monozygotic twins</oboInOwl:hasRelatedSynonym>
        <rdfs:label>identical twins</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10837 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10837">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to the ileum and the cecum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ileocecal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10500"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10838"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10838 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10838">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Third portion of the small intestine, between the jejunum and the cecum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ileum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10500"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10869"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10839 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10839">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Main artery of the pelvis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hypogastric artery</oboInOwl:hasRelatedSynonym>
        <rdfs:label>iliac artery</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10840 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10840">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of an anal opening due to the persistence of epithelial plug (persistence of the anal membrane) or to complete absence of the anal canal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>anal atresia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>imperforate anus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10841 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10841">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embedding of the early embryo in the lining of the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>nidation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>implantation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10842 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10842">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pseudohermaphroditic condition in female gastropods (snails) manifested by the development (imposition) of male characteristics such as a penis or vas deferens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Quantitation of imposex in the dog whelk (Nucella lapillus) has been used to monitor pollution by the antifouling agent tributyltin oxide (TBTO) in marine environments.</rdfs:comment>
        <rdfs:label>imposex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11149"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11358"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10843 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10843">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Differential expression of a gene, depending on whether it was transmitted through the sperm or the egg.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Imprinting is an epigenetic modulation of gene expression, thought to be regulated by attachment of methyl groups to the DNA, and by chromatin structure.</rdfs:comment>
        <rdfs:label>imprinting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10844 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10844">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Strain of an animal that has been inbred by brother-sister matings for more than \(\pu{20}\) generations, and consequently all the individuals of the strain are more than \(\pu{98\%}\) genetically identical.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>inbred strain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10845 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10845">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In rodents, number of pregnant females divided by the number of females mated, multiplied by 100.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This index measures the female’s ability to become pregnant and may be used as a general indicator of fertility.</rdfs:comment>
        <rdfs:label>female fertility index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10846 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10846">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In rodents, number of females with live born offspring divided by number of females with evidence of pregnancy, multiplied by \(\pu{100}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gestation index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11029"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10847 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10847">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In rodents, number of males impregnating females divided by number of males mated, multiplied by \(\pu{100}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This index measures the male’s ability to produce sperm that are capable of impregnating a female, assuming all mated females are fertile.</rdfs:comment>
        <rdfs:label>male fertility index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10848 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10848">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Percentage of seminiferous tubules containing identifiable spermatogonia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>tubular fertility index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11204"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10849 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10849">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pluripotent stem cell that is generated from an adult cell by genetic reprogramming.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>iPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iPS cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>induced pluripotent stem cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11103"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10849"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>iPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10850 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10850">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Persistent inability of either a male or a female to achieve conception or to produce offspring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>barrenness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>infecundity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sterility</oboInOwl:hasRelatedSynonym>
        <rdfs:label>infertility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10851 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10851">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anatomical funnel-shaped opening, often referring to the hollow stalk that connects the hypothalamus and the posterior pituitary gland, or to the portion of the Fallopian tube that receives the ovum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>infundibulum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10852 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10852">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Passage in the lower anterior abdominal wall, which in men conveys the spermatic cord and in women the round ligament of the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>inguinal canal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10853 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10853">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of peptide hormones secreted by the follicular granulosa cells of the ovary and the Sertoli cells of the testis, inhibiting follicle-stimulating hormone secretion by the anterior pituitary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>inhibin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10729"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10730"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10780"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10854 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10854">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malformation producing a cranial defect at the occiput, with the brain exposed, often combined with a cervical rachischisis and retroflexion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>iniencephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11027"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11162"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10855 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10855">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Twins conjoined at the occiput.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>iniopagus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10555"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11027"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10856 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10856">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delivery of sperm into the female reproductive system for the purpose or with the result of causing pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>insemination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10857 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10857">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a family of cell membrane glycoproteins that mediate cell-to-cell and cell-to-extracellular matrix interactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>integrin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10699"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10858 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10858">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of fibrous proteins (including keratin fibres, neurofilaments, desmin, and vimentin) that make up part of the cytoskeleton of most eukaryotic cells; so named because, at about \(\pu{10 nm}\) diameter, they are intermediate in thickness between actin filaments and microtubules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>IF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most types of intermediate filaments are cytoplasmic, but one type, the lamins, is nuclear.</rdfs:comment>
        <rdfs:label>intermediate filament</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10873"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10858"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10859 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10859">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition of having both male and female characteristics: thus, the state of being intermediate between the sexes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>intersex</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intersexuality</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10860 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10860">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Infertility treatment in which the sperm is injected through the membrane of the egg into its cytoplasm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ICSI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intracytoplasmic sperm injection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10850"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10860"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICSI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10861 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10861">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Creation of bone tissue during fetal development of jawed vertebrates, as well as during the healing of bone fractures; the tissue forms from mesenchymal stem cells residing in an extracellular matrix devoid of collagen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Intramembrous ossification is one of two mechanisms of bone formation, the other being endochondral ossification.</rdfs:comment>
        <rdfs:label>intramembrous ossification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10656"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10699"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10862 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10862">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Within the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>in utero</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intrauterine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10863 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10863">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subnormal, poor growth of the fetus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>IUGR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>intrauterine growth retardation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Growth restriction can be due to maternal or fetal causes, as well as to malnutrition and toxic exposures.</rdfs:comment>
        <rdfs:label>intrauterine growth restriction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10863"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IUGR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10864 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10864">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apoptotic pathway of cell death initiated from within the cell by signals initiated by mitochondrial damage and (or) DNA damage, a defective cell cycle, detachment from the extracellular matrix, hypoxia, loss of cell survival factors, or other types of severe cell stress; characterized by the activation of caspase 9.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The intrinsic and extrinsic pathways converge with cleavage of procaspase 3 by either caspase 8 (extrinsic pathway) or caspase 9 (intrinsic pathway).</rdfs:comment>
        <rdfs:comment>This pathway involves the release of pro-apoptotic proteins from the mitochondria.</rdfs:comment>
        <rdfs:label>intrinsic pathway</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10699"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10702"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10865 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10865">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rearrangement of a chromosome in which, after breakage at two points, a segment is reversed, resulting in a change in sequence of nucleotides.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chromosomal inversion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10866 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10866">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fertilization outside the body, used as a treatment for infertility.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>IVF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>&lt;em&gt;in vitro&lt;/em&gt; fertilization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10850"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10866"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IVF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10867 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10867">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Local deficiency of blood supply, and hence of dioxygen, to an organ or tissue, caused by constriction or obstruction of the blood vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ischemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10868 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10868">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vitamin A-like medication (13-cis retinoic acid) used, among other things, for acne treatment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Intake during pregnancy has a high teratogenic risk.</rdfs:comment>
        <rdfs:label>isotretinoin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11286"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10869 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10869">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Second part of the small intestine between the duodenum and ileum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>jejunum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10838"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10870 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10870">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dissolution of a cell nucleus, especially during mitosis and meiosis but also following necrosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>karyolysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10871"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10871 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10871">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Irreversible fragmentation of the nucleus of a dying cell following karyolysis, whereby its chromatin is distributed irregularly throughout the cytoplasm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>karyorrhexis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10870"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10872 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10872">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characterization of the number, form, and size of the chromosomes of an individual or a species. Photomicrograph of an individual’s chromosomes, arranged according to a standard classification for the species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>karyotype</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10873 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10873">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fibrous protein forming the main structural constituent of hair, feathers, hoofs, claws, horns, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>keratin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10874 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10874">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Replacement of the outer epithelial layer of cells, especially in skin, with keratin-rich structures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>cornification</oboInOwl:hasRelatedSynonym>
        <rdfs:label>keratinization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10873"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10875 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10875">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acidosis, as in diabetes, pregnancy, or starvation, accompanied by the accumulation of ketone bodies in body tissues and fluids.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ketoacidosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10876 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10876">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ketone that is an intermediate product of the breakdown of fats in the body; any of three compounds, acetoacetic acid, acetone, and (or) \(\upbeta\)-hydroxybutanoic acid, found in excess in blood and urine of persons with metabolic disorders.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Ketone bodies tend to accumulate in the blood and urine of individuals affected by starvation or uncontrolled diabetes mellitus.</rdfs:comment>
        <rdfs:label>ketone body</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10877 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10877">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Syndrome in males resulting from a genetic defect in which an extra female X chromosome (thus an XXY genotype) is present in a male, characterized by small testes, long legs, enlarged breasts, reduced sperm production, and mental retardation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Klinefelter syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11277"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11385"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10878 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10878">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mutation that leads to the loss of function of a particular gene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>null mutation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>knockout mutation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10879 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10879">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rearward curvature or convexity of the spine in excess of normal, resulting in a protuberant upper back.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hunchback</oboInOwl:hasRelatedSynonym>
        <rdfs:label>kyphosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10880 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10880">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physical efforts of expulsion of the fetus and the placenta from the uterus during birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>labor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10881 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10881">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secretion of milk from the mammary gland, usually to feed the infant during the neonatal period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>lactation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10997"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10882 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10882">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time following pregnancy during which the mammary glands secrete milk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>lactation period</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10883 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10883">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Layer of connective tissue, underlying the epithelium of a mucus membrane, containing capillaries and lymphatic vessels, as well as fibroblasts and cells of the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>lamina propria</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10719"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10904"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10978"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10884 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10884">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the respiratory tract between the pharynx and the trachea, having walls of cartilage and muscle and containing the vocal cords.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>larynx</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11086"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11310"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10885 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10885">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease caused by infection with the bacterium Mycobacterium leprae, often affecting the skin and nerves and causing body parts to become deformed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Thalidomide is used as a therapeutic drug and thalidomide-associated embryopathy occurs in regions where leprosy is endemic.</rdfs:comment>
        <rdfs:label>leprosy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11299"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10886 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10886">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malformation characterized by an abnormally tall, narrow cranium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>leptocephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10569"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10887 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10887">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally slender digits.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>leptodactyly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10888 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10888">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lack of pigmentation in the skin, hair, or feathers as a result of a failure of pigment cells to develop, or to migrate to those locations from their origin in the neural crest, in the embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Unlike albinism, where the defect is in the production of melanin pigment only, animals with leucism usually have pigment in the eye, as retinal pigment cells do not derive from the neural crest.</rdfs:comment>
        <rdfs:label>leucism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11001"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11179"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10889 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10889">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low concentration of white cells (leukocytes) in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>leukopenia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10890 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10890">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Normal position of the heart in the left hemithorax with the apex pointed to the left, and transposition of other viscera.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>levocardia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10601"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11224"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10891 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10891">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell in the testis that produces androgens, mainly testosterone, in the presence of luteinizing hormone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Leydig cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11296"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10892 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10892">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fibrous remnant of the ductus arteriosis linking the aortic arch and the top of the left pulmonary artery.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ligamentum arteriosum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10418"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10618"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11157"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10893 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10893">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic outgrowth of mesoderm covered in ectoderm that will give rise to one of the forelimbs or hindlimbs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>arm bud</oboInOwl:hasRelatedSynonym>
        <rdfs:label>limb bud</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10894 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10894">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique that studies patterns of heredity in high-risk families, in order to locate a disease-causing gene mutation by identifying co-inherited traits, usually by producing a LOD score.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>linkage analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10899"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10895 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10895">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence in members of a population of combinations of linked genes in non-random proportions, implying that the genes are close enough together on a chromosome to make it unlikely that they will be separated by recombination (see homologous recombination) during meiosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>linkage disequilibrium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10808"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10896 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10896">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder of fat metabolism characterized by the accumulation of abnormal levels of certain lipids in the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>lipidosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10897 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10897">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multiple offspring produced by a mammal from one pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>litter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10898 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10898">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific location of a gene or DNA sequence on a chromosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>loci</oboInOwl:hasRelatedSynonym>
        <rdfs:label>locus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10899 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10899">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the likelihood of two or more loci remaining together when chromosomes recombine (true linkage) to the likelihood of this occurring by chance alone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>logarithm (base 10) of odds</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An LOD score of 3 or greater is considered indicative of genetic linkage with odds greater than \(\pu{1000\!{:}\! 1}\).</rdfs:comment>
        <rdfs:label>LOD score</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10894"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10898"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10900 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10900">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Forward (ventral) curvature of the spine in the lumbar and cervical regions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Some degree of lumbar curvature is normal. Excessive curvature (lumbar hyperlordosis) is sometimes called swayback.</rdfs:comment>
        <rdfs:comment>This posture is also associated with a rodent being in heat.</rdfs:comment>
        <rdfs:label>lordosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10901 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10901">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Piercing into the subarachnoid space of the lumbar region in order to obtain spinal fluid for diagnostic purposes or to inject a drug.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>spinal tap</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lumbar puncture</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10902 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10902">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phase of the human menstrual cycle, usually lasting \(\pu{14 days}\), beginning with formation of the corpus luteum and ending, in the absence of fertilization, with the onset of menstruation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>menstrual cycle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>luteal phase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10936"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10937"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10903 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10903">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hormone made by the pituitary gland that acts on the ovary to control egg maturation and to trigger ovulation. The same hormone acts in the testes to trigger production of testosterone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>LH</oboInOwl:hasRelatedSynonym>
        <rdfs:label>luteinizing hormone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11296"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10903"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10904 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10904">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to lymph or its secretion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>lymphatic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10905 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10905">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to or denoting tissue responsible for producing lymphocytes and antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Lymphoid tissue occurs throughout the body in lymph nodes, thymus, tonsils, and spleen.</rdfs:comment>
        <rdfs:label>lymphoid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11303"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10906 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10906">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis (named after Mary Lyon) that random inactivation of all but one X chromosome occurs in each female mammalian cell in early development, thus explaining why the effect of the X chromosome on phenotype is the same in males with one copy as in females with two copies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Lyon law</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>X-inactivation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lyonization</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The Barr body, visible in some female cells, is an inactivated X chromosome.</rdfs:comment>
        <rdfs:comment>The Lyon hypothesis was designated the Lyon law by the European Molecular Biology Organization (EMBO) in 2011.</rdfs:comment>
        <rdfs:comment>This phenomenon leads to mosaicism for X-linked genes in the female, since the paternal X chromosome is inactivated in some cells and the maternal one in others.</rdfs:comment>
        <rdfs:label>Lyon hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11210"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11385"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10907 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10907">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a group of rare inherited metabolic disorders resulting from a defect in lysosomal function, commonly a deficiency of enzymes required for the metabolism of lipids, glycoproteins, or mucopolysaccharides, resulting in their accumulation in the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>lysosomal storage disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10908 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10908">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder characterized by an abnormally large head and (or) brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>megacephaly</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>megalocephaly</oboInOwl:hasRelatedSynonym>
        <rdfs:label>macrocephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10909 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10909">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder characterized by an abnormally enlarged tongue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This is often seen in Down syndrome.</rdfs:comment>
        <rdfs:label>macroglossia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11325"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10910 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10910">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder characterized by enlargement or elongation of the jaw.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>megagnathia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>macrognathia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10911 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10911">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder characterized by an abnormally large limb or limbs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>megalomelia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>macromelia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10912 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10912">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder characterized by an abnormally large body or body part.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>macrosomia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10913 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10913">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder characterized by an abnormally large size of the mouth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>macrostomia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10914 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10914">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural defect as a result of abnormal development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>malformation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10915 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10915">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurring in a severe form, tending to become progressively worse, resistant to treatment, and likely to result in death. In cancer, cells showing both uncontrolled growth and a tendency to invade and destroy other tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>malignant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10485"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10916 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10916">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Milk-producing organ in female mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mammary gland</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10917 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10917">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital connective tissue disorder associated with mutation of the fibrillin-1 gene FBN1.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Marfan syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10918 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10918">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development of male characteristics, such as facial hair, either as part of normal male maturation, or, pathologically, by people of either sex as a result of hormonal imbalance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>masculinization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10919 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10919">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein made in the fetus that normally leaks, in small amounts, into the mother’s circulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>MSAFP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>If there is an abnormal opening in the fetus, such as a neural tube defect, larger amounts appear in the mother’s serum, providing a screening test for such fetal anomalies.</rdfs:comment>
        <rdfs:label>maternal serum alpha-fetoprotein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11004"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10919"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MSAFP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10920 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10920">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to the maxilla (upper jaw).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>maxillary</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10921 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10921">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital pouch in the ileum resulting from incomplete closure of the yolk sac.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ileal diverticulum</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Meckel diverticulum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11389"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10922 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10922">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First intestinal discharges of the newborn infant, greenish in color and consisting of epithelial cells, mucus, and bile.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>meconium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10979"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10923 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10923">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Median concentration resulting in developmental malformations for \(\pu{50\%}\) of exposed test animals within a predetermined time, e.g., \(\pu{96 h}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>TC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>median teratogenic concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10923"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10924 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10924">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region in the middle of the thorax between the two lungs, containing the regional vessels, trachea, esophagus, bronchi, lymph nodes, and heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mediastinum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11310"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10925 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10925">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>[medulla oblongata] Lower part of the brain stem continuous with the spinal cord, containing neural centers regulating the autonomic functions of breathing, heart rate, and blood pressure. Middle (central) part of an organ, as in adrenal medulla, renal medulla, or the medulla of a lymph node.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>medulla</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10926 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10926">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition of extreme dilation of the colon that can be congenital (as in Hirschsprung disease) or acquired (as when children refuse to defecate).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Aganglionic megacolon is a condition, where parts of the colon have abnormal motor activity, resulting in spasms and massive distention of the colon proximal to the spasm.</rdfs:comment>
        <rdfs:label>megacolon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10801"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11148"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10927 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10927">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder characterized by an abnormally large fingers and (or) toes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>macrodactylia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>megadactyly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10928 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10928">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First menstrual cycle of a woman.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>menarche</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10936"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10929 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10929">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene located in a chromosome that obeys the laws of Mendelian inheritance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Mendelian gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10930"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10930 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10930">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inheritance in which stable and indivisible characteristics are controlled entirely or overwhelmingly by a single genetic locus and transmitted over many generations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Mendelian inheritance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10898"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10931 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10931">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenotype that shows a pattern of Mendelian inheritance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Mendelian trait</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10930"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10932 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10932">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of the three membranes (the dura mater, arachnoid, and pia mater) that line the skull and vertebral canal and enclose the brain and spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>meninges</oboInOwl:hasRelatedSynonym>
        <rdfs:label>meninx</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10933 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10933">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Herniation of the membranes of the brain or spinal cord (see meninx) through a defect in the cranium or spinal column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>meningocele</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10569"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10934 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10934">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Birth defect following failure of the neural tube to close, resulting in protrusion of a sac of nerve tissue and its covering membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>meningoencephalocele</oboInOwl:hasRelatedSynonym>
        <rdfs:label>meningomyelocele</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10935 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10935">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cessation of reproductive capability in a woman, marked by declining ovarian function and an end to menses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>menopause</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10936 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10936">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The period, normally lasting \(\pu{28 days}\) in the human female, during which an ovum matures, is ovulated, and enters the uterus through the Fallopian tubes. If fertilization occurs, the cycle is interrupted by pregnancy; otherwise, the cycle ends with menstruation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>menstrual cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10937 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10937">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cyclic endometrial shedding and discharge of a bloody fluid from the uterus during the menstrual cycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>menses</oboInOwl:hasRelatedSynonym>
        <rdfs:label>menstruation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10936"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10938 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10938">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of a part of a limb, resulting in a shrunken and deformed extremity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>meromelia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10362"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10790"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11089"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10939 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10939">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic migratory cells derived from the neural crest of the head that contribute to the formation of the meninges (see meninx) and become pigment cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ectomesenchyme</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mesectoderm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11001"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10940 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10940">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the vertebrate brain that develops from the middle section of the embryonic neural tube.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>midbrain</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mesencephalon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10941 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10941">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which motile mesenchymal cells undergo a development to planar, polarized fixed cells, forming epithelia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>MET</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This transition occurs in both normal development and tumor metastasis.</rdfs:comment>
        <rdfs:label>mesenchymal-to-epithelial transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10675"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10941"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10942 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10942">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Meshwork of embryonic connective tissue in the mesoderm, from which are formed the bone, muscular, and connective tissues of the body and also the urogenital system, blood vessels, and lymph vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mesenchyme</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11344"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10943 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10943">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membranous sheet attaching various organs to the body wall, especially the peritoneal fold attaching the intestine to the dorsal body wall.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mesentery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11081"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10944 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10944">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Middle layer of cells in the embryo, lying between the ectoderm and the endoderm. It includes the following tissues: Lateral mesoderm: peripheral portion of intraembryonic mesoderm. Intermediate mesoderm: origin of the nephrogenic cord. Parietal (somatic) mesoderm: cell source for the formation of the lateral and ventral body wall. Visceral (branchial, pharyngeal, splanchnic) mesoderm: inner layer of lateral mesoderm that, with the endoderm, provides the cells from which the gut and lungs and their coverings arise.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>embryonic mesoderm</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mesoderm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10471"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11086"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11226"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11252"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10945 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10945">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the embryonic mesentery that is attached to the early stomach.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mesogastrium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10943"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10946 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10946">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic duct of the mesonephros, which in the male becomes the vas deferens and in the female becomes vestigial.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Wolffian duct</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mesonephric duct</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10947"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11358"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11369"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10947 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10947">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Middle part of the embryonic kidney in vertebrates, becoming the adult kidney in fishes and amphibians and the epididymis in reptiles, birds, and mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mesonephros</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10668"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10951"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11141"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10948 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10948">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Single layer of flattened cells forming an epithelium that lines serous cavities such as the peritoneum, pleura, and pericardium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mesothelium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11078"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11082"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11101"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11207"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10949 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10949">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Morphogen, including bone morphogenetic protein, that affects metabolism and homeostasis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>metabologen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10468"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10972"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10950 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10950">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a family of low-molecular mass proteins that binds metals such as zinc, copper, cadmium and mercury.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>metallothionein</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10951 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10951">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Primordium of the permanent kidney, developing later than, and caudal to, the mesonephros.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>metanephros</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10947"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11134"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10952 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10952">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stage of mitosis or meiosis in which the chromosomes become aligned on the equatorial plate of the cell, separating the centromeres.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>metaphase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10502"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10953 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10953">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal transformation of an adult, fully differentiated tissue of one kind into a differentiated tissue of another kind.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>metaplasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10954 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10954">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attachment of a methyl group to a molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Methylation of DNA on cytosine bases is an epigenetic event that alters gene expression.</rdfs:comment>
        <rdfs:label>methylation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10955 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10955">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of an abnormally small head.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>microcephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10956 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10956">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of abnormally small hands.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>microcheiria</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10957 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10957">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of an abnormally small tongue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>microglossia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10958 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10958">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of abnormally small jaws, especially effecting the mandible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>micrognathia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10959 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10959">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Laboratory technique in which dispersed cells from an embryonic organ or tissue, such as the brain, limb bud, or cartilage, are allowed to reaggregate in culture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>micromass culture</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10893"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10960 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10960">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for mutagenicity in which animals are treated with a test agent, after which time the frequency of micronucleated cells is determined. Note: If a test group shows significantly increased levels of micronucleated cells compared to a control group, the chemical is considered capable of inducing chromosomal damage. Procedure to detect clastogenic or aneugenic agents by microscopic examination of chromosomes. Note: The test can be performed in vivo in rodents, or in cell culture (in vitro mammalian cell micronucleus test).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>micronucleus test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10392"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10527"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10961 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10961">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally small penis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>microphallus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10962 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10962">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of abnormally small eyeballs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>microphthalmia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10963 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10963">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-coding segment of DNA consisting of short nucleotide sequences (\(\pu{2\!{-}\! 6}\) base pairs), typically occurring in \(\pu{10\!{-}\! 100}\) consecutive (tandem) repeats.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>short tandem repeat (STR)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Microsatellites are used as markers in determining genetic diversity, in identifying important genetic traits, in forensic science, in population studies, and in determining paternity.</rdfs:comment>
        <rdfs:comment>The number of repeats varies between members of any given species.</rdfs:comment>
        <rdfs:label>microsatellite</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10964 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10964">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of an abnormally small opening of the mouth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>microstomia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10965 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10965">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Middle section of the digestive tract in a vertebrate embryo, from which the ileum, jejunum, and portions of the duodenum and colon develop.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>mesenteron</oboInOwl:hasRelatedSynonym>
        <rdfs:label>midgut</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10869"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10966 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10966">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurological disease caused by methylmercury, first seen in subjects ingesting contaminated fish from Minamata Bay in Japan.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Minamata disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10967 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10967">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-coding segment of DNA, found throughout the genome, usually near the ends of chromosomes, that consists of tandem repeats of sequences of about \(\pu{10\!{-}\! 100}\) base pairs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>variable number tandem repeat (VNTR)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These VNTRs are useful for genetic research and analysis.</rdfs:comment>
        <rdfs:label>minisatellite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10963"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10968 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10968">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lay term for spontaneous abortion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>miscarriage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10969 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10969">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use in epidemiological studies of techniques of molecular biology, such as DNA profiling and genetic analysis, with the aim of detecting genetic patterns characteristic of susceptible populations or of groups at risk of disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>molecular epidemiology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10666"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10970 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10970">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of one eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>monophthalmos</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10971 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10971">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder in which body cells have only one pair instead of the normal two pairs of a particular chromosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>monosomy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10972 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10972">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of various signalling factors in embryonic tissue that influences the movement and organization of cells during morphogenesis by forming a concentration gradient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>morphogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10973"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10973 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10973">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Shaping of an organism during embryological development by differentiation of cells, tissues, organs, and organ systems, according to the genetic program of the organism, and influenced by morphogens and environmental conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>morphogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10649"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10972"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10974 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10974">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to structure or form.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>morphological</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10975 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10975">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Early multi-celled stage of the embryo from which the blastocyst is formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>morula</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10976 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10976">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which an individual or an organism that develops from a single zygote has two or more cell populations that differ in genetic constitution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Mosaicism is seen in humans in Down syndrome, Turner syndrome and Klinefelter syndrome.</rdfs:comment>
        <rdfs:label>mosaicism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10877"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11333"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10977 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10977">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Energy-dependent forward movement of the sperm, allowing it to reach and penetrate the egg.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Decreased sperm motility is an indicator of reduced fertility.</rdfs:comment>
        <rdfs:label>sperm motility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10978 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10978">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Layer of epithelial tissue with a thin underlying layer of connective tissue (the lamina propria) that lines many body cavities, including the gut, respiratory passages, and tubular organs; it secretes, and is covered in, mucus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>mucosa</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mucous membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10883"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10979"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10979 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10979">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Slippery viscous fluid, consisting largely of water and glycoproteins, secreted by mucous membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>mucus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10978"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10980 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10980">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of a placenta with many lobes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>multicotyledonary placentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10981 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10981">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transmission from parents to offspring of a trait that is determined by multiple genetic and environmental factors, each with a small effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>multifactorial inheritance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10982 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10982">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal test of reproductive toxicity in which two to three generations of the test organism are exposed to the substance being assessed. Animal test of reproductive toxicity in which only one generation is exposed and effects on subsequent generations are assessed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>multigenerational study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10983 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10983">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Very small infectious microorganism, related to bacteria, but without a cell wall.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Genital mycoplasmas may lead to spontaneous preterm labor or perinatal morbidity and mortality.</rdfs:comment>
        <rdfs:label>mycoplasma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10754"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10880"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11079"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10984 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10984">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the brain in the embryo that gives rise to the medulla oblongata.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>myelencephalon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10985 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10985">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The acquisition, development, or formation of a myelin sheath around a nerve fiber.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>myelination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10986 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10986">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immature bone marrow cell that is a precursor of the granulocyte series.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>myeloblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10779"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10987 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10987">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Harming bone marrow or any of its components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>myelotoxic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10988 -->

