    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10767 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10767">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organized aggregation of cells functioning as a secretory or excretory organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
