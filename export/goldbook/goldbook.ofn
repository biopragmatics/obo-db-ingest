AnnotationAssertion(dcterms:description goldbook:13427 "Receptor involved in pathogen recognition, in clearance of endogenous serum glycoproteins, and in antigen presentation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13427 "MMR")
AnnotationAssertion(rdfs:comment goldbook:13427 "Clusters of lectin domains bind mannose residues on microbial and fungal surfaces in a \\(\\ce{Ca^{2+}}\\)-dependent manner."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13427 "The receptor activates the C3 component of complement."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13427 goldbook:12887)
AnnotationAssertion(mito:isMentionedBy goldbook:13427 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13427 "current"^^xsd:string)
Declaration(Class(goldbook:13428))
AnnotationAssertion(rdfs:label goldbook:13428 "macropinocytosis")
AnnotationAssertion(dcterms:description goldbook:13428 "'High-volume' pinocytosis by which dendritic cells engulf relatively large volumes of fluid from their surroundings, enabling them to take in many antigens nonspecifically.")
AnnotationAssertion(rdfs:seeAlso goldbook:13428 goldbook:13087)
AnnotationAssertion(mito:isMentionedBy goldbook:13428 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13428 "current"^^xsd:string)
Declaration(Class(goldbook:13429))
AnnotationAssertion(rdfs:label goldbook:13429 "major basic protein")
AnnotationAssertion(dcterms:description goldbook:13429 "Small basic arginine-rich peptide (\\(\\pu{pI 10.9}\\), molecular mass of \\(\\pu{13.8 kDa}\\)) in the granules of eosinophils that kills helminths and protozoa.")
AnnotationAssertion(rdfs:seeAlso goldbook:13429 goldbook:13117)
AnnotationAssertion(mito:isMentionedBy goldbook:13429 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13429 "current"^^xsd:string)
Declaration(Class(goldbook:13430))
AnnotationAssertion(rdfs:label goldbook:13430 "major histocompatibility complex")
AnnotationAssertion(dcterms:description goldbook:13430 "Cluster of genes encoding cell surface molecules involved in antigen presentation to T cells. In humans, they are found on chromosome 6 and in mice on chromosome 17. They are polymorphic and code for antigens that lead to rapid graft rejection between members of a single species that differ at these loci.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13430 "MHC")
AnnotationAssertion(rdfs:comment goldbook:13430 "Several classes of protein such as MHC class I and II molecules are gene products encoded in this region. The MHC-encoded molecules are also known as human leukocyte antigens (HLA)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:13190)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:13191)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:13432)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:13431)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:12887)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:13179)
AnnotationAssertion(rdfs:seeAlso goldbook:13430 goldbook:13230)
AnnotationAssertion(mito:isMentionedBy goldbook:13430 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13430 "current"^^xsd:string)
Declaration(Class(goldbook:13431))
AnnotationAssertion(rdfs:label goldbook:13431 "major histocompatibility complex class I molecule")
AnnotationAssertion(dcterms:description goldbook:13431 "Surface protein encoded by the major histocompatibility complex (MHC) expressed on all nucleated cells, presenting antigen-derived peptides.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13431 "class I MHC gene product")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13431 "MHC class I molecule")
AnnotationAssertion(rdfs:seeAlso goldbook:13431 goldbook:12887)
AnnotationAssertion(rdfs:seeAlso goldbook:13431 goldbook:13430)
AnnotationAssertion(mito:isMentionedBy goldbook:13431 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13431 "current"^^xsd:string)
Declaration(Class(goldbook:13432))
AnnotationAssertion(rdfs:label goldbook:13432 "major histocompatibility complex class II molecule")
AnnotationAssertion(dcterms:description goldbook:13432 "Surface protein encoded by the major histocompatibility complex (MHC) expressed on antigen-presenting cells (APCs), presenting antigen-derived peptides.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13432 "class II MHC gene product")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13432 "MHC class II molecule")
AnnotationAssertion(rdfs:seeAlso goldbook:13432 goldbook:12887)
