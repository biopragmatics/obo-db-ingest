Declaration(Class(goldbook:I03273))
AnnotationAssertion(rdfs:label goldbook:I03273 "isodiazenes")
AnnotationAssertion(dcterms:description goldbook:I03273 "Compounds having the structure . These compounds can also be called diazanylidenes or hydrazinylidenes. They have also been called by the trivial name azamines and the incorrectly formed name 1,1-diazenes. They should not be called 'aminonitrenes'.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:I03273 "azamines")
