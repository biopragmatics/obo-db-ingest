Declaration(Class(goldbook:11321))
AnnotationAssertion(rdfs:label goldbook:11321 "trisomy")
AnnotationAssertion(dcterms:description goldbook:11321 "Condition of having three homologous chromosomes in each somatic cell instead of the normal pair.")
AnnotationAssertion(rdfs:seeAlso goldbook:11321 goldbook:10807)
AnnotationAssertion(rdfs:seeAlso goldbook:11321 goldbook:11226)
AnnotationAssertion(mito:isMentionedBy goldbook:11321 doi:10.1515/pac-2015-1202)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11321 "current"^^xsd:string)
Declaration(Class(goldbook:11322))
AnnotationAssertion(rdfs:label goldbook:11322 "trisomy 8")
AnnotationAssertion(dcterms:description goldbook:11322 "Presence of an extra chromosome 8.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11322 "Warkany syndrome 2")
AnnotationAssertion(rdfs:comment goldbook:11322 "Complete trisomy 8 is lethal, but most affected individuals show mosaicism with craniofacial abnormalities, a short wide neck, multiple joint defects, and deep creases in the palms and soles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11322 goldbook:10565)
AnnotationAssertion(rdfs:seeAlso goldbook:11322 goldbook:10976)
AnnotationAssertion(rdfs:seeAlso goldbook:11322 goldbook:11321)
AnnotationAssertion(mito:isMentionedBy goldbook:11322 doi:10.1515/pac-2015-1202)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11322 "current"^^xsd:string)
Declaration(Class(goldbook:11323))
AnnotationAssertion(rdfs:label goldbook:11323 "trisomy 13")
AnnotationAssertion(dcterms:description goldbook:11323 "Presence of part or all of an extra chromosome 13 from nondisjunction during meiosis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11323 "Patau syndrome")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11323 "trisomy D")
AnnotationAssertion(rdfs:comment goldbook:11323 "This leads to multiple congenital abnormalities and mental retardation, and is usually fatal in early childhood."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11323 "Patau syndrome can also occur with an extra partial chromosome 13 resulting from a Robertsonian translocation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11323 goldbook:11188)
AnnotationAssertion(rdfs:seeAlso goldbook:11323 goldbook:10554)
AnnotationAssertion(mito:isMentionedBy goldbook:11323 doi:10.1515/pac-2015-1202)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11323 "current"^^xsd:string)
Declaration(Class(goldbook:11324))
AnnotationAssertion(rdfs:label goldbook:11324 "trisomy 18")
AnnotationAssertion(dcterms:description goldbook:11324 "Presence of part or all of an extra chromosome 18 from nondisjunction during meiosis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11324 "Edwards syndrome")
AnnotationAssertion(rdfs:comment goldbook:11324 "This leads to multiple congenital abnormalities and mental retardation, and is usually fatal in early childhood."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11324 goldbook:10554)
AnnotationAssertion(mito:isMentionedBy goldbook:11324 doi:10.1515/pac-2015-1202)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11324 "current"^^xsd:string)
Declaration(Class(goldbook:11325))
AnnotationAssertion(rdfs:label goldbook:11325 "trisomy 21")
AnnotationAssertion(dcterms:description goldbook:11325 "Presence of an extra chromosome 21.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11325 "Down syndrome")
AnnotationAssertion(rdfs:comment goldbook:11325 "This produces a characteristic constellation of physical abnormalities with delayed growth and mental development, but is compatible with life into adulthood."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11325 "The formerly used terms mongoloid and mongolism are now considered offensive."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11325 goldbook:10348)
AnnotationAssertion(mito:isMentionedBy goldbook:11325 doi:10.1515/pac-2015-1202)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11325 "current"^^xsd:string)
Declaration(Class(goldbook:11326))
AnnotationAssertion(rdfs:label goldbook:11326 "trophectoderm")
AnnotationAssertion(dcterms:description goldbook:11326 "Outer layer of the blastocyst that contacts the endometrium, establishes nutrition for the embryo, and differentiates into the trophoblast.")
AnnotationAssertion(rdfs:seeAlso goldbook:11326 goldbook:10462)
AnnotationAssertion(rdfs:seeAlso goldbook:11326 goldbook:10660)
AnnotationAssertion(rdfs:seeAlso goldbook:11326 goldbook:11327)
