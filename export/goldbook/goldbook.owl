        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>nipple</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11017 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11017">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Growth factor of the transforming growth factor \(\upbeta\) (TGF-\(\upbeta\)) superfamily, coded by a gene designated NODAL, that plays crucial roles in embryogenesis, particularly in signalling from the primitive streak to the mesoderm to establish left-right asymmetry as well as aspects of stem cell differentiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>nodal protein</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The name derives from expression of the gene in the primitive node.</rdfs:comment>
        <rdfs:label>nodal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11129"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11131"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11018 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11018">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Signaling protein released by the notochord, important in somite patterning and nervous system development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>NOG</oboInOwl:hasRelatedSynonym>
        <rdfs:label>noggin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11021"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11231"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11235"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NOG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11019 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11019">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of chromosomes to separate during meiosis, resulting in an uneven distribution of chromosomes in the two gametes (\(\pu{24}\) and \(\pu{22}\) in humans).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>nondisjunction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11020 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11020">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Catecholamine hormone acting as a postganglionic adrenergic mediator at $\ce{\upalpha\!\mbox{-}}$ and $\ce{\upbeta\!\mbox{-}adrenergic}$ receptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>2-diol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4-[(1S)-2-amino-1-hydroxyethyl]benzene-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>norepinephrine</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Noradrenaline has strong vasoconstrictive effects.</rdfs:comment>
        <rdfs:comment>Noradrenaline is also stored in, and released from, chromaffin granules in the adrenal medulla (see adrenal gland).</rdfs:comment>
        <rdfs:label>noradrenaline</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10522"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11021 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11021">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rod-shaped structure of cells derived from mesoderm, lying ventral to the neural tube and defining the primitive axis of the embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>notochord</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11022 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11022">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structure, formed from microtubules, that draws the newly duplicated chromosomes apart during mitosis and meiosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>mitotic spindle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nuclear spindle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11023 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11023">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Steroid hormone receptor, found in the cytosol, that upon ligand binding translocates into the nucleus and interacts with DNA as a homodimer to drive specific gene transcription.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>nuclear type I receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11024"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11024 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11024">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Steroid hormone receptor, found in the nucleus, that upon ligand binding interacts with DNA as a heterodimer (usually with the retinoid X receptor, RXR) to drive specific gene transcription.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>nuclear type II receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11023"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11025 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11025">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Never having been pregnant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>nulligravida</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11026"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11026 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11026">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Never having given birth to a live infant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>nulliparous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11025"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11027 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11027">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Back part of the head or skull.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>occiput</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11028 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11028">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dentin-forming cell of the pulp cavity of a tooth, arising from the mesenchyme of the neural crest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>odontoblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11001"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11029 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11029">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Child or children of a person, or the young of an animal, in relation to the parent(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>offspring</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11030 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11030">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of fewer than the usual number of digits, resulting in humans having fewer than five fingers or toes on a hand or foot.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>oligodactyly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11031 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11031">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of some of the teeth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>oligodontia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11032 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11032">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Infrequent or scanty menstruation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>oligomenomenorrhea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10937"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11033 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11033">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subnormal concentration of sperm in the male ejaculate (see ejaculation).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>oligospermatism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oligozoospermia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>oligospermia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10641"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11034 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11034">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fold of peritoneal membrane passing between the stomach and another abdominal organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>omentum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11035"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11036"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11082"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11035 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11035">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Omentum passing from the greater curvature of the stomach in front of the small intestine, folding back on itself to fuse into four layers of peritoneal membrane, and ascending to the transverse colon.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The greater omentum functions in fat deposition, contains islands of macrophages that contribute to immune function, and can delimit areas of traumatic tissue damage or infection.</rdfs:comment>
        <rdfs:label>greater omentum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11034"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11082"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11036 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11036">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Double-layer of peritoneal membrane (omentum) passing between the lesser curvature of the stomach and the duodenum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>lesser omentum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11034"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11082"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11037 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11037">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital herniation of abdominal viscera into the base of the umbilical cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>exomphalos</oboInOwl:hasRelatedSynonym>
        <rdfs:label>omphalocele</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10689"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10748"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11339"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11038 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11038">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lesser developed of two monozygotic twins that failed to separate completely during embryogenesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The omphalosite is joined to the other twin (the autosite) by the umbilical vessels, receives its blood supply from the placenta, and is incapable of survival after separation from the placenta.</rdfs:comment>
        <rdfs:label>omphalosite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10446"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11039 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11039">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which male rodents are dosed with a test substance for at least one spermatogenic cycle, and females for two estrous cycles, and then further exposed during mating, pregnancy, and nursing; adverse effects on reproduction, parturition, lactation and postnatal growth are studied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>one-generation reprotox study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10684"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10881"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11075"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11111"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11240"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11334"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11040 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11040">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immature precursor of the ovum resident in the ovary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ovocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:label>oocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11041 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11041">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Oocyte during growth phase before completion of the first meiotic division.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The primary oocyte is diploid and becomes a secondary oocyte before birth.</rdfs:comment>
        <rdfs:label>primary oocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10608"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11042"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11042 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11042">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Oocyte in which the first meiotic division to a haploid cell has been completed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>secondary oocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11041"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11043 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11043">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of formation and development of an ovum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>oogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11042"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11044"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11044 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11044">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Primitive germ cell that proliferates by mitosis and develops into a primary oocyte prior to birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>oogonium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10762"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11041"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11045 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11045">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to the eye or vision.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>optic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11046 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11046">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cavity in the skull of a vertebrate that contains the eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>eye socket</oboInOwl:hasRelatedSynonym>
        <rdfs:label>orbit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11047 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11047">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specialized collection of epithelial hair cells in the inner ear, involved in hearing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>spiral organ</oboInOwl:hasRelatedSynonym>
