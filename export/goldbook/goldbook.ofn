Declaration(Class(goldbook:C00946))
AnnotationAssertion(rdfs:label goldbook:C00946 "chain")
AnnotationAssertion(dcterms:description goldbook:C00946 "The whole or part of a macromolecule, an oligomer molecule or a block, comprising a linear or branched sequence of constitutional units between two boundary constitutional units, each of which may be either an end-group, a branch point or an otherwise-designated characteristic feature of the macromolecule.")
AnnotationAssertion(rdfs:comment goldbook:C00946 "Except in linear single-strand macromolecules, the definition of a chain may be somewhat arbitrary."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00946 "A cyclic macromolecule has no end groups but may nevertheless be regarded as a chain."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00946 "Any number of branch points may be present between the boundary units."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00946 "Where appropriate, definitions relating to 'macromolecule' may also be applied to 'chain'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C00946 goldbook:B00682)
AnnotationAssertion(rdfs:seeAlso goldbook:C00946 goldbook:B00728)
AnnotationAssertion(rdfs:seeAlso goldbook:C00946 goldbook:C01288)
AnnotationAssertion(rdfs:seeAlso goldbook:C00946 goldbook:E02092)
AnnotationAssertion(rdfs:seeAlso goldbook:C00946 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:C00946 goldbook:O04286)
AnnotationAssertion(rdfs:seeAlso goldbook:C00946 goldbook:ST06775)
AnnotationAssertion(mito:isMentionedBy goldbook:C00946 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00946 "current"^^xsd:string)
Declaration(Class(goldbook:C00948))
AnnotationAssertion(rdfs:label goldbook:C00948 "chain branching")
AnnotationAssertion(dcterms:description goldbook:C00948 "When in a chain reaction there is a net increase in the number of chain carrier there is said to be chain branching. A simple example of a chain-propagating reaction leading to chain branching is:  in which there is one chain carrier (an oxygen atom) on the left and two chain carriers (a hydrogen atom and a hydroxyl radical) on the right.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00948 goldbook:C00949)
AnnotationAssertion(rdfs:seeAlso goldbook:C00948 goldbook:C00960)
AnnotationAssertion(rdfs:seeAlso goldbook:C00948 goldbook:C00959)
AnnotationAssertion(rdfs:seeAlso goldbook:C00948 goldbook:D01557)
AnnotationAssertion(mito:isMentionedBy goldbook:C00948 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00948 "current"^^xsd:string)
Declaration(Class(goldbook:C00949))
AnnotationAssertion(rdfs:label goldbook:C00949 "chain carrier")
AnnotationAssertion(dcterms:description goldbook:C00949 "A species, such as an atom or free radical, which is involved in chain-propagating reactions is known as a chain carrier.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00949 goldbook:C00859)
AnnotationAssertion(rdfs:seeAlso goldbook:C00949 goldbook:C00959)
AnnotationAssertion(rdfs:seeAlso goldbook:C00949 goldbook:F02519)
