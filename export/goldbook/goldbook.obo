property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:11439
name: energy of the highest occupied molecular orbital
def: "The energy of the highest energy level in the ground state of a molecule that contains electrons\, sometimes used as a measure of nucleophilicity in QSAR  models."
property_value: mito:isMentionedBy doi:10.1515/pac-2012-1204
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:11440
name: energy of the lowest unoccupied molecular orbital
def: "The energy of the lowest energy level of a molecule that contains no electrons in the ground state\, sometimes used as a measure of electrophilicity in QSAR  models."
comment: "Also known as the energy of the lowest empty molecular orbital, \(E_{\rm{LEMO}}\)."
property_value: mito:isMentionedBy doi:10.1515/pac-2012-1204
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:11441
name: expert system
def: "A system that predicts properties or activities of chemicals from rules devised by domain experts."
property_value: mito:isMentionedBy doi:10.1515/pac-2012-1204
property_value: hasStatus "current" xsd:string
