Declaration(Class(goldbook:IT07404))
AnnotationAssertion(rdfs:label goldbook:IT07404 "isolampsic point")
AnnotationAssertion(dcterms:description goldbook:IT07404 "Same as isoemissive point.")
AnnotationAssertion(rdfs:comment goldbook:IT07404 "The term derives from the Greek words isos: equal, and lampein: to emit light or to shine. Isolampsic is thus parallel to isosbestic."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07404 goldbook:I03277)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07404 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07404 "current"^^xsd:string)
