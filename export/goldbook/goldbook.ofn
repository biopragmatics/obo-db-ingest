AnnotationAssertion(dcterms:description goldbook:11703 "State of severe confusion, characterized by restlessness, hallucinations and hyperactivity, during which the person affected may be isolated from normal communication.")
AnnotationAssertion(rdfs:comment goldbook:11703 "Delirium can result from drug or alcohol toxicity or withdrawal, infection, brain tumor, head injury, metabolic disturbances, etc."^^xsd:string)
