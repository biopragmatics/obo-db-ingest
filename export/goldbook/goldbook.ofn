Declaration(Class(goldbook:10906))
AnnotationAssertion(rdfs:label goldbook:10906 "Lyon hypothesis")
AnnotationAssertion(dcterms:description goldbook:10906 "Hypothesis (named after Mary Lyon) that random inactivation of all but one X chromosome occurs in each female mammalian cell in early development, thus explaining why the effect of the X chromosome on phenotype is the same in males with one copy as in females with two copies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10906 "Lyon law")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10906 "lyonization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10906 "X-inactivation")
AnnotationAssertion(rdfs:comment goldbook:10906 "The Barr body, visible in some female cells, is an inactivated X chromosome."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10906 "This phenomenon leads to mosaicism for X-linked genes in the female, since the paternal X chromosome is inactivated in some cells and the maternal one in others."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10906 "The Lyon hypothesis was designated the Lyon law by the European Molecular Biology Organization (EMBO) in 2011."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10906 goldbook:11210)
AnnotationAssertion(rdfs:seeAlso goldbook:10906 goldbook:11385)
AnnotationAssertion(rdfs:seeAlso goldbook:10906 goldbook:11386)
AnnotationAssertion(rdfs:seeAlso goldbook:10906 goldbook:10976)
AnnotationAssertion(mito:isMentionedBy goldbook:10906 doi:10.1515/pac-2015-1202)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10906 "current"^^xsd:string)
