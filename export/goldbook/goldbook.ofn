AnnotationAssertion(rdfs:seeAlso goldbook:L03508 goldbook:L03511)
AnnotationAssertion(rdfs:seeAlso goldbook:L03508 goldbook:CT01038)
AnnotationAssertion(rdfs:seeAlso goldbook:L03508 goldbook:C01329)
AnnotationAssertion(rdfs:seeAlso goldbook:L03508 goldbook:D01752)
