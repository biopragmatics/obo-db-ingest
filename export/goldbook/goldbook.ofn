AnnotationAssertion(obo:goldbook#hasStatus goldbook:11998 "current"^^xsd:string)
Declaration(Class(goldbook:11999))
AnnotationAssertion(rdfs:label goldbook:11999 "secondary parkinsonism")
AnnotationAssertion(dcterms:description goldbook:11999 "Neurological syndrome resembling Parkinson disease and often resulting from decreased dopamine production as a consequence of neurodegenerative changes in the substantia nigra.")
AnnotationAssertion(rdfs:comment goldbook:11999 "There are a number of known causes for secondary parkinsonism, including exposure to a number of neurotoxic substances."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11999 goldbook:11998)
AnnotationAssertion(rdfs:seeAlso goldbook:11999 goldbook:11723)
AnnotationAssertion(rdfs:seeAlso goldbook:11999 goldbook:11948)
AnnotationAssertion(rdfs:seeAlso goldbook:11999 goldbook:12103)
