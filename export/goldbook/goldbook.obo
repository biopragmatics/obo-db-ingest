[Term]
id: goldbook:09623
name: number of generations
def: "Number of constitutional repeating units on the path from the free valence to any end-group of a dendron."
comment: "The number of generations \(G\) is a cardinal number. A dendron with \(G = n\) generations of constitutional repeating units should be called \(n\mbox{-}\rm{generation}\) dendron. The terms "dendron of \(n^{\rm{th}}\) generation" or "\(n^{\rm{th}}\) generation dendron" are not acceptable."
property_value: mito:isMentionedBy doi:10.1515/pac-2016-1217
property_value: hasStatus "current" xsd:string
