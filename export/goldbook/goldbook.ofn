AnnotationAssertion(dcterms:description goldbook:16034 "Boundary value defined so that a stated fraction of the reference values is less than or exceeds that boundary value with a stated probability.")
AnnotationAssertion(mito:isMentionedBy goldbook:16034 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16034 "current"^^xsd:string)
