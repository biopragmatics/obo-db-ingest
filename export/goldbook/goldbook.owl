    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16265 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16265">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a group of small proteins (peptides) that serve as neurotransmitters in the brain, autonomic nervous system and neuroendocrine system.</dcterms:description>
