Declaration(Class(goldbook:P04743))
AnnotationAssertion(rdfs:label goldbook:P04743 "polymer–polymer complex")
AnnotationAssertion(dcterms:description goldbook:P04743 "Complex, at least two components of which are different polymers.")
AnnotationAssertion(rdfs:comment goldbook:P04743 "A complex is a molecular entity formed from two or more components that can be ionic or uncharged."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04743 "Although the intrinsic binding energy between the individual interacting sites giving rise to the complex is weaker than a covalent bond, the total binding energy for any single molecule may exceed the energy of a single covalent bond."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04743 "The properties of a complex defined here differ from those given elsewhere because, owing to the repeating nature of a polymer molecule, many interacting sites may be present, which together will provide stronger bonding than a single covalent bond."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04743 goldbook:BT07001)
AnnotationAssertion(rdfs:seeAlso goldbook:P04743 goldbook:C01384)
AnnotationAssertion(rdfs:seeAlso goldbook:P04743 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:P04743 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04743 "current"^^xsd:string)
Declaration(Class(goldbook:P04748))
AnnotationAssertion(rdfs:label goldbook:P04748 "polymorphic transition")
AnnotationAssertion(dcterms:description goldbook:P04748 "A reversible transition of a solid crystalline phase at a certain temperature and pressure (the inversion point) to another phase of the same chemical composition with a different crystal structure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04748 "enantiotropic transition")
AnnotationAssertion(rdfs:comment goldbook:P04748 "In a liquid-crystal transition, this term refers to phase changes in the smectic state or columnar discotic state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04748 goldbook:E02084)
AnnotationAssertion(rdfs:seeAlso goldbook:P04748 goldbook:I03149)
AnnotationAssertion(rdfs:seeAlso goldbook:P04748 goldbook:R05379)
