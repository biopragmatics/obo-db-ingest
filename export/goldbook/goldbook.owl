    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10768 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10768">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any small rounded mass or gland-like body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>glans</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10769 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10769">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rounded mass of sensitive erectile tissue that forms the head of the clitoris.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>glans clitoridis</rdfs:label>
