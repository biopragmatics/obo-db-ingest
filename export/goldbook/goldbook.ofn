Declaration(Class(goldbook:C00784))
AnnotationAssertion(rdfs:label goldbook:C00784 "calorie")
AnnotationAssertion(dcterms:description goldbook:C00784 "Non-SI unit of energy. There are three differently defined calories: thermochemical calorie (\\(\\rm{cal}_{\\rm{th}} = 4.184\\ \\rm{J}\\)), international steam table calorie (\\(\\rm{cal}_{\\rm{IT}} = 4.1868\\ \\rm{J}\\)), \\(15\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\) calorie (\\(\\rm{cal}_{15} = 4.1855\\ \\rm{J}\\)), however only the symbol \\(\\rm{cal}\\) is usually used.")
AnnotationAssertion(mito:isMentionedBy goldbook:C00784 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00784 "current"^^xsd:string)
Declaration(Class(goldbook:C00785))
AnnotationAssertion(rdfs:label goldbook:C00785 "calorimetric titration")
AnnotationAssertion(dcterms:description goldbook:C00785 "A titration performed in a calorimeter which produces a plot of heat change versus volume of titrant. This is the preferred term for experiments in which the main goal is the measurement of thermodynamic parameters. Because such experiments may be performed in any of a variety of types of calorimeters with varying degrees of calorimetric accuracy, it is important that the reporting of such results include an assessment of accuracy and precision. The term stands in contrast to the main emphasis in enthalpimetric analysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00785 goldbook:E02131)
AnnotationAssertion(rdfs:seeAlso goldbook:C00785 goldbook:P04799)
AnnotationAssertion(rdfs:seeAlso goldbook:C00785 goldbook:T06386)
