id: goldbook:I03014
name: individual perception threshold
def: "A term used in odour testing which signifies the lowest concentration of a particular species at which a subject indicates both an initial positive and repeated response."
synonym: "IPT" RELATED OMO:0003000 []
property_value: mito:isMentionedBy doi:10.1351/pac199062112167
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:I03015
name: induced radioactivity
def: "Radioactivity induced by irradiation."
property_value: mito:isMentionedBy doi:10.1351/pac198254081533
property_value: hasStatus "current" xsd:string
