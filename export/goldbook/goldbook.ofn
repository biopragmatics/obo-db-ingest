AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT06827 "current"^^xsd:string)
Declaration(Class(goldbook:HT06886))
AnnotationAssertion(rdfs:label goldbook:HT06886 "hemodialysis")
AnnotationAssertion(dcterms:description goldbook:HT06886 "Dialysis process in which undesired metabolites and toxic by-products, such as urea and creatine, are removed from blood.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT06886 goldbook:D01666)
AnnotationAssertion(mito:isMentionedBy goldbook:HT06886 doi:10.1351/pac199668071479)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT06886 "current"^^xsd:string)
Declaration(Class(goldbook:HT06908))
AnnotationAssertion(rdfs:label goldbook:HT06908 "health surveillance")
AnnotationAssertion(dcterms:description goldbook:HT06908 "The procedure for effects of work on the health of employees.")
AnnotationAssertion(mito:isMentionedBy goldbook:HT06908 doi:10.1351/pac200173060993)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT06908 "current"^^xsd:string)
Declaration(Class(goldbook:HT06962))
AnnotationAssertion(rdfs:label goldbook:HT06962 "Hansch analysis")
AnnotationAssertion(dcterms:description goldbook:HT06962 "Hansch analysis is the investigation of the quantitative relationship between the biological activity of a series of compounds and their physicochemical substituent or global parameters representing hydrophobic, electronic, steric and other effects using multiple regression correlation methodology.")
AnnotationAssertion(mito:isMentionedBy goldbook:HT06962 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT06962 "current"^^xsd:string)
Declaration(Class(goldbook:HT06963))
AnnotationAssertion(rdfs:label goldbook:HT06963 "hydrophilicity")
AnnotationAssertion(dcterms:description goldbook:HT06963 "Hydrophilicity is the tendency of a molecule to be solvated by water.")
AnnotationAssertion(mito:isMentionedBy goldbook:HT06963 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT06963 "current"^^xsd:string)
Declaration(Class(goldbook:HT06964))
AnnotationAssertion(rdfs:label goldbook:HT06964 "hydrophobicity")
AnnotationAssertion(dcterms:description goldbook:HT06964 "Hydrophobicity is the association of non-polar groups or molecules in an aqueous environment which arises from the tendency of water to exclude non-polar molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT06964 goldbook:A00472)
AnnotationAssertion(mito:isMentionedBy goldbook:HT06964 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT06964 "current"^^xsd:string)
Declaration(Class(goldbook:HT07035))
AnnotationAssertion(rdfs:label goldbook:HT07035 "Hückel molecular orbital theory")
AnnotationAssertion(dcterms:description goldbook:HT07035 "The simplest molecular orbital theory of $\\ce{\\uppi\\!\\mbox{-}conjugated}$ molecular systems. It uses the following approximations: $\\ce{\\uppi\\!\\mbox{-}electron}$ approximation; LCAO representation of the $\\ce{\\uppi\\!\\mbox{-}molecular orbitals}$; neglect of electron-electron and nuclear-nuclear repulsions (in fact, the assumption that these cancel). The diagonal elements of the effective Hamiltonian, coulombic integrals, and the off-diagonal elements, resonance integrals, (accounted for only directly bonded atoms) are chosen as empirical parameters, all overlap integrals being neglected.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:HT07035 "HMO")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:HT07035 "HMO theory")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07035 goldbook:M03996)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07035 goldbook:R05326)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07035 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07035 "current"^^xsd:string)
Declaration(Class(goldbook:HT07041))
AnnotationAssertion(rdfs:label goldbook:HT07041 "harmonic approximation")
AnnotationAssertion(dcterms:description goldbook:HT07041 "The approximation of the full nuclear potential of a molecular system in its equilibrium geometry and in the vicinity of the respective minimum on the potential energy surface by the function \\[V=\\frac{1}{2}\\ \\sum _{\\begin{array}{c} i,j=1 \\end{array}}^{3\\ N}\\frac{\\partial ^{2}V}{\\partial q_{i}\\partial q_{j}}\\] where \\(q_{i}\\) are mass-weighted cartesian displacements of nuclei relative to their equilibrium positions. The approximation allows one to describe vibrational motion in terms of independent vibrational modes (normal modes) each of which is governed by a simple one-dimensional harmonic potential.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07041 goldbook:ET07031)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07041 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07041 "current"^^xsd:string)
Declaration(Class(goldbook:HT07048))
AnnotationAssertion(rdfs:label goldbook:HT07048 "homodesmotic reaction")
AnnotationAssertion(dcterms:description goldbook:HT07048 "A subclass of isodesmic reactions in which reactants and products contain equal numbers of carbon atoms in corresponding states of hybridization; moreover, there is matching of the carbon-hydrogen bonds in terms of the number of hydrogen atoms joined to the individual carbon atoms. To achieve all this matching, one should significantly extend the number and types of reference molecules. In the aliphatic series of hydrocarbons these are propane, isobutane and neopentanes as well as propene and isobutene; for aromatics—buta-1,3-diene, 2-vinylbutadiene (3-methylidenehexa-1,5-diene) and 2,3-divinylbutadiene (3,4-bismethylidenehexa-1,5-diene). Thus to assess strain energy of cyclopropane and aromatic stabilization of benzene the following homodesmotic reactions are to be respectively analysed.$\\ce{c-(CH2)3 + 3CH3–CH3 -> 3CH3CH2CH3}$\\(\\Delta H_{\\exp}^{\\circ} = \\pu{-26.5 kcal/mol}\\) (\\(\\pu{110.9 kJ/mol}\\)).$\\ce{C6H6 + 3CH2=CH2 -> 3CH2=CH–CH=CH2}$(trans)\\(\\Delta H_{\\rm{calc}}^{\\circ} \\rm{(MP2/6{-}31G^{**})} = \\pu{23.9 kcal/mol}\\) (\\(\\pu{100.0 kJ/mol}\\)) Due to closer matching of the hybridization states of the atoms of reactants and products as compared to isodesmic reactions, the homodesmotic reactions give more accurate estimates of the intrinsic strain and the cyclic delocalization. The definition may be extended to molecules with heteroatoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07048 goldbook:D01583)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07048 goldbook:H02874)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07048 goldbook:H02889)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07048 goldbook:S06037)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07048 goldbook:ST07108)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07048 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07048 "current"^^xsd:string)
Declaration(Class(goldbook:HT07049))
AnnotationAssertion(rdfs:label goldbook:HT07049 "hybrid orbital")
AnnotationAssertion(dcterms:description goldbook:HT07049 "An atomic orbital derived through hybridization of atomic orbitals with different angular momentum quantum numbers located at a given atom.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07049 goldbook:A00353)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07049 goldbook:H02874)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07049 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07049 "current"^^xsd:string)
Declaration(Class(goldbook:HT07050))
AnnotationAssertion(rdfs:label goldbook:HT07050 "hydrogen bond")
AnnotationAssertion(dcterms:description goldbook:HT07050 "A particular type of multicenter (three center - four electron) $\\ce{X–H...Y}$ in which the central hydrogen atom covalently linked to an electronegative atom $\\ce{X}$ ($\\ce{C}$, $\\ce{N}$, $\\ce{O}$, $\\ce{S}$...) forms an additional weaker bond with atom $\\ce{Y}$ ($\\ce{N}$, $\\ce{O}$, $\\ce{S}$...) in the direction of its lone electron pair orbital. The energy of hydrogen bonds, which is usually in the range of \\(\\pu{3\\!{-}\\! 15 kcal/mol}\\) (\\(\\pu{12\\!{-}\\! 65 kJ/mol}\\)), results from the electrostatic interaction and also from the orbital interaction of the antibonding $\\upsigma^{\\ast}(\\ce{XH})MO$ of the molecule acting as the hydrogen donor and the non-bonding lone electron pair $MO{\\rm{n}}_{\\rm{Y}}$ of the hydrogen acceptor molecule.")
AnnotationAssertion(mito:isMentionedBy goldbook:HT07050 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07050 "current"^^xsd:string)
Declaration(Class(goldbook:HT07051))
AnnotationAssertion(rdfs:label goldbook:HT07051 "hypercoordination")
AnnotationAssertion(dcterms:description goldbook:HT07051 "A property of main-group atoms in molecular entities to acquire coordination numbers greater than four (which would comply with the Lewis octet rule). Hypercoordination may be associated with hypervalency, but usually is referred to peculiar atomic centres in the electron-deficient species with multicentre $\\ce{\\upsigma\\!\\mbox{-}bonding}$, in which the bonding power of a pair of electrons is spread over more than two atoms. An example of a hypercoordinated atom is the five-coordinate carbon atom in the methanium cation, where three $\\ce{C–H}$ bonds may be regarded as normal two center - two electron bonds and the bonding in the remaining $\\ce{CH2}$ fragment is governed by the three-centre, two-electron bond. A particular case of a hypercoordinated atom is the hydrogen atom included into a hydrogen bond.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07051 goldbook:LT07065)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07051 goldbook:C00907)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07051 goldbook:C01329)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07051 goldbook:H02899)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07051 goldbook:HT07054)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07051 goldbook:P04792)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07051 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07051 "current"^^xsd:string)
Declaration(Class(goldbook:HT07052))
AnnotationAssertion(rdfs:label goldbook:HT07052 "hyperfine coupling")
AnnotationAssertion(dcterms:description goldbook:HT07052 "The interaction between the spin magnetic moment of an unpaired electron and the nuclear spin magnetic moments resulting in the splitting of the $\\ce{\\upalpha\\!}$ (spin up) and $\\ce{\\upbeta\\!}$ (spin down) energy levels in an external magnetic field and, thus, in the multiplet pattern of the ESR spectra of radical-like species and transition metal compounds. Two main contributions to the hyperfine coupling are usually considered, Fermi contact and dipolar interactions. The contact interaction is isotropic and related to the unpaired spin density at the nucleus, \\(|\\psi _{\\unicode[Times]{x3C3}}|^{2}\\). The dipolar interaction is anisotropic, and related to \\(r^{-3}\\), where \\(r\\) is the distance between the atom holding the unpaired electron and the nucleus with non-zero spin.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07052 goldbook:F02339)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07052 goldbook:C01025)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07052 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07052 goldbook:N04256)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07052 goldbook:S05864)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07052 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07052 "current"^^xsd:string)
Declaration(Class(goldbook:HT07053))
AnnotationAssertion(rdfs:label goldbook:HT07053 "hyperpolarizability")
AnnotationAssertion(dcterms:description goldbook:HT07053 "The energy of a molecule in an external electrostatic field can be expanded as \\[E=E^{\\rm{o}}- \\unicode[Times]{x3BC}_{i}\\ F_{i}- \\frac{1}{2}\\ \\unicode[Times]{x3B1} _{ij}\\ F_{i}\\ F_{j}- \\frac{1}{6}\\ \\unicode[Times]{x3B2} _{ijk}\\ F_{i}\\ F_{j}\\ F_{k}- \\frac{1}{24}\\ \\unicode[Times]{x3B3} _{ijkl}\\ F_{i}\\ F_{j}\\ F_{k}\\ F_{l}- \\rm{...}\\] where \\(E^{\\rm{o}}\\) is the unperturbed energy, \\(F_{i}\\) is the component of the field in the i direction, \\(\\unicode[Times]{x3BC}_{i}\\) is the permanent dipole moment, \\(\\unicode[Times]{x3B1}_{ij}\\) is the polarizability tensor, and \\(\\unicode[Times]{x3B2}_{ijk}\\) and \\(\\unicode[Times]{x3B3}_{ijkl}\\) are the first and second hyperpolarizability tensors, respectively. \\(\\unicode[Times]{x3B2}\\) is a third order symmetric tensor that measures the second order response of the molecular electric dipole moment to the action of an external electric field and is thus often referred to as dipole hyperpolarizability.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07053 goldbook:D01761)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07053 goldbook:E01929)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07053 goldbook:P04711)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07053 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07053 "current"^^xsd:string)
Declaration(Class(goldbook:HT07054))
AnnotationAssertion(rdfs:label goldbook:HT07054 "hypervalency")
AnnotationAssertion(dcterms:description goldbook:HT07054 "The ability of an atom in a molecular entity to expand its valence shell beyond the limits of the Lewis octet rule. Hypervalent compounds are common for the second and subsequent row elements in groups 15–18 of the periodic table. A description of the hypervalent bonding implies a transfer of the electrons from the central (hypervalent) atom to the nonbonding molecular orbitals which it forms with (usually more electronegative) ligands. A typical example of the hypervalent bond is a linear three-centre, four-electron bond, e.g. that of $\\ce{F_{ap}–P–F_{ap}}$ fragment of $\\ce{PF5}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07054 goldbook:LT07065)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07054 goldbook:L03518)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07054 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07054 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07054 "current"^^xsd:string)
Declaration(Class(goldbook:HT07207))
AnnotationAssertion(rdfs:label goldbook:HT07207 "halato-telechelic polymer")
AnnotationAssertion(dcterms:description goldbook:HT07207 "Polymer composed of linear macromolecules having ionic or ionizable end-groups.")
AnnotationAssertion(rdfs:comment goldbook:HT07207 "The term halato-telechelic polymer is used to denote a polymer composed of macromolecules having stable (long-lived) ionic or ionizable groups, such as carboxylate or quaternary ammonium groups, as chain ends. It should not be used to describe a polymer composed of macromolecules having chain ends that are transient intermediates in ionic polymerizations initiated by difunctional initiators."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:HT07207 "The term halatopolymer is used for a linear polymer formed by the coupling of halato-telechelic polymer molecules, for example, for the linear polymer formed by the coupling of carboxylate end-groups with divalent metal cations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07207 goldbook:C01025)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07207 goldbook:L03556)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07207 goldbook:S05900)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07207 goldbook:TT07167)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07207 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07207 "current"^^xsd:string)
Declaration(Class(goldbook:HT07232))
AnnotationAssertion(rdfs:label goldbook:HT07232 "homologous polymer blend")
AnnotationAssertion(dcterms:description goldbook:HT07232 "Mixture of two or more fractions of the same polymer, each of which has a different molar-mass distribution.")
AnnotationAssertion(mito:isMentionedBy goldbook:HT07232 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07232 "current"^^xsd:string)
Declaration(Class(goldbook:HT07293))
AnnotationAssertion(rdfs:label goldbook:HT07293 "hard-segment phase domain")
AnnotationAssertion(dcterms:description goldbook:HT07293 "Phase domain of microscopic or smaller size, usually in a block, graft, or segmented copolymer, comprising essentially those segments of the polymer that are rigid and capable of forming strong intermolecular interactions.")
AnnotationAssertion(rdfs:comment goldbook:HT07293 "Hard-segment phase domains are typically of \\(2{-}15\\ \\rm{nm}\\) linear size."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07293 goldbook:PT07286)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07293 goldbook:B00682)
