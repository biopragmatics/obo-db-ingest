property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09262
name: line scan
def: "Plot of output signal intensity from a spectrometer\, signal intensity from another detector\, or processed intensity information from the available software along a line corresponding to a line on the sample surface."
comment: "The line is most often an x- or y-linescan from a rectangular raster, but, in more sophisticated systems, might be in any arbitrary direction."
