[Term]
id: goldbook:12719
name: proteinase
def: "Enzyme that catalyses the hydrolysis of proteins."
comment: "Usually, several proteolytic enzymes are necessary for the complete breakdown of polypeptides to their amino acids."
synonym: "protease" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-11-23
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:12720
name: prototype drug
def: "Early compound that has biological properties suitable for target validation but may not necessarily be adequate for clinical studies."
