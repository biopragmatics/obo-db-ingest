AnnotationAssertion(rdfs:label goldbook:C01498 "cycloalkyl groups")
AnnotationAssertion(dcterms:description goldbook:C01498 "Univalent groups derived from cycloalkanes by removal of a hydrogen atom from a ring carbon atom, e.g. 2-methylcyclopropyl.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01498 goldbook:C01497)
AnnotationAssertion(mito:isMentionedBy goldbook:C01498 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01498 "current"^^xsd:string)
Declaration(Class(goldbook:C01500))
AnnotationAssertion(rdfs:label goldbook:C01500 "cyclodextrins")
AnnotationAssertion(dcterms:description goldbook:C01500 "Cyclic oligoglucosides containing five to ca. ten glucose residues in which an enclosed tubular space allows reception of a guest molecule to form a clathrate. The synonymous term Schardinger dextrins is not recommended. ($\\ce{\\upalpha\\!\\mbox{-}Cyclodextrin}$ has six glucose residues; $\\ce{\\upbeta\\!\\mbox{-}Cyclodextrin}$ has seven.) Semi-systematically $\\ce{\\upalpha\\!\\mbox{-}cyclodextrin}$ is called cyclomaltohexaose.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01500 goldbook:C01097)
AnnotationAssertion(rdfs:seeAlso goldbook:C01500 goldbook:D01656)
