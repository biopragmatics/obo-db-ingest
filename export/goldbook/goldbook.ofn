AnnotationAssertion(rdfs:label goldbook:B00596 "bar")
AnnotationAssertion(dcterms:description goldbook:B00596 "Non-SI unit of pressure, \\(\\rm{bar} = 10^{5}\\ \\rm{Pa}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:B00596 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00596 "current"^^xsd:string)
Declaration(Class(goldbook:B00597))
AnnotationAssertion(rdfs:label goldbook:B00597 "barbiturates")
AnnotationAssertion(dcterms:description goldbook:B00597 "Pyrimidine-2,4,6(1H,3H,5H)-trione (trivial name barbituric acid) and derivatives:  (keto tautomeric form)Salts of barbituric acid and its derivatives.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00597 goldbook:K03382)
AnnotationAssertion(rdfs:seeAlso goldbook:B00597 goldbook:T06516)
AnnotationAssertion(mito:isMentionedBy goldbook:B00597 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00597 "current"^^xsd:string)
Declaration(Class(goldbook:B00599))
AnnotationAssertion(rdfs:label goldbook:B00599 "Barton reaction")
AnnotationAssertion(dcterms:description goldbook:B00599 "Photolysis of a nitrite to form a $\\ce{\\updelta\\!\\mbox{-}nitroso alcohol}$. The mechanism is believed to involve a homolytic $\\ce{RO–NO}$ cleavage, followed by $\\ce{\\updelta\\!\\mbox{-}hydrogen}$ abstraction and radical coupling.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00599 goldbook:P04624)
AnnotationAssertion(rdfs:seeAlso goldbook:B00599 goldbook:A00045)
AnnotationAssertion(rdfs:seeAlso goldbook:B00599 goldbook:C01025)
AnnotationAssertion(mito:isMentionedBy goldbook:B00599 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00599 "current"^^xsd:string)
Declaration(Class(goldbook:B00601))
AnnotationAssertion(rdfs:label goldbook:B00601 "base")
AnnotationAssertion(dcterms:description goldbook:B00601 "A chemical species or molecular entity having an available pair of electrons capable of forming a covalent bond with a hydron (proton) (see Brønsted base) or with the vacant orbital of some other species (see Lewis base).")
AnnotationAssertion(rdfs:seeAlso goldbook:B00601 goldbook:B00745)
AnnotationAssertion(rdfs:seeAlso goldbook:B00601 goldbook:L03511)
AnnotationAssertion(rdfs:seeAlso goldbook:B00601 goldbook:CT01038)
