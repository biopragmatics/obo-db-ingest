AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16088 "environmental tobacco smoke (ETS)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16088 "secondhand smoke")
AnnotationAssertion(rdfs:comment goldbook:16088 "This is the smoke that gives rise to passive inhalation on the part of bystanders."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16088 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16088 "current"^^xsd:string)
