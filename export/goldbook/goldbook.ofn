AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10706 "salpinx")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10706 "uterine tube")
Declaration(Class(goldbook:10707))
