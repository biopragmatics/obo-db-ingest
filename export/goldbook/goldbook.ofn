AnnotationAssertion(obo:goldbook#hasStatus goldbook:11788 "current"^^xsd:string)
Declaration(Class(goldbook:11789))
AnnotationAssertion(rdfs:label goldbook:11789 "glioma")
AnnotationAssertion(dcterms:description goldbook:11789 "Neoplasm originating from any of the glia cells in the brain and spinal cord.")
AnnotationAssertion(rdfs:comment goldbook:11789 "It is the predominant form of malignant brain tumor."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11789 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11789 goldbook:11785)
AnnotationAssertion(mito:isMentionedBy goldbook:11789 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11789 "current"^^xsd:string)
