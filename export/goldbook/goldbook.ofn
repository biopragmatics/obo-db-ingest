AnnotationAssertion(rdfs:label goldbook:S05944 "static fields mass spectrometer")
AnnotationAssertion(dcterms:description goldbook:S05944 "An instrument which can separate selected ion beams with fields which do not vary with time. The fields are generally both electric and magnetic.")
