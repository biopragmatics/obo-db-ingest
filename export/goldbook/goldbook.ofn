Declaration(Class(goldbook:10644))
AnnotationAssertion(rdfs:label goldbook:10644 "embryogenesis")
AnnotationAssertion(dcterms:description goldbook:10644 "Development and growth of an embryo in the period from formation of the bilaminar embryo to the beginning of the fetal period (in humans, the second through the eighth week after conception).")
Declaration(Class(goldbook:10645))
AnnotationAssertion(rdfs:label goldbook:10645 "embryoid body")
AnnotationAssertion(dcterms:description goldbook:10645 "Structure resembling an embryo which is formed by embryonic stem cells or teratocarcinoma cells when they are removed from a growth-promoting medium.")
Declaration(Class(goldbook:10646))
AnnotationAssertion(rdfs:label goldbook:10646 "embryonic induction")
AnnotationAssertion(dcterms:description goldbook:10646 "Process whereby the development of one group of cells, called the competent region, is altered by an inducing factor from another group, called a signaling center or organizer.")
Declaration(Class(goldbook:10647))
AnnotationAssertion(rdfs:label goldbook:10647 "embryo transfer")
