[Term]
id: goldbook:15337
name: mass ratio
def: "Mass of one constituent \\\(\\ce\{A\}\\\) divided by the mass of a second constituent \\\(\\ce\{B\}\\\) in the same system. \\\[\\zeta_\{\\ce\{A\,B\}\} = m_\{\\ce\{A\}\}/m_\{\\ce\{B\}\}\\\]"
property_value: mito:isMentionedBy doi:10.1351/pac200880020233
property_value: hasStatus "current" xsd:string
