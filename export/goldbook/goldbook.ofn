AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08278 "path length")
Declaration(Class(goldbook:08279))
AnnotationAssertion(rdfs:label goldbook:08279 "radiofrequency")
AnnotationAssertion(dcterms:description goldbook:08279 "Frequency or band of frequencies in the range \\(\\pu{E4}\\) to \\(\\pu{E12 Hz}\\).")
Declaration(Class(goldbook:08280))
AnnotationAssertion(rdfs:label goldbook:08280 "received radiant flux density")
