AnnotationAssertion(obo:goldbook#hasStatus goldbook:13025 "current"^^xsd:string)
Declaration(Class(goldbook:13026))
AnnotationAssertion(rdfs:label goldbook:13026 "combinatorial joining")
AnnotationAssertion(dcterms:description goldbook:13026 "Merging of DNA segments generating new genetic information.")
AnnotationAssertion(mito:isMentionedBy goldbook:13026 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13026 "current"^^xsd:string)
Declaration(Class(goldbook:13027))
AnnotationAssertion(rdfs:label goldbook:13027 "common variable immunodeficiency")
AnnotationAssertion(dcterms:description goldbook:13027 "Relatively common deficiency in antibody production, of unknown pathogenesis but strongly associated with genes mapping within the major histocompatibility complex (MHC).")
AnnotationAssertion(rdfs:comment goldbook:13027 "Characterized by reduced γ globulin levels, generally affecting all the antibody classes, but sometimes only immunoglobulin G (IgG)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13027 "Most patients have normal or near-normal numbers of B cells, which however do not differentiate into plasma cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13027 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13027 goldbook:13292)
AnnotationAssertion(rdfs:seeAlso goldbook:13027 goldbook:13430)
AnnotationAssertion(rdfs:seeAlso goldbook:13027 goldbook:13576)
AnnotationAssertion(rdfs:seeAlso goldbook:13027 goldbook:13165)
AnnotationAssertion(mito:isMentionedBy goldbook:13027 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13027 "current"^^xsd:string)
Declaration(Class(goldbook:13028))
AnnotationAssertion(rdfs:label goldbook:13028 "competitive inhibition assay")
AnnotationAssertion(dcterms:description goldbook:13028 "Method of measuring an antigen in a sample using a labeled species of the antigen as a competitive inhibitor of its binding in a specific antigen–antibody reaction.")
AnnotationAssertion(mito:isMentionedBy goldbook:13028 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13028 "current"^^xsd:string)
Declaration(Class(goldbook:13029))
AnnotationAssertion(rdfs:label goldbook:13029 "complementarity-determining region")
AnnotationAssertion(dcterms:description goldbook:13029 "Hypervariable amino acid sequence within antibody and T-cell receptor (TCR) variable (V) regions, which interacts with complementary amino acids on the antigen or major histocompatibility complex (MHC)–peptide complex.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13029 "CDR")
AnnotationAssertion(rdfs:seeAlso goldbook:13029 goldbook:13245)
AnnotationAssertion(rdfs:seeAlso goldbook:13029 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13029 goldbook:13430)
AnnotationAssertion(rdfs:seeAlso goldbook:13029 goldbook:13773)
AnnotationAssertion(mito:isMentionedBy goldbook:13029 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13029 "current"^^xsd:string)
Declaration(Class(goldbook:13030))
AnnotationAssertion(rdfs:label goldbook:13030 "complement deficiency")
AnnotationAssertion(dcterms:description goldbook:13030 "Congenital deficiency in any of the various components of the complement system.")
AnnotationAssertion(rdfs:comment goldbook:13030 "Rheumatic disorders [mainly systemic lupus erythematosus (SLE)] are associated with deficiencies of the early components of the classical pathway. More than \\(\\pu{30\\%}\\) of individuals with C2 deficiency and nearly \\(\\pu{80\\%}\\) with either C3 or C4 deficiency have an autoimmune manifestation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13030 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13030 goldbook:13011)
AnnotationAssertion(rdfs:seeAlso goldbook:13030 goldbook:13033)
AnnotationAssertion(rdfs:seeAlso goldbook:13030 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:13030 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13030 "current"^^xsd:string)
Declaration(Class(goldbook:13031))
AnnotationAssertion(rdfs:label goldbook:13031 "complement reaction")
AnnotationAssertion(dcterms:description goldbook:13031 "Physiological reaction to the presence of a foreign microorganism in which a cascade of enzymatic reactions, triggered by molecular features of the microorganism, result in lysis or phagocytosis of the foreign material.")
AnnotationAssertion(rdfs:seeAlso goldbook:13031 goldbook:13562)
AnnotationAssertion(mito:isMentionedBy goldbook:13031 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13031 "current"^^xsd:string)
Declaration(Class(goldbook:13032))
AnnotationAssertion(rdfs:label goldbook:13032 "complement receptor")
AnnotationAssertion(dcterms:description goldbook:13032 "Cell-surface protein that recognizes and binds complement proteins that have bound an antigen.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13032 "CR")
AnnotationAssertion(rdfs:comment goldbook:13032 "Complement receptors on phagocytes allow them to identify pathogens coated with complement proteins for uptake and destruction. Complement receptors include CR1, CR2, CR3, CR4, and the receptor for Clq."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13032 goldbook:13560)
AnnotationAssertion(mito:isMentionedBy goldbook:13032 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13032 "current"^^xsd:string)
Declaration(Class(goldbook:13033))
AnnotationAssertion(rdfs:label goldbook:13033 "complement system")
AnnotationAssertion(dcterms:description goldbook:13033 "Group of serum proteins with the capacity to interact with each other when activated in a chain reaction which results in formation of a lytic complex and the release of several biologically active peptides of low relative molecular mass (anaphylatoxins).")
AnnotationAssertion(rdfs:comment goldbook:13033 "The system can be activated by antigen–antibody complexes (classical pathway) and by other components, e.g., bacteria (alternative pathway). As an effector mechanism of the humoral immune response, the activated complement system facilitates opsonization, phagocytosis, and lysis of cellular antigens."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13033 goldbook:12866)
AnnotationAssertion(rdfs:seeAlso goldbook:13033 goldbook:12873)
AnnotationAssertion(rdfs:seeAlso goldbook:13033 goldbook:13011)
AnnotationAssertion(rdfs:seeAlso goldbook:13033 goldbook:13235)
AnnotationAssertion(rdfs:seeAlso goldbook:13033 goldbook:13526)
AnnotationAssertion(rdfs:seeAlso goldbook:13033 goldbook:13562)
AnnotationAssertion(mito:isMentionedBy goldbook:13033 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13033 "current"^^xsd:string)
Declaration(Class(goldbook:13034))
AnnotationAssertion(rdfs:label goldbook:13034 "concanavalin A")
AnnotationAssertion(dcterms:description goldbook:13034 "Hemagglutinin, isolated from jack bean (Canavalia ensiformis) meal, which reacts with polyglucosans in the blood of mammals, causing agglutination.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13034 "conA")
AnnotationAssertion(rdfs:comment goldbook:13034 "Concanavalin A has been used to activate T cells in vitro."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13034 goldbook:13200)
AnnotationAssertion(rdfs:seeAlso goldbook:13034 goldbook:13724)
AnnotationAssertion(mito:isMentionedBy goldbook:13034 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13034 "current"^^xsd:string)
