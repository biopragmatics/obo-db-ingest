AnnotationAssertion(rdfs:label goldbook:13206 "heterologous antibody")
AnnotationAssertion(dcterms:description goldbook:13206 "Antibody derived from another individual of the same species or another species.")
AnnotationAssertion(rdfs:seeAlso goldbook:13206 goldbook:12928)
AnnotationAssertion(mito:isMentionedBy goldbook:13206 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13206 "current"^^xsd:string)
Declaration(Class(goldbook:13207))
AnnotationAssertion(rdfs:label goldbook:13207 "heterologous antigen")
AnnotationAssertion(dcterms:description goldbook:13207 "Antigen that reacts with an antibody other than the one whose formation it induced.")
AnnotationAssertion(mito:isMentionedBy goldbook:13207 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13207 "current"^^xsd:string)
Declaration(Class(goldbook:13208))
AnnotationAssertion(rdfs:label goldbook:13208 "heterophagy")
AnnotationAssertion(dcterms:description goldbook:13208 "Digestion of exogenous material taken up by a cell by phagocytosis or pinocytosis, following fusion of the phagocytic or pinocytic vacuole with a lysosome.")
AnnotationAssertion(rdfs:seeAlso goldbook:13208 goldbook:13422)
AnnotationAssertion(rdfs:seeAlso goldbook:13208 goldbook:13562)
AnnotationAssertion(mito:isMentionedBy goldbook:13208 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13208 "current"^^xsd:string)
Declaration(Class(goldbook:13209))
AnnotationAssertion(rdfs:label goldbook:13209 "heterophile antibody")
AnnotationAssertion(dcterms:description goldbook:13209 "Antibody raised against an antigen from one species, which also reacts against antigens from other species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13209 "heterophilic antibody")
AnnotationAssertion(rdfs:comment goldbook:13209 "Heterophile antibodies are usually of low affinity and are a common cause of problems with immunoassays."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13209 "The existence of such antibodies explains observations of the presence of antibody against antigens from a variety of species without immunization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13209 "Heterophile antibodies commonly arise from viral infection."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13209 goldbook:13158)
AnnotationAssertion(mito:isMentionedBy goldbook:13209 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13209 "current"^^xsd:string)
Declaration(Class(goldbook:13210))
AnnotationAssertion(rdfs:label goldbook:13210 "heterophile antigen")
AnnotationAssertion(dcterms:description goldbook:13210 "Antigen that stimulates production in a vertebrate of antibodies capable of reacting with tissue components having related antigens in a wide range of other species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13210 "heterophilic antigen")
AnnotationAssertion(rdfs:seeAlso goldbook:13210 goldbook:13158)
AnnotationAssertion(mito:isMentionedBy goldbook:13210 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13210 "current"^^xsd:string)
