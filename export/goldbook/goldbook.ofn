AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10792 "erythroblastosis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10792 "erythroblastosis fetalis")
Declaration(Class(goldbook:10793))
AnnotationAssertion(rdfs:label goldbook:10793 "hepatosplenomegaly")
