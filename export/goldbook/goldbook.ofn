AnnotationAssertion(rdfs:label goldbook:IT07515 "inorganic polymer")
AnnotationAssertion(dcterms:description goldbook:IT07515 "Polymer or polymer network with a skeletal structure that does not include carbon atoms.")
AnnotationAssertion(rdfs:comment goldbook:IT07515 "Examples include polyphosphazenes, polysilicates, polysiloxanes, polysilanes, polysilazanes, polygermanes, polysulfides, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07515 goldbook:P04742)
