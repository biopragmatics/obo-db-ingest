AnnotationAssertion(rdfs:label goldbook:T06499 "triboluminescence")
AnnotationAssertion(dcterms:description goldbook:T06499 "Luminescence resulting from the rubbing together of the surface of certain solids. It can be produced, for example, when solids are crushed.")
