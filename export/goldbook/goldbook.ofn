AnnotationAssertion(dcterms:description goldbook:13806 "Molecular entity of spherical, elliptical, or cylindrical symmetry in which the constitution of the interior, the core, differs from that of the external surface, the shell.")
AnnotationAssertion(mito:isMentionedBy goldbook:13806 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13806 "current"^^xsd:string)
Declaration(Class(goldbook:13807))
AnnotationAssertion(rdfs:label goldbook:13807 "crystal lattice defect")
AnnotationAssertion(dcterms:description goldbook:13807 "Interruption to the regular pattern of atomic arrangement in crystal lattices.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13807 "crystallographic defect")
AnnotationAssertion(rdfs:comment goldbook:13807 "In this context, the terms are commonly shortened to \"defect\"."^^xsd:string)
