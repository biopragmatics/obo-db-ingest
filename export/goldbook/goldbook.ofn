AnnotationAssertion(mito:isMentionedBy goldbook:11951 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11951 "current"^^xsd:string)
Declaration(Class(goldbook:11952))
AnnotationAssertion(rdfs:label goldbook:11952 "neurotoxin")
AnnotationAssertion(dcterms:description goldbook:11952 "Any substance that has the potential to damage the nervous system.")
AnnotationAssertion(rdfs:comment goldbook:11952 "In the narrower sense, neurotoxins are of biological origin, like toxins in general. However, the term neurotoxin is also in general use for non-biological substances."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11952 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11952 doi:10.1515/pac-2015-0103)
