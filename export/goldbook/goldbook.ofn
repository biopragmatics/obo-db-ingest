AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11787 "GFAP")
AnnotationAssertion(rdfs:comment goldbook:11787 "Stains for GFAP are frequently used in the differential diagnosis of neurologic lesions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11787 "GFAP staining does not reveal the full distal arborization of the cell."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11787 goldbook:11605)
AnnotationAssertion(rdfs:seeAlso goldbook:11787 goldbook:11614)
