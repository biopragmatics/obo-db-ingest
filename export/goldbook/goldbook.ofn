AnnotationAssertion(rdfs:label goldbook:T06257 "tellurides")
AnnotationAssertion(dcterms:description goldbook:T06257 "Compounds having the structure $\\ce{RTeR}$ ($\\ce{R}  eq \\ce{H}$). Thus tellurium analogues of ethers.Metal salts of tellurane, $\\ce{H2Te}$.")
