AnnotationAssertion(rdfs:label goldbook:H02835 "hole transfer")
AnnotationAssertion(dcterms:description goldbook:H02835 "Charge migration process in which the majority carriers are positively charged.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02835 goldbook:M03920)
AnnotationAssertion(mito:isMentionedBy goldbook:H02835 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:H02835 "current"^^xsd:string)
