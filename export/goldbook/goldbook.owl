        <rdfs:label>umbilicus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11339"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.16264 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.16264">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficulty in breathing; shortness of breath.</dcterms:description>
