Declaration(Class(goldbook:08277))
AnnotationAssertion(rdfs:label goldbook:08277 "optical throughput")
AnnotationAssertion(dcterms:description goldbook:08277 "Volume in phase space, a function of the area of the emitting source (\\(S\\)) and the solid angle into which it propagates \\((\\mathit{\\Omega}).{\\rm{d}}^{2} G = {\\rm{d}}S {\\rm{d}}\\mathit{\\Omega}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08277 "étendue")
Declaration(Class(goldbook:08278))
