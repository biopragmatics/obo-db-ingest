Declaration(Class(goldbook:16084))
AnnotationAssertion(rdfs:label goldbook:16084 "sensory effect level")
AnnotationAssertion(dcterms:description goldbook:16084 "Intensity, where the detection threshold level is defined as the lower limit of the perceived intensity range (by convention, the lowest concentration that can be detected in \\(\\pu{50\\%}\\) of the cases in which it is present). Quality, where the recognition threshold level is defined as the lowest concentration at which the sensory effect can be recognized correctly in \\(\\pu{50\\%}\\) of the cases. Acceptability and annoyance, where the nuisance threshold level is defined as the concentration at which not more than a small proportion of the population, less than \\(\\pu{5\\%}\\), experiences annoyance for a small part of the time, less than \\(\\pu{2\\%}\\).Note: Since annoyance will be influenced by a number of factors, a nuisance threshold level cannot be set on the basis of concentration alone.")
AnnotationAssertion(rdfs:seeAlso goldbook:16084 goldbook:16136)
AnnotationAssertion(mito:isMentionedBy goldbook:16084 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16084 "current"^^xsd:string)
Declaration(Class(goldbook:16085))
AnnotationAssertion(rdfs:label goldbook:16085 "short-term exposure limit")
AnnotationAssertion(dcterms:description goldbook:16085 "Fifteen-minute time-weighted average (TWA) exposure recommended by ACGIH which should not be exceeded at any time during a workday, even if the \\(\\pu{8 h}\\) TWA is within the threshold limit value: time-weighted average, TLV-TWA.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16085 "STEL")
AnnotationAssertion(rdfs:comment goldbook:16085 "Workers can be exposed to a maximum of four STEL periods per \\(\\pu{8 h}\\) shift, with at least \\(\\pu{60 min}\\) between exposure periods."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:16085 goldbook:16139)
AnnotationAssertion(rdfs:seeAlso goldbook:16085 goldbook:16143)
AnnotationAssertion(mito:isMentionedBy goldbook:16085 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16085 "current"^^xsd:string)
