AnnotationAssertion(obo:goldbook#hasStatus goldbook:16129 "current"^^xsd:string)
Declaration(Class(goldbook:16130))
AnnotationAssertion(rdfs:label goldbook:16130 "target population")
AnnotationAssertion(dcterms:description goldbook:16130 "Collection of individuals, items, measurements, etc. about which inferences are required: The term is sometimes used to indicate the population from which a sample is drawn and sometimes to denote any reference population about which inferences are needed. Group of persons for whom an intervention is planned.")
AnnotationAssertion(mito:isMentionedBy goldbook:16130 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16130 "current"^^xsd:string)
Declaration(Class(goldbook:16131))
AnnotationAssertion(rdfs:label goldbook:16131 "temporary acceptable daily intake")
AnnotationAssertion(dcterms:description goldbook:16131 "Value for the acceptable daily intake (ADI) proposed for guidance when data are sufficient to conclude that use of the substance is safe over the relatively short period of time required to generate and evaluate further safety data, but are insufficient to conclude that use of the substance is safe over a lifetime.")
AnnotationAssertion(rdfs:comment goldbook:16131 "A higher-than-normal safety factor is used when establishing a temporary ADI, and an expiration date is established by which time appropriate data to resolve the safety issue should be available."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16131 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16131 "current"^^xsd:string)
Declaration(Class(goldbook:16132))
AnnotationAssertion(rdfs:label goldbook:16132 "temporary maximum residue limit")
AnnotationAssertion(dcterms:description goldbook:16132 "Regulatory value established for a specified, limited time when only a temporary acceptable daily intake has been established for the pesticide concerned or, with the existence of an agreed acceptable daily intake, the available residue data are inadequate for firm maximum residue recommendations.")
AnnotationAssertion(mito:isMentionedBy goldbook:16132 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16132 "current"^^xsd:string)
Declaration(Class(goldbook:16133))
AnnotationAssertion(rdfs:label goldbook:16133 "testing of chemicals")
AnnotationAssertion(dcterms:description goldbook:16133 "In toxicology, evaluation of the therapeutic and potentially toxic effects of substances by their application through relevant routes of exposure with appropriate organisms or biological systems so as to relate effects to dose following application. In chemistry, qualitative or quantitative analysis by the application of one or more fixed methods and comparison of the results with established standards.")
AnnotationAssertion(mito:isMentionedBy goldbook:16133 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16133 "current"^^xsd:string)
Declaration(Class(goldbook:16134))
AnnotationAssertion(rdfs:label goldbook:16134 "theoretical maximum daily intake")
AnnotationAssertion(dcterms:description goldbook:16134 "Predicted maximum daily intake of a residue, assuming that it is present at the maximum residue level and that average daily consumption of foods per person is represented by assessed regional diets: It is expressed in milligrams of residue per person per day.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16134 "TMDI")
AnnotationAssertion(rdfs:seeAlso goldbook:16134 goldbook:15871)
AnnotationAssertion(mito:isMentionedBy goldbook:16134 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16134 "current"^^xsd:string)
Declaration(Class(goldbook:16135))
AnnotationAssertion(rdfs:label goldbook:16135 "therapeutic cloning")
AnnotationAssertion(dcterms:description goldbook:16135 "Generation and manipulation of stem cells with the objective of deriving cells of a particular organ or tissue to treat a disease.")
AnnotationAssertion(mito:isMentionedBy goldbook:16135 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16135 "current"^^xsd:string)
Declaration(Class(goldbook:16136))
AnnotationAssertion(rdfs:label goldbook:16136 "threshold")
AnnotationAssertion(dcterms:description goldbook:16136 "Dose or exposure concentration below which a defined effect will not occur.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16136 "threshold concentration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16136 "threshold dose")
AnnotationAssertion(rdfs:seeAlso goldbook:16136 goldbook:15607)
AnnotationAssertion(rdfs:seeAlso goldbook:16136 goldbook:15681)
AnnotationAssertion(mito:isMentionedBy goldbook:16136 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16136 "current"^^xsd:string)
Declaration(Class(goldbook:16137))
AnnotationAssertion(rdfs:label goldbook:16137 "threshold limit value–ceiling")
AnnotationAssertion(dcterms:description goldbook:16137 "As defined by ACGIH, concentration of a potentially toxic substance that should not be exceeded during any part of the working exposure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16137 "TLV-C")
AnnotationAssertion(mito:isMentionedBy goldbook:16137 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16137 "current"^^xsd:string)
Declaration(Class(goldbook:16138))
AnnotationAssertion(rdfs:label goldbook:16138 "threshold limit value–short-term exposure limit")
AnnotationAssertion(dcterms:description goldbook:16138 "As defined by ACGIH, concentration to which it is believed that workers can be exposed continuously for a short period of time without suffering from (1) irritation, (2) chronic or irreversible tissue damage, or (3) narcosis of sufficient degree to increase the likelihood of accidental injury, impair self-rescue or materially reduce work efficiency, and provided that the daily TLV-TWA is not exceeded.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16138 "TLV–STEL")
AnnotationAssertion(rdfs:comment goldbook:16138 "It is not a separate independent exposure guideline; rather, it supplements the TLV-TWA limit where there are recognized acute effects from a substance whose toxic effects are primarily of a chronic nature. TLV-STELs are recommended only where toxic effects have been reported from high short-term exposures in either humans or animals."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:16138 goldbook:15695)
AnnotationAssertion(mito:isMentionedBy goldbook:16138 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16138 "current"^^xsd:string)
Declaration(Class(goldbook:16139))
AnnotationAssertion(rdfs:label goldbook:16139 "threshold limit value–time-weighted average")
AnnotationAssertion(dcterms:description goldbook:16139 "As defined by ACGIH, time-weighted average concentration for a conventional \\(\\pu{8\\!\\mbox{-}h}\\) workday and a \\(\\pu{40\\!\\mbox{-}h}\\) workweek, to which it is believed nearly all workers may be repeatedly exposed, day after day, without adverse effect.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16139 "TLV–TWA")
AnnotationAssertion(rdfs:seeAlso goldbook:16139 goldbook:15695)
AnnotationAssertion(rdfs:seeAlso goldbook:16139 goldbook:16143)
AnnotationAssertion(mito:isMentionedBy goldbook:16139 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16139 "current"^^xsd:string)
Declaration(Class(goldbook:16140))
AnnotationAssertion(rdfs:label goldbook:16140 "threshold of toxicological concern")
AnnotationAssertion(dcterms:description goldbook:16140 "Human exposure threshold value for a group of chemicals below which there should be no appreciable risk to human health.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16140 "TTC")
AnnotationAssertion(mito:isMentionedBy goldbook:16140 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16140 "current"^^xsd:string)
Declaration(Class(goldbook:16141))
AnnotationAssertion(rdfs:label goldbook:16141 "thyrotoxicosis")
AnnotationAssertion(dcterms:description goldbook:16141 "Condition resulting from excessive concentrations of thyroid hormones, as in hyperthyroidism, characterized by bulging eyes and rapid heart rate.")
AnnotationAssertion(mito:isMentionedBy goldbook:16141 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16141 "current"^^xsd:string)
Declaration(Class(goldbook:16142))
AnnotationAssertion(rdfs:label goldbook:16142 "tidal volume")
AnnotationAssertion(dcterms:description goldbook:16142 "Quantity of air or test gas that is inhaled and exhaled during one respiratory cycle.")
AnnotationAssertion(mito:isMentionedBy goldbook:16142 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16142 "current"^^xsd:string)
Declaration(Class(goldbook:16143))
AnnotationAssertion(rdfs:label goldbook:16143 "time-weighted-average-exposure")
AnnotationAssertion(dcterms:description goldbook:16143 "Concentration in the exposure medium at each measured time interval multiplied by that time interval and divided by the total time of observation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16143 "TWAE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16143 "time-weighted-average concentration (TWAC)")
AnnotationAssertion(rdfs:comment goldbook:16143 "For occupational exposure, a working shift of \\(\\pu{8\\!\\mbox{-}h}\\) is commonly used as the averaging time."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16143 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16143 "current"^^xsd:string)
Declaration(Class(goldbook:16144))
AnnotationAssertion(rdfs:label goldbook:16144 "tissue dose")
AnnotationAssertion(dcterms:description goldbook:16144 "Amount of a substance or physical agent (radiation) absorbed by a tissue.")
AnnotationAssertion(mito:isMentionedBy goldbook:16144 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16144 "current"^^xsd:string)
Declaration(Class(goldbook:16145))
AnnotationAssertion(rdfs:label goldbook:16145 "tolerable daily intake")
AnnotationAssertion(dcterms:description goldbook:16145 "Estimate of the amount of a potentially harmful substance (e.g., contaminant) in food or drinking water that can be ingested daily over a lifetime without appreciable health risk.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16145 "TDI")
AnnotationAssertion(rdfs:comment goldbook:16145 "For regulation of substances that cannot be easily avoided, a provisionally tolerable weekly intake (PTWI) may be applied as a temporary limit."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:16145 "Acceptable daily intake is normally used for substances not known to be harmful, such as food additives."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:16145 goldbook:16147)
AnnotationAssertion(mito:isMentionedBy goldbook:16145 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16145 "current"^^xsd:string)
Declaration(Class(goldbook:16146))
AnnotationAssertion(rdfs:label goldbook:16146 "tolerable risk")
AnnotationAssertion(dcterms:description goldbook:16146 "Probability of suffering disease or injury that can, for the time being, be tolerated, taking into account the associated benefits, and assuming that the risk is minimized by appropriate control procedures.")
AnnotationAssertion(mito:isMentionedBy goldbook:16146 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16146 "current"^^xsd:string)
Declaration(Class(goldbook:16147))
AnnotationAssertion(rdfs:label goldbook:16147 "tolerable weekly intake")
AnnotationAssertion(dcterms:description goldbook:16147 "Estimate of the amount of a potentially harmful substance (e.g., a contaminant) in food or drinking water that can be ingested weekly over a lifetime without appreciable health risk.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16147 "TWI")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16147 "provisional tolerable weekly intake (PTWI)")
