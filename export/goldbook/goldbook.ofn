AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01317 "current"^^xsd:string)
Declaration(Class(goldbook:C01319))
AnnotationAssertion(rdfs:label goldbook:C01319 "conversion spectrum")
AnnotationAssertion(dcterms:description goldbook:C01319 "A plot of a quantity related to the absorption (absorbance, cross section, etc.) multiplied by the quantum yield for the considered process against a suitable measure of photon energy, such as frequency, \\( u \\), wavenumber, \\(\\sigma \\), or wavelength, \\(\\lambda \\), e.g. the conversion cross section, \\(\\sigma \\varphi \\), has the SI unit \\(\\mathrm{m}^{2}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:C01319 goldbook:A00028)
