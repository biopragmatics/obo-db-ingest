AnnotationAssertion(rdfs:comment goldbook:12058 "The length of time the animal stays on the rod is a relative measure of motor coordination, balance and resistance to fatigue."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12058 "Maintaining an upright position on the rod involves the righting reflex."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12058 goldbook:11884)
AnnotationAssertion(rdfs:seeAlso goldbook:12058 goldbook:12055)
AnnotationAssertion(mito:isMentionedBy goldbook:12058 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12058 "current"^^xsd:string)
