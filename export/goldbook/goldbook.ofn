Declaration(Class(goldbook:12923))
AnnotationAssertion(rdfs:label goldbook:12923 "autoimmune polyendocrine syndrome type 1 or 2")
AnnotationAssertion(dcterms:description goldbook:12923 "Heterogeneous group of rare diseases characterized by autoimmune activity against more than one endocrine organ, although non-endocrine organs can also be affected.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12923 "APS")
AnnotationAssertion(rdfs:comment goldbook:12923 "Autoimmune polyendocrine syndrome, type 1 is known as the candidiasis-hypoparathyroidism-Addison disease syndrome after its main features: A mild immune deficiency, leading to persistent mucosal and cutaneous infections with Candida yeasts. There is also decreased function of the spleen (asplenism).Autoimmune dysfunction of the parathyroid gland (leading to hypocalcemia) and the adrenal gland (Addison disease)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12923 "Autoimmune polyendocrine syndrome, type 2 (also known as Schmidt syndrome) is more heterogeneous, occurs more often and has not been linked to one gene. Features of this syndrome are Addison disease, hypothyroidism (Hashimoto thyroiditis), and diabetes mellitus type 1. Patients are at a higher risk when they carry a particular human leukocyte antigen (HLA) genotype (e.g., DQ2, DQ8, and DRB1*0404)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:12845)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:13195)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:12986)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:13092)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:13230)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:13473)
AnnotationAssertion(rdfs:seeAlso goldbook:12923 goldbook:13690)
AnnotationAssertion(mito:isMentionedBy goldbook:12923 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12923 "current"^^xsd:string)
Declaration(Class(goldbook:12924))
AnnotationAssertion(rdfs:label goldbook:12924 "autoimmune regulator")
AnnotationAssertion(dcterms:description goldbook:12924 "DNA-binding protein involved in immunoregulation (probably in the establishment and maintenance of tolerance).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:12924 "AIRE")
