AnnotationAssertion(rdfs:label goldbook:08963 "macroinitiator")
AnnotationAssertion(dcterms:description goldbook:08963 "Macromolecule containing initiator functionality.")
AnnotationAssertion(rdfs:comment goldbook:08963 "The dormant species in RDRP such as ATRP or SRMP is often referred to as a macroinitiator."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08963 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08963 goldbook:08916)
