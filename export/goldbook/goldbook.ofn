AnnotationAssertion(rdfs:label goldbook:13392 "liver-kidney microsomal antibodies")
AnnotationAssertion(dcterms:description goldbook:13392 "Autoantibodies directed against cytochrome P450 and uridine diphosphate (UDP)-glucuronosyltransferase (UGT) antigens typically found in patients with immune-mediated hepatitis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13392 "LKM")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13392 "LKM antibodies")
AnnotationAssertion(rdfs:comment goldbook:13392 "These include LKM-1 antibodies (cytochrome P4502D6) in patients with autoimmune hepatitis type 2 (AIH-2) and autoimmunity associated with hepatitis C; LKM-2 (cytochrome P4502C9) in patients with drug-induced hepatitis caused by tienilic acid; and LKM-3 (UGT-1) in patients with chronic hepatitis D and AIH-2."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13392 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13392 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13392 goldbook:12925)
