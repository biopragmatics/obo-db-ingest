AnnotationAssertion(rdfs:label goldbook:S06073 "substance content")
AnnotationAssertion(dcterms:description goldbook:S06073 "Amount-of-substance of a component divided by the mass of the system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:S06073 "ISO")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:S06073 "content")
AnnotationAssertion(rdfs:comment goldbook:S06073 "The term component is recommended for clinical chemistry, ISO uses 'substance'."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S06073 "The term system is recommended for clinical chemistry, ISO uses mixture."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S06073 "Use of the term level as a synonym for content is deprecated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S06073 "In describing a quantity, 'content' must be clearly differentiated from concentration."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S06073 goldbook:C01209)
AnnotationAssertion(rdfs:seeAlso goldbook:S06073 goldbook:C01222)
