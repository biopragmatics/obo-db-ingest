[Term]
id: goldbook:12786
name: melt
def: "Matter in the amorphous state above its glass-transition temperature."
comment: "A melt has the physical properties of a liquid."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-02
property_value: hasStatus "current" xsd:string
