property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-11-23
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:12638
name: constitutive activity
def: "Receptor or enzymatic function displayed in the absence of an agonist or activator."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-11-23
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:12639
name: contract research organisation
def: "Commercial organisation that can be engaged to undertake specifically defined chemical\, biological\, safety\, or clinical studies."
comment: "Typically, such studies are subject to confidentially agreements."
synonym: "CRO" RELATED OMO:0003000 []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-11-23
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:12640
name: covalent drug
def: "Ligand that binds irreversibly to its molecular target through the formation of a new chemical bond."
