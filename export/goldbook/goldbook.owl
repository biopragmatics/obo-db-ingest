    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10761">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which mutations induced by an agent are studied in germ line cells or somatic stem cells from a transgenic animal (rodent), containing reporter genes for detection of various mutations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>germ cell gene mutation assay</rdfs:label>
