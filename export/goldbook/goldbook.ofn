Declaration(Class(goldbook:I03322))
AnnotationAssertion(rdfs:label goldbook:I03322 "isotope dilution")
AnnotationAssertion(dcterms:description goldbook:I03322 "Mixing of a given nuclide with one or more of its isotopes.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03322 goldbook:I03331)
