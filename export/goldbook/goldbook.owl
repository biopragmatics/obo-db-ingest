    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10757 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10757">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organ of reproduction or generation, both external and internal to the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>genital organ</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10758 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10758">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genital passages of the urogenital apparatus.</dcterms:description>
