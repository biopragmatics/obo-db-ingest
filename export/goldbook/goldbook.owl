    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11248">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of the neural tube to close, resulting in the absence of part of the vertebral arch at the midline of the spinal column and exposure of the spinal cord and its covering membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spina bifida</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11249 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11249">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Backbone.</dcterms:description>
