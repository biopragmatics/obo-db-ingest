        <rdfs:label>gestation period</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10766 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10766">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition of abnormal size or overgrowth of the entire body or of any of its parts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Often caused by increased levels of growth hormone.</rdfs:comment>
