AnnotationAssertion(dcterms:description goldbook:13597 "Precipitate of antibody and multivalent antigen due to the formation of high-molecular-weight complexes.")
AnnotationAssertion(mito:isMentionedBy goldbook:13597 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13597 "current"^^xsd:string)
Declaration(Class(goldbook:13598))
AnnotationAssertion(rdfs:label goldbook:13598 "pre-T cell")
AnnotationAssertion(dcterms:description goldbook:13598 "Cell differentiating into a T lymphocyte in the thymus gland.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13598 "single-positive cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13598 "thymocyte")
AnnotationAssertion(rdfs:comment goldbook:13598 "During maturation thymocytes express on their surface a precursor T-cell receptor (TCR) called a pre-T-cell receptor, and both CD8 and CD4 proteins (double-positive cells). At the same time they slowly migrate from the outer cortex of the thymus to the inner medullary region. Only the \\(\\pu{2\\%}\\) of cells capable of distinguishing self-antigen survive to maturity in the medulla. Here they become single-positive cells, expressing exclusively CD4 or CD8 surface proteins, and are exported from the thymus in the bloodstream to become helper T cells (Th) and cytotoxic T cells, respectively."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:12973)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:12976)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:13072)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:13102)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:13199)
AnnotationAssertion(rdfs:seeAlso goldbook:13598 goldbook:12914)
AnnotationAssertion(mito:isMentionedBy goldbook:13598 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13598 "current"^^xsd:string)
Declaration(Class(goldbook:13599))
AnnotationAssertion(rdfs:label goldbook:13599 "prick test")
AnnotationAssertion(dcterms:description goldbook:13599 "Test carried out by placing a drop of a suspected allergenic extract on the skin of the forearm and gently pricking it into the upper layer of skin. Sensitivity to a substance is indicated if the spot swells slightly and becomes red within about \\(\\pu{15 min}\\).")
AnnotationAssertion(rdfs:comment goldbook:13599 "A positive result is far from conclusive and, at best, gives a vague indication of allergenicity. The prick test is inappropriate as a test for food allergens."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13599 goldbook:12857)
AnnotationAssertion(mito:isMentionedBy goldbook:13599 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13599 "current"^^xsd:string)
Declaration(Class(goldbook:13600))
AnnotationAssertion(rdfs:label goldbook:13600 "primary biliary cirrhosis")
AnnotationAssertion(dcterms:description goldbook:13600 "Autoimmune liver disease that results in the destruction of bile ducts, leading to fibrosis and cirrhosis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13600 "PBC")
AnnotationAssertion(rdfs:comment goldbook:13600 "Primary biliary cirrhosis-specific antibodies are antimitochondrial antibodies (AMAs) directed against proteins of the pyruvate dehydrogenase complex (mainly the E2 subunit)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13600 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13600 goldbook:12895)
AnnotationAssertion(mito:isMentionedBy goldbook:13600 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13600 "current"^^xsd:string)
Declaration(Class(goldbook:13601))
AnnotationAssertion(rdfs:label goldbook:13601 "primary immune response")
AnnotationAssertion(dcterms:description goldbook:13601 "Immune response to the first encounter with an antigen, characterized by slow production of antibody molecules and the priming of lymphoid tissue in readiness for the production of a secondary immune response on subsequent challenge with the same antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13601 "primary response")
AnnotationAssertion(rdfs:comment goldbook:13601 "The primary response is generally weak, has a long induction phase or lag period, consists primarily of the release of immunoglobulin M (IgM) antibodies, and generates immunologic memory."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13601 goldbook:12997)
AnnotationAssertion(rdfs:seeAlso goldbook:13601 goldbook:13293)
AnnotationAssertion(rdfs:seeAlso goldbook:13601 goldbook:13414)
AnnotationAssertion(rdfs:seeAlso goldbook:13601 goldbook:13451)
AnnotationAssertion(rdfs:seeAlso goldbook:13601 goldbook:13607)
AnnotationAssertion(rdfs:seeAlso goldbook:13601 goldbook:13662)
AnnotationAssertion(mito:isMentionedBy goldbook:13601 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13601 "current"^^xsd:string)
Declaration(Class(goldbook:13602))
AnnotationAssertion(rdfs:label goldbook:13602 "primary immunization")
AnnotationAssertion(dcterms:description goldbook:13602 "First introduction of a vaccine into the body for the purposes of inducing immunity.")
AnnotationAssertion(rdfs:seeAlso goldbook:13602 goldbook:13272)
AnnotationAssertion(rdfs:seeAlso goldbook:13602 goldbook:13601)
AnnotationAssertion(mito:isMentionedBy goldbook:13602 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13602 "current"^^xsd:string)
Declaration(Class(goldbook:13603))
AnnotationAssertion(rdfs:label goldbook:13603 "primary lymphoid follicle")
AnnotationAssertion(dcterms:description goldbook:13603 "Region of a secondary lymphoid organ containing predominantly unstimulated B lymphocytes that develops into a germinal center following antigen stimulation.")
AnnotationAssertion(rdfs:seeAlso goldbook:13603 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13603 goldbook:13172)
AnnotationAssertion(rdfs:seeAlso goldbook:13603 goldbook:13412)
AnnotationAssertion(rdfs:seeAlso goldbook:13603 goldbook:13663)
AnnotationAssertion(mito:isMentionedBy goldbook:13603 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13603 "current"^^xsd:string)
Declaration(Class(goldbook:13604))
AnnotationAssertion(rdfs:label goldbook:13604 "primary lymphoid organ")
AnnotationAssertion(dcterms:description goldbook:13604 "Site at which immunocompetent lymphocytes develop, i.e., bone marrow and thymus in mammals.")
AnnotationAssertion(rdfs:seeAlso goldbook:13604 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13604 goldbook:13277)
AnnotationAssertion(rdfs:seeAlso goldbook:13604 goldbook:13399)
