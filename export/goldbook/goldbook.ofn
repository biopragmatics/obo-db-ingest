AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06775 "current"^^xsd:string)
Declaration(Class(goldbook:ST06784))
AnnotationAssertion(rdfs:label goldbook:ST06784 "Soret band")
AnnotationAssertion(dcterms:description goldbook:ST06784 "A very strong absorption band in the blue region of the optical absorption spectrum of a haem protein.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06784 goldbook:A00043)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06784 goldbook:H02714)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06784 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06784 "current"^^xsd:string)
Declaration(Class(goldbook:ST06785))
AnnotationAssertion(rdfs:label goldbook:ST06785 "stability constant")
AnnotationAssertion(dcterms:description goldbook:ST06785 "An equilibrium constant that expresses the propensity of a substance to form from its component parts. The larger the stability constant, the more stable is the species. The stability constant (formation constant) is the reciprocal of the instability constant (dissociation constant).")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06785 goldbook:D01801)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06785 goldbook:E02177)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06785 goldbook:F02485)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06785 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06785 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06785 "current"^^xsd:string)
Declaration(Class(goldbook:ST06802))
AnnotationAssertion(rdfs:label goldbook:ST06802 "systemic effect")
AnnotationAssertion(dcterms:description goldbook:ST06802 "Consequence that is either of a generalized nature or that occurs at a site distant from the point of entry of a substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06802 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06802 "current"^^xsd:string)
Declaration(Class(goldbook:ST06842))
AnnotationAssertion(rdfs:label goldbook:ST06842 "second messenger")
AnnotationAssertion(dcterms:description goldbook:ST06842 "Intracellular effector substance increasing or decreasing as a response to the stimulation of a receptor by an agonist, considered as the 'first messenger'.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06842 goldbook:A00186)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06842 goldbook:E01901)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06842 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06842 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06842 "current"^^xsd:string)
Declaration(Class(goldbook:ST06843))
AnnotationAssertion(rdfs:label goldbook:ST06843 "serum")
AnnotationAssertion(dcterms:description goldbook:ST06843 "Watery proteinaceous portion of the blood that remains after clotting. Synonym: blood serumClear watery fluid especially that moistening the surface of serous membranes or that exuded through inflammation of any of these membranes.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06843 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06843 "current"^^xsd:string)
Declaration(Class(goldbook:ST06844))
AnnotationAssertion(rdfs:label goldbook:ST06844 "stem cell")
AnnotationAssertion(dcterms:description goldbook:ST06844 "Multipotent cell with mitotic potential that may serve as a precursor for many kinds of differentiated cells.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06844 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06844 "current"^^xsd:string)
Declaration(Class(goldbook:ST06845))
AnnotationAssertion(rdfs:label goldbook:ST06845 "structure–activity relationship")
AnnotationAssertion(dcterms:description goldbook:ST06845 "Association between specific aspects of molecular structure and defined biological action.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:ST06845 "SAR")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06845 goldbook:A00472)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06845 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06845 "current"^^xsd:string)
Declaration(Class(goldbook:ST06848))
AnnotationAssertion(rdfs:label goldbook:ST06848 "speciation analysis")
AnnotationAssertion(dcterms:description goldbook:ST06848 "Analytical activities of identifying and/or measuring the quantities of one or more individual chemical species in a sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06848 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06848 "current"^^xsd:string)
Declaration(Class(goldbook:ST06861))
AnnotationAssertion(rdfs:label goldbook:ST06861 "speciation")
AnnotationAssertion(dcterms:description goldbook:ST06861 "Distribution of an element amongst defined chemical species in a system.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06861 goldbook:CT01038)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06861 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06861 "current"^^xsd:string)
Declaration(Class(goldbook:ST06868))
AnnotationAssertion(rdfs:label goldbook:ST06868 "side group or side-chain polymer liquid crystal")
AnnotationAssertion(dcterms:description goldbook:ST06868 "A polymer, the molecules of which have mesogenic units only in side-group's side-chains.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06868 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06868 "current"^^xsd:string)
Declaration(Class(goldbook:ST06872))
AnnotationAssertion(rdfs:label goldbook:ST06872 "semi-rigid chain")
AnnotationAssertion(dcterms:description goldbook:ST06872 "A chain for which the contour length is greater than the persistence length but for which their ratio is still below the Gaussian limit.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06872 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06872 "current"^^xsd:string)
Declaration(Class(goldbook:ST06873))
AnnotationAssertion(rdfs:label goldbook:ST06873 "spacer")
AnnotationAssertion(dcterms:description goldbook:ST06873 "A flexible segment used to link successive mesogenic units in the molecules of MCPLCs (main-chain polymer liquid crystals) or to attach mesogenic units as side-groups onto the polymer backbone of SGPLCs (side-group polymer liquid crystals).")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06873 goldbook:B00574)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06873 goldbook:MT06869)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06873 goldbook:MT06858)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06873 goldbook:ST06868)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06873 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06873 "current"^^xsd:string)
Declaration(Class(goldbook:ST06914))
AnnotationAssertion(rdfs:label goldbook:ST06914 "stochastic effect")
AnnotationAssertion(dcterms:description goldbook:ST06914 "Consequence for which the probability of occurrence depends on the absorbed dose; hereditary effects and cancer induced by radiation are considered to be stochastic effects. The term 'stochastic' indicates that the occurrence of effects so named would be random. This means that, even for an individual, there is no threshold of dose below which there is absolutely no probability of an effect occurring, and the chance of experiencing the effect increases with increasing dose.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06914 goldbook:DT06810)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06914 goldbook:DT07361)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06914 goldbook:P04855)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06914 doi:10.1351/pac200173060993)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06914 "current"^^xsd:string)
Declaration(Class(goldbook:ST06980))
AnnotationAssertion(rdfs:label goldbook:ST06980 "simplified molecular input line entry system")
AnnotationAssertion(dcterms:description goldbook:ST06980 "SMILES (Simplified Molecular Input Line Entry System) is a string notation used to describe the nature and topology of molecular structures.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:ST06980 "SMILES")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06980 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06980 "current"^^xsd:string)
Declaration(Class(goldbook:ST06981))
AnnotationAssertion(rdfs:label goldbook:ST06981 "structure-based design")
AnnotationAssertion(dcterms:description goldbook:ST06981 "Structure-based design is a design strategy for new chemical entities based on the three-dimensional (3D) structure of the target obtained by X-ray or nuclear magnetic resonance (NMR) studies, or from protein homology models.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:ST06981 "NMR")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06981 goldbook:R05326)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06981 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06981 "current"^^xsd:string)
Declaration(Class(goldbook:ST06982))
AnnotationAssertion(rdfs:label goldbook:ST06982 "structure-property correlations")
AnnotationAssertion(dcterms:description goldbook:ST06982 "Structure-property correlations (SPC) refer to all statistical mathematical methods used to correlate any molecular property (intrinsic, chemical or biological) to any other property, using statistical regression or pattern recognition techniques.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:ST06982 "SPC")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06982 goldbook:PT06976)
AnnotationAssertion(mito:isMentionedBy goldbook:ST06982 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST06982 "current"^^xsd:string)
Declaration(Class(goldbook:ST07097))
AnnotationAssertion(rdfs:label goldbook:ST07097 "scaling factor")
AnnotationAssertion(dcterms:description goldbook:ST07097 "A variational parameter used as a multiplier of each nuclear Cartesian and electronic coordinate chosen to minimize the variational integral and to make a trial variation function to satisfy the virial theorem. In practical calculations, the numeral factor to scale computed values, e.g. vibrational frequencies, to those found in experiments.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST07097 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07097 "current"^^xsd:string)
Declaration(Class(goldbook:ST07098))
AnnotationAssertion(rdfs:label goldbook:ST07098 "secular equation")
AnnotationAssertion(dcterms:description goldbook:ST07098 "In molecular orbital theory, the determinant of matrix elements whose solution leads to the set of energy levels of molecular orbitals for a given system.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07098 goldbook:M03996)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07098 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07098 "current"^^xsd:string)
Declaration(Class(goldbook:ST07099))
AnnotationAssertion(rdfs:label goldbook:ST07099 "semi-empirical quantum mechanical methods")
AnnotationAssertion(dcterms:description goldbook:ST07099 "Methods which use parameters derived from experimental data to simplify computations. The simplification may occur at various levels: simplification of the Hamiltonian (e.g., as in the Extended Hückel method), approximate evaluation of certain molecular integrals (see, for example, zero differential overlap approximation), simplification of the wavefunction (for example, use of a Pi ($\\ce{\\uppi\\!}$) electron approximation as in Pariser–Parr–Pople method), etc.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07099 goldbook:ET07032)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07099 goldbook:PT07088)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07099 goldbook:ZT07132)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07099 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07099 "current"^^xsd:string)
Declaration(Class(goldbook:ST07100))
AnnotationAssertion(rdfs:label goldbook:ST07100 "Slater determinant")
AnnotationAssertion(dcterms:description goldbook:ST07100 "The determinantal representation of many-electron wavefunction \\(\\Psi \\) which conforms to the requirement of the antisymmetry principle.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07100 goldbook:AT06989)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07100 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07100 "current"^^xsd:string)
Declaration(Class(goldbook:ST07101))
AnnotationAssertion(rdfs:label goldbook:ST07101 "soliton")
AnnotationAssertion(dcterms:description goldbook:ST07101 "Localized excitations propagating in a system with constant velocity and colliding with each other without change in their shapes.")
AnnotationAssertion(mito:isMentionedBy goldbook:ST07101 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07101 "current"^^xsd:string)
Declaration(Class(goldbook:ST07102))
AnnotationAssertion(rdfs:label goldbook:ST07102 "solvation energy")
AnnotationAssertion(dcterms:description goldbook:ST07102 "The change in Gibbs energy when an ion or molecule is transferred from a vacuum (or the gas phase) to a solvent. The main contributions to the solvation energy come from:  the cavitation energy of formation of the hole which preserves the dissolved species in the solvent;  the orientation energy of partial orientation of the dipoles; the isotropic interaction energy of electrostatic and dispersion origin; and  the anisotropic energy of specific interactions, e.g. hydrogen bonds, donor-acceptor interactions etc.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07102 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07102 goldbook:S05747)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07102 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07102 "current"^^xsd:string)
Declaration(Class(goldbook:ST07103))
AnnotationAssertion(rdfs:label goldbook:ST07103 "spin contamination")
AnnotationAssertion(dcterms:description goldbook:ST07103 "In unrestricted Hartree–Fock method, the wavefunctions obtained are eigenfunctions of the Hamiltonian and the spin projection \\(S_{\\rm{z}}\\) operators, but not eigenfunctions of the \\(S^{2}\\) operator. As a result, the wavefunctions of the doublet systems are spin-contaminated to some extent by admixtures of quartet, sextet, and higher spin states. The eigenvalues of the \\(S^{2}\\) operator are given as a measure of the spin contamination.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07103 goldbook:H02747)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07103 goldbook:C01295)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07103 goldbook:ST07106)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07103 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07103 "current"^^xsd:string)
Declaration(Class(goldbook:ST07104))
AnnotationAssertion(rdfs:label goldbook:ST07104 "spin crossover")
AnnotationAssertion(dcterms:description goldbook:ST07104 "A type of molecular magnetism that is the result of electronic instability (see electronic stability) caused by external constraints (temperature, pressure, or electromagnetic radiation), which induce structural changes at molecular and lattice levels. The phenomenon is most characteristic of first-row transition metal complexes, e.g. those of $\\ce{Fe^{2+}}$. An example of spin-crossover complexes (the term of spin-state isomers is also used) is $\\ce{[Fe(2-pic)3]Cl2.EtOH}$ (2-pic = 2-picolylamine). At the $\\ce{Fe–N}$ distance of \\(203.2\\ \\rm{pm}\\) (\\(115\\ \\rm{K}\\)), the complex has an electronic low-spin state ($^{1}{\\rm{A}}_{1}$), whereas stretching the bond up to \\(219.9\\ \\rm{pm}\\) at \\(227\\ \\rm{K}\\) induces the transition to a high-spin state ($^{5}{\\rm{T}}_{2}$).")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07104 goldbook:ET07027)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07104 goldbook:LT06788)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07104 goldbook:LT07067)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07104 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07104 "current"^^xsd:string)
Declaration(Class(goldbook:ST07105))
AnnotationAssertion(rdfs:label goldbook:ST07105 "spin polarization")
AnnotationAssertion(dcterms:description goldbook:ST07105 "Static and dynamic spin polarization effects are distinguished. The static polarization of an electron spin occurs in the $\\ce{C-H}$ bonds of aromatic radicals where the $\\ce{\\upsigma\\!\\mbox{-}electron}$ closest to an unpaired $\\ce{\\uppi\\!\\mbox{-}electron}$ tends to have its spin parallel to that of the $\\ce{\\uppi\\!\\mbox{-}electron}$. Likewise, static spin polarization arises in the $\\ce{\\upsigma\\!\\mbox{-}system}$ of conjugated radicals: the electron of the doubly occupied molecular orbital prefers to take a closer spatial position to the odd one, which spin is parallel to the latter. The effect reflects the energy unfavourable situation if an electron of opposite spin were to come nearby.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07105 goldbook:M03996)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07105 goldbook:P04712)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07105 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07105 "current"^^xsd:string)
Declaration(Class(goldbook:ST07106))
AnnotationAssertion(rdfs:label goldbook:ST07106 "spin projection")
AnnotationAssertion(dcterms:description goldbook:ST07106 "A component, \\(M_{S}\\), of the angular spin moment \\(S\\) along an arbitrary axis (usually chosen as the z-direction). \\(M_{S}\\) can take the values between \\(-S\\) and \\(S\\): \\(-S\\), \\(-S + 1\\),..., \\(S- 1\\), \\(S\\). The term is also used to denote an operation (spin-symmetry projection) allowing one to eliminate spin contamination in the cases where wavefunctions are not eigenfunctions of the operator \\(S^{2}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07106 goldbook:ST07103)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07106 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07106 "current"^^xsd:string)
Declaration(Class(goldbook:ST07107))
AnnotationAssertion(rdfs:label goldbook:ST07107 "stereochemical non-rigidity")
AnnotationAssertion(dcterms:description goldbook:ST07107 "The capability of a molecule to undergo fast and reversible intramolecular isomerization, the energy barrier to which is lower than that allowing for the preparative isolation of the individual isomers at room temperature. It is conventional to assign to the sterochemically non-rigid systems those compounds whose molecules rearrange rapidly enough to influence NMR line shapes at temperatures within the practical range (from \\(\\pu{-100^{\\circ}C}\\) to \\(\\pu{200^{\\circ}C}\\)) of experimentation. The energy barriers to thus defined rearrangements fall into the range of \\(5\\)–\\(\\pu{20 kcal/mol}\\) (\\(21\\)–\\(\\pu{85 kJ/mol}\\)).")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07107 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07107 goldbook:I03295)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07107 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07107 "current"^^xsd:string)
Declaration(Class(goldbook:ST07108))
AnnotationAssertion(rdfs:label goldbook:ST07108 "strain energy")
AnnotationAssertion(dcterms:description goldbook:ST07108 "The excess energy due to steric strain of a molecular entity or transition state structure, i.e. distortions relative to a reference (real or hypothetical) 'strainless' structure with the standard bond lengths, bond angles and dihedral angles. The strain energy components involve the following destabilizing terms: non-bonded repulsions, bond-angle distortions, bond stretch or compression, rotation around or twisting of double bonds, and electrostatic strain. In general, the contributions of these components are inseparable and interdependent. A quantitative assessment of strain and strain energies can be made by taking the difference between the heat of formation of the substance under consideration and that of a hypothetical strain-free model. Several approaches to the assessment of strain energies have been developed based on the use of energies of isodesmic and homodesmotic reactions and on the so-called 'strainless increments', i.e. heats of formation of certain groups ($\\ce{CH3}$, $\\ce{CH2}$, $\\ce{CH}$, $\\ce{C}$ etc).")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07108 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07108 goldbook:S06002)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07108 goldbook:S06037)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07108 goldbook:T06468)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07108 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07108 "current"^^xsd:string)
Declaration(Class(goldbook:ST07109))
AnnotationAssertion(rdfs:label goldbook:ST07109 "structural stability")
AnnotationAssertion(dcterms:description goldbook:ST07109 "Within the Born–Oppenheimer (adiabatic) approximation, this is associated with an energy minimum on a potential energy surface. Structural stability implies that any change in the coordinates of the nuclei can only increase the total energy.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07109 goldbook:A00141)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07109 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07109 "current"^^xsd:string)
Declaration(Class(goldbook:ST07110))
AnnotationAssertion(rdfs:label goldbook:ST07110 "sudden polarization")
AnnotationAssertion(dcterms:description goldbook:ST07110 "The occurrence of a large intramolecular charge separation in the singlet excited state of polyenes and their derivatives twisted about a double bond. Non-symmetrical substitution or geometrical distortion is effective in polarizing the system. An example is the stabilization of the zwitterionic structure of 90° twisted ethene with one methylene group pyramidalized:")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07110 goldbook:C00999)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07110 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07110 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07110 goldbook:M03881)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07110 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07110 "current"^^xsd:string)
Declaration(Class(goldbook:ST07111))
AnnotationAssertion(rdfs:label goldbook:ST07111 "supramolecular chemistry")
AnnotationAssertion(dcterms:description goldbook:ST07111 "A field of chemistry related to species of greater complexity than molecules, that are held together and organized by means of intermolecular interactions. The objects of supramolecular chemistry are supermolecules and other polymolecular entities that result from the spontaneous association of a large number of components into a specific phase (membranes, vesicles, micelles, solid state structures etc.)")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07111 goldbook:A00472)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07111 goldbook:I03098)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07111 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07111 "current"^^xsd:string)
Declaration(Class(goldbook:ST07151))
AnnotationAssertion(rdfs:label goldbook:ST07151 "sol-gel process")
AnnotationAssertion(dcterms:description goldbook:ST07151 "Process through which a network is formed from solution by a progressive change of liquid precursor(s) into a sol, to a gel, and in most cases finally to a dry network.")
AnnotationAssertion(rdfs:comment goldbook:ST07151 "An inorganic polymer, e.g., silica gel, or an organic–inorganic hybrid can be prepared by sol-gel processing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07151 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07151 goldbook:IT07515)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07151 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07151 goldbook:S05727)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07151 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07151 "current"^^xsd:string)
Declaration(Class(goldbook:ST07152))
AnnotationAssertion(rdfs:label goldbook:ST07152 "surface grafting")
AnnotationAssertion(dcterms:description goldbook:ST07152 "Process in which a polymer surface is chemically modified by grafting or by the generation of active sites that can lead to the initiation of a graft polymerization.")
AnnotationAssertion(rdfs:comment goldbook:ST07152 "Peroxidation, ozonolysis, high-energy irradiation, and plasma etching are methods of generating active sites on a polymer surface."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07152 goldbook:GT07138)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07152 goldbook:I03042)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07152 goldbook:I03255)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07152 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07152 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07152 "current"^^xsd:string)
Declaration(Class(goldbook:ST07194))
AnnotationAssertion(rdfs:label goldbook:ST07194 "shape-memory polymer")
AnnotationAssertion(dcterms:description goldbook:ST07194 "Polymer that, after heating and being subjected to a plastic deformation, resumes its original shape when heated above its glass-transition or melting temperature.")
AnnotationAssertion(rdfs:comment goldbook:ST07194 "Crystalline trans-polyisoprene is an example of a shape-memory polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07194 goldbook:M03821)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07194 goldbook:C01092)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07194 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07194 "current"^^xsd:string)
Declaration(Class(goldbook:ST07195))
AnnotationAssertion(rdfs:label goldbook:ST07195 "superabsorbent polymer")
AnnotationAssertion(dcterms:description goldbook:ST07195 "Polymer that can absorb and retain extremely large amounts of a liquid relative to its own mass.")
AnnotationAssertion(rdfs:comment goldbook:ST07195 "The liquid absorbed can be water or an organic liquid."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:ST07195 "The swelling ratio of a superabsorbent polymer can reach the order of 1000:1."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:ST07195 "Superabsorbent polymers for water are frequently polyelectrolytes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07195 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07195 "current"^^xsd:string)
Declaration(Class(goldbook:ST07227))
AnnotationAssertion(rdfs:label goldbook:ST07227 "solid polymer electrolyte")
AnnotationAssertion(dcterms:description goldbook:ST07227 "Electrically conducting solution of a salt in a polymer.")
AnnotationAssertion(rdfs:comment goldbook:ST07227 "An example of a solid @P04728@ is a solution of a lithium salt in a poly(oxyethylene) matrix; the ionic conductivity of such material is due to the mobility of lithium cations and their counterions in an electric field."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:ST07227 "Although the adjective 'solid' is used, the material may be a liquid."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:ST07227 "The term solid @P04728-1@ should not be confused with the term polymeric electrolyte."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07227 goldbook:CT07201)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07227 goldbook:I03175)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07227 goldbook:M03955)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07227 goldbook:P04728)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07227 goldbook:S05447)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07227 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07227 "current"^^xsd:string)
Declaration(Class(goldbook:ST07274))
AnnotationAssertion(rdfs:label goldbook:ST07274 "spinodal")
AnnotationAssertion(dcterms:description goldbook:ST07274 "Curve defining the region of composition and temperature for a binary mixture across which a transition occurs from conditions where single-phase mixtures are metastable to conditions where single-phase mixtures are unstable and undergo phase separation by spinodal decomposition.")
AnnotationAssertion(rdfs:comment goldbook:ST07274 "The spinodal curve for a binary mixture is defined as the geometrical locus of all states with \\[\\left ( \\frac{\\delta^{2}\\Delta _{\\rm{mix}}G}{\\delta\\phi ^{2}} \\right)_{T,p} = 0\\]."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:ST07274 "In the unstable region bounded by the spinodal curve, phase domain separation is spontaneous, i.e., no nucleation step is required to initiate the separation process."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07274 goldbook:M03872)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07274 goldbook:PT07286)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07274 goldbook:P04534)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07274 goldbook:S05869)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07274 goldbook:U06569)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07274 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07274 "current"^^xsd:string)
Declaration(Class(goldbook:ST07294))
AnnotationAssertion(rdfs:label goldbook:ST07294 "soft-segment phase domain")
AnnotationAssertion(dcterms:description goldbook:ST07294 "Phase domain of microscopic or smaller size, usually in a block, graft, or segmented copolymer, comprising essentially those segments of the polymer that have glass transition temperatures lower than the temperature of use.")
AnnotationAssertion(rdfs:comment goldbook:ST07294 "Soft-segment phase domains are often larger than hard-segment phase domains and are often continuous."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07294 goldbook:PT07286)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07294 goldbook:B00682)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07294 goldbook:G02640)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07294 goldbook:ST07295)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07294 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07294 "current"^^xsd:string)
Declaration(Class(goldbook:ST07295))
AnnotationAssertion(rdfs:label goldbook:ST07295 "segmented copolymer")
AnnotationAssertion(dcterms:description goldbook:ST07295 "Copolymer containing phase domains of microscopic or smaller size, with the domains constituted principally of single types of structural unit.")
AnnotationAssertion(rdfs:comment goldbook:ST07295 "The types of domain in a segmented copolymer usually comprise hard- and soft-segment phase domains."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07295 goldbook:C01335)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07295 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07295 "current"^^xsd:string)
Declaration(Class(goldbook:ST07395))
AnnotationAssertion(rdfs:label goldbook:ST07395 "spectral sensitivity")
AnnotationAssertion(dcterms:description goldbook:ST07395 "Referred to actinometer based on spectrophotometric measurements, \\(S_{\\rm{ac}}\\left(\\lambda \\right)=\\varPhi \\left(\\lambda \\right)\\ \\varepsilon\\left(\\lambda _{\\rm{obs}}\\right)=\\rm{sensitivity or actinometric factor}\\). \\(\\varPhi \\left(\\lambda \\right)\\) is the quantum yield of the actinometer at the excitation wavelength and \\(\\lambda _{\\rm{obs}}\\) is the observation wavelength, which may be the same as or differ from the former.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07395 goldbook:A00087)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07395 goldbook:Q04991)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07395 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07395 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07395 "current"^^xsd:string)
Declaration(Class(goldbook:ST07417))
AnnotationAssertion(rdfs:label goldbook:ST07417 "self-localized excitations")
AnnotationAssertion(dcterms:description goldbook:ST07417 "Physical and chemical properties of conjugated organic polymers with $\\ce{\\uppi\\!\\mbox{-}electrons}$ have been interpreted in terms of self-localized excitations, which are quasi-particles with structural changes over several repeating units. These excitations can be classified into solitons, polarons, bipolarons and excitons according to their charge and spin.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST07417 goldbook:BT07334)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07417 goldbook:PT07416)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07417 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07417 "current"^^xsd:string)
Declaration(Class(goldbook:ST07466))
AnnotationAssertion(rdfs:label goldbook:ST07466 "solubility parameter")
AnnotationAssertion(dcterms:description goldbook:ST07466 "Parameter used in predicting the solubility of non-electrolytes (including polymers) in a given solvent.For a substance \\(\\rm{B}\\), \\[\\delta _{\\rm{B}} = \\left ( \\frac{\\Delta _{\\rm{vap}}E_{\\rm{m,B}}}{V_{\\rm{m,B}}} \\right )^{1/2}\\] where \\(\\Delta _{\\rm{vap}}E_{\\rm{m,B}}\\) is the molar energy of vaporization at zero pressure and \\(V_{\\rm{m,B}}\\) is the molar volume.")
AnnotationAssertion(rdfs:comment goldbook:ST07466 "For a substance of low molecular weight, the value of the solubility parameter can be estimated most reliably from the enthalpy of vaporization and the molar volume."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:ST07466 "The solubility of a substance B can be related to the square of the difference between the solubility parameters for supercooled liquid B and solvent at a given temperature, with appropriate allowances for entropy of mixing. Thus, a value can be estimated from the solubility of the solid in a series of solvents of known solubility parameter. For a polymer, it is usually taken to be the value of the solubility parameter of the solvent producing the solution with maximum intrinsic viscosity or maximum swelling of a network of the polymer. See J.H. Hildebrand, R.L.Scott, The Solubility of Nonelectrolytes, 3rd ed., Reinhold Publishing (1950); Dover Publications (1964), Chap. VII, p.129; Chap. XXIII, for the original definition, theory, and extensive examples."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:ST07466 "The SI units are \\(\\rm{Pa}^{1/2} = \\rm{J}^{1/2}\\ \\rm{m}^{-3/2}\\), but units used frequently are \\((\\pu{\\upmu Pa})^{1/2} = (\\pu{J cm-3})^{1/2}\\) or \\((\\rm{cal cm}^{-3})^{1/2}\\), where \\(1\\ (\\rm{J cm}^{-3})^{1/2} \\approx 2.045(\\rm{cal cm}^{-3})^{1/2}\\). The unit calorie is discouraged as obsolete."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07466 goldbook:C00784)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07466 goldbook:E02141)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07466 goldbook:E02149)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07466 goldbook:M04000)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07466 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07466 goldbook:S05740)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07466 goldbook:V06627)
AnnotationAssertion(mito:isMentionedBy goldbook:ST07466 doi:10.1351/pac200880020233)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ST07466 "current"^^xsd:string)
