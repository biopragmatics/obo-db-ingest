    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10356">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extra-embryonic membrane formed early in development as an outpouching of the yolk sac into the area of the future umbilical cord.</dcterms:description>
