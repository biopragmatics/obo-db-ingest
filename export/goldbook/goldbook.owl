        <rdfs:label>epiblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10665 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10665">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inner layer of the pericardium, a sac of fibrous tissue that surrounds and lies upon the heart and the base of the great vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>visceral pericardium</oboInOwl:hasRelatedSynonym>
        <rdfs:label>epicardium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11078"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10666 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10666">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the distribution and determinants of health-related states or events in specified populations and the application of this study for the control of health problems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epidemiology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10667 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10667">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In vertebrates, protective outer stratified squamous layer of the skin consisting mainly of keratinocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epidermis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10668 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10668">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tightly-coiled, thin-walled tube that conducts sperm from the testis to the vas deferens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epididymis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11358"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10669 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10669">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cystic structure sometimes found on the head of the epididymis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>appendix epididymidis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The epididymal appendix represents a remnant of the mesonephric duct.</rdfs:comment>
        <rdfs:label>epididymal appendix</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10582"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10668"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10946"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10670 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10670">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic neurological disorder marked by sudden recurrent episodes of sensory disturbance, loss of consciousness, or convulsions, associated with abnormal electrical activity in the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epilepsy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10671 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10671">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The disk of hyaline cartilage between the metaphysis and the epiphysis of an immature long bone that permits the bone to grow longer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epiphyseal plate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10672 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10672">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malformation in which the urethra does not develop to full length, opening typically on the dorsum of the penis (and rarely, in females, between the clitoris and labia); frequently associated with exstrophy of the bladder.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epispadias</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10697"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11343"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10673 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10673">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Situation in which the phenotypic expression of one gene obscures the phenotypic effects of another gene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epistasis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10674 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10674">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sheet of one or more layers of cells covering the internal and external surfaces of the body and hollow organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>epithelium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10675 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10675">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of events, where epithelial cells detach, migrate, and become mesenchymal stem cells that can differentiate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>EMT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This transition plays a role in embryogenesis, wound healing, and cancer.</rdfs:comment>
        <rdfs:label>epithelial-to-mesenchymal transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10485"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10941"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10675"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EMT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10676 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10676">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detoxification enzyme (EC 3.3.2.9), located mainly in the endoplasmic reticulum, that hydrolyzes epoxides, converting them to metabolites that can be more rapidly excreted.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>epoxide hydratase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>epoxide hydrolase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10677 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10677">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inability of a male to have or to maintain an erection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>erectile dysfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10678 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10678">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Steroid sex hormone, involved in many regulatory processes, but most prominently in the development of female sex organs, the menstrual cycle, and pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>17β-estradiol</oboInOwl:hasRelatedSynonym>
        <rdfs:label>estradiol</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10936"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10679 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10679">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hormonally active metabolite of estradiol, eliminated in urine, especially during pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>estriol</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10678"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10680 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10680">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any substance, natural or synthetic, that exerts the hormonal effects of the natural estrogen, estradiol, usually by interaction with the estrogen receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Phytoestrogens are substances that occur in plants and have estrogenic activity.</rdfs:comment>
        <rdfs:label>estrogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10678"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10681 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10681">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a tumor cell line is exposed to a test substance and activation of the estrogen receptor is studied by a reporter molecule in order to assess the estrogen-sensitivity of the tumor. Test using estrogen-sensitive cells to evaluate estrogenic activity of a substance or environmental sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>&lt;em&gt;in vitro&lt;/em&gt; estrogen activity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11349"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10682 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10682">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Behaving like an estrogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>estrogen-mimetic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10683 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10683">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exhibiting hormonal activity similar to that of estrogens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>estrogenic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10684 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10684">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of recurring physiological uterine, ovarian, and other changes, induced by reproductive hormones in higher female animals, resulting in readiness for insemination. This cycle starts in adulthood (at menarche), transiently discontinues during pregnancy, and disappears at the menopause.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>estrous cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10348"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10856"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10928"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10935"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10685 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10685">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recurrent period of sexual receptivity and arousal in the female of most mammals except the higher primates, during which conception is possible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>heat</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oestrus</oboInOwl:hasRelatedSynonym>
        <rdfs:label>estrus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10686 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10686">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Persistent estrus caused by elevated estrogenic activity, either due to endogenous estrogens (e.g., in polycystic ovary syndrome) or due to exogenous substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Estrus syndrome is associated with infertility.</rdfs:comment>
        <rdfs:label>estrus syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10683"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10685"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10850"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11104"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10687 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10687">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to a cell or organism with chromosomes present in an integral multiple of the haploid number.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>A human cell with the normal number of \(\pu{46}\) chromosomes, an integral multiple of the monoploid number, \(\pu{23}\), is thus euploid. However, a human with abnormal, but integral, multiples of this full set (e.g., \(\pu{69}\) chromosomes) would also be considered as euploid.</rdfs:comment>
        <rdfs:label>euploid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10688 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10688">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subclass of mammals having a placenta through which the fetus is nourished.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>eutherian</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10689 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10689">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protrusion of omentum and/or intestine through a defect or weakness in the abdominal wall while the skin remains intact.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>herniation of intestines</oboInOwl:hasRelatedSynonym>
        <rdfs:label>eventration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11034"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11037"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10690 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10690">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific induction of a tissue within a developing embryo that results from the action of a single hormone or other chemical (the evocator).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>evocation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10691 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10691">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to a vessel (or opening) conveying fluid outwards.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The male excurrent ducts are those involved in the transport, enrichment and ejaculation of semen.</rdfs:comment>
        <rdfs:label>excurrent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10641"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11202"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10692 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10692">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exposed brain resulting from failure of the neural tube to close and absence of the top of the skull.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>exencephalus</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In humans this is followed by degeneration of the brain, resulting in anencephaly.</rdfs:comment>
        <rdfs:label>exencephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10390"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10693 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10693">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to or denoting glands that secrete through ducts opening on to superficial epithelium (e.g., the intestinal tract) rather than into the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>exocrine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10694 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10694">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hernia in which bowel or omentum protrudes through the abdominal wall under the skin at the umbilicus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>omphalocele</oboInOwl:hasRelatedSynonym>
        <rdfs:label>exomphalos</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10796"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11034"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10695 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10695">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Marked protrusion of the eyeballs, usually resulting from an increased volume of the orbital contents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>exophthalmos</oboInOwl:hasRelatedSynonym>
        <rdfs:label>exophthalmia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11046"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10696 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10696">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Partial or full complementary DNA sequence that can serve as a marker for a region of the genome that encodes an expressed product.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>EST</oboInOwl:hasRelatedSynonym>
        <rdfs:label>expressed sequence tag</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10696"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10697 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10697">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital malformation in which a hollow organ has its interior exposed through eversion; most commonly observed in the urinary bladder (ectopia vesicae).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>exstrophy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10698 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10698">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genitalia visible outside the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>external genitalia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10755"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10699 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10699">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mesh of molecules, secreted by cells into the surrounding extracellular space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ECM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Cells may adhere to the matrix and this can provide them with structural and biochemical support.</rdfs:comment>
        <rdfs:label>extracellular matrix</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10699"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ECM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10700 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10700">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the membranes that surrounds the embryo, which include the yolk sac, allantois, amnion, and chorion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>extraembryonic membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10356"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11389"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10701 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10701">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cells outside the embryo that, although derived from the zygote, are not part of the embryo proper and contribute to the fetal membranes (yolk sac, allantois, amnion, and chorion).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>extraembryonic mesoderm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10356"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11389"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10702 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10702">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apoptotic pathway of cell death initiated upon occupancy of so-called death receptors at the cell surface with their ligands, such as Fas/CD95 and tumor necrosis factor-\(\upalpha\), and involving activation of caspase 8.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This pathway converges with the intrinsic pathway at the level of cleavage of procaspase 3 by either caspase 8 (extrinsic pathway) or caspase 9 (intrinsic pathway).</rdfs:comment>
        <rdfs:label>extrinsic pathway</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10864"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10703 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10703">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicating ‘first filial’ generation, denoting offspring from genotypically (see genotype) distinct parents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>F2 denotes offspring resulting from mating (inbreeding) of individuals from F1. The term may be extended to F3 and beyond.</rdfs:comment>
        <rdfs:label>F1 generation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10704 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10704">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital anomaly resulting from the failure of facial structures in the embryo to fuse properly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>facial cleft</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11049"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10705 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10705">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In medicine, facial expression of an individual that is typical of a particular syndrome, disease, or condition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>facies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11277"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10706 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10706">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a pair of tubes, on either side of the upper or outer extremity of the ovary, that provides a path by which an ovum travels from the ovary to the fundus of the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>oviduct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>salpinx</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>uterine tube</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Each tube is largely enveloped by its expanded infundibulum, where, if the ovum is fertilized in the tube, it will implant (see implantation) as a zygote.</rdfs:comment>
        <rdfs:label>fallopian tube</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10743"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10707 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10707">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of fertilization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>impregnation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fecundation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10708 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10708">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to produce offspring within a given period of time. Quantity of reproductive output.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Fecundity is controlled by both genetic and environmental factors, and is a major determinant of fitness.</rdfs:comment>
        <rdfs:comment>The potential reproductive capacity of an organism or population may be measured by the number of gametes.</rdfs:comment>
        <rdfs:label>fecundity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10725"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10709 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10709">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development of female characteristics as part of normal female maturation, or, in a male, pathologically as a result of endocrine imbalance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>feminization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10710 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10710">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to conceive (see conception). Production of live offspring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>female fertility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10711 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10711">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to induce conception.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Sperm count and motility are important contributing factors.</rdfs:comment>
        <rdfs:label>male fertility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10977"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10712 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10712">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reproductive toxicity test in rodents in which female animals are repeatedly mated and frequency and size of litter and other parameters are measured; second or later generation fertility is also studied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>FACB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Reproductive Assessment by Continuous Breeding (RACB)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Fertility Assessment by Continuous Breeding</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10897"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10712"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FACB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10713 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10713">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In reproductive biology, union of male and female gametes to form a zygote from which an embryo can develop.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fertilization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10714 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10714">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition developing in the fetus and resulting in congenital abnormalities, caused by alcohol intake by the mother during pregnancy, typically characterized by decreased cognitive development, stunted growth and a characteristic facies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>FAS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>FAS is the most serious form of fetal alcohol spectrum disorder (FASD), a range of milder forms that may show reduced skills in learning, social development, memory, and control of emotions.</rdfs:comment>
        <rdfs:label>fetal alcohol syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10705"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10714"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10715 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10715">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thickening on the margin of the yolk sac of a fetus during pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Appearance of the fetal pole is used as the earliest sign of a baby in ultrasound examination.</rdfs:comment>
        <rdfs:label>fetal pole</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11337"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11389"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10716 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10716">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay for teratogenicity using embryos of the frog, Xenopus laevis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>frog embryo teratogenesis assay &lt;em&gt;Xenopus&lt;/em&gt;</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>frog embryo teratogenesis assay Xenopus</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The term is derived from the first letters of &quot;frog embryo teratogenesis assay Xenopus&quot;.</rdfs:comment>
        <rdfs:label>FETAX</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11290"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10717 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10717">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a fetus may be directly observed in utero, using a fiber-optic endoscope (fetoscope) introduced through a small incision in the abdomen under local anesthesia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Photographs may be taken, and amniotic fluid, fetal cells, or blood may be sampled for prenatal diagnosis of many congenital anomalies or genetic defects.</rdfs:comment>
        <rdfs:label>fetoscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10862"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10718 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10718">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Young mammal within the uterus of the mother, from the visible completion of characteristic organogenesis until birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>In humans, this period is usually defined as from the third month after fertilization until birth; prior to this the young mammal is referred to as an embryo.</rdfs:comment>
        <rdfs:label>fetus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11048"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10719 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10719">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Flat fibrous tissue cell, with stellate or spindle shape, associated with the formation of collagen fibers and intercellular extracellular matrix.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>desmocyte</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fibrocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This cell may develop into a number of precursor cells, such as collagenoblasts, osteoblasts, and chondroblasts.</rdfs:comment>
        <rdfs:label>fibroblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10699"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10720 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10720">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a family of more than twenty protein growth factors involved in angiogenesis, wound healing, and, in early embryonic development, induction of mesoderm, patterning and morphogenesis, and development of the limbs and brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>FGF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fibroblast growth factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11232"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10720"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FGF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10721 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10721">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which fish (often zebrafish, Danio rerio) eggs and embryos are exposed to a test chemical and subsequent development or death of the animals is studied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>FET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fish embryo acute toxicity test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fish embryo test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10721"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10722 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10722">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which sexually mature male and spawning female fish are exposed to a test substance and multiple endpoints, including egg production, endocrine activity, vitellogenin, and gonadal histopathology are measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fish reproduction assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10657"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11375"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10723 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10723">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which fish are exposed from the time of fertilization of the egg until sexual differentiation is completed and markers of possible endocrine disruptor activity are studied, including vitellogenin concentration, gonadal histopathology, sex ratios, and the occurrence of intersex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fish sexual development test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10658"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11375"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10724 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10724">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Permanent abnormal passage from an internal organ to the body surface or between two internal organs or structures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fistula</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10725 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10725">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to survive and reproduce.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fitness</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10726 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10726">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bend between the ascending colon and the transverse colon.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>right colic flexure</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hepatic flexure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10727 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10727">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Alternative spelling of fetus found in British English usage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>foetus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10728 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10728">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Water-soluble B vitamin involved in breakdown of carbohydrates, releasing energy and promoting biosynthesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Folic acid deficiency may lead to a range of serious abnormalities of the developing fetus, including neural tube defects.</rdfs:comment>
        <rdfs:label>folic acid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11004"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10729 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10729">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small, secretory sac, such as the dental follicles that enclose the teeth before eruption or the hair follicles within the epidermis. Fluid- or colloid-filled ball of cells in some glands such as the thyroid gland and the ovaries.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>follicle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10667"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11305"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10730 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10730">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hormone secreted by the anterior pituitary that stimulates the Graafian follicles of the ovary and subsequent follicular maturation, and in the male contributes to inducing spermatogenesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>FSH</oboInOwl:hasRelatedSynonym>
        <rdfs:label>follicle-stimulating hormone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10729"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10778"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11240"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10730"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FSH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10731 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10731">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hormone, released by the hypothalamus, inducing the secretion of follicle-stimulating hormone and luteinizing hormone by the pituitary gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>FSH-RH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gonadoliberin</oboInOwl:hasRelatedSynonym>
        <rdfs:label>follicle-stimulating hormone releasing hormone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10730"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10731"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FSH-RH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10732 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10732">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degeneration and resorption of an ovarian follicle before it reaches maturity and ruptures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>follicular atresia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11056"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10733 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10733">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First half of the human menstrual cycle, during which one or more follicles in the ovary may mature, culminating in ovulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>follicular phase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10729"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10936"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10734 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10734">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of several soft spots in specific locations on the skull of the newborn where the bones have not yet fused and the brain is covered by skin and a tough membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fontanelle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10564"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10735 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10735">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Opening, hole.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>foramina</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The skull has several such openings that act as passageways for structures, notably nerves and blood vessels.</rdfs:comment>
        <rdfs:comment>The vertebral column is perforated by the vertebral foramina through which nerves from the spinal cord exit to the periphery.</rdfs:comment>
        <rdfs:label>foramen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10736 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10736">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large foramen in the base of the skull, through which the spinal cord passes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>foramen magnum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10735"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10737 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10737">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In the fetal heart, opening that allows shunting of blood between the right and left atria and normally closes at birth. One of the larger foramina in the base of the skull.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>foramen ovale</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10441"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10735"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10738 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10738">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to genetic investigation in which the aim is to identify the gene that governs a particular function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Mutant phenotypes indicate the responsible gene and co-inherited genetic markers indicate the region of the genome where it occurs.</rdfs:comment>
        <rdfs:label>forward genetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11184"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10739 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10739">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In anatomy, a depression or hollow, often in a bone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fossa</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10740 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10740">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Oval depression in the heart, on the lower part of the septum of the right atrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The fossa ovalis is a remnant of the foramen ovale.</rdfs:comment>
        <rdfs:label>fossa ovalis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10441"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10737"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11206"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10741 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10741">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital malformation of the midface in which the nose has a flat, wide appearance, the eyes may be wide-set, and there is a groove of varying size, running down the middle of the face across the nose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>FND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tessier cleft numbers 0/14</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>frontonasal dysostosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>frontonasal malformation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>median cleft face syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>frontonasal dysplasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11293"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10741"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FND</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10742 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10742">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development and implementation of technologies to characterize the mechanisms through which genes and their products function and interact with each other and with the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>functional genomics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10743 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10743">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of a hollow organ (e.g., the uterus) that is furthest from its opening.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>fundus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10744 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10744">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pear-shaped muscular sac underneath the liver that stores bile secreted by the liver before its release into the duodenum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gall bladder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10620"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10745 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10745">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reproductive cell (e.g., sperm or egg) containing a haploid set of chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gamete</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10746 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10746">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique of assisted reproduction by placing eggs and sperm into a woman’s Fallopian tubes in order that fertilization may occur there.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>GIFT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The embryo is expected to travel through the Fallopian tube and implant in the uterus as it would have done had natural fertilization occurred.</rdfs:comment>
        <rdfs:label>gamete intrafallopian transfer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10746"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GIFT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10747 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10747">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development of male or female gametes to maturity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gametogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10748 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10748">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital defect characterized by a fissure in the anterior abdominal wall through which the small and (or) large intestine protrude.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gastroschisis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10749 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10749">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic stage that develops from two to three germ layers during gastrulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gastrula</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10750"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10763"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10750 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10750">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stage of embryo development in which the two-layered blastula transforms into the gastrula by developing ectoderm and endoderm, as well as a third layer (mesoderm), through the movement of specific cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gastrulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10749"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
    </owl:Class>
    


