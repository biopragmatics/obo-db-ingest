AnnotationAssertion(rdfs:label goldbook:11934 "neurogenic shock")
AnnotationAssertion(dcterms:description goldbook:11934 "Condition of decreased blood pressure, slow heart rate and insufficient perfusion of the body with blood, caused by loss of autonomic control following acute trauma to the brain or spinal cord.")
AnnotationAssertion(rdfs:seeAlso goldbook:11934 goldbook:11625)
AnnotationAssertion(rdfs:seeAlso goldbook:11934 goldbook:11647)
AnnotationAssertion(mito:isMentionedBy goldbook:11934 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11934 "current"^^xsd:string)
Declaration(Class(goldbook:11935))
AnnotationAssertion(rdfs:label goldbook:11935 "neuroimaging")
AnnotationAssertion(dcterms:description goldbook:11935 "Process of producing images of the structure or activity of the brain or other parts of the nervous system.")
AnnotationAssertion(rdfs:comment goldbook:11935 "Current neuroimaging techniques include magnetic resonance imaging and computerized tomography."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11935 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11935 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11935 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11935 "current"^^xsd:string)
Declaration(Class(goldbook:11936))
AnnotationAssertion(rdfs:label goldbook:11936 "neuroinflammation")
AnnotationAssertion(dcterms:description goldbook:11936 "Complex series of local immune responses within the nervous system to deal with a threat to the neural environment from infection, injury, or trauma.")
AnnotationAssertion(rdfs:comment goldbook:11936 "In the brain, the process is initiated by microglial release of cytokines, often leading to increased blood–brain barrier permeability and a secondary lymphocyte-mediated inflammation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11936 goldbook:11640)
AnnotationAssertion(rdfs:seeAlso goldbook:11936 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11936 goldbook:11830)
AnnotationAssertion(rdfs:seeAlso goldbook:11936 goldbook:11872)
AnnotationAssertion(rdfs:seeAlso goldbook:11936 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11936 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11936 "current"^^xsd:string)
Declaration(Class(goldbook:11937))
AnnotationAssertion(rdfs:label goldbook:11937 "neuroleptic")
AnnotationAssertion(dcterms:description goldbook:11937 "Any of a class of psychotropic drugs used to treat psychosis, particularly schizophrenia.")
AnnotationAssertion(rdfs:seeAlso goldbook:11937 goldbook:12029)
AnnotationAssertion(rdfs:seeAlso goldbook:11937 goldbook:12031)
AnnotationAssertion(mito:isMentionedBy goldbook:11937 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11937 "current"^^xsd:string)
Declaration(Class(goldbook:11938))
AnnotationAssertion(rdfs:label goldbook:11938 "neurolysis")
AnnotationAssertion(dcterms:description goldbook:11938 "Breakdown of nervous tissue from disease or injury. Therapeutic destruction of a nerve or nerves to treat intractable pain. Surgical freeing of a nerve from adhesions of the neural sheath.")
AnnotationAssertion(rdfs:seeAlso goldbook:11938 goldbook:11909)
AnnotationAssertion(rdfs:seeAlso goldbook:11938 goldbook:11983)
AnnotationAssertion(mito:isMentionedBy goldbook:11938 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11938 "current"^^xsd:string)
