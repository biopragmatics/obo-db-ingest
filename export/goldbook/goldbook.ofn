AnnotationAssertion(rdfs:seeAlso goldbook:13541 goldbook:12857)
AnnotationAssertion(rdfs:seeAlso goldbook:13541 goldbook:12859)
AnnotationAssertion(rdfs:seeAlso goldbook:13541 goldbook:13473)
