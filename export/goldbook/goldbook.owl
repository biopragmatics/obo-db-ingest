    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15470">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill trees and shrubs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
