AnnotationAssertion(dcterms:description goldbook:11959 "Referring to a substance or effect that mimics acetylcholine at the neuromuscular junction, at autonomic ganglia and at other locations in the brain.")
AnnotationAssertion(rdfs:comment goldbook:11959 "These substances bind to a specific class of cholinergic receptors denoted nicotinic acetylcholine receptors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11959 "The prototype substance is the parasympathomimetic alkaloid, nicotine [(S)-3-[1-methylpyrrolidin-2-yl]pyridine]."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11959 goldbook:11557)
AnnotationAssertion(rdfs:seeAlso goldbook:11959 goldbook:11625)
AnnotationAssertion(rdfs:seeAlso goldbook:11959 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11959 goldbook:11674)
