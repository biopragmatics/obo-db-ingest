AnnotationAssertion(dcterms:description goldbook:11939 "Tumor made up largely of nerve cells.")
AnnotationAssertion(mito:isMentionedBy goldbook:11939 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11939 "current"^^xsd:string)
Declaration(Class(goldbook:11940))
AnnotationAssertion(rdfs:label goldbook:11940 "neuronopathy")
AnnotationAssertion(dcterms:description goldbook:11940 "Disorder involving destruction of the cell bodies of neurons.")
AnnotationAssertion(mito:isMentionedBy goldbook:11940 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11940 "current"^^xsd:string)
Declaration(Class(goldbook:11941))
AnnotationAssertion(rdfs:label goldbook:11941 "neuron-specific enolase")
AnnotationAssertion(dcterms:description goldbook:11941 "Enzyme of glucose metabolism, normally found in nervous tissue, that catalyzes the dehydration of 2-phosphoglycerate.")
AnnotationAssertion(rdfs:comment goldbook:11941 "Elevated concentrations in the blood are associated with various disease, including neuroblastoma and non-neuronal tumors."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11941 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11941 "current"^^xsd:string)
Declaration(Class(goldbook:11942))
AnnotationAssertion(rdfs:label goldbook:11942 "neuropathological examination")
AnnotationAssertion(dcterms:description goldbook:11942 "Application of gross and histopathologic methods to study toxic changes in the morphology and histology of the nervous tissues and the brain.")
AnnotationAssertion(rdfs:comment goldbook:11942 "This can be a very detailed part of neurotoxicity evaluation that may reveal mechanisms of action."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11942 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11942 goldbook:11948)
AnnotationAssertion(mito:isMentionedBy goldbook:11942 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11942 "current"^^xsd:string)
Declaration(Class(goldbook:11943))
AnnotationAssertion(rdfs:label goldbook:11943 "neuropathy")
AnnotationAssertion(dcterms:description goldbook:11943 "Pathological change in the peripheral nervous system.")
AnnotationAssertion(rdfs:comment goldbook:11943 "It may occur as a localized lesion, or secondary to systemic toxicity (e.g., from alcohol consumption) or a generalized medical condition (e.g., diabetes)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11943 goldbook:12003)
AnnotationAssertion(mito:isMentionedBy goldbook:11943 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11943 "current"^^xsd:string)
Declaration(Class(goldbook:11944))
AnnotationAssertion(rdfs:label goldbook:11944 "neuropathy target esterase")
AnnotationAssertion(dcterms:description goldbook:11944 "Enzyme that is phosphorylated by organophosphate compounds and is believed to be involved in the delayed neuropathy of organophosphates.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11944 "NTE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11944 "neurotoxic esterase")
AnnotationAssertion(rdfs:seeAlso goldbook:11944 goldbook:11943)
AnnotationAssertion(rdfs:seeAlso goldbook:11944 goldbook:11979)
AnnotationAssertion(mito:isMentionedBy goldbook:11944 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11944 "current"^^xsd:string)
Declaration(Class(goldbook:11945))
AnnotationAssertion(rdfs:label goldbook:11945 "neuroprogenitor cell")
AnnotationAssertion(dcterms:description goldbook:11945 "Precursor cell that is capable of differentiating into specific cell types of the nervous system.")
AnnotationAssertion(rdfs:comment goldbook:11945 "The term typically refers to a cell that has further committed beyond an early neural stem cell, either by being located in a particular region of the nervous system or destined for a particular type of neuron."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11945 "The renewal potential of neuroprogenitor cells is typically reduced relative to neural stem cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11945 goldbook:11916)
AnnotationAssertion(rdfs:seeAlso goldbook:11945 goldbook:11920)
AnnotationAssertion(mito:isMentionedBy goldbook:11945 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11945 "current"^^xsd:string)
Declaration(Class(goldbook:11946))
AnnotationAssertion(rdfs:label goldbook:11946 "neuroprotective")
AnnotationAssertion(dcterms:description goldbook:11946 "Agent or property of an agent that protects neurons from damage and (or) from the process of aging or degeneration of the brain.")
AnnotationAssertion(rdfs:seeAlso goldbook:11946 goldbook:11647)
AnnotationAssertion(mito:isMentionedBy goldbook:11946 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11946 "current"^^xsd:string)
Declaration(Class(goldbook:11947))
AnnotationAssertion(rdfs:label goldbook:11947 "neuropsychological testing")
AnnotationAssertion(dcterms:description goldbook:11947 "Assessment, under standardized conditions, of an individual’s brain function as it impacts upon cognitive function, thought processes, behavior and personality.")
AnnotationAssertion(rdfs:comment goldbook:11947 "Such tests are designed to measure a psychological function known to be linked to a particular brain structure or pathway and often measure reaction times, motor performance or cognitive association."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11947 "An initial training period may be required so that each individual starts the testing at an optimized performance level, although most neuropsychological assessments compare an individual’s raw score to a normative sample score of the population."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11947 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11947 goldbook:11684)
AnnotationAssertion(rdfs:seeAlso goldbook:11947 goldbook:11883)
AnnotationAssertion(mito:isMentionedBy goldbook:11947 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11947 "current"^^xsd:string)
Declaration(Class(goldbook:11948))
AnnotationAssertion(rdfs:label goldbook:11948 "neurotoxic")
AnnotationAssertion(dcterms:description goldbook:11948 "Poisonous to structures and (or) functions of the brain and nerves.")
AnnotationAssertion(rdfs:seeAlso goldbook:11948 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11948 goldbook:11909)
AnnotationAssertion(mito:isMentionedBy goldbook:11948 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11948 "current"^^xsd:string)
Declaration(Class(goldbook:11949))
AnnotationAssertion(rdfs:label goldbook:11949 "neurotoxicant")
AnnotationAssertion(dcterms:description goldbook:11949 "Substance that can produce functional or structural damage to the nervous system.")
AnnotationAssertion(rdfs:seeAlso goldbook:11949 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11949 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11949 "current"^^xsd:string)
Declaration(Class(goldbook:11950))
AnnotationAssertion(rdfs:label goldbook:11950 "neurotoxicology")
AnnotationAssertion(dcterms:description goldbook:11950 "Discipline applying principles of both neuroscience and toxicology to study the ability of certain substances to alter nervous system structure or function.")
AnnotationAssertion(rdfs:seeAlso goldbook:11950 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11950 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11950 "current"^^xsd:string)
Declaration(Class(goldbook:11951))
AnnotationAssertion(rdfs:label goldbook:11951 "neurotoxic shellfish poisoning")
AnnotationAssertion(dcterms:description goldbook:11951 "Toxic shellfish poisoning characterized by nausea, vomiting, and mild neurological symptoms such as dysarthria, paresthesia, ataxia, and vertigo caused by ingestion of shellfish (specifically, bivalve molluscs) contaminated with the polyether brevetoxin and its derivatives produced by the dinoflagellate Karenia brevis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11951 "NSP")
AnnotationAssertion(rdfs:seeAlso goldbook:11951 goldbook:12072)
AnnotationAssertion(rdfs:seeAlso goldbook:11951 goldbook:11619)
