[Term]
id: goldbook:15220
name: paste
def: "Ointment containing \\\(\\gt \\pu\{0\\%\}\\\) of powder\, dispersed in a fatty base."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-04-10-14
property_value: hasStatus "current" xsd:string
consider: goldbook:15172
consider: goldbook:15217
