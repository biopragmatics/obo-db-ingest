AnnotationAssertion(rdfs:label goldbook:H02836 "holoenzyme")
AnnotationAssertion(dcterms:description goldbook:H02836 "An active enzyme consisting of the apoenzyme and coenzyme.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02836 goldbook:A00417)
AnnotationAssertion(rdfs:seeAlso goldbook:H02836 goldbook:C01126)
AnnotationAssertion(rdfs:seeAlso goldbook:H02836 goldbook:E02159)
