Declaration(Class(goldbook:IT07399))
AnnotationAssertion(rdfs:label goldbook:IT07399 "infrared")
AnnotationAssertion(dcterms:description goldbook:IT07399 "Region of the electromagnetic spectrum extending from \\(780\\ \\rm{nm}\\) to about \\(20\\,000\\ \\rm{nm}\\).According to the CIE, the range between \\(780\\ \\rm{nm}\\) and \\(1\\ \\rm{mm}\\) is subdivided into:IR-A \\(780\\)–\\(1400\\ \\rm{nm}\\)IR-B \\(1.4\\)–\\(3\\ \\unicode[times]{x3BC}\\rm{m}\\)IR-C \\(3\\ \\unicode[times]{x3BC}\\rm{m}\\)–\\(1\\ \\rm{mm}\\)")
AnnotationAssertion(rdfs:comment goldbook:IT07399 "This is the wavelength region in which absorption by a molecular entity causes excitation of its vibrational, rotational, and bending modes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07399 goldbook:A00036)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07399 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07399 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07399 "current"^^xsd:string)
Declaration(Class(goldbook:IT07400))
AnnotationAssertion(rdfs:label goldbook:IT07400 "intersection space")
AnnotationAssertion(dcterms:description goldbook:IT07400 "(3N − 8)-dimensional subspace of the (3N − 6)-dimensional nuclear coordinate space consisting of an infinite number of conical intersection points (N is the number of nuclei).")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07400 goldbook:CT07347)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07400 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07400 "current"^^xsd:string)
Declaration(Class(goldbook:IT07401))
AnnotationAssertion(rdfs:label goldbook:IT07401 "intramolecular charge transfer")
AnnotationAssertion(dcterms:description goldbook:IT07401 "Process that changes the overall charge distribution in a molecule.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:IT07401 "ICT")
AnnotationAssertion(rdfs:comment goldbook:IT07401 "For intramolecular charge transfer in the excited state, several models are discussed in the literature based on the molecular structure of the final state reached upon photo-induced ICT: planar intramolecular charge transfer (PICT) or twisted intramolecular charge transfer (TICT). For example, an ICT has been proposed to be responsible for the strongly Stokes-shifted additional fluorescence band in fluorescent molecules with two fluorescence bands (dual fluorescent molecules)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07401 goldbook:S06031)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07401 goldbook:DT07365)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07401 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07401 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07401 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07401 goldbook:PT07418)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07401 goldbook:T06537)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07401 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07401 "current"^^xsd:string)
