AnnotationAssertion(mito:isMentionedBy goldbook:13801 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13801 "current"^^xsd:string)
Declaration(Class(goldbook:13802))
AnnotationAssertion(rdfs:label goldbook:13802 "coil-to-globule transition")
AnnotationAssertion(dcterms:description goldbook:13802 "Change in conformation of a macromolecular chain in solution from that of a coil to a relatively compact structure in which the chain has collapsed upon itself in response to an external stimulus.")
AnnotationAssertion(rdfs:comment goldbook:13802 "A coil-to-globule transition is the reverse of a globule-to-coil transition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13802 "Typical external stimuli may be temperature, \\(\\pu{pH}\\), electrolyte concentration, or solvent composition."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13802 goldbook:13825)
AnnotationAssertion(mito:isMentionedBy goldbook:13802 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13802 "current"^^xsd:string)
Declaration(Class(goldbook:13803))
AnnotationAssertion(rdfs:label goldbook:13803 "colloidal crystal")
AnnotationAssertion(dcterms:description goldbook:13803 "Two- or three-dimensional ordered array of molecules or nanoparticles having a dimension roughly between \\(\\pu{1 nm}\\) and \\(\\pu{1 \\upmu m}\\) in at least one direction.")
AnnotationAssertion(mito:isMentionedBy goldbook:13803 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13803 "current"^^xsd:string)
Declaration(Class(goldbook:13804))
AnnotationAssertion(rdfs:label goldbook:13804 "columnar phase")
AnnotationAssertion(dcterms:description goldbook:13804 "Cylindrical assembly of molecules within a distinct series of layers in which the axes of the molecules lie in the planes of the layers and are identically aligned and oriented in adjacent layers.")
AnnotationAssertion(rdfs:comment goldbook:13804 "A columnar assembly of discotic molecules, called a columnar mesophase, a columnar discotic mesophase, or a columnar discotic, is one of the class of liquid crystal mesophases."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13804 goldbook:13811)
AnnotationAssertion(mito:isMentionedBy goldbook:13804 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13804 "current"^^xsd:string)
Declaration(Class(goldbook:13805))
AnnotationAssertion(rdfs:label goldbook:13805 "core-crosslinked micelle")
AnnotationAssertion(dcterms:description goldbook:13805 "Core-shell structure formed by self-assembly of amphiphiles and subsequently covalently crosslinked through functionalities in the core.")
AnnotationAssertion(rdfs:comment goldbook:13805 "The amphiphiles are often amphiphilic block copolymers"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13805 "Such structures are used, for example, for drug delivery and dye or adulterant encapsulation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13805 goldbook:13806)
AnnotationAssertion(rdfs:seeAlso goldbook:13805 goldbook:13795)
AnnotationAssertion(rdfs:seeAlso goldbook:13805 goldbook:13857)
AnnotationAssertion(mito:isMentionedBy goldbook:13805 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13805 "current"^^xsd:string)
