AnnotationAssertion(dcterms:description goldbook:11920 "Multipotent cell, with mitotic potential, that may serve as a precursor for neuroprogenitor cells.")
AnnotationAssertion(rdfs:comment goldbook:11920 "Adult neural stem cell refers to a cell localized in specific niches of the adult central nervous system, capable of generating new neurons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11920 goldbook:11945)
AnnotationAssertion(mito:isMentionedBy goldbook:11920 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11920 "current"^^xsd:string)
