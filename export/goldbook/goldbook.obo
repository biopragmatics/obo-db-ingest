[Term]
id: goldbook:I03180
name: ionic strength
def: "On a molality basis\, \\\[I_\{m\} = \\frac\{1\}\{2\}\\ \\sum m_\{\\rm\{B\}\}\\ z_\{\\rm\{B\}\}^\{2\}\\\] where the sum goes over all the ions B. \\\(z_\{\\rm\{B\}\}\\\) is the charge number of ion B. The ionic strength on a concentration basis is defined analogously \\\[I_\{c\} = \\frac\{1\}\{2\}\\ \\sum c_\{\\rm\{B\}\}\\ z_\{\\rm\{B\}\}^\{2\}\\\]"
property_value: mito:isMentionedBy doi:10.1351/pac199668040957
property_value: hasStatus "current" xsd:string
consider: goldbook:C00993

[Term]
id: goldbook:I03181
name: ionic transport number
def: "Quotient of the current carried by an ionic component and the total current."
