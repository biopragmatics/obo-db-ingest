AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01286 "current"^^xsd:string)
Declaration(Class(goldbook:C01287))
AnnotationAssertion(rdfs:label goldbook:C01287 "constitutional sequence")
AnnotationAssertion(dcterms:description goldbook:C01287 "The whole or part of a chain comprising one or more species of constitutional unit(s) in defined sequence.")
AnnotationAssertion(rdfs:comment goldbook:C01287 "Constitutional sequences comprising two constitutional units are termed diads, those comprising three constitutional units triads, and so on. In order of increasing sequence lengths they are called tetrads, pentads, hexads, heptads, octads, nonads, decads, undecads, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01287 goldbook:C00946)
AnnotationAssertion(rdfs:seeAlso goldbook:C01287 goldbook:C01288)
AnnotationAssertion(rdfs:seeAlso goldbook:C01287 goldbook:ST06775)
AnnotationAssertion(mito:isMentionedBy goldbook:C01287 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01287 "current"^^xsd:string)
Declaration(Class(goldbook:C01288))
AnnotationAssertion(rdfs:label goldbook:C01288 "constitutional unit")
AnnotationAssertion(dcterms:description goldbook:C01288 "An atom or group of atoms (with pendant atoms or groups, if any) comprising a part of the essential structure of a macromolecule, an oligomer molecule, a block or a chain.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01288 goldbook:B00682)
AnnotationAssertion(rdfs:seeAlso goldbook:C01288 goldbook:C00946)
