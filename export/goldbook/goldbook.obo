property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09465
name: defect-free pattern
def: "Imaged resist without imperfections in pattern."
comment: "In a DSA resist, for example, no error is introduced by the self-assembly process."
comment: "In a photoresist, for example, no error is introduced by the photochemistry."
property_value: mito:isMentionedBy doi:10.1515/pac-2018-1215
property_value: hasStatus "current" xsd:string
consider: goldbook:09564

[Term]
id: goldbook:09466
name: deprotection
def: "Removal of a protecting group which leads to a change in the solubility of a polymeric resist."
comment: "Deprotection is a common feature in the performance of most chemical amplification resists."
property_value: mito:isMentionedBy doi:10.1515/pac-2018-1215
property_value: hasStatus "current" xsd:string
consider: goldbook:09564

[Term]
id: goldbook:09467
name: depth of focus
def: "Tolerance of the placement of the image plane in relation to image quality."
comment: "Term used in an exposed and developed photoresist."
