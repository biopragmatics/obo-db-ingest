AnnotationAssertion(rdfs:label goldbook:13101 "double-negative cell")
AnnotationAssertion(dcterms:description goldbook:13101 "Immature T cell in the thymus that lacks expression of the two coreceptors, CD4 and CD8.")
AnnotationAssertion(rdfs:comment goldbook:13101 "In a normal thymus, double-negative cells represent about 5 % of thymocytes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13101 goldbook:12973)
AnnotationAssertion(rdfs:seeAlso goldbook:13101 goldbook:12976)
AnnotationAssertion(rdfs:seeAlso goldbook:13101 goldbook:13254)
