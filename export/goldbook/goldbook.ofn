AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00572 "current"^^xsd:string)
Declaration(Class(goldbook:B00573))
AnnotationAssertion(rdfs:label goldbook:B00573 "β-particle")
AnnotationAssertion(dcterms:description goldbook:B00573 "Electron ejected from a radioactive nucleus.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00573 goldbook:N04256)
AnnotationAssertion(rdfs:seeAlso goldbook:B00573 goldbook:R05077)
AnnotationAssertion(mito:isMentionedBy goldbook:B00573 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00573 "current"^^xsd:string)
Declaration(Class(goldbook:B00575))
AnnotationAssertion(rdfs:label goldbook:B00575 "back electron transfer")
AnnotationAssertion(dcterms:description goldbook:B00575 "A term often used to indicate thermal reversal of excited state electron transfer restoring the donor and acceptor in their original oxidation level. In using this term one should also specify the resulting electronic state of the donor and acceptor.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00575 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:B00575 goldbook:ET07026)
AnnotationAssertion(rdfs:seeAlso goldbook:B00575 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:B00575 goldbook:O04362)
AnnotationAssertion(mito:isMentionedBy goldbook:B00575 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00575 "current"^^xsd:string)
Declaration(Class(goldbook:B00576))
AnnotationAssertion(rdfs:label goldbook:B00576 "back extraction")
AnnotationAssertion(dcterms:description goldbook:B00576 "Synonymous with stripping (by extraction).")
AnnotationAssertion(rdfs:seeAlso goldbook:B00576 goldbook:E02301)
AnnotationAssertion(rdfs:seeAlso goldbook:B00576 goldbook:S06054)
AnnotationAssertion(mito:isMentionedBy goldbook:B00576 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00576 "current"^^xsd:string)
Declaration(Class(goldbook:B00577))
AnnotationAssertion(rdfs:label goldbook:B00577 "background")
AnnotationAssertion(dcterms:description goldbook:B00577 "The term employed to designate the value indicated by a radiation measuring device in the absence of the source whose radiation is to be measured, when the device is placed under its normal conditions of operation.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00577 goldbook:R05048)
AnnotationAssertion(mito:isMentionedBy goldbook:B00577 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00577 "current"^^xsd:string)
Declaration(Class(goldbook:B00578))
AnnotationAssertion(rdfs:label goldbook:B00578 "background concentration")
AnnotationAssertion(dcterms:description goldbook:B00578 "The concentration of a given species in a pristine air mass in which anthropogenic impurities of a relatively short lifetime are not present. The background concentrations of relatively long-lived molecules, methane, carbon dioxide, halocarbons ($\\ce{CF3Cl}$, $\\ce{CF2Cl2}$, etc.) and some other species continue to rise due to anthropogenic input, so the composition of background air is undergoing continual change. Background concentration of a given species is sometimes considered to be the concentration of that impurity in a given air mass when the contribution from anthropogenic sources under study is absent. Synonymous with baseline concentration.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:B00578 "baseline concentration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:B00578 "background level")
AnnotationAssertion(rdfs:seeAlso goldbook:B00578 goldbook:L03515)
AnnotationAssertion(mito:isMentionedBy goldbook:B00578 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00578 "current"^^xsd:string)
Declaration(Class(goldbook:B00580))
AnnotationAssertion(rdfs:label goldbook:B00580 "background radiation")
AnnotationAssertion(dcterms:description goldbook:B00580 "Radiation from any source other than the one it is desired to detect or measure.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00580 goldbook:R05048)
AnnotationAssertion(mito:isMentionedBy goldbook:B00580 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00580 "current"^^xsd:string)
Declaration(Class(goldbook:B00581))
AnnotationAssertion(rdfs:label goldbook:B00581 "backscatter")
AnnotationAssertion(dcterms:description goldbook:B00581 "Scattering of radiation in a generally backward direction. In the assay of radioactivity, it applies to the scattering of radiation into the radiation detector from any material except the sample and the detector. In light scattering, it is said to occur when the scattering angle, \\(\\theta \\), is \\(180^{\\unicode{x26ac}}\\). Conversely, forward scattering occurs when \\(\\theta \\) is \\(0^{\\unicode{x26ac}}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:B00581 goldbook:A00470)
AnnotationAssertion(rdfs:seeAlso goldbook:B00581 goldbook:L03525)
AnnotationAssertion(rdfs:seeAlso goldbook:B00581 goldbook:R05054)
AnnotationAssertion(rdfs:seeAlso goldbook:B00581 goldbook:R05092)
AnnotationAssertion(rdfs:seeAlso goldbook:B00581 goldbook:S05487)
AnnotationAssertion(rdfs:seeAlso goldbook:B00581 goldbook:S05488)
AnnotationAssertion(mito:isMentionedBy goldbook:B00581 doi:10.1351/pac198355060931)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00581 "current"^^xsd:string)
Declaration(Class(goldbook:B00582))
AnnotationAssertion(rdfs:label goldbook:B00582 "back scatter coefficient")
AnnotationAssertion(dcterms:description goldbook:B00582 "Number of back scattered electrons (BSEs) generated per primary electron for a given specimen and experimental condition. It depends on (mean) atomic number of the excited area of the sample, angle between electron beam and sample surface, primary electron energy and thickness of the sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:B00582 "BSEs")
AnnotationAssertion(rdfs:seeAlso goldbook:B00582 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:B00582 goldbook:A00499)
AnnotationAssertion(rdfs:seeAlso goldbook:B00582 goldbook:B00583)
AnnotationAssertion(rdfs:seeAlso goldbook:B00582 goldbook:P04829)
AnnotationAssertion(mito:isMentionedBy goldbook:B00582 doi:10.1351/pac198355122023)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00582 "current"^^xsd:string)
Declaration(Class(goldbook:B00583))
AnnotationAssertion(rdfs:label goldbook:B00583 "back scattered electrons")
AnnotationAssertion(dcterms:description goldbook:B00583 "All primary electrons which are scattered out of the original direction and retransmitted through the surface of the solid. In practice, electrons emitted from the surface of a solid under electron bombardment which have a kinetic energy in the range between \\(50\\ \\rm{eV}\\) and excitation energy (\\(E_{0}\\)).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:B00583 "BSEs")
AnnotationAssertion(rdfs:seeAlso goldbook:B00583 goldbook:E02251)
AnnotationAssertion(rdfs:seeAlso goldbook:B00583 goldbook:K03402)
AnnotationAssertion(rdfs:seeAlso goldbook:B00583 goldbook:P04829)
AnnotationAssertion(mito:isMentionedBy goldbook:B00583 doi:10.1351/pac198355122023)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00583 "current"^^xsd:string)
Declaration(Class(goldbook:B00587))
AnnotationAssertion(rdfs:label goldbook:B00587 "baffle chamber")
AnnotationAssertion(dcterms:description goldbook:B00587 "A chamber used in incinerator design to promote the settling of fly ash and coarse particulate matter by changing the direction and/or reducing the velocity of the gases produced by the combustion of the refuse.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00587 goldbook:I02997)
AnnotationAssertion(mito:isMentionedBy goldbook:B00587 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00587 "current"^^xsd:string)
Declaration(Class(goldbook:B00588))
AnnotationAssertion(rdfs:label goldbook:B00588 "bag filter")
AnnotationAssertion(dcterms:description goldbook:B00588 "A large bag constructed of a suitable fabric which is often tubular in shape, into which a particle-containing air stream flows. Modern bags are constructed of a fabric which is capable of collecting all but very fine particles in the gas stream. The efficiency of the removal of particles of various size ranges changes with the amount of particles captured by the filter and the filtering time. The bag operates on the same principle as the one on a household vacuum cleaner.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:B00588 "fabric filter")
AnnotationAssertion(rdfs:seeAlso goldbook:B00588 goldbook:F02384)
AnnotationAssertion(mito:isMentionedBy goldbook:B00588 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00588 "current"^^xsd:string)
Declaration(Class(goldbook:B00589))
AnnotationAssertion(rdfs:label goldbook:B00589 "baghouse")
AnnotationAssertion(dcterms:description goldbook:B00589 "An installation which contains many bag filters in parallel so that the resistance to air flow in a large installation is not seriously increased by the addition of these controls.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00589 goldbook:R05315)
AnnotationAssertion(mito:isMentionedBy goldbook:B00589 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00589 "current"^^xsd:string)
Declaration(Class(goldbook:B00590))
AnnotationAssertion(rdfs:label goldbook:B00590 "Bainite transition")
AnnotationAssertion(dcterms:description goldbook:B00590 "A term that is sometimes used in metallurgy for the martensitic transition that describes the transition between a face-centred-cubic lattice and a body-centred-tetragonal lattice. Example: The transition between the face-centred-cubic lattice of austenite and the body-centred-tetragonal lattice of a martensite.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00590 goldbook:M03708)
AnnotationAssertion(mito:isMentionedBy goldbook:B00590 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00590 "current"^^xsd:string)
Declaration(Class(goldbook:B00591))
AnnotationAssertion(rdfs:label goldbook:B00591 "baking")
AnnotationAssertion(dcterms:description goldbook:B00591 "The process in which the carbonaceous binder, usually coal tar pitch or petroleum pitch, as part of a shaped carbon mix is converted to carbon yielding a rigid carbon body by the slow application of heat. The process can take as little as \\(14\\ \\rm{days}\\) in coarse-grained, electrothermic grades (low binder level) and as long as \\(36\\ \\rm{days}\\) in ultra-fine-grained, specialty grades (high binder level). The final baking temperature can be in the range of \\(1100{-}1500\\ \\rm{K}\\), depending on the grade.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00591 goldbook:B00646)
AnnotationAssertion(rdfs:seeAlso goldbook:B00591 goldbook:C00821)
AnnotationAssertion(rdfs:seeAlso goldbook:B00591 goldbook:C00842)
AnnotationAssertion(rdfs:seeAlso goldbook:B00591 goldbook:C01121)
AnnotationAssertion(rdfs:seeAlso goldbook:B00591 goldbook:P04523)
AnnotationAssertion(mito:isMentionedBy goldbook:B00591 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00591 "current"^^xsd:string)
Declaration(Class(goldbook:B00592))
AnnotationAssertion(rdfs:label goldbook:B00592 "Baldwin's rules")
AnnotationAssertion(dcterms:description goldbook:B00592 "A set of empirical rules for certain formations of 3- to 7-membered rings. The predicted pathways are those in which the length and nature of the linking chain enables the terminal atoms to achieve the proper geometries for reaction. The disfavoured cases are subject to severe distortions of bond angles and bond distances.")
AnnotationAssertion(mito:isMentionedBy goldbook:B00592 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00592 "current"^^xsd:string)
Declaration(Class(goldbook:B00593))
AnnotationAssertion(rdfs:label goldbook:B00593 "bandgap energy")
AnnotationAssertion(dcterms:description goldbook:B00593 "The energy difference between the bottom of the conduction band and the top of the valence band in a semiconductor or an insulator.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00593 goldbook:F02341)
AnnotationAssertion(rdfs:seeAlso goldbook:B00593 goldbook:C01244)
AnnotationAssertion(rdfs:seeAlso goldbook:B00593 goldbook:S05591)
AnnotationAssertion(rdfs:seeAlso goldbook:B00593 goldbook:V06589)
AnnotationAssertion(mito:isMentionedBy goldbook:B00593 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00593 "current"^^xsd:string)
Declaration(Class(goldbook:B00594))
AnnotationAssertion(rdfs:label goldbook:B00594 "bandpass filter")
AnnotationAssertion(dcterms:description goldbook:B00594 "An optical device which permits the transmission of radiation within a specified wavelength range and does not permit transmission of radiation at higher or lower wavelengths. It can be an interference filter.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00594 goldbook:C01482)
AnnotationAssertion(rdfs:seeAlso goldbook:B00594 goldbook:I03090)
AnnotationAssertion(rdfs:seeAlso goldbook:B00594 goldbook:T06477)
AnnotationAssertion(rdfs:seeAlso goldbook:B00594 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:B00594 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00594 "current"^^xsd:string)
