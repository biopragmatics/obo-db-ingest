        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10513"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10513 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10513">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any one of the cells embedded in the lacunae of the cartilage matrix.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chondrocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10514 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10514">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secreted protein that dorsalizes early vertebrate embryonic tissues by binding to ventralizing transforming growth factor \(\upbeta\) (TGF-\(\upbeta\))-like bone morphogenetic proteins, sequestering them in latent complexes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chordin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10468"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10515 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10515">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Placenta developed from the allantois and chorion, establishing a nutritive and excretory connection between the blood of the fetus and that of the mother.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chorioallantoic placenta</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10356"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10516 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10516">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In human embryology, the cellular, outermost extra-embryonicmembrane, composed of trophoblast lined with mesoderm. Note: The chorion develops villi, becomes vascularized by allantoic vessels, and forms the fetal part of the placenta.  In mammalian embryology, the cellular, outer extra embryonic membrane, not necessarily developing villi. In biology, the noncellular membrane covering eggs of various animals, e.g., fish and insects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chorion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10649"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10517 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10517">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hormone secreted by the chorionic villi of the placenta in mammals, especially human chorionic gonadotropin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Chorionic gonadotropin promotes the secretion of progesterone by the corpus luteum.</rdfs:comment>
        <rdfs:comment>Human chorionic gonadotropin is the hormone that is detected by pregnancy tests.</rdfs:comment>
        <rdfs:label>chorionic gonadotropin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10519"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10518 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10518">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outermost membranous sac that encloses the embryo in higher vertebrates (reptiles, birds, and mammals), lined by chorion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chorionic sac</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10519 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10519">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of the tiny extensions from the chorion that contain fetal blood vessels and combine with the uterine tissue to form the placenta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chorionic villus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10520 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10520">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the choroid layer behind the retina of the eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chorioretinitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11179"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10521 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10521">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Infoldings of blood vessels of the pia mater, projecting into the cerebral ventricles, covered with ependymal cells, and secreting cerebrospinal fluid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>choroid plexus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10522 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10522">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell of the adrenal medulla that secretes epinephrine and norepinephrine, and contains granules that are readily stained with chromate salts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chromaffin cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10345"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11020"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10523 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10523">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a pair of chromosomes arising by duplication during mitosis or by pairing during meiosis, and joined together at the centromere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Sister chromatid refers to either one of the joined pair arising from the same chromosome by duplication, and non-sister chromatid refers to either of the joined homologous chromosomes of maternal or paternal origin arising during meiosis.</rdfs:comment>
        <rdfs:label>chromatid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10502"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10524 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10524">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormality in the number or structure of chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chromosomal abnormality</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10525 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10525">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of a chromosome or part of a chromosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chromosome deletion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10526 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10526">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal chromosome in which both ends have been lost and the two broken ends have reunited to form a ring-shaped structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chromosome ring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10525"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10527 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10527">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent causing chromosome breakage and (or) the consequent gain, loss, or rearrangement of pieces of chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>clastogen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10528 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10528">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First few divisions of a fertilized egg.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>There is little or no growth during these divisions and the cytoplasm is cleaved into smaller and smaller units with individual biochemistry that contributes to subsequent cell differentiation.</rdfs:comment>
        <rdfs:label>cleavage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10463"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10529"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10530"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10750"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10529 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10529">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Partial cleavage of the egg, occurring in some animals, such as reptiles and birds, whose eggs have a large amount of yolk, resulting in unequal blastomeres and only part of the egg progressing to further cell division; the yolk mass remains and has nutritive value.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>meroblastic cleavage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10463"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10528"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10530 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10530">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cleavage producing separate, equal blastomeres.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>holoblastic cleavage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10463"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10528"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10531 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10531">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gap in soft tissue, bone, or both.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>fissure</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cleft</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10532 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10532">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Split, divided, or partly divided into two.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cleft</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10533 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10533">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital malformation consisting of one or more clefts in the upper lip, the result of failed closure in the embryo of the maxillary and median nasal processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>cheiloschisis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hare lip</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cleft lip</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10534"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10920"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10994"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10534 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10534">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital fissure along the midline of the hard palate, that may extend into the soft palate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>palatoschisis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cleft palate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11062"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10535 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10535">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare congenital malformation resulting from defective fusion in the embryo of paired mesodermal bands in the ventral midline.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cleft sternum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10536 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10536">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Erectile body in the female genitalia, homologous with the penis in the male.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>clitoris</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10537 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10537">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Common cavity at the end of the digestive tract in vertebrates (apart from most mammals) into which are released both excretory and genital products.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cloaca</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10754"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10538 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10538">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane that covers the embryonic cloaca during the development of urinary and reproductive organs in those vertebrates where the cloaca occurs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cloacal membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10537"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10539 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10539">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition caused by the continued ingestion of low but toxic levels of estrogens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>estrogenism</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Dogs are particularly susceptible to the myelotoxic effects of estrogens and high dose or prolonged administration causes severe bone marrow depression with thrombocytopenia, followed by leukopenia and anemia.</rdfs:comment>
        <rdfs:comment>The most important occurrence is in farm animals pastured on plants containing phytoestrogens. The signs are those related to endometrial hyperplasia and vaginal tumefaction (swelling and puffiness), including long-term infertility and rectalprolapse, especially in pigs; uterine prolapse, especially in ewes; and feminization of males that have undergone castration.</rdfs:comment>
        <rdfs:label>clover disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10388"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10495"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10850"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10889"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10987"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11090"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11140"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11168"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10540 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10540">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deformed foot that is twisted out of shape or position, usually congenital (congenital talipes equinovarus (CTEV)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>talipes</oboInOwl:hasRelatedSynonym>
        <rdfs:label>clubfoot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10541 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10541">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrowing or constriction of a short section of a blood vessel, commonly of the aorta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>coarctation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10542 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10542">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spiral cavity of the inner ear containing the organ of Corti that transduces sound into nerve impulses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cochlea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11047"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10543 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10543">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Body cavity, found in many animals, lined with mesodermal epithelium and containing the digestive tract and other visceral organs</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The principal cavities of the trunk arise from the intraembryonic coelom.</rdfs:comment>
        <rdfs:label>coelom</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10544 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10544">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rich in the fibrous connective tissue protein, collagen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>collagenous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10545 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10545">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which collembolans (small soil-inhabiting insects) are exposed to soil that has been treated with a test substance, and adult mortality and reproductive output are studied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>collembolan reproduction test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10546 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10546">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any defect resulting from incomplete closure of the retinal fissure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The defect may be congenital, pathological, or artificial.</rdfs:comment>
        <rdfs:label>coloboma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11179"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10547 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10547">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure to evaluate both general systemic toxicity, with an emphasis on neurological endpoints, and notably reproductive effects and developmental progression in rodents. Groups of males and females are administered a test substance in graded doses prior to mating, during the mating period, and subsequently (up to two weeks post-mating in males and four days post-delivery in females).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>combined repeated dose toxicity study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10548 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10548">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complication of labor in twin births in which there is attempted simultaneous expulsion of both twins, so that the lower part of the mother’s pelvis is filled and further descent through the birth canal is prevented. In embryology, process during which blastomeres change their shape and align themselves tightly against each other to form the compact morula.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>compaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10463"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10649"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10880"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10975"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10549 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10549">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that explains transposition of the great arteries of the heart by failure of the aortopulmonary septum to follow a spiral course during partitioning of the bulbus cordis and truncus arteriosus in the process of forming the aorta and pulmonary trunk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>conal growth hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10419"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10480"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11156"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11315"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11328"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10550 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10550">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of a viable zygote by the union of a spermatozoon and an ovum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>conception</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10551 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10551">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryo and associated membranes in the uterus, especially during the early stages of pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>conceptus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10552 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10552">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Present from birth, as of a disease or physical abnormality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>congenital</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10553 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10553">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of disorders caused by hyperplasia of the adrenal cortex or by malignant tumors, resulting in excess secretion of adrenocortical androgenic hormones, and characterized by masculinization of women, feminization of men, or precocious puberty in the male.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>adrenogenital syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The condition is associated with a decrease in the blood level of cortisol and an increase in the level of androgens in both sexes, most commonly as a result of 21-hydroxylase deficiency.</rdfs:comment>
        <rdfs:label>congenital adrenal hyperplasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10385"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10826"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10915"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11152"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11260"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10554 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10554">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malformation existing at birth, or developing during the first month of life, regardless of the cause.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>congenital malformation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10555 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10555">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a pair of identical twins fused together with varying degrees of union and of residual duplication of organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Siamese twin</oboInOwl:hasRelatedSynonym>
        <rdfs:label>conjoined twin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11069"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10556 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10556">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extracellular matrix of fibrous proteins and glycoproteins, with associated cells such as fibroblasts, that fills the spaces between and within organs and tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Connective tissue provides the organs and tissues with structural and metabolic support.</rdfs:comment>
        <rdfs:comment>Specialized connective tissues also include bone, cartilage, blood components, and adipose tissue.</rdfs:comment>
        <rdfs:label>connective tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10699"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10719"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10557 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10557">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anything that prevents, or reduces the likelihood of pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>contraceptive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10558 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10558">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sudden, violent, irregular movement of the body caused by involuntary contraction of muscles and associated with brain disorders, such as epilepsy, fever in children, or with drug or alcohol abuse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>convulsion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10670"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10559 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10559">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Either of the two columns of erectile tissue forming the body of the clitoris (corpus cavernosum clitoridis) or penis (corpus cavernosum penis).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>corpus cavernosum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10560 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10560">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glandular mass of yellowish tissue in the ovary, formed by a Graafian ovarian follicle that has matured and released its oocyte.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Observed in animal reproductive testing to calculate preimplantation loss.</rdfs:comment>
        <rdfs:label>corpus luteum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10778"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10561 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10561">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer layer of an organ such as the kidney, the cerebellum, or the adrenal gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cortex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10562 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10562">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer layer of the cerebrum, composed of folded grey matter, playing an important role in consciousness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cerebral cortex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10563 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10563">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thickenings in the surface ectoderm of the embryo associated with future eye and ear regions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cranial placodes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10564 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10564">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Line where the bony plates of the skull are joined together by fibrous bands of tissue, easily felt in the newborn before closure by ossification.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cranial suture</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10734"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10565 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10565">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the cranium and the face.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>craniofacial</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10569"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10566 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10566">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neural tube defect in which both the cranium and vertebral column remain open.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>craniorachischisis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10569"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11004"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10567 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10567">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Developmental failure of the cranial sutures to close completely, especially at the occiput, usually leading to grossly defective development of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cranioschisis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10564"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11027"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10568 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10568">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Premature closure of the cranial sutures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>craniosynostosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10564"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10569 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10569">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bony structure surrounding the brain, excluding the bones of the face.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cranium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10570 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10570">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bacterial system in which the Cre protein mediates DNA recombination between specific DNA sequences known as lox-P sites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This system is used in mammalian cells to delete (or invert) a stretch of DNA by flanking it with lox-P sites and then exposing the cell to Cre protein at some predetermined time.</rdfs:comment>
        <rdfs:label>Cre/loxP</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10571 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10571">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Developmental disorder caused by deficiency of thyroid hormone, characterized by severe mental retardation and stunted physical growth, sometimes resulting from maternal iodine deficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cretinism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11305"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10572 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10572">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hereditary congenital syndrome due to deletion of the short arm of chromosome 5.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>5p - syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lejeune syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This syndrome is characterized by hypertelorism, microcephaly, severe mental deficiency, and a plaintive cat-like cry.</rdfs:comment>
        <rdfs:label>cri du chat syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10827"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11277"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10573 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10573">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the inward projections or folds of the inner membrane of a mitochondrion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>crista</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10574 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10574">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific time in the development of a biological system when it is particularly vulnerable to injury or misdirection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>critical period</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10575 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10575">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of autosomal dominant genetic diseases characterized by midfacial hypoplasia, craniosynostosis, exophthalmos, and a shortened head.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>branchial arch syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This affects the first branchial arch (pharyngeal arch), which is the precursor of the maxilla and mandible.</rdfs:comment>
        <rdfs:comment>This syndrome is thought to be caused by a genetic mutation of the FGFR3 gene, located on chromosome 10.</rdfs:comment>
        <rdfs:label>Crouzon syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10472"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10568"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10695"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10831"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10576 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10576">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small tubular gland, pit, or depression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>crypt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10577 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10577">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of the eyelids to develop with a fissure between them, usually with defective formation of the eyeballs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cryptophthalmos</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10578 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10578">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of follicular cells surrounding the oocyte in the Graafian follicle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cumulus oophorus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10729"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10778"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10579 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10579">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bluish discoloration of the skin and mucous membranes due to excessive concentration of deoxygenated haemoglobin, owing to poor circulation or inadequate oxygenation of the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cyanosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10978"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10580 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10580">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cycle of physiological changes in the female reproductive organs, from the time of fertilization of the oocyte through gestation and parturition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>reproductive cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10764"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11075"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10581 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10581">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare form of holoprosencephaly, a congenital disorder characterized by a single orbital fossa due to the failure of the embryonic prosencephalon to divide the orbits of the eye correctly into two cavities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>cyclocephaly</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>synophthalmia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cyclopia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10739"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10803"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11046"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11144"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10582 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10582">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In an animal or plant, thin-walled hollow organ or cavity containing a liquid secretion. Sac, vesicle, or bladder.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cyst</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11368"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10583 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10583">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Branch of genetics in which the structure and function of chromosomes and of other cell constituents concerned with heritable properties and their expression are studied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cytogenetics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10584 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10584">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of Herpes virus that usually produces very mild symptoms in an infected person but may cause severe neurological damage in people with weakened immune systems and in the newborn.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cytomegalovirus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10798"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10585 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10585">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inner cellular layer of the trophectoderm (trophoblast); part of the mammalian placenta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>cytotrophoblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11326"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10586 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10586">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which young female Daphnia are exposed to a substance added to the water and numbers of living offspring and surviving parent organisms are recorded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Daphnia magna reproduction test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10587 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10587">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Modified endometrial layer that lines the uterus during pregnancy and is shed with the afterbirth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>decidua</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10588 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10588">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enlarged, ovoid, connective tissue cell appearing in the endometrium during pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>decidual cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10589 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10589">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological test method in which pseudopregnant rats undergo a surgical treatment of the uterus to induce uterine differentiation and proliferation, resulting in massive tissue growth that mimics the response of the uterus during normal blastocyst implantation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Measurement of decidual growth during chemical treatment can be used to assess both hormonal status and uterine function. Uterine weight is a sensitive measure of the success of the decidual cell response.</rdfs:comment>
        <rdfs:label>decidual cell response technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10587"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10588"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11150"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10590 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10590">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Changes in response to progesterone that include the eosinophilic proliferation around arterioles after ovulation or progesterone action on endometrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Decidualization increases glandularepithelial secretion, stimulates glycogen accumulation in stromal cell cytoplasm, and promotes stromal vascularity (spiral arterioles) and edema.</rdfs:comment>
        <rdfs:label>decidualization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10638"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11136"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11251"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11264"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10591 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10591">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Swelling of a uterine crypt produced by its reaction to an implanted embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>deciduum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11346"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10592 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10592">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to two or more things that cross or intersect each other to form an X.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>decussate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10593 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10593">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gonadotropin secretion without female sex hormones.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>defeminized gonadotropin secretion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10776"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10594 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10594">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing a male animal from which the testicles have been removed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>castrated</oboInOwl:hasRelatedSynonym>
        <rdfs:label>demasculinized</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10595 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10595">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Layer of the skin deep under the epidermis, consisting of a bed of vascularized connective tissue and containing the nerves and organs of sensation, the hair roots, and sebaceous and sweat glands.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dermis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10667"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10596 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10596">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of synapsis due to separation of homologous chromosomes after initial pairing in meiosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>desynapsis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10597 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10597">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of biological development from fertilization to adulthood, usually with an emphasis on the prenatal period and regulation of morphogenesis, and neural development on through adolescence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Common model organisms include Caenorhabditis elegans, Xenopus, Drosophila, zebrafish (Danio rerio), chick, and mouse.</rdfs:comment>
        <rdfs:label>developmental biology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10348"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11119"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10598 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10598">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which female rodents are exposed to a test substance from the time of implantation through all of lactation; offspring may be exposed during the preweaning period, either directly or through milk, and are studied with regard to neurologic and behavioral abnormalities during postnatal development and until adulthood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>developmental neurotoxicity study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10348"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10881"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11111"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10599 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10599">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any gene that encodes a gene product that can be altered by environmental agents to cause disturbance of normal development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>developmental susceptibility gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10751"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10600 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10600">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of adverse effects on the developing organism that result from exposure of either parent to an agent or substance prior to conception, of the mother and fetus during prenatal development, and of the child from birth until the time development is completed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Functional brain development continues past the time of sexual maturation.</rdfs:comment>
        <rdfs:label>developmental toxicology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11119"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11215"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10601 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10601">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital defect in which the apex of the heart is directed toward the right side of the thorax (isolated dextrocardia), or the heart is found in a mirror image position on the right side of the body (dextrocardia situs inversus).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dextrocardia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11224"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10602 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10602">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Displacement to the right.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dextroposition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10603 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10603">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition caused by the deletion of a small piece of chromosome 22 near the middle of the chromosome at a location designated 22q11.2.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>DGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DiGeorge anomaly</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shprintzen syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Strong syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>congenital thymic aplasia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>conotruncal anomaly face syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thymic hypoplasia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>velocardiofacial syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Characteristic signs and symptoms may include birth defects such as congenital heart disease; defects in the palate, most commonly related to neuromuscular problems with closure (velopharyngeal insufficiency); learning disabilities; mild deviations in facial features; and recurrent infections.</rdfs:comment>
        <rdfs:label>DiGeorge syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11062"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11361"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10603"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DGS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10604 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10604">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dome-shaped muscular membranous partition separating the thoracic cavity from the abdominal cavity in mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The diaphragm plays a major role in breathing, as its contraction increases the volume of the thorax and so inflates the lungs.</rdfs:comment>
        <rdfs:label>diaphragm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10318"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10605 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10605">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hereditary predisposition to a particular medical condition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>diathesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10606 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10606">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Posterior part of the forebrain (prosencephalon), containing the hypothalamus and other thalamic components and enclosing the third ventricle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>diencephalon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11144"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11283"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11298"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10607 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10607">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Synthetic nonsteroidal substance with estrogenic activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>4,4′-[(3&lt;em&gt;E&lt;/em&gt;)-hex-3-ene-3,4-diyl]diphenol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DES</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>DES also has effects on the reproductive organs of male progeny exposed in utero.</rdfs:comment>
        <rdfs:comment>DES was formerly given to reduce the risk of complications and loss of pregnancy but was shown to cause a rare vaginal tumor in female offspring who had been exposed to this drug in utero.</rdfs:comment>
        <rdfs:label>diethylstilbestrol</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10683"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10862"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10607"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10608 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10608">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell or nucleus containing two complete sets of chromosomes, one from each parent, or an organism composed of such cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>diploid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10609 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10609">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bilayer plate of cells in the blastocyst from which the mammalian embryo develops.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>blastodisc</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>germinal disc</oboInOwl:hasRelatedSynonym>
        <rdfs:label>embryonic disc</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10610 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10610">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Entrance of two spermatozoa into one egg.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dispermy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10611 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10611">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disturbance that interrupts a process or disorganizes a structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>disruption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10612 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10612">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Situated away from the centre of the body or from the point of attachment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>distal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11148"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10613 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10613">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outpouching of a hollow structure in the body, that may be acquired (as in colonic diverticulitis) or be present at birth (e.g., Meckel diverticulum or Zenker diverticulum).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>diverticulum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10921"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10614 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10614">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of a gene, determining the phenotype even when present only in one copy or inherited from only one parent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dominant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11164"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10615 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10615">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>On or relating to the upper side or back of an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dorsal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10616 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10616">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any enzyme that metabolizes xenobiotics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>DME</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most if not all these enzymes also metabolize endogenous substrates.</rdfs:comment>
        <rdfs:label>drug metabolizing enzyme</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DME</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10617 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10617">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vessel for transporting fluids such as lymph, or glandular secretions such as tears or bile.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>duct</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10618 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10618">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fetal blood vessel connecting the pulmonary artery to the proximal descending aorta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This vessel allows most of the blood from the right ventricle to bypass the fetus’s fluid-filled non-functioning lungs. Upon closure at birth, it becomes the ligamentum arteriosum.</rdfs:comment>
        <rdfs:label>ductus arteriosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10892"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11076"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11148"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11157"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10619 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10619">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure using dung flies of the order Diptera where a test substance is mixed with bovine feces to which eggs of the fly are added; number, sex, and morphology are determined when the last adult has emerged.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Dipterian dung fly test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dung fly test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10620 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10620">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First portion of the small intestine, between the stomach and the jejunum, where bile and pancreatic digestive juices enter the intestinal tract.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>duodenum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10869"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10621 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10621">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defective or abnormal development of an organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dysgenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10622 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10622">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dysgenesis of the gonads.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dysgonesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10621"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10623 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10623">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficult and painful menstruation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dysmenorrhea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10937"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10624 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10624">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormality of shape of a body part or organ, often referring to a birth defect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>dysmorphism</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dysmorphia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10625 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10625">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production of dysmorphia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dysmorphogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10624"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10626 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10626">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal development of an organ or tissue identified by morphological examination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dysplasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10974"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10627 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10627">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defect in the normal ossification of fetal cartilage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>dysostosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10628 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10628">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxicity test using an organism in an early life stage such as the embryo or larva, noting that this stage is often the most sensitive part of the species life cycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ELS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ELS test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>early life stage test</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10628"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ELS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10629 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10629">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which adult worms (Eisenia sp.) are exposed to a test substance mixed into the soil; number, weight and behaviour of the adult worms are studied after four weeks and the number of juveniles hatched is counted after a further four weeks.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>earthworm reproduction test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10630 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10630">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute, life-threatening complication of pregnancy characterized by tonic-clonic seizures (convulsions), usually in a woman who has developed pre-eclampsia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>eclampsia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10558"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11114"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11199"/>
    </owl:Class>
    


