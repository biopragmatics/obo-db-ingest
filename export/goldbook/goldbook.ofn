Declaration(Class(goldbook:10701))
AnnotationAssertion(rdfs:label goldbook:10701 "extraembryonic mesoderm")
AnnotationAssertion(dcterms:description goldbook:10701 "Cells outside the embryo that, although derived from the zygote, are not part of the embryo proper and contribute to the fetal membranes (yolk sac, allantois, amnion, and chorion).")
Declaration(Class(goldbook:10702))
AnnotationAssertion(rdfs:label goldbook:10702 "extrinsic pathway")
