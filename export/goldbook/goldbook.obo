name: hyperglycemia
def: "Excessive concentration of glucose in the blood."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15793
name: hyperkalemia
def: "Excessive concentration of potassium in the blood."
