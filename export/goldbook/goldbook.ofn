Declaration(Class(goldbook:09710))
AnnotationAssertion(rdfs:label goldbook:09710 "nucleobase")
AnnotationAssertion(dcterms:description goldbook:09710 "Purine or pyrimidine nitrogenous base occurring in deoxyribonucleic acid (DNA) or ribonucleic acid (RNA).")
Declaration(Class(goldbook:09711))
AnnotationAssertion(rdfs:label goldbook:09711 "nucleobase lesion")
AnnotationAssertion(dcterms:description goldbook:09711 "Product of chemical modification of a nucleobase.")
Declaration(Class(goldbook:09712))
