[Term]
id: goldbook:E02245
name: excipient
def: "Any more or less inert substance added to a drug to give suitable consistency or form to the drug."
property_value: mito:isMentionedBy doi:10.1351/pac199365092003
property_value: hasStatus "current" xsd:string
