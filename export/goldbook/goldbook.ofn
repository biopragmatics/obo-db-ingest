AnnotationAssertion(rdfs:label goldbook:Y06729 "ynamines")
AnnotationAssertion(dcterms:description goldbook:Y06729 "N,N-Disubstituted alk-1-yn-1-amines, $\\ce{RC#CNR2}$. By usage, restricted to this type of acetylenic amine.")
