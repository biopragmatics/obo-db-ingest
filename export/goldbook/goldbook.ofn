AnnotationAssertion(rdfs:label goldbook:12128 "tetanus")
AnnotationAssertion(dcterms:description goldbook:12128 "Sustained muscle contraction. Disease caused by tetanus toxin and characterized by painful, sustained muscle contraction with spasticity and paralysis.")
