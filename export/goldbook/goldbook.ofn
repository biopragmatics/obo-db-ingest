AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14240 "polymer mixed crystal")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14240 "polymer-based crystalline molecular complex")
Declaration(Class(goldbook:14241))
