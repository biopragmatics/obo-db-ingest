AnnotationAssertion(obo:goldbook#hasStatus goldbook:13359 "current"^^xsd:string)
Declaration(Class(goldbook:13360))
AnnotationAssertion(rdfs:label goldbook:13360 "killer activatory receptor")
AnnotationAssertion(dcterms:description goldbook:13360 "Receptor found on natural killer (NK) cells, and some $\\ce{\\upgamma\\!{:}\\updelta\\!}$ and $\\ce{\\upalpha\\!{:}\\upbeta\\! T cells}$.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13360 "KAR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13360 "killer cell immunoglobulin-like receptor")
AnnotationAssertion(rdfs:comment goldbook:13360 "KARs recognize major histocompatibility complex (MHC) class I molecules and, like the C-type lectin receptors also found in these cells, can either inhibit or activate the killer cells. If immunoreceptor tyrosine-based inhibitory motif (ITIM) sequences are present in their cytoplasmic domain they are inhibitory."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13360 "Killer cell immunoglobulin-like receptors (KIRs) lacking ITIMs can associate with immunoreceptor tyrosine-based activation motif (ITAM)-containing adaptor molecules in which case they can activate the killer cell."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13360 goldbook:12983)
