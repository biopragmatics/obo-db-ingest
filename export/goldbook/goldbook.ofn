Declaration(Class(goldbook:A00215))
AnnotationAssertion(rdfs:label goldbook:A00215 "alert levels")
AnnotationAssertion(dcterms:description goldbook:A00215 "Designated concentrations of certain key pollutants at which some degree of danger to public health is expected. In many areas in which a relatively high level of pollution is often encountered, several levels of alert are often established. For example, a first alert may signify a potential problem exists; a second alert becomes a signal for the curtailment of certain significant emission sources; the third alert signifies the need for some specified emergency action which must be taken to ensure the public safety.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00215 goldbook:P04718)
AnnotationAssertion(mito:isMentionedBy goldbook:A00215 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00215 "current"^^xsd:string)
Declaration(Class(goldbook:A00216))
AnnotationAssertion(rdfs:label goldbook:A00216 "alicyclic compounds")
AnnotationAssertion(dcterms:description goldbook:A00216 "Aliphatic compounds having a carbocyclic ring structure which may be saturated or unsaturated, but may not be a benzenoid or other aromatic system.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00216 goldbook:A00217)
AnnotationAssertion(mito:isMentionedBy goldbook:A00216 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00216 "current"^^xsd:string)
Declaration(Class(goldbook:A00217))
AnnotationAssertion(rdfs:label goldbook:A00217 "aliphatic compounds")
AnnotationAssertion(dcterms:description goldbook:A00217 "Acyclic or cyclic, saturated or unsaturated carbon compounds, excluding aromatic compounds.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00217 goldbook:A00441)
AnnotationAssertion(mito:isMentionedBy goldbook:A00217 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00217 "current"^^xsd:string)
Declaration(Class(goldbook:A00218))
AnnotationAssertion(rdfs:label goldbook:A00218 "aliquot")
AnnotationAssertion(dcterms:description goldbook:A00218 "A known amount of a homogeneous material, assumed to be taken with negligible sampling error. The term is usually applied to fluids. The term 'aliquot' is usually used when the fractional part is an exact divisor of the whole; the term 'aliquant' has been used when the fractional part is not an exact divisor of the whole (e.g. a \\(15\\ \\rm{ml}\\) portion is an aliquant of \\(100\\ \\rm{ml}\\)). When a laboratory sample or test sample is 'aliquoted' or otherwise subdivided, the portions have been called split samples.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00218 goldbook:L03433)
AnnotationAssertion(rdfs:seeAlso goldbook:A00218 goldbook:S05463)
AnnotationAssertion(rdfs:seeAlso goldbook:A00218 goldbook:T06285)
AnnotationAssertion(mito:isMentionedBy goldbook:A00218 doi:10.1351/pac199062061193)
AnnotationAssertion(mito:isMentionedBy goldbook:A00218 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00218 "current"^^xsd:string)
Declaration(Class(goldbook:A00220))
AnnotationAssertion(rdfs:label goldbook:A00220 "alkaloids")
AnnotationAssertion(dcterms:description goldbook:A00220 "Basic nitrogen compounds (mostly heterocyclic) occurring mostly in the plant kingdom (but not excluding those of animal origin). Amino acids, peptides, proteins, nucleotides, nucleic acids, amino sugars and antibiotics are not normally regarded as alkaloids. By extension, certain neutral compounds biogenetically related to basic alkaloids are included.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00220 goldbook:A00283)
AnnotationAssertion(rdfs:seeAlso goldbook:A00220 goldbook:N04245)
AnnotationAssertion(rdfs:seeAlso goldbook:A00220 goldbook:N04255)
