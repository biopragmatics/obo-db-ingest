AnnotationAssertion(rdfs:label goldbook:12109 "synapse")
AnnotationAssertion(dcterms:description goldbook:12109 "Functional junction between two neurons, where a nerve impulse is transmitted from one neuron to another, by neurotransmitters.")
AnnotationAssertion(rdfs:seeAlso goldbook:12109 goldbook:11955)
AnnotationAssertion(mito:isMentionedBy goldbook:12109 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12109 "current"^^xsd:string)
Declaration(Class(goldbook:12110))
AnnotationAssertion(rdfs:label goldbook:12110 "synaptic cleft")
AnnotationAssertion(dcterms:description goldbook:12110 "Narrow gap between the presynaptic and postsynaptic regions of two communicating neurons, into which neurotransmitters are secreted.")
AnnotationAssertion(rdfs:seeAlso goldbook:12110 goldbook:11955)
AnnotationAssertion(rdfs:seeAlso goldbook:12110 goldbook:12109)
AnnotationAssertion(mito:isMentionedBy goldbook:12110 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12110 "current"^^xsd:string)
Declaration(Class(goldbook:12111))
AnnotationAssertion(rdfs:label goldbook:12111 "synaptic inhibition")
AnnotationAssertion(dcterms:description goldbook:12111 "Suppression of synaptic transmission.")
AnnotationAssertion(rdfs:comment goldbook:12111 "This may occur presynaptically or postsynaptically, result from electrical or chemical effects, and be deliberately produced or part of a physiological process."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12111 goldbook:11832)
AnnotationAssertion(rdfs:seeAlso goldbook:12111 goldbook:12016)
AnnotationAssertion(rdfs:seeAlso goldbook:12111 goldbook:12018)
AnnotationAssertion(rdfs:seeAlso goldbook:12111 goldbook:12114)
