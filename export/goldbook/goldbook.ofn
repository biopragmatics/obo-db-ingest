Declaration(Class(goldbook:H02907))
AnnotationAssertion(rdfs:label goldbook:H02907 "hydrophobic interaction")
AnnotationAssertion(dcterms:description goldbook:H02907 "The tendency of hydrocarbons (or of lipophilic hydrocarbon-like groups in solutes) to form intermolecular aggregates in an aqueous medium, and analogous intramolecular interactions. The name arises from the attribution of the phenomenon to the apparent repulsion between water and hydrocarbons. However, the phenomenon ought to be attributed to the effect of the hydrocarbon-like groups on the water-water interaction. The misleading alternative term 'hydrophobic bond' is discouraged.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02907 goldbook:H02889)
AnnotationAssertion(rdfs:seeAlso goldbook:H02907 goldbook:I03098)
AnnotationAssertion(rdfs:seeAlso goldbook:H02907 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:H02907 goldbook:L03572)
AnnotationAssertion(mito:isMentionedBy goldbook:H02907 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:H02907 "current"^^xsd:string)
Declaration(Class(goldbook:H02908))
AnnotationAssertion(rdfs:label goldbook:H02908 "hydropolysulfides")
AnnotationAssertion(dcterms:description goldbook:H02908 "Compounds having the structures $\\ce{RS2H}$, $\\ce{RS3H}$ ... $\\ce{RSnH}$, in which $\\ce{Sn}$ is a chain of sulfur atoms, and $\\ce{R}$ is hydrocarbyl. Some people exclude hydrodisulfides from the class hydropolysulfides.")
