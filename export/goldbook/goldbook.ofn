AnnotationAssertion(obo:goldbook#hasStatus goldbook:10037 "current"^^xsd:string)
Declaration(Class(goldbook:10038))
AnnotationAssertion(rdfs:label goldbook:10038 "hold-up time")
AnnotationAssertion(dcterms:description goldbook:10038 "Time required to elute a component which is not retained by the stationary phase.")
AnnotationAssertion(rdfs:comment goldbook:10038 "The hold-up time includes any time that the component spends in the sample injector, the detector, and connectors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10038 "The hold-up time is related to the hold-up volume (\\(V_{\\rm{M}}\\)) and flow rate (\\(F_{\\rm{c}}\\)) by \\(t_{\\rm{M}} = V_{\\rm{M}}⁄F_{\\rm{c}}\\) ."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10038 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10038 "current"^^xsd:string)
Declaration(Class(goldbook:10039))
AnnotationAssertion(rdfs:label goldbook:10039 "total retention time")
AnnotationAssertion(dcterms:description goldbook:10039 "Time between sample injection and the emergence of the peak maximum of the sample component of interest.")
AnnotationAssertion(rdfs:comment goldbook:10039 "Total retention time includes the hold-up time."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10039 "The total retention time is related to the total retention volume (\\(V_{\\rm{R}}\\)) and flow rate (\\(F_{\\rm{c}}\\)) by \\(t_{\\rm{R}} = V_{\\rm{R}}⁄F_{\\rm{c}}\\) ."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10039 goldbook:10038)
AnnotationAssertion(mito:isMentionedBy goldbook:10039 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10039 "current"^^xsd:string)
Declaration(Class(goldbook:10040))
AnnotationAssertion(rdfs:label goldbook:10040 "retention time of an unretained compound")
AnnotationAssertion(dcterms:description goldbook:10040 "Retention time of a sample component the molecules of which are larger than the largest pores of the particles of the stationary phase.")
AnnotationAssertion(rdfs:comment goldbook:10040 "This component will be eluted first from the column."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10040 "The retention time of an unretained compound is related to the retention volume of an unretained compound (in size-exclusion chromatography) and the flow rate (\\(F_{\\rm{c}}\\)) by \\(t_{0} = V_{0}/F_{\\rm{c}}\\) "^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10040 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10040 "current"^^xsd:string)
Declaration(Class(goldbook:10042))
AnnotationAssertion(rdfs:label goldbook:10042 "response")
AnnotationAssertion(dcterms:description goldbook:10042 "Measured or observed quantity in an experimental design.")
AnnotationAssertion(rdfs:seeAlso goldbook:10042 goldbook:10071)
AnnotationAssertion(mito:isMentionedBy goldbook:10042 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10042 "current"^^xsd:string)
Declaration(Class(goldbook:10043))
AnnotationAssertion(rdfs:label goldbook:10043 "autocorrelation")
AnnotationAssertion(dcterms:description goldbook:10043 "Correlation of a variable with itself over a successive time or space intervals (lags).")
AnnotationAssertion(rdfs:comment goldbook:10043 "If the mean of autocorrelated data is estimated the standard deviation of the mean depends on sampling mode."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10043 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10043 "current"^^xsd:string)
Declaration(Class(goldbook:10044))
AnnotationAssertion(rdfs:label goldbook:10044 "autoscaling")
AnnotationAssertion(dcterms:description goldbook:10044 "Variance scaling of mean-centered data.")
AnnotationAssertion(rdfs:seeAlso goldbook:10044 goldbook:10064)
AnnotationAssertion(rdfs:seeAlso goldbook:10044 goldbook:10053)
AnnotationAssertion(mito:isMentionedBy goldbook:10044 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10044 "current"^^xsd:string)
Declaration(Class(goldbook:10045))
AnnotationAssertion(rdfs:label goldbook:10045 "categorical data")
AnnotationAssertion(dcterms:description goldbook:10045 "Data, values of which are one of a fixed number of nominal categories.")
AnnotationAssertion(rdfs:comment goldbook:10045 "Data in a contingency table are categorical."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10045 goldbook:10046)
AnnotationAssertion(mito:isMentionedBy goldbook:10045 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10045 "current"^^xsd:string)
Declaration(Class(goldbook:10046))
AnnotationAssertion(rdfs:label goldbook:10046 "contingency table")
AnnotationAssertion(dcterms:description goldbook:10046 "Type of table in a matrix format that displays the multivariate frequency distribution of variables.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10046 "cross tabulation")
AnnotationAssertion(rdfs:comment goldbook:10046 "The entries in the cells of a contingency table can be frequency counts or relative frequencies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10046 goldbook:10045)
AnnotationAssertion(mito:isMentionedBy goldbook:10046 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10046 "current"^^xsd:string)
Declaration(Class(goldbook:10047))
AnnotationAssertion(rdfs:label goldbook:10047 "data matrix")
AnnotationAssertion(dcterms:description goldbook:10047 "Measurement results on a system arranged in a \\(m \\times n\\) matrix, with \\(m\\) objects and \\(n\\) variables.")
AnnotationAssertion(rdfs:comment goldbook:10047 "By convention a matrix is arranged with \\(m\\) rows and \\(n\\) columns."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10047 "Objects are also called \"samples\", but confusion with physical \"test samples\" in analytical chemistry should be avoided."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10047 "Variables are also called features, or explanatory variables."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10047 "For multi-way data the data is arranged in a hypercube of \\(m \\times n_{1} \\times n_{2} \\times\\) …, where \\(n_{1}\\), \\(n_{2}\\) … are the kinds of explanatory variable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10047 goldbook:10051)
AnnotationAssertion(rdfs:seeAlso goldbook:10047 goldbook:10056)
AnnotationAssertion(mito:isMentionedBy goldbook:10047 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10047 "current"^^xsd:string)
Declaration(Class(goldbook:10048))
AnnotationAssertion(rdfs:label goldbook:10048 "data pre-processing")
AnnotationAssertion(dcterms:description goldbook:10048 "Manipulation of raw data prior to a specified data analysis treatment.")
AnnotationAssertion(rdfs:comment goldbook:10048 "The term \"pre-processing\" is preferred to the term \"pre-treatment\" to reduce confusion with physical sample preparation or treatment prior to experimental analysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10048 "Aside from the three main categories of data pre-processing methods (mean centering, scaling and transformation), data pre-processing can refer to any other procedures carried out on the raw data, including mass binning and peak selection. In the case of multivariate images, this can also include region-of-interest selection and image filtering or binning."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10048 "All data pre-processing methods imply some assumptions about the nature of the variability in the data set. It is important that these assumptions are understood and appropriate for the data set involved."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10048 "More than one data pre-processing method can be applied to the same data set. The order of data pre-processing is important and can affect assumptions made on the nature of variance in the data set."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10048 goldbook:10053)
AnnotationAssertion(rdfs:seeAlso goldbook:10048 goldbook:10058)
AnnotationAssertion(rdfs:seeAlso goldbook:10048 goldbook:10060)
AnnotationAssertion(mito:isMentionedBy goldbook:10048 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10048 "current"^^xsd:string)
Declaration(Class(goldbook:10049))
AnnotationAssertion(rdfs:label goldbook:10049 "dynamic time warping")
AnnotationAssertion(dcterms:description goldbook:10049 "Process of synchronizing a data matrix so that it represents the same time shifts.")
AnnotationAssertion(rdfs:comment goldbook:10049 "The method is used in chromatography to align peaks by their retention times."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10049 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10049 "current"^^xsd:string)
Declaration(Class(goldbook:10050))
AnnotationAssertion(rdfs:label goldbook:10050 "evaluation data")
AnnotationAssertion(dcterms:description goldbook:10050 "Data used to validate a model.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10050 "validation data")
AnnotationAssertion(rdfs:comment goldbook:10050 "Evaluation data should be independent of the data used to calibrate or train a model."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10050 "\"Test data\" is also used for data from an unknown sample, and should not be used for \"evaluation data\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10050 goldbook:10077)
AnnotationAssertion(mito:isMentionedBy goldbook:10050 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10050 "current"^^xsd:string)
Declaration(Class(goldbook:10051))
AnnotationAssertion(rdfs:label goldbook:10051 "explanatory variable")
AnnotationAssertion(dcterms:description goldbook:10051 "Variable that influences the value of a response variable, and is used to build models of the response variable.")
AnnotationAssertion(mito:isMentionedBy goldbook:10051 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10051 "current"^^xsd:string)
Declaration(Class(goldbook:10052))
AnnotationAssertion(rdfs:label goldbook:10052 "exploratory data analysis")
AnnotationAssertion(dcterms:description goldbook:10052 "Summary of the main characteristics of data, often using graphical methods.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10052 "EDA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10052 "initial data analysis")
AnnotationAssertion(rdfs:comment goldbook:10052 "Exploratory data analysis is recommended before deciding an approach to chemometric modelling."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10052 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10052 "current"^^xsd:string)
Declaration(Class(goldbook:10053))
AnnotationAssertion(rdfs:label goldbook:10053 "mean centering")
AnnotationAssertion(dcterms:description goldbook:10053 "Data pre-processing in which the mean value of a variable is subtracted from data across all objects. \\[a_{i,j}^{\\ast} = a_{i,j} - \\frac{1}{n} \\sum \\limits_{i\\,=\\,1}^{n} a_{i,j}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10053 "centering")
AnnotationAssertion(rdfs:comment goldbook:10053 "Mean centering emphasises the differences between samples rather than differences between the samples and the variable’s origin (zero)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10053 "Mean centering is generally recommended for principal component analysis, partial least squares and discriminant analysis of data, where relative values across the samples are more important than their absolute deviation from zero. Mean centering is not compatible with non-negativity constraints in, for example, multivariate curve resolution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10053 "Mean centering is generally applied with other data pre-processing methods."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10053 goldbook:10060)
AnnotationAssertion(rdfs:seeAlso goldbook:10053 goldbook:10048)
AnnotationAssertion(rdfs:seeAlso goldbook:10053 goldbook:10100)
AnnotationAssertion(rdfs:seeAlso goldbook:10053 goldbook:10155)
AnnotationAssertion(rdfs:seeAlso goldbook:10053 goldbook:10106)
AnnotationAssertion(mito:isMentionedBy goldbook:10053 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10053 "current"^^xsd:string)
Declaration(Class(goldbook:10054))
AnnotationAssertion(rdfs:label goldbook:10054 "multiplicative scatter correction")
AnnotationAssertion(dcterms:description goldbook:10054 "Data pre-processing in which a constant and a multiple of a reference data set is subtracted from data.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10054 "MSC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10054 "multiplicative signal correction")
AnnotationAssertion(rdfs:comment goldbook:10054 "MSC is typically used in near-infrared spectrometry to remove effects of non-homogeneous particle size."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10054 goldbook:10048)
AnnotationAssertion(mito:isMentionedBy goldbook:10054 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10054 "current"^^xsd:string)
Declaration(Class(goldbook:10055))
AnnotationAssertion(rdfs:label goldbook:10055 "multivariate data")
AnnotationAssertion(dcterms:description goldbook:10055 "Data having two or more variables per object.")
AnnotationAssertion(rdfs:comment goldbook:10055 "The measurements results are often of the same kind of quantity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10055 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10055 "current"^^xsd:string)
Declaration(Class(goldbook:10056))
AnnotationAssertion(rdfs:label goldbook:10056 "multi-way data")
AnnotationAssertion(dcterms:description goldbook:10056 "Multivariate data having two or more kinds of explanatory variable per object.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10056 "N-way data")
AnnotationAssertion(rdfs:comment goldbook:10056 "For two groups of explanatory variables the data is termed ‘three-way’."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10056 "Models that decompose multi-way data include PARAFAC, Tucker3 model."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10056 goldbook:10055)
AnnotationAssertion(rdfs:seeAlso goldbook:10056 goldbook:10103)
AnnotationAssertion(rdfs:seeAlso goldbook:10056 goldbook:10116)
AnnotationAssertion(rdfs:seeAlso goldbook:10056 goldbook:10051)
AnnotationAssertion(mito:isMentionedBy goldbook:10056 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10056 "current"^^xsd:string)
Declaration(Class(goldbook:10057))
AnnotationAssertion(rdfs:label goldbook:10057 "random sampling")
AnnotationAssertion(dcterms:description goldbook:10057 "Sampling in which the sample locations are selected randomly from the whole population.")
AnnotationAssertion(rdfs:comment goldbook:10057 "The population defines the kind of quantity of the location. For example, in a time series, the quantity giving the location is time, in QSAR the location is a point in design space."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10057 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10057 "current"^^xsd:string)
Declaration(Class(goldbook:10058))
AnnotationAssertion(rdfs:label goldbook:10058 "raw data")
AnnotationAssertion(dcterms:description goldbook:10058 "Data not yet subjected to analysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10058 "primary data")
AnnotationAssertion(rdfs:comment goldbook:10058 "Raw data can be an indication obtained from a measuring instrument or measuring system"^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10058 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10058 "current"^^xsd:string)
Declaration(Class(goldbook:10059))
AnnotationAssertion(rdfs:label goldbook:10059 "sampling unit")
AnnotationAssertion(dcterms:description goldbook:10059 "Defined quantity of material having a boundary which may be physical or temporal.")
AnnotationAssertion(rdfs:comment goldbook:10059 "Examples of physical boundaries are capsules, containers, and bottles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10059 "A number of sampling units may be gathered together, for example in a package or box."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10059 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10059 "current"^^xsd:string)
Declaration(Class(goldbook:10060))
AnnotationAssertion(rdfs:label goldbook:10060 "scaling")
AnnotationAssertion(dcterms:description goldbook:10060 "Element-wise division of a data matrix by a scaling matrix.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10060 "weighting")
AnnotationAssertion(rdfs:seeAlso goldbook:10060 goldbook:10044)
AnnotationAssertion(rdfs:seeAlso goldbook:10060 goldbook:10047)
AnnotationAssertion(rdfs:seeAlso goldbook:10060 goldbook:10064)
AnnotationAssertion(mito:isMentionedBy goldbook:10060 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10060 "current"^^xsd:string)
Declaration(Class(goldbook:10061))
AnnotationAssertion(rdfs:label goldbook:10061 "smoothing")
AnnotationAssertion(dcterms:description goldbook:10061 "Transformation using an approximating function to capture important patterns in data, while removing noise or other fine-scale structures.")
AnnotationAssertion(rdfs:seeAlso goldbook:10061 goldbook:10041)
AnnotationAssertion(mito:isMentionedBy goldbook:10061 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10061 "current"^^xsd:string)
Declaration(Class(goldbook:10062))
AnnotationAssertion(rdfs:label goldbook:10062 "systematic sampling")
AnnotationAssertion(dcterms:description goldbook:10062 "Sampling in which individual samples are taken at equal intervals in location.")
AnnotationAssertion(rdfs:comment goldbook:10062 "In a time series, the quantity giving the location is time."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10062 "The starting point may be assigned randomly within the first stratum."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10062 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10062 "current"^^xsd:string)
Declaration(Class(goldbook:10063))
AnnotationAssertion(rdfs:label goldbook:10063 "take-it-or-leave-it data")
AnnotationAssertion(dcterms:description goldbook:10063 "Happenstance data that must be processed, or not processed, as is.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10063 "TILI")
AnnotationAssertion(mito:isMentionedBy goldbook:10063 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10063 "current"^^xsd:string)
Declaration(Class(goldbook:10064))
AnnotationAssertion(rdfs:label goldbook:10064 "variance scaling")
AnnotationAssertion(dcterms:description goldbook:10064 "Scaling in which the scaling matrix is the standard deviation of each variable across the objects. \\[a_{i,j}^{\\ast} = \\frac{a_{i,j}}{s_{j}}\\]")
AnnotationAssertion(rdfs:comment goldbook:10064 "A variable occupies a column of the data matrix."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10064 "Variance scaling equalizes the importance of each variable in multivariate data."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10064 "When used with mean centering variance scaling is known as autoscaling."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10064 goldbook:10060)
AnnotationAssertion(rdfs:seeAlso goldbook:10064 goldbook:10044)
AnnotationAssertion(rdfs:seeAlso goldbook:10064 goldbook:10047)
AnnotationAssertion(rdfs:seeAlso goldbook:10064 goldbook:10053)
AnnotationAssertion(rdfs:seeAlso goldbook:10064 goldbook:10055)
AnnotationAssertion(mito:isMentionedBy goldbook:10064 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10064 "current"^^xsd:string)
Declaration(Class(goldbook:10065))
AnnotationAssertion(rdfs:label goldbook:10065 "alias structure")
AnnotationAssertion(dcterms:description goldbook:10065 "List of combinations of effects that are aliased (confounded).")
AnnotationAssertion(rdfs:seeAlso goldbook:10065 goldbook:10066)
AnnotationAssertion(mito:isMentionedBy goldbook:10065 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10065 "current"^^xsd:string)
Declaration(Class(goldbook:10066))
AnnotationAssertion(rdfs:label goldbook:10066 "aliased effects")
AnnotationAssertion(dcterms:description goldbook:10066 "In a fractional-factorial design, effects for which the information obtained are identical.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10066 "confounded effects")
AnnotationAssertion(rdfs:comment goldbook:10066 "In a two-level design, the product of the coded levels for the aliased effects are equal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10066 goldbook:10068)
AnnotationAssertion(rdfs:seeAlso goldbook:10066 goldbook:10073)
AnnotationAssertion(mito:isMentionedBy goldbook:10066 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10066 "current"^^xsd:string)
Declaration(Class(goldbook:10067))
AnnotationAssertion(rdfs:label goldbook:10067 "coded experimental design")
AnnotationAssertion(dcterms:description goldbook:10067 "Matrix of runs by factor levels in which each level is denoted by a code that represents the relative magnitude of the level.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10067 "coded design")
AnnotationAssertion(rdfs:seeAlso goldbook:10067 goldbook:10072)
AnnotationAssertion(mito:isMentionedBy goldbook:10067 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10067 "current"^^xsd:string)
Declaration(Class(goldbook:10068))
AnnotationAssertion(rdfs:label goldbook:10068 "effect of a factor")
AnnotationAssertion(dcterms:description goldbook:10068 "Coefficient of a term in a response model.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10068 "effect")
AnnotationAssertion(rdfs:seeAlso goldbook:10068 goldbook:10075)
AnnotationAssertion(rdfs:seeAlso goldbook:10068 goldbook:10076)
AnnotationAssertion(rdfs:seeAlso goldbook:10068 goldbook:10077)
AnnotationAssertion(rdfs:seeAlso goldbook:10068 goldbook:10078)
AnnotationAssertion(mito:isMentionedBy goldbook:10068 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10068 "current"^^xsd:string)
Declaration(Class(goldbook:10069))
AnnotationAssertion(rdfs:label goldbook:10069 "design matrix")
AnnotationAssertion(dcterms:description goldbook:10069 "Matrix with rows representing individual experimental treatments (possibly transformed according to the assumed model) which can be extended by deduced levels of other functions of factor levels.")
AnnotationAssertion(rdfs:seeAlso goldbook:10069 goldbook:10072)
AnnotationAssertion(mito:isMentionedBy goldbook:10069 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10069 "current"^^xsd:string)
Declaration(Class(goldbook:10070))
AnnotationAssertion(rdfs:label goldbook:10070 "dummy factor")
AnnotationAssertion(dcterms:description goldbook:10070 "Factor that is known to have no effect on the response, used in an experimental design, to estimate repeatability standard deviation.")
AnnotationAssertion(rdfs:seeAlso goldbook:10070 goldbook:10071)
AnnotationAssertion(rdfs:seeAlso goldbook:10070 goldbook:10042)
AnnotationAssertion(mito:isMentionedBy goldbook:10070 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10070 "current"^^xsd:string)
Declaration(Class(goldbook:10071))
AnnotationAssertion(rdfs:label goldbook:10071 "experimental design")
AnnotationAssertion(dcterms:description goldbook:10071 "Efficient procedure for planning combinations of values of factors in experiments so that the data obtained can be analyzed to yield valid and objective conclusions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10071 "DoE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10071 "design of experiments")
AnnotationAssertion(rdfs:comment goldbook:10071 "Experimental design is applied to determine the set of conditions that are required to obtain a product or process with desirable, often optimal properties. A characteristic of experimental design is that these conditions are determined in a statistically-optimal way."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10071 "Response surface methodology is considered an important part of experimental design."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10071 "An \"experimental design\" (noun) usually refers to a table giving the levels of each factor for each run."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10071 goldbook:10082)
AnnotationAssertion(rdfs:seeAlso goldbook:10071 goldbook:10067)
AnnotationAssertion(mito:isMentionedBy goldbook:10071 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10071 "current"^^xsd:string)
Declaration(Class(goldbook:10072))
AnnotationAssertion(rdfs:label goldbook:10072 "factor level")
AnnotationAssertion(dcterms:description goldbook:10072 "Value of a factor in an experimental design.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10072 "level")
AnnotationAssertion(rdfs:comment goldbook:10072 "A design may be designated by the number of levels chosen for each factor, as in \"two-level design\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10072 "When writing an experimental design the levels are usually coded."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10072 goldbook:10067)
AnnotationAssertion(rdfs:seeAlso goldbook:10072 goldbook:10071)
AnnotationAssertion(mito:isMentionedBy goldbook:10072 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10072 "current"^^xsd:string)
Declaration(Class(goldbook:10073))
AnnotationAssertion(rdfs:label goldbook:10073 "fractional-factorial design")
AnnotationAssertion(dcterms:description goldbook:10073 "Experimental design obtained from a full-factorial design in which experiments are systematically removed to fulfill stated statistical requirements.")
AnnotationAssertion(rdfs:comment goldbook:10073 "The aim of a fractional design is to reduce the number of experiments by confounding low-order effects (e.g. main effect, two-way interaction) with high order interactions, which are assumed to be small."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10073 "A design, having \\(L^{k}\\) (see full-factorial design) experiments, is fractionated to \\(L^{k - p}\\) experiments where \\(p\\) is an integer \\(\\lt k\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10073 "The choice of design is governed by an alias structure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10073 "A fractional-factorial design is incomplete, but all incomplete designs are not fractional factorial."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10073 goldbook:10071)
AnnotationAssertion(rdfs:seeAlso goldbook:10073 goldbook:10080)
AnnotationAssertion(rdfs:seeAlso goldbook:10073 goldbook:10065)
AnnotationAssertion(rdfs:seeAlso goldbook:10073 goldbook:10074)
AnnotationAssertion(mito:isMentionedBy goldbook:10073 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10073 "current"^^xsd:string)
Declaration(Class(goldbook:10074))
AnnotationAssertion(rdfs:label goldbook:10074 "full-factorial design")
AnnotationAssertion(dcterms:description goldbook:10074 "Experimental design with all possible combinations of factor levels.")
AnnotationAssertion(rdfs:comment goldbook:10074 "If there are \\(k\\) factors, each at \\(L\\) levels, a full-factorial design has \\(L^{k}\\) runs."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10074 goldbook:10071)
AnnotationAssertion(rdfs:seeAlso goldbook:10074 goldbook:10072)
AnnotationAssertion(mito:isMentionedBy goldbook:10074 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10074 "current"^^xsd:string)
Declaration(Class(goldbook:10075))
AnnotationAssertion(rdfs:label goldbook:10075 "interaction effect")
AnnotationAssertion(dcterms:description goldbook:10075 "Effect of a factor where the term is the product of two or more factors.")
AnnotationAssertion(rdfs:seeAlso goldbook:10075 goldbook:10068)
AnnotationAssertion(rdfs:seeAlso goldbook:10075 goldbook:10076)
AnnotationAssertion(rdfs:seeAlso goldbook:10075 goldbook:10078)
AnnotationAssertion(mito:isMentionedBy goldbook:10075 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10075 "current"^^xsd:string)
Declaration(Class(goldbook:10076))
AnnotationAssertion(rdfs:label goldbook:10076 "main effect")
AnnotationAssertion(dcterms:description goldbook:10076 "Effect of a factor where the term is a single factor.")
AnnotationAssertion(rdfs:seeAlso goldbook:10076 goldbook:10068)
AnnotationAssertion(rdfs:seeAlso goldbook:10076 goldbook:10075)
AnnotationAssertion(rdfs:seeAlso goldbook:10076 goldbook:10078)
AnnotationAssertion(mito:isMentionedBy goldbook:10076 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10076 "current"^^xsd:string)
Declaration(Class(goldbook:10077))
AnnotationAssertion(rdfs:label goldbook:10077 "model")
AnnotationAssertion(dcterms:description goldbook:10077 "Equation describing the response as a function of values of the factors.")
AnnotationAssertion(rdfs:comment goldbook:10077 "The model can be based on knowledge of the chemistry or physics of the system, but usually the model is empirical, being linear or quadratic with interaction terms."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10077 "To obtain information about the significance of effects, data is usually mean centered and assessed against a coded experimental design."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10077 goldbook:10067)
AnnotationAssertion(rdfs:seeAlso goldbook:10077 goldbook:10075)
AnnotationAssertion(rdfs:seeAlso goldbook:10077 goldbook:10076)
AnnotationAssertion(rdfs:seeAlso goldbook:10077 goldbook:10053)
AnnotationAssertion(rdfs:seeAlso goldbook:10077 goldbook:10078)
AnnotationAssertion(rdfs:seeAlso goldbook:10077 goldbook:10042)
AnnotationAssertion(mito:isMentionedBy goldbook:10077 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10077 "current"^^xsd:string)
Declaration(Class(goldbook:10078))
AnnotationAssertion(rdfs:label goldbook:10078 "<em>n</em><sup>th</sup>-order effect")
AnnotationAssertion(dcterms:description goldbook:10078 "Effect of a factor where the term is a factor raised to the power \\(n\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:10078 goldbook:10068)
AnnotationAssertion(rdfs:seeAlso goldbook:10078 goldbook:10075)
AnnotationAssertion(rdfs:seeAlso goldbook:10078 goldbook:10076)
AnnotationAssertion(mito:isMentionedBy goldbook:10078 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10078 "current"^^xsd:string)
Declaration(Class(goldbook:10079))
AnnotationAssertion(rdfs:label goldbook:10079 "optimization")
AnnotationAssertion(dcterms:description goldbook:10079 "Minimization or maximization of a real function by systematically choosing the values of real or integer variables from within an allowed set.")
AnnotationAssertion(mito:isMentionedBy goldbook:10079 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10079 "current"^^xsd:string)
Declaration(Class(goldbook:10080))
AnnotationAssertion(rdfs:label goldbook:10080 "Plackett−Burman design")
AnnotationAssertion(dcterms:description goldbook:10080 "Incomplete experimental design to estimate main effects for which each combination of factor levels for any pair of factors appears the same number of times.")
AnnotationAssertion(rdfs:comment goldbook:10080 "Plackett–Burman designs are typically given for two levels, with a number of experiments that is a multiple of 4 but not a power of 2. (The latter case is a fractional-factorial design)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10080 "For \\(4 \\times N\\) experiments, \\(4 \\times N − 1\\) main effects and the mean are estimated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10080 "If less than \\(4 \\times N − 1\\) factors are being studied, dummy factors are inserted which allow estimation of the repeatability standard deviation of the measurement results."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10080 goldbook:10070)
AnnotationAssertion(rdfs:seeAlso goldbook:10080 goldbook:10071)
AnnotationAssertion(rdfs:seeAlso goldbook:10080 goldbook:10072)
AnnotationAssertion(rdfs:seeAlso goldbook:10080 goldbook:10073)
AnnotationAssertion(rdfs:seeAlso goldbook:10080 goldbook:10076)
AnnotationAssertion(mito:isMentionedBy goldbook:10080 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10080 "current"^^xsd:string)
Declaration(Class(goldbook:10081))
AnnotationAssertion(rdfs:label goldbook:10081 "resolution of a design")
AnnotationAssertion(dcterms:description goldbook:10081 "One more than the smallest nth-order interaction effect that some main effect is aliased with.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10081 "resolution")
AnnotationAssertion(rdfs:comment goldbook:10081 "Resolution is used to describe the extent to which fractional-factorial designs create aliased effects."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10081 "The resolution is written as a Roman numeral."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10081 "Full-factorial designs have no effects that are aliased and therefore have infinite resolution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10081 goldbook:10074)
AnnotationAssertion(rdfs:seeAlso goldbook:10081 goldbook:10066)
AnnotationAssertion(rdfs:seeAlso goldbook:10081 goldbook:10073)
AnnotationAssertion(rdfs:seeAlso goldbook:10081 goldbook:10076)
AnnotationAssertion(rdfs:seeAlso goldbook:10081 goldbook:10075)
AnnotationAssertion(mito:isMentionedBy goldbook:10081 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10081 "current"^^xsd:string)
Declaration(Class(goldbook:10082))
AnnotationAssertion(rdfs:label goldbook:10082 "response surface methodology")
AnnotationAssertion(dcterms:description goldbook:10082 "Experimental design in which the response is modelled in terms of one or more factor levels.")
AnnotationAssertion(rdfs:comment goldbook:10082 "Response surface methodology is usually associated with optimization. The model used is typically a quadratic function leading to a maximum or minimum response in the factor space."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10082 "The term \"surface\" implies two factors and a single response, when a plot of the modelled response as a function of values of the factors leads to a surface in the three-dimensional space. This can be generalized to any number of factors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10082 goldbook:10071)
AnnotationAssertion(rdfs:seeAlso goldbook:10082 goldbook:10072)
AnnotationAssertion(rdfs:seeAlso goldbook:10082 goldbook:10079)
AnnotationAssertion(rdfs:seeAlso goldbook:10082 goldbook:10042)
AnnotationAssertion(mito:isMentionedBy goldbook:10082 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10082 "current"^^xsd:string)
Declaration(Class(goldbook:10083))
AnnotationAssertion(rdfs:label goldbook:10083 "alternating least squares regression")
AnnotationAssertion(dcterms:description goldbook:10083 "Solution to the multivariate decomposition of a data matrix in which iteratively a solution of one output matrix is used to compute the second matrix, after the application of constraints.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10083 "ALS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10083 "alternating regression")
AnnotationAssertion(rdfs:comment goldbook:10083 "ALS is used to decompose multiple spectra (\\(\\boldsymbol{X}\\)) into concentration (\\(\\boldsymbol{C}\\)) and component spectra (\\(\\boldsymbol{S}\\)). \\(\\boldsymbol{X} = \\boldsymbol{C}\\boldsymbol{S}^{\\rm{T}}\\). Because spectra and concentrations cannot be negative at each iteration negative values are set to zero."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10083 goldbook:10055)
AnnotationAssertion(mito:isMentionedBy goldbook:10083 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10083 "current"^^xsd:string)
Declaration(Class(goldbook:10084))
AnnotationAssertion(rdfs:label goldbook:10084 "autoregression")
AnnotationAssertion(dcterms:description goldbook:10084 "Stochastic process in which future values are estimated based on a weighted sum of past values.")
AnnotationAssertion(rdfs:comment goldbook:10084 "A process called AR(1) is a first order process, meaning that the current value is based on the immediately preceding value. An AR(2) process has the current value based on the previous two values."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10084 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10084 "current"^^xsd:string)
Declaration(Class(goldbook:10085))
AnnotationAssertion(rdfs:label goldbook:10085 "biplot")
AnnotationAssertion(dcterms:description goldbook:10085 "Combination plot of a scores plot as points and loadings plot as vectors for common factors.")
AnnotationAssertion(rdfs:comment goldbook:10085 "The plots are scaled to facilitate interpretation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10085 "Points in the scores plot (objects) that fall on a loadings vector are considered to be characterised by the variable associated with the vector."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10085 goldbook:10096)
AnnotationAssertion(rdfs:seeAlso goldbook:10085 goldbook:10097)
AnnotationAssertion(rdfs:seeAlso goldbook:10085 goldbook:10113)
AnnotationAssertion(mito:isMentionedBy goldbook:10085 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10085 "current"^^xsd:string)
Declaration(Class(goldbook:10086))
AnnotationAssertion(rdfs:label goldbook:10086 "bootstrapping")
AnnotationAssertion(dcterms:description goldbook:10086 "Estimation of parameters by multiple re-sampling from measured data to approximate its distribution.")
AnnotationAssertion(rdfs:comment goldbook:10086 "Multiple resamples of the original data allow calculation of the distribution of a parameter of interest, and therefore its standard error (see example)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10086 "Random sampling with replacement is used when the data are assumed to be from an independent and identically-distributed population."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10086 "Bootstrapping is an alternative to cross validation in model validation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10086 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10086 "current"^^xsd:string)
Declaration(Class(goldbook:10087))
AnnotationAssertion(rdfs:label goldbook:10087 "canonical variables")
AnnotationAssertion(dcterms:description goldbook:10087 "Linear combinations of data with the greatest correlation.")
AnnotationAssertion(rdfs:seeAlso goldbook:10087 goldbook:10088)
AnnotationAssertion(mito:isMentionedBy goldbook:10087 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10087 "current"^^xsd:string)
Declaration(Class(goldbook:10088))
AnnotationAssertion(rdfs:label goldbook:10088 "canonical variate analysis")
AnnotationAssertion(dcterms:description goldbook:10088 "Multivariate technique which finds linear combinations of two sets of data that are most highly correlated.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10088 "canonical analysis")
AnnotationAssertion(rdfs:comment goldbook:10088 "The combinations with the greatest correlation, denoted U1 and V1 are known as the \"first canonical variables\". The next canonical functions, U2 and V2 are then restricted so that they are uncorrelated with U1 and V1. Everything is scaled so that the variance equals 1."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10088 "The relationship between the canonical variables is known as the canonical function."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10088 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10088 "current"^^xsd:string)
Declaration(Class(goldbook:10089))
AnnotationAssertion(rdfs:label goldbook:10089 "common factor analysis")
AnnotationAssertion(dcterms:description goldbook:10089 "Factor analysis in which latent variables are calculated that maximise the correlation with observed variables.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10089 "exploratory factor analysis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10089 "factor analysis")
AnnotationAssertion(rdfs:comment goldbook:10089 "The common factors are not unique. Typically factors are rotated so that the factors are more easily interpreted in terms of the original variables."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10089 goldbook:10093)
AnnotationAssertion(rdfs:seeAlso goldbook:10089 goldbook:10095)
AnnotationAssertion(mito:isMentionedBy goldbook:10089 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10089 "current"^^xsd:string)
Declaration(Class(goldbook:10090))
AnnotationAssertion(rdfs:label goldbook:10090 "core consistency diagnostic")
AnnotationAssertion(dcterms:description goldbook:10090 "Method to assess the appropriateness of a PARAFAC model.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10090 "CONCORDIA")
AnnotationAssertion(rdfs:comment goldbook:10090 "An appropriate PARAFAC model is a model where the components primarily reflect low-rank, trilinear variation in the data."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10090 "The principle of the method is to assess the degree of superdiagonality of the model."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10090 goldbook:10103)
AnnotationAssertion(mito:isMentionedBy goldbook:10090 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10090 "current"^^xsd:string)
Declaration(Class(goldbook:10091))
AnnotationAssertion(rdfs:label goldbook:10091 "correspondence factor analysis")
AnnotationAssertion(dcterms:description goldbook:10091 "Factor analysis applied to categorical data in which orthogonal factors are obtained from a contingency table.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10091 "correspondence analysis")
AnnotationAssertion(rdfs:seeAlso goldbook:10091 goldbook:10093)
AnnotationAssertion(mito:isMentionedBy goldbook:10091 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10091 "current"^^xsd:string)
Declaration(Class(goldbook:10092))
AnnotationAssertion(rdfs:label goldbook:10092 "evolving factor analysis")
AnnotationAssertion(dcterms:description goldbook:10092 "Factor analysis that follows the change or evolution of the rank of the data matrix as a function of an ordered variable.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10092 "EFA")
AnnotationAssertion(rdfs:comment goldbook:10092 "The ordering variable may be time."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10092 "The changing rank is calculated by principal-component analysis on an increasing data matrix."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10092 goldbook:10093)
AnnotationAssertion(rdfs:seeAlso goldbook:10092 goldbook:10106)
AnnotationAssertion(mito:isMentionedBy goldbook:10092 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10092 "current"^^xsd:string)
Declaration(Class(goldbook:10093))
AnnotationAssertion(rdfs:label goldbook:10093 "factor analysis")
AnnotationAssertion(dcterms:description goldbook:10093 "Matrix decomposition of a data matrix (\\(\\boldsymbol{X}\\)) into the product of a scores matrix (\\(\\boldsymbol{T}\\)) and the transpose of the loadings matrix (\\(\\boldsymbol{P}^{\\rm{T}}\\)).")
AnnotationAssertion(rdfs:comment goldbook:10093 "Hence \\(\\boldsymbol{X} = \\boldsymbol{TP}^{\\rm{T}} + \\boldsymbol{E}\\), where \\(\\boldsymbol{E}\\) is a residual matrix."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10093 "Factor analysis methods include common factor analysis (also called ‘factor analysis’), principal component analysis, and multivariate curve resolution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10093 "The number of factors selected in factor analysis is smaller than the rank of the data matrix."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10093 "Factor analysis is equivalent to a rotation in data space where the factors form the new axes. This is not necessarily rotation that maintains orthogonality except in the case of PCA."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10093 "The residual matrix contains data that are not described by the factor analysis model, and is usually assumed to contain noise."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10093 goldbook:10089)
AnnotationAssertion(rdfs:seeAlso goldbook:10093 goldbook:10047)
AnnotationAssertion(rdfs:seeAlso goldbook:10093 goldbook:10096)
AnnotationAssertion(rdfs:seeAlso goldbook:10093 goldbook:10100)
AnnotationAssertion(rdfs:seeAlso goldbook:10093 goldbook:10041)
AnnotationAssertion(rdfs:seeAlso goldbook:10093 goldbook:10106)
AnnotationAssertion(rdfs:seeAlso goldbook:10093 goldbook:10112)
AnnotationAssertion(mito:isMentionedBy goldbook:10093 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10093 "current"^^xsd:string)
Declaration(Class(goldbook:10094))
AnnotationAssertion(rdfs:label goldbook:10094 "<em>G</em>-fold cross validation")
AnnotationAssertion(dcterms:description goldbook:10094 "Cross validation of a data set of \\(N\\) objects in which \\(N/G\\) objects are removed at each iteration of the procedure.")
AnnotationAssertion(rdfs:comment goldbook:10094 "Objects 1 to \\(N/G\\) are removed on the first iteration, then objects \\(N/G + 1\\) to \\(2N/G\\) after replacement of the first \\(N/G\\) objects, and so on."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10094 "Because the perturbation of the model is larger than in leave-one-out cross validation, the prediction ability of the G-fold cross validation is less optimistic than obtained with leave-one-out cross validation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10094 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10094 "current"^^xsd:string)
Declaration(Class(goldbook:10095))
AnnotationAssertion(rdfs:label goldbook:10095 "latent variable")
AnnotationAssertion(dcterms:description goldbook:10095 "Variable that is inferred through a mathematical model from other variables that are observed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10095 "hidden variable")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10095 "latent construct")
AnnotationAssertion(rdfs:comment goldbook:10095 "The factors obtain from common factor analysis are termed latent variables."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10095 "A distinction can be made between ‘hidden variable’, which is considered to be an actual variable that is buried in the effects of other variables and noise, and a ‘latent variable’ that is entirely hypothetical."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10095 goldbook:10089)
AnnotationAssertion(rdfs:seeAlso goldbook:10095 goldbook:10041)
AnnotationAssertion(mito:isMentionedBy goldbook:10095 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10095 "current"^^xsd:string)
Declaration(Class(goldbook:10096))
AnnotationAssertion(rdfs:label goldbook:10096 "loadings")
AnnotationAssertion(dcterms:description goldbook:10096 "Projection of a factor onto the variables.")
AnnotationAssertion(rdfs:comment goldbook:10096 "\"Loadings\" (plural) refers to a column in the loadings matrix that relates to a particular factor. \"loading\" (singular) is the particular contribution of a variable in the original space to the factor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10096 "The loadings on a factor reflect the relationships between the variables on that factor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10096 "In principal component analysis the loadings are also the cosine angles between the variables and a particular factor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10096 "In multivariate curve resolution the term \"pure component spectrum\" is interchangeable with the term \"loading\" and is therefore deprecated. The term, in spectroscopy, may be confused with the spectrum for a pure material."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10096 goldbook:10100)
AnnotationAssertion(rdfs:seeAlso goldbook:10096 goldbook:10106)
AnnotationAssertion(rdfs:seeAlso goldbook:10096 goldbook:10112)
AnnotationAssertion(mito:isMentionedBy goldbook:10096 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10096 "current"^^xsd:string)
Declaration(Class(goldbook:10097))
AnnotationAssertion(rdfs:label goldbook:10097 "loadings plot")
AnnotationAssertion(dcterms:description goldbook:10097 "Plot of one loading against variable number, or two or three loadings against each other.")
AnnotationAssertion(rdfs:comment goldbook:10097 "Usually the loadings associated with the early factors (1, 2, 3) are plotted to reveal relationships among the variables."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10097 goldbook:10085)
AnnotationAssertion(rdfs:seeAlso goldbook:10097 goldbook:10096)
AnnotationAssertion(mito:isMentionedBy goldbook:10097 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10097 "current"^^xsd:string)
Declaration(Class(goldbook:10098))
AnnotationAssertion(rdfs:label goldbook:10098 "maximum likelihood principal component analysis")
AnnotationAssertion(dcterms:description goldbook:10098 "Principal-component analysis that incorporates information about measurement uncertainty to develop models that are optimal in a maximum likelihood sense.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10098 "MLPCA")
AnnotationAssertion(rdfs:seeAlso goldbook:10098 goldbook:10106)
AnnotationAssertion(mito:isMentionedBy goldbook:10098 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10098 "current"^^xsd:string)
Declaration(Class(goldbook:10099))
AnnotationAssertion(rdfs:label goldbook:10099 "mean squared error of prediction")
AnnotationAssertion(dcterms:description goldbook:10099 "In multivariate calibration the average of the squared deviation of estimated values from the values of evaluation data. For \\(N\\) evaluation data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the predicted value. \\[E_{\\rm{MSEP}} = \\frac{\\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i}\\,-\\, c_{i})^2}{N}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10099 "mean squared error of estimation")
AnnotationAssertion(rdfs:comment goldbook:10099 "Mean squared error of prediction is the square of root mean squared error of prediction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10099 goldbook:10050)
AnnotationAssertion(rdfs:seeAlso goldbook:10099 goldbook:10153)
AnnotationAssertion(rdfs:seeAlso goldbook:10099 goldbook:10110)
AnnotationAssertion(mito:isMentionedBy goldbook:10099 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10099 "current"^^xsd:string)
Declaration(Class(goldbook:10100))
AnnotationAssertion(rdfs:label goldbook:10100 "multivariate curve resolution")
AnnotationAssertion(dcterms:description goldbook:10100 "Factor analysis for the decomposition of multicomponent data into a linear sum of chemically-meaningful components when little or no prior information about the composition is available.")
AnnotationAssertion(rdfs:comment goldbook:10100 "MCR factors are extracted by the iterative minimization of the residual matrix using an alternating least squares approach, while applying suitable constraints, such as non-negativity, to the loadings and scores. MCR can be performed on the data matrix with or without data pre-processing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10100 "MCR factors are not unique but are dependent on initial estimates, the number of factors to be resolved, constraints applied and convergence criteria. MCR factors are not required to be orthogonal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10100 goldbook:10093)
AnnotationAssertion(rdfs:seeAlso goldbook:10100 goldbook:10083)
AnnotationAssertion(rdfs:seeAlso goldbook:10100 goldbook:10048)
AnnotationAssertion(mito:isMentionedBy goldbook:10100 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10100 "current"^^xsd:string)
Declaration(Class(goldbook:10101))
AnnotationAssertion(rdfs:label goldbook:10101 "non-linear iterative partial least squares")
AnnotationAssertion(dcterms:description goldbook:10101 "Iterative decomposition of a data matrix to give principal components.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10101 "NIPALS")
AnnotationAssertion(rdfs:comment goldbook:10101 "Writing the model as \\(\\boldsymbol{X} = \\boldsymbol{T}\\boldsymbol{P}^{\\rm{T}} + \\boldsymbol{E}\\), the first principal component is computed from a data matrix. The data explained by this PC are then subtracted from \\(\\boldsymbol{X}\\) and the algorithm applied again to residual data. The procedure is repeated until sufficient principal components are obtained."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10101 "The algorithm is very fast if only a few principal components are required, because the covariance matrix is not computed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10101 goldbook:10047)
AnnotationAssertion(rdfs:seeAlso goldbook:10101 goldbook:10107)
AnnotationAssertion(mito:isMentionedBy goldbook:10101 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10101 "current"^^xsd:string)
Declaration(Class(goldbook:10102))
AnnotationAssertion(rdfs:label goldbook:10102 "nonlinear mapping")
AnnotationAssertion(dcterms:description goldbook:10102 "Projection of objects defined in a multivariate space onto two- or three-dimensional space so that the distances between objects are preserved as well as possible.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10102 "NLM")
AnnotationAssertion(rdfs:comment goldbook:10102 "An often applied criterion for the mapping error (\\(E\\)) is the relative squared error between the true distance \\(d_{ij}\\) and mapped distance \\(\\delta_{ij}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10102 "Several iterative optimization procedures can be applied to minimize \\(E\\), such as steepest descent."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10102 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10102 "current"^^xsd:string)
Declaration(Class(goldbook:10103))
AnnotationAssertion(rdfs:label goldbook:10103 "parallel factors analysis")
AnnotationAssertion(dcterms:description goldbook:10103 "Decomposition of a three-way data matrix into the sum of sets of two-way loadings matrices.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10103 "canonical decomposition")
AnnotationAssertion(rdfs:comment goldbook:10103 "The PARAFAC model is also known as Canonical Decomposition (CANDECOMP)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10103 "A representation of PARAFAC is \\(x_{ijk} = \\sum\\limits_{r\\,=\\,1}^R a_{ir}b_{jr}c_{kr} + e_{ijk}\\), where \\(x_{ijk}\\) is \\(i\\),\\(j\\),\\(k\\)-th element of the data matrix, and \\(a_{ir}\\), \\(b_{jr}\\), \\(c_{kr}\\) are the components of the loadings matrices. \\(e_{ijk}\\) is the \\(i\\),\\(j\\),\\(k\\)-th element of residual matrix."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10103 "PARAFAC is a special case of the Tucker3 model (see Tucker tri-linear analysis) where the core matrix is the identity matrix, and \\(r = s = t = R\\) ."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10103 "A schematic representation of the PARAFAC model is "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10103 goldbook:10116)
AnnotationAssertion(rdfs:seeAlso goldbook:10103 goldbook:10096)
AnnotationAssertion(mito:isMentionedBy goldbook:10103 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10103 "current"^^xsd:string)
Declaration(Class(goldbook:10104))
AnnotationAssertion(rdfs:label goldbook:10104 "prediction error sum of squares")
AnnotationAssertion(dcterms:description goldbook:10104 "In multivariate calibration for a prediction set of \\(N\\) data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the predicted value. \\[E_{\\rm{PRESS}} = \\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i} - c_{i})^2\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10104 "residual sum of squares")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10104 "sum of squared errors of prediction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10104 "sum of squared residuals")
AnnotationAssertion(rdfs:seeAlso goldbook:10104 goldbook:10153)
AnnotationAssertion(rdfs:seeAlso goldbook:10104 goldbook:10110)
AnnotationAssertion(mito:isMentionedBy goldbook:10104 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10104 "current"^^xsd:string)
Declaration(Class(goldbook:10105))
AnnotationAssertion(rdfs:label goldbook:10105 "principal component-discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10105 "Discriminant analysis on a multivariate data set that has been subject to principal-component analysis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10105 "PC-DA")
AnnotationAssertion(rdfs:comment goldbook:10105 "This procedure removes collinearity from the multivariate data and ensures that the new predictor variables, which are PCA scores, are distributed normally."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10105 goldbook:10055)
AnnotationAssertion(rdfs:seeAlso goldbook:10105 goldbook:10106)
AnnotationAssertion(mito:isMentionedBy goldbook:10105 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10105 "current"^^xsd:string)
Declaration(Class(goldbook:10106))
AnnotationAssertion(rdfs:label goldbook:10106 "principal-component analysis")
AnnotationAssertion(dcterms:description goldbook:10106 "Factor analysis in which factors are calculated that successively capture the greatest variance in the data set.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10106 "PCA")
AnnotationAssertion(rdfs:comment goldbook:10106 "The factors are orthogonal and are known as principal-component factors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10106 "The factorization is written \\(\\boldsymbol{X} = \\boldsymbol{T}\\boldsymbol{P}^{\\rm{T}} + \\boldsymbol{E}\\), where \\(\\boldsymbol{T}\\) is the scores matrix, \\(\\boldsymbol{P}\\) is the loadings matrix and \\(\\boldsymbol{E}\\) is a residual matrix."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10106 "The term \"principal-component analysis\" is preferred to the plural \"principal-components analysis\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10106 goldbook:10093)
AnnotationAssertion(rdfs:seeAlso goldbook:10106 goldbook:10096)
AnnotationAssertion(rdfs:seeAlso goldbook:10106 goldbook:10101)
AnnotationAssertion(rdfs:seeAlso goldbook:10106 goldbook:10107)
AnnotationAssertion(rdfs:seeAlso goldbook:10106 goldbook:10112)
AnnotationAssertion(mito:isMentionedBy goldbook:10106 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10106 "current"^^xsd:string)
Declaration(Class(goldbook:10107))
AnnotationAssertion(rdfs:label goldbook:10107 "principal-component factor")
AnnotationAssertion(dcterms:description goldbook:10107 "Orthogonal factors obtained in a principal-component analysis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10107 "PC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10107 "principal component")
AnnotationAssertion(rdfs:comment goldbook:10107 "The successive factors explain reducing fractions of the variance of the data set, and are written PC1, PC2 …"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10107 "ISO 18115 recommends the use of the term \"PCA factor\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10107 goldbook:10106)
AnnotationAssertion(mito:isMentionedBy goldbook:10107 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10107 "current"^^xsd:string)
Declaration(Class(goldbook:10108))
AnnotationAssertion(rdfs:label goldbook:10108 "Procrustes analysis")
AnnotationAssertion(dcterms:description goldbook:10108 "Comparison of shapes of multi-dimensional objects by a series of geometrical transformations to minimise the sum of squared distances between the transformed and target structures while maintaining the internal structure of the objects.")
AnnotationAssertion(rdfs:comment goldbook:10108 "For two objects defined by \\(\\boldsymbol{X}\\) and \\(\\boldsymbol{Y}\\) the manipulation orthogonal rotation/reflection matrix \\(\\boldsymbol{R}\\) Procrustes analysis minimises: \\(\\parallel\\! \\boldsymbol{Y} - \\boldsymbol{X}\\boldsymbol{R}\\parallel^{2}\\) subject to \\(\\boldsymbol{R}^{\\rm{T}} \\boldsymbol{R} = \\boldsymbol{R} \\boldsymbol{R}^{\\rm{T}} = 1\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10108 "Ordinary, or classical, Procrustes analysis is when an object is compared to one other object, which may be a reference shape. Generalized Procrustes analysis compares three or more shapes to an optimally-determined mean shape."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10108 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10108 "current"^^xsd:string)
Declaration(Class(goldbook:10109))
AnnotationAssertion(rdfs:label goldbook:10109 "root mean square error of cross validation")
AnnotationAssertion(dcterms:description goldbook:10109 "Root mean square error of prediction when the predicted data is obtained by cross validation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10109 "RMSECV")
AnnotationAssertion(rdfs:seeAlso goldbook:10109 goldbook:10110)
AnnotationAssertion(mito:isMentionedBy goldbook:10109 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10109 "current"^^xsd:string)
Declaration(Class(goldbook:10110))
AnnotationAssertion(rdfs:label goldbook:10110 "root mean squared error of prediction")
AnnotationAssertion(dcterms:description goldbook:10110 "In multivariate calibration or classification for \\(N\\) evaluation data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the predicted value \\[E_{\\rm{RMSEP}} = \\sqrt {\\frac{\\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i}\\,-\\,c_{i})^2}{N}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10110 "root mean squared error of estimation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10110 "standard error of estimation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10110 "standard error of prediction")
AnnotationAssertion(rdfs:comment goldbook:10110 "RMSEP is related to the prediction error sum of squares (PRESS) by \\(E_{\\rm{RMSEP}} = \\sqrt \\frac{E_{\\rm{PRESS}}}{N}\\) ."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10110 "For completely independent, normally distributed evaluation data, RMSEP is a measure of the bias of the calibration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10110 "When prediction is by cross validation RMSEP may be termed root mean square error of cross validation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10110 goldbook:10050)
AnnotationAssertion(rdfs:seeAlso goldbook:10110 goldbook:10153)
AnnotationAssertion(mito:isMentionedBy goldbook:10110 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10110 "current"^^xsd:string)
Declaration(Class(goldbook:10111))
AnnotationAssertion(rdfs:label goldbook:10111 "simple-to-use interactive self-modelling mixture analysis")
AnnotationAssertion(dcterms:description goldbook:10111 "Interactive method to obtain concentrations and pure spectra from spectra of mixtures using directly-measured variables.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10111 "SIMPLISMA")
AnnotationAssertion(rdfs:comment goldbook:10111 "The directly-measured variables are called \"pure variables\" in the method."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10111 "A data matrix \\(\\boldsymbol{D} = \\boldsymbol{C} \\times \\boldsymbol{P}^{\\rm{T}} + \\boldsymbol{E}\\) where \\(\\boldsymbol{C}\\) is a concentration matrix, \\(\\boldsymbol{P}\\) pure spectra of mixture components and \\(\\boldsymbol{E}\\) an error matrix. Pure spectra are estimated \\(\\boldsymbol{\\hat Y}\\) which allows projection of a concentration matrix \\(\\boldsymbol{C^{\\ast}}\\) from which the data matrix can be reconstructed and compared with the measured spectra. \\[\\left\\{ {\\matrix{ {\\boldsymbol{\\hat P} = \\boldsymbol{D}^{\\rm{T}} \\boldsymbol{C}(\\boldsymbol{C}^{\\rm{T}}\\boldsymbol{C})}^{-1} \\cr {\\boldsymbol{C^{*}} = \\boldsymbol{C}\\boldsymbol{\\hat P}(\\boldsymbol{\\hat P}^{\\rm{T}}\\boldsymbol{\\hat P})}^{-1} \\cr}} \\right. {\\rm{then}}\\;{\\boldsymbol{D}_{{\\rm{recon}}}} = \\boldsymbol{C^{*}} \\times \\boldsymbol{\\hat P}^{\\rm{T}}\\]"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10111 "Second derivatives of spectra can be used for modelling."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10111 goldbook:10047)
AnnotationAssertion(mito:isMentionedBy goldbook:10111 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10111 "current"^^xsd:string)
Declaration(Class(goldbook:10112))
AnnotationAssertion(rdfs:label goldbook:10112 "score")
AnnotationAssertion(dcterms:description goldbook:10112 "Factor analysis projection of an object onto a factor.")
AnnotationAssertion(rdfs:comment goldbook:10112 "In principal-component analysis, the factors are orthogonal and the scores are an orthogonal projection of the objects onto a factor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10112 "The scores on a factor reflect the relationships between objects for that factor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10112 "The term scores (plural) refers to a whole column in the scores matrix that relates to a particular factor. The term score (singular) is the projection of a particular object onto the factor."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10112 goldbook:10093)
AnnotationAssertion(rdfs:seeAlso goldbook:10112 goldbook:10096)
AnnotationAssertion(rdfs:seeAlso goldbook:10112 goldbook:10106)
AnnotationAssertion(mito:isMentionedBy goldbook:10112 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10112 "current"^^xsd:string)
Declaration(Class(goldbook:10113))
AnnotationAssertion(rdfs:label goldbook:10113 "scores plot")
AnnotationAssertion(dcterms:description goldbook:10113 "Plot of one score against object number, or two or three scores against each other.")
AnnotationAssertion(rdfs:comment goldbook:10113 "Usually the scores associated with the early factors (1, 2, 3) are plotted to reveal relationships among the objects."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10113 goldbook:10085)
AnnotationAssertion(rdfs:seeAlso goldbook:10113 goldbook:10097)
AnnotationAssertion(rdfs:seeAlso goldbook:10113 goldbook:10112)
AnnotationAssertion(mito:isMentionedBy goldbook:10113 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10113 "current"^^xsd:string)
Declaration(Class(goldbook:10114))
AnnotationAssertion(rdfs:label goldbook:10114 "simulated annealing")
AnnotationAssertion(dcterms:description goldbook:10114 "Generic probabilistic meta-heuristic to locate a good approximation to the global optimum of a given function in a large search space, in which there is a slow decrease in the probability of accepting worse solutions as the solution space is explored.")
AnnotationAssertion(rdfs:comment goldbook:10114 "The function \\(E(\\rm{s})\\) to be minimized is analogous to the internal energy of the system in that state. The goal is to bring the system, from an arbitrary initial state, to a state with the minimum possible energy. At each step, the heuristic considers some neighbouring state \\(s^{\\prime}\\) of the current state \\(s\\), and probabilistically decides between moving the system to state \\(s^{\\prime}\\) or staying in state \\(s\\). These probabilities ultimately lead the system to move to states of lower energy. Typically this step is repeated until the system reaches a state that is good enough for the application, or until a given computation budget has been exhausted."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10114 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10114 "current"^^xsd:string)
Declaration(Class(goldbook:10115))
AnnotationAssertion(rdfs:label goldbook:10115 "singular value decomposition")
AnnotationAssertion(dcterms:description goldbook:10115 "A factorization of an \\(m \\times n\\) matrix (\\(\\boldsymbol{M}\\)) such that \\(\\boldsymbol{M} = \\boldsymbol{U}\\boldsymbol{\\Sigma} \\boldsymbol{V}^{T}\\), where \\(\\boldsymbol{U}\\) is an \\(m \\times m\\) matrix, \\(\\boldsymbol{\\Sigma}\\) is a \\(m \\times n\\) matrix and \\(\\boldsymbol{V}^{\\rm{T}}\\) is a \\(n \\times n\\) matrix.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10115 "SVD")
AnnotationAssertion(rdfs:comment goldbook:10115 "If \\(\\boldsymbol{M}\\) is a data matrix with \\(m\\) objects and \\(n\\) variables, the matrix \\(\\boldsymbol{U}\\) is the scores matrix, the diagonal of \\(\\boldsymbol{\\Sigma}\\) contain the square roots of the eigenvalues and \\(\\boldsymbol{V}\\) is the loadings matrix."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10115 goldbook:10047)
AnnotationAssertion(rdfs:seeAlso goldbook:10115 goldbook:10096)
AnnotationAssertion(rdfs:seeAlso goldbook:10115 goldbook:10112)
AnnotationAssertion(mito:isMentionedBy goldbook:10115 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10115 "current"^^xsd:string)
Declaration(Class(goldbook:10116))
AnnotationAssertion(rdfs:label goldbook:10116 "Tucker tri-linear analysis")
AnnotationAssertion(dcterms:description goldbook:10116 "Decomposition of a three-way data matrix into a three-way core matrix, and three, two-way loadings matrices.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10116 "Tucker3 model")
AnnotationAssertion(rdfs:comment goldbook:10116 "A representation of the Tucker3 model is \\[x_{ijk} = \\sum\\limits_{r\\,=\\,1}^R \\sum\\limits_{s\\,=\\,1}^S \\sum\\limits_{t\\,=\\,1}^T a_{ir}b_{js}{c_{kt}z_{rst} + e_{ijk}}\\] where \\(x_{ijk}\\) is the data matrix, \\(a_{ir}\\), \\(b_{js}\\), \\(c_{kt}\\) are the loadings matrices, and \\(z_{rst}\\) is the core matrix. \\(e_{ijk}\\) is the residual matrix."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10116 "A graphical representation of the Tucker3 model is "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10116 goldbook:10103)
AnnotationAssertion(mito:isMentionedBy goldbook:10116 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10116 "current"^^xsd:string)
Declaration(Class(goldbook:10117))
AnnotationAssertion(rdfs:label goldbook:10117 "backward chaining")
AnnotationAssertion(dcterms:description goldbook:10117 "Inference method from hypothesis to data that supports the hypothesis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10117 "back chaining")
AnnotationAssertion(rdfs:comment goldbook:10117 "Backward chaining is used in backward propagation to train an artificial neural network."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10117 goldbook:10118)
AnnotationAssertion(mito:isMentionedBy goldbook:10117 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10117 "current"^^xsd:string)
Declaration(Class(goldbook:10118))
AnnotationAssertion(rdfs:label goldbook:10118 "backward propagation")
AnnotationAssertion(dcterms:description goldbook:10118 "Supervised classification method for an artificial neural network in which weights of connections between nodes are calculated from the known output layer back to the input layer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10118 "back-propagation learning rule")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10118 "back-propagation of errors")
AnnotationAssertion(rdfs:seeAlso goldbook:10118 goldbook:10144)
AnnotationAssertion(mito:isMentionedBy goldbook:10118 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10118 "current"^^xsd:string)
Declaration(Class(goldbook:10119))
AnnotationAssertion(rdfs:label goldbook:10119 "backward stepwise linear discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10119 "Linear discriminant analysis in which variables to build the discriminant functions are removed one at a time to minimise the loss of discrimination, until there is a significant loss.")
AnnotationAssertion(rdfs:comment goldbook:10119 "Significant loss is tested by an F-test"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10119 "Interrelationships between variables that have not yet been selected are ignored, and variables already added, which may become largely redundant through subsequent additions, cannot be removed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10119 goldbook:10133)
AnnotationAssertion(rdfs:seeAlso goldbook:10119 goldbook:10126)
AnnotationAssertion(mito:isMentionedBy goldbook:10119 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10119 "current"^^xsd:string)
Declaration(Class(goldbook:10120))
AnnotationAssertion(rdfs:label goldbook:10120 "city-block distance")
AnnotationAssertion(dcterms:description goldbook:10120 "Distance (\\(d_{i,j}\\)) between two objects (\\(i\\) and \\(j\\)) calculated as the sum of the absolute difference between \\(k\\) variables (\\(x\\)) that describe the objects. \\[d_{i,j} = \\sum\\limits_{k\\,=\\,1}^{k\\,=\\,N} \\vert x_{i,k} - x_{j,k}\\vert\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10120 "Hamming distance")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10120 "Manhattan distance")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10120 "taxi distance")
AnnotationAssertion(mito:isMentionedBy goldbook:10120 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10120 "current"^^xsd:string)
Declaration(Class(goldbook:10121))
AnnotationAssertion(rdfs:label goldbook:10121 "complete linkage")
AnnotationAssertion(dcterms:description goldbook:10121 "Linkage criterion in hierarchical clustering in which the distance between two clusters is the distance between those two objects (one from each cluster) that are farthest apart.")
AnnotationAssertion(rdfs:comment goldbook:10121 "Complete linkage tends to find compact clusters of approximately equal size."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10121 goldbook:10129)
AnnotationAssertion(mito:isMentionedBy goldbook:10121 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10121 "current"^^xsd:string)
Declaration(Class(goldbook:10122))
AnnotationAssertion(rdfs:label goldbook:10122 "dendrogram")
AnnotationAssertion(dcterms:description goldbook:10122 "Tree diagram used to illustrate the arrangement of clusters produced by hierarchical clustering.")
AnnotationAssertion(rdfs:comment goldbook:10122 "The objects are successively grouped (or un-grouped) in each layer of the dendrogram, where the length of the linking lines is proportional to the dissimilarity of the objects."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10122 goldbook:10129)
AnnotationAssertion(mito:isMentionedBy goldbook:10122 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10122 "current"^^xsd:string)
Declaration(Class(goldbook:10123))
AnnotationAssertion(rdfs:label goldbook:10123 "disjoint principal component analysis")
AnnotationAssertion(dcterms:description goldbook:10123 "Principal-component analysis (PCA) independently performed on each class as a step in classification.")
AnnotationAssertion(rdfs:comment goldbook:10123 "Soft independent modelling of class analogy is an example of the use of disjoint principal component analysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10123 "When a PCA model is obtained using all classes, it is known as conjoint PCA."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10123 goldbook:10106)
AnnotationAssertion(rdfs:seeAlso goldbook:10123 goldbook:10143)
AnnotationAssertion(mito:isMentionedBy goldbook:10123 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10123 "current"^^xsd:string)
Declaration(Class(goldbook:10124))
AnnotationAssertion(rdfs:label goldbook:10124 "Euclidean distance")
AnnotationAssertion(dcterms:description goldbook:10124 "Distance (\\(d_{i,j}\\)) between two objects (\\(i\\) and \\(j\\)) calculated as the square root of the sum of the squared differences between \\(k\\) variables (\\(x\\)) that describe the objects. \\[d_{i,j} = \\sqrt {\\sum\\limits_{k\\,=\\,1}^{k\\,=\\,N} (x_{i,k} - x_{j,k})^2}\\]")
AnnotationAssertion(mito:isMentionedBy goldbook:10124 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10124 "current"^^xsd:string)
Declaration(Class(goldbook:10125))
AnnotationAssertion(rdfs:label goldbook:10125 "forward chaining")
AnnotationAssertion(dcterms:description goldbook:10125 "Inference method from data to hypothesis.")
AnnotationAssertion(rdfs:comment goldbook:10125 "In logic, forward chaining is the application of modus ponens (if \\(\\rm{P}\\) implies \\(\\rm{Q}\\), given \\(\\rm{P}\\) then \\(\\rm{Q}\\))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10125 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10125 "current"^^xsd:string)
Declaration(Class(goldbook:10126))
AnnotationAssertion(rdfs:label goldbook:10126 "forward stepwise linear discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10126 "Linear discriminant analysis in which variables to build the discriminant functions are introduced one at a time to maximise the discrimination, until there is no significant improvement.")
AnnotationAssertion(rdfs:comment goldbook:10126 "Significant improvement is usually tested by an F-test"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10126 "Interrelationships between variables that have not yet been selected are ignored, and variables already added, which may become largely redundant through subsequent additions, cannot be removed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10126 goldbook:10133)
AnnotationAssertion(rdfs:seeAlso goldbook:10126 goldbook:10119)
AnnotationAssertion(mito:isMentionedBy goldbook:10126 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10126 "current"^^xsd:string)
Declaration(Class(goldbook:10127))
AnnotationAssertion(rdfs:label goldbook:10127 "fuzzy clustering")
AnnotationAssertion(dcterms:description goldbook:10127 "Classification in which membership of an object in each possible class is given a weight between zero and one.")
AnnotationAssertion(rdfs:comment goldbook:10127 "In so-called hard cluster algorithms membership of a group can only take values 0 or 1, but in fuzzy clustering any value between 0 and 1 is allowed subject to the sum of all memberships of an object being 1."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10127 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10127 "current"^^xsd:string)
Declaration(Class(goldbook:10128))
AnnotationAssertion(rdfs:label goldbook:10128 "hidden layer")
AnnotationAssertion(dcterms:description goldbook:10128 "Group of nodes in an artificial neural network between input layer and output layer.")
AnnotationAssertion(rdfs:seeAlso goldbook:10128 goldbook:10137)
AnnotationAssertion(mito:isMentionedBy goldbook:10128 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10128 "current"^^xsd:string)
Declaration(Class(goldbook:10129))
AnnotationAssertion(rdfs:label goldbook:10129 "hierarchical clustering")
AnnotationAssertion(dcterms:description goldbook:10129 "Pattern recognition in which objects are linked together by use of an appropriate measure of distance between pairs of objects, and a linkage criterion, which specifies the dissimilarity of sets as a function of the pairwise distances between objects.")
AnnotationAssertion(rdfs:comment goldbook:10129 "Distance measures include Euclidean distance, Mahalanobis distance and city-block distance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10129 "Linkage criteria include single linkage, complete linkage."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10129 goldbook:10124)
AnnotationAssertion(rdfs:seeAlso goldbook:10129 goldbook:10134)
AnnotationAssertion(rdfs:seeAlso goldbook:10129 goldbook:10148)
AnnotationAssertion(rdfs:seeAlso goldbook:10129 goldbook:10120)
AnnotationAssertion(rdfs:seeAlso goldbook:10129 goldbook:10121)
AnnotationAssertion(rdfs:seeAlso goldbook:10129 goldbook:10142)
AnnotationAssertion(mito:isMentionedBy goldbook:10129 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10129 "current"^^xsd:string)
Declaration(Class(goldbook:10130))
AnnotationAssertion(rdfs:label goldbook:10130 "<em>k</em>-means clustering")
AnnotationAssertion(dcterms:description goldbook:10130 "Unsupervised classification method which partitions objects into \\(k\\) groups, in which each object belongs to the group with the nearest mean.")
AnnotationAssertion(rdfs:comment goldbook:10130 "Although \\(k\\)-means clustering is called unsupervised classification the value of \\(k\\) may be specified."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10130 goldbook:10146)
AnnotationAssertion(mito:isMentionedBy goldbook:10130 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10130 "current"^^xsd:string)
Declaration(Class(goldbook:10131))
AnnotationAssertion(rdfs:label goldbook:10131 "<em>k</em>-nearest neighbour")
AnnotationAssertion(dcterms:description goldbook:10131 "Non-parametric supervised classification method for objects based on the closest training examples in the variable space.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10131 "kNN")
AnnotationAssertion(rdfs:comment goldbook:10131 "An object is classified by a majority vote of its \\(k\\)-nearest neighbours, with the object being assigned to the class most common."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10131 "\\(k\\) is a small positive integer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10131 "When \\(k = 1\\) the method is known as \"nearest neighbour\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10131 goldbook:10144)
AnnotationAssertion(mito:isMentionedBy goldbook:10131 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10131 "current"^^xsd:string)
Declaration(Class(goldbook:10132))
AnnotationAssertion(rdfs:label goldbook:10132 "Kohonen network")
AnnotationAssertion(dcterms:description goldbook:10132 "Type of self-organising map with low dimensional grid.")
AnnotationAssertion(mito:isMentionedBy goldbook:10132 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10132 "current"^^xsd:string)
Declaration(Class(goldbook:10133))
AnnotationAssertion(rdfs:label goldbook:10133 "linear discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10133 "Discriminant analysis in which the criterion function is based on the pooled covariance matrix.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10133 "LDA")
AnnotationAssertion(mito:isMentionedBy goldbook:10133 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10133 "current"^^xsd:string)
Declaration(Class(goldbook:10134))
AnnotationAssertion(rdfs:label goldbook:10134 "Mahalanobis distance")
AnnotationAssertion(dcterms:description goldbook:10134 "Distance (\\(d_{i,j}\\)) between an object characterised by vector of variables \\(\\boldsymbol{x}_{i}\\) and the centroid of a class \\(\\boldsymbol{\\mu}_{j}\\) with covariance matrix \\(\\boldsymbol{S}\\) calculated as \\[d_{i,j} = \\sqrt {(\\boldsymbol{x}_{i} - \\boldsymbol{\\mu}_{j})^T \\boldsymbol{S}^{-1}(\\boldsymbol{x}_{i} - \\boldsymbol{\\mu}_{j})}\\] where \\(\\boldsymbol{S}\\) is the covariance matrix of the variables.")
AnnotationAssertion(mito:isMentionedBy goldbook:10134 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10134 "current"^^xsd:string)
Declaration(Class(goldbook:10135))
AnnotationAssertion(rdfs:label goldbook:10135 "misclassification rate")
AnnotationAssertion(dcterms:description goldbook:10135 "Fraction of objects incorrectly assigned to a group in supervised classification.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10135 "misclassification frequency")
AnnotationAssertion(rdfs:comment goldbook:10135 "Misclassification rate may be calculated for an evaluation data set, or in leave-one-out cross validation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10135 "Misclassification rate is an estimate of the misclassification probability."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10135 goldbook:10050)
AnnotationAssertion(rdfs:seeAlso goldbook:10135 goldbook:10144)
AnnotationAssertion(mito:isMentionedBy goldbook:10135 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10135 "current"^^xsd:string)
Declaration(Class(goldbook:10136))
AnnotationAssertion(rdfs:label goldbook:10136 "one-class classification")
AnnotationAssertion(dcterms:description goldbook:10136 "Classification identifying objects of a specific class amongst all objects, by learning from training data containing only objects of the specific class.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10136 "independent classification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10136 "unary classification")
AnnotationAssertion(rdfs:comment goldbook:10136 "The assignment of an object to a group may be in the form of a probability of membership."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10136 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10136 "current"^^xsd:string)
Declaration(Class(goldbook:10137))
AnnotationAssertion(rdfs:label goldbook:10137 "node")
AnnotationAssertion(dcterms:description goldbook:10137 "Locations in an artificial neural network that carry values that are calculated from values of connected nodes and weights by a transfer.")
AnnotationAssertion(rdfs:comment goldbook:10137 "Nodes are arranged in layers, input, hidden and output."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10137 "The value of a node is used in the calculation of nodes in subsequent layers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10137 goldbook:10128)
AnnotationAssertion(mito:isMentionedBy goldbook:10137 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10137 "current"^^xsd:string)
Declaration(Class(goldbook:10138))
AnnotationAssertion(rdfs:label goldbook:10138 "partial least squares discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10138 "Linear classification in which the criterion function is obtained by partial least squares analysis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10138 "PLS-DA")
AnnotationAssertion(rdfs:comment goldbook:10138 "PLS-DA can also be useful for exploratory data analysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10138 "PLS-DA results depend on data pre-processing and choice of parameters and so is believed to be more difficult to implement well than other forms of discriminant analysis such as linear discriminant analysis, quadratic discriminant analysis or regularized discriminant analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10138 goldbook:10048)
AnnotationAssertion(rdfs:seeAlso goldbook:10138 goldbook:10052)
AnnotationAssertion(rdfs:seeAlso goldbook:10138 goldbook:10133)
AnnotationAssertion(rdfs:seeAlso goldbook:10138 goldbook:10155)
AnnotationAssertion(rdfs:seeAlso goldbook:10138 goldbook:10139)
AnnotationAssertion(rdfs:seeAlso goldbook:10138 goldbook:10140)
AnnotationAssertion(mito:isMentionedBy goldbook:10138 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10138 "current"^^xsd:string)
Declaration(Class(goldbook:10139))
AnnotationAssertion(rdfs:label goldbook:10139 "quadratic discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10139 "Discriminant analysis in which the criterion function is based on the individual within-group covariance matrix.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10139 "QDA")
AnnotationAssertion(mito:isMentionedBy goldbook:10139 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10139 "current"^^xsd:string)
Declaration(Class(goldbook:10140))
AnnotationAssertion(rdfs:label goldbook:10140 "regularized discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10140 "Discriminant analysis in which the criterion function is based on a combination of pooled covariance matrix and the individual within-group covariance matrix.")
AnnotationAssertion(rdfs:comment goldbook:10140 "The covariance matrix (\\(\\sum_{k}(\\lambda)\\)) is related to the class covariance matrix (\\(\\sum_{k}\\)) and the pooled covariance matrix (\\(\\sum_{\\rm{pooled}}\\)) by \\(\\sum_{k}(\\lambda) = (1 - \\lambda)\\sum_{k} + \\lambda\\sum_{\\rm{pooled}}\\)"^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10140 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10140 "current"^^xsd:string)
Declaration(Class(goldbook:10141))
AnnotationAssertion(rdfs:label goldbook:10141 "similarity index")
AnnotationAssertion(dcterms:description goldbook:10141 "Quantity that describes the equivalence of two objects characterised by multivariate data.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10141 "similarity distance")
AnnotationAssertion(rdfs:comment goldbook:10141 "A similarity index may be in the interval, where 0 is complete dissimilarity and 1 is complete equivalence."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10141 "When the term \"distance\" is used the quantity is some function of the differences of coordinates in the multivariate data space."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10141 goldbook:10124)
AnnotationAssertion(rdfs:seeAlso goldbook:10141 goldbook:10134)
AnnotationAssertion(rdfs:seeAlso goldbook:10141 goldbook:10145)
AnnotationAssertion(rdfs:seeAlso goldbook:10141 goldbook:10148)
AnnotationAssertion(rdfs:seeAlso goldbook:10141 goldbook:10120)
AnnotationAssertion(rdfs:seeAlso goldbook:10141 goldbook:10055)
AnnotationAssertion(mito:isMentionedBy goldbook:10141 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10141 "current"^^xsd:string)
Declaration(Class(goldbook:10142))
AnnotationAssertion(rdfs:label goldbook:10142 "single linkage")
AnnotationAssertion(dcterms:description goldbook:10142 "Linkage criterion in hierarchical clustering in which the distance between two clusters is the distance between those two objects (one from each cluster) that are closest together.")
AnnotationAssertion(rdfs:comment goldbook:10142 "A drawback of this method is the so-called chaining phenomenon, which refers to the gradual growth of a cluster as one element at a time gets added to it. This may lead to impractically heterogeneous clusters and difficulties in defining classes that could usefully subdivide the data."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10142 goldbook:10129)
AnnotationAssertion(mito:isMentionedBy goldbook:10142 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10142 "current"^^xsd:string)
Declaration(Class(goldbook:10143))
AnnotationAssertion(rdfs:label goldbook:10143 "soft independent modelling of class analogy")
AnnotationAssertion(dcterms:description goldbook:10143 "Supervised classification that performs a principal-component analysis on each class, and then an unknown is assigned to the class with which it has the lowest residual variance.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10143 "SIMCA")
AnnotationAssertion(rdfs:comment goldbook:10143 "The number of principal-component factors chosen for each class is determined by cross validation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10143 "SIMCA is an example of the use of disjoint principal component analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10143 goldbook:10144)
AnnotationAssertion(rdfs:seeAlso goldbook:10143 goldbook:10123)
AnnotationAssertion(rdfs:seeAlso goldbook:10143 goldbook:10106)
AnnotationAssertion(rdfs:seeAlso goldbook:10143 goldbook:10107)
AnnotationAssertion(mito:isMentionedBy goldbook:10143 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10143 "current"^^xsd:string)
Declaration(Class(goldbook:10144))
AnnotationAssertion(rdfs:label goldbook:10144 "supervised classification")
AnnotationAssertion(dcterms:description goldbook:10144 "Classification in which, in a first step, a model is built using data from objects of known classes, and in a second step, the model is applied to new data to assign a class to unknown objects.")
AnnotationAssertion(rdfs:comment goldbook:10144 "Algorithms for supervised classification include discriminant analysis, support vector machine, artificial neural network, Bayesian classifier."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10144 goldbook:10077)
AnnotationAssertion(mito:isMentionedBy goldbook:10144 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10144 "current"^^xsd:string)
Declaration(Class(goldbook:10145))
AnnotationAssertion(rdfs:label goldbook:10145 "Tanimoto similarity index")
AnnotationAssertion(dcterms:description goldbook:10145 "Fraction of variables that are considered to agree between two objects.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10145 "Tanimoto index")
AnnotationAssertion(rdfs:comment goldbook:10145 "The rules for agreement must be defined. For example in an elemental analysis, element concentrations equivalent within \\(\\pu{20\\%}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10145 "The Tanimoto index is used in drug discovery and QSAR for comparison of structures in large data bases in an efficient way."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10145 "The Tanimoto index is essentially similar to the Jaccard index. (See https://en.wikipedia.org/wiki/Jaccard_index)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10145 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10145 "current"^^xsd:string)
Declaration(Class(goldbook:10146))
AnnotationAssertion(rdfs:label goldbook:10146 "unsupervised classification")
AnnotationAssertion(dcterms:description goldbook:10146 "Classification in which no prior information about membership of groups is known.")
AnnotationAssertion(rdfs:comment goldbook:10146 "The number of groups may be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10146 "Algorithms for unsupervised classification include k-means cluster analysis, hierarchical cluster analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10146 goldbook:10129)
AnnotationAssertion(rdfs:seeAlso goldbook:10146 goldbook:10130)
AnnotationAssertion(mito:isMentionedBy goldbook:10146 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10146 "current"^^xsd:string)
Declaration(Class(goldbook:10147))
AnnotationAssertion(rdfs:label goldbook:10147 "unweighted pair group method with arithmetic mean")
AnnotationAssertion(dcterms:description goldbook:10147 "Linkage criterion in hierarchical clustering in which the distance between two clusters is the average of all distances between pairs of objects.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10147 "UPGMA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10147 "average linkage")
AnnotationAssertion(rdfs:seeAlso goldbook:10147 goldbook:10129)
AnnotationAssertion(mito:isMentionedBy goldbook:10147 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10147 "current"^^xsd:string)
Declaration(Class(goldbook:10148))
AnnotationAssertion(rdfs:label goldbook:10148 "Ward’s minimum variance method")
AnnotationAssertion(dcterms:description goldbook:10148 "Linkage criterion in hierarchical clustering in which the within-cluster variance is minimized.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10148 "Ward’s method")
AnnotationAssertion(rdfs:comment goldbook:10148 "The initial cluster distances in Ward’s minimum variance method are the squared Euclidean distance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10148 goldbook:10124)
AnnotationAssertion(rdfs:seeAlso goldbook:10148 goldbook:10129)
AnnotationAssertion(mito:isMentionedBy goldbook:10148 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10148 "current"^^xsd:string)
Declaration(Class(goldbook:10149))
AnnotationAssertion(rdfs:label goldbook:10149 "least squares regression")
AnnotationAssertion(dcterms:description goldbook:10149 "Regression that minimizes the sum of squared differences between observed values of a variable and the values predicted by a model.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10149 "LSR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10149 "LS regression")
AnnotationAssertion(rdfs:comment goldbook:10149 "Least squares regression is used as a synonym for ordinary least squares regression. The full term should be used if there is ambiguity about the kind of regression being performed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10149 goldbook:10154)
AnnotationAssertion(mito:isMentionedBy goldbook:10149 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10149 "current"^^xsd:string)
Declaration(Class(goldbook:10150))
AnnotationAssertion(rdfs:label goldbook:10150 "errors-in-variables regression")
AnnotationAssertion(dcterms:description goldbook:10150 "Least squares regression in which both the response variable and predictor variable have measurement error.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10150 "total least squares regression")
AnnotationAssertion(rdfs:comment goldbook:10150 "The model for EIV regression is \\[\\left\\{\\matrix{c_{i} = \\alpha + \\beta x_{i}^{*} + \\varepsilon_{i} \\cr x_{i} = x_{i}^{*} + \\eta_{i} \\cr}\\right.\\] where \\(x^{*}\\) is the true value of the predictor variable, \\(c_{i}\\) concentration and \\(\\varepsilon\\) and \\(\\eta\\) are errors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10150 "When the errors \\(\\varepsilon\\) and \\(\\eta\\) have the same variance the method is called orthogonal regression and minimises the perpendicular distance of a point to the regression line."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10150 "Total least squares regression is performed by singular value decomposition."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10150 goldbook:10115)
AnnotationAssertion(mito:isMentionedBy goldbook:10150 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10150 "current"^^xsd:string)
Declaration(Class(goldbook:10151))
AnnotationAssertion(rdfs:label goldbook:10151 "mean squared error of calibration")
AnnotationAssertion(dcterms:description goldbook:10151 "In calibration for \\(N\\) calibration data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the value predicted by the calibration function. \\[E_{\\rm{MSEC}} = \\frac{\\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i} - c_{i})^2}{N}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10151 "mean residual sum of squares")
AnnotationAssertion(rdfs:comment goldbook:10151 "Mean squared error of calibration is the square of the root mean squared error of calibration."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10151 goldbook:10157)
AnnotationAssertion(mito:isMentionedBy goldbook:10151 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10151 "current"^^xsd:string)
Declaration(Class(goldbook:10152))
AnnotationAssertion(rdfs:label goldbook:10152 "multilinear least squares regression")
AnnotationAssertion(dcterms:description goldbook:10152 "Multivariate calibration in which the coefficients of the regression are calculated directly from the indications and values of standards.")
AnnotationAssertion(rdfs:comment goldbook:10152 "In \\(\\boldsymbol{X} \\boldsymbol{b} = \\boldsymbol{c} + \\boldsymbol{e}\\) (where \\(\\boldsymbol{X}\\) is a vector of indications, \\(\\boldsymbol{b}\\) are coefficients of the model, \\(\\boldsymbol{c}\\) is a vector of values of the quantity of interest and \\(\\boldsymbol{e}\\) a vector of errors), \\(\\boldsymbol{b} = \\boldsymbol{X^{+}} \\boldsymbol{c}\\), where \\(\\boldsymbol{X^{+}}\\) is the pseudo-inverse of \\(\\boldsymbol{X}\\), calculated as \\(\\boldsymbol{X^{+}} = (\\boldsymbol{X}^{\\rm{T}} \\boldsymbol{X})^{-1} \\boldsymbol{X}^{\\rm{T}}\\)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10152 "It is assumed that \\(\\boldsymbol{X}^{\\rm{T}} \\boldsymbol{X}\\) has full rank, i.e. there are more objects than variables, and the variables are independent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10152 "If \\(\\boldsymbol{X}^{\\rm{T}} \\boldsymbol{X}\\) has full rank only because of noise, the solution can become unstable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10152 goldbook:10153)
AnnotationAssertion(rdfs:seeAlso goldbook:10152 goldbook:10041)
AnnotationAssertion(mito:isMentionedBy goldbook:10152 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10152 "current"^^xsd:string)
Declaration(Class(goldbook:10153))
AnnotationAssertion(rdfs:label goldbook:10153 "multivariate calibration")
AnnotationAssertion(dcterms:description goldbook:10153 "Calibration in which the indications are multivariate data.")
AnnotationAssertion(rdfs:comment goldbook:10153 "In multivariate regression and calibration the problem is usually posed as a relation between the indications \\(\\boldsymbol{X}\\) (which are multivariate) and the property to be measured \\(\\boldsymbol{y}\\). Note that this is a reversal of the traditional form, \\(x\\) (concentration)/\\(y\\ (\\rm{g})\\) (indication) of linear calibration. \\(\\boldsymbol{X}\\) is a vector of observations (indications), and \\(\\boldsymbol{c}\\) a vector of concentrations. In matrix form: \\(\\boldsymbol{X} \\boldsymbol{b} = \\boldsymbol{c} + \\boldsymbol{e}\\) where \\(\\boldsymbol{b}\\) are the coefficients of the model and \\(\\boldsymbol{e}\\) is a vector of errors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10153 "Regression establishes the coefficients \\(\\boldsymbol{b}\\) (\\(\\boldsymbol{X} \\boldsymbol{b} = \\boldsymbol{c} + \\boldsymbol{e}\\)) from given indications \\(\\boldsymbol{X}\\), or some factorization of \\(\\boldsymbol{X}\\), and values \\(\\boldsymbol{c}\\), or some factorization of \\(\\boldsymbol{c}\\). Given indications \\(\\boldsymbol{X}_{\\rm{u}}\\) from an unknown sample, the quantity value \\(c_{\\rm{u}}\\) can be calculated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10153 goldbook:10055)
AnnotationAssertion(mito:isMentionedBy goldbook:10153 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10153 "current"^^xsd:string)
Declaration(Class(goldbook:10154))
AnnotationAssertion(rdfs:label goldbook:10154 "ordinary least squares regression")
AnnotationAssertion(dcterms:description goldbook:10154 "Least squares regression that minimizes the sum of squared differences between the known values of dependent variable and values predicted by a linear model.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10154 "OLSR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10154 "classical least squares regression")
AnnotationAssertion(rdfs:comment goldbook:10154 "Assumptions of the model are that error is only in the dependent variable, Normally-distributed, and homoscedastic."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10154 "OLSR is used for calibration and multivariate calibration."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10154 goldbook:10149)
AnnotationAssertion(rdfs:seeAlso goldbook:10154 goldbook:10153)
AnnotationAssertion(mito:isMentionedBy goldbook:10154 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10154 "current"^^xsd:string)
Declaration(Class(goldbook:10155))
AnnotationAssertion(rdfs:label goldbook:10155 "partial least squares regression")
AnnotationAssertion(dcterms:description goldbook:10155 "Multivariate calibration which finds factors that maximise covariance between two blocks of data.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10155 "PLS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10155 "partial least squares")
AnnotationAssertion(rdfs:comment goldbook:10155 "PLS finds factors (latent variables) in observed variables \\(\\boldsymbol{X}\\) that explain the maximum variance in the variable(s) \\(\\boldsymbol{c}\\), using the simultaneous decomposition of the two. It removes redundant information from the regression, i.e. factors describing large amounts of variance in the observed data that does not correlate with the predictions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10155 "The decompositions are \\(\\boldsymbol{X} = \\boldsymbol{T}_{k}\\boldsymbol{P}_{k}^{\\rm{T}} + \\boldsymbol{E}\\) and \\(\\boldsymbol{C} = \\boldsymbol{U}_{k}\\boldsymbol{Q}_{k}^{\\rm{T}} + \\boldsymbol{F}\\), and \\(\\boldsymbol{X^{+}} = \\boldsymbol{W}_{k} (\\boldsymbol{P}_{k}\\boldsymbol{W}_{k})^{-1} (\\boldsymbol{T}_{k}^{\\rm{T}}\\boldsymbol{T}_{k})^{-1} \\boldsymbol{T}_{k}^{\\rm{T}}\\), where \\(\\boldsymbol{W}\\) are weights that maintain orthogonal scores."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10155 "PLS1 refers to PLS for a single \"c\" variable. PLS2 is PLS that simultaneously obtains values for two or more \"c\" variables. Therefore in the equations of Note 2, PLS1 has vectors \\(\\boldsymbol{c}\\) and \\(\\boldsymbol{q}\\) and PLS2 has matrices \\(\\boldsymbol{C}\\) and \\(\\boldsymbol{Q}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10155 "When used for multivariate calibration, evaluation data or cross validation may be used to choose the number of PLS factors and assess the accuracy of the prediction (although the same data must not be used to do both). This is important to guard against overfitting."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10155 "PLS may also be used in classification. See partial least squares discriminant analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10155 goldbook:10153)
AnnotationAssertion(rdfs:seeAlso goldbook:10155 goldbook:10050)
AnnotationAssertion(rdfs:seeAlso goldbook:10155 goldbook:10138)
AnnotationAssertion(rdfs:seeAlso goldbook:10155 goldbook:10112)
AnnotationAssertion(mito:isMentionedBy goldbook:10155 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10155 "current"^^xsd:string)
Declaration(Class(goldbook:10156))
AnnotationAssertion(rdfs:label goldbook:10156 "principal components regression")
AnnotationAssertion(dcterms:description goldbook:10156 "Multivariate calibration in which a dependent variable is regressed against the scores of a chosen number of factors obtained from principal-component analysis of the predictor variable.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10156 "PCR")
AnnotationAssertion(rdfs:comment goldbook:10156 "PCA decomposes the predictor variable data \\(\\boldsymbol{X}\\) into \\(k\\) principal component factors \\(\\boldsymbol{\\hat X}_{k} = \\boldsymbol{T}_{k}\\boldsymbol{P}_{k}^{\\rm{T}}\\), where \\(k\\) may be determined by cross validation. The dependent variable \\(\\boldsymbol{c}\\) is then regressed against \\(\\boldsymbol{\\hat X}_{k}\\), \\(\\boldsymbol{c} = \\boldsymbol{\\hat X}_{k} \\boldsymbol{\\hat b}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10156 "The factorization gives orthogonal factors, but no information about the predicted variable \\(\\boldsymbol{c}\\) is used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10156 goldbook:10153)
AnnotationAssertion(rdfs:seeAlso goldbook:10156 goldbook:10107)
AnnotationAssertion(rdfs:seeAlso goldbook:10156 goldbook:10152)
AnnotationAssertion(rdfs:seeAlso goldbook:10156 goldbook:10155)
AnnotationAssertion(rdfs:seeAlso goldbook:10156 goldbook:10106)
AnnotationAssertion(rdfs:seeAlso goldbook:10156 goldbook:10112)
AnnotationAssertion(mito:isMentionedBy goldbook:10156 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10156 "current"^^xsd:string)
Declaration(Class(goldbook:10157))
AnnotationAssertion(rdfs:label goldbook:10157 "root mean squared error of calibration")
AnnotationAssertion(dcterms:description goldbook:10157 "In calibration for \\(N\\) calibration data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the value predicted by the calibration function. \\[E_{\\rm{RMSEC}} = \\sqrt \\frac{\\sum\\limits_{i\\,=\\,1}^{i,=\\,N} (\\hat c_{i} - c_{i})^2}{N}\\]")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10157 "RMSEC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10157 "standard error of calibration (SEC)")
AnnotationAssertion(rdfs:comment goldbook:10157 "Overfitting results in a small RMSEC, but poor predictive ability."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10157 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10157 "current"^^xsd:string)
Declaration(Class(goldbook:10158))
AnnotationAssertion(rdfs:label goldbook:10158 "underfitting of a calibration model")
AnnotationAssertion(dcterms:description goldbook:10158 "Condition in which a model fails to describe the data adequately.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10158 "underfitting")
AnnotationAssertion(rdfs:comment goldbook:10158 "Underfitting generally occurs when a model is not sufficiently complex, such as having too few parameters."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10158 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10158 "current"^^xsd:string)
Declaration(Class(goldbook:10159))
AnnotationAssertion(rdfs:label goldbook:10159 "weighted least squares regression")
AnnotationAssertion(dcterms:description goldbook:10159 "Least squares regression in which a nonnegative constant is associated with each value of the dependent variable.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10159 "WLSR")
AnnotationAssertion(rdfs:comment goldbook:10159 "The nonnegative constants are called weights."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10159 "If the only source of dispersion in the dependent variable is normally distributed, the weights are the inverse of the variance of each value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10159 "It is assumed the weights are known exactly."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10159 doi:10.1515/pac-2015-0605)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10159 "current"^^xsd:string)
Declaration(Class(goldbook:10160))
AnnotationAssertion(rdfs:label goldbook:10160 "boundary layer thickness")
AnnotationAssertion(dcterms:description goldbook:10160 "Distance from the interface beyond which mass transfer is determined by convection.")
AnnotationAssertion(mito:isMentionedBy goldbook:10160 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10160 "current"^^xsd:string)
Declaration(Class(goldbook:10161))
AnnotationAssertion(rdfs:label goldbook:10161 "breakthrough volume")
AnnotationAssertion(dcterms:description goldbook:10161 "Sample volume at which a defined amount of an analyte pumped continuously through an extraction device will begin to be eluted. Typical breakthrough curve indicating the breakthrough volume \\(V_{\\rm{B}}\\) and the sample volume corresponding to the saturation capacity of the sorbent \\(V_{\\rm{C}}\\) (\\(V_{\\rm{R}}\\) corresponds to the chromatographic elution volume and \\(\\upsigma_{\\rm{v}}\\) the standard deviation of the derivative of the curve).Typical breakthrough curve indicating the breakthrough volume \\(V_{\\rm{B}}\\) and the sample volume corresponding to the saturation capacity of the sorbent \\(V_{\\rm{C}}\\) (\\(V_{\\rm{R}}\\) corresponds to the chromatographic elution volume and \\(\\upsigma_{\\rm{v}}\\) the standard deviation of the derivative of the curve).")
AnnotationAssertion(rdfs:comment goldbook:10161 "The breakthrough volume, \\(V_{\\rm{B}}\\), for a particular compound and sampling device is determined by its breakthrough curve (see figure)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10161 "Defined amounts are usually given as a volume fraction of the sample volume (e.g. \\(\\pu{1\\%}\\), \\(\\pu{5\\%}\\) or \\(\\pu{10\\%}\\), etc.)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10161 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10161 "current"^^xsd:string)
Declaration(Class(goldbook:10162))
AnnotationAssertion(rdfs:label goldbook:10162 "ion-pair extraction")
AnnotationAssertion(dcterms:description goldbook:10162 "Transfer of ions from an aqueous phase to an immiscible liquid (or solid) phase by adding an ion of complementary charge to the aqueous phase.")
AnnotationAssertion(rdfs:comment goldbook:10162 "Ion-pair extraction can also be done by adding the complementary-charge containing compound to the organic phase before extraction."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10162 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10162 "current"^^xsd:string)
Declaration(Class(goldbook:10163))
AnnotationAssertion(rdfs:label goldbook:10163 "sorbent")
AnnotationAssertion(dcterms:description goldbook:10163 "Condensed phase where extraction of analytes can occur at the surface and in the bulk.")
AnnotationAssertion(rdfs:comment goldbook:10163 "If extraction occurs exclusively at the surface then adsorbent is the preferred term and if exclusively in the bulk then absorbent should be used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10163 "Sorbent is typically used explicitly to describe a condensed phase where extraction occurs simultaneously by adsorption and absorption (termed sorption), or where the true mechanism has not been established and the use of adsorbent or absorbent would be inappropriate."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10163 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10163 "current"^^xsd:string)
Declaration(Class(goldbook:10164))
AnnotationAssertion(rdfs:label goldbook:10164 "acceptor phase")
AnnotationAssertion(dcterms:description goldbook:10164 "Component of a multi-phase system into which the target analytes are extracted.")
AnnotationAssertion(rdfs:comment goldbook:10164 "When the acceptor phase is a liquid the term acceptor solution may be used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10164 "In extractions employing a semipermeable membrane for phase separation the acceptor phase is the phase to which analytes are transferred from the donor phase."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10164 goldbook:10171)
AnnotationAssertion(rdfs:seeAlso goldbook:10164 goldbook:10290)
AnnotationAssertion(mito:isMentionedBy goldbook:10164 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10164 "current"^^xsd:string)
Declaration(Class(goldbook:10165))
AnnotationAssertion(rdfs:label goldbook:10165 "active sampling")
AnnotationAssertion(dcterms:description goldbook:10165 "Continuous extraction with movement of the sample matrix with respect to the extraction phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:10165 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10165 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10165 "current"^^xsd:string)
Declaration(Class(goldbook:10166))
AnnotationAssertion(rdfs:label goldbook:10166 "batch extraction")
AnnotationAssertion(dcterms:description goldbook:10166 "Extraction in which the extraction phase and the sample are confined in an extraction vessel and processed according to a defined procedure.")
AnnotationAssertion(rdfs:comment goldbook:10166 "Term \"batch\" is also used in extraction to indicate a number of samples extracted sequentially or simultaneously by the same procedure (e.g. extraction of sample batch(es))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10166 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10166 "current"^^xsd:string)
Declaration(Class(goldbook:10167))
AnnotationAssertion(rdfs:label goldbook:10167 "calibrant in extraction phase")
AnnotationAssertion(dcterms:description goldbook:10167 "Internal standard that is incorporated in the extraction phase for calibration.")
AnnotationAssertion(rdfs:seeAlso goldbook:10167 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10167 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10167 "current"^^xsd:string)
Declaration(Class(goldbook:10168))
AnnotationAssertion(rdfs:label goldbook:10168 "charcoal tube")
AnnotationAssertion(dcterms:description goldbook:10168 "Tube filled with charcoal typically used to adsorb analytes from the gas or liquid phase.")
AnnotationAssertion(rdfs:comment goldbook:10168 "Activated charcoal was used in early applications, but a wider selection of carbon materials are currently used, with properties tailored to each application."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10168 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10168 "current"^^xsd:string)
Declaration(Class(goldbook:10169))
AnnotationAssertion(rdfs:label goldbook:10169 "continuous extraction")
AnnotationAssertion(dcterms:description goldbook:10169 "Extraction in which the sample is continuously introduced into the extraction device.")
AnnotationAssertion(mito:isMentionedBy goldbook:10169 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10169 "current"^^xsd:string)
Declaration(Class(goldbook:10170))
AnnotationAssertion(rdfs:label goldbook:10170 "countercurrent extraction")
AnnotationAssertion(dcterms:description goldbook:10170 "Extraction in which both phases are continuously added (or changed) and flow (or move) in opposite directions as the extraction progresses.")
AnnotationAssertion(rdfs:comment goldbook:10170 "The phases are either immiscible or separated by a membrane."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10170 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10170 "current"^^xsd:string)
Declaration(Class(goldbook:10171))
AnnotationAssertion(rdfs:label goldbook:10171 "donor phase")
AnnotationAssertion(dcterms:description goldbook:10171 "In extraction, the sample or sample solution.")
AnnotationAssertion(mito:isMentionedBy goldbook:10171 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10171 "current"^^xsd:string)
Declaration(Class(goldbook:10172))
AnnotationAssertion(rdfs:label goldbook:10172 "dynamic extraction")
AnnotationAssertion(dcterms:description goldbook:10172 "Extraction in which clean (or recycled) extraction phase is continuously passed through the sample.")
AnnotationAssertion(rdfs:comment goldbook:10172 "The extraction phase can be a gas or a liquid."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10172 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10172 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10172 "current"^^xsd:string)
Declaration(Class(goldbook:10173))
AnnotationAssertion(rdfs:label goldbook:10173 "exhaustive extraction")
AnnotationAssertion(dcterms:description goldbook:10173 "Type of extraction where the intent is a complete extraction of the analytes.")
AnnotationAssertion(mito:isMentionedBy goldbook:10173 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10173 "current"^^xsd:string)
Declaration(Class(goldbook:10174))
AnnotationAssertion(rdfs:label goldbook:10174 "external calibration")
AnnotationAssertion(dcterms:description goldbook:10174 "Calibration employing a simplified sample matrix spiked with target analyte embodying a reference value of the measurand.")
AnnotationAssertion(mito:isMentionedBy goldbook:10174 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10174 "current"^^xsd:string)
Declaration(Class(goldbook:10175))
AnnotationAssertion(rdfs:label goldbook:10175 "extraction phase")
AnnotationAssertion(dcterms:description goldbook:10175 "Liquid, solid, or gas phase in contact with the sample for the purpose of removal of analytes from the sample matrix.")
AnnotationAssertion(mito:isMentionedBy goldbook:10175 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10175 "current"^^xsd:string)
Declaration(Class(goldbook:10176))
AnnotationAssertion(rdfs:label goldbook:10176 "extraction rate")
AnnotationAssertion(dcterms:description goldbook:10176 "Rate at which analytes are transferred from the sample to the extraction phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10176 "kinetics of extraction")
AnnotationAssertion(rdfs:seeAlso goldbook:10176 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10176 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10176 "current"^^xsd:string)
Declaration(Class(goldbook:10177))
AnnotationAssertion(rdfs:label goldbook:10177 "feed")
AnnotationAssertion(dcterms:description goldbook:10177 "Solution or gas containing analyte introduced into an extraction.")
AnnotationAssertion(rdfs:comment goldbook:10177 "If feed is used without qualification, the term may be taken to designate the initial liquid phase containing the main solute to be transferred or sample solution in a batch process."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10177 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10177 "current"^^xsd:string)
Declaration(Class(goldbook:10178))
AnnotationAssertion(rdfs:label goldbook:10178 "fluorous extraction")
AnnotationAssertion(dcterms:description goldbook:10178 "Extraction in a biphasic system in which the main component of one phase is a highly fluorinated solvent (liquid-liquid extraction) or highly fluorinated sorbent (solid-phase extraction).")
AnnotationAssertion(rdfs:seeAlso goldbook:10178 goldbook:10255)
AnnotationAssertion(rdfs:seeAlso goldbook:10178 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10178 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10178 "current"^^xsd:string)
Declaration(Class(goldbook:10179))
AnnotationAssertion(rdfs:label goldbook:10179 "leaching")
AnnotationAssertion(dcterms:description goldbook:10179 "Dissolution of sample components from a solid with a liquid in which the solid phase is not wholly soluble.")
AnnotationAssertion(mito:isMentionedBy goldbook:10179 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10179 "current"^^xsd:string)
Declaration(Class(goldbook:10180))
AnnotationAssertion(rdfs:label goldbook:10180 "matrix-matched calibration")
AnnotationAssertion(dcterms:description goldbook:10180 "Calibration employing external calibration in which standard solutions of target are prepared in a solution of analyte-free matrix.")
AnnotationAssertion(rdfs:comment goldbook:10180 "Matrix-matched calibration is used to minimize the matrix effect on the measurement of target measurands."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10180 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10180 "current"^^xsd:string)
Declaration(Class(goldbook:10181))
AnnotationAssertion(rdfs:label goldbook:10181 "multiwell sample plate")
AnnotationAssertion(dcterms:description goldbook:10181 "Plate with multiple wells for individual samples.")
AnnotationAssertion(mito:isMentionedBy goldbook:10181 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10181 "current"^^xsd:string)
Declaration(Class(goldbook:10182))
AnnotationAssertion(rdfs:label goldbook:10182 "optimisation of extraction")
AnnotationAssertion(dcterms:description goldbook:10182 "Adjustment of extraction parameters to achieve a defined goal.")
AnnotationAssertion(rdfs:comment goldbook:10182 "Many extractions are controlled by several parameters and their interactions. Optimum conditions are more efficiently identified by multivariate methods."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10182 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10182 "current"^^xsd:string)
Declaration(Class(goldbook:10183))
AnnotationAssertion(rdfs:label goldbook:10183 "passive sampling")
AnnotationAssertion(dcterms:description goldbook:10183 "Extraction process driven by diffusion of analytes towards the extraction phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:10183 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10183 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10183 "current"^^xsd:string)
Declaration(Class(goldbook:10184))
AnnotationAssertion(rdfs:label goldbook:10184 "salting in")
AnnotationAssertion(dcterms:description goldbook:10184 "Addition of an electrolyte to an aqueous phase to decrease the distribution ratio of the analyte(s) or matrix.")
AnnotationAssertion(mito:isMentionedBy goldbook:10184 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10184 "current"^^xsd:string)
Declaration(Class(goldbook:10186))
AnnotationAssertion(rdfs:label goldbook:10186 "sequential extraction")
AnnotationAssertion(dcterms:description goldbook:10186 "Extraction wherein extractants of increasing strength or different chemical character are used in order to extract analytes of interest.")
AnnotationAssertion(rdfs:comment goldbook:10186 "The most commonly used approaches in elemental analysis are the BCR (now termed Standards, Measurement and Testing Program) and Tessier procedures."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10186 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10186 "current"^^xsd:string)
Declaration(Class(goldbook:10187))
AnnotationAssertion(rdfs:label goldbook:10187 "static extraction")
AnnotationAssertion(dcterms:description goldbook:10187 "Batch extraction in which the extraction phase attains a constant composition before phase separation.")
AnnotationAssertion(rdfs:comment goldbook:10187 "If the analytes are initially present as a solution in an immiscible liquid phase the process is synonymous with liquid-liquid extraction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10187 "If the sample is a solid that is partially soluble in the extraction phase then leaching may be a more appropriate term."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10187 goldbook:10166)
AnnotationAssertion(rdfs:seeAlso goldbook:10187 goldbook:10175)
AnnotationAssertion(rdfs:seeAlso goldbook:10187 goldbook:10179)
AnnotationAssertion(mito:isMentionedBy goldbook:10187 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10187 "current"^^xsd:string)
Declaration(Class(goldbook:10188))
AnnotationAssertion(rdfs:label goldbook:10188 "steady state extraction")
AnnotationAssertion(dcterms:description goldbook:10188 "State of a continuous process operating in such a way that the concentration of solutes in exit streams remains constant with respect to time for constant feed concentrations, even though the two phases are not necessarily in thermodynamic equilibrium in any part of the process.")
AnnotationAssertion(rdfs:comment goldbook:10188 "The term equilibrium should not be used to describe this situation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10188 goldbook:10177)
AnnotationAssertion(mito:isMentionedBy goldbook:10188 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10188 "current"^^xsd:string)
Declaration(Class(goldbook:10189))
AnnotationAssertion(rdfs:label goldbook:10189 "time-weighted average sampling")
AnnotationAssertion(dcterms:description goldbook:10189 "A passive sampling or active sampling strategy over a relatively long time, during which the amount of analyte(s) extracted is proportional to its average (mean) concentration over that time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10189 "TWA sampling")
AnnotationAssertion(rdfs:seeAlso goldbook:10189 goldbook:10165)
AnnotationAssertion(rdfs:seeAlso goldbook:10189 goldbook:10183)
AnnotationAssertion(mito:isMentionedBy goldbook:10189 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10189 "current"^^xsd:string)
Declaration(Class(goldbook:10190))
AnnotationAssertion(rdfs:label goldbook:10190 "chemical hydride generation")
AnnotationAssertion(dcterms:description goldbook:10190 "Type of chemical vapour generation wherein volatile hydrides are generated by reaction with (usually) borane complexes in aqueous solution.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10190 "CHG")
AnnotationAssertion(mito:isMentionedBy goldbook:10190 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10190 "current"^^xsd:string)
Declaration(Class(goldbook:10191))
AnnotationAssertion(rdfs:label goldbook:10191 "closed-loop extraction")
AnnotationAssertion(dcterms:description goldbook:10191 "Extraction by a fixed volume of gas continuously recycled through the sample and a sorbent trap by a pump in a closed-circuit arrangement.Typical apparatus for closed-loop stripping analysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10191 "closed-loop stripping analysis")
AnnotationAssertion(rdfs:comment goldbook:10191 "Closed-loop extraction was developed for trace analysis of volatile compounds (at mass concentrations of \\(\\pu{ng L-1}\\)) in drinking water."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10191 goldbook:10201)
AnnotationAssertion(mito:isMentionedBy goldbook:10191 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10191 "current"^^xsd:string)
Declaration(Class(goldbook:10192))
AnnotationAssertion(rdfs:label goldbook:10192 "cryogenic trap")
AnnotationAssertion(dcterms:description goldbook:10192 "Device used to concentrate volatile analytes from the gas phase by condensation on a cold surface.")
AnnotationAssertion(rdfs:comment goldbook:10192 "Typically, cryogenic traps have a low thermal mass to respond rapidly to changes in temperature and are prepared from short lengths of capillary tubing. Sub-ambient temperatures are required for the efficient collection of analytes from a flowing gas stream and above ambient temperatures for evaporation into a flowing gas stream for analysis, usually by gas chromatography or atomic spectrometry."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10192 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10192 "current"^^xsd:string)
Declaration(Class(goldbook:10193))
AnnotationAssertion(rdfs:label goldbook:10193 "denuder")
AnnotationAssertion(dcterms:description goldbook:10193 "Apparatus for the extraction of volatile analytes from a flowing gas stream by diffusion to the wall of a collection vessel, where they are retained by chemisorption or strong physisorption by the wall coating.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10193 "denuder device")
AnnotationAssertion(rdfs:comment goldbook:10193 "There are many design variations."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10193 "Both liquid and solid sorbents are used for trapping."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10193 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10193 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10193 "current"^^xsd:string)
Declaration(Class(goldbook:10194))
AnnotationAssertion(rdfs:label goldbook:10194 "dynamic headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10194 "Continuous removal of headspace above a sample by a flow of inert gas over or through the sample until all or a significant portion of the analytes have been removed from the sample. Sample vapours are typically transferred to a sorbent trap or cryogenic trap for collection.Typical apparatus for analysis by dynamic headspace (purge and trap). The gas flow (sparging gas) enters at the bottom of the sample container transporting volatile compounds through the headspace and purge head to the desorption tube for collection.")
AnnotationAssertion(rdfs:comment goldbook:10194 "Purge-and-trap is a version of dynamic headspace analysis in which volatile compounds are purged from solution by a continuous stream of gas bubbles (sparging gas) and transported through the headspace to a sorbent or cryogenic trap for collection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10194 "A typical apparatus for purge-and-trap is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10194 goldbook:10192)
AnnotationAssertion(rdfs:seeAlso goldbook:10194 goldbook:10198)
AnnotationAssertion(rdfs:seeAlso goldbook:10194 goldbook:10201)
AnnotationAssertion(mito:isMentionedBy goldbook:10194 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10194 "current"^^xsd:string)
Declaration(Class(goldbook:10195))
AnnotationAssertion(rdfs:label goldbook:10195 "extractive distillation")
AnnotationAssertion(dcterms:description goldbook:10195 "Separation of close-boiling liquids by fractional distillation in the presence of a low-volatility solvent or salt that selectively interacts with one or more components of the mixture, increasing the difference in vapour pressure of the sample components.")
AnnotationAssertion(rdfs:comment goldbook:10195 "If the separation solvent forms an azeotrope with one or more sample components the process is called azeotropic distillation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10195 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10195 "current"^^xsd:string)
Declaration(Class(goldbook:10196))
AnnotationAssertion(rdfs:label goldbook:10196 "flash desorption")
AnnotationAssertion(dcterms:description goldbook:10196 "Thermal desorption where the temperature of a packed tube or cryogenic trap is rapidly increased to transfer condensed or sorbed compounds to the gas phase.")
AnnotationAssertion(mito:isMentionedBy goldbook:10196 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10196 "current"^^xsd:string)
Declaration(Class(goldbook:10197))
AnnotationAssertion(rdfs:label goldbook:10197 "full-evaporation headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10197 "Small volume of sample in a headspace vessel maintained at a temperature sufficient to cause complete evaporation of analytes.")
AnnotationAssertion(rdfs:comment goldbook:10197 "The full-evaporation technique is used with both static headspace analysis and dynamic headspace analysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10197 "Equilibrium between the condensed and vapor phases no longer exists. As a consequence, the possibility of matrix interferences is reduced and the fraction extracted for low-volatility compounds is increased."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10197 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10197 "current"^^xsd:string)
Declaration(Class(goldbook:10198))
AnnotationAssertion(rdfs:label goldbook:10198 "headspace")
AnnotationAssertion(dcterms:description goldbook:10198 "Volume of gas phase above a sample in a closed container.")
AnnotationAssertion(mito:isMentionedBy goldbook:10198 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10198 "current"^^xsd:string)
Declaration(Class(goldbook:10199))
AnnotationAssertion(rdfs:label goldbook:10199 "multiple headspace extraction")
AnnotationAssertion(dcterms:description goldbook:10199 "Dynamic gas extraction carried out stepwise, with sequential analysis of a number of headspace samples taken from the same vial.")
AnnotationAssertion(rdfs:comment goldbook:10199 "At equilibrium the headspace is sampled and the remainder (or most of it) is exhausted and replaced by fresh gas phase. The process is repeated and the original sample concentration estimated from the peak areas for two consecutive extractions. \\[A_{\\rm{T}} = \\frac{A_{1}^{2}}{A_{1} - A_{2}}\\] where \\(A_{\\rm{T}}\\) = estimated sum of all partial peak areas corresponding to exhaustive extraction, \\(A_{1}\\) the peak area obtained from the first headspace fraction, and \\(A_{2}\\) the peak area obtained in the second (consecutive) headspace fraction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10199 "External calibration is required to convert peak areas into sample concentration."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10199 goldbook:10174)
AnnotationAssertion(rdfs:seeAlso goldbook:10199 goldbook:10198)
AnnotationAssertion(mito:isMentionedBy goldbook:10199 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10199 "current"^^xsd:string)
Declaration(Class(goldbook:10200))
AnnotationAssertion(rdfs:label goldbook:10200 "simultaneous steam distillation-solvent extraction")
AnnotationAssertion(dcterms:description goldbook:10200 "Extraction in which a sample dispersed in water and a water immiscible organic solvent (extraction phase) in separate flasks are heated simultaneously and their vapours co-condensed and separated into two streams in which water is returned to the sample flask and the extraction phase to the organic solvent flask.Apparatus for simultaneous steam distillation-solvent extraction with a lighter-than-water extraction phase. A = aqueous sample solution or slurry; B = immiscible organic solvent and receiving flask for extracted compounds; C = bowl for phase separation; D, E, F, and G are solvent or vapour transfer arms; and H = entry port for additional solvent or alternative sample introduction position for continuous liquid–liquid extraction. Switching the position of flasks A and B allows extraction with a heavier-than-water extraction solvent.")
AnnotationAssertion(rdfs:comment goldbook:10200 "A typical apparatus for simultaneous steam distillation-solvent extraction with a lighter-than-water extraction solvent is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10200 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10200 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10200 "current"^^xsd:string)
Declaration(Class(goldbook:10201))
AnnotationAssertion(rdfs:label goldbook:10201 "sorbent trap")
AnnotationAssertion(dcterms:description goldbook:10201 "Tube filled with porous sorbent typically used to extract analytes from the gas phase.")
AnnotationAssertion(rdfs:comment goldbook:10201 "The performance of a sorbent tube depends on the sorbent type, temperature, gas flow rate, and desorption time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10201 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10201 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10201 "current"^^xsd:string)
Declaration(Class(goldbook:10202))
AnnotationAssertion(rdfs:label goldbook:10202 "static headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10202 "Method of analysis, in which a small aliquot of the gas phase in contact with the sample in a closed container is withdrawn for analysis.")
AnnotationAssertion(rdfs:comment goldbook:10202 "At equilibrium, the analyte concentration in the gas phase is related to the sample concentration by a partition constant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10202 "The sample vessel is thermostatted."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10202 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10202 "current"^^xsd:string)
Declaration(Class(goldbook:10203))
AnnotationAssertion(rdfs:label goldbook:10203 "thermal extraction")
AnnotationAssertion(dcterms:description goldbook:10203 "Release of volatile compounds from a sample by heat.")
AnnotationAssertion(rdfs:comment goldbook:10203 "The volatile compounds are typically transported by a gas stream to a sorbent tube or cryogenic trap for collection."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10203 goldbook:10192)
AnnotationAssertion(rdfs:seeAlso goldbook:10203 goldbook:10201)
AnnotationAssertion(mito:isMentionedBy goldbook:10203 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10203 "current"^^xsd:string)
Declaration(Class(goldbook:10204))
AnnotationAssertion(rdfs:label goldbook:10204 "thin-layer headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10204 "Dynamic headspace analysis of a flowing sample solution in the form of a thin film on the surface of a heated tube.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10204 "TLHS")
AnnotationAssertion(rdfs:comment goldbook:10204 "Volatile compounds in the sample solution pass into the gas phase and are continuously swept out of the tube for analysis or detection."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10204 goldbook:10194)
AnnotationAssertion(mito:isMentionedBy goldbook:10204 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10204 "current"^^xsd:string)
Declaration(Class(goldbook:10205))
AnnotationAssertion(rdfs:label goldbook:10205 "biphasic system")
AnnotationAssertion(dcterms:description goldbook:10205 "Equilibrium system containing two or more solvents forming two phases with a single interface.")
AnnotationAssertion(mito:isMentionedBy goldbook:10205 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10205 "current"^^xsd:string)
Declaration(Class(goldbook:10206))
AnnotationAssertion(rdfs:label goldbook:10206 "chelation solvent extraction")
AnnotationAssertion(dcterms:description goldbook:10206 "Extraction method wherein charged analytes are extracted from an aqueous phase into an organic phase, assisted by a chelating agent.")
AnnotationAssertion(rdfs:comment goldbook:10206 "The chelating agent replaces water molecules in the coordination sphere of the metal ions. Consequently, the resultant metal chelates have a hydrophobic character which facilitates their transfer to the organic phase."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10206 "The analyte(s) are usually metal ions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10206 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10206 "current"^^xsd:string)
Declaration(Class(goldbook:10207))
AnnotationAssertion(rdfs:label goldbook:10207 "cloud point extraction")
AnnotationAssertion(dcterms:description goldbook:10207 "Coacervative extraction at a temperature above the cloud point temperature.")
AnnotationAssertion(rdfs:seeAlso goldbook:10207 goldbook:10208)
AnnotationAssertion(mito:isMentionedBy goldbook:10207 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10207 "current"^^xsd:string)
Declaration(Class(goldbook:10208))
AnnotationAssertion(rdfs:label goldbook:10208 "coacervative extraction")
AnnotationAssertion(dcterms:description goldbook:10208 "Extraction by a surfactant-rich, water-immiscible phase formed by adding a dehydrating agent to a colloidal solution of the sample and a surfactant above its critical micelle concentration.")
AnnotationAssertion(rdfs:comment goldbook:10208 "In cloud point extraction a small volume \"surfactant-rich\" phase enriched in sample components of moderate water solubility and a bulk aqueous phase with dissolved surfactant and highly water-soluble compounds are formed."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10208 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10208 "current"^^xsd:string)
Declaration(Class(goldbook:10209))
AnnotationAssertion(rdfs:label goldbook:10209 "continuous liquid-liquid extraction")
AnnotationAssertion(dcterms:description goldbook:10209 "Extraction in which a water-immiscible extraction solvent is continuously percolated through an aqueous solution and returned to the extraction solvent reservoir.Apparatus for continuous liquid–liquid extraction with a lighter-than-water extraction solvent (left) and a heavier-than-water extraction solvent (right). In each case the extraction solvent is contained in the round bottom flask and the aqueous sample in the vertical glass column.")
AnnotationAssertion(rdfs:comment goldbook:10209 "Typically, a fixed volume of extraction solvent is recycled through the aqueous sample solution by distillation and condensation, and dripped into the sample solution. A siphon mechanism allows continuous recovery of the extraction solvent based on its relative density."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10209 "Typical apparatuses are shown below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10209 "Continuous liquid-liquid extraction techniques are used when the sample volume is large, the distribution constant is small, or the rate of extraction is slow."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10209 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10209 "current"^^xsd:string)
Declaration(Class(goldbook:10210))
AnnotationAssertion(rdfs:label goldbook:10210 "Craig countercurrent distribution apparatus")
AnnotationAssertion(dcterms:description goldbook:10210 "Apparatus for extraction based on a multistage countercurrent distribution.")
AnnotationAssertion(rdfs:comment goldbook:10210 "The Craig CCD apparatus consists of a battery of glass vessels designed to allow the mixing, settling, and transfer of extracted phase (sample) and the addition of fresh solvent (extractant) in a repetitive fashion. Movement about the horizontal axis provides gentle mixing of the phases, settling, and decanting of the upper phase. The extraction process is slow but is fully automated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10210 goldbook:10217)
AnnotationAssertion(mito:isMentionedBy goldbook:10210 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10210 "current"^^xsd:string)
Declaration(Class(goldbook:10211))
AnnotationAssertion(rdfs:label goldbook:10211 "crosscurrent extraction")
AnnotationAssertion(dcterms:description goldbook:10211 "Extraction comprising a cascading series of states where the raffinate is brought into a subsequent stage and contacted with fresh solvent.")
AnnotationAssertion(mito:isMentionedBy goldbook:10211 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10211 "current"^^xsd:string)
Declaration(Class(goldbook:10212))
AnnotationAssertion(rdfs:label goldbook:10212 "differential contactor")
AnnotationAssertion(dcterms:description goldbook:10212 "Type of continuous multistage extraction equipment in which there is only one interface at which phase separation by settling occurs.")
AnnotationAssertion(mito:isMentionedBy goldbook:10212 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10212 "current"^^xsd:string)
Declaration(Class(goldbook:10213))
AnnotationAssertion(rdfs:label goldbook:10213 "dispersing solvent")
AnnotationAssertion(dcterms:description goldbook:10213 "Solvent used to disperse the extraction solvent as fine droplets throughout the sample solution in dispersive liquid–liquid microextraction.")
AnnotationAssertion(rdfs:comment goldbook:10213 "The dispersion solvent is typically a polar organic solvent miscible with water."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10213 goldbook:10214)
AnnotationAssertion(mito:isMentionedBy goldbook:10213 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10213 "current"^^xsd:string)
Declaration(Class(goldbook:10214))
AnnotationAssertion(rdfs:label goldbook:10214 "dispersive liquid-liquid microextraction")
AnnotationAssertion(dcterms:description goldbook:10214 "Extraction of analyte(s) from an aqueous solution by fine droplets of extraction phase dispersed throughout the solution.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10214 "DLLME")
AnnotationAssertion(rdfs:comment goldbook:10214 "The extraction phase is formed by a mixture of extraction and dispersion solvents injected into the sample solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10214 "The extraction phase can be formed by ion exchange when an ionic liquid is used as the extraction solvent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10214 "The extraction phase is sedimented by centrifugation and collected for analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10214 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10214 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10214 "current"^^xsd:string)
Declaration(Class(goldbook:10215))
AnnotationAssertion(rdfs:label goldbook:10215 "liquid-ion exchange")
AnnotationAssertion(dcterms:description goldbook:10215 "Liquid-liquid distribution process that involves the transfer of ionic species from the extractant to the aqueous phase in exchange for ions from the aqueous phase.")
AnnotationAssertion(mito:isMentionedBy goldbook:10215 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10215 "current"^^xsd:string)
Declaration(Class(goldbook:10216))
AnnotationAssertion(rdfs:label goldbook:10216 "liquid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10216 "Microextraction technique using a liquid as the extraction phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:10216 goldbook:11552)
AnnotationAssertion(rdfs:seeAlso goldbook:10216 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10216 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10216 "current"^^xsd:string)
Declaration(Class(goldbook:10217))
AnnotationAssertion(rdfs:label goldbook:10217 "multistage countercurrent distribution")
AnnotationAssertion(dcterms:description goldbook:10217 "Multistage countercurrent separation based on a discontinuous, differential migration process employing stepwise extraction.")
AnnotationAssertion(rdfs:seeAlso goldbook:10217 goldbook:10170)
AnnotationAssertion(mito:isMentionedBy goldbook:10217 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10217 "current"^^xsd:string)
Declaration(Class(goldbook:10218))
AnnotationAssertion(rdfs:label goldbook:10218 "single-drop microextraction")
AnnotationAssertion(dcterms:description goldbook:10218 "Extraction of analytes from the gas phase or solution by a single drop of extraction solvent.Typical experimental arrangement for single-drop microextraction.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10218 "SDME")
AnnotationAssertion(rdfs:comment goldbook:10218 "The extraction solvent with a volume typically \\(\\pu{\\lt 50 \\upmu L}\\) is suspended as a drop from the tip of a microsyringe needle as shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10218 "Typically, the sample is aqueous and the acceptor phase is an organic solvent, resulting in a two-phase extraction system (\\(\\ce{aqueous\\!->\\!organic}\\)). SDME can also be operated in three-phase mode (\\(\\ce{aqueous\\!->\\!organic\\!->\\!aqueous}\\)), or in the headspace mode (\\(\\ce{aqueous\\!->\\!gas\\!->\\!organic or aqueous}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10218 "The sample is stirred or agitated during extraction. After extraction, the drop of acceptor phase is collected by withdrawing it into the syringe used to support the drop for the final analytical measurement."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10218 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10218 "current"^^xsd:string)
Declaration(Class(goldbook:10219))
AnnotationAssertion(rdfs:label goldbook:10219 "solidified floating organic drop")
AnnotationAssertion(dcterms:description goldbook:10219 "Droplet of organic solvent recovered from the surface of the sample solution by solidification induced by cooling.")
AnnotationAssertion(mito:isMentionedBy goldbook:10219 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10219 "current"^^xsd:string)
Declaration(Class(goldbook:10220))
AnnotationAssertion(rdfs:label goldbook:10220 "solidified floating organic drop microextraction")
AnnotationAssertion(dcterms:description goldbook:10220 "Microextraction employing a solidified floating organic drop.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10220 "SFODME")
AnnotationAssertion(rdfs:comment goldbook:10220 "The extraction solvent has a melting point near room temperature to facilitate collection after solidification induced by cooling. The solidified solvent is then melted and analysed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10220 goldbook:11552)
AnnotationAssertion(rdfs:seeAlso goldbook:10220 goldbook:10219)
AnnotationAssertion(mito:isMentionedBy goldbook:10220 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10220 "current"^^xsd:string)
Declaration(Class(goldbook:10221))
AnnotationAssertion(rdfs:label goldbook:10221 "stage")
AnnotationAssertion(dcterms:description goldbook:10221 "Physically distinct part of an extraction process in which transfer of analyte(s) occurs, followed by phase separation.")
AnnotationAssertion(mito:isMentionedBy goldbook:10221 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10221 "current"^^xsd:string)
Declaration(Class(goldbook:10222))
AnnotationAssertion(rdfs:label goldbook:10222 "stagewise contactor")
AnnotationAssertion(dcterms:description goldbook:10222 "Type of continuous multi-stage liquid-liquid distribution equipment in which each stage has a physically distinct cycle of interphase contact and separation.")
AnnotationAssertion(rdfs:comment goldbook:10222 "There are the same number of phase separation interfaces as there are stages."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10222 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10222 "current"^^xsd:string)
Declaration(Class(goldbook:10223))
AnnotationAssertion(rdfs:label goldbook:10223 "two-phase aqueous partition")
AnnotationAssertion(dcterms:description goldbook:10223 "Distribution in a biphasic system formed by two aqueous solutions containing structurally incompatible components (two polymers or a polymer and a salt) above a critical concentration.")
AnnotationAssertion(mito:isMentionedBy goldbook:10223 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10223 "current"^^xsd:string)
Declaration(Class(goldbook:10224))
AnnotationAssertion(rdfs:label goldbook:10224 "matrix-solid phase dispersion")
AnnotationAssertion(dcterms:description goldbook:10224 "Extraction in which samples are blended with an abrasive solid sorbent, forming a free flowing powder from which target analytes are recovered by solvent elution.Typical work flow scheme for solid-phase matrix dispersion. (i) Sample is blended with an abrasive sorbent, (ii) free flowing powder containing sample is packed in a short column, and (iii) target analytes are recovered by elution.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10224 "MSPD")
AnnotationAssertion(rdfs:comment goldbook:10224 "A typical workflow scheme for matrix–solid-phase dispersion is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10224 "For additional sample clean-up the sorbent/sample mixture is deposited at the head of a solid-phase extraction cartridge containing a suitable sorbent to retard the elution of matrix components."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10224 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10224 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10224 "current"^^xsd:string)
Declaration(Class(goldbook:10225))
AnnotationAssertion(rdfs:label goldbook:10225 "microwave-assisted extraction")
AnnotationAssertion(dcterms:description goldbook:10225 "Leaching using microwave energy to heat the solvent in contact with the sample or the sample directly.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10225 "MAE")
AnnotationAssertion(rdfs:comment goldbook:10225 "Microwaves are electromagnetic radiation of \\(\\pu{300\\!{–}\\! 300,000 MHz}\\). They heat the extraction solution by their interaction with dielectric compounds (solvent or sample). Microwave heating is more efficient and rapid than convection and conduction and enhances the migration rate of compounds into the extraction solvent. Microwave-assisted extraction may be performed in a closed vessel with control of temperature and pressure or in an open vessel at atmospheric pressure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10225 goldbook:10179)
AnnotationAssertion(mito:isMentionedBy goldbook:10225 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10225 "current"^^xsd:string)
Declaration(Class(goldbook:10226))
AnnotationAssertion(rdfs:label goldbook:10226 "pressurized hot-water extraction")
AnnotationAssertion(dcterms:description goldbook:10226 "Extraction by water below its critical point (\\(\\pu{374.15^{\\circ}C}\\) and \\(\\pu{22.064 MPa}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10226 "subcritical water extraction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10226 "superheated water extraction")
AnnotationAssertion(rdfs:comment goldbook:10226 "The solvation properties of water become closer to organic solvents at elevated temperatures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10226 "Instrument requirements are similar to pressurized-liquid extraction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10226 goldbook:10227)
AnnotationAssertion(mito:isMentionedBy goldbook:10226 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10226 "current"^^xsd:string)
Declaration(Class(goldbook:10227))
AnnotationAssertion(rdfs:label goldbook:10227 "pressurized-liquid extraction")
AnnotationAssertion(dcterms:description goldbook:10227 "Leaching performed at elevated temperature and pressure.Schematic diagram of a typical apparatus for pressurized-liquid extraction. Gas flow is used to displace the extraction solvent from the sample chamber.")
AnnotationAssertion(rdfs:comment goldbook:10227 "A typical apparatus is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10227 "The sample, in the form of a fine powder or liquid supported on an inert solid, is packed into an extraction vessel and inserted in a flow-through system. The temperature, pressure, solvent type, and static and/or dynamic extraction time are varied to optimize the extraction performance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10227 goldbook:10179)
AnnotationAssertion(mito:isMentionedBy goldbook:10227 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10227 "current"^^xsd:string)
Declaration(Class(goldbook:10228))
AnnotationAssertion(rdfs:label goldbook:10228 "Soxhlet extraction")
AnnotationAssertion(dcterms:description goldbook:10228 "Leaching with fresh solvent cycled multiple times through a fine solid sample contained in a porous thimble.Typical apparatus for classical Soxhlet extraction.")
AnnotationAssertion(rdfs:comment goldbook:10228 "A typical apparatus for classical Soxhlet extraction is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10228 "The extraction solvent is cycled in a continuous-discrete process by distillation, condensation and siphoning. Extracted material accumulates in the distillation flask."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10228 goldbook:10179)
AnnotationAssertion(mito:isMentionedBy goldbook:10228 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10228 "current"^^xsd:string)
Declaration(Class(goldbook:10229))
AnnotationAssertion(rdfs:label goldbook:10229 "supercritical fluid extraction")
AnnotationAssertion(dcterms:description goldbook:10229 "Use of a supercritical fluid to extract analytes from a solid or supported liquid sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10229 "SFE")
AnnotationAssertion(rdfs:comment goldbook:10229 "The powdered sample, or supported liquid, is packed into a vessel and extracted using static or dynamic extraction conditions. The extracted material is typically recovered by reducing the pressure of the extraction fluid, allowing it to evaporate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10229 "The most common supercritical fluid for extraction is carbon dioxide (critical point = \\(\\pu{39.9^{\\circ}C}\\) and \\(\\pu{73.8 bar}\\)). Its extraction properties are varied by changing its density (temperature and pressure) or by addition of polar organic solvents."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10229 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10229 "current"^^xsd:string)
Declaration(Class(goldbook:10230))
AnnotationAssertion(rdfs:label goldbook:10230 "QuEChERS (quick, easy, cheap, effective, rugged and safe) extraction")
AnnotationAssertion(dcterms:description goldbook:10230 "Streamlined multiresidue method for extraction and clean-up of analytes in complex matrices.")
AnnotationAssertion(rdfs:comment goldbook:10230 "Often used for samples containing pesticide residues."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10230 "The general procedure includes micro-scale extraction with acetonitrile, salt-assisted phase separation, and sample clean up using dispersive solid-phase extraction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10230 "There are several procedural variations of the general method for application to particular compounds or sample matrices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10230 goldbook:11552)
AnnotationAssertion(mito:isMentionedBy goldbook:10230 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10230 "current"^^xsd:string)
Declaration(Class(goldbook:10231))
AnnotationAssertion(rdfs:label goldbook:10231 "ultrasound-assisted extraction")
AnnotationAssertion(dcterms:description goldbook:10231 "Extraction in which ultrasound energy is used to increase the extraction rate by enhancing the contact area between the sample and solvent and by promoting efficient agitation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10231 "UAE")
AnnotationAssertion(rdfs:comment goldbook:10231 "Ultrasound energy is applied to samples in a vessel immersed in a water bath or applied more directly using devices, such as horns, probes, or sono-reactors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10231 "Ultrasound energy causes cavitation in solvents, which generates numerous tiny bubbles in liquids and mechanical erosion of solids, including particle rupture. It promotes digestion and slurry formation with solids and homogenization and emulsification with liquids."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10231 goldbook:10176)
AnnotationAssertion(mito:isMentionedBy goldbook:10231 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10231 "current"^^xsd:string)
Declaration(Class(goldbook:10232))
AnnotationAssertion(rdfs:label goldbook:10232 "acid digestion")
AnnotationAssertion(dcterms:description goldbook:10232 "Process in which the sample (analyte and matrix) is dissolved by an acid.")
AnnotationAssertion(rdfs:comment goldbook:10232 "Acid digestion can also be used to remove a matrix constituent by selective volatilization, e.g. silicon by the use of hydrofluoric acid."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10232 "Acid digestion can be performed in closed or open vessels."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10232 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10232 "current"^^xsd:string)
Declaration(Class(goldbook:10233))
AnnotationAssertion(rdfs:label goldbook:10233 "closed-vessel acid digestion")
AnnotationAssertion(dcterms:description goldbook:10233 "Type of acid digestion performed in a closed vessel at elevated pressure.")
AnnotationAssertion(rdfs:comment goldbook:10233 "The increased rate of decomposition and retention of volatile trace elements is an advantage over open-vessel acid digestion."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10233 goldbook:10232)
AnnotationAssertion(rdfs:seeAlso goldbook:10233 goldbook:10236)
AnnotationAssertion(mito:isMentionedBy goldbook:10233 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10233 "current"^^xsd:string)
Declaration(Class(goldbook:10234))
AnnotationAssertion(rdfs:label goldbook:10234 "digestion")
AnnotationAssertion(dcterms:description goldbook:10234 "Sample dissolution with simultaneous matrix simplification.")
AnnotationAssertion(mito:isMentionedBy goldbook:10234 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10234 "current"^^xsd:string)
Declaration(Class(goldbook:10235))
AnnotationAssertion(rdfs:label goldbook:10235 "microwave acid digestion")
AnnotationAssertion(dcterms:description goldbook:10235 "Type of bomb acid digestion with microwave radiation used for sample heating.")
AnnotationAssertion(mito:isMentionedBy goldbook:10235 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10235 "current"^^xsd:string)
Declaration(Class(goldbook:10236))
AnnotationAssertion(rdfs:label goldbook:10236 "open-vessel acid digestion")
AnnotationAssertion(dcterms:description goldbook:10236 "Type of acid digestion performed at ambient pressure wherein the digestion temperature is limited by the boiling point of the acid.")
AnnotationAssertion(rdfs:seeAlso goldbook:10236 goldbook:10232)
AnnotationAssertion(rdfs:seeAlso goldbook:10236 goldbook:10233)
AnnotationAssertion(mito:isMentionedBy goldbook:10236 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10236 "current"^^xsd:string)
Declaration(Class(goldbook:10237))
AnnotationAssertion(rdfs:label goldbook:10237 "UV photochemical digestion")
AnnotationAssertion(dcterms:description goldbook:10237 "Formation of free metal ions in aqueous solution by oxidation under the influence of UV light and possibly an oxidizing agent (e.g. hydrogen peroxide or peroxodisulfate) in order to break down dissolved organic matter and metal complexes.")
AnnotationAssertion(rdfs:comment goldbook:10237 "Typical samples are sea water, waste water, drinking water, or fresh water."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10237 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10237 "current"^^xsd:string)
Declaration(Class(goldbook:10238))
AnnotationAssertion(rdfs:label goldbook:10238 "cartridge")
AnnotationAssertion(dcterms:description goldbook:10238 "Short disposable column containing a bed of porous particles immobilized between two porous frits.")
AnnotationAssertion(rdfs:comment goldbook:10238 "The particles are sized to allow sample processing by gravity, gentle suction or low pressure."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10238 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10238 "current"^^xsd:string)
Declaration(Class(goldbook:10239))
AnnotationAssertion(rdfs:label goldbook:10239 "conditioning solvent")
AnnotationAssertion(dcterms:description goldbook:10239 "Small volume of solvent used to prepare the sorbent for efficient sample processing.")
AnnotationAssertion(rdfs:comment goldbook:10239 "Principal roles include removal of contaminants from the sorbent bed to create the conditions for a stable flow of the sample solution during sampling and to facilitate wetting of hydrophobic sorbent surfaces before applying aqueous samples."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10239 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10239 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10239 "current"^^xsd:string)
Declaration(Class(goldbook:10240))
AnnotationAssertion(rdfs:label goldbook:10240 "elution solvent")
AnnotationAssertion(dcterms:description goldbook:10240 "Small volume of strong solvent used to displace target analytes from the sorbent bed.")
AnnotationAssertion(rdfs:seeAlso goldbook:10240 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10240 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10240 "current"^^xsd:string)
Declaration(Class(goldbook:10241))
AnnotationAssertion(rdfs:label goldbook:10241 "foamed polyurethane sorbent")
AnnotationAssertion(dcterms:description goldbook:10241 "Sorbent consisting of spherical, micron-sized, agglomerated particles bound together in a rigid and highly porous structure used for the extraction of semi-volatile organic compounds from air in high-volume samplers.")
AnnotationAssertion(rdfs:comment goldbook:10241 "Their main attribute is their favourable aerodynamic properties, which permit sampling at high flow rates."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10241 "Foamed polyurethane sorbents have a minor use for extracting compounds from water."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10241 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10241 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10241 "current"^^xsd:string)
Declaration(Class(goldbook:10242))
AnnotationAssertion(rdfs:label goldbook:10242 "immunosorbents")
AnnotationAssertion(dcterms:description goldbook:10242 "Porous material with surface bound monoclonal or polyclonal antibodies capable of selective extraction of target analytes by formation of reversible antibody-antigen (compound) binding complexes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10242 "immunoaffinity sorbents")
AnnotationAssertion(rdfs:comment goldbook:10242 "A high level of selectivity is possible due to the specificity of antibody-antigen spatial fitting and interactions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10242 "The porous support is chosen to minimize nonspecific matrix interactions to facilitate processing complex biological, environmental and food samples without additional clean up."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10242 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10242 "current"^^xsd:string)
Declaration(Class(goldbook:10243))
AnnotationAssertion(rdfs:label goldbook:10243 "inorganic oxide adsorbent")
AnnotationAssertion(dcterms:description goldbook:10243 "Adsorbent with site-specific polar and ion exchange functional groups that extract analytes from a gas or liquid phase by their complementary interactions with the surface.")
AnnotationAssertion(rdfs:comment goldbook:10243 "Typical inorganic oxide adsorbents include silica gel, alumina, magnesium silicate (Florisil), and zirconia."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10243 "Compounds with hydrogen-bonding or ionic functional groups are extracted efficiently, while neutral dipolar compounds are extracted to a lesser extent and weakly polarizable compounds to a limited extent."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10243 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10243 "current"^^xsd:string)
Declaration(Class(goldbook:10244))
AnnotationAssertion(rdfs:label goldbook:10244 "ion-exchange sorbent")
AnnotationAssertion(dcterms:description goldbook:10244 "Porous sorbent material  containing fixed ionic sites with a complementary charge to that of the target analyte(s).")
AnnotationAssertion(rdfs:comment goldbook:10244 "Ionic or ionizable compounds are extracted almost exclusively from water by electrostatic interactions with ion-exchange sorbents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10244 "Ion-exchange sorbents are usually classified as weak or strong depending on the identity of the ionic group and whether its charge is independent of the sample \\(\\rm{pH}\\) (strong ion-exchanger) or can be varied by changing the sample \\(\\rm{pH}\\) (weak ion-exchanger)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10244 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10244 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10244 "current"^^xsd:string)
Declaration(Class(goldbook:10245))
AnnotationAssertion(rdfs:label goldbook:10245 "low-specificity sorbents")
AnnotationAssertion(dcterms:description goldbook:10245 "Sorbent with a non-selective surface used almost exclusively to extract analytes from an aqueous solution. The sorbent has a largely passive role in the extraction, with the driving force being the expulsion of the organic contaminants from waterto minimize disruption of the water structure.")
AnnotationAssertion(rdfs:comment goldbook:10245 "Typical low-specificity sorbents are chemically-bonded porous silica, hydrophobic macroporous polymers, and various forms of carbon."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10245 "Low-specificity sorbents have surfaces with a low concentration of polar functional groups and retain compounds mainly through non-selective dispersion interactions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10245 "From the gas phase compounds are extracted by non-polar and weakly polar interactions with high surface area sorbents."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10245 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10245 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10245 "current"^^xsd:string)
Declaration(Class(goldbook:10246))
AnnotationAssertion(rdfs:label goldbook:10246 "magnetic nanoparticle sorbent")
AnnotationAssertion(dcterms:description goldbook:10246 "Sorbent consisting of nanometre-sized, spherical particles with a magnetic or magnetisable core surrounded by a sorbent shell.")
AnnotationAssertion(rdfs:comment goldbook:10246 "Magnetic nanoparticles have a high surface area-to-volume ratio and a low mass. They are easily dispersed in solution. A magnet facilitates recovery of the nanoparticles from the sample solution or suspension."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10246 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10246 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10246 "current"^^xsd:string)
Declaration(Class(goldbook:10247))
AnnotationAssertion(rdfs:label goldbook:10247 "mixed-mode sorbent")
AnnotationAssertion(dcterms:description goldbook:10247 "Porous sorbent material with surface co-bonded ion exchange and alkyl functional groups.")
AnnotationAssertion(rdfs:comment goldbook:10247 "The dual extraction mechanism allows fractionation of mixtures into a neutral and acidic fraction and a basic fraction by a stepwise change in \\(\\pu{pH}\\) of the eluting solvent."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10247 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10247 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10247 "current"^^xsd:string)
Declaration(Class(goldbook:10248))
AnnotationAssertion(rdfs:label goldbook:10248 "molecularly imprinted polymer sorbent")
AnnotationAssertion(dcterms:description goldbook:10248 "Porous polymer sorbent with synthetic recognition sites with a high specificity for the sorption of a targeted compound or group of structurally-related compounds.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10248 "MIPS")
AnnotationAssertion(rdfs:comment goldbook:10248 "The imprint is obtained by the co-polymerization of functional and crosslinking monomers in the presence of a template molecule (the analyte) and a porogen. The resultant imprint possesses a steric (size and shape) and chemical (spatial arrangement of complementary functional groups) memory of the template molecule that enable the sorbent to selectively rebind the template molecule from a complex matrix."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10248 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10248 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10248 "current"^^xsd:string)
Declaration(Class(goldbook:10249))
AnnotationAssertion(rdfs:label goldbook:10249 "multiwell extraction plate")
AnnotationAssertion(dcterms:description goldbook:10249 "Regular array of wells in a single moulded body with a short sorbent bed or disc embedded at the base of each well.Multiwell extraction plate.")
AnnotationAssertion(rdfs:comment goldbook:10249 "The design of a typical multiwall extraction plate is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10249 "Multiwell plates typically contain 24, 96, 256, or 384 wells with volumes varying from about \\(\\pu{100 \\upmu L}\\) to \\(\\pu{10 mL}\\). They are used for parallel sample processing in high throughput applications."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10249 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10249 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10249 "current"^^xsd:string)
Declaration(Class(goldbook:10250))
AnnotationAssertion(rdfs:label goldbook:10250 "needle trap")
AnnotationAssertion(dcterms:description goldbook:10250 "Gas-tight syringe with a sorbent-filled needle.")
AnnotationAssertion(rdfs:comment goldbook:10250 "Vertical movement of the plunger allows bidirectional flow of sample through the sorbent bed (active sampling). Alternatively, sampling can occur by diffusion of analytes into the syringe needle (passive sampling)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10250 goldbook:10165)
AnnotationAssertion(rdfs:seeAlso goldbook:10250 goldbook:10183)
AnnotationAssertion(rdfs:seeAlso goldbook:10250 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10250 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10250 "current"^^xsd:string)
Declaration(Class(goldbook:10251))
AnnotationAssertion(rdfs:label goldbook:10251 "particle-embedded glass fibre disc")
AnnotationAssertion(dcterms:description goldbook:10251 "Suspension of micron-sized sorbent particles woven into a glass fibre matrix.")
AnnotationAssertion(rdfs:comment goldbook:10251 "Small discs are self-supporting while larger discs require external support."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10251 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10251 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10251 "current"^^xsd:string)
Declaration(Class(goldbook:10252))
AnnotationAssertion(rdfs:label goldbook:10252 "particle-loaded membrane disc")
AnnotationAssertion(dcterms:description goldbook:10252 "Suspension of micron-sized sorbent particles distributed throughout a web of poly(tetrafluroethylene) microfibrils formed into a thin disc of various diameters.")
AnnotationAssertion(rdfs:comment goldbook:10252 "For general use the flexible discs are supported on a sintered glass disc in a filtration apparatus using suction to generate the desired flow through the membrane."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10252 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10252 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10252 "current"^^xsd:string)
Declaration(Class(goldbook:10253))
AnnotationAssertion(rdfs:label goldbook:10253 "restricted-access sorbent")
AnnotationAssertion(dcterms:description goldbook:10253 "Porous material with a biocompatible outer surface and a retentive interior surface.")
AnnotationAssertion(rdfs:comment goldbook:10253 "Access to the retentive interior surface is restricted for macromolecules by a physical or chemical diffusion barrier that facilitates elution of macromolecules and extraction of low-mass compounds."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10253 "The restricted access barrier can be accomplished by size exclusion, differential partitioning, or other phenomenon."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10253 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10253 "current"^^xsd:string)
Declaration(Class(goldbook:10254))
AnnotationAssertion(rdfs:label goldbook:10254 "rinse solvent")
AnnotationAssertion(dcterms:description goldbook:10254 "Weak solvent used to displace matrix components from a sorbent without displacing the target analyte(s).")
AnnotationAssertion(rdfs:comment goldbook:10254 "An optional step, intermediate between sample application and elution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10254 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10254 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10254 "current"^^xsd:string)
Declaration(Class(goldbook:10255))
AnnotationAssertion(rdfs:label goldbook:10255 "solid-phase extraction")
AnnotationAssertion(dcterms:description goldbook:10255 "Extraction of analytes from a gas, liquid, or fluid by transfer to a solid sorbent.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10255 "SPE")
AnnotationAssertion(rdfs:comment goldbook:10255 "Typical uses of solid-phase extraction include isolation, concentration, solvent exchange, and matrix simplification."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10255 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10255 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10255 "current"^^xsd:string)
Declaration(Class(goldbook:10256))
AnnotationAssertion(rdfs:label goldbook:10256 "solvent desorption")
AnnotationAssertion(dcterms:description goldbook:10256 "Use of a solvent, typically combined with agitation, to remove target analytes from a sorbent.")
AnnotationAssertion(rdfs:seeAlso goldbook:10256 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10256 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10256 "current"^^xsd:string)
Declaration(Class(goldbook:10257))
AnnotationAssertion(rdfs:label goldbook:10257 "sorbent-containing pipette tip")
AnnotationAssertion(dcterms:description goldbook:10257 "Disposable pipette tip with a small packed bed, disc, or monolithic plug of sorbent at its narrow end.Sorbent containing pipette tips in an array for use with a multiwall sample plate.")
AnnotationAssertion(rdfs:comment goldbook:10257 "A typical design of sorbent-containing pipette device for high throughput sample processing is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10257 "A micropipettor is used to control sample processing steps. This arrangement facilitates the use of bidirectional flow (the cycling of sample and solvents across the sorbent bed in either direction) for sample processing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10257 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10257 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10257 "current"^^xsd:string)
Declaration(Class(goldbook:10258))
AnnotationAssertion(rdfs:label goldbook:10258 "sorptive-tape extraction")
AnnotationAssertion(dcterms:description goldbook:10258 "Extraction from the surface of a solid by sorbent or polymer film in the form of a tape in direct contact with, or in the headspace above, the sample.")
AnnotationAssertion(rdfs:comment goldbook:10258 "The tape is typically a suitably-sized sheet of poly(dimethylsiloxane) polymer, or a piece of particle-loaded membrane, with a large surface area-to-volume ratio."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10258 goldbook:10198)
AnnotationAssertion(rdfs:seeAlso goldbook:10258 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10258 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10258 "current"^^xsd:string)
Declaration(Class(goldbook:10259))
AnnotationAssertion(rdfs:label goldbook:10259 "stir bar sorptive extraction")
AnnotationAssertion(dcterms:description goldbook:10259 "Extraction of compounds from solution by a sorbent coated magnetic stir bar by rapid stirring (direct immersion) or by exposure to the headspace above a sample (headspace extraction).")
AnnotationAssertion(rdfs:comment goldbook:10259 "Related devices for simultaneous stirring and sampling include rotating disc, stir rod, and stir membrane devices."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10259 "Rapid stirring accelerates mass transfer overcoming some of the limitations of diffusion controlled mass transfer in sessile solutions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10259 goldbook:10198)
AnnotationAssertion(rdfs:seeAlso goldbook:10259 goldbook:10267)
AnnotationAssertion(rdfs:seeAlso goldbook:10259 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10259 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10259 "current"^^xsd:string)
Declaration(Class(goldbook:10260))
AnnotationAssertion(rdfs:label goldbook:10260 "surface-bound macrocyclic sorbent")
AnnotationAssertion(dcterms:description goldbook:10260 "Porous sorbent with surface-bound macrocyclic ligands designed for the extraction of metal ions and some anions from aqueous solution.")
AnnotationAssertion(rdfs:comment goldbook:10260 "The selectivity of the extraction process depends on the stability of the host-guest complex, which can be optimized for individual ions by the choice of the macrocyclic cavity and the type of donor atoms."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10260 "Extracted ions are recovered by elution with a solution of complexing agent with a higher binding constant than the surface-bound macrocyclic ligand."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10260 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10260 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10260 "current"^^xsd:string)
Declaration(Class(goldbook:10261))
AnnotationAssertion(rdfs:label goldbook:10261 "surface-bound phenylboronic acid sorbent")
AnnotationAssertion(dcterms:description goldbook:10261 "Porous sorbent with surface-bound phenylboronic acid groups for the selective extraction of bifunctional compounds by reversible formation of 5- or 6-membered covalent cyclic boronic acid complexes.")
AnnotationAssertion(rdfs:comment goldbook:10261 "Extraction occurs at a basic \\(\\pu{pH}\\) for compounds with hydrogen-donating functional groups on neighbouring carbon atoms (1,2- and 1,3-). The analytes are released by elution with an acidic aqueous-organic solvent solution."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10261 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10261 "current"^^xsd:string)
Declaration(Class(goldbook:10262))
AnnotationAssertion(rdfs:label goldbook:10262 "biocompatible solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10262 "Extraction by a matrix-compatible immersion solid-phase microextraction device where the extraction phase and support are chosen to eliminate matrix interferences.")
AnnotationAssertion(rdfs:seeAlso goldbook:10262 goldbook:10276)
AnnotationAssertion(mito:isMentionedBy goldbook:10262 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10262 "current"^^xsd:string)
Declaration(Class(goldbook:10263))
AnnotationAssertion(rdfs:label goldbook:10263 "blade format")
AnnotationAssertion(dcterms:description goldbook:10263 "Solid-phase microextraction device where the extraction phase (sorbent) is dispersed in the form of a thin coating on the surface of a blade.")
AnnotationAssertion(rdfs:comment goldbook:10263 "This technique is typically used as a 96-blade brush in conjunction with a multiwell sample plate."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10263 goldbook:10276)
AnnotationAssertion(rdfs:seeAlso goldbook:10263 goldbook:10181)
AnnotationAssertion(rdfs:seeAlso goldbook:10263 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10263 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10263 "current"^^xsd:string)
Declaration(Class(goldbook:10264))
AnnotationAssertion(rdfs:label goldbook:10264 "coated-vessel format")
AnnotationAssertion(dcterms:description goldbook:10264 "Sample vessel with sorbent-coated walls.")
AnnotationAssertion(rdfs:seeAlso goldbook:10264 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10264 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10264 "current"^^xsd:string)
Declaration(Class(goldbook:10265))
AnnotationAssertion(rdfs:label goldbook:10265 "cold fibre solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10265 "Solid-phase microextraction in the fibre format with a sorbent temperature maintained below that of the sample matrix during extraction.")
AnnotationAssertion(rdfs:seeAlso goldbook:10265 goldbook:10276)
AnnotationAssertion(rdfs:seeAlso goldbook:10265 goldbook:10266)
AnnotationAssertion(rdfs:seeAlso goldbook:10265 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10265 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10265 "current"^^xsd:string)
Declaration(Class(goldbook:10266))
AnnotationAssertion(rdfs:label goldbook:10266 "fibre format")
AnnotationAssertion(dcterms:description goldbook:10266 "Extraction phase in the form of a thin layer supported on a fibre made of inert material, such as fused silica, stainless steel, or nickel-titanium alloy.")
AnnotationAssertion(rdfs:seeAlso goldbook:10266 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10266 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10266 "current"^^xsd:string)
Declaration(Class(goldbook:10267))
AnnotationAssertion(rdfs:label goldbook:10267 "headspace solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10267 "Solid-phase microextraction where the extraction phase is placed in the headspace above the sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:10267 goldbook:10276)
AnnotationAssertion(rdfs:seeAlso goldbook:10267 goldbook:10175)
AnnotationAssertion(rdfs:seeAlso goldbook:10267 goldbook:10198)
AnnotationAssertion(mito:isMentionedBy goldbook:10267 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10267 "current"^^xsd:string)
Declaration(Class(goldbook:10268))
AnnotationAssertion(rdfs:label goldbook:10268 "immersion solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10268 "Solid-phase microextraction where the extraction phase is immersed directly into the sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:10268 goldbook:10276)
AnnotationAssertion(rdfs:seeAlso goldbook:10268 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10268 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10268 "current"^^xsd:string)
Declaration(Class(goldbook:10269))
AnnotationAssertion(rdfs:label goldbook:10269 "in-needle capillary adsorption trap")
AnnotationAssertion(dcterms:description goldbook:10269 "In-tube format device with a sorbent-coated capillary placed inside a needle.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10269 "INCAT")
AnnotationAssertion(rdfs:seeAlso goldbook:10269 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10269 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10269 "current"^^xsd:string)
Declaration(Class(goldbook:10270))
AnnotationAssertion(rdfs:label goldbook:10270 "in-tube solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10270 "Extraction utilizing a coated open tubular or packed capillary tube as the extraction phase in a flow system.")
AnnotationAssertion(mito:isMentionedBy goldbook:10270 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10270 "current"^^xsd:string)
Declaration(Class(goldbook:10271))
AnnotationAssertion(rdfs:label goldbook:10271 "matrix-compatible solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10271 "Immersion solid-phase microextraction where the extraction phase is designed to minimize sorption of particles or macromolecules present in the sample matrix.")
AnnotationAssertion(rdfs:comment goldbook:10271 "Sorption of particles and macromolecules by the extraction phase is a potential source of interference in the extraction process or subsequent determination of analytes when sampling occurs by direct contact of the extraction phase with the sample. In some cases this can be addressed by incorporation of specific properties in the extraction phase that minimize matrix-extraction phase interactions for problem matrix components."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10271 goldbook:10268)
AnnotationAssertion(rdfs:seeAlso goldbook:10271 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10271 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10271 "current"^^xsd:string)
Declaration(Class(goldbook:10272))
AnnotationAssertion(rdfs:label goldbook:10272 "membrane-protected solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10272 "Immersion solid-phase microextraction in which the extraction phase is surrounded by a permeable membrane that allows access of analytes to the extraction phase while shielding the extraction phase from matrix components with a potential to interfere in the extraction or subsequent analysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:10272 goldbook:10268)
AnnotationAssertion(rdfs:seeAlso goldbook:10272 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10272 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10272 "current"^^xsd:string)
Declaration(Class(goldbook:10273))
AnnotationAssertion(rdfs:label goldbook:10273 "particle sorbent")
AnnotationAssertion(dcterms:description goldbook:10273 "Extraction phase in the form of sorbent particles.")
AnnotationAssertion(rdfs:comment goldbook:10273 "Particles are typically of a nanometre size and applied in the dispersion mode of extraction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10273 goldbook:10175)
AnnotationAssertion(rdfs:seeAlso goldbook:10273 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10273 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10273 "current"^^xsd:string)
Declaration(Class(goldbook:10274))
AnnotationAssertion(rdfs:label goldbook:10274 "rotating disk sorptive extraction")
AnnotationAssertion(dcterms:description goldbook:10274 "Sorbent-coated disc consisting of a polytetrafluoroethylene (PTFE) base with an integrated magnet and a sorbent film attached to one side.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10274 "RDSE")
AnnotationAssertion(rdfs:comment goldbook:10274 "Facilitates more rapid stirring than conventional sorbent-coated stir bars (see stir bar sorptive extraction) without deterioration of the sorbent coating, because it is not in contact with the vessel wall."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10274 goldbook:10163)
AnnotationAssertion(rdfs:seeAlso goldbook:10274 goldbook:10259)
AnnotationAssertion(mito:isMentionedBy goldbook:10274 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10274 "current"^^xsd:string)
Declaration(Class(goldbook:10275))
AnnotationAssertion(rdfs:label goldbook:10275 "solid-phase dynamic extraction")
AnnotationAssertion(dcterms:description goldbook:10275 "Solid-phase microextraction in which the extraction phase is coated on the internal surface of a needle.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10275 "SPDE")
AnnotationAssertion(rdfs:seeAlso goldbook:10275 goldbook:10276)
AnnotationAssertion(mito:isMentionedBy goldbook:10275 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10275 "current"^^xsd:string)
Declaration(Class(goldbook:10276))
AnnotationAssertion(rdfs:label goldbook:10276 "solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10276 "Microextraction where the extraction phase is a solid.")
AnnotationAssertion(rdfs:comment goldbook:10276 "This term is often narrowly used to describe an extraction process employing a syringe-based sampling device with a short length of small gauge solid fiber or wire coated with sorbent attached to one end of the plunger of the syringe to facilitate bidirectional movement of the sorbent-coated fiber (wire) through the syringe needle for extraction, storage, and desorption of extractants. For extraction the sorbent is exposed to the headspace above the sample or immersed directly into the sample solution. Sample components diffuse into and/or onto the sorbent coating until equilibrium is reached. The extractants are subsequently recovered by thermal desorption into a gas stream (typically in the liner of an injection port of a gas chromatograph) or rinsed from the sorbent coating with solvent for determination by other methods."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10276 "The extraction phase can also be a liquid physically coated on a fiber or wire support."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10276 goldbook:11552)
AnnotationAssertion(rdfs:seeAlso goldbook:10276 goldbook:10175)
AnnotationAssertion(rdfs:seeAlso goldbook:10276 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10276 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10276 "current"^^xsd:string)
Declaration(Class(goldbook:10277))
AnnotationAssertion(rdfs:label goldbook:10277 "thin film format")
AnnotationAssertion(dcterms:description goldbook:10277 "Solid-phase microextraction where the sorbent is in the form of a thin film on a support or self supported membrane.")
AnnotationAssertion(rdfs:seeAlso goldbook:10277 goldbook:10276)
AnnotationAssertion(rdfs:seeAlso goldbook:10277 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10277 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10277 "current"^^xsd:string)
Declaration(Class(goldbook:10278))
AnnotationAssertion(rdfs:label goldbook:10278 "electromembrane extraction")
AnnotationAssertion(dcterms:description goldbook:10278 "Hollow-fibre liquid-phase microextraction in which the extraction is driven by an electrical potential sustained between the sample solution and the acceptor phase, separated by a supported liquid membrane.Typical experimental arrangement for electromembrane extraction of cations (anions extracted by reversing the polarity). SLM, supported liquid membrane in the form of a porous hollow fiber with solvent-filled pores.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10278 "EME")
AnnotationAssertion(rdfs:comment goldbook:10278 "A typical experimental arrangement is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10278 "Electromembrane extraction is typically performed in three-phase mode (\\(\\ce{aqueous\\!->\\!organic\\!->\\!aqueous}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10278 "The sample is agitated or stirred during extraction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10278 goldbook:10280)
AnnotationAssertion(rdfs:seeAlso goldbook:10278 goldbook:10164)
AnnotationAssertion(rdfs:seeAlso goldbook:10278 goldbook:10293)
AnnotationAssertion(mito:isMentionedBy goldbook:10278 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10278 "current"^^xsd:string)
Declaration(Class(goldbook:10279))
AnnotationAssertion(rdfs:label goldbook:10279 "hollow fibre")
AnnotationAssertion(dcterms:description goldbook:10279 "Narrow cylindrical tube prepared from a porous polymer.")
AnnotationAssertion(rdfs:comment goldbook:10279 "The internal diameter of the tube is typically \\(\\pu{500 \\upmu m}\\) – \\(\\pu{1.5 mm}\\) with walls \\(\\pu{100 \\upmu m}\\) to \\(\\pu{300 \\upmu m}\\) thick. Fibers are typically prepared from porous poly(propylene), although other materials can be used."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10279 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10279 "current"^^xsd:string)
Declaration(Class(goldbook:10280))
AnnotationAssertion(rdfs:label goldbook:10280 "hollow-fibre liquid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10280 "Liquid-phase microextraction of analytes from a liquid (or gaseous) sample by a supported liquid membrane in the form of a porous hollow fibre with solvent-filled pores. The analytes are transferred to an acceptor phase contained in the cavity of the hollow fibre.Typical experimental arrangement for hollow-fiber supported liquid membrane (SLM) for liquid-phase microextraction.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10280 "HF-LPME")
AnnotationAssertion(rdfs:comment goldbook:10280 "A typical experimental arrangement is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10280 "The supported liquid membrane is generally an organic solvent immiscible with water and the sample an aqueous solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10280 "The acceptor phase can be aqueous, which provides a three-phase extraction system (\\(\\ce{aqueous\\!->\\!organic\\!->\\!aqueous}\\)), or an organic solvent, providing a two-phase extraction system (\\(\\ce{aqueous\\!->\\!organic}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10280 "The sample is agitated or stirred during extraction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10280 goldbook:10216)
AnnotationAssertion(rdfs:seeAlso goldbook:10280 goldbook:10164)
AnnotationAssertion(rdfs:seeAlso goldbook:10280 goldbook:10279)
AnnotationAssertion(rdfs:seeAlso goldbook:10280 goldbook:10293)
AnnotationAssertion(mito:isMentionedBy goldbook:10280 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10280 "current"^^xsd:string)
Declaration(Class(goldbook:10281))
AnnotationAssertion(rdfs:label goldbook:10281 "membrane extraction")
AnnotationAssertion(dcterms:description goldbook:10281 "Extraction of analytes from a sample by permeation through a membrane.")
AnnotationAssertion(mito:isMentionedBy goldbook:10281 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10281 "current"^^xsd:string)
Declaration(Class(goldbook:10282))
AnnotationAssertion(rdfs:label goldbook:10282 "membrane extraction with sorbent interface")
AnnotationAssertion(dcterms:description goldbook:10282 "Membrane extraction with a sorbent trap for concentration of the permeate.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10282 "MESI")
AnnotationAssertion(rdfs:comment goldbook:10282 "MESI is typically used in a system consisting of three components: (1) membrane extraction module; (2) sorbent interface; and (3) gas chromatograph. A flow of gas is used as the stripping phase to transfer permeate to the sorbent trap for concentration and thermal desorption into the gas chromatograph."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10282 goldbook:10281)
AnnotationAssertion(rdfs:seeAlso goldbook:10282 goldbook:10201)
AnnotationAssertion(mito:isMentionedBy goldbook:10282 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10282 "current"^^xsd:string)
Declaration(Class(goldbook:10283))
AnnotationAssertion(rdfs:label goldbook:10283 "microdialysis")
AnnotationAssertion(dcterms:description goldbook:10283 "Dialysis by a short length of hollow-fibre membrane used for sampling.")
AnnotationAssertion(rdfs:comment goldbook:10283 "Microdialysis is performed mostly in a living biological system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10283 goldbook:10279)
AnnotationAssertion(mito:isMentionedBy goldbook:10283 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10283 "current"^^xsd:string)
Declaration(Class(goldbook:10284))
AnnotationAssertion(rdfs:label goldbook:10284 "non-porous membrane")
AnnotationAssertion(dcterms:description goldbook:10284 "Membrane in which permeation occurs by processes other than flow through pores.")
AnnotationAssertion(rdfs:seeAlso goldbook:10284 goldbook:10287)
AnnotationAssertion(rdfs:seeAlso goldbook:10284 goldbook:10288)
AnnotationAssertion(mito:isMentionedBy goldbook:10284 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10284 "current"^^xsd:string)
Declaration(Class(goldbook:10285))
AnnotationAssertion(rdfs:label goldbook:10285 "parallel artificial liquid membrane extraction")
AnnotationAssertion(dcterms:description goldbook:10285 "Extraction of analytes from aqueous samples in a multiwell plate with a porous membrane at the base of each well by migration through the solvent-filled membrane pores into an acceptor phase located in each well.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10285 "PALME")
AnnotationAssertion(rdfs:comment goldbook:10285 "The solvent-filled filter pores function as a supported liquid membrane typically based on an organic solvent immiscible with water."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10285 "PALME is usually performed in the three-phase mode (\\(\\ce{aqueous\\!->\\!organic\\!->\\!aqueous}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10285 goldbook:10164)
AnnotationAssertion(rdfs:seeAlso goldbook:10285 goldbook:10181)
AnnotationAssertion(rdfs:seeAlso goldbook:10285 goldbook:10293)
AnnotationAssertion(mito:isMentionedBy goldbook:10285 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10285 "current"^^xsd:string)
Declaration(Class(goldbook:10286))
AnnotationAssertion(rdfs:label goldbook:10286 "perfusate")
AnnotationAssertion(dcterms:description goldbook:10286 "Stream of extraction phase entering a dialysis module.")
AnnotationAssertion(rdfs:comment goldbook:10286 "Perfusate is also used to describe the stripping phase in dialysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10286 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10286 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10286 "current"^^xsd:string)
Declaration(Class(goldbook:10287))
AnnotationAssertion(rdfs:label goldbook:10287 "permeation")
AnnotationAssertion(dcterms:description goldbook:10287 "Process by which mass transfer occurs through a membrane.")
AnnotationAssertion(mito:isMentionedBy goldbook:10287 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10287 "current"^^xsd:string)
Declaration(Class(goldbook:10288))
AnnotationAssertion(rdfs:label goldbook:10288 "porous membrane")
AnnotationAssertion(dcterms:description goldbook:10288 "Membrane in which permeation occurs through its porous structure.")
AnnotationAssertion(rdfs:seeAlso goldbook:10288 goldbook:10284)
AnnotationAssertion(rdfs:seeAlso goldbook:10288 goldbook:10287)
AnnotationAssertion(mito:isMentionedBy goldbook:10288 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10288 "current"^^xsd:string)
Declaration(Class(goldbook:10289))
AnnotationAssertion(rdfs:label goldbook:10289 "retentate stream")
AnnotationAssertion(dcterms:description goldbook:10289 "Sample left over in membrane separations after initial contact with the membrane.")
AnnotationAssertion(mito:isMentionedBy goldbook:10289 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10289 "current"^^xsd:string)
Declaration(Class(goldbook:10290))
AnnotationAssertion(rdfs:label goldbook:10290 "semipermeable membrane device")
AnnotationAssertion(dcterms:description goldbook:10290 "Membrane extraction in which the membrane fully encloses an acceptor phase.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10290 "SPMD")
AnnotationAssertion(rdfs:comment goldbook:10290 "Typically, a membrane filled with acceptor phase and formed into a sealed tube is immersed in the sample. As a passive sampling device, it is used to obtain time-weighted average concentrations for trace contaminants or to isolate them for toxicity assessment. With triolein as an acceptor phase, it is used to estimate the bioconcentration of contaminants in fatty tissues of organisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10290 goldbook:10281)
AnnotationAssertion(rdfs:seeAlso goldbook:10290 goldbook:10164)
AnnotationAssertion(mito:isMentionedBy goldbook:10290 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10290 "current"^^xsd:string)
Declaration(Class(goldbook:10291))
AnnotationAssertion(rdfs:label goldbook:10291 "stream")
AnnotationAssertion(dcterms:description goldbook:10291 "The sample in membrane separations prior to contact with the membrane.")
AnnotationAssertion(mito:isMentionedBy goldbook:10291 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10291 "current"^^xsd:string)
Declaration(Class(goldbook:10292))
AnnotationAssertion(rdfs:label goldbook:10292 "stripping phase")
AnnotationAssertion(dcterms:description goldbook:10292 "Extraction phase in a membrane separation.")
AnnotationAssertion(rdfs:seeAlso goldbook:10292 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10292 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10292 "current"^^xsd:string)
Declaration(Class(goldbook:10293))
AnnotationAssertion(rdfs:label goldbook:10293 "supported liquid membrane")
AnnotationAssertion(dcterms:description goldbook:10293 "Porous membrane with solvent-filled pores.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10293 "SLM")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10293 "artificial liquid membrane")
AnnotationAssertion(rdfs:comment goldbook:10293 "Porous polymeric hollow fibres and filter disks are typically used as support formats for microextraction techniques."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10293 "Water immiscible organic solvents are typically employed in the preparation of supported liquid membranes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10293 goldbook:10288)
AnnotationAssertion(rdfs:seeAlso goldbook:10293 goldbook:10279)
AnnotationAssertion(rdfs:seeAlso goldbook:10293 goldbook:11552)
AnnotationAssertion(mito:isMentionedBy goldbook:10293 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10293 "current"^^xsd:string)
Declaration(Class(goldbook:10294))
AnnotationAssertion(rdfs:label goldbook:10294 "at-line extraction")
AnnotationAssertion(dcterms:description goldbook:10294 "Flow system with extraction device employing a local detector.")
AnnotationAssertion(rdfs:comment goldbook:10294 "The extraction phase is typically collected in an automated fraction collector and introduced into a detector via a robotic device."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10294 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:10294 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10294 "current"^^xsd:string)
Declaration(Class(goldbook:10295))
AnnotationAssertion(rdfs:label goldbook:10295 "automated extraction")
AnnotationAssertion(dcterms:description goldbook:10295 "Extraction in a mechanical device regulated by feed-back of information without human intervention.")
AnnotationAssertion(rdfs:seeAlso goldbook:10295 goldbook:10307)
AnnotationAssertion(mito:isMentionedBy goldbook:10295 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10295 "current"^^xsd:string)
Declaration(Class(goldbook:10296))
AnnotationAssertion(rdfs:label goldbook:10296 "automatic extraction")
AnnotationAssertion(dcterms:description goldbook:10296 "Extraction according to manually preselected conditions without further human intervention.")
AnnotationAssertion(mito:isMentionedBy goldbook:10296 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10296 "current"^^xsd:string)
Declaration(Class(goldbook:10297))
AnnotationAssertion(rdfs:label goldbook:10297 "bead injection")
AnnotationAssertion(dcterms:description goldbook:10297 "Fully renewable (disposable) packed sorbent bed for solid-phase extraction in a flow manifold or mesofluidic platform using programmable flow extraction.Bead-injection protocols for automated solid phase microextraction with sorbent renewal for each assay [Reproduced from  https://www.flowinjectiontutorial.com].a) Injection of a metered amount of particles or beads with reactive surfaces in the flow system followed by mechanical trapping or capture with the aid of external energy sources; b) Injection of a metered volume of sample; c) Interaction of analyte(s) with sorptive surfaces; d) Preconcentration of analyte(s) followed by detection of native species or derivatization products; e) Automatic removal of sorptive surfaces.")
AnnotationAssertion(rdfs:comment goldbook:10297 "A typical workflow for bead injection in a flow manifold is shown in the figure below."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10297 goldbook:10313)
AnnotationAssertion(rdfs:seeAlso goldbook:10297 goldbook:10276)
AnnotationAssertion(rdfs:seeAlso goldbook:10297 goldbook:10255)
AnnotationAssertion(mito:isMentionedBy goldbook:10297 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10297 "current"^^xsd:string)
Declaration(Class(goldbook:10298))
AnnotationAssertion(rdfs:label goldbook:10298 "bioaccessibility")
AnnotationAssertion(dcterms:description goldbook:10298 "Fraction of analytes desorbed from a sample potentially available to organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10298 "environmental availabilty")
AnnotationAssertion(rdfs:comment goldbook:10298 "Bioaccessibility tests are usually performed by operationally defined leaching."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10298 "Also termed environmental availability."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10298 goldbook:10179)
AnnotationAssertion(mito:isMentionedBy goldbook:10298 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10298 "current"^^xsd:string)
Declaration(Class(goldbook:10299))
AnnotationAssertion(rdfs:label goldbook:10299 "dynamic bioaccessibility")
AnnotationAssertion(dcterms:description goldbook:10299 "Leaching of analytes from a solid or semi-solid sample in a flow-through device to evaluate their bioaccessibility.")
AnnotationAssertion(rdfs:seeAlso goldbook:10299 goldbook:10298)
AnnotationAssertion(mito:isMentionedBy goldbook:10299 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10299 "current"^^xsd:string)
Declaration(Class(goldbook:10300))
AnnotationAssertion(rdfs:label goldbook:10300 "flow-through extraction")
AnnotationAssertion(dcterms:description goldbook:10300 "Extraction by flow of sample through or over the extraction phase, or vice versa, to enhance the extraction rate.")
AnnotationAssertion(rdfs:comment goldbook:10300 "The forced flow of matrix or extraction phase is controlled by an external device."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10300 goldbook:10175)
AnnotationAssertion(rdfs:seeAlso goldbook:10300 goldbook:10176)
AnnotationAssertion(mito:isMentionedBy goldbook:10300 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10300 "current"^^xsd:string)
Declaration(Class(goldbook:10301))
AnnotationAssertion(rdfs:label goldbook:10301 "flow-through solid-phase spectrometry")
AnnotationAssertion(dcterms:description goldbook:10301 "Continuous optical interrogation of a packed-sorbent bed in a flow system at any stage of the extraction process prior to analyte elution and sorbent regeneration.")
AnnotationAssertion(rdfs:seeAlso goldbook:10301 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:10301 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10301 "current"^^xsd:string)
Declaration(Class(goldbook:10302))
AnnotationAssertion(rdfs:label goldbook:10302 "in-line extraction")
AnnotationAssertion(dcterms:description goldbook:10302 "Coupling of a flow system with extraction device to a detector without flow interruption.")
AnnotationAssertion(mito:isMentionedBy goldbook:10302 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10302 "current"^^xsd:string)
Declaration(Class(goldbook:10303))
AnnotationAssertion(rdfs:label goldbook:10303 "in-syringe microextraction")
AnnotationAssertion(dcterms:description goldbook:10303 "Batch-type extraction in which the barrel of a syringe pump is used as the device for liquid-phase microextraction or dispersive solid-phase microextraction.")
AnnotationAssertion(rdfs:seeAlso goldbook:10303 goldbook:10216)
AnnotationAssertion(rdfs:seeAlso goldbook:10303 goldbook:10276)
AnnotationAssertion(mito:isMentionedBy goldbook:10303 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10303 "current"^^xsd:string)
Declaration(Class(goldbook:10304))
AnnotationAssertion(rdfs:label goldbook:10304 "lab-at-valve liquid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10304 "Automatic batch-type liquid-phase microextraction by sequential injection analysis using an external extraction container (e.g. pipette tip) connected to a multiposition rotary valve.")
AnnotationAssertion(rdfs:seeAlso goldbook:10304 goldbook:11552)
AnnotationAssertion(rdfs:seeAlso goldbook:10304 goldbook:10316)
AnnotationAssertion(mito:isMentionedBy goldbook:10304 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10304 "current"^^xsd:string)
Declaration(Class(goldbook:10305))
AnnotationAssertion(rdfs:label goldbook:10305 "lab-on-a-chip extraction")
AnnotationAssertion(dcterms:description goldbook:10305 "Microfluidic platform containing microconduits to facilitate extraction processes with pressure-driven or electroosmotic flow.")
AnnotationAssertion(mito:isMentionedBy goldbook:10305 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10305 "current"^^xsd:string)
Declaration(Class(goldbook:10306))
AnnotationAssertion(rdfs:label goldbook:10306 "lab-on-valve extraction")
AnnotationAssertion(dcterms:description goldbook:10306 "Mesofluidic platform containing microconduits for extraction processes mounted on a multi-position rotary valve.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10306 "LOV")
AnnotationAssertion(mito:isMentionedBy goldbook:10306 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10306 "current"^^xsd:string)
Declaration(Class(goldbook:10307))
AnnotationAssertion(rdfs:label goldbook:10307 "mechanized extraction")
AnnotationAssertion(dcterms:description goldbook:10307 "Extraction using a device with at least one movable part that replaces or supplements human effort in any (or all) steps of the process.")
AnnotationAssertion(rdfs:seeAlso goldbook:10307 goldbook:10295)
AnnotationAssertion(mito:isMentionedBy goldbook:10307 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10307 "current"^^xsd:string)
Declaration(Class(goldbook:10308))
AnnotationAssertion(rdfs:label goldbook:10308 "mesofluidic extraction device")
AnnotationAssertion(dcterms:description goldbook:10308 "Extraction device with channel widths from \\(\\pu{10 \\upmu m}\\) to \\(\\pu{2 mm}\\) integrated into a flow platform.")
AnnotationAssertion(rdfs:comment goldbook:10308 "Lab-on-valve platforms belong to the group of mesofluidic devices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10308 goldbook:10306)
AnnotationAssertion(mito:isMentionedBy goldbook:10308 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10308 "current"^^xsd:string)
Declaration(Class(goldbook:10309))
AnnotationAssertion(rdfs:label goldbook:10309 "microflow injection analysis extraction device")
AnnotationAssertion(dcterms:description goldbook:10309 "Miniaturized flow injection analysis device for extraction with conduits of a diameter greater than \\(\\pu{0.1 mm}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:10309 "μFIA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10309 "μFIA extraction device")
AnnotationAssertion(mito:isMentionedBy goldbook:10309 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10309 "current"^^xsd:string)
Declaration(Class(goldbook:10310))
AnnotationAssertion(rdfs:label goldbook:10310 "microfluidic extraction device")
AnnotationAssertion(dcterms:description goldbook:10310 "Extraction device with channel widths from \\(\\pu{100 nm}\\) to \\(\\pu{10 \\upmu m}\\) integrated into a flow platform.")
AnnotationAssertion(mito:isMentionedBy goldbook:10310 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10310 "current"^^xsd:string)
Declaration(Class(goldbook:10311))
AnnotationAssertion(rdfs:label goldbook:10311 "multicommutation flow extraction")
AnnotationAssertion(dcterms:description goldbook:10311 "Programmable flow extraction device with microsolenoid valves for processing microliter sample volumes.")
AnnotationAssertion(rdfs:seeAlso goldbook:10311 goldbook:10313)
AnnotationAssertion(mito:isMentionedBy goldbook:10311 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10311 "current"^^xsd:string)
Declaration(Class(goldbook:10312))
AnnotationAssertion(rdfs:label goldbook:10312 "on-line extraction")
AnnotationAssertion(dcterms:description goldbook:10312 "Coupling of a flow system with an extraction device to a detector via a discontinuous interface.")
AnnotationAssertion(rdfs:comment goldbook:10312 "A suitable discontinuous interface is a rotary valve with a sample loop."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10312 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10312 "current"^^xsd:string)
Declaration(Class(goldbook:10313))
AnnotationAssertion(rdfs:label goldbook:10313 "programmable flow extraction")
AnnotationAssertion(dcterms:description goldbook:10313 "Multi-bidirectional flow (including stopped flow) of sample and/or extractant through an extraction device controlled by a pump.")
AnnotationAssertion(mito:isMentionedBy goldbook:10313 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10313 "current"^^xsd:string)
Declaration(Class(goldbook:10314))
AnnotationAssertion(rdfs:label goldbook:10314 "segmented flow analysis")
AnnotationAssertion(dcterms:description goldbook:10314 "Continuous-flow system attaining steady-state extraction/reaction conditions facilitated by injection of air bubbles. This might be extended to immiscible liquids injected as droplets in the flow system. Related term: segmented flow extraction.")
AnnotationAssertion(rdfs:seeAlso goldbook:10314 goldbook:10315)
AnnotationAssertion(mito:isMentionedBy goldbook:10314 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10314 "current"^^xsd:string)
Declaration(Class(goldbook:10315))
AnnotationAssertion(rdfs:label goldbook:10315 "segmented flow extraction")
AnnotationAssertion(dcterms:description goldbook:10315 "Extraction by insertion of the sample solution as equal-size droplets (segments) in a flowing stream of immiscible extraction phase.Typical segmented flow extraction manifold. C, carrier or liquid phase for sample; R, reagent (optional); P, propulsion unit; S, sample; IV, injection valve; MC, mixing coil; DB, displacement bottle (functions as a constant volume pump); ORG, organic solvent; SG, segmenter; EC, extraction coil; PS, phase separator; D, detector (optional); RC, restriction coil; and W, waste.")
AnnotationAssertion(rdfs:comment goldbook:10315 "The characteristic components of the system are the segmenter (creates the droplets in the solvent stream); the extraction coil (provides sufficient time for transfer of target analytes to the extraction solvent); and the phase separator (reconstitutes the sample solution and extraction solvent into two separate streams)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10315 "A typical apparatus for segmented flow extraction is shown in figure below."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:10315 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10315 "current"^^xsd:string)
