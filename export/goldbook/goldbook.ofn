AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11840 "allograft inflammatory factor 1 (AIF-1)")
AnnotationAssertion(rdfs:comment goldbook:11840 "Expression of Iba-1 is up-regulated upon activation of microglia, thus allowing identification of areas of brain injury or inflammation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11840 goldbook:11647)
