AnnotationAssertion(obo:goldbook#hasStatus goldbook:10019 "current"^^xsd:string)
Declaration(Class(goldbook:10020))
AnnotationAssertion(rdfs:label goldbook:10020 "nominal reference material")
AnnotationAssertion(dcterms:description goldbook:10020 "Material, sufficiently homogeneous and stable with reference to a specified nominal property, that has been established to be fit for its intended use in an examination.")
AnnotationAssertion(rdfs:comment goldbook:10020 "Nominal reference materials with or without assigned reference nominal property values can be used for control of examination precision, whereas only nominal reference materials with assigned reference nominal property values can be used for the control of examination calibration or evaluation of examination trueness."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10020 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:10020 goldbook:10021)
AnnotationAssertion(rdfs:seeAlso goldbook:10020 goldbook:10007)
