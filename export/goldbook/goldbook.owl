        <rdfs:label>endocardium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10661"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10656 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10656">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation and growth of bone tissue (especially of the long bones) during fetal development of the mammalian skeletal system, and in repair of bone fractures, that takes place in the presence of cartilage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Endochondral ossification is one of two mechanisms for bone formation, the other being intramembrous ossification.</rdfs:comment>
        <rdfs:label>endochondral ossification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10861"/>
    </owl:Class>
    


