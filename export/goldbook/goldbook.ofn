AnnotationAssertion(rdfs:seeAlso goldbook:11925 goldbook:12076)
AnnotationAssertion(mito:isMentionedBy goldbook:11925 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11925 "current"^^xsd:string)
Declaration(Class(goldbook:11926))
AnnotationAssertion(rdfs:label goldbook:11926 "neurodegenerative disease")
AnnotationAssertion(dcterms:description goldbook:11926 "Disease of the brain and (or) peripheral nervous system with progressive loss of neuronal function, accompanied by changes in morphology and subcellular organization of the nervous system.")
AnnotationAssertion(rdfs:seeAlso goldbook:11926 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11926 goldbook:11916)
AnnotationAssertion(rdfs:seeAlso goldbook:11926 goldbook:12003)
