Declaration(Class(goldbook:GT07620))
AnnotationAssertion(rdfs:label goldbook:GT07620 "gel aging")
AnnotationAssertion(dcterms:description goldbook:GT07620 "Time-dependent changes in the chemical or the physical structure and the properties of a gel.")
AnnotationAssertion(rdfs:comment goldbook:GT07620 "The aging of a gel can involve polymerization, crystallization, aggregation, syneresis, phase changes, formation of branch points and junction points as well as scission and chemical changes to constitutional units of network chains."^^xsd:string)
