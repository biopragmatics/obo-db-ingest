AnnotationAssertion(dcterms:description goldbook:11874 "Recurrent syndrome usually characterized by unilateral head pain accompanied by symptoms including nausea and vomiting, vertigo, photophobia and other visual phenomena.")
AnnotationAssertion(rdfs:comment goldbook:11874 "Migraine can be classified as classic migraine, common migraine, cluster headache, hemiplegic migraine, and ophthalm(opleg)ic migraine."^^xsd:string)
