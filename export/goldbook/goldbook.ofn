AnnotationAssertion(obo:goldbook#hasStatus goldbook:LT07408 "current"^^xsd:string)
Declaration(Class(goldbook:LT07409))
AnnotationAssertion(rdfs:label goldbook:LT07409 "Landau–Zener model")
AnnotationAssertion(dcterms:description goldbook:LT07409 "Within the Born–Oppenheimer approximation, a semi-classical model for the probability, \\(P\\), of hopping from one electronic state to another of the same or different multiplicity \\[P=\\exp (- \\frac{4\\ \\pi ^{2}\\ \\varepsilon_{12}^{2}}{h\\  u\\ |s_{1}-s_{2}|})\\] where \\(\\varepsilon_{12}\\) is the potential energy gap between the two electronic states at a surface crossing point, \\(|s_{1}- s_{2}|\\) is the difference in slopes between the intersecting potential energy curves at this point and \\( u\\) is the nuclear relative velocity with which the system passes the point of closest approach.")
AnnotationAssertion(rdfs:comment goldbook:LT07409 "The original formalism only considered states of the same spin multiplicity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:LT07409 goldbook:ET07026)
AnnotationAssertion(rdfs:seeAlso goldbook:LT07409 goldbook:P04855)
AnnotationAssertion(rdfs:seeAlso goldbook:LT07409 goldbook:S06166)
AnnotationAssertion(mito:isMentionedBy goldbook:LT07409 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:LT07409 "current"^^xsd:string)
