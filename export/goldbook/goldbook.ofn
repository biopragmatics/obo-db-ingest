AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03655 "current"^^xsd:string)
Declaration(Class(goldbook:L03656))
AnnotationAssertion(rdfs:label goldbook:L03656 "lyophilic sols")
AnnotationAssertion(dcterms:description goldbook:L03656 "These comprise both association colloids in which aggregates of small molecules are formed reversibly and macromolecules in which the molecules themselves are of colloidal size.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03656 goldbook:A00184)
AnnotationAssertion(rdfs:seeAlso goldbook:L03656 goldbook:A00472)
