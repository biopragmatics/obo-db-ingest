Declaration(Class(goldbook:C00782))
AnnotationAssertion(rdfs:label goldbook:C00782 "calibration sample")
AnnotationAssertion(dcterms:description goldbook:C00782 "The test portion or test solution used for calibration of an analytical procedure. The calibration sample is normally of known weight or volume and is prepared according to specifications.")
