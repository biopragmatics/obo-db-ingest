AnnotationAssertion(rdfs:label goldbook:13114 "enterotoxin")
AnnotationAssertion(dcterms:description goldbook:13114 "Toxin affecting intestinal cells and thus causing food poisoning.")
AnnotationAssertion(rdfs:comment goldbook:13114 "Enterotoxins stimulate many types of T cells by binding to major histocompatibility complex (MHC) class II molecules and the Vb domain of certain T-cell receptors (TCRs). Enterotoxins have thus been referred to as superantigens."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13114 goldbook:13724)
