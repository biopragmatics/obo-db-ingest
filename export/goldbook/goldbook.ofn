AnnotationAssertion(rdfs:label goldbook:12973 "CD4")
AnnotationAssertion(dcterms:description goldbook:12973 "Cell surface antigen belonging to the immunoglobulin (Ig) superfamily of molecules and a marker of T helper cells.")
AnnotationAssertion(rdfs:comment goldbook:12973 "As an adhesion molecule, it interacts with the non-polymorphic part of major histocompatibility complex (MHC) class II gene product."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12973 goldbook:13199)
AnnotationAssertion(rdfs:seeAlso goldbook:12973 goldbook:13432)
AnnotationAssertion(rdfs:seeAlso goldbook:12973 goldbook:13700)
