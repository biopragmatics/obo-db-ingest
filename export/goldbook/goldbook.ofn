Declaration(Class(goldbook:12981))
AnnotationAssertion(rdfs:label goldbook:12981 "CD40 ligand")
AnnotationAssertion(dcterms:description goldbook:12981 "Essential molecule for normal switching signaling through binding to CD40 on B cells. The interaction of CD40L and CD40 is also critical for optimal T cell function.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12981 "CD40L")
AnnotationAssertion(rdfs:seeAlso goldbook:12981 goldbook:12937)
