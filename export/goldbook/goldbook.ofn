Declaration(Class(goldbook:CT06930))
AnnotationAssertion(rdfs:label goldbook:CT06930 "chiral mobile phase")
AnnotationAssertion(dcterms:description goldbook:CT06930 "A mobile phase containing a chiral selector.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06930 goldbook:CT06931)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06930 doi:10.1351/pac199769071469)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06930 "current"^^xsd:string)
Declaration(Class(goldbook:CT06931))
AnnotationAssertion(rdfs:label goldbook:CT06931 "chiral selector")
AnnotationAssertion(dcterms:description goldbook:CT06931 "The chiral component of the separation system capable of interacting enantioselectively with the enantiomers to be separated.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06931 goldbook:C01057)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06931 doi:10.1351/pac199769071469)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06931 "current"^^xsd:string)
Declaration(Class(goldbook:CT06937))
AnnotationAssertion(rdfs:label goldbook:CT06937 "convex isotherm")
AnnotationAssertion(dcterms:description goldbook:CT06937 "Distribution isotherm, the slope of which is continuously decreasing.")
AnnotationAssertion(rdfs:comment goldbook:CT06937 "The resulting chromatographic peak is tailing. Adsorption isotherms are often of this type. A special case is the Langmuir adsorption isotherm."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06937 goldbook:DT06932)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06937 goldbook:T06249)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06937 doi:10.1351/pac199668081591)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06937 "current"^^xsd:string)
Declaration(Class(goldbook:CT06938))
AnnotationAssertion(rdfs:label goldbook:CT06938 "concave isotherm")
AnnotationAssertion(dcterms:description goldbook:CT06938 "Distribution isotherm, the slope of which is continuously increasing.")
AnnotationAssertion(rdfs:comment goldbook:CT06938 "The resulting chromatographic peak is fronting. In gas-liquid chromatography, overloading often results in a concave isotherm."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06938 goldbook:DT06932)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06938 goldbook:F02534)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06938 goldbook:G02586)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06938 doi:10.1351/pac199668081591)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06938 "current"^^xsd:string)
Declaration(Class(goldbook:CT06948))
AnnotationAssertion(rdfs:label goldbook:CT06948 "chemometrics")
AnnotationAssertion(dcterms:description goldbook:CT06948 "Chemometrics is the application of statistics to the analysis of chemical data (from organic, analytical or medicinal chemistry) and design of chemical experiments and simulations.")
AnnotationAssertion(mito:isMentionedBy goldbook:CT06948 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06948 "current"^^xsd:string)
Declaration(Class(goldbook:CT06949))
AnnotationAssertion(rdfs:label goldbook:CT06949 "CLOGP values")
AnnotationAssertion(dcterms:description goldbook:CT06949 "CLOGP values are calculated 1-octanol/water partition coefficients, frequently used in structure-property correlation or quantitative structure-activity relationship (SPC/QSAR) studies.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06949 goldbook:P04435)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06949 goldbook:QT06977)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06949 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06949 "current"^^xsd:string)
Declaration(Class(goldbook:CT06950))
AnnotationAssertion(rdfs:label goldbook:CT06950 "cluster analysis")
AnnotationAssertion(dcterms:description goldbook:CT06950 "Cluster analysis is the clustering, or grouping, of large data sets (e.g., chemical and/or pharmacological data sets) on the basis of similarity criteria for appropriately scaled variables that represent the data of interest. Similarity criteria (distance based, associative, correlative, probabilistic) among the several clusters facilitate the recognition of patterns and reveal otherwise hidden structures.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06950 goldbook:CT06769)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06950 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06950 "current"^^xsd:string)
Declaration(Class(goldbook:CT06951))
AnnotationAssertion(rdfs:label goldbook:CT06951 "comparative molecular field analysis")
AnnotationAssertion(dcterms:description goldbook:CT06951 "Comparative Molecular Field Analysis (CoMFA) is a 3D-QSAR method that uses statistical correlation techniques for the analysis of the quantitative relationship between the biological activity of a set of compounds with a special alignment, and their three-dimensional electronic and steric properties. Other properties, such as hydrophobicity and H-bonding, can also be incorporated into the analysis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:CT06951 "CoMFA")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06951 goldbook:HT06964)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06951 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06951 "current"^^xsd:string)
Declaration(Class(goldbook:CT06952))
AnnotationAssertion(rdfs:label goldbook:CT06952 "computational chemistry")
AnnotationAssertion(dcterms:description goldbook:CT06952 "Computational chemistry is a discipline using mathematical methods for the calculation of molecular properties or for the simulation of molecular behaviour. It also includes, e.g., synthesis planning, database searching, combinatorial library manipulation.")
AnnotationAssertion(mito:isMentionedBy goldbook:CT06952 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06952 "current"^^xsd:string)
Declaration(Class(goldbook:CT06953))
AnnotationAssertion(rdfs:label goldbook:CT06953 "computer-assisted drug design")
AnnotationAssertion(dcterms:description goldbook:CT06953 "Computer-assisted drug design involves all computer-assisted techniques used to discover, design and optimize biologically active compounds with a putative use as drugs.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:CT06953 "CADD")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06953 goldbook:DT06960)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06953 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06953 "current"^^xsd:string)
Declaration(Class(goldbook:CT06954))
AnnotationAssertion(rdfs:label goldbook:CT06954 "computer-assisted molecular design")
AnnotationAssertion(dcterms:description goldbook:CT06954 "Computer-assisted molecular design involves all computer-assisted techniques used to discover, design and optimize compounds with desired structure and properties.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:CT06954 "CAMD")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06954 goldbook:MT06968)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06954 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06954 "current"^^xsd:string)
Declaration(Class(goldbook:CT06955))
AnnotationAssertion(rdfs:label goldbook:CT06955 "computer-assisted molecular modeling")
AnnotationAssertion(dcterms:description goldbook:CT06955 "Computer-assisted molecular modeling is the investigation of molecular structures and properties using computational chemistry and graphical visualization techniques.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:CT06955 "CAMM")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06955 goldbook:CT06952)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06955 goldbook:MT06971)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06955 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06955 "current"^^xsd:string)
Declaration(Class(goldbook:CT06956))
AnnotationAssertion(rdfs:label goldbook:CT06956 "conformational analysis")
AnnotationAssertion(dcterms:description goldbook:CT06956 "Conformational analysis consists of the exploration of energetically favourable spatial arrangements (shapes) of a molecule (conformations) using molecular mechanics, molecular dynamics, quantum chemical calculations or analysis of experimentally-determined structural data, e.g, NMR or crystal structures.Molecular mechanics and quantum chemical methods are employed to compute conformational energies, whereas systematic and random searches, Monte Carlo, molecular dynamics, and distance geometry are methods (often combined with energy minimization procedures) used to explore the conformational space.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT06956 goldbook:C01259)
AnnotationAssertion(rdfs:seeAlso goldbook:CT06956 goldbook:M03985)
AnnotationAssertion(mito:isMentionedBy goldbook:CT06956 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06956 "current"^^xsd:string)
Declaration(Class(goldbook:CT07009))
AnnotationAssertion(rdfs:label goldbook:CT07009 "chemical bond")
AnnotationAssertion(dcterms:description goldbook:CT07009 "When forces acting between two atoms or groups of atoms lead to the formation of a stable independent molecular entity, a chemical bond is considered to exist between these atoms or groups. The principal characteristic of a bond in a molecule is the existence of a region between the nuclei of constant potential contours that allows the potential energy to improve substantially by atomic contraction at the expense of only a small increase in kinetic energy. Not only directed covalent bonds characteristic of organic compounds, but also bonds such as those existing between sodium cations and chloride anions in a crystal of sodium chloride or the bonds binding aluminium to six molecules of water in its environment, and even weak bonds that link two molecules of $\\ce{O2}$ into $\\ce{O4}$, are to be attributed to chemical bonds.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07009 goldbook:K03402)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07009 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07009 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07009 "current"^^xsd:string)
Declaration(Class(goldbook:CT07010))
AnnotationAssertion(rdfs:label goldbook:CT07010 "closed shell molecular systems")
AnnotationAssertion(dcterms:description goldbook:CT07010 "Even-electron atomic or molecular systems whose electron configurations consist of doubly occupied orbitals.")
AnnotationAssertion(mito:isMentionedBy goldbook:CT07010 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07010 "current"^^xsd:string)
Declaration(Class(goldbook:CT07011))
AnnotationAssertion(rdfs:label goldbook:CT07011 "concerted reaction")
AnnotationAssertion(dcterms:description goldbook:CT07011 "A single-step reaction through which reactants are directly transformed into products, i.e., without involvement of any intermediates.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07011 goldbook:S05691)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07011 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07011 "current"^^xsd:string)
Declaration(Class(goldbook:CT07012))
AnnotationAssertion(rdfs:label goldbook:CT07012 "conservation of orbital symmetry")
AnnotationAssertion(dcterms:description goldbook:CT07012 "The orbital symmetry control of concerted reactions; this requires transformation of the molecular orbitals of reactants into those of products to proceed continuously by following a reaction path along which the symmetry of these orbitals remains unchanged. Reactions which adhere to this requirement are classified as symmetry-allowed reactions, and those which do not as symmetry-forbidden reactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07012 goldbook:O04320)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07012 goldbook:R05174)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07012 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07012 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07012 "current"^^xsd:string)
Declaration(Class(goldbook:CT07013))
AnnotationAssertion(rdfs:label goldbook:CT07013 "Coulomb repulsion")
AnnotationAssertion(dcterms:description goldbook:CT07013 "The potential energy component corresponding to the electrostatic interaction between each pair of charged particles: \\[V=\\frac{1}{4\\: \\pi\\: \\varepsilon_{0}}\\ \\sum _{i}\\sum _{j \\lt i}e_{i}\\ e_{j}\\ \\Delta r_{ij}\\] where \\(\\varepsilon _{0}\\) is the permittivity of a vacuum, \\(\\Delta r_{ij}\\) is the distance between the two particles, and \\(e_{i}\\) and \\(e_{j}\\) are the charges on particles \\(i\\) and \\(j\\). In molecular orbital theory, the electrostatic repulsion between the two electrons occupying the orbitals \\(\\Psi _{i}\\) and \\(\\Psi _{j}\\). In the Hartree–Fock method, the mean Coulomb repulsion is determined by the value of the coulomb integral \\[J_{ij}=\\int \\int \\Psi _{i\\rm{*}}\\left(\\mathbf{r}_{1}\\right)\\ \\Psi _{i}\\left(\\mathbf{r}_{1}\\right)\\ \\left(\\frac{e^{2}}{r_{12}}\\right)\\ \\Psi _{j\\rm{*}}\\left(\\mathbf{r}_{2}\\right)\\ \\Psi _{j}\\left(\\mathbf{r}_{2}\\right)  \\ \\mathrm{d}\\mathbf{r}_{1} \\ \\mathrm{d}\\mathbf{r}_{2} = \\lt ij|ij \\gt\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07013 goldbook:C01365)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07013 goldbook:H02747)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07013 goldbook:C01366)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07013 goldbook:ET07034)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07013 goldbook:M03996)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07013 goldbook:P04507)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07013 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07013 "current"^^xsd:string)
Declaration(Class(goldbook:CT07014))
AnnotationAssertion(rdfs:label goldbook:CT07014 "coupled cluster method")
AnnotationAssertion(dcterms:description goldbook:CT07014 "A method employed in ab initio quantum mechanical calculations providing for a higher-level treatment of electron correlation beyond MP4.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:CT07014 "CC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:CT07014 "CC method")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07014 goldbook:E01984)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07014 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07014 "current"^^xsd:string)
Declaration(Class(goldbook:CT07016))
AnnotationAssertion(rdfs:label goldbook:CT07016 "curve-crossing model")
AnnotationAssertion(dcterms:description goldbook:CT07016 "Model of organic reactivity that generates a reaction profile from curves that describe the energies of reactant, product, and intermediate electronic configurations (or, alternatively, reactant, product and intermediate electronic states) as a function of the reaction coordinate. The crossing reflects the electronic reorganization that accompanies the transformation of reactants and products.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07016 goldbook:R05168)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07016 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07016 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07016 "current"^^xsd:string)
Declaration(Class(goldbook:CT07134))
AnnotationAssertion(rdfs:label goldbook:CT07134 "chemical amplification")
AnnotationAssertion(dcterms:description goldbook:CT07134 "Process consisting of a chemical reaction that generates a species that catalyzes another reaction and also the succeeding catalyzed reaction.")
AnnotationAssertion(rdfs:comment goldbook:CT07134 "Chemical amplification can lead to a change in structure and by consequence to a change in the physical properties of a polymeric material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07134 "The term 'chemical amplification' is commonly used in photo-resist lithography employing a photo-acid generator or photo-base generator."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07134 "An example of chemical amplification is the transformation of [(tert-butoxycarbonyl)oxy]phenyl groups in polymer chains to hydroxyphenyl groups catalyzed by a photo-generated acid."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07134 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07134 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07134 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07134 "current"^^xsd:string)
Declaration(Class(goldbook:CT07135))
AnnotationAssertion(rdfs:label goldbook:CT07135 "chemical modification")
AnnotationAssertion(dcterms:description goldbook:CT07135 "Process by which at least one feature of the chemical constitution of a polymer is changed by chemical reaction(s).")
AnnotationAssertion(rdfs:comment goldbook:CT07135 "A configurational change (e.g., cis–trans isomerization) is not usually referred to as a chemical modification."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07135 goldbook:C01282)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07135 goldbook:I03295)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07135 goldbook:C01092)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07135 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07135 "current"^^xsd:string)
Declaration(Class(goldbook:CT07136))
AnnotationAssertion(rdfs:label goldbook:CT07136 "crosslinking")
AnnotationAssertion(dcterms:description goldbook:CT07136 "Reaction involving sites or groups on existing macromolecules or an interaction between existing macromolecules that results in the formation of a small region in a macromolecule from which at least four chains emanate.")
AnnotationAssertion(rdfs:comment goldbook:CT07136 "The small region may be an atom, a group of atoms, or a number of branch points connected by bonds, groups of atoms, or oligomeric chains."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07136 "A reaction of a reactive chain end of a linear macromolecule with an internal reactive site of another linear macromolecule results in the formation of a branch point, but is not regarded as a crosslinking reaction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07136 goldbook:C01409)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07136 goldbook:L03554)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07136 goldbook:O04286)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07136 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07136 "current"^^xsd:string)
Declaration(Class(goldbook:CT07137))
AnnotationAssertion(rdfs:label goldbook:CT07137 "curing")
AnnotationAssertion(dcterms:description goldbook:CT07137 "Chemical process of converting a prepolymer or a polymer into a polymer of higher molar mass and then into a network.")
AnnotationAssertion(rdfs:comment goldbook:CT07137 "Curing is achieved by the induction of chemical reactions which might or might not require mixing with a chemical curing agent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07137 "Physical aging, crystallization, physical crosslinking and post-polymerization reactions are sometimes referred to as 'curing'. Use of the term 'curing' to describe such processes is deprecated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07137 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07137 goldbook:C01434)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07137 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07137 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07137 goldbook:PT07163)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07137 goldbook:VT07153)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07137 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07137 "current"^^xsd:string)
Declaration(Class(goldbook:CT07154))
AnnotationAssertion(rdfs:label goldbook:CT07154 "chelating polymer")
AnnotationAssertion(dcterms:description goldbook:CT07154 "Polymer containing ligand groups capable of forming bonds (or other attractive interactions) between two or more separate binding sites within the same ligand group and a single atom.")
AnnotationAssertion(rdfs:comment goldbook:CT07154 "Chelating polymers mostly act as ion-exchange polymers specific to ions that form chelates with chelating ligands of the polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07154 goldbook:C01012)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07154 goldbook:L03518)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07154 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07154 "current"^^xsd:string)
Declaration(Class(goldbook:CT07170))
AnnotationAssertion(rdfs:label goldbook:CT07170 "conducting polymer")
AnnotationAssertion(dcterms:description goldbook:CT07170 "Polymeric material that exhibits bulk electric conductivity.")
AnnotationAssertion(rdfs:comment goldbook:CT07170 "The electric conductivity of a conjugated polymer is markedly increased by doping it with an electron donor or acceptor, as in the case of polyacetylene doped with iodine."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07170 "A polymer showing a substantial increase in electric conductivity upon irradiation with ultraviolet or visible light is called a photoconductive polymer; an example is poly(N-vinylcarbazole)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07170 "A polymer that shows electric conductivity due to the transport of ionic species is called an ion-conducting polymer; an example is sulfonated polyaniline. When the transported ionic species is a proton as, e.g., in the case of fuel cells, it is called a proton-conducting polymer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07170 "A polymer that shows electric semiconductivity is called a semiconducting polymer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07170 "Electric conductance of a non-conducting polymer can be achieved by dispersing conducting particles (e.g., metal, carbon black) in the polymer. The resulting materials are referred to as conducting polymer composites or solid polymer-electrolyte composites."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:E01925)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:C00824)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:CT07201)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:C01245)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:E01926)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:E01988)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:I03255)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:P04591)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:P04906)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:S05591)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07170 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07170 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07170 "current"^^xsd:string)
Declaration(Class(goldbook:CT07200))
AnnotationAssertion(rdfs:label goldbook:CT07200 "cationic polymer")
AnnotationAssertion(dcterms:description goldbook:CT07200 "Polymer composed of positively charged macromolecules and an equivalent amount of counter-anions.")
AnnotationAssertion(rdfs:comment goldbook:CT07200 "If a substantial fraction of constitutional units carries positive charges, then a cationic polymer is a polyelectrolyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07200 "The positive charges may be fixed on groups located in main chains as in an ionene or in pendant groups."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07200 "The term cationic polymer should not be used to denote a polymer prepared by cationic polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07200 goldbook:C00910)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07200 goldbook:IT07210)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07200 goldbook:P04728)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07200 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07200 "current"^^xsd:string)
Declaration(Class(goldbook:CT07201))
AnnotationAssertion(rdfs:label goldbook:CT07201 "conducting polymer composite")
AnnotationAssertion(dcterms:description goldbook:CT07201 "Electrically-conducting composite comprising a non-conducting polymer matrix and an electrically-conducting material.")
AnnotationAssertion(rdfs:comment goldbook:CT07201 "Examples of the electrically-conducting materials are carbon black and metal particles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07201 goldbook:C00824)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07201 goldbook:CT07545)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07201 goldbook:CT07170)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07201 goldbook:ST07227)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07201 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07201 "current"^^xsd:string)
Declaration(Class(goldbook:CT07202))
AnnotationAssertion(rdfs:label goldbook:CT07202 "critical ion-concentration in an ionomer")
AnnotationAssertion(dcterms:description goldbook:CT07202 "Concentration of ionic groups in an ionomer matrix above which ionic aggregation occurs.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07202 goldbook:I03229)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07202 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07202 "current"^^xsd:string)
Declaration(Class(goldbook:CT07339))
AnnotationAssertion(rdfs:label goldbook:CT07339 "chemically induced dynamic electron polarization")
AnnotationAssertion(dcterms:description goldbook:CT07339 "Non-Boltzmann electron spin-state population produced in thermal or photochemical reactions, either from a combination of radical pairs (called radical-pair mechanism), or directly from the triplet state (called triplet mechanism) and detectable by ESR spectroscopy.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:CT07339 "CIDEP")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07339 goldbook:P04585)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07339 goldbook:S05848)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07339 goldbook:T06503)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07339 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07339 "current"^^xsd:string)
Declaration(Class(goldbook:CT07340))
AnnotationAssertion(rdfs:label goldbook:CT07340 "chemically initiated electron exchange luminescence")
AnnotationAssertion(dcterms:description goldbook:CT07340 "Type of luminescence resulting from a thermal electron-transfer reaction. Also called catalyzed chemiluminescence.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:CT07340 "CIEEL")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:CT07340 "catalyzed chemiluminescence")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07340 goldbook:C01045)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07340 goldbook:L03641)
