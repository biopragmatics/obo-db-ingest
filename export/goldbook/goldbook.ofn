Declaration(Class(goldbook:ST06775))
AnnotationAssertion(rdfs:label goldbook:ST06775 "sequence")
AnnotationAssertion(dcterms:description goldbook:ST06775 "The order of neighbouring amino acids in a protein or of the purine or pyrimidine bases in RNA or DNA.")
AnnotationAssertion(rdfs:seeAlso goldbook:ST06775 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06775 goldbook:R05386)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06775 goldbook:P04843)
AnnotationAssertion(rdfs:seeAlso goldbook:ST06775 goldbook:P04958)
