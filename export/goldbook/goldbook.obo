[Term]
id: goldbook:08308
name: <sup>15</sup>N-NOESY-HSQC
def: "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen and two hydrogen dimensions."
comment: "Magnetization is exchanged between all hydrogens using the nuclear Overhauser effect before being transferred to neighbouring \(\ce{^{15}N}\) nuclei and then back to \(\ce{^{1}H}\) for detection. This spectrum can be used to obtain restraints for structure calculations."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
