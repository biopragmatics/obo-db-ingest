    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00848 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00848">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1,3-Dipolar compounds having the structure</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carbonyl ylides</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.D01753"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.O04379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00850 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00850">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amides of carboxylic acids, having the structure $\ce{RC(=O)NR2}$. The term is used as a suffix in systematic name formation to denote the $\ce{–C(=O)NH2}$ group including its carbon atom.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carboxamides</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00266"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00852"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S06236"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00851 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00851">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds having the structure $\ce{RC(=NR)NR2}$. The term is used as a suffix in systematic nomenclature to denote the $\ce{–C(=NH)NH2}$ group including its carbon atom, e.g. acetamidine, $\ce{CH3C(=NH)NH2}$; 2-butyl-4,5-dihydroimidazole:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carboxamidines</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00852 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00852">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Oxoacids having the structure $\ce{RC(=O)OH}$. The term is used as a suffix in systematic name formation to denote the $\ce{–C(=O)OH}$ group including its carbon atom.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carboxylic acids</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.O04374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S06236"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00854 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00854">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The neutral species $\ce{HC_{^\vdots}}$ (methylidyne) and its derivatives formed by substitution in which a univalent carbon atom is covalently bonded to one group and also bears three nonbonding electrons. (This term carries no implication about spin-pairing).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carbynes</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00856 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00856">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The cationic species $\ce{H2C^{.+}}$ or substitution derivatives thereof, formally derived by adding a hydron to a carbyne or subtracting an electron from a carbene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carbynium ions</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00806"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00854"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02904"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00857 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00857">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hydrocarbon carotenoids (a subclass of tetraterpenes).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carotenes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02889"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06278"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00858 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00858">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tetraterpenoids ($\ce{C40}$), formally derived from the acyclic parent, $\ce{\uppsi\!,\!\uppsi\!-carotene}$ I by hydrogenation, dehydrogenation, cyclization, oxidation, or combination of these processes. This class includes carotenes, xanthophylls and certain compounds that arise from rearrangement of the skeleton of I or by loss of part of this structure. retinoids are excluded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>carotenoids</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.O04362"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05194"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05369"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05370"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.X06697"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00859 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00859">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A substance in appreciable amount which, when associated with a trace of a specified substance, will carry the trace with it through a chemical or physical process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac198254081533"/>
        <rdfs:label>carrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S06147"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00860 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00860">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A substance in appreciable amount which, when associated with a tracer of a specified substance, will carry the tracer with it through a chemical or physical process, or prevent the tracer from undergoing nonspecific processes due to its low concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199466122513"/>
        <rdfs:label>carrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06422"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00861 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00861">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A participant atom which is neither core nor peripheral and which carries other groups to and from the molecule containing the core atom(s) but which does not itself become covalently attached to that molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac198961010023"/>
        <rdfs:label>carrier atom</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01341"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00863 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00863">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A gas introduced in order to transport a sample for analytical purposes. In gas chromatography it is the gas which is passed continuously through the column and whose passage promotes the elution of the components of the sample. The carrier gas together with the portions of the sample present in this phase constitutes the mobile phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199062112167"/>
        <rdfs:label>carrier gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01075"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.E02042"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.M03952"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00866 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00866">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A process by which materials are carried into a reaction mixture to which they do not belong. These materials can be either parts of a specimen, or reagents including the diluent or wash solution. In such cases, carry-over means the transfer of material (specimen or reagents) from one container, or from one reaction mixture, to another one. It can be either unidirectional or bidirectional in a series of specimens or assays. The term carry-over effect is used for carry-over from specimen to specimen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac198961091657"/>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199163020301"/>
        <rdfs:label>carry-over</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00869 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00869">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An instrument used for the classification of aerosols according to size and for possible subsequent chemical analysis. Air is drawn through a series of orifices of decreasing size; the air flow is normal to collecting surfaces on which aerosols are collected by inertial impaction. The particles, separated stepwise by their momentum differences into a number of size ranges, are collected simultaneously.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199062112167"/>
        <rdfs:label>cascade impactor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I02985"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.M04007"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00870 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00870">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reactions involving the oxidation of organic substrates to provide chemically available energy (e.g. ATP) and to generate metabolic intermediates.Generally, the process of breakdown of complex molecules into simpler ones, often providing biologically available energy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199365092003"/>
        <rdfs:label>catabolism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00314"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.O04362"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S06083"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00871 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00871">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A decrease in the activity of certain auxiliary catabolic enzymes when a surplus of an (easily metabolizable) substrate is available. Commonly this effect is caused by glucose (glucose repression) or by metabolites produced from glucose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199264010143"/>
        <rdfs:label>catabolite repression</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.E02159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.M03859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05304"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00872 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00872">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A titration process, which involves a catalyst, where the end-point is detected by the sudden increase or decrease of the rate of a reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199365102291"/>
        <rdfs:label>catalymetric titration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.E02096"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06387"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00873 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00873">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The observed rate of reaction, \(\xi \), minus the spontaneous rate of reaction, \(\xi _{0}\), observed under otherwise similar conditions in the absence of added catalytic material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197951122451"/>
        <rdfs:label>catalysed rate of reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05156"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00874 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00874">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The action of a catalyst.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199466051077"/>
        <rdfs:label>catalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00876"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00876 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00876">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction; the process is called catalysis. The catalyst is both a reactant and product of the reaction. The words catalyst and catalysis should not be used when the added substance reduces the rate of reaction (see inhibitor). Catalysis can be classified as &apos;homogeneous catalysis&apos;, in which only one phase is involved, and &apos;heterogeneous catalysis&apos;, in which the reaction occurs at or near an interface between phases. Catalysis brought about by one of the products of a reaction is called autocatalysis. Catalysis brought about by a group on a reactant molecule itself is called intramolecular catalysis. The term catalysis is also often used when the substance is consumed in the reaction (for example: base-catalysed hydrolysis of esters). Strictly, such a substance should be called an activator.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668010149"/>
        <oboInOwl:hasRelatedSynonym>accelerator</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>kinetic synergist</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>surface catalysis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>catalyst</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00104"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00525"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.B00642"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.E02012"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.E02219"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.G02609"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.G02610"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02902"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03035"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03082"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03131"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.M03885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.M03892"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04536"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04861"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04924"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05156"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S05796"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00877 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00877">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A substance included in the solvent to increase the rate of transfer without affecting the position of equilibrium. The term accelerator may also be used but kinetic synergist is not recommended.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199365112373"/>
        <rdfs:label>catalyst</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.K03408"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00878 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00878">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Catalyst deactivation resulting from changes in the structure or in the texture of the catalyst. Changes of this kind are usually irreversible and the catalyst cannot be regenerated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <rdfs:label>catalyst ageing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00880"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00880 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00880">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The conversion in a catalytic reaction performed under constant conditions of reaction often decreases with time of run or time on stream. This phenomenon is called catalyst deactivation or catalyst decay.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <oboInOwl:hasRelatedSynonym>catalyst deactivation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>catalyst decay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00876"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00881 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00881">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in the rate of reaction of a specified chemical reaction that an enzyme produces in a specific assay system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199466122587"/>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <oboInOwl:hasRelatedSynonym>enzyme activity</oboInOwl:hasRelatedSynonym>
        <rdfs:label>catalytic activity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00470"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05156"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00882 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00882">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Catalytic activity of the component divided by the volume of the system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <oboInOwl:hasRelatedSynonym>catalytic concentration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In clinical chemistry litre is recommended as unit for the volume.</rdfs:comment>
        <rdfs:comment>In clinical chemistry the component is usually an enzyme.</rdfs:comment>
        <rdfs:comment>In describing a quantity, concentration must be clearly differentiated from content.</rdfs:comment>
        <rdfs:comment>The term &apos;catalytic concentration&apos; is accepted for use in clinical chemistry.</rdfs:comment>
        <rdfs:comment>Use of the term level as a synonym for concentration is deprecated.</rdfs:comment>
        <rdfs:label>catalytic activity concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01222"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01296"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.L03594"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00883 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00883">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Catalytic activity of the component divided by the mass of the system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <oboInOwl:hasRelatedSynonym>catalytic content</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In clinical chemistry the component is usually an enzyme.</rdfs:comment>
        <rdfs:comment>In describing a quantity, content must be clearly differentiated from concentration.</rdfs:comment>
        <rdfs:comment>The term catalytic content is accepted for use in clinical chemistry.</rdfs:comment>
        <rdfs:comment>Use of the term level as a synonym for concentration is deprecated.</rdfs:comment>
        <rdfs:label>catalytic activity content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01222"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01296"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00884 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00884">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quotient of the catalytic activity of the isozyme and the catalytic activity of all the isozymes of the same enzyme in the system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <oboInOwl:hasRelatedSynonym>catalytic fraction</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The definition also applies to other multiple forms of an enzyme that are not isoenzymes.</rdfs:comment>
        <rdfs:comment>The definition is based on the definitions of catalytic activity and fraction.</rdfs:comment>
        <rdfs:comment>The term catalytic fraction is accepted for use in clinical chemistry.</rdfs:comment>
        <rdfs:label>catalytic activity fraction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00881"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.F02494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03358"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00885 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00885">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>If the rate of reaction, \( u\), is expressible in the form: \[ u = (k_{0}+\sum _{\begin{array}{c}  i  \end{array}}k_{i}\ [C_{i}]^{n_{i}})\ [A]^{\alpha }\ [B]^{\beta }\ ...\] where $\ce{A}$, $\ce{B}$, ... are reactants and \(C_{i}\) represents one of a set of catalysts, then the proportionality factor \(k_{i}\) is the catalytic coefficient of the particular catalyst \(C_{i}\). Normally the partial order of reaction \(n_{i}\) with respect to a catalyst is unity, so that \(k_{i}\) is an \(\left ( \mathit{\alpha } + \mathit{\beta } + ... + 1 \right )\)th order rate coefficient. The proportionality factor \(k_{0}\) is the \(\left ( \mathit{\alpha } + \mathit{\beta } + ...\right )\)th order rate coefficient of the uncatalysed component of the total reaction. For example, if there is catalysis by hydrogen and hydroxide ions, and the order of reaction can be expressed in the form: \[k = k_{0}+k_{\rm{H}^{+}}\ [\rm{H}^{+}]+k_{\rm{OH}^{-}}\ [\rm{OH}^{-}]\] then \(k_{H^{+}}\) and \(k_{\rm{OH}^{-}}\) are the catalytic coefficients for $\ce{H^{+}}$ and $\ce{OH^{-}}$, respectively. The constant \(k_{0}\) relates to the uncatalysed reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199466051077"/>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668010149"/>
        <rdfs:label>catalytic coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01124"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.O04322"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05137"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05156"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00889 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00889">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The faradaic current that is obtained with a solution containing two substances B and A may exceed the sum of the faradaic currents that would be obtained with B and A separately, but at the same concentrations and under the same experimental conditions. In either of the two following situations the increase is termed a catalytic current. B is reduced or oxidized at the electrode-solution interface to give a product B&apos; that then reduces or oxidizes A chemically. The reaction of B with A may yield either B or an intermediate in the overall half-reaction by which B&apos; was obtained from B. In this situation the increase of current that results from the addition of A to a solution of B may be termed a regeneration current. The presence at the electrode-solution interface of one substance, which may be either A or the product A&apos; of its reduction or oxidation, decreases the over-potential for the reduction or oxidation of B. In either case the magnitude of the catalytic current depends on the applied potential. If the current observed with a mixture of A and B is smaller than the sum of the separate currents, the term non-additive current should be used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac198557101491"/>
        <rdfs:label>catalytic current</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00134"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.F02321"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03082"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.O04362"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00891 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00891">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A reaction in which an alkane is converted into an aromatic hydrocarbon and hydrogen. For example,</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <rdfs:label>catalytic dehydrocyclization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00894 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00894">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The transformation of non-graphitic carbon into graphite by heat treatment in the presence of certain metals or minerals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567030473"/>
        <rdfs:comment>Catalytic graphitization gives a fixed degree of graphitization at lower temperature and/or for a shorter heat treatment time than in the absence of the catalytic additives (or a higher degree of graphitization at fixed heat treatment conditions). Often it involves dissolution of carbon and precipitation of graphite at the catalyst particles so that non-graphitizing carbons can be graphitized by this procedure.</rdfs:comment>
        <rdfs:label>catalytic graphitization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00821"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.D01806"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.G02684"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.G02691"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.N04193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06446"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00895 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00895">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A process similar to catalytic cracking in its industrial purpose but effected under hydrogen pressure and on a catalyst containing an ingredient with a hydrogenating function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <rdfs:label>catalytic hydrocracking</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00888"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00896 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00896">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A process in which, in the presence of hydrogen, sulfur is removed as hydrogen sulfide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <rdfs:label>catalytic hydrodesulfurization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00897 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00897">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ordinarily, a reaction in which $\ce{A + H2}$ gives $\ce{B}$.   For example,    The term may also be used for cleavage of bonds other than $\ce{A}$, e.g.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <rdfs:label>catalytic hydrogenolysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00898 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00898">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A process for removing carbon monoxide from gas streams or for producing methane by the reaction</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <rdfs:label>catalytic methanation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00899 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00899">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A process for increasing the octane number of naphthas. It involves isomerization of alkanes, dehydrogenation of cyclohexanes to aromatic hydrocarbons, isomerization and dehydrogenation of alkylcyclopentanes, and dehydrocyclization of alkanes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197646010071"/>
        <rdfs:label>catalytic reforming</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00222"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02889"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00902 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00902">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>4-(2-Aminoethyl)pyrocatechol [4-(2-aminoethyl)benzene-1,2-diol] and derivatives formed by substitution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>catecholamines</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00903 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00903">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An affix used in inorganic nomenclature to denote a chain structure; often used to designate linear polymeric substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2014-0718"/>
        <rdfs:label>&lt;i&gt;catena&lt;/i&gt;-</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.M03667"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00904 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00904">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hydrocarbons having two or more rings connected in the manner of links of a chain, without a covalent bond. More generally, the class catena compounds embraces functional derivatives and hetero analogues, e.g:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <oboInOwl:hasRelatedSynonym>catena compounds</oboInOwl:hasRelatedSynonym>
        <rdfs:label>catenanes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02889"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00906 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00906">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a reaction with a single rate-determining step \[\frac{\alpha _{\rm{c}}}{ u } = -\frac{R\ T}{n\ F}\ (\frac{\partial (\ln (|I_{\rm{c}}|))}{\partial E})_{T,p,c_{i},...}\] where \(\alpha _{\rm{c}}\) is the cathodic transfer coefficient (number), \(R\) is the gas constant, \(T\) is the thermodynamic temperature, and \( u \) the stoichiometric number giving the number of identical activated complexes formed and destroyed in the completion of the overall reaction as formulated with the transfer of \(n\) electrons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197437040499"/>
        <rdfs:label>cathodic transfer coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01124"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.G02579"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S06025"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06321"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00907 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00907">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A monoatomic or polyatomic species having one or more elementary charges of the proton.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2014-0718"/>
        <rdfs:label>cation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04906"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00908 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00908">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The process of exchanging cations between a solution and a cation exchanger.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199365040819"/>
        <rdfs:label>cation exchange</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00909 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00909">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion exchanger with cations as counter-ions. The term cation-exchange resin may be used in the case of solid organic polymers. The acid form of a cation exchanger is the ionic form of a cation exchanger in which counter-ions are hydrogen ions (H-form) or the ionogenic groups have added a proton forming an undissociated acid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199365040819"/>
        <rdfs:label>cation exchanger</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C00907"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01371"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03171"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03228"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04906"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.RT07166"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00910 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00910">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An ionic polymerization in which the kinetic-chain carriers are cations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668122287"/>
        <rdfs:label>cationic polymerization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I03178"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00914 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00914">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds constrained by structure to having or accommodating a cavity large enough to host other molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>cavitands</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I02998"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00915 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00915">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Periodic removal of coherent radiation from a laser cavity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668122223"/>
        <rdfs:label>cavity dumping</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01130"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.L03459"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00917 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00917">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An automatic, recording instrument for reading the height of the cloud-base.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199062112167"/>
        <rdfs:label>ceilometer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05189"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00918 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00918">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defined as: \[\kappa _{\rm{cell}} = \kappa \ R\] where \(R\) is the measured resistance of the cell and \(\kappa \) is the conductivity (formerly called the specific conductance).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197437040499"/>
        <rdfs:label>cell constant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05315"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S05797"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00922 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00922">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The error which results if the incident beam does not fall perpendicularly to the windows of the cell, or if the cell windows are contaminated or have some other imperfection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac198860091449"/>
        <rdfs:label>cell error</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00928 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00928">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thermodynamic temperature minus \(273.15\ \rm{K}\), invariably expressed in the SI unit degree Celsius (\(\pu{^{\circ}C}\)) which is equal to the kelvin. Sometimes the misnomer centigrade temperature is used for Celsius temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <rdfs:label>Celsius temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.D01561"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.K03374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06321"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00930 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00930">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The atom in a coordination entity which binds other atoms or groups of atoms (ligands) to itself, thereby occupying a central position in the coordination entity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2014-0718"/>
        <rdfs:label>central atom</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.C01330"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.L03518"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00931 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00931">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The centre of a Mössbauer spectrum is defined as the Doppler-velocity at which the resonance maximum is (or would be) observed when all magnetic dipole, electric quadrupole, etc. hyperfine interactions are (or would be) absent. The contribution of the second order Doppler shift (\(\delta _{\rm{T}}\)) should be indicated, if possible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac197645030211"/>
        <rdfs:label>centre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05326"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00933 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00933">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The acceleration of a component as a result of a uniform rotational motion. Centrifugal acceleration is a vector quantity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199466040897"/>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <oboInOwl:hasRelatedSynonym>centripetal acceleration</oboInOwl:hasRelatedSynonym>
        <rdfs:label>centrifugal acceleration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00934 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00934">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a reaction without an electronic energy barrier, or its reverse, the rotational energy of the transition state gives rise to a reaction barrier, which is known as the centrifugal barrier.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668010149"/>
        <rdfs:label>centrifugal barrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.R05166"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.T06468"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00936 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00936">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fictitious force acting on a body as a result of centripetal acceleration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <rdfs:label>centrifugal force</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00937 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00937">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The radius at which a component is spinning at the end of the period of centrifugation. For a component sedimented from a dilute suspension, it can be equated with radius of rotation at the bottom of the centrifuge tube.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199466040897"/>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199668040957"/>
        <rdfs:label>centrifugal radius</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S06198"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00938 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00938">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds derived from glycerol in which a primary and the secondary hydroxy groups are esterified with long-chain fatty acids, and the remaining primary one with the mono(2-aminoethyl) ester of phosphoric acid, or with the monoserine ester of phosphoric acid. The term is not recommended. These compounds are preferably designated as (3-phosphatidyl)ethanolamines and (3-phosphatidyl)serines respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <oboInOwl:hasRelatedSynonym>kephalins</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cephalins</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.F02330"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04550"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.C00939 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.C00939">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cephems having the basic structure shown.</dcterms:description>
