AnnotationAssertion(mito:isMentionedBy goldbook:A00528 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00528 "current"^^xsd:string)
Declaration(Class(goldbook:A00529))
AnnotationAssertion(rdfs:label goldbook:A00529 "autophobicity")
AnnotationAssertion(dcterms:description goldbook:A00529 "If adsorption equilibrium and mutual saturation of the phases is not achieved instantly, it is possible to distinguish the initial spreading tension, \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\), from the final spreading tension, \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\), when equilibrium has been reached. In the case in which \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) is positive, while \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) is negative, the system is said to exhibit autophobicity.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00529 goldbook:S05472)
AnnotationAssertion(mito:isMentionedBy goldbook:A00529 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00529 "current"^^xsd:string)
