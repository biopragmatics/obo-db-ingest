AnnotationAssertion(obo:goldbook#hasStatus goldbook:13811 "current"^^xsd:string)
Declaration(Class(goldbook:13812))
AnnotationAssertion(rdfs:label goldbook:13812 "discotic mesogen")
AnnotationAssertion(dcterms:description goldbook:13812 "Mesogen composed of relatively flat, disc- or sheet-shaped molecules.")
AnnotationAssertion(rdfs:comment goldbook:13812 "The adjective \"discotic\" is also employed to describe the nematic mesophases formed by discotic mesogens. The mesophases formed by a columnar stacking of disc-like molecules are described as columnar mesophases."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13812 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13812 "current"^^xsd:string)
