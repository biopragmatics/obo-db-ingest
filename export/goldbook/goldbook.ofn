AnnotationAssertion(rdfs:label goldbook:11799 "hallucination")
AnnotationAssertion(dcterms:description goldbook:11799 "The apparent, often strong, subjective perception of an external object or event when no such stimulus or situation is present.")
AnnotationAssertion(rdfs:comment goldbook:11799 "Hallucinations may be visual, auditory, olfactory, gustatory, or tactile."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11799 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11799 "current"^^xsd:string)
