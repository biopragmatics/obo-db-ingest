AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01575 "current"^^xsd:string)
Declaration(Class(goldbook:D01576))
AnnotationAssertion(rdfs:label goldbook:D01576 "delayed coincidence")
AnnotationAssertion(dcterms:description goldbook:D01576 "The occurrence of two or more events separated by a short but measurable time interval.")
AnnotationAssertion(mito:isMentionedBy goldbook:D01576 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01576 "current"^^xsd:string)
Declaration(Class(goldbook:D01577))
AnnotationAssertion(rdfs:label goldbook:D01577 "delayed coke")
AnnotationAssertion(dcterms:description goldbook:D01577 "A commonly used term for a primary carbonization product (green or raw coke) from high-boiling hydrocarbon fractions (heavy residues of petroleum or coal processing) produced by the delayed coking process.")
AnnotationAssertion(rdfs:comment goldbook:D01577 "Delayed coke has, with only a few exceptions, a better graphitizability than cokes produced by other coking processes even if the same feedstock is used. Delayed coke contains a mass fraction of volatile matter between 4 and 15 wt% which can be released during heat treatment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:D01577 goldbook:C00840)
AnnotationAssertion(rdfs:seeAlso goldbook:D01577 goldbook:C01142)
AnnotationAssertion(rdfs:seeAlso goldbook:D01577 goldbook:C01144)
