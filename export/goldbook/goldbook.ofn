AnnotationAssertion(mito:isMentionedBy goldbook:P04599 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04599 "current"^^xsd:string)
Declaration(Class(goldbook:P04600))
AnnotationAssertion(rdfs:label goldbook:P04600 "photodynamic effect")
AnnotationAssertion(dcterms:description goldbook:P04600 "A term used in photobiology to refer to photoinduced damage requiring the simultaneous presence of light, photosensitizer and molecular oxygen. A sensitized photooxidation which involves molecular oxygen.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04600 goldbook:PT07445)
AnnotationAssertion(rdfs:seeAlso goldbook:P04600 goldbook:P04640)
AnnotationAssertion(rdfs:seeAlso goldbook:P04600 goldbook:P04653)
AnnotationAssertion(mito:isMentionedBy goldbook:P04600 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04600 "current"^^xsd:string)
Declaration(Class(goldbook:P04601))
AnnotationAssertion(rdfs:label goldbook:P04601 "photoelectrical effect")
AnnotationAssertion(dcterms:description goldbook:P04601 "The ejection of an electron from a solid or a liquid by a photon.")
AnnotationAssertion(mito:isMentionedBy goldbook:P04601 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04601 "current"^^xsd:string)
Declaration(Class(goldbook:P04602))
AnnotationAssertion(rdfs:label goldbook:P04602 "photoelectric attenuation coefficient")
AnnotationAssertion(dcterms:description goldbook:P04602 "The attenuation coefficient when only the photoelectric process is taken into account.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04602 goldbook:A00516)
AnnotationAssertion(mito:isMentionedBy goldbook:P04602 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04602 "current"^^xsd:string)
Declaration(Class(goldbook:P04604))
AnnotationAssertion(rdfs:label goldbook:P04604 "photoelectric peak")
AnnotationAssertion(dcterms:description goldbook:P04604 "Of a spectrum of γ-radiation, the part of the spectral response curve corresponding to the absorption in the radiation detector by the photoelectrical effect of the detected $\\upgamma\\!\\mbox{-}\\rm{energy}$. In most cases the peak also contains events caused by multiple processes and use of the expression full energy peak or full energy peak is to be preferred. Synonymous with photopeak.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04604 "photopeak")
AnnotationAssertion(rdfs:seeAlso goldbook:P04604 goldbook:A00036)
AnnotationAssertion(rdfs:seeAlso goldbook:P04604 goldbook:F02546)
AnnotationAssertion(rdfs:seeAlso goldbook:P04604 goldbook:P04601)
AnnotationAssertion(rdfs:seeAlso goldbook:P04604 goldbook:R05054)
AnnotationAssertion(rdfs:seeAlso goldbook:P04604 goldbook:R02568)
AnnotationAssertion(mito:isMentionedBy goldbook:P04604 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04604 "current"^^xsd:string)
Declaration(Class(goldbook:P04605))
AnnotationAssertion(rdfs:label goldbook:P04605 "photoelectrochemical cell")
AnnotationAssertion(dcterms:description goldbook:P04605 "An electrochemical cell in which current and a voltage are simultaneously produced upon absorption of light by one or more of the electrodes. Usually at least one of the electrodes is a semiconductor.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04605 goldbook:P04608)
AnnotationAssertion(rdfs:seeAlso goldbook:P04605 goldbook:P04615)
AnnotationAssertion(rdfs:seeAlso goldbook:P04605 goldbook:P04659)
AnnotationAssertion(rdfs:seeAlso goldbook:P04605 goldbook:S05591)
AnnotationAssertion(mito:isMentionedBy goldbook:P04605 doi:10.1351/pac199163040569)
AnnotationAssertion(mito:isMentionedBy goldbook:P04605 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04605 "current"^^xsd:string)
Declaration(Class(goldbook:P04606))
AnnotationAssertion(rdfs:label goldbook:P04606 "photoelectrochemical etching")
AnnotationAssertion(dcterms:description goldbook:P04606 "The dissolution of a semiconductor in an electrolytic solution upon exposure to light. Used in the photopatterning of semiconductor surfaces.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04606 goldbook:D01806)
AnnotationAssertion(rdfs:seeAlso goldbook:P04606 goldbook:S05591)
AnnotationAssertion(mito:isMentionedBy goldbook:P04606 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04606 "current"^^xsd:string)
Declaration(Class(goldbook:P04607))
AnnotationAssertion(rdfs:label goldbook:P04607 "photoelectrochemistry")
AnnotationAssertion(dcterms:description goldbook:P04607 "A term applied to a hybrid field of chemistry employing techniques which combine photochemical and electrochemical methods for the study of the oxidation-reduction chemistry of the ground or excited states of molecules or ions. In general, it is the chemistry resulting from the interaction of light with electrochemical systems.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04607 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:P04607 goldbook:P04605)
AnnotationAssertion(rdfs:seeAlso goldbook:P04607 goldbook:P04615)
AnnotationAssertion(rdfs:seeAlso goldbook:P04607 goldbook:P04659)
AnnotationAssertion(mito:isMentionedBy goldbook:P04607 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04607 "current"^^xsd:string)
Declaration(Class(goldbook:P04608))
AnnotationAssertion(rdfs:label goldbook:P04608 "photoelectrolytic cell")
AnnotationAssertion(dcterms:description goldbook:P04608 "A cell in which radiant energy causes a net chemical conversion in the cell, e.g. so as to produce hydrogen as a useful fuel. These cells can be classified as photosynthetic or photocatalytic. In the former case, radiant energy provides a Gibbs energy to drive a reaction such as \\(\\rm{H}_{2}\\rm{O}\\rightarrow \\rm{H}_{2}+\\frac{1}{2}\\rm{O}_{2}\\) , and electrical or thermal energy may be later recovered by allowing the reverse, spontaneous reaction to proceed. In a photocatalytic cell the photon absorption promotes a reaction with \\(\\Delta G < 0\\) so there is no net storage of chemical energy, but the radiant energy speeds up a slow reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04608 goldbook:R05039)
AnnotationAssertion(mito:isMentionedBy goldbook:P04608 doi:10.1351/pac199163040569)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04608 "current"^^xsd:string)
Declaration(Class(goldbook:P04609))
AnnotationAssertion(rdfs:label goldbook:P04609 "photoelectron spectroscopy")
AnnotationAssertion(dcterms:description goldbook:P04609 "A spectroscopic technique which measures the kinetic energy of electrons emitted upon the ionization of a substance by high energy monochromatic photons. A photoelectron spectrum is a plot of the number of electrons emitted versus their kinetic energy. The spectrum consists of bands due to transitions from the ground state of an atom or molecular entity to the ground and excited states of the corresponding radical cation. Approximate interpretations are usually based on 'Koopmans theorem' and yield orbital energies. PES and UPS (UV photoelectron spectroscopy) refer to the spectroscopy using vacuum ultraviolet sources, while ESCA (electron spectroscopy for chemical analysis) and XPS use X-ray sources.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:P04609 "PES")
AnnotationAssertion(rdfs:seeAlso goldbook:P04609 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:P04609 goldbook:I03183)
AnnotationAssertion(rdfs:seeAlso goldbook:P04609 goldbook:K03402)
AnnotationAssertion(rdfs:seeAlso goldbook:P04609 goldbook:R05073)
AnnotationAssertion(rdfs:seeAlso goldbook:P04609 goldbook:S05848)
AnnotationAssertion(rdfs:seeAlso goldbook:P04609 goldbook:UT07492)
AnnotationAssertion(mito:isMentionedBy goldbook:P04609 doi:10.1351/pac197645030221)
AnnotationAssertion(mito:isMentionedBy goldbook:P04609 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04609 "current"^^xsd:string)
Declaration(Class(goldbook:P04611))
AnnotationAssertion(rdfs:label goldbook:P04611 "photoelectron yield")
AnnotationAssertion(dcterms:description goldbook:P04611 "The number of photoelectrons emitted by the sample per incident photon.")
AnnotationAssertion(mito:isMentionedBy goldbook:P04611 doi:10.1351/pac197951112243)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04611 "current"^^xsd:string)
Declaration(Class(goldbook:P04612))
AnnotationAssertion(rdfs:label goldbook:P04612 "photoemissive detector")
AnnotationAssertion(dcterms:description goldbook:P04612 "A detector in which a photon interacts with a solid surface, which is called the photocathode, or a gas, releasing a photoelectron. This process is called the external photoelectric effect. The photoelectrons are collected by an electrode at positive electric potential, i.e. the anode.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04612 goldbook:A00370)
AnnotationAssertion(rdfs:seeAlso goldbook:P04612 goldbook:R05054)
AnnotationAssertion(rdfs:seeAlso goldbook:P04612 goldbook:E01935)
AnnotationAssertion(mito:isMentionedBy goldbook:P04612 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04612 "current"^^xsd:string)
Declaration(Class(goldbook:P04613))
AnnotationAssertion(rdfs:label goldbook:P04613 "photoexcitation")
AnnotationAssertion(dcterms:description goldbook:P04613 "The production of an excited state by the absorption of ultraviolet, visible, or infrared radiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04613 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:P04613 goldbook:IT07399)
AnnotationAssertion(rdfs:seeAlso goldbook:P04613 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:P04613 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:P04613 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04613 "current"^^xsd:string)
Declaration(Class(goldbook:P04614))
AnnotationAssertion(rdfs:label goldbook:P04614 "photo-Fries rearrangement")
AnnotationAssertion(dcterms:description goldbook:P04614 "A photorearrangement of aryl or acyl esters to give the-rearranged product (as well as the-rearranged product):")
AnnotationAssertion(rdfs:seeAlso goldbook:P04614 goldbook:E02219)
AnnotationAssertion(rdfs:seeAlso goldbook:P04614 goldbook:PT07460)
AnnotationAssertion(mito:isMentionedBy goldbook:P04614 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04614 "current"^^xsd:string)
Declaration(Class(goldbook:P04615))
AnnotationAssertion(rdfs:label goldbook:P04615 "photogalvanic cell")
AnnotationAssertion(dcterms:description goldbook:P04615 "An electrochemical cell in which current or voltage changes result from photochemically generated changes in the relative concentrations of reactants in a solution phase oxidation-reduction couple.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04615 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:P04615 goldbook:P04659)
AnnotationAssertion(mito:isMentionedBy goldbook:P04615 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04615 "current"^^xsd:string)
Declaration(Class(goldbook:P04617))
AnnotationAssertion(rdfs:label goldbook:P04617 "photoinduced electron transfer")
AnnotationAssertion(dcterms:description goldbook:P04617 "An electron transfer resulting from an electronic state produced by the resonant interaction of electromagnetic radiation with matter.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04617 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:P04617 goldbook:ET07026)
AnnotationAssertion(mito:isMentionedBy goldbook:P04617 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04617 "current"^^xsd:string)
Declaration(Class(goldbook:P04618))
AnnotationAssertion(rdfs:label goldbook:P04618 "photoinduced polymerization")
AnnotationAssertion(dcterms:description goldbook:P04618 "The polymerization of a monomer by a free radical or ionic chain reaction initiated by photoexcitation.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04618 goldbook:C00960)
AnnotationAssertion(rdfs:seeAlso goldbook:P04618 goldbook:F02519)
AnnotationAssertion(rdfs:seeAlso goldbook:P04618 goldbook:M04017)
AnnotationAssertion(rdfs:seeAlso goldbook:P04618 goldbook:P04613)
AnnotationAssertion(rdfs:seeAlso goldbook:P04618 goldbook:P04619)
AnnotationAssertion(rdfs:seeAlso goldbook:P04618 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:P04618 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04618 "current"^^xsd:string)
Declaration(Class(goldbook:P04619))
AnnotationAssertion(rdfs:label goldbook:P04619 "photoinitiation")
AnnotationAssertion(dcterms:description goldbook:P04619 "The photoproduction of a free radical or ion capable of initiating a chain reaction such as a polymerization.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04619 goldbook:C00960)
AnnotationAssertion(rdfs:seeAlso goldbook:P04619 goldbook:F02519)
AnnotationAssertion(rdfs:seeAlso goldbook:P04619 goldbook:P04618)
AnnotationAssertion(rdfs:seeAlso goldbook:P04619 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:P04619 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04619 "current"^^xsd:string)
Declaration(Class(goldbook:P04620))
AnnotationAssertion(rdfs:label goldbook:P04620 "photoionization")
AnnotationAssertion(dcterms:description goldbook:P04620 "The term generally used to describe ionization of any species by photons. The process may, for example, be written  Electrons and photons do not 'impact' molecules or atoms; they interact with them in ways that result in various electronic excitations including ionization. For this reason it is recommended that in mass spectrometry the terms 'electron impact' and 'photon impact' not be used.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04620 goldbook:I03183)
AnnotationAssertion(rdfs:seeAlso goldbook:P04620 goldbook:M03746)
AnnotationAssertion(mito:isMentionedBy goldbook:P04620 doi:10.1351/pac199163101541)
AnnotationAssertion(mito:isMentionedBy goldbook:P04620 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04620 "current"^^xsd:string)
Declaration(Class(goldbook:P04621))
AnnotationAssertion(rdfs:label goldbook:P04621 "photoionization detector")
AnnotationAssertion(dcterms:description goldbook:P04621 "Radiation from an ultraviolet lamp ionizes certain species in the carrier gas. A potential difference is applied and the resulting ionization current is detected. The detector is only useful for substances with ionization potentials below about \\(11\\ \\rm{eV}\\). This makes it quite useful for detecting one component of a combined eluent when the other component, for instance nitrogen, has a high ionization potential. The detector has a small linear dynamic range and is capable of detecting substances below \\(1\\ \\rm{ppmv}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:P04621 goldbook:C00863)
AnnotationAssertion(rdfs:seeAlso goldbook:P04621 goldbook:E02040)
AnnotationAssertion(rdfs:seeAlso goldbook:P04621 goldbook:I03183)
AnnotationAssertion(rdfs:seeAlso goldbook:P04621 goldbook:I03208)
AnnotationAssertion(rdfs:seeAlso goldbook:P04621 goldbook:L03447)
AnnotationAssertion(rdfs:seeAlso goldbook:P04621 goldbook:UT07492)
AnnotationAssertion(mito:isMentionedBy goldbook:P04621 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04621 "current"^^xsd:string)
Declaration(Class(goldbook:P04622))
AnnotationAssertion(rdfs:label goldbook:P04622 "photoisomerization")
AnnotationAssertion(dcterms:description goldbook:P04622 "Photochemical process leading to an isomerization of the substrate, either by bond rotation, skeletal rearrangement or atom- or group- transfer.")
AnnotationAssertion(rdfs:comment goldbook:P04622 "Typical examples are cis-trans photosomerization of alkenes, polyenes and phototautomerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04622 "Photochemical pathways have the advantage over thermal and catalytic methods of giving isomer mixtures (photostationary states) rich in thermodynamically unstable isomers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04622 "Photoisomerization is the primary photochemical reaction of the chromophore in several biological photoreceptors such as retinal proteins (e.g., rhodopsin), phytochromes, and the photoactive yellow protein."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:A00224)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:C01076)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:I03289)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:I03295)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:P04585)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:P04898)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:R05194)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:C01092)
AnnotationAssertion(rdfs:seeAlso goldbook:P04622 goldbook:U06569)
AnnotationAssertion(mito:isMentionedBy goldbook:P04622 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04622 "current"^^xsd:string)
Declaration(Class(goldbook:P04623))
AnnotationAssertion(rdfs:label goldbook:P04623 "photoluminescence")
AnnotationAssertion(dcterms:description goldbook:P04623 "Luminescence from direct photoexcitation of the emitting species.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04623 goldbook:L03641)
AnnotationAssertion(rdfs:seeAlso goldbook:P04623 goldbook:P04613)
AnnotationAssertion(mito:isMentionedBy goldbook:P04623 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04623 "current"^^xsd:string)
Declaration(Class(goldbook:P04624))
AnnotationAssertion(rdfs:label goldbook:P04624 "photolysis")
AnnotationAssertion(dcterms:description goldbook:P04624 "The cleavage of one or more covalent bonds in a molecular entity resulting from absorption of light, or a photochemical process in which such cleavage is an essential part. For example:  The term is used incorrectly to describe irradiation of a sample, although in the combination flash photolysis this usage is accepted.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04624 goldbook:C01384)
AnnotationAssertion(rdfs:seeAlso goldbook:P04624 goldbook:F02418)
AnnotationAssertion(rdfs:seeAlso goldbook:P04624 goldbook:I03255)
AnnotationAssertion(rdfs:seeAlso goldbook:P04624 goldbook:M03986)
AnnotationAssertion(mito:isMentionedBy goldbook:P04624 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04624 "current"^^xsd:string)
Declaration(Class(goldbook:P04625))
AnnotationAssertion(rdfs:label goldbook:P04625 "photometry")
AnnotationAssertion(dcterms:description goldbook:P04625 "The measurement of light over wavelengths which produce visual sensation (approximately \\(380{-}780\\ \\rm{nm}\\)). Thus photometric quantities do not refer to a specific wavelength but to the light emitted by a standard source (formerly a 'standard international candle', now a blackbody radiator emitting at the temperature of solidifying platinum, \\(2042\\ \\rm{K}\\)). luminance and illuminance are the photometric analogues of the radiometric quantities radiance and irradiance, respectively, but conversion from photometric units (e.g. \\(\\rm{lm cm}^{-2}\\)) to radiometric units (e.g. \\(\\pu{J s-1 cm-2}\\)) requires convolution over wavelength of the spectral radiation with the relative spectral response of the human eye. The standard response is called the 'spectral luminous efficiency of radiation', and is tabulated for daylight adapted vision in photopic response tables.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04625 goldbook:I02941)
AnnotationAssertion(rdfs:seeAlso goldbook:P04625 goldbook:I03254)
AnnotationAssertion(rdfs:seeAlso goldbook:P04625 goldbook:L03640)
AnnotationAssertion(rdfs:seeAlso goldbook:P04625 goldbook:R05037)
AnnotationAssertion(rdfs:seeAlso goldbook:P04625 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:P04625 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04625 "current"^^xsd:string)
Declaration(Class(goldbook:P04626))
AnnotationAssertion(rdfs:label goldbook:P04626 "photomultiplier tube")
AnnotationAssertion(dcterms:description goldbook:P04626 "A vacuum phototube with additional amplification by electron multiplication. It consists of a photocathode, a series of dynodes, called a dynode chain on which a secondary-electron multiplication process occurs, and an anode. According to the desired response time, transit time, time spread, gain, or low dark current, different types of dynode structures have been developed, e.g. circular cage structure, linear focused structure, venetian blind structure, box and grid structure. Some special dynode structures permit combination with additional electric or magnetic fields. A strip dynode photomultiplier tube consists of a photocathode followed by thin dynode material on an insulating substrate. In a continuous-strip photomultiplier, two strip dynodes are arranged in parallel. A potential applied to the ends of the two strips produces an electric field across the continuous strip dynodes, giving rise to electron multiplication along the dynodes. In a resistance-strip magnetic photomultiplier, a uniform magnetic field is applied to the planes of the strips, so that the electrons travel in the crossed electric and magnetic fields. A channel photomultiplier tube photocathode consists of a channel electron multiplier (CEM) system for the photoelectrons, and an anode to collect the final electron current. The basic part of the CEM is a tube with a semiconducting inner surface. In general it is curved in order to inhibit the acceleration of positive ions towards the photocathode. A number of small channels called microchannels can be constructed in arrays for imaging applications.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:P04626 "PMT")
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:A00051)
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:A00370)
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:C00769)
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:C00970)
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:R05347)
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:R05315)
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:R05345)
AnnotationAssertion(rdfs:seeAlso goldbook:P04626 goldbook:V06586)
AnnotationAssertion(mito:isMentionedBy goldbook:P04626 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04626 "current"^^xsd:string)
Declaration(Class(goldbook:P04627))
AnnotationAssertion(rdfs:label goldbook:P04627 "photon")
AnnotationAssertion(dcterms:description goldbook:P04627 "Particle of zero charge, zero rest mass, spin quantum number 1, energy \\(h\\  u \\) and momentum \\(\\frac{h\\  u }{c}\\)(\\(h\\) is the Planck constant, \\( u \\) the frequency of radiation and \\(c\\) the speed of light), carrier of electromagnetic force.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04627 goldbook:P04685)
AnnotationAssertion(rdfs:seeAlso goldbook:P04627 goldbook:C00859)
AnnotationAssertion(rdfs:seeAlso goldbook:P04627 goldbook:M04007)
AnnotationAssertion(mito:isMentionedBy goldbook:P04627 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04627 "current"^^xsd:string)
Declaration(Class(goldbook:P04629))
AnnotationAssertion(rdfs:label goldbook:P04629 "photon counting")
AnnotationAssertion(dcterms:description goldbook:P04629 "Recording of sequential single photons counted by way of recording and counting sequential electron pulses at the anode of the photomultiplier.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04629 "single-photon counting")
AnnotationAssertion(rdfs:comment goldbook:P04629 "Each electron pulse consists of 105–106 electrons resulting from the multiplication, in the 'dynode' arrangement (or the microchannel plate) of a photomultiplier, of a single photoelectron emitted by a photosensitive layer (the photocathode of the photomultiplier) upon arrival of a single photon."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04629 "Technique used for two purposes: (i) sensitive measurement of low levels of radiation such as those originating from a luminophore and (ii) recording of emission decays."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04629 goldbook:A00370)
AnnotationAssertion(mito:isMentionedBy goldbook:P04629 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04629 "current"^^xsd:string)
Declaration(Class(goldbook:P04631))
AnnotationAssertion(rdfs:label goldbook:P04631 "photon exitance")
AnnotationAssertion(dcterms:description goldbook:P04631 "Photon flux, number basis, \\(q_{\\rm{p}}\\), emitted by an element of the surface containing the source point under consideration divided by the area \\(S\\) of that element. SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-2}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04631 "photon emittance")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04631 "specific photon emission")
AnnotationAssertion(rdfs:comment goldbook:P04631 "Mathematical definition: \\(\\rm{d}q_{p}/\\rm{d}S\\). If \\(q_{\\rm{p}}\\) is constant over the surface area considered, \\(M_{\\rm{p}} = q_{\\rm{p}}/S\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04631 "Formerly called photon emittance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04631 "This quantity can be expressed on a chemical amount basis by dividing \\(M_{\\rm{p}}\\) by the Avogadro constant. In this case the symbol is \\(M_{n\\rm{,p}}\\), the name 'photon exitance, amount basis', SI unit is \\(\\pu{mol s-1 m-2}\\); common unit is \\(\\pu{einstein s-1 m-2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04631 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:P04631 goldbook:C01019)
AnnotationAssertion(rdfs:seeAlso goldbook:P04631 goldbook:E02264)
AnnotationAssertion(mito:isMentionedBy goldbook:P04631 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04631 "current"^^xsd:string)
Declaration(Class(goldbook:P04632))
AnnotationAssertion(rdfs:label goldbook:P04632 "photon exposure")
AnnotationAssertion(dcterms:description goldbook:P04632 "Photon irradiance, \\(E_{\\rm{p}}\\), integrated over the time of irradiation for a beam incident from all upward directions. SI unit is \\(\\rm{m}^{-2}\\).")
AnnotationAssertion(rdfs:comment goldbook:P04632 "Mathematical definition: \\(H_{\\rm{p}} = \\int_{t}E_{\\rm{p}}\\rm{d}t\\). If the photon irradiance is constant over the time interval, \\(H_{\\rm{p}} = E_{\\rm{p}}t\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04632 "This term refers to a beam not scattered or reflected by the target or its surroundings. For a beam incident from all directions photon fluence (\\(H_{\\rm{p,o}}\\), \\(F_{\\rm{p,o}}\\)) is an equivalent term."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04632 "This quantity can be used on a chemical amount basis by dividing \\(H_{\\rm{p}}\\) by the Avogadro constant, the symbol then being \\(H_{n\\rm{,p}}\\), the name 'photon exposure, amount basis', SI unit is \\(\\pu{mol m-2}\\); common unit is \\(\\pu{einstein m-2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04632 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:P04632 goldbook:P04637)
AnnotationAssertion(rdfs:seeAlso goldbook:P04632 goldbook:C01019)
AnnotationAssertion(rdfs:seeAlso goldbook:P04632 goldbook:I03255)
AnnotationAssertion(mito:isMentionedBy goldbook:P04632 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04632 "current"^^xsd:string)
Declaration(Class(goldbook:P04633))
AnnotationAssertion(rdfs:label goldbook:P04633 "photon flow")
AnnotationAssertion(dcterms:description goldbook:P04633 "The number of photons (quanta, \\(N\\)) per unit time. (\\(\\frac{\\rm{d}N}{\\rm{d}t}\\), simplified expression: \\(\\mathit{\\Phi} _{\\rm{p}} = \\frac{N}{t}\\) when the number of photons is constant over the time considered). The SI unit is \\(\\rm{s}^{-1}\\). Alternatively, the term can be used with the amount of photons (mol or its equivalent einstein), the SI unit then being \\(\\pu{mol s-1}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:P04633 goldbook:E01914)
AnnotationAssertion(rdfs:seeAlso goldbook:P04633 goldbook:R05046)
AnnotationAssertion(rdfs:seeAlso goldbook:P04633 goldbook:S05820)
AnnotationAssertion(mito:isMentionedBy goldbook:P04633 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04633 "current"^^xsd:string)
Declaration(Class(goldbook:P04634))
AnnotationAssertion(rdfs:label goldbook:P04634 "photon fluence")
AnnotationAssertion(dcterms:description goldbook:P04634 "Amount of photons (quanta of radiation) incident on a small sphere from all directions, divided by the cross-sectional area of that sphere and integrated over time. Photons per surface area (\\(\\rm{quanta m}^{-2}\\)). SI unit is \\(\\rm{m}^{-2}\\).")
AnnotationAssertion(rdfs:comment goldbook:P04634 "Mathematical definition: \\(H_{\\rm{p,o}} = F_{\\rm{p,o}} = \\rm{d}N_{\\rm{p}}/\\rm{d}S = \\int_{t}E_{\\rm{p,o}}\\rm{d}t\\) with \\(E_{\\rm{p,o}}\\) the photon fluence rate, integrated over the duration of the irradiation, \\(t\\). If \\(E_{\\rm{p,o}}\\) is constant over the time interval, \\(H_{\\rm{p,o}} = F_{\\rm{p,o}} = E_{\\rm{p,o}}\\,t\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04634 "This quantity can be used on a chemical amount basis by dividing \\(H_{\\rm{p,o}}\\) by the Avogadro constant, the symbol then being \\(H_{n\\rm{,p,o}}\\), the name 'photon fluence, amount basis', SI unit is \\(\\pu{mol m-2}\\); common unit is \\(\\pu{einstein m-2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04634 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:P04634 goldbook:C01019)
AnnotationAssertion(rdfs:seeAlso goldbook:P04634 goldbook:I03255)
AnnotationAssertion(rdfs:seeAlso goldbook:P04634 goldbook:P04635)
AnnotationAssertion(mito:isMentionedBy goldbook:P04634 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04634 "current"^^xsd:string)
Declaration(Class(goldbook:P04635))
AnnotationAssertion(rdfs:label goldbook:P04635 "photon fluence rate")
AnnotationAssertion(dcterms:description goldbook:P04635 "Rate of photon fluence. Total number of photons (\\(N_{\\rm{p}}\\)) incident from all directions on a small sphere divided by the cross-sectional area of the sphere and per time interval. SI unit is \\(\\rm{m}^{-2}\\ \\rm{s}^{-1}\\). Same as photon fluence rate.")
AnnotationAssertion(rdfs:comment goldbook:P04635 "Mathematical definition: \\(E_{\\rm{p,o}} = \\rm{d}N_{\\rm{p}}/\\left ( \\rm{d}t\\, \\rm{d}S \\right ) = \\rm{d}H_{\\rm{p,o}}/\\rm{d}t\\). If \\(E_{\\rm{p,o}}\\) is constant over the time interval and the surface, \\(E_{\\rm{p,o}} = N_{\\rm{p}}/t\\, S\\). Equivalent definition: \\(E_{\\rm{p,o}} = \\int _{4\\pi}L_{\\rm{p}}\\rm{d}\\varOmega\\) with \\(L_{\\rm{p}}\\) the photon radiance and \\(\\varOmega\\) the solid angle of the beams passing through the given point on the surface."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04635 "It reduces to photon irradiance \\(E_{\\rm{p}}\\) for a parallel and normally incident beam not scattered or reflected by the target or its surroundings."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04635 "This quantity can be used on a chemical amount basis by dividing \\(E_{\\rm{p,o}}\\) by the Avogadro constant, the symbol then being \\(E_{n\\rm{,p,o}}\\), the name 'photon spherical irradiance, amount basis', SI unit is \\(\\pu{mol m-2 s-1}\\); common unit is \\(\\pu{einstein m-2 s-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04635 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:P04635 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:P04635 goldbook:C01019)
AnnotationAssertion(rdfs:seeAlso goldbook:P04635 goldbook:FT07376)
AnnotationAssertion(rdfs:seeAlso goldbook:P04635 goldbook:P04637)
AnnotationAssertion(rdfs:seeAlso goldbook:P04635 goldbook:P04639)
AnnotationAssertion(mito:isMentionedBy goldbook:P04635 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04635 "current"^^xsd:string)
Declaration(Class(goldbook:P04636))
AnnotationAssertion(rdfs:label goldbook:P04636 "photon flux")
AnnotationAssertion(dcterms:description goldbook:P04636 "Number of photons (quanta of radiation, \\(N_{\\rm{p}}\\)) per time interval. SI unit is \\(\\rm{s}^{-1}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:P04636 "CEI")
AnnotationAssertion(rdfs:comment goldbook:P04636 "Mathematical definition: \\(q_{\\rm{p}} = \\rm{d}N_{\\rm{p}}/\\rm{d}t\\). If the number of photons is constant over the time interval, \\(q_{\\rm{p}} = N_{\\rm{p}}/t\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04636 "This quantity can be used on a chemical amount basis by dividing the photon flux, number basis, \\(q_{\\rm{p}}\\), by the Avogadro constant, the symbol then being \\(q_{n\\rm{,p}}\\), the name 'photon flux, amount basis', SI unit is \\(\\pu{mol s-1}\\); common unit is \\(\\rm{einstein s}^{-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04636 "Although the symbol recommended by CEI is \\(\\mathit{\\Phi} _{\\rm{p}}\\), the symbol \\(q_{\\rm{p}}\\) is preferred since \\(\\mathit{\\Phi}\\) is reserved for quantum yield."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04636 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:P04636 goldbook:C01019)
AnnotationAssertion(rdfs:seeAlso goldbook:P04636 goldbook:Q04991)
AnnotationAssertion(mito:isMentionedBy goldbook:P04636 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04636 "current"^^xsd:string)
Declaration(Class(goldbook:P04637))
AnnotationAssertion(rdfs:label goldbook:P04637 "photon irradiance")
AnnotationAssertion(dcterms:description goldbook:P04637 "Number of photons (quanta of radiation, \\(N_{\\rm{p}}\\)) per time interval (photon flux), \\(q_{\\rm{p}}\\), incident from all upward directions on a small element of surface containing the point under consideration divided by the area of the element. SI unit is \\(\\rm{m}^{-2}\\ \\rm{s}^{-1}\\). Equivalent definition: Integral, taken over the hemisphere visible from the given point, of the expression \\(L_{\\rm{p}}\\, \\rm{cos}\\:\\theta\\, \\rm{d}\\varOmega\\) the photon radiance at the given point in the various directions of the incident beam of solid angle \\(\\varOmega\\) and \\(\\theta\\) the angle between any of these beams and the normal to the surface at the given point.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:P04637 "SI")
AnnotationAssertion(rdfs:comment goldbook:P04637 "Mathematical definition: \\(E_{\\rm{p}} = \\rm{d}q_{\\rm{p}}/\\rm{d}S\\). If the photon flux is constant over the surface considered, \\(E_{\\rm{p}} = q_{\\rm{p}}/S\\). Equivalent definition: \\(E_{\\rm{p}} = \\int_{2\\pi} L_{\\rm{p}}\\, \\rm{cos}\\:\\theta\\, \\rm{d}\\varOmega\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04637 "This term refers to a beam not scattered or reflected by the target or its surroundings. For a beam incident from all directions photon fluence rate (\\(E_{\\rm{p,o}}\\)) is an equivalent term."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04637 "This quantity can be used on a chemical amount basis by dividing \\(E_{\\rm{p}}\\) by the Avogadro constant, the symbol then being \\(E_{n\\rm{,p}}\\), the name 'photon irradiance, amount basis', SI unit is \\(\\pu{mol m-2 s-1}\\); common unit is \\(\\pu{einstein m-2 s-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04637 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:P04637 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:P04637 goldbook:C01019)
AnnotationAssertion(rdfs:seeAlso goldbook:P04637 goldbook:P04635)
AnnotationAssertion(rdfs:seeAlso goldbook:P04637 goldbook:P04639)
AnnotationAssertion(rdfs:seeAlso goldbook:P04637 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:P04637 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04637 "current"^^xsd:string)
Declaration(Class(goldbook:P04639))
AnnotationAssertion(rdfs:label goldbook:P04639 "photon radiance")
AnnotationAssertion(dcterms:description goldbook:P04639 "Number of photons (quanta of radiation, \\(N_{\\rm{p}}\\)) per time interval (photon flux), \\(q_{\\rm{p}}\\), leaving or passing through a small transparent element of surface in a given direction from the source about the solid angle \\(\\varOmega\\), divided by the solid angle and by the orthogonally projected area of the element in a plane normal to the given beam direction, \\(\\rm{d}S_{\\perp } = \\rm{d}S\\, cos\\,\\theta\\), with \\(\\theta\\) the angle between the normal to the surface and the direction of the beam. Equivalent definition: Integral taken over the hemisphere visible from the given point, of the expression \\(L_{\\rm{p}}\\, cos\\,\\theta\\,\\rm{d}\\varOmega\\), with \\(L_{\\rm{p}}\\) the photon radiance at the given point in the various directions of the incident beam of solid angle \\(\\varOmega\\) and \\(\\theta\\) the angle between any of these beams and the normal to the surface at the given point.")
AnnotationAssertion(rdfs:comment goldbook:P04639 "Mathematical definition: \\[L_{\\rm{p}} = \\frac{\\rm{d}^{2}q_{p}}{\\rm{d}\\varOmega \\, \\rm{d}S_{\\perp }} = \\frac{\\rm{d}^{2}q_{p}}{\\rm{d}\\varOmega \\, \\rm{d}S\\, cos\\,\\theta}\\] for a divergent beam propagating in an elementary cone of the solid angle \\(\\varOmega\\) containing the direction \\(\\theta\\). SI unit is \\(\\rm{m}^{-2}\\ \\rm{s}^{-1}\\ \\rm{sr}^{-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04639 "For a parallel beam it is the number of photons (quanta of radiation, \\(N_{\\rm{p}}\\)) per time interval (photon flux), \\(q_{\\rm{p}}\\), leaving or passing through a small element of surface in a given direction from the source divided by the orthogonally projected area of the element in a plane normal to the given direction of the beam, \\(\\theta\\). Mathematical definition in this case: \\(L_{\\rm{p}} = \\rm{d}q_{\\rm{p}}/\\left ( \\rm{d}S\\, cos\\,\\theta \\right )\\) If \\(q_{\\rm{p}}\\) is constant over the surface area considered, \\(L_{\\rm{p}} = q_{\\rm{p}}/\\left ( S\\, cos\\,\\theta \\right )\\), SI unit is \\(\\rm{m}^{-2}\\ \\rm{s}^{-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04639 "This quantity can be used on a chemical amount basis by dividing \\(L_{\\rm{p}}\\) by the Avogadro constant, the symbol then being \\(L_{n\\rm{,p}}\\), the name 'photon radiance, amount basis'. For a divergent beam SI unit is \\(\\pu{mol m-2 s-1 sr-1}\\); common unit is \\(\\pu{einstein m-2 s-1 sr-1}\\). For a parallel beam SI unit is \\(\\pu{mol m-2 s-1}\\); common unit is \\(\\pu{einstein m-2 s-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04639 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:P04639 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:P04639 goldbook:C01019)
AnnotationAssertion(rdfs:seeAlso goldbook:P04639 goldbook:R05037)
AnnotationAssertion(rdfs:seeAlso goldbook:P04639 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:P04639 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04639 "current"^^xsd:string)
Declaration(Class(goldbook:P04640))
AnnotationAssertion(rdfs:label goldbook:P04640 "photooxidation")
AnnotationAssertion(dcterms:description goldbook:P04640 "Oxidation reactions induced by light. Common processes are: 1, the loss of one or more electrons from a chemical species as a result of photoexcitation of that species; 2, the reaction of a substance with oxygen under the influence of light. When oxygen remains in the product this latter process is also called photooxygenation. Reactions in which neither the substrate nor the oxygen are electronically excited are sometimes called photoinitiated oxidations.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04640 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:P04640 goldbook:P04613)
AnnotationAssertion(rdfs:seeAlso goldbook:P04640 goldbook:P04641)
AnnotationAssertion(rdfs:seeAlso goldbook:P04640 goldbook:P04650)
AnnotationAssertion(mito:isMentionedBy goldbook:P04640 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04640 "current"^^xsd:string)
Declaration(Class(goldbook:P04641))
AnnotationAssertion(rdfs:label goldbook:P04641 "photooxygenation")
AnnotationAssertion(dcterms:description goldbook:P04641 "The incorporation of molecular oxygen into a molecular entity. There are three common mechanisms: Type I: the reaction of triplet molecular oxygen with radicals formed photochemically. Type II: the reaction of photochemically produced singlet molecular oxygen with molecular entities to give rise to oxygen containing molecular entities. The third mechanism proceeds by electron transfer producing superoxide anion as the reactive species.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04641 goldbook:A00358)
AnnotationAssertion(rdfs:seeAlso goldbook:P04641 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:P04641 goldbook:P04640)
AnnotationAssertion(mito:isMentionedBy goldbook:P04641 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04641 "current"^^xsd:string)
Declaration(Class(goldbook:P04645))
AnnotationAssertion(rdfs:label goldbook:P04645 "photophoresis")
AnnotationAssertion(dcterms:description goldbook:P04645 "In aerosol physics, the motion of particles due to the influence of light. In many cases, this amounts to a special form of thermophoresis due to the heating of the particles by the light.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04645 goldbook:A00176)
AnnotationAssertion(mito:isMentionedBy goldbook:P04645 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04645 "current"^^xsd:string)
Declaration(Class(goldbook:P04646))
AnnotationAssertion(rdfs:label goldbook:P04646 "photophosphorylation")
AnnotationAssertion(dcterms:description goldbook:P04646 "The transformation of light (solar) energy for the reduction of $\\ce{CO2}$ and the generation of adenosine 5'-triphosphate, ATP.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04646 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:P04646 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04646 "current"^^xsd:string)
Declaration(Class(goldbook:P04647))
AnnotationAssertion(rdfs:label goldbook:P04647 "photophysical processes")
AnnotationAssertion(dcterms:description goldbook:P04647 "Photoexcitation and subsequent events which lead from one to another state of a molecular entity through radiation and radiationless transitions. No chemical change results.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04647 "primary photoprocess")
AnnotationAssertion(rdfs:seeAlso goldbook:P04647 goldbook:P04613)
AnnotationAssertion(rdfs:seeAlso goldbook:P04647 goldbook:P04836)
AnnotationAssertion(mito:isMentionedBy goldbook:P04647 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04647 "current"^^xsd:string)
Declaration(Class(goldbook:P04648))
AnnotationAssertion(rdfs:label goldbook:P04648 "photopolymerization")
AnnotationAssertion(dcterms:description goldbook:P04648 "Polymerization processes requiring a photon for the propagation step.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04648 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:P04648 goldbook:P04618)
AnnotationAssertion(rdfs:seeAlso goldbook:P04648 goldbook:P04881)
AnnotationAssertion(mito:isMentionedBy goldbook:P04648 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04648 "current"^^xsd:string)
Declaration(Class(goldbook:P04650))
AnnotationAssertion(rdfs:label goldbook:P04650 "photoreduction")
AnnotationAssertion(dcterms:description goldbook:P04650 "Reduction reactions induced by light. Common processes are: 1, addition of one or more electrons to a photoexcited species; 2, the photochemical hydrogenation of a substance. Reactions in which the substrate is not electronically excited are sometimes called photoinitiated reductions.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04650 goldbook:P04640)
AnnotationAssertion(mito:isMentionedBy goldbook:P04650 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04650 "current"^^xsd:string)
Declaration(Class(goldbook:P04651))
AnnotationAssertion(rdfs:label goldbook:P04651 "photoresist")
AnnotationAssertion(dcterms:description goldbook:P04651 "A photoimaging material, generally applied as a thin film, whose local solubility properties can be altered photochemically. A subsequent development step produces an image which is useful for the fabrication of microelectronic devices (e.g. integrated circuits).")
AnnotationAssertion(rdfs:seeAlso goldbook:P04651 goldbook:I02944)
AnnotationAssertion(rdfs:seeAlso goldbook:P04651 goldbook:S05740)
AnnotationAssertion(rdfs:seeAlso goldbook:P04651 goldbook:T06345)
AnnotationAssertion(mito:isMentionedBy goldbook:P04651 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04651 "current"^^xsd:string)
Declaration(Class(goldbook:P04652))
AnnotationAssertion(rdfs:label goldbook:P04652 "photosensitization")
AnnotationAssertion(dcterms:description goldbook:P04652 "The process by which a photochemical or photophysical alteration occurs in one molecular entity as a result of initial absorption of radiation by another molecular entity called a 'photosensitizer'. In mechanistic photochemistry the term is limited to cases in which the photosensitizer is not consumed in the reaction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04652 "sensitization")
AnnotationAssertion(rdfs:seeAlso goldbook:P04652 goldbook:E02116)
AnnotationAssertion(rdfs:seeAlso goldbook:P04652 goldbook:P04588)
AnnotationAssertion(mito:isMentionedBy goldbook:P04652 doi:10.1351/pac198153030753)
AnnotationAssertion(mito:isMentionedBy goldbook:P04652 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04652 "current"^^xsd:string)
Declaration(Class(goldbook:P04654))
AnnotationAssertion(rdfs:label goldbook:P04654 "photostationary state")
AnnotationAssertion(dcterms:description goldbook:P04654 "A steady state reached by a reacting chemical system when light has been absorbed by at least one of the components. At this state the rates of formation and disappearance are equal for each of the transient molecular entities formed.")
AnnotationAssertion(mito:isMentionedBy goldbook:P04654 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04654 "current"^^xsd:string)
Declaration(Class(goldbook:P04655))
AnnotationAssertion(rdfs:label goldbook:P04655 "photosynthesis")
AnnotationAssertion(dcterms:description goldbook:P04655 "A metabolic process involving plants and some types of bacteria (e.g. Chromatiaceae, Rhodospirillaceae, Chlorobiaceae) in which light energy absorbed by chlorophyll and other photosynthetic pigments results in the reduction of $\\ce{CO2}$ followed by the formation of organic compounds. In plants the overall process involves the conversion of $\\ce{CO2}$ and $\\ce{H2O}$ to carbohydrates (and other plant material) and the release of $\\ce{O2}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04655 goldbook:C00820)
AnnotationAssertion(mito:isMentionedBy goldbook:P04655 doi:10.1351/pac199062112167)
AnnotationAssertion(mito:isMentionedBy goldbook:P04655 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04655 "current"^^xsd:string)
Declaration(Class(goldbook:P04656))
AnnotationAssertion(rdfs:label goldbook:P04656 "photothermal effect")
AnnotationAssertion(dcterms:description goldbook:P04656 "An effect produced by photoexcitation resulting partially or totally in the production of heat.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04656 goldbook:P04613)
AnnotationAssertion(mito:isMentionedBy goldbook:P04656 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04656 "current"^^xsd:string)
Declaration(Class(goldbook:P04657))
AnnotationAssertion(rdfs:label goldbook:P04657 "photothermography")
AnnotationAssertion(dcterms:description goldbook:P04657 "A process utilizing both light and heat, simultaneously or sequentially, for image recording.")
AnnotationAssertion(mito:isMentionedBy goldbook:P04657 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04657 "current"^^xsd:string)
Declaration(Class(goldbook:P04658))
AnnotationAssertion(rdfs:label goldbook:P04658 "phototransistor")
AnnotationAssertion(dcterms:description goldbook:P04658 "A bipolar transistor with its base-collector junction acting as a photodiode, which, if irradiated, controls the response of the device. Due to the inherent current gain (of the transistor) the responsivity of the phototransistor is greater than that of photodiodes. A Darlington phototransistor consists of two separate transistors coupled in the high-impedance Darlington configuration with a phototransistor as the input transistor. A field effect phototransistor or photo-FET is a field effect transistor (FET) that employs photogeneration of carriers in the channel region (the neutral region sandwiched between the insulator and the depletion region under the gate of the FET). It is characterized by high responsivity due to the high current gain of the FET.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:P04658 "FET")
AnnotationAssertion(rdfs:seeAlso goldbook:P04658 goldbook:C00970)
AnnotationAssertion(rdfs:seeAlso goldbook:P04658 goldbook:F02358)
AnnotationAssertion(rdfs:seeAlso goldbook:P04658 goldbook:I02988)
AnnotationAssertion(rdfs:seeAlso goldbook:P04658 goldbook:P04598)
AnnotationAssertion(mito:isMentionedBy goldbook:P04658 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04658 "current"^^xsd:string)
Declaration(Class(goldbook:P04659))
AnnotationAssertion(rdfs:label goldbook:P04659 "photovoltaic cell")
AnnotationAssertion(dcterms:description goldbook:P04659 "A solid state device, usually a semiconductor such as silicon, which absorbs photons with energies higher than or equal to the bandgap energy and simultaneously produces electric power.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04659 goldbook:B00593)
AnnotationAssertion(rdfs:seeAlso goldbook:P04659 goldbook:P04615)
AnnotationAssertion(rdfs:seeAlso goldbook:P04659 goldbook:P04792)
AnnotationAssertion(rdfs:seeAlso goldbook:P04659 goldbook:S05591)
AnnotationAssertion(mito:isMentionedBy goldbook:P04659 doi:10.1351/pac199163040569)
AnnotationAssertion(mito:isMentionedBy goldbook:P04659 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04659 "current"^^xsd:string)
Declaration(Class(goldbook:P04660))
AnnotationAssertion(rdfs:label goldbook:P04660 "pH-rate profile")
AnnotationAssertion(dcterms:description goldbook:P04660 "A plot of observed rate coefficient, or more usually its decadic logarithm, against pH of solution, other variables being kept constant.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04660 goldbook:O04322)
AnnotationAssertion(mito:isMentionedBy goldbook:P04660 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04660 "current"^^xsd:string)
Declaration(Class(goldbook:P04662))
AnnotationAssertion(rdfs:label goldbook:P04662 "phthaleins")
AnnotationAssertion(dcterms:description goldbook:P04662 "3,3-Bis(hydroxyaryl)-2-benzofuran-1(3H)-ones generally derived from the condensation of phthalic anhydride with phenols. E.g. phenolphthalein.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04662 goldbook:P04539)
AnnotationAssertion(rdfs:seeAlso goldbook:P04662 goldbook:X06695)
AnnotationAssertion(mito:isMentionedBy goldbook:P04662 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04662 "current"^^xsd:string)
Declaration(Class(goldbook:P04663))
AnnotationAssertion(rdfs:label goldbook:P04663 "phthalides")
AnnotationAssertion(dcterms:description goldbook:P04663 "3,3-Di(hydrocarbyl) or 3-hydrocarbylidene-2-benzofuran-1(3H)-ones.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04663 goldbook:P04662)
AnnotationAssertion(mito:isMentionedBy goldbook:P04663 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04663 "current"^^xsd:string)
Declaration(Class(goldbook:P04665))
AnnotationAssertion(rdfs:label goldbook:P04665 "physical network")
AnnotationAssertion(dcterms:description goldbook:P04665 "Polymer network with junction points or zones formed by physically interacting chains which need not be permanent.")
AnnotationAssertion(rdfs:comment goldbook:P04665 "The junction points or zones need not be permanent over the time scale of the observation or measurement."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04665 "The interaction can be due to hydrogen bonds, π–π interactions, chain entanglements, etc."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04665 "Modification of the entry given as a note within the definition of network in polymer chemistry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04665 goldbook:P04742)
AnnotationAssertion(rdfs:seeAlso goldbook:P04665 goldbook:N04112)
AnnotationAssertion(mito:isMentionedBy goldbook:P04665 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04665 "current"^^xsd:string)
Declaration(Class(goldbook:P04667))
AnnotationAssertion(rdfs:label goldbook:P04667 "physisorption")
AnnotationAssertion(dcterms:description goldbook:P04667 "Adsorption in which the forces involved are intermolecular forces (van der Waals forces) of the same kind as those responsible for the imperfection of real gases and the condensation vapours, and which do not involve a significant change in the electronic orbital patterns of the species involved. The term 'van der Waals adsorption' is synonymous with physical adsorption, but its use is not recommended.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04667 "physical adsorption")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04667 "van der Waals adsorption")
AnnotationAssertion(rdfs:seeAlso goldbook:P04667 goldbook:A00155)
AnnotationAssertion(rdfs:seeAlso goldbook:P04667 goldbook:I03098)
AnnotationAssertion(rdfs:seeAlso goldbook:P04667 goldbook:V06595)
