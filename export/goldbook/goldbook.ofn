AnnotationAssertion(rdfs:label goldbook:C00872 "catalymetric titration")
AnnotationAssertion(dcterms:description goldbook:C00872 "A titration process, which involves a catalyst, where the end-point is detected by the sudden increase or decrease of the rate of a reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00872 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:C00872 goldbook:E02096)
