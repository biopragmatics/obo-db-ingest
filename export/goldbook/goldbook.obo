[Term]
id: goldbook:15213
name: moistening agents
def: "Usually water or low-molecular-weight alcohols or compounds\, used in topical applications and in wet granulation\, for the production of tablets."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-04-10-14
property_value: hasStatus "current" xsd:string
