AnnotationAssertion(dcterms:description goldbook:08985 "Term indicating control of a certain kinetic feature of a cationic polymerization or structural aspect of the polymer molecules formed by cationic polymerization, or both.")
AnnotationAssertion(rdfs:comment goldbook:08985 "Generally, the adjective 'controlled' should not be used without specifying the particular kinetic or structural feature that is subject to control."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08985 goldbook:08908)
AnnotationAssertion(mito:isMentionedBy goldbook:08985 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08985 "current"^^xsd:string)
Declaration(Class(goldbook:08986))
AnnotationAssertion(rdfs:label goldbook:08986 "electrophilic chain polymerization")
AnnotationAssertion(dcterms:description goldbook:08986 "Chain polymerization in which the active centres are electrophilic species.")
AnnotationAssertion(rdfs:comment goldbook:08986 "Cationic polymerization is an example of electrophilic chain polymerization."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08986 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08986 "current"^^xsd:string)
Declaration(Class(goldbook:08987))
AnnotationAssertion(rdfs:label goldbook:08987 "living cationic polymerization")
AnnotationAssertion(dcterms:description goldbook:08987 "Cationic polymerization in which chain termination and irreversible chain transfer are absent.")
AnnotationAssertion(rdfs:comment goldbook:08987 "Cationic polymerizations, controlled cationic polymerizations and reversible deactivation cationic polymerizations should not be described as living if there is a non-zero probability of chain termination or irreversible chain transfer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08987 goldbook:08946)
AnnotationAssertion(rdfs:seeAlso goldbook:08987 goldbook:08985)
AnnotationAssertion(rdfs:seeAlso goldbook:08987 goldbook:08912)
AnnotationAssertion(mito:isMentionedBy goldbook:08987 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08987 "current"^^xsd:string)
Declaration(Class(goldbook:08988))
AnnotationAssertion(rdfs:label goldbook:08988 "reversible-deactivation cationic polymerization")
AnnotationAssertion(dcterms:description goldbook:08988 "Reversible-deactivation polymerization in which the chain carriers are cations.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08988 "RDCP")
AnnotationAssertion(rdfs:seeAlso goldbook:08988 goldbook:08912)
AnnotationAssertion(mito:isMentionedBy goldbook:08988 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08988 "current"^^xsd:string)
Declaration(Class(goldbook:08989))
AnnotationAssertion(rdfs:label goldbook:08989 "anion-activated-monomer polymerization")
AnnotationAssertion(dcterms:description goldbook:08989 "Activated-monomer polymerization where the propagating species is an electrophile and activating species is anionic.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08989 "anionic activated-monomer polymerization")
AnnotationAssertion(rdfs:seeAlso goldbook:08989 goldbook:08907)
AnnotationAssertion(rdfs:seeAlso goldbook:08989 goldbook:08966)
AnnotationAssertion(mito:isMentionedBy goldbook:08989 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08989 "current"^^xsd:string)
Declaration(Class(goldbook:08990))
AnnotationAssertion(rdfs:label goldbook:08990 "cation-activated-monomer polymerization")
AnnotationAssertion(dcterms:description goldbook:08990 "Activated-monomer polymerization where the propagating species is a nucleophile and the activating species is cationic.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08990 "cationic activated-monomer polymerization")
AnnotationAssertion(rdfs:seeAlso goldbook:08990 goldbook:08907)
AnnotationAssertion(rdfs:seeAlso goldbook:08990 goldbook:08966)
AnnotationAssertion(mito:isMentionedBy goldbook:08990 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08990 "current"^^xsd:string)
Declaration(Class(goldbook:08991))
AnnotationAssertion(rdfs:label goldbook:08991 "living ring-opening metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08991 "Ring-opening metathesis polymerization in which chain termination and irreversible chain transfer are absent.")
AnnotationAssertion(rdfs:comment goldbook:08991 "Ring-opening metathesis polymerizations should not be described as living if there is a non-zero probability of chain termination (e.g., due to side reactions consuming some part of the catalyst) or irreversible chain transfer (e.g., due to backbiting)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08991 goldbook:08933)
AnnotationAssertion(rdfs:seeAlso goldbook:08991 goldbook:08946)
AnnotationAssertion(mito:isMentionedBy goldbook:08991 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08991 "current"^^xsd:string)
Declaration(Class(goldbook:08992))
AnnotationAssertion(rdfs:label goldbook:08992 "metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08992 "Polymerization in which unsaturated monomers are transformed into unsaturated polymers by a process of bond redistribution.")
AnnotationAssertion(rdfs:comment goldbook:08992 "Metathesis polymerization is most often metal-catalyzed and the kinetic-chain carriers alternate between metal-carbene complexes and metallacyclobutanes or between metal-carbyne complexes and metallacyclobutenes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08992 "The two most common forms of metathesis polymerization are ring-opening metathesis polymerization (ROMP) and acyclic diene metathesis polymerization (ADMET). ADMET is not a chain polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08992 goldbook:08933)
AnnotationAssertion(mito:isMentionedBy goldbook:08992 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08992 "current"^^xsd:string)
Declaration(Class(goldbook:08993))
AnnotationAssertion(rdfs:label goldbook:08993 "ring-opening metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08993 "Metathesis polymerization in which an unsaturated cyclic monomer is converted into an unsaturated monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08993 "ROMP")
AnnotationAssertion(rdfs:comment goldbook:08993 "In general, ring-opening metathesis polymerizations that show some living characteristics should not be called living ring-opening metathesis polymerization when there are side reactions leading to loss of catalyst or irreversible chain transfer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08993 goldbook:08991)
AnnotationAssertion(rdfs:seeAlso goldbook:08993 goldbook:08992)
AnnotationAssertion(mito:isMentionedBy goldbook:08993 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08993 "current"^^xsd:string)
Declaration(Class(goldbook:08994))
AnnotationAssertion(rdfs:label goldbook:08994 "electron-transfer ring-opening metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08994 "Ring-opening metathesis polymerization (ROMP) proceeding through one-electron redox processes in the absence of a metal carbene initiator.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08994 "ET-ROMP")
AnnotationAssertion(rdfs:comment goldbook:08994 "ET-ROMP may be initiated by single electron-transfer to a vinyl ether from a photoredox catalyst or by electrochemical processes to create a radical cation as the kinetic-chain carrier."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08994 goldbook:08933)
AnnotationAssertion(mito:isMentionedBy goldbook:08994 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08994 "current"^^xsd:string)
Declaration(Class(goldbook:08995))
AnnotationAssertion(rdfs:label goldbook:08995 "coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:08995 "Chain polymerization that involves the preliminary coordination of a monomer molecule with a chain carrier.")
AnnotationAssertion(rdfs:comment goldbook:08995 "Coordination polymerization often occurs by pseudo-ionic polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08995 "The term 'metal-catalyzed polymerization' without explanation to designate coordination polymerization is deprecated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08995 goldbook:09007)
AnnotationAssertion(mito:isMentionedBy goldbook:08995 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08995 "current"^^xsd:string)
Declaration(Class(goldbook:08996))
AnnotationAssertion(rdfs:label goldbook:08996 "coordination-addition polymerization")
AnnotationAssertion(dcterms:description goldbook:08996 "Coordination polymerization of \\(\\ce{\\upalpha\\!,\\!\\upbeta\\mbox{-}unsaturated}\\) amides or esters that proceeds by sequential monomer coordination and Michael addition events.")
AnnotationAssertion(rdfs:seeAlso goldbook:08996 goldbook:08995)
AnnotationAssertion(mito:isMentionedBy goldbook:08996 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08996 "current"^^xsd:string)
Declaration(Class(goldbook:08997))
AnnotationAssertion(rdfs:label goldbook:08997 "coordination-insertion polymerization")
AnnotationAssertion(dcterms:description goldbook:08997 "Coordination polymerization of olefins that proceeds by insertion of the olefin into a metal–carbon bond")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08997 "insertion polymerization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08997 "polyinsertion")
AnnotationAssertion(rdfs:seeAlso goldbook:08997 goldbook:08995)
AnnotationAssertion(rdfs:seeAlso goldbook:08997 goldbook:08911)
AnnotationAssertion(mito:isMentionedBy goldbook:08997 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08997 "current"^^xsd:string)
Declaration(Class(goldbook:08998))
AnnotationAssertion(rdfs:label goldbook:08998 "living coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:08998 "Coordination polymerization in which chain termination and irreversible chain transfer are absent.")
AnnotationAssertion(rdfs:comment goldbook:08998 "Coordination polymerizations, controlled coordination polymerizations and reversible-deactivation coordination polymerizations should not be described as living if there is a non-zero probability of chain termination or irreversible chain transfer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08998 "The use of the adjective living to denote systems with an extended catalyst lifetime is deprecated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08998 goldbook:08995)
AnnotationAssertion(rdfs:seeAlso goldbook:08998 goldbook:08946)
AnnotationAssertion(rdfs:seeAlso goldbook:08998 goldbook:08999)
AnnotationAssertion(mito:isMentionedBy goldbook:08998 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08998 "current"^^xsd:string)
Declaration(Class(goldbook:08999))
AnnotationAssertion(rdfs:label goldbook:08999 "reversible-deactivation coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:08999 "Reversible-deactivation polymerization in which the chain carriers are coordination complexes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08999 "RDCP")
AnnotationAssertion(rdfs:seeAlso goldbook:08999 goldbook:09003)
AnnotationAssertion(rdfs:seeAlso goldbook:08999 goldbook:09001)
AnnotationAssertion(rdfs:seeAlso goldbook:08999 goldbook:08912)
AnnotationAssertion(mito:isMentionedBy goldbook:08999 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08999 "current"^^xsd:string)
Declaration(Class(goldbook:09000))
AnnotationAssertion(rdfs:label goldbook:09000 "coordination ring-opening polymerization")
AnnotationAssertion(dcterms:description goldbook:09000 "Coordination polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer.")
AnnotationAssertion(rdfs:seeAlso goldbook:09000 goldbook:08995)
AnnotationAssertion(mito:isMentionedBy goldbook:09000 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09000 "current"^^xsd:string)
Declaration(Class(goldbook:09001))
AnnotationAssertion(rdfs:label goldbook:09001 "chain-shuttling polymerization")
AnnotationAssertion(dcterms:description goldbook:09001 "Coordinative chain-transfer polymerization that involves two different catalysts showing different specificity, where chain propagation occurs sequentially on the two catalysts, allowing for the formation of segmented or multiblock copolymers.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09001 "CSP")
AnnotationAssertion(rdfs:comment goldbook:09001 "Chain-shuttling polymerization is a form of degenerative chain-transfer polymerization (DTP)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09001 goldbook:08944)
AnnotationAssertion(rdfs:seeAlso goldbook:09001 goldbook:09003)
AnnotationAssertion(rdfs:seeAlso goldbook:09001 goldbook:08909)
AnnotationAssertion(mito:isMentionedBy goldbook:09001 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09001 "current"^^xsd:string)
Declaration(Class(goldbook:09002))
AnnotationAssertion(rdfs:label goldbook:09002 "chain-walking polymerization")
AnnotationAssertion(dcterms:description goldbook:09002 "Coordination polymerization in which the chain carrier migrates along the formed polymer chain through a series of \\(\\ce{\\upbeta\\mbox{-}hydrogen}\\) eliminations and reinsertions with inversion of stereochemistry.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09002 "CWP")
AnnotationAssertion(rdfs:comment goldbook:09002 "In contrast to classical coordination polymerizations, which provide linear polyethylene, CWP of ethylene leads to a branched polymer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09002 "CWP of \\(\\ce{\\upbeta\\mbox{-}olefins}\\) generally leads to less branched polymers than those formed by classical coordination polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09002 goldbook:08995)
AnnotationAssertion(mito:isMentionedBy goldbook:09002 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09002 "current"^^xsd:string)
Declaration(Class(goldbook:09003))
AnnotationAssertion(rdfs:label goldbook:09003 "coordinative chain-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:09003 "Coordination polymerization in which a propagating chain is able to transfer reversibly between the catalyst and a chain-transfer agent, thereby converting the active species into a dormant species.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09003 "CCTP")
AnnotationAssertion(rdfs:comment goldbook:09003 "Coordinative chain-transfer polymerization is a form of degenerative chain-transfer polymerization (DTP)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09003 goldbook:08995)
AnnotationAssertion(rdfs:seeAlso goldbook:09003 goldbook:08966)
AnnotationAssertion(rdfs:seeAlso goldbook:09003 goldbook:09001)
AnnotationAssertion(rdfs:seeAlso goldbook:09003 goldbook:08947)
AnnotationAssertion(rdfs:seeAlso goldbook:09003 goldbook:08909)
AnnotationAssertion(rdfs:seeAlso goldbook:09003 goldbook:08952)
AnnotationAssertion(mito:isMentionedBy goldbook:09003 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09003 "current"^^xsd:string)
Declaration(Class(goldbook:09004))
AnnotationAssertion(rdfs:label goldbook:09004 "heterogeneous catalysis coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:09004 "Coordination polymerization making use of a heterogeneous catalyst.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09004 "heterogeneous coordination polymerization")
AnnotationAssertion(rdfs:comment goldbook:09004 "Heterogeneous catalysis coordination polymerization of polyolefins is sometimes known as Ziegler-Natta polymerization. Named reactions are deprecated in IUPAC terminology."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09004 "When using the term heterogeneous coordination polymerization, the context must allow distinction from a coordination polymerization in a heterogeneous medium."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09004 goldbook:08995)
AnnotationAssertion(mito:isMentionedBy goldbook:09004 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09004 "current"^^xsd:string)
Declaration(Class(goldbook:09005))
AnnotationAssertion(rdfs:label goldbook:09005 "homogeneous catalysis coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:09005 "Coordination polymerization making use of a homogeneous catalyst.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09005 "homogeneous coordination polymerization")
AnnotationAssertion(rdfs:comment goldbook:09005 "Metallocene polymerization is one form of homogeneous coordination polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09005 "When using the term homogeneous coordination polymerization, the context must allow distinction from a coordination polymerization in a homogeneous medium."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09005 goldbook:08995)
AnnotationAssertion(rdfs:seeAlso goldbook:09005 goldbook:09006)
AnnotationAssertion(mito:isMentionedBy goldbook:09005 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09005 "current"^^xsd:string)
Declaration(Class(goldbook:09006))
AnnotationAssertion(rdfs:label goldbook:09006 "metallocene polymerization")
AnnotationAssertion(dcterms:description goldbook:09006 "Coordination polymerization making use of a metallocene catalyst.")
AnnotationAssertion(rdfs:seeAlso goldbook:09006 goldbook:08995)
AnnotationAssertion(mito:isMentionedBy goldbook:09006 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09006 "current"^^xsd:string)
Declaration(Class(goldbook:09007))
AnnotationAssertion(rdfs:label goldbook:09007 "pseudo-ionic polymerization")
AnnotationAssertion(dcterms:description goldbook:09007 "Polymerization proceeding by insertion of a monomer into a polar bond without the generation of ions.")
AnnotationAssertion(rdfs:comment goldbook:09007 "Most pseudo-ionic polymerizations involve concerted (e.g., four- or multi-centre) mechanisms of propagation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09007 "The term pseudo-ionic polymerization has been most often used in connection with ring-opening polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09007 goldbook:08995)
AnnotationAssertion(mito:isMentionedBy goldbook:09007 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09007 "current"^^xsd:string)
Declaration(Class(goldbook:09008))
AnnotationAssertion(rdfs:label goldbook:09008 "rare-earth-metal-mediated coordination-addition polymerization")
AnnotationAssertion(dcterms:description goldbook:09008 "Coordination-addition polymerization with propagation occurring within the coordination sphere of a rare-earth metal complex.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09008 "lanthanide-mediated group-transfer polymerization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09008 "rare-earth-metal-mediated coordination polymerization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09008 "rare-earth-metal-mediated group-transfer polymerization")
AnnotationAssertion(rdfs:comment goldbook:09008 "The process may also involve non-rare-earth metal complexes with a sufficiently large coordination sphere (e.g., zirconium)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09008 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09008 "current"^^xsd:string)
Declaration(Class(goldbook:09010))
AnnotationAssertion(rdfs:label goldbook:09010 "catalyst-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:09010 "Catalysed condensative chain polymerization where the catalyst is transferred from reactant polymer to product polymer with high efficiency.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09010 "CTP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09010 "catalyst-transfer chain polymerization")
AnnotationAssertion(rdfs:comment goldbook:09010 "It is recommended that the adjective 'chain' be included in the term catalyst-transfer chain polymerization in circumstances where there may be confusion with respect to whether a chain mechanism is involved."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09010 goldbook:09011)
AnnotationAssertion(rdfs:seeAlso goldbook:09010 goldbook:09009)
AnnotationAssertion(mito:isMentionedBy goldbook:09010 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09010 "current"^^xsd:string)
Declaration(Class(goldbook:09011))
AnnotationAssertion(rdfs:label goldbook:09011 "catalyst-transfer cross-coupling polymerization")
AnnotationAssertion(dcterms:description goldbook:09011 "Catalyst-transfer polymerization where the propagation steps comprise cross-coupling reactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09011 goldbook:09010)
AnnotationAssertion(mito:isMentionedBy goldbook:09011 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09011 "current"^^xsd:string)
Declaration(Class(goldbook:09012))
AnnotationAssertion(rdfs:label goldbook:09012 "living condensative chain polymerization")
AnnotationAssertion(dcterms:description goldbook:09012 "Condensative chain polymerization in which chain termination and irreversible chain transfer are absent.")
AnnotationAssertion(rdfs:comment goldbook:09012 "Condensative chain polymerizations should not be described as living if chain termination or irreversible chain transfer are evident."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09012 goldbook:09009)
AnnotationAssertion(rdfs:seeAlso goldbook:09012 goldbook:08946)
AnnotationAssertion(mito:isMentionedBy goldbook:09012 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09012 "current"^^xsd:string)
Declaration(Class(goldbook:09013))
AnnotationAssertion(rdfs:label goldbook:09013 "brush polymer")
AnnotationAssertion(dcterms:description goldbook:09013 "Polymer composed of brush macromolecules.")
AnnotationAssertion(rdfs:comment goldbook:09013 "The term should not be confused with polymer brush, which is commonly used to describe polymers attached to a substrate."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09013 doi:10.1515/pac-2020-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09013 "current"^^xsd:string)
Declaration(Class(goldbook:09014))
AnnotationAssertion(rdfs:label goldbook:09014 "locant")
AnnotationAssertion(dcterms:description goldbook:09014 "Numeral or letter or a combination of both that identifies position(s) in a structure.")
AnnotationAssertion(rdfs:comment goldbook:09014 "A locant appears in a name or general expression such as ‘2-substituted’."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09014 doi:10.1515/pac-2020-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09014 "current"^^xsd:string)
Declaration(Class(goldbook:09015))
AnnotationAssertion(rdfs:label goldbook:09015 "senior constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09015 "More (most) senior CRU of a structure of a macromolecule or oligomer molecule containing two or more different types of CRUs.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09015 "S-CRU")
AnnotationAssertion(rdfs:comment goldbook:09015 "The CRU beginning with the subunit of highest (higher) seniority is chosen as the S-CRU."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09015 "If CRUs begin with an identical subunit, the choice depends on the seniority of the remaining subunits and the number and position of substituents."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09015 doi:10.1515/pac-2020-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09015 "current"^^xsd:string)
Declaration(Class(goldbook:09016))
AnnotationAssertion(rdfs:label goldbook:09016 "preferred constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09016 "Constitutional repeating unit (CRU) written with the subunits in a linear series from the highest (higher) seniority to the lowest (lower) or as close as possible by the shortest path.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09016 "P-CRU")
AnnotationAssertion(rdfs:comment goldbook:09016 "This definition is based on descriptions of methods to reach the P-CRU."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09016 "The P-CRU is chosen with the lowest possible locant(s) for the substituents."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09016 doi:10.1515/pac-2020-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09016 "current"^^xsd:string)
Declaration(Class(goldbook:09017))
AnnotationAssertion(rdfs:label goldbook:09017 "subunit")
AnnotationAssertion(dcterms:description goldbook:09017 "Largest main-chain (backbone) segment of the constitutional repeating unit (CRU) that can be named a single unit under organic nomenclature rules. This may be a ring or a ring system, a heteroatom or a heteroatom chain, or an acyclic carbon chain.")
AnnotationAssertion(mito:isMentionedBy goldbook:09017 doi:10.1515/pac-2020-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09017 "current"^^xsd:string)
Declaration(Class(goldbook:09018))
AnnotationAssertion(rdfs:label goldbook:09018 "dimensionless Henry’s law solubility constant")
AnnotationAssertion(dcterms:description goldbook:09018 "Amount concentration \\(c_{\\rm{l}}\\) of a species in the liquid phase divided by the amount concentration \\(c_{\\rm{g}}\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{cc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{l}}}{c_{\\rm{g}}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09018 "dimensionless Henry solubility")
AnnotationAssertion(rdfs:comment goldbook:09018 "Instead of the amount concentrations \\(c_{\\rm{l}}\\) and \\(c_{\\rm{g}}\\), the mass concentrations \\(\\gamma_{\\rm{l}}\\) and \\(\\gamma_{\\rm{g}}\\) might be used here. This yields the same dimensionless Henry solubility because the molar mass \\(M\\) of the solute cancels out:\\(\\gamma_{\\rm{l}}/\\gamma_{\\rm{g}} = (c_{\\rm{l}}M)/(c_{\\rm{g}}M) = c_{\\rm{l}}/c_{\\rm{g}}\\)"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09018 goldbook:09021)
AnnotationAssertion(mito:isMentionedBy goldbook:09018 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09018 "current"^^xsd:string)
Declaration(Class(goldbook:09019))
AnnotationAssertion(rdfs:label goldbook:09019 "dimensionless Henry’s law volatility constant")
AnnotationAssertion(dcterms:description goldbook:09019 "Amount concentration \\(c_{\\rm{g}}\\) of a species in the gas phase divided by the amount concentration \\(c_{\\rm{g}}\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{cc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{g}}}{c_{\\rm{l}}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09019 "dimensionless Henry volatility")
AnnotationAssertion(rdfs:comment goldbook:09019 "Instead of the amount concentrations \\(c_{\\rm{g}}\\) and \\(c_{\\rm{l}}\\), the mass concentrations \\(\\gamma_{\\rm{g}}\\) and \\(\\gamma_{\\rm{l}}\\) can be used here. This yields the same dimensionless Henry volatility because the molar mass \\(M\\) of the solute cancels out: \\(\\gamma_{\\rm{g}}/\\gamma_{\\rm{l}} = (c_{\\rm{g}}M)/(c_{\\rm{l}}M) = c_{\\rm{g}}/c_{\\rm{l}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09019 goldbook:09022)
AnnotationAssertion(mito:isMentionedBy goldbook:09019 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09019 "current"^^xsd:string)
Declaration(Class(goldbook:09020))
AnnotationAssertion(rdfs:label goldbook:09020 "Henry’s law constant")
AnnotationAssertion(dcterms:description goldbook:09020 "Proportionality factor describing the equilibrium distribution of a chemical species between the gas phase and a liquid solution at infinite dilution of the solute according to Henry’s law. It is an umbrella term for the reciprocal quantities Henry’s law solubility constant and Henry’s law volatility constant. Because of its ambiguity, it is strongly recommended to specify whether a solubility or volatility constant is intended.")
AnnotationAssertion(rdfs:seeAlso goldbook:09020 goldbook:09021)
AnnotationAssertion(rdfs:seeAlso goldbook:09020 goldbook:09022)
AnnotationAssertion(mito:isMentionedBy goldbook:09020 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09020 "current"^^xsd:string)
Declaration(Class(goldbook:09021))
AnnotationAssertion(rdfs:label goldbook:09021 "Henry’s law solubility constant")
AnnotationAssertion(dcterms:description goldbook:09021 "Umbrella term for all variants of Henry’s law constants that are defined in such a way that the numerical value increases with increasing solubility of the solute. Variants include \\(H_{\\rm{s}}^{cp}\\), \\(H_{\\rm{s}}^{xp}\\), \\(H_{\\rm{s}}^{bp}\\), and \\(H_{\\rm{s}}^{cc}\\), as discussed elsewhere in this section.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09021 "Henry solubility")
AnnotationAssertion(rdfs:seeAlso goldbook:09021 goldbook:09022)
AnnotationAssertion(mito:isMentionedBy goldbook:09021 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09021 "current"^^xsd:string)
Declaration(Class(goldbook:09022))
AnnotationAssertion(rdfs:label goldbook:09022 "Henry’s law volatility constant")
AnnotationAssertion(dcterms:description goldbook:09022 "Umbrella term for all variants of Henry’s law constants that are defined in such a way that the numerical value increases with increasing volatility of the solute. Variants include \\(H_{\\rm{v}}^{pc}\\), \\(H_{\\rm{v}}^{px}\\), \\(H_{\\rm{v}}^{pw}\\), and \\(H_{\\rm{v}}^{cc}\\), as discussed elsewhere in this section.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09022 "Henry volatility")
AnnotationAssertion(rdfs:seeAlso goldbook:09022 goldbook:09021)
AnnotationAssertion(mito:isMentionedBy goldbook:09022 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09022 "current"^^xsd:string)
Declaration(Class(goldbook:09023))
AnnotationAssertion(rdfs:label goldbook:09023 "Henry’s law volatility constant (via p and c)")
AnnotationAssertion(dcterms:description goldbook:09023 "Partial pressure \\(p\\) of a species in the gas phase divided by the amount concentration \\(c_{\\rm{l}}\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{pc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{p}{c_{\\rm{l}}}\\]")
AnnotationAssertion(rdfs:comment goldbook:09023 "The coherent SI unit for \\(H_{\\rm{v}}^{pc}\\) is \\(\\pu{Pa m3 mol-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09023 goldbook:09022)
AnnotationAssertion(mito:isMentionedBy goldbook:09023 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09023 "current"^^xsd:string)
Declaration(Class(goldbook:09024))
AnnotationAssertion(rdfs:label goldbook:09024 "Henry’s law solubility constant (via c and p)")
AnnotationAssertion(dcterms:description goldbook:09024 "Amount concentration \\(c_{\\rm{l}}\\) of a species in the liquid phase divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{cp}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{l}}}{p}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09024 "Henry solubility (defined via amount concentration and partial pressure)")
AnnotationAssertion(rdfs:comment goldbook:09024 "The coherent SI unit for \\(H_{\\rm{s}}^{cp}\\) is \\(\\pu{mol m-3 Pa-1}\\). Another commonly used unit is \\(\\pu{mol L-1 bar-1}\\), equivalent to \\(\\pu{10E-2 mol m-3 Pa-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09024 goldbook:09021)
AnnotationAssertion(mito:isMentionedBy goldbook:09024 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09024 "current"^^xsd:string)
Declaration(Class(goldbook:09025))
AnnotationAssertion(rdfs:label goldbook:09025 "Henry’s law solubility constant (via x and p)")
AnnotationAssertion(dcterms:description goldbook:09025 "Amount fraction \\(x\\) of a species in the liquid phase divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{xp}: = \\underset{x \\to 0}{\\rm{lim}}\\frac{x}{p}\\]")
AnnotationAssertion(rdfs:comment goldbook:09025 "The coherent SI unit for \\(H_{\\rm{s}}^{xp}\\) is \\(\\pu{Pa-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09025 goldbook:09021)
AnnotationAssertion(mito:isMentionedBy goldbook:09025 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09025 "current"^^xsd:string)
Declaration(Class(goldbook:09026))
AnnotationAssertion(rdfs:label goldbook:09026 "Henry’s law solubility constant (via b and p)")
AnnotationAssertion(dcterms:description goldbook:09026 "Molality \\(b\\) of a species divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{bp}: = \\underset{b \\to 0}{\\rm{lim}}\\frac{b}{p}\\]")
AnnotationAssertion(rdfs:comment goldbook:09026 "The coherent SI unit for \\(H_{\\rm{s}}^{bp}\\) is \\(\\pu{mol m-3 Pa-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09026 "Here, the symbol \\(b\\) is used for molality (instead of \\(m\\)) to avoid confusion with the symbol \\(m\\) for mass."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09026 "Molality refers to the mass of solvent and should not be confused with content which refers to the mass of solution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09026 goldbook:09021)
AnnotationAssertion(mito:isMentionedBy goldbook:09026 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09026 "current"^^xsd:string)
Declaration(Class(goldbook:09027))
AnnotationAssertion(rdfs:label goldbook:09027 "Henry’s law volatility constant (via p and x)")
AnnotationAssertion(dcterms:description goldbook:09027 "Partial pressure \\(p\\) of a species in the gas phase divided by the amount fraction \\(x\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{px}: = \\underset{x \\to 0}{\\rm{lim}}\\frac{p}{x}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09027 "Henry volatility (defined via partial pressure and liquid-phase amount fraction)")
AnnotationAssertion(rdfs:comment goldbook:09027 "The coherent SI unit for \\(H_{\\rm{v}}^{px}\\) is \\(\\pu{Pa}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09027 goldbook:09022)
AnnotationAssertion(mito:isMentionedBy goldbook:09027 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09027 "current"^^xsd:string)
Declaration(Class(goldbook:09028))
AnnotationAssertion(rdfs:label goldbook:09028 "Henry’s law volatility constant (via p and w)")
AnnotationAssertion(dcterms:description goldbook:09028 "Partial pressure \\(p\\) of a species in the gas phase divided by the mass fraction \\(w\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{pw}: = \\underset{w \\to 0}{\\rm{lim}}\\frac{p}{w}\\]")
AnnotationAssertion(rdfs:comment goldbook:09028 "The coherent SI unit for \\(H_{\\rm{v}}^{pw}\\) is \\(\\pu{Pa}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09028 goldbook:09022)
AnnotationAssertion(mito:isMentionedBy goldbook:09028 doi:10.1515/pac-2020-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09028 "current"^^xsd:string)
Declaration(Class(goldbook:09029))
AnnotationAssertion(rdfs:label goldbook:09029 "link")
AnnotationAssertion(dcterms:description goldbook:09029 "Constitutive part of a conjugation that binds an active species to a substrate.")
AnnotationAssertion(rdfs:comment goldbook:09029 "When release of the active species is desired, the link must be cleavable."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09029 doi:10.1515/pac-2020-0502)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09029 "current"^^xsd:string)
Declaration(Class(goldbook:09030))
AnnotationAssertion(rdfs:label goldbook:09030 "prodrug conjugate")
AnnotationAssertion(dcterms:description goldbook:09030 "Conjugate in which at least one conjugation includes a bioactive active species to be released by cleavage of the link where its action is desired.")
AnnotationAssertion(mito:isMentionedBy goldbook:09030 doi:10.1515/pac-2020-0502)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09030 "current"^^xsd:string)
Declaration(Class(goldbook:09031))
AnnotationAssertion(rdfs:label goldbook:09031 "spacer arm")
AnnotationAssertion(dcterms:description goldbook:09031 "Link used in a conjugation to distance the substrate from the active species that otherwise would have its activity affected by steric or other influences.")
AnnotationAssertion(rdfs:seeAlso goldbook:09031 goldbook:09029)
AnnotationAssertion(mito:isMentionedBy goldbook:09031 doi:10.1515/pac-2020-0502)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09031 "current"^^xsd:string)
Declaration(Class(goldbook:09032))
AnnotationAssertion(rdfs:label goldbook:09032 "materials chemistry")
AnnotationAssertion(dcterms:description goldbook:09032 "Materials chemistry is the scientific discipline that designs, synthesizes, and characterizes materials with particular interest on both their processing and the understanding of useful or potentially useful properties displayed by the materials designed and synthesized for specific applications.")
AnnotationAssertion(rdfs:comment goldbook:09032 "The aspects of design, synthesis, and function (useful or potentially useful properties) are all needed for the topical item of material research/development/production to be part of materials chemistry."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09032 "The keywords \"useful\" and \"properties\" emphasize functionality as a major driving force of the practitioners of materials chemistry."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09032 "For a series of further details on both the structure-property relation and functionality by design, read the source."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09032 doi:10.1515/pac-2023-0215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09032 "current"^^xsd:string)
Declaration(Class(goldbook:09033))
AnnotationAssertion(rdfs:label goldbook:09033 "pnictogen bond")
AnnotationAssertion(dcterms:description goldbook:09033 "Weak attractive interaction between an electrophilic region on a pnictogen atom in a molecular entity (wherein the pnictogen is involved in other stronger bonds) and a nucleophilic region in another, or the same, molecular entity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09033 "PnB")
AnnotationAssertion(rdfs:comment goldbook:09033 "A typical PnB is denoted by the three dots in \\(\\ce{R–Pn\\bond{...}A}\\), wherein \\(\\ce{R}\\) is collectively representing the groups covalently bonded to the pnictogen atom Pn, Pn (the PnB donor atom) is any atom (possibly hypervalent) of Group 15 having at least one electrophilic (electron poor) region (the PnB donor region) involved in a bond with \\(\\ce{A}\\), \\(\\ce{R–Pn}\\) (the PnB donor) is a molecular entity containing the electrophilic pnictogen atom, and \\(\\ce{A}\\) (the PnB acceptor) is a molecular entity having at least one nucleophilic (electron rich) region (the PnB acceptor region)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09033 "An electrophilic region (typically associated with a \\(\\ce{\\upsigma\\mbox{-}}\\) or \\(\\ce{\\uppi\\mbox{-}hole}\\)) on a pnictogen atom in a molecular entity and a nucleophilic region in another or the same molecular entity can form bonds spanning a range of separations, energies, and other experimental or theoretical parameters; the use of the term PnB has to be limited to cases where separations, energies, and/or other experimental/theoretical parameters differ from those of corresponding covalent/ionic bonds."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09033 "The polar character of the pnictogen atom in the interaction (i.e., the electrophilic role in pnictogen bonded systems or its nucleophilic role in the other systems) is established by considering the physical and chemical properties of the starting molecular entities before the interaction formation and/or of the system assembled by the interaction (see onward)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09033 "Bonds wherein a pnictogen atom acts as the nucleophile and those wherein its electrophilic role cannot be identified must not be named PnBs."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09033 "Pnictogen atoms can concurrently form one or more than one PnB; the PnB donor and/or PnB acceptor can be charged molecular entities, thus forming charge-assisted PnBs."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09033 doi:10.1515/pac-2020-1002)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09033 "current"^^xsd:string)
Declaration(Class(goldbook:09034))
AnnotationAssertion(rdfs:label goldbook:09034 "alkalinity")
AnnotationAssertion(dcterms:description goldbook:09034 "Measure of the capacity of aqueous media to react with hydrogen ions.")
AnnotationAssertion(rdfs:comment goldbook:09034 "Alkalinity is used to assess the buffering capacity of natural waters and is measured by titration using methyl red (pH 4.5, total alkalinity) or phenolphthalein (pH 8.3, composite alkalinity)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09034 "Alkalinity is often expressed as an equivalent mass concentration of calcium carbonate, for example \"alkalinity equals \\(\\pu{3.2 mg L-1}\\) as \\(\\ce{CaCO3}\\).\""^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09034 goldbook:09038)
AnnotationAssertion(mito:isMentionedBy goldbook:09034 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09034 "current"^^xsd:string)
Declaration(Class(goldbook:09035))
AnnotationAssertion(rdfs:label goldbook:09035 "back titration")
AnnotationAssertion(dcterms:description goldbook:09035 "Titration of remaining reagent after addition of excess reagent to the titrand.")
AnnotationAssertion(rdfs:seeAlso goldbook:09035 goldbook:09051)
AnnotationAssertion(mito:isMentionedBy goldbook:09035 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09035 "current"^^xsd:string)
Declaration(Class(goldbook:09036))
AnnotationAssertion(rdfs:label goldbook:09036 "blank titration")
AnnotationAssertion(dcterms:description goldbook:09036 "Titration performed with titrand containing no analyte.")
AnnotationAssertion(rdfs:comment goldbook:09036 "A blank titration is used to estimate systematic error such as indicator consumption error."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09036 goldbook:09046)
AnnotationAssertion(rdfs:seeAlso goldbook:09036 goldbook:09051)
AnnotationAssertion(mito:isMentionedBy goldbook:09036 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09036 "current"^^xsd:string)
Declaration(Class(goldbook:09037))
AnnotationAssertion(rdfs:label goldbook:09037 "cerimetric titration")
AnnotationAssertion(dcterms:description goldbook:09037 "Redox titration using cerium(IV), in which an iron(II)-1,10-phenanthroline complex (ferroin) color change indicates the end-point.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09037 "cerimetry")
AnnotationAssertion(mito:isMentionedBy goldbook:09037 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09037 "current"^^xsd:string)
Declaration(Class(goldbook:09038))
AnnotationAssertion(rdfs:label goldbook:09038 "composite alkalinity")
AnnotationAssertion(dcterms:description goldbook:09038 "Measurement by titration to the phenolphthalein end-point (pH 8.3) of that portion of alkalinity arbitrarily attributed to all the hydroxyl content and half the carbonate content of a titrand.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09038 "phenolphthalein end-point alkalinity")
AnnotationAssertion(rdfs:comment goldbook:09038 "For the carbonate system, with no other oxoanions, \\(A_{\\rm{P}} = [\\ce{CO3^{2-}}] + [\\ce{OH-}]\\) where the concentrations refer to the solution before the titration \\(\\ce{CO3^{2−} + H+ -> HCO3−}\\) and \\(\\ce{OH− + H+ -> H2O}\\) performed to discoloration of the visual indicator."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09038 "By definition, composite alkalinity is zero for solutions which have a pH value of 8.3 or less."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09038 goldbook:09034)
AnnotationAssertion(rdfs:seeAlso goldbook:09038 goldbook:09051)
AnnotationAssertion(mito:isMentionedBy goldbook:09038 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09038 "current"^^xsd:string)
Declaration(Class(goldbook:09039))
AnnotationAssertion(rdfs:label goldbook:09039 "conventional mass")
AnnotationAssertion(dcterms:description goldbook:09039 "Mass of a body that is balanced by a standard mass under conventionally chosen conditions.")
AnnotationAssertion(rdfs:comment goldbook:09039 "The International Organization of Legal Metrology recommends that the conventionally chosen conditions are: reference temperature, \\(t_{\\rm{ref}} = \\pu{20^{\\circ}C}\\), density of air as a reference value, \\(\\rho_{0} = \\pu{1.2 kg m−3}\\); reference density of standard weight, \\(\\rho_{\\rm{c}} = \\pu{8000 kg m-3}\\). In this case, the conventional mass is related to the mass (\\(m\\)) and density (\\(\\rho\\)) of the object by \\(m_{\\rm{c}} = m \\frac{1 - \\rho_{0}/\\rho}{1 - \\rho_{0}/\\rho_{\\rm{c}}}\\)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09039 "The base unit of the quantity \"conventional mass\" is the kilogram."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09039 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09039 "current"^^xsd:string)
Declaration(Class(goldbook:09040))
AnnotationAssertion(rdfs:label goldbook:09040 "direct titration")
AnnotationAssertion(dcterms:description goldbook:09040 "Titration in which titrant is added directly to titrand.")
AnnotationAssertion(rdfs:seeAlso goldbook:09040 goldbook:09035)
AnnotationAssertion(rdfs:seeAlso goldbook:09040 goldbook:09051)
AnnotationAssertion(mito:isMentionedBy goldbook:09040 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09040 "current"^^xsd:string)
Declaration(Class(goldbook:09041))
AnnotationAssertion(rdfs:label goldbook:09041 "end-point error")
AnnotationAssertion(dcterms:description goldbook:09041 "Difference in the volume or mass of titrant, or the corresponding difference in the volume or mass of titrand, between the end-point value and equivalence-point value.")
AnnotationAssertion(rdfs:seeAlso goldbook:09041 goldbook:09042)
AnnotationAssertion(mito:isMentionedBy goldbook:09041 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09041 "current"^^xsd:string)
Declaration(Class(goldbook:09042))
AnnotationAssertion(rdfs:label goldbook:09042 "equivalence-point")
AnnotationAssertion(dcterms:description goldbook:09042 "Stage of a titration at which the titrant has completely reacted with the titrand according to the stoichiometry of the reaction.")
AnnotationAssertion(rdfs:comment goldbook:09042 "The term \"equivalence-point\" is also used for the quantity that expresses the volume or mass of titrant at the equivalence-point."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09042 goldbook:09051)
AnnotationAssertion(mito:isMentionedBy goldbook:09042 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09042 "current"^^xsd:string)
Declaration(Class(goldbook:09043))
AnnotationAssertion(rdfs:label goldbook:09043 "gravimetric analysis")
AnnotationAssertion(dcterms:description goldbook:09043 "Measurement principle of quantitative chemical analysis based on measurement of mass.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09043 "gravimetry")
AnnotationAssertion(rdfs:comment goldbook:09043 "The analyte of interest is separated from the sample in a form that allows measurement of mass (e.g., by precipitation), and its mass or amount of substance is calculated from the mass of the weighed compound whose stoichiometric composition must be exactly known."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09043 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09043 "current"^^xsd:string)
Declaration(Class(goldbook:09044))
AnnotationAssertion(rdfs:label goldbook:09044 "gravimetric factor")
AnnotationAssertion(dcterms:description goldbook:09044 "Mass fraction of analyte in a precipitate (see precipitation) obtained in a gravimetric analysis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09044 "GF")
AnnotationAssertion(rdfs:comment goldbook:09044 "Gravimetric factor is calculated by \\(g_{\\rm{F}} = (M_{\\rm{A}}v_{\\rm{A}})/(M_{\\rm{P}}v_{\\rm{P}})\\), where \\(M_{\\rm{A}}\\), \\(M_{\\rm{P}}\\) are molar masses of analyte and precipitate, respectively, and \\(v_{\\rm{A}}\\) and \\(v_{\\rm{P}}\\) are the stoichiometric numbers in the precipitation reaction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09044 "Historically, the gravimetric factor is given the initialism GF, but to conform to the IUPAC convention that quantities should have a single symbol, it is recommended that \\(g_{\\rm{F}}\\) is used in equations."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09044 "The gravimetric factor is used to calculate the mass fraction of an analyte in a sample (\\(w\\)) by \\(w = m_{\\rm{P}}/m_{\\rm{sample}} \\times g_{\\rm{F}}\\), where \\(m_{\\rm{P}}\\) is the mass of precipitate and \\(m_{\\rm{sample}}\\) the mass of sample."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09044 goldbook:09043)
AnnotationAssertion(mito:isMentionedBy goldbook:09044 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09044 "current"^^xsd:string)
Declaration(Class(goldbook:09045))
AnnotationAssertion(rdfs:label goldbook:09045 "homogeneous precipitation")
AnnotationAssertion(dcterms:description goldbook:09045 "Precipitation in gravimetric analysis in which the precipitating agent is produced from a homogeneously dissolved precursor to minimise local excesses and supersaturation.")
AnnotationAssertion(rdfs:seeAlso goldbook:09045 goldbook:09043)
AnnotationAssertion(mito:isMentionedBy goldbook:09045 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09045 "current"^^xsd:string)
Declaration(Class(goldbook:09046))
AnnotationAssertion(rdfs:label goldbook:09046 "indicator consumption error")
AnnotationAssertion(dcterms:description goldbook:09046 "Systematic measurement error from the reaction of a visual indicator with a reactant in a titration.")
AnnotationAssertion(rdfs:comment goldbook:09046 "The magnitude and sign of this error depends on the amount of substance of indicator used and the nature of the interaction between the indicator and the analyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09046 "Indicator consumption error may be expressed as a volume or mass of titrant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09046 "A significant compensation of this error usually takes place because the standardization of the titrant is carried out in similar conditions to the analysis titration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09046 "Indicator consumption error may be estimated by performing a blank titration."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09046 goldbook:09036)
AnnotationAssertion(mito:isMentionedBy goldbook:09046 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09046 "current"^^xsd:string)
Declaration(Class(goldbook:09047))
AnnotationAssertion(rdfs:label goldbook:09047 "potentiometric titration")
AnnotationAssertion(dcterms:description goldbook:09047 "Redox titration in which the course of the reaction is followed by potentiometry.")
AnnotationAssertion(mito:isMentionedBy goldbook:09047 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09047 "current"^^xsd:string)
Declaration(Class(goldbook:09048))
AnnotationAssertion(rdfs:label goldbook:09048 "precipitation indicator")
AnnotationAssertion(dcterms:description goldbook:09048 "Visual indicator precipitated, with concomitant color change, by reaction with excess titrant at the end-point of a titration.")
AnnotationAssertion(mito:isMentionedBy goldbook:09048 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09048 "current"^^xsd:string)
Declaration(Class(goldbook:09049))
AnnotationAssertion(rdfs:label goldbook:09049 "redox indicator")
AnnotationAssertion(dcterms:description goldbook:09049 "Visual indicator that reacts with excess titrant or titrand with a color change at the end-point of a redox titration.")
AnnotationAssertion(rdfs:seeAlso goldbook:09049 goldbook:09051)
AnnotationAssertion(mito:isMentionedBy goldbook:09049 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09049 "current"^^xsd:string)
Declaration(Class(goldbook:09050))
AnnotationAssertion(rdfs:label goldbook:09050 "stock solution")
AnnotationAssertion(dcterms:description goldbook:09050 "Solution prepared by weighing an appropriate portion of a solid or by measuring out an appropriate volume of a liquid and dissolving it in the weighed mass of solvent or by adding solvent to a given volume.")
AnnotationAssertion(rdfs:comment goldbook:09050 "A stock solution is usually of a greater concentration than is needed for the chemical purpose and is diluted to give the required concentration before use."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09050 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09050 "current"^^xsd:string)
Declaration(Class(goldbook:09051))
AnnotationAssertion(rdfs:label goldbook:09051 "titrand")
AnnotationAssertion(dcterms:description goldbook:09051 "Reactant solution being titrated in a titration.")
AnnotationAssertion(mito:isMentionedBy goldbook:09051 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09051 "current"^^xsd:string)
Declaration(Class(goldbook:09052))
AnnotationAssertion(rdfs:label goldbook:09052 "titrimetric analysis")
AnnotationAssertion(dcterms:description goldbook:09052 "Methods of quantitative analysis employing titration.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09052 "titrimetry")
AnnotationAssertion(rdfs:comment goldbook:09052 "The titrant added is usually measured by volume (volumetric titration) but it can be weighed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09052 goldbook:09055)
AnnotationAssertion(mito:isMentionedBy goldbook:09052 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09052 "current"^^xsd:string)
Declaration(Class(goldbook:09053))
AnnotationAssertion(rdfs:label goldbook:09053 "transition potential")
AnnotationAssertion(dcterms:description goldbook:09053 "Potential at the end-point of a redox titration.")
AnnotationAssertion(rdfs:comment goldbook:09053 "The transition potential is a function of the formal redox potential, the total concentration of the indicator (especially for one color indicators), the depth of the color layer, the minimal observable absorbance change (which depends on wavelength and eye sensitivity), and the absorption coefficient."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09053 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09053 "current"^^xsd:string)
Declaration(Class(goldbook:09054))
AnnotationAssertion(rdfs:label goldbook:09054 "universal indicator")
AnnotationAssertion(dcterms:description goldbook:09054 "Visual indicator composed of a solution of several pH indicators (main components are thymol blue, methyl red, bromothymol blue and phenolphthalein) that changes color through a range of pH values, usually from 1 to 14.")
AnnotationAssertion(rdfs:comment goldbook:09054 "Universal indicators are commercially available in the form of a solution or in paper strips accompanied by a color matching chart."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09054 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09054 "current"^^xsd:string)
Declaration(Class(goldbook:09055))
AnnotationAssertion(rdfs:label goldbook:09055 "volumetric titration")
AnnotationAssertion(dcterms:description goldbook:09055 "Titration in which the titrant is added by volume.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09055 "volumetry")
AnnotationAssertion(rdfs:comment goldbook:09055 "Titrant is usually added from a calibrated burette."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09055 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09055 "current"^^xsd:string)
Declaration(Class(goldbook:09056))
AnnotationAssertion(rdfs:label goldbook:09056 "von Weimarn ratio")
AnnotationAssertion(dcterms:description goldbook:09056 "Difference between the concentration of the supersaturated solution (see supersaturation) required for nucleation (\\(Q\\)) and its solubility (\\(S\\)), divided by the solubility, \\((Q − S)/S\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09056 "relative supersaturation")
AnnotationAssertion(rdfs:comment goldbook:09056 "The units of the quantities \\(Q\\) and \\(S\\) must be the same."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09056 "The particle size of a precipitate increases as its relative supersaturation decreases, so \\(Q\\) should be kept low and \\(S\\) should be high during gravimetric analysis by precipitation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09056 goldbook:09043)
AnnotationAssertion(mito:isMentionedBy goldbook:09056 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09056 "current"^^xsd:string)
Declaration(Class(goldbook:09057))
AnnotationAssertion(rdfs:label goldbook:09057 "net faradaic current")
AnnotationAssertion(dcterms:description goldbook:09057 "Algebraic sum of faradaic currents flowing through an electrode.")
AnnotationAssertion(mito:isMentionedBy goldbook:09057 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09057 "current"^^xsd:string)
Declaration(Class(goldbook:09058))
AnnotationAssertion(rdfs:label goldbook:09058 "electrochemical cell")
AnnotationAssertion(dcterms:description goldbook:09058 "System that consists of at least two electron conductors (electrodes) in contact with ionic conductors (electrolytes).")
AnnotationAssertion(rdfs:comment goldbook:09058 "The two electrodes may be a working electrode and an auxiliary electrode or, for zero-current measurements (potentiometric mode), an indicator electrode and a reference electrode. There may be a third electrode, the cell having a separate auxiliary electrode (to carry current) and reference electrode (for measurement of electrode potential) in addition to a working electrode (See three-electrode cell)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09058 "The current flow through the electrochemical cell may be zero or non-zero. An electrochemical cell with current flow can operate either as a galvanic cell or as an electrolytic cell."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09058 "In electrochemistry the term “cell” is commonly qualified to describe the particular device on which electrochemical reactions take place. Examples of galvanic and electrolytic cells are standard cells, electrochemical sensor cells, conductivity cells, spectroelectrochemical cells, fuel cells, batteries, electrochemical measuring cells, and two- and three-electrode cells."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09058 "If processes of interest occur at both the anode and the cathode of a cell (as in differential amperometry or controlled-current potentiometric titration with two indicator electrodes), the cell should be said to comprise two indicator or two working electrodes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09058 goldbook:09132)
AnnotationAssertion(rdfs:seeAlso goldbook:09058 goldbook:09072)
AnnotationAssertion(rdfs:seeAlso goldbook:09058 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09058 goldbook:09061)
AnnotationAssertion(rdfs:seeAlso goldbook:09058 goldbook:09062)
AnnotationAssertion(rdfs:seeAlso goldbook:09058 goldbook:09066)
AnnotationAssertion(rdfs:seeAlso goldbook:09058 goldbook:09081)
AnnotationAssertion(mito:isMentionedBy goldbook:09058 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09058 "current"^^xsd:string)
Declaration(Class(goldbook:09059))
AnnotationAssertion(rdfs:label goldbook:09059 "electrochemical constants")
AnnotationAssertion(dcterms:description goldbook:09059 "In May 2019, certain fundamental constants that had been measured in SI units have had their numerical values fixed, with no uncertainty, thus defining the units. Of importance to electroanalytical chemistry are the values of the Boltzmann constant, the elementary charge, and the Avogadro constant. These are given in the table below, with calculated values of the Faraday constant (\\(F = e·N_{\\rm{A}}\\)) and gas constant (\\(R = k\\cdot\\!N_{\\rm{A}}\\)).")
AnnotationAssertion(mito:isMentionedBy goldbook:09059 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09059 "current"^^xsd:string)
Declaration(Class(goldbook:09060))
AnnotationAssertion(rdfs:label goldbook:09060 "electrode")
AnnotationAssertion(dcterms:description goldbook:09060 "Electron conductor in an electrochemical cell connected to the external circuit.  Half-cell consisting of at least one electron conductor and at least one ionic conductor (electrolyte).")
AnnotationAssertion(rdfs:comment goldbook:09060 "The current flow through electrochemical cells may be zero or non-zero. An electrochemical cell with current flow can operate either as a galvanic cell or an electrolytic cell."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09060 "In some electroanalytical techniques (conductometry and differential potentiometry), two indicator electrodes are used. For many analytical measurements in cells with current flow, a three-electrode cell is used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09060 "Many types of electrodes are used. These may be classified into groups according to their composition, form and size, and according to their operating mode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09132)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09166)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09058)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09061)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09062)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09066)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09078)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09127)
AnnotationAssertion(rdfs:seeAlso goldbook:09060 goldbook:09081)
AnnotationAssertion(mito:isMentionedBy goldbook:09060 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09060 "current"^^xsd:string)
Declaration(Class(goldbook:09061))
AnnotationAssertion(rdfs:label goldbook:09061 "electrolyte")
AnnotationAssertion(dcterms:description goldbook:09061 "Conducting medium in which the flow of electric current is accompanied by the movement of ions.  Substance that provides ions on dissolution in a solvent or on melting.")
AnnotationAssertion(rdfs:comment goldbook:09061 "An ionic liquid is an electrolyte composed of a salt that is liquid below \\(\\pu{100^{\\circ}C}\\). Ionic liquids have found uses in electrochemical analysis, because their unconventional properties include a negligible vapor pressure, a high thermal and electrochemical stability, and exceptional dissolution properties for both organic and inorganic chemical species."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09061 "A solid electrolyte is a solid material where the predominant charge carriers are ions. For example: NASICON (Na Super Ionic Conductor), which has the general formula \\(\\ce{Na_{1+x}Zr2P_{3-x}Si_{x}O12}\\), \\(0 \\lt x \\lt 3\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09061 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09061 "current"^^xsd:string)
Declaration(Class(goldbook:09062))
AnnotationAssertion(rdfs:label goldbook:09062 "electrolytic cell")
AnnotationAssertion(dcterms:description goldbook:09062 "Electrochemical cell in which electrical energy is converted into chemical energy.")
AnnotationAssertion(rdfs:seeAlso goldbook:09062 goldbook:09058)
AnnotationAssertion(mito:isMentionedBy goldbook:09062 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09062 "current"^^xsd:string)
Declaration(Class(goldbook:09063))
AnnotationAssertion(rdfs:label goldbook:09063 "electron number of an electrochemical reaction")
AnnotationAssertion(dcterms:description goldbook:09063 "Number of electrons transferred in a charge transfer reaction between an electrode and a single entity (ion, radical-ion, or molecule) of an electroactive substance, whose identity must be specified.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09063 "charge number")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09063 "number of electrons transferred")
AnnotationAssertion(rdfs:comment goldbook:09063 "The apparent number of electrons transferred, \\(z_{\\rm{app}}\\), represents the experimentally measured number of electrons transferred between an electrode and one electroactive substance species, whose identity must be specified. When the electrooxidation or electroreduction of a substance \\(\\ce{B}\\) is accompanied by chemical processes, such as the catalyzed or induced reduction of a second substance, or a side reaction that consumes \\(\\ce{B}\\) or an intermediate, the value of \\(z_{\\rm{app}}\\) will differ from that of \\(z\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09063 "Symbol \\(n\\) is commonly used when there is no risk of confusion with an amount of substance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09063 "Charge number is used in in the IUPAC Green Book."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09063 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09063 "current"^^xsd:string)
Declaration(Class(goldbook:09064))
AnnotationAssertion(rdfs:label goldbook:09064 "equilibrium electrode potential")
AnnotationAssertion(dcterms:description goldbook:09064 "Potential of an electrode when no electric current flows through the cell and all local charge transfer equilibria across phase boundaries that are represented in the cell diagram (except at possible electrolyte-electrolyte junctions) and local chemical equilibria are established.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09064 "Nernst potential")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09064 "reversible potential")
AnnotationAssertion(rdfs:comment goldbook:09064 "Temperature and activities of relevant species must be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09064 "\\(E_{\\rm{eq}}\\) is related to the standard electrode potential by the Nernst equation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09064 goldbook:09068)
AnnotationAssertion(rdfs:seeAlso goldbook:09064 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09064 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09064 "current"^^xsd:string)
Declaration(Class(goldbook:09065))
AnnotationAssertion(rdfs:label goldbook:09065 "formal electrode potential")
AnnotationAssertion(dcterms:description goldbook:09065 "Equilibrium electrode potential under conditions of unit concentration of species involved in the electrode reaction. \\[E_{\\rm{eq}} = E^{\\circ\\prime} - (RT/zF) \\mathop \\sum \\limits_{i}  u_{i} \\ln(c_{i}/c^{\\circ)\\] where \\(E_{\\rm{eq}}\\) is the equilibrium electrode potential, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(F\\) the Faraday constant, \\(z\\) the electron number of an electrochemical reaction, \\( u_{\\rm{i}}\\) the stoichiometric coefficients (numbers of species) in the equation of the electrode reaction (positive for products and negative for reactants), and \\(c_{\\rm{i}}\\) are the amount concentrations of the species involved (most usually ions).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09065 "formal potential")
AnnotationAssertion(rdfs:comment goldbook:09065 "It is \\(E^{\\circ\\prime}\\) which is calculated in electrochemical experiments when the concentrations of the various species are known, but their activities are not. Its value depends on the composition of the electrolyte solution. The argument of ln is dimensionless, while the concentration \\(c_{\\rm{i}}\\) is normalized through division by the standard concentration, usually \\(c^{\\circ} = \\pu{1 mol dm-3}\\) for soluble species.."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09065 goldbook:09064)
AnnotationAssertion(rdfs:seeAlso goldbook:09065 goldbook:09063)
AnnotationAssertion(mito:isMentionedBy goldbook:09065 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09065 "current"^^xsd:string)
Declaration(Class(goldbook:09066))
AnnotationAssertion(rdfs:label goldbook:09066 "galvanic cell")
AnnotationAssertion(dcterms:description goldbook:09066 "Electrochemical cell in which chemical reactions occur spontaneously and chemical energy is converted into electrical energy.")
AnnotationAssertion(rdfs:seeAlso goldbook:09066 goldbook:09058)
AnnotationAssertion(mito:isMentionedBy goldbook:09066 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09066 "current"^^xsd:string)
Declaration(Class(goldbook:09067))
AnnotationAssertion(rdfs:label goldbook:09067 "line representation of electrochemical cells")
AnnotationAssertion(dcterms:description goldbook:09067 "Notation giving electrodes, electroactive substances, and other relevant information for an electrochemical cell. The notation starts and finishes with an electrode. Phase boundaries are denoted with a solid vertical bar \\(|\\), boundaries between miscible liquids by a vertical dashed bar \\(¦\\), and a liquid junction by double vertical dashed bars \\(¦¦\\).")
AnnotationAssertion(rdfs:comment goldbook:09067 "The potential difference of an electrochemical cell is measured between a metallic conductor attached to the right-hand electrode of the notation and an identical metallic conductor attached to the left-hand electrode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09067 goldbook:09058)
AnnotationAssertion(rdfs:seeAlso goldbook:09067 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09067 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09067 "current"^^xsd:string)
Declaration(Class(goldbook:09068))
AnnotationAssertion(rdfs:label goldbook:09068 "Nernst equation")
AnnotationAssertion(dcterms:description goldbook:09068 "Fundamental equation in electrochemistry that describes the dependence of the equilibrium electrode potential on the composition of the contacting phases, written as a reduction: \\[E_{\\rm{eq}} = E^{\\circ}\\!-\\!(RT/zF)\\mathop \\sum \\limits_i  u_i \\ln(a_i)\\] where \\(E_{\\rm{eq}}\\) is the equilibrium electrode potential, \\(E^{\\circ}\\) the standard electrode potential of the reaction, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(F\\) the Faraday constant, \\(z\\) the electron number of an electrochemical reaction, and \\( u_{\\rm{i}}\\) are the stoichiometric coefficients (numbers of species) in the equation of the electrode reaction, positive for products and negative for reactants, while \\(a_{\\rm{i}}\\) represents the activities of the species involved (most usually ions).")
AnnotationAssertion(rdfs:comment goldbook:09068 "For a solution containing oxidized (ox) and reduced (red) forms of a redox couple at activities \\(a_{\\rm{ox}}\\) and \\(a_{\\rm{red}}\\), respectively, the equilibrium electrode potential is \\[E_{\\rm{eq}} = E^{\\circ}\\!-\\!(RT/zF)\\ln(a_{\\rm{red}}/a_{\\rm{ox}})\\] where \\(E^{\\circ}\\) is the standard electrode potential of the redox couple."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09068 "In analytical chemistry, concentrations, rather than activities, are often considered (see Note to formal electrode potential) \\[E_{\\rm{eq}} = E^{\\circ\\prime}\\!-\\!(RT/zF)\\ln(c_{\\rm{red}}/c_{\\rm{ox}})\\] where \\(E^{\\circ\\prime}\\) is the formal potential which can differ from the standard electrode potential owing to the influence of real conditions (pH, ionic strength, concentration of complex forming substances, etc.), and \\(c_{\\rm{red}}\\) and \\(c_{\\rm{ox}}\\) are the amount concentrations of reduced and oxidized species, respectively. At \\(\\pu{25^{\\circ}C}\\), and for practical purposes, this equation is often written as \\[E_{\\rm{eq}} \\approx E^{\\circ\\prime}\\!-\\!(0.0592/z)\\log_{10}(c_{\\rm{red}}/c_{\\rm{ox}})\\] where the factor \\(0.0592 \\approx (RT/F)/{\\rm{log}}_{10}(\\rm{e})\\) at \\(\\pu{298.15 K}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09068 goldbook:09063)
AnnotationAssertion(rdfs:seeAlso goldbook:09068 goldbook:09064)
AnnotationAssertion(rdfs:seeAlso goldbook:09068 goldbook:09065)
AnnotationAssertion(mito:isMentionedBy goldbook:09068 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09068 "current"^^xsd:string)
Declaration(Class(goldbook:09069))
AnnotationAssertion(rdfs:label goldbook:09069 "Cottrell equation")
AnnotationAssertion(dcterms:description goldbook:09069 "Equation for diffusion current \\(I_{\\rm{d}}\\) at time \\(t\\) at a large planar electrode in contact with a semi-infinite layer of unstirred solution containing excess supporting (inert) electrolyte and an electroactive substance of bulk concentration \\(c\\) when, at the instant \\(t = 0\\), the potential of the electrode is suddenly changed to a value at which a mass-transport limited electrochemical reaction occurs and the concentration of the electroactive species at the electrode is zero, \\[I_{\\rm{d}} = zFA{D^{1/2}}c/(\\pi^{1/2} t^{1/2})\\] where \\(z\\) is the electron number of an electrochemical reaction in the charge transfer step of the species (being positive for an oxidation and negative for a reduction), \\(F\\) the Faraday constant, \\(A\\) the electrode surface area, and \\(D\\) the diffusion coefficient of the electroactive substance.")
AnnotationAssertion(rdfs:comment goldbook:09069 "This equation shows that the current decays from an initial infinitely large value, is proportional to \\(1/t^{1/2}\\), and that no steady-state current (current independent of time) is ever achieved. In practice, diffusion-limited transport is eventually limited by convection."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09069 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09069 goldbook:09074)
AnnotationAssertion(rdfs:seeAlso goldbook:09069 goldbook:09063)
AnnotationAssertion(mito:isMentionedBy goldbook:09069 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09069 "current"^^xsd:string)
Declaration(Class(goldbook:09070))
AnnotationAssertion(rdfs:label goldbook:09070 "current-potential curve")
AnnotationAssertion(dcterms:description goldbook:09070 "Plot of current versus applied potential (\\(I\\!{-}\\!E\\)) for a given system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09070 "I-E curve")
AnnotationAssertion(rdfs:comment goldbook:09070 "In voltammetry the curve is called a voltammogram."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09070 "The curve is sigmoidal in hydrodynamic voltammetry, voltammetry at microelectrodes and polarography, or peak-shaped in ac voltammetry, differential pulse voltammetry, square-wave voltammetry, stripping voltammetry, and derivative techniques."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09070 goldbook:09130)
AnnotationAssertion(rdfs:seeAlso goldbook:09070 goldbook:09136)
AnnotationAssertion(rdfs:seeAlso goldbook:09070 goldbook:09138)
AnnotationAssertion(rdfs:seeAlso goldbook:09070 goldbook:09147)
AnnotationAssertion(rdfs:seeAlso goldbook:09070 goldbook:09155)
AnnotationAssertion(rdfs:seeAlso goldbook:09070 goldbook:09148)
AnnotationAssertion(rdfs:seeAlso goldbook:09070 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09070 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09070 "current"^^xsd:string)
Declaration(Class(goldbook:09071))
AnnotationAssertion(rdfs:label goldbook:09071 "electrochemical biosensor")
AnnotationAssertion(dcterms:description goldbook:09071 "Electrochemical sensor that has a biological recognition element.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09071 "bioanalytical sensor")
AnnotationAssertion(rdfs:comment goldbook:09071 "Electrochemical biosensor may be shortened to ‘biosensor’ only if there is no ambiguity concerning, or interest in, the principle of measurement."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09071 goldbook:09072)
AnnotationAssertion(mito:isMentionedBy goldbook:09071 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09071 "current"^^xsd:string)
Declaration(Class(goldbook:09072))
AnnotationAssertion(rdfs:label goldbook:09072 "electrochemical sensor")
AnnotationAssertion(dcterms:description goldbook:09072 "Measuring system in which the response to an electrochemical reaction is converted, via a suitable transducer, into a measurable electrical signal.")
AnnotationAssertion(rdfs:comment goldbook:09072 "Measurement principles of electrochemical sensors are given in the table below. When used in the description of cells, the measurement principle is written in place of ‘electrochemical’; thus, potentiometric sensor, amperometric sensor, conductometric sensor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09072 "Among the most important general criteria which must be obeyed in the design of a useful electrochemical sensor are: For amperometric and voltammetric sensors, the species to be determined are electroactive within the sensor’s potential range.For potentiometric sensors, there is an adequate electrode material, free from interferences.The concentration of electroactive species can be determined with sufficient accuracy and precision.Measurements are sufficiently reliable and repeatable.The response time of the sensor is sufficiently short.The drift or decrease of sensor response with time owing to electrode degradation or surface fouling is sufficiently low.Calibration is simple and easy to perform, or not necessary.The limit of detection is sufficiently low for the purpose envisaged.The relative importance of these factors depends on the requirements for monitoring, as well as on the technique employed and the electrode and cell configuration. It is important to bear in mind the possibilities and advantages arising from self-contained test modules, specific assays, miniaturization, and no necessity for external pre-treatment or reagent addition."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09072 goldbook:09128)
AnnotationAssertion(rdfs:seeAlso goldbook:09072 goldbook:09166)
AnnotationAssertion(rdfs:seeAlso goldbook:09072 goldbook:09127)
AnnotationAssertion(mito:isMentionedBy goldbook:09072 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09072 "current"^^xsd:string)
Declaration(Class(goldbook:09073))
AnnotationAssertion(rdfs:label goldbook:09073 "electrode coverage density")
AnnotationAssertion(dcterms:description goldbook:09073 "Amount of a chemical modifier at an electrode surface per unit area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09073 "electrode coverage")
AnnotationAssertion(rdfs:comment goldbook:09073 "The total coverage may be distinguished from coverage that is electrochemically reactive or accessible on some given timescale."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09073 "SI unit of \\(\\mathit{\\Gamma}\\) is \\(\\pu{mol m−2}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09073 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09073 "current"^^xsd:string)
Declaration(Class(goldbook:09074))
AnnotationAssertion(rdfs:label goldbook:09074 "electrode surface area")
AnnotationAssertion(dcterms:description goldbook:09074 "Area of electrode–solution interface.")
AnnotationAssertion(rdfs:comment goldbook:09074 "The geometric area, \\(A_{\\rm{geom}}\\), is the interfacial area, determined on the assumption that the interface is truly flat (two-dimensional) and calculated using the geometric data of the involved surfaces."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09074 "The real (true) area, \\(A_{\\rm{real}}\\), takes into account non-idealities of the interface (roughness, porosity, etc.) and can be measured by a variety of electrochemical methods."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09074 "The electroactive area is the area calculated from experiments with model electroactive species and may be different from the real surface area in cases where not all of the surface is electrochemically active or accessible."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09074 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09074 "current"^^xsd:string)
Declaration(Class(goldbook:09075))
AnnotationAssertion(rdfs:label goldbook:09075 "Faraday’s laws of electrolysis")
AnnotationAssertion(dcterms:description goldbook:09075 "Faraday’s First Law of electrolysis: Mass \\(m\\) of electrochemically-transformed substance is proportional to the charge \\(Q\\) passed, \\(m\\! \\propto\\! Q\\). Faraday’s Second Law of electrolysis: When the same electric charge (quantity of electricity) \\(Q\\) is passed through several electrolytes, the mass \\(m_{\\rm{i}}\\) of the substances deposited are proportional to their respective chemical equivalent molar mass, \\(M_{\\rm{i}}/z_{\\rm{i}}\\). \\[m_{1}/m_{2} = (M_{1}/z_{1})/(M_{2}/z_{2})\\]")
AnnotationAssertion(rdfs:comment goldbook:09075 "The relationship may be formulated as \\(m=MQ/zF\\), where \\(M\\) is the molar mass of the substance, \\(z\\) the number of electrons transferred (see: electron number of an electrochemical reaction), and \\(F\\) is the Faraday constant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09075 "Measurement of charge using a coulometer relies on Faraday’s Law."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09075 "If reference is made only to ‘Faraday’s Law of electrolysis’ the first law is meant."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09075 goldbook:09157)
AnnotationAssertion(rdfs:seeAlso goldbook:09075 goldbook:09063)
AnnotationAssertion(mito:isMentionedBy goldbook:09075 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09075 "current"^^xsd:string)
Declaration(Class(goldbook:09076))
AnnotationAssertion(rdfs:label goldbook:09076 "galvanostat")
AnnotationAssertion(dcterms:description goldbook:09076 "Instrument which controls the electric current between the working electrode and the auxiliary electrode.")
AnnotationAssertion(rdfs:seeAlso goldbook:09076 goldbook:09132)
AnnotationAssertion(rdfs:seeAlso goldbook:09076 goldbook:09079)
AnnotationAssertion(mito:isMentionedBy goldbook:09076 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09076 "current"^^xsd:string)
Declaration(Class(goldbook:09077))
AnnotationAssertion(rdfs:label goldbook:09077 "open circuit potential")
AnnotationAssertion(dcterms:description goldbook:09077 "Electrode potential of working electrode relative to the reference electrode when no potential or electric current is being applied to the electrochemical cell.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09077 "OCP")
AnnotationAssertion(rdfs:comment goldbook:09077 "In the case of a reversible electrode system, the OCP is also referred to as the equilibrium electrode potential. Otherwise, it is called the rest potential, or the corrosion potential, depending on the system being studied."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09077 goldbook:09058)
AnnotationAssertion(rdfs:seeAlso goldbook:09077 goldbook:09064)
AnnotationAssertion(mito:isMentionedBy goldbook:09077 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09077 "current"^^xsd:string)
Declaration(Class(goldbook:09078))
AnnotationAssertion(rdfs:label goldbook:09078 "polarizable electrode")
AnnotationAssertion(dcterms:description goldbook:09078 "Electrode whose potential changes with an applied potential.")
AnnotationAssertion(rdfs:comment goldbook:09078 "A non-polarizable electrode is an electrode that holds its potential essentially constant by efficiently allowing electric current to pass. This is a desirable characteristic for a reference electrode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09078 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09078 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09078 "current"^^xsd:string)
Declaration(Class(goldbook:09079))
AnnotationAssertion(rdfs:label goldbook:09079 "potentiostat")
AnnotationAssertion(dcterms:description goldbook:09079 "Measuring instrument for electric current that controls the potential difference between a working electrode and a reference electrode and measures the electric current between a working electrode and an auxiliary electrode.")
AnnotationAssertion(rdfs:seeAlso goldbook:09079 goldbook:09132)
AnnotationAssertion(mito:isMentionedBy goldbook:09079 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09079 "current"^^xsd:string)
Declaration(Class(goldbook:09080))
AnnotationAssertion(rdfs:label goldbook:09080 "salt bridge")
AnnotationAssertion(dcterms:description goldbook:09080 "Means of making electrolytic connection between two half cells without introducing a significant liquid junction potential.")
AnnotationAssertion(rdfs:comment goldbook:09080 "A typical construction is a tube of an inert material (e.g. agar agar) filled with a solution containing an electrolyte with approximately equal ion mobilities of the cation and the anion (e.g., \\(\\ce{KNO3}\\), \\(\\ce{KCl}\\)), with the ends of the tube immersed in the electrolyte solution of the half cells."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09080 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09080 "current"^^xsd:string)
Declaration(Class(goldbook:09081))
AnnotationAssertion(rdfs:label goldbook:09081 "three-electrode cell")
AnnotationAssertion(dcterms:description goldbook:09081 "Electrochemical cell with a working electrode, reference electrode, and auxiliary electrode.Schematic of a three-electrode cell. 1 - working electrode, 2 - reference electrode, 3 - auxiliary electrode. The potential between 1 and 2 is set while passing and measuring current between 1 and 3.")
AnnotationAssertion(rdfs:comment goldbook:09081 "Electric current flows between the working and auxiliary electrodes. Electrode potential may be measured between the working and reference electrodes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09081 "A potentiostat can be used to maintain a potential difference between the working and reference electrodes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09081 goldbook:09058)
AnnotationAssertion(rdfs:seeAlso goldbook:09081 goldbook:09079)
AnnotationAssertion(mito:isMentionedBy goldbook:09081 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09081 "current"^^xsd:string)
Declaration(Class(goldbook:09082))
AnnotationAssertion(rdfs:label goldbook:09082 "working potential range")
AnnotationAssertion(dcterms:description goldbook:09082 "Range of electrode potentials of a given working electrode in a given electrolyte, where the electric current from reactions of the electrode or electrolyte is negligible compared with the current from reactions of the system under investigation.")
AnnotationAssertion(rdfs:comment goldbook:09082 "Because the working potential range is a function of a specific electrode/electrolyte system, only approximate ranges can be given for generic systems. See table."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09082 "The working potential range is usually limited by the stability of the electrolyte, itself affected by the catalytic properties of the electrode, or by the stability of the electrode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09082 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09082 goldbook:09061)
AnnotationAssertion(mito:isMentionedBy goldbook:09082 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09082 "current"^^xsd:string)
Declaration(Class(goldbook:09083))
AnnotationAssertion(rdfs:label goldbook:09083 "macroelectrode")
AnnotationAssertion(dcterms:description goldbook:09083 "Electrode with smallest dimension of order millimetre or greater.")
AnnotationAssertion(rdfs:comment goldbook:09083 "Electrodes are described by their smallest dimension. Thus, an electrode of \\(\\pu{1 \\upmu m \\times 1 mm}\\) is termed a ‘microelectrode’."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09083 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09083 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09083 "current"^^xsd:string)
Declaration(Class(goldbook:09084))
AnnotationAssertion(rdfs:label goldbook:09084 "microelectrode")
AnnotationAssertion(dcterms:description goldbook:09084 "Electrode with smallest dimension of less than 1 millimetre and greater than 1 micrometre.")
AnnotationAssertion(rdfs:comment goldbook:09084 "Electrodes are described by their smallest dimension. Thus, an electrode of \\(\\pu{1 \\upmu m \\times 1 mm}\\) is termed a ‘microelectrode’."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09084 "Microelectrodes operate at a current small enough to not perturb the concentration of the solution over the experimental time span."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09084 "Electrode dimensions of micrometres are now routine and the distinction between ‘ultramicro’ and ‘micro’ electrodes is not usually made."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09084 "When the smallest dimension of an electrode falls below about \\(\\pu{25 \\upmu m}\\), the diffusion layer thickness becomes greater than the dimension of the electrode, which leads to a steady state current given by \\(I = zFA m_{0} c_{0}\\), where \\(z\\) is the number of electrons transferred (see electron number of an electrochemical reaction) in the charge transfer step of the species (being positive for an oxidation and negative for a reduction), \\(F\\) the Faraday constant, \\(A\\) the electrode surface area, and \\(c_{0}\\) the bulk concentration of electroactive species. \\(m_{0}\\) depends on the geometry of the electrode and is, for example, \\(4D/\\pi r_{0}\\) for a disc and \\(D/r_{0}\\) for a hemisphere, where \\(D\\) is the diffusion coefficient of the electroactive substance, and \\(r_{0}\\) the radius of the electrode."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09084 "An IUPAC Technical Report defined microelectrode in terms of its relation to the diffusion layer thickness. Microelectrode is any electrode whose characteristic dimension is, under the given experimental conditions, comparable to or smaller than the diffusion layer thickness, \\(\\delta\\). Under these conditions, a steady state or a pseudo steady state (cylindrical electrodes) is attained. In a short time, when the diffusion layer thickness \\(\\delta\\) is smaller than the characteristic electrode dimension \\(r\\), an electrode behaves as a regular planar electrode. In contrast, at a long time, when \\(\\delta\\) is large compared to \\(r\\), an electrode acts as a microelectrode. In defining a microelectrode, important is the dimensionless \\(\\delta/r\\) ratio. An electrode operates as the microelectrode if this ratio much exceeds unity. An absolute \\(r\\) value is irrelevant in this definition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09084 "Nanoelectrodes and microelectrodes are often configured as electrode arrays."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09084 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09084 goldbook:09114)
AnnotationAssertion(rdfs:seeAlso goldbook:09084 goldbook:09074)
AnnotationAssertion(rdfs:seeAlso goldbook:09084 goldbook:09063)
AnnotationAssertion(mito:isMentionedBy goldbook:09084 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09084 "current"^^xsd:string)
Declaration(Class(goldbook:09085))
AnnotationAssertion(rdfs:label goldbook:09085 "ultramicroelectrode")
AnnotationAssertion(dcterms:description goldbook:09085 "Electrode with smallest dimension of less than 25 micrometre.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09085 "UME")
AnnotationAssertion(rdfs:comment goldbook:09085 "Electrodes are described by their smallest dimension. Thus, an electrode of \\(\\pu{1 \\upmu m \\times 1 mm}\\) is termed a ‘microelectrode’."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09085 "Electrode dimensions of micrometres are now routine and the distinction between ‘ultramicro’ and ‘micro’ electrodes is not usually made."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09085 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09085 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09085 "current"^^xsd:string)
Declaration(Class(goldbook:09086))
AnnotationAssertion(rdfs:label goldbook:09086 "nanoelectrode")
AnnotationAssertion(dcterms:description goldbook:09086 "Electrode with smallest dimension less than 1 micrometre")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09086 "NE")
AnnotationAssertion(rdfs:comment goldbook:09086 "Nanoelectrodes and microelectrodes are often configured as electrode arrays."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09086 "Nanoparticles adsorbed, or otherwise deposited, on a conductor are considered a kind of nanoelectrode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09086 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09086 goldbook:09114)
AnnotationAssertion(mito:isMentionedBy goldbook:09086 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09086 "current"^^xsd:string)
Declaration(Class(goldbook:09087))
AnnotationAssertion(rdfs:label goldbook:09087 "quasi-reference electrode")
AnnotationAssertion(dcterms:description goldbook:09087 "Electrode that maintains a constant, but not generally well-defined, potential in an electrochemical cell.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09087 "QRE")
AnnotationAssertion(rdfs:comment goldbook:09087 "Examples are platinum or silver wires used in non-aqueous electrolytes or ionic liquids. Quasi-reference electrodes are calibrated against a reference electrode or by using a redox couple of known standard electrode potential."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09087 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09087 goldbook:09058)
AnnotationAssertion(mito:isMentionedBy goldbook:09087 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09087 "current"^^xsd:string)
Declaration(Class(goldbook:09088))
AnnotationAssertion(rdfs:label goldbook:09088 "glassy carbon electrode")
AnnotationAssertion(dcterms:description goldbook:09088 "Electrode made of glassy carbon material with an intertwined graphitic ribbon structure, formed by pyrolysis of a resol precursor at temperatures up to \\(\\pu{3000^{\\circ}C}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09088 "GCE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09088 "vitreous carbon electrode")
AnnotationAssertion(rdfs:comment goldbook:09088 "Glassy carbon combines glass-like mechanical characteristics with physical properties similar to graphite, owing to its “graphene ribbon” structure. It is extremely resistant to many chemicals, impermeable to gases and liquids, and has good electrical conductivity, high hardness and strength, and biocompatibility. It is one of the most frequently used working electrode materials."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09088 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09088 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09088 "current"^^xsd:string)
Declaration(Class(goldbook:09089))
AnnotationAssertion(rdfs:label goldbook:09089 "highly oriented pyrolytic graphite electrode")
AnnotationAssertion(dcterms:description goldbook:09089 "Graphite electrode of material produced by high temperature deposition of carbon on a ceramic surface and subject to graphitization at \\(\\pu{3000^{\\circ}C}\\)")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09089 "HOPGE")
AnnotationAssertion(rdfs:comment goldbook:09089 "HOPGE is employed as edge plane pyrolytic graphite electrode (EPPG, graphene sheets perpendicular to the electrode surface) or as basal plane pyrolytic graphite electrode (BPPG, graphene sheets parallel to the electrode surface). The properties of these electrodes are different."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09089 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09089 "current"^^xsd:string)
Declaration(Class(goldbook:09090))
AnnotationAssertion(rdfs:label goldbook:09090 "paraffin impregnated graphite electrode")
AnnotationAssertion(dcterms:description goldbook:09090 "Graphite electrode based on a graphitic material impregnated with paraffin having a high melting point.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09090 "PIGE")
AnnotationAssertion(rdfs:comment goldbook:09090 "Paraffin impregnation results in decreased porosity and lower charging current and memory effects."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09090 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09090 "current"^^xsd:string)
Declaration(Class(goldbook:09091))
AnnotationAssertion(rdfs:label goldbook:09091 "boron-doped diamond electrode")
AnnotationAssertion(dcterms:description goldbook:09091 "Electrode composed of a boron-doped diamond film on an electron-conducting substrate.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09091 "BDDE")
AnnotationAssertion(rdfs:comment goldbook:09091 "Boron is the most widely used dopant to produce conducting diamond electrodes. A BDDE is characterized by a wide working potential range, low noise, a low and stable background current, chemical and mechanical stability, good biocompatibility, and resistance to passivation. BDDEs can be used as substrate materials for various chemical modifications."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09091 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09091 goldbook:09082)
AnnotationAssertion(mito:isMentionedBy goldbook:09091 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09091 "current"^^xsd:string)
Declaration(Class(goldbook:09092))
AnnotationAssertion(rdfs:label goldbook:09092 "biorecognition")
AnnotationAssertion(dcterms:description goldbook:09092 "Detection principle for a chemically modified electrode (CME) in which the electrode is modified by a biological recognition element.")
AnnotationAssertion(mito:isMentionedBy goldbook:09092 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09092 "current"^^xsd:string)
Declaration(Class(goldbook:09093))
AnnotationAssertion(rdfs:label goldbook:09093 "change of mass")
AnnotationAssertion(dcterms:description goldbook:09093 "Detection principle for a chemically modified electrode (CME) in which the signal originates from accumulation and/or release of an analyte or reagent as well as other electrochemical processes which can result in changes in the mass of the CME.")
AnnotationAssertion(rdfs:comment goldbook:09093 "Simultaneous electrochemistry and microgravimetry can be accomplished by means of an electrochemical quartz crystal microbalance (EQCM, see electrochemical piezoelectric microgravimetry). For use with an EQCM, a CME is fabricated by covering one face of a metallized quartz resonator with a modifying film."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09093 goldbook:09162)
AnnotationAssertion(mito:isMentionedBy goldbook:09093 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09093 "current"^^xsd:string)
Declaration(Class(goldbook:09094))
AnnotationAssertion(rdfs:label goldbook:09094 "electrocatalysis")
AnnotationAssertion(dcterms:description goldbook:09094 "Detection principle for a chemically modified electrode (CME) in which a charge transfer reaction between a CME and analyte proceeds at a lower overpotential than at the bare electrode. Usually, the effect of electrocatalysis is also an increase of faradaic current.")
AnnotationAssertion(rdfs:comment goldbook:09094 "Electrocatalysis at a CME must be distinguished from redox mediation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09094 goldbook:09095)
AnnotationAssertion(mito:isMentionedBy goldbook:09094 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09094 "current"^^xsd:string)
Declaration(Class(goldbook:09095))
AnnotationAssertion(rdfs:label goldbook:09095 "redox mediation")
AnnotationAssertion(dcterms:description goldbook:09095 "Detection principle for a chemically modified electrode (CME) in which an immobilized redox couple can shuttle electrons between the electrode and an analyte, for instance, one with difficult access to the electrode surface because of steric reasons.")
AnnotationAssertion(rdfs:comment goldbook:09095 "Electrocatalysis is accomplished by charge mediation but not all mediation results in electrocatalysis."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09095 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09095 "current"^^xsd:string)
Declaration(Class(goldbook:09096))
AnnotationAssertion(rdfs:label goldbook:09096 "carbon paste electrode")
AnnotationAssertion(dcterms:description goldbook:09096 "Electrode of a composite of carbon powder and a pasting liquid (including mineral oil, Nujol, bromoform, bromonaphthalene).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09096 "CPE")
AnnotationAssertion(rdfs:comment goldbook:09096 "The CPE was first described by Adams in 1958. A CPE is typically housed in a Teflon holder, contacted by a conductive wire (occasionally a piston is used to renew the surface by extrusion of the used paste). Problems are long-term stability of the paste and that the binder can influence its properties."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09096 "These electrodes can easily be chemically modified by the incorporation of reagents (electrocatalysts, redox mediators, complexation agents, enzymes, etc.) and by the attachment of micro- or nanoparticles to prepare electrochemical sensors for analytical applications. See for an example using rabbit anti-mouse immunoglobulin in an ELISA assay using a carbon ink electrode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09096 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09096 goldbook:09072)
AnnotationAssertion(mito:isMentionedBy goldbook:09096 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09096 "current"^^xsd:string)
Declaration(Class(goldbook:09097))
AnnotationAssertion(rdfs:label goldbook:09097 "carbon ink electrode")
AnnotationAssertion(dcterms:description goldbook:09097 "Development of a carbon paste electrode that is screen printed using a carbon/polymer mixture of suitable composition.")
AnnotationAssertion(rdfs:comment goldbook:09097 "These electrodes can easily be chemically modified by the incorporation of reagents (electrocatalysts, redox mediators, complexation agents, enzymes, etc.) and by the attachment of micro- or nanoparticles to prepare electrochemical sensors for analytical applications. See for an example using rabbit anti-mouse immunoglobulin in an ELISA assay using a carbon ink electrode."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09097 "Typical composition of a carbon ink expressed as mass fractions is graphite powder \\(\\pu{60\\%}\\) and polystyrene \\(\\pu{40\\%}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09097 goldbook:09096)
AnnotationAssertion(rdfs:seeAlso goldbook:09097 goldbook:09072)
AnnotationAssertion(mito:isMentionedBy goldbook:09097 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09097 "current"^^xsd:string)
Declaration(Class(goldbook:09098))
AnnotationAssertion(rdfs:label goldbook:09098 "solid amalgam electrode")
AnnotationAssertion(dcterms:description goldbook:09098 "Electrode made of a solid amalgam of an appropriate metal.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09098 "SAE")
AnnotationAssertion(rdfs:comment goldbook:09098 "Solid amalgam electrodes are electrochemically similar to the hanging mercury drop electrode. Their main advantages are high hydrogen overpotential (similar to liquid mercury); a wide working potential range; the simple mechanical, chemical, and electrochemical regeneration of the surface; a long lifetime; low toxicity of material (comparable with that of dental amalgams); applicability for field measurements; compatibility with flow-through systems; simple construction, without mobile parts; and easy miniaturization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09098 "Liquid and paste amalgams can also be used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09098 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09098 goldbook:09103)
AnnotationAssertion(rdfs:seeAlso goldbook:09098 goldbook:09082)
AnnotationAssertion(mito:isMentionedBy goldbook:09098 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09098 "current"^^xsd:string)
Declaration(Class(goldbook:09099))
AnnotationAssertion(rdfs:label goldbook:09099 "gold electrode")
AnnotationAssertion(dcterms:description goldbook:09099 "Foil, wire or disc electrode made of gold which is easily fabricated into a variety of electrode geometries.")
AnnotationAssertion(rdfs:comment goldbook:09099 "At positive potentials, \\(\\ce{Au}\\) forms an oxide and/or chemisorbed oxygen layer, while in the presence of complexing anions, such as chloride or cyanide, it readily undergoes oxidation and dissolution, limiting its working potential range and its applications."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09099 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09099 goldbook:09082)
AnnotationAssertion(mito:isMentionedBy goldbook:09099 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09099 "current"^^xsd:string)
Declaration(Class(goldbook:09100))
AnnotationAssertion(rdfs:label goldbook:09100 "platinum electrode")
AnnotationAssertion(dcterms:description goldbook:09100 "Foil, wire, disc, or mesh electrode made of platinum, which is the most commonly used metallic working electrode in electrochemistry.")
AnnotationAssertion(rdfs:comment goldbook:09100 "\\(\\ce{Pt}\\) has a very small overpotential for hydrogen evolution, which determines the negative potential limit in protic solvents. \\(\\ce{Pt}\\) adsorbs hydrogen, resulting in hydrogen adsorption/desorption waves. However, the positive potential limit in polar aprotic solvents free of oxygen and water is higher than that for any other commonly used electrode materials. In the presence of water and/or oxygen, \\(\\ce{Pt}\\) forms a film of oxide (and/or chemisorbed oxygen), resulting in potentially interfering waves or peaks."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09100 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09100 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09100 "current"^^xsd:string)
Declaration(Class(goldbook:09101))
AnnotationAssertion(rdfs:label goldbook:09101 "silver electrode")
AnnotationAssertion(dcterms:description goldbook:09101 "Electrode in the form of foil, mesh, wire, rod, tube, powder, pellets, or single crystal of silver.")
AnnotationAssertion(rdfs:comment goldbook:09101 "\\(\\ce{Ag}\\) electrodes were first used in potentiometry for the determination of \\(\\ce{Cl-}\\), \\(\\ce{Br-}\\), \\(\\ce{I-}\\), as well as for \\(\\ce{Ag+}\\) ions, to which they are sensitive."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09101 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09101 goldbook:09127)
AnnotationAssertion(mito:isMentionedBy goldbook:09101 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09101 "current"^^xsd:string)
Declaration(Class(goldbook:09102))
AnnotationAssertion(rdfs:label goldbook:09102 "mercury electrode")
AnnotationAssertion(dcterms:description goldbook:09102 "Liquid metal electrode used in polarography.")
AnnotationAssertion(rdfs:comment goldbook:09102 "Liquid mercury is an ideal electrode material for negative potentials because of its high overpotential for hydrogen evolution (electrochemical reduction of hydroxonium cations from solution). However, mercury is readily oxidized, particularly in the presence of anions that form complexes or that precipitate with \\(\\ce{Hg(I)}\\) or \\(\\ce{Hg(II)}\\) ions, and thus it is not suitable for use at positive potentials. The use of liquid mercury has largely been discontinued because of concerns about the toxicity of the element and its compounds."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09102 "A mercury film electrode (MFE) or thin mercury film electrode (TMFE) is formed by coating a conducting substrate, usually glassy carbon, with a layer of mercury (thin film, amalgam, or array of microdrops), often by electrodeposition from a solution containing \\(\\ce{Hg(II)}\\). The electrode area is normally in the range of \\(\\pu{0.1 to\\, 0.5 cm2}\\) and mercury film thickness typically ranges from \\(\\pu{10 to 1000 nm}\\), producing a film of large surface area-to-volume ratio that results in a high analyte pre-concentration during the deposition step of anodic stripping voltammetry. Compared to an HMDE, the MFE provides high sensitivity and resolution; however, it is somewhat less reproducible and more prone to interferences from intermetallic formation and surface-active substances."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09102 goldbook:09103)
AnnotationAssertion(rdfs:seeAlso goldbook:09102 goldbook:09152)
AnnotationAssertion(rdfs:seeAlso goldbook:09102 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09102 goldbook:09135)
AnnotationAssertion(mito:isMentionedBy goldbook:09102 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09102 "current"^^xsd:string)
Declaration(Class(goldbook:09103))
AnnotationAssertion(rdfs:label goldbook:09103 "dropping mercury electrode")
AnnotationAssertion(dcterms:description goldbook:09103 "Mercury electrode formed by sequence of mercury drops falling from a small aperture.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09103 "DME")
AnnotationAssertion(rdfs:comment goldbook:09103 "The DME was introduced by Jaroslav Heyrovský (1890–1967). A drop is renewed every few seconds. Many metals amalgamate with mercury so that in the analysis of metal ions in aqueous solution the DME maintains a fresh surface throughout."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09103 "Other kinds of mercury drop electrodes are the static mercury drop electrode (SMDE), in which a drop is held at constant radius before being mechanically knocked off, and the hanging mercury drop electrode (HMDE), in which the whole experiment is performed on a single drop of mercury."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09103 goldbook:09102)
AnnotationAssertion(mito:isMentionedBy goldbook:09103 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09103 "current"^^xsd:string)
Declaration(Class(goldbook:09104))
AnnotationAssertion(rdfs:label goldbook:09104 "bimetallic electrode")
AnnotationAssertion(dcterms:description goldbook:09104 "Electrode containing two different metals (e.g. platinum and ruthenium) on its surface (e.g. to modify its electrocatalytic properties).")
AnnotationAssertion(rdfs:seeAlso goldbook:09104 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09104 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09104 "current"^^xsd:string)
Declaration(Class(goldbook:09105))
AnnotationAssertion(rdfs:label goldbook:09105 "chemically-sensitive field effect transistor")
AnnotationAssertion(dcterms:description goldbook:09105 "Non-faradaic electrode system in which electric field variations in the semiconductor gate region control the magnitude of the source-drain current.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09105 "ChemFET")
AnnotationAssertion(mito:isMentionedBy goldbook:09105 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09105 "current"^^xsd:string)
Declaration(Class(goldbook:09106))
AnnotationAssertion(rdfs:label goldbook:09106 "chemically-modified electrode")
AnnotationAssertion(dcterms:description goldbook:09106 "Electrode coated with a thin layer of a substance that exhibits particular chemical, electrochemical, and/or optical properties.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09106 "CME")
AnnotationAssertion(rdfs:comment goldbook:09106 "The layer may be monomolecular, multimolecular, ionic, or polymeric in structure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09106 "The substance is termed a chemical modifier."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09106 "For electroanalytical purposes, a CME is designed for use as a predominantly voltammetric or amperometric device, but examples of potentiometric, impedimetric, or microgravimetric sensing devices are known."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09106 "A CME is prepared by the deliberate modification of the surface or bulk matrix material of the electrode with a selected reagent (monomeric or polymeric) that governs its electrochemical properties. Such manipulation of the molecular composition of the electrode aims to improve sensitivity, selectivity, and/or stability, allowing for the tailoring of its response to meet analytical needs."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09106 "The range of electrode surface properties sought is broader than that of ion-selective electrodes (ISEs), which also involve the rational design of the phase-boundary, partition, and transport properties of membranes on or between electrodes. CMEs also differ from ISEs in that they are generally used voltammetrically or amperometrically, a faradaic (charge transfer) reaction being the basis of measurement, whereas ISEs are generally used in potentiometric mode, the measured quantity being a phase/boundary potential (interfacial potential difference)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09106 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09106 goldbook:09092)
AnnotationAssertion(rdfs:seeAlso goldbook:09106 goldbook:09095)
AnnotationAssertion(rdfs:seeAlso goldbook:09106 goldbook:11539)
AnnotationAssertion(rdfs:seeAlso goldbook:09106 goldbook:09094)
AnnotationAssertion(mito:isMentionedBy goldbook:09106 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09106 "current"^^xsd:string)
Declaration(Class(goldbook:09107))
AnnotationAssertion(rdfs:label goldbook:09107 "enzyme-modified electrode")
AnnotationAssertion(dcterms:description goldbook:09107 "Chemically-modified electrode in which the products of a reaction between enzymes in an immobilized enzyme layer and the enzyme reaction substrate are electrochemically active and are measured usually by amperometry or potentiometry.Schematic of the mediated oxidation of glucose to gluconolactone by glucose oxidase. The current passed to re-oxidise the mediator is proportional to the amount concentration of glucose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09107 "enzyme electrode")
AnnotationAssertion(rdfs:seeAlso goldbook:09107 goldbook:09106)
AnnotationAssertion(rdfs:seeAlso goldbook:09107 goldbook:09128)
AnnotationAssertion(rdfs:seeAlso goldbook:09107 goldbook:09127)
AnnotationAssertion(mito:isMentionedBy goldbook:09107 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09107 "current"^^xsd:string)
Declaration(Class(goldbook:09108))
AnnotationAssertion(rdfs:label goldbook:09108 "homogeneous crystalline membrane electrodes")
AnnotationAssertion(dcterms:description goldbook:09108 "ISE in which the membrane is a crystalline material prepared from either a single compound or a homogeneous mixture of compounds.")
AnnotationAssertion(mito:isMentionedBy goldbook:09108 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09108 "current"^^xsd:string)
Declaration(Class(goldbook:09109))
AnnotationAssertion(rdfs:label goldbook:09109 "heterogeneous crystalline membrane electrodes")
AnnotationAssertion(dcterms:description goldbook:09109 "ISE prepared of an active substance, or mixture of active substances, mixed with an inert matrix (such as silicone rubber or \\(\\ce{PVC}\\)), or placed on hydrophobized graphite or conducting epoxy resin, to form a heterogeneous sensing membrane.")
AnnotationAssertion(mito:isMentionedBy goldbook:09109 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09109 "current"^^xsd:string)
Declaration(Class(goldbook:09110))
AnnotationAssertion(rdfs:label goldbook:09110 "non-crystalline membrane")
AnnotationAssertion(dcterms:description goldbook:09110 "Kind of ion-selective membranes used in an ISE which is a support matrix, containing an ion exchanger (either cationic or anionic), a plasticizer solvent, and possibly an uncharged, selectivity-enhancing species, form the ion-selective membrane which is usually interposed between two aqueous solutions. The matrix can be either macroporous (e.g., poly(propylene carbonate) filter, glass frit, etc.) or microporous (e.g., “thirsty” glass or polymeric material such as \\(\\ce{PVC}\\)) yielding with the ion-exchanger and the solvent a “solidified” homogeneous mixture.")
AnnotationAssertion(rdfs:comment goldbook:09110 "An ISE based on these membranes exhibits a response due to the presence of the selectivity-enhancing species (which exhibit an ion-exchange property) in the membrane."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09110 goldbook:09119)
AnnotationAssertion(mito:isMentionedBy goldbook:09110 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09110 "current"^^xsd:string)
Declaration(Class(goldbook:09111))
AnnotationAssertion(rdfs:label goldbook:09111 "rigid membranes")
AnnotationAssertion(dcterms:description goldbook:09111 "Kind of ion-selective membranes used in an ISE comprising synthetic cross-linked polymer with fixed sites or thin glass membrane.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09111 "matrix membranes")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09111 "self-supporting membranes")
AnnotationAssertion(rdfs:comment goldbook:09111 "The chemical composition of the polymer (e.g. polystyrenesulfonate, sulfonated poly(tetrafluoroethylene), poly(vinyl chloride) aminated) or the glass determines the membrane selectivity (see pH-sensitive electrode)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09111 goldbook:09119)
AnnotationAssertion(rdfs:seeAlso goldbook:09111 goldbook:09121)
AnnotationAssertion(mito:isMentionedBy goldbook:09111 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09111 "current"^^xsd:string)
Declaration(Class(goldbook:09112))
AnnotationAssertion(rdfs:label goldbook:09112 "membranes with mobile charged sites")
AnnotationAssertion(dcterms:description goldbook:09112 "Kind of ion-selective membranes used in an ISE comprising:  Positively-charged, hydrophobic cations which, when dissolved in a suitable organic solvent and held in an inert support (e.g., poly(propylenecarbonate) filter or \\(\\ce{PVC}\\)), provide membranes which are sensitive to changes in the activities of anions. Negatively-charged hydrophobic anions which, when dissolved in a suitable organic solvent and held in an inert support (e.g., poly(propylene carbonate) filter or \\(\\ce{PVC}\\)), provide membranes which are sensitive to changes of cation activities. Uncharged “carrier” electrodes based on solutions of molecular complexing agents of cations and anions, which can be used for preparing ion exchanger membranes sensitive and selective to certain cations and anions. Hydrophobic ion-pair electrodes of plasticized polymers (e.g., \\(\\ce{PVC}\\)) containing a dissolved hydrophobic ion-pair respond to the ion activities of those components, which are relevant to the ion-pairs incorporated in the membrane. The responses can be Nernstian.")
AnnotationAssertion(rdfs:seeAlso goldbook:09112 goldbook:09119)
AnnotationAssertion(mito:isMentionedBy goldbook:09112 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09112 "current"^^xsd:string)
Declaration(Class(goldbook:09113))
AnnotationAssertion(rdfs:label goldbook:09113 "combined electrode")
AnnotationAssertion(dcterms:description goldbook:09113 "Ion-selective electrode cell in which the ion-selective electrode and reference electrode are combined in a single sensor assembly, thereby avoiding the need for a separate external reference electrode.")
AnnotationAssertion(mito:isMentionedBy goldbook:09113 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09113 "current"^^xsd:string)
Declaration(Class(goldbook:09114))
AnnotationAssertion(rdfs:label goldbook:09114 "electrode array")
AnnotationAssertion(dcterms:description goldbook:09114 "Assembly of linked electrodes (usually microelectrodes, ultramicroelectrodes or nanoelectrodes) acting as a single electrode.")
AnnotationAssertion(rdfs:comment goldbook:09114 "By replacement of macroelectrodes with dimensions in the millimetre or centimetre range by a microelectrode array, the current density can be increased by orders of magnitude, as well as the ratio of faradaic to capacitive currents. When array electrodes are employed as generator-collector systems with two distinct potentials applied, the diffusion distance between electrodes becomes the main factor in controlling the total current."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09114 "Interdigitated array electrodes are commonly employed in electrochemical sensors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09114 goldbook:09072)
AnnotationAssertion(rdfs:seeAlso goldbook:09114 goldbook:09084)
AnnotationAssertion(rdfs:seeAlso goldbook:09114 goldbook:09086)
AnnotationAssertion(rdfs:seeAlso goldbook:09114 goldbook:09085)
AnnotationAssertion(mito:isMentionedBy goldbook:09114 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09114 "current"^^xsd:string)
Declaration(Class(goldbook:09115))
AnnotationAssertion(rdfs:label goldbook:09115 "glass pH-sensitive electrode")
AnnotationAssertion(dcterms:description goldbook:09115 "pH-sensitive electrode, usually consisting of a bulb, or other suitable form, of special glass attached to a stem of high-resistance glass, complete with an internal reference electrode and internal filling solution system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09115 "glass electrode")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09115 "pH electrode")
AnnotationAssertion(rdfs:comment goldbook:09115 "Other geometrical forms may be appropriate for special applications, e.g., a capillary electrode for the measurement of blood pH."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09115 "The potential across the membrane is measured between two reference electrodes (usually silver-silver chloride, chloride) and is related to the ratio of hydronium-ion activities by the Nikolsky–Eisenman equation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09115 "Line notation for the cell is: external reference electrode \\(\\vert\\) external reference electrolyte \\(\\vert\\vert\\) test solution \\(\\vert\\) glass membrane \\(\\vert\\) internal reference electrolyte \\(\\vert\\) internal reference electrode."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09115 "The bulk of the glass membrane is dry (of about \\(\\pu{50 \\upmu m}\\) thickness) with two hydrated layers (of \\(\\pu{5 to 100 nm}\\) thickness) on each side of the membrane that contact the solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09115 "The hydrated layer acts as an ion-exchanger for the exchange of \\(\\ce{Na+}\\) ions of the membrane with \\(\\ce{H3O+}\\) ions from an aqueous solution. \\[|\\ce{Si{-}O{-}Na + H+(aq)|Si{-}OH + Na+(aq)}\\] The glass electrode is therefore selective to \\(\\ce{Na+}\\) (and any other alkali metal ions)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09115 "The membrane potential originates as a Galvani potential difference between the two sides of the glass membrane, which depends on the ratio of the activities of \\(\\ce{H+}\\) ions on both sides of the membrane. In the absence of interfering ions, the membrane potential can be expressed by the Nernst equation \\[\\begin{align*} E &= K + (RT/F)\\ln(a_{\\ce{H+}}({\\rm{test}})/a_{\\ce{H+}}({\\rm{internal}})) \\\\ &= K^{\\prime}\\!-\\!(RT/F)/(\\log_{10}({\\rm{e}}))\\ {\\rm{pH(test)}} \\end{align*}\\] where \\(K\\) and \\(K^{\\prime}\\) are constants, \\(R\\) is the gas constant, \\(T\\) the thermodynamic temperature, \\(F\\) the Faraday constant, and \\(a\\) activity. At \\(\\pu{25^{\\circ}C}\\) this becomes \\(E \\approx K^{\\prime} - 0.0592\\ \\pu{pH(test)}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09115 goldbook:09068)
AnnotationAssertion(rdfs:seeAlso goldbook:09115 goldbook:09120)
AnnotationAssertion(rdfs:seeAlso goldbook:09115 goldbook:09121)
AnnotationAssertion(mito:isMentionedBy goldbook:09115 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09115 "current"^^xsd:string)
Declaration(Class(goldbook:09116))
AnnotationAssertion(rdfs:label goldbook:09116 "heterogeneous crystalline membrane ion-selective electrode")
AnnotationAssertion(dcterms:description goldbook:09116 "Ion-selective electrode in which the ion-selective membrane is a crystalline material mixed with an inert matrix (such as silicone rubber or polyvinyl chloride), or placed on hydrophobized graphite or conducting epoxy resin, to form a heterogeneous sensing membrane.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09116 "heterogeneous crystalline membrane electrode")
AnnotationAssertion(rdfs:seeAlso goldbook:09116 goldbook:09119)
AnnotationAssertion(mito:isMentionedBy goldbook:09116 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09116 "current"^^xsd:string)
Declaration(Class(goldbook:09117))
AnnotationAssertion(rdfs:label goldbook:09117 "homogeneous crystalline membrane ion-selective electrode")
AnnotationAssertion(dcterms:description goldbook:09117 "Ion-selective electrode in which the ion-selective membrane is a crystalline material prepared from either a single compound or homogeneous mixture of compounds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09117 "homogeneous crystalline membrane electrode")
AnnotationAssertion(rdfs:seeAlso goldbook:09117 goldbook:09119)
AnnotationAssertion(mito:isMentionedBy goldbook:09117 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09117 "current"^^xsd:string)
Declaration(Class(goldbook:09118))
AnnotationAssertion(rdfs:label goldbook:09118 "ion-selective field effect transistor")
AnnotationAssertion(dcterms:description goldbook:09118 "Electrochemical sensor based on the principle of the field effect transistor (FET) in which the surface of the gate is modified in a way that makes the response ion-selective.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09118 "ISFET")
AnnotationAssertion(rdfs:comment goldbook:09118 "A field effect transistor is a semi-conductor device in which the electric current between two semiconductor electrodes (termed the source and the drain) is controlled by the third electrode, termed the gate. Changes in the concentration of the species in the solution in contact with the gate surface thus control the current between the source and drain."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09118 "The output signal of the ISFET is usually a potential difference, the magnitude of which varies with the change in the logarithm of sensed ion activity or concentration in the same way (but not necessarily in sign) as the corresponding ion-selective electrode. The graphical representation of results should be in accordance with previous recommendations for ISEs, that is, the output potential difference should be plotted versus the logarithm of ion activity or concentration so that the slope of the plot is positive for cation responsive devices and negative for anion-responsive ones."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09118 "Not all chemical-sensitive semiconductor devices are based on the field effect transistor (FET), metal oxide semiconductor field effect transistor (MOSFET), or insulated gate field effect transistor (IGFET). Also, not all chemically-sensitive field effect transistors (ChemFETs) are ion-sensitive (ISFETs), but considerations are restricted here solely to ISFETs. Generally, ChemFETs are sensitive to gases and to enzyme substrates as well as to ions. Structurally, the ISFET is very similar to the IGFET."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09118 "Symbols and techniques related to the performance of ISFETs with regard to the determination of ions in solution should be in accordance with the recommendations for ISEs."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09118 goldbook:09072)
AnnotationAssertion(rdfs:seeAlso goldbook:09118 goldbook:09105)
AnnotationAssertion(mito:isMentionedBy goldbook:09118 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09118 "current"^^xsd:string)
Declaration(Class(goldbook:09119))
AnnotationAssertion(rdfs:label goldbook:09119 "ion-selective membrane")
AnnotationAssertion(dcterms:description goldbook:09119 "Membrane with controlled permeability to a particular ion covering an electrode, or separating two electrolyte solutions.")
AnnotationAssertion(rdfs:comment goldbook:09119 "The potential difference of an ion-selective electrode derives from differences in activity of an ion at each side of the membrane."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09119 goldbook:09109)
AnnotationAssertion(rdfs:seeAlso goldbook:09119 goldbook:09108)
AnnotationAssertion(rdfs:seeAlso goldbook:09119 goldbook:09112)
AnnotationAssertion(rdfs:seeAlso goldbook:09119 goldbook:09110)
AnnotationAssertion(rdfs:seeAlso goldbook:09119 goldbook:09111)
AnnotationAssertion(mito:isMentionedBy goldbook:09119 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09119 "current"^^xsd:string)
Declaration(Class(goldbook:09120))
AnnotationAssertion(rdfs:label goldbook:09120 "Nikolsky–Eisenman equation")
AnnotationAssertion(dcterms:description goldbook:09120 "Equation describing the contribution of interfering ions, \\(i\\), to the electrode potential of an ion-selective electrode that is mainly dominated by the primary ion \\(\\ce{X}\\). \\[E = {\\rm{const}} + \\frac{RT}{z_{\\rm{X}}F} \\ln \\left(a_{\\ce{X}} + \\sum\\limits_i K_{{\\ce{X}},i}^{\\rm{pot}}a_{i}^{(z_{\\ce{X}}/z_i)} \\right)\\] where \\(E\\) is the measured electrode potential of an ISE when the only variables are activities in the test solution. \\(R\\) is the gas constant, \\(T\\) the thermodynamic temperature, \\(z_{\\rm{X}}\\) and \\(z_{\\rm{i}}\\) are the numbers of electrons transferred by the analyte ion \\(\\ce{X}\\) and \\(i\\), respectively, \\(F\\) is the Faraday constant, \\(a_{\\rm{X}}\\) and \\(a_{\\rm{i}}\\) the activity of \\(\\ce{X}\\) and \\(i\\), respectively, and \\(K_{\\ce{X},i}^{\\rm{pot}}\\) is the potentiometric selectivity coefficient for interfering ion \\(i\\) with respect to the primary ion \\(\\ce{X}\\).")
AnnotationAssertion(rdfs:comment goldbook:09120 "The Nikolsky–Eisenman equation is an extension of the Nernst equation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09120 goldbook:09068)
AnnotationAssertion(rdfs:seeAlso goldbook:09120 goldbook:09063)
AnnotationAssertion(mito:isMentionedBy goldbook:09120 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09120 "current"^^xsd:string)
Declaration(Class(goldbook:09121))
AnnotationAssertion(rdfs:label goldbook:09121 "pH-sensitive electrode")
AnnotationAssertion(dcterms:description goldbook:09121 "Potentiometric electrochemical sensor that measures pH as a linear function of electrode potential.")
AnnotationAssertion(rdfs:comment goldbook:09121 "Measurement principles or methods include the use of an ion-selective electrode (see glass pH-sensitive electrode), ion-selective field effect transistor, metal-metal oxide electrodes, or redox electrode (e.g. hydrogen electrode, quinhydrone electrode)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09121 goldbook:09072)
AnnotationAssertion(rdfs:seeAlso goldbook:09121 goldbook:09115)
AnnotationAssertion(rdfs:seeAlso goldbook:09121 goldbook:09118)
AnnotationAssertion(rdfs:seeAlso goldbook:09121 goldbook:09095)
AnnotationAssertion(mito:isMentionedBy goldbook:09121 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09121 "current"^^xsd:string)
Declaration(Class(goldbook:09122))
AnnotationAssertion(rdfs:label goldbook:09122 "potentiometric enzyme electrode")
AnnotationAssertion(dcterms:description goldbook:09122 "Enzyme-modified electrode, or an electrode modified by a substrate, cofactor or inhibitor, in which the activity of a product of the enzyme reaction is measured by an ion-selective electrode.")
AnnotationAssertion(rdfs:seeAlso goldbook:09122 goldbook:09107)
AnnotationAssertion(rdfs:seeAlso goldbook:09122 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09122 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09122 "current"^^xsd:string)
Declaration(Class(goldbook:09123))
AnnotationAssertion(rdfs:label goldbook:09123 "potentiometric gas sensor")
AnnotationAssertion(dcterms:description goldbook:09123 "Ion-selective electrode cell that is responsive to an analyte gas.")
AnnotationAssertion(rdfs:comment goldbook:09123 "The ion-selective membrane of the gas sensor is in contact with a thin film of solution that is separated from the bulk of the sample solution by a gas-permeable membrane or an air gap. This intermediate solution interacts with the analyte gas that penetrates through the membrane or air gap, which results in a change of a measured constituent (e.g., \\(\\ce{H+}\\) activity) of the intermediate solution. This change is then sensed by the ion-selective electrode and is related to the partial pressure of the gaseous species in the sample."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09123 "These electrodes respond both to the partial pressure of the gas (\\(\\ce{H2}\\) or \\(\\ce{Cl2}\\)) and to the ionic activities of related species (\\(\\ce{H+}\\) or \\(\\ce{Cl-}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09123 "In electrochemical literature the term ‘gas electrode’ includes potentiometric gas sensors and the classical, redox-equilibrium-based gas electrodes, such as the hydrogen electrode: \\(\\ce{Pt(s)}\\,|\\,\\ce{H2(g)\\,|\\,\\ce{H+(aq)}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09123 goldbook:09119)
AnnotationAssertion(mito:isMentionedBy goldbook:09123 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09123 "current"^^xsd:string)
Declaration(Class(goldbook:09124))
AnnotationAssertion(rdfs:label goldbook:09124 "rotating disc electrode")
AnnotationAssertion(dcterms:description goldbook:09124 "A disc electrode that is embedded in the centre of a cylinder which rotates in solution around the longitudinal cylinder axis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09124 "RDE")
AnnotationAssertion(rdfs:comment goldbook:09124 "The limiting current is given by the Levich equation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09124 "The current is directly proportional to the electrode area and the electrode is uniformly accessible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09124 "A second annular working electrode may be positioned concentric with the disc to make a rotating ring-disc electrode (RRDE). This arrangement is largely used in mechanistic studies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09124 goldbook:09140)
AnnotationAssertion(rdfs:seeAlso goldbook:09124 goldbook:09060)
AnnotationAssertion(mito:isMentionedBy goldbook:09124 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09124 "current"^^xsd:string)
Declaration(Class(goldbook:09125))
AnnotationAssertion(rdfs:label goldbook:09125 "wall-jet electrode")
AnnotationAssertion(dcterms:description goldbook:09125 "A disc electrode with a thin circular jet of fluid impinging on its centre.")
AnnotationAssertion(rdfs:comment goldbook:09125 "The limiting current is given by \\[I_{\\rm{lim}} = 1.59\\ kz Fr^{3/4} d^{-1/2} V_{\\rm{f}}^{3/4} \\upsilon^{-5/12} D^{2/3} c\\] where 1.59 is a numerical factor that arises from the mathematical solution to the convective-diffusion system, \\(k\\) is an empirical factor with values between 0.90 and 0.96, \\(z\\) the electron number of an electrochemical reaction, and \\(F\\) the Faraday constant, \\(r\\) is the radius of the disc electrode (\\(\\rm{cm}\\)), \\(d\\) is the diameter of the impinging jet (\\(\\rm{cm}\\)), \\(V_{\\rm{f}}\\) is the volume flow rate (\\(\\pu{cm3 s-1}\\)), \\(\\nu\\) the kinematic viscosity (\\(\\pu{cm2 s-1}\\)), and \\(D\\) the diffusion coefficient of the electroactive species (\\(\\pu{cm2 s-1}\\)) of concentration \\(c\\) (\\(\\pu{mol cm-3}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09125 "The current is not directly proportional to the electrode area."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09125 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09125 goldbook:09063)
AnnotationAssertion(mito:isMentionedBy goldbook:09125 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09125 "current"^^xsd:string)
Declaration(Class(goldbook:09126))
AnnotationAssertion(rdfs:label goldbook:09126 "chronopotentiometry")
AnnotationAssertion(dcterms:description goldbook:09126 "Potentiometry in which the potential is measured with time following a change in applied current.")
AnnotationAssertion(rdfs:comment goldbook:09126 "The change in applied current is usually a step, but cyclic current reversals or linearly increasing currents are also used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09126 goldbook:09127)
AnnotationAssertion(mito:isMentionedBy goldbook:09126 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09126 "current"^^xsd:string)
Declaration(Class(goldbook:09127))
AnnotationAssertion(rdfs:label goldbook:09127 "potentiometry")
AnnotationAssertion(dcterms:description goldbook:09127 "Electrochemical measurement principle where the potential difference between an indicator electrode and a reference electrode is measured.")
AnnotationAssertion(rdfs:comment goldbook:09127 "For measurements using ion-selective electrodes, the measurement is made under equilibrium conditions what means that the macroscopic electric current is zero and the concentrations of all species are uniform throughout the solution. The indicator electrode is in direct contact with the analyte solution, whereas the reference electrode is usually separated from the analyte solution by a salt bridge. The potential difference between the indicator and reference electrodes is normally directly proportional to the logarithm of the activity (concentration) of the analyte in the solution (Nernst equation)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09127 goldbook:09068)
AnnotationAssertion(rdfs:seeAlso goldbook:09127 goldbook:09080)
AnnotationAssertion(mito:isMentionedBy goldbook:09127 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09127 "current"^^xsd:string)
Declaration(Class(goldbook:09128))
AnnotationAssertion(rdfs:label goldbook:09128 "amperometry")
AnnotationAssertion(dcterms:description goldbook:09128 "Electrochemical measurement principle based on measurement of current at a controlled applied potential.")
AnnotationAssertion(rdfs:comment goldbook:09128 "The current is usually faradaic and the applied potential is usually constant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09128 "Amperometry can be distinguished from voltammetry by the parameter being controlled (electrode potential \\(E\\)) and the parameter being measured (electrode current \\(I\\) which is usually a function of time - see chronoamperometry)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09128 "In a non-stirred solution, a diffusion-limited current is usually measured, which is proportional to the concentration of an electroactive analyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09128 "The integral of current with time is the electric charge, which may be related to the amount of substance reacted by Faraday’s laws of electrolysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09128 goldbook:09075)
AnnotationAssertion(rdfs:seeAlso goldbook:09128 goldbook:09129)
AnnotationAssertion(rdfs:seeAlso goldbook:09128 goldbook:09148)
AnnotationAssertion(mito:isMentionedBy goldbook:09128 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09128 "current"^^xsd:string)
Declaration(Class(goldbook:09129))
AnnotationAssertion(rdfs:label goldbook:09129 "chronoamperometry")
AnnotationAssertion(dcterms:description goldbook:09129 "Amperometry in which the current is measured as a function of time after a change in the applied potential.")
AnnotationAssertion(rdfs:comment goldbook:09129 "If the potential step is from a potential at which no current flows (i.e., at which the oxidation or reduction of the electrochemically active species does not take place) to one at which the current is limited by diffusion (see diffusion-limited current), the current obeys the Cottrell equation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09129 goldbook:09128)
AnnotationAssertion(rdfs:seeAlso goldbook:09129 goldbook:09069)
AnnotationAssertion(mito:isMentionedBy goldbook:09129 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09129 "current"^^xsd:string)
Declaration(Class(goldbook:09130))
AnnotationAssertion(rdfs:label goldbook:09130 "AC voltammetry")
AnnotationAssertion(dcterms:description goldbook:09130 "Voltammetry in which a sinusoidal alternating potential of small amplitude (\\(\\pu{10 to 50 mV}\\)) of constant frequency (\\(\\pu{10 Hz to 100 kHz}\\)) is superimposed on a slowly and linearly varying potential ramp. The resulting alternating current is plotted versus imposed DC potential. The obtained AC voltammogram is peak-shaped.Waveform for AC voltammetry. The applied potential as a function of time is a sinusoidal alternating potential superimposed on a linearly increasing ramp.")
AnnotationAssertion(rdfs:comment goldbook:09130 "The phase angle between the alternating current and imposed DC potential is measured in the case of AC voltammetry with phase detection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09130 "In cyclic AC voltammetry, a reverse potential scan is added to the usual forward potential scan."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09130 goldbook:09148)
AnnotationAssertion(mito:isMentionedBy goldbook:09130 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09130 "current"^^xsd:string)
Declaration(Class(goldbook:09131))
AnnotationAssertion(rdfs:label goldbook:09131 "chronocoulometric constant")
AnnotationAssertion(dcterms:description goldbook:09131 "Empirically-determined quantity defined by the equation \\[{\\cal Q} = (1/Ac)\\Delta Q/\\Delta (t^{1/2})\\] where \\(A\\) is the electrode surface area, \\(c\\) is the bulk concentration of the electroactive substance, \\(Q\\) is the charge passed, and \\(\\Delta Q/\\Delta(t^{1/2})\\) is the slope of a plot of \\(Q\\) against \\(t^{1/2}\\).")
AnnotationAssertion(rdfs:comment goldbook:09131 "The SI unit of \\(\\cal Q\\) is \\(\\pu{A s^{1/2} mol-1 m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09131 goldbook:09074)
AnnotationAssertion(mito:isMentionedBy goldbook:09131 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09131 "current"^^xsd:string)
Declaration(Class(goldbook:09132))
AnnotationAssertion(rdfs:label goldbook:09132 "chronopotentiometric constant")
AnnotationAssertion(dcterms:description goldbook:09132 "Empirically-evaluated quantity defined by the equation \\[{\\cal T} = I\\tau^{1/2}/(A c_{B}) = j\\tau^{1/2}/c_{\\ce{B}}\\] where \\(I\\) is the electric current, \\(\\tau\\) is the transition time, \\(A\\) is the electrode surface area, \\(\\ce{B}\\) is the bulk concentration of the electroactive substance \\(\\ce{B}\\), and \\(j=I/A\\) is the current density.")
AnnotationAssertion(rdfs:comment goldbook:09132 "The SI unit of \\(\\cal T\\) is \\(\\pu{A s^{1/2} mol-1 m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09132 goldbook:09074)
AnnotationAssertion(mito:isMentionedBy goldbook:09132 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09132 "current"^^xsd:string)
Declaration(Class(goldbook:09133))
AnnotationAssertion(rdfs:label goldbook:09133 "current sampling")
AnnotationAssertion(dcterms:description goldbook:09133 "Measurement of electric current in voltammetry.")
AnnotationAssertion(rdfs:comment goldbook:09133 "The usual objective is to minimise the sampling time. With modern instrumentation, the interval depends on the speed of a sample-and-hold device coupled with analog-to-digital (A-to-D) conversion."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09133 goldbook:09148)
AnnotationAssertion(mito:isMentionedBy goldbook:09133 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09133 "current"^^xsd:string)
Declaration(Class(goldbook:09134))
AnnotationAssertion(rdfs:label goldbook:09134 "cyclic voltammetry")
AnnotationAssertion(dcterms:description goldbook:09134 "Voltammetry in which the electric current is recorded as the electrode potential is varied with time cyclically between two potential limits, normally at a constant scan rate.Cyclic voltammetry. (a) Variation of applied potential with time. (b) Cyclic voltammogram of current against applied potential for a reversible redox couple.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09134 "CV")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09134 "cyclic linear scan voltammetry")
AnnotationAssertion(rdfs:comment goldbook:09134 "The initial potential is usually the negative or positive limit of the cycle but can have any value between the two limits, as can the initial scan direction. The limits of the potential are known as the switching potentials. See figure a."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09134 "Normally the initial potential is chosen where no electrode reaction occurs and the switching potential is greater (more positive for an oxidation or more negative for a reduction) than the peak potential of the analyte reaction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09134 "The plot of current against potential is termed a cyclic voltammogram. Usually peak-shaped responses are obtained for scans in both directions. See figure b."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09134 "Cyclic voltammetry is frequently used for the investigation of mechanisms of electrochemical/electrode reactions. The current-potential curve may be modelled to obtain reaction mechanisms and electrochemical parameters."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09134 goldbook:09148)
AnnotationAssertion(rdfs:seeAlso goldbook:09134 goldbook:09146)
AnnotationAssertion(rdfs:seeAlso goldbook:09134 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09134 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09134 "current"^^xsd:string)
Declaration(Class(goldbook:09135))
AnnotationAssertion(rdfs:label goldbook:09135 "DC polarography")
AnnotationAssertion(dcterms:description goldbook:09135 "Linear scan voltammetry with slow scan rate in which a dropping mercury electrode is used as the working electrode. See figure.Electric current as a function of applied potential for DC polarography, showing oscillations of current as the dropping mercury electrode grows and is detached.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09135 "classical polarography")
AnnotationAssertion(rdfs:comment goldbook:09135 "This is the oldest variant of polarographic techniques, introduced by Jaroslav Heyrovský (1890–1967)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09135 "Usually the drop time is between 1 and \\(\\pu{5 s}\\) and the pseudo-steady-state wave-shaped dependence on potential is called a polarogram. If the limiting current is controlled by diffusion, it is expressed by the Ilkovič equation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09135 "If the whole scan is performed on a single growing drop, the technique should be called single drop scan voltammetry. The term polarography in this context is discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09135 goldbook:09139)
AnnotationAssertion(rdfs:seeAlso goldbook:09135 goldbook:09103)
AnnotationAssertion(rdfs:seeAlso goldbook:09135 goldbook:09148)
AnnotationAssertion(mito:isMentionedBy goldbook:09135 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09135 "current"^^xsd:string)
Declaration(Class(goldbook:09136))
AnnotationAssertion(rdfs:label goldbook:09136 "differential pulse voltammetry")
AnnotationAssertion(dcterms:description goldbook:09136 "Voltammetry in which small potential pulses (constant height \\(\\pu{10 to 100 mV}\\), constant width \\(\\pu{10 to 100 ms}\\)) are superimposed onto a linearly varying potential or onto a staircase potential ramp. The current is sampled just before the onset of the pulse (e.g. \\(\\pu{10 to 20 ms}\\)) and for the same sampling time just before the end of the pulse. The difference between the two sampled currents is plotted versus the potential applied before the pulse. Thus, a differential pulse voltammogram is peak-shaped.(a) Potential waveform for differential pulse voltammetry (not to scale). Typical values for pulse parameters are $\\tau$=1 s, $t_{\\rm{p}}$=50 ms, $E_{\\tau}$=50 mV, $E_{\\rm{p}}$=2 mV. Sampling interval indicated by horizontal curly brackets is typically 15 ms. (b) Differential pulse voltammogram. $I$ is the difference between currents sampled at ‘2’ and ‘1’.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09136 "DPV")
AnnotationAssertion(rdfs:comment goldbook:09136 "The ratio of faradaic current to charging current is enhanced and the negative influence of charging current is partially eliminated in the same way as in normal pulse voltammetry (NPV). Moreover, subtraction of the charging current sampled before the application of the pulse further decreases its negative influence. Due to the more enhanced signal (faradaic current) to noise (charging current) ratio, the limit of detection is lower than with NPV. See figure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09136 "The sensitivity of DPV depends on the reversibility of the electrode reaction of the analyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09136 "Differential pulse polarography is differential pulse voltammetry in which a dropping mercury electrode is used as the working electrode. A pulse is applied before the mechanically enforced end of the drop and the current is sampled twice: just before the onset of the pulse and just before its end. The pulse width is usually \\(\\pu{10 to 20\\%}\\) of the drop life. The drop dislodgement is synchronized with current sampling, which is carried out as in DPV."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09136 goldbook:09148)
AnnotationAssertion(rdfs:seeAlso goldbook:09136 goldbook:09103)
AnnotationAssertion(rdfs:seeAlso goldbook:09136 goldbook:09142)
AnnotationAssertion(mito:isMentionedBy goldbook:09136 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09136 "current"^^xsd:string)
Declaration(Class(goldbook:09137))
AnnotationAssertion(rdfs:label goldbook:09137 "Heyrovský–Ilkovič equation")
AnnotationAssertion(dcterms:description goldbook:09137 "The relationship that describes the electrode potential as a function of the current of a reversible redox system (reversible electrode reaction) in the steady state in voltammetry \\[E = E^{\\circ\\prime} - \\frac{RT}{zF} \\ln \\left(\\frac{D_{\\rm{red}}}{D_{\\rm{ox}}}\\right)^{s} \\pm \\frac{RT}{zF} \\ln\\!\\left(\\frac{I_{\\rm{d,lim}} - I}{I}\\right)\\] where \\(E^{\\circ\\prime}\\) is the formal electrode potential, \\(z\\) the electron number of an electrochemical reaction, \\(D_{\\rm{red}}\\) and \\(D_{\\rm{ox}}\\) the diffusion coefficients of the reduced and oxidized forms of the electroactive substance, respectively, \\(I_{\\rm{d,lim}}\\) is the limiting diffusion current, and \\(I\\) is the current at the potential being applied. The value of the exponent \\(s\\) is ½ for a stationary or dropping mercury electrode, ⅔ for a hydrodynamic electrode (see hydrodynamic voltammetry), or 1 for a microelectrode. In the equation, the last term is added for reduction and subtracted for oxidation.")
AnnotationAssertion(rdfs:comment goldbook:09137 "The equation is named after Jaroslav Heyrovský (1890–1967) and Dionýz Ilkovič (1907–1980)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09137 goldbook:09103)
AnnotationAssertion(rdfs:seeAlso goldbook:09137 goldbook:09063)
AnnotationAssertion(rdfs:seeAlso goldbook:09137 goldbook:09065)
AnnotationAssertion(rdfs:seeAlso goldbook:09137 goldbook:09138)
AnnotationAssertion(rdfs:seeAlso goldbook:09137 goldbook:09084)
AnnotationAssertion(mito:isMentionedBy goldbook:09137 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09137 "current"^^xsd:string)
Declaration(Class(goldbook:09138))
AnnotationAssertion(rdfs:label goldbook:09138 "hydrodynamic voltammetry")
AnnotationAssertion(dcterms:description goldbook:09138 "Voltammetry with forced flow of the solution towards the electrode surface.")
AnnotationAssertion(rdfs:comment goldbook:09138 "Mass transport of a redox species enhanced by convection in this way results in a greater electric current. Convective mass transfer occurs up to the diffusion-limiting layer, within which the mass transfer is controlled by diffusion. Electroactive substance depletion outside the diffusion layer is annulled by convective mass transfer, which results in steady-state sigmoidal wave-shaped current-potential curves."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09138 "A linear potential scan, at sufficiently slow scan rates so as to ensure a steady state response, is usually applied."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09138 "The forced flow can be accomplished by movement either of the solution (solution stirring, or channel flow), or of the electrode (electrode rotation or vibration)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09138 goldbook:09140)
AnnotationAssertion(rdfs:seeAlso goldbook:09138 goldbook:09148)
AnnotationAssertion(rdfs:seeAlso goldbook:09138 goldbook:09070)
AnnotationAssertion(rdfs:seeAlso goldbook:09138 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09138 goldbook:09124)
AnnotationAssertion(mito:isMentionedBy goldbook:09138 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09138 "current"^^xsd:string)
Declaration(Class(goldbook:09139))
AnnotationAssertion(rdfs:label goldbook:09139 "Ilkovič equation")
AnnotationAssertion(dcterms:description goldbook:09139 "Equation relating electric current at a dropping mercury electrode under purely diffusional control, \\(I_{{\\rm{d,}}t}\\), the amount concentration of an electroactive substance at the drop surface \\(c\\), and the concentration in bulk solution \\(c_{\\rm{0}}\\), \\[I_{{\\rm{d}},t} = -k\\,z\\,F\\,D^{1/2}q_{\\rm{m}}^{2/3} t^{1/6}(c - c_{0})\\] where \\(k\\) is a numerical constant, $z$ the electron number of an electrochemical reaction, \\(F\\) the Faraday constant, \\(D\\) the diffusion coefficient of the electroactive substance, \\(q_{\\rm{m}}\\) the mass flux of mercury at the dropping electrode, and \\(t\\) the time elapsed from the beginning of the drop.")
AnnotationAssertion(rdfs:comment goldbook:09139 "At sufficiently large overpotentials, the surface concentration \\(c\\) will fall to zero, giving a limiting diffusion current. \\[I_{\\rm{d,lim}} = k\\,z\\,F\\,D^{1/2} q_{\\rm{m}}^{2/3} t^{1/6} c_{0}\\] Mostly, the average current (averaged over drop time and thus drop size) is calculated, when \\(t\\) becomes the drop time \\(t_{\\rm{d}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09139 "The value of \\(k\\) depends on the units used for quantities in the equation (\\(D\\), \\(q_{\\rm{m}}\\), \\(t\\), \\(c\\)), and whether the limiting current or the current averaged over the life of a drop is calculated. For \\(D\\) in \\(\\pu{cm2 s-1}\\), \\(q_{\\rm{m}}\\) in \\(\\pu{g s-1}\\), \\(t\\) in \\(s\\), and \\(c\\) in \\(\\pu{mol cm-3}\\), the constant \\(k\\) is 708 (limiting current in \\(\\pu{A}\\)) and 607 (average current in \\(\\pu{A}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09139 goldbook:09103)
AnnotationAssertion(rdfs:seeAlso goldbook:09139 goldbook:09063)
AnnotationAssertion(rdfs:seeAlso goldbook:09139 goldbook:09144)
AnnotationAssertion(mito:isMentionedBy goldbook:09139 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09139 "current"^^xsd:string)
Declaration(Class(goldbook:09140))
AnnotationAssertion(rdfs:label goldbook:09140 "Levich equation")
AnnotationAssertion(dcterms:description goldbook:09140 "Equation relating limiting current at a rotating disc electrode (see hydrodynamic voltammetry) to the amount concentration of an electroactive substance in bulk solution \\(c_{0}\\), \\[I_{\\rm{lim}} = k\\,z\\,F\\,A\\,D^{2/3} \\omega^{1/2}  u^{−1/6} c_{0}\\] where \\(k\\) is a numerical factor, \\(z\\) the electron number of an electrochemical reaction, \\(F\\) the Faraday constant, \\(A\\) the electrode surface area, \\(D\\) the diffusion coefficient of the electroactive substance, \\(\\omega\\) the angular velocity (rotation rate), and \\( u\\) the kinematic viscosity of the solution.")
AnnotationAssertion(rdfs:comment goldbook:09140 "The value of \\(k\\) depends on the units used for quantities in the equation (\\(D\\), \\(A\\), \\(\\omega\\), \\(\\nu\\), \\(c\\)), and is 1.554 for \\(A\\) in \\(\\pu{cm2}\\), \\(D\\) in \\(\\pu{cm2 s-1}\\), \\(\\omega\\) in \\(\\pu{Hz}\\), \\(\\nu\\) in \\(\\pu{cm2 s-1}\\), \\(c_{0}\\) in \\(\\pu{mol cm-3}\\), and \\(I_{\\rm{lim}}\\) in \\(\\pu{A}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09140 "The equation is named after Veniamin Grigorievich Levich (1917–1987)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09140 goldbook:09074)
AnnotationAssertion(rdfs:seeAlso goldbook:09140 goldbook:09063)
AnnotationAssertion(rdfs:seeAlso goldbook:09140 goldbook:09138)
AnnotationAssertion(rdfs:seeAlso goldbook:09140 goldbook:09124)
AnnotationAssertion(mito:isMentionedBy goldbook:09140 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09140 "current"^^xsd:string)
Declaration(Class(goldbook:09141))
AnnotationAssertion(rdfs:label goldbook:09141 "linear-scan voltammetry")
AnnotationAssertion(dcterms:description goldbook:09141 "Voltammetry in which the electric current is recorded as the electrode potential is varied linearly with time. See figure.Linear scan voltammogram of current against applied potential for a reversible redox couple.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09141 "LSV")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09141 "linear-sweep voltammetry")
AnnotationAssertion(rdfs:comment goldbook:09141 "The peak current is expressed by the Randles–Ševčík equation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09141 "The scan is usually started at a potential where no electrode reaction occurs."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09141 "LSV corresponds to the first half cycle of cyclic voltammetry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09141 goldbook:09143)
AnnotationAssertion(rdfs:seeAlso goldbook:09141 goldbook:09148)
AnnotationAssertion(rdfs:seeAlso goldbook:09141 goldbook:09134)
AnnotationAssertion(rdfs:seeAlso goldbook:09141 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09141 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09141 "current"^^xsd:string)
Declaration(Class(goldbook:09142))
AnnotationAssertion(rdfs:label goldbook:09142 "normal pulse voltammetry")
AnnotationAssertion(dcterms:description goldbook:09142 "Voltammetry in which potential pulses of amplitude increasing by a constant increment and with a pulse width of \\(\\pu{2 to 200 ms}\\) are superimposed on a constant initial potential. The current is sampled at the end of the pulse and then plotted versus the potential of the pulse. Sigmoidal wave-shaped voltammograms are obtained. See figure.(a) Waveform for normal pulse voltammetry (not to scale). Typical values for pulse parameters are \\(\\tau = \\pu{1 s}\\), \\(t_{\\rm{p}} = \\pu{50 ms}\\), \\(E_{\\rm{p}} = \\pu{2 mV}\\), \\(E_{\\rm{step}} = \\pu{2 mV}\\). Sampling interval indicated by horizontal curly brackets is typically \\(\\pu{15 ms}\\). (b) Normal pulse voltammogram.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09142 "NPV")
AnnotationAssertion(rdfs:comment goldbook:09142 "The current is sampled just before the end of the pulse, when the charging current is greatly diminished. In this way, the ratio of faradaic current to charging current is enhanced and the negative influence of charging current is partially eliminated. Due to the improved signal (faradaic current) to noise (charging current) ratio, the limit of detection is lowered."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09142 "The sensitivity of NPV is not affected by the reversibility of the electrode reaction of the analyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09142 "Normal pulse polarography is NPV in which a dropping mercury electrode is used as the working electrode. A pulse is applied just before the mechanically enforced end of the drop. The pulse width is usually \\(\\pu{10 to 20\\%}\\) of the drop time. The drop dislodgment is synchronized with current sampling, which is carried out just before the end of the pulse, as in NPV."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09142 goldbook:09148)
AnnotationAssertion(rdfs:seeAlso goldbook:09142 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09142 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09142 "current"^^xsd:string)
Declaration(Class(goldbook:09143))
AnnotationAssertion(rdfs:label goldbook:09143 "Randles–Ševčík equations")
AnnotationAssertion(dcterms:description goldbook:09143 "Equations describing the peak current \\(I_{\\rm{p}}\\) in linear scan voltammetry and cyclic voltammetry as a function of the amount concentration, \\(c_{\\rm{0}}\\), of electroactive species in bulk solution. For a reversible charge transfer: \\[I_{\\rm{p,rev}} = k\\,z\\,F\\,A\\,c_0 (z\\,F\\,D u/RT)^{1/2}\\] for irreversible charge transfer: \\[I_{\\rm{p,irrev}} = k^{\\prime}(\\alpha z^{\\prime})^{1/2} zFA{c_0}(FD u/RT)^{1/2}\\] where \\(k\\) and \\(k^{\\prime}\\) are numerical constants, \\(\\alpha\\) is the charge transfer coefficient (usually assumed to be close to 0.5), \\(z\\) the electron number of an electrochemical reaction, \\(z^{\\prime}\\) the number of electrons transferred before the rate determining step, \\(F\\) the Faraday constant, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(A\\) the electrode surface area, \\(D\\) the diffusion coefficient, and \\( u\\) the scan rate.")
AnnotationAssertion(rdfs:comment goldbook:09143 "For \\(A\\) in \\(\\pu{cm2}\\), \\(D\\) in \\(\\pu{cm2 s-1}\\), \\(\\nu\\) in \\(\\pu{cm2 s-1}\\), and \\(c_{0}\\) in \\(\\pu{mol cm-3}\\), and \\(I_{\\rm{p}}\\) in \\(A\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09143 "At \\(T = \\pu{298.15 K}\\), for reversible charge transfer \\(k = 0.446\\), and for irreversible charge transfer, \\(k^{\\prime} = 0.496\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09143 goldbook:09134)
AnnotationAssertion(rdfs:seeAlso goldbook:09143 goldbook:09063)
AnnotationAssertion(rdfs:seeAlso goldbook:09143 goldbook:09141)
AnnotationAssertion(mito:isMentionedBy goldbook:09143 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09143 "current"^^xsd:string)
Declaration(Class(goldbook:09144))
AnnotationAssertion(rdfs:label goldbook:09144 "rate of flow of liquid metal in polarography")
AnnotationAssertion(dcterms:description goldbook:09144 "Mass of a drop of liquid metal in polarography at the instant when it is detached from the tip of the capillary divided by the drop time \\(t_{\\rm{d}}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09144 "mass flux")
AnnotationAssertion(rdfs:comment goldbook:09144 "The liquid is usually mercury."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09144 goldbook:09135)
AnnotationAssertion(mito:isMentionedBy goldbook:09144 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09144 "current"^^xsd:string)
Declaration(Class(goldbook:09145))
AnnotationAssertion(rdfs:label goldbook:09145 "sampled DC polarography")
AnnotationAssertion(dcterms:description goldbook:09145 "DC polarography with current sampling at the end of each drop life mechanically enforced by a knocker at a preset drop time value. The current sampling and mechanical drop dislodge are synchronized.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09145 "TAST polarography")
AnnotationAssertion(rdfs:comment goldbook:09145 "In this way, the ratio of faradaic current to double layer charging current is enhanced and the negative influence of charging current is partially eliminated. Due to the improved signal (faradaic current) to noise (charging current) ratio, the limit of detection is lowered."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09145 goldbook:09135)
AnnotationAssertion(rdfs:seeAlso goldbook:09145 goldbook:09133)
AnnotationAssertion(mito:isMentionedBy goldbook:09145 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09145 "current"^^xsd:string)
Declaration(Class(goldbook:09146))
AnnotationAssertion(rdfs:label goldbook:09146 "scan rate")
AnnotationAssertion(dcterms:description goldbook:09146 "The rate of change of applied potential with time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09146 "potential scan rate")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09146 "potential sweep rate")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09146 "sweep rate")
AnnotationAssertion(rdfs:comment goldbook:09146 "Scan rate has SI unit \\(\\pu{V s-1}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09146 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09146 "current"^^xsd:string)
Declaration(Class(goldbook:09147))
AnnotationAssertion(rdfs:label goldbook:09147 "square-wave voltammetry")
AnnotationAssertion(dcterms:description goldbook:09147 "Voltammetry in which a square-wave potential waveform is superimposed on an underlying linearlyhyphen‐varying potential ramp or staircase ramp. The current is sampled just before the end of the forward-going pulse and of the backward-going pulse and the difference of the two sampled currents is plotted versus the applied potential of the potential or staircase ramp. The square-wave voltammogram is peak-shaped. See figure.(a) Waveform for square wave voltammetry (not to scale). Typical values for pulse parameters are \\(\\tau = \\pu{10 ms}\\), \\(t_{\\rm{p}} = \\pu{5 ms}\\), \\(E_{\\rm{\\tau}} = \\pu{25 mV}\\), \\(E_{\\rm{step}} = \\pu{4 mV}\\). Sampling interval indicated by horizontal curly brackets is typically \\(\\pu{1 ms}\\). (b) Square wave voltammogram of the difference between currents sampled at ‘2’ and ‘1’ against applied potential.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09147 "SWV")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09147 "Osteryoung square-wave voltammetry (OSWV)")
AnnotationAssertion(rdfs:comment goldbook:09147 "The sensitivity of SWV depends on the reversibility of the electrode reaction of the analyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09147 "Most instruments show plots of the current at the end of the forward-going pulse and of the backward-going pulse vs. the potential, as well as their difference. This can give valuable information on the kinetics of the electrode reaction and the electrode process."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09147 goldbook:09148)
AnnotationAssertion(rdfs:seeAlso goldbook:09147 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09147 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09147 "current"^^xsd:string)
Declaration(Class(goldbook:09148))
AnnotationAssertion(rdfs:label goldbook:09148 "voltammetry")
AnnotationAssertion(dcterms:description goldbook:09148 "Electrochemical measurement principle in which the electrode potential of a working electrode is controlled and the electric current measured.")
AnnotationAssertion(mito:isMentionedBy goldbook:09148 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09148 "current"^^xsd:string)
Declaration(Class(goldbook:09149))
AnnotationAssertion(rdfs:label goldbook:09149 "voltammogram")
AnnotationAssertion(dcterms:description goldbook:09149 "Current-potential curve in a voltammetry experiment.")
AnnotationAssertion(rdfs:seeAlso goldbook:09149 goldbook:09070)
AnnotationAssertion(rdfs:seeAlso goldbook:09149 goldbook:09147)
AnnotationAssertion(rdfs:seeAlso goldbook:09149 goldbook:09148)
AnnotationAssertion(mito:isMentionedBy goldbook:09149 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09149 "current"^^xsd:string)
Declaration(Class(goldbook:09150))
AnnotationAssertion(rdfs:label goldbook:09150 "accumulation in stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09150 "Transfer of an analyte from a test solution to an electrode surface as the first step in stripping voltammetry.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09150 "accumulation")
AnnotationAssertion(rdfs:comment goldbook:09150 "Analyte accumulation can be achieved by the following methods:electrodeposition of metal atoms onto a solid electrode,reduction of metal ions on a mercury electrode and dissolution of the formed metal atoms in the mercury (amalgam formation),precipitation of sparingly soluble mercuric, mercurous, or silver salts on mercury or silver electrodes,precipitation of metal oxides, hydroxides, or other insoluble salts on an inert (usually noble metal or carbon) electrode,chemical reaction of an analyte with an electrode material,adsorption of electroactive organic substances,adsorption of complexes of metal ions with organic ligands,synergistic adsorption of complexes,anion-induced adsorption of metal ions,surface complexation of metal ions,ion-exchange reactions at surface-modified electrodes,extraction by ion transfer across the interface of two immiscible electrolyte solutions,(m) reaction by biological recognition processes involving nucleic acids, antibodies, enzymes, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09150 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09150 goldbook:09155)
AnnotationAssertion(mito:isMentionedBy goldbook:09150 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09150 "current"^^xsd:string)
Declaration(Class(goldbook:09151))
AnnotationAssertion(rdfs:label goldbook:09151 "adsorptive stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09151 "Stripping voltammetry involving pre-concentration by adsorption of the analyte (in contrast to electrochemical accumulation).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09151 "AdSV")
AnnotationAssertion(rdfs:comment goldbook:09151 "AdSV is usually employed for analysis of organic compounds or metal complexes with organic ligands. Stripping is done by means of an anodic or a cathodic voltammetric scan (linear or pulse), during which the adsorbed compound is oxidized or reduced."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09151 "A peak-shaped adsorptive stripping voltammogram is obtained. Peak current depends on time of accumulation, mass transport of analyte (stirring), scan rate and mode (linear or pulse), and analyte concentration in solution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09151 goldbook:09155)
AnnotationAssertion(rdfs:seeAlso goldbook:09151 goldbook:09150)
AnnotationAssertion(rdfs:seeAlso goldbook:09151 goldbook:09146)
AnnotationAssertion(rdfs:seeAlso goldbook:09151 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09151 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09151 "current"^^xsd:string)
Declaration(Class(goldbook:09152))
AnnotationAssertion(rdfs:label goldbook:09152 "anodic stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09152 "Stripping voltammetry in which material accumulated at the working electrode is electrochemically oxidized in the stripping step.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09152 "ASV")
AnnotationAssertion(rdfs:comment goldbook:09152 "A peak-shaped anodic stripping voltammogram is obtained. Peak current depends on time of accumulation, mass transport of analyte (stirring), scan rate and mode (linear or pulse), and analyte concentration in solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09152 "A solid electrode (see metal electrode), carbon paste or composite electrode, bismuth film electrode, mercury film electrode, or static mercury drop electrode (see mercury electrode) may be used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09152 goldbook:09155)
AnnotationAssertion(rdfs:seeAlso goldbook:09152 goldbook:09150)
AnnotationAssertion(rdfs:seeAlso goldbook:09152 goldbook:09096)
AnnotationAssertion(rdfs:seeAlso goldbook:09152 goldbook:09102)
AnnotationAssertion(rdfs:seeAlso goldbook:09152 goldbook:09146)
AnnotationAssertion(rdfs:seeAlso goldbook:09152 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09152 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09152 "current"^^xsd:string)
Declaration(Class(goldbook:09153))
AnnotationAssertion(rdfs:label goldbook:09153 "cathodic stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09153 "Stripping voltammetry in which material accumulated at the working electrode is electrochemically reduced in the stripping step. See figure.Applied potential against time during the accumulation and stripping steps in cathodic stripping voltammetry.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09153 "CSV")
AnnotationAssertion(rdfs:comment goldbook:09153 "A peak-shaped cathodic stripping voltammogram is obtained. Peak current depends on time of accumulation, mass transport of analyte (stirring), scan rate and mode (linear or pulse), and analyte concentration in solution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09153 goldbook:09155)
AnnotationAssertion(rdfs:seeAlso goldbook:09153 goldbook:09150)
AnnotationAssertion(rdfs:seeAlso goldbook:09153 goldbook:09146)
AnnotationAssertion(rdfs:seeAlso goldbook:09153 goldbook:09149)
AnnotationAssertion(mito:isMentionedBy goldbook:09153 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09153 "current"^^xsd:string)
Declaration(Class(goldbook:09154))
AnnotationAssertion(rdfs:label goldbook:09154 "potentiometric stripping analysis")
AnnotationAssertion(dcterms:description goldbook:09154 "Two-step electrochemical measurement in which 1) material is accumulated at an electrode and 2) the material is removed by chemical reaction or electrochemically at constant current with measurement of electrode potential. The time between changes in potential in step two is related to the concentration of analyte in the solution.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09154 "PSA")
AnnotationAssertion(rdfs:comment goldbook:09154 "The accumulation is similar to that used in stripping voltammetry."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09154 "The stripping potentiogram shows staircase curves of potential as a function of time. Frequently, the first derivative is displayed (\\({\\rm{d}}E/{\\rm{d}}t = f(t)\\)), as this produces peak-shaped signals. The time between transitions (peaks) is proportional to the concentration of analyte in the test solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09154 "Historically for the analysis of metal ions, mercury ions were added to the test solution to form a mercury amalgam when reduced. Alternatively, a hanging mercury drop electrode (HMDE) or mercury film electrode (MFE) was used and the oxidizing agent added after amalgam formation. However, the toxicity of mercury and its compounds have all but precluded the present-day use of mercury."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09154 goldbook:09150)
AnnotationAssertion(rdfs:seeAlso goldbook:09154 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09154 goldbook:09103)
AnnotationAssertion(rdfs:seeAlso goldbook:09154 goldbook:09102)
AnnotationAssertion(rdfs:seeAlso goldbook:09154 goldbook:09155)
AnnotationAssertion(mito:isMentionedBy goldbook:09154 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09154 "current"^^xsd:string)
Declaration(Class(goldbook:09155))
AnnotationAssertion(rdfs:label goldbook:09155 "stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09155 "Two-step electrochemical measurement in which 1) material is accumulated at an electrode and 2) the amount of an accumulated species is measured by voltammetry. The measured electric current in step 2 is related to the concentration of analyte in the solution by calibration.")
AnnotationAssertion(rdfs:comment goldbook:09155 "Types of stripping voltammetry refer to the kind of accumulation (e.g. adsorptive stripping voltammetry) or the polarity of the stripping electrochemistry (anodic, cathodic stripping voltammetry)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09155 "Stripping voltammetry is a calibrated method to establish the relation between amount accumulated in a given time and the concentration of the analyte in solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09155 "Because the accumulation (pre-concentration) step can be prolonged, increasing the amount of material at the electrode, stripping voltammetry is able to measure very small concentrations of analyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09155 "Often the product of the electrochemical stripping is identical to the analyte before the accumulation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09155 "Anodic stripping voltammetry (ASV) was historically used to measure concentrations of metal ions in solution using cathodic accumulation with mercury to form an amalgam. Due to the toxicity of mercury and its compounds, inductively coupled plasma optical emission spectrometry and inductively coupled plasma mass spectrometry have frequently replaced ASV at mercury electrodes in the laboratory, often sacrificing the probing of speciation and lability in complex matrices. Mercury has now been replaced by non-toxic bismuth or antimony as films on a solid electrode support (such as glassy carbon) with equally good sensitivity and detection limits."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09155 goldbook:09150)
AnnotationAssertion(rdfs:seeAlso goldbook:09155 goldbook:09151)
AnnotationAssertion(rdfs:seeAlso goldbook:09155 goldbook:09152)
AnnotationAssertion(rdfs:seeAlso goldbook:09155 goldbook:09153)
AnnotationAssertion(rdfs:seeAlso goldbook:09155 goldbook:09060)
AnnotationAssertion(rdfs:seeAlso goldbook:09155 goldbook:09148)
AnnotationAssertion(mito:isMentionedBy goldbook:09155 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09155 "current"^^xsd:string)
Declaration(Class(goldbook:09156))
AnnotationAssertion(rdfs:label goldbook:09156 "chronocoulometry")
AnnotationAssertion(dcterms:description goldbook:09156 "Direct coulometry at controlled potential in which the electric charge passed after the application of a potential step perturbation is measured as a function of time (\\(Q{-}t\\) curve).")
AnnotationAssertion(rdfs:comment goldbook:09156 "Chronocoulometry provides the same information that is provided by chronoamperometry, since it is based on the integration of the \\(I{-}t\\) curve. Nevertheless, chronocoulometry offers important experimental advantages, such as (i) the measured signal usually increases with time and hence the later parts of the transient can be detected more accurately, (ii) a better signal-to-noise ratio can be achieved, and (iii) other contributions to overall charge passed as a function of time can be discriminated from those due to the diffusion of electroactive substances."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09156 goldbook:09161)
AnnotationAssertion(rdfs:seeAlso goldbook:09156 goldbook:09129)
AnnotationAssertion(mito:isMentionedBy goldbook:09156 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09156 "current"^^xsd:string)
Declaration(Class(goldbook:09157))
AnnotationAssertion(rdfs:label goldbook:09157 "coulometer")
AnnotationAssertion(dcterms:description goldbook:09157 "Measuring instrument to obtain the electrical charge passed in an experiment, or to produce a known amount of substance in a titration.")
AnnotationAssertion(rdfs:comment goldbook:09157 "The silver coulometer is a primary reference measurement procedure for charge and current. By weighing the mass of silver deposited in a known time at constant current, the charge and current are calculated from Faraday’s laws of electrolysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09157 "Modern instruments for measuring trace water by Karl Fischer titration use the passage of a measured charge to produce iodine from iodide solution. They are known as Karl Fischer coulometers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09157 goldbook:09075)
AnnotationAssertion(rdfs:seeAlso goldbook:09157 goldbook:09158)
AnnotationAssertion(mito:isMentionedBy goldbook:09157 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09157 "current"^^xsd:string)
Declaration(Class(goldbook:09159))
AnnotationAssertion(rdfs:label goldbook:09159 "coulometry")
AnnotationAssertion(dcterms:description goldbook:09159 "Electrochemical measurement principle in which the electric charge required to carry out a known electrochemical reaction is measured. By Faraday’s laws of electrolysis, the amount of substance is proportional to the charge.")
AnnotationAssertion(rdfs:comment goldbook:09159 "Coulometry used to measure the amount of substance is a primary reference measurement procedure not requiring calibration with a standard for a quantity of the same kind (i.e. amount of substance)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09159 "The coulometric experiment can be carried out at controlled (constant) potential (see direct coulometry at controlled potential) or controlled (constant) current (see direct coulometry at controlled current)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09159 goldbook:09075)
AnnotationAssertion(rdfs:seeAlso goldbook:09159 goldbook:09160)
AnnotationAssertion(rdfs:seeAlso goldbook:09159 goldbook:09161)
AnnotationAssertion(mito:isMentionedBy goldbook:09159 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09159 "current"^^xsd:string)
Declaration(Class(goldbook:09160))
AnnotationAssertion(rdfs:label goldbook:09160 "direct coulometry at controlled current")
AnnotationAssertion(dcterms:description goldbook:09160 "Coulometry at an imposed, constant electric current in the electrochemical cell.")
AnnotationAssertion(rdfs:comment goldbook:09160 "Direct coulometry at controlled current is usually carried out in convective mass transfer mode. The end-point of the electrolysis, at which the current is stopped, must be determined either from the inflection point in the \\(E{-}t\\) curve or by using visual or objective end-point indication, similar to volumetric methods. The total electric charge is calculated as the product of the constant current and time of electrolysis or can be measured directly using a coulometer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09160 "The advantage of this method is that the electric charge consumed during the electrode reaction is directly proportional to the electrolysis time. Care must be taken to avoid the potential region where another electrode reaction may occur."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09160 goldbook:09159)
AnnotationAssertion(rdfs:seeAlso goldbook:09160 goldbook:09157)
AnnotationAssertion(rdfs:seeAlso goldbook:09160 goldbook:09058)
AnnotationAssertion(mito:isMentionedBy goldbook:09160 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09160 "current"^^xsd:string)
Declaration(Class(goldbook:09161))
AnnotationAssertion(rdfs:label goldbook:09161 "direct coulometry at controlled potential")
AnnotationAssertion(dcterms:description goldbook:09161 "Coulometry at a preselected constant potential of the working electrode.Electric current against time showing the representation of the electric charge in direct coulometry at controlled potential as the area under the graph.")
AnnotationAssertion(rdfs:comment goldbook:09161 "Direct coulometry at controlled potential is usually carried out in convective mass transfer mode using a large surface working electrode. Reference electrode and auxiliary electrode are placed in separate compartments. The total electric charge is obtained by integration of the \\(I{-}t\\) curve or can be measured directly using a coulometer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09161 "In principle, the end point at which \\(I = 0\\), i.e. when the concentration of species under study becomes zero, can be reached only at infinite time. However, in practice, the electrolysis is stopped when the current has decayed to a few percent of the initial value and the charge passed at infinite time is calculated from a plot of charge \\(Q(t)\\) against time \\(t\\). For a simple system under diffusion control \\(Q_{t} = Q_{\\infty}[1 - \\exp(-DAt/V\\delta)]\\), where \\(Q_{\\infty} = \\lim_{t \\to \\infty}Q(t)\\) is the total charge passed at infinite time, \\(D\\) is the diffusion coefficient of the electroactive species, \\(A\\) the electrode area, \\(\\delta\\) the diffusion layer thickness, and \\(V\\) the volume of the solution. See figure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09161 goldbook:09159)
AnnotationAssertion(rdfs:seeAlso goldbook:09161 goldbook:09132)
AnnotationAssertion(rdfs:seeAlso goldbook:09161 goldbook:09129)
AnnotationAssertion(rdfs:seeAlso goldbook:09161 goldbook:09156)
AnnotationAssertion(rdfs:seeAlso goldbook:09161 goldbook:09157)
AnnotationAssertion(mito:isMentionedBy goldbook:09161 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09161 "current"^^xsd:string)
Declaration(Class(goldbook:09162))
AnnotationAssertion(rdfs:label goldbook:09162 "electrochemical piezoelectric microgravimetry")
AnnotationAssertion(dcterms:description goldbook:09162 "Electrogravimetry using an electrochemical quartz crystal microbalance.")
AnnotationAssertion(rdfs:comment goldbook:09162 "The change of mass is, for rigid deposits, linearly proportional to the change of the resonance frequency of the quartz crystal, according to the Sauerbrey equation. For non-rigid deposits, corrections must be made."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09162 goldbook:09164)
AnnotationAssertion(rdfs:seeAlso goldbook:09162 goldbook:09163)
AnnotationAssertion(mito:isMentionedBy goldbook:09162 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09162 "current"^^xsd:string)
Declaration(Class(goldbook:09163))
AnnotationAssertion(rdfs:label goldbook:09163 "electrochemical quartz crystal microbalance")
AnnotationAssertion(dcterms:description goldbook:09163 "Electrochemical cell in which the working electrode is located on one surface of a piezoelectric quartz crystal, the oscillation frequency of which is measured.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09163 "EQCM")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09163 "electrochemical quartz crystal nanobalance (EQCN)")
AnnotationAssertion(rdfs:comment goldbook:09163 "The electrode may be chemically modified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09163 "The change in resonant frequency (proportional to mass changes) is measured during electrochemical processes, such as linear scan voltammetry or cyclic voltammetry, giving simultaneous information on changes in mass and charge transfer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09163 goldbook:09058)
AnnotationAssertion(rdfs:seeAlso goldbook:09163 goldbook:09134)
AnnotationAssertion(rdfs:seeAlso goldbook:09163 goldbook:09162)
AnnotationAssertion(rdfs:seeAlso goldbook:09163 goldbook:09141)
AnnotationAssertion(mito:isMentionedBy goldbook:09163 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09163 "current"^^xsd:string)
Declaration(Class(goldbook:09164))
AnnotationAssertion(rdfs:label goldbook:09164 "electrogravimetry")
AnnotationAssertion(dcterms:description goldbook:09164 "Gravimetry in which the material to be weighed is obtained by electrochemical reaction.")
AnnotationAssertion(rdfs:comment goldbook:09164 "The electrolysis can be performed by controlling current or electrode potential or, in the simple two-electrode arrangement, controlling the potential difference between the two electrodes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09164 "When the precipitate has a known stoichiometric composition, electrogravimetry is a primary reference measurement procedure not requiring calibration with a standard for a quantity of the same kind (i.e. amount of substance)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09164 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09164 "current"^^xsd:string)
Declaration(Class(goldbook:09165))
AnnotationAssertion(rdfs:label goldbook:09165 "conductometric titration")
AnnotationAssertion(dcterms:description goldbook:09165 "Titration in which the electric conductivity of a solution is measured as a function of the amount of titrant added.Conductimetric titration curve of conductance ($G$) against volume of titrant. The end-point of the titration is indicated by a change in slope of the graph.")
AnnotationAssertion(rdfs:comment goldbook:09165 "The method is based on replacing an ionic species of the analyte with another species, corresponding to the titrant or the product with significantly different conductance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09165 "The equivalence-point is obtained as the intersection of linear parts of the conductance \\(G\\), versus titrant volume \\(V\\), curve (see figure)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09165 "The method can be used for deeply coloured or turbid solutions. Acid-base and precipitation reactions are most frequently used."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09165 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09165 "current"^^xsd:string)
Declaration(Class(goldbook:09166))
AnnotationAssertion(rdfs:label goldbook:09166 "conductometry")
AnnotationAssertion(dcterms:description goldbook:09166 "Measurement principle in which the electric conductivity of a solution is measured.")
AnnotationAssertion(rdfs:comment goldbook:09166 "The conductivity of a solution depends on the concentration and nature of ions present."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09166 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09166 "current"^^xsd:string)
Declaration(Class(goldbook:09167))
AnnotationAssertion(rdfs:label goldbook:09167 "dielectrometry")
AnnotationAssertion(dcterms:description goldbook:09167 "Electrochemical measurement principle based on the measurement of the dielectric constant of a sample resulting from the orientation of particles (molecules or ions) that have a dipole moment in an electric field.")
AnnotationAssertion(rdfs:comment goldbook:09167 "The method is used to monitor the purity of dielectrics, for example to detect small amounts of moisture."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09167 "Dielectrometric titrations use dielectrometry for the end-point detection."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09167 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09167 "current"^^xsd:string)
Declaration(Class(goldbook:09168))
AnnotationAssertion(rdfs:label goldbook:09168 "electrochemical impedance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09168 "Electrochemical measurement method of the complex impedance of an electrochemical system as a function of the frequency of a small amplitude (normally \\(\\pu{5 to 10 mV}\\)) sinusoidal voltage perturbation superimposed on a fixed value of applied potential or on the open circuit potential.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09168 "EIS")
AnnotationAssertion(rdfs:comment goldbook:09168 "The sinusoidal current response lags behind the sinusoidal voltage perturbation by a phase angle \\(\\phi\\). Resistances (e.g. to charge transfer) give a response in phase with the voltage perturbation; capacitances (e.g. double layer) give a response \\(\\pu{90\\!^{\\circ}}\\) out of phase; combinations of resistances and capacitances give phase angles between 0 and \\(\\pu{90\\!^{\\circ}}\\). Plots of the out of phase vs. the in phase component of the impedance for all the frequencies tested are called complex plane (or Nyquist) plots. Plots of the phase angle and the magnitude of the impedance vs. the logarithm of perturbation frequency are called Bode diagrams. Complex plane plots are the more commonly used for electrochemical sensors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09168 "Impedimetric sensors are based on measurement of a concentration-dependent parameter taken from analysis of the respective electrochemical impedance spectra, or from the impedance magnitudes at a chosen fixed frequency."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09168 goldbook:09077)
AnnotationAssertion(mito:isMentionedBy goldbook:09168 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09168 "current"^^xsd:string)
Declaration(Class(goldbook:09169))
AnnotationAssertion(rdfs:label goldbook:09169 "impedimetry")
AnnotationAssertion(dcterms:description goldbook:09169 "Measurement principle in which the complex electric impedance of a system is measured, usually as a function of a small amplitude sinusoidal electrode potential.")
AnnotationAssertion(rdfs:seeAlso goldbook:09169 goldbook:09168)
AnnotationAssertion(mito:isMentionedBy goldbook:09169 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09169 "current"^^xsd:string)
Declaration(Class(goldbook:09170))
AnnotationAssertion(rdfs:label goldbook:09170 "electrochemical detection in flowing systems")
AnnotationAssertion(dcterms:description goldbook:09170 "Electrochemical techniques (potentiometry, amperometry, voltammetry, coulometry, conductimetry) used for analyte detection in flowing systems.")
AnnotationAssertion(rdfs:comment goldbook:09170 "Measurement in flowing systems (e.g. flow injection analysis) should be differentiated from batchwise determination in individual fractions obtained after separation (e.g., high performance liquid chromatography, capillary zone electrophoresis)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09170 goldbook:09128)
AnnotationAssertion(rdfs:seeAlso goldbook:09170 goldbook:09166)
AnnotationAssertion(rdfs:seeAlso goldbook:09170 goldbook:09159)
AnnotationAssertion(rdfs:seeAlso goldbook:09170 goldbook:09127)
AnnotationAssertion(rdfs:seeAlso goldbook:09170 goldbook:09148)
AnnotationAssertion(mito:isMentionedBy goldbook:09170 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09170 "current"^^xsd:string)
Declaration(Class(goldbook:09171))
AnnotationAssertion(rdfs:label goldbook:09171 "spectroelectrochemistry")
AnnotationAssertion(dcterms:description goldbook:09171 "Measurement methods combining spectrometric and electrochemical measurements.")
AnnotationAssertion(mito:isMentionedBy goldbook:09171 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09171 "current"^^xsd:string)
Declaration(Class(goldbook:09172))
AnnotationAssertion(rdfs:label goldbook:09172 "Auger spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09172 "Measurement method of electron emission spectroscopy that utilizes Auger electrons emitted from the target following excitation with an electron beam or X-ray beam.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09172 "AES")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09172 "Auger electron spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:09172 "Chemical species are identified from the energies of the emitted Auger electrons and the typically low energies of the emitted electrons and resulting escape depth mean the technique is particularly sensitive for surface species analysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09172 "Most AES is performed under high vacuum or ultra-high vacuum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09172 "An electron beam in the energy range \\(\\pu{2 keV}\\) to \\(\\pu{30 keV}\\) is often used for excitation of the Auger electrons. Auger electrons can also be excited with X-rays, ions, and other sources, but the term Auger electron spectroscopy, without additional qualifiers, is usually reserved for electron-beam-induced excitation. Where an X-ray source is used, the Auger electron energies are referenced to the Fermi level, but, where an electron beam is used, the reference may either be the Fermi level or the vacuum level. Conventionally, spectra may be presented in the direct or differential forms."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09172 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09172 "current"^^xsd:string)
Declaration(Class(goldbook:09173))
AnnotationAssertion(rdfs:label goldbook:09173 "Auger photoelectron coincidence spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09173 "Detection of an Auger electron and a core-level photoelectron, emitted from a solid irradiated by mono-energetic X-rays, within a sufficiently short time that the Auger electron shall arise from the decay of the particular core-hole associated with the photoelectron.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09173 "APECS")
AnnotationAssertion(mito:isMentionedBy goldbook:09173 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09173 "current"^^xsd:string)
Declaration(Class(goldbook:09174))
AnnotationAssertion(rdfs:label goldbook:09174 "elastic peak electron spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09174 "Measurement method in which an electron spectrometer is used to measure the energy, intensity, and/or energy broadening distribution of quasi-elastically scattered electrons from a solid or liquid surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09174 "EPES")
AnnotationAssertion(rdfs:comment goldbook:09174 "An electron beam in the energy range \\(\\pu{100 keV}\\) to \\(\\pu{3 keV}\\) is often used for this kind of spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09174 "In general, electron sources with energy spreads that are less than \\(\\pu{1 keV}\\) are required to provide adequate information."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09174 "EPES is often an auxiliary method of Auger electron spectroscopy and reflection electron energy loss spectroscopy (REELS), providing information on the composition of the surface layer. EPES is suitable for the experimental determination of the electron inelastic mean free path, the electron differential elastic scattering cross section, and the surface excitation parameter."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09174 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09174 goldbook:09246)
AnnotationAssertion(rdfs:seeAlso goldbook:09174 goldbook:09327)
AnnotationAssertion(rdfs:seeAlso goldbook:09174 goldbook:09329)
AnnotationAssertion(mito:isMentionedBy goldbook:09174 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09174 "current"^^xsd:string)
Declaration(Class(goldbook:09175))
AnnotationAssertion(rdfs:label goldbook:09175 "direct recoil spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09175 "Measurement method to elucidate composition and structure of the outermost atomic layers of a solid material, in which principally monoenergetic neutral atoms or singly charged probe ions are used to sputter atoms or ions out of the solid surface, their energy being recorded at one or more angle of scattering.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09175 "elastic recoil detection")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09175 "elastic recoil detection analysis")
AnnotationAssertion(rdfs:comment goldbook:09175 "In the analysis, it is assumed that the recoiled atom or ion is from a single binary elastic scattering event. The energy is the complement of the primary ion scattered ion energy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09175 "The scattered primary ions can be removed from the spectrum by a suitable choice of angle of scattering."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09175 "This method is often combined with rutherford backscattering spectrometry, as they share many concepts and instrumental items."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09175 goldbook:09178)
AnnotationAssertion(rdfs:seeAlso goldbook:09175 goldbook:09378)
AnnotationAssertion(mito:isMentionedBy goldbook:09175 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09175 "current"^^xsd:string)
Declaration(Class(goldbook:09176))
AnnotationAssertion(rdfs:label goldbook:09176 "low-energy ion scattering spectrometry")
AnnotationAssertion(dcterms:description goldbook:09176 "Measurement method to elucidate the composition and structure of the very outermost atomic layers of a solid material, in which principally monoenergetic, singly-charged probe ions scattered from the surface are detected and recorded as a function of their energy, angle of scattering, or both.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09176 "LEIS, LEISS")
AnnotationAssertion(rdfs:comment goldbook:09176 "LEIS(S) is a form of ion beam analysis in which the probe ions, typically \\(\\ce{He+}\\) or \\(\\ce{Ne+}\\), have energies in the range \\(\\pu{0.1 keV}\\) to \\(\\pu{10 keV}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09176 "The acronym usually has only one “S”."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09176 goldbook:09378)
AnnotationAssertion(mito:isMentionedBy goldbook:09176 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09176 "current"^^xsd:string)
Declaration(Class(goldbook:09177))
AnnotationAssertion(rdfs:label goldbook:09177 "medium-energy ion scattering spectrometry")
AnnotationAssertion(dcterms:description goldbook:09177 "Measurement method to elucidate the composition and structure of the outermost atomic layers of a solid material, in which principally monoenergetic, singly-charged probe ions scattered from the surface are detected and recorded as a function of their energy, angle of scattering, or both.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09177 "MEIS, MEISS")
AnnotationAssertion(rdfs:comment goldbook:09177 "MEIS is a form of ion beam analysis in which the probe ions, typically protons, have energies in the range \\(\\pu{100 keV}\\) to \\(\\pu{200 keV}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09177 "By using channelling and aligning the incident-ion beam along a crystal axis, the scattering from the substrate can be suppressed, enhancing the signal quality and visibility obtained for amorphous overlayers. By further aligning the detector along a second crystal axis, the double-alignment mode, the scattering from the substrate can be further suppressed, improving the signal quality and visibility for amorphous overlayers to a high level."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09177 "In some cases, an angle-sensitive detector is used that allows extensive structure and depth profile (see depth profiling) information to be obtained."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09177 "The acronym usually has only one “S”."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09177 goldbook:09244)
AnnotationAssertion(rdfs:seeAlso goldbook:09177 goldbook:09378)
AnnotationAssertion(mito:isMentionedBy goldbook:09177 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09177 "current"^^xsd:string)
Declaration(Class(goldbook:09178))
AnnotationAssertion(rdfs:label goldbook:09178 "Rutherford backscattering spectrometry")
AnnotationAssertion(dcterms:description goldbook:09178 "Measurement method to elucidate composition and structure of layers at the surface of a solid material, in which principally monoenergetic, singly charged probe ions scattered from the surface with a Rutherford cross section are detected and recorded as a function of their energy or angle of scattering, or both.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09178 "RBS")
AnnotationAssertion(rdfs:comment goldbook:09178 "RBS is a form of ion beam analysis in which the probe ions, typically \\(\\ce{He+}\\) but sometimes \\(\\ce{H+}\\), have energies in the range \\(\\pu{1 MeV}\\) to \\(\\pu{2 MeV}\\). In its traditional form, a solid-state energy-dispersive detector is used. In the form of high-resolution RBS, the energy can be reduced to \\(\\pu{300 keV}\\) and a high-resolution (ion optical) spectrometer can be used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09178 "By using channelling and aligning the incident-ion beam along a crystal axis, the scattering from the substrate can be suppressed so that enhanced signal quality and visibility are obtained for amorphous overlayers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09178 goldbook:09381)
AnnotationAssertion(rdfs:seeAlso goldbook:09178 goldbook:09378)
AnnotationAssertion(mito:isMentionedBy goldbook:09178 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09178 "current"^^xsd:string)
Declaration(Class(goldbook:09179))
AnnotationAssertion(rdfs:label goldbook:09179 "desorption atmospheric pressure chemical ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09179 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of a nearby corona discharge in a humid carrier gas.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09179 "DAPCI")
AnnotationAssertion(rdfs:comment goldbook:09179 "The carrier gas is usually nitrogen."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09179 "Both positive and negative ions are observed with the mechanisms involving protonation through water molecules and ionization through the Penning process."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09179 goldbook:09182)
AnnotationAssertion(rdfs:seeAlso goldbook:09179 goldbook:09190)
AnnotationAssertion(mito:isMentionedBy goldbook:09179 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09179 "current"^^xsd:string)
Declaration(Class(goldbook:09180))
AnnotationAssertion(rdfs:label goldbook:09180 "desorption atmospheric pressure photoionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09180 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of desorption by a jet of hot solvent vapour and ionization by ultraviolet light.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09180 "DAPPI")
AnnotationAssertion(rdfs:comment goldbook:09180 "The desorption mechanism is thermal."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09180 "Both positive and negative ions are observed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09180 goldbook:09181)
AnnotationAssertion(rdfs:seeAlso goldbook:09180 goldbook:09184)
AnnotationAssertion(rdfs:seeAlso goldbook:09180 goldbook:09185)
AnnotationAssertion(rdfs:seeAlso goldbook:09180 goldbook:09188)
AnnotationAssertion(mito:isMentionedBy goldbook:09180 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09180 "current"^^xsd:string)
Declaration(Class(goldbook:09181))
AnnotationAssertion(rdfs:label goldbook:09181 "desorption electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09181 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the bombardment by ionized solvent droplets generated by pneumatically assisted electrospray ionization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09181 "DESI")
AnnotationAssertion(rdfs:comment goldbook:09181 "Water and methanol are often used as the solvents to create the droplets. Acids and alkalis are added to control the solution pH."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09181 "DESI is one of the few surface analysis methods designed to analyse materials without exposure to vacuum. It is used for complex molecules, organic molecules, and biomolecules. In vivo analysis is claimed to be possible."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09181 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09181 "current"^^xsd:string)
Declaration(Class(goldbook:09182))
AnnotationAssertion(rdfs:label goldbook:09182 "direct analysis in real time")
AnnotationAssertion(dcterms:description goldbook:09182 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the interaction with a beam containing metastable, excited atoms heated to about \\(\\pu{500^{\\circ}C}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09182 "DART")
AnnotationAssertion(rdfs:comment goldbook:09182 "DART is the registered trademark of JEOL, USA, Inc."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09182 "The beam atoms usually used are helium, nitrogen, or neon."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09182 "Both positive and negative ions are observed, although the mechanism for positive ions can be through protonation involving water molecules and the process for negative ions through Penning ionization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09182 goldbook:09190)
AnnotationAssertion(mito:isMentionedBy goldbook:09182 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09182 "current"^^xsd:string)
Declaration(Class(goldbook:09183))
AnnotationAssertion(rdfs:label goldbook:09183 "dynamic secondary-ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09183 "Secondary-ion mass spectrometry analysis with primary ion current density sufficiently high for use in the analysis of sample surface layers in the depth direction.")
AnnotationAssertion(rdfs:comment goldbook:09183 "Dynamic SIMS is often simply termed SIMS."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09183 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09183 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09183 "current"^^xsd:string)
Declaration(Class(goldbook:09184))
AnnotationAssertion(rdfs:label goldbook:09184 "electrospray laser desorption ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09184 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge quotient and the abundance of ionized entities emitted from a sample in air via ablation by a focused pulsed laser while simultaneously directing an electrospray jet through the desorbed plume to enhance sample ionization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09184 "ELDIMS")
AnnotationAssertion(rdfs:comment goldbook:09184 "The desorption mechanism is thermal."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09184 "Both positive and negative ions are observed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09184 "With the addition of a matrix on the sample, this is termed matrix-assisted laser desorption electrospray ionization (MALDESI)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09184 "With the use of an infrared laser for ablation, this has sometimes been termed laser ablation electrospray ionization (LAESI)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09184 goldbook:09180)
AnnotationAssertion(rdfs:seeAlso goldbook:09184 goldbook:09181)
AnnotationAssertion(rdfs:seeAlso goldbook:09184 goldbook:09185)
AnnotationAssertion(mito:isMentionedBy goldbook:09184 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09184 "current"^^xsd:string)
Declaration(Class(goldbook:09185))
AnnotationAssertion(rdfs:label goldbook:09185 "extractive electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09185 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of an inert gas being passed over the sample to pick up the molecules, which are subsequently ionized by ionized solvent droplets generated by pneumatically assisted electrospray ionization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09185 "EESI")
AnnotationAssertion(rdfs:comment goldbook:09185 "Both positive and negative ions are observed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09185 goldbook:09180)
AnnotationAssertion(rdfs:seeAlso goldbook:09185 goldbook:09181)
AnnotationAssertion(rdfs:seeAlso goldbook:09185 goldbook:09184)
AnnotationAssertion(rdfs:seeAlso goldbook:09185 goldbook:09188)
AnnotationAssertion(mito:isMentionedBy goldbook:09185 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09185 "current"^^xsd:string)
Declaration(Class(goldbook:09186))
AnnotationAssertion(rdfs:label goldbook:09186 "G-SIMS")
AnnotationAssertion(dcterms:description goldbook:09186 "Variant of static secondary-ion mass spectrometry in which the intensities for each mass in two spectra from the same area, recorded with different beam energies or different bombarding ions, are ratioed to each other and the result is used to scale one of the spectra to generate a new spectrum.")
AnnotationAssertion(rdfs:comment goldbook:09186 "As with static SIMS, the ion areic dose during measurement is restricted to less than \\(\\pu{E16}\\) ions per \\(\\pu{m2}\\) to an extent that depends on both the material of the sample and the size of the molecular fragments being analysed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09186 "The G-SIMS spectrum enables the mass of whole molecules on the surface to be determined more readily than in static SIMS."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09186 "The “G” in G-SIMS originally indicated the gentleness of the process generated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09186 goldbook:09223)
AnnotationAssertion(rdfs:seeAlso goldbook:09186 goldbook:09193)
AnnotationAssertion(mito:isMentionedBy goldbook:09186 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09186 "current"^^xsd:string)
Declaration(Class(goldbook:09187))
AnnotationAssertion(rdfs:label goldbook:09187 "laser ablation electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09187 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of laser ablation and electrospray ionization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09187 "LAESI")
AnnotationAssertion(rdfs:comment goldbook:09187 "The laser wavelength is usually in the infrared region."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09187 "Both positive and negative ions are observed with the mechanisms involving protonation through water molecules and ionization through the Penning process."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09187 goldbook:09180)
AnnotationAssertion(rdfs:seeAlso goldbook:09187 goldbook:09181)
AnnotationAssertion(rdfs:seeAlso goldbook:09187 goldbook:09184)
AnnotationAssertion(rdfs:seeAlso goldbook:09187 goldbook:09185)
AnnotationAssertion(rdfs:seeAlso goldbook:09187 goldbook:09188)
AnnotationAssertion(mito:isMentionedBy goldbook:09187 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09187 "current"^^xsd:string)
Declaration(Class(goldbook:09188))
AnnotationAssertion(rdfs:label goldbook:09188 "matrix-assisted laser desorption electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09188 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities from a sample that has been mixed with a matrix whose role is enhancing the ion yield produced by laser ablation and electrospray ionization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09188 "MALDESI")
AnnotationAssertion(rdfs:comment goldbook:09188 "The matrix, e.g. glycerol, allows efficient absorption of the laser energy and assists the desorption of the analyte molecules in the ejected charged droplets."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09188 "Both positive and negative ions are observed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09188 goldbook:09180)
AnnotationAssertion(rdfs:seeAlso goldbook:09188 goldbook:09181)
AnnotationAssertion(rdfs:seeAlso goldbook:09188 goldbook:09184)
AnnotationAssertion(rdfs:seeAlso goldbook:09188 goldbook:09185)
AnnotationAssertion(rdfs:seeAlso goldbook:09188 goldbook:09187)
AnnotationAssertion(mito:isMentionedBy goldbook:09188 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09188 "current"^^xsd:string)
Declaration(Class(goldbook:09189))
AnnotationAssertion(rdfs:label goldbook:09189 "matrix-assisted laser desorption/ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09189 "Measurement method in which a time-of-flight mass spectrometer is used to measure the ratio of mass to charge and the abundance of ions emitted, as a result of a short pulse of laser illumination, from a sample whose analyte is contained in a matrix that assists the formation of ions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09189 "MALDI")
AnnotationAssertion(rdfs:comment goldbook:09189 "The matrix used for assisting the ion emission needs a strong absorbance at the laser wavelength and a low enough mass to sublime. Examples of matrices for \\(\\pu{337 nm}\\) wavelength laser light are 2,5-dihydroxybenzoic acid (DHB), 3,5-dimethoxy-4-hydroxycinnamic acid (sinapinic acid), and α-cyano-4-hydroxycinnamic acid (CHCA)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09189 "MALDI is used to analyse non-volatile polar biological and organic macromolecules, as well as polymers, to masses of over \\(\\pu{3000 ku}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09189 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09189 "current"^^xsd:string)
Declaration(Class(goldbook:09190))
AnnotationAssertion(rdfs:label goldbook:09190 "plasma assisted desorption ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09190 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the bombardment by a focused plasma.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09190 "PADI")
AnnotationAssertion(rdfs:comment goldbook:09190 "The energy of the plasma ions is very low."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09190 "The beam atoms usually used are helium, nitrogen, air, or argon."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09190 "Both positive and negative ions are observed, although the mechanism for positive ions can be through protonation involving water molecules and the process for negative ions through Penning ionization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09190 goldbook:09182)
AnnotationAssertion(mito:isMentionedBy goldbook:09190 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09190 "current"^^xsd:string)
Declaration(Class(goldbook:09191))
AnnotationAssertion(rdfs:label goldbook:09191 "reactive desorption electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09191 "Mode of desorption electrospray ionization mass spectrometry with reactive chemicals within the spray solution to enhance the analytical specificity.")
AnnotationAssertion(rdfs:comment goldbook:09191 "The method has been used to detect chemical warefare agents, as well as natural products in marine alga."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09191 goldbook:09181)
AnnotationAssertion(mito:isMentionedBy goldbook:09191 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09191 "current"^^xsd:string)
Declaration(Class(goldbook:09192))
AnnotationAssertion(rdfs:label goldbook:09192 "secondary-ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09192 "Measurement method in which a focused beam of primary ions produces secondary ions by sputtering from a solid surface. The secondary ions are analysed by mass spectrometry.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09192 "SIMS")
AnnotationAssertion(rdfs:comment goldbook:09192 "SIMS is, by convention, generally classified as either dynamic, in which the material surface layers are continually removed as they are being measured, or static, in which the ion areic dose during measurement is restricted to less than \\(\\pu{E16}\\) ions \\(\\pu{m2}\\) in order to retain the surface in an essentially undamaged state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09192 goldbook:09183)
AnnotationAssertion(rdfs:seeAlso goldbook:09192 goldbook:09193)
AnnotationAssertion(mito:isMentionedBy goldbook:09192 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09192 "current"^^xsd:string)
Declaration(Class(goldbook:09193))
AnnotationAssertion(rdfs:label goldbook:09193 "static secondary-ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09193 "Method of secondary-ion mass spectrometry using low current densities for analysis of sample surface components, in contrast with dynamic secondary-ion mass spectrometry, which is used for analysis of components in the depth direction.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09193 "SSIMS")
AnnotationAssertion(rdfs:comment goldbook:09193 "When the sample is an organic molecule in solid form, the term is often changed to organic SIMS or molecular SIMS."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09193 "The ion areic dose during measurement is restricted to less than \\(\\pu{E16}\\) ions per \\(\\pu{m2}\\) to an extent that depends on both the material of the sample and the size of the molecular fragments being analysed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09193 "Ions are usually detected by a time of flight mass spectrometer (TOF-SIMS)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09193 goldbook:09223)
AnnotationAssertion(rdfs:seeAlso goldbook:09193 goldbook:09183)
AnnotationAssertion(rdfs:seeAlso goldbook:09193 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09193 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09193 "current"^^xsd:string)
Declaration(Class(goldbook:09194))
AnnotationAssertion(rdfs:label goldbook:09194 "surface-assisted laser desorption/ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09194 "Matrix-assisted laser desorption/ionization mass spectrometry using a combined liquid and particulate matrix.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09194 "SALDI")
AnnotationAssertion(rdfs:comment goldbook:09194 "The first particulate matrix to be used was graphite. More recently, nano particle matrices have been used. Ethane-1,2-diol (ethylene glycol) is a typical liquid."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09194 goldbook:09189)
AnnotationAssertion(mito:isMentionedBy goldbook:09194 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09194 "current"^^xsd:string)
Declaration(Class(goldbook:09195))
AnnotationAssertion(rdfs:label goldbook:09195 "attenuated total reflection infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09195 "Attenuated total reflection spectroscopy in which the infrared absorption spectrum of a sample in contact with a prism is measured.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09195 "ATRIRS")
AnnotationAssertion(rdfs:comment goldbook:09195 "Most ATRIR work is carried out with an angle of incidence of \\(\\pu{45\\!^{\\circ}}\\) inside a \\(\\ce{ZnSe}\\) or diamond prism, both with a refractive index of 2.4. With such optical conditions, total internal reflection is achieved with an effective sample refractive index less than about 1.7 for almost all powdered samples."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09195 "ATRIRS has particular application in the surface chemical analysis of solid particle films immersed in aqueous solution."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09195 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09195 "current"^^xsd:string)
Declaration(Class(goldbook:09196))
AnnotationAssertion(rdfs:label goldbook:09196 "diffuse reflection-absorption infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09196 "Measurement method in which the infrared absorption spectrum of light reflected and transmitted from powdered samples is measured.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09196 "diffuse reflectance infrared Fourier transform spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:09196 "Used for the analysis of weakly-reflective surfaces in gas phase or vacuum."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09196 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09196 "current"^^xsd:string)
Declaration(Class(goldbook:09197))
AnnotationAssertion(rdfs:label goldbook:09197 "ellipsometry")
AnnotationAssertion(dcterms:description goldbook:09197 "Measurement method for the thickness of transparent surface films and layers and for the refractive index of a reflecting material.")
AnnotationAssertion(rdfs:comment goldbook:09197 "Radiation that is linearly polarized oblique to the surface becomes elliptically polarized after reflection at non-normal incidence. The ellipticity is obtained from measurements of the intensity and polarization of the incident and the reflected radiation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09197 "Ellipsometry may utilise monochromatic light, while spectroscopic ellipsometry employs a range of frequencies."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09197 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09197 "current"^^xsd:string)
Declaration(Class(goldbook:09198))
AnnotationAssertion(rdfs:label goldbook:09198 "extended X-ray absorption fine structure spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09198 "X-ray absorption fine structure spectroscopy in the energy region from the core-level edge to an energy several hundred $\\pu{eV}$ greater.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09198 "EXAFS")
AnnotationAssertion(rdfs:comment goldbook:09198 "Extended X-ray absorption fine structure results mainly from the single scattering of the photoelectron from surrounding atoms and is exhibited as oscillations in the absorption cross section with increasing photon energy. Analysis of the oscillations provides information, through bond lengths, on the local chemical environment of the emitting atom."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09198 "EXAFS has been used as an alternate term for the superordinate concept of XAFS."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09198 goldbook:09212)
AnnotationAssertion(mito:isMentionedBy goldbook:09198 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09198 "current"^^xsd:string)
Declaration(Class(goldbook:09199))
AnnotationAssertion(rdfs:label goldbook:09199 "grazing-incidence small-angle X-ray scattering analysis")
AnnotationAssertion(dcterms:description goldbook:09199 "Measurement method in which the elastically scattered intensity of X-rays from a reflecting surface is measured for small-angle deflections at grazing incidence.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09199 "GISAXS")
AnnotationAssertion(rdfs:comment goldbook:09199 "The grazing incidence angle depends on photon energy and material and is typically less than \\(\\pu{2\\!^{\\circ}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09199 "GISAXS provides structural information for the surface or for particles on the surface, with lengths scales between several nm and several hundred nm."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09199 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09199 "current"^^xsd:string)
Declaration(Class(goldbook:09200))
AnnotationAssertion(rdfs:label goldbook:09200 "off-specular X-ray reflectometry")
AnnotationAssertion(dcterms:description goldbook:09200 "X-ray reflectometry in which significant scattered intensity arises from imperfections in the specimen, the scattered intensity falling outside the specular condition (see specular X-ray reflectometry).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09200 "diffuse X-ray reflectometry")
AnnotationAssertion(rdfs:comment goldbook:09200 "Imperfections generating diffuse XRR include surface and interface roughnesses, film defects, and inhomogeneities. Quantitative estimates of these can be made by modelling."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09200 goldbook:09214)
AnnotationAssertion(rdfs:seeAlso goldbook:09200 goldbook:09204)
AnnotationAssertion(mito:isMentionedBy goldbook:09200 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09200 "current"^^xsd:string)
Declaration(Class(goldbook:09201))
AnnotationAssertion(rdfs:label goldbook:09201 "reflection-absorption infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09201 "Spectroscopy based on reflection-absorption.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09201 "infrared reflection-absorption spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:09201 "RAIRS allows improved discrimination between species at the surface and those in the bulk."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09201 "RAIRS is most sensitive at metal surfaces with grazing incidence."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09201 "RAIRS is usually employed with the sample in a vacuum or gas."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09201 "RAIRS may be employed with polarization modulation to minimize background absorption."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09201 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09201 "current"^^xsd:string)
Declaration(Class(goldbook:09202))
AnnotationAssertion(rdfs:label goldbook:09202 "scanning near-field optical microscopy")
AnnotationAssertion(dcterms:description goldbook:09202 "Measurement method in microscopy in which spectroscopic data may be collected with the detector closer to the sample than the optical wavelength employed.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09202 "SNOM")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09202 "near-field optical microscopy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09202 "near-field scanning optical microscopy (NSOM)")
AnnotationAssertion(rdfs:comment goldbook:09202 "Includes near-field infrared, Raman, and fluorescence spectroscopies."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09202 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09202 "current"^^xsd:string)
Declaration(Class(goldbook:09203))
AnnotationAssertion(rdfs:label goldbook:09203 "small-angle X-ray scattering")
AnnotationAssertion(dcterms:description goldbook:09203 "Measurement method in which the elastically scattered intensity of X-rays is measured for small-angle deflections.")
AnnotationAssertion(rdfs:comment goldbook:09203 "Angular scattering is usually measured within the range \\(\\pu{0.1\\!^{\\circ}}\\) to \\(\\pu{10\\!^{\\circ}}\\). This provides structural information on macromolecules, as well as periodicity on length scales typically larger than \\(\\pu{5 nm}\\) and less than \\(\\pu{200 nm}\\) for ordered or partially ordered systems."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09203 "Wide-angle X-ray scattering (WAXS) is an analogous technique, similar to X-ray crystallography, in which scattering at larger angles, which is sensitive to periodicity on smaller length scales, is measured."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09203 "The X-ray source can be a synchrotron, in which case the term synchrotron radiation small-angle X-ray scattering (SRXAS) is occasionally encountered."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09203 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09203 "current"^^xsd:string)
Declaration(Class(goldbook:09204))
AnnotationAssertion(rdfs:label goldbook:09204 "specular X-ray reflectrometry")
AnnotationAssertion(dcterms:description goldbook:09204 "Mode of X-ray reflectrometry in which the angle between the detected beam and the sample surface is equal to that of the incident beam and the sample surface.")
AnnotationAssertion(rdfs:comment goldbook:09204 "Specular XRR is the plainary mode for XRR and is often meant when the term XRR is used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09204 "In this case, the angle scattering \\(2 \\theta\\) is twice the incidence angle, \\(\\omega\\). The detected, scattered X-ray intensity is measured as a function of either \\(\\omega\\) or \\(2 \\theta\\) or the scattering vector, \\(q_{\\rm{z}}\\). The intensity data are usually presented as a function of \\(q_{\\rm{z}}\\) or \\(\\omega\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09204 goldbook:09214)
AnnotationAssertion(rdfs:seeAlso goldbook:09204 goldbook:09200)
AnnotationAssertion(mito:isMentionedBy goldbook:09204 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09204 "current"^^xsd:string)
Declaration(Class(goldbook:09205))
AnnotationAssertion(rdfs:label goldbook:09205 "sum frequency generation spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09205 "Measurement method from non-linear optics in which a structurally-ordered sample at an interface between two phases is irradiated by single frequency visible and variable frequency infrared pulses of light to generate a sum frequency vibrational spectrum of the interfacial species without any bulk phase contribution.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09205 "SFGS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09205 "vibrational sum frequency spectroscopy (VSFS)")
AnnotationAssertion(rdfs:comment goldbook:09205 "Closely related to second harmonic generation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09205 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09205 "current"^^xsd:string)
Declaration(Class(goldbook:09206))
AnnotationAssertion(rdfs:label goldbook:09206 "surface extended X-ray absorption fine structure spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09206 "Extended X-ray absorption fine structure spectroscopy in which, instead of measuring X-ray absorption, electron emission arising from that absorption is measured.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09206 "SEXAFS")
AnnotationAssertion(rdfs:comment goldbook:09206 "Emitted electrons include Auger electrons and secondary electrons."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09206 "The detection of emitted electrons provides greater surface sensitivity than is generally found with extended X-ray absorption fine structure measurements."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09206 goldbook:09198)
AnnotationAssertion(mito:isMentionedBy goldbook:09206 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09206 "current"^^xsd:string)
Declaration(Class(goldbook:09207))
AnnotationAssertion(rdfs:label goldbook:09207 "surface-enhanced infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09207 "Measurement method giving enhanced infrared absorption in the measured infrared spectrum of a sample adsorbed on a roughened thin metal substrate. The metal substrate is deposited onto a prism and data is collected by total internal reflection.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09207 "SEIRAS")
AnnotationAssertion(rdfs:comment goldbook:09207 "SEIRAS enhancements can be \\(\\pu{E2}\\) or greater."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09207 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09207 "current"^^xsd:string)
Declaration(Class(goldbook:09209))
AnnotationAssertion(rdfs:label goldbook:09209 "surface-enhanced resonant Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09209 "Measurement method of surface-enhanced Raman spectroscopy (SERS) by which the Raman spectrum is significantly enhanced under the conditions that, whilst undergoing SERS, the molecules are excited by radiation that is in resonance with electronic transitions in the sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09209 "SERRS")
AnnotationAssertion(rdfs:comment goldbook:09209 "Enhancements of up to and greater than \\(\\pu{E10}\\) have been measured."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09209 "The acronym SERRS is used for both surface-enhanced resonant Raman scattering and spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09209 goldbook:09208)
AnnotationAssertion(mito:isMentionedBy goldbook:09209 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09209 "current"^^xsd:string)
Declaration(Class(goldbook:09210))
AnnotationAssertion(rdfs:label goldbook:09210 "tip enhanced raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09210 "Measurement method of Raman spectroscopy combining surface-enhanced Raman spectroscopy and scanning using an atomic force microscope or scanning tunnelling microscope to produce maps of a surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09210 "TERS")
AnnotationAssertion(rdfs:comment goldbook:09210 "TERS is one of several near-field optical spectroscopic techniques."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09210 goldbook:09208)
AnnotationAssertion(mito:isMentionedBy goldbook:09210 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09210 "current"^^xsd:string)
Declaration(Class(goldbook:09211))
AnnotationAssertion(rdfs:label goldbook:09211 "total reflection X-ray fluorescence spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09211 "Measurement method in which an X-ray spectrometer is used to measure the energy distribution of fluorescence X-rays emitted from a surface irradiated by primary X-rays under the condition of total reflection.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09211 "TXRF")
AnnotationAssertion(rdfs:seeAlso goldbook:09211 goldbook:09440)
AnnotationAssertion(mito:isMentionedBy goldbook:09211 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09211 "current"^^xsd:string)
Declaration(Class(goldbook:09212))
AnnotationAssertion(rdfs:label goldbook:09212 "X-ray absorption fine structure spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09212 "Measurement method to measure the absorption of X-rays at energies near and above (typically several hundred \\(\\pu{eV}\\) greater) an absorption edge, over which fine structure (modulation of the X-ray absorption coefficient) can be detected.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09212 "XAFS")
AnnotationAssertion(rdfs:comment goldbook:09212 "XAFS includes both extended X-ray absorption fine structure spectroscopy and X-ray absorption near-edge spectroscopy. It involves transitions from a core-level to an unoccupied orbital or band and mainly reflects the local atomic structure and bonding (SEXAFS) and the density of the unoccupied electronic states (XANES)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09212 "XAFS measurements usually start some \\(\\pu{10 eV}\\) before the core-level binding energy (the absorption edge) of the emitting atoms, because in many cases pre-edge features are used to identify chemical bonds [example: \\(\\uppi^{\\ast}\\) resonances (excitation into lowest unoccupied molecular orbitals) in C K-edge spectra of polymer samples]."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09212 "Usefully sharp absorption edges are commonly observed in X-ray absorption spectra, although broader increases can be observed for some inner-shell excitations with short lifetimes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09212 "XAFS spectra are best recorded when a highly intense beam of X-rays from a synchrotron is used along with a high resolution double crystal or curved crystal spectrometer. Detectors include ionization chambers, scintillation counters, and solid state detectors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09212 goldbook:09213)
AnnotationAssertion(rdfs:seeAlso goldbook:09212 goldbook:09198)
AnnotationAssertion(mito:isMentionedBy goldbook:09212 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09212 "current"^^xsd:string)
Declaration(Class(goldbook:09213))
AnnotationAssertion(rdfs:label goldbook:09213 "X-ray absorption near-edge spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09213 "X-ray absorption fine structure spectroscopy in the energy region near (within approximately \\(\\pu{100 eV}\\)) an absorption edge.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09213 "XANES")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09213 "near-edge extended X-ray absorption fine structure spectroscopy (NEXAFS)")
AnnotationAssertion(rdfs:comment goldbook:09213 "XANES results from interference in multiple scattering of low-energy photoelectrons by surrounding atoms. It provides information on the local coordination environment, oxidation state, molecular orbitals, hybridization, and band structure (unoccupied electronic states)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09213 "XANES measurements usually start some \\(\\pu{10 eV}\\) before the core-level binding energy (the absorption edge) of the emitting atoms, because in many cases pre-edge features are used to identify chemical bonds, e.g. \\(\\uppi^{\\ast}\\) resonances (excitation into lowest unoccupied molecular orbitals) in C K-edge spectra of polymer samples."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09213 "Usefully sharp absorption edges are commonly observed in X-ray absorption spectra, although broader increases can be observed for some inner-shell excitations with short lifetimes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09213 goldbook:09212)
AnnotationAssertion(mito:isMentionedBy goldbook:09213 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09213 "current"^^xsd:string)
Declaration(Class(goldbook:09214))
AnnotationAssertion(rdfs:label goldbook:09214 "X-ray reflectometry")
AnnotationAssertion(dcterms:description goldbook:09214 "Measurement method for surface and interface roughness and density, layer thickness of thin layers, and electron density profile achieved by reflecting X-rays from a flat sample and analysing the reflected intensity as a function of angle.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09214 "XRR")
AnnotationAssertion(rdfs:comment goldbook:09214 "Monochromatic X-rays of low divergence are required. Many layers can be modelled, with thicknesses between about \\(\\pu{1 nm}\\) and a few \\(\\pu{\\upmu m}\\), and (subject to conditions) fitted to the data. The surface needs to be flat over the beam footprint of typically \\(\\pu{10 mm}\\) to \\(\\pu{40 mm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09214 goldbook:09436)
AnnotationAssertion(rdfs:seeAlso goldbook:09214 goldbook:09204)
AnnotationAssertion(mito:isMentionedBy goldbook:09214 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09214 "current"^^xsd:string)
Declaration(Class(goldbook:09215))
AnnotationAssertion(rdfs:label goldbook:09215 "X-ray standing waves")
AnnotationAssertion(dcterms:description goldbook:09215 "Measurement method based on the interference of X-rays that occurs near the Bragg condition at the surface of a crystalline solid, which leads to intensity maxima in yields of photoelectrons as the Bragg condition is scanned by tilting the sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09215 "XSW")
AnnotationAssertion(rdfs:comment goldbook:09215 "Intensity nodes are scanned from one lattice plane to the next as the sample is tilted. Atomic positions in the crystalline lattice can be determined from comparisons of measured scans of photoelectron intensity versus tilt angle with calculated scans from dynamical scattering theory."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09215 "For defect-rich substrates, such as metal single crystals, a normal-incidence or back-reflection geometry may be used. Instead of rocking the crystal in space, the energy of the incident beam is tuned through the Bragg condition."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09215 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09215 "current"^^xsd:string)
Declaration(Class(goldbook:09216))
AnnotationAssertion(rdfs:label goldbook:09216 "absolute elemental sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09216 "Coefficient for an element by which the measured intensity for that element is divided to yield the atomic concentration or atomic fraction of the element present in the sample.")
AnnotationAssertion(rdfs:comment goldbook:09216 "The choice of atomic concentration or atomic fraction should be made clear."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09216 "The type of sensitivity factor utilized should be appropriate for the formulae used in the quantification process and for the type of sample analysed, e.g. for homogeneous samples or segregated layers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09216 "The source of sensitivity factors should be given to ensure that the correct matrix factors or other parameters are used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09216 "Sensitivity factors depend on parameters of the excitation source, the spectrometer, and the orientation of the sample to these parts of the instrument. Sensitivity factors also depend on the matrix being analysed. Sensitivity factors also depend on the matrix being analysed. In secondary ion mass spectrometry this has a dominating influence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09216 goldbook:09263)
AnnotationAssertion(rdfs:seeAlso goldbook:09216 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09216 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09216 "current"^^xsd:string)
Declaration(Class(goldbook:09217))
AnnotationAssertion(rdfs:label goldbook:09217 "altered layer")
AnnotationAssertion(dcterms:description goldbook:09217 "Surface region of a material under particle bombardment where the chemical state or physical structure is modified by the effects of the bombardment.")
AnnotationAssertion(rdfs:comment goldbook:09217 "For silicon bombarded by \\(\\pu{4 keV}\\) \\(\\ce{O2+}\\) at near-normal incidence, after sputtering for a sufficient time to reach a steady state, the surface is converted to stoichiometric \\(\\ce{SiO2}\\) to a depth of around \\(\\pu{15 nm}\\), with lower oxygen concentrations at greater depths. At \\(\\pu{2 keV}\\), this is reduced to \\(\\pu{7 nm}\\), these thicknesses being approximately twice the projected range."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09217 "The observed interface width (depth resolution) in secondary-ion mass spectrometry can be greater or smaller than the altered-layer thickness, depending on the analyte and bombarding-ion species."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09217 goldbook:09245)
AnnotationAssertion(rdfs:seeAlso goldbook:09217 goldbook:09271)
AnnotationAssertion(rdfs:seeAlso goldbook:09217 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09217 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09217 "current"^^xsd:string)
Declaration(Class(goldbook:09218))
AnnotationAssertion(rdfs:label goldbook:09218 "analysis area")
AnnotationAssertion(dcterms:description goldbook:09218 "Two-dimensional region of a sample surface measured in the plane of that surface, from which the entire analytical signal or a specified fraction of that signal is detected.")
AnnotationAssertion(mito:isMentionedBy goldbook:09218 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09218 "current"^^xsd:string)
Declaration(Class(goldbook:09219))
AnnotationAssertion(rdfs:label goldbook:09219 "analysis area")
AnnotationAssertion(dcterms:description goldbook:09219 "Two-dimensional region of a sample surface at the analytical point, but set in the plane at right angles to the spectrometer axis, from which the entire analytical signal or a specified fraction of that signal is detected.")
AnnotationAssertion(mito:isMentionedBy goldbook:09219 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09219 "current"^^xsd:string)
Declaration(Class(goldbook:09220))
AnnotationAssertion(rdfs:label goldbook:09220 "angle lapping")
AnnotationAssertion(dcterms:description goldbook:09220 "Sample preparation in which a sample is mechanically polished at an angle to the original surface.")
AnnotationAssertion(rdfs:comment goldbook:09220 "This angle can often be less than \\(\\pu{1\\!^{\\circ}}\\), so that depth information with respect to the original surface is transformed to lateral information."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09220 goldbook:09272)
AnnotationAssertion(mito:isMentionedBy goldbook:09220 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09220 "current"^^xsd:string)
Declaration(Class(goldbook:09221))
AnnotationAssertion(rdfs:label goldbook:09221 "angle of emission")
AnnotationAssertion(dcterms:description goldbook:09221 "Angle between the trajectory of a particle or photon, as it leaves a surface, and the local or average surface normal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09221 "emission angle")
AnnotationAssertion(rdfs:comment goldbook:09221 "The particular surface normal needs to be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09221 "In XPS and other techniques, the take-off angle, which is referred to the sample surface, is quoted."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09221 goldbook:09296)
AnnotationAssertion(mito:isMentionedBy goldbook:09221 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09221 "current"^^xsd:string)
Declaration(Class(goldbook:09222))
AnnotationAssertion(rdfs:label goldbook:09222 "areic dose rate")
AnnotationAssertion(dcterms:description goldbook:09222 "Areic dose introduced into a solid in time interval \\(t\\) divided by \\(t\\).")
AnnotationAssertion(rdfs:comment goldbook:09222 "For a stationary parallel beam, the areic dose rate equals the flux times \\(\\cos\\ \\theta\\), where \\(\\theta\\) is the angle of incidence of the beam."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09222 goldbook:09223)
AnnotationAssertion(mito:isMentionedBy goldbook:09222 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09222 "current"^^xsd:string)
Declaration(Class(goldbook:09223))
AnnotationAssertion(rdfs:label goldbook:09223 "areic dose")
AnnotationAssertion(dcterms:description goldbook:09223 "Number, \\(N\\), of energetic particles of a specified type introduced into a solid through a surface area \\(A\\) divided by \\(A\\). \\(D = N/A\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09223 "dose")
AnnotationAssertion(rdfs:comment goldbook:09223 "The energetic particles are atoms or atom clusters, which can be electrically charged or neutral, and the surface area \\(A\\) is the geometric surface area."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09223 "For a stationary parallel beam, the areic dose equals the fluence times \\(cos\\ \\theta\\), where \\(\\theta\\) is the angle of incidence of the beam to the surface normal. Therefore, the use of ‘fluence’ for ‘dose’ is not recommended."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09223 "In some texts, the term dose density is used, but the term dose (more correctly areic dose) is more widespread. The term dose has been defined very differently in the fields of radiation and the medical sciences. Some have taken the total amount of particle radiation impacting the surface to be the dose, while others consider the amount divided by the area of the surface to be the dose. Here, dose is taken to be the latter. Dose density and dose, where they occur, are to be taken as the areic dose."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09223 "For a discussion of areic dose in relation to ion-implanted reference materials."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09223 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09223 "current"^^xsd:string)
Declaration(Class(goldbook:09224))
AnnotationAssertion(rdfs:label goldbook:09224 "areic surface energy")
AnnotationAssertion(dcterms:description goldbook:09224 "Energy required to increase a surface area at thermodynamic equilibrium divided by that increase in area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09224 "surface energy")
AnnotationAssertion(rdfs:comment goldbook:09224 "SI unit \\(\\pu{J m^{–2}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09224 "This term has no relation to surface energy approximation, used in energetic-ion analysis and Rutherford backscattering spectrometry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09224 goldbook:09178)
AnnotationAssertion(mito:isMentionedBy goldbook:09224 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09224 "current"^^xsd:string)
Declaration(Class(goldbook:09225))
AnnotationAssertion(rdfs:label goldbook:09225 "atomic mixing")
AnnotationAssertion(dcterms:description goldbook:09225 "Migration of sample atoms due to energy transfer with incident particles in the surface region.")
AnnotationAssertion(rdfs:seeAlso goldbook:09225 goldbook:09232)
AnnotationAssertion(rdfs:seeAlso goldbook:09225 goldbook:09238)
AnnotationAssertion(mito:isMentionedBy goldbook:09225 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09225 "current"^^xsd:string)
Declaration(Class(goldbook:09226))
AnnotationAssertion(rdfs:label goldbook:09226 "Auger neutralization")
AnnotationAssertion(dcterms:description goldbook:09226 "Process in which an electron, tunnelling from the conduction band of a solid, neutralizes an incoming ion and an electron is ejected from a surface atom.")
AnnotationAssertion(rdfs:comment goldbook:09226 "The ejected electron can be emitted into the vacuum."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09226 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09226 "current"^^xsd:string)
Declaration(Class(goldbook:09227))
AnnotationAssertion(rdfs:label goldbook:09227 "average beam current")
AnnotationAssertion(dcterms:description goldbook:09227 "Electric charge of specified polarity in a beam passing in time interval \\(t\\), divided by \\(t\\).")
AnnotationAssertion(rdfs:comment goldbook:09227 "For beams in which the instantaneous current varies periodically with time, the time interval \\(t\\) is an integral number of periods."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09227 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09227 "current"^^xsd:string)
Declaration(Class(goldbook:09228))
AnnotationAssertion(rdfs:label goldbook:09228 "backscattering energy")
AnnotationAssertion(dcterms:description goldbook:09228 "Energy of a particle from the primary beam after it has undergone a backscattering collision and escaped from the sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:09228 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09228 "current"^^xsd:string)
Declaration(Class(goldbook:09229))
AnnotationAssertion(rdfs:label goldbook:09229 "ball cratering")
AnnotationAssertion(dcterms:description goldbook:09229 "Procedure in which the sample is abraded by a sphere in order to expose compositional changes in layers below the original surface, with the intent that the depth of those layers can be related to the lateral position in the crater created by the abrasion.")
AnnotationAssertion(rdfs:seeAlso goldbook:09229 goldbook:09272)
AnnotationAssertion(mito:isMentionedBy goldbook:09229 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09229 "current"^^xsd:string)
Declaration(Class(goldbook:09230))
AnnotationAssertion(rdfs:label goldbook:09230 "binary elastic scattering")
AnnotationAssertion(dcterms:description goldbook:09230 "Collision between a moving particle and a second particle in which total kinetic energy and total momentum are conserved.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09230 "elastic scattering")
AnnotationAssertion(rdfs:comment goldbook:09230 "In elastic scattering interactions, the moving particle can be deflected through angles of up to \\(\\pu{180\\!^{\\circ}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09230 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09230 "current"^^xsd:string)
Declaration(Class(goldbook:09231))
AnnotationAssertion(rdfs:label goldbook:09231 "Bragg’s rule")
AnnotationAssertion(dcterms:description goldbook:09231 "Empirical rule formulated by W.H. Bragg and R. Kleeman that states that the stopping cross section of a compound sample is equal to the sum of the products of the elemental stopping cross sections for each constituent and its atomic fraction. \\[S_{\\ce{AB}}(\\varepsilon) = xS_{\\ce{A}}(\\varepsilon) + yS_{\\ce{B}}(\\varepsilon)\\] where \\(S_{\\ce{AB}}(\\varepsilon)\\) is the stopping cross section of the compound \\(\\ce{A}_{x}\\ce{B}_{y}\\), and \\(S_{\\ce{A}}(\\varepsilon)\\) and \\(S_{\\ce{B}}(\\varepsilon)\\) are the stopping cross sections of elements \\(\\ce{A}\\) and \\(\\ce{B}\\), respectively.")
AnnotationAssertion(rdfs:seeAlso goldbook:09231 goldbook:09387)
AnnotationAssertion(mito:isMentionedBy goldbook:09231 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09231 "current"^^xsd:string)
Declaration(Class(goldbook:09232))
AnnotationAssertion(rdfs:label goldbook:09232 "cascade mixing")
AnnotationAssertion(dcterms:description goldbook:09232 "Diffusion-like process in which atoms of material are moved randomly by energy deposited by incident particles slowing down in the sample surface region.")
AnnotationAssertion(rdfs:seeAlso goldbook:09232 goldbook:09225)
AnnotationAssertion(rdfs:seeAlso goldbook:09232 goldbook:09238)
AnnotationAssertion(mito:isMentionedBy goldbook:09232 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09232 "current"^^xsd:string)
Declaration(Class(goldbook:09233))
AnnotationAssertion(rdfs:label goldbook:09233 "channeling")
AnnotationAssertion(dcterms:description goldbook:09233 "Preferential motion of energetic particles along the crystal axes of a crystalline solid as the particles move through the sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:09233 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09233 "current"^^xsd:string)
Declaration(Class(goldbook:09234))
AnnotationAssertion(rdfs:label goldbook:09234 "charge neutralization")
AnnotationAssertion(dcterms:description goldbook:09234 "Maintenance at a fixed potential, usually near neutrality, of the surface of a non-conducting or poorly conducting sample material under bombardment by primary particles or photons.")
AnnotationAssertion(rdfs:comment goldbook:09234 "Charge neutralization can be accomplished by bombarding the surface with electrons or, more rarely, ions or photons."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09234 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09234 "current"^^xsd:string)
Declaration(Class(goldbook:09235))
AnnotationAssertion(rdfs:label goldbook:09235 "charging potential")
AnnotationAssertion(dcterms:description goldbook:09235 "Electric potential of the surface region of an insulating sample, caused by irradiation.")
AnnotationAssertion(rdfs:comment goldbook:09235 "Different charging potentials can occur on different areas or at different depths in a sample, arising from sample inhomogeneities or non-uniform intensity of the incident flux of radiation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09235 "The surface and bulk potentials can differ, for example as a result of band bending, interface dipoles, and charge centres."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09235 goldbook:09251)
AnnotationAssertion(mito:isMentionedBy goldbook:09235 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09235 "current"^^xsd:string)
Declaration(Class(goldbook:09236))
AnnotationAssertion(rdfs:label goldbook:09236 "chemical map")
AnnotationAssertion(dcterms:description goldbook:09236 "Surface map using signals proportional to the amount of an element in a particular chemical state in the sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09236 goldbook:09293)
AnnotationAssertion(mito:isMentionedBy goldbook:09236 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09236 "current"^^xsd:string)
Declaration(Class(goldbook:09237))
AnnotationAssertion(rdfs:label goldbook:09237 "chromatic aberration")
AnnotationAssertion(dcterms:description goldbook:09237 "Non-ideal focus of an electron or ion optical system for electrons or ions of different energies.")
AnnotationAssertion(mito:isMentionedBy goldbook:09237 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09237 "current"^^xsd:string)
Declaration(Class(goldbook:09238))
AnnotationAssertion(rdfs:label goldbook:09238 "collision cascade")
AnnotationAssertion(dcterms:description goldbook:09238 "Sequential energy transfer between atoms in a solid as a result of bombardment by an energetic species.")
AnnotationAssertion(rdfs:seeAlso goldbook:09238 goldbook:09225)
AnnotationAssertion(rdfs:seeAlso goldbook:09238 goldbook:09232)
AnnotationAssertion(mito:isMentionedBy goldbook:09238 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09238 "current"^^xsd:string)
Declaration(Class(goldbook:09239))
AnnotationAssertion(rdfs:label goldbook:09239 "compositional depth profile")
AnnotationAssertion(dcterms:description goldbook:09239 "Chemical composition measured as a function of distance normal to the surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09239 "CDP")
AnnotationAssertion(mito:isMentionedBy goldbook:09239 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09239 "current"^^xsd:string)
Declaration(Class(goldbook:09240))
AnnotationAssertion(rdfs:label goldbook:09240 "crater depth")
AnnotationAssertion(dcterms:description goldbook:09240 "Average depth of the region of a crater from which the measured signal is derived.")
AnnotationAssertion(rdfs:comment goldbook:09240 "The crater is generally formed by ion bombardment in sputter depth profiling and, in this case, can be different from the thickness of sample material removed by sputtering due to dilation of the altered layer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09240 "The crater depth can be modified by the formation of a reacted layer (e.g. an oxide) following any exposure to the atmosphere or other environments necessary when conducting the crater depth measurement."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09240 goldbook:09244)
AnnotationAssertion(mito:isMentionedBy goldbook:09240 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09240 "current"^^xsd:string)
Declaration(Class(goldbook:09241))
AnnotationAssertion(rdfs:label goldbook:09241 "cross-sectioning")
AnnotationAssertion(dcterms:description goldbook:09241 "Sample preparation in which the sample is cleaved, cut, or polished in a plane perpendicular to the interface under study, so that associated compositional differences or gradients can be observed in that plane.")
AnnotationAssertion(mito:isMentionedBy goldbook:09241 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09241 "current"^^xsd:string)
Declaration(Class(goldbook:09242))
AnnotationAssertion(rdfs:label goldbook:09242 "damage limit")
AnnotationAssertion(dcterms:description goldbook:09242 "Particle fluence above which significant changes in the spectrum or in a stated peak, arising from damage processes, are observed.")
AnnotationAssertion(rdfs:seeAlso goldbook:09242 goldbook:09429)
AnnotationAssertion(mito:isMentionedBy goldbook:09242 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09242 "current"^^xsd:string)
Declaration(Class(goldbook:09243))
AnnotationAssertion(rdfs:label goldbook:09243 "delta layer")
AnnotationAssertion(dcterms:description goldbook:09243 "Layer of discrete composition, one atom thick, formed during the growth of material on a substrate.")
AnnotationAssertion(rdfs:comment goldbook:09243 "These films are often formed during epitaxial growth on single-crystal substrates."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09243 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09243 "current"^^xsd:string)
Declaration(Class(goldbook:09244))
AnnotationAssertion(rdfs:label goldbook:09244 "depth profiling")
AnnotationAssertion(dcterms:description goldbook:09244 "Monitoring of signal intensity as a function of a variable that can be related to distance normal to the surface.")
AnnotationAssertion(rdfs:comment goldbook:09244 "Signal intensity is usually measured as a function of the sputtering time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09244 goldbook:09239)
AnnotationAssertion(mito:isMentionedBy goldbook:09244 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09244 "current"^^xsd:string)
Declaration(Class(goldbook:09245))
AnnotationAssertion(rdfs:label goldbook:09245 "depth resolution parameter")
AnnotationAssertion(dcterms:description goldbook:09245 "Parameter that can be used as a coefficient in an analytic fit to a measured compositional depth profile or as a qualitative way of describing that profile.")
AnnotationAssertion(rdfs:comment goldbook:09245 "Standard deviations can be used for any bell-shaped curve. If parameters are measured for a step change in composition, care must be taken that the depth range for the measurements is large enough to ensure that the signal becomes constant with depth on either side of the step."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09245 "Parameter definitions should be used consistently."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09245 "Depth resolution parameters usually give no indication of distinguishability, but are useful in instrumental evaluation and profile deconvolution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09245 goldbook:09443)
AnnotationAssertion(mito:isMentionedBy goldbook:09245 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09245 "current"^^xsd:string)
Declaration(Class(goldbook:09246))
AnnotationAssertion(rdfs:label goldbook:09246 "elastic scattering cross section")
AnnotationAssertion(dcterms:description goldbook:09246 "Cross section for binary elastic scattering.")
AnnotationAssertion(rdfs:seeAlso goldbook:09246 goldbook:09230)
AnnotationAssertion(mito:isMentionedBy goldbook:09246 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09246 "current"^^xsd:string)
Declaration(Class(goldbook:09247))
AnnotationAssertion(rdfs:label goldbook:09247 "electron flooding")
AnnotationAssertion(dcterms:description goldbook:09247 "Irradiation of a sample with low-energy electrons in order to change or stabilize the charging potential.")
AnnotationAssertion(rdfs:seeAlso goldbook:09247 goldbook:09235)
AnnotationAssertion(mito:isMentionedBy goldbook:09247 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09247 "current"^^xsd:string)
Declaration(Class(goldbook:09248))
AnnotationAssertion(rdfs:label goldbook:09248 "elemental map")
AnnotationAssertion(dcterms:description goldbook:09248 "Surface map using signals proportional to the amount of an element present in a sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09248 goldbook:09293)
AnnotationAssertion(mito:isMentionedBy goldbook:09248 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09248 "current"^^xsd:string)
Declaration(Class(goldbook:09249))
AnnotationAssertion(rdfs:label goldbook:09249 "erosion rate")
AnnotationAssertion(dcterms:description goldbook:09249 "Change in the position of the surface as a result of particle or photon irradiation divided by time of irradiation.")
AnnotationAssertion(rdfs:comment goldbook:09249 "Erosion rate can be deduced from surface profilometer measurements of a crater after analysis. In this case, the effects of the altered layer and post-profile oxidation need to be considered."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09249 "Where the erosion is caused by sputtering, initially the erosion rate can be less than the sputtering rate as a result of the retention of sputtering particles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09249 "The rate can be measured as a velocity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09249 goldbook:09286)
AnnotationAssertion(mito:isMentionedBy goldbook:09249 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09249 "current"^^xsd:string)
Declaration(Class(goldbook:09250))
AnnotationAssertion(rdfs:label goldbook:09250 "field-induced migration")
AnnotationAssertion(dcterms:description goldbook:09250 "Effect occurring in insulators or semi-conductors where internal electric fields cause the migration of sample atoms.")
AnnotationAssertion(mito:isMentionedBy goldbook:09250 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09250 "current"^^xsd:string)
Declaration(Class(goldbook:09251))
AnnotationAssertion(rdfs:label goldbook:09251 "flux of a beam of particles")
AnnotationAssertion(dcterms:description goldbook:09251 "\\(\\mathit{\\Phi} = {\\rm{d}}N/{\\rm{d}}t\\), where \\(N\\) is number of particles of a specified type and \\(t\\) is time.")
AnnotationAssertion(rdfs:comment goldbook:09251 "For a parallel beam, fluence rate and flux density are equivalent measures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09251 "SI unit: \\(\\pu{s^{-1}}\\). For a beam of charged particles (ions) the flux is expressed in ampere, i.e. \\(F \\times ze\\), where \\(z\\) is the charge on a particle and \\(e\\) the elementary charge (\\(\\pu{1.602176634E-19 C}\\))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09251 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09251 "current"^^xsd:string)
Declaration(Class(goldbook:09252))
AnnotationAssertion(rdfs:label goldbook:09252 "focused ion beam system")
AnnotationAssertion(dcterms:description goldbook:09252 "Ion beam system used for machining small regions with sub-micron precision.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09252 "FIB")
AnnotationAssertion(rdfs:comment goldbook:09252 "In general, FIBs use a liquid metal ion source to generate a finely focused ion beam with diameters typically in the range \\(\\pu{7 nm}\\) to \\(\\pu{300 nm}\\) and of sufficient flux, typically \\(\\pu{4 pA}\\) to \\(\\pu{20 pA}\\), to machine small items for study by Auger electron spectroscopy, secondary-ion mass spectrometry, or transmission electron microscopy in an economic time. They are also used to manufacture scanning probe microscopy tips, those for atom force microscopy having radii down to \\(\\pu{2 nm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09252 "FIB-machined surfaces can have an ion-damaged surface that needs to be removed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09252 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09252 goldbook:09260)
AnnotationAssertion(rdfs:seeAlso goldbook:09252 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09252 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09252 "current"^^xsd:string)
Declaration(Class(goldbook:09253))
AnnotationAssertion(rdfs:label goldbook:09253 "fractional sputtering yield")
AnnotationAssertion(dcterms:description goldbook:09253 "Number of atoms and ions of a particular species sputtered from a sample divided by the total number of atoms and ions sputtered from the sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09253 goldbook:09401)
AnnotationAssertion(rdfs:seeAlso goldbook:09253 goldbook:09410)
AnnotationAssertion(rdfs:seeAlso goldbook:09253 goldbook:09265)
AnnotationAssertion(rdfs:seeAlso goldbook:09253 goldbook:09413)
AnnotationAssertion(rdfs:seeAlso goldbook:09253 goldbook:09299)
AnnotationAssertion(mito:isMentionedBy goldbook:09253 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09253 "current"^^xsd:string)
Declaration(Class(goldbook:09254))
AnnotationAssertion(rdfs:label goldbook:09254 "image depth profile")
AnnotationAssertion(dcterms:description goldbook:09254 "Three-dimensional representation of the spatial distribution of a particular elemental or molecular species, as indicated by emitted secondary ions or electrons, as a function of depth or material removed by sputtering.")
AnnotationAssertion(rdfs:seeAlso goldbook:09254 goldbook:09422)
AnnotationAssertion(mito:isMentionedBy goldbook:09254 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09254 "current"^^xsd:string)
Declaration(Class(goldbook:09255))
AnnotationAssertion(rdfs:label goldbook:09255 "impact energy")
AnnotationAssertion(dcterms:description goldbook:09255 "Kinetic energy of particles on impact with a sample surface.")
AnnotationAssertion(rdfs:comment goldbook:09255 "For primary-ion beams in secondary-ion mass spectrometry (SIMS), the ion impact energy is given by the difference in electric potential between the ion source and the sample surface multiplied by the charge on the ion. In some SIMS systems, the beam energy is given for the source potential with respect to ground, but the sample potential need not be at ground. The impact energy takes account of any sample potential."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09255 "Use of the qualifier “impact” indicates that this is the energy of the particles striking the surface."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09255 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09255 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09255 "current"^^xsd:string)
Declaration(Class(goldbook:09256))
AnnotationAssertion(rdfs:label goldbook:09256 "implanted areic dose")
AnnotationAssertion(dcterms:description goldbook:09256 "Number, \\(N_{\\rm{imp}}\\), of energetic particles of a specified type incident on a solid within a surface area \\(A\\) and stopped within the solid divided by \\(A\\). \\(D_{\\rm{imp}} = N_{\\rm{imp}}/A\\).")
AnnotationAssertion(rdfs:comment goldbook:09256 "Particles that are not stopped within the solid are either backscattered or transmitted."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09256 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09256 "current"^^xsd:string)
Declaration(Class(goldbook:09257))
AnnotationAssertion(rdfs:label goldbook:09257 "information depth")
AnnotationAssertion(dcterms:description goldbook:09257 "Maximum depth, normal to the surface, from which useful information is obtained.")
AnnotationAssertion(mito:isMentionedBy goldbook:09257 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09257 "current"^^xsd:string)
Declaration(Class(goldbook:09258))
AnnotationAssertion(rdfs:label goldbook:09258 "information radius")
AnnotationAssertion(dcterms:description goldbook:09258 "Maximum radius of a circular region, in the plane of the surface, from which useful information is obtained.")
AnnotationAssertion(mito:isMentionedBy goldbook:09258 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09258 "current"^^xsd:string)
Declaration(Class(goldbook:09259))
AnnotationAssertion(rdfs:label goldbook:09259 "instrumental depth resolution")
AnnotationAssertion(dcterms:description goldbook:09259 "Depth resolution in a sample arising from parameters of the instrument.")
AnnotationAssertion(rdfs:comment goldbook:09259 "This concept is used in the secondary-ion mass spectrometry, Auger electron spectroscopy, and X-ray photoelectron spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09259 "In sputter depth profiling, these parameters involve the system alignment and can include the ion species, energy, and angle of incidence, as well as the option to rotate the sample while sputtering."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09259 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09259 goldbook:09245)
AnnotationAssertion(rdfs:seeAlso goldbook:09259 goldbook:09244)
AnnotationAssertion(rdfs:seeAlso goldbook:09259 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09259 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09259 "current"^^xsd:string)
Declaration(Class(goldbook:09260))
AnnotationAssertion(rdfs:label goldbook:09260 "ion beam")
AnnotationAssertion(dcterms:description goldbook:09260 "Directed flux of charged atoms or molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:09260 goldbook:09251)
AnnotationAssertion(mito:isMentionedBy goldbook:09260 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09260 "current"^^xsd:string)
Declaration(Class(goldbook:09261))
AnnotationAssertion(rdfs:label goldbook:09261 "ion implantation")
AnnotationAssertion(dcterms:description goldbook:09261 "Injection of ions into a sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:09261 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09261 "current"^^xsd:string)
Declaration(Class(goldbook:09262))
AnnotationAssertion(rdfs:label goldbook:09262 "line scan")
AnnotationAssertion(dcterms:description goldbook:09262 "Plot of output signal intensity from a spectrometer, signal intensity from another detector, or processed intensity information from the available software along a line corresponding to a line on the sample surface.")
AnnotationAssertion(rdfs:comment goldbook:09262 "The line is most often an x- or y-linescan from a rectangular raster, but, in more sophisticated systems, might be in any arbitrary direction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09262 goldbook:09274)
AnnotationAssertion(mito:isMentionedBy goldbook:09262 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09262 "current"^^xsd:string)
Declaration(Class(goldbook:09263))
AnnotationAssertion(rdfs:label goldbook:09263 "matrix factor")
AnnotationAssertion(dcterms:description goldbook:09263 "Factors, arising from the composition of the matrix, for multiplying the quotient of the measured intensity and the appropriate sensitivity factor in formulae to determine the composition using surface analytical techniques.")
AnnotationAssertion(rdfs:comment goldbook:09263 "In methods such as Auger electron spectroscopy, the matrix factor is determined in part by the composition of the sub-surface material and in part by the composition of the analysis volume in the sample."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09263 goldbook:09172)
AnnotationAssertion(mito:isMentionedBy goldbook:09263 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09263 "current"^^xsd:string)
Declaration(Class(goldbook:09264))
AnnotationAssertion(rdfs:label goldbook:09264 "mean escape depth")
AnnotationAssertion(dcterms:description goldbook:09264 "Average depth normal to the surface from which specified particles or radiations escape.")
AnnotationAssertion(mito:isMentionedBy goldbook:09264 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09264 "current"^^xsd:string)
Declaration(Class(goldbook:09265))
AnnotationAssertion(rdfs:label goldbook:09265 "partial sputtering yield")
AnnotationAssertion(dcterms:description goldbook:09265 "Number of atoms and ions of a particular species sputtered from a sample divided by the total number of incident particles.")
AnnotationAssertion(rdfs:seeAlso goldbook:09265 goldbook:09401)
AnnotationAssertion(rdfs:seeAlso goldbook:09265 goldbook:09253)
AnnotationAssertion(rdfs:seeAlso goldbook:09265 goldbook:09410)
AnnotationAssertion(rdfs:seeAlso goldbook:09265 goldbook:09413)
AnnotationAssertion(rdfs:seeAlso goldbook:09265 goldbook:09299)
AnnotationAssertion(mito:isMentionedBy goldbook:09265 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09265 "current"^^xsd:string)
Declaration(Class(goldbook:09266))
AnnotationAssertion(rdfs:label goldbook:09266 "peak energy")
AnnotationAssertion(dcterms:description goldbook:09266 "Energy value corresponding to the intensity maximum in a direct spectrum or to the intensity minimum (i.e. the negative excursion) for a differential spectrum.")
AnnotationAssertion(rdfs:comment goldbook:09266 "The energy value can relate to the peak envelope for a group of overlapping peaks or to the positions of constituent peaks obtained by peak synthesis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09266 "For the differential spectrum in Auger electron spectroscopy (AES), the modulation, or differentiating amplitude should be given."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09266 "Peak energies for the differential spectrum in AES have greater kinetic energy than those for the direct spectrum."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09266 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09266 goldbook:09319)
AnnotationAssertion(rdfs:seeAlso goldbook:09266 goldbook:09320)
AnnotationAssertion(mito:isMentionedBy goldbook:09266 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09266 "current"^^xsd:string)
Declaration(Class(goldbook:09267))
AnnotationAssertion(rdfs:label goldbook:09267 "photoionization cross section")
AnnotationAssertion(dcterms:description goldbook:09267 "Total ionization cross section for an incident photon of a given energy interacting with a material to produce one or more photoelectrons from all sub-shells that are energetically accessible.")
AnnotationAssertion(rdfs:seeAlso goldbook:09267 goldbook:09357)
AnnotationAssertion(mito:isMentionedBy goldbook:09267 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09267 "current"^^xsd:string)
Declaration(Class(goldbook:09268))
AnnotationAssertion(rdfs:label goldbook:09268 "plasmon")
AnnotationAssertion(dcterms:description goldbook:09268 "Excitation of valence-band electrons in a solid in which collective oscillations are generated.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09268 "bulk plasmon")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09268 "volume plasmon")
AnnotationAssertion(rdfs:comment goldbook:09268 "Plasmon excitations are often observed as characteristic energy loss peaks associated with other peaks in the spectrum, such as those of any elastically scattered primary electrons, photoelectron peaks, Auger electron peaks, and ionization edges."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09268 "Plasmons are prominent in some materials and not others."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09268 "Two types of plasmon are commonly observed: bulk plasmons, associated with material remote from the surface, and surface plasmons, associated with material at the surface. When the term plasmon is used without a qualifier, the term refers to the bulk plasmon. Occasionally, interface plasmons can be observed that are associated with interfaces. Bulk plasmon energies depend on the electronic structure of the material and are roughly proportional to the square root of valence-band density. Surface plasmon energies are typically between \\(\\pu{50\\%}\\) and \\(\\pu{90\\%}\\) of bulk plasmon energies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09268 goldbook:09315)
AnnotationAssertion(mito:isMentionedBy goldbook:09268 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09268 "current"^^xsd:string)
Declaration(Class(goldbook:09269))
AnnotationAssertion(rdfs:label goldbook:09269 "preferential sputtering")
AnnotationAssertion(dcterms:description goldbook:09269 "Change in equilibrium surface composition of the sample, which can occur when sputtering multicomponent samples.")
AnnotationAssertion(mito:isMentionedBy goldbook:09269 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09269 "current"^^xsd:string)
Declaration(Class(goldbook:09270))
AnnotationAssertion(rdfs:label goldbook:09270 "primary beam")
AnnotationAssertion(dcterms:description goldbook:09270 "Directed flux of beam particles or photons incident on a sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09270 goldbook:09251)
AnnotationAssertion(mito:isMentionedBy goldbook:09270 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09270 "current"^^xsd:string)
Declaration(Class(goldbook:09271))
AnnotationAssertion(rdfs:label goldbook:09271 "projected range")
AnnotationAssertion(dcterms:description goldbook:09271 "Distance from the surface at which an energetic ion or atom comes to rest in the sample, projected along the direction of the beam.")
AnnotationAssertion(rdfs:comment goldbook:09271 "Used in energetic-ion analysis, Rutherford backscattering spectrometry, and secondary-ion mass spectrometry."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09271 "Calculations usually deal with the mean or average projected range for a large number of ions or atoms of the same species and the same energy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09271 goldbook:09178)
AnnotationAssertion(rdfs:seeAlso goldbook:09271 goldbook:09273)
AnnotationAssertion(rdfs:seeAlso goldbook:09271 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09271 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09271 "current"^^xsd:string)
Declaration(Class(goldbook:09272))
AnnotationAssertion(rdfs:label goldbook:09272 "radial sectioning")
AnnotationAssertion(dcterms:description goldbook:09272 "Sample preparation in which a sample is polished by a cylinder in order to expose compositional changes below the original sample surface, with the intent that the depth of these layers can be related to the position on the surface created by the cylinder.")
AnnotationAssertion(mito:isMentionedBy goldbook:09272 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09272 "current"^^xsd:string)
Declaration(Class(goldbook:09273))
AnnotationAssertion(rdfs:label goldbook:09273 "range straggling")
AnnotationAssertion(dcterms:description goldbook:09273 "Standard deviation of the projected ranges of energetic ions or atoms of a given energy.")
AnnotationAssertion(rdfs:comment goldbook:09273 "Used in energetic-ion analysis, Rutherford backscattering spectrometry, and secondary-ion mass spectrometry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09273 goldbook:09178)
AnnotationAssertion(rdfs:seeAlso goldbook:09273 goldbook:09271)
AnnotationAssertion(rdfs:seeAlso goldbook:09273 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09273 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09273 "current"^^xsd:string)
Declaration(Class(goldbook:09274))
AnnotationAssertion(rdfs:label goldbook:09274 "raster")
AnnotationAssertion(dcterms:description goldbook:09274 "Two-dimensional pattern generated by the deflection of a primary beam.")
AnnotationAssertion(rdfs:comment goldbook:09274 "Commonly used rasters cover square or rectangular areas."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09274 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09274 "current"^^xsd:string)
Declaration(Class(goldbook:09275))
AnnotationAssertion(rdfs:label goldbook:09275 "redeposition")
AnnotationAssertion(dcterms:description goldbook:09275 "Deposition of sputtered sample material back onto the sample surface.")
AnnotationAssertion(mito:isMentionedBy goldbook:09275 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09275 "current"^^xsd:string)
Declaration(Class(goldbook:09276))
AnnotationAssertion(rdfs:label goldbook:09276 "relative instrument spectral response function")
AnnotationAssertion(dcterms:description goldbook:09276 "In Auger electron spectroscopy (AES), secondary-ion mass spectrometry, and X-ray photoelectron spectroscopy, the spectrometer response function divided by the response function of a reference instrument, or the average for several such instruments, as a function of energy (AES, XPS, etc.) or mass (SIMS).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09276 "RISR")
AnnotationAssertion(rdfs:comment goldbook:09276 "The RISR can be used to relate spectra from one instrument to spectra from another when using similar excitation sources and geometries."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09276 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09276 goldbook:09192)
AnnotationAssertion(rdfs:seeAlso goldbook:09276 goldbook:09283)
AnnotationAssertion(mito:isMentionedBy goldbook:09276 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09276 "current"^^xsd:string)
Declaration(Class(goldbook:09277))
AnnotationAssertion(rdfs:label goldbook:09277 "relative resolution")
AnnotationAssertion(dcterms:description goldbook:09277 "Resolution of a spectrometer at a given energy, mass, or wavelength divided by that energy, mass, or wavelength.")
AnnotationAssertion(rdfs:comment goldbook:09277 "The relative resolution of a spectrometer is the reciprocal of the resolving power of a spectrometer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09277 "It can be convenient to specify the relative energy resolution of an electron spectrometer, the relative mass resolution of a mass spectrometer, or the relative wavelength resolution of an optical spectrometer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09277 "In practice, the relative resolution of a spectrometer can be deduced using a source with an emission line of known width, usually chosen to be as narrow as possible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09277 "Designs of spectrometer generally maintain the resolution either to be constant throughout the spectrum or to be proportional to the energy, mass, or wavelength being scanned. For the former, the term resolution is useful, whereas, for the latter, the relative resolution or resolving power is more useful."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09277 "The relative resolution is often expressed as a percentage."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09277 goldbook:09329)
AnnotationAssertion(mito:isMentionedBy goldbook:09277 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09277 "current"^^xsd:string)
Declaration(Class(goldbook:09278))
AnnotationAssertion(rdfs:label goldbook:09278 "relative sputtering rate")
AnnotationAssertion(dcterms:description goldbook:09278 "Sputtering rate of a sample divided by the sputtering rate of a reference sample sputtered under the same conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09278 goldbook:09286)
AnnotationAssertion(mito:isMentionedBy goldbook:09278 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09278 "current"^^xsd:string)
Declaration(Class(goldbook:09279))
AnnotationAssertion(rdfs:label goldbook:09279 "sample bias")
AnnotationAssertion(dcterms:description goldbook:09279 "Electric potential applied to the whole or part of the sample, referenced to the electric potential of the sample holder.")
AnnotationAssertion(rdfs:seeAlso goldbook:09279 goldbook:09281)
AnnotationAssertion(mito:isMentionedBy goldbook:09279 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09279 "current"^^xsd:string)
Declaration(Class(goldbook:09280))
AnnotationAssertion(rdfs:label goldbook:09280 "sample charging")
AnnotationAssertion(dcterms:description goldbook:09280 "Change in the electrical potential in the sample or on the sample surface caused by particle or photon bombardment.")
AnnotationAssertion(mito:isMentionedBy goldbook:09280 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09280 "current"^^xsd:string)
Declaration(Class(goldbook:09281))
AnnotationAssertion(rdfs:label goldbook:09281 "sample voltage")
AnnotationAssertion(dcterms:description goldbook:09281 "Electric potential difference of the sample referenced to ground.")
AnnotationAssertion(rdfs:comment goldbook:09281 "The sample voltage can be pulsed or constant, depending on the type of instrument."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09281 "For insulators, the sample voltage is assumed to be the same as that of the sample holder if an effective charge neutralizing device is used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09281 goldbook:09279)
AnnotationAssertion(mito:isMentionedBy goldbook:09281 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09281 "current"^^xsd:string)
Declaration(Class(goldbook:09282))
AnnotationAssertion(rdfs:label goldbook:09282 "solid angle of analyser")
AnnotationAssertion(dcterms:description goldbook:09282 "Solid angle allowing particles or photons to be transmitted from a point on the sample to the detector.")
AnnotationAssertion(mito:isMentionedBy goldbook:09282 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09282 "current"^^xsd:string)
Declaration(Class(goldbook:09283))
AnnotationAssertion(rdfs:label goldbook:09283 "spectrometer response function")
AnnotationAssertion(dcterms:description goldbook:09283 "Number of particles detected with a spectrometer divided by the number of such particles per solid angle and per interval of the dispersing parameter available for measurement as a function of the dispersing parameter.")
AnnotationAssertion(rdfs:seeAlso goldbook:09283 goldbook:09284)
AnnotationAssertion(mito:isMentionedBy goldbook:09283 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09283 "current"^^xsd:string)
Declaration(Class(goldbook:09284))
AnnotationAssertion(rdfs:label goldbook:09284 "spectrometer transmission function")
AnnotationAssertion(dcterms:description goldbook:09284 "Number of particles transmitted by the analyser divided by the number of such particles per solid angle and per interval of the dispersing parameter (e.g. energy, mass, or wavelength) available for measurement as a function of the dispersing parameter.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09284 "analyser transmission function")
AnnotationAssertion(rdfs:seeAlso goldbook:09284 goldbook:09283)
AnnotationAssertion(mito:isMentionedBy goldbook:09284 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09284 "current"^^xsd:string)
Declaration(Class(goldbook:09285))
AnnotationAssertion(rdfs:label goldbook:09285 "sputter depth profile")
AnnotationAssertion(dcterms:description goldbook:09285 "Compositional depth profile obtained when the surface composition is measured while material is removed by sputtering.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09285 "SDP")
AnnotationAssertion(rdfs:comment goldbook:09285 "In some analytical methods, such as secondary ion mass spectrometry, the sputtering is often accomplished by the ion beam used for analysis, but in other methods an ion beam might need to be added."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09285 goldbook:09260)
AnnotationAssertion(rdfs:seeAlso goldbook:09285 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09285 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09285 "current"^^xsd:string)
Declaration(Class(goldbook:09286))
AnnotationAssertion(rdfs:label goldbook:09286 "sputtering rate")
AnnotationAssertion(dcterms:description goldbook:09286 "Amount, mass, or number of entities of sample material removed, as a result of particle bombardment, per unit time.")
AnnotationAssertion(rdfs:comment goldbook:09286 "SI unit: \\(\\pu{mol s^{-1}}\\), \\(\\pu{kg s^{-1}}\\), \\(\\pu{s^{-1}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09286 goldbook:09249)
AnnotationAssertion(mito:isMentionedBy goldbook:09286 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09286 "current"^^xsd:string)
Declaration(Class(goldbook:09287))
AnnotationAssertion(rdfs:label goldbook:09287 "sputtering yield")
AnnotationAssertion(dcterms:description goldbook:09287 "Number of atoms and ions sputtered from a sample divided by the total number of incident primary particles.")
AnnotationAssertion(mito:isMentionedBy goldbook:09287 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09287 "current"^^xsd:string)
Declaration(Class(goldbook:09288))
AnnotationAssertion(rdfs:label goldbook:09288 "standard vacuum level")
AnnotationAssertion(dcterms:description goldbook:09288 "Electric potential \\(\\pu{4.500 eV}\\) above the Fermi level.")
AnnotationAssertion(rdfs:comment goldbook:09288 "The Fermi level is an absolute level to which electron kinetic energies can be accurately referenced. Historically, in Auger electron spectroscopy, the electron energies have not been referenced to the Fermi level but, instead, have been referenced to the instrument vacuum level. This level varies from instrument to instrument and does not provide a consistent reference level. However, most reported Auger electron kinetic energies have been referenced to the vacuum level, and most analysts are familiar with the variations that occur from one instrument to another for energies referenced in this way. By convention, the standard vacuum level is defined, as above, to be a consistent reference level close to the value for typical instrument vacuum levels. Energies referenced to the standard vacuum level are consistent and are within approximately \\(\\pu{1 eV}\\) of those referenced to individual instrument vacuum levels."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09288 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09288 goldbook:09300)
AnnotationAssertion(mito:isMentionedBy goldbook:09288 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09288 "current"^^xsd:string)
Declaration(Class(goldbook:09289))
AnnotationAssertion(rdfs:label goldbook:09289 "steady-state sputtering")
AnnotationAssertion(dcterms:description goldbook:09289 "State of the sputtering process in which important operational and analytical parameters are unchanging over a meaningful timescale.")
AnnotationAssertion(rdfs:comment goldbook:09289 "Generally, steady state and stoichiometric sputtering are equivalent but, in profiling dilute delta layers in semiconductors, for example, the sputtering can be at a steady state while the constituents being studied are not being sputtered in their stoichiometric ratio."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09289 goldbook:09243)
AnnotationAssertion(rdfs:seeAlso goldbook:09289 goldbook:09291)
AnnotationAssertion(mito:isMentionedBy goldbook:09289 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09289 "current"^^xsd:string)
Declaration(Class(goldbook:09290))
AnnotationAssertion(rdfs:label goldbook:09290 "steady-state surface composition sputtering")
AnnotationAssertion(dcterms:description goldbook:09290 "Steady-state surface composition produced by sputtering a homogeneous sample under non-varying conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09290 "equilibrium surface composition sputtering")
AnnotationAssertion(mito:isMentionedBy goldbook:09290 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09290 "current"^^xsd:string)
Declaration(Class(goldbook:09291))
AnnotationAssertion(rdfs:label goldbook:09291 "stoichiometric sputtering")
AnnotationAssertion(dcterms:description goldbook:09291 "State of the sputtering process in which the relative amounts of the elemental components sputtered from a sample are equal to their stoichiometry within the sample.")
AnnotationAssertion(rdfs:comment goldbook:09291 "For most homogeneous materials, stoichiometric sputtering is attained after the sputter removal of a few nanometres from the surface."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09291 goldbook:09289)
AnnotationAssertion(mito:isMentionedBy goldbook:09291 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09291 "current"^^xsd:string)
Declaration(Class(goldbook:09292))
AnnotationAssertion(rdfs:label goldbook:09292 "surface excess amount")
AnnotationAssertion(dcterms:description goldbook:09292 "For an interface, the difference between the amount of component actually present in the system and that which would be present (in a reference system) if the bulk concentration in the adjoining phases were maintained up to a chosen geometrical dividing surface (Gibbs dividing surface).")
AnnotationAssertion(rdfs:comment goldbook:09292 "For a solid/liquid interface in which no component of the liquid phase penetrates into the solid, the surface excess (or adsorption) of component \\(i\\) is defined as; \\(n_{i}^{\\upsigma} = n_{i} - V^{\\rm{l}} {c}_{i}^{\\rm{l}}\\), where \\(n_{i}\\) is the total amount of \\(i\\) in the system, \\(V^{\\rm{l}}\\) is the volume of an arbitrarily chosen amount of bulk liquid (in the framework of the so-called algebraic method), and \\({c}_{i}^{\\rm{l}}\\) is its bulk concentration in the liquid."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09292 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09292 "current"^^xsd:string)
Declaration(Class(goldbook:09293))
AnnotationAssertion(rdfs:label goldbook:09293 "surface map")
AnnotationAssertion(dcterms:description goldbook:09293 "Two- or three-dimensional representation of the sample surface where the information at each point in the representation, given by a brightness or colour or as a length in a third dimension, is related to the output signal from a detector or processed intensity information from the available software.")
AnnotationAssertion(rdfs:seeAlso goldbook:09293 goldbook:09236)
AnnotationAssertion(rdfs:seeAlso goldbook:09293 goldbook:09248)
AnnotationAssertion(mito:isMentionedBy goldbook:09293 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09293 "current"^^xsd:string)
Declaration(Class(goldbook:09294))
AnnotationAssertion(rdfs:label goldbook:09294 "surface plasmon")
AnnotationAssertion(dcterms:description goldbook:09294 "Collective motion of electrons on an interface of two phases which have different permittivity, of which one must have electrical conductivity to sustain the collective motion.")
AnnotationAssertion(rdfs:comment goldbook:09294 "Metals such as silver and gold are well known examples of materials exhibiting surface plasmon behaviour."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09294 "Collective motion of electrons is induced by an injection of energetic particles, for example photons, electrons, ions, or alpha particles."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09294 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09294 "current"^^xsd:string)
Declaration(Class(goldbook:09295))
AnnotationAssertion(rdfs:label goldbook:09295 "surface segregation")
AnnotationAssertion(dcterms:description goldbook:09295 "Partitioning of a species from the bulk of a material to the surface as a result of kinetic or thermodynamic effects.")
AnnotationAssertion(mito:isMentionedBy goldbook:09295 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09295 "current"^^xsd:string)
Declaration(Class(goldbook:09296))
AnnotationAssertion(rdfs:label goldbook:09296 "take-off angle")
AnnotationAssertion(dcterms:description goldbook:09296 "Angle between the trajectory of a particle as it leaves a surface and the local or average surface plane.")
AnnotationAssertion(rdfs:comment goldbook:09296 "The particular surface plane needs to be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09296 "The take-off angle is the complement of the angle of emission."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09296 "In the past, ‘take-off angle’ has sometimes been used erroneously to mean angle of emission."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09296 goldbook:09221)
AnnotationAssertion(mito:isMentionedBy goldbook:09296 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09296 "current"^^xsd:string)
Declaration(Class(goldbook:09297))
AnnotationAssertion(rdfs:label goldbook:09297 "thermionic work function")
AnnotationAssertion(dcterms:description goldbook:09297 "Parameter describing the apparent work function of a solid that controls the electronic current density, \\(J\\), emitted from a conductor at temperature \\(T\\). \\(W = -kT\\ln(J/AT^{2})\\), where \\(k\\) is the Boltzmann constant and \\(A\\) is the Richardson constant.")
AnnotationAssertion(rdfs:comment goldbook:09297 "For polycrystalline solids, the thermionic work function will be close to the minimum work function of the crystallites present."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09297 "Richardson constant, \\(A = (4\\uppi m_{\\rm{e}} k^{2} e)/h^{3} \\approx \\pu{1.202E6 A m-2 K-2}\\) where \\(m_{\\rm{e}}\\) is the mass of the electron, \\(e\\) the elementary charge, and \\(h\\) is the Planck constant."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09297 goldbook:09345)
AnnotationAssertion(mito:isMentionedBy goldbook:09297 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09297 "current"^^xsd:string)
Declaration(Class(goldbook:09298))
AnnotationAssertion(rdfs:label goldbook:09298 "topographic contrast")
AnnotationAssertion(dcterms:description goldbook:09298 "Contrast in a surface map or image arising from the topography of the sample surface.")
AnnotationAssertion(rdfs:comment goldbook:09298 "Topographic effects can modify the interaction between the primary beam and the sample, making the interpretation of electron or ion yield data more complex than otherwise."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09298 "Topographic contrast can change after ion sputtering."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09298 goldbook:09293)
AnnotationAssertion(mito:isMentionedBy goldbook:09298 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09298 "current"^^xsd:string)
Declaration(Class(goldbook:09299))
AnnotationAssertion(rdfs:label goldbook:09299 "total ion yield")
AnnotationAssertion(dcterms:description goldbook:09299 "Number of ions of both signs sputtered from a sample divided by the number of incident particles.")
AnnotationAssertion(rdfs:seeAlso goldbook:09299 goldbook:09401)
AnnotationAssertion(rdfs:seeAlso goldbook:09299 goldbook:09253)
AnnotationAssertion(rdfs:seeAlso goldbook:09299 goldbook:09410)
AnnotationAssertion(rdfs:seeAlso goldbook:09299 goldbook:09411)
AnnotationAssertion(rdfs:seeAlso goldbook:09299 goldbook:09265)
AnnotationAssertion(rdfs:seeAlso goldbook:09299 goldbook:09413)
AnnotationAssertion(mito:isMentionedBy goldbook:09299 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09299 "current"^^xsd:string)
Declaration(Class(goldbook:09300))
AnnotationAssertion(rdfs:label goldbook:09300 "vacuum level")
AnnotationAssertion(dcterms:description goldbook:09300 "Energy level of an electron positioned at rest just outside a solid, i.e. with zero kinetic energy with respect to the sample surface.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09300 "local vacuum level")
AnnotationAssertion(rdfs:comment goldbook:09300 "‘Just outside’ has also been written as “a few nanometers”, and is taken as a distance where there is no effect of image forces but that is sufficient for the electron to experience the full impact of the surface dipole."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09300 "The vacuum level depends on the nature of the surface; for example, it is different between surface crystal planes \\(\\ce{Si}[001]\\) and \\(\\ce{Si}[111]\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09300 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09300 "current"^^xsd:string)
Declaration(Class(goldbook:09301))
AnnotationAssertion(rdfs:label goldbook:09301 "vacuum level at infinity")
AnnotationAssertion(dcterms:description goldbook:09301 "Electric potential of the vacuum at a point in space.")
AnnotationAssertion(rdfs:comment goldbook:09301 "In electron spectroscopy, the point in space is taken at a sufficiently large distance outside the sample, such that electric fields caused by different work functions of different parts of the surface are zero or extremely small."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09301 "This level is not experimentally accessible."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09301 goldbook:09300)
AnnotationAssertion(mito:isMentionedBy goldbook:09301 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09301 "current"^^xsd:string)
Declaration(Class(goldbook:09302))
AnnotationAssertion(rdfs:label goldbook:09302 "volume yield")
AnnotationAssertion(dcterms:description goldbook:09302 "Volume sputtered from a sample divided by number of incident particles.")
AnnotationAssertion(rdfs:comment goldbook:09302 "Volume yield is useful for expressing the amount sputtered in organic layers where molecules can be easily fragmented and values of the molecular sputtering yield can be much more variable between samples than the volume yield."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09302 goldbook:09401)
AnnotationAssertion(rdfs:seeAlso goldbook:09302 goldbook:09253)
AnnotationAssertion(rdfs:seeAlso goldbook:09302 goldbook:09410)
AnnotationAssertion(rdfs:seeAlso goldbook:09302 goldbook:09265)
AnnotationAssertion(rdfs:seeAlso goldbook:09302 goldbook:09413)
AnnotationAssertion(mito:isMentionedBy goldbook:09302 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09302 "current"^^xsd:string)
Declaration(Class(goldbook:09303))
AnnotationAssertion(rdfs:label goldbook:09303 "X-ray linewidth")
AnnotationAssertion(dcterms:description goldbook:09303 "Energy width of the principal characteristic X-ray line.")
AnnotationAssertion(rdfs:comment goldbook:09303 "In X-ray photoelectron spectroscopy the X-ray linewidth usually refers to that of the X-ray source."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09303 "X-ray linewidth contributes to the photoelectron peak widths."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09303 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09303 "current"^^xsd:string)
Declaration(Class(goldbook:09304))
AnnotationAssertion(rdfs:label goldbook:09304 "X-ray monochromator")
AnnotationAssertion(dcterms:description goldbook:09304 "Device used to eliminate photons of energies other than those in a narrow energy or wavelength band.")
AnnotationAssertion(rdfs:comment goldbook:09304 "For X-ray photoelectron spectroscopy using \\(\\ce{Al}\\) X-rays, the monochromator is usually aligned close to the \\(\\ce{Al}\\) \\(\\ce{K}\\upalpha_{1}\\) energy."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09304 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09304 "current"^^xsd:string)
Declaration(Class(goldbook:09305))
AnnotationAssertion(rdfs:label goldbook:09305 "adventitious carbon referencing")
AnnotationAssertion(dcterms:description goldbook:09305 "In X-ray photoelectron spectroscopy, measurement of the charging potential of a particular sample from a comparison of the experimentally measured \\(\\ce{C 1s}\\) binding energy, arising from adsorbed hydrocarbons on the sample, with a standard binding energy value.")
AnnotationAssertion(rdfs:comment goldbook:09305 "A nominal value of \\(\\pu{285.0 eV}\\) is often used for the binding energy of the relevant \\(\\ce{C 1s}\\) peak, although some analysts prefer specific values in the range \\(\\pu{284.6 eV}\\) to \\(\\pu{285.2 eV}\\), depending on the nature of the substrate. This method does not determine the true charging potential, since the true binding energy of the adsorbed hydrocarbons is not known."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09305 "Different sample charging potentials can occur on different areas on the surface, or at different depths, arising, for example, from sample inhomogeneities or non-uniform intensity of the incident-radiation flux."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09305 goldbook:09332)
AnnotationAssertion(rdfs:seeAlso goldbook:09305 goldbook:09235)
AnnotationAssertion(mito:isMentionedBy goldbook:09305 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09305 "current"^^xsd:string)
Declaration(Class(goldbook:09306))
AnnotationAssertion(rdfs:label goldbook:09306 "asymmetry parameter")
AnnotationAssertion(dcterms:description goldbook:09306 "In X-ray photoelectron spectroscopy factor which characterizes the intensity distribution, \\(L(\\gamma)\\), of photoelectrons ejected by X-rays from isolated atoms at an angle \\(\\gamma\\) from the incident X-ray direction. In the dipole approximation, \\(L(\\gamma) = 1 + ½\\beta [3(\\sin^{2}\\gamma)/2-1]\\).")
AnnotationAssertion(rdfs:comment goldbook:09306 "This formula relates to gases and is modified by the effects of elastic scattering when applied to solids. At the magic angle, \\(L(\\gamma) = 1\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09306 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09306 "current"^^xsd:string)
Declaration(Class(goldbook:09307))
AnnotationAssertion(rdfs:label goldbook:09307 "Auger electron spectrum")
AnnotationAssertion(dcterms:description goldbook:09307 "Plot of intensity of Auger electrons as a function of the electron kinetic energy, usually as part of the energy distribution of detected electrons.")
AnnotationAssertion(rdfs:comment goldbook:09307 "When excited by incident electrons, the energy distribution of detected electrons, often measured between \\(\\pu{0 eV}\\) and \\(\\pu{2500 eV}\\), contains Auger electrons, backscattered (primary) electrons, and secondary electrons. The entire distribution is sometimes referred to as an Auger electron spectrum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09307 "The Auger electron spectrum can be presented in either direct spectrum or differential spectrum formats."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09307 goldbook:09311)
AnnotationAssertion(rdfs:seeAlso goldbook:09307 goldbook:09319)
AnnotationAssertion(rdfs:seeAlso goldbook:09307 goldbook:09320)
AnnotationAssertion(mito:isMentionedBy goldbook:09307 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09307 "current"^^xsd:string)
Declaration(Class(goldbook:09308))
AnnotationAssertion(rdfs:label goldbook:09308 "Auger parameter")
AnnotationAssertion(dcterms:description goldbook:09308 "Kinetic energy of a narrow Auger electron peak in a spectrum minus the kinetic energy of the most intense X-ray photoelectron peak from the same element.")
AnnotationAssertion(rdfs:comment goldbook:09308 "The value of the Auger parameter depends on the energy of the X-rays, which therefore needs to be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09308 "The Auger parameter is sometimes called the final state Auger parameter (see initial state Auger parameter)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09308 "The Auger parameter is useful for separating chemical states for samples in which charging causes uncertainty in the binding energy measurement or in which the binding energy shift is inadequate to identify the chemical state."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09308 "The Auger parameter is useful for evaluating the relaxation energy of the ionized matrix atom associated with the generation of a core hole for those Auger transitions between core levels, which have similar chemical shifts."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09308 goldbook:09339)
AnnotationAssertion(rdfs:seeAlso goldbook:09308 goldbook:09343)
AnnotationAssertion(rdfs:seeAlso goldbook:09308 goldbook:09350)
AnnotationAssertion(mito:isMentionedBy goldbook:09308 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09308 "current"^^xsd:string)
Declaration(Class(goldbook:09309))
AnnotationAssertion(rdfs:label goldbook:09309 "Auger vacancy satellite")
AnnotationAssertion(dcterms:description goldbook:09309 "Emission of an Auger electron in which additional spectator holes are present in the initial state or the final state) for the transition.")
AnnotationAssertion(rdfs:seeAlso goldbook:09309 goldbook:09333)
AnnotationAssertion(rdfs:seeAlso goldbook:09309 goldbook:09337)
AnnotationAssertion(rdfs:seeAlso goldbook:09309 goldbook:09356)
AnnotationAssertion(mito:isMentionedBy goldbook:09309 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09309 "current"^^xsd:string)
Declaration(Class(goldbook:09310))
AnnotationAssertion(rdfs:label goldbook:09310 "average matrix relative sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09310 "Coefficient, proportional to the intensity, calculated for an element in an average matrix, by which the measured intensity for that element is divided in calculations to yield the atomic concentration or atomic fraction of the element present in the sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09310 "AMRSF")
AnnotationAssertion(rdfs:comment goldbook:09310 "The choice of atomic concentration or atomic fraction should be made clear."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09310 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09310 "current"^^xsd:string)
Declaration(Class(goldbook:09311))
AnnotationAssertion(rdfs:label goldbook:09311 "backscattered electron")
AnnotationAssertion(dcterms:description goldbook:09311 "Electron, originating in the incident beam, which is emitted after interaction with the sample.")
AnnotationAssertion(rdfs:comment goldbook:09311 "By convention, an electron with energy greater than \\(\\pu{50 eV}\\) can be considered a backscattered electron."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09311 "By convention, the incident beam is often called the primary beam and the backscattered electrons are often referred to as the backscattered primary electrons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09311 goldbook:09270)
AnnotationAssertion(mito:isMentionedBy goldbook:09311 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09311 "current"^^xsd:string)
Declaration(Class(goldbook:09312))
AnnotationAssertion(rdfs:label goldbook:09312 "backscattering correction factor")
AnnotationAssertion(dcterms:description goldbook:09312 "In Auger electron spectroscopy, factor equal to the total Auger-electron current arising from ionizations in the sample caused by both primary electrons and backscattered electrons divided by the Auger-electron current arising directly from the primary electrons.")
AnnotationAssertion(rdfs:comment goldbook:09312 "‘Backscattering correction factor’ is preferred to the contraction ‘backscattering factor’."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09312 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09312 goldbook:09311)
AnnotationAssertion(mito:isMentionedBy goldbook:09312 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09312 "current"^^xsd:string)
Declaration(Class(goldbook:09313))
AnnotationAssertion(rdfs:label goldbook:09313 "backscattering fraction")
AnnotationAssertion(dcterms:description goldbook:09313 "In Auger electron spectroscopy, Auger-electron current arising from ionizations in the sample caused by backscattered electrons divided by Auger-electron current arising directly from the primary electrons.")
AnnotationAssertion(rdfs:seeAlso goldbook:09313 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09313 goldbook:09311)
AnnotationAssertion(mito:isMentionedBy goldbook:09313 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09313 "current"^^xsd:string)
Declaration(Class(goldbook:09314))
AnnotationAssertion(rdfs:label goldbook:09314 "backscattering yield")
AnnotationAssertion(dcterms:description goldbook:09314 "Number of electrons emitted from the sample with energies greater than \\(\\pu{50 eV}\\) divided by the number of electrons incident at a given energy and angle of incidence.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09314 "backscattering coefficient")
AnnotationAssertion(rdfs:seeAlso goldbook:09314 goldbook:09312)
AnnotationAssertion(rdfs:seeAlso goldbook:09314 goldbook:09423)
AnnotationAssertion(rdfs:seeAlso goldbook:09314 goldbook:09359)
AnnotationAssertion(mito:isMentionedBy goldbook:09314 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09314 "current"^^xsd:string)
Declaration(Class(goldbook:09315))
AnnotationAssertion(rdfs:label goldbook:09315 "characteristic electron energy losses")
AnnotationAssertion(dcterms:description goldbook:09315 "Inelastic scattering of electrons in solids that produces a non-uniform energy loss spectrum determined by the characteristics of the material.")
AnnotationAssertion(mito:isMentionedBy goldbook:09315 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09315 "current"^^xsd:string)
Declaration(Class(goldbook:09316))
AnnotationAssertion(rdfs:label goldbook:09316 "charge referencing")
AnnotationAssertion(dcterms:description goldbook:09316 "Measurement of charging potential of a sample in order to correct the measured energies so that those energies correspond to a sample with no surface charge.")
AnnotationAssertion(rdfs:comment goldbook:09316 "Charge referencing is often conducted using adventitious carbon referencing, using internal carbon referencing or by gold decoration, or by referencing to the substrate when grounded."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09316 "Different charging potentials can occur on different areas or at different depths in a sample, arising, for example, from sample inhomogeneities or the non-uniform intensity of the incident flux of radiation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09316 goldbook:09305)
AnnotationAssertion(rdfs:seeAlso goldbook:09316 goldbook:09235)
AnnotationAssertion(rdfs:seeAlso goldbook:09316 goldbook:09251)
AnnotationAssertion(mito:isMentionedBy goldbook:09316 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09316 "current"^^xsd:string)
Declaration(Class(goldbook:09317))
AnnotationAssertion(rdfs:label goldbook:09317 "chemical state")
AnnotationAssertion(dcterms:description goldbook:09317 "State of an atom arising from its chemical interaction with neighbouring atoms in a molecule, compound, solid, liquid, or gas that leads to a characteristic energy or feature observable in electron spectroscopy.")
AnnotationAssertion(mito:isMentionedBy goldbook:09317 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09317 "current"^^xsd:string)
Declaration(Class(goldbook:09318))
AnnotationAssertion(rdfs:label goldbook:09318 "chemical state plot")
AnnotationAssertion(dcterms:description goldbook:09318 "In X-ray photoelectron spectroscopy, plot of the measured kinetic energy of a sharp Auger electron peak versus the binding energy of a photoelectron peak for the same element.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09318 "Wagner plot")
AnnotationAssertion(rdfs:comment goldbook:09318 "Plots are usually made for a given element that can exist in different chemical states. Such plots are helpful in defining the state for an unknown sample, where measurements of the binding energy alone are inadequate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09318 "The binding energy is usually plotted on the abscissa, with values decreasing towards the right."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09318 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09318 "current"^^xsd:string)
Declaration(Class(goldbook:09319))
AnnotationAssertion(rdfs:label goldbook:09319 "differential spectrum")
AnnotationAssertion(dcterms:description goldbook:09319 "Differential of a direct spectrum with respect to energy by an analogue electrode modulation method or by the numerical differentiation of that spectrum.")
AnnotationAssertion(rdfs:comment goldbook:09319 "Used in Auger electron spectroscopy and, rarely, in X-ray photoelectron spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09319 "The modulation amplitude (for example in unit \\(\\pu{eV}\\)) or the number of points and the type of differentiating function should be given."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09319 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09319 goldbook:09320)
AnnotationAssertion(mito:isMentionedBy goldbook:09319 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09319 "current"^^xsd:string)
Declaration(Class(goldbook:09320))
AnnotationAssertion(rdfs:label goldbook:09320 "direct spectrum")
AnnotationAssertion(dcterms:description goldbook:09320 "Spectrum of intensity of electrons transmitted and detected by a spectrometer with a dispersing energy analyser as a function of energy, \\(E\\).")
AnnotationAssertion(rdfs:comment goldbook:09320 "In retarding field energy analysers, which do not have a dispersing element, the direct spectrum can be obtained from the first differential of the collected current with respect to the retarding energy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09320 "By convention, direct spectra in X-ray photoelectron spectroscopy are often presented in constant analyser energy mode, in which the spectrum approximates the true spectrum, whereas, in Auger electron spectroscopy, spectra are often presented in constant retardation ratio mode, in which the spectrum approximates to \\(E\\) times the true spectrum."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09320 goldbook:09172)
AnnotationAssertion(mito:isMentionedBy goldbook:09320 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09320 "current"^^xsd:string)
Declaration(Class(goldbook:09321))
AnnotationAssertion(rdfs:label goldbook:09321 "dynamic emittance matching")
AnnotationAssertion(dcterms:description goldbook:09321 "Electron or ion optical method of steering a spectrometer axis to align with the impact area of the primary beam at all points of a raster scan on the sample surface.")
AnnotationAssertion(rdfs:seeAlso goldbook:09321 goldbook:09274)
AnnotationAssertion(mito:isMentionedBy goldbook:09321 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09321 "current"^^xsd:string)
Declaration(Class(goldbook:09322))
AnnotationAssertion(rdfs:label goldbook:09322 "effective attenuation length")
AnnotationAssertion(dcterms:description goldbook:09322 "Parameter that, when introduced in place of the electron inelastic mean free path into an expression derived for Auger electron spectroscopy and X-ray photoelectron spectroscopy on the assumption that elastic scattering effects are negligible for a given quantitative application, will correct that expression for elastic scattering effects.")
AnnotationAssertion(rdfs:comment goldbook:09322 "The effective attenuation length can have different values for different quantitative applications of AES and XPS. However, the most common use of effective attenuation length is in the determination of overlayer-film thicknesses from the measurement of the changes of overlayer and substrate Auger-electron or photoelectron signal intensities after the deposition of a film or as a function of the emission angle. For emission angles of up to about \\(\\pu{60\\!^{\\circ}}\\) (with respect to the surface normal), it is often satisfactory to use a single value of this parameter. For greater emission angles, the effective attenuation length can depend on this angle."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09322 "Since there are different uses of this term, it is recommended that users specify clearly the particular application and the definition of the parameter for that application (e.g. by giving a formula or by providing a reference to a particular source)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09322 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09322 goldbook:09246)
AnnotationAssertion(rdfs:seeAlso goldbook:09322 goldbook:09327)
AnnotationAssertion(rdfs:seeAlso goldbook:09322 goldbook:09221)
AnnotationAssertion(mito:isMentionedBy goldbook:09322 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09322 "current"^^xsd:string)
Declaration(Class(goldbook:09323))
AnnotationAssertion(rdfs:label goldbook:09323 "Einstein photoelectric equation")
AnnotationAssertion(dcterms:description goldbook:09323 "Equation relating the kinetic energy of an electron, emitted from a conductor illuminated by monochromatic photons, and the photon energy and work function of the surface from which the photoelectron is emitted. \\(½m_{\\rm{e}}  u_{\\rm{max}}^{2} = h u - \\phi_{0}\\), where \\(m_{\\rm{e}}\\) is the mass of an electron, \\( u_{\\rm{max}}\\) the maximum velocity of the emitted electron, \\(h\\) the Planck constant, \\( u\\) the frequency of the illuminating photons, and \\(\\phi_{0}\\) the photoelectric work function of the surface.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09323 "Einstein equation")
AnnotationAssertion(rdfs:seeAlso goldbook:09323 goldbook:09345)
AnnotationAssertion(mito:isMentionedBy goldbook:09323 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09323 "current"^^xsd:string)
Declaration(Class(goldbook:09324))
AnnotationAssertion(rdfs:label goldbook:09324 "elastic peak")
AnnotationAssertion(dcterms:description goldbook:09324 "Peak in the electron spectrum, produced by quasi-elastically scattered electrons detected by an electron spectrometer.")
AnnotationAssertion(rdfs:comment goldbook:09324 "All electrons that are scattered by atoms can be elastically scattered in the centre-of-mass frame, but energy losses that are typically less than \\(\\pu{1 eV}\\) might be observed in the laboratory frame. These losses are generally significantly less than the measured energy width of the electrons in a primary-electron beam. Historically, and more generally, the scattering has been called “elastic”; however, the term quasi-elastic is now often used if the small change in energy that occurs on scattering is important."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09324 "The energy and the energy broadening of the quasi-elastic peak are influenced by the recoil of the scatterer atoms, the energy distribution of the primary (incident) electrons, the scattering geometry, the acceptance geometry, and the response function of the electron spectrometer. The intensity of the elastic peak depends on the electron differential elastic scattering cross section and on the cross section for inelastic electron scattering at the particular beam energy of the primary-electrons and in the given scattering geometry, including the probability of surface excitations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09324 goldbook:09174)
AnnotationAssertion(rdfs:seeAlso goldbook:09324 goldbook:09246)
AnnotationAssertion(rdfs:seeAlso goldbook:09324 goldbook:09329)
AnnotationAssertion(rdfs:seeAlso goldbook:09324 goldbook:09334)
AnnotationAssertion(mito:isMentionedBy goldbook:09324 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09324 "current"^^xsd:string)
Declaration(Class(goldbook:09325))
AnnotationAssertion(rdfs:label goldbook:09325 "electron energy analyser")
AnnotationAssertion(dcterms:description goldbook:09325 "Measuring instrument for measuring the number of electrons, or an intensity proportional to that number, as a function of the electron kinetic energy.")
AnnotationAssertion(rdfs:comment goldbook:09325 "An electron energy analyser is part of an electron spectrometer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09325 goldbook:09329)
AnnotationAssertion(mito:isMentionedBy goldbook:09325 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09325 "current"^^xsd:string)
Declaration(Class(goldbook:09326))
AnnotationAssertion(rdfs:label goldbook:09326 "electron energy loss spectrum")
AnnotationAssertion(dcterms:description goldbook:09326 "Energy spectrum of electrons from a nominally monoenergetic source emitted after inelastic interactions with the sample, often exhibiting peaks due to specific inelastic loss processes (see characteristic electron energy losses and plasmon).")
AnnotationAssertion(rdfs:comment goldbook:09326 "The electron energy loss spectrum obtained using an incident-electron beam of about the same energy as a peak obtained in Auger electron spectroscopy or X-ray photoelectron spectroscopy approximates to the energy loss spectrum associated with that peak."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09326 "The electron energy loss spectrum, measured with an incident-electron beam, is a function of beam energy, angle of incidence of the beam, angle of emission, and the electronic properties of the sample."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09326 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09326 goldbook:09221)
AnnotationAssertion(rdfs:seeAlso goldbook:09326 goldbook:09315)
AnnotationAssertion(rdfs:seeAlso goldbook:09326 goldbook:09268)
AnnotationAssertion(mito:isMentionedBy goldbook:09326 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09326 "current"^^xsd:string)
Declaration(Class(goldbook:09327))
AnnotationAssertion(rdfs:label goldbook:09327 "electron inelastic mean free path")
AnnotationAssertion(dcterms:description goldbook:09327 "Average distance that an electron with a given energy travels between successive inelastic collisions.")
AnnotationAssertion(mito:isMentionedBy goldbook:09327 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09327 "current"^^xsd:string)
Declaration(Class(goldbook:09328))
AnnotationAssertion(rdfs:label goldbook:09328 "electron retardation")
AnnotationAssertion(dcterms:description goldbook:09328 "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, measurement method for kinetic energy distribution by retarding the emitted electrons before or within the electron energy analyser.")
AnnotationAssertion(rdfs:seeAlso goldbook:09328 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09328 goldbook:09325)
AnnotationAssertion(mito:isMentionedBy goldbook:09328 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09328 "current"^^xsd:string)
Declaration(Class(goldbook:09329))
AnnotationAssertion(rdfs:label goldbook:09329 "electron spectrometer")
AnnotationAssertion(dcterms:description goldbook:09329 "Measuring system, the essential part of which is an electron energy analyser.")
AnnotationAssertion(rdfs:comment goldbook:09329 "The term electron spectrometer can be used either as a synonym for electron energy analyser or to describe a more complex instrument based on an electron energy analyser and additional electron-optical components. Occasionally, the term is used to describe a complete working system with an energy analyser, possible electron-optical components, an electron detector, excitation sources, vacuum pumps, control electronics, and a data-processing system. The meaning will normally be made clear by the context."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09329 goldbook:09325)
AnnotationAssertion(mito:isMentionedBy goldbook:09329 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09329 "current"^^xsd:string)
Declaration(Class(goldbook:09330))
AnnotationAssertion(rdfs:label goldbook:09330 "elemental relative sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09330 "In dynamic secondary-ion mass spectrometry, coefficient for an element by which the measured intensity of a mass peak for that element, divided by the measured intensity of a mass peak for the matrix, is multiplied to yield the atomic concentration of the element present in the sample.")
AnnotationAssertion(rdfs:comment goldbook:09330 "The elemental relative sensitivity factor can be obtained by dividing the relative isotopic sensitivity factor by the isotope abundance of the detected isotope ion."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09330 "Matrix terms are strong, and the matrix, bombarding species, incident-ion energy, and angle of incidence, as well as the spectrometer operating conditions, all affect relative elemental sensitivity factors significantly."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09330 goldbook:09183)
AnnotationAssertion(rdfs:seeAlso goldbook:09330 goldbook:09419)
AnnotationAssertion(mito:isMentionedBy goldbook:09330 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09330 "current"^^xsd:string)
Declaration(Class(goldbook:09331))
AnnotationAssertion(rdfs:label goldbook:09331 "extrinsic plasmon")
AnnotationAssertion(dcterms:description goldbook:09331 "Plasmon excited as an electron travels through a condensed medium.")
AnnotationAssertion(rdfs:comment goldbook:09331 "The probability describing the number of extrinsic plasmons excited by the electron depends on the path length traversed and, for typical applications of Auger-electron spectroscopy and X-ray photoelectron spectroscopy of a homogeneous sample, follows a Poisson distribution for the parameter \\(s/\\lambda\\), where \\(s\\) is path length and \\(\\lambda\\) is electron inelastic mean free path."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09331 goldbook:09268)
AnnotationAssertion(rdfs:seeAlso goldbook:09331 goldbook:09327)
AnnotationAssertion(rdfs:seeAlso goldbook:09331 goldbook:09342)
AnnotationAssertion(mito:isMentionedBy goldbook:09331 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09331 "current"^^xsd:string)
Declaration(Class(goldbook:09332))
AnnotationAssertion(rdfs:label goldbook:09332 "Fermi level referencing")
AnnotationAssertion(dcterms:description goldbook:09332 "Process for establishing the binding energy scale for a particular sample by assigning the kinetic energy corresponding to the Fermi level, as determined by analysis of the spectrum obtained from X-ray photoelectron spectroscopy or ultraviolet photoelectron spectroscopy, as the point of zero binding energy.")
AnnotationAssertion(rdfs:seeAlso goldbook:09332 goldbook:09361)
AnnotationAssertion(mito:isMentionedBy goldbook:09332 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09332 "current"^^xsd:string)
Declaration(Class(goldbook:09333))
AnnotationAssertion(rdfs:label goldbook:09333 "final energy state")
AnnotationAssertion(dcterms:description goldbook:09333 "Energy state of an atom after a particular Auger, X-ray, or photoemission process.")
AnnotationAssertion(rdfs:seeAlso goldbook:09333 goldbook:09338)
AnnotationAssertion(rdfs:seeAlso goldbook:09333 goldbook:09337)
AnnotationAssertion(mito:isMentionedBy goldbook:09333 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09333 "current"^^xsd:string)
Declaration(Class(goldbook:09334))
AnnotationAssertion(rdfs:label goldbook:09334 "inelastic electron scattering background")
AnnotationAssertion(dcterms:description goldbook:09334 "Intensity distribution in a spectrum for particles originally at one energy but which are emitted at lower energies due to one or more inelastic scattering processes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09334 "inelastic background")
AnnotationAssertion(rdfs:comment goldbook:09334 "For Auger electron spectroscopy and X-ray photoelectron spectroscopy, the inelastic background associated with a particular Auger electron or photoelectron peak has been approximated by a measured electron energy loss spectrum for which the incident-electron energy is close to the energy of the peak. Simple linear backgrounds have also been used, but these are much less accurate, except for the XPS analysis of insulators."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09334 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09334 goldbook:09355)
AnnotationAssertion(rdfs:seeAlso goldbook:09334 goldbook:09360)
AnnotationAssertion(rdfs:seeAlso goldbook:09334 goldbook:09326)
AnnotationAssertion(rdfs:seeAlso goldbook:09334 goldbook:09335)
AnnotationAssertion(mito:isMentionedBy goldbook:09334 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09334 "current"^^xsd:string)
Declaration(Class(goldbook:09335))
AnnotationAssertion(rdfs:label goldbook:09335 "inelastic electron scattering background subtraction")
AnnotationAssertion(dcterms:description goldbook:09335 "Subtraction of a chosen inelastic electron scattering background from a measured spectrum in Auger electron spectroscopy and X-ray photoelectron spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:09335 "The inelastic background associated with a particular Auger electron or photoelectron peak has been approximated by a measured electron energy loss spectrum for which the incident-electron energy is close to the energy of the peak."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09335 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09335 goldbook:09326)
AnnotationAssertion(rdfs:seeAlso goldbook:09335 goldbook:09334)
AnnotationAssertion(mito:isMentionedBy goldbook:09335 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09335 "current"^^xsd:string)
Declaration(Class(goldbook:09336))
AnnotationAssertion(rdfs:label goldbook:09336 "inelastic scattering cross section")
AnnotationAssertion(dcterms:description goldbook:09336 "Cross section for inelastic scattering by an electron traversing a material.")
AnnotationAssertion(rdfs:seeAlso goldbook:09336 goldbook:09246)
AnnotationAssertion(mito:isMentionedBy goldbook:09336 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09336 "current"^^xsd:string)
Declaration(Class(goldbook:09337))
AnnotationAssertion(rdfs:label goldbook:09337 "initial energy state")
AnnotationAssertion(dcterms:description goldbook:09337 "Core-hole excited state of an atom prior to Auger transition or to X-ray emission.")
AnnotationAssertion(rdfs:seeAlso goldbook:09337 goldbook:09340)
AnnotationAssertion(mito:isMentionedBy goldbook:09337 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09337 "current"^^xsd:string)
Declaration(Class(goldbook:09338))
AnnotationAssertion(rdfs:label goldbook:09338 "initial energy state")
AnnotationAssertion(dcterms:description goldbook:09338 "Ground state of an atom prior to photoelectron emission.")
AnnotationAssertion(mito:isMentionedBy goldbook:09338 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09338 "current"^^xsd:string)
Declaration(Class(goldbook:09339))
AnnotationAssertion(rdfs:label goldbook:09339 "initial-state Auger parameter")
AnnotationAssertion(dcterms:description goldbook:09339 "\\(\\beta = 3E_{\\rm{B}} + E_{\\rm{K}}\\), where \\(E_{\\rm{B}}\\) and \\(E_{\\rm{K}}\\) are, respectively, the binding energy of a photoelectron peak and the Fermi level referenced (see Fermi level referencing) kinetic energy of an Auger electron peak, each involving the same initial core level of the same element.")
AnnotationAssertion(rdfs:comment goldbook:09339 "The initial-state Auger parameter is useful for evaluating the change in the atomic core potential contribution to changes in binding energy between two environments, provided the Auger transition is between core levels that have similar binding energy shifts."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09339 "This parameter has no relation to the asymmetry parameter, which is also given the symbol \\(\\beta\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09339 goldbook:09308)
AnnotationAssertion(rdfs:seeAlso goldbook:09339 goldbook:09332)
AnnotationAssertion(rdfs:seeAlso goldbook:09339 goldbook:09306)
AnnotationAssertion(rdfs:seeAlso goldbook:09339 goldbook:09343)
AnnotationAssertion(mito:isMentionedBy goldbook:09339 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09339 "current"^^xsd:string)
Declaration(Class(goldbook:09340))
AnnotationAssertion(rdfs:label goldbook:09340 "interatomic Auger process")
AnnotationAssertion(dcterms:description goldbook:09340 "Auger transition in which at least one of the final electron vacancies is localized in valence levels or molecular orbitals of atoms adjacent to the atom in which the initial vacancy occurred.")
AnnotationAssertion(mito:isMentionedBy goldbook:09340 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09340 "current"^^xsd:string)
Declaration(Class(goldbook:09341))
AnnotationAssertion(rdfs:label goldbook:09341 "interface core-level shift")
AnnotationAssertion(dcterms:description goldbook:09341 "Energy shift observed in core-level photoelectron spectroscopy arising from the changed bonding and/or from the displacements of atoms from their bulk positions near an interface between two materials.")
AnnotationAssertion(rdfs:seeAlso goldbook:09341 goldbook:09358)
AnnotationAssertion(mito:isMentionedBy goldbook:09341 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09341 "current"^^xsd:string)
Declaration(Class(goldbook:09342))
AnnotationAssertion(rdfs:label goldbook:09342 "intrinsic plasmon")
AnnotationAssertion(dcterms:description goldbook:09342 "Plasmon excited at the same time as the excitation of a core-level photoelectron or an Auger electron associated with the same locality as the excitation of the photoelectron or Auger electron.")
AnnotationAssertion(rdfs:seeAlso goldbook:09342 goldbook:09268)
AnnotationAssertion(rdfs:seeAlso goldbook:09342 goldbook:09331)
AnnotationAssertion(mito:isMentionedBy goldbook:09342 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09342 "current"^^xsd:string)
Declaration(Class(goldbook:09343))
AnnotationAssertion(rdfs:label goldbook:09343 "modified Auger parameter")
AnnotationAssertion(dcterms:description goldbook:09343 "Sum of the Fermi level referenced (see Fermi level referencing) kinetic energy of a narrow Auger electron peak in the spectrum and the binding energy of the most intense photoelectron peak from the same element.")
AnnotationAssertion(rdfs:comment goldbook:09343 "The modified Auger parameter is the sum of the Auger parameter and the energy of the X-rays responsible for the measured photoelectron peak. Unlike the Auger parameter, it does not depend on the energy of the X-rays."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09343 goldbook:09308)
AnnotationAssertion(rdfs:seeAlso goldbook:09343 goldbook:09332)
AnnotationAssertion(rdfs:seeAlso goldbook:09343 goldbook:09339)
AnnotationAssertion(mito:isMentionedBy goldbook:09343 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09343 "current"^^xsd:string)
Declaration(Class(goldbook:09344))
AnnotationAssertion(rdfs:label goldbook:09344 "pass energy")
AnnotationAssertion(dcterms:description goldbook:09344 "Mean kinetic energy of detected particles in the energy-dispersive portion of an electron energy analyser.")
AnnotationAssertion(rdfs:seeAlso goldbook:09344 goldbook:09325)
AnnotationAssertion(mito:isMentionedBy goldbook:09344 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09344 "current"^^xsd:string)
Declaration(Class(goldbook:09345))
AnnotationAssertion(rdfs:label goldbook:09345 "photoelectric work function")
AnnotationAssertion(dcterms:description goldbook:09345 "Minimum photon energy required to liberate an electron from the surface of a conducting solid by absorption of that photon.")
AnnotationAssertion(rdfs:seeAlso goldbook:09345 goldbook:09297)
AnnotationAssertion(mito:isMentionedBy goldbook:09345 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09345 "current"^^xsd:string)
Declaration(Class(goldbook:09346))
AnnotationAssertion(rdfs:label goldbook:09346 "photoelectron X-ray satellite peaks")
AnnotationAssertion(dcterms:description goldbook:09346 "Photoelectron peaks in a spectrum resulting from photoemission induced by characteristic minor X-ray lines associated with the X-ray spectrum of the anode material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09346 "satellite peaks")
AnnotationAssertion(rdfs:seeAlso goldbook:09346 goldbook:09348)
AnnotationAssertion(mito:isMentionedBy goldbook:09346 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09346 "current"^^xsd:string)
Declaration(Class(goldbook:09347))
AnnotationAssertion(rdfs:label goldbook:09347 "photoelectron X-ray satellite subtraction")
AnnotationAssertion(dcterms:description goldbook:09347 "Removal of photoelectron X-ray satellite peaks from a spectrum.")
AnnotationAssertion(rdfs:comment goldbook:09347 "For unmonochromated \\(\\ce{Al}\\) and \\(\\ce{Mg}\\) X-rays, the satellites usually removed are \\(\\ce{K}\\upalpha_{3,4}\\) and \\(\\ce{K}\\upalpha_{5,6}\\). More sophisticated subtraction methods also remove the \\(\\ce{K}\\upalpha_{2}\\), \\(\\ce{K}\\upalpha^{\\prime}\\), and \\(\\ce{K}\\upbeta\\) satellites."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09347 goldbook:09346)
AnnotationAssertion(mito:isMentionedBy goldbook:09347 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09347 "current"^^xsd:string)
Declaration(Class(goldbook:09348))
AnnotationAssertion(rdfs:label goldbook:09348 "photoemission")
AnnotationAssertion(dcterms:description goldbook:09348 "Emission of electrons from atoms or molecules caused by the photoelectric effect.")
AnnotationAssertion(mito:isMentionedBy goldbook:09348 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09348 "current"^^xsd:string)
Declaration(Class(goldbook:09349))
AnnotationAssertion(rdfs:label goldbook:09349 "pure-element relative sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09349 "In electron spectroscopy, coefficient, proportional to the intensity measured for a pure sample of an element, by which the measured intensity for that element is divided in calculations to yield the atomic concentration or atomic fraction of the element present in the sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09349 "PERSF")
AnnotationAssertion(rdfs:comment goldbook:09349 "The choice of atomic concentration or atomic fraction should be made clear."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09349 "The type of sensitivity factor utilized should be appropriate for the formulae used in the quantification process and for the type of sample analysed, for example homogeneous samples or segregated layers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09349 "The source of sensitivity factors should be given to ensure that the correct matrix factors or other parameters are used. Matrix factors are significant and should be used with pure-element relative sensitivity factors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09349 "Sensitivity factors depend on parameters of the excitation source, the spectrometer, and the orientation of the sample to these parts of the instrument. The numerical values of the sensitivity factors can also depend on the method used to measure the peak intensities."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09349 goldbook:09310)
AnnotationAssertion(rdfs:seeAlso goldbook:09349 goldbook:09263)
AnnotationAssertion(mito:isMentionedBy goldbook:09349 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09349 "current"^^xsd:string)
Declaration(Class(goldbook:09350))
AnnotationAssertion(rdfs:label goldbook:09350 "relaxation energy")
AnnotationAssertion(dcterms:description goldbook:09350 "Energy associated with intra-atomic or extra-atomic electronic readjustment to the removal of an atomic electron, so as to minimize the energy of the final state of the system.")
AnnotationAssertion(rdfs:seeAlso goldbook:09350 goldbook:09333)
AnnotationAssertion(mito:isMentionedBy goldbook:09350 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09350 "current"^^xsd:string)
Declaration(Class(goldbook:09352))
AnnotationAssertion(rdfs:label goldbook:09352 "selected-area aperture")
AnnotationAssertion(dcterms:description goldbook:09352 "Aperture in the electron or ion optical system restricting the detected signal to a small area of the sample surface.")
AnnotationAssertion(mito:isMentionedBy goldbook:09352 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09352 "current"^^xsd:string)
Declaration(Class(goldbook:09353))
AnnotationAssertion(rdfs:label goldbook:09353 "shakeoff")
AnnotationAssertion(dcterms:description goldbook:09353 "Multi-electron process in which two or more electrons are emitted, partitioning between them the excess kinetic energy.")
AnnotationAssertion(rdfs:comment goldbook:09353 "Shakeoff leads to a continuum background intensity at kinetic energies below that of the parent peak in the electron spectrum. This is in contrast to shakeup, which leads to peak structure, also at kinetic energies below that of a parent peak."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09353 goldbook:09354)
AnnotationAssertion(mito:isMentionedBy goldbook:09353 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09353 "current"^^xsd:string)
Declaration(Class(goldbook:09354))
AnnotationAssertion(rdfs:label goldbook:09354 "shakeup")
AnnotationAssertion(dcterms:description goldbook:09354 "Multi-electron process in which an atom is left in an excited state following a photoionization or Auger electron process, so that the outgoing electron has a characteristic kinetic energy slightly less than that of the parent photoelectron.")
AnnotationAssertion(rdfs:comment goldbook:09354 "Shakeup peaks are usually observed within \\(\\pu{10 eV}\\) of the parent peak. However, for gases where the background is low, shakeup peaks have been identified at kinetic energies up to \\(\\pu{100 eV}\\) less than that of the parent peak."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09354 goldbook:09353)
AnnotationAssertion(mito:isMentionedBy goldbook:09354 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09354 "current"^^xsd:string)
Declaration(Class(goldbook:09355))
AnnotationAssertion(rdfs:label goldbook:09355 "Shirley background")
AnnotationAssertion(dcterms:description goldbook:09355 "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, background calculated to fit the measured spectrum at points at greater and lesser kinetic energy than the peak or peaks of interest, such that the background contribution at a given kinetic energy is in a fixed proportion to the total peak area above that background for greater kinetic energies.")
AnnotationAssertion(rdfs:comment goldbook:09355 "Fitting to the background can be made by averaging over a given number of energy channels."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09355 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09355 goldbook:09360)
AnnotationAssertion(mito:isMentionedBy goldbook:09355 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09355 "current"^^xsd:string)
Declaration(Class(goldbook:09356))
AnnotationAssertion(rdfs:label goldbook:09356 "spectator hole")
AnnotationAssertion(dcterms:description goldbook:09356 "Electronic configuration of an atom containing an electronic vacancy that can be present during processes, such as Auger electron and X-ray photoelectron emission, but is not created or destroyed in the process.")
AnnotationAssertion(rdfs:seeAlso goldbook:09356 goldbook:09348)
AnnotationAssertion(mito:isMentionedBy goldbook:09356 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09356 "current"^^xsd:string)
Declaration(Class(goldbook:09357))
AnnotationAssertion(rdfs:label goldbook:09357 "sub-shell photoionization cross section")
AnnotationAssertion(dcterms:description goldbook:09357 "Cross section for an incident photon interacting with a material to produce one or more photoelectrons from a given sub-shell.")
AnnotationAssertion(rdfs:comment goldbook:09357 "Photoionization from one sub-shell can lead to shake-up or shakeoff of electrons from other shells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09357 goldbook:09267)
AnnotationAssertion(rdfs:seeAlso goldbook:09357 goldbook:09354)
AnnotationAssertion(rdfs:seeAlso goldbook:09357 goldbook:09353)
AnnotationAssertion(mito:isMentionedBy goldbook:09357 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09357 "current"^^xsd:string)
Declaration(Class(goldbook:09358))
AnnotationAssertion(rdfs:label goldbook:09358 "surface core-level shift")
AnnotationAssertion(dcterms:description goldbook:09358 "Energy shift observed in core-level photoelectron spectroscopy arising from the reduced coordination of the surface or near-surface atoms compared to bulk atoms.")
AnnotationAssertion(rdfs:comment goldbook:09358 "Surface core level shifts are often observed for single crystals and nanoparticles and depend on the crystal surface exposed. Shifts can be to lower or higher binding energy, depending on the band structure of the bulk solid. For the outermost atom layer, the shift can be as high as \\(\\pu{0.4 eV}\\). In X-ray photoelectron emission, the sampling depth is generally many atom layers when photoelectrons are detected with emission angles at, or close to, the surface normal. The shift for the outermost atom layer is thus seen most clearly at near-grazing emission angles. Separate energy shifts can be detected for the second and third atom layers from the surface."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09358 goldbook:09348)
AnnotationAssertion(mito:isMentionedBy goldbook:09358 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09358 "current"^^xsd:string)
Declaration(Class(goldbook:09359))
AnnotationAssertion(rdfs:label goldbook:09359 "total secondary-electron yield")
AnnotationAssertion(dcterms:description goldbook:09359 "Total number of electrons emitted from a sample divided by the total number of electrons incident at a given energy and angle of incidence. \\(\\sigma = \\delta + \\eta\\), where \\(\\delta\\) is the secondary-electron yield and \\(\\eta\\) is the backscattering coefficient.")
AnnotationAssertion(rdfs:comment goldbook:09359 "The total secondary-electron yield is often simply called the secondary-electron yield. This leads to confusion with the term of that name, which is restricted to secondary electrons with energies less than or equal to \\(\\pu{50 eV}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09359 goldbook:09314)
AnnotationAssertion(rdfs:seeAlso goldbook:09359 goldbook:09423)
AnnotationAssertion(mito:isMentionedBy goldbook:09359 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09359 "current"^^xsd:string)
Declaration(Class(goldbook:09360))
AnnotationAssertion(rdfs:label goldbook:09360 "Tougaard background")
AnnotationAssertion(dcterms:description goldbook:09360 "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, intensity distribution of the background due to inelastic scattering obtained from the differential inelastic scattering cross section with respect to energy loss and the three-dimensional distribution of the emitting atoms in the surface region.")
AnnotationAssertion(rdfs:comment goldbook:09360 "A number of classes of atomic distributions can be used together with different differential inelastic scattering cross sections. The atomic distribution and the inelastic scattering cross section should be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09360 "The Tougaard background is usually calculated to match the measured spectrum over a wide energy range that excludes the peak region and the spectral region extending to approximately \\(\\pu{50 eV}\\) less kinetic energy than the peaks of interest. The measured spectrum should be corrected for the spectrometer response function of the measuring instrument before the calculation of the Tougaard background."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09360 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09360 goldbook:09355)
AnnotationAssertion(rdfs:seeAlso goldbook:09360 goldbook:09336)
AnnotationAssertion(rdfs:seeAlso goldbook:09360 goldbook:09283)
AnnotationAssertion(mito:isMentionedBy goldbook:09360 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09360 "current"^^xsd:string)
Declaration(Class(goldbook:09361))
AnnotationAssertion(rdfs:label goldbook:09361 "vacuum level referencing")
AnnotationAssertion(dcterms:description goldbook:09361 "Method of establishing the kinetic energy scale in which the zero point corresponds to an electron at rest at the vacuum level.")
AnnotationAssertion(rdfs:seeAlso goldbook:09361 goldbook:09332)
AnnotationAssertion(rdfs:seeAlso goldbook:09361 goldbook:09300)
AnnotationAssertion(mito:isMentionedBy goldbook:09361 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09361 "current"^^xsd:string)
Declaration(Class(goldbook:09362))
AnnotationAssertion(rdfs:label goldbook:09362 "valence-band spectrum")
AnnotationAssertion(dcterms:description goldbook:09362 "X-ray photoelectron energy distribution arising from the excitation of electrons from the valence band of the sample material.")
AnnotationAssertion(mito:isMentionedBy goldbook:09362 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09362 "current"^^xsd:string)
Declaration(Class(goldbook:09363))
AnnotationAssertion(rdfs:label goldbook:09363 "aligned incidence spectrum")
AnnotationAssertion(dcterms:description goldbook:09363 "Backscattering spectrum recorded with the analysing beam aligned with crystallographic axes or planes of the sample that produce channelling.")
AnnotationAssertion(rdfs:seeAlso goldbook:09363 goldbook:09364)
AnnotationAssertion(mito:isMentionedBy goldbook:09363 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09363 "current"^^xsd:string)
Declaration(Class(goldbook:09364))
AnnotationAssertion(rdfs:label goldbook:09364 "backscattering spectrum")
AnnotationAssertion(dcterms:description goldbook:09364 "Plot of backscattering yield versus backscattering energy.")
AnnotationAssertion(mito:isMentionedBy goldbook:09364 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09364 "current"^^xsd:string)
Declaration(Class(goldbook:09365))
AnnotationAssertion(rdfs:label goldbook:09365 "beam chopper")
AnnotationAssertion(dcterms:description goldbook:09365 "Electrostatic or electromagnetic device used to generate pulses of ions from a continuous ion beam.")
AnnotationAssertion(rdfs:comment goldbook:09365 "The beam chopper can be used to define the pulse length and hence the mass resolution in a time-of-flight mass spectrometer and it can also be used to select particular ions in a beam that contains more than one species."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09365 goldbook:09393)
AnnotationAssertion(rdfs:seeAlso goldbook:09365 goldbook:09260)
AnnotationAssertion(mito:isMentionedBy goldbook:09365 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09365 "current"^^xsd:string)
Declaration(Class(goldbook:09366))
AnnotationAssertion(rdfs:label goldbook:09366 "binary elastic scattering peak")
AnnotationAssertion(dcterms:description goldbook:09366 "In ion-scattering spectrometry, increase in the spectrometer detection system response above the background signal, which can be attributed to the binary elastic scattering of an incident ion by a surface atom of a particular mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:09366 goldbook:09230)
AnnotationAssertion(mito:isMentionedBy goldbook:09366 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09366 "current"^^xsd:string)
Declaration(Class(goldbook:09367))
AnnotationAssertion(rdfs:label goldbook:09367 "blocking geometry")
AnnotationAssertion(dcterms:description goldbook:09367 "Experimental arrangement wherein the atom rows or planes of a single-crystal target are aligned parallel to a vector from the sample to the detector.")
AnnotationAssertion(mito:isMentionedBy goldbook:09367 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09367 "current"^^xsd:string)
Declaration(Class(goldbook:09368))
AnnotationAssertion(rdfs:label goldbook:09368 "electronic stopping cross section")
AnnotationAssertion(dcterms:description goldbook:09368 "Stopping cross section arising from energy transfer to the electrons of the sample.")
AnnotationAssertion(rdfs:comment goldbook:09368 "The maximum of the nuclear stopping cross section occurs at energies of the order of \\(\\pu{1 keV}\\) per nucleon, whereas that of the electronic stopping cross section occurs at above \\(\\pu{100 keV}\\) per nucleon. The absolute value of the electronic stopping cross section maximum is significantly greater than that for the nuclear stopping cross section."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09368 goldbook:09387)
AnnotationAssertion(mito:isMentionedBy goldbook:09368 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09368 "current"^^xsd:string)
Declaration(Class(goldbook:09369))
AnnotationAssertion(rdfs:label goldbook:09369 "energy edge")
AnnotationAssertion(dcterms:description goldbook:09369 "Values of the backscattering energy for an element, or for an isotope, that is located at the surface of a sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09369 goldbook:09228)
AnnotationAssertion(mito:isMentionedBy goldbook:09369 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09369 "current"^^xsd:string)
Declaration(Class(goldbook:09370))
AnnotationAssertion(rdfs:label goldbook:09370 "surface approximation energy")
AnnotationAssertion(dcterms:description goldbook:09370 "Simplification of calculations involving the energy of an ion passing through a solid sample, where the energy of the ion at the surface is used in place of a properly averaged energy.")
AnnotationAssertion(rdfs:comment goldbook:09370 "This approximation is used to determine the energy at which scattering cross sections (see elastic scattering cross section, inelastic scattering cross section) or stopping cross sections, or both, are evaluated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09370 goldbook:09246)
AnnotationAssertion(rdfs:seeAlso goldbook:09370 goldbook:09336)
AnnotationAssertion(rdfs:seeAlso goldbook:09370 goldbook:09387)
AnnotationAssertion(mito:isMentionedBy goldbook:09370 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09370 "current"^^xsd:string)
Declaration(Class(goldbook:09371))
AnnotationAssertion(rdfs:label goldbook:09371 "enhanced elastic cross section")
AnnotationAssertion(dcterms:description goldbook:09371 "Cross section of an atom for elastic scattering that is greater than the Rutherford cross section due to partial penetration of a nucleus in the sample by the incident particle.")
AnnotationAssertion(rdfs:seeAlso goldbook:09371 goldbook:09381)
AnnotationAssertion(mito:isMentionedBy goldbook:09371 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09371 "current"^^xsd:string)
Declaration(Class(goldbook:09372))
AnnotationAssertion(rdfs:label goldbook:09372 "experimental scattered-ion intensity")
AnnotationAssertion(dcterms:description goldbook:09372 "Measured response of the energy filtering and detection system as a consequence of bombarding the sample material with an ion beam, usually presented as the ordinate of an ion-scattering spectrum.")
AnnotationAssertion(rdfs:seeAlso goldbook:09372 goldbook:09260)
AnnotationAssertion(rdfs:seeAlso goldbook:09372 goldbook:09373)
AnnotationAssertion(mito:isMentionedBy goldbook:09372 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09372 "current"^^xsd:string)
Declaration(Class(goldbook:09373))
AnnotationAssertion(rdfs:label goldbook:09373 "ion-scattering spectrum")
AnnotationAssertion(dcterms:description goldbook:09373 "Plot of the intensities of ions, scattered from a sample, as a function of the scattered-ion energy divided by the incident-ion energy.")
AnnotationAssertion(rdfs:seeAlso goldbook:09373 goldbook:09390)
AnnotationAssertion(rdfs:seeAlso goldbook:09373 goldbook:09382)
AnnotationAssertion(mito:isMentionedBy goldbook:09373 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09373 "current"^^xsd:string)
Declaration(Class(goldbook:09374))
AnnotationAssertion(rdfs:label goldbook:09374 "kinematic factor")
AnnotationAssertion(dcterms:description goldbook:09374 "Particle energy after an elastic collision divided by the energy before the collision, in the laboratory frame of reference.")
AnnotationAssertion(rdfs:comment goldbook:09374 "The symbol \\(K\\) is often used for the kinematic factor and might have a subscript added in ion-scattering spectrometry or Rutherford backscattering spectrometry measurements, denoting the target atom as either, say, \\(K_{\\ce{Si}}\\) or \\(K_{28}\\). The subscript for atomic mass is preferred, since the isotope is correctly identified."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09374 goldbook:09178)
AnnotationAssertion(mito:isMentionedBy goldbook:09374 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09374 "current"^^xsd:string)
Declaration(Class(goldbook:09375))
AnnotationAssertion(rdfs:label goldbook:09375 "nuclear reaction cross section")
AnnotationAssertion(dcterms:description goldbook:09375 "Cross section at a given beam energy and emission direction of the detected product for a particular nuclear reaction per atom.")
AnnotationAssertion(rdfs:comment goldbook:09375 "SI unit \\(\\pu{m2}\\). Commonly used unit barn, \\(\\pu{1 barn} = \\pu{E-28 m2}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09375 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09375 "current"^^xsd:string)
Declaration(Class(goldbook:09376))
AnnotationAssertion(rdfs:label goldbook:09376 "nuclear stopping cross section")
AnnotationAssertion(dcterms:description goldbook:09376 "Stopping cross section arising from energy transfer to atomic nuclei of the sample.")
AnnotationAssertion(rdfs:comment goldbook:09376 "The maximum of the nuclear stopping cross section occurs at energies of the order of \\(\\pu{1 keV}\\) per nucleon, whereas that of the electronic stopping cross section occurs at above \\(\\pu{100 keV}\\) per nucleon. The absolute value of the electronic stopping cross section maximum is significantly greater than that of the nuclear stopping cross section."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09376 goldbook:09387)
AnnotationAssertion(mito:isMentionedBy goldbook:09376 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09376 "current"^^xsd:string)
Declaration(Class(goldbook:09377))
AnnotationAssertion(rdfs:label goldbook:09377 "pileup")
AnnotationAssertion(dcterms:description goldbook:09377 "Counts in a backscattering spectrum arising from two or more separate events that occur so closely in time that the signals are not resolved by the detection system and cause counts to be recorded in erroneous channels.")
AnnotationAssertion(rdfs:seeAlso goldbook:09377 goldbook:09364)
AnnotationAssertion(mito:isMentionedBy goldbook:09377 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09377 "current"^^xsd:string)
Declaration(Class(goldbook:09378))
AnnotationAssertion(rdfs:label goldbook:09378 "probe ion")
AnnotationAssertion(dcterms:description goldbook:09378 "Ion intentionally produced by an ion source and directed onto the sample surface at a known angle of incidence and a known energy.")
AnnotationAssertion(mito:isMentionedBy goldbook:09378 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09378 "current"^^xsd:string)
Declaration(Class(goldbook:09379))
AnnotationAssertion(rdfs:label goldbook:09379 "random incidence spectrum")
AnnotationAssertion(dcterms:description goldbook:09379 "Backscattering spectrum recorded with the analysing beam incident on the sample in a direction such as to produce no channelling.")
AnnotationAssertion(rdfs:seeAlso goldbook:09379 goldbook:09364)
AnnotationAssertion(mito:isMentionedBy goldbook:09379 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09379 "current"^^xsd:string)
Declaration(Class(goldbook:09380))
AnnotationAssertion(rdfs:label goldbook:09380 "resonance reaction")
AnnotationAssertion(dcterms:description goldbook:09380 "Nuclear reaction that has a narrow peak in the nuclear reaction cross section as a function of energy, the nuclear reaction cross section at the peak being so much larger than the nuclear reaction cross sections at adjacent energies on either side of the peak that essentially all the particles detected from the reaction are due to the peak.")
AnnotationAssertion(rdfs:seeAlso goldbook:09380 goldbook:09375)
AnnotationAssertion(mito:isMentionedBy goldbook:09380 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09380 "current"^^xsd:string)
Declaration(Class(goldbook:09381))
AnnotationAssertion(rdfs:label goldbook:09381 "Rutherford cross section")
AnnotationAssertion(dcterms:description goldbook:09381 "Elastic scattering cross section calculated using classical mechanics and a Coulomb potential.")
AnnotationAssertion(rdfs:comment goldbook:09381 "The resulting cross section formula was first derived by Rutherford."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09381 goldbook:09246)
AnnotationAssertion(rdfs:seeAlso goldbook:09381 goldbook:09178)
AnnotationAssertion(rdfs:seeAlso goldbook:09381 goldbook:09371)
AnnotationAssertion(mito:isMentionedBy goldbook:09381 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09381 "current"^^xsd:string)
Declaration(Class(goldbook:09382))
AnnotationAssertion(rdfs:label goldbook:09382 "scattered-ion energy")
AnnotationAssertion(dcterms:description goldbook:09382 "Kinetic energy of a primary ion after a collision.")
AnnotationAssertion(rdfs:comment goldbook:09382 "Following binary elastic scattering, the kinetic energy of the primary or probe ions, \\(E_{\\rm{s}}\\), is given by \\(E_{\\rm{s}} = E_{0}[M_{0}/(M_{0} + M_{1})]^{2} \\{\\cos\\theta + [(M_{0}/M_{1})^{2} - \\sin^{2}\\theta]^{½}\\}^{2}\\) where \\(E_{0}\\) is the kinetic energy of the incident probe ion prior to scattering; \\(M_{0}\\) is the mass of the probe ion; \\(M_{1}\\) is the mass of the target atom; \\(\\theta\\) is the angle between the initial and final velocity vectors for the probe ion, as determined from a common origin in the laboratory coordinate system, expressed as a value between \\(\\pu{0\\!^{\\circ}}\\) and \\(\\pu{180\\!^{\\circ}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09382 goldbook:09414)
AnnotationAssertion(rdfs:seeAlso goldbook:09382 goldbook:09378)
AnnotationAssertion(mito:isMentionedBy goldbook:09382 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09382 "current"^^xsd:string)
Declaration(Class(goldbook:09383))
AnnotationAssertion(rdfs:label goldbook:09383 "scattered-ion energy ratio")
AnnotationAssertion(dcterms:description goldbook:09383 "Scattered-ion energy divided by energy of the incident probe ion prior to a collision.")
AnnotationAssertion(rdfs:seeAlso goldbook:09383 goldbook:09382)
AnnotationAssertion(rdfs:seeAlso goldbook:09383 goldbook:09378)
AnnotationAssertion(mito:isMentionedBy goldbook:09383 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09383 "current"^^xsd:string)
Declaration(Class(goldbook:09384))
AnnotationAssertion(rdfs:label goldbook:09384 "screening")
AnnotationAssertion(dcterms:description goldbook:09384 "Response arising from electrons in an atom causing an apparent reduction in the coulomb potential of the nucleus.")
AnnotationAssertion(rdfs:comment goldbook:09384 "In ion-beam analysis, when the incident ion is far from the target nucleus, the atom in which the nucleus sits looks neutral to the ion as a result of screening. The screening reduces the scattering cross section slightly from the Rutherford cross section (about \\(\\pu{1\\%}\\) per 50 increase in the target atomic number for \\(\\pu{2 MeV}\\) \\(\\ce{He}\\)). The effect becomes more pronounced and increasingly uncertain as the energy decreases and, for low-energy ion scattering spectrometry, the cross section is no longer really well-known."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09384 goldbook:09381)
AnnotationAssertion(rdfs:seeAlso goldbook:09384 goldbook:09176)
AnnotationAssertion(mito:isMentionedBy goldbook:09384 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09384 "current"^^xsd:string)
Declaration(Class(goldbook:09385))
AnnotationAssertion(rdfs:label goldbook:09385 "screening function")
AnnotationAssertion(dcterms:description goldbook:09385 "Factor by which the Rutherford cross section is reduced as a result of screening in a given experiment.")
AnnotationAssertion(rdfs:seeAlso goldbook:09385 goldbook:09381)
AnnotationAssertion(rdfs:seeAlso goldbook:09385 goldbook:09384)
AnnotationAssertion(mito:isMentionedBy goldbook:09385 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09385 "current"^^xsd:string)
Declaration(Class(goldbook:09386))
AnnotationAssertion(rdfs:label goldbook:09386 "stopping cross section factor")
AnnotationAssertion(dcterms:description goldbook:09386 "Energy loss of a particle scattered at a given depth in the sample, and detected at a given angle, by the product of the atomic density of the sample atoms and the depth of scattering.")
AnnotationAssertion(mito:isMentionedBy goldbook:09386 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09386 "current"^^xsd:string)
Declaration(Class(goldbook:09387))
AnnotationAssertion(rdfs:label goldbook:09387 "stopping cross section")
AnnotationAssertion(dcterms:description goldbook:09387 "Rate of energy loss of a particle with distance along its trajectory in a sample divided by the atomic density of sample atoms for a sample of infinitesimal thickness.")
AnnotationAssertion(rdfs:comment goldbook:09387 "The atomic density is usually taken as the number density, \\(N\\), but sometimes as the mass density, \\(\\rho\\). The stopping cross section is thus given either by \\(S(E)\\equiv (1/N){\\rm{d}}E/{\\rm{d}}x\\) or by \\(S(E)\\equiv (1/\\rho){\\rm{d}}E/{\\rm{d}}x\\), where \\({\\rm{d}}E/{\\rm{d}}x\\) is the rate of loss of energy \\(E\\) with distance \\(x\\) along the particle trajectory. Note that \\({\\rm{d}}E/{\\rm{d}}x\\) is often called the stopping power, although it is not in units of power. This inconsistency for the term stopping power leads to its deprecation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09387 "SI unit: \\(\\pu{J m2}\\) or \\(\\pu{J m2 kg^{-1}}\\). Common unit \\(\\pu{eV m2}\\) or \\(\\pu{eV m2 kg^{-1}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09387 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09387 "current"^^xsd:string)
Declaration(Class(goldbook:09388))
AnnotationAssertion(rdfs:label goldbook:09388 "swift ion")
AnnotationAssertion(dcterms:description goldbook:09388 "Ion moving with a velocity exceeding the Bohr speed of \\(c/137\\), where \\(c\\) is the velocity of light.")
AnnotationAssertion(rdfs:comment goldbook:09388 "For argon and gold, this criterion requires energies greater than \\(\\pu{1 MeV}\\) and \\(\\pu{5 MeV}\\), respectively."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09388 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09388 "current"^^xsd:string)
Declaration(Class(goldbook:09389))
AnnotationAssertion(rdfs:label goldbook:09389 "system resolution")
AnnotationAssertion(dcterms:description goldbook:09389 "Energy resolution or depth resolution measured in a backscattering spectrum for a monoenergetic incident-ion beam.")
AnnotationAssertion(rdfs:seeAlso goldbook:09389 goldbook:09364)
AnnotationAssertion(rdfs:seeAlso goldbook:09389 goldbook:09245)
AnnotationAssertion(mito:isMentionedBy goldbook:09389 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09389 "current"^^xsd:string)
Declaration(Class(goldbook:09390))
AnnotationAssertion(rdfs:label goldbook:09390 "theoretical scattered-ion intensity")
AnnotationAssertion(dcterms:description goldbook:09390 "Calculated intensity for probe ions scattered into a specified solid angle at a given direction.")
AnnotationAssertion(rdfs:seeAlso goldbook:09390 goldbook:09378)
AnnotationAssertion(mito:isMentionedBy goldbook:09390 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09390 "current"^^xsd:string)
Declaration(Class(goldbook:09391))
AnnotationAssertion(rdfs:label goldbook:09391 "thin target")
AnnotationAssertion(dcterms:description goldbook:09391 "In energetic-ion analysis and Rutherford backscattering spectrometry, sample whose thickness is sufficiently small that the variation in energy of particles backscattered from atoms of each constitutive element is small with respect to the system resolution.")
AnnotationAssertion(rdfs:seeAlso goldbook:09391 goldbook:09178)
AnnotationAssertion(rdfs:seeAlso goldbook:09391 goldbook:09389)
AnnotationAssertion(mito:isMentionedBy goldbook:09391 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09391 "current"^^xsd:string)
Declaration(Class(goldbook:09392))
AnnotationAssertion(rdfs:label goldbook:09392 "analyser blanking")
AnnotationAssertion(dcterms:description goldbook:09392 "Action to prevent secondary ions from travelling through the mass spectrometer and being detected.")
AnnotationAssertion(rdfs:comment goldbook:09392 "This action is usually made by pulsing one of the relevant electrode potentials in time-of-flight mass spectrometers to deflect ions of a selected mass range in which intense peaks occur, so that those masses are not detected and thus do not cause unwanted detector saturation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09392 goldbook:09422)
AnnotationAssertion(mito:isMentionedBy goldbook:09392 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09392 "current"^^xsd:string)
Declaration(Class(goldbook:09393))
AnnotationAssertion(rdfs:label goldbook:09393 "beam bunching")
AnnotationAssertion(dcterms:description goldbook:09393 "Reduction in the spread of arrival times of an ion pulse by reduction in the speed of the leading ions or acceleration of those at the trailing edge of the pulse.")
AnnotationAssertion(rdfs:comment goldbook:09393 "This procedure can degrade the optimum focus of the ion beam, since different ions experience different fields."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09393 goldbook:09260)
AnnotationAssertion(mito:isMentionedBy goldbook:09393 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09393 "current"^^xsd:string)
Declaration(Class(goldbook:09394))
AnnotationAssertion(rdfs:label goldbook:09394 "buncher")
AnnotationAssertion(dcterms:description goldbook:09394 "Device to shorten the time length of a pulse of ions so that they arrive at a point over a reduced time interval.")
AnnotationAssertion(rdfs:comment goldbook:09394 "The point is usually the sample surface."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09394 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09394 "current"^^xsd:string)
Declaration(Class(goldbook:09395))
AnnotationAssertion(rdfs:label goldbook:09395 "dilute limit")
AnnotationAssertion(dcterms:description goldbook:09395 "Atomic fraction or concentration of impurity species in a homogeneous matrix below which the secondary-ion mass spectrometry can safely be assumed to be linear with composition.")
AnnotationAssertion(rdfs:seeAlso goldbook:09395 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09395 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09395 "current"^^xsd:string)
Declaration(Class(goldbook:09396))
AnnotationAssertion(rdfs:label goldbook:09396 "disappearance cross section")
AnnotationAssertion(dcterms:description goldbook:09396 "Cross section for the loss of intensity of an ion signal observed as a result of the bombardment by primary ions.")
AnnotationAssertion(rdfs:comment goldbook:09396 "The ion signal used is usually that for a large or characteristic fragment of the molecule, such as a cationized ion, protonated ion, or deprotonated ion from the molecule, at a surface."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09396 "Generally, the larger the molecule, the larger the disappearance cross section."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09396 "It is often assumed that the material being studied is present as a monolayer; however, this is an experimentally measured parameter and a value can be obtained irrespective of the precise form of the material under study. The disappearance cross section has practical significance and might or might not be simply related to the damage cross section."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09396 goldbook:09414)
AnnotationAssertion(mito:isMentionedBy goldbook:09396 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09396 "current"^^xsd:string)
Declaration(Class(goldbook:09397))
AnnotationAssertion(rdfs:label goldbook:09397 "dual-beam profiling")
AnnotationAssertion(dcterms:description goldbook:09397 "In secondary-ion mass spectrometry, sputter depth profiling involving two ion guns.")
AnnotationAssertion(rdfs:comment goldbook:09397 "Two similar ion guns can be used in opposite azimuths of the sample to reduce the development of topography."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09397 "In time-of-flight mass spectrometers, one beam is used with a short on-time for the secondary ion mass spectrometry analysis, while a second is used during the period when the first is off and the mass analysis has been completed in each cycle. The second gun provides the ions for sputter removal of the sample to form the depth profile. This combination allows practical sputtering rates to be achieved and the profiling to be optimized separately from the optimization for the SIMS analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09397 goldbook:09244)
AnnotationAssertion(rdfs:seeAlso goldbook:09397 goldbook:09192)
AnnotationAssertion(rdfs:seeAlso goldbook:09397 goldbook:09286)
AnnotationAssertion(mito:isMentionedBy goldbook:09397 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09397 "current"^^xsd:string)
Declaration(Class(goldbook:09398))
AnnotationAssertion(rdfs:label goldbook:09398 "extraction field")
AnnotationAssertion(dcterms:description goldbook:09398 "In secondary-ion mass spectrometry, electric field above a sample, operational during ion emission from the sample.")
AnnotationAssertion(rdfs:comment goldbook:09398 "The extraction field can be pulsed or constant, depending on the type of instrument."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09398 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09398 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09398 "current"^^xsd:string)
Declaration(Class(goldbook:09399))
AnnotationAssertion(rdfs:label goldbook:09399 "extractor voltage")
AnnotationAssertion(dcterms:description goldbook:09399 "Electric potential, referenced to the sample, of the electrode defining the field above the sample and used to facilitate introduction of emitted ions into the mass spectrometer.")
AnnotationAssertion(rdfs:comment goldbook:09399 "In pulsed-extraction mode, the extractor voltage will be pulsed to the high value required to extract ions emitted from the sample by the primary-ion pulse for at least the time period necessary for the heaviest ion to pass through the extractor electrode and will then be reduced to the extraction bias voltage until the next pulse is required."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09399 "This voltage, together with the separation distance between the sample and the extractor electrode, defines the extraction field."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09399 goldbook:09398)
AnnotationAssertion(rdfs:seeAlso goldbook:09399 goldbook:09414)
AnnotationAssertion(mito:isMentionedBy goldbook:09399 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09399 "current"^^xsd:string)
Declaration(Class(goldbook:09400))
AnnotationAssertion(rdfs:label goldbook:09400 "fast-atom bombardment secondary ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09400 "Secondary ion mass spectrometry in which the primary-ion beam is replaced by a fast-atom beam.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09400 "FAB-SIMS")
AnnotationAssertion(rdfs:seeAlso goldbook:09400 goldbook:09192)
AnnotationAssertion(rdfs:seeAlso goldbook:09400 goldbook:09414)
AnnotationAssertion(mito:isMentionedBy goldbook:09400 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09400 "current"^^xsd:string)
Declaration(Class(goldbook:09401))
AnnotationAssertion(rdfs:label goldbook:09401 "fractional ion yield")
AnnotationAssertion(dcterms:description goldbook:09401 "Number of ions of a particular species sputtered from a sample divided by number of particles of that species sputtered from that sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09401 goldbook:09253)
AnnotationAssertion(rdfs:seeAlso goldbook:09401 goldbook:09265)
AnnotationAssertion(rdfs:seeAlso goldbook:09401 goldbook:09299)
AnnotationAssertion(mito:isMentionedBy goldbook:09401 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09401 "current"^^xsd:string)
Declaration(Class(goldbook:09402))
AnnotationAssertion(rdfs:label goldbook:09402 "g index")
AnnotationAssertion(dcterms:description goldbook:09402 "Power for the ratio of mass intensities in two mass spectra measured for two different primary ion conditions, used to generate the G-SIMS spectrum.")
AnnotationAssertion(rdfs:comment goldbook:09402 "The different primary ion conditions can be two, well-separated, energies for the same primary ion or two different primary ions, usually at the same beam energy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09402 "A value of 13 has been found to be effective for the g index in generating G-SIMS spectra and a continuous variation between 0 and 40 for analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09402 goldbook:09186)
AnnotationAssertion(rdfs:seeAlso goldbook:09402 goldbook:09414)
AnnotationAssertion(mito:isMentionedBy goldbook:09402 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09402 "current"^^xsd:string)
Declaration(Class(goldbook:09403))
AnnotationAssertion(rdfs:label goldbook:09403 "G-SIMS with fragmentation pathway mapping")
AnnotationAssertion(dcterms:description goldbook:09403 "Development of G-SIMS in which the g index is varied in order to deduce the linkages between product ions and precursor ion.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09403 "G-SIMS-FPM")
AnnotationAssertion(rdfs:seeAlso goldbook:09403 goldbook:09186)
AnnotationAssertion(rdfs:seeAlso goldbook:09403 goldbook:09402)
AnnotationAssertion(mito:isMentionedBy goldbook:09403 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09403 "current"^^xsd:string)
Declaration(Class(goldbook:09404))
AnnotationAssertion(rdfs:label goldbook:09404 "ion beam ratio")
AnnotationAssertion(dcterms:description goldbook:09404 "Intensity of analyte ion divided by intensity of matrix ion, both corrected for isotopic abundance.")
AnnotationAssertion(mito:isMentionedBy goldbook:09404 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09404 "current"^^xsd:string)
Declaration(Class(goldbook:09405))
AnnotationAssertion(rdfs:label goldbook:09405 "liquid-metal ion gun")
AnnotationAssertion(dcterms:description goldbook:09405 "Ion gun utilizing a liquid-metal Taylor cone as the source of the primary ions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09405 "LMIG")
AnnotationAssertion(rdfs:comment goldbook:09405 "The Taylor cone generates ion sources of very high brightness. This design enables the gun to provide beam diameters in the range \\(\\pu{50 nm}\\) to \\(\\pu{1 \\upmu m}\\) for ion beam energies in the range \\(\\pu{5 keV}\\) to \\(\\pu{30 keV}\\), the smallest diameters generally being at the higher energies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09405 goldbook:09414)
AnnotationAssertion(mito:isMentionedBy goldbook:09405 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09405 "current"^^xsd:string)
Declaration(Class(goldbook:09406))
AnnotationAssertion(rdfs:label goldbook:09406 "mass accuracy")
AnnotationAssertion(dcterms:description goldbook:09406 "Measured mass minus reference value for that mass.")
AnnotationAssertion(rdfs:comment goldbook:09406 "In practice, mass accuracy is expressed as a fractional error."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09406 goldbook:09420)
AnnotationAssertion(mito:isMentionedBy goldbook:09406 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09406 "current"^^xsd:string)
Declaration(Class(goldbook:09407))
AnnotationAssertion(rdfs:label goldbook:09407 "metastable background")
AnnotationAssertion(dcterms:description goldbook:09407 "Intensity in a mass spectrum arising from ions that spontaneously fragment between emission and detection.")
AnnotationAssertion(rdfs:comment goldbook:09407 "In reflectron time-of-flight mass spectrometers, the decay of metastable ions leads to broad peaks at a mass dependent on the drift energy and reflector voltage. Good design minimizes these background signals."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09407 goldbook:09418)
AnnotationAssertion(mito:isMentionedBy goldbook:09407 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09407 "current"^^xsd:string)
Declaration(Class(goldbook:09408))
AnnotationAssertion(rdfs:label goldbook:09408 "molecular fragment")
AnnotationAssertion(dcterms:description goldbook:09408 "Ion or neutral particle that was part of a larger molecular structure and contains information about that structure.")
AnnotationAssertion(mito:isMentionedBy goldbook:09408 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09408 "current"^^xsd:string)
Declaration(Class(goldbook:09409))
AnnotationAssertion(rdfs:label goldbook:09409 "molecular image")
AnnotationAssertion(dcterms:description goldbook:09409 "Image of a surface formed from ions characteristic of a particular molecule.")
AnnotationAssertion(rdfs:seeAlso goldbook:09409 goldbook:09429)
AnnotationAssertion(rdfs:seeAlso goldbook:09409 goldbook:09293)
AnnotationAssertion(mito:isMentionedBy goldbook:09409 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09409 "current"^^xsd:string)
Declaration(Class(goldbook:09410))
AnnotationAssertion(rdfs:label goldbook:09410 "negative-ion yield")
AnnotationAssertion(dcterms:description goldbook:09410 "Number of negatively-charged secondary ions sputtered from a sample divided by total number of incident primary particles.")
AnnotationAssertion(rdfs:seeAlso goldbook:09410 goldbook:09401)
AnnotationAssertion(rdfs:seeAlso goldbook:09410 goldbook:09413)
AnnotationAssertion(rdfs:seeAlso goldbook:09410 goldbook:09422)
AnnotationAssertion(rdfs:seeAlso goldbook:09410 goldbook:09299)
AnnotationAssertion(mito:isMentionedBy goldbook:09410 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09410 "current"^^xsd:string)
Declaration(Class(goldbook:09411))
AnnotationAssertion(rdfs:label goldbook:09411 "partial ion yield")
AnnotationAssertion(dcterms:description goldbook:09411 "Number of ions of a particular species sputtered from a sample divided by the number of incident particles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09411 "partial ion sputtering yield")
AnnotationAssertion(rdfs:seeAlso goldbook:09411 goldbook:09401)
AnnotationAssertion(rdfs:seeAlso goldbook:09411 goldbook:09253)
AnnotationAssertion(rdfs:seeAlso goldbook:09411 goldbook:09410)
AnnotationAssertion(rdfs:seeAlso goldbook:09411 goldbook:09265)
AnnotationAssertion(rdfs:seeAlso goldbook:09411 goldbook:09413)
AnnotationAssertion(rdfs:seeAlso goldbook:09411 goldbook:09299)
AnnotationAssertion(mito:isMentionedBy goldbook:09411 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09411 "current"^^xsd:string)
Declaration(Class(goldbook:09412))
AnnotationAssertion(rdfs:label goldbook:09412 "polyatomic fragment")
AnnotationAssertion(dcterms:description goldbook:09412 "Ion or neutral particle composed of three or more atoms.")
AnnotationAssertion(mito:isMentionedBy goldbook:09412 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09412 "current"^^xsd:string)
Declaration(Class(goldbook:09413))
AnnotationAssertion(rdfs:label goldbook:09413 "positive-ion yield")
AnnotationAssertion(dcterms:description goldbook:09413 "Number of positively-charged secondary ions sputtered from a sample divided by the total number of incident primary particles.")
AnnotationAssertion(rdfs:seeAlso goldbook:09413 goldbook:09401)
AnnotationAssertion(rdfs:seeAlso goldbook:09413 goldbook:09410)
AnnotationAssertion(rdfs:seeAlso goldbook:09413 goldbook:09422)
AnnotationAssertion(rdfs:seeAlso goldbook:09413 goldbook:09299)
AnnotationAssertion(mito:isMentionedBy goldbook:09413 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09413 "current"^^xsd:string)
Declaration(Class(goldbook:09414))
AnnotationAssertion(rdfs:label goldbook:09414 "primary ion")
AnnotationAssertion(dcterms:description goldbook:09414 "Ion extracted from a source and directed at a sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09414 goldbook:09378)
AnnotationAssertion(rdfs:seeAlso goldbook:09414 goldbook:09422)
AnnotationAssertion(mito:isMentionedBy goldbook:09414 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09414 "current"^^xsd:string)
Declaration(Class(goldbook:09415))
AnnotationAssertion(rdfs:label goldbook:09415 "pulse rate")
AnnotationAssertion(dcterms:description goldbook:09415 "Number of ion pulse cycles per second in secondary ion mass spectrometry.")
AnnotationAssertion(rdfs:seeAlso goldbook:09415 goldbook:09421)
AnnotationAssertion(rdfs:seeAlso goldbook:09415 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09415 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09415 "current"^^xsd:string)
Declaration(Class(goldbook:09416))
AnnotationAssertion(rdfs:label goldbook:09416 "pulse width")
AnnotationAssertion(dcterms:description goldbook:09416 "Full width at half maximum of the time distribution of the pulse of ions generated by a beam chopper and, optionally, the use of beam bunching in secondary ion mass spectrometry.")
AnnotationAssertion(rdfs:comment goldbook:09416 "The pulse width is usually measured using the \\(\\ce{H+}\\) ion. The velocity of \\(\\ce{H+}\\) ions, for a given extraction field, is larger than that of other ions. The width in time of the \\(\\ce{H+}\\) pulse thus provides a more reliable value for the width of the extraction pulse."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09416 goldbook:09393)
AnnotationAssertion(rdfs:seeAlso goldbook:09416 goldbook:09398)
AnnotationAssertion(rdfs:seeAlso goldbook:09416 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09416 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09416 "current"^^xsd:string)
Declaration(Class(goldbook:09417))
AnnotationAssertion(rdfs:label goldbook:09417 "pulsed extraction field")
AnnotationAssertion(dcterms:description goldbook:09417 "Extraction field around the sample that is pulsed to the working value for extracting ions for the time necessary for operation of a time-of-flight mass spectrometer, but is otherwise at a low value.")
AnnotationAssertion(rdfs:comment goldbook:09417 "This is the usual mode in time-of-flight secondary ion mass spectrometry systems, either for studying insulators, where charge neutralization is established while the extraction field is off, or for depth profiling using a second ion beam while the extraction field is off."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09417 goldbook:09398)
AnnotationAssertion(rdfs:seeAlso goldbook:09417 goldbook:09244)
AnnotationAssertion(rdfs:seeAlso goldbook:09417 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09417 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09417 "current"^^xsd:string)
Declaration(Class(goldbook:09418))
AnnotationAssertion(rdfs:label goldbook:09418 "reflector voltage")
AnnotationAssertion(dcterms:description goldbook:09418 "Electric potential set on the reflector electrode of a reflectron mass spectrometer with the zero referenced, such that an ion emitted from the sample with an energy numerically equal to the reflector voltage would just be on the point of reflection or transmission by the reflector electrode.")
AnnotationAssertion(rdfs:seeAlso goldbook:09418 goldbook:11544)
AnnotationAssertion(mito:isMentionedBy goldbook:09418 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09418 "current"^^xsd:string)
Declaration(Class(goldbook:09419))
AnnotationAssertion(rdfs:label goldbook:09419 "relative isotopic sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09419 "In dynamic secondary-ion mass spectrometry, coefficient for an element by which the measured intensity for an isotope of that element, divided by the measured intensity for a matrix ion, is multiplied to yield the atomic concentration of that isotope of the element present in the sample.")
AnnotationAssertion(rdfs:comment goldbook:09419 "Matrix terms are strong, and the matrix, bombarding species, incident-ion energy, and angle of incidence, as well as the spectrometer operating conditions, all affect relative elemental sensitivity factors significantly."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09419 goldbook:09183)
AnnotationAssertion(mito:isMentionedBy goldbook:09419 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09419 "current"^^xsd:string)
Declaration(Class(goldbook:09420))
AnnotationAssertion(rdfs:label goldbook:09420 "relative mass accuracy")
AnnotationAssertion(dcterms:description goldbook:09420 "Mass accuracy divided by reference mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:09420 goldbook:09406)
AnnotationAssertion(mito:isMentionedBy goldbook:09420 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09420 "current"^^xsd:string)
Declaration(Class(goldbook:09422))
AnnotationAssertion(rdfs:label goldbook:09422 "secondary ion")
AnnotationAssertion(dcterms:description goldbook:09422 "Ion ejected from a sample surface as a result of energy and momentum transfer from a primary ion.")
AnnotationAssertion(rdfs:seeAlso goldbook:09422 goldbook:09414)
AnnotationAssertion(mito:isMentionedBy goldbook:09422 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09422 "current"^^xsd:string)
Declaration(Class(goldbook:09424))
AnnotationAssertion(rdfs:label goldbook:09424 "secondary-ion angular distribution")
AnnotationAssertion(dcterms:description goldbook:09424 "Number of secondary ions as a function of angle of emission.")
AnnotationAssertion(mito:isMentionedBy goldbook:09424 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09424 "current"^^xsd:string)
Declaration(Class(goldbook:09425))
AnnotationAssertion(rdfs:label goldbook:09425 "secondary-ion energy distribution")
AnnotationAssertion(dcterms:description goldbook:09425 "Number of secondary ions as a function of kinetic energy at a specified collection angle.")
AnnotationAssertion(rdfs:seeAlso goldbook:09425 goldbook:09422)
AnnotationAssertion(mito:isMentionedBy goldbook:09425 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09425 "current"^^xsd:string)
Declaration(Class(goldbook:09426))
AnnotationAssertion(rdfs:label goldbook:09426 "secondary-ion yield")
AnnotationAssertion(dcterms:description goldbook:09426 "Number of ions sputtered from a sample divided by the number of ions incident with a given mass, energy, charge, and angle of incidence.")
AnnotationAssertion(mito:isMentionedBy goldbook:09426 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09426 "current"^^xsd:string)
Declaration(Class(goldbook:09427))
AnnotationAssertion(rdfs:label goldbook:09427 "shots per pixel")
AnnotationAssertion(dcterms:description goldbook:09427 "Number of ion pulses incident at each pixel in an image for one raster frame in secondary ion mass spectrometry.")
AnnotationAssertion(rdfs:seeAlso goldbook:09427 goldbook:09274)
AnnotationAssertion(rdfs:seeAlso goldbook:09427 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09427 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09427 "current"^^xsd:string)
Declaration(Class(goldbook:09428))
AnnotationAssertion(rdfs:label goldbook:09428 "SIMS ion image")
AnnotationAssertion(dcterms:description goldbook:09428 "Two-dimensional surface map of the spatial distribution of the amount of a particular secondary ion emitted from within a specific area of the sample in secondary ion mass spectrometry.")
AnnotationAssertion(rdfs:seeAlso goldbook:09428 goldbook:09192)
AnnotationAssertion(rdfs:seeAlso goldbook:09428 goldbook:09422)
AnnotationAssertion(rdfs:seeAlso goldbook:09428 goldbook:09293)
AnnotationAssertion(mito:isMentionedBy goldbook:09428 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09428 "current"^^xsd:string)
Declaration(Class(goldbook:09429))
AnnotationAssertion(rdfs:label goldbook:09429 "static limit")
AnnotationAssertion(dcterms:description goldbook:09429 "Ion fluence above which any significant changes in the spectrum, arising from beam damage, are observed in secondary ion mass spectrometry.")
AnnotationAssertion(rdfs:comment goldbook:09429 "Classically, a limit of \\(\\pu{E12}\\) ions per \\(\\pu{cm2}\\), or \\(\\pu{E16}\\) ions per \\(\\pu{m2}\\) is taken as the limit not to be exceeded in static secondary ion mass spectrometry. This limit is based on one incident ion for each \\(\\pu{1000}\\) surface atoms."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09429 "For imaging, the total molecular signal can be used, and here the limit can be greater and reach \\(\\pu{100}\\) times the limit given in Note 1."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09429 "For large molecules, the damage cross section and disappearance cross section are both generally larger than for small molecules, leading to a static limit less than \\(\\pu{E12}\\) ions per \\(\\pu{cm2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09429 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09429 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09429 "current"^^xsd:string)
Declaration(Class(goldbook:09430))
AnnotationAssertion(rdfs:label goldbook:09430 "stop event")
AnnotationAssertion(dcterms:description goldbook:09430 "Registration of a particle by a time-to-digital converter in secondary ion mass spectrometry.")
AnnotationAssertion(rdfs:comment goldbook:09430 "The arrival time for each ion providing a pulse at the detector is registered by the time-to-digital converter (TDC). This is a stop event. TDCs might only record a fixed number of stop events during the time following each primary-ion pulse, for example 512 or 1024, other events being lost."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09430 goldbook:09414)
AnnotationAssertion(rdfs:seeAlso goldbook:09430 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09430 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09430 "current"^^xsd:string)
Declaration(Class(goldbook:09431))
AnnotationAssertion(rdfs:label goldbook:09431 "transformation probability")
AnnotationAssertion(dcterms:description goldbook:09431 "Probability of a defined charged or neutral species being produced, by consumption of a defined parent atomic or molecular configuration at a surface, as a result of sputtering in secondary ion mass spectrometry.")
AnnotationAssertion(rdfs:seeAlso goldbook:09431 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09431 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09431 "current"^^xsd:string)
Declaration(Class(goldbook:09432))
AnnotationAssertion(rdfs:label goldbook:09432 "ultra-shallow depth profile")
AnnotationAssertion(dcterms:description goldbook:09432 "Depth profile in secondary-ion mass spectrometry where the depth over which significant changes occur is less than \\(\\pu{10 nm}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:09432 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09432 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09432 "current"^^xsd:string)
Declaration(Class(goldbook:09433))
AnnotationAssertion(rdfs:label goldbook:09433 "useful ion yield")
AnnotationAssertion(dcterms:description goldbook:09433 "In secondary ion mass spectrometry, number of ions of a particular isotope detected divided by the number of atoms of the same element sputtered from the sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:09433 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09433 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09433 "current"^^xsd:string)
Declaration(Class(goldbook:09434))
AnnotationAssertion(rdfs:label goldbook:09434 "useful spatial resolution")
AnnotationAssertion(dcterms:description goldbook:09434 "Image resolution in secondary ion mass spectrometry obtained in practice.")
AnnotationAssertion(rdfs:comment goldbook:09434 "The image resolution is poorer than the primary-ion beam diameter as a result of either the need to maintain the damage level below a limit set by the integrity of the data or the need to record sufficient signal when the sample is being consumed during analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09434 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09434 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09434 "current"^^xsd:string)
Declaration(Class(goldbook:09435))
AnnotationAssertion(rdfs:label goldbook:09435 "absorption length")
AnnotationAssertion(dcterms:description goldbook:09435 "Distance over which the transmitted X-ray intensity falls by \\(1/e\\), where \\(e\\) is the base of the natural logarithm.")
AnnotationAssertion(mito:isMentionedBy goldbook:09435 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09435 "current"^^xsd:string)
Declaration(Class(goldbook:09436))
AnnotationAssertion(rdfs:label goldbook:09436 "beam footprint")
AnnotationAssertion(dcterms:description goldbook:09436 "Area on the specimen irradiated by X-rays in X-ray reflectrometry.")
AnnotationAssertion(rdfs:comment goldbook:09436 "In typical commercial equipment, the beam width is \\(\\pu{200 \\upmu m}\\), so at \\(\\pu{0.3\\!^{\\circ}}\\) incident angle, the beam footprint is \\(\\pu{38 mm}\\) long; at \\(\\pu{1\\!^{\\circ}}\\), it is \\(\\pu{11.5 mm}\\) and at zero incidence angle it is infinite. For \\(\\pu{100 \\upmu m}\\) incident beam width, these values are halved."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09436 "The beam footprint along the beam direction can be reduced by the use of a suitable knife-edge diaphragm mounted in a plane that is normal to the sample surface and whose normal, in turn, aligns with the beam azimuth. The knife-edge is parallel to, and adjusted to be close to, the surface at the point where the X-ray beam centre strikes the sample surface. This closeness limits the footprint size but also reduces the measured signal intensity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09436 goldbook:09214)
AnnotationAssertion(mito:isMentionedBy goldbook:09436 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09436 "current"^^xsd:string)
Declaration(Class(goldbook:09437))
AnnotationAssertion(rdfs:label goldbook:09437 "beam spill-off")
AnnotationAssertion(dcterms:description goldbook:09437 "Fraction of the incident X-ray beam in X-ray reflectrometry missing the specimen.")
AnnotationAssertion(rdfs:seeAlso goldbook:09437 goldbook:09214)
AnnotationAssertion(mito:isMentionedBy goldbook:09437 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09437 "current"^^xsd:string)
Declaration(Class(goldbook:09438))
AnnotationAssertion(rdfs:label goldbook:09438 "delayed onset")
AnnotationAssertion(dcterms:description goldbook:09438 "X-ray energy at which there is a significant increase of absorption and for which the increased absorption occurs at a greater energy than a core-level binding energy.")
AnnotationAssertion(rdfs:comment goldbook:09438 "For many elements, there is a significant increase of absorption when the X-ray energy is equal to the electron-binding energy for a sub-shell. A delayed onset occurs for some elements and sub-shells when the corresponding increase of absorption occurs, instead, at an energy larger than the sub-shell binding energy."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09438 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09438 "current"^^xsd:string)
Declaration(Class(goldbook:09439))
AnnotationAssertion(rdfs:label goldbook:09439 "dispersion plane")
AnnotationAssertion(dcterms:description goldbook:09439 "Plane containing the source, detector, incident, and specularly reflected X–ray beams in X-ray reflectrometry.")
AnnotationAssertion(rdfs:seeAlso goldbook:09439 goldbook:09214)
AnnotationAssertion(mito:isMentionedBy goldbook:09439 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09439 "current"^^xsd:string)
Declaration(Class(goldbook:09440))
AnnotationAssertion(rdfs:label goldbook:09440 "total reflection of X-rays")
AnnotationAssertion(dcterms:description goldbook:09440 "Condition where the glancing angle for the incident X-rays is at or less than the critical angle and the X-rays are either reflected or absorbed in a region very close to the surface.")
AnnotationAssertion(rdfs:comment goldbook:09440 "The reflected intensity is close to \\(\\pu{100\\%}\\) of the incident intensity and the transmitted intensity is zero."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09440 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09440 "current"^^xsd:string)
Declaration(Class(goldbook:09441))
AnnotationAssertion(rdfs:label goldbook:09441 "wave vector")
AnnotationAssertion(dcterms:description goldbook:09441 "Vector in reciprocal space describing the direction of propagation of X-rays and equal in magnitude to \\(2\\uppi/\\lambda\\), where \\(\\lambda\\) is the wavelength of the X-rays.")
AnnotationAssertion(rdfs:comment goldbook:09441 "In different fields of study, the wave vector is taken as \\(2\\uppi/\\lambda\\) or as \\(1/\\lambda\\). In X-ray reflectometry the former is usually used."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09441 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09441 "current"^^xsd:string)
Declaration(Class(goldbook:09442))
AnnotationAssertion(rdfs:label goldbook:09442 "X-ray jump ratio")
AnnotationAssertion(dcterms:description goldbook:09442 "X-ray absorption coefficient at an energy just above an absorption edge divided by that at an energy just below the edge.")
AnnotationAssertion(rdfs:comment goldbook:09442 "X-ray absorption spectra can have complex shapes for X-ray energies in the vicinity of photoionization thresholds, and a well-defined edge is not always observed at the threshold."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09442 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09442 "current"^^xsd:string)
Declaration(Class(goldbook:09443))
AnnotationAssertion(rdfs:label goldbook:09443 "observed interface width")
AnnotationAssertion(dcterms:description goldbook:09443 "In secondary-ion mass spectrometry, Auger electron spectroscopy, and X-ray photoelectron spectroscopy, distance over which a change in signal intensity from \\(\\pu{16\\%}\\) to \\(\\pu{84\\%}\\), or from \\(\\pu{84\\%}\\) to \\(\\pu{16\\%}\\), is measured at the junction of two dissimilar matrices, the thicknesses of which are more than six times that distance")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09443 "depth resolution")
AnnotationAssertion(rdfs:comment goldbook:09443 "The change in signal intensity should be quoted with the observed interface width."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09443 goldbook:09172)
AnnotationAssertion(rdfs:seeAlso goldbook:09443 goldbook:09245)
AnnotationAssertion(rdfs:seeAlso goldbook:09443 goldbook:09192)
AnnotationAssertion(mito:isMentionedBy goldbook:09443 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09443 "current"^^xsd:string)
Declaration(Class(goldbook:09444))
AnnotationAssertion(rdfs:label goldbook:09444 "surface plasmon resonance")
AnnotationAssertion(dcterms:description goldbook:09444 "Resonant interaction between the natural frequency of a surface plasmon and incident light of the same frequency.")
AnnotationAssertion(rdfs:seeAlso goldbook:09444 goldbook:09294)
AnnotationAssertion(mito:isMentionedBy goldbook:09444 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09444 "current"^^xsd:string)
Declaration(Class(goldbook:09445))
AnnotationAssertion(rdfs:label goldbook:09445 "adhesion promoter")
AnnotationAssertion(dcterms:description goldbook:09445 "Interfacial agent comprised of molecules possessing two or more functional groups, each of which exhibits preferential interactions with the various types of phase domains in a composite.")
AnnotationAssertion(mito:isMentionedBy goldbook:09445 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09445 "current"^^xsd:string)
Declaration(Class(goldbook:09446))
AnnotationAssertion(rdfs:label goldbook:09446 "aerial image")
AnnotationAssertion(dcterms:description goldbook:09446 "Image of a mask pattern that is projected onto the photoresist coated wafer by an optical system.")
AnnotationAssertion(rdfs:seeAlso goldbook:09446 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09446 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09446 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09446 "current"^^xsd:string)
Declaration(Class(goldbook:09447))
AnnotationAssertion(rdfs:label goldbook:09447 "annealing")
AnnotationAssertion(dcterms:description goldbook:09447 "Thermal treatment of a solid polymer material at a fixed or changing temperature that leads to desired changes in its physical structure and properties without involving complete melting or dissolution.")
AnnotationAssertion(rdfs:comment goldbook:09447 "Annealing of a crystalline polymer is usually carried out by keeping the polymer at temperatures just below its melting point."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09447 "Annealing may be carried out by exposure of a crystalline polymer to a poor solvent or to its vapors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09447 "In a crystalline polymer, the process of annealing leads to reorganization and involves an increase of order in existing crystallites, an increase in degree of crystallinity, and changes to more stable polymorphs."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09447 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09447 "current"^^xsd:string)
Declaration(Class(goldbook:09448))
AnnotationAssertion(rdfs:label goldbook:09448 "solvent vapor annealing")
AnnotationAssertion(dcterms:description goldbook:09448 "Annealing via the exposure of a substrate to solvent vapor.")
AnnotationAssertion(rdfs:comment goldbook:09448 "Solvent vapor annealing is most commonly used in lithography to process block copolymer (BCP) thin films, often leading to a more equilibrated structure."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09448 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09448 "current"^^xsd:string)
Declaration(Class(goldbook:09449))
AnnotationAssertion(rdfs:label goldbook:09449 "thermal annealing")
AnnotationAssertion(dcterms:description goldbook:09449 "Annealing in which a heating step is used to activate chemical processes in a resist that depend on diffusion.")
AnnotationAssertion(rdfs:comment goldbook:09449 "Thermal annealing is frequently employed in photolithography and in block copolymer lithography."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09449 goldbook:09454)
AnnotationAssertion(rdfs:seeAlso goldbook:09449 goldbook:09517)
AnnotationAssertion(rdfs:seeAlso goldbook:09449 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09449 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09449 "current"^^xsd:string)
Declaration(Class(goldbook:09450))
AnnotationAssertion(rdfs:label goldbook:09450 "anti-reflective coating")
AnnotationAssertion(dcterms:description goldbook:09450 "Material used in lithography or in other technologies that is applied to a surface in order to reduce reflection.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09450 "ARC")
AnnotationAssertion(rdfs:seeAlso goldbook:09450 goldbook:09503)
AnnotationAssertion(mito:isMentionedBy goldbook:09450 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09450 "current"^^xsd:string)
Declaration(Class(goldbook:09451))
AnnotationAssertion(rdfs:label goldbook:09451 "aspect ratio")
AnnotationAssertion(dcterms:description goldbook:09451 "Proportional relationship between the width and height of an image produced by exposing a resist.")
AnnotationAssertion(rdfs:seeAlso goldbook:09451 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09451 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09451 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09451 "current"^^xsd:string)
Declaration(Class(goldbook:09452))
AnnotationAssertion(rdfs:label goldbook:09452 "atomic force microscopy")
AnnotationAssertion(dcterms:description goldbook:09452 "High-resolution scanning probe microscopy that maps a surface with a demonstrated resolution of the order of fractions of a nanometer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09452 "AFM")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09452 "scanning force microscopy (SFM)")
AnnotationAssertion(rdfs:comment goldbook:09452 "Such tools for microscopy may also be used for nanoscale pattern generation of thin organic films on substrates."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09452 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09452 "current"^^xsd:string)
Declaration(Class(goldbook:09453))
AnnotationAssertion(rdfs:label goldbook:09453 "base quencher")
AnnotationAssertion(dcterms:description goldbook:09453 "Base added to a chemical amplification resist to neutralize low levels of acid that might diffuse into nominally unexposed regions and cause blur.")
AnnotationAssertion(rdfs:seeAlso goldbook:09453 goldbook:09565)
AnnotationAssertion(mito:isMentionedBy goldbook:09453 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09453 "current"^^xsd:string)
Declaration(Class(goldbook:09454))
AnnotationAssertion(rdfs:label goldbook:09454 "block copolymer lithography")
AnnotationAssertion(dcterms:description goldbook:09454 "Process in which a thin film of block copolymer is formed into a regular nanoscale pattern.")
AnnotationAssertion(rdfs:seeAlso goldbook:09454 goldbook:09470)
AnnotationAssertion(mito:isMentionedBy goldbook:09454 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09454 "current"^^xsd:string)
Declaration(Class(goldbook:09455))
AnnotationAssertion(rdfs:label goldbook:09455 "bottom anti-reflective coating")
AnnotationAssertion(dcterms:description goldbook:09455 "Layer placed between a photoresist and a substrate to prevent reflection from the latter resulting in a reduction in photoresist pattern quality, as characterized by resolution, line edge roughness, etc.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09455 "BARC")
AnnotationAssertion(rdfs:seeAlso goldbook:09455 goldbook:09500)
AnnotationAssertion(mito:isMentionedBy goldbook:09455 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09455 "current"^^xsd:string)
Declaration(Class(goldbook:09456))
AnnotationAssertion(rdfs:label goldbook:09456 "bottom-up lithography")
AnnotationAssertion(dcterms:description goldbook:09456 "Pattern formation using self-assembly processes.")
AnnotationAssertion(mito:isMentionedBy goldbook:09456 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09456 "current"^^xsd:string)
Declaration(Class(goldbook:09457))
AnnotationAssertion(rdfs:label goldbook:09457 "basting solvent")
AnnotationAssertion(dcterms:description goldbook:09457 "Solvent in which a resist or additional thin-film component (typically a BARC) is dissolved for the coating process.")
AnnotationAssertion(rdfs:seeAlso goldbook:09457 goldbook:09455)
AnnotationAssertion(rdfs:seeAlso goldbook:09457 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09457 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09457 "current"^^xsd:string)
Declaration(Class(goldbook:09458))
AnnotationAssertion(rdfs:label goldbook:09458 "clearance dose")
AnnotationAssertion(dcterms:description goldbook:09458 "Dose of radiation required to completely remove a positive-tone resist from a large area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09458 "clearing dose")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09458 "dose to clear")
AnnotationAssertion(rdfs:seeAlso goldbook:09458 goldbook:09477)
AnnotationAssertion(rdfs:seeAlso goldbook:09458 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09458 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09458 "current"^^xsd:string)
Declaration(Class(goldbook:09459))
AnnotationAssertion(rdfs:label goldbook:09459 "contact hole")
AnnotationAssertion(dcterms:description goldbook:09459 "Hole in a layer of a semiconductor device enabling contact with an underlying semiconductor layer.")
AnnotationAssertion(rdfs:comment goldbook:09459 "Contact holes are usually of a diameter less than \\(\\pu{100 nm}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09459 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09459 "current"^^xsd:string)
Declaration(Class(goldbook:09460))
AnnotationAssertion(rdfs:label goldbook:09460 "contrast")
AnnotationAssertion(dcterms:description goldbook:09460 "Maximum of the absolute value of the gradient of a contrast curve taken as a measure of the ability of a resist to differentiate the regions that have been exposed to radiation from those that have not.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09460 "contrast ratio")
AnnotationAssertion(rdfs:comment goldbook:09460 "For ease of determination, for positive- and negative-tone resists respectively, contrasts are usually calculated as \\[\\gamma =\\frac{1}{2\\log_{10} (D_{\\rm{n}}^{0.5}/D_{\\rm{n}}^{0})} \\quad {\\rm{and}} \\quad \\gamma =\\frac{1}{2\\log_{10} (D_{\\rm{p}}^1 /D_{\\rm{p}}^{0.5})}\\] in which \\(D_{\\rm{n}}^{0}\\), \\(D_{\\rm{n,p}}^{0.5}\\), and \\(D_{\\rm{p}}^{1}\\) are the incident exposure doses to light or radiation required for incipient gel formation in a negative-tone system, the dose at \\(\\pu{50\\%}\\) of the original resist thickness remaining after development for either system, and the clearance dose for a positive-tone system, respectively."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09460 goldbook:09461)
AnnotationAssertion(rdfs:seeAlso goldbook:09460 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09460 goldbook:09477)
AnnotationAssertion(rdfs:seeAlso goldbook:09460 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09460 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09460 "current"^^xsd:string)
Declaration(Class(goldbook:09461))
AnnotationAssertion(rdfs:label goldbook:09461 "contrast curve")
AnnotationAssertion(dcterms:description goldbook:09461 "Plot of the fraction of the original thickness that remains after the development of a uniformly irradiated resist versus the logarithm of the incident exposure dose.")
AnnotationAssertion(rdfs:seeAlso goldbook:09461 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09461 goldbook:09477)
AnnotationAssertion(rdfs:seeAlso goldbook:09461 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09461 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09461 "current"^^xsd:string)
Declaration(Class(goldbook:09462))
AnnotationAssertion(rdfs:label goldbook:09462 "critical dimension")
AnnotationAssertion(dcterms:description goldbook:09462 "Length of the smallest geometrical features that can be formed in a lithographic process.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09462 "CD")
AnnotationAssertion(rdfs:comment goldbook:09462 "The final device CD is often notably smaller than the smallest geometrical features that can be formed in a lithographic process, achieved, for example, by etch or slimming processes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09462 "The critical dimension uniformity (CDU), which is a statistical measurement of the variation in length of the smallest geometrical feature, is often as low as \\(3\\:\\upsigma\\) of \\(\\pu{10\\%}\\) of the CD."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09462 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09462 "current"^^xsd:string)
Declaration(Class(goldbook:09463))
AnnotationAssertion(rdfs:label goldbook:09463 "dark loss")
AnnotationAssertion(dcterms:description goldbook:09463 "Unwanted change in the solubility of a resist that takes place in the absence of exposure.")
AnnotationAssertion(rdfs:seeAlso goldbook:09463 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09463 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09463 "current"^^xsd:string)
Declaration(Class(goldbook:09464))
AnnotationAssertion(rdfs:label goldbook:09464 "defect")
AnnotationAssertion(dcterms:description goldbook:09464 "Imperfection introduced during pattern formation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09464 "image defect")
AnnotationAssertion(mito:isMentionedBy goldbook:09464 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09464 "current"^^xsd:string)
Declaration(Class(goldbook:09465))
AnnotationAssertion(rdfs:label goldbook:09465 "defect-free pattern")
AnnotationAssertion(dcterms:description goldbook:09465 "Imaged resist without imperfections in pattern.")
AnnotationAssertion(rdfs:comment goldbook:09465 "In a photoresist, for example, no error is introduced by the photochemistry."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09465 "In a DSA resist, for example, no error is introduced by the self-assembly process."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09465 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09465 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09465 "current"^^xsd:string)
Declaration(Class(goldbook:09466))
AnnotationAssertion(rdfs:label goldbook:09466 "deprotection")
AnnotationAssertion(dcterms:description goldbook:09466 "Removal of a protecting group which leads to a change in the solubility of a polymeric resist.")
AnnotationAssertion(rdfs:comment goldbook:09466 "Deprotection is a common feature in the performance of most chemical amplification resists."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09466 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09466 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09466 "current"^^xsd:string)
Declaration(Class(goldbook:09467))
AnnotationAssertion(rdfs:label goldbook:09467 "depth of focus")
AnnotationAssertion(dcterms:description goldbook:09467 "Tolerance of the placement of the image plane in relation to image quality.")
AnnotationAssertion(rdfs:comment goldbook:09467 "Term used in an exposed and developed photoresist."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09467 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09467 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09467 "current"^^xsd:string)
Declaration(Class(goldbook:09468))
AnnotationAssertion(rdfs:label goldbook:09468 "development")
AnnotationAssertion(dcterms:description goldbook:09468 "Process in which a developer is used to generate an image by removing the soluble portion of the latent pattern of an exposed resist.")
AnnotationAssertion(rdfs:comment goldbook:09468 "Aqueous-based development is carried out using a \\(\\pu{0.262 M}\\) solution of tetramethylammonium hydroxide in water as developer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09468 "Solvent development is carried out using a non-polar solvent as a developer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09468 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09468 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09468 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09468 "current"^^xsd:string)
Declaration(Class(goldbook:09469))
AnnotationAssertion(rdfs:label goldbook:09469 "dip-pen nanolithography")
AnnotationAssertion(dcterms:description goldbook:09469 "Direct write, tip-based patterning method that uses the tip of an AFM probe to act as a pen and deposit molecules on a surface.")
AnnotationAssertion(rdfs:comment goldbook:09469 "The ink used in dip-pen nanolithography often consists of thiols that self-assemble on surfaces."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09469 goldbook:09515)
AnnotationAssertion(mito:isMentionedBy goldbook:09469 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09469 "current"^^xsd:string)
Declaration(Class(goldbook:09470))
AnnotationAssertion(rdfs:label goldbook:09470 "directed self-assembly")
AnnotationAssertion(dcterms:description goldbook:09470 "Process in which a thin film of block copolymer is formed into a regular nanoscale pattern on chemically or topographically nanopatterned surfaces (or a combination thereof).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09470 "DSA")
AnnotationAssertion(rdfs:seeAlso goldbook:09470 goldbook:09539)
AnnotationAssertion(mito:isMentionedBy goldbook:09470 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09470 "current"^^xsd:string)
Declaration(Class(goldbook:09471))
AnnotationAssertion(rdfs:label goldbook:09471 "dislocation")
AnnotationAssertion(dcterms:description goldbook:09471 "Defect, or irregularity, within an ordered structure.")
AnnotationAssertion(rdfs:comment goldbook:09471 "A screw dislocation is a structure in which a helical path is traced around a linear defect (dislocation line) by the atomic planes in the crystal lattice."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09471 "An edge dislocation is a defect where an extra half-plane of atoms is introduced mid-way through the crystal."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09471 "In the context of lithography, a dislocation may be found in a block copolymer pattern."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09471 goldbook:09464)
AnnotationAssertion(rdfs:seeAlso goldbook:09471 goldbook:09503)
AnnotationAssertion(mito:isMentionedBy goldbook:09471 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09471 "current"^^xsd:string)
Declaration(Class(goldbook:09472))
AnnotationAssertion(rdfs:label goldbook:09472 "dissolution inhibitor")
AnnotationAssertion(dcterms:description goldbook:09472 "Compound that, when included in a resist formulation, slows the rate of dissolution.")
AnnotationAssertion(rdfs:comment goldbook:09472 "In lithography, the effectiveness of a dissolution inhibitor is changed after exposure to imaging radiation, which facilitates its application in resist formulations."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09472 "A typical example of a resist based on a dissolution inhibitor comprises a diazonaphthoquinone within a phenolic resin."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09472 goldbook:09503)
AnnotationAssertion(rdfs:seeAlso goldbook:09472 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09472 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09472 "current"^^xsd:string)
Declaration(Class(goldbook:09473))
AnnotationAssertion(rdfs:label goldbook:09473 "dissolution promoter")
AnnotationAssertion(dcterms:description goldbook:09473 "Compound that, when included in a resist formulation, increases the rate of dissolution.")
AnnotationAssertion(rdfs:seeAlso goldbook:09473 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09473 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09473 "current"^^xsd:string)
Declaration(Class(goldbook:09474))
AnnotationAssertion(rdfs:label goldbook:09474 "dissolution rate")
AnnotationAssertion(dcterms:description goldbook:09474 "Rate at which resist is removed during development.")
AnnotationAssertion(rdfs:comment goldbook:09474 "Usually reported in \\(\\pu{nm s^{-1}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09474 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09474 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09474 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09474 "current"^^xsd:string)
Declaration(Class(goldbook:09475))
AnnotationAssertion(rdfs:label goldbook:09475 "doctor blading")
AnnotationAssertion(dcterms:description goldbook:09475 "Coating of solution or slurry drawn to uniform film by use of a knife edge or doctor blade.")
AnnotationAssertion(rdfs:comment goldbook:09475 "The term has been borrowed from printing and coating technologies. It is believed that it derives from the blades employed in letter press equipment that were used to wipe so-called ductor rolls, the term \"ductor\" becoming doctor over time."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09475 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09475 "current"^^xsd:string)
Declaration(Class(goldbook:09476))
AnnotationAssertion(rdfs:label goldbook:09476 "doping (p- and n-type)")
AnnotationAssertion(dcterms:description goldbook:09476 "Process that increases the thermal-equilibrium concentration of free charge carriers in a material to augment its electrical conductivity using chemical agents or additives (i.e. dopants).")
AnnotationAssertion(rdfs:comment goldbook:09476 "Typical dopants to organic polymers (compounds) are:Oxidants, giving positively charged (p-doped) polymers that act as hole conductors;Reductants, giving negatively charged (n-doped) polymers that mostly act as electron conductors;Strong Brønsted acids, which are indispensable dopants to polymers such as polyaniline."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09476 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09476 "current"^^xsd:string)
Declaration(Class(goldbook:09478))
AnnotationAssertion(rdfs:label goldbook:09478 "double exposure")
AnnotationAssertion(dcterms:description goldbook:09478 "Lithographic process requiring two exposures to radiation for a single resist layer to form a finished pattern.")
AnnotationAssertion(rdfs:seeAlso goldbook:09478 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09478 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09478 "current"^^xsd:string)
Declaration(Class(goldbook:09479))
AnnotationAssertion(rdfs:label goldbook:09479 "double patterning")
AnnotationAssertion(dcterms:description goldbook:09479 "Printing of two distinct lines at the edges of a single resist line pattern by means of a deposit-etch process.")
AnnotationAssertion(rdfs:seeAlso goldbook:09479 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09479 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09479 "current"^^xsd:string)
Declaration(Class(goldbook:09480))
AnnotationAssertion(rdfs:label goldbook:09480 "dry deposition")
AnnotationAssertion(dcterms:description goldbook:09480 "Assembly of a layer on a substrate by the use of a solvent-free process, such as vapor deposition.")
AnnotationAssertion(rdfs:seeAlso goldbook:09480 goldbook:09582)
AnnotationAssertion(mito:isMentionedBy goldbook:09480 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09480 "current"^^xsd:string)
Declaration(Class(goldbook:09481))
AnnotationAssertion(rdfs:label goldbook:09481 "dry development")
AnnotationAssertion(dcterms:description goldbook:09481 "Process in which a portion of a latent pattern in an exposed resist is removed to form the image without the use of a liquid developer.")
AnnotationAssertion(rdfs:seeAlso goldbook:09481 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09481 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09481 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09481 "current"^^xsd:string)
Declaration(Class(goldbook:09482))
AnnotationAssertion(rdfs:label goldbook:09482 "dry-etch resistance")
AnnotationAssertion(dcterms:description goldbook:09482 "Facility of an exposed resist to withstand etching conditions, usually a plasma, determined in comparison to a reference standard.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09482 "etch resistance")
AnnotationAssertion(rdfs:comment goldbook:09482 "Plasma may be oxygen or halogen-based."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09482 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09482 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09482 "current"^^xsd:string)
Declaration(Class(goldbook:09483))
AnnotationAssertion(rdfs:label goldbook:09483 "dual-tone resist")
AnnotationAssertion(dcterms:description goldbook:09483 "Photoresist capable of being processed in either positive tone (aqueous base development) or negative tone (organic solvent development).")
AnnotationAssertion(mito:isMentionedBy goldbook:09483 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09483 "current"^^xsd:string)
Declaration(Class(goldbook:09484))
AnnotationAssertion(rdfs:label goldbook:09484 "edge acuity")
AnnotationAssertion(dcterms:description goldbook:09484 "Degree to which the edge of an image appears sharp and precise.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09484 "edge sharpness")
AnnotationAssertion(rdfs:seeAlso goldbook:09484 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09484 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09484 "current"^^xsd:string)
Declaration(Class(goldbook:09485))
AnnotationAssertion(rdfs:label goldbook:09485 "embossing")
AnnotationAssertion(dcterms:description goldbook:09485 "Creating a pattern by pressing a master die into a malleable material.")
AnnotationAssertion(mito:isMentionedBy goldbook:09485 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09485 "current"^^xsd:string)
Declaration(Class(goldbook:09486))
AnnotationAssertion(rdfs:label goldbook:09486 "epitaxial crystallization")
AnnotationAssertion(dcterms:description goldbook:09486 "Growth of crystals on other crystals involving a precisely defined mutual orientation of their lattices.")
AnnotationAssertion(rdfs:comment goldbook:09486 "The process involves heterogeneous nucleation of the growing crystals by the substrate crystal faces."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09486 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09486 "current"^^xsd:string)
Declaration(Class(goldbook:09487))
AnnotationAssertion(rdfs:label goldbook:09487 "epitaxy")
AnnotationAssertion(dcterms:description goldbook:09487 "Deposition of a crystalline over layer on a crystalline substrate.")
AnnotationAssertion(rdfs:comment goldbook:09487 "The over layer is called an epitaxial film or epitaxial layer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09487 "An ordered spatial relationship existing between the lattices of substrate crystals and those grown by epitaxial crystallization on top of the substrate crystals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09487 "Examples involving polymers are given under the terms homoepitaxy and heteroepitaxy, where if the crystals are of the same substance, but possibly different polymorphs, the former term applies, in contrast to the use of the latter term, which involves crystals of two different substances."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09487 "The term epitaxy is sometimes used for epitaxial crystallization. This use is not recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09487 goldbook:09486)
AnnotationAssertion(mito:isMentionedBy goldbook:09487 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09487 "current"^^xsd:string)
Declaration(Class(goldbook:09488))
AnnotationAssertion(rdfs:label goldbook:09488 "etch")
AnnotationAssertion(dcterms:description goldbook:09488 "Treatment to remove substrate to a requisite depth from those areas of a surface no longer protected following the exposure and development of an overlaid resist.")
AnnotationAssertion(rdfs:seeAlso goldbook:09488 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09488 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09488 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09488 "current"^^xsd:string)
Declaration(Class(goldbook:09489))
AnnotationAssertion(rdfs:label goldbook:09489 "dry etching")
AnnotationAssertion(dcterms:description goldbook:09489 "Process of removal of material, typically of a masked pattern on a semiconductor, by exposing it to a bombardment of ions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09489 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09489 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09489 "current"^^xsd:string)
Declaration(Class(goldbook:09490))
AnnotationAssertion(rdfs:label goldbook:09490 "etch rate")
AnnotationAssertion(dcterms:description goldbook:09490 "Rate of material removal using either a wet or a dry-etch process.")
AnnotationAssertion(rdfs:comment goldbook:09490 "Usually reported in \\(\\pu{\\upmu m min-1}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09490 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09490 "current"^^xsd:string)
Declaration(Class(goldbook:09491))
AnnotationAssertion(rdfs:label goldbook:09491 "wet etching")
AnnotationAssertion(dcterms:description goldbook:09491 "Process of removal of material, typically of a masked pattern on a semiconductor, by exposing it to a corrosive liquid.")
AnnotationAssertion(rdfs:seeAlso goldbook:09491 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09491 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09491 "current"^^xsd:string)
Declaration(Class(goldbook:09492))
AnnotationAssertion(rdfs:label goldbook:09492 "exposure latitude")
AnnotationAssertion(dcterms:description goldbook:09492 "Extent to which a light- or radiation-sensitive material can be overexposed or underexposed and still achieve acceptable imaging.")
AnnotationAssertion(mito:isMentionedBy goldbook:09492 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09492 "current"^^xsd:string)
Declaration(Class(goldbook:09493))
AnnotationAssertion(rdfs:label goldbook:09493 "focused ion beam")
AnnotationAssertion(dcterms:description goldbook:09493 "Technique used for the site-specific analysis, deposition, ablation, and micromachining of materials down to dimensions of \\(\\pu{10}\\) to \\(\\pu{15 nm}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09493 "FIB")
AnnotationAssertion(rdfs:comment goldbook:09493 "FIB should not be confused with ion-beam lithography."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09493 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09493 "current"^^xsd:string)
Declaration(Class(goldbook:09494))
AnnotationAssertion(rdfs:label goldbook:09494 "hard bake")
AnnotationAssertion(dcterms:description goldbook:09494 "High temperature annealing to solidify any resist material remaining after development in order to provide a durable protective layer for etching.")
AnnotationAssertion(rdfs:seeAlso goldbook:09494 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09494 goldbook:09488)
AnnotationAssertion(rdfs:seeAlso goldbook:09494 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09494 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09494 "current"^^xsd:string)
Declaration(Class(goldbook:09495))
AnnotationAssertion(rdfs:label goldbook:09495 "image")
AnnotationAssertion(dcterms:description goldbook:09495 "Pattern produced in or on a substrate during a lithographic process.")
AnnotationAssertion(rdfs:comment goldbook:09495 "The term was originally used to describe patterns produced by means of light exposure followed by development, but with the growth in the number of lithographic methods it may now refer to those produced by molding, embossing, or other kinds of patterning processes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09495 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09495 goldbook:09485)
AnnotationAssertion(mito:isMentionedBy goldbook:09495 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09495 "current"^^xsd:string)
Declaration(Class(goldbook:09496))
AnnotationAssertion(rdfs:label goldbook:09496 "developed image")
AnnotationAssertion(dcterms:description goldbook:09496 "Visible image produced by an effect of radiation on a substrate followed by subsequent lithographic development.")
AnnotationAssertion(rdfs:seeAlso goldbook:09496 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09496 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09496 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09496 "current"^^xsd:string)
Declaration(Class(goldbook:09497))
AnnotationAssertion(rdfs:label goldbook:09497 "image blur")
AnnotationAssertion(dcterms:description goldbook:09497 "Broadening during the development of a lithographic image.")
AnnotationAssertion(rdfs:comment goldbook:09497 "Image blur is measured as the distance between regions of \\(\\pu{12}\\) and \\(\\pu{88\\%}\\) maximum exposure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09497 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09497 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09497 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09497 "current"^^xsd:string)
Declaration(Class(goldbook:09498))
AnnotationAssertion(rdfs:label goldbook:09498 "immersion fluid")
AnnotationAssertion(dcterms:description goldbook:09498 "High refractive index liquid medium used in immersion lithography that replaces the air gap between the lens and the resist surface in conventional photolithography.")
AnnotationAssertion(rdfs:seeAlso goldbook:09498 goldbook:09508)
AnnotationAssertion(rdfs:seeAlso goldbook:09498 goldbook:09517)
AnnotationAssertion(rdfs:seeAlso goldbook:09498 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09498 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09498 "current"^^xsd:string)
Declaration(Class(goldbook:09499))
AnnotationAssertion(rdfs:label goldbook:09499 "lift-off process")
AnnotationAssertion(dcterms:description goldbook:09499 "Method whereby a film, usually metallic, deposited on a patterned substrate after etch processing, is removed during resist strip, which leaves only that portion of the film that is deposited directly onto the exposed regions of the substrate.")
AnnotationAssertion(rdfs:comment goldbook:09499 "A lift-off process is commonly employed to pattern substrates when using resists that have little or no dry-etch resistance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09499 goldbook:09489)
AnnotationAssertion(rdfs:seeAlso goldbook:09499 goldbook:09488)
AnnotationAssertion(rdfs:seeAlso goldbook:09499 goldbook:09571)
AnnotationAssertion(rdfs:seeAlso goldbook:09499 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09499 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09499 "current"^^xsd:string)
Declaration(Class(goldbook:09500))
AnnotationAssertion(rdfs:label goldbook:09500 "line edge roughness")
AnnotationAssertion(dcterms:description goldbook:09500 "Variations along one edge of a linear resist feature over an extended length.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09500 "LER")
AnnotationAssertion(rdfs:seeAlso goldbook:09500 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09500 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09500 "current"^^xsd:string)
Declaration(Class(goldbook:09501))
AnnotationAssertion(rdfs:label goldbook:09501 "line width roughness")
AnnotationAssertion(dcterms:description goldbook:09501 "Variations in the width of a linear resist feature over an extended length.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09501 "LWR")
AnnotationAssertion(rdfs:seeAlso goldbook:09501 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09501 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09501 "current"^^xsd:string)
Declaration(Class(goldbook:09502))
AnnotationAssertion(rdfs:label goldbook:09502 "line-space patterning")
AnnotationAssertion(dcterms:description goldbook:09502 "Developed lithographic pattern comprising alternating lines with spaces between.")
AnnotationAssertion(mito:isMentionedBy goldbook:09502 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09502 "current"^^xsd:string)
Declaration(Class(goldbook:09503))
AnnotationAssertion(rdfs:label goldbook:09503 "lithography")
AnnotationAssertion(dcterms:description goldbook:09503 "Process whereby an image is created on an apparently planar surface.")
AnnotationAssertion(rdfs:comment goldbook:09503 "The term was originally applied within printing technology, but its usage has been extended to embrace the imaging processes of the microfabrication techniques used to make integrated circuits and microelectromechanical systems."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09503 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09503 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09503 "current"^^xsd:string)
Declaration(Class(goldbook:09504))
AnnotationAssertion(rdfs:label goldbook:09504 "direct-write lithography")
AnnotationAssertion(dcterms:description goldbook:09504 "Pattern created without recourse to irradiation through a mask of the image.")
AnnotationAssertion(rdfs:comment goldbook:09504 "Typical direct-write imaging systems are electron-beam lithography and ion-beam lithography."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09504 goldbook:09505)
AnnotationAssertion(rdfs:seeAlso goldbook:09504 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09504 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09504 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09504 "current"^^xsd:string)
Declaration(Class(goldbook:09505))
AnnotationAssertion(rdfs:label goldbook:09505 "electron beam lithography")
AnnotationAssertion(dcterms:description goldbook:09505 "Lithography performed by exposing a resist to a beam of electrons.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09505 "e-beam lithography")
AnnotationAssertion(rdfs:seeAlso goldbook:09505 goldbook:09503)
AnnotationAssertion(rdfs:seeAlso goldbook:09505 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09505 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09505 "current"^^xsd:string)
Declaration(Class(goldbook:09506))
AnnotationAssertion(rdfs:label goldbook:09506 "electron-beam direct-write lithography")
AnnotationAssertion(dcterms:description goldbook:09506 "Electron beam lithography whereby the pattern is written directly onto the photoresist without the use of a mask.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09506 "EBDW")
AnnotationAssertion(rdfs:seeAlso goldbook:09506 goldbook:09505)
AnnotationAssertion(rdfs:seeAlso goldbook:09506 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09506 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09506 "current"^^xsd:string)
Declaration(Class(goldbook:09507))
AnnotationAssertion(rdfs:label goldbook:09507 "extreme ultraviolet lithography")
AnnotationAssertion(dcterms:description goldbook:09507 "Photolithography performed by exposing a resist to extreme ultraviolet (\\(\\pu{13 nm}\\)) radiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09507 "EUVL")
AnnotationAssertion(rdfs:seeAlso goldbook:09507 goldbook:09517)
AnnotationAssertion(rdfs:seeAlso goldbook:09507 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09507 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09507 "current"^^xsd:string)
Declaration(Class(goldbook:09508))
AnnotationAssertion(rdfs:label goldbook:09508 "immersion lithography")
AnnotationAssertion(dcterms:description goldbook:09508 "Photolithography that provides resolution enhancement by immersing a resist-coated substrate in a fluid during the exposure process.")
AnnotationAssertion(rdfs:seeAlso goldbook:09508 goldbook:09517)
AnnotationAssertion(rdfs:seeAlso goldbook:09508 goldbook:09498)
AnnotationAssertion(rdfs:seeAlso goldbook:09508 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09508 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09508 "current"^^xsd:string)
Declaration(Class(goldbook:09509))
AnnotationAssertion(rdfs:label goldbook:09509 "imprint lithography")
AnnotationAssertion(dcterms:description goldbook:09509 "Patterns created by mechanical deformation of an imprint resist and a subsequent curing process.")
AnnotationAssertion(rdfs:seeAlso goldbook:09509 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09509 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09509 "current"^^xsd:string)
Declaration(Class(goldbook:09510))
AnnotationAssertion(rdfs:label goldbook:09510 "nanoimprint lithography")
AnnotationAssertion(dcterms:description goldbook:09510 "Subset of imprint lithography that allows for the fabrication of nanometer scale patterns.")
AnnotationAssertion(rdfs:seeAlso goldbook:09510 goldbook:09509)
AnnotationAssertion(mito:isMentionedBy goldbook:09510 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09510 "current"^^xsd:string)
Declaration(Class(goldbook:09511))
AnnotationAssertion(rdfs:label goldbook:09511 "interference lithography")
AnnotationAssertion(dcterms:description goldbook:09511 "Technique for patterning regular arrays of fine features without the use of complex optical systems or photomasks.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09511 "holographic lithography")
AnnotationAssertion(rdfs:seeAlso goldbook:09511 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09511 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09511 "current"^^xsd:string)
Declaration(Class(goldbook:09512))
AnnotationAssertion(rdfs:label goldbook:09512 "magnetolithography")
AnnotationAssertion(dcterms:description goldbook:09512 "Lithography for direct patterning of surfaces based on the application of a magnetic field to the substrate using paramagnetic metal masks.")
AnnotationAssertion(rdfs:seeAlso goldbook:09512 goldbook:09503)
AnnotationAssertion(rdfs:seeAlso goldbook:09512 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09512 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09512 "current"^^xsd:string)
Declaration(Class(goldbook:09513))
AnnotationAssertion(rdfs:label goldbook:09513 "maskless lithography")
AnnotationAssertion(dcterms:description goldbook:09513 "Lithography that does not need a mask of the image to make a pattern.")
AnnotationAssertion(rdfs:seeAlso goldbook:09513 goldbook:09503)
AnnotationAssertion(rdfs:seeAlso goldbook:09513 goldbook:09504)
AnnotationAssertion(rdfs:seeAlso goldbook:09513 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09513 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09513 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09513 "current"^^xsd:string)
Declaration(Class(goldbook:09514))
AnnotationAssertion(rdfs:label goldbook:09514 "microlithography")
AnnotationAssertion(dcterms:description goldbook:09514 "Lithography or pattern formation at a resolution of the order of microns.")
AnnotationAssertion(rdfs:seeAlso goldbook:09514 goldbook:09503)
AnnotationAssertion(mito:isMentionedBy goldbook:09514 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09514 "current"^^xsd:string)
Declaration(Class(goldbook:09515))
AnnotationAssertion(rdfs:label goldbook:09515 "nanolithography")
AnnotationAssertion(dcterms:description goldbook:09515 "Umbrella term that is used to describe all lithographic techniques that allow for the fabrication of nanometer scale patterns.")
AnnotationAssertion(mito:isMentionedBy goldbook:09515 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09515 "current"^^xsd:string)
Declaration(Class(goldbook:09516))
AnnotationAssertion(rdfs:label goldbook:09516 "nanosphere lithography")
AnnotationAssertion(dcterms:description goldbook:09516 "Lithography in which material is deposited into the interstices of a 2D array of nanospheres that are subsequently removed to form a pattern.")
AnnotationAssertion(rdfs:comment goldbook:09516 "Vapor deposition is the most commonly used deposition technique."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09516 goldbook:09503)
AnnotationAssertion(mito:isMentionedBy goldbook:09516 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09516 "current"^^xsd:string)
Declaration(Class(goldbook:09517))
AnnotationAssertion(rdfs:label goldbook:09517 "photolithography")
AnnotationAssertion(dcterms:description goldbook:09517 "Lithography performed by exposing a resist to an intense parallel light beam through an image mask.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09517 "optical lithography")
AnnotationAssertion(rdfs:seeAlso goldbook:09517 goldbook:09503)
AnnotationAssertion(rdfs:seeAlso goldbook:09517 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09517 goldbook:09523)
AnnotationAssertion(rdfs:seeAlso goldbook:09517 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09517 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09517 "current"^^xsd:string)
Declaration(Class(goldbook:09518))
AnnotationAssertion(rdfs:label goldbook:09518 "scanning-probe lithography")
AnnotationAssertion(dcterms:description goldbook:09518 "Lithographic method in which a microscopic or nanoscopic stylus is moved mechanically across a surface to form a pattern.")
AnnotationAssertion(mito:isMentionedBy goldbook:09518 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09518 "current"^^xsd:string)
Declaration(Class(goldbook:09519))
AnnotationAssertion(rdfs:label goldbook:09519 "soft lithography")
AnnotationAssertion(dcterms:description goldbook:09519 "Family of techniques for fabricating or replicating structures using elastomeric stamps, molds, and conformable photomasks.")
AnnotationAssertion(rdfs:seeAlso goldbook:09519 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09519 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09519 "current"^^xsd:string)
Declaration(Class(goldbook:09520))
AnnotationAssertion(rdfs:label goldbook:09520 "X-ray lithography")
AnnotationAssertion(dcterms:description goldbook:09520 "Lithography performed by exposing a resist to X-radiation through an image mask.")
AnnotationAssertion(rdfs:seeAlso goldbook:09520 goldbook:09503)
AnnotationAssertion(rdfs:seeAlso goldbook:09520 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09520 goldbook:09523)
AnnotationAssertion(rdfs:seeAlso goldbook:09520 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09520 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09520 "current"^^xsd:string)
Declaration(Class(goldbook:09521))
AnnotationAssertion(rdfs:label goldbook:09521 "3D lithography")
AnnotationAssertion(dcterms:description goldbook:09521 "Lithography performed in three dimensions, typically carried out using nanoimprint patterning or 2-photon lithography.")
AnnotationAssertion(rdfs:seeAlso goldbook:09521 goldbook:09522)
AnnotationAssertion(rdfs:seeAlso goldbook:09521 goldbook:09503)
AnnotationAssertion(rdfs:seeAlso goldbook:09521 goldbook:09510)
AnnotationAssertion(mito:isMentionedBy goldbook:09521 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09521 "current"^^xsd:string)
Declaration(Class(goldbook:09522))
AnnotationAssertion(rdfs:label goldbook:09522 "2-photon lithography")
AnnotationAssertion(dcterms:description goldbook:09522 "Photolithography within a thick photoresist film, within which the photochemically-induced solubility change results from the simultaneous absorption of two photons.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09522 "two-photon lithography")
AnnotationAssertion(rdfs:comment goldbook:09522 "Usually the imaging radiation is of near-IR wavelength."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09522 "An instrument such as a confocal microscope can be used for two-photon lithography."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09522 goldbook:09517)
AnnotationAssertion(mito:isMentionedBy goldbook:09522 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09522 "current"^^xsd:string)
Declaration(Class(goldbook:09523))
AnnotationAssertion(rdfs:label goldbook:09523 "mask")
AnnotationAssertion(dcterms:description goldbook:09523 "Transparent substrate pre-patterned with the desired image that is inserted into the incident beam in photo- and X-ray lithography.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09523 "photomask")
AnnotationAssertion(rdfs:comment goldbook:09523 "A dark field mask is used with a positive tone photoresist and a bright field mask with a negative tone photoresist."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09523 "Masks are typically transparent fused silica blanks with a pattern defined in a chrome film using direct-write lithography."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09523 goldbook:09520)
AnnotationAssertion(rdfs:seeAlso goldbook:09523 goldbook:09504)
AnnotationAssertion(rdfs:seeAlso goldbook:09523 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09523 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09523 "current"^^xsd:string)
Declaration(Class(goldbook:09524))
AnnotationAssertion(rdfs:label goldbook:09524 "magnetic mask")
AnnotationAssertion(dcterms:description goldbook:09524 "Mask with a pattern defined by a paramagnetic metal.")
AnnotationAssertion(rdfs:seeAlso goldbook:09524 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09524 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09524 "current"^^xsd:string)
Declaration(Class(goldbook:09525))
AnnotationAssertion(rdfs:label goldbook:09525 "mask error enhancement factor")
AnnotationAssertion(dcterms:description goldbook:09525 "Increase in error of pattern edge location during pattern formation when the wavelength of light used to expose a resist is greater than the feature size.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09525 "MEEF")
AnnotationAssertion(rdfs:seeAlso goldbook:09525 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09525 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09525 "current"^^xsd:string)
Declaration(Class(goldbook:09526))
AnnotationAssertion(rdfs:label goldbook:09526 "microcontact printing")
AnnotationAssertion(dcterms:description goldbook:09526 "Form of soft lithography that uses micron-scale and smaller relief patterns on a master elastomer stamp to form images on the surface of a substrate through conformal contact.")
AnnotationAssertion(rdfs:comment goldbook:09526 "Stamps fabricated from polydimethylsiloxane are often used to make patterns of self-assembled monolayers on a metal, such as gold."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09526 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09526 goldbook:09519)
AnnotationAssertion(mito:isMentionedBy goldbook:09526 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09526 "current"^^xsd:string)
Declaration(Class(goldbook:09527))
AnnotationAssertion(rdfs:label goldbook:09527 "microfabrication")
AnnotationAssertion(dcterms:description goldbook:09527 "Process whereby structures of micrometre scale and smaller are fabricated.")
AnnotationAssertion(mito:isMentionedBy goldbook:09527 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09527 "current"^^xsd:string)
Declaration(Class(goldbook:09528))
AnnotationAssertion(rdfs:label goldbook:09528 "microfluidics")
AnnotationAssertion(dcterms:description goldbook:09528 "Multi-disciplinary subject concerned with the behavior, precise control, and manipulation of fluids that are geometrically constrained within a small, typically sub-millimeter, scale channel.")
AnnotationAssertion(mito:isMentionedBy goldbook:09528 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09528 "current"^^xsd:string)
Declaration(Class(goldbook:09529))
AnnotationAssertion(rdfs:label goldbook:09529 "micromolding")
AnnotationAssertion(dcterms:description goldbook:09529 "Form of soft lithography that uses the relief patterns in a master template to make 3-dimensional structures.")
AnnotationAssertion(rdfs:comment goldbook:09529 "Molds are commonly fabricated from an elastomer, such as polydimethylsiloxane."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09529 "Micromolding is used to manufacture parts of micro-objects, such as microfluidic circuits."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09529 goldbook:09528)
AnnotationAssertion(rdfs:seeAlso goldbook:09529 goldbook:09519)
AnnotationAssertion(mito:isMentionedBy goldbook:09529 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09529 "current"^^xsd:string)
Declaration(Class(goldbook:09530))
AnnotationAssertion(rdfs:label goldbook:09530 "molecular glass")
AnnotationAssertion(dcterms:description goldbook:09530 "Assembly of small molecules that vitrify, rather than crystallize, when cooled.")
AnnotationAssertion(rdfs:comment goldbook:09530 "Molecular glass photoresists are used in deep- and extreme-UV photolithography."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09530 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09530 "current"^^xsd:string)
Declaration(Class(goldbook:09531))
AnnotationAssertion(rdfs:label goldbook:09531 "molecular logic gate")
AnnotationAssertion(dcterms:description goldbook:09531 "Molecule that acts as a device performing a logical operation based on one or more physical or chemical inputs and a single output.")
AnnotationAssertion(mito:isMentionedBy goldbook:09531 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09531 "current"^^xsd:string)
Declaration(Class(goldbook:09532))
AnnotationAssertion(rdfs:label goldbook:09532 "molecular template")
AnnotationAssertion(dcterms:description goldbook:09532 "Molecular structure that transfers a pattern to or organizes another molecular scale structure.")
AnnotationAssertion(mito:isMentionedBy goldbook:09532 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09532 "current"^^xsd:string)
Declaration(Class(goldbook:09533))
AnnotationAssertion(rdfs:label goldbook:09533 "molecular wires")
AnnotationAssertion(dcterms:description goldbook:09533 "Molecular-scale objects that conduct electrical current.")
AnnotationAssertion(mito:isMentionedBy goldbook:09533 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09533 "current"^^xsd:string)
Declaration(Class(goldbook:09534))
AnnotationAssertion(rdfs:label goldbook:09534 "Moore’s law")
AnnotationAssertion(dcterms:description goldbook:09534 "Empirical observation by Gordon E. Moore, co-founder of Intel, that, over the history of computing hardware, the number of transistors on integrated circuits doubles approximately every two years.")
AnnotationAssertion(rdfs:comment goldbook:09534 "Moore’s law applies more fundamentally to advances in lithographic processing, particularly achievable resolution, since the inception of printed circuit boards."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09534 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09534 "current"^^xsd:string)
Declaration(Class(goldbook:09535))
AnnotationAssertion(rdfs:label goldbook:09535 "nanodevice")
AnnotationAssertion(dcterms:description goldbook:09535 "Device in which the manufactured size is between \\(\\pu{1}\\) and \\(\\pu{100 nm}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:09535 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09535 "current"^^xsd:string)
Declaration(Class(goldbook:09536))
AnnotationAssertion(rdfs:label goldbook:09536 "nanoelectromechanical systems")
AnnotationAssertion(dcterms:description goldbook:09536 "Devices that integrate electrical and mechanical functionality at the nanoscale. A miniaturization of microelectromechanical systems (MEMS).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09536 "NEMS")
AnnotationAssertion(mito:isMentionedBy goldbook:09536 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09536 "current"^^xsd:string)
Declaration(Class(goldbook:09537))
AnnotationAssertion(rdfs:label goldbook:09537 "nanoelectronics")
AnnotationAssertion(dcterms:description goldbook:09537 "Application of nanotechnology to microelectronics.")
AnnotationAssertion(rdfs:seeAlso goldbook:09537 goldbook:09542)
AnnotationAssertion(mito:isMentionedBy goldbook:09537 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09537 "current"^^xsd:string)
Declaration(Class(goldbook:09538))
AnnotationAssertion(rdfs:label goldbook:09538 "nanoparticle")
AnnotationAssertion(dcterms:description goldbook:09538 "Particle of any shape with an equivalent diameter of approximately \\(\\pu{1}\\) to \\(\\pu{100 nm}\\).")
AnnotationAssertion(rdfs:comment goldbook:09538 "nanoparticle photoresists are used in deep- and extreme-UV photolithography."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09538 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09538 "current"^^xsd:string)
Declaration(Class(goldbook:09539))
AnnotationAssertion(rdfs:label goldbook:09539 "nanopattern")
AnnotationAssertion(dcterms:description goldbook:09539 "Patterns on a substrate with lesser dimensions of between \\(\\pu{1}\\) to \\(\\pu{100 nm}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:09539 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09539 "current"^^xsd:string)
Declaration(Class(goldbook:09540))
AnnotationAssertion(rdfs:label goldbook:09540 "nanophotonics")
AnnotationAssertion(dcterms:description goldbook:09540 "Study of the interaction of light with particles or substances on a scale less than the wavelength of the light.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09540 "nano-optics")
AnnotationAssertion(mito:isMentionedBy goldbook:09540 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09540 "current"^^xsd:string)
Declaration(Class(goldbook:09541))
AnnotationAssertion(rdfs:label goldbook:09541 "nanostructure")
AnnotationAssertion(dcterms:description goldbook:09541 "Structure or feature of size between \\(\\pu{1}\\) and \\(\\pu{100 nm}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:09541 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09541 "current"^^xsd:string)
Declaration(Class(goldbook:09542))
AnnotationAssertion(rdfs:label goldbook:09542 "nanotechnology")
AnnotationAssertion(dcterms:description goldbook:09542 "Manipulation of matter on an atomic and molecular scale.")
AnnotationAssertion(mito:isMentionedBy goldbook:09542 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09542 "current"^^xsd:string)
Declaration(Class(goldbook:09543))
AnnotationAssertion(rdfs:label goldbook:09543 "near-field scanning optical microscopy")
AnnotationAssertion(dcterms:description goldbook:09543 "Microscopy applied to the investigation of nanostructures that breaks the farfield resolution limit by exploiting the properties of evanescent waves.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09543 "NSOM")
AnnotationAssertion(rdfs:comment goldbook:09543 "NSOM can be used to make nanopatterns."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09543 goldbook:09539)
AnnotationAssertion(rdfs:seeAlso goldbook:09543 goldbook:09541)
AnnotationAssertion(mito:isMentionedBy goldbook:09543 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09543 "current"^^xsd:string)
Declaration(Class(goldbook:09544))
AnnotationAssertion(rdfs:label goldbook:09544 "negative-tone development")
AnnotationAssertion(dcterms:description goldbook:09544 "Process for revealing the latent image in a resist in which the exposed regions are less soluble in the developer than the unexposed regions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09544 "NTD")
AnnotationAssertion(rdfs:seeAlso goldbook:09544 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09544 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09544 "current"^^xsd:string)
Declaration(Class(goldbook:09545))
AnnotationAssertion(rdfs:label goldbook:09545 "normalized image log slope")
AnnotationAssertion(dcterms:description goldbook:09545 "Measure of the information content of the aerial image and represents an energy (intensity) gradient at the position of the nominal line edge.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09545 "NILS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09545 "normalized image slope")
AnnotationAssertion(rdfs:seeAlso goldbook:09545 goldbook:09446)
AnnotationAssertion(mito:isMentionedBy goldbook:09545 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09545 "current"^^xsd:string)
Declaration(Class(goldbook:09546))
AnnotationAssertion(rdfs:label goldbook:09546 "pattern collapse")
AnnotationAssertion(dcterms:description goldbook:09546 "Destruction of pattern during and after development caused by the surface tension of the development solvent.")
AnnotationAssertion(rdfs:seeAlso goldbook:09546 goldbook:09468)
AnnotationAssertion(mito:isMentionedBy goldbook:09546 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09546 "current"^^xsd:string)
Declaration(Class(goldbook:09547))
AnnotationAssertion(rdfs:label goldbook:09547 "pattern transfer")
AnnotationAssertion(dcterms:description goldbook:09547 "Transfer of the pattern of a developed lithographic image to an underlying substrate by processes such as etching.")
AnnotationAssertion(rdfs:seeAlso goldbook:09547 goldbook:09488)
AnnotationAssertion(rdfs:seeAlso goldbook:09547 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09547 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09547 "current"^^xsd:string)
Declaration(Class(goldbook:09548))
AnnotationAssertion(rdfs:label goldbook:09548 "photoacid generator")
AnnotationAssertion(dcterms:description goldbook:09548 "Compound that on exposure to radiation gives rise to a proton.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09548 "PAG")
AnnotationAssertion(mito:isMentionedBy goldbook:09548 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09548 "current"^^xsd:string)
Declaration(Class(goldbook:09549))
AnnotationAssertion(rdfs:label goldbook:09549 "photoactive compound")
AnnotationAssertion(dcterms:description goldbook:09549 "Compound that on exposure to radiation will release an active ionic or radical species.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09549 "PAC")
AnnotationAssertion(mito:isMentionedBy goldbook:09549 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09549 "current"^^xsd:string)
Declaration(Class(goldbook:09550))
AnnotationAssertion(rdfs:label goldbook:09550 "photonic crystal")
AnnotationAssertion(dcterms:description goldbook:09550 "Periodic structures consisting of a dielectric material that shows strong interaction with light.")
AnnotationAssertion(mito:isMentionedBy goldbook:09550 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09550 "current"^^xsd:string)
Declaration(Class(goldbook:09551))
AnnotationAssertion(rdfs:label goldbook:09551 "photonics")
AnnotationAssertion(dcterms:description goldbook:09551 "Science and technology of the production, transmission, absorption, sensing, and direction of light.")
AnnotationAssertion(mito:isMentionedBy goldbook:09551 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09551 "current"^^xsd:string)
Declaration(Class(goldbook:09552))
AnnotationAssertion(rdfs:label goldbook:09552 "pitch division")
AnnotationAssertion(dcterms:description goldbook:09552 "Method for making a lithographic pattern smaller than that deemed possible given the wavelength of the imaging radiation.")
AnnotationAssertion(rdfs:comment goldbook:09552 "A current objective of directed self-assembly is to use the process with conventional lithography to double the pitch."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09552 goldbook:09470)
AnnotationAssertion(rdfs:seeAlso goldbook:09552 goldbook:09503)
AnnotationAssertion(mito:isMentionedBy goldbook:09552 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09552 "current"^^xsd:string)
Declaration(Class(goldbook:09553))
AnnotationAssertion(rdfs:label goldbook:09553 "planarising layer")
AnnotationAssertion(dcterms:description goldbook:09553 "Coating used to create a level surface during lithographic processing.")
AnnotationAssertion(rdfs:comment goldbook:09553 "This layer is often organic and may be called an organic planarizing layer (OPL)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09553 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09553 "current"^^xsd:string)
Declaration(Class(goldbook:09554))
AnnotationAssertion(rdfs:label goldbook:09554 "plasma enhanced chemical vapor deposition")
AnnotationAssertion(dcterms:description goldbook:09554 "Process to deposit a solid film on a substrate resulting from plasma-induced reactions of precursor compounds, either in the gaseous state or on the film surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09554 "PECVD")
AnnotationAssertion(rdfs:comment goldbook:09554 "A RF frequency or DC discharge generated by two electrodes inducing a plasma from a gas occupying the space between."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09554 "Examples of PECVD films are \\(\\ce{SiO2}\\) films via PECVD of dichlorosilane or silane and oxygen precursors or tetraethoxysilane in an oxygen or oxygen-argon plasma, silicon nitride formed from silane and ammonia or nitrogen, and amorphous silicon from monosilane or tetrachlorosilane, as well as polymers from vinyl monomers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09554 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09554 "current"^^xsd:string)
Declaration(Class(goldbook:09555))
AnnotationAssertion(rdfs:label goldbook:09555 "plasma etch")
AnnotationAssertion(dcterms:description goldbook:09555 "Plasma processing used in the fabrication of integrated circuits that generates volatile products from the elements of the material etched and the reactive species generated by the plasma.")
AnnotationAssertion(rdfs:comment goldbook:09555 "A variation of this method that removes a single layer of atoms is known as atomic layer etching (ALE)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09555 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09555 "current"^^xsd:string)
Declaration(Class(goldbook:09556))
AnnotationAssertion(rdfs:label goldbook:09556 "positive-tone development")
AnnotationAssertion(dcterms:description goldbook:09556 "Process for revealing the latent image in a resist in which the exposed regions are more soluble in the developer than are the unexposed regions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09556 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09556 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09556 "current"^^xsd:string)
Declaration(Class(goldbook:09557))
AnnotationAssertion(rdfs:label goldbook:09557 "post-apply bake")
AnnotationAssertion(dcterms:description goldbook:09557 "Thermal annealing step following the coating of a substrate with a resist material.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09557 "PAB")
AnnotationAssertion(rdfs:seeAlso goldbook:09557 goldbook:09447)
AnnotationAssertion(rdfs:seeAlso goldbook:09557 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09557 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09557 "current"^^xsd:string)
Declaration(Class(goldbook:09558))
AnnotationAssertion(rdfs:label goldbook:09558 "post-exposure bake")
AnnotationAssertion(dcterms:description goldbook:09558 "Thermal annealing step following the exposure of a resist to imaging radiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09558 "PEB")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09558 "post bake")
AnnotationAssertion(rdfs:seeAlso goldbook:09558 goldbook:09447)
AnnotationAssertion(mito:isMentionedBy goldbook:09558 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09558 "current"^^xsd:string)
Declaration(Class(goldbook:09559))
AnnotationAssertion(rdfs:label goldbook:09559 "post-exposure delay")
AnnotationAssertion(dcterms:description goldbook:09559 "Pause between successive patterning steps in lithographic processing.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09559 "PED")
AnnotationAssertion(mito:isMentionedBy goldbook:09559 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09559 "current"^^xsd:string)
Declaration(Class(goldbook:09560))
AnnotationAssertion(rdfs:label goldbook:09560 "protecting group")
AnnotationAssertion(dcterms:description goldbook:09560 "Non-reactive group temporarily used to transform a reactive group into one that does not react under conditions where the non-protected group reacts.")
AnnotationAssertion(rdfs:comment goldbook:09560 "Trimethylsilylation is a typical transformation used to protect reactive functional groups, such as hydroxy or amino groups, from their reaction with the propagating species in an anionic polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09560 "In photoresists, protecting groups may also alter solubility (e.g., tBOC protection of hydroxy groups in chemically amplified poly(4-hydroxystyrene) resists)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09560 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09560 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09560 "current"^^xsd:string)
Declaration(Class(goldbook:09561))
AnnotationAssertion(rdfs:label goldbook:09561 "proximity effect")
AnnotationAssertion(dcterms:description goldbook:09561 "Widening of the exposure dose distribution, and hence the developed pattern, caused by the scattering of the primary beam electrons within the resist and substrate.")
AnnotationAssertion(rdfs:seeAlso goldbook:09561 goldbook:09477)
AnnotationAssertion(rdfs:seeAlso goldbook:09561 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09561 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09561 "current"^^xsd:string)
Declaration(Class(goldbook:09562))
AnnotationAssertion(rdfs:label goldbook:09562 "raster scan")
AnnotationAssertion(dcterms:description goldbook:09562 "Rectangular pattern of line-by-line scanning for image capture used in electron beam and ion-beam lithography.")
AnnotationAssertion(rdfs:seeAlso goldbook:09562 goldbook:09505)
AnnotationAssertion(rdfs:seeAlso goldbook:09562 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09562 goldbook:09583)
AnnotationAssertion(mito:isMentionedBy goldbook:09562 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09562 "current"^^xsd:string)
Declaration(Class(goldbook:09563))
AnnotationAssertion(rdfs:label goldbook:09563 "reactive ion etching")
AnnotationAssertion(dcterms:description goldbook:09563 "Etching technology used in microfabrication that uses chemically reactive plasma to remove material from a substrate.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09563 "RIE")
AnnotationAssertion(mito:isMentionedBy goldbook:09563 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09563 "current"^^xsd:string)
Declaration(Class(goldbook:09564))
AnnotationAssertion(rdfs:label goldbook:09564 "resist")
AnnotationAssertion(dcterms:description goldbook:09564 "Material, usually a polymer, that when irradiated either undergoes a marked change in solubility in a given solvent or is ablated.")
AnnotationAssertion(rdfs:comment goldbook:09564 "A resist polymer under irradiation either forms patterns directly or undergoes chemical reactions leading to pattern formation after subsequent processing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09564 "In a positive-tone resist, also called a positive-working resist, the material in the irradiated area not covered by a mask is removed on development, which results in an image with a pattern identical with that on the mask. In a negative-tone resist, also called a negative-working resist, the non-irradiated area is subsequently removed, which results in an image with a pattern that is the complement of that on the mask."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09564 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09564 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09564 goldbook:09523)
AnnotationAssertion(mito:isMentionedBy goldbook:09564 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09564 "current"^^xsd:string)
Declaration(Class(goldbook:09565))
AnnotationAssertion(rdfs:label goldbook:09565 "chemically amplified resist")
AnnotationAssertion(dcterms:description goldbook:09565 "Resist that undergoes solubility change upon exposure of photoacid generator, followed by thermally activated acid catalyzed deprotection.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09565 "CAR")
AnnotationAssertion(rdfs:seeAlso goldbook:09565 goldbook:09564)
AnnotationAssertion(rdfs:seeAlso goldbook:09565 goldbook:09466)
AnnotationAssertion(rdfs:seeAlso goldbook:09565 goldbook:09548)
AnnotationAssertion(mito:isMentionedBy goldbook:09565 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09565 "current"^^xsd:string)
Declaration(Class(goldbook:09566))
AnnotationAssertion(rdfs:label goldbook:09566 "electron beam resist")
AnnotationAssertion(dcterms:description goldbook:09566 "Resist optimized for use under electron beam irradiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09566 "e-beam resist")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09566 "electron-beam resist")
AnnotationAssertion(rdfs:seeAlso goldbook:09566 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09566 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09566 "current"^^xsd:string)
Declaration(Class(goldbook:09567))
AnnotationAssertion(rdfs:label goldbook:09567 "ion beam resist")
AnnotationAssertion(dcterms:description goldbook:09567 "Resist optimized for use under ion beam irradiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09567 "ion-beam resist")
AnnotationAssertion(rdfs:seeAlso goldbook:09567 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09567 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09567 "current"^^xsd:string)
Declaration(Class(goldbook:09568))
AnnotationAssertion(rdfs:label goldbook:09568 "multi-component resist")
AnnotationAssertion(dcterms:description goldbook:09568 "Resist comprising more than one active component.")
AnnotationAssertion(rdfs:seeAlso goldbook:09568 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09568 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09568 "current"^^xsd:string)
Declaration(Class(goldbook:09569))
AnnotationAssertion(rdfs:label goldbook:09569 "X-ray resist")
AnnotationAssertion(dcterms:description goldbook:09569 "Resist optimized for use under X-ray irradiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:09569 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09569 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09569 "current"^^xsd:string)
Declaration(Class(goldbook:09570))
AnnotationAssertion(rdfs:label goldbook:09570 "resist profile")
AnnotationAssertion(dcterms:description goldbook:09570 "Topography of a resist pattern in cross section.")
AnnotationAssertion(rdfs:seeAlso goldbook:09570 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09570 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09570 "current"^^xsd:string)
Declaration(Class(goldbook:09571))
AnnotationAssertion(rdfs:label goldbook:09571 "resist strip")
AnnotationAssertion(dcterms:description goldbook:09571 "Subsequent removal of the remaining resist that covers the protected regions of a substrate during development and etch processing.")
AnnotationAssertion(rdfs:seeAlso goldbook:09571 goldbook:09468)
AnnotationAssertion(rdfs:seeAlso goldbook:09571 goldbook:09488)
AnnotationAssertion(rdfs:seeAlso goldbook:09571 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09571 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09571 "current"^^xsd:string)
Declaration(Class(goldbook:09572))
AnnotationAssertion(rdfs:label goldbook:09572 "shot noise")
AnnotationAssertion(dcterms:description goldbook:09572 "Noise which originates from the discrete nature of elementary charge.")
AnnotationAssertion(rdfs:comment goldbook:09572 "Shot noise decreases the resolution of an image in e-beam lithography."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09572 goldbook:09505)
AnnotationAssertion(rdfs:seeAlso goldbook:09572 goldbook:09495)
AnnotationAssertion(mito:isMentionedBy goldbook:09572 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09572 "current"^^xsd:string)
Declaration(Class(goldbook:09573))
AnnotationAssertion(rdfs:label goldbook:09573 "silylation")
AnnotationAssertion(dcterms:description goldbook:09573 "Introduction of a substituted silyl group (\\(\\ce{R3Si}\\)) to an alcohol, carboxylic acid, amine, thiol, or phosphate, commonly as a protecting group.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09573 "silation")
AnnotationAssertion(rdfs:comment goldbook:09573 "Trimethylsilylation used to protect reactive functional groups, such as hydroxy or amino groups, from their reaction with growing anionic species in anionic polymerization."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09573 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09573 "current"^^xsd:string)
Declaration(Class(goldbook:09574))
AnnotationAssertion(rdfs:label goldbook:09574 "soft bake")
AnnotationAssertion(dcterms:description goldbook:09574 "Short, low temperature annealing step following the coating of a wafer with a photoresist.")
AnnotationAssertion(rdfs:comment goldbook:09574 "The purpose of the soft bake is to (1) drive out remaining coating solvent from the resist layer; (2) improve the adhesion of the resist to the substrate; and (3) anneal the shear stresses introduced during spin-coating."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09574 goldbook:11545)
AnnotationAssertion(rdfs:seeAlso goldbook:09574 goldbook:09447)
AnnotationAssertion(rdfs:seeAlso goldbook:09574 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09574 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09574 "current"^^xsd:string)
Declaration(Class(goldbook:09575))
AnnotationAssertion(rdfs:label goldbook:09575 "stamp")
AnnotationAssertion(dcterms:description goldbook:09575 "Three-dimensional template comprising the negative pattern used to leave an impression on the surface of a malleable material.")
AnnotationAssertion(mito:isMentionedBy goldbook:09575 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09575 "current"^^xsd:string)
Declaration(Class(goldbook:09576))
AnnotationAssertion(rdfs:label goldbook:09576 "supramolecular assembly")
AnnotationAssertion(dcterms:description goldbook:09576 "Molecular system comprising two or more self-assembled molecular, or molecular and ionic, entities held together by means of non-covalent intermolecular binding interactions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09576 "supramolecular species")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09576 "supramolecular structure")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09576 "supramolecule")
AnnotationAssertion(rdfs:comment goldbook:09576 "While a supramolecular assembly may comprise only two molecular or molecular/ionic entities, for example a DNA double helix or a host-guest complex, the term is more commonly used to denote larger constructs, typically with rod-like, sheet-like, or spherical structures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09576 "The dimensions of supramolecular assemblies can range from nanometers to micrometers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09576 "The use of the term supramolecular polymer is discouraged."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09576 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09576 "current"^^xsd:string)
Declaration(Class(goldbook:09577))
AnnotationAssertion(rdfs:label goldbook:09577 "surface roughness")
AnnotationAssertion(dcterms:description goldbook:09577 "Measure of the texture of a surface that is quantified by vertical deviations from its ideal location.")
AnnotationAssertion(mito:isMentionedBy goldbook:09577 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09577 "current"^^xsd:string)
Declaration(Class(goldbook:09578))
AnnotationAssertion(rdfs:label goldbook:09578 "swing curve")
AnnotationAssertion(dcterms:description goldbook:09578 "Sinusoidal variation in the lithographic clearance dose arising from changes in the phase difference between incoming and outgoing radiation that is induced by variations in resist thickness.")
AnnotationAssertion(rdfs:seeAlso goldbook:09578 goldbook:09458)
AnnotationAssertion(rdfs:seeAlso goldbook:09578 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09578 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09578 "current"^^xsd:string)
Declaration(Class(goldbook:09579))
AnnotationAssertion(rdfs:label goldbook:09579 "topcoat")
AnnotationAssertion(dcterms:description goldbook:09579 "Protective layer spun directly on top of a resist.")
AnnotationAssertion(rdfs:comment goldbook:09579 "In immersion lithography, a topcoat serves as barrier for chemical diffusion between the liquid medium and the photoresist."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09579 goldbook:09508)
AnnotationAssertion(rdfs:seeAlso goldbook:09579 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09579 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09579 "current"^^xsd:string)
Declaration(Class(goldbook:09580))
AnnotationAssertion(rdfs:label goldbook:09580 "top-down patterning")
AnnotationAssertion(dcterms:description goldbook:09580 "Pattern formation using lithographic (also embossing) methods.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09580 "top-down processing")
AnnotationAssertion(rdfs:seeAlso goldbook:09580 goldbook:09485)
AnnotationAssertion(mito:isMentionedBy goldbook:09580 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09580 "current"^^xsd:string)
Declaration(Class(goldbook:09581))
AnnotationAssertion(rdfs:label goldbook:09581 "top-surface imaging")
AnnotationAssertion(dcterms:description goldbook:09581 "Lithographic process in which the exposed region of resist is silylated and the image then formed through reactive oxygen etch.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09581 "TSI")
AnnotationAssertion(rdfs:comment goldbook:09581 "Usually a chemically amplified photoresist is used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09581 "Oxygen plasma is used to convert any silicon to \\(\\ce{SiO2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09581 goldbook:09488)
AnnotationAssertion(rdfs:seeAlso goldbook:09581 goldbook:09495)
AnnotationAssertion(rdfs:seeAlso goldbook:09581 goldbook:09564)
AnnotationAssertion(mito:isMentionedBy goldbook:09581 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09581 "current"^^xsd:string)
Declaration(Class(goldbook:09582))
AnnotationAssertion(rdfs:label goldbook:09582 "vapor deposition")
AnnotationAssertion(dcterms:description goldbook:09582 "Growth of solid materials on a substrate by deposition from the gas phase.")
AnnotationAssertion(mito:isMentionedBy goldbook:09582 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09582 "current"^^xsd:string)
Declaration(Class(goldbook:09583))
AnnotationAssertion(rdfs:label goldbook:09583 "vector scan")
AnnotationAssertion(dcterms:description goldbook:09583 "Pattern formation using a directed electron beam or ion beam that skips from region to region requiring exposure but is otherwise turned off.")
AnnotationAssertion(rdfs:seeAlso goldbook:09583 goldbook:09562)
AnnotationAssertion(mito:isMentionedBy goldbook:09583 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09583 "current"^^xsd:string)
Declaration(Class(goldbook:09584))
AnnotationAssertion(rdfs:label goldbook:09584 "rotated Fischer projection")
AnnotationAssertion(dcterms:description goldbook:09584 "Projection formula for macromolecules in which horizontal lines denote polymer backbone bonds. At each individual backbone carbon atom, horizontal lines represent bonds directed below the projection plane and vertical lines represent bonds directed above that plane.")
AnnotationAssertion(mito:isMentionedBy goldbook:09584 doi:10.1515/pac-2019-0409)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09584 "current"^^xsd:string)
Declaration(Class(goldbook:09585))
AnnotationAssertion(rdfs:label goldbook:09585 "m diad")
AnnotationAssertion(dcterms:description goldbook:09585 "Pair of adjacent constitutionally equivalent stereogenic units that are of like configuration.")
AnnotationAssertion(rdfs:comment goldbook:09585 "Usage of the term meso diad for describing structures with a symmetrically constituted connecting group is no longer acceptable because of the potential for confusion with the similar term used in organic chemistry to describe small molecules."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09585 doi:10.1515/pac-2019-0409)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09585 "current"^^xsd:string)
Declaration(Class(goldbook:09586))
AnnotationAssertion(rdfs:label goldbook:09586 "r diad")
AnnotationAssertion(dcterms:description goldbook:09586 "Pair of adjacent constitutionally equivalent stereogenic units that are of unlike configuration. Figure 2: Diagrammatic representations of the configurational repeating unit or stereorepeating unit (upper), and the diad sequence (lower) for isotactic poly(oxypropylene), both as a rotated Fischer projections (left) and as a zigzag projection (right). [image2]")
AnnotationAssertion(rdfs:comment goldbook:09586 "Usage of the term racemo diad for describing structures with a symmetrically-constituted connecting group is no longer acceptable because of the potential for confusion with the similar term used in organic chemistry to describe small molecules."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09586 doi:10.1515/pac-2019-0409)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09586 "current"^^xsd:string)
Declaration(Class(goldbook:09587))
AnnotationAssertion(rdfs:label goldbook:09587 "heterotactic macromolecule")
AnnotationAssertion(dcterms:description goldbook:09587 "Regular macromolecule having a configurational repeating unit comprising four configurational base units, the first two stereogenic units of which are identical and enantiomorphic to the last two.")
AnnotationAssertion(rdfs:comment goldbook:09587 "A macromolecule consisting only of m and r diads in alternating sequence (i.e. mr and rm triads) is heterotactic. The configurational repeating unit consists of four configurational base units."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09587 "The prefix ht- is recommended to indicate a heterotactic macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09587 "A heterotactic polypropylene can be depicted by a rotated Fischer Projection (top) and zigzag projection (bottom) as follows. The configurational repeating unit, a mrm tetrad, is shown within brackets. The configurational repeating unit can be equally well defined as a rmr tetrad. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09587 goldbook:09585)
AnnotationAssertion(rdfs:seeAlso goldbook:09587 goldbook:09586)
AnnotationAssertion(mito:isMentionedBy goldbook:09587 doi:10.1515/pac-2019-0409)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09587 "current"^^xsd:string)
Declaration(Class(goldbook:09588))
AnnotationAssertion(rdfs:label goldbook:09588 "asymmetric enantiomer-differentiating polymerization")
AnnotationAssertion(dcterms:description goldbook:09588 "Asymmetric polymerization in which, starting from a mixture of enantiomeric monomer molecules, only one enantiomer is polymerized.")
AnnotationAssertion(rdfs:seeAlso goldbook:09588 goldbook:09589)
AnnotationAssertion(mito:isMentionedBy goldbook:09588 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09588 "current"^^xsd:string)
Declaration(Class(goldbook:09589))
AnnotationAssertion(rdfs:label goldbook:09589 "asymmetric polymerization")
AnnotationAssertion(dcterms:description goldbook:09589 "Polymerization that proceeds in an unsymmetrical manner in terms of chirality under the influence of chiral features present in one or more components of the reaction system.")
AnnotationAssertion(mito:isMentionedBy goldbook:09589 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09589 "current"^^xsd:string)
Declaration(Class(goldbook:09590))
AnnotationAssertion(rdfs:label goldbook:09590 "Bernoullian distribution")
AnnotationAssertion(dcterms:description goldbook:09590 "The Bernoullian distribution is a discrete distribution having two possible outcomes labelled by \\(n = 0\\) and \\(n = 1\\), in which \\(n = 1\\) ('success') occurs with probability $p$ and \\(n = 0\\) ('failure') occurs with probability \\(q = 1 - p\\), where $0 \\lt p \\lt 1$. It is a special case of a binomial distribution corresponding to a random distribution.")
AnnotationAssertion(rdfs:comment goldbook:09590 "Since enantiomers have the same reactivity, this statistic applies to units in the case of the polycondensation of mixtures of (\\(R\\)) and (\\(S\\)) lactic acid, and to pairs of units in the case of the ring-opening polymerization of mixtures of (\\(S,S\\)) and (\\(R,R\\)) lactides."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09590 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09590 "current"^^xsd:string)
Declaration(Class(goldbook:09591))
AnnotationAssertion(rdfs:label goldbook:09591 "bioassimilation")
AnnotationAssertion(dcterms:description goldbook:09591 "Conversion of a substance into biomass by biochemical processes.")
AnnotationAssertion(rdfs:comment goldbook:09591 "Lactic acid-based polyesters are not biodegradable, but they can be bioassimilated, since the ultimate degradation by-products are lactic acid metabolites."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09591 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09591 "current"^^xsd:string)
Declaration(Class(goldbook:09592))
AnnotationAssertion(rdfs:label goldbook:09592 "biobased")
AnnotationAssertion(dcterms:description goldbook:09592 "Composed of or derived from, in whole or in part, biological products derived from the biomass (including plant, animal, and marine or forestry materials).")
AnnotationAssertion(rdfs:comment goldbook:09592 "Lactic acids are obtained from the fermentation of natural products, such as corn or sugars, or from oil-based chemistry. Only the lactic acid-based polymers derived from natural sources are biobased."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09592 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09592 "current"^^xsd:string)
Declaration(Class(goldbook:09593))
AnnotationAssertion(rdfs:label goldbook:09593 "biodegradable")
AnnotationAssertion(dcterms:description goldbook:09593 "Qualifier for a substance or device that undergoes biodegradation.")
AnnotationAssertion(rdfs:comment goldbook:09593 "High molecular mass lactic acid-based polyesters are not degraded by animal cells or environmental micro-organisms. Therefore, the use of the term biodegradable is inappropriate and misleading, unless biodegradation under particular conditions is proved. The correct qualification is \"hydrolytically degradable\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09593 "As hydrolytic degradation leads to low molar mass end-products that can be biodegraded, excreted via kidneys and lungs after biomineralisation, or biorecycled by living organisms or micro-organisms, lactic acid-based polyesters are bioresorbable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09593 goldbook:09596)
AnnotationAssertion(mito:isMentionedBy goldbook:09593 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09593 "current"^^xsd:string)
Declaration(Class(goldbook:09594))
AnnotationAssertion(rdfs:label goldbook:09594 "bioerosion")
AnnotationAssertion(dcterms:description goldbook:09594 "Surface degradation resulting from the action of cells.")
AnnotationAssertion(rdfs:comment goldbook:09594 "High molecular mass lactic acid-based polyesters are not bioerodible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09594 "Some non-human enzymes like proteinase K can cause erosion of lactic acid-based polyesters due to surface enzymatic degradation of lactic acid-based polyesters."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09594 "When hydrophobic compounds are present in a lactic acid-based polymeric matrix, water uptake can be so low that surface hydrolysis is faster than the bulk hydrolysis and causes erosion that can be confused with enzymatic erosion or bioerosion."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09594 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09594 "current"^^xsd:string)
Declaration(Class(goldbook:09595))
AnnotationAssertion(rdfs:label goldbook:09595 "biorelated")
AnnotationAssertion(dcterms:description goldbook:09595 "Qualifier for actions or substances that are connected to living systems.")
AnnotationAssertion(rdfs:comment goldbook:09595 "This qualifier can be used for lactic acid-based polyesters when appropriate according to origin or application."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09595 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09595 "current"^^xsd:string)
Declaration(Class(goldbook:09596))
AnnotationAssertion(rdfs:label goldbook:09596 "bioresorbable")
AnnotationAssertion(dcterms:description goldbook:09596 "Qualifier used to indicate that a compound or a device is bioresorbed, i.e., totally eliminated or bioassimilated by an animal or a human body.")
AnnotationAssertion(rdfs:comment goldbook:09596 "Lactic acid-based polyesters are bioresorbable after preliminary hydrolytic degradation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09596 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09596 "current"^^xsd:string)
Declaration(Class(goldbook:09597))
AnnotationAssertion(rdfs:label goldbook:09597 "composting")
AnnotationAssertion(dcterms:description goldbook:09597 "Process of biological decomposition of organic matter performed by microorganisms, mostly bacteria and fungi.")
AnnotationAssertion(rdfs:comment goldbook:09597 "Lactic acid-based polyesters can be composted industrially provided that they are first hydrolytically degraded at a temperature above the glass transition temperature \\(T_{\\rm{g}}\\), otherwise degradation is very slow."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09597 "Packaging made of semi-crystalline lactic acid-based polyesters may not be compostable in a home compost bin."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09597 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09597 "current"^^xsd:string)
Declaration(Class(goldbook:09598))
AnnotationAssertion(rdfs:label goldbook:09598 "degradable")
AnnotationAssertion(dcterms:description goldbook:09598 "Qualifier to a substance that can undergo physical and/or chemical deleterious changes of some properties, especially of integrity, under stress conditions.")
AnnotationAssertion(rdfs:comment goldbook:09598 "Lactic acid-based polyesters are degradable polymers and more precisely hydrolytically degradable polymers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09598 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09598 "current"^^xsd:string)
Declaration(Class(goldbook:09599))
AnnotationAssertion(rdfs:label goldbook:09599 "heterogeneous degradation")
AnnotationAssertion(dcterms:description goldbook:09599 "Degradation or biodegradation occurring at different rates depending on the location within a matrix.")
AnnotationAssertion(rdfs:comment goldbook:09599 "Heterogeneous degradation is observed when the soluble degradation by-products that participate in the autocatalysis of the hydrolytic degradation of lactic acid-based polyester matrices are degraded faster than they diffuse outside."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09599 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09599 "current"^^xsd:string)
Declaration(Class(goldbook:09600))
AnnotationAssertion(rdfs:label goldbook:09600 "homogeneous degradation")
AnnotationAssertion(dcterms:description goldbook:09600 "Degradation that occurs at the same rate regardless of the location within a polymeric item.")
AnnotationAssertion(rdfs:comment goldbook:09600 "Homogeneous degradation occurs in aqueous media when soluble degradation by-products that participate in the autocatalyzed hydrolysis diffuse faster out of the matrix than they degrade inside. Homogeneous degradation is also observed in air or in a medium that is not a solvent for degradation by-products, because these products cannot diffuse to such outer media."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09600 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09600 "current"^^xsd:string)
Declaration(Class(goldbook:09601))
AnnotationAssertion(rdfs:label goldbook:09601 "stereocopolymer")
AnnotationAssertion(dcterms:description goldbook:09601 "Copolymer formed of constitutional repeating units that are constitutionally identical but configurationally different.")
AnnotationAssertion(rdfs:comment goldbook:09601 "In transesterification and hydrolytic degradation reactions of lactic-acid stereocopolymers, the intrachain ester bonds in \\(m\\), \\(r\\), and heterochiral short sequences exhibit different reactivity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09601 doi:10.1515/pac-2017-1007)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09601 "current"^^xsd:string)
Declaration(Class(goldbook:09602))
AnnotationAssertion(rdfs:label goldbook:09602 "branch constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09602 "Constitutional repeating unit of connectivity three or more connected at least to three other constitutional repeating units.")
AnnotationAssertion(rdfs:comment goldbook:09602 "In addition, a branch constitutional repeating unit may also be connected to one or more end-groups."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09602 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09602 "current"^^xsd:string)
Declaration(Class(goldbook:09603))
AnnotationAssertion(rdfs:label goldbook:09603 "core unit")
AnnotationAssertion(dcterms:description goldbook:09603 "Constitutional unit in a dendrimer molecule, from which the dendron(s) emanate(s).")
AnnotationAssertion(rdfs:comment goldbook:09603 "The structure of the core unit may be identical to that of the constitutional repeating units."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09603 "Occasionally, a dendrimer molecule may consist of two dendrons directly connected together."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09603 "In a hyperbranched macromolecule obtained by the \\({\\rm{AB}}_{x}\\mbox{-}\\rm{type}\\) monomer + \\({\\rm{B}}_{y}\\mbox{-}\\rm{type}\\) monomer polycondensation approach, where \\(\\rm{A}\\) and \\(\\rm{B}\\) refer to mutually reactive groups, the terms core molecule (not acceptable) and core unit refer to the \\({\\rm{B}}_{y}\\mbox{-}\\rm{type}\\) unit, even though the structure of the macromolecule does not comprise dendrons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09603 goldbook:09605)
AnnotationAssertion(rdfs:seeAlso goldbook:09603 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09603 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09603 "current"^^xsd:string)
Declaration(Class(goldbook:09604))
AnnotationAssertion(rdfs:label goldbook:09604 "degree of branching")
AnnotationAssertion(dcterms:description goldbook:09604 "Parameter characterizing the branched architecture of a hyperbranched polymer, which is equal to unity for a polymer that contains no linear or semi-dendritic constitutional repeating unit and is equal to 0 for a polymer that contains no dendritic or semi-dendritic constitutional repeating unit.")
AnnotationAssertion(rdfs:comment goldbook:09604 "Several definitions of the degree of branching have been proposed for hyperbranched polymers obtained by polycondensation of \\({\\rm{AB}}_2\\mbox{-}\\rm{type}\\) monomers and for those obtained by polycondensation of more complex monomer systems. The definition by Hölter et al. is: \\(D_{\\rm{br}} = 2 x_{\\rm{D}}/(2 x_{\\rm{D}} + x_{\\rm{L}})\\), where \\(x_{\\rm{D}}\\) and \\(x_{\\rm{L}}\\) are the mole fractions of dendritic and linear units, respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09604 "The degree of branching of a dendrimer is equal to one. However, a polymer with the degree of branching equal to one is not necessarily a dendrimer. It can be a hyperbranched polymer, since the degree of branching does not per se take into account the regularity and symmetry of the molecules that compose it."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09604 "The degree of branching of a linear polymer is equal to 0."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09604 goldbook:09610)
AnnotationAssertion(rdfs:seeAlso goldbook:09604 goldbook:09618)
AnnotationAssertion(rdfs:seeAlso goldbook:09604 goldbook:09622)
AnnotationAssertion(rdfs:seeAlso goldbook:09604 goldbook:09629)
AnnotationAssertion(mito:isMentionedBy goldbook:09604 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09604 "current"^^xsd:string)
Declaration(Class(goldbook:09605))
AnnotationAssertion(rdfs:label goldbook:09605 "dendrimer molecule")
AnnotationAssertion(dcterms:description goldbook:09605 "Molecule consisting of one or more dendrons emanating from a single constitutional unit.")
AnnotationAssertion(rdfs:comment goldbook:09605 "An example of a formula of a dendrimer molecule is given in the figure in core unit."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09605 "Occasionally, a dendrimer molecule may consist of two dendrons directly connected together."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09605 goldbook:09603)
AnnotationAssertion(rdfs:seeAlso goldbook:09605 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09605 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09605 "current"^^xsd:string)
Declaration(Class(goldbook:09606))
AnnotationAssertion(rdfs:label goldbook:09606 "dendritic block macromolecule")
AnnotationAssertion(dcterms:description goldbook:09606 "Block macromolecule in which at least one block is a dendron.")
AnnotationAssertion(rdfs:seeAlso goldbook:09606 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09606 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09606 "current"^^xsd:string)
Declaration(Class(goldbook:09607))
AnnotationAssertion(rdfs:label goldbook:09607 "dendritic constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09607 "Constitutional repeating unit of connectivity $c \\ge 3$ connected to $c$ other constitutional repeating units.")
AnnotationAssertion(rdfs:comment goldbook:09607 "Examples of dendritic constitutional repeating units of connectivity $c = 3$ connected to three other constitutional repeating units are given in figures in dendron direction and hyperbranched oligomer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09607 "Dendritic constitutional repeating units belong to the class of branch constitutional repeating units."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09607 goldbook:09602)
AnnotationAssertion(rdfs:seeAlso goldbook:09607 goldbook:09611)
AnnotationAssertion(rdfs:seeAlso goldbook:09607 goldbook:09612)
AnnotationAssertion(rdfs:seeAlso goldbook:09607 goldbook:09616)
AnnotationAssertion(mito:isMentionedBy goldbook:09607 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09607 "current"^^xsd:string)
Declaration(Class(goldbook:09608))
AnnotationAssertion(rdfs:label goldbook:09608 "dendritic graft macromolecule")
AnnotationAssertion(dcterms:description goldbook:09608 "Graft macromolecule in which at least one of the grafts contains a dendron.")
AnnotationAssertion(rdfs:comment goldbook:09608 "A dendritic graft macromolecule is sometimes referred to as a dendronised macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09608 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09608 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09608 "current"^^xsd:string)
Declaration(Class(goldbook:09609))
AnnotationAssertion(rdfs:label goldbook:09609 "dendritic macromolecule")
AnnotationAssertion(dcterms:description goldbook:09609 "Macromolecule containing at least one dendron.")
AnnotationAssertion(rdfs:seeAlso goldbook:09609 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09609 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09609 "current"^^xsd:string)
Declaration(Class(goldbook:09610))
AnnotationAssertion(rdfs:label goldbook:09610 "dendritic polymer")
AnnotationAssertion(dcterms:description goldbook:09610 "Substance composed of dendritic macromolecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:09610 goldbook:09606)
AnnotationAssertion(mito:isMentionedBy goldbook:09610 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09610 "current"^^xsd:string)
Declaration(Class(goldbook:09611))
AnnotationAssertion(rdfs:label goldbook:09611 "dendron")
AnnotationAssertion(dcterms:description goldbook:09611 "Part of a molecule with only one free valence, comprising exclusively dendritic and terminal constitutional repeating units and in which each path from the free valence to any end-group comprises the same number of constitutional repeating units.")
AnnotationAssertion(rdfs:comment goldbook:09611 "For the purpose of determining the nature of constitutional repeating units the free valence is treated as a connection to a CRU."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09611 "A dendrimer molecule comprising only one dendron is sometimes referred to as dendron, monodendron or functionalised dendron. The use of the terms ‘dendron’ or ‘monodendron’ in the meaning of molecule or substance is not acceptable."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09611 "In a dendron, macrocycles of constitutional units are absent. Example of a regular dendron, highlighting dendritic constitutional repeating units, terminal constitutional repeatingunits, end-groups, the dendron direction and the free valence. The preferred constitutional repeating unit is chosen such that the branch points are at its end in the dendron direction. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09611 goldbook:09605)
AnnotationAssertion(rdfs:seeAlso goldbook:09611 goldbook:09607)
AnnotationAssertion(rdfs:seeAlso goldbook:09611 goldbook:09612)
AnnotationAssertion(rdfs:seeAlso goldbook:09611 goldbook:09630)
AnnotationAssertion(mito:isMentionedBy goldbook:09611 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09611 "current"^^xsd:string)
Declaration(Class(goldbook:09612))
AnnotationAssertion(rdfs:label goldbook:09612 "dendron direction")
AnnotationAssertion(dcterms:description goldbook:09612 "For a constitutional repeating unit of a dendron, the direction from the free valence to the end-groups.")
AnnotationAssertion(rdfs:comment goldbook:09612 "See the figure in dendron."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09612 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09612 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09612 "current"^^xsd:string)
Declaration(Class(goldbook:09613))
AnnotationAssertion(rdfs:label goldbook:09613 "focal unit")
AnnotationAssertion(dcterms:description goldbook:09613 "Core unit of a dendrimer molecule that comprises only one dendron")
AnnotationAssertion(rdfs:seeAlso goldbook:09613 goldbook:09603)
AnnotationAssertion(rdfs:seeAlso goldbook:09613 goldbook:09605)
AnnotationAssertion(rdfs:seeAlso goldbook:09613 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09613 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09613 "current"^^xsd:string)
Declaration(Class(goldbook:09614))
AnnotationAssertion(rdfs:label goldbook:09614 "generation")
AnnotationAssertion(dcterms:description goldbook:09614 "Set of constitutional repeating units separated from the free valence of a dendron by the same number of constitutional repeating units.")
AnnotationAssertion(rdfs:comment goldbook:09614 "Generations are numbered consecutively starting from the constitutional repeating unit bearing the free valence. Example of a four-generation dendron, highlighting constitutional repeating units of generations 1 to 4 and the end-groups. The preferred constitutional repeating unit is chosen such that the branch points are at its end in the dendron direction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09614 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09614 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09614 "current"^^xsd:string)
Declaration(Class(goldbook:09615))
AnnotationAssertion(rdfs:label goldbook:09615 "hyperbranched macromolecule")
AnnotationAssertion(dcterms:description goldbook:09615 "Highly branched macromolecule, the constitutional repeating units of which are in substantial part branch constitutional repeating units and terminal constitutional repeating units.")
AnnotationAssertion(rdfs:comment goldbook:09615 "Hyperbranched macromolecules, unlike dendrimer molecules, usually comprise a number of randomly distributed linear constitutional repeating units. Examples of hyperbranched molecules with a core unit. Terminal, linear and dendritic constitutional repeating units and the core unit are circled. The preferred constitutional repeating unit is chosen such that the branch points are at its end in the dendron direction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09615 "For the purpose of determining the type of constitutional repeating units (dendritic, semi-dendritic, terminal or linear CRUs) in a hyperbranched macromolecule, the core unit should be treated as a CRU."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09630)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09602)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09603)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09605)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09610)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09607)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09622)
AnnotationAssertion(rdfs:seeAlso goldbook:09615 goldbook:09629)
AnnotationAssertion(mito:isMentionedBy goldbook:09615 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09615 "current"^^xsd:string)
Declaration(Class(goldbook:09616))
AnnotationAssertion(rdfs:label goldbook:09616 "hyperbranched oligomer")
AnnotationAssertion(dcterms:description goldbook:09616 "Substance composed of hyperbranched oligomer molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:09616 goldbook:09617)
AnnotationAssertion(mito:isMentionedBy goldbook:09616 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09616 "current"^^xsd:string)
Declaration(Class(goldbook:09617))
AnnotationAssertion(rdfs:label goldbook:09617 "hyperbranched oligomer molecule")
AnnotationAssertion(dcterms:description goldbook:09617 "Highly branched oligomer molecule, the constitutional repeating units of which are in substantial part branch constitutional repeating units and terminal constitutional repeating units.")
AnnotationAssertion(rdfs:seeAlso goldbook:09617 goldbook:09602)
AnnotationAssertion(rdfs:seeAlso goldbook:09617 goldbook:09615)
AnnotationAssertion(rdfs:seeAlso goldbook:09617 goldbook:09630)
AnnotationAssertion(mito:isMentionedBy goldbook:09617 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09617 "current"^^xsd:string)
Declaration(Class(goldbook:09618))
AnnotationAssertion(rdfs:label goldbook:09618 "hyperbranched polymer")
AnnotationAssertion(dcterms:description goldbook:09618 "Substance composed of hyperbranched macromolecules.")
AnnotationAssertion(rdfs:comment goldbook:09618 "The term \"dendrigraft\" is sometimes used for hyperbranched polymers of low molar-mass-dispersity. The use of \"dendrigraft\" is not acceptable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09618 goldbook:09615)
AnnotationAssertion(mito:isMentionedBy goldbook:09618 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09618 "current"^^xsd:string)
Declaration(Class(goldbook:09619))
AnnotationAssertion(rdfs:label goldbook:09619 "irregular dendrimer")
AnnotationAssertion(dcterms:description goldbook:09619 "Substance composed of irregular dendrimer molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:09619 goldbook:09620)
AnnotationAssertion(mito:isMentionedBy goldbook:09619 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09619 "current"^^xsd:string)
Declaration(Class(goldbook:09620))
AnnotationAssertion(rdfs:label goldbook:09620 "irregular dendrimer molecule")
AnnotationAssertion(dcterms:description goldbook:09620 "Dendrimer molecule that contains either different types of regular dendrons or at least one irregular dendron.")
AnnotationAssertion(rdfs:seeAlso goldbook:09620 goldbook:09605)
AnnotationAssertion(rdfs:seeAlso goldbook:09620 goldbook:09621)
AnnotationAssertion(rdfs:seeAlso goldbook:09620 goldbook:09628)
AnnotationAssertion(mito:isMentionedBy goldbook:09620 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09620 "current"^^xsd:string)
Declaration(Class(goldbook:09621))
AnnotationAssertion(rdfs:label goldbook:09621 "irregular dendron")
AnnotationAssertion(dcterms:description goldbook:09621 "Dendron composed of either different types of constitutional units, different types of end-groups or any combination of these.")
AnnotationAssertion(rdfs:seeAlso goldbook:09621 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09621 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09621 "current"^^xsd:string)
Declaration(Class(goldbook:09622))
AnnotationAssertion(rdfs:label goldbook:09622 "linear constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09622 "Constitutional repeating unit connected to exactly two other constitutional repeating units.")
AnnotationAssertion(rdfs:comment goldbook:09622 "A linear constitutional repeating unit may be connected to one or more end-groups."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09622 "End-groups attached to non-terminal constitutional repeating units are sometimes termed side groups. The use of the term side group in this meaning is not acceptable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09622 goldbook:09615)
AnnotationAssertion(mito:isMentionedBy goldbook:09622 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09622 "current"^^xsd:string)
Declaration(Class(goldbook:09623))
AnnotationAssertion(rdfs:label goldbook:09623 "number of generations")
AnnotationAssertion(dcterms:description goldbook:09623 "Number of constitutional repeating units on the path from the free valence to any end-group of a dendron.")
AnnotationAssertion(rdfs:comment goldbook:09623 "The number of generations \\(G\\) is a cardinal number. A dendron with \\(G = n\\) generations of constitutional repeating units should be called \\(n\\mbox{-}\\rm{generation}\\) dendron. The terms \"dendron of \\(n^{\\rm{th}}\\) generation\" or \"\\(n^{\\rm{th}}\\) generation dendron\" are not acceptable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09623 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09623 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09623 "current"^^xsd:string)
Declaration(Class(goldbook:09624))
AnnotationAssertion(rdfs:label goldbook:09624 "number of generations")
AnnotationAssertion(dcterms:description goldbook:09624 "Number of generation of the dendrons of a regular dendrimer molecule.")
AnnotationAssertion(rdfs:seeAlso goldbook:09624 goldbook:09623)
AnnotationAssertion(rdfs:seeAlso goldbook:09624 goldbook:09611)
AnnotationAssertion(rdfs:seeAlso goldbook:09624 goldbook:09627)
AnnotationAssertion(mito:isMentionedBy goldbook:09624 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09624 "current"^^xsd:string)
Declaration(Class(goldbook:09625))
AnnotationAssertion(rdfs:label goldbook:09625 "number of pseudo-generations")
AnnotationAssertion(dcterms:description goldbook:09625 "Number of generations of the hypothetical dendrimer molecule that would present the same ratio of constitutional repeating units to core unit.")
AnnotationAssertion(rdfs:comment goldbook:09625 "The number of pseudo-generations can be a decimal number, while the number of generations of a dendrimer molecule is an integer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09625 "In hyperbranched polymers obtained by the \\({\\rm{AB}}_{x}\\mbox{-}\\rm{type}\\) monomer + \\({\\rm{B}}_{y}\\mbox{-}\\rm{type}\\) monomer polycondensation approach, where \\(\\rm{A}\\) and \\(\\rm{B}\\) represent mutually reactive groups, the number of pseudo-generations \\(n\\) can be calculated by solving the equation: \\[r = y(x^n - 1)/(x - 1)\\], where \\(r\\) is the mole ratio of \\({\\rm{AB}}_{x}\\mbox{-}\\rm{type}\\) monomer to \\({\\rm{B}}_{y}\\mbox{-}\\rm{type}\\) monomer in the initial monomer mixture. See the figure for an example of \\({\\rm{AB}}_2\\) and \\({\\rm{B}}_{3}\\mbox{-}\\rm{type}\\) monomers (\\(x = 2\\) and \\(y = 3\\)). Idealized representation of an aliphatic hyperbranched polyester macromolecule obtained by one-step bulk polyesterification of 3-hydroxy-2-(hydroxymethyl)-2-methylpropanoic acid (\\({\\rm{AB}}_{2}\\mbox{-}\\rm{type}\\) monomer) and 2-ethyl-2-(hydroxymethyl)propane-1,3-diol (\\({\\rm{B}}_{3}\\mbox{-}\\rm{type}\\) molecule). "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09625 "The use of the terms generation and number of generations for a hyperbranched polymer is not acceptable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09625 goldbook:09603)
AnnotationAssertion(rdfs:seeAlso goldbook:09625 goldbook:09605)
AnnotationAssertion(rdfs:seeAlso goldbook:09625 goldbook:09614)
AnnotationAssertion(rdfs:seeAlso goldbook:09625 goldbook:09618)
AnnotationAssertion(rdfs:seeAlso goldbook:09625 goldbook:09624)
AnnotationAssertion(mito:isMentionedBy goldbook:09625 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09625 "current"^^xsd:string)
Declaration(Class(goldbook:09626))
AnnotationAssertion(rdfs:label goldbook:09626 "regular dendrimer")
AnnotationAssertion(dcterms:description goldbook:09626 "Substance composed of regular dendrimer molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:09626 goldbook:09627)
AnnotationAssertion(mito:isMentionedBy goldbook:09626 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09626 "current"^^xsd:string)
Declaration(Class(goldbook:09627))
AnnotationAssertion(rdfs:label goldbook:09627 "regular dendrimer molecule")
AnnotationAssertion(dcterms:description goldbook:09627 "Dendrimer molecule comprising only identical regular dendrons.")
AnnotationAssertion(rdfs:comment goldbook:09627 "A dendrimer molecule comprising only one dendron is a regular dendrimer molecule."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09627 goldbook:09605)
AnnotationAssertion(rdfs:seeAlso goldbook:09627 goldbook:09611)
AnnotationAssertion(rdfs:seeAlso goldbook:09627 goldbook:09628)
AnnotationAssertion(mito:isMentionedBy goldbook:09627 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09627 "current"^^xsd:string)
Declaration(Class(goldbook:09628))
AnnotationAssertion(rdfs:label goldbook:09628 "regular dendron")
AnnotationAssertion(dcterms:description goldbook:09628 "Dendron composed of only one type of constitutional repeating units and of only one type of end-groups.")
AnnotationAssertion(rdfs:seeAlso goldbook:09628 goldbook:09611)
AnnotationAssertion(mito:isMentionedBy goldbook:09628 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09628 "current"^^xsd:string)
Declaration(Class(goldbook:09629))
AnnotationAssertion(rdfs:label goldbook:09629 "semi-dendritic constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09629 "Constitutional repeating unit of connectivity \\(c \\ge 4\\) connected to more than two but less than \\(c\\) other constitutional repeating units.Example of a hyperbranched macromolecule part with a semi-dendritic constitutional repeating unit of connectivity \\(c = 4\\) (circled), connected to three other constitutional repeating units and to one hydroxymethyl end-group. The preferred constitutional repeating unit is chosen such that the branch points are at its end in the dendron direction.")
AnnotationAssertion(mito:isMentionedBy goldbook:09629 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09629 "current"^^xsd:string)
Declaration(Class(goldbook:09630))
AnnotationAssertion(rdfs:label goldbook:09630 "terminal constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09630 "Constitutional repeating unit connected to only one other constitutional repeating unit.")
AnnotationAssertion(rdfs:comment goldbook:09630 "A terminal constitutional repeating unit may be connected to one or more end-groups."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09630 goldbook:09611)
AnnotationAssertion(rdfs:seeAlso goldbook:09630 goldbook:09615)
AnnotationAssertion(mito:isMentionedBy goldbook:09630 doi:10.1515/pac-2016-1217)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09630 "current"^^xsd:string)
Declaration(Class(goldbook:09631))
AnnotationAssertion(rdfs:label goldbook:09631 "chalcogen bond")
AnnotationAssertion(dcterms:description goldbook:09631 "Net attractive interaction between an electrophilic region associated with a chalcogen atom in a molecular entity and a nucleophilic region in another, or the same, molecular entity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09631 "ChB")
AnnotationAssertion(rdfs:comment goldbook:09631 "A typical chalcogen bond is denoted by the three dots in \\(\\ce{R–Ch···A}\\), where \\(\\ce{Ch}\\) is the \\(\\ce{ChB}\\) donor, being any chalcogen atom (possibly hypervalent) having an electrophilic (electron-poor) region, \\(\\rm{R}\\) is the remainder of the molecular entity \\(\\ce{R–Ch}\\) containing the \\(\\ce{ChB}\\) donor, and \\(\\rm{A}\\) is the \\(\\ce{ChB}\\) acceptor and is typically a molecular entity possessing at least one nucleophilic (electron-rich) region."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09631 "Chalcogen atoms can concurrently form one or more than one chalcogen bond."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09631 "Chalcogen atoms of a molecular entity give rise to a variety of interactions with different electronic and geometric features. The term chalcogen bond must not be used for interactions where the chalcogen (frequently oxygen) functions as a nucleophile. The attractive intermolecular interaction between the oxygen atoms of an alcohol or a carboxylic acid and the acidic proton of another alcohol or carboxylic acid molecule is not a chalcogen bond, it is a hydrogen bond; the attractive intermolecular interaction between 1,4-dithiane and iodine atoms of diiodine or triiodomethane is not a chalcogen bond, it is a halogen bond; the attractive intermolecular interaction between bismuth and selenium atoms of tris(selenophen-2-yl)-bismuthane is not a chalcogen bond, it is a pnictogen bond (PnB); and the attractive intramolecular interactions between tin and sulphur atoms in crystalline 2,10-dichloro-2,10-dimethyl-2,10-distanna-6-thiaundecane is not a chalcogen bond, it is a tetrel bond (\\(\\ce{TtB}\\))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09631 doi:10.1515/pac-2018-0713)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09631 "current"^^xsd:string)
Declaration(Class(goldbook:09632))
AnnotationAssertion(rdfs:label goldbook:09632 "bioanalytical chemistry")
AnnotationAssertion(dcterms:description goldbook:09632 "Sub-field of analytical chemistry dealing with analysis of biomolecules.")
AnnotationAssertion(rdfs:comment goldbook:09632 "Bioanalytical chemistry covers the identification (identity, sequence), characterization (properties such as polarity and charge, structure, folding, intermolecular interactions), and quantification and monitoring (stability, dynamics, fragmentation, degradation, metabolism, and others)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09632 goldbook:09633)
AnnotationAssertion(mito:isMentionedBy goldbook:09632 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09632 "current"^^xsd:string)
Declaration(Class(goldbook:09633))
AnnotationAssertion(rdfs:label goldbook:09633 "biomolecule")
AnnotationAssertion(dcterms:description goldbook:09633 "Molecule of biological origin.")
AnnotationAssertion(rdfs:comment goldbook:09633 "Most biomolecules are organic compounds present in living organisms. They may also include exogenous molecules modified by metabolism. Some typical biomolecules representing subjects of bioanalytical chemistry are amino acids, peptides, polypeptides, proteins, nucleotides, nucleic acids, carbohydrates, glycoconjugates, lipids, antibodies, haptenes, and receptors, as well as primary and secondary metabolites."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09633 "Modern bioanalytical chemistry shifts its attention to the analysis and investigation of biomacromolecules, such as nucleic acids, proteins, polysaccharides, and others."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09633 goldbook:09632)
AnnotationAssertion(rdfs:seeAlso goldbook:09633 goldbook:09809)
AnnotationAssertion(mito:isMentionedBy goldbook:09633 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09633 "current"^^xsd:string)
Declaration(Class(goldbook:09634))
AnnotationAssertion(rdfs:label goldbook:09634 "biomacromolecule")
AnnotationAssertion(dcterms:description goldbook:09634 "Macromolecule (including proteins, nucleic acids, and polysaccharides) formed by living organisms.")
AnnotationAssertion(rdfs:comment goldbook:09634 "From a biological standpoint, a biomacromolecule can also be defined as a biomolecule of high relative molecular mass."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09634 "Non-natural biomacromolecule-like synthetic molecules (such as poly(lactic acid)), and nucleic acid analogues (such as peptide nucleic acids or locked nucleic acids) are also used in bioanalysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09634 goldbook:09714)
AnnotationAssertion(mito:isMentionedBy goldbook:09634 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09634 "current"^^xsd:string)
Declaration(Class(goldbook:09635))
AnnotationAssertion(rdfs:label goldbook:09635 "amniotic fluid")
AnnotationAssertion(dcterms:description goldbook:09635 "Fluid that surrounds the foetus in the amniotic sac.")
AnnotationAssertion(rdfs:comment goldbook:09635 "A specimen is obtained by a technique called amniocentesis, in which a long needle is inserted into the amniotic sac through the abdominal wall, through which fluid is withdrawn."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09635 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09635 "current"^^xsd:string)
Declaration(Class(goldbook:09636))
AnnotationAssertion(rdfs:label goldbook:09636 "blood")
AnnotationAssertion(dcterms:description goldbook:09636 "Fluid that circulates through the heart, arteries, capillaries, and veins.")
AnnotationAssertion(rdfs:comment goldbook:09636 "Circulating blood is a heterogeneous fluid consisting of a clear, slightly yellow liquid (native plasma) and three groups of suspended, formed elements: red blood cells, or erythrocytes (about \\(\\pu{99\\%}\\) of the blood cells), white blood cells, or leukocytes, and blood platelets, or thrombocytes. When no anticoagulant is added, normal blood withdrawn from the circulation forms a clot due the polymerization of fibrinogen to fibrin. On standing, the clot retracts, expressing serum which differs from plasma chiefly in that it contains no fibrinogen."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09636 goldbook:09637)
AnnotationAssertion(mito:isMentionedBy goldbook:09636 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09636 "current"^^xsd:string)
Declaration(Class(goldbook:09637))
AnnotationAssertion(rdfs:label goldbook:09637 "blood cell")
AnnotationAssertion(dcterms:description goldbook:09637 "Any cellular element of the blood, including erythrocytes, leucocytes, and platelets.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09637 "haematopoietic cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09637 "hematocyte")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09637 "hemocyte")
AnnotationAssertion(rdfs:comment goldbook:09637 "A blood cell is produced by hematopoiesis and is normally found in blood. In mammals, these fall into three general categories: red blood cells (erythrocytes), white blood cells (leukocytes), and platelets (thrombocytes)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09637 goldbook:09636)
AnnotationAssertion(mito:isMentionedBy goldbook:09637 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09637 "current"^^xsd:string)
Declaration(Class(goldbook:09638))
AnnotationAssertion(rdfs:label goldbook:09638 "blood cell count")
AnnotationAssertion(dcterms:description goldbook:09638 "Number of red blood cells and white blood cells per unit volume in a specimen of venous blood.")
AnnotationAssertion(rdfs:seeAlso goldbook:09638 goldbook:09636)
AnnotationAssertion(rdfs:seeAlso goldbook:09638 goldbook:09637)
AnnotationAssertion(mito:isMentionedBy goldbook:09638 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09638 "current"^^xsd:string)
Declaration(Class(goldbook:09639))
AnnotationAssertion(rdfs:label goldbook:09639 "blood group")
AnnotationAssertion(dcterms:description goldbook:09639 "Red cell phenotypes classified by their antigenic structural characteristics, which are under the control of various allelic genes.")
AnnotationAssertion(rdfs:comment goldbook:09639 "The cell membrane properties that provide the specific antigenicity of the blood groups are called agglutinogens, as they agglutinate or clump in the presence of their specific antibody."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09639 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09639 "current"^^xsd:string)
Declaration(Class(goldbook:09640))
AnnotationAssertion(rdfs:label goldbook:09640 "body fluids")
AnnotationAssertion(dcterms:description goldbook:09640 "Liquids originating from the bodies of living or dead humans, animals, and other organisms.")
AnnotationAssertion(rdfs:comment goldbook:09640 "They include fluids that are excreted or secreted from the body."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09640 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09640 "current"^^xsd:string)
Declaration(Class(goldbook:09641))
AnnotationAssertion(rdfs:label goldbook:09641 "cerebrospinal fluid")
AnnotationAssertion(dcterms:description goldbook:09641 "Clear, colourless fluid that fills spaces within and around the central nervous system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09641 "CSF")
AnnotationAssertion(rdfs:comment goldbook:09641 "CSF originates from plasma by a biological ultrafiltration process. Specimens are obtained by a lumbar puncture (i.e. a spinal tap)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09641 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09641 "current"^^xsd:string)
Declaration(Class(goldbook:09642))
AnnotationAssertion(rdfs:label goldbook:09642 "cord blood")
AnnotationAssertion(dcterms:description goldbook:09642 "Blood contained in the vessels of the umbilical cord at the time of birth.")
AnnotationAssertion(rdfs:comment goldbook:09642 "Cord blood contains stem cells."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09642 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09642 "current"^^xsd:string)
Declaration(Class(goldbook:09643))
AnnotationAssertion(rdfs:label goldbook:09643 "lymph")
AnnotationAssertion(dcterms:description goldbook:09643 "Yellowish, slightly basic fluid circulating through the lymphatic system.")
AnnotationAssertion(rdfs:comment goldbook:09643 "Lymph is similar to plasma and contains white blood cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09643 goldbook:09637)
AnnotationAssertion(mito:isMentionedBy goldbook:09643 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09643 "current"^^xsd:string)
Declaration(Class(goldbook:09644))
AnnotationAssertion(rdfs:label goldbook:09644 "occult blood")
AnnotationAssertion(dcterms:description goldbook:09644 "Blood present in such small amounts that its presence can be ascertained only by chemical analysis or by spectroscopic or microscopic examination; particularly the blood found in stools.")
AnnotationAssertion(rdfs:seeAlso goldbook:09644 goldbook:09636)
AnnotationAssertion(mito:isMentionedBy goldbook:09644 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09644 "current"^^xsd:string)
Declaration(Class(goldbook:09645))
AnnotationAssertion(rdfs:label goldbook:09645 "peripheral blood")
AnnotationAssertion(dcterms:description goldbook:09645 "Blood obtained from parts of the body that are located at some distance from the heart.")
AnnotationAssertion(rdfs:seeAlso goldbook:09645 goldbook:09636)
AnnotationAssertion(mito:isMentionedBy goldbook:09645 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09645 "current"^^xsd:string)
Declaration(Class(goldbook:09646))
AnnotationAssertion(rdfs:label goldbook:09646 "protein-free filtrate")
AnnotationAssertion(dcterms:description goldbook:09646 "Sample of blood, serum, or plasma from which all proteins have been removed by chemical or physical denaturation, dialysis, ultrafiltration, or solvent extraction.")
AnnotationAssertion(rdfs:seeAlso goldbook:09646 goldbook:09636)
AnnotationAssertion(mito:isMentionedBy goldbook:09646 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09646 "current"^^xsd:string)
Declaration(Class(goldbook:09647))
AnnotationAssertion(rdfs:label goldbook:09647 "saliva")
AnnotationAssertion(dcterms:description goldbook:09647 "Clear, viscous secretion from the parotid, submaxillary, sublingual, and smaller mucous glands in the cavity of the mouth.")
AnnotationAssertion(rdfs:comment goldbook:09647 "Saliva contains many important substances, including electrolytes, mucus, antibacterial compounds and various enzymes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09647 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09647 "current"^^xsd:string)
Declaration(Class(goldbook:09648))
AnnotationAssertion(rdfs:label goldbook:09648 "skin")
AnnotationAssertion(dcterms:description goldbook:09648 "Soft outer covering of vertebrates.")
AnnotationAssertion(mito:isMentionedBy goldbook:09648 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09648 "current"^^xsd:string)
Declaration(Class(goldbook:09649))
AnnotationAssertion(rdfs:label goldbook:09649 "sperm")
AnnotationAssertion(dcterms:description goldbook:09649 "Seminal fluid containing male reproductive cells.")
AnnotationAssertion(mito:isMentionedBy goldbook:09649 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09649 "current"^^xsd:string)
Declaration(Class(goldbook:09650))
AnnotationAssertion(rdfs:label goldbook:09650 "sweat")
AnnotationAssertion(dcterms:description goldbook:09650 "Fluid excreted by the sweat glands in the skin of mammals during perspiration.")
AnnotationAssertion(mito:isMentionedBy goldbook:09650 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09650 "current"^^xsd:string)
Declaration(Class(goldbook:09651))
AnnotationAssertion(rdfs:label goldbook:09651 "tears")
AnnotationAssertion(dcterms:description goldbook:09651 "Clear salty liquid that is secreted by the lachrymal gland of the eye to lubricate the surface between the eyeball and eyelid and to wash away irritants.")
AnnotationAssertion(mito:isMentionedBy goldbook:09651 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09651 "current"^^xsd:string)
Declaration(Class(goldbook:09652))
AnnotationAssertion(rdfs:label goldbook:09652 "tissue")
AnnotationAssertion(dcterms:description goldbook:09652 "Group of biological cells that perform a specific function.")
AnnotationAssertion(rdfs:comment goldbook:09652 "A cellular organizational level intermediate between cells and complete organs."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09652 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09652 "current"^^xsd:string)
Declaration(Class(goldbook:09653))
AnnotationAssertion(rdfs:label goldbook:09653 "urine")
AnnotationAssertion(dcterms:description goldbook:09653 "Fluid containing metabolic products that is excreted by the kidneys, stored in the bladder, and normally discharged by way of the urethra.")
AnnotationAssertion(mito:isMentionedBy goldbook:09653 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09653 "current"^^xsd:string)
Declaration(Class(goldbook:09654))
AnnotationAssertion(rdfs:label goldbook:09654 "bioinformatics")
AnnotationAssertion(dcterms:description goldbook:09654 "Discipline encompassing the development and utilisation of computational tools to store, analyse, and interpret biological data.")
AnnotationAssertion(rdfs:comment goldbook:09654 "Among the most important bioinformatics tools are specialised databases with genetic and protein sequences accompanied by related data (biological function, cell localisation, etc.) and including search, alignment, and sorting algorithms or graphical modelling."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09654 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09654 "current"^^xsd:string)
Declaration(Class(goldbook:09655))
AnnotationAssertion(rdfs:label goldbook:09655 "biological recognition element")
AnnotationAssertion(dcterms:description goldbook:09655 "Component of biological origin that translates information from the biochemical domain into a physical or chemical domain with a defined selectivity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09655 "biochemical receptor")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09655 "biocomponent (at a biosensor)")
AnnotationAssertion(rdfs:comment goldbook:09655 "The main purpose of the biological recognition element is to provide a biosensor or other system with a high degree of selectivity for the kind of quantity to be measured."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09655 "Typical biological recognition elements include biocatalysts, immune receptors, nucleic acids, and others. Biologically-derived recognition elements, such as oligopeptides, oligosaccharides, and peptide nucleic acids are also of great interest."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09655 "A biocatalytic recognition element is based on a biocatalytic reaction. Five types of biocatalyst are commonly used: (a) Enzyme (mono-or multi-enzyme): the most common and well-developed recognition system; (b) whole cells (micro-organisms, such as bacteria, fungi, eukaryotic cells or yeast) or cell organelles or particles (mitochondria, cell walls); and (c) tissue (plant or animal tissue slice). (d) Ribozymes, and (e) DNAzymes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09655 "A biocomplexing or bioaffinity recognition element is based on the binding interaction of the analyte with macromolecules or organised molecular assemblies that have either been isolated from their original biological environment or engineered."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09655 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09655 "current"^^xsd:string)
Declaration(Class(goldbook:09656))
AnnotationAssertion(rdfs:label goldbook:09656 "enzymatic decomposition")
AnnotationAssertion(dcterms:description goldbook:09656 "Decomposition of organic materials (e.g. starch, sugars, proteins, lignin, hemicelluloses, etc.) with specific enzymes or microbes in which the enzyme converts a high relative molecular mass compound into lower relative molecular mass species.")
AnnotationAssertion(rdfs:seeAlso goldbook:09656 goldbook:09633)
AnnotationAssertion(mito:isMentionedBy goldbook:09656 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09656 "current"^^xsd:string)
Declaration(Class(goldbook:09658))
AnnotationAssertion(rdfs:label goldbook:09658 "lysis")
AnnotationAssertion(dcterms:description goldbook:09658 "Breaking down of a cell.")
AnnotationAssertion(rdfs:comment goldbook:09658 "Lysis may be caused by physical, (bio)chemical, or biological means."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09658 "A fluid containing the contents of lysed cells is called a \"lysate\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09658 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09658 "current"^^xsd:string)
Declaration(Class(goldbook:09659))
AnnotationAssertion(rdfs:label goldbook:09659 "microarray")
AnnotationAssertion(dcterms:description goldbook:09659 "Two-dimensional arrangement of a device for analysis of sub-microlitre sample volume.")
AnnotationAssertion(rdfs:comment goldbook:09659 "This screening format is a direct offshoot of genomic microarray technologies and makes use of ultra-low-volume miniaturization provided by nanodispensing technologies."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09659 "A collection of molecules spatially addressed on a surface within features that have micrometer dimensions. Planar device (flat plane) used for off-line determination and identification of biocompounds."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09659 goldbook:09812)
AnnotationAssertion(rdfs:seeAlso goldbook:09659 goldbook:09832)
AnnotationAssertion(mito:isMentionedBy goldbook:09659 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09659 "current"^^xsd:string)
Declaration(Class(goldbook:09660))
AnnotationAssertion(rdfs:label goldbook:09660 "sample quality control")
AnnotationAssertion(dcterms:description goldbook:09660 "Test of the purity of the sample that will be subjected to detailed biochemical analysis.")
AnnotationAssertion(rdfs:comment goldbook:09660 "Microelectrophoresis belongs to methods used for sample quality testing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09660 goldbook:09747)
AnnotationAssertion(mito:isMentionedBy goldbook:09660 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09660 "current"^^xsd:string)
Declaration(Class(goldbook:09661))
AnnotationAssertion(rdfs:label goldbook:09661 "affinity")
AnnotationAssertion(dcterms:description goldbook:09661 "Strength of association between a single antibody and a single epitope of antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09661 "binding affinity")
AnnotationAssertion(rdfs:comment goldbook:09661 "Affinity of the immunochemical reaction: \\[\\ce{Antibody + Antigen -> Antibody{-}Antigen}\\] is characterised by the affinity (binding, association) constant \\[K_{\\rm{A}} = [\\ce{Antibody{-}Antigen}]/[\\ce{Antibody}][\\ce{Antigen}]\\]"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09661 "The average binding constant reflects a population of antibody molecules (polyclonal antibody)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09661 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09661 "current"^^xsd:string)
Declaration(Class(goldbook:09662))
AnnotationAssertion(rdfs:label goldbook:09662 "agglutination inhibition")
AnnotationAssertion(dcterms:description goldbook:09662 "Type of agglutination in which particulate and soluble antigen compete for soluble antibody.")
AnnotationAssertion(rdfs:comment goldbook:09662 "Typically, it is soluble antigen in the test medium which reacts first with the soluble antibody, inhibiting the agglutination of indicator particles. With viral hemagglutination inhibition assays, host antibodies resulting from a specific infection are the most common forms of agglutination inhibition assays. In this case, viral-specific antibodies block the sites on the virus that agglutinate erythrocytes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09662 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09662 "current"^^xsd:string)
Declaration(Class(goldbook:09663))
AnnotationAssertion(rdfs:label goldbook:09663 "antigenic determinant")
AnnotationAssertion(dcterms:description goldbook:09663 "Part of the structure of an antigen molecule that is responsible for specific interaction with antibody molecules evoked by the same or a similar antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09663 "epitome")
AnnotationAssertion(mito:isMentionedBy goldbook:09663 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09663 "current"^^xsd:string)
Declaration(Class(goldbook:09664))
AnnotationAssertion(rdfs:label goldbook:09664 "avidity")
AnnotationAssertion(dcterms:description goldbook:09664 "Net affinity of all binding sites of all antibodies in the antiserum under specified physicochemical reaction conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09664 goldbook:09661)
AnnotationAssertion(mito:isMentionedBy goldbook:09664 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09664 "current"^^xsd:string)
Declaration(Class(goldbook:09665))
AnnotationAssertion(rdfs:label goldbook:09665 "binding capacity")
AnnotationAssertion(dcterms:description goldbook:09665 "Amount of a ligand that binds to a receptor expressed in operational units.")
AnnotationAssertion(rdfs:comment goldbook:09665 "Operational units are defined in contrast to the quantitative mass units of the affinity constant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09665 "Binding capacity is determined by saturating the receptor and then measuring the amount of complex forming ligand. Parameters like pH and ionic strength influence the capacity value, which will be changed depending on the experimental conditions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09665 goldbook:09661)
AnnotationAssertion(mito:isMentionedBy goldbook:09665 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09665 "current"^^xsd:string)
Declaration(Class(goldbook:09666))
AnnotationAssertion(rdfs:label goldbook:09666 "blocking")
AnnotationAssertion(dcterms:description goldbook:09666 "Coating of an immunospecific surface (e.g. serum, tissues, cells, biological macromolecules, biosensor surface) to form an active cover with selectivity or an inert layer.")
AnnotationAssertion(rdfs:comment goldbook:09666 "Blocking is a pre-treatment method with blocking agents (e.g. monovalent Fab fragment, i.e. the antigen-binding fragment of an immunoglobulin molecule; mono or divalent antibodies; organic ligands; metals)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09666 goldbook:09634)
AnnotationAssertion(rdfs:seeAlso goldbook:09666 goldbook:09652)
AnnotationAssertion(mito:isMentionedBy goldbook:09666 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09666 "current"^^xsd:string)
Declaration(Class(goldbook:09667))
AnnotationAssertion(rdfs:label goldbook:09667 "bound/free ratio")
AnnotationAssertion(dcterms:description goldbook:09667 "Amount of analyte bound by a label divided by amount of unbound (free) analyte")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09667 "B/F")
AnnotationAssertion(mito:isMentionedBy goldbook:09667 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09667 "current"^^xsd:string)
Declaration(Class(goldbook:09668))
AnnotationAssertion(rdfs:label goldbook:09668 "complement")
AnnotationAssertion(dcterms:description goldbook:09668 "Array of serum proteins (some of which are enzymes) that become sequentially activated after the first member of the series is activated by either antigen-antibody complexes or microbial products.")
AnnotationAssertion(mito:isMentionedBy goldbook:09668 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09668 "current"^^xsd:string)
Declaration(Class(goldbook:09669))
AnnotationAssertion(rdfs:label goldbook:09669 "enzyme conjugate")
AnnotationAssertion(dcterms:description goldbook:09669 "Conjugate that has an enzyme bound covalently.")
AnnotationAssertion(mito:isMentionedBy goldbook:09669 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09669 "current"^^xsd:string)
Declaration(Class(goldbook:09670))
AnnotationAssertion(rdfs:label goldbook:09670 "hemagglutination")
AnnotationAssertion(dcterms:description goldbook:09670 "Agglutination reactions in which the particles used are erythrocytes.")
AnnotationAssertion(rdfs:comment goldbook:09670 "Hemagglutination may be either direct, in which erythrocyte antigens are reactants, or indirect (passive) for coated antigen or, in the case of reverse (passive) assays, coated antibody. One of the most common uses of hemagglutination is to quantitate the number of hemagglutinating viruses (cf. influenza) or their soluble hemagglutinating surface subunits. It can also be used for blood typing."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09670 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09670 "current"^^xsd:string)
Declaration(Class(goldbook:09671))
AnnotationAssertion(rdfs:label goldbook:09671 "immunoblotting")
AnnotationAssertion(dcterms:description goldbook:09671 "Technique that uses antibodies (or other specific ligands in related techniques) to identify target proteins among a number of unrelated protein species.")
AnnotationAssertion(rdfs:comment goldbook:09671 "The techniques allow the detection of proteins from complex mixtures separated by gel chromatography and then transferred to a membrane. After incubation of the attached product from membrane with labelled antibody, the target proteins become visible."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09671 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09671 "current"^^xsd:string)
Declaration(Class(goldbook:09672))
AnnotationAssertion(rdfs:label goldbook:09672 "immunochemical specificity")
AnnotationAssertion(dcterms:description goldbook:09672 "The extent to which the immunoassay responds only to (all subsets of) a specific analyte and not to other substances of similar structure that are present in the sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09672 "specificity")
AnnotationAssertion(mito:isMentionedBy goldbook:09672 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09672 "current"^^xsd:string)
Declaration(Class(goldbook:09673))
AnnotationAssertion(rdfs:label goldbook:09673 "immunocomplex")
AnnotationAssertion(dcterms:description goldbook:09673 "Product of an antigen-antibody reaction that may also contain components of the complement.")
AnnotationAssertion(rdfs:comment goldbook:09673 "Formation of the immunocomplex is characterised by the binding constant"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09673 goldbook:09661)
AnnotationAssertion(rdfs:seeAlso goldbook:09673 goldbook:09668)
AnnotationAssertion(mito:isMentionedBy goldbook:09673 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09673 "current"^^xsd:string)
Declaration(Class(goldbook:09674))
AnnotationAssertion(rdfs:label goldbook:09674 "immunoglobulin class")
AnnotationAssertion(dcterms:description goldbook:09674 "Classification of immunoglobulins based on antigenic and structural differences of the heavy peptide chain.")
AnnotationAssertion(rdfs:comment goldbook:09674 "There are five classes: \\(\\ce{IgG}\\), \\(\\ce{IgA}\\), \\(\\ce{IgM}\\), \\(\\ce{IgD}\\), and \\(\\ce{IgE}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09674 "Immunoglobulin subclass (isotype) represents the subdivision of an immunoglobulin class based on structural and antigenic differences in the heavy peptide chain. Four human \\(\\ce{IgG}\\) subclasses and two \\(\\ce{IgA}\\) subclasses have currently been recognised; \\(\\ce{IgM}\\) subclasses have been postulated; \\(\\ce{IgD}\\) and \\(\\ce{IgE}\\) subclasses are unknown."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09674 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09674 "current"^^xsd:string)
Declaration(Class(goldbook:09675))
AnnotationAssertion(rdfs:label goldbook:09675 "immunoprecipitation")
AnnotationAssertion(dcterms:description goldbook:09675 "Isolation and concentration of an antigen by forming a precipitate with an antibody.")
AnnotationAssertion(rdfs:comment goldbook:09675 "Immunoprecipitation requires that the antibody be coupled to a solid substrate at some point in the procedure."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09675 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09675 "current"^^xsd:string)
Declaration(Class(goldbook:09676))
AnnotationAssertion(rdfs:label goldbook:09676 "immunoreactivity")
AnnotationAssertion(dcterms:description goldbook:09676 "Kinetic property of the immune response caused by an antigen.")
AnnotationAssertion(mito:isMentionedBy goldbook:09676 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09676 "current"^^xsd:string)
Declaration(Class(goldbook:09677))
AnnotationAssertion(rdfs:label goldbook:09677 "immunosensor")
AnnotationAssertion(dcterms:description goldbook:09677 "Biosensor where one of the immunointeracting partners (an antibody or an antigen as the analyte) is immobilised on the surface of a physicochemical transducer.")
AnnotationAssertion(rdfs:comment goldbook:09677 "The generated signal either directly reflects the amount of formed immunocomplex or corresponds to the amount of label."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09677 goldbook:09673)
AnnotationAssertion(mito:isMentionedBy goldbook:09677 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09677 "current"^^xsd:string)
Declaration(Class(goldbook:09678))
AnnotationAssertion(rdfs:label goldbook:09678 "indirect agglutination")
AnnotationAssertion(dcterms:description goldbook:09678 "Agglutination in which antigen is first immobilised artificially onto the particulate surfaces, either by physical adsorption or by chemical and/or immunochemical linkers.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09678 "passive agglutination")
AnnotationAssertion(rdfs:comment goldbook:09678 "Antigen-loaded particles can be used to detect the presence of the corresponding specific agglutinins in sample. Agglutination results by cross-linking of the antigen-bearing particles onto an extensive antigen-antibody lattice (i.e. in detectable agglutination of the particles)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09678 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09678 "current"^^xsd:string)
Declaration(Class(goldbook:09679))
AnnotationAssertion(rdfs:label goldbook:09679 "lateral flow test")
AnnotationAssertion(dcterms:description goldbook:09679 "Migration of the sample zone driven by capillary forces in a porous carrier strip.")
AnnotationAssertion(rdfs:comment goldbook:09679 "During migration the dissolved tracer becomes distributed between capture and control zones with immobilised antibodies."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09679 "The amount of the label compound in both zones depends on the concentration of the compound in the studied sample."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09679 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09679 "current"^^xsd:string)
Declaration(Class(goldbook:09680))
AnnotationAssertion(rdfs:label goldbook:09680 "monoclonal")
AnnotationAssertion(dcterms:description goldbook:09680 "Arising from a single clone of cells.")
AnnotationAssertion(rdfs:comment goldbook:09680 "In the case of immunoglobulin, \"monoclonal\" refers to its origin."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09680 "Usually, the monoclonal antibody is of a single immunoglobulin class containing only one light chain type of either the K or L variety. It also refers to all antibody molecules having identical physical-chemical characteristics and antibody specificity. Monoclonal antibodies have very restricted structural diversity and they are homogeneous compared with polyclonal antibodies."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09680 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09680 "current"^^xsd:string)
Declaration(Class(goldbook:09681))
AnnotationAssertion(rdfs:label goldbook:09681 "monospecificity")
AnnotationAssertion(dcterms:description goldbook:09681 "Immunoreactivity of an antiserum with its designated antigen.")
AnnotationAssertion(rdfs:comment goldbook:09681 "In practice, true monospecificity to naturally occurring antigens does not occur in antisera produced by the immunization of the intact animal. An attempt is made to reduce the level of unwanted specificities below that which will interfere with the intended use of a particular immunochemical test."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09681 goldbook:09676)
AnnotationAssertion(rdfs:seeAlso goldbook:09681 goldbook:09672)
AnnotationAssertion(mito:isMentionedBy goldbook:09681 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09681 "current"^^xsd:string)
Declaration(Class(goldbook:09682))
AnnotationAssertion(rdfs:label goldbook:09682 "polyclonal")
AnnotationAssertion(dcterms:description goldbook:09682 "Arising from multiple, different clones.")
AnnotationAssertion(rdfs:comment goldbook:09682 "Polyclonal antibodies (pAbs) are antibodies that are secreted by different B cell lineages within the body. They are a collection of immunoglobulin molecules that react against a specific antigen, each identifying a different epitope."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09682 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09682 "current"^^xsd:string)
Declaration(Class(goldbook:09683))
AnnotationAssertion(rdfs:label goldbook:09683 "reverse passive agglutination")
AnnotationAssertion(dcterms:description goldbook:09683 "Modification of the indirect agglutination assay, where the particles are coated with antibody.")
AnnotationAssertion(rdfs:comment goldbook:09683 "These antibody-laden particles become probes for detecting specific antigens in the sample material. The presence of the relevant antigen will result in the agglutination of particles."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09683 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09683 "current"^^xsd:string)
Declaration(Class(goldbook:09684))
AnnotationAssertion(rdfs:label goldbook:09684 "sandwich immunoassay")
AnnotationAssertion(dcterms:description goldbook:09684 "Immunoassay using chemical or immunochemical binding of analyte to a solid phase carrying antibody and the immunochemical binding of a second (labelled) reagent to the analyte.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09684 "two-site, noncompetitive immunoassay")
AnnotationAssertion(rdfs:comment goldbook:09684 "This is one of the most common assays in clinical practice."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09684 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09684 "current"^^xsd:string)
Declaration(Class(goldbook:09685))
AnnotationAssertion(rdfs:label goldbook:09685 "amplification of deoxyribonucleic acid")
AnnotationAssertion(dcterms:description goldbook:09685 "Process of producing multiple copies of a deoxyribonucleic acid (DNA) sequence by the repeated copying of a DNA segment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09685 "amplification of DNA")
AnnotationAssertion(mito:isMentionedBy goldbook:09685 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09685 "current"^^xsd:string)
Declaration(Class(goldbook:09686))
AnnotationAssertion(rdfs:label goldbook:09686 "base pair")
AnnotationAssertion(dcterms:description goldbook:09686 "Pair of two nucleobases, consisting of one purine and one pyrimidine base, held together by hydrogen bonds.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09686 "bp")
AnnotationAssertion(rdfs:comment goldbook:09686 "In deoxyribonucleic acid (DNA), guanine typically pairs with cytosine and adenine typically pairs with thymine. In ribonucleic acid (RNA), adenine typically pairs with uracil."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09686 goldbook:09710)
AnnotationAssertion(mito:isMentionedBy goldbook:09686 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09686 "current"^^xsd:string)
Declaration(Class(goldbook:09687))
AnnotationAssertion(rdfs:label goldbook:09687 "base sequence analysis")
AnnotationAssertion(dcterms:description goldbook:09687 "Method for determining the nucleotide sequence.")
AnnotationAssertion(rdfs:seeAlso goldbook:09687 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09687 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09687 "current"^^xsd:string)
Declaration(Class(goldbook:09688))
AnnotationAssertion(rdfs:label goldbook:09688 "basic local alignment search tool")
AnnotationAssertion(dcterms:description goldbook:09688 "Computer algorithm that finds regions of local similarity between deoxyribonucleic acid (DNA) or protein sequences.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09688 "BLAST")
AnnotationAssertion(mito:isMentionedBy goldbook:09688 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09688 "current"^^xsd:string)
Declaration(Class(goldbook:09689))
AnnotationAssertion(rdfs:label goldbook:09689 "cloning")
AnnotationAssertion(dcterms:description goldbook:09689 "Specialised deoxyribonucleic acid (DNA) technology for the production of multiple exact copies of a single gene or another segment of DNA.")
AnnotationAssertion(mito:isMentionedBy goldbook:09689 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09689 "current"^^xsd:string)
Declaration(Class(goldbook:09690))
AnnotationAssertion(rdfs:label goldbook:09690 "cloning vector")
AnnotationAssertion(dcterms:description goldbook:09690 "Deoxyribonucleic acid (DNA) molecule into which another DNA fragment of appropriate size can be integrated without the loss of its capacity for self-replication.")
AnnotationAssertion(mito:isMentionedBy goldbook:09690 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09690 "current"^^xsd:string)
Declaration(Class(goldbook:09691))
AnnotationAssertion(rdfs:label goldbook:09691 "complementary sequence")
AnnotationAssertion(dcterms:description goldbook:09691 "Nucleotide sequence that can form a double-stranded structure with another deoxyribonucleic acid (DNA) sequence by following base-pairing (see base pair) rules.")
AnnotationAssertion(rdfs:seeAlso goldbook:09691 goldbook:09712)
AnnotationAssertion(rdfs:seeAlso goldbook:09691 goldbook:09686)
AnnotationAssertion(mito:isMentionedBy goldbook:09691 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09691 "current"^^xsd:string)
Declaration(Class(goldbook:09692))
AnnotationAssertion(rdfs:label goldbook:09692 "complete genome sequence")
AnnotationAssertion(dcterms:description goldbook:09692 "High-quality, low-error, gap-free deoxyribonucleic acid (DNA) sequence of an entire genome of an organism.")
AnnotationAssertion(mito:isMentionedBy goldbook:09692 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09692 "current"^^xsd:string)
Declaration(Class(goldbook:09693))
AnnotationAssertion(rdfs:label goldbook:09693 "damage to deoxyribonucleic acid")
AnnotationAssertion(dcterms:description goldbook:09693 "Alteration in the deoxyribonucleic acid (DNA) chemical structure resulting from interactions with physical or chemical agents occurring in the environment, generated in the organisms as by-products of metabolism, or used as therapeutics.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09693 "damage to DNA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09693 "DNA damage")
AnnotationAssertion(rdfs:comment goldbook:09693 "The main types of DNA damage include the interruption of the sugar-phosphate backbone (strand breaks) or the release of bases due to hydrolysis of N-glycosidic bonds (resulting in abasic sites), inter- and intra-strand crosslinks (such as pyrimidine dimers), and a variety of nucleobase lesions (adducts) resulting from reactions of DNA with a broad range of oxidants, alkylating compounds, and other agents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09693 "Terms \"(product of) DNA damage\" (lesion, adduct) and \"mutation\" should not be intermingled. Mutations refer to hereditable changes in DNA sequence—substitutions, deletions, or insertions of (one or more) standard base pair(s) and are not synonyms to \"base mismatches\". Importantly, DNA damage and its repair can promote the occurrence of mutations."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09693 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09693 "current"^^xsd:string)
Declaration(Class(goldbook:09694))
AnnotationAssertion(rdfs:label goldbook:09694 "deletion")
AnnotationAssertion(dcterms:description goldbook:09694 "Loss of a part (one or more base pairs) of deoxyribonucleic acid (DNA).")
AnnotationAssertion(rdfs:seeAlso goldbook:09694 goldbook:09686)
AnnotationAssertion(mito:isMentionedBy goldbook:09694 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09694 "current"^^xsd:string)
Declaration(Class(goldbook:09695))
AnnotationAssertion(rdfs:label goldbook:09695 "deoxyribose")
AnnotationAssertion(dcterms:description goldbook:09695 "Type of pentose sugar that is incorporated in the structure of deoxyribonucleic acid (DNA).")
AnnotationAssertion(mito:isMentionedBy goldbook:09695 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09695 "current"^^xsd:string)
Declaration(Class(goldbook:09696))
AnnotationAssertion(rdfs:label goldbook:09696 "deoxyribonucleic acid fragmentation")
AnnotationAssertion(dcterms:description goldbook:09696 "Breaking and/or separation of large deoxyribonucleic acid (DNA) molecules into smaller pieces (fragments).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09696 "DNA fragmentation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09696 "fragmentation of DNA")
AnnotationAssertion(rdfs:comment goldbook:09696 "DNA fragmentation is usually achieved via cleavage with restriction endonucleases at specific sites or non-specifically by, for example, sonication."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09696 "DNA fragmentation is also a consequence of damage to DNA."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09696 goldbook:09704)
AnnotationAssertion(mito:isMentionedBy goldbook:09696 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09696 "current"^^xsd:string)
Declaration(Class(goldbook:09697))
AnnotationAssertion(rdfs:label goldbook:09697 "deoxyribonucleic acid fragmentation index")
AnnotationAssertion(dcterms:description goldbook:09697 "Fraction of deoxyribonucleic acid (DNA) having fragmented DNA.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09697 "DFI")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09697 "DNA fragmentation index")
AnnotationAssertion(mito:isMentionedBy goldbook:09697 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09697 "current"^^xsd:string)
Declaration(Class(goldbook:09698))
AnnotationAssertion(rdfs:label goldbook:09698 "deoxyribonucleic acid integrity index")
AnnotationAssertion(dcterms:description goldbook:09698 "Ratio of longer fragments to shorter deoxyribonucleic acid (DNA).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09698 "DNA integrity index")
AnnotationAssertion(rdfs:comment goldbook:09698 "Integrity index may be clinically usefully used as surrogate for detection of tumours."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09698 "DNA strand integrity is measured by quantitative PCR (QPCR) using a real-time system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09698 goldbook:09719)
AnnotationAssertion(mito:isMentionedBy goldbook:09698 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09698 "current"^^xsd:string)
Declaration(Class(goldbook:09699))
AnnotationAssertion(rdfs:label goldbook:09699 "deoxyribonucleic acid mismatch")
AnnotationAssertion(dcterms:description goldbook:09699 "Defect in the double stranded deoxyribonucleic acid (DNA) structure in which the DNA double helix contains one (or more) non-standard base pairs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09699 "DNA mismatch")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09699 "mismatch in DNA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09699 "multi-base mismatch")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09699 "single mismatch")
AnnotationAssertion(rdfs:comment goldbook:09699 "One mismatch is known as a single mismatch. Multiple mismatches are called multi-base mismatches."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09699 goldbook:09686)
AnnotationAssertion(rdfs:seeAlso goldbook:09699 goldbook:09703)
AnnotationAssertion(mito:isMentionedBy goldbook:09699 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09699 "current"^^xsd:string)
Declaration(Class(goldbook:09700))
AnnotationAssertion(rdfs:label goldbook:09700 "deoxyribonucleic acid profiling")
AnnotationAssertion(dcterms:description goldbook:09700 "Identification of individuals by matching characteristics of their genome deoxyribonucleic acid (DNA) sequence.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09700 "DNA profiling")
AnnotationAssertion(rdfs:comment goldbook:09700 "DNA profiles are at a lower resolution than a full genome DNA sequence, but this is adequate for forensic purposes, such as in parental testing and criminal investigations."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09700 "Characteristics used include the frequency (or size) of tandem repeats in the genome."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09700 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09700 "current"^^xsd:string)
Declaration(Class(goldbook:09701))
AnnotationAssertion(rdfs:label goldbook:09701 "deoxyribonucleic acid replication")
AnnotationAssertion(dcterms:description goldbook:09701 "Synthesis of new deoxyribonucleic acid (DNA) strands using existing DNA as a template.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09701 "DNA replication")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09701 "replication of DNA")
AnnotationAssertion(mito:isMentionedBy goldbook:09701 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09701 "current"^^xsd:string)
Declaration(Class(goldbook:09702))
AnnotationAssertion(rdfs:label goldbook:09702 "deoxyribonucleic acid sequencing")
AnnotationAssertion(dcterms:description goldbook:09702 "Determination of nucleotide sequence (the deoxyribonucleic acid (DNA) primary structure).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09702 "DNA sequencing")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09702 "sequencing of DNA")
AnnotationAssertion(rdfs:comment goldbook:09702 "Next-generation sequencing refers to non-Sanger-based high-throughput DNA sequencing technologies where millions of DNA strands can be sequenced in parallel."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09702 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09702 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09702 "current"^^xsd:string)
Declaration(Class(goldbook:09703))
AnnotationAssertion(rdfs:label goldbook:09703 "double helix")
AnnotationAssertion(dcterms:description goldbook:09703 "The twisted shape of two complementary strands of deoxyribonucleic acid (DNA).")
AnnotationAssertion(rdfs:comment goldbook:09703 "The complementary chains are held together by hydrogen bonds between pairs of the complementary nucleobases. The helical conformation is promoted by several relatively weak interactions, including hydrophobic (stacking) ones between the bases."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09703 "The double helix is the most frequent DNA structure formed by two complementary DNA strands. It can also be formed by two complementary strands of ribonucleic acid (RNA), one DNA and one RNA strand, as well of any of these with synthetic nucleic acids analogues, such as locked nucleic acid, LNA, or peptide nucleic acid, PNA."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09703 goldbook:09710)
AnnotationAssertion(rdfs:seeAlso goldbook:09703 goldbook:09714)
AnnotationAssertion(mito:isMentionedBy goldbook:09703 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09703 "current"^^xsd:string)
Declaration(Class(goldbook:09704))
AnnotationAssertion(rdfs:label goldbook:09704 "endonuclease")
AnnotationAssertion(dcterms:description goldbook:09704 "Enzyme that cleaves nucleic acids by hydrolysing phosphodiester bonds between nucleotides within a nucleic acid molecule.")
AnnotationAssertion(mito:isMentionedBy goldbook:09704 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09704 "current"^^xsd:string)
Declaration(Class(goldbook:09705))
AnnotationAssertion(rdfs:label goldbook:09705 "exogenous deoxyribonucleic acid")
AnnotationAssertion(dcterms:description goldbook:09705 "Deoxyribonucleic acid (DNA) molecule of foreign origin that has been introduced into an organism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09705 "exogenous DNA")
AnnotationAssertion(mito:isMentionedBy goldbook:09705 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09705 "current"^^xsd:string)
Declaration(Class(goldbook:09706))
AnnotationAssertion(rdfs:label goldbook:09706 "exonuclease")
AnnotationAssertion(dcterms:description goldbook:09706 "Enzyme that cleaves nucleotides from free ends of a linear nucleic acid molecule.")
AnnotationAssertion(mito:isMentionedBy goldbook:09706 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09706 "current"^^xsd:string)
Declaration(Class(goldbook:09707))
AnnotationAssertion(rdfs:label goldbook:09707 "gene expression")
AnnotationAssertion(dcterms:description goldbook:09707 "Process for converting a gene’s coded information into biomolecules present and operating in the cell.")
AnnotationAssertion(mito:isMentionedBy goldbook:09707 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09707 "current"^^xsd:string)
Declaration(Class(goldbook:09708))
AnnotationAssertion(rdfs:label goldbook:09708 "Northern blot")
AnnotationAssertion(dcterms:description goldbook:09708 "Technique involving hybridization of nucleic acids  used to study gene expression at the level of ribonucleic acid (RNA).")
AnnotationAssertion(rdfs:comment goldbook:09708 "The Northern blot approach is preferred to Southern blot and Western blot."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09708 goldbook:09728)
AnnotationAssertion(rdfs:seeAlso goldbook:09708 goldbook:09789)
AnnotationAssertion(rdfs:seeAlso goldbook:09708 goldbook:09707)
AnnotationAssertion(mito:isMentionedBy goldbook:09708 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09708 "current"^^xsd:string)
Declaration(Class(goldbook:09709))
AnnotationAssertion(rdfs:label goldbook:09709 "nucleic acid aptamers")
AnnotationAssertion(dcterms:description goldbook:09709 "Single stranded (ss) oligonucleotides (mainly deoxyribonucleic acid (DNA) or ribonucleic acid (RNA)) originating from in vitro selection, which, starting from random sequence libraries, optimise the nucleic acids for high-affinity binding to a given target.")
AnnotationAssertion(rdfs:comment goldbook:09709 "In vitro selection is an iterative method mainly known as Systematic Evolution of Ligands by EXponential enrichment (SELEX)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09709 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09709 "current"^^xsd:string)
Declaration(Class(goldbook:09710))
AnnotationAssertion(rdfs:label goldbook:09710 "nucleobase")
AnnotationAssertion(dcterms:description goldbook:09710 "Purine or pyrimidine nitrogenous base occurring in deoxyribonucleic acid (DNA) or ribonucleic acid (RNA).")
AnnotationAssertion(rdfs:seeAlso goldbook:09710 goldbook:09717)
AnnotationAssertion(rdfs:seeAlso goldbook:09710 goldbook:09718)
AnnotationAssertion(mito:isMentionedBy goldbook:09710 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09710 "current"^^xsd:string)
Declaration(Class(goldbook:09711))
AnnotationAssertion(rdfs:label goldbook:09711 "nucleobase lesion")
AnnotationAssertion(dcterms:description goldbook:09711 "Product of chemical modification of a nucleobase.")
AnnotationAssertion(rdfs:seeAlso goldbook:09711 goldbook:09693)
AnnotationAssertion(rdfs:seeAlso goldbook:09711 goldbook:09710)
AnnotationAssertion(mito:isMentionedBy goldbook:09711 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09711 "current"^^xsd:string)
Declaration(Class(goldbook:09712))
AnnotationAssertion(rdfs:label goldbook:09712 "nucleotide sequence")
AnnotationAssertion(dcterms:description goldbook:09712 "Order of nucleotides in a deoxyribonucleic acid (DNA) or ribonucleic acid (RNA) molecule.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09712 "base sequence")
AnnotationAssertion(mito:isMentionedBy goldbook:09712 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09712 "current"^^xsd:string)
Declaration(Class(goldbook:09713))
AnnotationAssertion(rdfs:label goldbook:09713 "open reading frame")
AnnotationAssertion(dcterms:description goldbook:09713 "Sequence of deoxyribonucleic acid (DNA) or ribonucleic acid (RNA) nucleotides, located between the start-code sequence (initiation codon) and the stop-code sequence (termination codon), which is transcribed and translated to generate a protein.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09713 "ORF")
AnnotationAssertion(mito:isMentionedBy goldbook:09713 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09713 "current"^^xsd:string)
Declaration(Class(goldbook:09714))
AnnotationAssertion(rdfs:label goldbook:09714 "peptide nucleic acid")
AnnotationAssertion(dcterms:description goldbook:09714 "Synthetic deoxyribonucleic acid (DNA) mimic, which contains 2-aminoethylglycine linkages instead of the negatively charged phosphodiesteric backbone of oligonucleotides.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09714 "PNA")
AnnotationAssertion(rdfs:comment goldbook:09714 "The PNA probes are particularly convenient for the detection of single-base mismatches (point mutations, SNPs), because the stability of DNA-PNA duplexes is strongly influenced by a single-base mismatch."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09714 goldbook:09699)
AnnotationAssertion(mito:isMentionedBy goldbook:09714 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09714 "current"^^xsd:string)
Declaration(Class(goldbook:09715))
AnnotationAssertion(rdfs:label goldbook:09715 "polymerase")
AnnotationAssertion(dcterms:description goldbook:09715 "Enzyme that catalyses the synthesis of nucleic acids on pre-existing nucleic acid templates.")
AnnotationAssertion(mito:isMentionedBy goldbook:09715 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09715 "current"^^xsd:string)
Declaration(Class(goldbook:09716))
AnnotationAssertion(rdfs:label goldbook:09716 "primer")
AnnotationAssertion(dcterms:description goldbook:09716 "Short pre-existing polynucleotide chain attached to a complementary stretch in template deoxyribonucleic acid (DNA) to which new deoxyribonucleotides can be added by DNA polymerase.")
AnnotationAssertion(rdfs:seeAlso goldbook:09716 goldbook:09715)
AnnotationAssertion(mito:isMentionedBy goldbook:09716 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09716 "current"^^xsd:string)
Declaration(Class(goldbook:09717))
AnnotationAssertion(rdfs:label goldbook:09717 "purine")
AnnotationAssertion(dcterms:description goldbook:09717 "Nitrogen-containing, double-ring, basic compound that occurs in nucleic acids.")
AnnotationAssertion(rdfs:seeAlso goldbook:09717 goldbook:09710)
AnnotationAssertion(mito:isMentionedBy goldbook:09717 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09717 "current"^^xsd:string)
Declaration(Class(goldbook:09718))
AnnotationAssertion(rdfs:label goldbook:09718 "pyrimidine")
AnnotationAssertion(dcterms:description goldbook:09718 "Nitrogen-containing, single-ring, basic compound that occurs in nucleic acids.")
AnnotationAssertion(rdfs:seeAlso goldbook:09718 goldbook:09710)
AnnotationAssertion(mito:isMentionedBy goldbook:09718 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09718 "current"^^xsd:string)
Declaration(Class(goldbook:09719))
AnnotationAssertion(rdfs:label goldbook:09719 "quantitative polymerase chain reaction")
AnnotationAssertion(dcterms:description goldbook:09719 "Polymerase chain reaction to quantify target nucleotide sequences of interest.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09719 "qPCR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09719 "quantitative PCR")
AnnotationAssertion(mito:isMentionedBy goldbook:09719 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09719 "current"^^xsd:string)
Declaration(Class(goldbook:09720))
AnnotationAssertion(rdfs:label goldbook:09720 "real-time polymerase chain reaction")
AnnotationAssertion(dcterms:description goldbook:09720 "Polymerase chain reaction where data are collected and monitored in real-time as the reaction proceeds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09720 "real-time PCR")
AnnotationAssertion(rdfs:comment goldbook:09720 "Digital PCR is a new alternate method to conventional real-time PCR and quantitative PCR for absolute quantification and rare allele detection. Digital PCR works by partitioning a sample of deoxyribonucleic acid (DNA) or complementary DNA into many individual, parallel PCR reactions; some of these reactions contain the target molecule (complementary DNA, positive) while others do not (negative). A single molecule can be amplified a million-fold or more."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09720 goldbook:09719)
AnnotationAssertion(mito:isMentionedBy goldbook:09720 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09720 "current"^^xsd:string)
Declaration(Class(goldbook:09721))
AnnotationAssertion(rdfs:label goldbook:09721 "recombinant deoxyribonucleic acid")
AnnotationAssertion(dcterms:description goldbook:09721 "Deoxyribonucleic acid (DNA) molecules joined together using recombinant deoxyribonucleic acid (DNA) technology.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09721 "recombinant DNA")
AnnotationAssertion(mito:isMentionedBy goldbook:09721 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09721 "current"^^xsd:string)
Declaration(Class(goldbook:09722))
AnnotationAssertion(rdfs:label goldbook:09722 "recombination")
AnnotationAssertion(dcterms:description goldbook:09722 "Process by which genetic material is broken and joined to other genetic material, which can lead to a rearrangement of genetic sequences.")
AnnotationAssertion(mito:isMentionedBy goldbook:09722 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09722 "current"^^xsd:string)
Declaration(Class(goldbook:09723))
AnnotationAssertion(rdfs:label goldbook:09723 "restriction fragment length polymorphism")
AnnotationAssertion(dcterms:description goldbook:09723 "Variation between individuals in deoxyribonucleic acid (DNA) fragment sizes cut by specific restriction enzymes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09723 "RFLP")
AnnotationAssertion(mito:isMentionedBy goldbook:09723 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09723 "current"^^xsd:string)
Declaration(Class(goldbook:09724))
AnnotationAssertion(rdfs:label goldbook:09724 "reverse transcriptase")
AnnotationAssertion(dcterms:description goldbook:09724 "Enzyme used to form a complementary deoxyribonucleic acid sequence (cDNA) from a ribonucleic acid (RNA) template.")
AnnotationAssertion(mito:isMentionedBy goldbook:09724 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09724 "current"^^xsd:string)
Declaration(Class(goldbook:09725))
AnnotationAssertion(rdfs:label goldbook:09725 "Sanger sequencing")
AnnotationAssertion(dcterms:description goldbook:09725 "Method for determining a nucleotide sequence of deoxyribonucleic acid (DNA) based on incorporating chain-terminating dideoxynucleotides.")
AnnotationAssertion(rdfs:comment goldbook:09725 "The method is named after Frederick Sanger (1918–2013, awarded the Nobel Prize in 1958 and 1980)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09725 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09725 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09725 "current"^^xsd:string)
Declaration(Class(goldbook:09726))
AnnotationAssertion(rdfs:label goldbook:09726 "shotgun method")
AnnotationAssertion(dcterms:description goldbook:09726 "Method used for determining the order of bases in long DNA using sequencing of deoxyribonucleic acid (DNA) broken up randomly into numerous small segments.")
AnnotationAssertion(mito:isMentionedBy goldbook:09726 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09726 "current"^^xsd:string)
Declaration(Class(goldbook:09727))
AnnotationAssertion(rdfs:label goldbook:09727 "single nucleotide polymorphism")
AnnotationAssertion(dcterms:description goldbook:09727 "Variant of nucleotide sequence of deoxyribonucleic acid (DNA) in which the purine or pyrimidine base of a single nucleotide is replaced by another such base.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09727 "SNP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09727 "point mutation")
AnnotationAssertion(rdfs:comment goldbook:09727 "SNP is the most common type of change in DNA."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09727 "SNPs occur normally throughout a human DNA once in every 300 nucleotides on average, which means there are roughly 10 million SNPs in any typical human genome. They can act as biological (diagnostic) markers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09727 goldbook:09712)
AnnotationAssertion(rdfs:seeAlso goldbook:09727 goldbook:09717)
AnnotationAssertion(rdfs:seeAlso goldbook:09727 goldbook:09718)
AnnotationAssertion(mito:isMentionedBy goldbook:09727 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09727 "current"^^xsd:string)
Declaration(Class(goldbook:09728))
AnnotationAssertion(rdfs:label goldbook:09728 "Southern blot")
AnnotationAssertion(dcterms:description goldbook:09728 "Technique based on deoxyribonucleic acid (DNA) hybridization used for the detection of a DNA fragment of specific nucleotide sequence.")
AnnotationAssertion(rdfs:seeAlso goldbook:09728 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09728 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09728 "current"^^xsd:string)
Declaration(Class(goldbook:09729))
AnnotationAssertion(rdfs:label goldbook:09729 "strand break")
AnnotationAssertion(dcterms:description goldbook:09729 "Interruption of the sugar-phosphate backbone of a polynucleotide chain.")
AnnotationAssertion(mito:isMentionedBy goldbook:09729 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09729 "current"^^xsd:string)
Declaration(Class(goldbook:09730))
AnnotationAssertion(rdfs:label goldbook:09730 "tandem repeat sequence")
AnnotationAssertion(dcterms:description goldbook:09730 "Multiple consecutive copies of the same nucleotide sequence on a chromosome.")
AnnotationAssertion(rdfs:comment goldbook:09730 "Tandem repeat sequences can be used as markers in physical mapping e.g. by DNA profiling."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09730 goldbook:09700)
AnnotationAssertion(rdfs:seeAlso goldbook:09730 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09730 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09730 "current"^^xsd:string)
Declaration(Class(goldbook:09731))
AnnotationAssertion(rdfs:label goldbook:09731 "telomerase")
AnnotationAssertion(dcterms:description goldbook:09731 "Enzyme that directs the replication of telomeres.")
AnnotationAssertion(rdfs:seeAlso goldbook:09731 goldbook:09732)
AnnotationAssertion(mito:isMentionedBy goldbook:09731 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09731 "current"^^xsd:string)
Declaration(Class(goldbook:09732))
AnnotationAssertion(rdfs:label goldbook:09732 "telomere")
AnnotationAssertion(dcterms:description goldbook:09732 "Repetitive nucleotide sequences present at the ends of a chromosome that protect the chromosome from deterioration.")
AnnotationAssertion(rdfs:comment goldbook:09732 "In polymer sciences, an oligomer obtained by telomerization is often termed a telomer."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09732 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09732 "current"^^xsd:string)
Declaration(Class(goldbook:09733))
AnnotationAssertion(rdfs:label goldbook:09733 "yeast artificial chromosome")
AnnotationAssertion(dcterms:description goldbook:09733 "Vector used to clone large deoxyribonucleic acid (DNA) fragments.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09733 "YAC")
AnnotationAssertion(rdfs:seeAlso goldbook:09733 goldbook:09690)
AnnotationAssertion(mito:isMentionedBy goldbook:09733 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09733 "current"^^xsd:string)
Declaration(Class(goldbook:09734))
AnnotationAssertion(rdfs:label goldbook:09734 "alternative splicing")
AnnotationAssertion(dcterms:description goldbook:09734 "Process occurring during gene expression that allows the generation of multiple protein molecules from one gene. It generally involves the processing of messenger ribonucleic acid (mRNA) via elimination of introns.")
AnnotationAssertion(mito:isMentionedBy goldbook:09734 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09734 "current"^^xsd:string)
Declaration(Class(goldbook:09735))
AnnotationAssertion(rdfs:label goldbook:09735 "bottom-up proteomics")
AnnotationAssertion(dcterms:description goldbook:09735 "Approach to identify proteins and characterise their amino acid sequences or post-translational modifications by sequential combination of proteolysis (enzymatic proteolysis and chemical proteolysis) prior to mass spectrometric analysis of the resulting proteolytic peptides.")
AnnotationAssertion(rdfs:comment goldbook:09735 "In shotgun proteomics, the proteins in a mixture are digested, usually by a specific enzyme, and the resulting peptides are separated by liquid chromatography and identified by tandem mass spectrometry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09735 goldbook:09776)
AnnotationAssertion(rdfs:seeAlso goldbook:09735 goldbook:09726)
AnnotationAssertion(rdfs:seeAlso goldbook:09735 goldbook:09786)
AnnotationAssertion(mito:isMentionedBy goldbook:09735 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09735 "current"^^xsd:string)
Declaration(Class(goldbook:09736))
AnnotationAssertion(rdfs:label goldbook:09736 "C-terminal analysis")
AnnotationAssertion(dcterms:description goldbook:09736 "Chemical method for C-terminal sequencing of proteins and peptides starting at their C-terminus.")
AnnotationAssertion(rdfs:seeAlso goldbook:09736 goldbook:09737)
AnnotationAssertion(mito:isMentionedBy goldbook:09736 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09736 "current"^^xsd:string)
Declaration(Class(goldbook:09737))
AnnotationAssertion(rdfs:label goldbook:09737 "C-terminus")
AnnotationAssertion(dcterms:description goldbook:09737 "End of an amino acid chain (protein or polypeptide), terminated by a carboxylic group.")
AnnotationAssertion(mito:isMentionedBy goldbook:09737 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09737 "current"^^xsd:string)
Declaration(Class(goldbook:09738))
AnnotationAssertion(rdfs:label goldbook:09738 "database searching")
AnnotationAssertion(dcterms:description goldbook:09738 "Bioinformatics analysis of proteomic mass spectrometric data used in order to identify a protein or its post-translational modification. It results in a list of candidates presented mostly in order of the decreasing statistical significance of the hit.")
AnnotationAssertion(rdfs:seeAlso goldbook:09738 goldbook:09654)
AnnotationAssertion(mito:isMentionedBy goldbook:09738 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09738 "current"^^xsd:string)
Declaration(Class(goldbook:09739))
AnnotationAssertion(rdfs:label goldbook:09739 "difference gel electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09739 "Measurement method of two-dimensional gel electrophoresis used to study protein expression regulation by the differential staining of multiple gels representing different states of a proteome, preferably with fluorescent dyes (e.g. \\(\\ce{Cy{3}}\\), \\(\\ce{Cy{5}}\\), \\(\\ce{Cy{2}}\\)).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09739 "DIGE")
AnnotationAssertion(rdfs:comment goldbook:09739 "The resulting stained gels are analysed using 2D image analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09739 goldbook:09788)
AnnotationAssertion(mito:isMentionedBy goldbook:09739 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09739 "current"^^xsd:string)
Declaration(Class(goldbook:09740))
AnnotationAssertion(rdfs:label goldbook:09740 "disulfide bond cleavage")
AnnotationAssertion(dcterms:description goldbook:09740 "Chemical reduction of protein disulfide bonds.")
AnnotationAssertion(rdfs:comment goldbook:09740 "Reductants, such as tributylphosphine (TBP), 2-sulfanylethan-1-ol (BME), or dithiothreitol (DTT) are used."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09740 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09740 "current"^^xsd:string)
Declaration(Class(goldbook:09741))
AnnotationAssertion(rdfs:label goldbook:09741 "Edman degradation")
AnnotationAssertion(dcterms:description goldbook:09741 "Method of N-terminal analysis in which the N-terminal amino acid residue is labelled and cleaved from the peptide without affecting other peptide bonds in the peptide chain.")
AnnotationAssertion(rdfs:comment goldbook:09741 "The method is named after Pehr Victor Edman (1916–1977)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09741 goldbook:09753)
AnnotationAssertion(mito:isMentionedBy goldbook:09741 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09741 "current"^^xsd:string)
Declaration(Class(goldbook:09742))
AnnotationAssertion(rdfs:label goldbook:09742 "electron-transfer dissociation")
AnnotationAssertion(dcterms:description goldbook:09742 "Ion fragmentation technique in mass spectrometry-driven proteomics based on the transfer of low energy electrons to the molecules selected for fragmentation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09742 "ETD")
AnnotationAssertion(rdfs:comment goldbook:09742 "ETD is particularly effective for analysis of post-translational modification."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09742 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09742 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09742 "current"^^xsd:string)
Declaration(Class(goldbook:09743))
AnnotationAssertion(rdfs:label goldbook:09743 "electron-transfer/higher-energy collision dissociation")
AnnotationAssertion(dcterms:description goldbook:09743 "Ion fragmentation technique in mass spectrometry-driven proteomics that is a combination of electron-transfer dissociation (ETD) and higher-energy collision dissociation (HCD) in Kingdon trap instruments (Orbitrap™).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09743 "EthcD")
AnnotationAssertion(rdfs:comment goldbook:09743 "The dual fragmentation allows generation of rich MS/MS spectra for peptide sequencing and post-translational modification (PTM) analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09743 goldbook:09742)
AnnotationAssertion(rdfs:seeAlso goldbook:09743 goldbook:09748)
AnnotationAssertion(mito:isMentionedBy goldbook:09743 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09743 "current"^^xsd:string)
Declaration(Class(goldbook:09744))
AnnotationAssertion(rdfs:label goldbook:09744 "electrospray ionisation")
AnnotationAssertion(dcterms:description goldbook:09744 "Soft ionisation technique in mass spectrometry-driven proteomics.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09744 "ESI")
AnnotationAssertion(rdfs:comment goldbook:09744 "Electrospray ionisation is optimal for ionising liquid eluates from separation methods, as well as for the direct introduction of liquid samples to fragmentation in a mass spectrometer. Ionisation is made by positive or negative mode, depending on the ability of the molecules to form cations or anions. During the ionisation process, a biomacromolecule obtains a number of charges roughly proportional to its relative molecular mass. Also, non-covalent protein complexes may be ionised with ESI."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09744 goldbook:09634)
AnnotationAssertion(rdfs:seeAlso goldbook:09744 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09744 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09744 "current"^^xsd:string)
Declaration(Class(goldbook:09745))
AnnotationAssertion(rdfs:label goldbook:09745 "expression proteomics")
AnnotationAssertion(dcterms:description goldbook:09745 "Field of study in proteomics that deals with the determination of changes in protein expression and regulation in response to different stimuli, internal or external. It also includes the analysis of post-translational modifications (e.g. phosphorylation, glycosylation, etc.), their identification, and their localisation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09745 "differential proteomics")
AnnotationAssertion(mito:isMentionedBy goldbook:09745 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09745 "current"^^xsd:string)
Declaration(Class(goldbook:09746))
AnnotationAssertion(rdfs:label goldbook:09746 "functional proteomics")
AnnotationAssertion(dcterms:description goldbook:09746 "Field of study in proteomics studying protein interactions on different levels: protein-protein interactions (interactomics), the formation of protein complexes, and the interaction of proteins with other biomolecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:09746 goldbook:09633)
AnnotationAssertion(rdfs:seeAlso goldbook:09746 goldbook:09872)
AnnotationAssertion(rdfs:seeAlso goldbook:09746 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09746 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09746 "current"^^xsd:string)
Declaration(Class(goldbook:09747))
AnnotationAssertion(rdfs:label goldbook:09747 "gel electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09747 "Separation technique used to separate or fractionate proteins and larger peptides according to their relative molecular mass using an electric field in polyacrylamide gel (PAGE).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09747 "PAGE")
AnnotationAssertion(rdfs:comment goldbook:09747 "1D PAGE has two basic modes: a denaturing (or SDS) PAGE to estimate relative molecular masses and a native PAGE to separate proteins as their native structures."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09747 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09747 "current"^^xsd:string)
Declaration(Class(goldbook:09748))
AnnotationAssertion(rdfs:label goldbook:09748 "higher-energy collision dissociation")
AnnotationAssertion(dcterms:description goldbook:09748 "Ion fragmentation technique in mass spectrometry-driven proteomics used mostly in Kingdon trap (Orbitrap™) instruments. It does not have low mass cut-off of collision-induced dissociation (CID) and therefore is used for the tandem mass tag of stable isotope labels.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09748 "HCD")
AnnotationAssertion(rdfs:seeAlso goldbook:09748 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09748 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09748 "current"^^xsd:string)
Declaration(Class(goldbook:09749))
AnnotationAssertion(rdfs:label goldbook:09749 "isoelectric focusing")
AnnotationAssertion(dcterms:description goldbook:09749 "Separation technique used to separate or fractionate proteins and peptides in a gel (or similar type of media) according to their isoelectric point.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09749 "IEF")
AnnotationAssertion(rdfs:comment goldbook:09749 "IEF is typically the first dimension of two-dimensional gel electrophoresis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09749 goldbook:09747)
AnnotationAssertion(mito:isMentionedBy goldbook:09749 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09749 "current"^^xsd:string)
Declaration(Class(goldbook:09750))
AnnotationAssertion(rdfs:label goldbook:09750 "mass fingerprinting")
AnnotationAssertion(dcterms:description goldbook:09750 "Protein analysis where an unknown protein is chemically or enzymatically cleaved into peptide fragments whose masses are determined by mass spectrometry. The peptide masses are compared to peptide masses calculated for known proteins in a database and analysed statistically to determine the best match.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09750 "mass mapping")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09750 "peptide mass fingerprinting")
AnnotationAssertion(mito:isMentionedBy goldbook:09750 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09750 "current"^^xsd:string)
Declaration(Class(goldbook:09751))
AnnotationAssertion(rdfs:label goldbook:09751 "MS/MS data based identification")
AnnotationAssertion(dcterms:description goldbook:09751 "Mass spectrometric method used for protein/peptide identification based on protein sequencing.")
AnnotationAssertion(rdfs:comment goldbook:09751 "Using peptide ion fragments, the peptide sequence is read and a list of hit candidates is obtained in combination with database searching."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09751 goldbook:09738)
AnnotationAssertion(rdfs:seeAlso goldbook:09751 goldbook:11547)
AnnotationAssertion(mito:isMentionedBy goldbook:09751 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09751 "current"^^xsd:string)
Declaration(Class(goldbook:09752))
AnnotationAssertion(rdfs:label goldbook:09752 "multidimensional protein identification technology")
AnnotationAssertion(dcterms:description goldbook:09752 "Non-gel step-wise multidimensional technique for separating and identifying individual components of complex protein and peptide mixtures. It combines fractionation of proteolytic peptides in steps on a strong cation exchanger (SAX) using ion exchange chromatography (IEC); each step uses higher elution force. Then, each fraction is separated on reversed phase liquid chromatography and analysed using mass spectrometry.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09752 "MudPIT")
AnnotationAssertion(mito:isMentionedBy goldbook:09752 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09752 "current"^^xsd:string)
Declaration(Class(goldbook:09753))
AnnotationAssertion(rdfs:label goldbook:09753 "N-terminal analysis")
AnnotationAssertion(dcterms:description goldbook:09753 "Chemical method for N-terminal sequencing of proteins and peptides starting at their N-terminus.")
AnnotationAssertion(rdfs:seeAlso goldbook:09753 goldbook:09741)
AnnotationAssertion(rdfs:seeAlso goldbook:09753 goldbook:09754)
AnnotationAssertion(mito:isMentionedBy goldbook:09753 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09753 "current"^^xsd:string)
Declaration(Class(goldbook:09754))
AnnotationAssertion(rdfs:label goldbook:09754 "N-terminus")
AnnotationAssertion(dcterms:description goldbook:09754 "The end of an amino acid chain (protein or polypeptide), terminating in a free primary amine group.")
AnnotationAssertion(mito:isMentionedBy goldbook:09754 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09754 "current"^^xsd:string)
Declaration(Class(goldbook:09755))
AnnotationAssertion(rdfs:label goldbook:09755 "off-gel isoelectric focusing")
AnnotationAssertion(dcterms:description goldbook:09755 "Separation technique used to fractionate proteins and peptides into discrete liquid fractions according to their isoelectric point.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09755 "OFFGEL™")
AnnotationAssertion(rdfs:seeAlso goldbook:09755 goldbook:09749)
AnnotationAssertion(mito:isMentionedBy goldbook:09755 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09755 "current"^^xsd:string)
Declaration(Class(goldbook:09756))
AnnotationAssertion(rdfs:label goldbook:09756 "off peptide product ions")
AnnotationAssertion(dcterms:description goldbook:09756 "Protein/peptide sequencing approach using overlapping complementary information on a sequence acquired using proteolysis in bottom-up proteomic analysis by at least two different proteolytic approaches.")
AnnotationAssertion(rdfs:seeAlso goldbook:09756 goldbook:09735)
AnnotationAssertion(rdfs:seeAlso goldbook:09756 goldbook:11547)
AnnotationAssertion(mito:isMentionedBy goldbook:09756 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09756 "current"^^xsd:string)
Declaration(Class(goldbook:09757))
AnnotationAssertion(rdfs:label goldbook:09757 "peptide de novo sequencing")
AnnotationAssertion(dcterms:description goldbook:09757 "Analytical process that derives an amino acid sequence of a peptide from its tandem mass spectrum without the assistance of a sequence database.")
AnnotationAssertion(rdfs:comment goldbook:09757 "It is defined in contrast to protein/peptide identification using a database search. An advantage of de novo sequencing is its applicability to both known and novel peptides from organisms with unsequenced genome."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09757 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09757 "current"^^xsd:string)
Declaration(Class(goldbook:09758))
AnnotationAssertion(rdfs:label goldbook:09758 "peptide fragment ion")
AnnotationAssertion(dcterms:description goldbook:09758 "Product ion which originates in a peptide precursor ion fragmentation process.")
AnnotationAssertion(rdfs:comment goldbook:09758 "Peptide fragment ions are generated in pairs according to the kind of mechanism that dissociates the chemical bonds around the peptide bond."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09758 goldbook:09760)
AnnotationAssertion(mito:isMentionedBy goldbook:09758 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09758 "current"^^xsd:string)
Declaration(Class(goldbook:09759))
AnnotationAssertion(rdfs:label goldbook:09759 "peptide fragmentation technique")
AnnotationAssertion(dcterms:description goldbook:09759 "Mass spectrometric technique that serves to generate peptide fragment ions through the fragmentation of peptide precursor ions via different physicochemical processes in an ion source.")
AnnotationAssertion(rdfs:comment goldbook:09759 "This approach based on the top-down proteomics is an alternative to bottom-up proteomics. The main advantages include the potential for \\(\\pu{100\\%}\\) sequence coverage of the protein and improved detection of post-translational modifications."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09759 goldbook:09735)
AnnotationAssertion(rdfs:seeAlso goldbook:09759 goldbook:09758)
AnnotationAssertion(rdfs:seeAlso goldbook:09759 goldbook:09760)
AnnotationAssertion(rdfs:seeAlso goldbook:09759 goldbook:09786)
AnnotationAssertion(mito:isMentionedBy goldbook:09759 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09759 "current"^^xsd:string)
Declaration(Class(goldbook:09760))
AnnotationAssertion(rdfs:label goldbook:09760 "peptide precursor ion")
AnnotationAssertion(dcterms:description goldbook:09760 "Peptide ion generated during the ionisation of peptides in an ion source or during tandem mass spectrometry of an intact protein in top-down proteomic analysis, selected for further analysis by means of tandem mass spectrometry.")
AnnotationAssertion(rdfs:comment goldbook:09760 "Once generated, a peptide fragment ion may become a precursor ion for tandem mass spectrometry of higher orders (\\({\\rm{MS}}^{n}\\), \\(n = 3\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09760 goldbook:09786)
AnnotationAssertion(mito:isMentionedBy goldbook:09760 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09760 "current"^^xsd:string)
Declaration(Class(goldbook:09761))
AnnotationAssertion(rdfs:label goldbook:09761 "peptidomics")
AnnotationAssertion(dcterms:description goldbook:09761 "Study of the set of peptides in an organism, its peptidome.")
AnnotationAssertion(rdfs:comment goldbook:09761 "It uses similar approaches and methods as proteomics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09761 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09761 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09761 "current"^^xsd:string)
Declaration(Class(goldbook:09762))
AnnotationAssertion(rdfs:label goldbook:09762 "protein complex")
AnnotationAssertion(dcterms:description goldbook:09762 "Ensemble of two or more different associated proteins, each with a specific function, linked by non-covalent protein-protein interactions.")
AnnotationAssertion(rdfs:comment goldbook:09762 "Protein complexes are required for most biological processes. Together they form molecular machines that perform biological functions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09762 "Proteins with quaternary structure are not considered as protein complexes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09762 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09762 "current"^^xsd:string)
Declaration(Class(goldbook:09763))
AnnotationAssertion(rdfs:label goldbook:09763 "protein complex purification")
AnnotationAssertion(dcterms:description goldbook:09763 "Set of methods serving to purify the intact protein complex for further analysis.")
AnnotationAssertion(rdfs:comment goldbook:09763 "The methods used may employ single step affinity purification or tandem affinity purification (two affinity purification steps). These approaches include the direct application of an epitope on a bait protein for immunopurification or the genetic insertion of an affinity tag to bait protein, both used to co-purify the prey components of the protein complex."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09763 goldbook:09762)
AnnotationAssertion(mito:isMentionedBy goldbook:09763 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09763 "current"^^xsd:string)
Declaration(Class(goldbook:09764))
AnnotationAssertion(rdfs:label goldbook:09764 "protein database")
AnnotationAssertion(dcterms:description goldbook:09764 "Collection of protein sequences from several sources, including translations from annotated genetic coding regions, as well as original protein and peptide sequences.")
AnnotationAssertion(rdfs:comment goldbook:09764 "A protein database is fundamental for the determination of protein structure and function via bioinformatics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09764 goldbook:11547)
AnnotationAssertion(mito:isMentionedBy goldbook:09764 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09764 "current"^^xsd:string)
Declaration(Class(goldbook:09765))
AnnotationAssertion(rdfs:label goldbook:09765 "protein folding")
AnnotationAssertion(dcterms:description goldbook:09765 "Physicochemical process by which a polypeptide folds into its characteristic and functional three-dimensional structure from a random coil.")
AnnotationAssertion(mito:isMentionedBy goldbook:09765 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09765 "current"^^xsd:string)
Declaration(Class(goldbook:09766))
AnnotationAssertion(rdfs:label goldbook:09766 "protein fractionation")
AnnotationAssertion(dcterms:description goldbook:09766 "Methodical approach to simplify a complex mixture of proteomic sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09766 "protein separation")
AnnotationAssertion(rdfs:comment goldbook:09766 "Target compounds can either be separated into individual protein/peptides or fractionated into groups with similar physicochemical properties (polarity, charge, relative molecular mass, etc.). Different analytical separation methods are deployed to achieve this effect: liquid chromatography, gel electrophoresis, isoelectric focusing, affinity chromatography, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09766 goldbook:09747)
AnnotationAssertion(rdfs:seeAlso goldbook:09766 goldbook:09749)
AnnotationAssertion(mito:isMentionedBy goldbook:09766 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09766 "current"^^xsd:string)
Declaration(Class(goldbook:09767))
AnnotationAssertion(rdfs:label goldbook:09767 "protein fragmentation")
AnnotationAssertion(dcterms:description goldbook:09767 "Process which happens during tandem mass spectrometry of intact proteins.")
AnnotationAssertion(rdfs:comment goldbook:09767 "This process is used in top-down proteomics. It generates specific peptide fragment ions from a selected protein precursor ion."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09767 goldbook:09758)
AnnotationAssertion(rdfs:seeAlso goldbook:09767 goldbook:09786)
AnnotationAssertion(mito:isMentionedBy goldbook:09767 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09767 "current"^^xsd:string)
Declaration(Class(goldbook:09768))
AnnotationAssertion(rdfs:label goldbook:09768 "protein identification")
AnnotationAssertion(dcterms:description goldbook:09768 "Analytical approach leading to the identity of a protein.")
AnnotationAssertion(rdfs:comment goldbook:09768 "The identity of the protein is given in respect to the proteoform by its primary structure, post-translational modification, or tertiary structure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09768 goldbook:09774)
AnnotationAssertion(rdfs:seeAlso goldbook:09768 goldbook:09785)
AnnotationAssertion(mito:isMentionedBy goldbook:09768 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09768 "current"^^xsd:string)
Declaration(Class(goldbook:09769))
AnnotationAssertion(rdfs:label goldbook:09769 "protein machine")
AnnotationAssertion(dcterms:description goldbook:09769 "Supramolecular interacting system, such as a metabolic circuit, intracellular signal transduction, or cell-to-cell communication.")
AnnotationAssertion(rdfs:comment goldbook:09769 "These systems are operated under process control strategies involving integrated feedback control. The input and output of the circuits or modules are coordinated to assure the normal or adaptive function of the cell or organism."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09769 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09769 "current"^^xsd:string)
Declaration(Class(goldbook:09770))
AnnotationAssertion(rdfs:label goldbook:09770 "protein purification")
AnnotationAssertion(dcterms:description goldbook:09770 "Series of processes conducted to isolate either the whole proteome or a subset from a biological sample.")
AnnotationAssertion(rdfs:comment goldbook:09770 "Protein purification involves many different methods, such as chromatography, immunopurification, immunoprecipitation, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09770 goldbook:09675)
AnnotationAssertion(mito:isMentionedBy goldbook:09770 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09770 "current"^^xsd:string)
Declaration(Class(goldbook:09771))
AnnotationAssertion(rdfs:label goldbook:09771 "protein quantification")
AnnotationAssertion(dcterms:description goldbook:09771 "Analytical methods and related techniques to measure the protein content.")
AnnotationAssertion(rdfs:comment goldbook:09771 "Protein quantification can be further divided into relative quantification and absolute quantification. Basic analytical methods used in proteomics to quantify protein content are immunoanalysis (see Western blotting), mass spectrometry or densitometry of differential staining. Especially mass spectrometry offers many techniques based either on stable isotope labelling or label-free approaches."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09771 "Absolute quantification of proteins (AQUA) is performed via measurements on constituent proteolytic peptides using chemically synthesised isotope-labelled peptides as surrogate internal standards for mass spectrometry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09771 goldbook:09789)
AnnotationAssertion(mito:isMentionedBy goldbook:09771 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09771 "current"^^xsd:string)
Declaration(Class(goldbook:09772))
AnnotationAssertion(rdfs:label goldbook:09772 "protein sequencer")
AnnotationAssertion(dcterms:description goldbook:09772 "Equipment designed for the automatic determination of amino acid sequences of peptides using a method of N-terminal analysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:09772 goldbook:09741)
AnnotationAssertion(rdfs:seeAlso goldbook:09772 goldbook:09753)
AnnotationAssertion(mito:isMentionedBy goldbook:09772 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09772 "current"^^xsd:string)
Declaration(Class(goldbook:09773))
AnnotationAssertion(rdfs:label goldbook:09773 "protein staining")
AnnotationAssertion(dcterms:description goldbook:09773 "Technique used to visualise proteins separated on electrophoretic slab gels.")
AnnotationAssertion(rdfs:comment goldbook:09773 "Typically, three types of staining are commonly used: silver staining, which is highly sensitive and non-quantitative; Coommassie Brilliant Blue staining, which is less sensitive than silver staining and quantitative; and fluorescent dye staining, which is highly sensitive and quantitative."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09773 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09773 "current"^^xsd:string)
Declaration(Class(goldbook:09774))
AnnotationAssertion(rdfs:label goldbook:09774 "proteoform")
AnnotationAssertion(dcterms:description goldbook:09774 "All of the different molecular forms in which the protein product of a single gene can be found, including changes due to genetic variations, alternatively spliced ribonucleic acid (RNA) transcripts, and post-translational modifications.")
AnnotationAssertion(mito:isMentionedBy goldbook:09774 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09774 "current"^^xsd:string)
Declaration(Class(goldbook:09775))
AnnotationAssertion(rdfs:label goldbook:09775 "proteogenomics")
AnnotationAssertion(dcterms:description goldbook:09775 "Field of biological research in-between proteomics and genomics using proteomic information (mostly derived from mass spectrometry) to improve gene annotations.")
AnnotationAssertion(rdfs:seeAlso goldbook:09775 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09775 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09775 "current"^^xsd:string)
Declaration(Class(goldbook:09776))
AnnotationAssertion(rdfs:label goldbook:09776 "proteolysis")
AnnotationAssertion(dcterms:description goldbook:09776 "Protein cleavage to generate proteolytic peptides for bottom-up proteomic analysis, either enzymatic or chemical.")
AnnotationAssertion(rdfs:comment goldbook:09776 "Both enzymatic and chemical proteolysis may be sequence-specific or unspecific. Proteolysis is specific where cleavage appears at a few specific sequence motives (e.g. proteolysis by trypsin), or unspecific, being connected to wide range of sequence motives (e.g. proteolysis by chymotrypsin)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09776 goldbook:09735)
AnnotationAssertion(mito:isMentionedBy goldbook:09776 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09776 "current"^^xsd:string)
Declaration(Class(goldbook:09777))
AnnotationAssertion(rdfs:label goldbook:09777 "proteolytic digestion")
AnnotationAssertion(dcterms:description goldbook:09777 "Exposure of a sample to proteolytic reactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09777 goldbook:09776)
AnnotationAssertion(mito:isMentionedBy goldbook:09777 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09777 "current"^^xsd:string)
Declaration(Class(goldbook:09778))
AnnotationAssertion(rdfs:label goldbook:09778 "proteolytic enzyme")
AnnotationAssertion(dcterms:description goldbook:09778 "Group of enzymes that cleave the polypeptide into shorter oligopeptides (peptides) and amino acids.")
AnnotationAssertion(mito:isMentionedBy goldbook:09778 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09778 "current"^^xsd:string)
Declaration(Class(goldbook:09779))
AnnotationAssertion(rdfs:label goldbook:09779 "proteolytic peptide")
AnnotationAssertion(dcterms:description goldbook:09779 "Peptide generated via proteolysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:09779 goldbook:09776)
AnnotationAssertion(mito:isMentionedBy goldbook:09779 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09779 "current"^^xsd:string)
Declaration(Class(goldbook:09780))
AnnotationAssertion(rdfs:label goldbook:09780 "proteomics")
AnnotationAssertion(dcterms:description goldbook:09780 "Complex and comprehensive study of proteomes, particularly proteins, and the way they are expressed, modified, involved in metabolism, as well as of their interactions.")
AnnotationAssertion(mito:isMentionedBy goldbook:09780 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09780 "current"^^xsd:string)
Declaration(Class(goldbook:09781))
AnnotationAssertion(rdfs:label goldbook:09781 "relative quantification")
AnnotationAssertion(dcterms:description goldbook:09781 "Type of protein/peptide quantification, where the relative amounts of one protein in different samples is determined, i.e. the ratio of the content of a protein/peptide in sample 1 to sample 2.")
AnnotationAssertion(mito:isMentionedBy goldbook:09781 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09781 "current"^^xsd:string)
Declaration(Class(goldbook:09782))
AnnotationAssertion(rdfs:label goldbook:09782 "stable isotope labelling")
AnnotationAssertion(dcterms:description goldbook:09782 "Techniques which serve to quantify protein content by means of mass spectrometry. The principle lies in the introduction of a mass tag to an internal standard protein/peptide containing different stable isotopes than the protein/peptide in the sample. Mass resolved signals originating in the internal standard and the sample are read individually and evaluated.")
AnnotationAssertion(rdfs:comment goldbook:09782 "In the case of a complex sample, the use of multiple reaction monitoring allows for the resolution of multiple overlapping signals."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09782 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09782 "current"^^xsd:string)
Declaration(Class(goldbook:09783))
AnnotationAssertion(rdfs:label goldbook:09783 "structural proteomics")
AnnotationAssertion(dcterms:description goldbook:09783 "Field in proteomics which focuses on higher orders of the protein structure, mainly tertiary or quaternary.")
AnnotationAssertion(rdfs:seeAlso goldbook:09783 goldbook:09780)
AnnotationAssertion(rdfs:seeAlso goldbook:09783 goldbook:09785)
AnnotationAssertion(mito:isMentionedBy goldbook:09783 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09783 "current"^^xsd:string)
Declaration(Class(goldbook:09784))
AnnotationAssertion(rdfs:label goldbook:09784 "targeted proteomics")
AnnotationAssertion(dcterms:description goldbook:09784 "Approach in proteomics focused on the selected proteins of a sample.")
AnnotationAssertion(rdfs:comment goldbook:09784 "In a targeted analysis, the mass spectrometer is programmed to analyse a preselected group of proteins. This can be achieved using a technology called selected reaction monitoring (SRM; also referred to as multiple reaction monitoring, MRM), whereby assays are developed on a triple quadrupole instrument to detect fragment-ion signals arising from unique diagnostic peptides representing each of the targeted proteins."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09784 "Targeted proteomics achieves the highest sensitivity and throughput for hundreds or thousands of samples in regard to the intended aspect (namely target fragments)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09784 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09784 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09784 "current"^^xsd:string)
Declaration(Class(goldbook:09785))
AnnotationAssertion(rdfs:label goldbook:09785 "tertiary structure of a protein")
AnnotationAssertion(dcterms:description goldbook:09785 "Arrangement of all atoms of a protein molecule or a subunit of a protein molecule in space, without regard to its relationship with neighbouring molecules or subunits.")
AnnotationAssertion(rdfs:comment goldbook:09785 "The tertiary structure represents a three-dimensional fold/organisation of a polypeptide chain, one containing specific arrangements of secondary structures (see secondary structure of a protein)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09785 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09785 "current"^^xsd:string)
Declaration(Class(goldbook:09786))
AnnotationAssertion(rdfs:label goldbook:09786 "top-down proteomics")
AnnotationAssertion(dcterms:description goldbook:09786 "Approach to identify proteins and characterise their amino acid sequences or post-translational modifications either by direct mass spectrometric analysis of an ionised protein molecule or by sequential combination of protein/peptide fragmentation in the ion source or mass analyser with ion trapping mass spectrometers.")
AnnotationAssertion(rdfs:seeAlso goldbook:09786 goldbook:09735)
AnnotationAssertion(mito:isMentionedBy goldbook:09786 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09786 "current"^^xsd:string)
Declaration(Class(goldbook:09787))
AnnotationAssertion(rdfs:label goldbook:09787 "trypsin")
AnnotationAssertion(dcterms:description goldbook:09787 "Serine protease with highly specific primary endoproteolytic activity that serves to generate proteolytic peptides in bottom-up proteomics analysis.")
AnnotationAssertion(rdfs:comment goldbook:09787 "It may be modified by reductive methylation or glycosylation to increase its thermal stability."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09787 goldbook:09735)
AnnotationAssertion(mito:isMentionedBy goldbook:09787 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09787 "current"^^xsd:string)
Declaration(Class(goldbook:09788))
AnnotationAssertion(rdfs:label goldbook:09788 "two-dimensional gel electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09788 "Technique used to separate proteins using isoelectric focusing in a gel. The proteins are then further separated in the second dimension using denaturing PAGE.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09788 "2D PAGE")
AnnotationAssertion(rdfs:comment goldbook:09788 "2D PAGE greatly enhances the capacity of the separation and facilitates further analysis, such as the difference gel electrophoresis or the mass spectrometric analysis of gel separated proteins."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09788 goldbook:09747)
AnnotationAssertion(rdfs:seeAlso goldbook:09788 goldbook:09749)
AnnotationAssertion(mito:isMentionedBy goldbook:09788 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09788 "current"^^xsd:string)
Declaration(Class(goldbook:09789))
AnnotationAssertion(rdfs:label goldbook:09789 "Western blot")
AnnotationAssertion(dcterms:description goldbook:09789 "Immunoanalytical technique for the identification of polypeptides separated using gel electrophoresis. The polypeptide is transferred by blotting to a membrane, where it undergoes specific interaction with primary antibody that is specific to the protein of interest. The peptides are detected as complexes by a label and/or enzymatic reaction, which may be conjugated to the primary antibody directly or via a separate (secondary) antibody.")
AnnotationAssertion(rdfs:seeAlso goldbook:09789 goldbook:09708)
AnnotationAssertion(rdfs:seeAlso goldbook:09789 goldbook:09728)
AnnotationAssertion(mito:isMentionedBy goldbook:09789 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09789 "current"^^xsd:string)
Declaration(Class(goldbook:09790))
AnnotationAssertion(rdfs:label goldbook:09790 "cultivation")
AnnotationAssertion(dcterms:description goldbook:09790 "Sample pretreatment to degrade complex metabolites in the presence of oxygen; a method for amplifying the concentration of native metabolites in solution.")
AnnotationAssertion(mito:isMentionedBy goldbook:09790 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09790 "current"^^xsd:string)
Declaration(Class(goldbook:09791))
AnnotationAssertion(rdfs:label goldbook:09791 "design of experiment")
AnnotationAssertion(dcterms:description goldbook:09791 "Metabolomic workflow composed of sampling, metabolism quenching, metabolite extraction, metabolite analyses, data analysis, and interpretation.")
AnnotationAssertion(mito:isMentionedBy goldbook:09791 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09791 "current"^^xsd:string)
Declaration(Class(goldbook:09792))
AnnotationAssertion(rdfs:label goldbook:09792 "endometabolome")
AnnotationAssertion(dcterms:description goldbook:09792 "Complete set of metabolites inside a cell (intracellular metabolites).")
AnnotationAssertion(mito:isMentionedBy goldbook:09792 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09792 "current"^^xsd:string)
Declaration(Class(goldbook:09793))
AnnotationAssertion(rdfs:label goldbook:09793 "excretion")
AnnotationAssertion(dcterms:description goldbook:09793 "Process removing compounds and their metabolites from the body, usually through the kidneys (via urine) or in the feces. Unless excretion is complete, the accumulation of foreign substances can adversely affect normal metabolism.")
AnnotationAssertion(mito:isMentionedBy goldbook:09793 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09793 "current"^^xsd:string)
Declaration(Class(goldbook:09794))
AnnotationAssertion(rdfs:label goldbook:09794 "exometabolome")
AnnotationAssertion(dcterms:description goldbook:09794 "Complete set of metabolites outside the cell (extracellular environment).")
AnnotationAssertion(mito:isMentionedBy goldbook:09794 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09794 "current"^^xsd:string)
Declaration(Class(goldbook:09795))
AnnotationAssertion(rdfs:label goldbook:09795 "fingerprinting")
AnnotationAssertion(dcterms:description goldbook:09795 "Qualitative analysis of the endometabolome.")
AnnotationAssertion(rdfs:seeAlso goldbook:09795 goldbook:09792)
AnnotationAssertion(mito:isMentionedBy goldbook:09795 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09795 "current"^^xsd:string)
Declaration(Class(goldbook:09796))
AnnotationAssertion(rdfs:label goldbook:09796 "fluxomics")
AnnotationAssertion(dcterms:description goldbook:09796 "In vivo measurements of metabolic fluxes and integration of the results into stoichiometric network models.")
AnnotationAssertion(mito:isMentionedBy goldbook:09796 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09796 "current"^^xsd:string)
Declaration(Class(goldbook:09797))
AnnotationAssertion(rdfs:label goldbook:09797 "footprinting")
AnnotationAssertion(dcterms:description goldbook:09797 "Qualitative analysis of the exometabolome.")
AnnotationAssertion(rdfs:seeAlso goldbook:09797 goldbook:09794)
AnnotationAssertion(mito:isMentionedBy goldbook:09797 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09797 "current"^^xsd:string)
Declaration(Class(goldbook:09798))
AnnotationAssertion(rdfs:label goldbook:09798 "glucuronide")
AnnotationAssertion(dcterms:description goldbook:09798 "Glycoside of glucuronic acid.")
AnnotationAssertion(rdfs:comment goldbook:09798 "Glucuronides of xenobiotics (such as drugs, toxic substances, etc.) are formed to excrete them from the organism."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09798 goldbook:09824)
AnnotationAssertion(rdfs:seeAlso goldbook:09798 goldbook:09793)
AnnotationAssertion(mito:isMentionedBy goldbook:09798 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09798 "current"^^xsd:string)
Declaration(Class(goldbook:09799))
AnnotationAssertion(rdfs:label goldbook:09799 "metabolic pathway")
AnnotationAssertion(dcterms:description goldbook:09799 "All metabolic products of the main compound (e.g. phase 1 and phase 2 metabolites) with the routes of metabolism and the excreted metabolites in body fluids, e.g. in urine or blood.")
AnnotationAssertion(mito:isMentionedBy goldbook:09799 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09799 "current"^^xsd:string)
Declaration(Class(goldbook:09800))
AnnotationAssertion(rdfs:label goldbook:09800 "metabolism quenching")
AnnotationAssertion(dcterms:description goldbook:09800 "Physical or chemical methodology used for rapidly breaking all biochemical processes in metabolomic samples.")
AnnotationAssertion(rdfs:seeAlso goldbook:09800 goldbook:09804)
AnnotationAssertion(mito:isMentionedBy goldbook:09800 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09800 "current"^^xsd:string)
Declaration(Class(goldbook:09801))
AnnotationAssertion(rdfs:label goldbook:09801 "metabolite fingerprinting and footprinting")
AnnotationAssertion(dcterms:description goldbook:09801 "Unique pattern characterizing the metabolism in a given living phase that does not attempt to identify or quantify all the metabolites.")
AnnotationAssertion(rdfs:seeAlso goldbook:09801 goldbook:09795)
AnnotationAssertion(rdfs:seeAlso goldbook:09801 goldbook:09797)
AnnotationAssertion(mito:isMentionedBy goldbook:09801 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09801 "current"^^xsd:string)
Declaration(Class(goldbook:09802))
AnnotationAssertion(rdfs:label goldbook:09802 "metabolite profiling")
AnnotationAssertion(dcterms:description goldbook:09802 "Strategy to identify and quantify a particular set of metabolites belonging to a specific metabolic pathway or class of compounds.")
AnnotationAssertion(mito:isMentionedBy goldbook:09802 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09802 "current"^^xsd:string)
Declaration(Class(goldbook:09803))
AnnotationAssertion(rdfs:label goldbook:09803 "metabolome")
AnnotationAssertion(dcterms:description goldbook:09803 "Complete set (from \\(\\pu{50}\\) to \\(\\pu{1000}\\) metabolites) of organic or inorganic compounds of low relative molecular mass, present in the cell or organism and which participate in the metabolic reactions required for growth, maintenance, and normal functioning.")
AnnotationAssertion(rdfs:comment goldbook:09803 "The metabolome forms a large network of metabolic reactions where outputs from one enzymatic chemical reaction are inputs to other chemical reactions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09803 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09803 "current"^^xsd:string)
Declaration(Class(goldbook:09804))
AnnotationAssertion(rdfs:label goldbook:09804 "metabolomics")
AnnotationAssertion(dcterms:description goldbook:09804 "Complex and comprehensive study of metabolome; identification and quantification of the small molecule metabolic products of a biological system (cell, tissue, organ, biological fluid, or organism) at a specific point in time.")
AnnotationAssertion(rdfs:comment goldbook:09804 "An essential part of systems biology in addition to genomics, transcriptomics, proteomics, interactomics, and fluxomics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09804 goldbook:09796)
AnnotationAssertion(rdfs:seeAlso goldbook:09804 goldbook:09872)
AnnotationAssertion(rdfs:seeAlso goldbook:09804 goldbook:09803)
AnnotationAssertion(rdfs:seeAlso goldbook:09804 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09804 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09804 "current"^^xsd:string)
Declaration(Class(goldbook:09805))
AnnotationAssertion(rdfs:label goldbook:09805 "metabonomics")
AnnotationAssertion(dcterms:description goldbook:09805 "Measurement of the dynamic multiparametric metabolic response of a living system to pathophysiological stimuli or genetic modification.")
AnnotationAssertion(rdfs:comment goldbook:09805 "This term is sometime misapplied to refer to the whole of \"metabolomics\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09805 goldbook:09804)
AnnotationAssertion(mito:isMentionedBy goldbook:09805 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09805 "current"^^xsd:string)
Declaration(Class(goldbook:09806))
AnnotationAssertion(rdfs:label goldbook:09806 "primary metabolite")
AnnotationAssertion(dcterms:description goldbook:09806 "Metabolite directly involved in the normal life processes of each cell.")
AnnotationAssertion(mito:isMentionedBy goldbook:09806 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09806 "current"^^xsd:string)
Declaration(Class(goldbook:09807))
AnnotationAssertion(rdfs:label goldbook:09807 "activated nucleotide sugar")
AnnotationAssertion(dcterms:description goldbook:09807 "Activated form of monosaccharide linked to a nucleotide to be available in a high-energy state for glycosyl transfer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09807 "nucleotide sugar")
AnnotationAssertion(rdfs:seeAlso goldbook:09807 goldbook:09826)
AnnotationAssertion(mito:isMentionedBy goldbook:09807 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09807 "current"^^xsd:string)
Declaration(Class(goldbook:09808))
AnnotationAssertion(rdfs:label goldbook:09808 "anomeric hydroxy group")
AnnotationAssertion(dcterms:description goldbook:09808 "Hydroxy group that originates from the aldehydic or ketonic group of a monosaccharide after ring closure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09808 "glycosidic hydroxy group")
AnnotationAssertion(rdfs:comment goldbook:09808 "A functional group in one of two stereoisomers of a cyclic saccharide that differs only in its configuration at the hemiacetal or hemiketal carbon, which is also called the anomeric carbon. An anomer is a special type of epimer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09808 "The group is sometimes called, incorrectly, \"anomeric hydroxyl group\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09808 goldbook:09829)
AnnotationAssertion(rdfs:seeAlso goldbook:09808 goldbook:09830)
AnnotationAssertion(mito:isMentionedBy goldbook:09808 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09808 "current"^^xsd:string)
Declaration(Class(goldbook:09809))
AnnotationAssertion(rdfs:label goldbook:09809 "carbohydrate")
AnnotationAssertion(dcterms:description goldbook:09809 "Monosaccharide, oligosaccharide and polysaccharide substances, as well as substances derived from a monosaccharide by reduction of the carbonyl group (alditol), by oxidation, including the oxidation of one or more terminal groups of a carboxylic acid, or by replacement of one or more hydroxy groups by a hydrogen atom, an amino group, a thiol group, or by similar heteroatomic groups. This term also includes derivatives of these of these compounds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09809 "glycan")
AnnotationAssertion(rdfs:comment goldbook:09809 "The term carbohydrate was applied originally to monosaccharides, in recognition of the fact that their empirical composition can be expressed as \\(\\ce{C_{m}(H2O)_{n}}\\). However, the term is now used generically in a wider sense."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09809 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09809 "current"^^xsd:string)
Declaration(Class(goldbook:09810))
AnnotationAssertion(rdfs:label goldbook:09810 "comparative glycoproteomics")
AnnotationAssertion(dcterms:description goldbook:09810 "Field of glycoproteomics that studies that the changes in the structures and expression levels of glycoproteins under different conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09810 goldbook:09821)
AnnotationAssertion(rdfs:seeAlso goldbook:09810 goldbook:09822)
AnnotationAssertion(mito:isMentionedBy goldbook:09810 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09810 "current"^^xsd:string)
Declaration(Class(goldbook:09811))
AnnotationAssertion(rdfs:label goldbook:09811 "comparative proteoglycomics")
AnnotationAssertion(dcterms:description goldbook:09811 "Field of proteoglycomics that studies the changes in the structures and expression levels of proteoglycans under different conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09811 goldbook:09833)
AnnotationAssertion(mito:isMentionedBy goldbook:09811 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09811 "current"^^xsd:string)
Declaration(Class(goldbook:09812))
AnnotationAssertion(rdfs:label goldbook:09812 "glycan microarray")
AnnotationAssertion(dcterms:description goldbook:09812 "Glycans attached to a surface of a microarray.")
AnnotationAssertion(rdfs:comment goldbook:09812 "Glycan microarrays are used for the characterization of lectins and other glycan-binding proteins via specific interactions with labelled glycan-binding proteins."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09812 "Specific lectin–glycan interactions are also used for the characterization of glycans in the opposite set-up (see lectin microarray, glycan profiling)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09812 goldbook:09813)
AnnotationAssertion(rdfs:seeAlso goldbook:09812 goldbook:09832)
AnnotationAssertion(rdfs:seeAlso goldbook:09812 goldbook:09831)
AnnotationAssertion(rdfs:seeAlso goldbook:09812 goldbook:09659)
AnnotationAssertion(mito:isMentionedBy goldbook:09812 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09812 "current"^^xsd:string)
Declaration(Class(goldbook:09813))
AnnotationAssertion(rdfs:label goldbook:09813 "glycan profiling")
AnnotationAssertion(dcterms:description goldbook:09813 "Determination of the diversity of glycan structures expressed on glycoconjugates or cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:09813 goldbook:09832)
AnnotationAssertion(mito:isMentionedBy goldbook:09813 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09813 "current"^^xsd:string)
Declaration(Class(goldbook:09814))
AnnotationAssertion(rdfs:label goldbook:09814 "glycan-binding protein")
AnnotationAssertion(dcterms:description goldbook:09814 "Protein that recognises and binds to specific glycans and mediates their biological function.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09814 "carbohydrate-binding protein")
AnnotationAssertion(rdfs:seeAlso goldbook:09814 goldbook:09831)
AnnotationAssertion(mito:isMentionedBy goldbook:09814 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09814 "current"^^xsd:string)
Declaration(Class(goldbook:09815))
AnnotationAssertion(rdfs:label goldbook:09815 "glycoform")
AnnotationAssertion(dcterms:description goldbook:09815 "Specific form of a glycoprotein containing a distinct glycan structure per glycosylation site.")
AnnotationAssertion(rdfs:comment goldbook:09815 "Natural glycoprotein consists of a population of glycoforms resulting from variable glycan structure and/or glycan attachment site occupancy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09815 goldbook:09821)
AnnotationAssertion(mito:isMentionedBy goldbook:09815 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09815 "current"^^xsd:string)
Declaration(Class(goldbook:09816))
AnnotationAssertion(rdfs:label goldbook:09816 "glycogene")
AnnotationAssertion(dcterms:description goldbook:09816 "Gene encoding an enzyme or other functional protein for glycan synthesis.")
AnnotationAssertion(rdfs:comment goldbook:09816 "The term should not be confused with glycogen (an energy-storage glucose polysacharide in animals and fungi)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09816 "Proteins for glycan synthesis include glycosyltransferases, sugar-nucleotide synthases, sugar-nucleotide transporters, and sulfotransferases (see glycosylation, activated nucleotide sugars)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09816 goldbook:09807)
AnnotationAssertion(rdfs:seeAlso goldbook:09816 goldbook:09827)
AnnotationAssertion(mito:isMentionedBy goldbook:09816 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09816 "current"^^xsd:string)
Declaration(Class(goldbook:09817))
AnnotationAssertion(rdfs:label goldbook:09817 "glycolipid")
AnnotationAssertion(dcterms:description goldbook:09817 "Compound containing a glycan covalently linked to a lipid aglycon.")
AnnotationAssertion(rdfs:comment goldbook:09817 "The term \"lipid\" comprises several types of compounds. Therefore, different classes of glycolipides are described. For example, typical glycolipids in higher organisms are glycosphingolipids."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09817 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09817 "current"^^xsd:string)
Declaration(Class(goldbook:09818))
AnnotationAssertion(rdfs:label goldbook:09818 "glycome")
AnnotationAssertion(dcterms:description goldbook:09818 "Complete set of glycans and glycoconjugates produced by a species, tissue, or cell in a specified time, space, and environment.")
AnnotationAssertion(rdfs:comment goldbook:09818 "Glycome is an analogue of the terms genome, proteome, and transcriptome."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09818 "The terms, as for example \"sialome\", are sometimes used for the specific subclasses of the glycome."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09818 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09818 "current"^^xsd:string)
Declaration(Class(goldbook:09819))
AnnotationAssertion(rdfs:label goldbook:09819 "glycomics")
AnnotationAssertion(dcterms:description goldbook:09819 "Complex and comprehensive study of the glycome.")
AnnotationAssertion(rdfs:comment goldbook:09819 "\"Glycomics\" is an analogue of the terms genomics or proteomics. The terms, as for example \"fucanomics\" or \"galactanomics\", are sometimes used for the specialised fields of glycomics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09819 goldbook:09818)
AnnotationAssertion(rdfs:seeAlso goldbook:09819 goldbook:09780)
AnnotationAssertion(mito:isMentionedBy goldbook:09819 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09819 "current"^^xsd:string)
Declaration(Class(goldbook:09820))
AnnotationAssertion(rdfs:label goldbook:09820 "glycone")
AnnotationAssertion(dcterms:description goldbook:09820 "Carbohydrate part of a glycoconjugate or a glycoside.")
AnnotationAssertion(rdfs:seeAlso goldbook:09820 goldbook:09809)
AnnotationAssertion(rdfs:seeAlso goldbook:09820 goldbook:09824)
AnnotationAssertion(mito:isMentionedBy goldbook:09820 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09820 "current"^^xsd:string)
Declaration(Class(goldbook:09821))
AnnotationAssertion(rdfs:label goldbook:09821 "glycoprotein")
AnnotationAssertion(dcterms:description goldbook:09821 "Protein with one or more covalently bound glycans.")
AnnotationAssertion(rdfs:seeAlso goldbook:09821 goldbook:09831)
AnnotationAssertion(mito:isMentionedBy goldbook:09821 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09821 "current"^^xsd:string)
Declaration(Class(goldbook:09822))
AnnotationAssertion(rdfs:label goldbook:09822 "glycoproteomics")
AnnotationAssertion(dcterms:description goldbook:09822 "Comprehensive analysis of glycoproteins.")
AnnotationAssertion(rdfs:comment goldbook:09822 "Glycoproteomics studies the glycosylated subset of the proteome, including sites of glycosylation and glycan structures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09822 goldbook:09821)
AnnotationAssertion(rdfs:seeAlso goldbook:09822 goldbook:09827)
AnnotationAssertion(mito:isMentionedBy goldbook:09822 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09822 "current"^^xsd:string)
Declaration(Class(goldbook:09823))
AnnotationAssertion(rdfs:label goldbook:09823 "glycosidase")
AnnotationAssertion(dcterms:description goldbook:09823 "Enzyme that catalyses the hydrolysis of glycosidic linkages.")
AnnotationAssertion(rdfs:comment goldbook:09823 "Endoglycosidase hydrolyses internal glycosidic linkages, while exoglycosidase removes terminal monosaccharide from the non-reducing end of a glycoside."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09823 goldbook:09825)
AnnotationAssertion(mito:isMentionedBy goldbook:09823 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09823 "current"^^xsd:string)
Declaration(Class(goldbook:09824))
AnnotationAssertion(rdfs:label goldbook:09824 "glycoside")
AnnotationAssertion(dcterms:description goldbook:09824 "Mixed acetal formally arising by the elimination of water between the hemiacetal or hemiketal hydroxy group of a sugar and a hydroxy group of a second compound. Glycan containing at least one glycosidic linkage to another glycan or an aglycon.")
AnnotationAssertion(rdfs:comment goldbook:09824 "The bond between the two components is called a glycosidic bond."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09824 goldbook:09825)
AnnotationAssertion(rdfs:seeAlso goldbook:09824 goldbook:09829)
AnnotationAssertion(rdfs:seeAlso goldbook:09824 goldbook:09830)
AnnotationAssertion(mito:isMentionedBy goldbook:09824 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09824 "current"^^xsd:string)
Declaration(Class(goldbook:09825))
AnnotationAssertion(rdfs:label goldbook:09825 "glycosidic linkage")
AnnotationAssertion(dcterms:description goldbook:09825 "Linkage of a monosaccharide to another residue via the anomeric hydroxy group.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09825 "glycosidic bond")
AnnotationAssertion(rdfs:seeAlso goldbook:09825 goldbook:09808)
AnnotationAssertion(mito:isMentionedBy goldbook:09825 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09825 "current"^^xsd:string)
Declaration(Class(goldbook:09826))
AnnotationAssertion(rdfs:label goldbook:09826 "glycosyl")
AnnotationAssertion(dcterms:description goldbook:09826 "Monosaccharide ring without the anomeric oxygen.")
AnnotationAssertion(mito:isMentionedBy goldbook:09826 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09826 "current"^^xsd:string)
Declaration(Class(goldbook:09827))
AnnotationAssertion(rdfs:label goldbook:09827 "glycosylation")
AnnotationAssertion(dcterms:description goldbook:09827 "Covalent attachment of a saccharide to a protein, lipid, polynucleotide, saccharide, or other organic compound, generally catalysed by enzymes glycosyltransferases.")
AnnotationAssertion(rdfs:seeAlso goldbook:09827 goldbook:09828)
AnnotationAssertion(mito:isMentionedBy goldbook:09827 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09827 "current"^^xsd:string)
Declaration(Class(goldbook:09828))
AnnotationAssertion(rdfs:label goldbook:09828 "glycosyltransferase")
AnnotationAssertion(dcterms:description goldbook:09828 "Enzyme that catalyses the transfer of a saccharide from a nucleotide di(mono)phosphate-activated sugar to an acceptor molecule.")
AnnotationAssertion(rdfs:seeAlso goldbook:09828 goldbook:09807)
AnnotationAssertion(rdfs:seeAlso goldbook:09828 goldbook:09827)
AnnotationAssertion(rdfs:seeAlso goldbook:09828 goldbook:09834)
AnnotationAssertion(mito:isMentionedBy goldbook:09828 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09828 "current"^^xsd:string)
Declaration(Class(goldbook:09829))
AnnotationAssertion(rdfs:label goldbook:09829 "hemiacetal")
AnnotationAssertion(dcterms:description goldbook:09829 "Compound having the general formula \\(\\ce{RCH(OH)(OR^{\\prime})}\\) (\\(\\ce{R^{\\prime}}  eq \\ce{H}\\)).")
AnnotationAssertion(rdfs:comment goldbook:09829 "A hemiacetal results from the nucleophilic addition of a hydroxy group to a carbonyl functionality of an aldehyde, as in ring closure of an aldose."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09829 goldbook:09808)
AnnotationAssertion(rdfs:seeAlso goldbook:09829 goldbook:09830)
AnnotationAssertion(mito:isMentionedBy goldbook:09829 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09829 "current"^^xsd:string)
Declaration(Class(goldbook:09830))
AnnotationAssertion(rdfs:label goldbook:09830 "hemiketal")
AnnotationAssertion(dcterms:description goldbook:09830 "Compound having the general formula \\(\\ce{R2C(OH)OR^{\\prime}}\\) (\\(\\ce{R^{\\prime}}  eq \\ce{H}\\)).")
AnnotationAssertion(rdfs:comment goldbook:09830 "A hemiketal results from the nucleophilic addition of a hydroxy group to a carbonyl functionality of a ketone, as in ring closure of a ketose."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09830 goldbook:09829)
AnnotationAssertion(mito:isMentionedBy goldbook:09830 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09830 "current"^^xsd:string)
Declaration(Class(goldbook:09831))
AnnotationAssertion(rdfs:label goldbook:09831 "lectin")
AnnotationAssertion(dcterms:description goldbook:09831 "Saccharide binding protein of non-immune origin.")
AnnotationAssertion(rdfs:comment goldbook:09831 "Some lectins participate in immune response, but they are not products of primary immune response. Lectins also do not display catalytic activity towards their ligands; the binding of carbohydrate is reversible and highly specific."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09831 goldbook:09821)
AnnotationAssertion(mito:isMentionedBy goldbook:09831 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09831 "current"^^xsd:string)
Declaration(Class(goldbook:09832))
AnnotationAssertion(rdfs:label goldbook:09832 "lectin microarray")
AnnotationAssertion(dcterms:description goldbook:09832 "Lectins with distinct saccharide-binding specificity arranged on a microarray platform.")
AnnotationAssertion(rdfs:comment goldbook:09832 "Lectin microarray is used for the characterization of glycans (see glycan profiling) via specific interactions with labelled glycans."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09832 "The specific lectin–glycan interactions are also used for the characterization of lectins in the opposite set-up (see glycan microarray)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09832 goldbook:09831)
AnnotationAssertion(rdfs:seeAlso goldbook:09832 goldbook:09812)
AnnotationAssertion(rdfs:seeAlso goldbook:09832 goldbook:09813)
AnnotationAssertion(rdfs:seeAlso goldbook:09832 goldbook:09659)
AnnotationAssertion(mito:isMentionedBy goldbook:09832 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09832 "current"^^xsd:string)
Declaration(Class(goldbook:09833))
AnnotationAssertion(rdfs:label goldbook:09833 "proteoglycomics")
AnnotationAssertion(dcterms:description goldbook:09833 "Systematic study of the structure, expression, and function of proteoglycans.")
AnnotationAssertion(mito:isMentionedBy goldbook:09833 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09833 "current"^^xsd:string)
Declaration(Class(goldbook:09834))
AnnotationAssertion(rdfs:label goldbook:09834 "sugar")
AnnotationAssertion(dcterms:description goldbook:09834 "Term frequently applied to monosaccharides and lower oligosaccharides.")
AnnotationAssertion(mito:isMentionedBy goldbook:09834 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09834 "current"^^xsd:string)
Declaration(Class(goldbook:09835))
AnnotationAssertion(rdfs:label goldbook:09835 "alkaline degradation")
AnnotationAssertion(dcterms:description goldbook:09835 "Treatment with alkaline solution (e.g. hydrazine, \\(\\ce{KOH}\\), \\(\\ce{NaOH}\\)) useful for the cleavage of fatty acids.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09835 "alkaline hydrolysis")
AnnotationAssertion(rdfs:comment goldbook:09835 "The resulting (partially or fully) O-deacylated and (fully) N-deacylated products enable the determination of the fatty acid substitution positions by mass spectrometry."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09835 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09835 "current"^^xsd:string)
Declaration(Class(goldbook:09836))
AnnotationAssertion(rdfs:label goldbook:09836 "core oligosaccharide")
AnnotationAssertion(dcterms:description goldbook:09836 "Intermediate structural region between the O-polysaccharide and lipid A moiety of lipopolysaccharides (LPS).")
AnnotationAssertion(rdfs:seeAlso goldbook:09836 goldbook:09840)
AnnotationAssertion(mito:isMentionedBy goldbook:09836 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09836 "current"^^xsd:string)
Declaration(Class(goldbook:09837))
AnnotationAssertion(rdfs:label goldbook:09837 "fatty acyls")
AnnotationAssertion(dcterms:description goldbook:09837 "Diverse group of lipid molecules synthesised by chain elongation of an acetyl-CoA primer with malonyl-CoA (or methylmalonyl-CoA) groups.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09837 "FA")
AnnotationAssertion(rdfs:comment goldbook:09837 "The fatty acyl category is further divided into multiple subclasses, including fatty acids and conjugates, icosanoid, fatty alcohols and esters, glycans, and others."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09837 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09837 "current"^^xsd:string)
Declaration(Class(goldbook:09838))
AnnotationAssertion(rdfs:label goldbook:09838 "glycerolipids")
AnnotationAssertion(dcterms:description goldbook:09838 "Esters, ethers, and other O-derivatives of glycerol with alkyls or alkenyls, including mono-, di-, and tri-substituted glycerols.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09838 "GL")
AnnotationAssertion(mito:isMentionedBy goldbook:09838 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09838 "current"^^xsd:string)
Declaration(Class(goldbook:09839))
AnnotationAssertion(rdfs:label goldbook:09839 "glycerophospholipids")
AnnotationAssertion(dcterms:description goldbook:09839 "Lipids with glycerol backbone esterified with one or two fatty acids in position \\(\\ce{C-1}\\) and/or \\(\\ce{C-2}\\) and with phosphoric acid at position \\(\\ce{C-3}\\). The phosphate group is usually esterified with an alcohol (choline, ethanolamine, serine, inositol, glycerol) to form the 'lipid head group'.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09839 "GP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09839 "phospholipids")
AnnotationAssertion(rdfs:comment goldbook:09839 "GPs are ubiquitous in nature and are key components of the membrane lipid bilayers of cells."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09839 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09839 "current"^^xsd:string)
Declaration(Class(goldbook:09840))
AnnotationAssertion(rdfs:label goldbook:09840 "lipid A")
AnnotationAssertion(dcterms:description goldbook:09840 "Glycolipid component of lipopolysaccharides (LPSs) that is integrated into the bacterial cell wall and is responsible for the beneficial (immunostimulatory) or toxic (immunopathological) effects of the molecule.")
AnnotationAssertion(rdfs:comment goldbook:09840 "The archetypical (Enterobacteriaceae) structure of lipid A consists of a \\(\\beta\\)-1,6-linked d-glucosamine (GlcN) or 2,3-diamino-2,3-dideoxy-d-glucose (GlcN3N) disaccharide (or a mixture of them), which is acylated by varying numbers (usually four to seven) of ester- and amide-linked acyl groups (often termed primary and secondary fatty acids). Phosphate groups and other glycosyl substituents may be linked at the \\(\\ce{C-1}\\) and \\(\\ce{C-4^{\\prime}}\\) positions. Lipid A is linked to the core oligosaccharide at the \\(\\ce{C-6^{\\prime}}\\) position of the distal sugar unit of lipid A."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09840 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09840 "current"^^xsd:string)
Declaration(Class(goldbook:09841))
AnnotationAssertion(rdfs:label goldbook:09841 "lipid droplets")
AnnotationAssertion(dcterms:description goldbook:09841 "Round-shaped intracellular inclusions consisting of hydrophobic cores (mainly triacylglycerols, sterol esters, occasionally free fatty acids or squalene) covered by a phospholipid monolayer containing a specific set of proteins.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09841 "adiposomes")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09841 "lipid bodies")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09841 "lipid particles")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09841 "oil bodies")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09841 "oleosomes")
AnnotationAssertion(rdfs:comment goldbook:09841 "Originally considered as lipid storage compartments, lipid droplets are currently recognised as organelles with high metabolic activity. The defective formation and/or function of lipid droplets is involved in various pathogenic conditions, such as obesity, cardiovascular diseases, type 2 diabetes, or metabolic syndrome."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09841 goldbook:09839)
AnnotationAssertion(mito:isMentionedBy goldbook:09841 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09841 "current"^^xsd:string)
Declaration(Class(goldbook:09842))
AnnotationAssertion(rdfs:label goldbook:09842 "lipid extraction")
AnnotationAssertion(dcterms:description goldbook:09842 "Isolation of lipids in their native state from samples of different origin.")
AnnotationAssertion(rdfs:comment goldbook:09842 "Usually based on the use of organic solvents (methanol, chloroform) to facilitate lipid partitioning between aqueous and organic phases."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09842 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09842 "current"^^xsd:string)
Declaration(Class(goldbook:09843))
AnnotationAssertion(rdfs:label goldbook:09843 "lipid profiling")
AnnotationAssertion(dcterms:description goldbook:09843 "Lipidomics technique conferring unbiased information about total lipids within a particular cell type, tissue, or body fluid.")
AnnotationAssertion(rdfs:seeAlso goldbook:09843 goldbook:09846)
AnnotationAssertion(mito:isMentionedBy goldbook:09843 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09843 "current"^^xsd:string)
Declaration(Class(goldbook:09844))
AnnotationAssertion(rdfs:label goldbook:09844 "lipid remodelling")
AnnotationAssertion(dcterms:description goldbook:09844 "Changes in the lipid molecules composition after completion of their biosynthesis.")
AnnotationAssertion(rdfs:comment goldbook:09844 "In glycerophospholipids, remodelling includes changes in the composition of fatty acids (for example by acyl chain exchange catalysed by transacylases) or the introduction of unsaturated double bonds (catalysed by desaturases), or by the synthesis of new lipid species or degradation of existing ones. In phosphoinositides, it can involve phosphorylation/dephosphorylation processes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09844 "Lipid remodelling is important for the adaptation of biological membranes to changing environmental conditions and physiological demands."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09844 goldbook:09839)
AnnotationAssertion(mito:isMentionedBy goldbook:09844 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09844 "current"^^xsd:string)
Declaration(Class(goldbook:09845))
AnnotationAssertion(rdfs:label goldbook:09845 "lipidome")
AnnotationAssertion(dcterms:description goldbook:09845 "Complete set of lipid species and their metabolites present within a particular cell type, tissue, or body fluid.")
AnnotationAssertion(rdfs:comment goldbook:09845 "It is estimated that lipidome of a eukaryotic cell may contain over \\(\\pu{100000}\\) individual molecular species of various lipids."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09845 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09845 "current"^^xsd:string)
Declaration(Class(goldbook:09846))
AnnotationAssertion(rdfs:label goldbook:09846 "lipidomics")
AnnotationAssertion(dcterms:description goldbook:09846 "Systematic and comprehensive study aimed at the identification, profiling, and quantification of lipidome.")
AnnotationAssertion(rdfs:comment goldbook:09846 "In a broader context, lipidomics includes system-level analysis of subcellular localization and the biological activities of individual lipids."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09846 "Lipidomics is a lipid-targeted metabolomics approach aimed at a comprehensive analysis of lipids in biological systems."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09846 goldbook:09845)
AnnotationAssertion(rdfs:seeAlso goldbook:09846 goldbook:09804)
AnnotationAssertion(mito:isMentionedBy goldbook:09846 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09846 "current"^^xsd:string)
Declaration(Class(goldbook:09847))
AnnotationAssertion(rdfs:label goldbook:09847 "lipooligosaccharide")
AnnotationAssertion(dcterms:description goldbook:09847 "Lipopolysaccharide produced by specific wild-type bacteria that give a smooth-colony appearance when cultured on agar plates.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09847 "LOS")
AnnotationAssertion(rdfs:comment goldbook:09847 "LOSs are composed of lipid A and a saccharide moiety, limited to an oligosaccharide core only."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09847 "The lack of O-polysaccharide chains in LOS structures is an inherent property of bacteria."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09847 goldbook:09840)
AnnotationAssertion(mito:isMentionedBy goldbook:09847 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09847 "current"^^xsd:string)
Declaration(Class(goldbook:09848))
AnnotationAssertion(rdfs:label goldbook:09848 "lipopolysaccharidomics")
AnnotationAssertion(dcterms:description goldbook:09848 "Study of the structure-activity relationship of bacterial lipopolysaccharides.")
AnnotationAssertion(mito:isMentionedBy goldbook:09848 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09848 "current"^^xsd:string)
Declaration(Class(goldbook:09849))
AnnotationAssertion(rdfs:label goldbook:09849 "membrane bilayer")
AnnotationAssertion(dcterms:description goldbook:09849 "Planar structure spontaneously formed by amphipathic lipids in a polar (aqueous) environment.")
AnnotationAssertion(rdfs:comment goldbook:09849 "Formation of a lipid bilayer is driven by the interaction of the polar heads of lipids with water molecules while minimizing the exposure of the hydrophobic parts of lipids to water. Lipid bilayers represent the basic structure of biological membranes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09849 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09849 "current"^^xsd:string)
Declaration(Class(goldbook:09850))
AnnotationAssertion(rdfs:label goldbook:09850 "membrane rafts")
AnnotationAssertion(dcterms:description goldbook:09850 "Dynamic, nanometre-sized, highly ordered, membrane domains enriched in sterols and sphingolipids. They contain specific sets of membrane proteins that are sorted into rafts by their specific physical properties and specific lipid-protein interactions.")
AnnotationAssertion(rdfs:comment goldbook:09850 "In functional terms, membrane rafts represent highly specialised membrane domains involved in various cellular processes, such as transmembrane transport, membrane trafficking, cell signalling, or virus assembly."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09850 goldbook:09860)
AnnotationAssertion(rdfs:seeAlso goldbook:09850 goldbook:09861)
AnnotationAssertion(mito:isMentionedBy goldbook:09850 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09850 "current"^^xsd:string)
Declaration(Class(goldbook:09851))
AnnotationAssertion(rdfs:label goldbook:09851 "molecular shape of lipids")
AnnotationAssertion(dcterms:description goldbook:09851 "Specific structure of lipid molecules (glycerophospholipids) in aqueous environments and membranes as a function of the ratio between the cross-sections of their polar heads and hydrophobic tails.")
AnnotationAssertion(rdfs:comment goldbook:09851 "Lipids’ ability to self-assemble in dynamic macrostructures in an aqueous medium is driven by the amphiphilic nature of lipid molecules, which tend to aggregate so that the hydrophobic (tails) and the hydrophilic (heads) parts of the lipid are well separated and the area of the dividing surface is held by the hydrophobic effect."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09851 "The shape of a membrane lipid depends on the relative size of its polar headgroup and apolar tails. In cases in which the headgroup and lipid backbone have similar cross-sectional areas, the molecule has a cylindrical shape (phosphatidylcholine and phosphatidylserine). Lipids with a small headgroup, such as phosphatidylethanolamine, are conical shaped. By contrast, when the hydrophobic part occupies a relatively smaller surface area, the molecule has the shape of an inverted cone (lysophosphatidylcholine and, to some extent, sphingomyelin)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09851 goldbook:09839)
AnnotationAssertion(mito:isMentionedBy goldbook:09851 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09851 "current"^^xsd:string)
Declaration(Class(goldbook:09852))
AnnotationAssertion(rdfs:label goldbook:09852 "O-polysaccharide")
AnnotationAssertion(dcterms:description goldbook:09852 "Part of a lipopolysaccharide that consists of a polysaccharide chain extending outwards from the bacterial cell surface.")
AnnotationAssertion(mito:isMentionedBy goldbook:09852 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09852 "current"^^xsd:string)
Declaration(Class(goldbook:09853))
AnnotationAssertion(rdfs:label goldbook:09853 "plasma lipoproteins")
AnnotationAssertion(dcterms:description goldbook:09853 "Assemblies of lipids and proteins in blood plasma transporting lipids between tissues.")
AnnotationAssertion(rdfs:comment goldbook:09853 "They are structurally very similar to intracellular lipid droplets. They are classified according to their size and buoyant density into five types with different functions: chylomicrons, very low density lipoproteins (VLDL), intermediate lipoproteins (IDL), low density lipoproteins (LDL), and high density lipoproteins (HDL)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09853 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09853 "current"^^xsd:string)
Declaration(Class(goldbook:09854))
AnnotationAssertion(rdfs:label goldbook:09854 "polyunsaturated fatty acids")
AnnotationAssertion(dcterms:description goldbook:09854 "Fatty acids with more than one double bond.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:09854 "PUFA")
AnnotationAssertion(rdfs:comment goldbook:09854 "The double bonds usually have cis (Z) configuration and are methylene-interrupted."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09854 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09854 "current"^^xsd:string)
Declaration(Class(goldbook:09855))
AnnotationAssertion(rdfs:label goldbook:09855 "prenol lipids")
AnnotationAssertion(dcterms:description goldbook:09855 "Lipids containing a linear chain of isoprenoid groups.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09855 "PR")
AnnotationAssertion(rdfs:comment goldbook:09855 "Prenol lipids are synthesised from the five-carbon precursors isopentenyl diphosphate and dimethylallyl diphosphate. Both precursors are produced mainly via the mevalonic acid pathway."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09855 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09855 "current"^^xsd:string)
Declaration(Class(goldbook:09856))
AnnotationAssertion(rdfs:label goldbook:09856 "proteolipids")
AnnotationAssertion(dcterms:description goldbook:09856 "Proteins with covalently linked lipids, e.g. fatty acid or glycophosphatidylinositol (GPI).")
AnnotationAssertion(rdfs:comment goldbook:09856 "The term ‘lipoprotein’ is also occasionally used to describe such compounds, but to avoid confusion this might be better reserved for the non-covalently linked lipid-protein complexes of the type found in plasma (plasma lipoproteins)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09856 goldbook:09853)
AnnotationAssertion(mito:isMentionedBy goldbook:09856 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09856 "current"^^xsd:string)
Declaration(Class(goldbook:09857))
AnnotationAssertion(rdfs:label goldbook:09857 "saccharolipids")
AnnotationAssertion(dcterms:description goldbook:09857 "Biomolecules where fatty acids are directly bound to a saccharide backbone, thus forming structures similar to glycerolipids or glycerophospholipids, with saccharide substituting for the glycerol.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09857 "SL")
AnnotationAssertion(rdfs:seeAlso goldbook:09857 goldbook:09838)
AnnotationAssertion(rdfs:seeAlso goldbook:09857 goldbook:09839)
AnnotationAssertion(mito:isMentionedBy goldbook:09857 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09857 "current"^^xsd:string)
Declaration(Class(goldbook:09858))
AnnotationAssertion(rdfs:label goldbook:09858 "shotgun lipidomics")
AnnotationAssertion(dcterms:description goldbook:09858 "Methodological approach based on the direct analysis of the total lipid extracts from cells or tissues without an online chromatographic separation.")
AnnotationAssertion(mito:isMentionedBy goldbook:09858 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09858 "current"^^xsd:string)
Declaration(Class(goldbook:09859))
AnnotationAssertion(rdfs:label goldbook:09859 "signalling lipids")
AnnotationAssertion(dcterms:description goldbook:09859 "Lipid molecules involved in intracellular signalling and the regulation of cell death, immune response, or inflammation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09859 "lipid mediators")
AnnotationAssertion(rdfs:comment goldbook:09859 "Signalling lipids include diacylglycerol, phosphatidic acid, phosphatidylinositol-4,5-bisphosphate (the source of polyphosphorylated inositols), arachidonic acid-derived mediators (icosanoids, prostaglandins and leukotrienes), sphingolipid-derived mediators (ceramides, sphingosine, sphingosine-1-phosphate), or cholesterol-derived steroid hormones (androgens, estrogens, progestogens, mineralocorticoids, glucocorticoids)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09859 "Broadly defined term referring to any lipid messenger that binds a protein target, such as a receptor, kinase or phosphatase, which in turn mediates the effects of these lipids on specific cellular responses."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09859 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09859 "current"^^xsd:string)
Declaration(Class(goldbook:09860))
AnnotationAssertion(rdfs:label goldbook:09860 "sphingolipids")
AnnotationAssertion(dcterms:description goldbook:09860 "Complex family of lipids that contain a sphingoid base backbone and a fatty acyl chain.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09860 "SP")
AnnotationAssertion(rdfs:comment goldbook:09860 "Together with glycerophospholipids and sterols, sphingolipids are the major lipid components of cellular membranes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09860 goldbook:09837)
AnnotationAssertion(rdfs:seeAlso goldbook:09860 goldbook:09839)
AnnotationAssertion(mito:isMentionedBy goldbook:09860 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09860 "current"^^xsd:string)
Declaration(Class(goldbook:09861))
AnnotationAssertion(rdfs:label goldbook:09861 "sterol lipids")
AnnotationAssertion(dcterms:description goldbook:09861 "Structural derivatives of tetracyclic alcohols with a hydroxyl group in the position \\(\\ce{C-3}\\) and an aliphatic side chain in the position \\(\\ce{C-17}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09861 "ST")
AnnotationAssertion(rdfs:comment goldbook:09861 "This category primarily comprises sterols: polycyclic compounds of isoprenoid origin and their various derivatives, including steroids, bile acids, and sterol esters. Sterols, along with glycerophospholipids and sphingolipids, are important constituents of cellular membranes. In addition, sterol lipids act as hormones (steroids) or fat emulsifiers (bile acids)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09861 goldbook:09839)
AnnotationAssertion(rdfs:seeAlso goldbook:09861 goldbook:09860)
AnnotationAssertion(mito:isMentionedBy goldbook:09861 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09861 "current"^^xsd:string)
Declaration(Class(goldbook:09862))
AnnotationAssertion(rdfs:label goldbook:09862 "structural lipids")
AnnotationAssertion(dcterms:description goldbook:09862 "Lipids (mainly glycerophospholipids, sterols and sphingolipids) involved in the formation of biological membranes.")
AnnotationAssertion(rdfs:seeAlso goldbook:09862 goldbook:09839)
AnnotationAssertion(rdfs:seeAlso goldbook:09862 goldbook:09860)
AnnotationAssertion(rdfs:seeAlso goldbook:09862 goldbook:09861)
AnnotationAssertion(mito:isMentionedBy goldbook:09862 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09862 "current"^^xsd:string)
Declaration(Class(goldbook:09863))
AnnotationAssertion(rdfs:label goldbook:09863 "targeted lipidomics")
AnnotationAssertion(dcterms:description goldbook:09863 "Analytical technique focusing on the quantification of specific lipids of interest.")
AnnotationAssertion(mito:isMentionedBy goldbook:09863 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09863 "current"^^xsd:string)
Declaration(Class(goldbook:09864))
AnnotationAssertion(rdfs:label goldbook:09864 "unsaturation index")
AnnotationAssertion(dcterms:description goldbook:09864 "Measure of the number of double bonds in fatty acids moieties of phospholipids, calculated as the fraction of each unsaturated fatty acid multiplied by the number of double bonds within that fatty acid.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09864 "UI")
AnnotationAssertion(rdfs:comment goldbook:09864 "UI is indicative of membrane physical properties (e.g. fluidity, curvature, or flexibility)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09864 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09864 "current"^^xsd:string)
Declaration(Class(goldbook:09865))
AnnotationAssertion(rdfs:label goldbook:09865 "capture probe")
AnnotationAssertion(dcterms:description goldbook:09865 "Specifically-designed single-stranded nucleic acid with a defined (known) nucleotide sequence immobilised on a surface.")
AnnotationAssertion(rdfs:comment goldbook:09865 "Capture probes are utilised as a recognition element to test the nucleotide sequence of target deoxyribonucleic acid (DNA) or ribonucleic acid (RNA) in the sample solution by using DNA or RNA hybridization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09865 "An analogous principle, based on immobilised nucleic acid probes, has been applied in studies of the interactions of nucleic acids with proteins or other targets. See also nucleic acid aptamers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09865 goldbook:09709)
AnnotationAssertion(rdfs:seeAlso goldbook:09865 goldbook:09712)
AnnotationAssertion(rdfs:seeAlso goldbook:09865 goldbook:09714)
AnnotationAssertion(mito:isMentionedBy goldbook:09865 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09865 "current"^^xsd:string)
Declaration(Class(goldbook:09866))
AnnotationAssertion(rdfs:label goldbook:09866 "chromatin immunoprecipitation")
AnnotationAssertion(dcterms:description goldbook:09866 "Method for studying deoxyribonucleic acid (DNA)–protein and/or protein–protein interactions in the context of chromatin, suitable for the identification of binding sites of proteins in genome DNA, etc. This method combines chemical cross-linking, the isolation of specific protein conjugates by immunoprecipitation, and polymerase chain reaction (PCR) amplification of co-precipitated DNA.")
AnnotationAssertion(rdfs:seeAlso goldbook:09866 goldbook:09685)
AnnotationAssertion(rdfs:seeAlso goldbook:09866 goldbook:09675)
AnnotationAssertion(mito:isMentionedBy goldbook:09866 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09866 "current"^^xsd:string)
Declaration(Class(goldbook:09867))
AnnotationAssertion(rdfs:label goldbook:09867 "cross-linking")
AnnotationAssertion(dcterms:description goldbook:09867 "Formation of a covalent bridge between two biomacromolecules or between two segments of the same biomacromolecule using reactive substances (e.g. formaldehyde, bifunctional aldehydes such as glutaraldehyde, or cisplatin) or photochemical processes.")
AnnotationAssertion(rdfs:comment goldbook:09867 "Cross-linking is used to study protein oligomerization, as well as protein–protein and nucleic acid–protein interactions"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09867 goldbook:09634)
AnnotationAssertion(rdfs:seeAlso goldbook:09867 goldbook:09866)
AnnotationAssertion(mito:isMentionedBy goldbook:09867 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09867 "current"^^xsd:string)
Declaration(Class(goldbook:09868))
AnnotationAssertion(rdfs:label goldbook:09868 "fluorescent <em>in situ</em> hybridization")
AnnotationAssertion(dcterms:description goldbook:09868 "Cytogenetic technique used to detect and localise the presence or absence of specific deoxyribonucleic acid (DNA) sequences on chromosomes. It uses fluorescent probes that only bind to those parts of the chromosome with which they show a high degree of sequence complementarity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09868 "FISH")
AnnotationAssertion(rdfs:comment goldbook:09868 "FISH is often used for finding specific features in DNA for use in genetic counselling, medicine, and species identification. FISH can also be used to detect and localise specific ribonucleic acid (RNA) targets (messenger ribonucleic acid (mRNA), long non-coding ribonucleic acid (lncRNA) and mitochondrial ribonucleic acid (miRNA)) in cells, circulating tumour cells, and tissue samples. In this context, it can help define the spatial-temporal patterns of gene expression within cells and tissues."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09868 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09868 "current"^^xsd:string)
Declaration(Class(goldbook:09869))
AnnotationAssertion(rdfs:label goldbook:09869 "groove binding")
AnnotationAssertion(dcterms:description goldbook:09869 "Process in which molecules are bound within a minor or major groove of the deoxyribonucleic acid (DNA) double helix.")
AnnotationAssertion(rdfs:seeAlso goldbook:09869 goldbook:09703)
AnnotationAssertion(mito:isMentionedBy goldbook:09869 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09869 "current"^^xsd:string)
Declaration(Class(goldbook:09870))
AnnotationAssertion(rdfs:label goldbook:09870 "hybridization assay")
AnnotationAssertion(dcterms:description goldbook:09870 "Assay with specifically designed single-stranded deoxyribonucleic acid (DNA) probe with a defined (known) nucleotide sequence usually immobilised on a surface (in such a case, the nucleic acid probe is called the capture probe).")
AnnotationAssertion(rdfs:comment goldbook:09870 "The probe is used as a recognition element to test for the nucleotide sequence within the target DNA in the sample solution. If target DNA contains a sequence complementary to the probe, a hybrid double-stranded DNA (dsDNA) is formed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09870 goldbook:09865)
AnnotationAssertion(rdfs:seeAlso goldbook:09870 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09870 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09870 "current"^^xsd:string)
Declaration(Class(goldbook:09871))
AnnotationAssertion(rdfs:label goldbook:09871 "interactome")
AnnotationAssertion(dcterms:description goldbook:09871 "Virtual map depicting protein–protein interactions.")
AnnotationAssertion(rdfs:comment goldbook:09871 "The interactome is the most visible outcome of functional proteomics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09871 goldbook:09746)
AnnotationAssertion(mito:isMentionedBy goldbook:09871 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09871 "current"^^xsd:string)
Declaration(Class(goldbook:09872))
AnnotationAssertion(rdfs:label goldbook:09872 "interactomics")
AnnotationAssertion(dcterms:description goldbook:09872 "Complex and comprehensive study of the interactions between various proteins and between protein and other molecules within a cell, such as nucleic acids and metabolites, as well as the consequences of these interactions.")
AnnotationAssertion(mito:isMentionedBy goldbook:09872 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09872 "current"^^xsd:string)
Declaration(Class(goldbook:09873))
AnnotationAssertion(rdfs:label goldbook:09873 "intermolecular interactions")
AnnotationAssertion(dcterms:description goldbook:09873 "Interactions between (parts of) two biomolecule chains (e.g. base pairing in deoxyribonucleic acid (DNA) double helix, or the interactions between two polypeptide chains, or between a DNA and a protein molecule).")
AnnotationAssertion(rdfs:seeAlso goldbook:09873 goldbook:09633)
AnnotationAssertion(rdfs:seeAlso goldbook:09873 goldbook:09703)
AnnotationAssertion(mito:isMentionedBy goldbook:09873 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09873 "current"^^xsd:string)
Declaration(Class(goldbook:09874))
AnnotationAssertion(rdfs:label goldbook:09874 "intramolecular interactions")
AnnotationAssertion(dcterms:description goldbook:09874 "Interactions between (neighbouring or distant) segments within the same biomolecule chain (e.g. base pairing in hairpin or monomolecular tetraplex structures of deoxyribonucleic acid (DNA) or ribonucleic acid (RNA), the interactions stabilizing the secondary or tertiary structures of proteins, etc.).")
AnnotationAssertion(rdfs:seeAlso goldbook:09874 goldbook:09633)
AnnotationAssertion(rdfs:seeAlso goldbook:09874 goldbook:09785)
AnnotationAssertion(mito:isMentionedBy goldbook:09874 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09874 "current"^^xsd:string)
Declaration(Class(goldbook:09875))
AnnotationAssertion(rdfs:label goldbook:09875 "non-covalent interactions")
AnnotationAssertion(dcterms:description goldbook:09875 "Interactions between biomolecules or within a biomolecule (e.g. hydrogen bonds, electrostatic interactions, and van der Waals forces) taking part in the stabilization of proper biomolecule structure and intermolecular interactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:09875 goldbook:09633)
AnnotationAssertion(rdfs:seeAlso goldbook:09875 goldbook:09873)
AnnotationAssertion(mito:isMentionedBy goldbook:09875 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09875 "current"^^xsd:string)
Declaration(Class(goldbook:09876))
AnnotationAssertion(rdfs:label goldbook:09876 "non-specific binding")
AnnotationAssertion(dcterms:description goldbook:09876 "Binding of a protein to deoxyribonucleic acid (DNA) independent of the nucleotide sequence or the conformation of the DNA, often with a strong contribution of electrostatic interaction between the negatively charged sugar-phosphate backbone of the DNA and basic amino acid residues of the protein.")
AnnotationAssertion(rdfs:seeAlso goldbook:09876 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09876 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09876 "current"^^xsd:string)
Declaration(Class(goldbook:09877))
AnnotationAssertion(rdfs:label goldbook:09877 "nucleic acid–protein interaction")
AnnotationAssertion(dcterms:description goldbook:09877 "Formation of specific or non-specific complexes between deoxyribonucleic acid (DNA) or ribonucleic acid (RNA) and proteins, mediated and stabilised by a network of non-covalent interactions.")
AnnotationAssertion(rdfs:comment goldbook:09877 "Nucleic acid–protein interactions are critical for basic cellular functions such as replication, transcription, translation, recombination, DNA repair etc. as well as for fine regulation of them. Proteins may bind more tightly to specific sequences in the nucleic acid or non-specifically, in which case their affinity is independent of sequence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09877 goldbook:09661)
AnnotationAssertion(rdfs:seeAlso goldbook:09877 goldbook:09875)
AnnotationAssertion(rdfs:seeAlso goldbook:09877 goldbook:09722)
AnnotationAssertion(mito:isMentionedBy goldbook:09877 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09877 "current"^^xsd:string)
Declaration(Class(goldbook:09878))
AnnotationAssertion(rdfs:label goldbook:09878 "protein–protein interaction")
AnnotationAssertion(dcterms:description goldbook:09878 "Association of one protein with one or more other proteins to form either homo- or heteromeric proteins or protein complexes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09878 "PPI")
AnnotationAssertion(rdfs:comment goldbook:09878 "Such associations are common in biological systems and are responsible for the regulation of numerous cellular functions in addition to the mediation of disease morphology, where aberrant interactions play a significant role."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09878 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09878 "current"^^xsd:string)
Declaration(Class(goldbook:09879))
AnnotationAssertion(rdfs:label goldbook:09879 "pull-down assay")
AnnotationAssertion(dcterms:description goldbook:09879 "Approach used for studying protein–protein interactions analogous to immunoprecipitation, using (instead of antibody) one of the interacting proteins (the 'bait') immobilised at a surface to capture the other protein (the 'prey').")
AnnotationAssertion(rdfs:seeAlso goldbook:09879 goldbook:09675)
AnnotationAssertion(rdfs:seeAlso goldbook:09879 goldbook:09878)
AnnotationAssertion(mito:isMentionedBy goldbook:09879 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09879 "current"^^xsd:string)
Declaration(Class(goldbook:09880))
AnnotationAssertion(rdfs:label goldbook:09880 "reporter probe")
AnnotationAssertion(dcterms:description goldbook:09880 "Specifically designed single-stranded deoxyribonucleic acid (ssDNA) (alternatively, ribonucleic acid (RNA) or a synthetic nucleic acid analogue such as locked nucleic acid (LNA) or peptide nucleic acid (PNA)) with a defined (known) nucleotide sequence used to detect complementary DNA or RNA sequence in a sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09880 "signalling probe")
AnnotationAssertion(rdfs:comment goldbook:09880 "Reporter probe is usually labelled (radioactively, immunologically, or by fluorescent, electroactive, or other species to produce a specific signal upon hybridization)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09880 "Similar to capture probes, nucleic acid signalling probes (or nucleic acid aptamers) can be applied in studies of nucleic acid interactions with proteins and other ligands."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09880 goldbook:09709)
AnnotationAssertion(rdfs:seeAlso goldbook:09880 goldbook:09712)
AnnotationAssertion(rdfs:seeAlso goldbook:09880 goldbook:09714)
AnnotationAssertion(mito:isMentionedBy goldbook:09880 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09880 "current"^^xsd:string)
Declaration(Class(goldbook:09881))
AnnotationAssertion(rdfs:label goldbook:09881 "specific binding")
AnnotationAssertion(dcterms:description goldbook:09881 "Binding of proteins to specific sites in deoxyribonucleic acid (DNA) based on the precise recognition of nucleotide sequence and/or conformation of the DNA.")
AnnotationAssertion(rdfs:comment goldbook:09881 "Sequence-specific DNA binding is typical for restriction enzymes, transcription factors and other proteins involved in cellular regulation, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09881 goldbook:09712)
AnnotationAssertion(mito:isMentionedBy goldbook:09881 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09881 "current"^^xsd:string)
Declaration(Class(goldbook:09882))
AnnotationAssertion(rdfs:label goldbook:09882 "stacking interactions")
AnnotationAssertion(dcterms:description goldbook:09882 "Attractive interaction between planar aromatic rings, in nucleic acids being one of the critical forces stabilizing double- and multistranded structures.")
AnnotationAssertion(rdfs:comment goldbook:09882 "Stacking interactions are involved in binding of intercalators to DNA."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09882 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09882 "current"^^xsd:string)
Declaration(Class(goldbook:09883))
AnnotationAssertion(rdfs:label goldbook:09883 "Tunel test")
AnnotationAssertion(dcterms:description goldbook:09883 "Method for the determination of strand breaks and DNA fragmentation in cells based on labelling and quantification of free 3′-OH ends of deoxyribonucleic acid (DNA).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09883 "TUNEL")
AnnotationAssertion(rdfs:comment goldbook:09883 "The abbreviation is for terminal deoxynucleotidyl transferase dUTP nick end labelling (TUNEL)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09883 goldbook:09696)
AnnotationAssertion(rdfs:seeAlso goldbook:09883 goldbook:09729)
AnnotationAssertion(mito:isMentionedBy goldbook:09883 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09883 "current"^^xsd:string)
Declaration(Class(goldbook:09884))
AnnotationAssertion(rdfs:label goldbook:09884 "two hybrid system")
AnnotationAssertion(dcterms:description goldbook:09884 "Molecular biology method for studying protein–protein or protein–deoxyribonucleic acid (DNA) interactions in cellular (yeast or bacterial) milieu.")
AnnotationAssertion(rdfs:comment goldbook:09884 "This method involves a transcription factor split into two separate domains (DNA binding and transcription activating), one of which is fused with one of the tested proteins (the \"bait\") and the other with another tested protein (the \"prey\"), as well as with a reporter gene construct. Only upon physical interaction between bait and prey is the expression of the reporter gene observed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09884 goldbook:09878)
AnnotationAssertion(mito:isMentionedBy goldbook:09884 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09884 "current"^^xsd:string)
Declaration(Class(goldbook:09885))
AnnotationAssertion(rdfs:label goldbook:09885 "chromatographic bed")
AnnotationAssertion(dcterms:description goldbook:09885 "Form in which the stationary phase is used.")
AnnotationAssertion(mito:isMentionedBy goldbook:09885 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09885 "current"^^xsd:string)
Declaration(Class(goldbook:09886))
AnnotationAssertion(rdfs:label goldbook:09886 "immobilized stationary phase")
AnnotationAssertion(dcterms:description goldbook:09886 "Stationary phase which has been immobilized on the support particles or on the inner wall of the column, e.g. by a physical attraction (coated stationary phase), by chemical bonding (bonded stationary phase), or by in situ polymerisation (cross-linked stationary phase) after coating.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09886 "immobilized stationary phase material")
AnnotationAssertion(mito:isMentionedBy goldbook:09886 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09886 "current"^^xsd:string)
Declaration(Class(goldbook:09887))
AnnotationAssertion(rdfs:label goldbook:09887 "countercurrent chromatography")
AnnotationAssertion(dcterms:description goldbook:09887 "Partition chromatography which uses two immiscible liquid phases and no solid support. One liquid acts as the stationary phase and the other as the mobile phase.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09887 "CCC")
AnnotationAssertion(rdfs:comment goldbook:09887 "The method employs a variety of systems using either gravity or centrifugal force to retain the stationary phase in the column."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09887 "The method allows continuous elution of the mobile phase and on-line monitoring of the effluent."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09887 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09887 "current"^^xsd:string)
Declaration(Class(goldbook:09888))
AnnotationAssertion(rdfs:label goldbook:09888 "enantioselective chromatography")
AnnotationAssertion(dcterms:description goldbook:09888 "Separation of enantiomeric species due to the enantioselectivity of their interaction with the chiral selector(s) of a chromatographic (electrophoretic) system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09888 "chiral chromatography")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09888 "chiral electrophoresis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09888 "enantioselective electrophoresis")
AnnotationAssertion(mito:isMentionedBy goldbook:09888 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09888 "current"^^xsd:string)
Declaration(Class(goldbook:09889))
AnnotationAssertion(rdfs:label goldbook:09889 "hydrodynamic chromatography")
AnnotationAssertion(dcterms:description goldbook:09889 "Liquid chromatography for the separation of macromolecules and particles based on the difference in the speed of the mobile phase flow between the column axis and column wall and the specific size-dependent distribution of particles across the column cross-section.")
AnnotationAssertion(mito:isMentionedBy goldbook:09889 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09889 "current"^^xsd:string)
Declaration(Class(goldbook:09890))
AnnotationAssertion(rdfs:label goldbook:09890 "hydrophilic-interaction liquid chromatography")
AnnotationAssertion(dcterms:description goldbook:09890 "Liquid chromatography in which the molecules are partitioned between a water-enriched layer, which is immobilised on a hydrophilic (polar) stationary phase, and a less-polar mobile phase, containing water and organic solvent.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09890 "HILIC")
AnnotationAssertion(mito:isMentionedBy goldbook:09890 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09890 "current"^^xsd:string)
Declaration(Class(goldbook:09891))
AnnotationAssertion(rdfs:label goldbook:09891 "hydrophobic-interaction chromatography")
AnnotationAssertion(dcterms:description goldbook:09891 "Chromatography in which molecules are separated by interactions between their hydrophobic moieties and hydrophobic sites on the surface of the stationary phase.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09891 "HIC")
AnnotationAssertion(rdfs:comment goldbook:09891 "High salt concentrations are used in the mobile phase and separations are effected by changing the salt concentration. Gradients are run by decreasing the salt concentration over time."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09891 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09891 "current"^^xsd:string)
Declaration(Class(goldbook:09892))
AnnotationAssertion(rdfs:label goldbook:09892 "ion-exclusion chromatography")
AnnotationAssertion(dcterms:description goldbook:09892 "Exclusion chromatography in which ionized compounds are excluded from the pores of the support and elute first, while weakly ionized and non-ionic compounds elute later.")
AnnotationAssertion(mito:isMentionedBy goldbook:09892 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09892 "current"^^xsd:string)
Declaration(Class(goldbook:09893))
AnnotationAssertion(rdfs:label goldbook:09893 "ion-pair chromatography")
AnnotationAssertion(dcterms:description goldbook:09893 "Liquid chromatography in which the mobile liquid phase contains an ionized additive (an ion-pair reagent) that can form an ion pair with an analyte molecule.")
AnnotationAssertion(rdfs:comment goldbook:09893 "Separations occur due to the difference in the ability to form ion pairs and/or in the distribution coefficients of the ion pairs between the mobile and stationary phases."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09893 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09893 "current"^^xsd:string)
Declaration(Class(goldbook:09894))
AnnotationAssertion(rdfs:label goldbook:09894 "ligand exchange chromatography")
AnnotationAssertion(dcterms:description goldbook:09894 "Chromatography based on the different ability of substances to form complexes with metal ions.")
AnnotationAssertion(mito:isMentionedBy goldbook:09894 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09894 "current"^^xsd:string)
Declaration(Class(goldbook:09895))
AnnotationAssertion(rdfs:label goldbook:09895 "micellar chromatography")
AnnotationAssertion(dcterms:description goldbook:09895 "Reversed-phase liquid chromatography which uses a mobile phase containing a surfactant above its critical micellar concentration (cmc).")
AnnotationAssertion(mito:isMentionedBy goldbook:09895 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09895 "current"^^xsd:string)
Declaration(Class(goldbook:09896))
AnnotationAssertion(rdfs:label goldbook:09896 "isocratic elution")
AnnotationAssertion(dcterms:description goldbook:09896 "Chromatography in which the composition of the mobile phase remains constant during elution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09896 "isocratic analysis")
AnnotationAssertion(mito:isMentionedBy goldbook:09896 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09896 "current"^^xsd:string)
Declaration(Class(goldbook:09897))
AnnotationAssertion(rdfs:label goldbook:09897 "column diameter")
AnnotationAssertion(dcterms:description goldbook:09897 "Inner diameter of the column tubing.")
AnnotationAssertion(rdfs:comment goldbook:09897 "The column radius \\(r_{\\rm{c}} = d_{\\rm{c}}/2\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09897 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09897 "current"^^xsd:string)
Declaration(Class(goldbook:09898))
AnnotationAssertion(rdfs:label goldbook:09898 "column length")
AnnotationAssertion(dcterms:description goldbook:09898 "Length of that part of the column tube that contains the stationary phase.")
AnnotationAssertion(mito:isMentionedBy goldbook:09898 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09898 "current"^^xsd:string)
Declaration(Class(goldbook:09899))
AnnotationAssertion(rdfs:label goldbook:09899 "cross-sectional area of the column")
AnnotationAssertion(dcterms:description goldbook:09899 "Cross-sectional area of the empty tube: \\(A_{\\rm{c}} = \\pi r_{\\rm{c}}^{2} = \\pi (d_{\\rm{c}}/2)^{2}\\), where \\(d_{\\rm{c}}\\) is the column diameter.")
AnnotationAssertion(rdfs:seeAlso goldbook:09899 goldbook:09897)
AnnotationAssertion(mito:isMentionedBy goldbook:09899 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09899 "current"^^xsd:string)
Declaration(Class(goldbook:09900))
AnnotationAssertion(rdfs:label goldbook:09900 "liquid-phase film thickness")
AnnotationAssertion(dcterms:description goldbook:09900 "Average thickness of the liquid stationary phase film coated on the inside wall of the column tubing of an open-tubular column.")
AnnotationAssertion(mito:isMentionedBy goldbook:09900 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09900 "current"^^xsd:string)
Declaration(Class(goldbook:09901))
AnnotationAssertion(rdfs:label goldbook:09901 "monolithic column")
AnnotationAssertion(dcterms:description goldbook:09901 "Column packed with a single piece of solid material (monolith) composed of interconnected skeletons (forming macropores) and interconnected flow paths (mesopores) as a stationary phase material.")
AnnotationAssertion(mito:isMentionedBy goldbook:09901 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09901 "current"^^xsd:string)
Declaration(Class(goldbook:09902))
AnnotationAssertion(rdfs:label goldbook:09902 "asymmetry factor")
AnnotationAssertion(dcterms:description goldbook:09902 "Width of a peak (\\(f + b\\)) divided by twice the width of the front of the peak (\\(f\\)), measured at \\(\\pu{10\\%}\\) of the peak height (see figure). \\[A_{\\rm{s}} = \\frac{(f + b)}{2f}\\] Peak asymmetry (schematic). \\(R_{\\rm{D}}\\) is the response of the detector.Peak asymmetry (schematic). \\(R_{\\rm{D}}\\) is the response of the detector.")
AnnotationAssertion(rdfs:comment goldbook:09902 "For a symmetrical peak \\(A_{\\rm{s}} = 1\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09902 "Some pharmacopoeia definitions of peak asymmetry measure the value at \\(\\pu{5\\%}\\) of the peak height."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09902 goldbook:09905)
AnnotationAssertion(mito:isMentionedBy goldbook:09902 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09902 "current"^^xsd:string)
Declaration(Class(goldbook:09903))
AnnotationAssertion(rdfs:label goldbook:09903 "peak width at base")
AnnotationAssertion(dcterms:description goldbook:09903 "Peak width at peak base intercepted by tangents to the chromatogram drawn at the inflection points on either side of the peak. Represented by the line AB in the peak height figure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09903 "base width")
AnnotationAssertion(mito:isMentionedBy goldbook:09903 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09903 "current"^^xsd:string)
Declaration(Class(goldbook:09904))
AnnotationAssertion(rdfs:label goldbook:09904 "peak width at half height")
AnnotationAssertion(dcterms:description goldbook:09904 "Peak width at \\(\\pu{50\\%}\\) of the peak height that terminates at the intersections with the peak.")
AnnotationAssertion(rdfs:comment goldbook:09904 "The peak width at half height must never be called the \"half width\" because that has a completely different meaning."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09904 "The peak width at half height of a Gaussian peak is about 2.355 times the standard deviation of the modelled Gaussian. See figure in peak height."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09904 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09904 "current"^^xsd:string)
Declaration(Class(goldbook:09905))
AnnotationAssertion(rdfs:label goldbook:09905 "tailing factor")
AnnotationAssertion(dcterms:description goldbook:09905 "Width of the back of a peak (\\(b\\)) divided by the width of the front (\\(f\\)) of the peak measured at \\(\\pu{10\\%}\\) of the peak height. See figure in asymmetry factor.")
AnnotationAssertion(rdfs:seeAlso goldbook:09905 goldbook:09902)
AnnotationAssertion(mito:isMentionedBy goldbook:09905 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09905 "current"^^xsd:string)
Declaration(Class(goldbook:09906))
AnnotationAssertion(rdfs:label goldbook:09906 "effective plate height")
AnnotationAssertion(dcterms:description goldbook:09906 "Column length (\\(L\\)) divided by effective plate number (\\(N_{\\rm{eff}}\\)): \\[H_{\\rm{eff}} = \\frac{L}{N_{\\rm{eff}}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09906 "height equivalent to one effective plate")
AnnotationAssertion(rdfs:seeAlso goldbook:09906 goldbook:09898)
AnnotationAssertion(rdfs:seeAlso goldbook:09906 goldbook:09907)
AnnotationAssertion(mito:isMentionedBy goldbook:09906 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09906 "current"^^xsd:string)
Declaration(Class(goldbook:09907))
AnnotationAssertion(rdfs:label goldbook:09907 "effective plate number")
AnnotationAssertion(dcterms:description goldbook:09907 "Number indicative of column performance, calculated from the ratios of measures of adjusted retention and peak width: \\[\\eqalign{& N_{\\rm{eff}} = \\left(\\frac{V_{\\rm{R}}^{\\prime}}{\\sigma} \\right)^{2} = \\left(\\frac{t_{\\rm{R}}^{\\prime}}{\\sigma} \\right)^{2} \\cr & N_{\\rm{eff}} = 16 \\left(\\frac{V_{\\rm{R}}^{\\prime}}{w_{\\rm{b}}} \\right)^{2} = 16 \\left(\\frac{t_{\\rm{R}}^{\\prime}}{w_{\\rm{b}}} \\right)^{2} \\cr & N_{\\rm{eff}} \\approx 5.545 \\left(\\frac{V_{\\rm{R}}^{\\prime}}{w_{\\rm{h}}} \\right)^{2} \\approx 5.545 \\left(\\frac{t_{\\rm{R}}^{\\prime}}{w_{\\rm{h}}} \\right)^{2}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09907 "number of effective plates")
AnnotationAssertion(rdfs:comment goldbook:09907 "\\(V_{\\rm{R}}^{\\prime}\\): adjusted retention volume; \\(t_{\\rm{R}}^{\\prime}\\): total retention time; \\(\\sigma\\): standard deviation of the Gaussian peak; \\(w_{\\rm{b}}\\): peak width at base; \\(w_{\\rm{h}}\\): peak width at half height; \\(\\rm{8 \\ln 2} ≈ 5.545\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09907 "These expressions assume a Gaussian (symmetrical) peak."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09907 "Units for the quantities being divided must be consistent so that their ratio is dimensionless: i.e. if the numerator is a time, then peak width must also be expressed in terms of time"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09907 "The plate number is related to the effective plate number and retention factor (\\(k\\)) \\(N = N_{\\rm{eff}}{\\left(\\frac{{k + 1}}{k} \\right)^2}\\)"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09907 goldbook:09903)
AnnotationAssertion(rdfs:seeAlso goldbook:09907 goldbook:09904)
AnnotationAssertion(rdfs:seeAlso goldbook:09907 goldbook:10039)
AnnotationAssertion(mito:isMentionedBy goldbook:09907 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09907 "current"^^xsd:string)
Declaration(Class(goldbook:09908))
AnnotationAssertion(rdfs:label goldbook:09908 "reduced plate height")
AnnotationAssertion(dcterms:description goldbook:09908 "In liquid chromatography plate height divided by average particle diameter. \\[h = H/d_{\\rm{p}}\\]")
AnnotationAssertion(rdfs:comment goldbook:09908 "For open-tubular columns \\(h\\) is the plate height divided by the column diameter, \\(h = H/d_{\\rm{c}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09908 goldbook:09897)
AnnotationAssertion(mito:isMentionedBy goldbook:09908 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09908 "current"^^xsd:string)
Declaration(Class(goldbook:09909))
AnnotationAssertion(rdfs:label goldbook:09909 "detector")
AnnotationAssertion(dcterms:description goldbook:09909 "Sensor that responds to components in the effluent.")
AnnotationAssertion(mito:isMentionedBy goldbook:09909 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09909 "current"^^xsd:string)
Declaration(Class(goldbook:09911))
AnnotationAssertion(rdfs:label goldbook:09911 "capillary affinity electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09911 "Capillary electrophoresis in which the background electrolyte contains substances capable of specific, often biospecific, interactions with the analytes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09911 "CAE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09911 "ACE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09911 "affinity capillary electrophoresis")
AnnotationAssertion(rdfs:comment goldbook:09911 "Biospecific compounds can be already in the sample (receptor-acceptor formation under applied electric field, or the bioselective compounds may be attached on the capillary inner wall before the analysis starts. They are bound covalently or dynamically on the surface."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09911 goldbook:09913)
AnnotationAssertion(mito:isMentionedBy goldbook:09911 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09911 "current"^^xsd:string)
Declaration(Class(goldbook:09912))
AnnotationAssertion(rdfs:label goldbook:09912 "capillary electrochromatography")
AnnotationAssertion(dcterms:description goldbook:09912 "Liquid chromatography, where the movement of the mobile phase through a capillary, filled, packed, or coated with a stationary phase, is achieved by electroosmotic flow (which may be assisted by pressure).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09912 "CEC")
AnnotationAssertion(rdfs:comment goldbook:09912 "The retention time is determined by a combination of electrophoretic migration and chromatographic retention."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09912 goldbook:09963)
AnnotationAssertion(mito:isMentionedBy goldbook:09912 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09912 "current"^^xsd:string)
Declaration(Class(goldbook:09913))
AnnotationAssertion(rdfs:label goldbook:09913 "capillary electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09913 "Separation method based solely on the differences in the electrophoretic mobilities of charged species in capillaries.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09913 "CE")
AnnotationAssertion(rdfs:comment goldbook:09913 "The background electrolyte may be an aqueous or non-aqueous solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09913 "The electrolytes can contain additives, which can interact with the charged species and alter their electrophoretic mobilities."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09913 "The use of the term capillary electrophoresis (CE) as a collective term for all capillary electromigration techniques is not recommended, as some of these techniques involve separation mechanisms other than electrophoresis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09913 "The basic kind of CE is capillary zone electrophoresis in which separation takes place in the homogeneous solution of the background electrolyte on the basis of different electrophoretic mobilities of analytes in a free solution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09913 goldbook:09911)
AnnotationAssertion(mito:isMentionedBy goldbook:09913 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09913 "current"^^xsd:string)
Declaration(Class(goldbook:09914))
AnnotationAssertion(rdfs:label goldbook:09914 "capillary gel electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09914 "Capillary sieving electrophoresis in which the capillary is filled with a gel.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09914 "CGE")
AnnotationAssertion(rdfs:seeAlso goldbook:09914 goldbook:09917)
AnnotationAssertion(mito:isMentionedBy goldbook:09914 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09914 "current"^^xsd:string)
Declaration(Class(goldbook:09915))
AnnotationAssertion(rdfs:label goldbook:09915 "capillary isoelectric focusing")
AnnotationAssertion(dcterms:description goldbook:09915 "Electrophoretic technique for the separation of analytes according to their isoelectric points by an electric field along a pH gradient formed in a capillary.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09915 "CIEF")
AnnotationAssertion(mito:isMentionedBy goldbook:09915 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09915 "current"^^xsd:string)
Declaration(Class(goldbook:09916))
AnnotationAssertion(rdfs:label goldbook:09916 "capillary isotachophoresis")
AnnotationAssertion(dcterms:description goldbook:09916 "Electrophoretic separation technique in a discontinuous buffer system in which analytes migrate according to their electrophoretic mobilities, forming a chain of adjacent zones moving with equal speed (velocity) between two solutions, leading and terminating electrolytes, bracketing the mobility range of the analytes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09916 "CITP")
AnnotationAssertion(mito:isMentionedBy goldbook:09916 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09916 "current"^^xsd:string)
Declaration(Class(goldbook:09917))
AnnotationAssertion(rdfs:label goldbook:09917 "capillary sieving electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09917 "Electrophoretic separation technique, which takes place in a capillary containing a medium in the background electrolyte that retains molecules and particles based on their size and shape.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09917 "CSE")
AnnotationAssertion(rdfs:comment goldbook:09917 "The medium may be an entangled polymer network."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09917 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09917 "current"^^xsd:string)
Declaration(Class(goldbook:09918))
AnnotationAssertion(rdfs:label goldbook:09918 "effective length of the capillary")
AnnotationAssertion(dcterms:description goldbook:09918 "Length of the capillary from the sample introduction point to the detection point.")
AnnotationAssertion(mito:isMentionedBy goldbook:09918 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09918 "current"^^xsd:string)
Declaration(Class(goldbook:09919))
AnnotationAssertion(rdfs:label goldbook:09919 "electrokinetic chromatography")
AnnotationAssertion(dcterms:description goldbook:09919 "Separation method based on a combination of electrophoresis and interactions of the analytes with additives (e.g. surfactants), which form a dispersed phase moving at a different speed (velocity). In order to achieve separation, either the analytes or this secondary phase should be charged.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09919 "electrokinetic capillary chromatography")
AnnotationAssertion(rdfs:comment goldbook:09919 " This is not totally compatible with the definition of chromatography."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09919 "Surfactants must be at concentrations above their critical micelle concentration for being able to form a dispersed phase – otherwise they will just act as ion-pair reagents."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09919 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09919 "current"^^xsd:string)
Declaration(Class(goldbook:09920))
AnnotationAssertion(rdfs:label goldbook:09920 "electrokinetic injection")
AnnotationAssertion(dcterms:description goldbook:09920 "Injection of the analytical sample by applying a potential across the sample and capillary and using the electroosmotic flow to draw an aliquot into the end of the capillary tube. The sample is then replaced by the running electrolyte for the separation to take place.")
AnnotationAssertion(mito:isMentionedBy goldbook:09920 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09920 "current"^^xsd:string)
Declaration(Class(goldbook:09921))
AnnotationAssertion(rdfs:label goldbook:09921 "electroosmosis")
AnnotationAssertion(dcterms:description goldbook:09921 "Motion of a liquid through a capillary (or membrane or plug) because of the application of an electric field across the capillary (or membrane or plug).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09921 "electro-osmosis")
AnnotationAssertion(mito:isMentionedBy goldbook:09921 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09921 "current"^^xsd:string)
Declaration(Class(goldbook:09922))
AnnotationAssertion(rdfs:label goldbook:09922 "electroosmotic velocity")
AnnotationAssertion(dcterms:description goldbook:09922 "Effective length of the capillary (\\(L_{\\rm{eff}}\\)) divided by the electroosmotic hold-up time (\\(t_{\\rm{eo}}\\)). \\[\\boldsymbol{v}_{\\rm{eo}} = L_{\\rm{eff}}/t_{\\rm{eo}}\\]")
AnnotationAssertion(rdfs:comment goldbook:09922 "In capillary electromigration, this velocity is positive, by convention, in the direction from the sample introduction end of the capillary to the detection end, otherwise negative."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09922 goldbook:09918)
AnnotationAssertion(rdfs:seeAlso goldbook:09922 goldbook:09921)
AnnotationAssertion(mito:isMentionedBy goldbook:09922 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09922 "current"^^xsd:string)
Declaration(Class(goldbook:09923))
AnnotationAssertion(rdfs:label goldbook:09923 "electroosmotic volume flow rate")
AnnotationAssertion(dcterms:description goldbook:09923 "Volume flow rate divided by electric field strength through the whole plug or capillary.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09923 "electroosmotic volume flow")
AnnotationAssertion(mito:isMentionedBy goldbook:09923 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09923 "current"^^xsd:string)
Declaration(Class(goldbook:09924))
AnnotationAssertion(rdfs:label goldbook:09924 "electrostacking")
AnnotationAssertion(dcterms:description goldbook:09924 "Methods that use differences in migration behaviour in spatially defined regions of the capillary of different field strengths (conductivities).")
AnnotationAssertion(rdfs:comment goldbook:09924 "Electrostacking methods can be used to concentrate dilute samples."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09924 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09924 "current"^^xsd:string)
Declaration(Class(goldbook:09925))
AnnotationAssertion(rdfs:label goldbook:09925 "hydrodynamic injection")
AnnotationAssertion(dcterms:description goldbook:09925 "Introduction of the analytical sample into a capillary by a pressure difference between the ends of the capillary.")
AnnotationAssertion(mito:isMentionedBy goldbook:09925 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09925 "current"^^xsd:string)
Declaration(Class(goldbook:09926))
AnnotationAssertion(rdfs:label goldbook:09926 "immunoelectrophoresis")
AnnotationAssertion(dcterms:description goldbook:09926 "Biochemical methods for separation and characterization of proteins based on electrophoresis and reaction with antibodies.")
AnnotationAssertion(mito:isMentionedBy goldbook:09926 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09926 "current"^^xsd:string)
Declaration(Class(goldbook:09927))
AnnotationAssertion(rdfs:label goldbook:09927 "micellar electrokinetic chromatography")
AnnotationAssertion(dcterms:description goldbook:09927 "Electrokinetic chromatography, in which the secondary phase is a micellar dispersed phase in the capillary.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09927 "micellar electrokinetic capillary chromatography")
AnnotationAssertion(rdfs:seeAlso goldbook:09927 goldbook:09919)
AnnotationAssertion(mito:isMentionedBy goldbook:09927 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09927 "current"^^xsd:string)
Declaration(Class(goldbook:09928))
AnnotationAssertion(rdfs:label goldbook:09928 "microemulsion electrokinetic chromatography")
AnnotationAssertion(dcterms:description goldbook:09928 "Electrokinetic chromatography, where a microemulsion is employed as the dispersed phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09928 "microemulsion electrokinetic capillary chromatography")
AnnotationAssertion(rdfs:seeAlso goldbook:09928 goldbook:09919)
AnnotationAssertion(mito:isMentionedBy goldbook:09928 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09928 "current"^^xsd:string)
Declaration(Class(goldbook:09929))
AnnotationAssertion(rdfs:label goldbook:09929 "non-aqueous capillary electrophoresis")
AnnotationAssertion(dcterms:description goldbook:09929 "Capillary electrophoresis, which uses water-free organic solutions and modifiers to produce ions in solution.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09929 "NACE")
AnnotationAssertion(rdfs:comment goldbook:09929 "Typical organic solvents are methanol, ethanol, propanol, and acetonitrile."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09929 "Typical modifiers are acetic acid, sodium acetate, ammonium acetate, ammonium chloride and ammonium hydroxide (non aqueous)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09929 goldbook:09913)
AnnotationAssertion(mito:isMentionedBy goldbook:09929 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09929 "current"^^xsd:string)
Declaration(Class(goldbook:09930))
AnnotationAssertion(rdfs:label goldbook:09930 "sample introduction")
AnnotationAssertion(dcterms:description goldbook:09930 "In isotachophoresis a sample is introduced between a zone of fast leading electrolyte and a zone of slow terminating electrolyte.")
AnnotationAssertion(rdfs:comment goldbook:09930 "Usually, the leading and terminating electrolytes have a common counter-ion, but the co-ions are different."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09930 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09930 "current"^^xsd:string)
Declaration(Class(goldbook:09931))
AnnotationAssertion(rdfs:label goldbook:09931 "asymmetrical flow field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09931 "Flow field-flow fractionation in which only one channel wall is permeable, meaning there is one channel inlet for the flow during the run and some of the channel flow is directed through the accumulation wall.")
AnnotationAssertion(rdfs:comment goldbook:09931 "In a uniform width channel this would result in the channel flow decreasing dramatically along the channel length. In order to minimize this, a trapezoid shape of the separation channel has been developed for AsFlFFF. In general, the channel geometry significantly affects the separation efficiency in AF4."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09931 "Three different channel designs were evaluated using polystyrene latex nanoparticles. The channel breadth was held constant for one (rectangular) profile, and was reduced either linearly (trapezoid profile) or exponentially (exponential profile) along the length for the other two channels. Com-pared with a rectangular channel, trapezoid and exponential profiles provided better performance of AsFlFFF and allowed band broadening to be reduced."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09931 "Advantages of AsFlFFF include that the upper channel wall can be made of a transparent material, allowing the accumulation and sample migration to be viewed. Sample focusing can be achieved during relaxation, resulting in a narrower sample band being produced, resulting in lower band broadening."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09931 goldbook:09935)
AnnotationAssertion(mito:isMentionedBy goldbook:09931 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09931 "current"^^xsd:string)
Declaration(Class(goldbook:09932))
AnnotationAssertion(rdfs:label goldbook:09932 "Brownian field-flow fractionation mode")
AnnotationAssertion(dcterms:description goldbook:09932 "Mechanism of field-flow fractionation of sub-micron particles that relies on Brownian motion.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09932 "BFFF")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09932 "BFFF mode")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09932 "NFFF mode")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09932 "normal FFF")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09932 "normal FFF mode (NFFF)")
AnnotationAssertion(rdfs:comment goldbook:09932 "BFFF mode requires a specific sample injection procedure described as stop-flow injection or a relaxation step. A relaxation time is needed to equilibrate the sample under the influence of a force field and Brownian diffusion in the absence of flow. The injected sample is forced to concentrate in a thin layer adjacent to the accumulation wall (channel bottom)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09932 "When the flow is switched on, elution begins with smaller particles, which are distributed further away from the accumulation wall and thus protrude further into the faster flow streams; larger particles elute later."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09932 "Two main factors influencing the sample behaviour in BFFF mode are the properties of particles characterized by the diffusion coefficient and the strength of the cross-field applied."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09932 goldbook:09943)
AnnotationAssertion(rdfs:seeAlso goldbook:09932 goldbook:09934)
AnnotationAssertion(mito:isMentionedBy goldbook:09932 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09932 "current"^^xsd:string)
Declaration(Class(goldbook:09933))
AnnotationAssertion(rdfs:label goldbook:09933 "coiled-tube field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09933 "Field-flow fractionation in a long (usually \\(\\pu{10 m}\\) or more) rotating coiled column under the action of asymmetrical centrifugal field.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09933 "CTFFF")
AnnotationAssertion(rdfs:comment goldbook:09933 "CTFFF can be attributed to non-conventional sedimentation field-flow fractionation (SdFFF), which enables the sample mass to be increased to gram levels."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09933 "The complex asymmetrical force field is generated in planetary centrifuges where the column drum rotates around its own axis and at the same time revolves around the central axis of the centrifuge."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09933 goldbook:09934)
AnnotationAssertion(rdfs:seeAlso goldbook:09933 goldbook:09938)
AnnotationAssertion(mito:isMentionedBy goldbook:09933 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09933 "current"^^xsd:string)
Declaration(Class(goldbook:09934))
AnnotationAssertion(rdfs:label goldbook:09934 "field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09934 "Separation based on the retention and elution of macromolecular, colloidal, and particulate matter achieved by the combined action of the non-uniform flow speed (velocity) profile of a carrier fluid (mobile phase) and a physical force field (e.g. gravitational, centrifugal, electrical) applied at right angles to a thin (\\(\\pu{0.05 mm}\\) to \\(\\pu{0.5 mm}\\)) channel (see figure). Basic principle of field-flow fractionation.Basic principle of field-flow fractionation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09934 "FFF")
AnnotationAssertion(rdfs:comment goldbook:09934 "Although similar to liquid chromatography, FFF requires no stationary phase, so the separation channel contains no packing material and only physical interactions are involved in the separation process."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09934 "FFF is applicable to the fractionation and characterization of colloidal and solid particles, polymers, and biological cells in the size range from \\(\\pu{1 nm}\\) to \\(\\pu{50 \\upmu m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09934 "The sample mass injected is usually less than \\(\\pu{1 mg}\\) to avoid overloading."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09934 goldbook:09943)
AnnotationAssertion(mito:isMentionedBy goldbook:09934 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09934 "current"^^xsd:string)
Declaration(Class(goldbook:09935))
AnnotationAssertion(rdfs:label goldbook:09935 "flow field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09935 "Field-flow fractionation in which the physical force field is a nonspecific hydrodynamic force field across the channel, generated by a secondary mobile phase cross-flow in addition to the normal channel flow.")
AnnotationAssertion(rdfs:comment goldbook:09935 "The sample components are driven by the cross-flow toward the accumulation wall, which consists of porous frit covered with a permeable membrane."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09935 "Like sedimentation field-flow fractionation (SdFFF), FlFFF can be used for submicron particles and macromolecules using the Brownian field-flow fractionation mode or micron size particles utilizing the hyperlayer mode."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09935 "This technique can be applied to the size fractionation of different synthetic polymers, liposomes, proteins, viruses, dissolved organic matter, humic and fulvic acids as well as their complexes with trace metals, diesel soot particles, marine colloids, heterogeneous and arbitrarily shaped natural colloidal particles, gold colloid standards starting from 5 nm."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09935 goldbook:09932)
AnnotationAssertion(rdfs:seeAlso goldbook:09935 goldbook:09934)
AnnotationAssertion(rdfs:seeAlso goldbook:09935 goldbook:09937)
AnnotationAssertion(rdfs:seeAlso goldbook:09935 goldbook:09938)
AnnotationAssertion(mito:isMentionedBy goldbook:09935 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09935 "current"^^xsd:string)
Declaration(Class(goldbook:09936))
AnnotationAssertion(rdfs:label goldbook:09936 "gravitational field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09936 "Field-flow fractionation in which the physical force field is the Earth’s gravitational field.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09936 "GFFF")
AnnotationAssertion(rdfs:comment goldbook:09936 "GFFF can fractionate particulate matter in the micrometre size range (large microorganisms, blood cells, sediments, etc)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09936 "Since the Earth’s gravitational field produces relatively weak forces, this mode is only appropriate for micron size particles, hence the separation is an example of hyperlayer focusing field-flow fractionation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09936 goldbook:09934)
AnnotationAssertion(rdfs:seeAlso goldbook:09936 goldbook:09937)
AnnotationAssertion(mito:isMentionedBy goldbook:09936 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09936 "current"^^xsd:string)
Declaration(Class(goldbook:09937))
AnnotationAssertion(rdfs:label goldbook:09937 "hyperlayer focusing field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09937 "Mechanism of field-flow fractionation of particles greater than \\(\\pu{1 \\upmu m}\\) in diameter relying on hydrodynamic lift forces near the channel wall to move particles into faster flowing streams.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09937 "HyFFF")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09937 "hyperlayer field-flow fractionation mode")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09937 "lift-hyperlayer field-flow fractionation mode")
AnnotationAssertion(rdfs:comment goldbook:09937 "HyFFF is a preferred alternative to steric field-flow fractionation. The retention of particles larger than \\(\\pu{1 \\upmu m}\\) typically increases with flow rate. Particles are driven away from the wall by a hydrody-namic lift force and elevated into faster flow streams. The particles form thin layers at an equilibrium position, where the external field is balanced by the opposing hydrodynamic lift force, as compared to steric mode, where the thin layer of particles is adjacent to the accumulation wall."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09937 "Due to the large size of the particles, Brownian diffusion away from the accumulation wall is assumed to be negligible in this mode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09937 goldbook:09934)
AnnotationAssertion(rdfs:seeAlso goldbook:09937 goldbook:09940)
AnnotationAssertion(mito:isMentionedBy goldbook:09937 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09937 "current"^^xsd:string)
Declaration(Class(goldbook:09938))
AnnotationAssertion(rdfs:label goldbook:09938 "sedimentation field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09938 "Field-flow fractionation in which the physical force field is a centrifugal force field.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09938 "SdFFF")
AnnotationAssertion(rdfs:comment goldbook:09938 "SdFFF is performed in a circular flat channel inserted inside a centrifugal basket."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09938 "SdFFF can be applied to a wide range of colloidal and micron size particles and is a powerful method for cell separations, including industrial carbon blacks, silica nanoparticles, silver and gold nano-particles, aquatic sediments, aerosols, and latex beads."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09938 "SdFFF can be successfully applied to the fractionation and characterization (sizing) of submicron particles, starting from about \\(\\pu{5 nm}\\), but this limit depends on the particle density, as the separation is based on the buoyant mass of the particles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09938 "SdFFF can operate in both the Brownian field-flow fractionation (BFFF) and hyperlayer field-flow fractionation (HyFFF) modes and caution must be exercised if samples span the Brownian-hyperlayer transition point of about \\(\\pu{1 \\upmu m}\\), as this can lead to separated fractions containing two particle sizes, smaller particles separated by Brownian mode and larger particles separated by hyperlayer mode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09938 goldbook:09932)
AnnotationAssertion(rdfs:seeAlso goldbook:09938 goldbook:09934)
AnnotationAssertion(rdfs:seeAlso goldbook:09938 goldbook:09937)
AnnotationAssertion(mito:isMentionedBy goldbook:09938 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09938 "current"^^xsd:string)
Declaration(Class(goldbook:09939))
AnnotationAssertion(rdfs:label goldbook:09939 "split-flow thin-cell fractionation")
AnnotationAssertion(dcterms:description goldbook:09939 "Separation in which laminar flow conditions are established between a liquid containing suspended sample and a carrier liquid, with a physical force field applied across the streams.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09939 "SPLITT")
AnnotationAssertion(rdfs:comment goldbook:09939 "Although SPILTT is similar to field-flow fractionation, it should not be referred to as FFF. The separation is achieved by the combined action of controlled flow rates and an applied cross-field."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09939 "The system has two channel inlets and two outlets. Sample suspension is continuously pumped into one inlet and carrier liquid is pumped into the other inlet. Due to the laminar flow conditions, these two streams do not mix."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09939 "SPLITT enables the separation of samples of masses of the order of grams."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09939 "Fields that have been tested so far include gravitational, centrifugal and magnetic."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09939 "A semi-preparative binary separation can be generated with smaller particles eluting from one outlet and larger particles emerging from the other. Careful manipulation of the inlet and outlet flow rates and the field strength enables the cut-off diameter of the particles to be selected."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09939 goldbook:09934)
AnnotationAssertion(mito:isMentionedBy goldbook:09939 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09939 "current"^^xsd:string)
Declaration(Class(goldbook:09940))
AnnotationAssertion(rdfs:label goldbook:09940 "steric field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09940 "Mechanism of field-flow fractionation of particles greater than \\(\\pu{1 \\upmu m}\\) in diameter relying on proximity to the accumulation wall.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09940 "StFFF")
AnnotationAssertion(rdfs:comment goldbook:09940 "In StFFF the elution order is opposite to that of Brownian field-flow fractionation mode and larger particles move ahead of smaller ones."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09940 "It was originally considered that particles are in contact with the accumulation wall during the entire migration time and consequently the centre of larger particles are situated closer to the centre of the channel in the faster flow streams. This is never achieved in practice due to hydrodynamic lift forces away from the accumulation wall."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09940 goldbook:09932)
AnnotationAssertion(rdfs:seeAlso goldbook:09940 goldbook:09934)
AnnotationAssertion(mito:isMentionedBy goldbook:09940 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09940 "current"^^xsd:string)
Declaration(Class(goldbook:09941))
AnnotationAssertion(rdfs:label goldbook:09941 "symmetrical flow field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09941 "Flow field-flow fractionation in which the speed of mobile phase is constant along the length of the channel due to constant channel width.")
AnnotationAssertion(rdfs:comment goldbook:09941 "The width is constant except for triangular sections at each of the ends of the channel."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09941 "Theory and data analysis are simplified by the assumption of constant flow."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09941 goldbook:09935)
AnnotationAssertion(mito:isMentionedBy goldbook:09941 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09941 "current"^^xsd:string)
Declaration(Class(goldbook:09942))
AnnotationAssertion(rdfs:label goldbook:09942 "thermal field-flow fractionation")
AnnotationAssertion(dcterms:description goldbook:09942 "Field-flow fractionation in which the physical force field is created by a temperature difference across the channel.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09942 "TFFF")
AnnotationAssertion(rdfs:comment goldbook:09942 "One side of the channel is heated and the other side is cooled. A relatively small temperature difference between the top and bottom walls of the channel provides a high thermal gradient."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09942 "TFFF has been mainly used for the separation of lyophilic synthetic polymers, including ultrahigh molecular weight polymers and microgels. However, some reports of other types of macromolecules and particles, including aqueous solvents, are present in the literature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09942 goldbook:09934)
AnnotationAssertion(mito:isMentionedBy goldbook:09942 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09942 "current"^^xsd:string)
Declaration(Class(goldbook:09943))
AnnotationAssertion(rdfs:label goldbook:09943 "elution mode")
AnnotationAssertion(dcterms:description goldbook:09943 "Method of introduction of the mobile phase (upper or lower) into the rotating coil (from the head or the tail). Of four combinations, only two elution modes should be used in high-speed counter-current chromatography, i.e. either the lower phase from the head toward the tail or the upper phase from the tail toward the head.")
AnnotationAssertion(rdfs:seeAlso goldbook:09943 goldbook:09944)
AnnotationAssertion(mito:isMentionedBy goldbook:09943 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09943 "current"^^xsd:string)
Declaration(Class(goldbook:09944))
AnnotationAssertion(rdfs:label goldbook:09944 "high-speed counter-current chromatography")
AnnotationAssertion(dcterms:description goldbook:09944 "Counter-current chromatography system using a multilayer coil separation column, which undergoes a type-J synchronous planetary motion (see figure).Type-J planetary motion of a multilayer coil separation column. The column holder rotates about its own axis and revolves around the centrifuge axis at the same angular velocity (ω) in the same direction. This planetary motion prevents twisting of the bundle of flow tubes, allowing continuous elution through a rotating column without risk of leakage and contamination.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:09944 "HSCCC")
AnnotationAssertion(rdfs:comment goldbook:09944 "The method covers analytical (microgram) to preparative (\\(\\pu{10 g}\\)) scale separations usually in a few hours at a high partition efficiency up to a few thousand theoretical plates (see number of theoretical plates)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09944 goldbook:09887)
AnnotationAssertion(mito:isMentionedBy goldbook:09944 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09944 "current"^^xsd:string)
Declaration(Class(goldbook:09945))
AnnotationAssertion(rdfs:label goldbook:09945 "mobile-phase volume")
AnnotationAssertion(dcterms:description goldbook:09945 "Volume of the liquid mobile phase contained in the column in counter-current chromatography \\[V_{\\rm{M}} = V_{\\rm{C}} - V_{\\rm{S}}\\] where \\(V_{\\rm{C}}\\) is the total volume of the column and \\(V_{\\rm{S}}\\) is the volume of the liquid stationary phase in the column.")
AnnotationAssertion(rdfs:seeAlso goldbook:09945 goldbook:09887)
AnnotationAssertion(mito:isMentionedBy goldbook:09945 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09945 "current"^^xsd:string)
Declaration(Class(goldbook:09946))
AnnotationAssertion(rdfs:label goldbook:09946 "multilayer coil")
AnnotationAssertion(dcterms:description goldbook:09946 "Separation column used for high-speed counter-current chromatography.")
AnnotationAssertion(rdfs:comment goldbook:09946 "The multilayer coil is prepared from a long piece of polytetrafluoroethylene (PTFE) tubing by coaxially winding it around a spool-shaped holder, making multiple coiled layers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09946 "Usually, three different inner diameter sizes of tubing are used: ca. \\(\\pu{1 mm}\\) for analytical, \\(\\pu{1.6 mm}\\) for semipreparative, and \\(\\pu{2.6 mm}\\) for preparative separations. It provides efficient mixing of the two phases and a high retention of the stationary phase under a high flow rate of the mobile phase."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09946 goldbook:09944)
AnnotationAssertion(mito:isMentionedBy goldbook:09946 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09946 "current"^^xsd:string)
Declaration(Class(goldbook:09947))
AnnotationAssertion(rdfs:label goldbook:09947 "pH-zone-refining counter-current chromatography")
AnnotationAssertion(dcterms:description goldbook:09947 "Counter-current chromatography that produces a train of fused rectangular solute peaks called pH-zones, each with its specific pH. Each zone contains highly concentrated solute, often near saturation level, and is separated from the neighbouring zone by a narrow strip called a mixing zone, which contains a mixture of impurities.")
AnnotationAssertion(rdfs:seeAlso goldbook:09947 goldbook:09887)
AnnotationAssertion(mito:isMentionedBy goldbook:09947 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09947 "current"^^xsd:string)
Declaration(Class(goldbook:09948))
AnnotationAssertion(rdfs:label goldbook:09948 "retainer and eluter")
AnnotationAssertion(dcterms:description goldbook:09948 "Most important reagents in pH-zone-refining counter-current chromatography. A retainer is added to the stationary organic phase to retain the analytes and the eluter added to the mobile aqueous phase to elute the analytes.")
AnnotationAssertion(rdfs:comment goldbook:09948 "Trifluoroacetic acid and triethylamine are typical retainers for the separation of acidic and basic compounds, respectively, where the stationary phase typically is the organic phase. The retainer determines the analyte concentration in the stationary phase. NH4OH and HCl are commonly used as the eluter for the separation of acidic and basic compounds, respectively. The eluter always stays in the aqueous mobile phase to serve as a counter ion. pH-zone-refining CCC can also be performed using the organic phase as the mobile phase (normal displacement mode). In this case, the retainer becomes the eluter to elute the analytes, and the eluter becomes the retainer to retain the analytes in the aqueous stationary phase."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09948 goldbook:09947)
AnnotationAssertion(mito:isMentionedBy goldbook:09948 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09948 "current"^^xsd:string)
Declaration(Class(goldbook:09949))
AnnotationAssertion(rdfs:label goldbook:09949 "retention volume of the stationary phase")
AnnotationAssertion(dcterms:description goldbook:09949 "Volume of the stationary phase, which stays permanently within the column in counter-current chromatography.")
AnnotationAssertion(rdfs:comment goldbook:09949 "\\(V_{\\rm{s}}\\) is one of the most important parameters that determines the peak resolution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09949 goldbook:09887)
AnnotationAssertion(mito:isMentionedBy goldbook:09949 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09949 "current"^^xsd:string)
Declaration(Class(goldbook:09950))
AnnotationAssertion(rdfs:label goldbook:09950 "type-J coil planet centrifuge")
AnnotationAssertion(dcterms:description goldbook:09950 "Centrifuge that provides type-J synchronous planetary motion to the column holder, the axis of which is parallel to the centrifuge axis (see figure in high-speed counter-current chromatography).")
AnnotationAssertion(rdfs:seeAlso goldbook:09950 goldbook:09944)
AnnotationAssertion(rdfs:seeAlso goldbook:09950 goldbook:09951)
AnnotationAssertion(mito:isMentionedBy goldbook:09950 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09950 "current"^^xsd:string)
Declaration(Class(goldbook:09951))
AnnotationAssertion(rdfs:label goldbook:09951 "type-J synchronous planetary motion")
AnnotationAssertion(dcterms:description goldbook:09951 "Unique type of planetary motion (so named because the flow tubes form a letter J figure, as shown in the figure in high-speed counter-current chromatography) of the column holder, which rotates around its own axis once during one revolution around the central axis of the centrifuge in the same direction.")
AnnotationAssertion(rdfs:comment goldbook:09951 "The system prevents the flow tubes from twisting during column rotation, and produces an excellent mixing and high retention of the stationary phase in a multilayer coil separation column."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09951 goldbook:09944)
AnnotationAssertion(mito:isMentionedBy goldbook:09951 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09951 "current"^^xsd:string)
Declaration(Class(goldbook:09952))
AnnotationAssertion(rdfs:label goldbook:09952 "chiral additive")
AnnotationAssertion(dcterms:description goldbook:09952 "Chiral selector that has been added as a component of a mobile phase or electrophoretic medium.")
AnnotationAssertion(mito:isMentionedBy goldbook:09952 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09952 "current"^^xsd:string)
Declaration(Class(goldbook:09953))
AnnotationAssertion(rdfs:label goldbook:09953 "comprehensive two-dimensional chromatography")
AnnotationAssertion(dcterms:description goldbook:09953 "Type of two-dimensional chromatography in which all the effluent from the first separation step is transferred in fractions to a second separation step.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09953 "comprehensive chromatography")
AnnotationAssertion(rdfs:comment goldbook:09953 "The multiplier (\\(\\times\\)) is used to denote the two separation steps, e.g. \\(GC \\times GC\\) or \\(LC \\times SFC\\) ."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09953 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09953 "current"^^xsd:string)
Declaration(Class(goldbook:09954))
AnnotationAssertion(rdfs:label goldbook:09954 "heart-cut separations")
AnnotationAssertion(dcterms:description goldbook:09954 "Type of two-dimensional chromatography in which selected fractions from the first separation step are transferred to a second separation step.")
AnnotationAssertion(mito:isMentionedBy goldbook:09954 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09954 "current"^^xsd:string)
Declaration(Class(goldbook:09955))
AnnotationAssertion(rdfs:label goldbook:09955 "modulation frequency")
AnnotationAssertion(dcterms:description goldbook:09955 "Number of modulations in a given time interval.")
AnnotationAssertion(mito:isMentionedBy goldbook:09955 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09955 "current"^^xsd:string)
Declaration(Class(goldbook:09956))
AnnotationAssertion(rdfs:label goldbook:09956 "modulation number")
AnnotationAssertion(dcterms:description goldbook:09956 "Number of modulations for a given first-dimension peak.")
AnnotationAssertion(mito:isMentionedBy goldbook:09956 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09956 "current"^^xsd:string)
Declaration(Class(goldbook:09957))
AnnotationAssertion(rdfs:label goldbook:09957 "modulation period")
AnnotationAssertion(dcterms:description goldbook:09957 "Duration of a complete cycle of modulation in a system for comprehensive two-dimensional chromatography.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09957 "modulation time")
AnnotationAssertion(rdfs:comment goldbook:09957 "Modulation period is the length of a second-dimension chromatogram, i.e. the time between two successive injections into the second column."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09957 goldbook:09953)
AnnotationAssertion(mito:isMentionedBy goldbook:09957 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09957 "current"^^xsd:string)
Declaration(Class(goldbook:09958))
AnnotationAssertion(rdfs:label goldbook:09958 "modulator")
AnnotationAssertion(dcterms:description goldbook:09958 "Interface device between the two columns in a system for comprehensive two-dimensional chromatography that accumulates or samples narrow bands from the effluent of the first column for fast re-injection into the second column.")
AnnotationAssertion(rdfs:seeAlso goldbook:09958 goldbook:09953)
AnnotationAssertion(mito:isMentionedBy goldbook:09958 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09958 "current"^^xsd:string)
Declaration(Class(goldbook:09959))
AnnotationAssertion(rdfs:label goldbook:09959 "multi-dimensional chromatography")
AnnotationAssertion(dcterms:description goldbook:09959 "Chromatography in which parts or all of the separated sample components are subjected to additional separation steps.")
AnnotationAssertion(rdfs:comment goldbook:09959 "Multi-dimensional chromatography can be done, for example, by conducting a particular fraction eluting from the column into other columns (system) having different separation characteristics."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09959 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09959 "current"^^xsd:string)
Declaration(Class(goldbook:09960))
AnnotationAssertion(rdfs:label goldbook:09960 "wrap-around")
AnnotationAssertion(dcterms:description goldbook:09960 "Occurrence of second dimension peaks in subsequent elution sequences, caused by second-dimension retention times that exceed the modulation time in comprehensive two-dimensional chromatography.")
AnnotationAssertion(rdfs:seeAlso goldbook:09960 goldbook:09953)
AnnotationAssertion(rdfs:seeAlso goldbook:09960 goldbook:09957)
AnnotationAssertion(mito:isMentionedBy goldbook:09960 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09960 "current"^^xsd:string)
Declaration(Class(goldbook:09962))
AnnotationAssertion(rdfs:label goldbook:09962 "retention volume of an unretained compound")
AnnotationAssertion(dcterms:description goldbook:09962 "Retention volume of a sample component the molecules of which are larger than the largest pores of the particles of the stationary phase.")
AnnotationAssertion(rdfs:comment goldbook:09962 "These molecules will be eluted first from the column."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09962 "The retention volume of an unretained compound is related to the retention time of an unretained compound (in size-exclusion chromatography) and the flow rate (\\(F_{\\rm{c}}\\)) by \\(V_{0} = t_{0} \\times F_{\\rm{c}}\\)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09962 "Ignoring any extra-column volume, \\(V_{0}\\) is equal to the interparticle volume of the column."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09962 goldbook:09963)
AnnotationAssertion(rdfs:seeAlso goldbook:09962 goldbook:10040)
AnnotationAssertion(mito:isMentionedBy goldbook:09962 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09962 "current"^^xsd:string)
Declaration(Class(goldbook:09963))
AnnotationAssertion(rdfs:label goldbook:09963 "retention volume")
AnnotationAssertion(dcterms:description goldbook:09963 "Retention volume of a sample component, the molecules of which are smaller than the largest pores of the particles of the stationary phase but larger than the smallest pores.")
AnnotationAssertion(rdfs:comment goldbook:09963 "The corresponding retention time is related to the retention time (in size-exclusion chromatography) (\\(t_{\\rm{R}}\\)) and the flow rate (\\(F_{\\rm{c}}\\)) by \\(V_{\\rm{R}} = t_{\\rm{R}} \\times F_{\\rm{c}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09963 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09963 "current"^^xsd:string)
Declaration(Class(goldbook:09964))
AnnotationAssertion(rdfs:label goldbook:09964 "total mobile phase volume")
AnnotationAssertion(dcterms:description goldbook:09964 "Retention volume of a sample component, the molecules of which are smaller than the smallest pores of the particles of the stationary phase.")
AnnotationAssertion(rdfs:comment goldbook:09964 "The total mobile phase volume is related to the total mobile phase time (in size-exclusion chromatography) (\\(t_{\\rm{t}}\\)) and the flow rate (\\(F_{\\rm{c}}\\)) by \\(V_{\\rm{t}} = t_{\\rm{t}} \\times F_{\\rm{c}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09964 goldbook:09963)
AnnotationAssertion(mito:isMentionedBy goldbook:09964 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09964 "current"^^xsd:string)
Declaration(Class(goldbook:09965))
AnnotationAssertion(rdfs:label goldbook:09965 "relative molecular-mass exclusion limit")
AnnotationAssertion(dcterms:description goldbook:09965 "Maximum value of the relative molecular masses of components in a specific polymer solvent system that can enter into the pores of the porous non-adsorbing material used in size-exclusion chromatography.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09965 "molecular-weight exclusion limit")
AnnotationAssertion(rdfs:comment goldbook:09965 "For particles with relative molar mass greater than the exclusion limit the separation effect of the size-exclusion chromatography vanishes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09965 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09965 "current"^^xsd:string)
Declaration(Class(goldbook:09966))
AnnotationAssertion(rdfs:label goldbook:09966 "specific resolution")
AnnotationAssertion(dcterms:description goldbook:09966 "Peak resolution also considering the molar masses (\\(M_{1}\\), \\(M_{2}\\)) of the two test compounds: \\[R_{\\rm{sp}} = \\left[\\frac{V_{\\rm{R1}} - V_{\\rm{R2}}}{(w_{\\rm{b1}} + w_{\\rm{b2}})/2} \\right] \\cdot \\left[ \\frac{1}{\\log (M_{2}/M_{1})} \\right]\\]")
AnnotationAssertion(rdfs:comment goldbook:09966 "The test compounds used for the determination of the specific resolution should have a narrow molecular-mass distribution (the ratio of the mass-average and number-average molecular masses should be equal to or less than about \\(\\pu{1.1}\\)) and differ by a factor of about \\(\\pu{10}\\) in their molar masses."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09966 "In some areas, the symbol \\(R_{\\rm{s}}\\) is used for the specific resolution. Due to the possibility of confusing it with the general resolution term (see peak resolution), the symbol \\(R_{\\rm{sp}}\\) is suggested here."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09966 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09966 "current"^^xsd:string)
Declaration(Class(goldbook:09967))
AnnotationAssertion(rdfs:label goldbook:09967 "flavans")
AnnotationAssertion(dcterms:description goldbook:09967 "Flavans are compounds with a 2-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran skeleton (1 in flavonoids), that may be substituted, and include flavan-3-ols (compounds derived from 2-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran-3-ol skeleton 2) and flavan-4-ones (compounds derived from 2-phenyl-2,3-dihydro-4\\(H\\)-1-benzopyran-4-one skeleton 3), which are generically designated as flavanols and flavanones, respectively. Compounds derived from 2-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran-3,4-diol skeleton 4 are flavan-3,4-diols, designated leukoanthocyanidins because these colourless compounds have their structure derived from that of an anthocyanidin, specifically they are dehydronated 3,4-dihydroxy-1,2,3,4-tetrahydroanthocyanidins.")
AnnotationAssertion(mito:isMentionedBy goldbook:09967 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09967 "current"^^xsd:string)
Declaration(Class(goldbook:09968))
AnnotationAssertion(rdfs:label goldbook:09968 "flavones")
AnnotationAssertion(dcterms:description goldbook:09968 "Flavones and 3-hydroxyflavones (flavonols) are compounds with a 2-phenyl-4\\(H\\)-1-benzopyran-4-one (2-phenyl-4\\(H\\)-chromen-4-one) skeleton 5.")
AnnotationAssertion(rdfs:comment goldbook:09968 "The term \"flavonol\" is used as a class name for compounds with a 3-hydroxy-2-phenyl-4\\(H\\)-1-benzopyran-4-one (3-hydroxy-2-phenyl-4\\(H\\)-chromen-4-one) skeleton 6."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:09968 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09968 "current"^^xsd:string)
Declaration(Class(goldbook:09970))
AnnotationAssertion(rdfs:label goldbook:09970 "isoflavans")
AnnotationAssertion(dcterms:description goldbook:09970 "Isoflavans are compounds with a 3-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran skeleton (see isoflavonoids). They may be substituted.")
AnnotationAssertion(rdfs:seeAlso goldbook:09970 goldbook:09969)
AnnotationAssertion(mito:isMentionedBy goldbook:09970 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09970 "current"^^xsd:string)
Declaration(Class(goldbook:09971))
AnnotationAssertion(rdfs:label goldbook:09971 "isoflavones")
AnnotationAssertion(dcterms:description goldbook:09971 "Isoflavones are compounds with a 3-phenyl-4$H$-1-benzopyran-4-one (3-phenyl-4$H$-chromen-4-one) skeleton 9. They may be substituted.")
AnnotationAssertion(mito:isMentionedBy goldbook:09971 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09971 "current"^^xsd:string)
Declaration(Class(goldbook:09973))
AnnotationAssertion(rdfs:label goldbook:09973 "neoflavans")
AnnotationAssertion(dcterms:description goldbook:09973 "Neoflavans are compounds with a 4-phenyl-3,4-dihydro-2$H$-1-benzopyran skeleton (see neoflavonoids). They may be substituted.")
AnnotationAssertion(rdfs:seeAlso goldbook:09973 goldbook:09972)
AnnotationAssertion(mito:isMentionedBy goldbook:09973 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09973 "current"^^xsd:string)
Declaration(Class(goldbook:09974))
AnnotationAssertion(rdfs:label goldbook:09974 "neoflavones")
AnnotationAssertion(dcterms:description goldbook:09974 "Neoflavones are compounds with a 4-phenyl-2$H$-1-benzopyran-2-one (4-phenyl-2$H$-chromen-2-one) skeleton 11. They may be substituted.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09974 "4-phenylcoumarins")
AnnotationAssertion(mito:isMentionedBy goldbook:09974 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09974 "current"^^xsd:string)
Declaration(Class(goldbook:09975))
AnnotationAssertion(rdfs:label goldbook:09975 "aurones")
AnnotationAssertion(dcterms:description goldbook:09975 "Aurones are compounds derived from (2$Z$)-2-benzylidene-1-benzofuran-3(2$H$)-one [alternative name: (2$Z$)-2-(phenylmethylidene)-1-benzofuran-3(2$H$)-one] (aurone, compound 14).")
AnnotationAssertion(mito:isMentionedBy goldbook:09975 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09975 "current"^^xsd:string)
Declaration(Class(goldbook:09976))
AnnotationAssertion(rdfs:label goldbook:09976 "pterocarpans")
AnnotationAssertion(dcterms:description goldbook:09976 "Pterocarpans are compounds derived from (6a$R$,11a$R$)-6a,11a-dihydro-6$H$-[1]benzofuro[3,2-$c$][1]benzopyran (15), and their 6a,11a-didehydro derivatives 16 are named coumestans. They are numbered systematically following the numbering rules for fused ring systems.")
AnnotationAssertion(mito:isMentionedBy goldbook:09976 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09976 "current"^^xsd:string)
Declaration(Class(goldbook:09977))
AnnotationAssertion(rdfs:label goldbook:09977 "flavonolignans")
AnnotationAssertion(dcterms:description goldbook:09977 "Flavonolignans have structures based on flavonoids condensed with \\(\\ce{C6{-}C3}\\) lignan precursors.")
AnnotationAssertion(mito:isMentionedBy goldbook:09977 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09977 "current"^^xsd:string)
Declaration(Class(goldbook:09978))
AnnotationAssertion(rdfs:label goldbook:09978 "biflavonoids")
AnnotationAssertion(dcterms:description goldbook:09978 "Biflavonoid and other flavonoid oligomers, which occur widely in nature, are exemplified and named in this recommendation (Flv-3.8).")
AnnotationAssertion(mito:isMentionedBy goldbook:09978 doi:10.1515/pac-2013-0919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09978 "current"^^xsd:string)
Declaration(Class(goldbook:09979))
AnnotationAssertion(rdfs:label goldbook:09979 "nominal property")
AnnotationAssertion(dcterms:description goldbook:09979 "Property of a phenomenon, body, or substance, where the property has no size.")
AnnotationAssertion(rdfs:comment goldbook:09979 "The concept \"nominal property\" is defined as the opposite of \"quantity\", i.e. the former concept lacks the essential characteristic of \"size\" (or \"magnitude\"). In such cases, ISO 704:2009-6.5.4 allows a \"negative definition\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09979 "The term \"attribute\" has sometimes been used to designate \"nominal property\", but not here."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09979 "The term \"qualitative property\" is also used, but not here as it is ambiguous because \"ordinal quantity\" is often included under that term."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09979 "\"Nominal property\" is sometimes termed \"nameable property\", but not here."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09979 goldbook:09982)
AnnotationAssertion(mito:isMentionedBy goldbook:09979 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09979 "current"^^xsd:string)
Declaration(Class(goldbook:09980))
AnnotationAssertion(rdfs:label goldbook:09980 "kind-of-nominal-property")
AnnotationAssertion(dcterms:description goldbook:09980 "Defining aspect, common to mutually comparable nominal properties.")
AnnotationAssertion(rdfs:comment goldbook:09980 "\"Kind-of-nominal-property\" is sometimes termed \"attribute\", but not here."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09980 goldbook:09982)
AnnotationAssertion(rdfs:seeAlso goldbook:09980 goldbook:09979)
AnnotationAssertion(mito:isMentionedBy goldbook:09980 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09980 "current"^^xsd:string)
Declaration(Class(goldbook:09981))
AnnotationAssertion(rdfs:label goldbook:09981 "category")
AnnotationAssertion(dcterms:description goldbook:09981 "Kind-of-nominal-property indicating a class among nominal properties ordered according to nominal property values of a specified nominal property value set without relation to size.")
AnnotationAssertion(rdfs:seeAlso goldbook:09981 goldbook:09980)
AnnotationAssertion(rdfs:seeAlso goldbook:09981 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09981 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:09981 goldbook:09996)
AnnotationAssertion(mito:isMentionedBy goldbook:09981 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09981 "current"^^xsd:string)
Declaration(Class(goldbook:09982))
AnnotationAssertion(rdfs:label goldbook:09982 "taxon")
AnnotationAssertion(dcterms:description goldbook:09982 "Category indicating a class of organisms within a recognized hierarchically structured nominal property value set.")
AnnotationAssertion(rdfs:comment goldbook:09982 "Taxonomy is the science of classification and its applications, usually regarding organisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09982 goldbook:09981)
AnnotationAssertion(rdfs:seeAlso goldbook:09982 goldbook:09980)
AnnotationAssertion(rdfs:seeAlso goldbook:09982 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:09982 goldbook:09996)
AnnotationAssertion(mito:isMentionedBy goldbook:09982 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09982 "current"^^xsd:string)
Declaration(Class(goldbook:09983))
AnnotationAssertion(rdfs:label goldbook:09983 "dedicated kind-of-nominal-property")
AnnotationAssertion(dcterms:description goldbook:09983 "Kind-of-nominal-property with a sort of system and any pertinent sort(s) of component(s).")
AnnotationAssertion(rdfs:comment goldbook:09983 "A dedicated kind-of-nominal-property is not specified to any individual person, in contrast to an individual nominal property, and it cannot have a nominal property value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09983 "In clinical laboratory report forms, dedicated kind-of-nominal-properties may be described according to an internationally recommended NPU syntax from IFCC-IUPAC. The syntax is System(specification)-Component(specification); kind-of-property(specification). The last \"specification\" might contain information on the examination procedure or the nominal property value set. The initial capital for System and for Component is mandatory.Examples of the NPU syntax:.Blood—Plasma; colour({milky, red, yellow});.Erythrocytes(Blood)—Erythrocyte antigen; blood group({A, B, AB, O}).For examples 1-4 above, individual nominal properties can be written as follows (omitting patient identity and time but including the nominal property value for clarity):Patient—Spinal fluid; colour(visual)=reddish;DNA(Leukocytes)—CYP2D6 gene; sequence variation(allele specific PCR)=*1/*3;Expectoration—Bacterium; taxon(Phadebact coagglutination test)=Mycobacterium tuberculosis;Monocytes(Blood)—Nuclei; shape=oval."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09983 "The patient\"s name (or other identifier), location, and date and time of obtaining the sample of the system under consideration shall always be given in the clinical laboratory report."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09983 "The dedicated kinds-of-nominal-property examples above correspond to examples 1-4 of kind-of-nominal-property."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09983 goldbook:09980)
AnnotationAssertion(rdfs:seeAlso goldbook:09983 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:09983 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:09983 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:09983 goldbook:09982)
AnnotationAssertion(mito:isMentionedBy goldbook:09983 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09983 "current"^^xsd:string)
Declaration(Class(goldbook:09984))
AnnotationAssertion(rdfs:label goldbook:09984 "examination")
AnnotationAssertion(dcterms:description goldbook:09984 "Process of experimentally obtaining one or more nominal property values that can reasonably be attributed to a nominal property.")
AnnotationAssertion(rdfs:comment goldbook:09984 "The outcome of an examination is an examination result."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09984 "The activity of examination essentially consists in comparing the property considered, i.e. the examinand by way of an examining system, with the property of a \"reference\" of similar nature. Such a reference may be personal and subjective, such as a person\"s memory of a colour, or the reference may be objective, such as a nominal reference material."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09984 goldbook:09985)
AnnotationAssertion(rdfs:seeAlso goldbook:09984 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:09984 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:09984 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09984 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:09984 goldbook:10020)
AnnotationAssertion(mito:isMentionedBy goldbook:09984 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09984 "current"^^xsd:string)
Declaration(Class(goldbook:09985))
AnnotationAssertion(rdfs:label goldbook:09985 "examinand")
AnnotationAssertion(dcterms:description goldbook:09985 "Nominal property intended to be examined.")
AnnotationAssertion(rdfs:comment goldbook:09985 "The nominal property value of an examinand may be different from that of the property actually being examined due to changes of the system bearing the property during the examination."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09985 "The examined value may be obtained indirectly through examinations of other nominal properties, giving the examined value by using an algorithm which may involve measurement results and examination results."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09985 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09985 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:09985 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:09985 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:09985 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:09985 goldbook:09982)
AnnotationAssertion(mito:isMentionedBy goldbook:09985 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09985 "current"^^xsd:string)
Declaration(Class(goldbook:09986))
AnnotationAssertion(rdfs:label goldbook:09986 "examining system")
AnnotationAssertion(dcterms:description goldbook:09986 "Set of one or more devices, including any reagent and supply, assembled and adapted to give information used to generate examined values from a nominal property value set.")
AnnotationAssertion(rdfs:comment goldbook:09986 "A human eye may be an essential element of an examining system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09986 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:09986 goldbook:09997)
AnnotationAssertion(mito:isMentionedBy goldbook:09986 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09986 "current"^^xsd:string)
Declaration(Class(goldbook:09987))
AnnotationAssertion(rdfs:label goldbook:09987 "influence nominal property")
AnnotationAssertion(dcterms:description goldbook:09987 "Nominal property that, in an examination, does not affect the nominal property that is actually examined, but affects the relation between the nominal indication on the examining system and the examination result.")
AnnotationAssertion(rdfs:comment goldbook:09987 "A quantity might also influence a nominal property."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09987 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09987 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:09987 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:09987 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:09987 goldbook:09991)
AnnotationAssertion(mito:isMentionedBy goldbook:09987 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09987 "current"^^xsd:string)
Declaration(Class(goldbook:09988))
AnnotationAssertion(rdfs:label goldbook:09988 "examination principle")
AnnotationAssertion(dcterms:description goldbook:09988 "Phenomenon serving as a basis of an examination.")
AnnotationAssertion(rdfs:comment goldbook:09988 "The phenomenon can be of a physical, chemical, or biological nature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09988 goldbook:09984)
AnnotationAssertion(mito:isMentionedBy goldbook:09988 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09988 "current"^^xsd:string)
Declaration(Class(goldbook:09989))
AnnotationAssertion(rdfs:label goldbook:09989 "examination method")
AnnotationAssertion(dcterms:description goldbook:09989 "Generic description of a logical organization of operations used in an examination.")
AnnotationAssertion(rdfs:comment goldbook:09989 "The laconic description in an examination method is insufficient to allow an examination with prescribed examination uncertainty, but aids in formulating one or more examination procedures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09989 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:09989 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:09989 goldbook:10004)
AnnotationAssertion(mito:isMentionedBy goldbook:09989 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09989 "current"^^xsd:string)
Declaration(Class(goldbook:09990))
AnnotationAssertion(rdfs:label goldbook:09990 "examination procedure")
AnnotationAssertion(dcterms:description goldbook:09990 "Detailed description of an examination according to one or more examination principles and to a given examination method and any decision algorithm necessary to obtain an examination result.")
AnnotationAssertion(rdfs:comment goldbook:09990 "An examination procedure specifies the dedicated kind-of-nominal-property involved, any sampling, examining system, nominal reference material(s) needed, and the nominal property value set used. The examination procedure also specifies how many examined values that are necessary to obtain an examination result and how to estimate the expected examination uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09990 "The information presented in an examination procedure is intended to be operational and should be sufficient for a trained operator to perform an examination satisfactorily."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09990 "An examination procedure can include a statement concerning a target examination uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:09983)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:09989)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:09988)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:10004)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:10020)
AnnotationAssertion(rdfs:seeAlso goldbook:09990 goldbook:10013)
AnnotationAssertion(mito:isMentionedBy goldbook:09990 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09990 "current"^^xsd:string)
Declaration(Class(goldbook:09991))
AnnotationAssertion(rdfs:label goldbook:09991 "nominal indication")
AnnotationAssertion(dcterms:description goldbook:09991 "Nominal property value provided by an examining system.")
AnnotationAssertion(rdfs:seeAlso goldbook:09991 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:09991 goldbook:09986)
AnnotationAssertion(mito:isMentionedBy goldbook:09991 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09991 "current"^^xsd:string)
Declaration(Class(goldbook:09992))
AnnotationAssertion(rdfs:label goldbook:09992 "blank nominal indication")
AnnotationAssertion(dcterms:description goldbook:09992 "Nominal indication obtained from an object similar to the one under investigation, except that the nominal property of interest is supposed not to be present, or is not contributing to the nominal indication.")
AnnotationAssertion(rdfs:comment goldbook:09992 "A blank nominal indication shall not be confused with a quantity value below a detection limit."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09992 "A blank nominal indication is necessary for quality assessment in some examination procedures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09992 "A blank nominal indication, when the examination procedure is expected to produce a nominal property value, is an erroneous nominal property value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09992 "The concept is often termed \"negative control\", but not here."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09992 goldbook:09991)
AnnotationAssertion(rdfs:seeAlso goldbook:09992 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:09992 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09992 goldbook:09996)
AnnotationAssertion(mito:isMentionedBy goldbook:09992 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09992 "current"^^xsd:string)
Declaration(Class(goldbook:09993))
AnnotationAssertion(rdfs:label goldbook:09993 "repeatability condition")
AnnotationAssertion(dcterms:description goldbook:09993 "Condition of examination out of a set of conditions that includes the same examination procedure, same operators, same examining system, same operating conditions, same location, and replicate examinations on the same or similar objects over a short period of time.")
AnnotationAssertion(rdfs:seeAlso goldbook:09993 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:09993 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:09993 goldbook:09986)
AnnotationAssertion(mito:isMentionedBy goldbook:09993 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09993 "current"^^xsd:string)
Declaration(Class(goldbook:09994))
AnnotationAssertion(rdfs:label goldbook:09994 "intermediate precision condition")
AnnotationAssertion(dcterms:description goldbook:09994 "Condition of examination out of a set of conditions that includes the same examination procedure, same location, and replicate examinations on the same or similar objects over an extended period of time, but may include other conditions involving changes.")
AnnotationAssertion(rdfs:seeAlso goldbook:09994 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:09994 goldbook:09990)
AnnotationAssertion(mito:isMentionedBy goldbook:09994 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09994 "current"^^xsd:string)
Declaration(Class(goldbook:09995))
AnnotationAssertion(rdfs:label goldbook:09995 "reproducibility condition")
AnnotationAssertion(dcterms:description goldbook:09995 "Condition of examination out of a set of conditions that includes different locations, operators, examining systems, and replicate examinations on the same or similar objects.")
AnnotationAssertion(rdfs:comment goldbook:09995 "The different examining systems may use different examination procedures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09995 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:09995 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:09995 goldbook:09986)
AnnotationAssertion(mito:isMentionedBy goldbook:09995 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09995 "current"^^xsd:string)
Declaration(Class(goldbook:09996))
AnnotationAssertion(rdfs:label goldbook:09996 "nominal property value")
AnnotationAssertion(dcterms:description goldbook:09996 "Feature common to equivalent individual nominal properties.")
AnnotationAssertion(rdfs:comment goldbook:09996 "Nominal property values can be words, alphanumerical codes, symbols, etc, but cannot enter into algebraic equations and is not related to a quantity dimension or a measurement unit."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09996 "A nominal property value can consist of a set of items.Example: The colours of the national flag of Switzerland are red and white."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09996 "The term \"nominal quantity value\" and its short form \"nominal value\" are used to indicate a concept concerning rounded or approximate quantity values. The term \"nominal indication interval\" is used to indicate a concept concerning rounded or approximate extreme indications."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09996 goldbook:09980)
AnnotationAssertion(rdfs:seeAlso goldbook:09996 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09996 goldbook:09982)
AnnotationAssertion(mito:isMentionedBy goldbook:09996 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09996 "current"^^xsd:string)
Declaration(Class(goldbook:09997))
AnnotationAssertion(rdfs:label goldbook:09997 "nominal property value set")
AnnotationAssertion(dcterms:description goldbook:09997 "Set of possible nominal property values for nominal properties of a given kind-of-nominal-property.")
AnnotationAssertion(rdfs:comment goldbook:09997 "A \"nominal property value set\" can be ordered by convention, for example in alphabetic order of words, or alphanumerical codes identifying nominal property values, or an order reflecting a classification, but neither of these is an ordering by size."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09997 goldbook:09980)
AnnotationAssertion(rdfs:seeAlso goldbook:09997 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09997 goldbook:09996)
AnnotationAssertion(mito:isMentionedBy goldbook:09997 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09997 "current"^^xsd:string)
Declaration(Class(goldbook:09998))
AnnotationAssertion(rdfs:label goldbook:09998 "reference nominal property value")
AnnotationAssertion(dcterms:description goldbook:09998 "Nominal property value used as a basis for comparison with nominal property values of nominal properties of the same kind-of-nominal-property.")
AnnotationAssertion(rdfs:comment goldbook:09998 "A reference nominal property value can be a true nominal property value of an examinand, in which case it is unknown, or a conventional nominal property value, in which case it is known."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09998 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:09998 goldbook:10002)
AnnotationAssertion(rdfs:seeAlso goldbook:09998 goldbook:09985)
AnnotationAssertion(rdfs:seeAlso goldbook:09998 goldbook:09980)
AnnotationAssertion(rdfs:seeAlso goldbook:09998 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:09998 goldbook:10001)
AnnotationAssertion(mito:isMentionedBy goldbook:09998 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09998 "current"^^xsd:string)
Declaration(Class(goldbook:09999))
AnnotationAssertion(rdfs:label goldbook:09999 "examination result")
AnnotationAssertion(dcterms:description goldbook:09999 "Set of nominal property values being attributed to an examinand together with any other available relevant information.")
AnnotationAssertion(rdfs:comment goldbook:09999 "An \"examination result\" sometimes contains \"relevant information\" about the set of nominal property values, such that some may be more representative of the examinand than others."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09999 "\"Examination result\" should not be confused with nominal property value set."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:09999 "An \"examination result\" may be expressed as a single examined value and an examination uncertainty. If there is no dispersion of nominal property values attributed to the examinand or if the examination uncertainty is considered to be negligible for a specified purpose, the examination result may be expressed as a single examined value."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:09999 goldbook:10002)
AnnotationAssertion(rdfs:seeAlso goldbook:09999 goldbook:09985)
AnnotationAssertion(rdfs:seeAlso goldbook:09999 goldbook:10004)
AnnotationAssertion(rdfs:seeAlso goldbook:09999 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:09999 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:09999 goldbook:09996)
AnnotationAssertion(mito:isMentionedBy goldbook:09999 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:09999 "current"^^xsd:string)
Declaration(Class(goldbook:10000))
AnnotationAssertion(rdfs:label goldbook:10000 "examined value")
AnnotationAssertion(dcterms:description goldbook:10000 "Nominal property value representing an examination result.")
AnnotationAssertion(rdfs:comment goldbook:10000 "The term \"observed value\" is sometimes used for \"examined value\", but not here."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10000 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:10000 goldbook:09999)
AnnotationAssertion(mito:isMentionedBy goldbook:10000 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10000 "current"^^xsd:string)
Declaration(Class(goldbook:10001))
AnnotationAssertion(rdfs:label goldbook:10001 "true nominal property value")
AnnotationAssertion(dcterms:description goldbook:10001 "Nominal property value consistent with the definition of a nominal property.")
AnnotationAssertion(rdfs:seeAlso goldbook:10001 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:10001 goldbook:09979)
AnnotationAssertion(mito:isMentionedBy goldbook:10001 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10001 "current"^^xsd:string)
Declaration(Class(goldbook:10002))
AnnotationAssertion(rdfs:label goldbook:10002 "conventional nominal property value")
AnnotationAssertion(dcterms:description goldbook:10002 "Nominal property value attributed by agreement to a nominal property for a given purpose.")
AnnotationAssertion(rdfs:seeAlso goldbook:10002 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:10002 goldbook:09979)
AnnotationAssertion(mito:isMentionedBy goldbook:10002 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10002 "current"^^xsd:string)
Declaration(Class(goldbook:10003))
AnnotationAssertion(rdfs:label goldbook:10003 "examination trueness")
AnnotationAssertion(dcterms:description goldbook:10003 "Fraction of examined values identical to one or more reference nominal property values among all the examined values provided.")
AnnotationAssertion(rdfs:comment goldbook:10003 "Each examined value is either equivalent, or non-equivalent, to the reference nominal property value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10003 "The examination trueness, in contrast to measurement trueness, is a quantity, and is complementary to examination uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10003 goldbook:10004)
AnnotationAssertion(rdfs:seeAlso goldbook:10003 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:10003 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10003 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:10003 goldbook:09998)
AnnotationAssertion(mito:isMentionedBy goldbook:10003 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10003 "current"^^xsd:string)
Declaration(Class(goldbook:10004))
AnnotationAssertion(rdfs:label goldbook:10004 "examination uncertainty")
AnnotationAssertion(dcterms:description goldbook:10004 "Fraction of examined values that is different from a reference nominal property value among all the examined values provided.")
AnnotationAssertion(rdfs:comment goldbook:10004 "Examination uncertainty is a quantity that is complementary to examination trueness."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10004 "Examination uncertainty is a part of an examination result."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10004 "With exception of the situation where the examination uncertainty is zero, some examined values differ from the reference nominal property value. In a comment to the examination result, the laboratory can provide information about other possible nominal property values, based on the information available."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:10003)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:09996)
AnnotationAssertion(rdfs:seeAlso goldbook:10004 goldbook:09998)
AnnotationAssertion(mito:isMentionedBy goldbook:10004 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10004 "current"^^xsd:string)
Declaration(Class(goldbook:10005))
AnnotationAssertion(rdfs:label goldbook:10005 "examination error")
AnnotationAssertion(dcterms:description goldbook:10005 "Disagreement between an examined value and a reference nominal property value.")
AnnotationAssertion(rdfs:comment goldbook:10005 "An examination error is either present or absent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10005 "Examination error is associated with an examined value, but not with an examining system."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10005 "Examination error should not be confused with production error or mistake."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10005 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10005 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10005 goldbook:09998)
AnnotationAssertion(mito:isMentionedBy goldbook:10005 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10005 "current"^^xsd:string)
Declaration(Class(goldbook:10006))
AnnotationAssertion(rdfs:label goldbook:10006 "examination accuracy")
AnnotationAssertion(dcterms:description goldbook:10006 "Closeness of agreement between an examined value and a true nominal property value of an examinand.")
AnnotationAssertion(rdfs:comment goldbook:10006 "Examination accuracy is a feature of an individual examined value, but not of an examining system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10006 goldbook:09985)
AnnotationAssertion(rdfs:seeAlso goldbook:10006 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10006 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10006 goldbook:10001)
AnnotationAssertion(mito:isMentionedBy goldbook:10006 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10006 "current"^^xsd:string)
Declaration(Class(goldbook:10007))
AnnotationAssertion(rdfs:label goldbook:10007 "examination precision")
AnnotationAssertion(dcterms:description goldbook:10007 "Closeness of agreement between nominal indications on an examining system or examined values obtained by replicate examinations on the same or similar objects under specified examination conditions.")
AnnotationAssertion(rdfs:comment goldbook:10007 "Examination precision can be expressed numerically by measures of dispersion of examined values such as Index of Qualitative Variation (IQV) and the Shannon\"s entropy, under specified examination conditions. IQV varies between 0 (no dispersion, all examined values in a single class) and 1 (two or more classes with identical frequency). Shannon\"s entropy varies between 0 (no dispersion, that is all examined values belong to a single category) and a maximum value equal to the logarithm (on basis 2) of the number of all categories. See Example."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10007 "A proportion distribution of a set of examined values describes proportions of data belonging to every possible nominal property value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10007 "\"Specified examination conditions\" can, for example, be repeatability condition of examination, intermediate precision condition of examination, or reproducibility condition of examination."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10007 "Examination precision is used to define examination repeatability, intermediate examination precision, and examination reproducibility."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10007 "Examination precision is a feature of an examining system used with a specified examination procedure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10007 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:10007 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10007 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10007 goldbook:09991)
AnnotationAssertion(rdfs:seeAlso goldbook:10007 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:10007 goldbook:09997)
AnnotationAssertion(mito:isMentionedBy goldbook:10007 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10007 "current"^^xsd:string)
Declaration(Class(goldbook:10008))
AnnotationAssertion(rdfs:label goldbook:10008 "examination repeatability")
AnnotationAssertion(dcterms:description goldbook:10008 "Examination precision under repeatability condition of examination.")
AnnotationAssertion(rdfs:comment goldbook:10008 "Examination repeatability is a quantity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10008 "Examination repeatability is a feature of an examining system used with a specified examination procedure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10008 goldbook:10007)
AnnotationAssertion(rdfs:seeAlso goldbook:10008 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:10008 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10008 goldbook:09993)
AnnotationAssertion(mito:isMentionedBy goldbook:10008 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10008 "current"^^xsd:string)
Declaration(Class(goldbook:10009))
AnnotationAssertion(rdfs:label goldbook:10009 "intermediate examination precision")
AnnotationAssertion(dcterms:description goldbook:10009 "Examination precision under intermediate precision condition of examination.")
AnnotationAssertion(rdfs:comment goldbook:10009 "Intermediate examination precision is a quantity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10009 "Intermediate examination precision is a feature of an examining system used with a specified examination procedure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10009 goldbook:10007)
AnnotationAssertion(rdfs:seeAlso goldbook:10009 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:10009 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10009 goldbook:09994)
AnnotationAssertion(mito:isMentionedBy goldbook:10009 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10009 "current"^^xsd:string)
Declaration(Class(goldbook:10010))
AnnotationAssertion(rdfs:label goldbook:10010 "examination reproducibility")
AnnotationAssertion(dcterms:description goldbook:10010 "Examination precision under reproducibility condition of examination.")
AnnotationAssertion(rdfs:comment goldbook:10010 "Examination reproducibility is a quantity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10010 "Examination reproducibility is a feature of a set of examined values."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10010 goldbook:10007)
AnnotationAssertion(rdfs:seeAlso goldbook:10010 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10010 goldbook:09995)
AnnotationAssertion(mito:isMentionedBy goldbook:10010 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10010 "current"^^xsd:string)
Declaration(Class(goldbook:10011))
AnnotationAssertion(rdfs:label goldbook:10011 "systematic examination error")
AnnotationAssertion(dcterms:description goldbook:10011 "Fraction of examined values with examination error that in replicate examinations remains constant or varies in a predictable manner.")
AnnotationAssertion(rdfs:comment goldbook:10011 "Systematic examination errors for examined values are quantities."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10011 "The systematic examination error for examined values can be expressed for a set of examined values as examination bias."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10011 "Systematic examination error is a feature of an examining system used with a specified examination procedure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10011 goldbook:10012)
AnnotationAssertion(rdfs:seeAlso goldbook:10011 goldbook:10005)
AnnotationAssertion(rdfs:seeAlso goldbook:10011 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:10011 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:10011 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10011 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10011 goldbook:09998)
AnnotationAssertion(mito:isMentionedBy goldbook:10011 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10011 "current"^^xsd:string)
Declaration(Class(goldbook:10012))
AnnotationAssertion(rdfs:label goldbook:10012 "examination bias")
AnnotationAssertion(dcterms:description goldbook:10012 "Estimate of a systematic examination error.")
AnnotationAssertion(rdfs:comment goldbook:10012 "Examination bias is a quantity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10012 "If the proportion distributions of the reference nominal property values and the examined values are the same, there is no examination bias for the examining system. If the distributions differ there is an examination bias."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10012 "In some publications on analytical chemistry, \"examination bias\" is termed \"lack of reliability\", but this is not recommended here."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10012 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10012 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10012 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:10012 goldbook:10022)
AnnotationAssertion(rdfs:seeAlso goldbook:10012 goldbook:09998)
AnnotationAssertion(rdfs:seeAlso goldbook:10012 goldbook:10011)
AnnotationAssertion(mito:isMentionedBy goldbook:10012 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10012 "current"^^xsd:string)
Declaration(Class(goldbook:10013))
AnnotationAssertion(rdfs:label goldbook:10013 "target examination uncertainty")
AnnotationAssertion(dcterms:description goldbook:10013 "Examination uncertainty specified as an acceptable fraction and decided on the basis of the intended use of examination results.")
AnnotationAssertion(rdfs:comment goldbook:10013 "Target examination uncertainty is a quantity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10013 goldbook:10004)
AnnotationAssertion(rdfs:seeAlso goldbook:10013 goldbook:09999)
AnnotationAssertion(mito:isMentionedBy goldbook:10013 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10013 "current"^^xsd:string)
Declaration(Class(goldbook:10014))
AnnotationAssertion(rdfs:label goldbook:10014 "nominal property value coverage set")
AnnotationAssertion(dcterms:description goldbook:10014 "Subset of the nominal property value set containing the true nominal property value(s) of an examinand with a stated probability, based on the information available.")
AnnotationAssertion(rdfs:seeAlso goldbook:10014 goldbook:09985)
AnnotationAssertion(rdfs:seeAlso goldbook:10014 goldbook:09997)
AnnotationAssertion(rdfs:seeAlso goldbook:10014 goldbook:10001)
AnnotationAssertion(mito:isMentionedBy goldbook:10014 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10014 "current"^^xsd:string)
Declaration(Class(goldbook:10015))
AnnotationAssertion(rdfs:label goldbook:10015 "nominal property value coverage probability")
AnnotationAssertion(dcterms:description goldbook:10015 "Probability that the set of true nominal property values of an examinand is contained within a specified nominal property value coverage set.")
AnnotationAssertion(rdfs:seeAlso goldbook:10015 goldbook:09985)
AnnotationAssertion(rdfs:seeAlso goldbook:10015 goldbook:10014)
AnnotationAssertion(rdfs:seeAlso goldbook:10015 goldbook:10001)
AnnotationAssertion(mito:isMentionedBy goldbook:10015 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10015 "current"^^xsd:string)
Declaration(Class(goldbook:10016))
AnnotationAssertion(rdfs:label goldbook:10016 "examination traceability")
AnnotationAssertion(dcterms:description goldbook:10016 "Property of an examination result whereby it can be related to a reference through a documented unbroken chain of examination calibrations, each contributing to the examination uncertainty.")
AnnotationAssertion(rdfs:comment goldbook:10016 "The ISO Technical report (TR 79:2015) characterizes reference materials for \"qualitative properties\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10016 goldbook:10021)
AnnotationAssertion(rdfs:seeAlso goldbook:10016 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:10016 goldbook:10004)
AnnotationAssertion(mito:isMentionedBy goldbook:10016 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10016 "current"^^xsd:string)
Declaration(Class(goldbook:10017))
AnnotationAssertion(rdfs:label goldbook:10017 "examinational comparability")
AnnotationAssertion(dcterms:description goldbook:10017 "Comparability of examination results, for nominal properties of a given kind-of-nominal-property, that are examined and traceable to the same reference.")
AnnotationAssertion(rdfs:seeAlso goldbook:10017 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:10017 goldbook:09980)
AnnotationAssertion(rdfs:seeAlso goldbook:10017 goldbook:09979)
AnnotationAssertion(mito:isMentionedBy goldbook:10017 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10017 "current"^^xsd:string)
Declaration(Class(goldbook:10018))
AnnotationAssertion(rdfs:label goldbook:10018 "examinational compatibility")
AnnotationAssertion(dcterms:description goldbook:10018 "Property of a set of examination results for a specified examinand of a given kind-of-nominal-property that have overlapping nominal property value sets.")
AnnotationAssertion(rdfs:comment goldbook:10018 "Two compatible examination results can be identical."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:10018 "The definition of this concept is not analogous to that of \"metrological compatibility of measurement results\" in the VIM."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10018 goldbook:09985)
AnnotationAssertion(rdfs:seeAlso goldbook:10018 goldbook:09999)
AnnotationAssertion(rdfs:seeAlso goldbook:10018 goldbook:09980)
