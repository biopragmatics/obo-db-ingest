AnnotationAssertion(mito:isMentionedBy goldbook:B00609 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00609 "current"^^xsd:string)
Declaration(Class(goldbook:B00610))
AnnotationAssertion(rdfs:label goldbook:B00610 "base unit")
AnnotationAssertion(dcterms:description goldbook:B00610 "Unit of measurement of a base quantity in a given system of quantities. By international agreement, a set of seven dimensionally independent units form the SI base units: the metre, kilogram, second, ampere, kelvin, mole and candela.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:A00300)
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:B00609)
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:C00787)
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:K03374)
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:K03391)
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:M03884)
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:M03980)
AnnotationAssertion(rdfs:seeAlso goldbook:B00610 goldbook:S05513)
