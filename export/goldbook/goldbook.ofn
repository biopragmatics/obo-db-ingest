AnnotationAssertion(rdfs:seeAlso goldbook:G02609 goldbook:S05796)
AnnotationAssertion(rdfs:seeAlso goldbook:G02609 goldbook:S06082)
AnnotationAssertion(mito:isMentionedBy goldbook:G02609 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02609 "current"^^xsd:string)
Declaration(Class(goldbook:G02610))
AnnotationAssertion(rdfs:label goldbook:G02610 "general base catalysis")
AnnotationAssertion(dcterms:description goldbook:G02610 "The catalysis of a chemical reaction by a series of Brønsted bases (which may include the lyate ion) so that the rate of the catalysed part of the reaction is given by \\(\\sum k_{\\rm{B}}\\ [\\rm{B}]\\) multiplied by some function of substrate concentration.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02610 goldbook:B00745)
AnnotationAssertion(rdfs:seeAlso goldbook:G02610 goldbook:C00874)
