property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:I03354
name: isotropic carbon
def: "A monolithic carbon material without preferred crystallographic orientation of the microstructure."
comment: "Isotropic carbon can also be a graphite material. The isotropy can be gross (bulk), macroscopic or microscopic, depending on the structural level at which isotropy is obtained. This word is widely used today and its meaning covers all the above levels. For example, the aerospace graphites have isotropy built in by random grain orientation. Some nuclear graphites are isotropic at the crystalline (sub-grain) level."
property_value: mito:isMentionedBy doi:10.1351/pac199567030473
property_value: hasStatus "current" xsd:string
