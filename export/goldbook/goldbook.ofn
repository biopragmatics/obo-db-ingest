AnnotationAssertion(dcterms:description goldbook:N04187 "Electrodes in which a support matrix, containing an ion exchanger (either cationic or anionic), a plasticizer solvent, and possibly an uncharged, selectivity-enhancing species, forms the ion-selective membrane which is usually interposed between two aqueous solutions. The support used can be either macroporous [e.g. poly(propylene carbonate) filter, glass frit, etc.] or microporous (e.g. 'thirsty' glass or inert polymeric material such as PVC) yielding with the ion-exchanger and the solvent a 'solidified' homogeneous mixture. These electrodes exhibit a response due to the presence of the ion-exchange material in the membrane. The solvent-polymeric-membrane is an example.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04187 goldbook:F02384)
AnnotationAssertion(rdfs:seeAlso goldbook:N04187 goldbook:I03026)
AnnotationAssertion(rdfs:seeAlso goldbook:N04187 goldbook:I03171)
AnnotationAssertion(rdfs:seeAlso goldbook:N04187 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:N04187 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:N04187 goldbook:S05563)
AnnotationAssertion(mito:isMentionedBy goldbook:N04187 doi:10.1351/pac199466122527)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04187 "current"^^xsd:string)
Declaration(Class(goldbook:N04188))
AnnotationAssertion(rdfs:label goldbook:N04188 "non-destructive activation analysis")
AnnotationAssertion(dcterms:description goldbook:N04188 "An activation analysis procedure in which, after the irradiation, no chemical and physical operations are applied which cause a change of any properties of the sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04188 goldbook:A00096)
AnnotationAssertion(rdfs:seeAlso goldbook:N04188 goldbook:I03255)
AnnotationAssertion(mito:isMentionedBy goldbook:N04188 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04188 "current"^^xsd:string)
Declaration(Class(goldbook:N04192))
AnnotationAssertion(rdfs:label goldbook:N04192 "non-equilibrium reaction")
AnnotationAssertion(dcterms:description goldbook:N04192 "If the reactants in a chemical reaction are not initially present in a Boltzmann distribution the reaction is referred to as a non-equilibrium reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04192 goldbook:E02184)
AnnotationAssertion(mito:isMentionedBy goldbook:N04192 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04192 "current"^^xsd:string)
Declaration(Class(goldbook:N04193))
AnnotationAssertion(rdfs:label goldbook:N04193 "non-graphitic carbon")
AnnotationAssertion(dcterms:description goldbook:N04193 "All varieties of solids consisting mainly of the element carbon with two-dimensional long-range order of the carbon atoms in planar hexagonal networks, but without any measurable crystallographic order in the third direction (c-direction) apart from more or less parallel stacking.")
AnnotationAssertion(rdfs:comment goldbook:N04193 "Some varieties of non-graphitic carbon convert on heat treatment to graphitic carbon but some others do not (non-graphitizable carbon)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:N04193 goldbook:A00294)
AnnotationAssertion(rdfs:seeAlso goldbook:N04193 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:N04193 goldbook:N04194)
AnnotationAssertion(mito:isMentionedBy goldbook:N04193 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04193 "current"^^xsd:string)
Declaration(Class(goldbook:N04194))
AnnotationAssertion(rdfs:label goldbook:N04194 "non-graphitizable carbon")
AnnotationAssertion(dcterms:description goldbook:N04194 "A non-graphitic carbon which cannot be transformed into graphitic carbon solely by high-temperature treatment up to \\(3300\\ \\rm{K}\\) under atmospheric pressure or lower pressure.")
AnnotationAssertion(rdfs:comment goldbook:N04194 "The term non-graphitizable is limited to the result of heat treatment without additional influence of foreign matter or neutron radiation. Non-graphitizable carbon can be transformed into graphitic carbon by a high-temperature process via intermediate dissolution in foreign matter and precipitation under high pressure or by radiation damage."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:N04194 goldbook:D01806)
AnnotationAssertion(rdfs:seeAlso goldbook:N04194 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:N04194 goldbook:G02690)
AnnotationAssertion(rdfs:seeAlso goldbook:N04194 goldbook:N04116)
AnnotationAssertion(rdfs:seeAlso goldbook:N04194 goldbook:N04193)
AnnotationAssertion(rdfs:seeAlso goldbook:N04194 goldbook:P04795)
AnnotationAssertion(mito:isMentionedBy goldbook:N04194 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04194 "current"^^xsd:string)
Declaration(Class(goldbook:N04195))
AnnotationAssertion(rdfs:label goldbook:N04195 "non-isotopic labelling")
AnnotationAssertion(dcterms:description goldbook:N04195 "Labelling in which the resulting product has a different chemical composition from the initial one.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04195 goldbook:L03425)
AnnotationAssertion(mito:isMentionedBy goldbook:N04195 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04195 "current"^^xsd:string)
Declaration(Class(goldbook:N04196))
AnnotationAssertion(rdfs:label goldbook:N04196 "non-linearity error")
AnnotationAssertion(dcterms:description goldbook:N04196 "An error caused by any deviation from linearity of the response of the detector to the measured radiant power.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04196 goldbook:D01650)
AnnotationAssertion(rdfs:seeAlso goldbook:N04196 goldbook:R05046)
AnnotationAssertion(mito:isMentionedBy goldbook:N04196 doi:10.1351/pac198860091449)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04196 "current"^^xsd:string)
Declaration(Class(goldbook:N04197))
AnnotationAssertion(rdfs:label goldbook:N04197 "non-linear optical effect")
AnnotationAssertion(dcterms:description goldbook:N04197 "An effect brought about by electromagnetic radiation the magnitude of which is not proportional to the irradiance. Non-linear optical effects of importance to photochemistry are harmonic frequency generation, lasers, Raman shifting, upconversion, and others.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04197 goldbook:H02744)
AnnotationAssertion(rdfs:seeAlso goldbook:N04197 goldbook:P04588)
AnnotationAssertion(rdfs:seeAlso goldbook:N04197 goldbook:U06574)
