Declaration(Class(goldbook:10786))
AnnotationAssertion(rdfs:label goldbook:10786 "haploid")
AnnotationAssertion(dcterms:description goldbook:10786 "State in which a cell contains only one set of chromosomes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10786 "monoploid")
Declaration(Class(goldbook:10787))
AnnotationAssertion(rdfs:label goldbook:10787 "hemal")
AnnotationAssertion(dcterms:description goldbook:10787 """Pertaining to blood or blood vessels.
Situated, in common with the heart and major blood vessels, on the ventral side of the body with respect to the vertebral column or its embryonic precursors.""")
Declaration(Class(goldbook:10788))
AnnotationAssertion(rdfs:label goldbook:10788 "hemangioma")
AnnotationAssertion(dcterms:description goldbook:10788 "Benign tumor formed by a vascular malformation present at birth or developing during life, in which proliferation of blood vessels leads to a vascular tangle.")
Declaration(Class(goldbook:10789))
AnnotationAssertion(rdfs:label goldbook:10789 "hematopoiesis")
AnnotationAssertion(dcterms:description goldbook:10789 "Development of each of the types of blood cell from common precursor cells, located mainly in the bone marrow.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10789 "hemopoiesis")
Declaration(Class(goldbook:10790))
AnnotationAssertion(rdfs:label goldbook:10790 "hemimelia")
AnnotationAssertion(dcterms:description goldbook:10790 "Congenital partial absence of all or part of the distal half of a limb.")
Declaration(Class(goldbook:10791))
AnnotationAssertion(rdfs:label goldbook:10791 "hemivertebra")
