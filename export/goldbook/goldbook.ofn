Declaration(Class(goldbook:16105))
AnnotationAssertion(rdfs:label goldbook:16105 "subchronic")
AnnotationAssertion(dcterms:description goldbook:16105 "Repeated over a short period, usually about \\(\\pu{10\\%}\\) of the life span; an imprecise term used to describe exposures of intermediate duration.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16105 "semichronic")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16105 "subacute")
AnnotationAssertion(mito:isMentionedBy goldbook:16105 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16105 "current"^^xsd:string)
Declaration(Class(goldbook:16106))
AnnotationAssertion(rdfs:label goldbook:16106 "subchronic effect")
AnnotationAssertion(dcterms:description goldbook:16106 "Biological change resulting from an environmental alteration lasting about \\(\\pu{10\\%}\\) of the lifetime of the test organism.")
AnnotationAssertion(rdfs:comment goldbook:16106 "In practice with experimental animals, such an effect is usually identified as resulting from multiple or continuous exposures occurring over three months (90 days). Sometimes a subchronic effect is distinguished from a subacute effect on the basis of its lasting for a much longer time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:16106 goldbook:16105)
AnnotationAssertion(mito:isMentionedBy goldbook:16106 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16106 "current"^^xsd:string)
Declaration(Class(goldbook:16107))
AnnotationAssertion(rdfs:label goldbook:16107 "subchronic toxicity test")
AnnotationAssertion(dcterms:description goldbook:16107 "Animal experiment serving to study the effects produced by the test substance when administered in repeated doses (or continually in food, drinking water, air) over a period of up to about 90 days.")
AnnotationAssertion(mito:isMentionedBy goldbook:16107 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16107 "current"^^xsd:string)
Declaration(Class(goldbook:16108))
AnnotationAssertion(rdfs:label goldbook:16108 "subclinical effect")
AnnotationAssertion(dcterms:description goldbook:16108 "Biological change with detectable symptoms following exposure to an agent known to cause disease either before symptoms of the disease occur or when they are absent.")
AnnotationAssertion(rdfs:seeAlso goldbook:16108 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:16108 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16108 "current"^^xsd:string)
Declaration(Class(goldbook:16109))
AnnotationAssertion(rdfs:label goldbook:16109 "subfertility")
AnnotationAssertion(dcterms:description goldbook:16109 "Fertility below the normal range for a given species.")
AnnotationAssertion(mito:isMentionedBy goldbook:16109 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16109 "current"^^xsd:string)
Declaration(Class(goldbook:16110))
AnnotationAssertion(rdfs:label goldbook:16110 "subjective environment")
AnnotationAssertion(dcterms:description goldbook:16110 "Surrounding conditions as perceived by persons living in these conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16110 "perceived environment")
AnnotationAssertion(mito:isMentionedBy goldbook:16110 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16110 "current"^^xsd:string)
Declaration(Class(goldbook:16111))
AnnotationAssertion(rdfs:label goldbook:16111 "sufficient evidence")
AnnotationAssertion(dcterms:description goldbook:16111 "According to the USEPA’s Guidelines for Carcinogen Risk Assessment, sufficient evidence is a collection of facts and scientific references that is definite enough to establish that an adverse effect is caused by the agent in question.")
AnnotationAssertion(mito:isMentionedBy goldbook:16111 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16111 "current"^^xsd:string)
Declaration(Class(goldbook:16112))
AnnotationAssertion(rdfs:label goldbook:16112 "suggested no-adverse-response level")
AnnotationAssertion(dcterms:description goldbook:16112 "Maximum dose or concentration that on current understanding is likely to be tolerated by an exposed organism without producing any harm.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16112 "SNARL")
AnnotationAssertion(rdfs:seeAlso goldbook:16112 goldbook:15695)
AnnotationAssertion(mito:isMentionedBy goldbook:16112 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16112 "current"^^xsd:string)
Declaration(Class(goldbook:16113))
