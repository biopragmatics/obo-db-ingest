consider: goldbook:M03858
consider: goldbook:M04000

[Term]
id: goldbook:A00315
name: anaerobe
def: "An organism that does not need free-form oxygen for growth. Many anaerobes are even sensitive to free oxygen. Obligate \(strict\) anaerobes grow only in the absence of oxygen. Facultative anaerobes can grow either in the presence or in the absence of molecular oxygen."
property_value: mito:isMentionedBy doi:10.1351/pac199264010143
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:A00316
name: anaerobic
def: "Not requiring molecular oxygen."
property_value: mito:isMentionedBy doi:10.1351/pac199365092003
property_value: hasStatus "current" xsd:string
consider: goldbook:A00171

[Term]
id: goldbook:A00317
name: anaesthetic
def: "Substance which produces loss of feeling or sensation\: general anaesthetic produces loss of consciousness; local or regional anaesthetic renders a specific area insensible to pain."
property_value: mito:isMentionedBy doi:10.1351/pac199365092003
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:A00318
name: analgesic
def: "Substance which relieves pain\, without causing loss of consciousness."
property_value: mito:isMentionedBy doi:10.1351/pac199365092003
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:A00319
name: analogue metabolism
def: "Process by which a normally non-biodegradable compound is biodegraded in the presence of a structurally similar compound which can induce the necessary enzymes."
property_value: mito:isMentionedBy doi:10.1351/pac199365092003
property_value: hasStatus "current" xsd:string
