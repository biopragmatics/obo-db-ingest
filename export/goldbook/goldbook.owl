    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.S06123 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.S06123">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds having the structure $\ce{RN=S(=O)2}$. (Indexed by Chemical Abstracts Service at the heading sulfimide). E.g. $\ce{CH3N=S(=O)2}$ N-sulfonylmethylamine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>sulfonylamines</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.S06124 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.S06124">
