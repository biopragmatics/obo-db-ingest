AnnotationAssertion(rdfs:label goldbook:10023 "primary reference examination procedure")
AnnotationAssertion(dcterms:description goldbook:10023 "Reference examination procedure used to obtain an examination result without relation to an examination standard for a nominal property of the same kind-of-nominal-property.")
AnnotationAssertion(rdfs:seeAlso goldbook:10023 goldbook:10022)
