AnnotationAssertion(rdfs:seeAlso goldbook:12176 goldbook:12125)
AnnotationAssertion(mito:isMentionedBy goldbook:12176 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12176 "current"^^xsd:string)
Declaration(Class(goldbook:12177))
AnnotationAssertion(rdfs:label goldbook:12177 "Wernicke’s area")
AnnotationAssertion(dcterms:description goldbook:12177 "Region of the brain in superior temporal gyrus of the dominant hemisphere, associated with comprehension of written and spoken language.")
AnnotationAssertion(rdfs:seeAlso goldbook:12177 goldbook:11805)
AnnotationAssertion(mito:isMentionedBy goldbook:12177 doi:10.1515/pac-2015-0103)
