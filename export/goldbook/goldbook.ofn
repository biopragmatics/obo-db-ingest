AnnotationAssertion(rdfs:label goldbook:E02163 "epicadmium neutrons")
AnnotationAssertion(dcterms:description goldbook:E02163 "Neutrons of kinetic energy greater than the effective cadmium cut-off energy.")
AnnotationAssertion(rdfs:seeAlso goldbook:E02163 goldbook:E01891)
AnnotationAssertion(rdfs:seeAlso goldbook:E02163 goldbook:K03402)
AnnotationAssertion(mito:isMentionedBy goldbook:E02163 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:E02163 "current"^^xsd:string)
Declaration(Class(goldbook:E02164))
AnnotationAssertion(rdfs:label goldbook:E02164 "epigenetic")
AnnotationAssertion(dcterms:description goldbook:E02164 "Descriptive term for processes that change the phenotype without altering the genotype.")
AnnotationAssertion(rdfs:seeAlso goldbook:E02164 goldbook:G02617)
AnnotationAssertion(rdfs:seeAlso goldbook:E02164 goldbook:P04542)
AnnotationAssertion(mito:isMentionedBy goldbook:E02164 doi:10.1351/pac199264010143)
