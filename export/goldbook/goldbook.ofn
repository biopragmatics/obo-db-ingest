AnnotationAssertion(rdfs:label goldbook:C01219 "Compton electron")
AnnotationAssertion(dcterms:description goldbook:C01219 "The energetic electron resulting from the Compton effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01219 goldbook:C01218)
AnnotationAssertion(rdfs:seeAlso goldbook:C01219 goldbook:E01975)
AnnotationAssertion(mito:isMentionedBy goldbook:C01219 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01219 "current"^^xsd:string)
Declaration(Class(goldbook:C01224))
AnnotationAssertion(rdfs:label goldbook:C01224 "concentration-cell corrosion")
AnnotationAssertion(dcterms:description goldbook:C01224 "The local variation of the corrosion rate due to the action of a corrosion cell resulting from inhomogeneous composition of the environment.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01224 goldbook:C01352)
AnnotationAssertion(rdfs:seeAlso goldbook:C01224 goldbook:C01358)
AnnotationAssertion(mito:isMentionedBy goldbook:C01224 doi:10.1351/pac198961010019)
