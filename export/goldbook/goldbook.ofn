AnnotationAssertion(dcterms:description goldbook:16049 "Contaminant remaining in an organism or in other material such as food or packaging, following exposure.")
AnnotationAssertion(mito:isMentionedBy goldbook:16049 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16049 "current"^^xsd:string)
Declaration(Class(goldbook:16050))
AnnotationAssertion(rdfs:label goldbook:16050 "resorptive effect")
AnnotationAssertion(dcterms:description goldbook:16050 "Action of a substance after its reabsorption from the gut into the blood.")
AnnotationAssertion(mito:isMentionedBy goldbook:16050 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16050 "current"^^xsd:string)
Declaration(Class(goldbook:16051))
AnnotationAssertion(rdfs:label goldbook:16051 "respirable dust")
AnnotationAssertion(dcterms:description goldbook:16051 "Mass fraction of dust (particles) that penetrates to the unciliated airways of the lung (the alveolar region).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16051 "respirable particles")
AnnotationAssertion(rdfs:comment goldbook:16051 "This fraction is represented by a cumulative log-normal curve having a median aerodynamic diameter of \\(\\pu{4 \\upmu m}\\), standard deviation \\(\\pu{2 \\upmu m}\\) (values for humans)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16051 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16051 "current"^^xsd:string)
Declaration(Class(goldbook:16052))
AnnotationAssertion(rdfs:label goldbook:16052 "retrospective study")
AnnotationAssertion(dcterms:description goldbook:16052 "Research design used to test etiological hypotheses in which inferences about exposure to the putative causal factor(s) are derived from data relating to characteristics of the persons or organisms under study or to events or experiences in their past.")
AnnotationAssertion(rdfs:comment goldbook:16052 "The essential feature is that some of the persons under study have the disease or other outcome condition of interest, and their characteristics and past experiences are compared with those of other, unaffected persons. Persons who differ in the severity of the disease may also be compared."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:16052 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:16052 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16052 "current"^^xsd:string)
Declaration(Class(goldbook:16053))
AnnotationAssertion(rdfs:label goldbook:16053 "returned effect of poisons")
AnnotationAssertion(dcterms:description goldbook:16053 "Enhancement of the dose–effect relationship for a poison following repeated exposure to decreasing doses.")
AnnotationAssertion(mito:isMentionedBy goldbook:16053 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16053 "current"^^xsd:string)
Declaration(Class(goldbook:16054))
AnnotationAssertion(rdfs:label goldbook:16054 "reverse mutation")
AnnotationAssertion(dcterms:description goldbook:16054 "Mutation in a mutant allele which makes it capable of producing the nonmutant phenotype; this may result from restoration of the original DNA sequence of the gene or from production of a new DNA sequence which has the same effect.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16054 "back mutation")
AnnotationAssertion(mito:isMentionedBy goldbook:16054 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16054 "current"^^xsd:string)
Declaration(Class(goldbook:16055))
AnnotationAssertion(rdfs:label goldbook:16055 "reverse transcription")
AnnotationAssertion(dcterms:description goldbook:16055 "Process by which an RNA molecule is used as a template to make a single-stranded DNA copy.")
AnnotationAssertion(mito:isMentionedBy goldbook:16055 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16055 "current"^^xsd:string)
Declaration(Class(goldbook:16056))
AnnotationAssertion(rdfs:label goldbook:16056 "reversible alteration")
AnnotationAssertion(dcterms:description goldbook:16056 "Change from normal structure or function, induced by a substance or other agent(s), that returns to normal status or within normal limits after cessation of exposure.")
AnnotationAssertion(mito:isMentionedBy goldbook:16056 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16056 "current"^^xsd:string)
Declaration(Class(goldbook:16057))
AnnotationAssertion(rdfs:label goldbook:16057 "rhabdomyolysis")
AnnotationAssertion(dcterms:description goldbook:16057 "Acute, fulminating, potentially lethal disease of skeletal muscle that causes disintegration of striated muscle fibers as evidenced by myoglobin in the blood and urine.")
AnnotationAssertion(mito:isMentionedBy goldbook:16057 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16057 "current"^^xsd:string)
Declaration(Class(goldbook:16058))
AnnotationAssertion(rdfs:label goldbook:16058 "rhonchus")
AnnotationAssertion(dcterms:description goldbook:16058 "Harsh crepitation in the throat, often resembling snoring.")
AnnotationAssertion(rdfs:seeAlso goldbook:16058 goldbook:15602)
AnnotationAssertion(mito:isMentionedBy goldbook:16058 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16058 "current"^^xsd:string)
Declaration(Class(goldbook:16059))
AnnotationAssertion(rdfs:label goldbook:16059 "risk associated with a lifetime exposure")
AnnotationAssertion(dcterms:description goldbook:16059 "Probability of the occurrence of a specified undesirable event following exposure of an individual person from a given population to a specified substance at a defined level for the expected lifetime of the average member of that population.")
AnnotationAssertion(mito:isMentionedBy goldbook:16059 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16059 "current"^^xsd:string)
Declaration(Class(goldbook:16060))
AnnotationAssertion(rdfs:label goldbook:16060 "risk aversion")
AnnotationAssertion(dcterms:description goldbook:16060 "Tendency of an individual person to avoid risk.")
AnnotationAssertion(mito:isMentionedBy goldbook:16060 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16060 "current"^^xsd:string)
Declaration(Class(goldbook:16061))
AnnotationAssertion(rdfs:label goldbook:16061 "risk communication")
AnnotationAssertion(dcterms:description goldbook:16061 "Interpretation and communication of risk assessments in terms that are comprehensible to the general public or to others without specialist knowledge.")
AnnotationAssertion(mito:isMentionedBy goldbook:16061 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16061 "current"^^xsd:string)
Declaration(Class(goldbook:16062))
AnnotationAssertion(rdfs:label goldbook:16062 "risk <i>de minimis</i>")
AnnotationAssertion(dcterms:description goldbook:16062 "Risk that is negligible and too small to be of societal concern (usually assumed to be a probability below \\(\\pu{E-5}\\) or \\(\\pu{E-6}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16062 "de minimis risk")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16062 "negligible risk")
AnnotationAssertion(rdfs:comment goldbook:16062 "This term can also mean \"virtually safe\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:16062 "In the United States, this is a legal term used to mean \"negligible risk to the individual\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16062 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16062 "current"^^xsd:string)
Declaration(Class(goldbook:16063))
AnnotationAssertion(rdfs:label goldbook:16063 "risk evaluation")
AnnotationAssertion(dcterms:description goldbook:16063 "Establishment of a qualitative or quantitative relationship between risks and benefits, involving the complex process of determining the significance of the identified hazards and estimated risks to those organisms or people concerned with or affected by them.")
AnnotationAssertion(mito:isMentionedBy goldbook:16063 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16063 "current"^^xsd:string)
Declaration(Class(goldbook:16064))
AnnotationAssertion(rdfs:label goldbook:16064 "risk identification")
AnnotationAssertion(dcterms:description goldbook:16064 "Recognition of a potential hazard and definition of the factors required to assess the probability of exposure of organisms or people to that hazard and of harm resulting from such exposure.")
AnnotationAssertion(mito:isMentionedBy goldbook:16064 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16064 "current"^^xsd:string)
Declaration(Class(goldbook:16065))
AnnotationAssertion(rdfs:label goldbook:16065 "risk marker")
AnnotationAssertion(dcterms:description goldbook:16065 "Attribute that is associated with an increased probability of occurrence of a disease or other specified outcome and that can be used as an indicator of this increased risk.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16065 "risk indicator")
AnnotationAssertion(rdfs:comment goldbook:16065 "A risk marker is not necessarily a causal factor."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16065 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16065 "current"^^xsd:string)
Declaration(Class(goldbook:16066))
AnnotationAssertion(rdfs:label goldbook:16066 "risk monitoring")
AnnotationAssertion(dcterms:description goldbook:16066 "Process of following up the decisions and actions within risk management in order to check whether the aims of reduced exposure and risk are achieved.")
AnnotationAssertion(mito:isMentionedBy goldbook:16066 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16066 "current"^^xsd:string)
Declaration(Class(goldbook:16067))
AnnotationAssertion(rdfs:label goldbook:16067 "risk perception")
AnnotationAssertion(dcterms:description goldbook:16067 "Subjective perception of the gravity or importance of the risk based on a person’s knowledge of different risks and the moral, economic, and political judgment of their implications.")
AnnotationAssertion(mito:isMentionedBy goldbook:16067 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16067 "current"^^xsd:string)
