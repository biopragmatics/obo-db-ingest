AnnotationAssertion(rdfs:label goldbook:C00854 "carbynes")
AnnotationAssertion(dcterms:description goldbook:C00854 "The neutral species $\\ce{HC_{^\\vdots}}$ (methylidyne) and its derivatives formed by substitution in which a univalent carbon atom is covalently bonded to one group and also bears three nonbonding electrons. (This term carries no implication about spin-pairing).")
AnnotationAssertion(mito:isMentionedBy goldbook:C00854 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00854 "current"^^xsd:string)
