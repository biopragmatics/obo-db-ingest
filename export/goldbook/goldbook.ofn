AnnotationAssertion(rdfs:seeAlso goldbook:13628 goldbook:13431)
AnnotationAssertion(mito:isMentionedBy goldbook:13628 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13628 "current"^^xsd:string)
Declaration(Class(goldbook:13629))
AnnotationAssertion(rdfs:label goldbook:13629 "radial immunodiffusion")
AnnotationAssertion(dcterms:description goldbook:13629 "Method for quantifying an antigen by measuring the diameters of circular precipitates around an antigen-spiked cavity in an antibody-containing agar gel.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13629 "Mancini immunodiffusion")
AnnotationAssertion(mito:isMentionedBy goldbook:13629 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13629 "current"^^xsd:string)
Declaration(Class(goldbook:13630))
AnnotationAssertion(rdfs:label goldbook:13630 "radioallergosorbent test")
AnnotationAssertion(dcterms:description goldbook:13630 "Solid-phase radioimmunoassay (RIA) for detecting immunoglobulin E (IgE) antibody specific for a particular antigen.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13630 "RAST")
AnnotationAssertion(rdfs:seeAlso goldbook:13630 goldbook:13288)
AnnotationAssertion(mito:isMentionedBy goldbook:13630 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13630 "current"^^xsd:string)
Declaration(Class(goldbook:13631))
AnnotationAssertion(rdfs:label goldbook:13631 "radioimmunoconjugate")
AnnotationAssertion(dcterms:description goldbook:13631 "Biochemical conjugate consisting of an immune-targeting molecule such as an antibody or antibody fragment together with a cytotoxic radionuclide.")
AnnotationAssertion(rdfs:seeAlso goldbook:13631 goldbook:13071)
AnnotationAssertion(mito:isMentionedBy goldbook:13631 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13631 "current"^^xsd:string)
Declaration(Class(goldbook:13632))
AnnotationAssertion(rdfs:label goldbook:13632 "Raynaud phenomenon")
AnnotationAssertion(dcterms:description goldbook:13632 "Intermittent bilateral attacks of vasospasm and ischemia of the fingers or toes and sometimes of the ears and nose, marked by a severe pallor and often accompanied by paresthesia and pain.")
AnnotationAssertion(rdfs:comment goldbook:13632 "It is brought on characteristically by cold or emotional stimuli and relieved by heat, and may be due to an underlying disease or anatomic abnormality."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13632 "The phenomenon is more common in women than men and occurs in most patients with progressive systemic sclerosis (SSc), mixed connective tissue disease (MCTD), and polymyositis/scleroderma overlap syndrome."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13632 "When the condition is idiopathic or primary, it is termed Raynaud disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13632 goldbook:13249)
AnnotationAssertion(rdfs:seeAlso goldbook:13632 goldbook:13465)
AnnotationAssertion(rdfs:seeAlso goldbook:13632 goldbook:13609)
AnnotationAssertion(mito:isMentionedBy goldbook:13632 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13632 "current"^^xsd:string)
Declaration(Class(goldbook:13633))
AnnotationAssertion(rdfs:label goldbook:13633 "reactive airways dysfunction syndrome")
AnnotationAssertion(dcterms:description goldbook:13633 "Syndrome characterized by reversible airflow limitation and complicating bronchial hyperresponsiveness induced by acute exposure to high concentrations of non-sensitizer irritant gases.")
