[Term]
id: goldbook:12198
name: root-mean-square unperturbed end-to-end distance
def: "Root-mean-square end-to-end distance of a chain having unperturbed dimensions."
comment: "If no ambiguity results, the term "unperturbed end-to-end distance" can be used."
property_value: mito:isMentionedBy doi:10.1515/pac-2013-0201
