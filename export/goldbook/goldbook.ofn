AnnotationAssertion(mito:isMentionedBy goldbook:N04217 doi:10.1351/pac199163050735)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04217 "current"^^xsd:string)
Declaration(Class(goldbook:N04218))
AnnotationAssertion(rdfs:label goldbook:N04218 "Norrish Type II photoreaction")
AnnotationAssertion(dcterms:description goldbook:N04218 "Intramolecular abstraction of a $\\ce{\\upgamma\\!\\mbox{-}hydrogen}$ by an excited carbonyl compound to produce a 1,4-diradical as a primary photoproduct.")
AnnotationAssertion(rdfs:comment goldbook:N04218 "An example is: "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:N04218 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:N04218 goldbook:A00045)
AnnotationAssertion(mito:isMentionedBy goldbook:N04218 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04218 "current"^^xsd:string)
Declaration(Class(goldbook:N04219))
AnnotationAssertion(rdfs:label goldbook:N04219 "Norrish Type I photoreaction")
AnnotationAssertion(dcterms:description goldbook:N04219 "$\\ce{\\upalpha\\!\\mbox{-}Cleavage}$ of an excited carbonyl compound leading to an acyl-alkyl radical pair (from an acyclic carbonyl compound) or an acyl-alkyl diradical (from a cyclic carbonyl compound) as a primary photoproduct.")
AnnotationAssertion(rdfs:comment goldbook:N04219 "An example is: "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:N04219 "Decarbonylation of the primary diradical formed from cyclic carbonyl compounds and subsequent recombination of the biradical afford very interesting cyclic compounds."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:N04219 goldbook:B00671)
AnnotationAssertion(rdfs:seeAlso goldbook:N04219 goldbook:C00844)
AnnotationAssertion(mito:isMentionedBy goldbook:N04219 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04219 "current"^^xsd:string)
