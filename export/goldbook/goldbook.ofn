AnnotationAssertion(mito:isMentionedBy goldbook:M03869 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03869 "current"^^xsd:string)
Declaration(Class(goldbook:M03870))
AnnotationAssertion(rdfs:label goldbook:M03870 "metamagnetic transition")
AnnotationAssertion(dcterms:description goldbook:M03870 "An antiferromagnetic to ferromagnetic transition for \\(H_{\\rm{applied}}>H_{\\rm{c}}\\) and/or \\(T>T_{\\rm{t}}\\) where \\(H_{\\rm{c}}\\) and \\(T_{\\rm{t}}\\) refer to the critical magnetic field and transition temperature, respectively.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03870 goldbook:A00393)
AnnotationAssertion(rdfs:seeAlso goldbook:M03870 goldbook:F02349)
AnnotationAssertion(mito:isMentionedBy goldbook:M03870 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03870 "current"^^xsd:string)
Declaration(Class(goldbook:M03871))
AnnotationAssertion(rdfs:label goldbook:M03871 "metastability")
AnnotationAssertion(dcterms:description goldbook:M03871 "A term that describes the state of a phase in which an energy barrier considerably higher than \\(k\\ T\\) must be surmounted before this phase can transform to a phase of lower molar Gibbs energy and molar Helmholtz energy, where \\(k\\) is the Boltzmann constant and \\(T\\) the thermodynamic temperature.")
AnnotationAssertion(rdfs:comment goldbook:M03871 "In a thermodynamic sense, the equilibrium state is the state with the lowest molar Gibbs energy; a metastable state corresponds to a relative minimum in the molar Gibbs energy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M03871 goldbook:B00695)
AnnotationAssertion(rdfs:seeAlso goldbook:M03871 goldbook:G02629)
AnnotationAssertion(rdfs:seeAlso goldbook:M03871 goldbook:H02772)
AnnotationAssertion(rdfs:seeAlso goldbook:M03871 goldbook:M03872)
AnnotationAssertion(rdfs:seeAlso goldbook:M03871 goldbook:T06321)
AnnotationAssertion(mito:isMentionedBy goldbook:M03871 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03871 "current"^^xsd:string)
Declaration(Class(goldbook:M03874))
AnnotationAssertion(rdfs:label goldbook:M03874 "metastable ion")
AnnotationAssertion(dcterms:description goldbook:M03874 "An ion which is formed with sufficient excitation to dissociate spontaneously during its flight from the ion source to the detector.")
AnnotationAssertion(mito:isMentionedBy goldbook:M03874 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03874 "current"^^xsd:string)
Declaration(Class(goldbook:M03875))
AnnotationAssertion(rdfs:label goldbook:M03875 "metastable state")
AnnotationAssertion(dcterms:description goldbook:M03875 "An isomeric state in an energy state higher than the ground state.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03875 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:M03875 goldbook:I03292)
AnnotationAssertion(mito:isMentionedBy goldbook:M03875 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03875 "current"^^xsd:string)
Declaration(Class(goldbook:M03876))
AnnotationAssertion(rdfs:label goldbook:M03876 "metastable state")
AnnotationAssertion(dcterms:description goldbook:M03876 "Any excited state which in principle, by virtue of the selection rules, cannot radiatively combine with any lower state. It usually has a considerably longer lifetime than an ordinary excited state.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:M03876 "metastable")
AnnotationAssertion(rdfs:seeAlso goldbook:M03876 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:M03876 goldbook:L03515)
AnnotationAssertion(rdfs:seeAlso goldbook:M03876 goldbook:M03874)
AnnotationAssertion(rdfs:seeAlso goldbook:M03876 goldbook:M03875)
AnnotationAssertion(rdfs:seeAlso goldbook:M03876 goldbook:T06451)
AnnotationAssertion(mito:isMentionedBy goldbook:M03876 doi:10.1351/pac198557101453)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03876 "current"^^xsd:string)
Declaration(Class(goldbook:M03878))
AnnotationAssertion(rdfs:label goldbook:M03878 "metathesis")
AnnotationAssertion(dcterms:description goldbook:M03878 "A bimolecular process formally involving the exchange of a bond (or bonds) between similar interacting chemical species so that the bonding affiliations in the products are identical (or closely similar) to those in the reactants. For example:  (The term has its origin in inorganic chemistry with a different meaning, but this older usage is not applicable in physical organic chemistry.)")
AnnotationAssertion(rdfs:seeAlso goldbook:M03878 goldbook:M03989)
AnnotationAssertion(rdfs:seeAlso goldbook:M03878 goldbook:CT01038)
AnnotationAssertion(mito:isMentionedBy goldbook:M03878 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03878 "current"^^xsd:string)
Declaration(Class(goldbook:M03879))
AnnotationAssertion(rdfs:label goldbook:M03879 "methanogens")
AnnotationAssertion(dcterms:description goldbook:M03879 "Strictly anaerobic archaebacteria, able to use only a very limited substrate spectrum (e.g. molecular hydrogen, formate, methanol, methylamine, carbon monoxide or acetate) as electron donors for the reduction of carbon dioxide to methane.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03879 goldbook:A00316)
AnnotationAssertion(mito:isMentionedBy goldbook:M03879 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03879 "current"^^xsd:string)
Declaration(Class(goldbook:M03880))
AnnotationAssertion(rdfs:label goldbook:M03880 "method of isotopic perturbation")
AnnotationAssertion(dcterms:description goldbook:M03880 "NMR shift difference measurement of the isotope effect on a fast (degenerate) equilibrium between two species which are equivalent except for isotopic substitution. This can be used to distinguish a rapidly equilibrating mixture with time-averaged symmetry from a single structure with higher symmetry.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03880 goldbook:I03327)
AnnotationAssertion(mito:isMentionedBy goldbook:M03880 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03880 "current"^^xsd:string)
Declaration(Class(goldbook:M03883))
AnnotationAssertion(rdfs:label goldbook:M03883 "methylotrophic microorganisms")
AnnotationAssertion(dcterms:description goldbook:M03883 "Organisms that use, as substrates for growth, $\\ce{C}$ compounds containing carbon in a lower oxidation state than in carbon dioxide.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03883 goldbook:O04365)
AnnotationAssertion(mito:isMentionedBy goldbook:M03883 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03883 "current"^^xsd:string)
Declaration(Class(goldbook:M03885))
AnnotationAssertion(rdfs:label goldbook:M03885 "micellar catalysis")
AnnotationAssertion(dcterms:description goldbook:M03885 "The acceleration of a chemical reaction in solution by the addition of a surfactant at a concentration higher than its critical micelle concentration so that the reaction can proceed in the environment of surfactant aggregates (micelles). (Rate enhancements may be due, for example, to higher concentration of the reactants in that environment, more favourable orientation and solvation of the species, or enhanced rate constants in the micellar pseudophase of the surfactant aggregate.) Micelle formation can also lead to a decreased reaction rate.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03885 goldbook:A00051)
AnnotationAssertion(rdfs:seeAlso goldbook:M03885 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:M03885 goldbook:C01033)
AnnotationAssertion(rdfs:seeAlso goldbook:M03885 goldbook:C01395)
AnnotationAssertion(rdfs:seeAlso goldbook:M03885 goldbook:M03889)
AnnotationAssertion(rdfs:seeAlso goldbook:M03885 goldbook:S05747)
AnnotationAssertion(mito:isMentionedBy goldbook:M03885 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03885 "current"^^xsd:string)
Declaration(Class(goldbook:M03886))
AnnotationAssertion(rdfs:label goldbook:M03886 "micellar mass")
AnnotationAssertion(dcterms:description goldbook:M03886 "The term usually refers to a neutral micelle and therefore includes an equivalent amount of counter-ions with the surfactant ions.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03886 goldbook:C01371)
AnnotationAssertion(rdfs:seeAlso goldbook:M03886 goldbook:M03889)
AnnotationAssertion(rdfs:seeAlso goldbook:M03886 goldbook:S06194)
AnnotationAssertion(mito:isMentionedBy goldbook:M03886 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03886 "current"^^xsd:string)
Declaration(Class(goldbook:M03887))
AnnotationAssertion(rdfs:label goldbook:M03887 "micellar solubilization")
AnnotationAssertion(dcterms:description goldbook:M03887 "In a system formed by a solvent, an association colloid and at least one other component (the solubilizate), the incorporation of this other component into or on the micelles is called micellar solubilization, or, briefly, solubilization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:M03887 "solubilization")
AnnotationAssertion(rdfs:seeAlso goldbook:M03887 goldbook:A00472)
AnnotationAssertion(rdfs:seeAlso goldbook:M03887 goldbook:C01171)
AnnotationAssertion(rdfs:seeAlso goldbook:M03887 goldbook:M03889)
AnnotationAssertion(mito:isMentionedBy goldbook:M03887 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03887 "current"^^xsd:string)
Declaration(Class(goldbook:M03889))
AnnotationAssertion(rdfs:label goldbook:M03889 "micelle")
AnnotationAssertion(dcterms:description goldbook:M03889 "Surfactants in solution are often association colloids, that is, they tend to form aggregates of colloidal dimensions, which exist in equilibrium with the molecules or ions from which they are formed. Such aggregates are termed micelles.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03889 goldbook:S06194)
AnnotationAssertion(rdfs:seeAlso goldbook:M03889 goldbook:A00472)
AnnotationAssertion(rdfs:seeAlso goldbook:M03889 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:M03889 goldbook:I03151)
AnnotationAssertion(mito:isMentionedBy goldbook:M03889 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03889 "current"^^xsd:string)
Declaration(Class(goldbook:M03890))
AnnotationAssertion(rdfs:label goldbook:M03890 "micelle charge")
AnnotationAssertion(dcterms:description goldbook:M03890 "Usually understood to include the net charge of the surfactant ions and the counterions bound to the micelle.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03890 goldbook:M03889)
AnnotationAssertion(rdfs:seeAlso goldbook:M03890 goldbook:S06194)
AnnotationAssertion(mito:isMentionedBy goldbook:M03890 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03890 "current"^^xsd:string)
Declaration(Class(goldbook:M03891))
AnnotationAssertion(rdfs:label goldbook:M03891 "Michaelis constant")
AnnotationAssertion(dcterms:description goldbook:M03891 "Substance concentration of substrate at which the rate of reaction is equal to one half of the limiting rate (maximum rate).")
AnnotationAssertion(rdfs:comment goldbook:M03891 "Also called the Michaelis concentration"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:M03891 "The Michaelis constant (Michaelis concentration) may be used only when @M03892@ is obeyed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M03891 goldbook:M03892)
AnnotationAssertion(rdfs:seeAlso goldbook:M03891 goldbook:S06072)
AnnotationAssertion(rdfs:seeAlso goldbook:M03891 goldbook:R05156)
AnnotationAssertion(rdfs:seeAlso goldbook:M03891 goldbook:S06082)
AnnotationAssertion(mito:isMentionedBy goldbook:M03891 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03891 "current"^^xsd:string)
Declaration(Class(goldbook:M03892))
AnnotationAssertion(rdfs:label goldbook:M03892 "Michaelis–Menten kinetics")
AnnotationAssertion(dcterms:description goldbook:M03892 "The dependence of an initial rate of reaction upon the concentration of a substrate S that is present in large excess over the concentration of an enzyme or other catalyst (or reagent) E with the appearance of saturation behaviour following the Michaelis-Menten equation: \\[ u=\\frac{V\\ \\left[\\rm{S}\\right]}{K_{\\rm{m}}+\\left[\\rm{S}\\right]}\\] where \\( u\\) is the observed initial rate, \\(V\\) is its limiting value at substrate saturation (i.e. \\(\\left[\\rm{S}\\right]\\gg K_{\\rm{m}}\\)), and \\(K_{\\rm{m}}\\) the substrate concentration when \\( u = \\frac{V}{2}\\). The definition is experimental, i.e. it applies to any reaction that follows an equation of this general form. The symbols \\(V_{\\max }\\) or \\( u_{\\max }\\) are sometimes used for \\(V\\). The parameters \\(V\\) and \\(K_{\\rm{m}}\\) (the 'Michaelis constant') of the equation can be evaluated from the slope and intercept of a linear plot of \\( u^{-1}\\) vs. \\(\\left[\\rm{S}\\right]^{-1}\\) (a 'Lineweaver–Burk plot') or from slope and intercept of a linear plot of \\( u\\) vs. \\(\\frac{ u}{\\left[\\rm{S}\\right]}\\) ('Eadie–Hofstee plot'). A Michaelis–Menten equation is also applicable to the condition where E is present in large excess, in which case the concentration \\(\\left[\\rm{E}\\right]\\) appears in the equation instead of \\(\\left[\\rm{S}\\right]\\). The term has sometimes been used to describe reactions that proceed according to the scheme: \\[\\rm{E}+\\rm{S}\\overset{k_{1}}{\\underset{k_{-1}}\\rightleftarrows }\\rm{ES}\\overset{k_{\\rm{cat}}}{\\rightarrow }\\rm{Products}\\] in which case \\(K_{\\rm{m}} = \\frac{k_{-1}+k_{\\rm{cat}}}{k_{1}}\\) (Briggs–Haldane conditions). It has more usually been applied only to the special case in which \\(k_{-1}\\gg k_{\\rm{cat}}\\) and \\(K_{\\rm{m}} = \\frac{k_{-1}}{k_{1}}=K_{s}\\); in this case \\(K_{\\rm{m}}\\) is a true dissociation constant (Michaelis–Menten conditions).")
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:L03566)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:M03891)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:D01801)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:R05156)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:R05140)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:R05190)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:S05472)
AnnotationAssertion(rdfs:seeAlso goldbook:M03892 goldbook:S06082)
AnnotationAssertion(mito:isMentionedBy goldbook:M03892 doi:10.1351/pac199466051077)
AnnotationAssertion(mito:isMentionedBy goldbook:M03892 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03892 "current"^^xsd:string)
Declaration(Class(goldbook:M03893))
AnnotationAssertion(rdfs:label goldbook:M03893 "Michaelis–Menten mechanism")
AnnotationAssertion(dcterms:description goldbook:M03893 "The Michaelis–Menten mechanism is the simplest mechanism that will explain Michaelis–Menten kinetics. According to the mechanism, a substrate A first combines with a molecule of enzyme E, and this process is followed by a step in which the enzyme-substrate complex EA breaks down (sometimes with the participation of the solvent) into enzyme and reaction products: \\[\\rm{E}+\\rm{A}\\overset{k_{1}}{\\underset{k_{-1}}\\rightleftharpoons }\\rm{EA}\\overset{k_{2}}{\\rightarrow }\\rm{E}+\\rm{Products}\\] If, as is usual, the substrate A is present in great excess of the enzyme it can be shown that steady-state conditions apply, and that the rate equation is: \\[v = \\frac{k_{2}\\ \\left[\\rm{E}\\right]_{0}\\ \\left[\\rm{A}\\right]}{\\frac{k_{-1}\\,+\\,k_{2}}{k_{1}}\\,+\\,\\left[\\rm{A}\\right]}\\] where \\(\\left[\\rm{E}\\right]_{0}\\) is the total concentration of enzyme. This equation is of the form of the Michaelis–Menten equation. Other, more complicated, mechanisms lead to the Michaelis–Menten equation, adherence to which therefore does not require that the Michaelis– Menten mechanism applies.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03893 goldbook:M03892)
AnnotationAssertion(mito:isMentionedBy goldbook:M03893 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03893 "current"^^xsd:string)
Declaration(Class(goldbook:M03895))
AnnotationAssertion(rdfs:label goldbook:M03895 "microbial leaching")
AnnotationAssertion(dcterms:description goldbook:M03895 "A process for the solubilization of metals, mostly from poor ores, by lithotrophic bacteria.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03895 goldbook:M03887)
AnnotationAssertion(mito:isMentionedBy goldbook:M03895 doi:10.1351/pac199264010143)
