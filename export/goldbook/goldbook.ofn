Declaration(Class(goldbook:10672))
AnnotationAssertion(rdfs:label goldbook:10672 "epispadias")
AnnotationAssertion(dcterms:description goldbook:10672 "Malformation in which the urethra does not develop to full length, opening typically on the dorsum of the penis (and rarely, in females, between the clitoris and labia); frequently associated with exstrophy of the bladder.")
Declaration(Class(goldbook:10673))
AnnotationAssertion(rdfs:label goldbook:10673 "epistasis")
AnnotationAssertion(dcterms:description goldbook:10673 "Situation in which the phenotypic expression of one gene obscures the phenotypic effects of another gene.")
Declaration(Class(goldbook:10674))
AnnotationAssertion(rdfs:label goldbook:10674 "epithelium")
