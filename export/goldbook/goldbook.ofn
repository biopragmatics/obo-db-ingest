Declaration(Class(goldbook:11757))
AnnotationAssertion(rdfs:label goldbook:11757 "ependymoma")
AnnotationAssertion(dcterms:description goldbook:11757 "Growth in the brain or spinal cord arising from ependymal tissue.")
AnnotationAssertion(rdfs:comment goldbook:11757 "Because cerebrospinal fluid normally flows through the ependymal tissue-lined ventricles, blockage due to an ependymoma can cause build up of fluid, increased intracranial pressure, and hydrocephalus."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11757 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11757 goldbook:11756)
AnnotationAssertion(rdfs:seeAlso goldbook:11757 goldbook:11836)
AnnotationAssertion(rdfs:seeAlso goldbook:11757 goldbook:12163)
