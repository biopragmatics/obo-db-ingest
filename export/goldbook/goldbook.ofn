AnnotationAssertion(rdfs:label goldbook:13041 "contact dermatitis")
AnnotationAssertion(dcterms:description goldbook:13041 "Skin inflammation that occurs when the skin’s surface comes in contact with a substance originating outside the body.")
AnnotationAssertion(rdfs:comment goldbook:13041 "There are two kinds of contact dermatitis, irritant and allergic."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13041 goldbook:12858)
AnnotationAssertion(mito:isMentionedBy goldbook:13041 doi:10.1351/PAC-REC-11-06-03)
