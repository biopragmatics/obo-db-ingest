AnnotationAssertion(obo:goldbook#hasStatus goldbook:13435 "current"^^xsd:string)
Declaration(Class(goldbook:13436))
AnnotationAssertion(rdfs:label goldbook:13436 "mammalian target of rapamycin")
AnnotationAssertion(dcterms:description goldbook:13436 "Intracellular signaling molecule (phosphoinositide-3-kinase) involved in control of cell growth, whose activity is negatively influenced by the immunosuppressive drug rapamycin.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13436 "mTOR")
AnnotationAssertion(rdfs:seeAlso goldbook:13436 goldbook:13320)
AnnotationAssertion(mito:isMentionedBy goldbook:13436 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13436 "current"^^xsd:string)
Declaration(Class(goldbook:13437))
AnnotationAssertion(rdfs:label goldbook:13437 "mannan-binding lectin-associated serine peptidase-1 and -2")
AnnotationAssertion(dcterms:description goldbook:13437 "Complement-dependent bactericidal factors that bind to the Ra and R2 polysaccharides expressed by certain enterobacterium strains, such as Ra chemotype strains of Salmonella.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13437 "mannose-binding protein-associated serine protease (MASP)")
AnnotationAssertion(rdfs:comment goldbook:13437 "Alternate splicing of the genes results in multiple transcript variants encoding two Ra-reactive factors (RARF) that are involved in the mannose-binding lectin (MBL) pathway of complement activation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13437 "They are serine proteases that share about \\(\\pu{40\\%}\\) sequence identity with complement components C1r and C1s."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13437 goldbook:13001)
AnnotationAssertion(rdfs:seeAlso goldbook:13437 goldbook:13438)
AnnotationAssertion(mito:isMentionedBy goldbook:13437 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13437 "current"^^xsd:string)
Declaration(Class(goldbook:13438))
AnnotationAssertion(rdfs:label goldbook:13438 "mannose-binding protein")
AnnotationAssertion(dcterms:description goldbook:13438 "Member of the collectin family of calcium-dependent lectins, and an acute-phase protein.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13438 "MBP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13438 "mannose-binding lectin (MBL)")
AnnotationAssertion(rdfs:comment goldbook:13438 "This lectin functions as a stimulator of the classical pathway of complement activation, and as an opsonin for phagocytosis by binding to mannose, a sugar residue usually found in an exposed form only on the surface of microorganisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13438 goldbook:12839)
AnnotationAssertion(rdfs:seeAlso goldbook:13438 goldbook:13011)
AnnotationAssertion(rdfs:seeAlso goldbook:13438 goldbook:13023)
AnnotationAssertion(rdfs:seeAlso goldbook:13438 goldbook:13562)
AnnotationAssertion(mito:isMentionedBy goldbook:13438 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13438 "current"^^xsd:string)
Declaration(Class(goldbook:13439))
AnnotationAssertion(rdfs:label goldbook:13439 "mantle zone")
AnnotationAssertion(dcterms:description goldbook:13439 "Outer ring of small lymphocytes surrounding the center of a lymphatic nodule (lymphoid follicle). It contains transient lymphocytes and is the location of the lymphoma in mantle cell lymphoma.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13439 "corona")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13439 "mantle")
AnnotationAssertion(rdfs:seeAlso goldbook:13439 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13439 goldbook:13412)
AnnotationAssertion(rdfs:seeAlso goldbook:13439 goldbook:13417)
AnnotationAssertion(mito:isMentionedBy goldbook:13439 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13439 "current"^^xsd:string)
Declaration(Class(goldbook:13440))
AnnotationAssertion(rdfs:label goldbook:13440 "marginal zone")
AnnotationAssertion(dcterms:description goldbook:13440 "Outer area of the splenic periarteriolar lymphoid sheath (PALS) that is rich in B cells, particularly those responding to thymus-independent antigens.")
AnnotationAssertion(rdfs:seeAlso goldbook:13440 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13440 goldbook:13691)
AnnotationAssertion(mito:isMentionedBy goldbook:13440 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13440 "current"^^xsd:string)
Declaration(Class(goldbook:13441))
AnnotationAssertion(rdfs:label goldbook:13441 "margination")
AnnotationAssertion(dcterms:description goldbook:13441 "Leukocyte adhesion to the endothelium of blood vessels in the early phase of an acute inflammatory response.")
AnnotationAssertion(rdfs:seeAlso goldbook:13441 goldbook:13379)
AnnotationAssertion(mito:isMentionedBy goldbook:13441 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13441 "current"^^xsd:string)
Declaration(Class(goldbook:13442))
AnnotationAssertion(rdfs:label goldbook:13442 "mast cell")
AnnotationAssertion(dcterms:description goldbook:13442 "Large connective tissue cell that contains inflammatory substances such as histamine, proteases (including tryptases, chymases, and carboxypeptidase A), heparin and chondroitin sulfate proteoglycans, and eicosanoid lipid mediators (the precursors of leukotrienes and prostaglandins). These substances are released in allergic reactions or in response to injury or inflammation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13442 "mastocyte")
AnnotationAssertion(rdfs:comment goldbook:13442 "Mast cells are bound within tissues that interface with the external world such as the skin, respiratory or intestinal tract, as well as in other areas such as heart, synovium, and uterus. Mast cells do not circulate. The mast cell has binding sites on its surface for immunoglobulin E (IgE)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13442 goldbook:12858)
AnnotationAssertion(rdfs:seeAlso goldbook:13442 goldbook:13288)
AnnotationAssertion(rdfs:seeAlso goldbook:13442 goldbook:13384)
AnnotationAssertion(mito:isMentionedBy goldbook:13442 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13442 "current"^^xsd:string)
Declaration(Class(goldbook:13443))
AnnotationAssertion(rdfs:label goldbook:13443 "mast cell activation disorder")
AnnotationAssertion(dcterms:description goldbook:13443 "Disorder or syndrome in which there is evidence of systemic, inappropriate release of mast cell mediators.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13443 "mast cell activation syndrome")
AnnotationAssertion(rdfs:comment goldbook:13443 "While people with MCAD/MCAS have a normal or near-normal tryptase level and a bone marrow biopsy that contains a normal number of mast cells, they experience most of the same symptoms as someone with mastocytosis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13443 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13443 goldbook:13442)
AnnotationAssertion(rdfs:seeAlso goldbook:13443 goldbook:13446)
AnnotationAssertion(rdfs:seeAlso goldbook:13443 goldbook:13708)
AnnotationAssertion(mito:isMentionedBy goldbook:13443 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13443 "current"^^xsd:string)
Declaration(Class(goldbook:13444))
AnnotationAssertion(rdfs:label goldbook:13444 "mast cell stabilizer")
AnnotationAssertion(dcterms:description goldbook:13444 "Non-steroidal medication that reduces the release of substances from mast cells, e.g., sodium cromoglycate.")
AnnotationAssertion(rdfs:seeAlso goldbook:13444 goldbook:13442)
AnnotationAssertion(mito:isMentionedBy goldbook:13444 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13444 "current"^^xsd:string)
Declaration(Class(goldbook:13445))
AnnotationAssertion(rdfs:label goldbook:13445 "mastocytoma")
AnnotationAssertion(dcterms:description goldbook:13445 "Nodule of mast cells that can involve the skin, subcutaneous tissue, and sometimes muscle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13445 "mast cell tumor")
AnnotationAssertion(rdfs:comment goldbook:13445 "Mastocytomas are rare and are mostly seen in infants within the first three months of life."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13445 goldbook:13442)
AnnotationAssertion(mito:isMentionedBy goldbook:13445 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13445 "current"^^xsd:string)
Declaration(Class(goldbook:13446))
AnnotationAssertion(rdfs:label goldbook:13446 "mastocytosis")
AnnotationAssertion(dcterms:description goldbook:13446 "Rare disease characterized by the presence of too many mast cells in various organs and tissues. The condition can be a chronic, long-term illness or it can develop suddenly.")
AnnotationAssertion(rdfs:comment goldbook:13446 "Mastocytosis may be systemic, involving a variety of organs, or cutaneous, involving only the skin, also referred to as urticaria pigmentosa."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13446 goldbook:13442)
AnnotationAssertion(rdfs:seeAlso goldbook:13446 goldbook:13708)
AnnotationAssertion(mito:isMentionedBy goldbook:13446 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13446 "current"^^xsd:string)
Declaration(Class(goldbook:13447))
AnnotationAssertion(rdfs:label goldbook:13447 "maturation")
AnnotationAssertion(dcterms:description goldbook:13447 "Process by which B cells produce antibodies with increased affinity for antigen during the course of an immune response.")
AnnotationAssertion(rdfs:seeAlso goldbook:13447 goldbook:12937)
AnnotationAssertion(mito:isMentionedBy goldbook:13447 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13447 "current"^^xsd:string)
Declaration(Class(goldbook:13448))
AnnotationAssertion(rdfs:label goldbook:13448 "mature B cell")
AnnotationAssertion(dcterms:description goldbook:13448 "B cell with immunoglobulin M (IgM) and immunoglobulin D (IgD) on its surface.")
AnnotationAssertion(rdfs:seeAlso goldbook:13448 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13448 goldbook:13287)
AnnotationAssertion(rdfs:seeAlso goldbook:13448 goldbook:13293)
AnnotationAssertion(mito:isMentionedBy goldbook:13448 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13448 "current"^^xsd:string)
Declaration(Class(goldbook:13449))
AnnotationAssertion(rdfs:label goldbook:13449 "megakaryocyte")
AnnotationAssertion(dcterms:description goldbook:13449 "Bone marrow precursor of platelets.")
AnnotationAssertion(rdfs:seeAlso goldbook:13449 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:13449 goldbook:13580)
AnnotationAssertion(mito:isMentionedBy goldbook:13449 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13449 "current"^^xsd:string)
Declaration(Class(goldbook:13450))
AnnotationAssertion(rdfs:label goldbook:13450 "membrane attack complex")
AnnotationAssertion(dcterms:description goldbook:13450 "Complex of complement components C5b–C9 that inserts as a pore into the membrane of target cells leading to cell lysis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:13450 "MAC")
AnnotationAssertion(rdfs:seeAlso goldbook:13450 goldbook:13727)
AnnotationAssertion(mito:isMentionedBy goldbook:13450 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13450 "current"^^xsd:string)
Declaration(Class(goldbook:13451))
AnnotationAssertion(rdfs:label goldbook:13451 "memory")
AnnotationAssertion(dcterms:description goldbook:13451 "Characteristic of the acquired immune response (see acquired immunity) of lymphocytes whereby a second encounter with a given antigen produces a secondary immune response that is faster, greater, and longer lasting than the primary immune response.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13451 "immunological memory")
AnnotationAssertion(rdfs:seeAlso goldbook:13451 goldbook:12832)
AnnotationAssertion(rdfs:seeAlso goldbook:13451 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13451 goldbook:13601)
AnnotationAssertion(mito:isMentionedBy goldbook:13451 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13451 "current"^^xsd:string)
Declaration(Class(goldbook:13452))
AnnotationAssertion(rdfs:label goldbook:13452 "memory cell")
AnnotationAssertion(dcterms:description goldbook:13452 "Clonally expanded T cell or B cell produced during a primary immune response and which is primed to mediate a secondary immune response to the original antigen.")
AnnotationAssertion(rdfs:seeAlso goldbook:13452 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13452 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13452 goldbook:13601)
AnnotationAssertion(rdfs:seeAlso goldbook:13452 goldbook:13607)
AnnotationAssertion(rdfs:seeAlso goldbook:13452 goldbook:13662)
