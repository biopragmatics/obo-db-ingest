        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development and growth of an embryo in the period from formation of the bilaminar embryo to the beginning of the fetal period (in humans, the second through the eighth week after conception).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>embryogenesis</rdfs:label>
