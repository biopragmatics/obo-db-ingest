Declaration(Class(goldbook:L03592))
AnnotationAssertion(rdfs:label goldbook:L03592 "lithometeor")
AnnotationAssertion(dcterms:description goldbook:L03592 "A particle of dry substance in the atmosphere, as contrasted to a hydrometeor.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03592 goldbook:H02903)
AnnotationAssertion(mito:isMentionedBy goldbook:L03592 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03592 "current"^^xsd:string)
Declaration(Class(goldbook:L03593))
AnnotationAssertion(rdfs:label goldbook:L03593 "lithosphere")
AnnotationAssertion(dcterms:description goldbook:L03593 "The crust of the earth, usually thought of as discrete from and in contact with the hydrosphere and the atmosphere.")
AnnotationAssertion(mito:isMentionedBy goldbook:L03593 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03593 "current"^^xsd:string)
Declaration(Class(goldbook:L03595))
AnnotationAssertion(rdfs:label goldbook:L03595 "live time")
AnnotationAssertion(dcterms:description goldbook:L03595 "For a measurement, the time during which a radiation measuring assembly is capable of processing events occurring in the radiation detector. It equals the clock time minus the integrated resolving or dead time (to be distinguished from 'life time').")
AnnotationAssertion(rdfs:seeAlso goldbook:L03595 goldbook:D01529)
AnnotationAssertion(rdfs:seeAlso goldbook:L03595 goldbook:R05054)
AnnotationAssertion(mito:isMentionedBy goldbook:L03595 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03595 "current"^^xsd:string)
Declaration(Class(goldbook:L03596))
AnnotationAssertion(rdfs:label goldbook:L03596 "living copolymerization")
AnnotationAssertion(dcterms:description goldbook:L03596 "A copolymerization which is a living polymerization.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03596 goldbook:C01336)
AnnotationAssertion(rdfs:seeAlso goldbook:L03596 goldbook:L03597)
AnnotationAssertion(mito:isMentionedBy goldbook:L03596 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03596 "current"^^xsd:string)
Declaration(Class(goldbook:L03597))
AnnotationAssertion(rdfs:label goldbook:L03597 "living polymerization")
AnnotationAssertion(dcterms:description goldbook:L03597 "A chain polymerization from which chain transfer and chain termination are absent. In many cases, the rate of chain initiation is fast compared with the rate of chain propagation, so that the number of kinetic-chain carriers is essentially constant throughout the polymerization.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03597 goldbook:C00955)
AnnotationAssertion(rdfs:seeAlso goldbook:L03597 goldbook:C00958)
AnnotationAssertion(rdfs:seeAlso goldbook:L03597 goldbook:C00963)
AnnotationAssertion(rdfs:seeAlso goldbook:L03597 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:L03597 goldbook:P04881)
AnnotationAssertion(rdfs:seeAlso goldbook:L03597 goldbook:T06274)
AnnotationAssertion(mito:isMentionedBy goldbook:L03597 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03597 "current"^^xsd:string)
Declaration(Class(goldbook:L03599))
AnnotationAssertion(rdfs:label goldbook:L03599 "loading capacity")
AnnotationAssertion(dcterms:description goldbook:L03599 "The maximum concentration of solute(s) that a solvent can contain under specified conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03599 "maximum loading")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03599 "saturation capacity")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03599 "saturation loading")
AnnotationAssertion(rdfs:comment goldbook:L03599 "The terms maximum loading, saturation capacity and saturation loading are synonymous."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:L03599 "All the above terms should clearly be distinguished from ultimate capacity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:L03599 goldbook:U06546)
AnnotationAssertion(mito:isMentionedBy goldbook:L03599 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03599 "current"^^xsd:string)
Declaration(Class(goldbook:L03602))
AnnotationAssertion(rdfs:label goldbook:L03602 "local efficiency of atomization")
AnnotationAssertion(dcterms:description goldbook:L03602 "The substance fraction of atomized component in the component consumed. The efficiency of atomization is measured in a given part of the flame, usually the observation space; \\(\\varepsilon_{\\rm{a}} = \\varepsilon_{\\rm{n}}\\ \\chi _{\\rm{s}}\\ \\chi _{\\rm{v}}\\ \\chi _{\\rm{a}}\\). The signal is a function of the product \\(q_{\\rm{v}}\\ \\varepsilon_{\\rm{a}}\\), but \\(\\varepsilon_{\\rm{a}}\\) is also a function of \\(q_{\\rm{v}}\\), usually decreasing at high volume rates.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03602 goldbook:S06075)
AnnotationAssertion(mito:isMentionedBy goldbook:L03602 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03602 "current"^^xsd:string)
Declaration(Class(goldbook:L03603))
AnnotationAssertion(rdfs:label goldbook:L03603 "local flame temperature")
AnnotationAssertion(dcterms:description goldbook:L03603 "The effective thermodynamic temperature in the observation space as measured by a specific sensor for a specified element (in \\(\\rm{K}\\)). The temperature of a flame (or other plasma) is not homogeneous. It is usually lower at the borders of the flame. It is therefore appropriate to speak of an effective temperature which represents an average value of all temperatures throughout the observation space. The flame temperature depends on several factors such as: kind of plasma, kind of gas or gas mixture and concentration gradient of the thermometric species in the observation space.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03603 goldbook:C01227)
AnnotationAssertion(rdfs:seeAlso goldbook:L03603 goldbook:T06321)
AnnotationAssertion(rdfs:seeAlso goldbook:L03603 goldbook:T06329)
AnnotationAssertion(mito:isMentionedBy goldbook:L03603 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03603 "current"^^xsd:string)
Declaration(Class(goldbook:L03604))
AnnotationAssertion(rdfs:label goldbook:L03604 "local fraction atomized")
AnnotationAssertion(dcterms:description goldbook:L03604 "The substance fraction of the atomized component in the total volatilized component. This quantity is measured in a defined part of the flame, usually the observation space. The fraction atomized is the result of chemical reactions in the gaseous state. It depends on the bond strength of the compounds that the component may form within the flame and on the composition and temperature of the flame. When analysing elements that tend to become oxidized in the flame, it may be advisable to use as fuel gas mixtures with a reducing component such as $\\ce{C2H2}$ or $\\ce{N2O}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03604 goldbook:S06075)
AnnotationAssertion(mito:isMentionedBy goldbook:L03604 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03604 "current"^^xsd:string)
Declaration(Class(goldbook:L03605))
AnnotationAssertion(rdfs:label goldbook:L03605 "local fraction desolvated")
AnnotationAssertion(dcterms:description goldbook:L03605 "The amount-of-substance fraction of component in a desolvated state in the amount of component entering the flame. This quantity is measured in a defined part of the flame, usually the observation space. Because it varies with height in the flame as a result of progressive evaporation of aerosol droplets, it is appropriate to term the expression local. The fraction desolvated does not account for losses by incomplete volatilization of the dry aerosol (which largely depends upon the nature and concentration of the component). Such losses are described by local fraction volatilized, which usually depends on the solute. Since \\(\\chi _{\\rm{s}}\\) varies markedly with the height in the flame, its observed value represents an average. Local fraction desolvated depends on the solvent, the temperature of the flame and the time the component takes to travel from the tip of the burner to the height in the flame considered.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03605 goldbook:A00176)
AnnotationAssertion(rdfs:seeAlso goldbook:L03605 goldbook:A00299)
AnnotationAssertion(rdfs:seeAlso goldbook:L03605 goldbook:E02227)
AnnotationAssertion(rdfs:seeAlso goldbook:L03605 goldbook:V06632)
AnnotationAssertion(mito:isMentionedBy goldbook:L03605 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03605 "current"^^xsd:string)
Declaration(Class(goldbook:L03606))
AnnotationAssertion(rdfs:label goldbook:L03606 "local fraction volatilized")
AnnotationAssertion(dcterms:description goldbook:L03606 "The substance fraction of the volatilized component in the total desolvated component. The gaseous state includes free atoms, molecules and radicals. This quantity is measured in a defined part of the flame, usually the observation space. The fraction volatilized varies inversely with the size of the desolvated particles. Since \\(\\chi _{\\rm{v}}\\) varies markedly with the height in the flame, its observed value represents an average.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03606 goldbook:S06075)
AnnotationAssertion(mito:isMentionedBy goldbook:L03606 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03606 "current"^^xsd:string)
Declaration(Class(goldbook:L03608))
AnnotationAssertion(rdfs:label goldbook:L03608 "localized-itinerant transition")
AnnotationAssertion(dcterms:description goldbook:L03608 "A transition of either of two types: (a) a Mott transition (single-valent systems). (b) a small-polaron to itinerant-electron transition (mixed-valent systems).")
AnnotationAssertion(rdfs:seeAlso goldbook:L03608 goldbook:M04037)
AnnotationAssertion(rdfs:seeAlso goldbook:L03608 goldbook:PT07416)
AnnotationAssertion(mito:isMentionedBy goldbook:L03608 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03608 "current"^^xsd:string)
Declaration(Class(goldbook:L03613))
AnnotationAssertion(rdfs:label goldbook:L03613 "logit")
AnnotationAssertion(dcterms:description goldbook:L03613 "In competitive binding assays, the logit-log dose relationship, in which the response is defined by: \\(R=\\mathrm{logit}\\left(y\\right)=\\log _{10}(\\frac{y}{1- y})\\) where \\(y=\\frac{b}{b_{0}}\\) with \\(b\\) = fraction of tracer bound and \\(b_{0}\\) = value of \\(b\\) with no unlabelled ligand in the system. Logit transformed assay data frequently yield straight-line dose-response curves, amenable to statistical analysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03613 goldbook:A00470)
AnnotationAssertion(rdfs:seeAlso goldbook:L03613 goldbook:C01199)
AnnotationAssertion(rdfs:seeAlso goldbook:L03613 goldbook:DT07361)
AnnotationAssertion(rdfs:seeAlso goldbook:L03613 goldbook:L03518)
AnnotationAssertion(rdfs:seeAlso goldbook:L03613 goldbook:T06422)
AnnotationAssertion(mito:isMentionedBy goldbook:L03613 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03613 "current"^^xsd:string)
Declaration(Class(goldbook:L03614))
AnnotationAssertion(rdfs:label goldbook:L03614 "log-normal distribution")
AnnotationAssertion(dcterms:description goldbook:L03614 "A distribution function \\(F(y)\\), in which the logarithm of a quantity is normally distributed, i.e. \\(F(y)=f_{\\rm{gauss}}(\\ln y)\\) where \\(f_{\\rm{gauss}}(x)\\) is a Gaussian distribution. The size distributions of atmospheric aerosols are often described using this distribution function, although the term also applies to gaseous pollutants.")
AnnotationAssertion(mito:isMentionedBy goldbook:L03614 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03614 "current"^^xsd:string)
Declaration(Class(goldbook:L03615))
AnnotationAssertion(rdfs:label goldbook:L03615 "London–Eyring–Polanyi method")
AnnotationAssertion(dcterms:description goldbook:L03615 "A semiempirical method of calculating a potential-energy surface, based on a simplified quantum-mechanical equation (the London equation).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:L03615 "LEP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03615 "LEP method")
AnnotationAssertion(rdfs:seeAlso goldbook:L03615 goldbook:P04780)
AnnotationAssertion(mito:isMentionedBy goldbook:L03615 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03615 "current"^^xsd:string)
Declaration(Class(goldbook:L03616))
AnnotationAssertion(rdfs:label goldbook:L03616 "London–Eyring–Polanyi–Sato method")
AnnotationAssertion(dcterms:description goldbook:L03616 "A modification of the London–Eyring–Polanyi proposed in 1955 by S. Sato.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:L03616 "LEPS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03616 "LEPS method")
AnnotationAssertion(rdfs:seeAlso goldbook:L03616 goldbook:L03615)
AnnotationAssertion(mito:isMentionedBy goldbook:L03616 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03616 "current"^^xsd:string)
Declaration(Class(goldbook:L03617))
AnnotationAssertion(rdfs:label goldbook:L03617 "London forces")
AnnotationAssertion(dcterms:description goldbook:L03617 "Attractive forces between apolar molecules, due to their mutual polarizability. They are also components of the forces between polar molecules. Also called 'dispersion forces'.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03617 "dispersion forces")
AnnotationAssertion(rdfs:seeAlso goldbook:L03617 goldbook:P04711)
AnnotationAssertion(rdfs:seeAlso goldbook:L03617 goldbook:V06597)
AnnotationAssertion(mito:isMentionedBy goldbook:L03617 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03617 "current"^^xsd:string)
Declaration(Class(goldbook:L03618))
AnnotationAssertion(rdfs:label goldbook:L03618 "lone pair")
AnnotationAssertion(dcterms:description goldbook:L03618 "Two paired electrons localized in the valence shell on a single atom. Lone pairs should be designated with two dots. The term 'nonbonding electron pair' is more appropriate, and is found in many modern text books.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03618 "electron pair")
AnnotationAssertion(rdfs:seeAlso goldbook:L03618 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:L03618 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03618 "current"^^xsd:string)
Declaration(Class(goldbook:L03619))
AnnotationAssertion(rdfs:label goldbook:L03619 "long chain")
AnnotationAssertion(dcterms:description goldbook:L03619 "A chain of high relative molecular mass.")
