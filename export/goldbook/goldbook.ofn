Declaration(Class(goldbook:10663))
AnnotationAssertion(rdfs:label goldbook:10663 "epaxial")
AnnotationAssertion(dcterms:description goldbook:10663 "Located above or on the dorsal side of an axis.")
Declaration(Class(goldbook:10664))
AnnotationAssertion(rdfs:label goldbook:10664 "epiblast")
AnnotationAssertion(dcterms:description goldbook:10664 "Primitive ectoderm of the early embryo.")
Declaration(Class(goldbook:10665))
AnnotationAssertion(rdfs:label goldbook:10665 "epicardium")
