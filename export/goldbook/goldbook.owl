    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11148">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nearer to an anatomical point of origin or attachment, or the midline of the body.</dcterms:description>
