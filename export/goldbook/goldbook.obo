property_value: hasStatus "current" xsd:string
consider: goldbook:08696

[Term]
id: goldbook:08699
name: tip-enhanced Raman spectroscopy
def: "Measurement method of Raman spectroscopy combining surface-enhanced Raman spectroscopy and scanning using an atomic force microscope or scanning tunnelling microscope to give complementary maps of a surface."
synonym: "TERS" RELATED OMO:0003000 []
