    <!-- http://dx.doi.org/10.1351/goldbook.10635 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10635">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complication of pregnancy in which the embryo implants (see implantation) and develops outside the cavity of the uterus.</dcterms:description>
