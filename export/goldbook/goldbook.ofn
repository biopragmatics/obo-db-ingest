AnnotationAssertion(rdfs:label goldbook:A00533 "autoradiograph")
AnnotationAssertion(dcterms:description goldbook:A00533 "A radiograph of an object containing radioactive substance, produced by placing the object adjacent to a photographic plate or film or a fluorescent screen.")
