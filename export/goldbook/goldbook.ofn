AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11220 "sinuatrial node")
Declaration(Class(goldbook:11221))
AnnotationAssertion(rdfs:label goldbook:11221 "sinus")
AnnotationAssertion(dcterms:description goldbook:11221 """Hollow or cavity.
Channel for the passage of fluid, lacking the usual lining of a blood or lymphatic vessel; especially a dilatation for the passage of venous blood.""")
Declaration(Class(goldbook:11222))
AnnotationAssertion(rdfs:label goldbook:11222 "sinus venosus")
