AnnotationAssertion(dcterms:description goldbook:10696 "Partial or full complementary DNA sequence that can serve as a marker for a region of the genome that encodes an expressed product.")
Declaration(Class(goldbook:10697))
AnnotationAssertion(rdfs:label goldbook:10697 "exstrophy")
