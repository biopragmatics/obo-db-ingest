    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15469 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15469">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lack of development of an organ or tissue, or of the cellular products from an organ or tissue.</dcterms:description>
