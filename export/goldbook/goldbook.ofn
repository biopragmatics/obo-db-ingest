Declaration(Class(goldbook:15311))
AnnotationAssertion(rdfs:label goldbook:15311 "helical polymer")
AnnotationAssertion(dcterms:description goldbook:15311 "Polymer composed of macromolecules that adopt partly or completely a helical conformation.")
Declaration(Class(goldbook:15312))
AnnotationAssertion(rdfs:label goldbook:15312 "activity coefficient at infinite dilution")
AnnotationAssertion(dcterms:description goldbook:15312 "For a substance \\(\\ce{B}\\), activity coefficient \\(f_{\\ce{B}}\\) extrapolated to infinite dilution: \\[\\ln (f_{\\ce{B}}^{\\infty}) = \\lim \\limits_{x_{\\ce{B}} \\to 0} (\\frac{\\mu_{\\ce{B}} - \\mu_{\\ce{B}}^{\\ast}}{RT} - \\ln x_{\\ce{B}})\\]")
Declaration(Class(goldbook:15313))
AnnotationAssertion(rdfs:label goldbook:15313 "analytical method")
AnnotationAssertion(dcterms:description goldbook:15313 "Class of experimental procedures for solubility determination in which a saturated solution is prepared and then analyzed to determine composition.")
Declaration(Class(goldbook:15314))
AnnotationAssertion(rdfs:label goldbook:15314 "aquamolality")
AnnotationAssertion(dcterms:description goldbook:15314 """For a solute \\(\\ce{B}\\) in a system containing solvent \\(\\ce{A}\\) and a reference solvent \\(\\ce{C}\\), \\[m_{\\ce{B}}^{(\\ce{C})} = m_{\\ce{B}} \\overline M/M_{\\ce{C}}\\] where \\(m_{\\ce{B}}\\) is the molality of \\(\\ce{B}\\), \\(M_{\\ce{C}}\\) is the molar mass of a reference component, and \\(\\overline{M}\\) is the average molar mass of a mixed solvent, defined for a system containing two solvents as \\[\\overline M = x_{
u,\\ce{A}} M_{\\ce{A}} + (1 - x_{
u,\\ce{A}}) M_{\\ce{C}}\\] the solvent amount fraction of solvent \\(\\ce{A}\\).""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15314 "solvomolality")
Declaration(Class(goldbook:15315))
AnnotationAssertion(rdfs:label goldbook:15315 "azeotropic point")
AnnotationAssertion(dcterms:description goldbook:15315 "For a mixture, temperature and pressure (the azeotropic temperature and pressure) at which the compositions of the liquid and vapor phases become equal (the azeotropic composition), but the intensive properties of the two phases (such as molar volume) are different.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15315 "azeotrope")
Declaration(Class(goldbook:15316))
AnnotationAssertion(rdfs:label goldbook:15316 "binary system")
AnnotationAssertion(dcterms:description goldbook:15316 "System containing two components.")
Declaration(Class(goldbook:15317))
AnnotationAssertion(rdfs:label goldbook:15317 "Bunsen coefficient")
AnnotationAssertion(dcterms:description goldbook:15317 "Volume \\(V^{\\rm{g}}\\) of an amount \\(n_{\\ce{B}}^{\\rm{l}}\\) of a gas dissolved at a given standard temperature \\(T^{^⦵\\!}\\) (usually \\(\\pu{273.15 K}\\)) and given standard (partial) pressure \\(p_{\\ce{B}}^{_{^⦵\\!}}\\) (\\(\\pu{1 bar} = \\pu{0.1 MPa}\\) or, in older literature, \\(\\pu{1 atm}\\)) divided by the volume of the solvent \\(V^{\\rm{l}}\\) containing an amount \\(n_{\\ce{A}}\\) of solvent at temperature \\(T\\) and the given total pressure \\(p^{_{^⦵\\!}}\\).")
Declaration(Class(goldbook:15318))
AnnotationAssertion(rdfs:label goldbook:15318 "Clarke–Glew equation")
AnnotationAssertion(dcterms:description goldbook:15318 "Semi-empirical equation describing the temperature dependence of the standard Gibbs energy of solution, \\[\\Delta_{\\rm{sln}}G^{^⦵\\!}(T, p^{_{^⦵\\!}})/RT = A_{0} + A_{1}(T_{\\rm{ref}}/T) + A_{2}\\ln(T/T_{\\rm{ref}}) + A_{3}(T/T_{\\rm{ref}}) + A_{4}(T/T_{\\rm{ref}})^{2} + \\ldots\\] where the \\(A_{i}\\) are constants that can be related to thermodynamic quantities (but subject to uncertainty because of statistical correlations among the fitting coefficients) and \\(T_{\\rm{ref}}\\) is a reference temperature.")
Declaration(Class(goldbook:15319))
AnnotationAssertion(rdfs:label goldbook:15319 "Clarke–Glew–Weiss equation")
AnnotationAssertion(dcterms:description goldbook:15319 "Clarke–Glew equation with \\(T_{\\rm{ref}} = \\pu{100 K}\\).")
Declaration(Class(goldbook:15320))
AnnotationAssertion(rdfs:label goldbook:15320 "coexistence curve")
AnnotationAssertion(dcterms:description goldbook:15320 "Boundary of stable phase separation (limits of solubility) in a liquid or solid system of two or more components.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15320 "binodal curve")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15320 "conodal curve")
Declaration(Class(goldbook:15321))
AnnotationAssertion(rdfs:label goldbook:15321 "conjugate phases")
AnnotationAssertion(dcterms:description goldbook:15321 "Two phases of variable composition in mutual thermodynamic equilibrium.")
Declaration(Class(goldbook:15322))
AnnotationAssertion(rdfs:label goldbook:15322 "critical index")
AnnotationAssertion(dcterms:description goldbook:15322 "Index in the basic equation describing a coexistence curve \\[\\beta = \\lim \\limits_{T \\to T_{\\rm{c}}} \\left(\\frac{\\partial \\ln (x'' - x')}{\\partial \\ln \\vert T - T_{\\rm{c}}\\vert} \\right)\\] where \\(x''\\), \\(x'\\) are the mole fractions of one component in the respective concentrated and dilute phases and \\(T_{\\rm{c}}\\) is the critical solution temperature.")
Declaration(Class(goldbook:15323))
AnnotationAssertion(rdfs:label goldbook:15323 "data")
AnnotationAssertion(dcterms:description goldbook:15323 "Experimental results, often numerical.")
Declaration(Class(goldbook:15324))
AnnotationAssertion(rdfs:label goldbook:15324 "dystectic reaction")
AnnotationAssertion(dcterms:description goldbook:15324 "Isobaric, reversible melting or dissolution with either complete or partial dissociation on heating of a solid compound, \\(\\ce{A_{\\rm{a}}B_{\\rm{b}}}\\), formed by components \\(\\ce{A}\\) and \\(\\ce{B}\\) \\[\\ce{A_{\\rm{a}}B_{\\rm{b}}(s)  A_{\\rm{a}}B_{\\rm{b}}(l)  {\\rm{a}}A(l) + {\\rm{b}}B(l)}\\] where the forward arrows indicate the direction of heating.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15324 "congruent melting")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15324 "indifferent melting")
Declaration(Class(goldbook:15325))
AnnotationAssertion(rdfs:label goldbook:15325 "dystonic reaction")
AnnotationAssertion(dcterms:description goldbook:15325 "Reversible dissolution in an isothermal, isobaric system of three or more components characterized by dissolution and saturation with a stoichiometric compound consisting of two or more of these components. The equilibrium process is, for example, \\[\\ce{AB.p H2O  A(aq, sat) + B(aq, sat) + p H2O(l)}\\]")
Declaration(Class(goldbook:15326))
AnnotationAssertion(rdfs:label goldbook:15326 "eutectoid reaction")
AnnotationAssertion(dcterms:description goldbook:15326 "Isothermal reversible reaction of a solid mixture phase \\(\\upgamma\\) which is transformed into two (or more) different solid (pure, binary compound or mixture) phases \\(\\upalpha\\) and \\(\\upbeta\\) during the cooling of a system. In a binary system, \\[\\ce{\\upgamma  \\upalpha + \\upbeta}\\] where the forward arrow indicates the direction of cooling. The equilibrium reaction occurs along the eutectoid line at the eutectoid temperature. At the eutectoid composition, the compositions of the high temperature solid phase and the mechanical mixture of the low-temperature solid phases are equal, and intermediate to the compositions of the pure solid phases \\(\\upalpha\\) and \\(\\upbeta\\). This composition and the eutectoid temperature, which are isobaric invariants of the system, define the eutectoid point.")
Declaration(Class(goldbook:15327))
AnnotationAssertion(rdfs:label goldbook:15327 "eutonic reaction")
AnnotationAssertion(dcterms:description goldbook:15327 "Reversible dissolution in a system of three or more components characterized by the composition of a solution that is simultaneously saturated with respect to all (at least two or more) dissolved solutes. The two simultaneous equilibrium processes are, for example, \\[\\begin{array}{l}\\ce{A.p H2O  A{(aq, sat)} + p H2O(l)} \\\\ \\ce{B.q H2O  B{(aq, sat)} + q H2O(l)}\\end{array}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15327 "(isothermally and isobarically invariant) reaction of double saturation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15327 "isothermally invariant reaction")
Declaration(Class(goldbook:15328))
AnnotationAssertion(rdfs:label goldbook:15328 "fitting equation")
AnnotationAssertion(dcterms:description goldbook:15328 "Theoretically based or empirical equation for interpolation of data over a range of temperature, pressure, composition, or other variable.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15328 "smoothing equation")
Declaration(Class(goldbook:15329))
AnnotationAssertion(rdfs:label goldbook:15329 "Gibbs–Duhem equation")
AnnotationAssertion(dcterms:description goldbook:15329 "Equation relating the intensive variables \\(T\\), \\(p\\) and the \\(C\\) chemical potentials \\(\\mu_{i}\\) in a phase \\[S{\\rm{d}}T - V{\\rm{d}}p + \\sum \\limits_{i=1}^{C} n_{i} {\\rm{d}}\\mu_{i} = 0\\] where \\(C\\) is the total number of components, \\(i\\) in a phase.")
Declaration(Class(goldbook:15330))
AnnotationAssertion(rdfs:label goldbook:15330 "Gibbs energy of transfer")
AnnotationAssertion(dcterms:description goldbook:15330 "Change in Gibbs energy at a given temperature and pressure for transfer of a substance between two different phases.")
Declaration(Class(goldbook:15331))
AnnotationAssertion(rdfs:label goldbook:15331 "Gibbs–Konovalov equations")
AnnotationAssertion(dcterms:description goldbook:15331 "Pair of equations for a binary mixture of components \\(\\ce{A}\\) and \\(\\ce{B}\\) that relate the variables \\(T\\), \\(p\\), in one phase of variable composition, \\(\\upalpha\\), to the variables \\(T\\), \\(p\\), in a coexisting equilibrium phase of variable composition, \\(\\upbeta\\): \\[\\begin{array}{c} -\\frac{\\left(1 - x_{\\ce{B}}^{\\beta} \\right)\\Delta_{\\alpha}^{\\beta} H_{\\ce{A}} + x_{\\ce{B}}^{\\beta} \\Delta_{\\alpha}^{\\beta} H_{\\ce{B}}}{T}{\\rm{d}}T + \\left[\\left(1 - x_{\\ce{B}}^{\\beta} \\right)\\Delta_{\\alpha}^{\\beta}V_{\\ce{A}} + x_{\\ce{B}}^{\\beta}\\Delta_{\\alpha}^{\\beta}V_{\\ce{B}} \\right]{\\rm{d}}p +\\left(x_{\\ce{B}}^{\\alpha} - x_{\\ce{B}}^{\\beta} \\right)\\left(\\frac{\\partial^{2} G_{\\rm{m}}^{\\alpha}}{\\partial x_{\\ce{B}}^{\\alpha 2}} \\right)_{T,p} {\\rm{d}}x_{\\ce{B}}^{\\alpha} = 0 \\\\ -\\frac{\\left(1 - x_{\\ce{B}}^{\\alpha} \\right)\\Delta_{\\alpha}^{\\beta} H_{\\ce{A}} + x_{\\ce{B}}^{\\alpha} \\Delta_{\\alpha}^{\\beta} H_{\\rm{B}}}{T}{\\rm{d}}T + \\left[\\left(1 - x_{\\ce{B}}^{\\alpha} \\right)\\Delta_{\\alpha}^{\\beta}V_{\\ce{A}} + x_{\\ce{B}}^{\\alpha}\\Delta_{\\alpha}^{\\beta}V_{\\ce{B}} \\right]{\\rm{d}}p +\\left(x_{\\ce{B}}^{\\alpha} - x_{\\ce{B}}^{\\beta} \\right)\\left(\\frac{\\partial^{2} G_{\\rm{m}}^{\\alpha}}{\\partial x_{\\ce{B}}^{\\beta 2}} \\right)_{T,p} {\\rm{d}}x_{\\ce{B}}^{\\beta} = 0 \\end{array}\\] where \\(\\Delta_{\\upalpha}^{\\upbeta} H_{\\ce{A}} = H_{\\ce{A}}^{\\upbeta} - H_{\\ce{A}}^{\\upalpha}\\), \\(\\Delta_{\\upalpha}^{\\upbeta} V_{\\ce{A}} = V_{\\ce{A}}^{\\upbeta} - V_{\\ce{A}}^{\\upalpha}\\) are the enthalpy and volume of transfer of component \\(\\ce{A}\\) from phase \\(\\upalpha\\) to phase \\(\\upbeta\\), and similarly for component \\(\\ce{B}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15331 "Gibbs–Konovalow equations")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15331 "van der Waals’ equations")
Declaration(Class(goldbook:15332))
AnnotationAssertion(rdfs:label goldbook:15332 "higher-order system")
AnnotationAssertion(dcterms:description goldbook:15332 "System containing more than three components.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15332 "multicomponent system")
Declaration(Class(goldbook:15333))
AnnotationAssertion(rdfs:label goldbook:15333 "infinite dilution")
AnnotationAssertion(dcterms:description goldbook:15333 "Limiting composition or other variable in a solution obtained by extrapolating to a value of zero for the variable describing the composition of the solution.")
Declaration(Class(goldbook:15334))
AnnotationAssertion(rdfs:label goldbook:15334 "infinite miscibility")
AnnotationAssertion(dcterms:description goldbook:15334 "Property of a system of forming a single phase at all relative proportions of its components.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15334 "miscibility in all proportions")
Declaration(Class(goldbook:15335))
AnnotationAssertion(rdfs:label goldbook:15335 "ionic mole fraction")
AnnotationAssertion(dcterms:description goldbook:15335 """For an ionized salt \\(\\ce{B}\\) in solution, \\[x_{+\\rm{B}} = \\frac{
u_{+\\ce{B}}x_{\\ce{B}}}{1 + \\sum \\limits_{i=1}^{s} \\left(
u_{i} - 1 \\right)x_{i}},x_{-\\ce{B}} = \\frac{
u_{-\\ce{B}}x_{+\\ce{B}}}{
u_{+\\ce{B}}}\\] where the summation is over all $s$ solute components \\(i\\) and \\(
u_{i} = 
u_{+i} + 
u_{-i}\\) is the sum of the stoichiometric numbers of the ions formed from salt \\(i\\).
For a single solvent \\(\\ce{A}\\) in an ionic solution, \\[x'_{\\ce{A}} = \\frac{x_{\\ce{A}}}{1 + \\sum \\limits_{i=1}^{s} \\left(
u_{i} - 1 \\right)x_{i}}\\] Note 1: These are generalizations of terms and are used in formulating fitting equations for solubility of salts, in defining activity coefficients on the mole fraction scale, and in discussing salt effects on solubilities of gases.Note 2: Note that \\[\\sum \\limits_{i=1}^{s} \\left(x_{+i} - x_{-i} \\right) + x'_{\\ce{A}} = 1\\]""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15335 "ionic amount fraction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15335 "species amount fraction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15335 "species mole fraction")
Declaration(Class(goldbook:15336))
AnnotationAssertion(rdfs:label goldbook:15336 "isopleth")
AnnotationAssertion(dcterms:description goldbook:15336 "Line joining points of equal composition on a phase diagram.")
Declaration(Class(goldbook:15337))
AnnotationAssertion(rdfs:label goldbook:15337 "mass ratio")
AnnotationAssertion(dcterms:description goldbook:15337 "Mass of one constituent \\(\\ce{A}\\) divided by the mass of a second constituent \\(\\ce{B}\\) in the same system. \\[\\zeta_{\\ce{A,B}} = m_{\\ce{A}}/m_{\\ce{B}}\\]")
Declaration(Class(goldbook:15338))
AnnotationAssertion(rdfs:label goldbook:15338 "mass solubility")
AnnotationAssertion(dcterms:description goldbook:15338 "Obsolete term for molality of a saturated solution of a gas.")
Declaration(Class(goldbook:15339))
AnnotationAssertion(rdfs:label goldbook:15339 "metatectic reaction")
AnnotationAssertion(dcterms:description goldbook:15339 "Isothermal reversible reaction of a solid mixture phase \\(\\upbeta\\) which is transformed into a different solid phase \\(\\upalpha\\) plus a liquid phase \\(\\ce{l}\\) during cooling of a system. For a binary system, \\[\\ce{\\upbeta  \\upalpha + 1}\\] where the forward arrow indicates the direction of cooling. The equilibrium transformation occurs along the metatectic line characterized by the metatectic temperature. The metatectic composition and temperature, isobaric invariants of the system, define the metatectic point, which lies between the compositions of liquid \\(\\ce{l}\\) and solid phase \\(\\upalpha\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15339 "catatectic reaction")
Declaration(Class(goldbook:15340))
AnnotationAssertion(rdfs:label goldbook:15340 "mole percent")
AnnotationAssertion(dcterms:description goldbook:15340 "Deprecated term that includes both a quantity and a unit. Replace by mole fraction expressed as percent.")
Declaration(Class(goldbook:15341))
AnnotationAssertion(rdfs:label goldbook:15341 "mole ratio")
AnnotationAssertion(dcterms:description goldbook:15341 "Amount of one constituent divided by the amount of a second constituent in the same system. For constituents 1 and 2, \\[r_{12} = n_{1}/n_{2}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15341 "amount ratio")
Declaration(Class(goldbook:15342))
AnnotationAssertion(rdfs:label goldbook:15342 "mutual solubility")
AnnotationAssertion(dcterms:description goldbook:15342 "In a system of two or more liquid or solid components, solubility of all components in all phases.")
Declaration(Class(goldbook:15343))
AnnotationAssertion(rdfs:label goldbook:15343 "non-saturating solute")
AnnotationAssertion(dcterms:description goldbook:15343 "Solute which forms an unsaturated solution.")
Declaration(Class(goldbook:15344))
AnnotationAssertion(rdfs:label goldbook:15344 "peritonic reaction")
AnnotationAssertion(dcterms:description goldbook:15344 "Isothermal, isobaric reversible reaction between two phases, a saturated liquid and a solid, that results, on removal of the solvent component of a ternary system in one new solid phase. For example, \\[\\ce{l + \\upalpha  \\upbeta}\\] where the forward arrow indicates the direction of removal of the solvent component. The system is in equilibrium along the peritonic line, on which is found the peritonic composition or point, an isothermal, isobaric invariant of the system which lies between the compositions of phases \\(\\ce{l}\\) and \\(\\upalpha\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15344 "transition reaction (in phase equilibria)")
Declaration(Class(goldbook:15345))
AnnotationAssertion(rdfs:label goldbook:15345 "permil")
AnnotationAssertion(dcterms:description goldbook:15345 "One part in a thousand parts.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15345 "per mille")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15345 "permille")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15345 "promille")
Declaration(Class(goldbook:15346))
AnnotationAssertion(rdfs:label goldbook:15346 "phase diagram")
AnnotationAssertion(dcterms:description goldbook:15346 "Graphical representation, by use of points, lines, and surfaces, of the phases present at chemical equilibrium in unary, binary, ternary, and higher-order systems containing two or more phases.")
Declaration(Class(goldbook:15347))
AnnotationAssertion(rdfs:label goldbook:15347 "Poynting correction")
AnnotationAssertion(dcterms:description goldbook:15347 "Factor used to convert experimentally determined Henry’s law constants at the saturation vapor pressure of the solvent \\(\\ce{A}\\), \\(p_{\\ce{A}}^{\\ast}\\), to a reference pressure \\(p\\) \\[\\begin{array}{c} I_{\\rm{p}} = \\int_{p_{\\ce{A}}^{\\ast}}^p \\frac{V_{\\ce{B}}^{\\infty {\\rm{l}}}}{RT}{\\rm{d}}p \\\\ k_{\\rm{H},\\ce{B}}(p) = k_{\\rm{H},\\ce{B}}(p^{\\ast}) \\exp \\left[I_{\\rm{p}}(p) \\right]\\end{array}\\] is the partial molar volume of liquid \\(\\ce{B}\\) at infinite dilution in solvent \\(\\ce{A}\\). The second equation gives the relation between the two Henry’s law constants.")
Declaration(Class(goldbook:15348))
AnnotationAssertion(rdfs:label goldbook:15348 "primary data")
AnnotationAssertion(dcterms:description goldbook:15348 "Data reported in peer-reviewed scientific reports of original research which allow an assessment of data quality.")
Declaration(Class(goldbook:15349))
AnnotationAssertion(rdfs:label goldbook:15349 "Raoult’s law")
AnnotationAssertion(dcterms:description goldbook:15349 "Fugacity (\\(\\tilde{p}_{\\ce{B}}\\)) of a gaseous component (\\(\\ce{B}\\)) in equilibrium with a liquid or solid mixture containing \\(\\ce{B}\\) is directly proportional to the activity (\\(a_{\\ce{B}}\\)) of the component in the mixture \\[\\tilde{p}_{\\ce{B}} = \\tilde{p}_{\\ce{B}}^{\\ast} f_{\\ce{B}} x_{\\ce{B}}\\] where \\(f_{\\ce{B}}\\) is the activity coefficient of \\(\\ce{B}\\) referenced to Raoult’s law at mole fraction \\(x_{\\ce{B}}\\) and \\(\\tilde{p}_{\\ce{B}}\\) is the fugacity of pure \\(\\ce{B}\\).")
Declaration(Class(goldbook:15350))
AnnotationAssertion(rdfs:label goldbook:15350 "reciprocal salt system")
AnnotationAssertion(dcterms:description goldbook:15350 "System containing \\(n\\) ionic species with or without a single solvent. Because of electrical neutrality, the system has \\(n\\) components in an aqueous system with a single solvent and \\(n - 1\\) components in a molten salt system.")
Declaration(Class(goldbook:15351))
AnnotationAssertion(rdfs:label goldbook:15351 "reduced pressure")
AnnotationAssertion(dcterms:description goldbook:15351 "Pressure divided by the critical pressure.")
Declaration(Class(goldbook:15352))
AnnotationAssertion(rdfs:label goldbook:15352 "reduced temperature")
AnnotationAssertion(dcterms:description goldbook:15352 "Temperature divided by the critical temperature.")
Declaration(Class(goldbook:15353))
AnnotationAssertion(rdfs:label goldbook:15353 "reference data")
AnnotationAssertion(dcterms:description goldbook:15353 "Data that are critically evaluated and verified, obtained from an identified source, and related to a property of a phenomenon, body, or substance, or a system of components of known composition and structure.")
Declaration(Class(goldbook:15354))
AnnotationAssertion(rdfs:label goldbook:15354 "retrograde solubility")
AnnotationAssertion(dcterms:description goldbook:15354 """Solubility that decreases with an increase in conditions such as temperature or added component, where an increase is expected as the usual case.
In ternary liquid systems with coexisting phases, where the critical solution point is not a maximum on a ternary diagram, passing from a homogeneous mixture in which the composition of a given component is greater than that of the critical mixture to a heterogeneous mixture and back to a homogeneous mixture by altering the relative amounts of the two other components.""")
Declaration(Class(goldbook:15355))
AnnotationAssertion(rdfs:label goldbook:15355 "saturating solute")
AnnotationAssertion(dcterms:description goldbook:15355 "Solute that forms a saturated solution.")
Declaration(Class(goldbook:15356))
AnnotationAssertion(rdfs:label goldbook:15356 "scaling equation")
AnnotationAssertion(dcterms:description goldbook:15356 "Dimensionless equation representing mutual solubilities in a number of chemically related liquid systems. Each mutual solubility is subtracted from the solubility at the critical solution point, and the temperature is divided by the critical solution temperature.")
Declaration(Class(goldbook:15357))
AnnotationAssertion(rdfs:label goldbook:15357 "Sechenov equation")
AnnotationAssertion(dcterms:description goldbook:15357 "Expression of the salt effect that relates the change in solubility of a nonelectrolyte (e.g., gas or organic liquid) to changing ionic strength of aqueous solutions, \\[\\lg (s_{\\rm{o}}/s) = K_{s} I_{s}\\] where \\(s_{o}\\), \\(s\\) are the solubilities of nonelectrolyte in pure water and saline solution, respectively, \\(K_{s}\\) the Sechenov parameter (an empirical proportionality constant), and \\(I_{s}\\) the ionic strength of the saline solution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15357 "Setschenow equation")
Declaration(Class(goldbook:15358))
AnnotationAssertion(rdfs:label goldbook:15358 "Sieverts’ law")
AnnotationAssertion(dcterms:description goldbook:15358 "Solubility of a diatomic gas in a molten metal is proportional to the square root of the partial pressure.")
Declaration(Class(goldbook:15359))
AnnotationAssertion(rdfs:label goldbook:15359 "solubility constant")
AnnotationAssertion(dcterms:description goldbook:15359 "Generalization of solubility product to include, for example, undissociated salt or uncharged cation-anion pair as solute, reaction between solution species and the cation or anion of the solid salt, and gas-solution equilibria.")
Declaration(Class(goldbook:15360))
AnnotationAssertion(rdfs:label goldbook:15360 "solubilisation")
AnnotationAssertion(dcterms:description goldbook:15360 "Process by which an agent increases the solubility or the rate of dissolution of a solid or liquid solute.Modified from entry 'micellar solubilization' in.")
Declaration(Class(goldbook:15361))
AnnotationAssertion(rdfs:label goldbook:15361 "solvent mole fraction")
AnnotationAssertion(dcterms:description goldbook:15361 "Mole or mass fraction of a solvent in a solution containing \\(s\\) solute constituents (\\(i = 1, 2, \\ldots, s\\)) and \\(p\\) solvent constituents (\\(i = s + 1, s + 2, \\ldots, p\\)). For a solvent \\(\\ce{A}\\), \\[x_{{\\rm{v}},{\\ce{A}}} = x_{\\ce{A}}/\\sum \\limits_{i=s+1}^{p} x_{i}\\] where \\[\\sum \\limits_{i=1}^{p} x_{i} = \\sum \\limits_{i=1}^{s} x_{i} + \\sum \\limits_{i=s+1}^{p} x_{i} = 1\\] and analogously for \\(w_{{\\rm{v}},{\\ce{A}}}\\), where the first and last summations are over all solvent constituents.")
Declaration(Class(goldbook:15362))
AnnotationAssertion(rdfs:label goldbook:15362 "solvent volume fraction")
AnnotationAssertion(dcterms:description goldbook:15362 "For a solvent \\(\\ce{A}\\), volume fraction of \\(\\ce{A}\\) divided by the sum of the volume fractions of solvent in a solution containing both \\(s\\) solutes (\\(i = 1, 2, \\ldots, s\\)) and \\(p\\) solvents (\\(i = s + 1, s + 2, \\ldots, p\\)) \\[\\varphi_{{\\rm{v}},{\\ce{A}}} = \\varphi_{\\ce{A}}/\\sum \\limits_{i=s+1}^{p} \\varphi_{i}\\] where the summation is over the \\(p\\) solvent components only.")
Declaration(Class(goldbook:15363))
AnnotationAssertion(rdfs:label goldbook:15363 "standard amount concentration")
AnnotationAssertion(dcterms:description goldbook:15363 "Chosen value of amount concentration.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15363 "standard concentration")
Declaration(Class(goldbook:15364))
AnnotationAssertion(rdfs:label goldbook:15364 "synthetic method")
AnnotationAssertion(dcterms:description goldbook:15364 "Class of experimental procedures for solubility determination in which a solution of known composition is prepared. Two major subclasses are recognized. In the isothermal method, one liquid component is titrated with a second liquid component at constant temperature until persistent turbidity is observed (i.e., to the cloud point). In the polythermal method, a mixture of known composition is heated above its solution temperature and monitored visually during cooling until turbidity (the cloud point) is observed.")
Declaration(Class(goldbook:15365))
AnnotationAssertion(rdfs:label goldbook:15365 "ternary diagram")
AnnotationAssertion(dcterms:description goldbook:15365 "Triangular plot (usually an equilateral or right-angled triangle) whose vertices represent the pure components of a ternary system at constant temperature and pressure. Any point within the triangle represents the composition in terms of the two independent mole (or mass) fractions. Lines parallel to the sides of the triangle represent constant proportions of the respective components (isopleths).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15365 "Gibbs’ triangular representation")
Declaration(Class(goldbook:15366))
AnnotationAssertion(rdfs:label goldbook:15366 "ternary system")
AnnotationAssertion(dcterms:description goldbook:15366 "System containing three components.")
Declaration(Class(goldbook:15367))
AnnotationAssertion(rdfs:label goldbook:15367 "tie-line")
AnnotationAssertion(dcterms:description goldbook:15367 "Straight line connecting compositions of independent coexisting phases in equilibrium on a phase diagram.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15367 "connodal")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15367 "conodal")
Declaration(Class(goldbook:15368))
AnnotationAssertion(rdfs:label goldbook:15368 "unary system")
AnnotationAssertion(dcterms:description goldbook:15368 "System containing one component.")
Declaration(Class(goldbook:15369))
AnnotationAssertion(rdfs:label goldbook:15369 "unsaturated solution")
AnnotationAssertion(dcterms:description goldbook:15369 "Solution that has a lower proportion of a solute than one that is in equilibrium with undissolved solute at specified values of temperature and pressure.")
Declaration(Class(goldbook:15370))
AnnotationAssertion(rdfs:label goldbook:15370 "unsaturation")
AnnotationAssertion(dcterms:description goldbook:15370 "State of an unsaturated solution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15370 "undersaturation")
Declaration(Class(goldbook:15371))
AnnotationAssertion(rdfs:label goldbook:15371 "wet residue method")
AnnotationAssertion(dcterms:description goldbook:15371 "Method for determining composition of a solid phase in a ternary system at constant temperature and pressure by analysis of the total mixture of solid and liquid in equilibrium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15371 "initial complex method")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15371 "Schreinemakers’ method")
Declaration(Class(goldbook:15372))
AnnotationAssertion(rdfs:label goldbook:15372 "Ising model")
AnnotationAssertion(dcterms:description goldbook:15372 "Theory of coexistence curves or other discontinuities in the properties of phases (such as order-disorder or magnetic transitions) in binary systems, based on a one-, two-, or three-dimensional statistical mechanical nearest-neighbor lattice theory.")
Declaration(Class(goldbook:15373))
AnnotationAssertion(rdfs:label goldbook:15373 "Jänecke coordinates")
AnnotationAssertion(dcterms:description goldbook:15373 "Coordinates used mainly in representation of multicomponent phase diagrams that distinguish solutes and a single solvent. The mole or mass fractions of the \\(s\\) solutes are chosen as the primary composition variables and the mole or mass fraction of solvent as a secondary variable, so that the solute amount (mass) fractions may be represented, for example, in ternary and quaternary systems, as linear (ternary) or planar triangular or square planar (quaternary) diagrams, with the solvent amount or mass fraction along an axis perpendicular to the chosen diagram of solute variables. Quantitatively, \\[x_{{\\rm{s}},{\\ce{B}}} = x_{\\ce{B}}/\\sum \\limits_{i=1}^{s}x_{i}\\] where the summation is over the \\(s\\) solute substances. Note that \\(\\sum \\limits_{i=1}^{s}x_{{\\rm{s}},{\\ce{B}}} = 1\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15373 "solute mole (or mass) fraction coordinates")
Declaration(Class(goldbook:15374))
AnnotationAssertion(rdfs:label goldbook:15374 "Kuenen coefficient")
AnnotationAssertion(dcterms:description goldbook:15374 "Volume \\(V^{\\rm{g}}\\) of an amount \\(n_{\\ce{B}}^{\\rm{l}}\\) of a dissolved gas at a given standard temperature \\(T^{^⦵\\!}\\) (usually \\(\\pu{273.15 K}\\)) and given standard pressure \\(p^{_{^⦵\\!}}\\) (\\(\\pu{1 bar} = \\pu{0.1 MPa}\\) or, in older literature, \\(\\pu{1 atm}\\)) divided by the mass \\(m^{\\rm{l}}\\) of the dissolving liquid containing an amount $n_{\\ce{A}}$ of solvent at temperature $T$ and the given pressure \\(p^{_{^⦵\\!}}\\).")
Declaration(Class(goldbook:15375))
AnnotationAssertion(rdfs:label goldbook:15375 "mass percent")
AnnotationAssertion(dcterms:description goldbook:15375 "Deprecated term that includes both a quantity and a unit. Replace by mass fraction expressed as percent.")
Declaration(Class(goldbook:15377))
AnnotationAssertion(rdfs:label goldbook:15377 "Ostwald coefficient")
AnnotationAssertion(dcterms:description goldbook:15377 "Volume \\(V^{\\rm{g}}\\) of an amount \\(n_{\\ce{B}}^{\\rm{l}}\\) of a dissolved gas calculated at given temperature \\(T\\) and pressure \\(p\\) divided by the volume of the dissolving liquid of volume \\(V^{\\rm{l}}\\) and containing an amount \\(n_{\\ce{A}}\\) of solvent at the same temperature \\(T\\) and pressure \\(p\\).")
Declaration(Class(goldbook:15378))
AnnotationAssertion(rdfs:label goldbook:15378 "acyclic diene metathesis polymerisation")
AnnotationAssertion(dcterms:description goldbook:15378 "Metathesis polymerization of an acylic diene monomer.")
Declaration(Class(goldbook:15379))
AnnotationAssertion(rdfs:label goldbook:15379 "apparent rate constant of polymerisation")
AnnotationAssertion(dcterms:description goldbook:15379 "Measured rate of polymerization divided by the concentration of the reactant (if there is only one) or the product of concentrations of the presumed reactants.")
Declaration(Class(goldbook:15380))
AnnotationAssertion(rdfs:label goldbook:15380 "auto-acceleration")
AnnotationAssertion(dcterms:description goldbook:15380 "Increase in the rate of polymerization with increasing conversion of the reactant(s).")
Declaration(Class(goldbook:15381))
AnnotationAssertion(rdfs:label goldbook:15381 "azeotropic copolymerisation")
AnnotationAssertion(dcterms:description goldbook:15381 "Binary copolymerization in which the two monomer reactivity ratios, \\(r_{12}\\) and \\(r_{21}\\) are not both equal to unity yet the copolymerization forms a copolymer with its molar ratio of monomer units equal to the molar ratio of monomers in the monomer feed.")
Declaration(Class(goldbook:15382))
AnnotationAssertion(rdfs:label goldbook:15382 "backbiting")
AnnotationAssertion(dcterms:description goldbook:15382 "Chain transfer from an active center on a macromolecule to another part of the same macromolecule.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15382 "intramolecular chain transfer")
Declaration(Class(goldbook:15383))
AnnotationAssertion(rdfs:label goldbook:15383 "binary copolymerisation")
AnnotationAssertion(dcterms:description goldbook:15383 "Copolymerization involving two species of monomer.")
Declaration(Class(goldbook:15384))
AnnotationAssertion(rdfs:label goldbook:15384 "bulk polymerisation")
AnnotationAssertion(dcterms:description goldbook:15384 "Polymerization of an undiluted liquid monomer.")
Declaration(Class(goldbook:15385))
AnnotationAssertion(rdfs:label goldbook:15385 "ceiling temperature")
AnnotationAssertion(dcterms:description goldbook:15385 "Temperature above which, in a given chain polymerization, polymer of high molar mass is not formed.")
Declaration(Class(goldbook:15386))
AnnotationAssertion(rdfs:label goldbook:15386 "chain copolymerisation")
AnnotationAssertion(dcterms:description goldbook:15386 "Chain polymerization in which a copolymer is formed.")
Declaration(Class(goldbook:15387))
AnnotationAssertion(rdfs:label goldbook:15387 "chain depropagation")
AnnotationAssertion(dcterms:description goldbook:15387 "Chemical reaction that results in the formation of a monomer molecule at an active center on the terminal unit of a chain carrier and decreases the degree of polymerization of the chain carrier by one.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15387 "depropagation")
Declaration(Class(goldbook:15388))
AnnotationAssertion(rdfs:label goldbook:15388 "chain-end reactivity ratio")
AnnotationAssertion(dcterms:description goldbook:15388 "In a binary copolymerization, the ratio of two rate constants defining the relative activity of an active center on a given type of terminal unit of a chain carrier toward one type of monomer, in the two cases where the penultimate unit of the chain carrier is identical to and different from the terminal unit.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15388 "radical reactivity ratio")
Declaration(Class(goldbook:15389))
AnnotationAssertion(rdfs:label goldbook:15389 "chain-transfer constant")
AnnotationAssertion(dcterms:description goldbook:15389 "In a homopolymerization, rate constant for chain transfer, \\(k_{\\rm{tr}}\\), divided by the rate constant for chain propagation, \\(k_{\\rm{p}}\\), i.e., \\(C_{\\rm{tr}} = k_{\\rm{tr}}/k_{\\rm{p}}\\).")
Declaration(Class(goldbook:15390))
AnnotationAssertion(rdfs:label goldbook:15390 "comonomer")
AnnotationAssertion(dcterms:description goldbook:15390 "Monomer used in copolymerization.")
Declaration(Class(goldbook:15391))
AnnotationAssertion(rdfs:label goldbook:15391 "copolymerisation composition equation")
AnnotationAssertion(dcterms:description goldbook:15391 "Equation relating the instantaneous composition of a binary copolymer to the monomer reactivity ratios and the ratio of instantaneous monomer concentrations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15391 "Mayo–Lewis equation")
Declaration(Class(goldbook:15392))
AnnotationAssertion(rdfs:label goldbook:15392 "coupling reaction")
AnnotationAssertion(dcterms:description goldbook:15392 "Linking of two macromolecules through chemical reaction.")
Declaration(Class(goldbook:15393))
AnnotationAssertion(rdfs:label goldbook:15393 "cross-propagation")
AnnotationAssertion(dcterms:description goldbook:15393 "Propagation reaction in a copolymerization in which a chain carrier, bearing at its active end a monomer unit of one kind, reacts with a monomer molecule of another kind.")
Declaration(Class(goldbook:15394))
AnnotationAssertion(rdfs:label goldbook:15394 "cross-termination")
AnnotationAssertion(dcterms:description goldbook:15394 "Termination reaction in a copolymerization between two chain carriers with different chemical structures.")
Declaration(Class(goldbook:15395))
AnnotationAssertion(rdfs:label goldbook:15395 "dead-end polymerisation")
AnnotationAssertion(dcterms:description goldbook:15395 "Radical polymerization that stops, as a consequence of the depletion of the initiator, before the monomer has reacted fully.")
Declaration(Class(goldbook:15396))
AnnotationAssertion(rdfs:label goldbook:15396 "degradative chain transfer")
AnnotationAssertion(dcterms:description goldbook:15396 "Chain transfer reaction that generates a new chain carrier of much lower reactivity than that of the original chain carrier.")
Declaration(Class(goldbook:15397))
AnnotationAssertion(rdfs:label goldbook:15397 "diffusion-controlled termination")
AnnotationAssertion(dcterms:description goldbook:15397 "Chain termination in a chain polymerization in which the rate-determining step is a diffusion process.")
Declaration(Class(goldbook:15398))
AnnotationAssertion(rdfs:label goldbook:15398 "end-capping")
AnnotationAssertion(dcterms:description goldbook:15398 "Reaction in which end-groups of a desired structure are intentionally formed.")
Declaration(Class(goldbook:15399))
AnnotationAssertion(rdfs:label goldbook:15399 "enthalpy of polymerisation")
AnnotationAssertion(dcterms:description goldbook:15399 "Change of enthalpy, in a chain polymerization forming a homopolymer, associated with the conversion of one mole of monomer into polymer under isobaric and isothermal conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15399 "molar enthalpy of polymerization")
Declaration(Class(goldbook:15400))
AnnotationAssertion(rdfs:label goldbook:15400 "entropy of polymerisation")
AnnotationAssertion(dcterms:description goldbook:15400 "Change of entropy, in a chain polymerization forming a homopolymer, associated with the conversion of one mole of monomer into polymer under isobaric and isothermal conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15400 "molar entropy of polymerization")
Declaration(Class(goldbook:15401))
AnnotationAssertion(rdfs:label goldbook:15401 "floor temperature")
AnnotationAssertion(dcterms:description goldbook:15401 "Temperature below which, in a given chain polymerization, polymer of high molar mass is not formed.")
Declaration(Class(goldbook:15402))
AnnotationAssertion(rdfs:label goldbook:15402 "free ion")
AnnotationAssertion(dcterms:description goldbook:15402 "Ion whose behavior is independent of the influence of a counterion.")
Declaration(Class(goldbook:15403))
AnnotationAssertion(rdfs:label goldbook:15403 "heat of polymerisation")
AnnotationAssertion(dcterms:description goldbook:15403 "Heat absorbed or given off from the conversion of a specified amount of monomer into polymer.")
Declaration(Class(goldbook:15404))
AnnotationAssertion(rdfs:label goldbook:15404 "homopropagation")
AnnotationAssertion(dcterms:description goldbook:15404 "Addition of a monomer to a chain carrier bearing a terminal group derived from the same monomer species.")
Declaration(Class(goldbook:15405))
AnnotationAssertion(rdfs:label goldbook:15405 "ideal binary copolymerisation")
AnnotationAssertion(dcterms:description goldbook:15405 "Binary copolymerization in which the relative rates of incorporation of the two types of monomer into the copolymer are independent of the nature of the monomer unit at the end of a propagating chain.")
Declaration(Class(goldbook:15406))
AnnotationAssertion(rdfs:label goldbook:15406 "ideal copolymerisation")
AnnotationAssertion(dcterms:description goldbook:15406 "Copolymerization in which all types of propagating species show the same relative reactivity toward the monomers present.")
Declaration(Class(goldbook:15407))
AnnotationAssertion(rdfs:label goldbook:15407 "interfacial polycondensation")
AnnotationAssertion(dcterms:description goldbook:15407 "Polycondensation involving two monomers separately dissolved in immiscible solvents, forming a twophase system, with polycondensation taking place at (or near) an interface between the two phases.")
Declaration(Class(goldbook:15408))
AnnotationAssertion(rdfs:label goldbook:15408 "intermolecular chain transfer")
AnnotationAssertion(dcterms:description goldbook:15408 "Chain transfer from an active center on a macromolecule to a different macromolecule.")
Declaration(Class(goldbook:15409))
AnnotationAssertion(rdfs:label goldbook:15409 "kinetic-chain length")
AnnotationAssertion(dcterms:description goldbook:15409 "In a chain polymerization, the rate of chain propagation divided by the sum of the rates of all of the chain-termination processes.")
Declaration(Class(goldbook:15410))
AnnotationAssertion(rdfs:label goldbook:15410 "monomer reactivity ratios")
AnnotationAssertion(dcterms:description goldbook:15410 "In binary copolymerization, (a) the ratio (\\(r_{12}\\)) of the rate constant (\\(k_{11}\\)) for the homopropagation of monomer \\(\\rm{M}_{1}\\) to the rate constant (\\(k_{12}\\)) for the cross-propagation of the chain carrier \\(\\ldots -{\\rm{m}}_{1}^{\\ast}\\) with the monomer \\(\\rm{M}_{2}\\) and (b) the ratio (\\(r_{21}\\)) of the rate constant (\\(k_{22}\\)) for the homopropagation of monomer \\(\\rm{M}_{2}\\) to the rate constant for the cross-propagation (\\(k_{21}\\)) of the chain carrier \\(\\ldots -{\\rm{m}}_{2}^{\\ast}\\) with monomer \\(\\rm{M}_{1}\\). Thus, \\(r_{12} = k_{11}/k_{12}, r_{21} = k_{22}/k_{21}\\).")
Declaration(Class(goldbook:15411))
AnnotationAssertion(rdfs:label goldbook:15411 "monomer reactivity scale")
AnnotationAssertion(dcterms:description goldbook:15411 "Relative scale defined by the values of the rate constants for the addition of monomers to a reference active center.")
Declaration(Class(goldbook:15412))
AnnotationAssertion(rdfs:label goldbook:15412 "patterns of reactivity scheme")
AnnotationAssertion(dcterms:description goldbook:15412 "Method for the prediction of monomer reactivity ratios in binary copolymerization, based exclusively on experimentally determined parameters.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15412 "Jenkins’ scheme")
Declaration(Class(goldbook:15413))
AnnotationAssertion(rdfs:label goldbook:15413 "penultimate-unit effect")
AnnotationAssertion(dcterms:description goldbook:15413 "Phenomenon that the penultimate monomer unit preceding the active center on the terminal unit of an active polymer chain affects the reactivity of that active center.")
Declaration(Class(goldbook:15414))
AnnotationAssertion(rdfs:label goldbook:15414 "primary-radical termination")
AnnotationAssertion(dcterms:description goldbook:15414 "Termination reaction involving a radical chain carrier and a primary radical.")
Declaration(Class(goldbook:15415))
AnnotationAssertion(rdfs:label goldbook:15415 "pulsed-laser polymerisation")
AnnotationAssertion(dcterms:description goldbook:15415 "Polymerization initiated by successive pulses of laser light.")
Declaration(Class(goldbook:15416))
AnnotationAssertion(rdfs:label goldbook:15416 "<i>Q-e</i> scheme")
AnnotationAssertion(dcterms:description goldbook:15416 "Empirical equations expressing the monomer reactivity ratios in a binary radical copolymerization, \\(r_{12}\\) and \\(r_{21}\\), in terms of the empirical parameters \\(Q\\) and \\(e\\) for the two monomers, namely, \\(\\rm{Q}_{1}\\), \\(\\rm{Q}_{2}\\), \\(\\rm{e}_{1}\\), and \\(\\rm{e}_{2}\\), with\\(r_{12} = (Q_{1}/Q_{2})\\exp [-{e_{1}}(e_{1} - e_{2})]\\) and \\(r_{21} = (Q_{2}/Q_{1}) \\exp [-{e_{2}}(e_{2} - e_{1})]\\)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15416 "Alfrey–Price scheme")
Declaration(Class(goldbook:15417))
AnnotationAssertion(rdfs:label goldbook:15417 "radical reactivity scale")
AnnotationAssertion(dcterms:description goldbook:15417 "Scale of the values of the rate constants for the reaction of radicals with a reference monomer.")
Declaration(Class(goldbook:15418))
