[Term]
id: goldbook:C01172
name: colloidal
def: "The term refers to a state of subdivision\, implying that the molecules or polymolecular particles dispersed in a medium have at least in one direction a dimension roughly between \\\(1\\ \\rm\{nm\}\\\) and \\\(1\\ \\unicode\[Times\]\{x3BC\}\\rm\{m\}\\\)\, or that in a system discontinuities are found at distances of that order."
property_value: mito:isMentionedBy doi:10.1351/pac197231040577
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:C01173
name: colloidal carbon
def: "A particulate carbon with particle sizes below ca.\\\(1000\\ \\rm\{nm\}\\\) in at least one dimension."
comment: "Colloidal carbon exists in several morphologically distinct forms."
property_value: mito:isMentionedBy doi:10.1351/pac199567030473
property_value: hasStatus "current" xsd:string
