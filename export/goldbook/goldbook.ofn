AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11222 "venous sinus")
Declaration(Class(goldbook:11223))
AnnotationAssertion(rdfs:label goldbook:11223 "sister chromatid exchange")
AnnotationAssertion(dcterms:description goldbook:11223 "Reciprocal exchange of chromatin between two replicated chromosomes that remain attached to each other until anaphase of mitosis.")
Declaration(Class(goldbook:11224))
AnnotationAssertion(rdfs:label goldbook:11224 "situs inversus")
AnnotationAssertion(dcterms:description goldbook:11224 "Developmental anomaly in which major visceral organs are found in a mirrored position to their normal location.")
Declaration(Class(goldbook:11225))
AnnotationAssertion(rdfs:label goldbook:11225 "small interfering RNA molecule")
AnnotationAssertion(dcterms:description goldbook:11225 "Short interfering RNA.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11225 "siRNA molecule")
Declaration(Class(goldbook:11226))
AnnotationAssertion(rdfs:label goldbook:11226 "somatic")
AnnotationAssertion(dcterms:description goldbook:11226 "Pertaining to the body or describing cells that form the body other than germ line cells or undifferentiated stem cells.")
Declaration(Class(goldbook:11227))
AnnotationAssertion(rdfs:label goldbook:11227 "somatic hypermutation")
AnnotationAssertion(dcterms:description goldbook:11227 "Programmed process of mutation affecting the variable (V) regions of immunoglobulin (Ig) genes. SHM affects only individual immune cells, and the mutations are not transmitted to offspring.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11227 "mutation (in immunology)")
Declaration(Class(goldbook:11228))
AnnotationAssertion(rdfs:label goldbook:11228 "human chorionic somatomammotropin")
