AnnotationAssertion(rdfs:label goldbook:16178 "unit risk")
AnnotationAssertion(dcterms:description goldbook:16178 "Upper-bound excess lifetime cancer risk estimated to result from continuous exposure to an agent at a concentration of \\(\\pu{1 \\upmu g L-1}\\) in water, or \\(\\pu{1 \\upmu g m-3}\\) in air.")
AnnotationAssertion(rdfs:comment goldbook:16178 "The interpretation of unit risk is as follows: if unit risk = \\(\\pu{1.5E-6 \\upmu g L-1}\\), \\(\\pu{1.5}\\) excess tumors are expected to develop per \\(\\pu{1000000}\\) or \\(\\pu{E6}\\) people if exposed daily for a lifetime to \\(\\pu{1 \\upmu g}\\) of the chemical in \\(\\pu{1 L}\\) of drinking water."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16178 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16178 "current"^^xsd:string)
