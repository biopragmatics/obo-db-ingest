AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00240 "current"^^xsd:string)
Declaration(Class(goldbook:A00241))
AnnotationAssertion(rdfs:label goldbook:A00241 "allostery")
AnnotationAssertion(dcterms:description goldbook:A00241 "A phenomenon whereby the conformation of an enzyme or other protein is altered by combination, at a site other than the substrate-binding site, with a small molecule, referred to as an effector, which results in either increased or decreased activity by the enzyme.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00241 goldbook:B00649)
AnnotationAssertion(rdfs:seeAlso goldbook:A00241 goldbook:C01258)
AnnotationAssertion(rdfs:seeAlso goldbook:A00241 goldbook:E01901)
