Declaration(Class(goldbook:12148))
AnnotationAssertion(rdfs:label goldbook:12148 "treadmill test")
AnnotationAssertion(dcterms:description goldbook:12148 "Procedure used to assess limb function and strength, often to evaluate models of peripheral neuropathy, in which a rodent is placed in an enclosed lane upon a surface that can be made to move at variable speed in a retrograde manner, thus allowing observation of the animal’s gait dimension during sustained attempt at forward motion.")
AnnotationAssertion(rdfs:comment goldbook:12148 "The test can be modified to provide a test of endurance in the animal, or to test motor coordination and gait."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12148 "A treadmill test with humans is commonly used in a medical setting for assessment of cardiac performance and pulmonary function."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12148 goldbook:11884)
AnnotationAssertion(mito:isMentionedBy goldbook:12148 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12148 "current"^^xsd:string)
Declaration(Class(goldbook:12149))
AnnotationAssertion(rdfs:label goldbook:12149 "tremor")
AnnotationAssertion(dcterms:description goldbook:12149 "Repetitive, often regular and usually involuntary oscillatory movement caused by alternating contractions of opposing muscle groups.")
AnnotationAssertion(rdfs:comment goldbook:12149 "There are many causes of tremor, some of them benign."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12149 "A characteristic tremor originating in cerebellar pathways upon intentional fine movement (\"intention tremor\") can occur during alcohol withdrawal."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12149 "A coarse rhythmic (\\(\\pu{3\\!-\\! 5 Hz}\\)) tremor of the hands and forearms that appears when the muscles are relaxed (\"resting tremor\") is characteristic of Parkinson disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12149 goldbook:11998)
AnnotationAssertion(rdfs:seeAlso goldbook:12149 goldbook:11669)
AnnotationAssertion(rdfs:seeAlso goldbook:12149 goldbook:12181)
AnnotationAssertion(mito:isMentionedBy goldbook:12149 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12149 "current"^^xsd:string)
