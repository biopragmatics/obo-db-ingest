AnnotationAssertion(dcterms:description goldbook:08310 "Pulsed radiofrequency signal in NMR that rotates the bulk magnetization vector (\\(\\boldsymbol{M}_{0}\\)) of a nuclear spin to its opposing direction, effectively inverting the signal, (e.g., from the \\(+z\\) to \\(-z\\) axis).")
Declaration(Class(goldbook:08311))
AnnotationAssertion(rdfs:label goldbook:08311 "90° pulse")
AnnotationAssertion(dcterms:description goldbook:08311 "Pulsed radiofrequency signal that rotates the bulk magnetization vector (\\(\\boldsymbol{M}_{0}\\)) of a nuclear spin to its orthogonal plane.")
Declaration(Class(goldbook:08312))
