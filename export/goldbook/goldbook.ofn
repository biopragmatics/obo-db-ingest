Declaration(Class(goldbook:13079))
AnnotationAssertion(rdfs:label goldbook:13079 "danger hypothesis")
AnnotationAssertion(dcterms:description goldbook:13079 "Hypothesis that suggests it is not foreignness of a molecule per se but rather its ability to cause cell damage or stress that induces an immune response. Often implicated in causation of idiosyncratic drug reactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:13079 goldbook:13251)
AnnotationAssertion(mito:isMentionedBy goldbook:13079 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13079 "current"^^xsd:string)
Declaration(Class(goldbook:13080))
AnnotationAssertion(rdfs:label goldbook:13080 "death receptor")
AnnotationAssertion(dcterms:description goldbook:13080 "Cell-surface receptor whose binding to extracellular ligands stimulates apoptosis in the receptor-bearing cell through the extrinsic pathway.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13080 "death ligand receptor")
AnnotationAssertion(rdfs:seeAlso goldbook:13080 goldbook:13762)
AnnotationAssertion(mito:isMentionedBy goldbook:13080 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13080 "current"^^xsd:string)
Declaration(Class(goldbook:13081))
AnnotationAssertion(rdfs:label goldbook:13081 "death domain")
AnnotationAssertion(dcterms:description goldbook:13081 "Protein-interaction domain originally discovered in proteins involved in programmed cell death or apoptosis.")
AnnotationAssertion(mito:isMentionedBy goldbook:13081 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13081 "current"^^xsd:string)
Declaration(Class(goldbook:13082))
AnnotationAssertion(rdfs:label goldbook:13082 "decay-accelerating factor")
AnnotationAssertion(dcterms:description goldbook:13082 "Cell-surface molecule that protects cells from lysis by complement.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13082 "DAF")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13082 "CD55")
AnnotationAssertion(rdfs:comment goldbook:13082 "The decay-accelerating factor binds to C3 convertases of both the alternative pathway and classical pathway of complement activation and, by displacing Bb and C2b respectively, prevents their action. Its absence causes the disease paroxysmal nocturnal hemoglobinuria."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13082 goldbook:12866)
AnnotationAssertion(rdfs:seeAlso goldbook:13082 goldbook:13011)
AnnotationAssertion(rdfs:seeAlso goldbook:13082 goldbook:13047)
AnnotationAssertion(mito:isMentionedBy goldbook:13082 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13082 "current"^^xsd:string)
Declaration(Class(goldbook:13083))
AnnotationAssertion(rdfs:label goldbook:13083 "defensin")
AnnotationAssertion(dcterms:description goldbook:13083 "Any member of a family of oligopeptides made within the body, notably by neutrophils and macrophages, and having potent antimicrobial properties.")
AnnotationAssertion(rdfs:comment goldbook:13083 "Defensins play important roles against invading microbes. They act against bacteria, fungi, and viruses by binding to their membranes and increasing membrane permeability."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13083 "Human defensins are classified into the \\(\\ce{\\upalpha\\mbox{-}defensins}\\) and \\(\\ce{\\upbeta\\mbox{-}defensins}\\) on the basis of their sequence homology and their cysteine residues."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13083 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13083 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:13083 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13083 "current"^^xsd:string)
Declaration(Class(goldbook:13084))
AnnotationAssertion(rdfs:label goldbook:13084 "degranulation")
AnnotationAssertion(dcterms:description goldbook:13084 "Cell reaction that releases antimicrobial cytotoxic molecules and other substances (e.g., histamine) from secretory vesicles called granules found inside some cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13084 "mast cell degranulation")
AnnotationAssertion(rdfs:comment goldbook:13084 "Degranulation occurs in several different cells involved in the immune system, including granulocytes (neutrophils, basophils, and eosinophils), mast cells, and certain lymphocytes such as natural killer (NK) cells and cytotoxic T cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:12943)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:13071)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:13072)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:13117)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:13442)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:13499)
AnnotationAssertion(rdfs:seeAlso goldbook:13084 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:13084 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13084 "current"^^xsd:string)
Declaration(Class(goldbook:13085))
AnnotationAssertion(rdfs:label goldbook:13085 "delayed-type hypersensitivity")
AnnotationAssertion(dcterms:description goldbook:13085 "Form of T cell-mediated immunity in which the ultimate effector cell is the activated mononuclear phagocyte (macrophage); the response of DTH appears fully over \\(\\pu{24}\\) to \\(\\pu{48 h}\\). Previous exposure is required.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13085 "DTH")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13085 "Gell and Coombs Type IV reaction")
AnnotationAssertion(rdfs:comment goldbook:13085 "Examples include response to Mycobacterium tuberculosis (tuberculin test) and contact dermatitis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13085 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13085 goldbook:13041)
AnnotationAssertion(rdfs:seeAlso goldbook:13085 goldbook:13272)
AnnotationAssertion(rdfs:seeAlso goldbook:13085 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13085 goldbook:13560)
AnnotationAssertion(rdfs:seeAlso goldbook:13085 goldbook:13758)
AnnotationAssertion(mito:isMentionedBy goldbook:13085 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13085 "current"^^xsd:string)
Declaration(Class(goldbook:13086))
AnnotationAssertion(rdfs:label goldbook:13086 "delayed-type hypersensitivity assay")
AnnotationAssertion(dcterms:description goldbook:13086 "In vivo assay of cell-mediated immune response, elicited by antigen in the skin and mediated by CD4+ Th1 cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13086 "DTH assay")
AnnotationAssertion(rdfs:comment goldbook:13086 "DTH reactions are often divided into two phases which should be assessed in the assay: the sensitization phase, referring to the initial immunization with specific antigen, and the efferent or challenge phase of the DTH response, which usually follows 6 to 14 days after sensitization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13086 goldbook:12973)
AnnotationAssertion(rdfs:seeAlso goldbook:13086 goldbook:13718)
AnnotationAssertion(rdfs:seeAlso goldbook:13086 goldbook:12994)
AnnotationAssertion(rdfs:seeAlso goldbook:13086 goldbook:12997)
AnnotationAssertion(mito:isMentionedBy goldbook:13086 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13086 "current"^^xsd:string)
Declaration(Class(goldbook:13087))
AnnotationAssertion(rdfs:label goldbook:13087 "dendritic cell")
AnnotationAssertion(dcterms:description goldbook:13087 "Ameboid cell that is major histocompatibility complex (MHC) class II-positive, Fc receptor-negative, and presents processed antigens to T cells in the T-cell areas of secondary lymphoid tissues.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13087 "interdigitating dendritic cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13087 "interdigitating reticular cell")
AnnotationAssertion(rdfs:comment goldbook:13087 "Dendritic cells are potent stimulators of T-cell responses. Nonlymphoid tissues also contain dendritic cells, but these are not able to stimulate T-cell responses until they are activated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13087 "There are three major subclasses of dendritic cells, conventional dendritic cells, Langerhans cells, and plasmacytoid dendritic cells."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13087 "This is a different cell type from the follicular dendritic cell, which is Fc receptor-positive."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13087 "Some authors also distinguish myeloid and lymphoid dendritic cells based on lineage."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13087 "Some confusion in the classification of dendritic cells may arise from systems based on function, morphology, or lineage, and possibly species differences."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13138)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13373)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13045)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13156)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13432)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13577)
AnnotationAssertion(rdfs:seeAlso goldbook:13087 goldbook:13663)
AnnotationAssertion(mito:isMentionedBy goldbook:13087 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13087 "current"^^xsd:string)
Declaration(Class(goldbook:13088))
AnnotationAssertion(rdfs:label goldbook:13088 "immune complex deposition")
AnnotationAssertion(dcterms:description goldbook:13088 "Precipitation of immune complex in organs and tissues, often causing local inflammation.")
AnnotationAssertion(rdfs:comment goldbook:13088 "Immune complex deposition is a prominent feature of systemic lupus erythematosus (SLE), cryoglobulinemia, rheumatoid arthritis (RA), scleroderma, and Sjögren syndrome."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13088 goldbook:13680)
AnnotationAssertion(rdfs:seeAlso goldbook:13088 goldbook:13060)
AnnotationAssertion(rdfs:seeAlso goldbook:13088 goldbook:13257)
