property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:10121
name: complete linkage
def: "Linkage criterion in hierarchical clustering in which the distance between two clusters is the distance between those two objects \(one from each cluster\) that are farthest apart."
comment: "Complete linkage tends to find compact clusters of approximately equal size."
property_value: mito:isMentionedBy doi:10.1515/pac-2015-0605
property_value: hasStatus "current" xsd:string
