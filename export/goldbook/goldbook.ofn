Declaration(Class(goldbook:11215))
AnnotationAssertion(rdfs:label goldbook:11215 "sexual maturation")
AnnotationAssertion(dcterms:description goldbook:11215 "Process of reaching the age or stage when an organism can reproduce sexually.")
Declaration(Class(goldbook:11216))
AnnotationAssertion(rdfs:label goldbook:11216 "sexual maturity")
AnnotationAssertion(dcterms:description goldbook:11216 "Age or stage when an organism can reproduce sexually.")
Declaration(Class(goldbook:11217))
AnnotationAssertion(rdfs:label goldbook:11217 "sexual reproduction")
AnnotationAssertion(dcterms:description goldbook:11217 "Creation of a new organism requiring combination of the genetic material from two different sexes.")
Declaration(Class(goldbook:11218))
AnnotationAssertion(rdfs:label goldbook:11218 "sibling")
