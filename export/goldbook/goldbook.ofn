Declaration(Class(goldbook:H02816))
AnnotationAssertion(rdfs:label goldbook:H02816 "heterotrophic")
AnnotationAssertion(dcterms:description goldbook:H02816 "Descriptive of organisms which are not able to synthesize cell components from carbon dioxide as sole carbon source. Heterotrophic organisms use preformed oxidizable organic substrates such as glucose as carbon and energy sources.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:H02816 "heterotrophic organisms")
AnnotationAssertion(rdfs:seeAlso goldbook:H02816 goldbook:S06083)
AnnotationAssertion(mito:isMentionedBy goldbook:H02816 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:H02816 "current"^^xsd:string)
Declaration(Class(goldbook:H02818))
AnnotationAssertion(rdfs:label goldbook:H02818 "hexagonal graphite")
AnnotationAssertion(dcterms:description goldbook:H02818 "The thermodynamically stable form of graphite with an ABAB stacking sequence of the graphene layers. The exact crystallographic description of this allotropic form is given by the space group \\(d_{6h}^{4} - P6_{3}/\\rm{mmc}\\) (unit cell constants: \\(a=245.6\\ \\mathrm{pm}\\), \\(c=670.8\\ \\mathrm{pm}\\)). Hexagonal graphite is thermodynamically stable below approximately \\(2600\\ \\rm{K}\\) and \\(6\\ \\rm{GPa}\\).")
AnnotationAssertion(rdfs:comment goldbook:H02818 "The use of the term graphite instead of the more exact term hexagonal graphite may be tolerated in view of the minor importance of rhombohedral graphite, the other allotropic form."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:H02818 goldbook:G02683)
AnnotationAssertion(rdfs:seeAlso goldbook:H02818 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:H02818 goldbook:R05385)
AnnotationAssertion(rdfs:seeAlso goldbook:H02818 goldbook:ST06775)
