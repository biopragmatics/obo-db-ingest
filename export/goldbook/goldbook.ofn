AnnotationAssertion(rdfs:label goldbook:C01087 "<i>cis</i>-")
AnnotationAssertion(dcterms:description goldbook:C01087 "A prefix designating two groups occupying adjacent positions in a coordination sphere, not now generally recommended for precise nomenclature purposes.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01087 goldbook:C01329)
AnnotationAssertion(mito:isMentionedBy goldbook:C01087 doi:10.1515/pac-2014-0718)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01087 "current"^^xsd:string)
Declaration(Class(goldbook:C01092))
AnnotationAssertion(rdfs:label goldbook:C01092 "<i>cis</i>, <i>trans</i>")
AnnotationAssertion(dcterms:description goldbook:C01092 "Descriptors which show the relationship between two ligands attached to separate atoms that are connected by a double bond or are contained in a ring. The two ligands are said to be located cis to each other if they lie on the same side of a plane. If they are on opposite sides, their relative position is described as trans. The appropriate reference plane of a double bond is perpendicular to that of the relevant $\\ce{\\upsigma\\!\\mbox{-}bonds}$ and passes through the double bond. For a ring (the ring being in a conformation, real or assumed, without re-entrant angles at the two substituted atoms) it is the mean plane of the ring(s). For alkenes the terms cis and trans may be ambiguous and have therefore largely been replaced by the E, Z convention for the nomenclature of organic compounds. If there are more than two entities attached to the ring the use of cis and trans requires the definition of a reference substituent.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01092 goldbook:E01882)
AnnotationAssertion(rdfs:seeAlso goldbook:C01092 goldbook:A00224)
AnnotationAssertion(rdfs:seeAlso goldbook:C01092 goldbook:C01258)
AnnotationAssertion(rdfs:seeAlso goldbook:C01092 goldbook:L03518)
AnnotationAssertion(mito:isMentionedBy goldbook:C01092 doi:10.1351/pac199971071327)
AnnotationAssertion(mito:isMentionedBy goldbook:C01092 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01092 "current"^^xsd:string)
Declaration(Class(goldbook:C01093))
AnnotationAssertion(rdfs:label goldbook:C01093 "<i>cis</i>-<i>trans</i> isomers")
AnnotationAssertion(dcterms:description goldbook:C01093 "Stereoisomeric olefins or cycloalkanes (or hetero-analogues) which differ in the positions of atoms (or groups) relative to a reference plane: in the cis-isomer the atoms are on the same side, in the trans-isomer they are on opposite sides.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01093 "geometric isomerism")
AnnotationAssertion(rdfs:seeAlso goldbook:C01093 goldbook:S05983)
AnnotationAssertion(rdfs:seeAlso goldbook:C01093 goldbook:C01497)
