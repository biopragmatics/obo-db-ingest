AnnotationAssertion(rdfs:label goldbook:C01103 "clone")
AnnotationAssertion(dcterms:description goldbook:C01103 "A population of genetically identical cells produced from a common ancestor. Sometimes, 'clone' is also used for a number of recombinant DNA molecules all carrying the same inserted sequence.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:C01103 "DNA")
AnnotationAssertion(rdfs:seeAlso goldbook:C01103 goldbook:R05203)
