Declaration(Class(goldbook:C01107))
AnnotationAssertion(rdfs:label goldbook:C01107 "cloud")
AnnotationAssertion(dcterms:description goldbook:C01107 "An aerosol of the atmosphere which is dense enough to be perceptible to the eye. Usually refers to an assembly of water droplet aerosols suspended in the atmosphere, although dust clouds are also recognized.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01107 goldbook:A00176)
AnnotationAssertion(mito:isMentionedBy goldbook:C01107 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01107 "current"^^xsd:string)
Declaration(Class(goldbook:C01115))
AnnotationAssertion(rdfs:label goldbook:C01115 "cluster ion")
AnnotationAssertion(dcterms:description goldbook:C01115 "An ion formed by the combination of more ions or atoms or molecules of a chemical species often in association with a second species. For example, $\\ce{[(H2O)_{n}H]^{+}}$ is a cluster ion.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01115 goldbook:A00472)
AnnotationAssertion(rdfs:seeAlso goldbook:C01115 goldbook:CT06769)
AnnotationAssertion(mito:isMentionedBy goldbook:C01115 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01115 "current"^^xsd:string)
Declaration(Class(goldbook:C01116))
AnnotationAssertion(rdfs:label goldbook:C01116 "coacervation")
AnnotationAssertion(dcterms:description goldbook:C01116 "The separation into two liquid phases in colloidal systems. The phase more concentrated in colloid component is the coacervate, and the other phase is the equilibrium solution.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01116 goldbook:C01171)
AnnotationAssertion(rdfs:seeAlso goldbook:C01116 goldbook:C01172)
AnnotationAssertion(mito:isMentionedBy goldbook:C01116 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01116 "current"^^xsd:string)
Declaration(Class(goldbook:C01117))
AnnotationAssertion(rdfs:label goldbook:C01117 "coagulation")
AnnotationAssertion(dcterms:description goldbook:C01117 "When a sol is colloidally unstable (i.e. the rate of aggregation is not negligible) the formation of aggregates is called coagulation or flocculation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01117 "flocculation")
AnnotationAssertion(rdfs:seeAlso goldbook:C01117 goldbook:A00184)
AnnotationAssertion(rdfs:seeAlso goldbook:C01117 goldbook:A00182)
AnnotationAssertion(rdfs:seeAlso goldbook:C01117 goldbook:S05727)
AnnotationAssertion(rdfs:seeAlso goldbook:C01117 goldbook:U06569)
AnnotationAssertion(mito:isMentionedBy goldbook:C01117 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01117 "current"^^xsd:string)
Declaration(Class(goldbook:C01118))
AnnotationAssertion(rdfs:label goldbook:C01118 "coal-derived pitch coke")
AnnotationAssertion(dcterms:description goldbook:C01118 "The primary industrial solid carbonization product obtained from coal tar pitch mainly produced in chamber or delayed coking processes.")
AnnotationAssertion(rdfs:comment goldbook:C01118 "Coal-derived pitchcoke, although it exhibits a pregraphitic microstructure, has often a lower graphitizability than petroleum coke. Fractions of coal tar pitches (obtained by extraction or filtration) may form cokes with needle-like structures and have an improved graphitizability. The usually lower graphitizability compared to petroleum coke is due to an inhibition of mesophase growth because of chemical and physical differences of the cokes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:C00840)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:C01121)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:C01142)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:D01578)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:E02301)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:F02388)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:I03034)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:M03849)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:P04522)
AnnotationAssertion(rdfs:seeAlso goldbook:C01118 goldbook:P04677)
AnnotationAssertion(mito:isMentionedBy goldbook:C01118 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01118 "current"^^xsd:string)
Declaration(Class(goldbook:C01119))
AnnotationAssertion(rdfs:label goldbook:C01119 "coalescence")
AnnotationAssertion(dcterms:description goldbook:C01119 "The disappearance of the boundary between two particles (usually droplets or bubbles) in contact, or between one of these and a bulk phase followed by changes of shape leading to a reduction of the total surface area. The flocculation of an emulsion, viz. the formation of aggregates, may be followed by coalescence.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01119 goldbook:A00184)
AnnotationAssertion(rdfs:seeAlso goldbook:C01119 goldbook:E02065)
AnnotationAssertion(rdfs:seeAlso goldbook:C01119 goldbook:A00182)
AnnotationAssertion(mito:isMentionedBy goldbook:C01119 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01119 "current"^^xsd:string)
Declaration(Class(goldbook:C01120))
AnnotationAssertion(rdfs:label goldbook:C01120 "coalification")
AnnotationAssertion(dcterms:description goldbook:C01120 "A geological process of formation of materials with increasing content of the element carbon from organic materials that occurs in a first, biological stage into peats, followed by a gradual transformation into coal by action of moderate temperature (about \\(500\\ \\rm{K}\\)) and high pressure in a geochemical stage.")
AnnotationAssertion(rdfs:comment goldbook:C01120 "Coalification is a dehydrogenation process with a reaction rate slower by many orders of magnitude than that of carbonization. Some specific reactions approach completion before others have started. The dehydrogenation remains incomplete. The degree of coalification reached by an organic material in the process of coalification increases progressively and can be defined by means of the measured C/H ratio and of the residual contents of oxygen, sulfur and nitrogen."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01120 goldbook:C00840)
AnnotationAssertion(rdfs:seeAlso goldbook:C01120 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:C01120 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01120 "current"^^xsd:string)
Declaration(Class(goldbook:C01121))
AnnotationAssertion(rdfs:label goldbook:C01121 "coal tar pitch")
AnnotationAssertion(dcterms:description goldbook:C01121 "A residue produced by distillation or heat treatment of coal tar. It is a solid at room temperature, consists of a complex mixture of numerous predominantly aromatic hydrocarbons and heterocyclics, and exhibits a broad softening range instead of a defined melting temperature.")
AnnotationAssertion(rdfs:comment goldbook:C01121 "The hydrogen aromaticity in coal tar pitch (ratio of aromatic to total content of hydrogen atoms) varies from 0.7 to 0.9."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01121 goldbook:A00442)
AnnotationAssertion(rdfs:seeAlso goldbook:C01121 goldbook:H02889)
AnnotationAssertion(rdfs:seeAlso goldbook:C01121 goldbook:M03821)
AnnotationAssertion(rdfs:seeAlso goldbook:C01121 goldbook:P04677)
AnnotationAssertion(mito:isMentionedBy goldbook:C01121 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01121 "current"^^xsd:string)
Declaration(Class(goldbook:C01123))
AnnotationAssertion(rdfs:label goldbook:C01123 "codon")
AnnotationAssertion(dcterms:description goldbook:C01123 "The sequence of three consecutive nucleotides that occurs in mRNA which directs the incorporation of a specific amino acid into a protein and includes also the starting or termination signals of protein synthesis.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01123 goldbook:M03857)
AnnotationAssertion(rdfs:seeAlso goldbook:C01123 goldbook:N04255)
AnnotationAssertion(rdfs:seeAlso goldbook:C01123 goldbook:ST06775)
AnnotationAssertion(rdfs:seeAlso goldbook:C01123 goldbook:T06274)
AnnotationAssertion(mito:isMentionedBy goldbook:C01123 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01123 "current"^^xsd:string)
Declaration(Class(goldbook:C01125))
AnnotationAssertion(rdfs:label goldbook:C01125 "coefficient of haze")
AnnotationAssertion(dcterms:description goldbook:C01125 "One technique of measurement of the amount of filterable particulate matter suspended in air which has been used in the past depends upon drawing a measured sample of air (usually 1 000 linear feet) through a paper or membrane filter. A measurement is made of the intensity of light transmitted through the dust spot formed relative to that transmitted through an identical clean filter. The dirtiness of the air is reported in terms of the \\(\\rm{COH}\\) unit. This relates to the quantity of particulate material which produces an optical density, \\[\\log_{10}(\\frac{I_{0}}{I})\\] of 0.01 when measured by light transmission at \\(\\pu{400 nm}\\) and relative to the transmission of an identical dust-free filter taken as 100%. Thus a filter which transmitted 50% relative to the clean filter has an absorbance of 0.301 or 30.1 \\(\\rm{COH}\\) units. This is not a recommended measure of filterable particulate matter since the size, colour and other properties of the aerosol and the air in which it is suspended affect the results.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:C01125 "COH")
AnnotationAssertion(rdfs:seeAlso goldbook:C01125 goldbook:A00028)
AnnotationAssertion(rdfs:seeAlso goldbook:C01125 goldbook:A00176)
AnnotationAssertion(rdfs:seeAlso goldbook:C01125 goldbook:F02384)
AnnotationAssertion(rdfs:seeAlso goldbook:C01125 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:C01125 goldbook:O04306)
AnnotationAssertion(rdfs:seeAlso goldbook:C01125 goldbook:T06477)
AnnotationAssertion(mito:isMentionedBy goldbook:C01125 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01125 "current"^^xsd:string)
Declaration(Class(goldbook:C01126))
AnnotationAssertion(rdfs:label goldbook:C01126 "coenzyme")
AnnotationAssertion(dcterms:description goldbook:C01126 "The dissociable, low-relative-molecular-mass active group of an enzyme which transfers chemical groups, hydrogen or electrons. A coenzyme binds with its associated protein (apoenzyme) to form the active enzyme (holoenzyme).")
AnnotationAssertion(rdfs:seeAlso goldbook:C01126 goldbook:A00417)
AnnotationAssertion(rdfs:seeAlso goldbook:C01126 goldbook:E02159)
AnnotationAssertion(rdfs:seeAlso goldbook:C01126 goldbook:H02836)
AnnotationAssertion(mito:isMentionedBy goldbook:C01126 doi:10.1351/pac199466122587)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01126 "current"^^xsd:string)
Declaration(Class(goldbook:C01127))
AnnotationAssertion(rdfs:label goldbook:C01127 "coextraction")
AnnotationAssertion(dcterms:description goldbook:C01127 "Formation of mixed-species aggregates in a low-polarity organic phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01127 goldbook:P04710)
AnnotationAssertion(mito:isMentionedBy goldbook:C01127 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01127 "current"^^xsd:string)
Declaration(Class(goldbook:C01128))
AnnotationAssertion(rdfs:label goldbook:C01128 "cofactors")
AnnotationAssertion(dcterms:description goldbook:C01128 "Organic molecules (cf. coenzymes) or ions (usually metal ions) that are required by an enzyme of its activity. They may be attached either loosely or tightly prosthetic group) to the enzyme. A cofactor binds with its associated protein (apoenzymes), which is functionally inactive, to form the active enzyme (holoenzyme).")
AnnotationAssertion(rdfs:seeAlso goldbook:C01128 goldbook:C01126)
AnnotationAssertion(rdfs:seeAlso goldbook:C01128 goldbook:E02159)
AnnotationAssertion(rdfs:seeAlso goldbook:C01128 goldbook:H02836)
AnnotationAssertion(rdfs:seeAlso goldbook:C01128 goldbook:P04893)
AnnotationAssertion(mito:isMentionedBy goldbook:C01128 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01128 "current"^^xsd:string)
Declaration(Class(goldbook:C01129))
AnnotationAssertion(rdfs:label goldbook:C01129 "coherence length")
AnnotationAssertion(dcterms:description goldbook:C01129 "The distance over which order is maintained. As an example, there can be long-range atomic or molecular order, i.e. coherence. Coherence lengths are significantly larger than molecular size. Normally, coherence length is estimated from electron, neutron or X-ray scattering and scales the size of ordered domains in material where long range ordering occurs (as in liquid crystals, for example). The term coherence length is also used for the scale characterizing the profile of molecular axis orientation in the distorted, so-called, transition layers formed at a solid/liquid-crystal boundary when an appropriate external field is applied (e.g. when the orientation of anchored surface molecules of a nematic liquid crystal is unaffected by an external field -- magnetic or electric -- whereas the bulk molecules reorient freely). This scale is referred to as electric coherence length, \\(\\zeta _{\\rm{E}}\\) or magnetic coherence length, \\(\\zeta _{\\rm{M}}\\), depending on the nature of the applied field.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01129 goldbook:LT06856)
AnnotationAssertion(rdfs:seeAlso goldbook:C01129 goldbook:N04116)
AnnotationAssertion(rdfs:seeAlso goldbook:C01129 goldbook:S05487)
AnnotationAssertion(mito:isMentionedBy goldbook:C01129 doi:10.1351/pac199466081667)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01129 "current"^^xsd:string)
Declaration(Class(goldbook:C01130))
AnnotationAssertion(rdfs:label goldbook:C01130 "coherent radiation")
AnnotationAssertion(dcterms:description goldbook:C01130 "Radiation emitted by a source when all the elementary waves emitted have a phase difference constant in space and time.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01130 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01130 "current"^^xsd:string)
Declaration(Class(goldbook:C01131))
AnnotationAssertion(rdfs:label goldbook:C01131 "coherent scattering")
AnnotationAssertion(dcterms:description goldbook:C01131 "Scattering is coherent whenever the phases of the signals arising from different scattering centres are correlated and incoherent whenever these phases are uncorrelated.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01131 goldbook:S05487)
AnnotationAssertion(mito:isMentionedBy goldbook:C01131 doi:10.1351/pac198355060931)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01131 "current"^^xsd:string)
Declaration(Class(goldbook:C01132))
AnnotationAssertion(rdfs:label goldbook:C01132 "coherent source")
AnnotationAssertion(dcterms:description goldbook:C01132 "Those sources where the radiation has a constant phase relationship between waves spatially as well as temporally, e.g. lasers. Non-coherent optical sources emit radiation which is randomly distributed in phase, spatially as well as temporally. Most sources which are used in spectroscopy and for spectrochemical analysis conform to this latter group.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01132 goldbook:R05048)
AnnotationAssertion(rdfs:seeAlso goldbook:C01132 goldbook:S05848)
AnnotationAssertion(mito:isMentionedBy goldbook:C01132 doi:10.1351/pac198557101453)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01132 "current"^^xsd:string)
Declaration(Class(goldbook:C01133))
AnnotationAssertion(rdfs:label goldbook:C01133 "coherent structure")
AnnotationAssertion(dcterms:description goldbook:C01133 "If the net of an ordered adsorbed phase is in registry with the lattice of the adsorbent the structure is called coherent, if not it is called incoherent.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01133 goldbook:A00153)
AnnotationAssertion(mito:isMentionedBy goldbook:C01133 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01133 "current"^^xsd:string)
Declaration(Class(goldbook:C01134))
AnnotationAssertion(rdfs:label goldbook:C01134 "coherent system of units of measurement")
AnnotationAssertion(dcterms:description goldbook:C01134 "System of units of measurement in which all of the derived units are coherent.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01134 goldbook:C01135)
AnnotationAssertion(rdfs:seeAlso goldbook:C01134 goldbook:D01615)
AnnotationAssertion(mito:isMentionedBy goldbook:C01134 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01134 "current"^^xsd:string)
Declaration(Class(goldbook:C01135))
AnnotationAssertion(rdfs:label goldbook:C01135 "coherent unit")
AnnotationAssertion(dcterms:description goldbook:C01135 "Derived unit of measurement that may be expressed as a product of powers of base units with the proportionality factor one.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01135 "coherent derived unit")
AnnotationAssertion(mito:isMentionedBy goldbook:C01135 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01135 "current"^^xsd:string)
Declaration(Class(goldbook:C01136))
AnnotationAssertion(rdfs:label goldbook:C01136 "coincidence circuit")
AnnotationAssertion(dcterms:description goldbook:C01136 "An electronic circuit which produces a usable output pulse only when each of its inputs receives a pulse within a specified time interval.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01136 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01136 "current"^^xsd:string)
Declaration(Class(goldbook:C01139))
AnnotationAssertion(rdfs:label goldbook:C01139 "coincidence resolving time")
AnnotationAssertion(dcterms:description goldbook:C01139 "The greatest time interval that can elapse between the occurrence of two or more consecutive signal pulses, in order that the measuring device processes them as a coincidence.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01139 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01139 "current"^^xsd:string)
Declaration(Class(goldbook:C01141))
AnnotationAssertion(rdfs:label goldbook:C01141 "co-ions")
AnnotationAssertion(dcterms:description goldbook:C01141 "Ions of low relative molecular mass with a charge of the same sign as that of a given colloidal ion.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01141 goldbook:I03158)
AnnotationAssertion(rdfs:seeAlso goldbook:C01141 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:C01141 goldbook:R05271)
AnnotationAssertion(mito:isMentionedBy goldbook:C01141 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01141 "current"^^xsd:string)
Declaration(Class(goldbook:C01142))
AnnotationAssertion(rdfs:label goldbook:C01142 "coke")
AnnotationAssertion(dcterms:description goldbook:C01142 "A solid high in content of the element carbon and structurally in the non-graphitic state. It is produced by pyrolysis of organic material which has passed, at least in part, through a liquid or liquid-crystalline state during the carbonization process. Coke can contain mineral matter.")
AnnotationAssertion(rdfs:comment goldbook:C01142 "As some parts, at least, of the carbonization product have passed through a liquid or liquid-crystalline state, the resulting non-graphitic carbon is of the graphitizable variety. From a structural viewpoint, the term coke characterizes the state of graphitizable carbon before the beginning of graphitization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01142 goldbook:C00840)
AnnotationAssertion(rdfs:seeAlso goldbook:C01142 goldbook:G02690)
AnnotationAssertion(rdfs:seeAlso goldbook:C01142 goldbook:G02691)
AnnotationAssertion(rdfs:seeAlso goldbook:C01142 goldbook:N04193)
AnnotationAssertion(rdfs:seeAlso goldbook:C01142 goldbook:P04961)
AnnotationAssertion(mito:isMentionedBy goldbook:C01142 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01142 "current"^^xsd:string)
Declaration(Class(goldbook:C01143))
AnnotationAssertion(rdfs:label goldbook:C01143 "coke breeze")
AnnotationAssertion(dcterms:description goldbook:C01143 "A by-product of coke manufacture; it is the residue from the screening of heat-treated coke. The particle size is less than \\(10\\ \\rm{mm}\\). Generally, coke breeze has a volatile matter content of \\(")
AnnotationAssertion(rdfs:seeAlso goldbook:C01143 goldbook:C01142)
AnnotationAssertion(mito:isMentionedBy goldbook:C01143 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01143 "current"^^xsd:string)
Declaration(Class(goldbook:C01144))
AnnotationAssertion(rdfs:label goldbook:C01144 "coking")
AnnotationAssertion(dcterms:description goldbook:C01144 "Many reactions involving hydrocarbons and particularly those run at higher temperatures lead to the deposition on the catalyst of high molecular weight compounds of carbon and hydrogen which deactivate the catalyst. This phenomenon is called coking or fouling. Catalysts so deactivated can often be regenerated.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01144 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:C01144 goldbook:H02889)
AnnotationAssertion(rdfs:seeAlso goldbook:C01144 goldbook:M04000)
AnnotationAssertion(mito:isMentionedBy goldbook:C01144 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01144 "current"^^xsd:string)
Declaration(Class(goldbook:C01145))
AnnotationAssertion(rdfs:label goldbook:C01145 "col")
AnnotationAssertion(dcterms:description goldbook:C01145 "A mountain-pass in a potential-energy surface is known as a col or saddle point. It is a point at which the gradient is zero along all coordinates, and the curvature is positive along all but one coordinate, which is the reaction coordinate, along which the curvature is negative.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01145 "saddle point")
AnnotationAssertion(rdfs:seeAlso goldbook:C01145 goldbook:G02669)
AnnotationAssertion(rdfs:seeAlso goldbook:C01145 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:C01145 goldbook:R05168)
AnnotationAssertion(rdfs:seeAlso goldbook:C01145 goldbook:S05446)
AnnotationAssertion(mito:isMentionedBy goldbook:C01145 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01145 "current"^^xsd:string)
Declaration(Class(goldbook:C01147))
AnnotationAssertion(rdfs:label goldbook:C01147 "cold neutrons")
AnnotationAssertion(dcterms:description goldbook:C01147 "Neutrons with a neutron temperature considerably lower than normal room temperature.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01147 goldbook:N04132)
AnnotationAssertion(mito:isMentionedBy goldbook:C01147 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01147 "current"^^xsd:string)
Declaration(Class(goldbook:C01149))
AnnotationAssertion(rdfs:label goldbook:C01149 "collection efficiency")
AnnotationAssertion(dcterms:description goldbook:C01149 "A term which characterizes an entire sampling and sample pretreatment procedure, usually represented as a percentage of the original amount of the analyte which is left for measurement (signal formation) after having passed through this procedure. This term also applies to the efficiency of collection of an air pollutant by an arrestment plant. For particulates, the collection efficiency is size related.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01149 goldbook:A00194)
AnnotationAssertion(rdfs:seeAlso goldbook:C01149 goldbook:C01148)
AnnotationAssertion(mito:isMentionedBy goldbook:C01149 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01149 "current"^^xsd:string)
Declaration(Class(goldbook:C01150))
AnnotationAssertion(rdfs:label goldbook:C01150 "collection gas flow system")
AnnotationAssertion(dcterms:description goldbook:C01150 "A system in which the analyte is carried to a collecting device called the collector which may be an amalgamator for mercury, a cold trap for some of the more stable hydrides, an absorbing solution in which the analyte is absorbed by some chemical reaction, an electrothermal atomizer or a reservoir.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01150 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:C01150 doi:10.1351/pac199264020261)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01150 "current"^^xsd:string)
Declaration(Class(goldbook:C01151))
AnnotationAssertion(rdfs:label goldbook:C01151 "collector")
AnnotationAssertion(dcterms:description goldbook:C01151 "A device for removing and retaining contaminants from air or other gases; a term which is often applied to cleaning devices in exhaust systems. Also used to designate a device for removing and retaining samples from media in different environmental compartments to be investigated. A collector is sometimes used to describe a scavenger.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01151 goldbook:S05495)
AnnotationAssertion(mito:isMentionedBy goldbook:C01151 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01151 "current"^^xsd:string)
Declaration(Class(goldbook:C01153))
AnnotationAssertion(rdfs:label goldbook:C01153 "colligation")
AnnotationAssertion(dcterms:description goldbook:C01153 "The formation of a covalent bond by the combination or recombination of two radicals (the reverse of unimolecular homolysis).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01153 "radical combination")
AnnotationAssertion(rdfs:seeAlso goldbook:C01153 goldbook:C01384)
AnnotationAssertion(rdfs:seeAlso goldbook:C01153 goldbook:R05066)
AnnotationAssertion(rdfs:seeAlso goldbook:C01153 goldbook:M03989)
AnnotationAssertion(mito:isMentionedBy goldbook:C01153 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01153 "current"^^xsd:string)
Declaration(Class(goldbook:C01154))
AnnotationAssertion(rdfs:label goldbook:C01154 "collimation")
AnnotationAssertion(dcterms:description goldbook:C01154 "The limiting of a beam of radiation to the required dimensions and angular spread.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01154 goldbook:R05048)
AnnotationAssertion(mito:isMentionedBy goldbook:C01154 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01154 "current"^^xsd:string)
Declaration(Class(goldbook:C01155))
AnnotationAssertion(rdfs:label goldbook:C01155 "collimator")
AnnotationAssertion(dcterms:description goldbook:C01155 "An arrangement of absorbers used for collimation.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01155 goldbook:A00034)
AnnotationAssertion(rdfs:seeAlso goldbook:C01155 goldbook:C01154)
AnnotationAssertion(mito:isMentionedBy goldbook:C01155 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01155 "current"^^xsd:string)
Declaration(Class(goldbook:C01156))
AnnotationAssertion(rdfs:label goldbook:C01156 "collinear reaction")
AnnotationAssertion(dcterms:description goldbook:C01156 "This is a reaction assumed to occur via an activated complex in which all of the atoms directly involved in the process lie along a straight line.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01156 goldbook:A00092)
AnnotationAssertion(mito:isMentionedBy goldbook:C01156 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01156 "current"^^xsd:string)
Declaration(Class(goldbook:C01157))
AnnotationAssertion(rdfs:label goldbook:C01157 "collisional activation")
AnnotationAssertion(dcterms:description goldbook:C01157 "An ion/neutral species process wherein excitation of a projectile ion of high translational energy is brought about by the same mechanism as in collision-induced dissociation. (The ion may decompose subsequently.)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01157 "collisionally activated dissociation")
AnnotationAssertion(rdfs:seeAlso goldbook:C01157 goldbook:D01801)
AnnotationAssertion(mito:isMentionedBy goldbook:C01157 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01157 "current"^^xsd:string)
Declaration(Class(goldbook:C01158))
AnnotationAssertion(rdfs:label goldbook:C01158 "collisional broadening")
AnnotationAssertion(dcterms:description goldbook:C01158 "Collisions of the emitting or absorbing particle with other particles cause collisional broadening as well as collisional shift of the spectral line. When collisions occur between unlike, neutral particles the term foreign-gas broadening is used, or van der Waals' broadening when both collision partners are neutral. When the colliding particles are of the same species, the term resonance broadening is employed. The term Lorentz broadening was previously used for neutral particle collision broadening, and Holtsmark broadening for cases of van der Waals' broadening when collisions took place with like particles. Both terms are now discouraged. Stark broadening refers to collisions with charged particles or particles with a strong permanent electrical dipole moment. Whereas a strong chaotic electrical field causes Stark broadening, an applied static electrical field induces a Stark shift.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01158 "Lorentz broadening")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01158 "Holtsmark broadening")
AnnotationAssertion(rdfs:seeAlso goldbook:C01158 goldbook:D01761)
AnnotationAssertion(rdfs:seeAlso goldbook:C01158 goldbook:R05326)
AnnotationAssertion(mito:isMentionedBy goldbook:C01158 doi:10.1351/pac198557101453)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01158 "current"^^xsd:string)
Declaration(Class(goldbook:C01159))
AnnotationAssertion(rdfs:label goldbook:C01159 "collisional excitation")
AnnotationAssertion(dcterms:description goldbook:C01159 "An ion/neutral species process wherein there is an increase in the reactant ion's internal energy at the expense of the translational energy of either (or both) of the reacting species. The scattering angle may be large.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01159 goldbook:I03103)
AnnotationAssertion(rdfs:seeAlso goldbook:C01159 goldbook:S05488)
AnnotationAssertion(mito:isMentionedBy goldbook:C01159 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01159 "current"^^xsd:string)
Declaration(Class(goldbook:C01160))
AnnotationAssertion(rdfs:label goldbook:C01160 "collision complex")
AnnotationAssertion(dcterms:description goldbook:C01160 "An ensemble formed by two reaction partners for which the distance is the sum of their van der Waals radii. As such it constitutes a subclass of the species indicated as encounter complex.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01160 goldbook:E02087)
AnnotationAssertion(mito:isMentionedBy goldbook:C01160 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01160 "current"^^xsd:string)
Declaration(Class(goldbook:C01164))
AnnotationAssertion(rdfs:label goldbook:C01164 "collision efficiency")
AnnotationAssertion(dcterms:description goldbook:C01164 "The collision efficiency, or de-energization efficiency, is defined by: \\[k_{\\rm{-1}} = B_{\\rm{c}}\\ k_{\\rm{-1}}^{\\rm{sc}}\\] where \\(k_{-1}\\) is the rate constant for a particular substance \\(\\rm{M}\\) when it brings about the de-energization process  and \\(k_{-1}^{\\rm{sc}}\\) is the corresponding rate constant for a reference molecule \\(\\rm{M}_{\\rm{r}}\\) that de-energizes \\(\\rm{A}^{*}\\) on every collision; that is, the reference molecule \\(\\rm{M}_{\\rm{r}}\\) undergoes strong collisions, and by definition has a collision efficiency \\(B_{\\rm{c}}\\) of unity. The species \\(\\rm{A}^{*}\\) is usually in a vibrationally-excited state, and \\(\\rm{A}\\) has energy less than that required for reaction to occur.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01164 "de-energization efficiency")
AnnotationAssertion(rdfs:seeAlso goldbook:C01164 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:C01164 goldbook:O04322)
AnnotationAssertion(rdfs:seeAlso goldbook:C01164 goldbook:S06059)
AnnotationAssertion(mito:isMentionedBy goldbook:C01164 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01164 "current"^^xsd:string)
Declaration(Class(goldbook:C01167))
AnnotationAssertion(rdfs:label goldbook:C01167 "collision-induced dissociation")
AnnotationAssertion(dcterms:description goldbook:C01167 "An ion/neutral species process wherein the projectile ion is dissociated as a result of interaction with a target neutral species. This is brought about by conversion of part of the translational energy of the ion to internal energy in the ion during the collision.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01167 goldbook:I03103)
AnnotationAssertion(mito:isMentionedBy goldbook:C01167 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01167 "current"^^xsd:string)
Declaration(Class(goldbook:C01169))
AnnotationAssertion(rdfs:label goldbook:C01169 "collision number")
AnnotationAssertion(dcterms:description goldbook:C01169 "Now called collision density.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01169 goldbook:C01162)
AnnotationAssertion(mito:isMentionedBy goldbook:C01169 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01169 "current"^^xsd:string)
Declaration(Class(goldbook:C01170))
AnnotationAssertion(rdfs:label goldbook:C01170 "collision theory")
AnnotationAssertion(dcterms:description goldbook:C01170 "Various collision theories, dealing with the frequency of collision between reactant molecules, have been put forward. In the earliest theories reactant molecules were regarded as hard spheres, and a collision was considered to occur when the distance \\(d\\) between the centres of two molecules was equal to the sum of their radii. For a gas containing only one type of molecule, A, the collision density is given by simple collision theory as: \\[Z_{\\mathrm{AA}}=\\frac{\\sqrt{2}\\ \\pi \\ \\sigma ^{2}\\ u\\ N_{\\rm{A}}^{2}}{2}\\] Here \\(N_{\\rm{A}}\\) is the number density of molecules and \\(u\\) is the mean molecular speed, given by kinetic theory to be \\(\\sqrt{\\frac{8\\ k_{\\rm{B}}\\ T}{\\pi \\ m}}\\), where \\(m\\) is the molecular mass, and \\(\\sigma =\\pi \\ d_{\\mathrm{AA}}^{2}\\). Thus: \\[Z_{\\mathrm{AA}}=2\\ N_{\\rm{A}}^{2}\\ \\sigma ^{2}\\ \\sqrt{\\frac{\\pi \\ k_{\\rm{B}}\\ T}{m}}\\] The corresponding expression for the collision density \\(Z_{\\mathrm{AB}}\\) for two unlike molecules A and B, of masses \\(m_{\\rm{A}}\\) and \\(m_{\\rm{B}}\\) is: \\[Z_{\\mathrm{AB}}=N_{\\rm{A}}\\ N_{\\rm{B}}\\ \\sigma ^{2}\\ \\sqrt{\\frac{\\pi \\ k_{\\rm{B}}\\ T}{\\mu }}\\] where \\(\\mu \\) is the reduced mass \\(\\frac{m_{\\rm{A}}\\ m_{\\rm{B}}}{m_{\\rm{A}}+m_{\\rm{B}}}\\), and \\(\\sigma =\\pi \\ d_{\\mathrm{AB}}^{2}\\). For the collision frequency factor these formulations lead to the following expression: \\[z_{\\mathrm{AA}}\\quad \\rm{or}\\quad z_{\\mathrm{AB}}=L\\ \\sigma ^{2}\\ \\sqrt{\\frac{8\\ \\pi \\ k_{\\rm{B}}\\ T}{\\mu }}\\] where \\(L\\) is the Avogadro constant. More advanced collision theories, not involving the assumption that molecules behave as hard spheres, are known as generalized kinetic theories.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01170 "kinetic theory of collisions")
AnnotationAssertion(rdfs:seeAlso goldbook:C01170 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:C01170 goldbook:C01162)
AnnotationAssertion(rdfs:seeAlso goldbook:C01170 goldbook:C01166)
AnnotationAssertion(rdfs:seeAlso goldbook:C01170 goldbook:N04262)
AnnotationAssertion(rdfs:seeAlso goldbook:C01170 goldbook:R05163)
AnnotationAssertion(rdfs:seeAlso goldbook:C01170 goldbook:R05214)
AnnotationAssertion(mito:isMentionedBy goldbook:C01170 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01170 "current"^^xsd:string)
Declaration(Class(goldbook:C01171))
AnnotationAssertion(rdfs:label goldbook:C01171 "colloid")
AnnotationAssertion(dcterms:description goldbook:C01171 "A short synonym for colloidal system.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01171 goldbook:C01172)
AnnotationAssertion(mito:isMentionedBy goldbook:C01171 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01171 "current"^^xsd:string)
Declaration(Class(goldbook:C01172))
AnnotationAssertion(rdfs:label goldbook:C01172 "colloidal")
AnnotationAssertion(dcterms:description goldbook:C01172 "The term refers to a state of subdivision, implying that the molecules or polymolecular particles dispersed in a medium have at least in one direction a dimension roughly between \\(1\\ \\rm{nm}\\) and \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\), or that in a system discontinuities are found at distances of that order.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01172 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01172 "current"^^xsd:string)
Declaration(Class(goldbook:C01173))
AnnotationAssertion(rdfs:label goldbook:C01173 "colloidal carbon")
AnnotationAssertion(dcterms:description goldbook:C01173 "A particulate carbon with particle sizes below ca.\\(1000\\ \\rm{nm}\\) in at least one dimension.")
AnnotationAssertion(rdfs:comment goldbook:C01173 "Colloidal carbon exists in several morphologically distinct forms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01173 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:C01173 goldbook:P04433)
AnnotationAssertion(mito:isMentionedBy goldbook:C01173 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01173 "current"^^xsd:string)
Declaration(Class(goldbook:C01174))
AnnotationAssertion(rdfs:label goldbook:C01174 "colloidal dispersion")
AnnotationAssertion(dcterms:description goldbook:C01174 "A system in which particles of colloidal size of any nature (e.g. solid, liquid or gas) are dispersed in a continuous phase of a different composition (or state). The name dispersed phase for the particles should be used only if they have essentially the properties of a bulk phase of the same composition.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01174 goldbook:C01172)
AnnotationAssertion(mito:isMentionedBy goldbook:C01174 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01174 "current"^^xsd:string)
Declaration(Class(goldbook:C01175))
AnnotationAssertion(rdfs:label goldbook:C01175 "colloidal electrolyte")
AnnotationAssertion(dcterms:description goldbook:C01175 "An electrolyte which gives ions of which at least one is of colloidal size. This term therefore includes hydrophobic sols, ionic association colloids, and polyelectrolytes.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01175 goldbook:A00472)
AnnotationAssertion(rdfs:seeAlso goldbook:C01175 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:C01175 goldbook:C01171)
AnnotationAssertion(rdfs:seeAlso goldbook:C01175 goldbook:S05727)
AnnotationAssertion(mito:isMentionedBy goldbook:C01175 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01175 "current"^^xsd:string)
Declaration(Class(goldbook:C01176))
AnnotationAssertion(rdfs:label goldbook:C01176 "colloidally stable")
AnnotationAssertion(dcterms:description goldbook:C01176 "Particles which do not aggregate at a significant rate: the precise connotation depends on the type of aggregation under consideration. For example, a concentrated paint is called stable by some people because oil and pigment do not separate out at a measurable rate, and unstable by others because the pigment particles aggregate into a continuous network.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01176 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:C01176 goldbook:S05900)
AnnotationAssertion(rdfs:seeAlso goldbook:C01176 goldbook:U06569)
AnnotationAssertion(mito:isMentionedBy goldbook:C01176 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01176 "current"^^xsd:string)
Declaration(Class(goldbook:C01177))
AnnotationAssertion(rdfs:label goldbook:C01177 "colloidal suspension")
AnnotationAssertion(dcterms:description goldbook:C01177 "A suspension in which the size of the particles lies in the colloidal range.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01177 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:C01177 goldbook:S06198)
AnnotationAssertion(mito:isMentionedBy goldbook:C01177 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01177 "current"^^xsd:string)
Declaration(Class(goldbook:C01178))
AnnotationAssertion(rdfs:label goldbook:C01178 "colloid osmotic pressure")
AnnotationAssertion(dcterms:description goldbook:C01178 "The pressure difference which has to be established between a colloidal system and its equilibrium liquid to prevent material transfer between the two phases when they are separated by a membrane, permeable to all components of the system, except the colloidal ones.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01178 "Donnan pressure")
AnnotationAssertion(rdfs:seeAlso goldbook:C01178 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:C01178 goldbook:MT06878)
AnnotationAssertion(mito:isMentionedBy goldbook:C01178 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01178 "current"^^xsd:string)
Declaration(Class(goldbook:C01179))
AnnotationAssertion(rdfs:label goldbook:C01179 "colorimeter")
AnnotationAssertion(dcterms:description goldbook:C01179 "An instrument used for colour measurement based on optical comparison with standard colours.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01179 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01179 "current"^^xsd:string)
Declaration(Class(goldbook:C01181))
AnnotationAssertion(rdfs:label goldbook:C01181 "column")
AnnotationAssertion(dcterms:description goldbook:C01181 "The tube and the stationary phase contained within, through which the mobile phase passes.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01181 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01181 "current"^^xsd:string)
Declaration(Class(goldbook:C01182))
AnnotationAssertion(rdfs:label goldbook:C01182 "column chromatography")
AnnotationAssertion(dcterms:description goldbook:C01182 "A separation technique in which the stationary bed is within a tube. The particles of the solid stationary phase or support coated with a liquid stationary phase may fill the whole inside volume of the tube (packed column) or be concentrated on or along the inside tube wall leaving an open, unrestricted path for the mobile phase in the middle part of the tube (open-tubular column).")
AnnotationAssertion(mito:isMentionedBy goldbook:C01182 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01182 "current"^^xsd:string)
Declaration(Class(goldbook:C01183))
AnnotationAssertion(rdfs:label goldbook:C01183 "column volume")
AnnotationAssertion(dcterms:description goldbook:C01183 "The geometric volume of the part of the tube that contains the packing: \\[V_{\\rm{c}} = A_{\\rm{c}}\\ L\\] where \\(A_{\\rm{c}}\\) is the internal cross-sectional area of the tube and \\(L\\) the length of the packed part of the column. In the case of wall-coated open-tubular columns the column volume corresponds to the geometric volume of the whole tube having a liquid or a solid stationary phase on its wall.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01183 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01183 "current"^^xsd:string)
Declaration(Class(goldbook:C01184))
AnnotationAssertion(rdfs:label goldbook:C01184 "combination electrode")
AnnotationAssertion(dcterms:description goldbook:C01184 "An ion-selective electrode and an external reference electrode combined in a single unit, thereby avoiding the need for a separate external reference electrode.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01184 goldbook:I03244)
AnnotationAssertion(rdfs:seeAlso goldbook:C01184 goldbook:R05229)
AnnotationAssertion(mito:isMentionedBy goldbook:C01184 doi:10.1351/pac199466122527)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01184 "current"^^xsd:string)
Declaration(Class(goldbook:C01185))
AnnotationAssertion(rdfs:label goldbook:C01185 "combined sample")
AnnotationAssertion(dcterms:description goldbook:C01185 "A sample obtained by removing specific fractions by separation or selection techniques (e.g. heavy liquid, magnetic, sieving, etc.), analysing the fractions separately, and combining the results mathematically. When not combined, the sample is a modified sample. This term should not be confused with composite sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01185 goldbook:C01212)
AnnotationAssertion(rdfs:seeAlso goldbook:C01185 goldbook:M03964)
AnnotationAssertion(mito:isMentionedBy goldbook:C01185 doi:10.1351/pac199062061193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01185 "current"^^xsd:string)
Declaration(Class(goldbook:C01186))
AnnotationAssertion(rdfs:label goldbook:C01186 "comb macromolecule")
AnnotationAssertion(dcterms:description goldbook:C01186 "A macromolecule comprising a main chain with multiple trifunctional branch points from each of which a linear side-chain emanates.")
AnnotationAssertion(rdfs:comment goldbook:C01186 "If the subchains between the branch points of the main chain and the terminal subchains of the main chain are identical with respect to constitution and degree of polymerization, and the side chains are identical with respect to constitution and degree of polymerization the macromolecule is termed a regular comb macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C01186 "If at least some of the branch points are of functionality greater than three, the macromolecule may be termed a brush macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01186 goldbook:B00728)
AnnotationAssertion(rdfs:seeAlso goldbook:C01186 goldbook:C01282)
AnnotationAssertion(rdfs:seeAlso goldbook:C01186 goldbook:D01569)
AnnotationAssertion(rdfs:seeAlso goldbook:C01186 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:C01186 goldbook:M03694)
AnnotationAssertion(rdfs:seeAlso goldbook:C01186 goldbook:B00720)
AnnotationAssertion(mito:isMentionedBy goldbook:C01186 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01186 "current"^^xsd:string)
Declaration(Class(goldbook:C01187))
AnnotationAssertion(rdfs:label goldbook:C01187 "comb polymer")
AnnotationAssertion(dcterms:description goldbook:C01187 "A polymer composed of comb macromolecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01187 goldbook:C01186)
AnnotationAssertion(rdfs:seeAlso goldbook:C01187 goldbook:R05249)
AnnotationAssertion(mito:isMentionedBy goldbook:C01187 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01187 "current"^^xsd:string)
Declaration(Class(goldbook:C01188))
AnnotationAssertion(rdfs:label goldbook:C01188 "combustion gas")
AnnotationAssertion(dcterms:description goldbook:C01188 "A gas or vapour produced in furnaces, combustion chambers or in open burning.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01188 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01188 "current"^^xsd:string)
Declaration(Class(goldbook:C01189))
AnnotationAssertion(rdfs:label goldbook:C01189 "commensurate–incommensurate transition")
AnnotationAssertion(dcterms:description goldbook:C01189 "A transition between two states having magnetic or crystallographic structures with a basic lattice and an imposed super-periodicity. In the commensurate (lock-in) state this super-periodicity is a simple rational multiple of the basic unit cell. In the incommensurate state the ratio of the super-periodicity repeat distance to the basic lattice repeat distance is irrational and may show continuous variation with variation in some degree of freedom (e.g. temperature, pressure, composition) of the system.")
AnnotationAssertion(rdfs:comment goldbook:C01189 "A commensurate–incommensurate transition also occurs in liquid-crystal systems where there is an incommensurability in the packing of dimers in relation to monomers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C01189 goldbook:U06562)
AnnotationAssertion(mito:isMentionedBy goldbook:C01189 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01189 "current"^^xsd:string)
Declaration(Class(goldbook:C01191))
AnnotationAssertion(rdfs:label goldbook:C01191 "common-ion effect")
AnnotationAssertion(dcterms:description goldbook:C01191 "A reduction in the rate of reaction of certain reactions of a substrate RX in solution [by a path that involves a pre-equilibrium with formation of $\\ce{R^{+}}$ (or $\\ce{R^{−}}$) ions as reaction intermediates] caused by the addition to the reaction mixture of an electrolyte solute containing the 'common ion' $\\ce{X^{−}}$ (or $\\ce{X+}$). For example, the rate of solvolysis of diphenylmethyl chloride in acetone-water is reduced by the addition of salts of the common ion $\\ce{Cl^{−}}$ which causes a decrease in the quasi-equilibrium concentration of the diphenylmethyl cation in the scheme:   This phenomenon is a direct consequence of the mass-law effect on ionization equilibria in electrolytic solution. More generally, the common-ion effect is the influence of the 'common ion' on the reactivity due to the shift of the dissociation equilibrium. It may also lead to an enhancement of the rate of reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:C00907)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:D01801)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:I03183)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:M03725)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:P04810)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:Q04999)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:R05156)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:S05762)
AnnotationAssertion(rdfs:seeAlso goldbook:C01191 goldbook:S06082)
AnnotationAssertion(mito:isMentionedBy goldbook:C01191 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01191 "current"^^xsd:string)
Declaration(Class(goldbook:C01192))
AnnotationAssertion(rdfs:label goldbook:C01192 "communities")
AnnotationAssertion(dcterms:description goldbook:C01192 "Naturally occuring groups of different (micro)organisms inhabiting a common environment, interacting with each other, especially through food relationships and relatively independent of other groups. Communities may be of varying sizes, and larger communities may contain smaller ones.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01192 "consortia")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01192 "syntrophic associations")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01192 "synergistic associations")
AnnotationAssertion(rdfs:seeAlso goldbook:C01192 goldbook:M03894)
AnnotationAssertion(mito:isMentionedBy goldbook:C01192 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01192 "current"^^xsd:string)
Declaration(Class(goldbook:C01194))
AnnotationAssertion(rdfs:label goldbook:C01194 "comparator")
AnnotationAssertion(dcterms:description goldbook:C01194 "A known amount of element that is simultaneously irradiated with the test portion in the context of activation analysis. If one comparator is used (single comparator method), it is essentially identical to a flux monitor (except that this term is not necessarily linked to activation analysis).")
AnnotationAssertion(rdfs:seeAlso goldbook:C01194 goldbook:A00093)
AnnotationAssertion(rdfs:seeAlso goldbook:C01194 goldbook:A00096)
AnnotationAssertion(rdfs:seeAlso goldbook:C01194 goldbook:T06284)
AnnotationAssertion(mito:isMentionedBy goldbook:C01194 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01194 "current"^^xsd:string)
Declaration(Class(goldbook:C01195))
AnnotationAssertion(rdfs:label goldbook:C01195 "compensation")
AnnotationAssertion(dcterms:description goldbook:C01195 "For the process: \\[k = A\\ \\rm{e}^{\\frac{-E}{R\\ T}}\\] where \\(k\\) is a rate constant, \\(A\\) the frequency factor and \\(E\\) the activation energy, \\(A\\) and \\(E\\) sometimes exhibit compensation, i.e. they change in the same direction with change in catalyst for a given reaction or with change in reaction for a given catalyst.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01195 goldbook:A00102)
AnnotationAssertion(rdfs:seeAlso goldbook:C01195 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:C01195 goldbook:O04322)
AnnotationAssertion(mito:isMentionedBy goldbook:C01195 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01195 "current"^^xsd:string)
Declaration(Class(goldbook:C01196))
AnnotationAssertion(rdfs:label goldbook:C01196 "compensation")
AnnotationAssertion(dcterms:description goldbook:C01196 "For internal compensation, see compound.See: external compensation")
AnnotationAssertion(rdfs:seeAlso goldbook:C01196 goldbook:M03839)
AnnotationAssertion(rdfs:seeAlso goldbook:C01196 goldbook:E02284)
AnnotationAssertion(rdfs:seeAlso goldbook:C01196 goldbook:I03101)
AnnotationAssertion(mito:isMentionedBy goldbook:C01196 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01196 "current"^^xsd:string)
Declaration(Class(goldbook:C01197))
AnnotationAssertion(rdfs:label goldbook:C01197 "compensation effect")
AnnotationAssertion(dcterms:description goldbook:C01197 "In a considerable number of cases plots of \\(T\\ \\Delta ^{\\ddagger }S\\) vs. \\(\\Delta ^{\\ddagger}H\\), for a series of reactions, e.g. for a reaction in a range of different solvents, are straight lines of approximately unit slope. Therefore, the terms \\(\\Delta ^{\\ddagger}H\\) and \\(T\\ \\Delta ^{\\ddagger }S\\) in the expression partially compensate, and \\[\\Delta ^{\\ddagger}G = \\Delta ^{\\ddagger}H - T\\ \\Delta ^{\\ddagger}S\\] often is a much simpler function of solvent (or other) variation than \\(\\Delta ^{\\ddagger}H\\) or \\(T\\ \\Delta ^{\\ddagger }S\\) separately.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01197 goldbook:I03285)
AnnotationAssertion(mito:isMentionedBy goldbook:C01197 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01197 "current"^^xsd:string)
Declaration(Class(goldbook:C01199))
AnnotationAssertion(rdfs:label goldbook:C01199 "competitive binding assay")
AnnotationAssertion(dcterms:description goldbook:C01199 "An assay based on the competition between a labelled and an unlabelled ligand in the reaction with a receptor binding agent (e.g. antibody, receptor, transport protein).")
AnnotationAssertion(rdfs:seeAlso goldbook:C01199 goldbook:A00384)
AnnotationAssertion(rdfs:seeAlso goldbook:C01199 goldbook:A00470)
AnnotationAssertion(rdfs:seeAlso goldbook:C01199 goldbook:C01198)
AnnotationAssertion(rdfs:seeAlso goldbook:C01199 goldbook:L03424)
