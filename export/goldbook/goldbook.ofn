Declaration(Class(goldbook:A00222))
AnnotationAssertion(rdfs:label goldbook:A00222 "alkanes")
AnnotationAssertion(dcterms:description goldbook:A00222 "Acyclic branched or unbranched hydrocarbons having the general formula $\\ce{C_{n}H_{2n+2}}$, and therefore consisting entirely of hydrogen atoms and saturated carbon atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00222 goldbook:C01497)
AnnotationAssertion(rdfs:seeAlso goldbook:A00222 goldbook:H02889)
AnnotationAssertion(mito:isMentionedBy goldbook:A00222 doi:10.1351/pac199567081307)
