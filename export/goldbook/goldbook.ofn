Declaration(Class(goldbook:M04018))
AnnotationAssertion(rdfs:label goldbook:M04018 "monomeric unit")
AnnotationAssertion(dcterms:description goldbook:M04018 "The largest constitutional unit contributed by a single monomer molecule to the structure of a macromolecule or oligomer molecule.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:M04018 "monomer unit")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:M04018 "mer")
AnnotationAssertion(rdfs:comment goldbook:M04018 "The largest constitutional unit contributed by a single monomer molecule to the structure of a macromolecule or oligomer molecule may be described as either monomeric, or by monomer used adjectivally."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M04018 goldbook:C01288)
AnnotationAssertion(rdfs:seeAlso goldbook:M04018 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:M04018 goldbook:M04017)
AnnotationAssertion(rdfs:seeAlso goldbook:M04018 goldbook:M04019)
AnnotationAssertion(rdfs:seeAlso goldbook:M04018 goldbook:O04286)
