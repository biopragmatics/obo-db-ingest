property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:C01002
name: charge-transfer adsorption
def: "Oxidative or reductive chemisorption where 'reductive' and 'oxidative' refer to electron gain or loss on species in the solid. In simple cases it is non-dissociative\, i.e. there is a mere transfer of charge between adsorptive and adsorbent in forming the adsorbate."
property_value: mito:isMentionedBy doi:10.1351/pac197646010071
property_value: hasStatus "current" xsd:string
