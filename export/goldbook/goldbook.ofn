AnnotationAssertion(rdfs:label goldbook:15618 "cumulative median lethal dose")
AnnotationAssertion(dcterms:description goldbook:15618 "Estimate of the total administered amount of a substance that is associated with the death of half a population of animals when the substance is administered repeatedly in doses which are generally fractions of the median lethal dose.")
AnnotationAssertion(mito:isMentionedBy goldbook:15618 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15618 "current"^^xsd:string)
Declaration(Class(goldbook:15619))
AnnotationAssertion(rdfs:label goldbook:15619 "cumulative risk")
AnnotationAssertion(dcterms:description goldbook:15619 "Probability of a common harmful effect associated with concurrent exposure by all relevant pathways and routes of exposure to a group of substances that share a common chemical mechanism of toxicity. Total probability of a harmful effect over time.")
AnnotationAssertion(mito:isMentionedBy goldbook:15619 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15619 "current"^^xsd:string)
Declaration(Class(goldbook:15620))
