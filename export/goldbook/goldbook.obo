consider: goldbook:S06198

[Term]
id: goldbook:S05534
name: sedimentation
def: "In the atmospheric sciences\, the process of removal of an air borne particle from the atmosphere due to the effect of gravity."
property_value: mito:isMentionedBy doi:10.1351/pac199062112167
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:S05535
name: sedimentation coefficient
def: "Velocity of sedimentation divided by the acceleration of the force field \(gravitation or centrifugation\)."
