AnnotationAssertion(rdfs:label goldbook:D01763 "dipyrrins")
AnnotationAssertion(dcterms:description goldbook:D01763 "Compounds containing two pyrrole rings linked through a methine, $\\ce{–CH=}$, group.")
AnnotationAssertion(mito:isMentionedBy goldbook:D01763 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01763 "current"^^xsd:string)
Declaration(Class(goldbook:D01765))
AnnotationAssertion(rdfs:label goldbook:D01765 "diradicals")
AnnotationAssertion(dcterms:description goldbook:D01765 "Molecular species having two unpaired electrons, in which at least two different electronic states with different multiplicities [electron-paired (singlet state) or electron-unpaired (triplet state)] can be identified, e.g. $\\ce{H2C^{.}–CH2–C^{.}H2}$ propane-1,3-diyl (trimethylene).")
AnnotationAssertion(rdfs:seeAlso goldbook:D01765 goldbook:B00671)
AnnotationAssertion(rdfs:seeAlso goldbook:D01765 goldbook:S05699)
