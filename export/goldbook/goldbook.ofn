AnnotationAssertion(dcterms:description goldbook:12076 "Procedure to assess psychomotor speed in which a test subject is presented at irregular intervals with a visual stimulus, such as a coloured dot on a screen, and is asked to press a button immediately after noticing the stimulus.")
AnnotationAssertion(rdfs:comment goldbook:12076 "Premature or untimely late reactions should be minimized during an initial practise phase."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12076 "Many variations of the test exist."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12076 goldbook:11925)
AnnotationAssertion(mito:isMentionedBy goldbook:12076 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12076 "current"^^xsd:string)
