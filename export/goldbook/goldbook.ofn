AnnotationAssertion(mito:isMentionedBy goldbook:Z06752 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Z06752 "current"^^xsd:string)
Declaration(Class(goldbook:Z06753))
AnnotationAssertion(rdfs:label goldbook:Z06753 "zygote")
AnnotationAssertion(dcterms:description goldbook:Z06753 "The cell obtained as a result of complete or partial fusion of meiotically (cf. meiosis) produced cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:Z06753 goldbook:F02563)
AnnotationAssertion(rdfs:seeAlso goldbook:Z06753 goldbook:M03818)
AnnotationAssertion(mito:isMentionedBy goldbook:Z06753 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Z06753 "current"^^xsd:string)
Declaration(Class(goldbook:ZT07132))
AnnotationAssertion(rdfs:label goldbook:ZT07132 "zero differential overlap approximation")
AnnotationAssertion(dcterms:description goldbook:ZT07132 "An approach to the systematic neglect of the small-in-value electron repulsion integrals which is used in a number of approximate self-consistent field molecular orbital schemes. It means that all the products of atomic orbitals \\(\\upchi_{\\upmu} \\upchi_{\\upnu}\\) are set to zero and the overlap integral \\(\\rm{S}_{\\upmu\\upnu} = \\updelta_{\\upmu\\upnu}\\) (where \\(\\updelta_{\\upmu\\upnu}\\) is the Kronecker delta). The ZDO approximation greatly simplifies the computation of wavefunctions by eliminating many of two-electron integrals. At the ZDO approximation all three- and four-centered integrals vanish.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:ZT07132 "ZDO")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:ZT07132 "ZDO approximation")
AnnotationAssertion(rdfs:seeAlso goldbook:ZT07132 goldbook:M03996)
AnnotationAssertion(rdfs:seeAlso goldbook:ZT07132 goldbook:O04357)
AnnotationAssertion(mito:isMentionedBy goldbook:ZT07132 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ZT07132 "current"^^xsd:string)
Declaration(Class(goldbook:ZT07228))
AnnotationAssertion(rdfs:label goldbook:ZT07228 "zwitterionic polymer")
AnnotationAssertion(dcterms:description goldbook:ZT07228 "Ampholytic polymer containing ionic groups of opposite sign, commonly on the same pendant groups.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:ZT07228 "polymeric inner salt")
AnnotationAssertion(rdfs:seeAlso goldbook:ZT07228 goldbook:AT07196)
AnnotationAssertion(mito:isMentionedBy goldbook:ZT07228 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:ZT07228 "current"^^xsd:string)
Declaration(Class(goldbook:ZT07501))
AnnotationAssertion(rdfs:label goldbook:ZT07501 "$\\pu{\\rm{Z}_{50}}$")
AnnotationAssertion(dcterms:description goldbook:ZT07501 "Number of cycles required to reduce by 50% the initial absorbance of the coloured form of a photochromic compound at a specific wavelength.")
AnnotationAssertion(rdfs:seeAlso goldbook:ZT07501 goldbook:A00028)
