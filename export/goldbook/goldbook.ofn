AnnotationAssertion(rdfs:seeAlso goldbook:12055 goldbook:12044)
AnnotationAssertion(mito:isMentionedBy goldbook:12055 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12055 "current"^^xsd:string)
Declaration(Class(goldbook:12056))
AnnotationAssertion(rdfs:label goldbook:12056 "righting test")
AnnotationAssertion(dcterms:description goldbook:12056 "Experimental measurement of an animal’s (usually a rodent’s) ability to land in an upright position at the end of a fall.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12056 "aerial righting test")
AnnotationAssertion(rdfs:comment goldbook:12056 "Imprecise measure of proprioception and motor coordination."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12056 goldbook:11884)
AnnotationAssertion(rdfs:seeAlso goldbook:12056 goldbook:12022)
AnnotationAssertion(rdfs:seeAlso goldbook:12056 goldbook:12055)
AnnotationAssertion(mito:isMentionedBy goldbook:12056 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12056 "current"^^xsd:string)
Declaration(Class(goldbook:12057))
AnnotationAssertion(rdfs:label goldbook:12057 "surface righting test")
AnnotationAssertion(dcterms:description goldbook:12057 "Test animal is placed on its back and the time to retain an uprate position with four paws in contact with the surface is measured.")
AnnotationAssertion(rdfs:comment goldbook:12057 "This may be used to study development."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:12057 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12057 "current"^^xsd:string)
