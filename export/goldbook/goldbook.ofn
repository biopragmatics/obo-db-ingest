Declaration(Class(goldbook:10923))
AnnotationAssertion(rdfs:label goldbook:10923 "median teratogenic concentration")
AnnotationAssertion(dcterms:description goldbook:10923 "Median concentration resulting in developmental malformations for \\(\\pu{50\\%}\\) of exposed test animals within a predetermined time, e.g., \\(\\pu{96 h}\\).")
Declaration(Class(goldbook:10924))
AnnotationAssertion(rdfs:label goldbook:10924 "mediastinum")
AnnotationAssertion(dcterms:description goldbook:10924 "Region in the middle of the thorax between the two lungs, containing the regional vessels, trachea, esophagus, bronchi, lymph nodes, and heart.")
Declaration(Class(goldbook:10925))
AnnotationAssertion(rdfs:label goldbook:10925 "medulla")
AnnotationAssertion(dcterms:description goldbook:10925 """[medulla oblongata] Lower part of the brain stem continuous with the spinal cord, containing neural centers regulating the autonomic functions of breathing, heart rate, and blood pressure.
Middle (central) part of an organ, as in adrenal medulla, renal medulla, or the medulla of a lymph node.""")
Declaration(Class(goldbook:10926))
AnnotationAssertion(rdfs:label goldbook:10926 "megacolon")
AnnotationAssertion(dcterms:description goldbook:10926 "Condition of extreme dilation of the colon that can be congenital (as in Hirschsprung disease) or acquired (as when children refuse to defecate).")
Declaration(Class(goldbook:10927))
AnnotationAssertion(rdfs:label goldbook:10927 "megadactyly")
AnnotationAssertion(dcterms:description goldbook:10927 "Disorder characterized by an abnormally large fingers and (or) toes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10927 "macrodactylia")
Declaration(Class(goldbook:10928))
AnnotationAssertion(rdfs:label goldbook:10928 "menarche")
AnnotationAssertion(dcterms:description goldbook:10928 "First menstrual cycle of a woman.")
Declaration(Class(goldbook:10929))
AnnotationAssertion(rdfs:label goldbook:10929 "Mendelian gene")
AnnotationAssertion(dcterms:description goldbook:10929 "Gene located in a chromosome that obeys the laws of Mendelian inheritance.")
Declaration(Class(goldbook:10930))
AnnotationAssertion(rdfs:label goldbook:10930 "Mendelian inheritance")
AnnotationAssertion(dcterms:description goldbook:10930 "Inheritance in which stable and indivisible characteristics are controlled entirely or overwhelmingly by a single genetic locus and transmitted over many generations.")
Declaration(Class(goldbook:10931))
AnnotationAssertion(rdfs:label goldbook:10931 "Mendelian trait")
AnnotationAssertion(dcterms:description goldbook:10931 "Phenotype that shows a pattern of Mendelian inheritance.")
Declaration(Class(goldbook:10932))
AnnotationAssertion(rdfs:label goldbook:10932 "meninx")
AnnotationAssertion(dcterms:description goldbook:10932 "Any of the three membranes (the dura mater, arachnoid, and pia mater) that line the skull and vertebral canal and enclose the brain and spinal cord.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10932 "meninges")
Declaration(Class(goldbook:10933))
AnnotationAssertion(rdfs:label goldbook:10933 "meningocele")
AnnotationAssertion(dcterms:description goldbook:10933 "Herniation of the membranes of the brain or spinal cord (see meninx) through a defect in the cranium or spinal column.")
Declaration(Class(goldbook:10934))
AnnotationAssertion(rdfs:label goldbook:10934 "meningomyelocele")
AnnotationAssertion(dcterms:description goldbook:10934 "Birth defect following failure of the neural tube to close, resulting in protrusion of a sac of nerve tissue and its covering membranes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10934 "meningoencephalocele")
Declaration(Class(goldbook:10935))
AnnotationAssertion(rdfs:label goldbook:10935 "menopause")
AnnotationAssertion(dcterms:description goldbook:10935 "Cessation of reproductive capability in a woman, marked by declining ovarian function and an end to menses.")
Declaration(Class(goldbook:10936))
AnnotationAssertion(rdfs:label goldbook:10936 "menstrual cycle")
AnnotationAssertion(dcterms:description goldbook:10936 "The period, normally lasting \\(\\pu{28 days}\\) in the human female, during which an ovum matures, is ovulated, and enters the uterus through the Fallopian tubes. If fertilization occurs, the cycle is interrupted by pregnancy; otherwise, the cycle ends with menstruation.")
Declaration(Class(goldbook:10937))
AnnotationAssertion(rdfs:label goldbook:10937 "menstruation")
AnnotationAssertion(dcterms:description goldbook:10937 "Cyclic endometrial shedding and discharge of a bloody fluid from the uterus during the menstrual cycle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10937 "menses")
Declaration(Class(goldbook:10938))
AnnotationAssertion(rdfs:label goldbook:10938 "meromelia")
AnnotationAssertion(dcterms:description goldbook:10938 "Congenital absence of a part of a limb, resulting in a shrunken and deformed extremity.")
Declaration(Class(goldbook:10939))
AnnotationAssertion(rdfs:label goldbook:10939 "mesectoderm")
AnnotationAssertion(dcterms:description goldbook:10939 "Embryonic migratory cells derived from the neural crest of the head that contribute to the formation of the meninges (see meninx) and become pigment cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10939 "ectomesenchyme")
Declaration(Class(goldbook:10940))
AnnotationAssertion(rdfs:label goldbook:10940 "mesencephalon")
AnnotationAssertion(dcterms:description goldbook:10940 "Part of the vertebrate brain that develops from the middle section of the embryonic neural tube.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10940 "midbrain")
Declaration(Class(goldbook:10941))
AnnotationAssertion(rdfs:label goldbook:10941 "mesenchymal-to-epithelial transition")
AnnotationAssertion(dcterms:description goldbook:10941 "Process in which motile mesenchymal cells undergo a development to planar, polarized fixed cells, forming epithelia.")
Declaration(Class(goldbook:10942))
AnnotationAssertion(rdfs:label goldbook:10942 "mesenchyme")
AnnotationAssertion(dcterms:description goldbook:10942 "Meshwork of embryonic connective tissue in the mesoderm, from which are formed the bone, muscular, and connective tissues of the body and also the urogenital system, blood vessels, and lymph vessels.")
Declaration(Class(goldbook:10943))
AnnotationAssertion(rdfs:label goldbook:10943 "mesentery")
AnnotationAssertion(dcterms:description goldbook:10943 "Membranous sheet attaching various organs to the body wall, especially the peritoneal fold attaching the intestine to the dorsal body wall.")
Declaration(Class(goldbook:10944))
AnnotationAssertion(rdfs:label goldbook:10944 "mesoderm")
AnnotationAssertion(dcterms:description goldbook:10944 """Middle layer of cells in the embryo, lying between the ectoderm and the endoderm. It includes the following tissues:
Lateral mesoderm: peripheral portion of intraembryonic mesoderm.
Intermediate mesoderm: origin of the nephrogenic cord.
Parietal (somatic) mesoderm: cell source for the formation of the lateral and ventral body wall.
Visceral (branchial, pharyngeal, splanchnic) mesoderm: inner layer of lateral mesoderm that, with the endoderm, provides the cells from which the gut and lungs and their coverings arise.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10944 "embryonic mesoderm")
Declaration(Class(goldbook:10945))
AnnotationAssertion(rdfs:label goldbook:10945 "mesogastrium")
AnnotationAssertion(dcterms:description goldbook:10945 "Part of the embryonic mesentery that is attached to the early stomach.")
Declaration(Class(goldbook:10946))
AnnotationAssertion(rdfs:label goldbook:10946 "mesonephric duct")
AnnotationAssertion(dcterms:description goldbook:10946 "Embryonic duct of the mesonephros, which in the male becomes the vas deferens and in the female becomes vestigial.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10946 "Wolffian duct")
Declaration(Class(goldbook:10947))
AnnotationAssertion(rdfs:label goldbook:10947 "mesonephros")
AnnotationAssertion(dcterms:description goldbook:10947 "Middle part of the embryonic kidney in vertebrates, becoming the adult kidney in fishes and amphibians and the epididymis in reptiles, birds, and mammals.")
Declaration(Class(goldbook:10948))
AnnotationAssertion(rdfs:label goldbook:10948 "mesothelium")
AnnotationAssertion(dcterms:description goldbook:10948 "Single layer of flattened cells forming an epithelium that lines serous cavities such as the peritoneum, pleura, and pericardium.")
Declaration(Class(goldbook:10949))
AnnotationAssertion(rdfs:label goldbook:10949 "metabologen")
AnnotationAssertion(dcterms:description goldbook:10949 "Morphogen, including bone morphogenetic protein, that affects metabolism and homeostasis.")
Declaration(Class(goldbook:10950))
AnnotationAssertion(rdfs:label goldbook:10950 "metallothionein")
AnnotationAssertion(dcterms:description goldbook:10950 "One of a family of low-molecular mass proteins that binds metals such as zinc, copper, cadmium and mercury.")
Declaration(Class(goldbook:10951))
AnnotationAssertion(rdfs:label goldbook:10951 "metanephros")
AnnotationAssertion(dcterms:description goldbook:10951 "Primordium of the permanent kidney, developing later than, and caudal to, the mesonephros.")
Declaration(Class(goldbook:10952))
AnnotationAssertion(rdfs:label goldbook:10952 "metaphase")
AnnotationAssertion(dcterms:description goldbook:10952 "Stage of mitosis or meiosis in which the chromosomes become aligned on the equatorial plate of the cell, separating the centromeres.")
Declaration(Class(goldbook:10953))
