AnnotationAssertion(obo:goldbook#hasStatus goldbook:13168 "current"^^xsd:string)
Declaration(Class(goldbook:13169))
AnnotationAssertion(rdfs:label goldbook:13169 "gene rearrangement")
AnnotationAssertion(dcterms:description goldbook:13169 "Structural alteration in a chromosome that changes the order of its genetic loci, occurring by DNA recombination, e.g., during development or in some cancers.")
AnnotationAssertion(rdfs:comment goldbook:13169 "In immunology, it refers to recombination of gene segments in immunoglobulin (Ig) and T-cell receptor (TCR) loci to produce a functional variable (V) region sequence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13169 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13169 goldbook:13303)
AnnotationAssertion(rdfs:seeAlso goldbook:13169 goldbook:13773)
