[Term]
id: goldbook:12726
name: site-directed mutagenesis
def: "Molecular biology technique in which mutations are created at one or more defined sites in a DNA molecule."
comment: "Typically used in molecular target validation and to determine whether specific amino acids are involved at ligand or substrate interaction sites."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-11-23
property_value: hasStatus "current" xsd:string
