property_value: hasStatus "current" xsd:string
consider: goldbook:09495
consider: goldbook:09564

[Term]
id: goldbook:09482
name: dry-etch resistance
def: "Facility of an exposed resist to withstand etching conditions\, usually a plasma\, determined in comparison to a reference standard."
comment: "Plasma may be oxygen or halogen-based."
synonym: "etch resistance" []
property_value: mito:isMentionedBy doi:10.1515/pac-2018-1215
property_value: hasStatus "current" xsd:string
consider: goldbook:09564

[Term]
id: goldbook:09483
name: dual-tone resist
def: "Photoresist capable of being processed in either positive tone \(aqueous base development\) or negative tone \(organic solvent development\)."
property_value: mito:isMentionedBy doi:10.1515/pac-2018-1215
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09484
name: edge acuity
def: "Degree to which the edge of an image appears sharp and precise."
