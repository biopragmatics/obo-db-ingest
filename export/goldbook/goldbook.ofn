AnnotationAssertion(rdfs:label goldbook:10899 "LOD score")
AnnotationAssertion(dcterms:description goldbook:10899 "Ratio of the likelihood of two or more loci remaining together when chromosomes recombine (true linkage) to the likelihood of this occurring by chance alone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10899 "logarithm (base 10) of odds")
AnnotationAssertion(rdfs:comment goldbook:10899 "An LOD score of 3 or greater is considered indicative of genetic linkage with odds greater than \\(\\pu{1000\\!{:}\\! 1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10899 goldbook:10894)
AnnotationAssertion(rdfs:seeAlso goldbook:10899 goldbook:10898)
