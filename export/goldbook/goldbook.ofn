AnnotationAssertion(rdfs:label goldbook:08954 "inifer")
AnnotationAssertion(dcterms:description goldbook:08954 "Substance that combines the properties of an initiator and a reversible chain-transfer agent.")
AnnotationAssertion(rdfs:seeAlso goldbook:08954 goldbook:08947)
AnnotationAssertion(mito:isMentionedBy goldbook:08954 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08954 "current"^^xsd:string)
Declaration(Class(goldbook:08955))
AnnotationAssertion(rdfs:label goldbook:08955 "iniferter")
AnnotationAssertion(dcterms:description goldbook:08955 "Substance that combines the properties of an initiator, a reversible chain-transfer agent and a chain terminator or reversible deactivator.")
AnnotationAssertion(rdfs:comment goldbook:08955 "Some iniferters are also RAFT agents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08955 "A substance that combines the properties of a photoinitiator, a reversible chain-transfer agent and a chain terminator or reversible deactivator is known as a photoiniferter."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08955 goldbook:08968)
