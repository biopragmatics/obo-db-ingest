AnnotationAssertion(rdfs:label goldbook:P04713 "polarization")
AnnotationAssertion(dcterms:description goldbook:P04713 "The difference of the electrode potential from the corrosion potential. The symbol should not be used for polarization.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04713 goldbook:C01357)
AnnotationAssertion(rdfs:seeAlso goldbook:P04713 goldbook:E01956)
