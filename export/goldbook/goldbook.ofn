AnnotationAssertion(obo:goldbook#hasStatus goldbook:11315 "current"^^xsd:string)
Declaration(Class(goldbook:11316))
AnnotationAssertion(rdfs:label goldbook:11316 "Treacher Collins syndrome")
AnnotationAssertion(dcterms:description goldbook:11316 "Congenital deformity characterized by structural abnormalities of the head and face.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11316 "mandibulofacial dysostosis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11316 "Treacher Collins–Franceschetti syndrome")
AnnotationAssertion(rdfs:comment goldbook:11316 "Autosomal dominant mutations have been identified in several genes involved in early development of bone and the tissues of the face, the most frequently implicated being TCOF1."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11316 goldbook:10449)
AnnotationAssertion(rdfs:seeAlso goldbook:11316 goldbook:10552)
AnnotationAssertion(rdfs:seeAlso goldbook:11316 goldbook:10565)
