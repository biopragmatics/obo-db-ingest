AnnotationAssertion(dcterms:description goldbook:10686 "Persistent estrus caused by elevated estrogenic activity, either due to endogenous estrogens (e.g., in polycystic ovary syndrome) or due to exogenous substances.")
Declaration(Class(goldbook:10687))
AnnotationAssertion(rdfs:label goldbook:10687 "euploid")
AnnotationAssertion(dcterms:description goldbook:10687 "Referring to a cell or organism with chromosomes present in an integral multiple of the haploid number.")
Declaration(Class(goldbook:10688))
AnnotationAssertion(rdfs:label goldbook:10688 "eutherian")
AnnotationAssertion(dcterms:description goldbook:10688 "Subclass of mammals having a placenta through which the fetus is nourished.")
Declaration(Class(goldbook:10689))
AnnotationAssertion(rdfs:label goldbook:10689 "eventration")
