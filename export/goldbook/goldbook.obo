[Term]
id: goldbook:S05544
name: segregation
def: "The process that differentiates the composition at an interface or surface from the average or bulk composition."
comment: "The composition of the segregated phases need not be uniform, for example, when concentration gradients are established in the phases."
property_value: mito:isMentionedBy doi:10.1351/pac199466030577
property_value: hasStatus "current" xsd:string
