    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11253">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic epithelial cell that develops into a neuroglial cell.</dcterms:description>
