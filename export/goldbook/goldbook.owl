    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10639">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Seminal duct leading from the testis to the head of the epididymis.</dcterms:description>
