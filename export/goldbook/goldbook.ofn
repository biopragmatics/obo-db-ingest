AnnotationAssertion(rdfs:label goldbook:12132 "tetrad test")
AnnotationAssertion(dcterms:description goldbook:12132 "Battery of tests typically for the effects of cannabinoids in rodents that includes hypomotility assessed by an open field test, catalepsy assessed by the bar test, hypothermia measured by rectal temperature, and analgesia measured by avoidance of heat, e.g., in the tail immersion test.")
AnnotationAssertion(rdfs:seeAlso goldbook:12132 goldbook:11631)
AnnotationAssertion(rdfs:seeAlso goldbook:12132 goldbook:11973)
