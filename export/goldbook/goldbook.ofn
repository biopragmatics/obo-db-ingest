AnnotationAssertion(rdfs:seeAlso goldbook:11793 goldbook:11916)
AnnotationAssertion(rdfs:seeAlso goldbook:11793 goldbook:12109)
AnnotationAssertion(rdfs:seeAlso goldbook:11793 goldbook:12181)
