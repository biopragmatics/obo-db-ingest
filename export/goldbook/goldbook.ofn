Declaration(Class(goldbook:10626))
AnnotationAssertion(rdfs:label goldbook:10626 "dysplasia")
AnnotationAssertion(dcterms:description goldbook:10626 "Abnormal development of an organ or tissue identified by morphological examination.")
Declaration(Class(goldbook:10627))
AnnotationAssertion(rdfs:label goldbook:10627 "dysostosis")
