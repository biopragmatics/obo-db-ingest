AnnotationAssertion(rdfs:label goldbook:12073 "shunt")
AnnotationAssertion(dcterms:description goldbook:12073 "n. Fistula or prosthetic device that diverts fluid from one system to another. vb. To bypass or divert.")
AnnotationAssertion(mito:isMentionedBy goldbook:12073 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12073 "current"^^xsd:string)
Declaration(Class(goldbook:12074))
AnnotationAssertion(rdfs:label goldbook:12074 "sick building syndrome")
AnnotationAssertion(dcterms:description goldbook:12074 "Health effects or loss of a sense of well-being associated, by those who experience it, with time spent in a certain building or room.")
AnnotationAssertion(rdfs:comment goldbook:12074 "Neurological symptoms include headache, irritability, and fatigue."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12074 "Potential causes include poor ventilation and indoor air quality, outgassing of volatile substances from building materials, molds, and ozone build-up from office machines. Psychological factors may play a role."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12074 goldbook:11800)
AnnotationAssertion(mito:isMentionedBy goldbook:12074 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12074 "current"^^xsd:string)
