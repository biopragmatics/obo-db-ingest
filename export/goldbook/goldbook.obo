[Term]
id: goldbook:RT07164
name: reactive polymer
def: "Polymer having reactive functional groups that can undergo chemical transformation under the conditions required for a given reaction or application."
property_value: mito:isMentionedBy doi:10.1351/pac200476040889
property_value: hasStatus "current" xsd:string
