AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12129 "tetanospasmin")
AnnotationAssertion(rdfs:comment goldbook:12129 "Its action is in major part due to suppression of release of the inhibitory neurotransmitter, γ-aminobutyric acid."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12129 goldbook:11952)
