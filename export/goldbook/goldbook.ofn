AnnotationAssertion(mito:isMentionedBy goldbook:N04228 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04228 "current"^^xsd:string)
Declaration(Class(goldbook:N04229))
AnnotationAssertion(rdfs:label goldbook:N04229 "nuclear fission")
AnnotationAssertion(dcterms:description goldbook:N04229 "The division of a nucleus into two or more parts with masses of equal order of magnitude, usually accompanied by the emission of neutrons, gamma radiation and, rarely, small charged nuclear fragments.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04229 goldbook:N04256)
AnnotationAssertion(mito:isMentionedBy goldbook:N04229 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04229 "current"^^xsd:string)
Declaration(Class(goldbook:N04230))
AnnotationAssertion(rdfs:label goldbook:N04230 "nuclear fuel")
AnnotationAssertion(dcterms:description goldbook:N04230 "Material containing fissile nuclides, which when placed in a reactor, enables a chain reaction to be achieved.")
AnnotationAssertion(rdfs:seeAlso goldbook:N04230 goldbook:C00960)
AnnotationAssertion(rdfs:seeAlso goldbook:N04230 goldbook:F02394)
AnnotationAssertion(mito:isMentionedBy goldbook:N04230 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04230 "current"^^xsd:string)
Declaration(Class(goldbook:N04232))
AnnotationAssertion(rdfs:label goldbook:N04232 "nuclear fusion reaction")
AnnotationAssertion(dcterms:description goldbook:N04232 "A reaction between two light nuclei resulting in the production of a nuclear species heavier than either initial nucleus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:N04232 "nuclear fusion")
AnnotationAssertion(rdfs:seeAlso goldbook:N04232 goldbook:N04256)
AnnotationAssertion(mito:isMentionedBy goldbook:N04232 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:N04232 "current"^^xsd:string)
Declaration(Class(goldbook:N04233))
AnnotationAssertion(rdfs:label goldbook:N04233 "nuclear graphite")
AnnotationAssertion(dcterms:description goldbook:N04233 "A polygranular graphite material for use in nuclear reactor cores consisting of graphitic carbon of very high chemical purity. High purity is needed to avoid absorption of low-energy neutrons and the production of undesirable radioactive species.")
AnnotationAssertion(rdfs:comment goldbook:N04233 "Apart from the absence of neutron-absorbing impurities, modern reactor graphites are also characterized by a high degree of graphitization and no preferred bulk orientation. Such properties increase the dimensional stability of the nuclear graphite at high temperatures and in a high flux of neutrons. The term nuclear graphite is often, but incorrectly, used for any graphite material in a nuclear reactor, even if it serves only for structural purposes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:N04233 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:N04233 goldbook:G02687)
AnnotationAssertion(rdfs:seeAlso goldbook:N04233 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:N04233 goldbook:G02691)
AnnotationAssertion(rdfs:seeAlso goldbook:N04233 goldbook:N04116)
AnnotationAssertion(rdfs:seeAlso goldbook:N04233 goldbook:N04239)
