AnnotationAssertion(rdfs:label goldbook:O04332 "ortho amides")
AnnotationAssertion(dcterms:description goldbook:O04332 "Hypothetical compounds having the structure $\\ce{RC(NH2)3}$, and N-substituted derivatives thereof. $\\ce{(R2N)4C}$ are generically included, but such use is obsolescent.")
AnnotationAssertion(mito:isMentionedBy goldbook:O04332 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04332 "current"^^xsd:string)
Declaration(Class(goldbook:O04334))
AnnotationAssertion(rdfs:label goldbook:O04334 "ortho esters")
AnnotationAssertion(dcterms:description goldbook:O04334 "Compounds having the structure $\\ce{RC(OR')3}$ ($\\ce{R'}  eq \\ce{H}$), or the structure $\\ce{C(OR')4}$ ($\\ce{R'}  eq \\ce{H}$), e.g. $\\ce{HC(OCH3)3}$ trimethyl orthoformate, $\\ce{C(OCH3)4}$ tetramethyl orthocarbonate.")
AnnotationAssertion(mito:isMentionedBy goldbook:O04334 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04334 "current"^^xsd:string)
Declaration(Class(goldbook:O04336))
AnnotationAssertion(rdfs:label goldbook:O04336 "orthokinetic aggregation")
AnnotationAssertion(dcterms:description goldbook:O04336 "The rate of aggregation is in general determined by the frequency of collisions and the probability of cohesion during collision. If the collisions are caused by hydrodynamic motions (e.g convection or sedimentation) this is then referred to as orthokinetic aggregation.")
AnnotationAssertion(rdfs:seeAlso goldbook:O04336 goldbook:P04855)
AnnotationAssertion(rdfs:seeAlso goldbook:O04336 goldbook:S05534)
