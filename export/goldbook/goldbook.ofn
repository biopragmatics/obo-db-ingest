Declaration(Class(goldbook:09731))
AnnotationAssertion(rdfs:label goldbook:09731 "telomerase")
AnnotationAssertion(dcterms:description goldbook:09731 "Enzyme that directs the replication of telomeres.")
Declaration(Class(goldbook:09732))
AnnotationAssertion(rdfs:label goldbook:09732 "telomere")
