AnnotationAssertion(rdfs:label goldbook:12072 "shellfish poisoning")
AnnotationAssertion(dcterms:description goldbook:12072 "Illness associated with consumption of seafood contaminated with toxins.")
AnnotationAssertion(rdfs:comment goldbook:12072 "These are primarily associated with consumption of bivalve molluscs such as mussels, clams, oysters and scallops that accumulate toxins produced by microscopic algae such as dinoflagellates and diatoms, and cyanobacteria."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12072 "Four syndromes with overlapping features are recognized. These are amnesic shellfish poisoning, diarrheal shellfish poisoning, neurotoxic shellfish poisoning, and paralytic shellfish poisoning."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12072 goldbook:11579)
