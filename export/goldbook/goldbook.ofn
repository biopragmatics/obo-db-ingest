AnnotationAssertion(rdfs:label goldbook:12183 "Wolfgram protein")
AnnotationAssertion(dcterms:description goldbook:12183 "Acidic proteolipid protein component of central nervous systemmyelin.")
AnnotationAssertion(rdfs:seeAlso goldbook:12183 goldbook:11896)
