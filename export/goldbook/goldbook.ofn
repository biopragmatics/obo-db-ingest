AnnotationAssertion(rdfs:label goldbook:10033 "conservation")
AnnotationAssertion(dcterms:description goldbook:10033 "Set of operations necessary to preserve the examinational properties of an examination standard within stated limits.")
AnnotationAssertion(rdfs:comment goldbook:10033 "Conservation of an examination standard commonly includes periodic verification of predefined nominal properties or examination calibration, storage under suitable conditions, and specified care in use."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10033 goldbook:10021)
