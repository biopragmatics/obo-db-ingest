        <rdfs:label>sulfur diimides</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02891"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.S06128 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.S06128">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sulfonamides in which the S-N bond is part of a ring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>sultams</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.S06114"/>
