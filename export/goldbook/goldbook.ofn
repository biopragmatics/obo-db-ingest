AnnotationAssertion(dcterms:description goldbook:12143 "Substance causing injury to living organisms as a result of physicochemical interactions.")
AnnotationAssertion(mito:isMentionedBy goldbook:12143 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12143 "current"^^xsd:string)
Declaration(Class(goldbook:12144))
AnnotationAssertion(rdfs:label goldbook:12144 "tranquilizer")
AnnotationAssertion(dcterms:description goldbook:12144 "Drug that calms and pacifies with minimal sedating or depressant effects.")
AnnotationAssertion(rdfs:comment goldbook:12144 "A tranquilizer decreases anxiety (i.e., has anxiolytic properties) or agitation without necessarily decreasing awareness or wakefulness. Tranquilizers at higher dose may induce sleep."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12144 "Minor tranquilizers are sedatives, examples of which include benzodiazepines, antihistamines, alcohol, cannabis, and chloral hydrate. Major tranquilizers include antipsychotic drugs and neuroleptics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12144 goldbook:11596)
AnnotationAssertion(rdfs:seeAlso goldbook:12144 goldbook:11598)
AnnotationAssertion(rdfs:seeAlso goldbook:12144 goldbook:11937)
