AnnotationAssertion(rdfs:label goldbook:13955 "conditioning film")
AnnotationAssertion(dcterms:description goldbook:13955 "Film that is rapidly formed on the surface of a solid in contact with a biological system (in the widest sense) that conditions the surface for subsequent interaction with constituents of the biological system.")
Declaration(Class(goldbook:13956))
AnnotationAssertion(rdfs:label goldbook:13956 "ecotoxicity")
AnnotationAssertion(dcterms:description goldbook:13956 "Consequence of adverse effects caused by a substance on the environment and on organisms living in it.")
Declaration(Class(goldbook:13957))
AnnotationAssertion(rdfs:label goldbook:13957 "environmentally degradable polymer")
AnnotationAssertion(dcterms:description goldbook:13957 "Polymer that can be degraded by the action of the environment, through, for example, air, light, heat, or microorganisms.")
Declaration(Class(goldbook:13958))
AnnotationAssertion(rdfs:label goldbook:13958 "environmentally friendly")
AnnotationAssertion(dcterms:description goldbook:13958 "Qualifiers for a substance, device, or process that has minimal deleterious impact on the environment, which is air, water, minerals, living systems, etc.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13958 "ecocompatible")
Declaration(Class(goldbook:13959))
AnnotationAssertion(rdfs:label goldbook:13959 "green polymer")
AnnotationAssertion(dcterms:description goldbook:13959 "Polymer that conforms to the concept of green chemistry.")
Declaration(Class(goldbook:13960))
AnnotationAssertion(rdfs:label goldbook:13960 "life cycle assessment")
AnnotationAssertion(dcterms:description goldbook:13960 "Investigation and valuation of the environmental impacts of a given product or service caused or necessitated by its existence.")
Declaration(Class(goldbook:13961))
AnnotationAssertion(rdfs:label goldbook:13961 "mulching film")
AnnotationAssertion(dcterms:description goldbook:13961 "Polymer film aimed at covering seeded area in order to protect the growing plants from weeds and cold and preserve humidity.")
Declaration(Class(goldbook:13962))
AnnotationAssertion(rdfs:label goldbook:13962 "sustainability")
AnnotationAssertion(dcterms:description goldbook:13962 "Developments that meet the needs of the present without compromising the ability of future generations to meet their needs.")
Declaration(Class(goldbook:13963))
AnnotationAssertion(rdfs:label goldbook:13963 "waste")
AnnotationAssertion(dcterms:description goldbook:13963 "Residue left when a compound or a product reaches the end of its initial usefulness.")
Declaration(Class(goldbook:13964))
AnnotationAssertion(rdfs:label goldbook:13964 "waste management")
AnnotationAssertion(dcterms:description goldbook:13964 "Control of the collection, treatment and disposal of wastes.")
Declaration(Class(goldbook:13965))
AnnotationAssertion(rdfs:label goldbook:13965 "macrocyclic component")
AnnotationAssertion(dcterms:description goldbook:13965 "Molecule that has at least one ring (cycle) large enough to allow it to be threaded onto a linear subchain of another molecule.")
Declaration(Class(goldbook:13966))
AnnotationAssertion(rdfs:label goldbook:13966 "macromolecular component")
AnnotationAssertion(dcterms:description goldbook:13966 "Macromolecule that is part of a rotaxane assembly.")
Declaration(Class(goldbook:13967))
AnnotationAssertion(rdfs:label goldbook:13967 "macromolecular pseudorotaxane")
AnnotationAssertion(dcterms:description goldbook:13967 "Pseudorotaxane, at least one component of which is a macromolecule.")
Declaration(Class(goldbook:13968))
AnnotationAssertion(rdfs:label goldbook:13968 "macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13968 "Rotaxane, at least one component of which is a macromolecule.")
Declaration(Class(goldbook:13969))
AnnotationAssertion(rdfs:label goldbook:13969 "main-chain macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13969 "Macromolecular rotaxane in which rotaxane constitutional units are exclusively located within the main macromolecular chain.")
Declaration(Class(goldbook:13970))
AnnotationAssertion(rdfs:label goldbook:13970 "main-chain rotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13970 "Polymer composed of macromolecular assemblies that are main-chain macromolecular rotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13970 "main-chain polyrotaxane")
Declaration(Class(goldbook:13971))
AnnotationAssertion(rdfs:label goldbook:13971 "molecular shuttle")
AnnotationAssertion(dcterms:description goldbook:13971 "Rotaxane or pseudorotaxane comprising a threading component upon which is threaded a macrocyclic component that, depending on the conditions, can reside at either a specific recognition site on the threading component or away from any recognition site.")
Declaration(Class(goldbook:13972))
AnnotationAssertion(rdfs:label goldbook:13972 "pseudorotaxane")
AnnotationAssertion(dcterms:description goldbook:13972 "Rotaxane-like molecular assembly in which the threading component(s) has(have) ends small enough to permit threading or dethreading of the macrocyclic component(s).")
Declaration(Class(goldbook:13973))
AnnotationAssertion(rdfs:label goldbook:13973 "pseudorotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13973 "Polymer composed of macromolecules that are macromolecular pseudorotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13973 "polypseudorotaxane")
Declaration(Class(goldbook:13974))
AnnotationAssertion(rdfs:label goldbook:13974 "regular macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13974 "Macromolecular rotaxane, the structure of which essentially comprises the repetition of a single constitutional unit of the rotaxane type, referred to as the rotaxane constitutional repeating unit, rot-CRU, with all units connected identically with respect to directional sense.")
Declaration(Class(goldbook:13975))
AnnotationAssertion(rdfs:label goldbook:13975 "rotaxane constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:13975 "Constitutional repeating unit (CRU) that has a rotaxane structure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13975 "rotaxane CRU")
Declaration(Class(goldbook:13976))
AnnotationAssertion(rdfs:label goldbook:13976 "rotaxane constitutional unit")
AnnotationAssertion(dcterms:description goldbook:13976 "Constitutional unit (CU) that has a rotaxane structure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13976 "rotaxane CU")
Declaration(Class(goldbook:13977))
AnnotationAssertion(rdfs:label goldbook:13977 "rotaxane end-unit")
AnnotationAssertion(dcterms:description goldbook:13977 "Constitutional unit of a macromolecular rotaxane consisting of an end-group of its macromolecular component and a complementary threading or macrocyclic component.")
Declaration(Class(goldbook:13978))
AnnotationAssertion(rdfs:label goldbook:13978 "rotaxane monomer")
AnnotationAssertion(dcterms:description goldbook:13978 "Monomer that is a rotaxane.")
Declaration(Class(goldbook:13979))
AnnotationAssertion(rdfs:label goldbook:13979 "rotaxane monomeric unit")
AnnotationAssertion(dcterms:description goldbook:13979 "Monomeric unit (monomer unit, mer) that has a rotaxane structure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13979 "rotaxane monomer unit")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13979 "rotaxane MU")
Declaration(Class(goldbook:13980))
AnnotationAssertion(rdfs:label goldbook:13980 "rotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13980 "Polymer composed of macromolecules that are macromolecular rotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13980 "polymeric rotaxane")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13980 "polyrotaxane")
Declaration(Class(goldbook:13981))
AnnotationAssertion(rdfs:label goldbook:13981 "side-chain macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13981 "Macromolecular rotaxane in which rotaxane constitutional units are located exclusively in side chains of the macromolecule.")
Declaration(Class(goldbook:13982))
AnnotationAssertion(rdfs:label goldbook:13982 "side-chain rotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13982 "Polymer composed of macromolecular assemblies that are side-chain macromolecular rotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13982 "side-chain polyrotaxane")
Declaration(Class(goldbook:13983))
AnnotationAssertion(rdfs:label goldbook:13983 "stopper")
AnnotationAssertion(dcterms:description goldbook:13983 "Group bulky enough to prevent dethreading of a given macrocyclic component from a threading component or its translocation to another linear section of the threading component.")
Declaration(Class(goldbook:13984))
AnnotationAssertion(rdfs:label goldbook:13984 "threadable ring")
AnnotationAssertion(dcterms:description goldbook:13984 "Key part of a macrocyclic component: molecular ring (cycle) large enough to be threaded onto a linear subchain of a threading component.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13984 "threadable cycle")
Declaration(Class(goldbook:13985))
AnnotationAssertion(rdfs:label goldbook:13985 "threading component")
AnnotationAssertion(dcterms:description goldbook:13985 "Molecule with at least one linear section onto which at least one macrocyclic component is threaded.")
Declaration(Class(goldbook:13986))
AnnotationAssertion(rdfs:label goldbook:13986 "absorbed local spectral photon flux density")
AnnotationAssertion(dcterms:description goldbook:13986 "Local value of the spectral photon radiance, or spectral photon flux density, defined for a three-dimensional space, often in terms of napierian properties.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13986 "local spectral photon density absorption rate")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13986 "local volumetric rate of photon absorption")
Declaration(Class(goldbook:13987))
AnnotationAssertion(rdfs:label goldbook:13987 "absorbed local spectral radiance")
AnnotationAssertion(dcterms:description goldbook:13987 "Local value of the spectral radiance, or energy density absorption rate, defined for a three-dimensional space, often in terms of napierian properties.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13987 "local volumetric rate of energy absorption")
Declaration(Class(goldbook:13988))
AnnotationAssertion(rdfs:label goldbook:13988 "absorbed radiant density")
AnnotationAssertion(dcterms:description goldbook:13988 "Monochromatic radiant energy, per time interval (spectral radiance) coming from all directions and absorbed by a system integrated over the whole volume and averaged per volume \\(V\\), \\(\\langle L_{\\lambda}^{\\rm{a}}\\left(t \\right) \\rangle_{V}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13988 "absorbed spectral radiant density")
Declaration(Class(goldbook:13989))
AnnotationAssertion(rdfs:label goldbook:13989 "accumulation layer")
AnnotationAssertion(dcterms:description goldbook:13989 "Subsurface space where the majority carriers accumulate near the surface of a semiconductor because of band bending caused by the surface potential.")
Declaration(Class(goldbook:13990))
AnnotationAssertion(rdfs:label goldbook:13990 "active state")
AnnotationAssertion(dcterms:description goldbook:13990 "Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier that interacts with species at the solid/liquid, liquid/liquid, solid/gas, or liquid/gas interfaces with formation of, e.g., chemisorbed species.")
Declaration(Class(goldbook:13991))
AnnotationAssertion(rdfs:label goldbook:13991 "active state")
AnnotationAssertion(dcterms:description goldbook:13991 "Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier or reactive intermediate that interacts with molecular entities at an interface with the formation of reaction products or intermediates.")
Declaration(Class(goldbook:13992))
AnnotationAssertion(rdfs:label goldbook:13992 "area-related parameters")
AnnotationAssertion(dcterms:description goldbook:13992 "Quantities expressed in terms of 'per area' are denoted as area-related parameters.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13992 "areal parameters")
Declaration(Class(goldbook:13993))
AnnotationAssertion(rdfs:label goldbook:13993 "artificial photosynthesis")
AnnotationAssertion(dcterms:description goldbook:13993 "Photocatalytic production of substances from simple compounds (e.g., \\(\\ce{H2}\\) and \\(\\ce{O2}\\) from water, \\(\\ce{H2}\\) from hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation absorbed by chromophoric systems, often included in microheterogeneous media, mimicking the action of antennae and reaction centres in natural photosynthetic organisms.")
Declaration(Class(goldbook:13994))
AnnotationAssertion(rdfs:label goldbook:13994 "band-to-band recombination")
AnnotationAssertion(dcterms:description goldbook:13994 "Recombination of charge carriers occurring via a one-step electron transition from the conduction band to the valence band in a semiconductor or insulator.")
Declaration(Class(goldbook:13995))
AnnotationAssertion(rdfs:label goldbook:13995 "black body")
AnnotationAssertion(dcterms:description goldbook:13995 "Idealised object absorbing all incident radiant power, regardless of wavelength and transforming it all into heat. No electromagnetic radiation passes through it and none is reflected. A black body is a perfect absorber of radiant energy. Therefore, it is also a perfect emitter of radiation. The wavelength distribution of the radiation of a black body depends only on its temperature and not on its internal nature or structure.")
Declaration(Class(goldbook:13996))
AnnotationAssertion(rdfs:label goldbook:13996 "black-body-like photocatalytic reactor")
AnnotationAssertion(dcterms:description goldbook:13996 "Reactor used to determine quantum yields of photoadsorption and photocatalysed reactions when the catalyst is in the form of a powdered layer (or powder dispersion). The incident photons are (nearly) all absorbed by the catalyst, provided that the dispersion layer is sufficiently thick (or the dispersion is sufficiently concentrated).")
Declaration(Class(goldbook:13997))
AnnotationAssertion(rdfs:label goldbook:13997 "Brunauer–Emmett–Teller surface area")
AnnotationAssertion(dcterms:description goldbook:13997 "Specific surface area (\\(\\pu{m2 kg-1}\\)) determined from the adsorption isotherm of a gas with the help of the Brunauer, Emmett, and Teller model using the conventional value for the molecular cross-section.")
Declaration(Class(goldbook:13998))
AnnotationAssertion(rdfs:label goldbook:13998 "catalyst photoactivation")
AnnotationAssertion(dcterms:description goldbook:13998 "Generation or alteration of the catalytic activity (selectivity) of a substance after its interaction with light.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13998 "catalyst photomodification")
Declaration(Class(goldbook:13999))
AnnotationAssertion(rdfs:label goldbook:13999 "catalytic site")
AnnotationAssertion(dcterms:description goldbook:13999 "Site at which catalysed chemical transformations take place.")
Declaration(Class(goldbook:14000))
AnnotationAssertion(rdfs:label goldbook:14000 "catalysed photochemical reaction")
AnnotationAssertion(dcterms:description goldbook:14000 "Enhancement (alteration) of efficiency of photochemical reactions upon direct excitation of photoactive reactants via an intermediate interaction of these reactants with certain compounds that act as catalysts (promoters) of the appropriate chemical transformations of the reactants.")
Declaration(Class(goldbook:14001))
AnnotationAssertion(rdfs:label goldbook:14001 "Coekelbergs effect")
AnnotationAssertion(dcterms:description goldbook:14001 "Adsorption at the surface of a pre-irradiated adsorbent (the photocatalyst) occurring in the dark, after the irradiation in the presence of the photoadsorbate entities is terminated, i.e., after preliminary photoadsorption.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14001 "Coekelbergs–Solonitsyn effect")
Declaration(Class(goldbook:14002))
AnnotationAssertion(rdfs:label goldbook:14002 "colour centres")
AnnotationAssertion(dcterms:description goldbook:14002 "Lattice defects (typically vacancies) that trap one or more electrons or holes in ionic crystals. They constitute a long-lived deep trap with a low efficiency of trapping of a carrier of the opposite sign.")
Declaration(Class(goldbook:14003))
AnnotationAssertion(rdfs:label goldbook:14003 "deep energy trap")
AnnotationAssertion(dcterms:description goldbook:14003 "Trap defined by an energy level (of trapped carriers) within the bandgap energy of a semiconductor or insulator with an energy difference between it and the conduction band (for electrons) or valence band (for holes) much greater than the energy of thermal excitation of the solid at a given temperature.")
Declaration(Class(goldbook:14004))
AnnotationAssertion(rdfs:label goldbook:14004 "depletion layer")
AnnotationAssertion(dcterms:description goldbook:14004 "Subsurface space where the majority carriers are forced away owing to band bending caused by the surface potential. (i) The subsurface layer of an n-type semiconductor becomes depleted of electrons, which are the majority carriers, as a consequence of upward band bending. (ii) The subsurface layer of a p-type semiconductor becomes enriched by electrons (depleted of holes) as a consequence of downward band bending.")
Declaration(Class(goldbook:14005))
AnnotationAssertion(rdfs:label goldbook:14005 "direct bandgap semiconductor")
AnnotationAssertion(dcterms:description goldbook:14005 "Semiconductor or dielectric materials whose first band-to-band transition occurs from the highest level in the valence band to the lowest level in the conduction band possessing the same electron momentum, i.e., \\(\\boldsymbol{p}_{\\rm{max}} = \\boldsymbol{p}_{\\rm{min}}\\), with \\(\\boldsymbol{p}_{\\rm{max}}\\) and \\(\\boldsymbol{p}_{\\rm{min}}\\) the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively.")
Declaration(Class(goldbook:14006))
AnnotationAssertion(rdfs:label goldbook:14006 "dynamic photoadsorption process")
AnnotationAssertion(dcterms:description goldbook:14006 "Simultaneous (or synchronous) formation of adsorbed species (adsorbate) via photoadsorption and detachment by photodesorption to yield the same species, both processes occurring under photoexcitation of the solid photocatalyst (adsorbent).")
Declaration(Class(goldbook:14007))
AnnotationAssertion(rdfs:label goldbook:14007 "effective radiation-catalytic activity")
AnnotationAssertion(dcterms:description goldbook:14007 "Number of product entities (atoms, molecules, or radicals) generated by each \\(\\pu{100 eV}\\) of radiation incident on the system.")
Declaration(Class(goldbook:14008))
AnnotationAssertion(rdfs:label goldbook:14008 "electrical double layer")
AnnotationAssertion(dcterms:description goldbook:14008 "Array of charged species and oriented dipoles existing at a solid-solution interface. The solid may be a metal or a semiconductor. Double refers to the fact that the surface charge and its counter charge at the solution side are included.")
Declaration(Class(goldbook:14009))
AnnotationAssertion(rdfs:label goldbook:14009 "exciton absorption")
AnnotationAssertion(dcterms:description goldbook:14009 "Absorption of ultraviolet, visible, or infrared radiation yielding optical information on the excitons in solids. Exciton absorption bands in a spectrum of a semiconductor or insulator are located on the long wavelength side of the fundamental absorption edge.")
Declaration(Class(goldbook:14010))
AnnotationAssertion(rdfs:label goldbook:14010 "extrinsic absorption")
AnnotationAssertion(dcterms:description goldbook:14010 "Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators corresponding to optical transitions of electrons from defect energy levels (within the bandgap energy) to conduction band levels, or holes to valence band levels (photoionisation of defects), or from the ground state level to excited levels of a given intrinsic defect of any sort.")
Declaration(Class(goldbook:14011))
AnnotationAssertion(rdfs:label goldbook:14011 "extrinsic defect")
AnnotationAssertion(dcterms:description goldbook:14011 "Imperfection in a solid semiconductor (or insulator) connected with surface defects of any sort involving extrinsic chemical units in relation to the chemical formula of the solid, particularly adsorbed species of any sort.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14011 "extrinsic surface defect")
Declaration(Class(goldbook:14012))
AnnotationAssertion(rdfs:label goldbook:14012 "F centres")
AnnotationAssertion(dcterms:description goldbook:14012 "Anion vacancies occupied by electrons in semiconductors.")
Declaration(Class(goldbook:14013))
AnnotationAssertion(rdfs:label goldbook:14013 "Fermi level splitting")
AnnotationAssertion(dcterms:description goldbook:14013 "Splitting of the Fermi level in irradiated semiconductors and insulators into two Fermi quasi-levels for electrons \\(E_{\\rm{F}}^{\\rm{e}}\\) and for holes \\(E_{\\rm{F}}^{\\rm{h}}\\), displaced toward the bottom of the conduction band and toward the top of the valence band, respectively.")
Declaration(Class(goldbook:14014))
AnnotationAssertion(rdfs:label goldbook:14014 "free charge carriers")
AnnotationAssertion(dcterms:description goldbook:14014 "Applies to free electrons or free holes.")
Declaration(Class(goldbook:14015))
AnnotationAssertion(rdfs:label goldbook:14015 "free electrons")
AnnotationAssertion(dcterms:description goldbook:14015 "Photoexcited electrons from the valence band into the conduction band in semiconductors and insulators.")
Declaration(Class(goldbook:14016))
AnnotationAssertion(rdfs:label goldbook:14016 "fundamental absorption")
AnnotationAssertion(dcterms:description goldbook:14016 "Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators inducing optical transitions of electrons originating exclusively from the valence band to the conduction band to yield free electron-hole pairs and/or exciton absorption bands.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14016 "intrinsic absorption")
Declaration(Class(goldbook:14017))
AnnotationAssertion(rdfs:label goldbook:14017 "fundamental absorption edge")
AnnotationAssertion(dcterms:description goldbook:14017 "High wavelength limit of the fundamental absorption band in the spectrum of semiconductors and of insulators.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14017 "fundamental absorption threshold")
Declaration(Class(goldbook:14018))
AnnotationAssertion(rdfs:label goldbook:14018 "heterogeneous photocatalysis")
AnnotationAssertion(dcterms:description goldbook:14018 "Photocatalysis taking place at the interfacial boundary between two phases (solid/liquid, solid/gas, liquid/gas).")
Declaration(Class(goldbook:14019))
AnnotationAssertion(rdfs:label goldbook:14019 "heterogeneous radiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14019 "Radiation catalysis taking place in heterogeneous systems.")
Declaration(Class(goldbook:14020))
AnnotationAssertion(rdfs:label goldbook:14020 "homogeneous photocatalysis")
AnnotationAssertion(dcterms:description goldbook:14020 "Photocatalysis taking place in homogeneous systems.")
Declaration(Class(goldbook:14021))
AnnotationAssertion(rdfs:label goldbook:14021 "homogeneous radiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14021 "Radiation catalysis taking place in homogeneous systems.")
Declaration(Class(goldbook:14022))
AnnotationAssertion(rdfs:label goldbook:14022 "indirect bandgap semiconductor")
AnnotationAssertion(dcterms:description goldbook:14022 """Semiconductor or dielectric materials with a first band-to-band transition from the highest level in the valence band to the lowest level in the conduction band requiring the change of electron momentum, that is \\(\\boldsymbol{p}_{\\rm{max}} 
eq \\boldsymbol{p}_{\\rm{min}}\\), where \\(\\boldsymbol{p}_{\\rm{max}}\\) and \\(\\boldsymbol{p}_{\\rm{min}}\\) are the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively.""")
Declaration(Class(goldbook:14023))
AnnotationAssertion(rdfs:label goldbook:14023 "in-scattering")
AnnotationAssertion(dcterms:description goldbook:14023 "Physical phenomenon considering scattered radiative energy from rays in any direction \\(\\mathit{\\Omega}'\\) into the direction \\(\\mathit{\\Omega}\\) of the rays considered in the radiative transfer equation (RTE).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14023 "scattering in (into the beam under consideration)")
Declaration(Class(goldbook:14024))
AnnotationAssertion(rdfs:label goldbook:14024 "interparticle electron transfer")
AnnotationAssertion(dcterms:description goldbook:14024 "Electron transfer taking place from a photoexcited semiconductor onto another semiconductor (or insulator) in its ground state leading to vectorial (irreversible) charge transfer.")
Declaration(Class(goldbook:14025))
AnnotationAssertion(rdfs:label goldbook:14025 "intrinsic emission")
AnnotationAssertion(dcterms:description goldbook:14025 "Band-to-band recombination of electrons and holes (or exciton decay) in a semiconductor or insulator leading to luminescence.")
Declaration(Class(goldbook:14026))
AnnotationAssertion(rdfs:label goldbook:14026 "intrinsic defects")
AnnotationAssertion(dcterms:description goldbook:14026 "Imperfections connected with surface point defects (zero-dimensional), linear defects (one-dimensional), or square defects (two-dimensional) not including extrinsic chemical units in relation to the chemical formula of the solid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14026 "intrinsic surface defects")
Declaration(Class(goldbook:14027))
AnnotationAssertion(rdfs:label goldbook:14027 "inversion layer")
AnnotationAssertion(dcterms:description goldbook:14027 "Layer formed when band bending places the Fermi level on the surface close to the band of the bulk minority charge carriers. This leads to a higher concentration of the minority charge carriers on the surface relative to the concentration of the majority charge carriers, an opposite situation to that in the bulk.")
Declaration(Class(goldbook:14028))
AnnotationAssertion(rdfs:label goldbook:14028 "local differential absorption")
AnnotationAssertion(dcterms:description goldbook:14028 "Absorption term in the radiative transfer equation (RTE). Mathematical expression is \\[\\alpha_{\\lambda} (\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x}/t)\\] with \\(\\alpha_{\\lambda} (\\boldsymbol{x},t)\\) the space- and time-dependent linear napierian absorption coefficient and \\(L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) the spectral radiance arriving at position \\(x\\) and time \\(t\\) from every possible angular directions \\(\\mathit{\\Omega}\\).")
Declaration(Class(goldbook:14029))
AnnotationAssertion(rdfs:label goldbook:14029 "natural photosynthesis")
AnnotationAssertion(dcterms:description goldbook:14029 "Production of complex organic substances by higher plants, algae and photosynthesising bacteria from simple compounds (e.g., carbon dioxide and water, hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation energy absorbed by, e.g., chlorophyll, chlorophyll-protein complexes, and natural chromoproteins.")
Declaration(Class(goldbook:14030))
AnnotationAssertion(rdfs:label goldbook:14030 "out-scattering")
AnnotationAssertion(dcterms:description goldbook:14030 "Physical process by which the incoming electromagnetic radiation is forced to deviate from a straight trajectory by non-uniformities in the medium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14030 "scattering out (out of the beam under consideration)")
Declaration(Class(goldbook:14031))
AnnotationAssertion(rdfs:label goldbook:14031 "phase function")
AnnotationAssertion(dcterms:description goldbook:14031 "Distribution function representing the fraction of photons scattered from any direction \\(\\mathit{\\Omega}'\\) into the direction \\(\\mathit{\\Omega}\\) under consideration in the radiative transfer equation (RTE). Dimension one.")
Declaration(Class(goldbook:14032))
AnnotationAssertion(rdfs:label goldbook:14032 "photoadsorbate")
AnnotationAssertion(dcterms:description goldbook:14032 "Entity (molecule, atom, or ion) bound to the surface of a solid (semiconductor or insulator) particle (typically to a photoadsorption centre) as the result of photoexcitation of either the solid or the entity (molecule, atom, or ion).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14032 "photoadsorbed species")
Declaration(Class(goldbook:14033))
AnnotationAssertion(rdfs:label goldbook:14033 "photoadsorption area number")
AnnotationAssertion(dcterms:description goldbook:14033 "Maximum amount of substance photoadsorbed per area on the uniformly irradiated surface of an adsorbent.")
Declaration(Class(goldbook:14034))
AnnotationAssertion(rdfs:label goldbook:14034 "photoadsorption capacity")
AnnotationAssertion(dcterms:description goldbook:14034 "Maximal number of entities (molecules, atoms, or ions) per regular surface site that can be photoadsorbed at a uniformly irradiated surface of an adsorbent, \\(\\theta_{\\rm{max}} = N_{\\rm{max}}/N^{\\rm{ss}}\\) where \\(N_{\\rm{max}}\\) is the maximal number of entities photoadsorbed and \\(N^{\\rm{ss}}\\) is the number of surface sites (mainly regular surface sites, i.e., regular lattice ions or atoms; typically, \\(N^{\\rm{ss}}\\) ca. \\(\\pu{E15 cm-2}\\)).")
Declaration(Class(goldbook:14035))
AnnotationAssertion(rdfs:label goldbook:14035 "photoadsorption centre")
AnnotationAssertion(dcterms:description goldbook:14035 "Surface site or defect in its active state after photoexcitation capable of photoadsorbing species by a chemical interaction with the adsorbate entities (molecules, atoms, or ions).")
Declaration(Class(goldbook:14036))
AnnotationAssertion(rdfs:label goldbook:14036 "photoadsorption efficiency")
AnnotationAssertion(dcterms:description goldbook:14036 "Ratio of the maximal (typically the initial) rate of photoadsorption of entities \\(\\ce{B}\\) (molecules, atoms, or ions) to the integrated incident (superscript 0, zero) photon flux, \\(\\int_{\\lambda_{1}}^{\\lambda_{2}} q_{\\rm{p},\\lambda}^{0}{\\rm{d}}\\lambda = q_{\\rm{p}}^{0} = {\\rm{d}}N_{\\rm{p}}^{0}/{\\rm{d}}t\\), in the wavelength range \\(\\lambda_{1}{-}\\lambda_{2}\\). Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects.")
Declaration(Class(goldbook:14037))
AnnotationAssertion(rdfs:label goldbook:14037 "photoadsorption fraction")
AnnotationAssertion(dcterms:description goldbook:14037 "Number of entities (atoms, molecules or ions) photoadsorbed per regular surface site at a uniformly irradiated surface of an adsorbent.")
Declaration(Class(goldbook:14038))
AnnotationAssertion(rdfs:label goldbook:14038 "photoadsorption photonic yield")
AnnotationAssertion(dcterms:description goldbook:14038 "Ratio of the maximal (typically the initial) rate of photoadsorption of entities \\(\\ce{B}\\) (molecules, atoms, or ions) on a surface to the incident (superscript 0, zero) photon flux, \\(q_{\\rm{p},\\lambda}^{0} = {\\rm{d}}N_{\\rm{p},\\lambda}^{0}/{\\rm{d}}t\\) at a given wavelength. Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects.")
Declaration(Class(goldbook:14039))
AnnotationAssertion(rdfs:label goldbook:14039 "photoadsorption quantum yield")
AnnotationAssertion(dcterms:description goldbook:14039 "Ratio of the number of photoadsorbed entities \\(\\ce{B}\\) (molecules, atoms, or ions) on a surface to the number of photons of ultraviolet, visible, or infrared radiation (at a given wavelength \\(\\lambda\\)) absorbed by the system (typically by the adsorbent) during the initial stage of irradiation.")
Declaration(Class(goldbook:14040))
AnnotationAssertion(rdfs:label goldbook:14040 "photocarrier")
AnnotationAssertion(dcterms:description goldbook:14040 "Nonequilibrium free electron or free hole generated in a solid by ultraviolet, visible, or infrared absorption and occupying energy levels in the conduction band or the valence band, respectively.")
Declaration(Class(goldbook:14041))
AnnotationAssertion(rdfs:label goldbook:14041 "photocatalytic active centre")
AnnotationAssertion(dcterms:description goldbook:14041 "Surface centre, i.e., either a surface defect or a regular surface site, at which a chemical transformation takes place after converting the centre into an active state by a photophysical process, e.g., by photoexcitation.")
Declaration(Class(goldbook:14042))
AnnotationAssertion(rdfs:label goldbook:14042 "photocatalytic activity")
AnnotationAssertion(dcterms:description goldbook:14042 "Number of entities (product) formed in a photocatalytic process (alternatively the number of reactant entities disappearing) divided by the number of photons absorbed by the photocatalyst at one single wavelength or within a defined wavelength range. For one wavelength it has the same meaning as quantum yield, whereas within a defined wavelength range it has the same meaning as quantum efficiency.")
Declaration(Class(goldbook:14043))
AnnotationAssertion(rdfs:label goldbook:14043 "photocatalytic centre")
AnnotationAssertion(dcterms:description goldbook:14043 "Surface centre, i.e., a surface defect or a regular surface site, in an active or electronically excited state at which a chemical transformation takes place.")
Declaration(Class(goldbook:14044))
AnnotationAssertion(rdfs:label goldbook:14044 "photocatalytic efficiency")
AnnotationAssertion(dcterms:description goldbook:14044 "Number of entities (product) formed (alternatively the number of reactant entities disappearing) divided by the number of ultraviolet, visible, or infrared photons incident (prior to absorption) on the system and in a wavelength range \\(\\lambda_{1}{-}\\lambda_{2}\\).")
Declaration(Class(goldbook:14045))
AnnotationAssertion(rdfs:label goldbook:14045 "photocatalytic oxidation")
AnnotationAssertion(dcterms:description goldbook:14045 "Commonly used to describe the oxidation of pollutants by the action of ultraviolet, visible, or infrared radiation and a catalyst.")
Declaration(Class(goldbook:14046))
AnnotationAssertion(rdfs:label goldbook:14046 "photocorrosion")
AnnotationAssertion(dcterms:description goldbook:14046 "Decomposition of the photocatalyst or of the electrodes as a result of a photoinduced reaction.")
Declaration(Class(goldbook:14047))
AnnotationAssertion(rdfs:label goldbook:14047 "photocurrent")
AnnotationAssertion(dcterms:description goldbook:14047 "Photogeneration and movement of charge between two electrodes in a photovoltaic cell or a photoelectrochemical cell as a result of photoprocesses induced by light absorption.")
Declaration(Class(goldbook:14048))
AnnotationAssertion(rdfs:label goldbook:14048 "photodesorption")
AnnotationAssertion(dcterms:description goldbook:14048 "Desorption induced by the absorption of ultraviolet, visible, or infrared radiation either by the adsorbate or by the adsorbent.")
Declaration(Class(goldbook:14049))
AnnotationAssertion(rdfs:label goldbook:14049 "photodesorption quantum yield")
AnnotationAssertion(dcterms:description goldbook:14049 "Number of entities evolving into the medium from a surface divided by the number of photons absorbed at a given wavelength by a solid or by an adsorbed entity treated as a surface extrinsic defect (centre).")
Declaration(Class(goldbook:14050))
AnnotationAssertion(rdfs:label goldbook:14050 "photoelectrocatalysis")
AnnotationAssertion(dcterms:description goldbook:14050 "Electrochemically assisted photocatalysis. The role of the photocatalyst is played by a photoelectrode, often a semiconductor.")
Declaration(Class(goldbook:14051))
AnnotationAssertion(rdfs:label goldbook:14051 "photoelectrode")
AnnotationAssertion(dcterms:description goldbook:14051 "Electrode capable of initiating electrochemical transformations after absorbing ultraviolet, visible, or infrared radiation.")
Declaration(Class(goldbook:14052))
AnnotationAssertion(rdfs:label goldbook:14052 "photoelectrosynthesis")
AnnotationAssertion(dcterms:description goldbook:14052 "Process by which ultraviolet, visible, or infrared radiation is absorbed by a semiconductor, electron transfer occurs at the interface between the semiconductor and a liquid and the output is chemical energy, i.e., radiant energy is stored as chemical energy.")
Declaration(Class(goldbook:14053))
AnnotationAssertion(rdfs:label goldbook:14053 "photogenerated catalysis")
AnnotationAssertion(dcterms:description goldbook:14053 "Initiation of chemical transformations through the photochemical formation of molecular species, which (once formed) are catalytically active even without the action of ultraviolet, visible, or infrared radiation.")
Declaration(Class(goldbook:14054))
AnnotationAssertion(rdfs:label goldbook:14054 "photogenerated charge carrier")
AnnotationAssertion(dcterms:description goldbook:14054 "Charge carrying entity, especially an electron or a hole, in a semiconductor, produced by the absorption of ultraviolet, visible, or infrared radiation.")
Declaration(Class(goldbook:14055))
AnnotationAssertion(rdfs:label goldbook:14055 "photoinitiator")
AnnotationAssertion(dcterms:description goldbook:14055 "Agent initiating certain chemical transformations under the action of ultraviolet, visible, or infrared radiation and consumed therewith.")
Declaration(Class(goldbook:14056))
AnnotationAssertion(rdfs:label goldbook:14056 "photomineralisation")
AnnotationAssertion(dcterms:description goldbook:14056 "Complete photodegradation of an organic compound into carbon dioxide and water, and other simple inorganic compounds (depending on the hetero-atom in the compound) upon absorption of ultraviolet, visible, or infrared radiation by the photocatalyst or by the adsorbate.")
Declaration(Class(goldbook:14057))
AnnotationAssertion(rdfs:label goldbook:14057 "photonic efficiency")
AnnotationAssertion(dcterms:description goldbook:14057 "Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons within a defined wavelength interval inside the irradiation window of the reactor.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14057 "formal quantum efficiency")
Declaration(Class(goldbook:14058))
AnnotationAssertion(rdfs:label goldbook:14058 "photonic yield")
AnnotationAssertion(dcterms:description goldbook:14058 "Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons of monochromatic light inside the irradiation window of the reactor.")
Declaration(Class(goldbook:14059))
AnnotationAssertion(rdfs:label goldbook:14059 "photonic yield spectrum")
AnnotationAssertion(dcterms:description goldbook:14059 "Plot of the photonic yield of a given photoprocess, measured at the same photon flux of incident (prior to absorption) light, as a function of a measure of the energy of the photons, i.e., for monochromatic irradiation.")
Declaration(Class(goldbook:14060))
AnnotationAssertion(rdfs:label goldbook:14060 "photoradiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14060 "Radiation catalysis under conditions not allowing a distinction between the effect of ultraviolet, visible, or infrared and of ionising radiation as well as the case in which the ionising radiation alone generates emission of chemically active light (e.g., the 'Cherenkov' light emission).")
Declaration(Class(goldbook:14061))
AnnotationAssertion(rdfs:label goldbook:14061 "photosensitised reaction")
AnnotationAssertion(dcterms:description goldbook:14061 "Reaction initiated by photosensitisation.")
Declaration(Class(goldbook:14062))
AnnotationAssertion(rdfs:label goldbook:14062 "photothermocatalysis")
AnnotationAssertion(dcterms:description goldbook:14062 "Catalysis occurring by the combined action of electronic excitation due to absorption of ultraviolet or visible radiation and thermal energy (infrared radiation or exothermic reactions) including catalytic phenomena.")
Declaration(Class(goldbook:14063))
AnnotationAssertion(rdfs:label goldbook:14063 "physical pathway")
AnnotationAssertion(dcterms:description goldbook:14063 "Set of physical processes leading to the relaxation of the electronically excited system without chemical transformations.")
Declaration(Class(goldbook:14064))
AnnotationAssertion(rdfs:label goldbook:14064 "radiant dose")
AnnotationAssertion(dcterms:description goldbook:14064 "Radiant energy (\\(Q\\), SI unit is \\(\\pu{J}\\)) or amount of photons (in \\(\\pu{mol}\\) or the non-SI unit einstein) absorbed per area or volume by an object irradiated during a given exposure time.")
Declaration(Class(goldbook:14065))
AnnotationAssertion(rdfs:label goldbook:14065 "radiation-activation")
AnnotationAssertion(dcterms:description goldbook:14065 "Increasing of catalytic activity or alteration of selectivity of a substance after its exposure to high-energy radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14065 "radioactivation")
Declaration(Class(goldbook:14066))
AnnotationAssertion(rdfs:label goldbook:14066 "radiation adsorption")
AnnotationAssertion(dcterms:description goldbook:14066 "The word combination may be misleading. Usually radiation is absorbed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14066 "radiation-induced adsorption")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14066 "radioadsorption")
Declaration(Class(goldbook:14067))
AnnotationAssertion(rdfs:label goldbook:14067 "radiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14067 "Change in the rate of a chemical reaction under the action of ionising radiation in the presence of a radiation catalyst.")
Declaration(Class(goldbook:14068))
AnnotationAssertion(rdfs:label goldbook:14068 "radiation catalyst")
AnnotationAssertion(dcterms:description goldbook:14068 "Substance absorbing ionising radiation and able to produce chemical transformations of the reaction partners, repeatedly producing intermediate transformations and regenerating its chemical composition after each cycle of such interactions.")
Declaration(Class(goldbook:14069))
AnnotationAssertion(rdfs:label goldbook:14069 "radiation-chemical yield")
AnnotationAssertion(dcterms:description goldbook:14069 "Number of entities of a product formed (alternatively, the number of entities of a reactant disappearing) generated per \\(\\pu{100 eV}\\) of energy absorbed from ionising radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14069 "G value")
Declaration(Class(goldbook:14070))
AnnotationAssertion(rdfs:label goldbook:14070 "radiation desorption")
AnnotationAssertion(dcterms:description goldbook:14070 "Desorption from solid or liquid interfaces induced by absorption of radiation by the solid or liquid adsorbent.")
Declaration(Class(goldbook:14071))
AnnotationAssertion(rdfs:label goldbook:14071 "radiation-generated catalysis")
AnnotationAssertion(dcterms:description goldbook:14071 "Initiation of chemical transformations through the formation, by absorption of high-energy radiation, of substances that are catalytically active even in the absence of the radiation.")
Declaration(Class(goldbook:14072))
AnnotationAssertion(rdfs:label goldbook:14072 "radiation-induced adsorption")
AnnotationAssertion(dcterms:description goldbook:14072 "Adsorption of a molecular entity at solid or liquid interfaces induced by absorption of high-energy radiation by the solid or the liquid adsorbent.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14072 "radiation adsorption")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14072 "radioadsorption")
Declaration(Class(goldbook:14073))
AnnotationAssertion(rdfs:label goldbook:14073 "radiation sensitisation")
AnnotationAssertion(dcterms:description goldbook:14073 "Chemical change or physical process occurring in one entity (e.g., biological molecules, cells, and living organisms) as a result of initial absorption of high-energy radiation by the medium in the presence of another entity called the radiation sensitiser.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14073 "radiosensitisation")
Declaration(Class(goldbook:14074))
AnnotationAssertion(rdfs:label goldbook:14074 "radiation sensitiser")
AnnotationAssertion(dcterms:description goldbook:14074 "Chemical substance that increases the radiation sensitivity of, in particular, biological molecules, cells and biological organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14074 "radiosensitiser")
Declaration(Class(goldbook:14075))
AnnotationAssertion(rdfs:label goldbook:14075 "radiation-stimulated diffusion")
AnnotationAssertion(dcterms:description goldbook:14075 "Increase of diffusion of an adsorbate under the action of ionising radiation absorbed by either the adsorbent and/or the adsorbate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14075 "radiostimulated diffusion")
Declaration(Class(goldbook:14076))
AnnotationAssertion(rdfs:label goldbook:14076 "radiation thermal catalysis")
AnnotationAssertion(dcterms:description goldbook:14076 "Radiation catalysis under the action of large radiation fluxes that simultaneously heat the system as a consequence of absorption of energy from radiationless deactivation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14076 "radiothermal catalysis")
Declaration(Class(goldbook:14077))
AnnotationAssertion(rdfs:label goldbook:14077 "radiative transfer equation")
AnnotationAssertion(dcterms:description goldbook:14077 "When a photon beam of radiance \\(L_{\\lambda}\\) and angular distribution \\(\\mathit{\\Omega}\\) passes along a single direction of propagation through a medium, which is totally absorbing and/or scattering, i.e., the processes occurring are described by the following equation: \\[\\begin{array} \\\\ \\frac{{\\rm{d}}L_{\\Omega,\\lambda}(\\boldsymbol{x},t)}{{\\rm{d}}s} + \\underbrace{\\alpha_{\\lambda}(\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t)}_{\\rm{adsorption}} + \\underbrace{\\sigma_{\\lambda}(\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t)}_{\\rm{out\\mbox{-}scattering}} = \\\\ \\underbrace{j_{\\lambda}(\\boldsymbol{x},t)}_{\\rm{emission}} + \\underbrace{\\frac{\\sigma_{\\lambda}(\\boldsymbol{x},t)}{4\\pi}B_{\\lambda}(\\mathit{\\Omega}' \\to \\mathit{\\Omega}) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t){\\rm{d}}\\mathit{\\Omega}'}_{\\rm{in\\mbox{-}scattering}} \\end{array}\\] where \\(\\frac{{\\rm{d}}L_{\\Omega,\\lambda}(\\boldsymbol{x},t)}{{\\rm{d}}s}\\) is the directional derivative along the direction \\(s\\) at a point \\(\\boldsymbol{x}\\) in the reaction space of the incident radiance, \\(\\alpha_{\\lambda}(\\boldsymbol{x},t)\\) is the space- and time-dependent spectral linear napierian absorption coefficient, \\(\\sigma_{\\lambda}(\\boldsymbol{x},t)\\) is the space- and time-dependent spectral linear napierian scattering coefficient, \\(j_{\\lambda}(\\boldsymbol{x},t)\\) represents the spontaneous and/or induced emission, and \\(B_{\\lambda}\\) is the phase function. All quantities are a function of time. The RTE is written for the direction \\(s\\).")
Declaration(Class(goldbook:14078))
AnnotationAssertion(rdfs:label goldbook:14078 "rate of generation")
AnnotationAssertion(dcterms:description goldbook:14078 "Number of carriers (or electron-hole pairs, or excitons) produced per time interval and per volume of a solid photocatalyst particle due to the absorption of light.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14078 "rate of photogeneration")
Declaration(Class(goldbook:14079))
AnnotationAssertion(rdfs:label goldbook:14079 "rate of surface recombination")
AnnotationAssertion(dcterms:description goldbook:14079 "Decay of carriers at the surface of a solid or interface between different phases, e.g., at the crystal surface.")
Declaration(Class(goldbook:14080))
AnnotationAssertion(rdfs:label goldbook:14080 "recombination of photocarriers")
AnnotationAssertion(dcterms:description goldbook:14080 "Two-step transition of an electron from the conduction band to a defect centre and then further to the valence band, or from the defect centre to the valence band (first step) and a subsequent transition of the conduction band electron to the defect centre (second step).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14080 "recombination of photocarriers via defects")
Declaration(Class(goldbook:14081))
AnnotationAssertion(rdfs:label goldbook:14081 "recombination centre")
AnnotationAssertion(dcterms:description goldbook:14081 "Defect in semiconductors and insulators capable of sequential capture of free charge carriers of both signs with high efficiency.")
Declaration(Class(goldbook:14082))
AnnotationAssertion(rdfs:label goldbook:14082 "regular surface")
AnnotationAssertion(dcterms:description goldbook:14082 "Perfect surface of a solid without heterogeneity or defect.")
Declaration(Class(goldbook:14083))
AnnotationAssertion(rdfs:label goldbook:14083 "regular surface site")
AnnotationAssertion(dcterms:description goldbook:14083 "Zero-dimension site (atom, ion, or interstitial position) at a regular surface.")
Declaration(Class(goldbook:14084))
AnnotationAssertion(rdfs:label goldbook:14084 "relative photonic efficiency")
AnnotationAssertion(dcterms:description goldbook:14084 "Ratio of the photonic efficiency (\\(\\xi\\)) of a chemical process to the corresponding photonic efficiency of a standard process under otherwise identical conditions in the same reactor configuration and operation.")
Declaration(Class(goldbook:14085))
AnnotationAssertion(rdfs:label goldbook:14085 "scattering albedo")
AnnotationAssertion(dcterms:description goldbook:14085 "Efficiency of scattering, i.e., ratio of scattering coefficient, \\(\\sigma(\\lambda_{\\rm{i}})\\), to the total attenuance coefficient, \\(\\beta(\\lambda_{\\rm{i}})\\), at a particular wavelength \\(\\lambda_{\\rm{i}}\\).")
Declaration(Class(goldbook:14086))
AnnotationAssertion(rdfs:label goldbook:14086 "shallow trap")
AnnotationAssertion(dcterms:description goldbook:14086 "Energy level (of trapped carrier) within the bandgap energy, near the bottom of the conduction band (electron shallow trap) and near the top of the valence band (hole shallow band) at an energy such that \\(E_{\\rm{trap}} \\approx kT\\), with \\(k\\) the Boltzmann constant and \\(T\\) the thermodynamic temperature.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14086 "shallow energy trap")
Declaration(Class(goldbook:14087))
AnnotationAssertion(rdfs:label goldbook:14087 "Solonitsyn effect")
AnnotationAssertion(dcterms:description goldbook:14087 "Adsorption (or reaction) after preliminary irradiation of a photocatalyst in vacuum (or in the absence of reagent).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14087 "post-adsorption")
Declaration(Class(goldbook:14088))
AnnotationAssertion(rdfs:label goldbook:14088 "sonophotocatalytic reactor")
AnnotationAssertion(dcterms:description goldbook:14088 "Reactor in which a hybrid technique combining 'sonochemical' and photocatalytic reactions is used.")
Declaration(Class(goldbook:14089))
AnnotationAssertion(rdfs:label goldbook:14089 "space charge region")
AnnotationAssertion(dcterms:description goldbook:14089 "Region formed within a semiconductor in contact with another phase in which there is a band bending that can be upward or downward.")
Declaration(Class(goldbook:14090))
AnnotationAssertion(rdfs:label goldbook:14090 "specific photoadsorption number")
AnnotationAssertion(dcterms:description goldbook:14090 "Maximum number of entities (molecules, atoms or radicals) adsorbed as a result of irradiation divided by the surface area and by the mass of adsorbent.")
Declaration(Class(goldbook:14091))
AnnotationAssertion(rdfs:label goldbook:14091 "specific absorption coefficient")
AnnotationAssertion(dcterms:description goldbook:14091 "Linear napierian, \\(\\alpha_{\\lambda}^{\\ast}\\), or linear decadic, \\(a_{\\lambda}^{\\ast}\\), absorption coefficient divided by the mass concentration, \\(\\rho\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14091 "specific linear decadic spectral absorption coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14091 "specific linear Napierian spectral absorption coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14091 "specific spectral absorption coefficient")
Declaration(Class(goldbook:14092))
AnnotationAssertion(rdfs:label goldbook:14092 "specific napierian attenuance coefficient")
AnnotationAssertion(dcterms:description goldbook:14092 "Attenuance (napierian), \\(D_{\\rm{e}}\\), divided by the absorption pathlength, \\(l\\), and the mass concentration, \\(\\rho\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14092 "specific Napierian extinction coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14092 "specific Napierian spectral extinction coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14092 "specific spectral Napierian attenuance coefficient")
Declaration(Class(goldbook:14093))
AnnotationAssertion(rdfs:label goldbook:14093 "specific napierian scattering coefficient")
AnnotationAssertion(dcterms:description goldbook:14093 "Fraction of attenuance (napierian) not due to absorbance, divided by the pathlength, \\(l\\), within the scattering medium and the mass concentration, \\(\\rho\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14093 "specific spectral napierian scattering coefficient")
Declaration(Class(goldbook:14094))
AnnotationAssertion(rdfs:label goldbook:14094 "spectral photon irradiance")
AnnotationAssertion(dcterms:description goldbook:14094 "Derivative of photon irradiance, \\(E_{\\rm{p}}\\), with respect to wavelength, \\(\\lambda\\).")
Declaration(Class(goldbook:14095))
AnnotationAssertion(rdfs:label goldbook:14095 "spectral photonic yield")
AnnotationAssertion(dcterms:description goldbook:14095 "Dependence of the photonic yield on the photon energy (wavelength, frequency, or wavenumber) of the radiation for a given photoreaction obtained at a certain incident (prior to absorption) photon irradiance in a given spectral range.")
Declaration(Class(goldbook:14096))
AnnotationAssertion(rdfs:label goldbook:14096 "spectral quantum yield")
AnnotationAssertion(dcterms:description goldbook:14096 "Dependence of the quantum yield on the photon energy (wavelength, frequency or wavenumber) of the radiation absorbed by the reactant for a given photoreaction.")
Declaration(Class(goldbook:14097))
AnnotationAssertion(rdfs:label goldbook:14097 "surface-active site")
AnnotationAssertion(dcterms:description goldbook:14097 "Surface regular or defect site that can initiate the chemical transformation of reagents.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14097 "surface-active centre")
Declaration(Class(goldbook:14098))
AnnotationAssertion(rdfs:label goldbook:14098 "surface recombination")
AnnotationAssertion(dcterms:description goldbook:14098 "Recombination of charge carriers at a solid surface or at an interface between different phases.")
Declaration(Class(goldbook:14099))
AnnotationAssertion(rdfs:label goldbook:14099 "thermal bleaching")
AnnotationAssertion(dcterms:description goldbook:14099 "Loss of absorption by the colour centres because of heating of the solid semiconductor or insulator.")
Declaration(Class(goldbook:14100))
AnnotationAssertion(rdfs:label goldbook:14100 "thermophotocatalysis")
AnnotationAssertion(dcterms:description goldbook:14100 "A photocatalytic phenomenon occurring when the system is also heated by the ultraviolet, visible, or infrared radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14100 "light-initiated thermocatalytic phenomena")
Declaration(Class(goldbook:14101))
AnnotationAssertion(rdfs:label goldbook:14101 "turnover number")
AnnotationAssertion(dcterms:description goldbook:14101 "Number of times, \\(n\\), that the overall reaction (the photochemical transformation) goes through a photocatalytic cycle.")
Declaration(Class(goldbook:14102))
AnnotationAssertion(rdfs:label goldbook:14102 "V centres")
AnnotationAssertion(dcterms:description goldbook:14102 "Trapped holes in semiconductors.")
Declaration(Class(goldbook:14103))
AnnotationAssertion(rdfs:label goldbook:14103 "volatile organic chemical/compounds")
AnnotationAssertion(dcterms:description goldbook:14103 "Term commonly used to designate organic gas-phase pollutants frequently degraded by photocatalytic procedures.")
Declaration(Class(goldbook:14104))
AnnotationAssertion(rdfs:label goldbook:14104 "absorbance assay")
AnnotationAssertion(dcterms:description goldbook:14104 "Assay in which response is determined by the detection of light absorption by an assay component.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14104 "optical density assay (obsolete)")
Declaration(Class(goldbook:14105))
AnnotationAssertion(rdfs:label goldbook:14105 "active")
AnnotationAssertion(dcterms:description goldbook:14105 "Sample that produces a response or signal above a defined threshold at a tested concentration in a single assay or screen.")
Declaration(Class(goldbook:14106))
AnnotationAssertion(rdfs:label goldbook:14106 "activity distribution")
AnnotationAssertion(dcterms:description goldbook:14106 "Graphical representation of the number of samples present in each activity range.")
Declaration(Class(goldbook:14107))
AnnotationAssertion(rdfs:label goldbook:14107 "allosteric site")
AnnotationAssertion(dcterms:description goldbook:14107 "Binding site on a protein, distinct from the site recognized by an endogenous agonist (i.e., the orthosteric site) in the case of a receptor, or substrate in the case of an enzyme, that when occupied by a ligand effects a conformational change in the protein, thus altering its signaling, catalytic properties, or its capability to interact with other macromolecules.")
Declaration(Class(goldbook:14108))
AnnotationAssertion(rdfs:label goldbook:14108 "artifact")
AnnotationAssertion(dcterms:description goldbook:14108 "Observation, effect, or result that is inaccurate because it is produced by the methodology used in scientific investigation or by experimental error.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14108 "artefact")
Declaration(Class(goldbook:14109))
AnnotationAssertion(rdfs:label goldbook:14109 "assay validation")
AnnotationAssertion(dcterms:description goldbook:14109 "Experiments conducted to verify that the output measurements of the assay are consistently reflective of the activity against the target.")
Declaration(Class(goldbook:14110))
AnnotationAssertion(rdfs:label goldbook:14110 "automated device")
AnnotationAssertion(dcterms:description goldbook:14110 "Device that performs one or more functions without human intervention by means of direct control or by programmed operations.")
Declaration(Class(goldbook:14111))
AnnotationAssertion(rdfs:label goldbook:14111 "binding assay")
AnnotationAssertion(dcterms:description goldbook:14111 "Assay in which the specific physical association or interaction between two molecules (e.g., ligand–receptor, antibody–antigen, protein–protein, ligand–transport protein) is measured.")
Declaration(Class(goldbook:14112))
AnnotationAssertion(rdfs:label goldbook:14112 "binding isotherm")
AnnotationAssertion(dcterms:description goldbook:14112 "Graphical representation of the relationship between the amount of ligand that is specifically bound to a receptor per mass of binding material and the amount of free ligand.")
Declaration(Class(goldbook:14113))
AnnotationAssertion(rdfs:label goldbook:14113 "cell-based assay")
AnnotationAssertion(dcterms:description goldbook:14113 "Assay in which the response of live cells to a test sample is measured.")
Declaration(Class(goldbook:14114))
AnnotationAssertion(rdfs:label goldbook:14114 "cell membrane preparation")
AnnotationAssertion(dcterms:description goldbook:14114 "Preparation from tissue or cells, in which the membranous elements, generally the cell membrane, are enriched in relation to other cellular constituents.")
Declaration(Class(goldbook:14115))
AnnotationAssertion(rdfs:label goldbook:14115 "cell mortality")
AnnotationAssertion(dcterms:description goldbook:14115 "Ratio of counted dead cells to the total number of observed cells.")
Declaration(Class(goldbook:14116))
AnnotationAssertion(rdfs:label goldbook:14116 "cell viability")
AnnotationAssertion(dcterms:description goldbook:14116 "Ratio of counted live cells to the total number of observed cells.")
Declaration(Class(goldbook:14117))
AnnotationAssertion(rdfs:label goldbook:14117 "channel blocker")
AnnotationAssertion(dcterms:description goldbook:14117 "Compound that reduces or eliminates the conductance of an ion channel by impeding the movement of ions through that channel.")
Declaration(Class(goldbook:14118))
AnnotationAssertion(rdfs:label goldbook:14118 "channel opener")
AnnotationAssertion(dcterms:description goldbook:14118 "Compound that increases the conductance of an ion channel by a mechanism other than alteration of membrane potential or activation of the cognate receptor.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14118 "channel activator")
Declaration(Class(goldbook:14119))
AnnotationAssertion(rdfs:label goldbook:14119 "chemotaxis assay")
AnnotationAssertion(dcterms:description goldbook:14119 "Cell-based assay in which the rate and/or direction of cell migration is measured.")
Declaration(Class(goldbook:14120))
AnnotationAssertion(rdfs:label goldbook:14120 "combinatorial library")
AnnotationAssertion(dcterms:description goldbook:14120 "Set of compounds prepared by combinatorial chemistry. It may consist of a collection of pools, or sublibraries. Its composition may be described by the chemset notation.")
Declaration(Class(goldbook:14121))
AnnotationAssertion(rdfs:label goldbook:14121 "compound collection")
AnnotationAssertion(dcterms:description goldbook:14121 "Set of chemicals that has been assembled and annotated for easy storage and retrieval and that is available for screening.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14121 "compound deck")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14121 "compound library")
Declaration(Class(goldbook:14122))
AnnotationAssertion(rdfs:label goldbook:14122 "concentration–response relationship")
AnnotationAssertion(dcterms:description goldbook:14122 "Association between compound concentration and the resultant magnitude of the continuously graded change produced, in an assay.")
Declaration(Class(goldbook:14123))
AnnotationAssertion(rdfs:label goldbook:14123 "confirmed hit")
AnnotationAssertion(dcterms:description goldbook:14123 "Sample that produces activity above the hit threshold in an assay and whose structural identity has been confirmed.")
Declaration(Class(goldbook:14124))
AnnotationAssertion(rdfs:label goldbook:14124 "counter-screen")
AnnotationAssertion(dcterms:description goldbook:14124 "Screen in which test samples are assessed against a target for unwanted activity.")
Declaration(Class(goldbook:14125))
AnnotationAssertion(rdfs:label goldbook:14125 "cytotoxicity assay")
AnnotationAssertion(dcterms:description goldbook:14125 "Cell-based assay in which damage to cell structure or function caused by a test sample is determined.")
Declaration(Class(goldbook:14126))
AnnotationAssertion(rdfs:label goldbook:14126 "efficacy")
AnnotationAssertion(dcterms:description goldbook:14126 "Extent to which a compound activates a receptor to produce a response in an assay under saturating conditions.")
Declaration(Class(goldbook:14127))
AnnotationAssertion(rdfs:label goldbook:14127 "electrochemiluminescence assay")
AnnotationAssertion(dcterms:description goldbook:14127 "Assay in which light emitted by electrogenerated luminescence is detected and used to quantify a label, e.g., ruthenium(II) tris-(bipyridine), on one of the two assay binding components.")
Declaration(Class(goldbook:14128))
AnnotationAssertion(rdfs:label goldbook:14128 "end-point assay")
AnnotationAssertion(dcterms:description goldbook:14128 "Kinetic assay run for a set constant incubation time. Typically, at the end of the set incubation time, a reagent that stops the reaction is added to allow postponed measurement of the signal.")
Declaration(Class(goldbook:14129))
AnnotationAssertion(rdfs:label goldbook:14129 "epitope mapping")
AnnotationAssertion(dcterms:description goldbook:14129 "Identification and localization of the specific regions of protein molecules that are recognized by the immune system.")
Declaration(Class(goldbook:14130))
AnnotationAssertion(rdfs:label goldbook:14130 "equilibrium assay")
AnnotationAssertion(dcterms:description goldbook:14130 "Assay in which there is sufficient incubation time for the plateau phase of the signal to be reached and equilibrium has been established between the reactants.")
Declaration(Class(goldbook:14131))
AnnotationAssertion(rdfs:label goldbook:14131 "equilibrium association constant")
AnnotationAssertion(dcterms:description goldbook:14131 "Ratio, at equilibrium, of \\([\\ce{AB}]/[\\ce{A}][\\ce{B}]\\) for the reversible binding interaction of \\(\\ce{A}\\) and \\(\\ce{B}\\) to yield the complex \\(\\ce{AB}\\).")
Declaration(Class(goldbook:14132))
AnnotationAssertion(rdfs:label goldbook:14132 "equilibrium dissociation constant")
AnnotationAssertion(dcterms:description goldbook:14132 "Ratio, at equilibrium, of \\([\\ce{A}][\\ce{B}]/[\\ce{AB}]\\), for the reversible binding interaction of \\(\\ce{A}\\) and \\(\\ce{B}\\) to yield the complex \\(\\ce{AB}\\).")
Declaration(Class(goldbook:14133))
AnnotationAssertion(rdfs:label goldbook:14133 "flow cytometry assay")
AnnotationAssertion(dcterms:description goldbook:14133 "Cell-based assay in which the response is dependent on the detection of the phenotype of cells as determined through the light-scattering properties of each cell, and, typically, the fluorescence intensity of a relevant probe.")
Declaration(Class(goldbook:14134))
AnnotationAssertion(rdfs:label goldbook:14134 "fluorescence correlation assay")
AnnotationAssertion(dcterms:description goldbook:14134 "Assay in which fluctuations in fluorescence intensity are detected and used to characterize a species that is labeled with a fluorescent probe.")
Declaration(Class(goldbook:14135))
AnnotationAssertion(rdfs:label goldbook:14135 "fluorescence polarisation")
AnnotationAssertion(dcterms:description goldbook:14135 "Dimensionless value determined from the fluorescence intensities (\\(I\\)) measured parallel (\\(I_{\\Vert}\\)) and perpendicular (\\(I_{\\perp}\\)) to the excitation plane: \\[p = \\frac{I_{\\Vert} - I_{\\perp}}{I_{\\Vert} + I_{\\perp}}\\]")
Declaration(Class(goldbook:14136))
AnnotationAssertion(rdfs:label goldbook:14136 "fluorescence polarisation assay")
AnnotationAssertion(dcterms:description goldbook:14136 "Assay in which the association between an intrinsically fluorescent ligand, or a ligand linked to a fluorescent probe, and a larger macromolecule is detected.")
Declaration(Class(goldbook:14137))
AnnotationAssertion(rdfs:label goldbook:14137 "fluorescence resonance energy transfer assay")
AnnotationAssertion(dcterms:description goldbook:14137 "Assay based on the nonradiative energy transfer that occurs when the emission spectrum of a fluorescent donor molecule overlaps with the absorption spectrum of an energy acceptor molecule.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14137 "FRET assay")
Declaration(Class(goldbook:14138))
AnnotationAssertion(rdfs:label goldbook:14138 "functional assay")
AnnotationAssertion(dcterms:description goldbook:14138 "Assay in which the biological or physiological activity of the target is measured.")
Declaration(Class(goldbook:14139))
AnnotationAssertion(rdfs:label goldbook:14139 "heterogeneous assay")
AnnotationAssertion(dcterms:description goldbook:14139 "Assay in which the response is detected only after the physical separation by methods such as filtration or centrifugation of one or more assay components.")
Declaration(Class(goldbook:14140))
AnnotationAssertion(rdfs:label goldbook:14140 "heterogeneous binding assay")
AnnotationAssertion(dcterms:description goldbook:14140 "Assay in which one binding component is immobilized to a surface (e.g., cellular membrane, glass, gold, bead, or biopolymer layer) while its binding partner is freely diffusible.")
Declaration(Class(goldbook:14141))
AnnotationAssertion(rdfs:label goldbook:14141 "high-content screening assay")
AnnotationAssertion(dcterms:description goldbook:14141 "A cell-based assay that produces multiple biological readouts.")
Declaration(Class(goldbook:14142))
AnnotationAssertion(rdfs:label goldbook:14142 "high-performance liquid chromatography assay")
AnnotationAssertion(dcterms:description goldbook:14142 "Assay in which response is determined after the physical separation of assay components using high-performance liquid chromatography (HPLC) with concurrent detection, usually by monitoring absorbance at an appropriate wavelength.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14142 "HPLC Assay")
Declaration(Class(goldbook:14143))
AnnotationAssertion(rdfs:label goldbook:14143 "high throughput")
AnnotationAssertion(dcterms:description goldbook:14143 "Relative term, applied to the generation of a large number of results in a short timeframe (e.g., \\(\\pu{E5}\\) in a week or a month).")
Declaration(Class(goldbook:14144))
AnnotationAssertion(rdfs:label goldbook:14144 "hit rate")
AnnotationAssertion(dcterms:description goldbook:14144 "Proportion of hits from a screen that displays confirmed activity beyond a minimum defined level, the hit threshold. It is expressed as a percentage of the number of samples screened.")
Declaration(Class(goldbook:14145))
AnnotationAssertion(rdfs:label goldbook:14145 "hit threshold")
AnnotationAssertion(dcterms:description goldbook:14145 "Minimum activity that defines actives in a primary screen.")
Declaration(Class(goldbook:14146))
AnnotationAssertion(rdfs:label goldbook:14146 "homogeneous assay")
AnnotationAssertion(dcterms:description goldbook:14146 "Assay in which all reagents and reactants are of a uniform phase (typically, liquid phase) and assay response is detected without the need for physical separation of assay components.")
Declaration(Class(goldbook:14147))
AnnotationAssertion(rdfs:label goldbook:14147 "homogeneous binding assay")
AnnotationAssertion(dcterms:description goldbook:14147 "Single-phase system used to qualitatively discriminate between specific and nonspecific interactions or quantitatively determine the concentration of a component part of a mixture.")
Declaration(Class(goldbook:14148))
AnnotationAssertion(rdfs:label goldbook:14148 "image-based assay")
AnnotationAssertion(dcterms:description goldbook:14148 "Assay in which image analysis algorithms that determine the compartmentalization of fluorescent probes give topological as well as quantitative information.")
Declaration(Class(goldbook:14149))
AnnotationAssertion(rdfs:label goldbook:14149 "immobilised metal ion affinity-based fluorescence polarisation assay")
AnnotationAssertion(dcterms:description goldbook:14149 "Assay in which the interaction between nanoparticles coated with triply charged metal ions and phosphate groups on a substrate that carries a fluorescent tag is detected.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14149 "IMAP™ assay")
Declaration(Class(goldbook:14150))
AnnotationAssertion(rdfs:label goldbook:14150 "inactive")
AnnotationAssertion(dcterms:description goldbook:14150 "Sample that, at the tested concentration, does not produce a response above the hit threshold in an assay.")
Declaration(Class(goldbook:14151))
AnnotationAssertion(rdfs:label goldbook:14151 "inverse agonist")
AnnotationAssertion(dcterms:description goldbook:14151 "Ligand that decreases signaling through a receptor below the level of constitutive activity.")
Declaration(Class(goldbook:14152))
AnnotationAssertion(rdfs:label goldbook:14152 "kinetic assay")
AnnotationAssertion(dcterms:description goldbook:14152 "Assay in which the time dependence of the signal intensity is measured. Signal values are typically acquired at several time intervals in order to calculate kinetic parameters.")
Declaration(Class(goldbook:14153))
AnnotationAssertion(rdfs:label goldbook:14153 "label-free assay")
AnnotationAssertion(dcterms:description goldbook:14153 "Assay in which there is no requirement to modify one of the interacting components in order to facilitate signal detection.")
Declaration(Class(goldbook:14154))
AnnotationAssertion(rdfs:label goldbook:14154 "label-free detection")
AnnotationAssertion(dcterms:description goldbook:14154 "Direct detection of compound activity on a target without the requirement for a labeled reagent.")
Declaration(Class(goldbook:14155))
AnnotationAssertion(rdfs:label goldbook:14155 "lead identification")
AnnotationAssertion(dcterms:description goldbook:14155 "Process that is targeted toward the generation of at least one compound series that meets the requirements for progression to lead optimization.")
Declaration(Class(goldbook:14156))
AnnotationAssertion(rdfs:label goldbook:14156 "lead optimisation")
AnnotationAssertion(dcterms:description goldbook:14156 "Process in which the drug-like properties of an initial lead or lead series are improved.")
Declaration(Class(goldbook:14157))
AnnotationAssertion(rdfs:label goldbook:14157 "library")
AnnotationAssertion(dcterms:description goldbook:14157 """Collection of samples (e.g., chemical compounds, natural products, over-expression library of a microbe) available for screening.
Set of compounds produced through combinatorial chemistry or other means that expands around a single core structure.""")
Declaration(Class(goldbook:14158))
AnnotationAssertion(rdfs:label goldbook:14158 "ligand-activated channel")
AnnotationAssertion(dcterms:description goldbook:14158 "Any ion channel that is gated (i.e., opened or closed) by a ligand.")
Declaration(Class(goldbook:14159))
AnnotationAssertion(rdfs:label goldbook:14159 "liquid handler")
AnnotationAssertion(dcterms:description goldbook:14159 "Automated device that accurately and precisely delivers programmed, predefined quantities of liquid to a microplate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14159 "liquid handling machine")
Declaration(Class(goldbook:14160))
AnnotationAssertion(rdfs:label goldbook:14160 "luminescence assay")
AnnotationAssertion(dcterms:description goldbook:14160 "Assay in which response is measured by the detection of light of a nonradiative origin, such as bioluminescence or chemiluminescence.")
Declaration(Class(goldbook:14161))
AnnotationAssertion(rdfs:label goldbook:14161 "microplate")
AnnotationAssertion(dcterms:description goldbook:14161 "Any of a number of plates containing a series of wells which may be used for storage or to perform individual assays.")
Declaration(Class(goldbook:14162))
AnnotationAssertion(rdfs:label goldbook:14162 "microplate standards")
AnnotationAssertion(dcterms:description goldbook:14162 "Defined footprint, height, flanges, and well positions for 96-, 384-, and 1536-well microplates.")
Declaration(Class(goldbook:14163))
AnnotationAssertion(rdfs:label goldbook:14163 "miniaturisation")
AnnotationAssertion(dcterms:description goldbook:14163 "Experimental design aimed at decreasing the reaction volume of an assay and consequently the amount and cost of reagents.")
Declaration(Class(goldbook:14164))
AnnotationAssertion(rdfs:label goldbook:14164 "module")
AnnotationAssertion(dcterms:description goldbook:14164 "Individual automated device within a fully automated assay system that usually performs a complete single assay step or procedure.")
Declaration(Class(goldbook:14165))
AnnotationAssertion(rdfs:label goldbook:14165 "molecular imprinted polymers")
AnnotationAssertion(dcterms:description goldbook:14165 "Synthetic polymers in which well-defined volume cavities (imprints) created by template molecules mimic a biomolecular specific ligand–receptor interaction.")
Declaration(Class(goldbook:14166))
AnnotationAssertion(rdfs:label goldbook:14166 "multiplex assay")
AnnotationAssertion(dcterms:description goldbook:14166 "Assay in which the activity of a single sample against more than one target is measured in a single test.")
Declaration(Class(goldbook:14167))
AnnotationAssertion(rdfs:label goldbook:14167 "natural product")
AnnotationAssertion(dcterms:description goldbook:14167 """Complex mixture derived from natural (biological) sources used in screening as a resource for identification of lead compounds.
Pure compound of natural (biological) origin (whether obtained by purification of natural mixtures or by laboratory synthesis), as opposed to compounds originating from synthetic chemistry.Note: Typical origins include extracts from microbes and higher organisms from terrestrial or marine environments.""")
Declaration(Class(goldbook:14168))
AnnotationAssertion(rdfs:label goldbook:14168 "negative assay control")
AnnotationAssertion(dcterms:description goldbook:14168 "Experimental conditions designed to produce the signal reflective of the absence of the process under investigation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14168 "low control")
Declaration(Class(goldbook:14169))
AnnotationAssertion(rdfs:label goldbook:14169 "noncompetitive binding assay")
AnnotationAssertion(dcterms:description goldbook:14169 "Assay in which the interaction of a ligand with a receptor is measured without a requirement for added competing agents. It can be homogeneous or heterogeneous.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14169 "indirect binding assay")
Declaration(Class(goldbook:14170))
AnnotationAssertion(rdfs:label goldbook:14170 "nuclease assay")
AnnotationAssertion(dcterms:description goldbook:14170 "Method used to determine the presence or quantify the amount of specific target nucleotide sequences.")
Declaration(Class(goldbook:14171))
AnnotationAssertion(rdfs:label goldbook:14171 "off-rate")
AnnotationAssertion(dcterms:description goldbook:14171 "Rate of dissociation of the enzyme-substrate (\\(\\ce{ES}\\)) complex to enzyme (\\(\\ce{E}\\)) and substrate (\\(\\ce{S}\\)) or of ligand–receptor (\\(\\ce{LR}\\)) to receptor (\\(\\ce{R}\\)) and ligand (\\(\\ce{L}\\)).")
Declaration(Class(goldbook:14172))
AnnotationAssertion(rdfs:label goldbook:14172 "on-rate")
AnnotationAssertion(dcterms:description goldbook:14172 "Rate of formation of the enzyme-substrate (\\(\\ce{ES}\\)) or ligand–receptor (\\(\\ce{LR}\\)) complex.")
Declaration(Class(goldbook:14173))
AnnotationAssertion(rdfs:label goldbook:14173 "orthosteric site")
AnnotationAssertion(dcterms:description goldbook:14173 "Binding site recognized by the endogenous agonist of a receptor.")
Declaration(Class(goldbook:14174))
AnnotationAssertion(rdfs:label goldbook:14174 "partial agonist")
AnnotationAssertion(dcterms:description goldbook:14174 "Agonist that is unable to induce a maximal receptor response in a given biological assay, regardless of the amount applied.")
Declaration(Class(goldbook:14175))
AnnotationAssertion(rdfs:label goldbook:14175 "pipettor")
AnnotationAssertion(dcterms:description goldbook:14175 "Device that aspirates and dispenses liquid (\\(\\pu{nL}\\) to \\(\\pu{mL}\\) range) for the purposes of transferring from a source to destination.")
Declaration(Class(goldbook:14176))
AnnotationAssertion(rdfs:label goldbook:14176 "plate format")
AnnotationAssertion(dcterms:description goldbook:14176 "Number and configuration of wells on a microplate.")
Declaration(Class(goldbook:14177))
AnnotationAssertion(rdfs:label goldbook:14177 "plate gripper")
AnnotationAssertion(dcterms:description goldbook:14177 "Handling device that positions microplates on a workstation.")
Declaration(Class(goldbook:14178))
AnnotationAssertion(rdfs:label goldbook:14178 "plate map")
AnnotationAssertion(dcterms:description goldbook:14178 "Layout of samples and controls configured on a plate during an assay.")
Declaration(Class(goldbook:14179))
AnnotationAssertion(rdfs:label goldbook:14179 "plate reader")
AnnotationAssertion(dcterms:description goldbook:14179 "Automated device that uses optical and/or computer vision techniques to detect biological, chemical, or physical events in samples stored in microplates.")
Declaration(Class(goldbook:14180))
AnnotationAssertion(rdfs:label goldbook:14180 "plate stacker")
AnnotationAssertion(dcterms:description goldbook:14180 "Automated device that loads, unloads, and restacks microplates.")
Declaration(Class(goldbook:14181))
AnnotationAssertion(rdfs:label goldbook:14181 "plate washer")
AnnotationAssertion(dcterms:description goldbook:14181 "Automated device used to wash the wells of microplates.")
Declaration(Class(goldbook:14182))
AnnotationAssertion(rdfs:label goldbook:14182 "positive assay control")
AnnotationAssertion(dcterms:description goldbook:14182 "Experimental conditions designed to produce the signal reflective of maximum biological effect in an assay.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14182 "high control")
Declaration(Class(goldbook:14183))
AnnotationAssertion(rdfs:label goldbook:14183 "potency")
AnnotationAssertion(dcterms:description goldbook:14183 "Dose of drug required to produce a specific effect of given intensity as compared to a standard reference.")
Declaration(Class(goldbook:14184))
AnnotationAssertion(rdfs:label goldbook:14184 "primary screen")
AnnotationAssertion(dcterms:description goldbook:14184 "Initial screen applied to assess the activity of a collection of compounds and identify hits or actives against a biological target of interest.")
Declaration(Class(goldbook:14185))
AnnotationAssertion(rdfs:label goldbook:14185 "radioligand")
AnnotationAssertion(dcterms:description goldbook:14185 "Ligand into which a radioisotope has been incorporated as a label.")
Declaration(Class(goldbook:14186))
AnnotationAssertion(rdfs:label goldbook:14186 "robot")
AnnotationAssertion(dcterms:description goldbook:14186 "Automated device that performs tasks (i.e., screen functions) that would normally be performed by a human.")
Declaration(Class(goldbook:14187))
AnnotationAssertion(rdfs:label goldbook:14187 "scheduling software")
AnnotationAssertion(dcterms:description goldbook:14187 "Computer program used to organize the chronological sequence of experimental methods to be followed to execute an automated high-throughput screening campaign.")
Declaration(Class(goldbook:14188))
AnnotationAssertion(rdfs:label goldbook:14188 "scintillation proximity assay")
AnnotationAssertion(dcterms:description goldbook:14188 "Homogeneous assay in which beads incorporated with scintillant emit light in the presence of radiolabeled molecules within the proximity of the bead’s scintillant detection.")
Declaration(Class(goldbook:14189))
AnnotationAssertion(rdfs:label goldbook:14189 "screen")
AnnotationAssertion(dcterms:description goldbook:14189 "Execution, analysis, and interpretation of a large number of assays to evaluate the activity of a collection of samples against a target.")
Declaration(Class(goldbook:14190))
AnnotationAssertion(rdfs:label goldbook:14190 "screen validation")
AnnotationAssertion(dcterms:description goldbook:14190 "Assay conditions, as determined by assay validation, are performed in the chosen plate format with an acceptable signal to background ratio as described by the Z′ factor.")
Declaration(Class(goldbook:14191))
AnnotationAssertion(rdfs:label goldbook:14191 "secondary screen")
AnnotationAssertion(dcterms:description goldbook:14191 "Screen applied to independently confirm actives from the primary screen.")
Declaration(Class(goldbook:14192))
AnnotationAssertion(rdfs:label goldbook:14192 "selectivity assay")
AnnotationAssertion(dcterms:description goldbook:14192 "Assay used to determine the relative potency of active or lead compounds toward an alternative target.")
Declaration(Class(goldbook:14193))
AnnotationAssertion(rdfs:label goldbook:14193 "stably transfected cells")
AnnotationAssertion(dcterms:description goldbook:14193 "Eukaryotic cells into which recombinant DNA has been introduced and incorporated into the genome, so that the cells replicate the new DNA in a stable fashion.")
Declaration(Class(goldbook:14194))
AnnotationAssertion(rdfs:label goldbook:14194 "standard error of the mean")
AnnotationAssertion(dcterms:description goldbook:14194 "Sample standard deviation divided by the square root of the sample size.")
Declaration(Class(goldbook:14195))
AnnotationAssertion(rdfs:label goldbook:14195 "sublibrary")
AnnotationAssertion(dcterms:description goldbook:14195 "Portion of a library that is grouped or selected based on similarity of structure or biological effect.")
Declaration(Class(goldbook:14196))
AnnotationAssertion(rdfs:label goldbook:14196 "surface plasmon resonance assay")
AnnotationAssertion(dcterms:description goldbook:14196 "Assay in which the binding of a ligand to a target immobilized on the gold surface of a chip is detected by changes in the angle of the light reflected from the surface.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14196 "SPR Assay")
Declaration(Class(goldbook:14197))
AnnotationAssertion(rdfs:label goldbook:14197 "targeted library")
AnnotationAssertion(dcterms:description goldbook:14197 "Library designed, on the basis of preexisting information, to generate enhanced activity or hit rate against a particular biological target or target class.")
Declaration(Class(goldbook:14198))
AnnotationAssertion(rdfs:label goldbook:14198 "total internal reflection fluorescence")
AnnotationAssertion(dcterms:description goldbook:14198 "Spectroscopic technique that discriminates between labeled molecules in the homogeneous phase and those interacting with binding partners immobilized at a surface.")
Declaration(Class(goldbook:14199))
AnnotationAssertion(rdfs:label goldbook:14199 "transiently transfected cells")
AnnotationAssertion(dcterms:description goldbook:14199 "Eukaryotic cells into which recombinant DNA has been introduced and expressed by cellular transcription, but without incorporation into the stable genome.")
Declaration(Class(goldbook:14200))
AnnotationAssertion(rdfs:label goldbook:14200 "ultra-high throughput")
AnnotationAssertion(dcterms:description goldbook:14200 "Relative term, currently applied to the screening of \\(\\pu{E5}\\) test samples in a \\(\\pu{24\\!\\mbox{-}h}\\) period.")
Declaration(Class(goldbook:14201))
AnnotationAssertion(rdfs:label goldbook:14201 "voltage-activated channel")
AnnotationAssertion(dcterms:description goldbook:14201 "Ion channel that is specifically activated, or gated, by the surrounding potential difference across the cell membrane near the channel (or near the cell, neuron, or synapse).")
Declaration(Class(goldbook:14202))
AnnotationAssertion(rdfs:label goldbook:14202 "workstation")
AnnotationAssertion(dcterms:description goldbook:14202 "Programmable device used to automate a single operation (such as liquid handling) on a microplate supplied to the device by a robot (automated stacker system or a robotic manipulator).")
Declaration(Class(goldbook:14203))
AnnotationAssertion(rdfs:label goldbook:14203 "Z factor")
AnnotationAssertion(dcterms:description goldbook:14203 "Dimensionless statistical parameter that provides a practical assessment of assay performance in the presence of test compounds. \\[Z = 1 - 3(\\sigma_{\\rm{s}} + \\sigma_{\\rm{c}})/\\vert\\mu_{\\rm{s}} - \\mu_{\\rm{c}}\\vert\\] where \\(\\mu_{\\rm{s}}\\) denotes the mean of the library sample signal, \\(\\mu_{\\rm{c}}\\) the mean of the control signal and \\(\\sigma_{\\rm{s}}\\), \\(\\sigma_{\\rm{c}}\\) the corresponding standard deviations. \\(1 \\gt Z \\ge 0.5\\) generally categorizes an excellent assay.")
Declaration(Class(goldbook:14204))
AnnotationAssertion(rdfs:label goldbook:14204 "Z′ factor")
AnnotationAssertion(dcterms:description goldbook:14204 """Dimensionless statistical parameter used extensively in biomolecular screening, and a characteristic of an assay without the intervention of test compounds. It provides a practical index of the quality and reliability of the assay, and can be used as a guide to assay development and optimization. \\[Z' = 1 - 3(\\sigma_{\\rm{c^{+}}} + \\sigma_{\\rm{c^{-}}})/(\\vert\\mu_{\\rm{c^{+}}} - \\mu_{\\rm{c^{-}}}\\vert)\\] where \\(\\sigma_{\\rm{c^{+}}}\\) and \\(\\sigma_{\\rm{c^{-}}}\\) are the standard deviations of the high and low controls and \\(\\mu_{\\rm{c^{+}}}\\) and \\(\\mu_{\\rm{c^{-}}}\\) are the means of the high and low controls, respectively.
A graphical illustration of the parameters used in the calculation of \\(Z'\\) is provided below.""")
Declaration(Class(goldbook:14205))
AnnotationAssertion(rdfs:label goldbook:14205 "two-phase model")
AnnotationAssertion(dcterms:description goldbook:14205 "Model based on the assumption that the polymer sample consists only of domains of a crystalline phase and of an amorphous phase.")
Declaration(Class(goldbook:14206))
AnnotationAssertion(rdfs:label goldbook:14206 "axial advancement per constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:14206 "Projected length of a constitutional repeating unit (CRU) on the chain axis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14206 "unit height")
Declaration(Class(goldbook:14207))
AnnotationAssertion(rdfs:label goldbook:14207 "directional chain")
AnnotationAssertion(dcterms:description goldbook:14207 "Polymer chain that may be oriented in two distinguishable, opposite directions along the chain axis.")
Declaration(Class(goldbook:14208))
AnnotationAssertion(rdfs:label goldbook:14208 "directional stem")
AnnotationAssertion(dcterms:description goldbook:14208 "Stem of a directional chain.")
Declaration(Class(goldbook:14209))
AnnotationAssertion(rdfs:label goldbook:14209 "helix pitch")
AnnotationAssertion(dcterms:description goldbook:14209 "Distance between successive helical windings projected on the chain axis.")
Declaration(Class(goldbook:14210))
AnnotationAssertion(rdfs:label goldbook:14210 "ideal crystalline chain conformation")
AnnotationAssertion(dcterms:description goldbook:14210 "Minimum energy conformation of an isolated polymer chain constructed according to the equivalence postulate and approximating the conformation found in a crystalline phase.")
Declaration(Class(goldbook:14211))
AnnotationAssertion(rdfs:label goldbook:14211 "left-handed helix")
AnnotationAssertion(dcterms:description goldbook:14211 "Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds clockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period).")
Declaration(Class(goldbook:14212))
AnnotationAssertion(rdfs:label goldbook:14212 "multiple helix")
AnnotationAssertion(dcterms:description goldbook:14212 "Helical arrangement comprising two or more intertwined helical chains sharing the same axis.")
Declaration(Class(goldbook:14213))
AnnotationAssertion(rdfs:label goldbook:14213 "right-handed helix")
AnnotationAssertion(dcterms:description goldbook:14213 "Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds anticlockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period).")
Declaration(Class(goldbook:14214))
AnnotationAssertion(rdfs:label goldbook:14214 "rod group")
AnnotationAssertion(dcterms:description goldbook:14214 "Symmetry group of a three-dimensional array of atoms, regularly repeating along one direction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14214 "line repetition group")
Declaration(Class(goldbook:14215))
AnnotationAssertion(rdfs:label goldbook:14215 "rotation per helix residue")
