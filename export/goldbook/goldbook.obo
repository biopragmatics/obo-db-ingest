[Term]
id: goldbook:A00143
name: adiabatic ionization
def: "A process whereby an electron is either removed from or added to an atom or molecule producing an ion in its ground state."
property_value: mito:isMentionedBy doi:10.1351/pac199163101541
property_value: hasStatus "current" xsd:string
