AnnotationAssertion(obo:goldbook#hasStatus goldbook:13169 "current"^^xsd:string)
Declaration(Class(goldbook:13170))
AnnotationAssertion(rdfs:label goldbook:13170 "germ-free")
AnnotationAssertion(dcterms:description goldbook:13170 "Descriptor applied to animals (usually mice) raised in the complete absence of intestinal and other microorganisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13170 "gnotobiotic")
AnnotationAssertion(rdfs:comment goldbook:13170 "Such mice have very depleted immune systems, but they can respond normally to any specific antigen, provided it is mixed with a strong adjuvant."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13170 goldbook:13271)
AnnotationAssertion(mito:isMentionedBy goldbook:13170 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13170 "current"^^xsd:string)
Declaration(Class(goldbook:13171))
AnnotationAssertion(rdfs:label goldbook:13171 "germ line")
AnnotationAssertion(dcterms:description goldbook:13171 "Referring to genes in their unrearranged state rather than those rearranged for production of immunoglobulin (Ig) or T-cell receptor (TCR) molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13171 "in immunology")
AnnotationAssertion(rdfs:seeAlso goldbook:13171 goldbook:13714)
AnnotationAssertion(mito:isMentionedBy goldbook:13171 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13171 "current"^^xsd:string)
Declaration(Class(goldbook:13172))
AnnotationAssertion(rdfs:label goldbook:13172 "germinal center")
AnnotationAssertion(dcterms:description goldbook:13172 "Discrete area within lymph nodes and spleen where B-cell maturation and memory development occur.")
AnnotationAssertion(rdfs:seeAlso goldbook:13172 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13172 goldbook:13397)
AnnotationAssertion(rdfs:seeAlso goldbook:13172 goldbook:13447)
AnnotationAssertion(rdfs:seeAlso goldbook:13172 goldbook:13451)
