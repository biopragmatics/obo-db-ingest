AnnotationAssertion(dcterms:description goldbook:11877 "Abnormal contraction of the pupil of the eye to less than \\(\\pu{2 mm}\\).")
AnnotationAssertion(rdfs:comment goldbook:11877 "Miosis may indicate organophosphate poisoning or opiate intake."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11877 doi:10.1515/pac-2015-0103)
