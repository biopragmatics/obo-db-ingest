AnnotationAssertion(obo:goldbook#hasStatus goldbook:16127 "current"^^xsd:string)
Declaration(Class(goldbook:16128))
AnnotationAssertion(rdfs:label goldbook:16128 "tachypnoea")
AnnotationAssertion(dcterms:description goldbook:16128 "Abnormally fast breathing.")
AnnotationAssertion(rdfs:seeAlso goldbook:16128 goldbook:15523)
AnnotationAssertion(mito:isMentionedBy goldbook:16128 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16128 "current"^^xsd:string)
