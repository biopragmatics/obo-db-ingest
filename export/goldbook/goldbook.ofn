AnnotationAssertion(dcterms:description goldbook:13352 "Tyrosine kinase activated by cytokines binding to cell receptors.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:13352 "JAK")
AnnotationAssertion(rdfs:seeAlso goldbook:13352 goldbook:13350)
