Declaration(Class(goldbook:FT07383))
AnnotationAssertion(rdfs:label goldbook:FT07383 "frequency")
AnnotationAssertion(dcterms:description goldbook:FT07383 "The number of waveperiods per time interval. The linear frequency, \\( u\\), is the number of cycles per time interval. SI unit \\(\\rm{Hz =  s}^{-1}\\).")
AnnotationAssertion(rdfs:comment goldbook:FT07383 "For the angular frequency the symbol \\(\\omega\\) (\\(= 2\\pi\\nu\\)) is used with \\(\\rm{rad s}^{-1}\\) as the SI unit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07383 goldbook:A00352)
