AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13409 "lymphopenia")
AnnotationAssertion(rdfs:comment goldbook:13409 "This is a characteristic feature of systemic autoimmune diseases [e.g., systemic lupus erythematosus (SLE), Sjögren syndrome, mixed connective tissue disease (MCTD)]."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13409 goldbook:13680)
