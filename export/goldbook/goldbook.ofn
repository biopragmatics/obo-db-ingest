AnnotationAssertion(rdfs:label goldbook:15612 "cross-sectional study")
AnnotationAssertion(dcterms:description goldbook:15612 "Study that examines the relationship between diseases (or other health-related characteristics) and other variables of interest as they exist in a defined population at one particular time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15612 "disease frequency survey")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15612 "prevalence study")
AnnotationAssertion(rdfs:comment goldbook:15612 "Disease prevalence rather than incidence is normally recorded in a cross-sectional study and the temporal sequence of cause and effect cannot necessarily be determined."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15612 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15612 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15612 "current"^^xsd:string)
Declaration(Class(goldbook:15613))
AnnotationAssertion(rdfs:label goldbook:15613 "cumulative death rate")
AnnotationAssertion(dcterms:description goldbook:15613 "Proportion of a defined group that dies within the specified time period (e.g., month, year).")
AnnotationAssertion(rdfs:comment goldbook:15613 "It may refer to all deaths or to deaths from a specific cause or specific causes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15613 goldbook:16098)
AnnotationAssertion(mito:isMentionedBy goldbook:15613 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15613 "current"^^xsd:string)
Declaration(Class(goldbook:15614))
AnnotationAssertion(rdfs:label goldbook:15614 "cumulative effect")
AnnotationAssertion(dcterms:description goldbook:15614 "Overall change that occurs after repeated doses of a substance or radiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:15614 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15614 "current"^^xsd:string)
Declaration(Class(goldbook:15615))
AnnotationAssertion(rdfs:label goldbook:15615 "cumulative incidence")
AnnotationAssertion(dcterms:description goldbook:15615 "Number or proportion of individuals in a group who experience the onset of a health-related event during a specified time interval.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15615 "incidence proportion")
AnnotationAssertion(rdfs:comment goldbook:15615 "This interval is generally the same for all members of the group, but, as in lifetime incidence, it may vary from person to person without reference to age."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15615 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15615 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15615 "current"^^xsd:string)
Declaration(Class(goldbook:15616))
AnnotationAssertion(rdfs:label goldbook:15616 "cumulative incidence rate")
AnnotationAssertion(dcterms:description goldbook:15616 "Proportion of the cumulative incidence to the total population.")
AnnotationAssertion(rdfs:seeAlso goldbook:15616 goldbook:15615)
AnnotationAssertion(mito:isMentionedBy goldbook:15616 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15616 "current"^^xsd:string)
Declaration(Class(goldbook:15617))
AnnotationAssertion(rdfs:label goldbook:15617 "cumulative incidence ratio")
AnnotationAssertion(dcterms:description goldbook:15617 "Value obtained by dividing the cumulative incidence rate in the exposed population by the cumulative incidence rate in the unexposed population.")
AnnotationAssertion(rdfs:seeAlso goldbook:15617 goldbook:15616)
AnnotationAssertion(rdfs:seeAlso goldbook:15617 goldbook:15695)
AnnotationAssertion(mito:isMentionedBy goldbook:15617 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15617 "current"^^xsd:string)
