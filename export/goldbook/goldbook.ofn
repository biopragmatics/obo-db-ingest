AnnotationAssertion(obo:goldbook#hasStatus goldbook:16159 "current"^^xsd:string)
Declaration(Class(goldbook:16160))
AnnotationAssertion(rdfs:label goldbook:16160 "toxicophoric group")
AnnotationAssertion(dcterms:description goldbook:16160 "Structural moiety that upon metabolic activation exerts toxic effects: The presence of a toxicophoric group indicates only potential and not necessarily actual toxicity of a drug or other substances.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16160 "toxogenic group")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16160 "toxophoric group")
AnnotationAssertion(mito:isMentionedBy goldbook:16160 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16160 "current"^^xsd:string)
Declaration(Class(goldbook:16161))
AnnotationAssertion(rdfs:label goldbook:16161 "toxicovigilance")
AnnotationAssertion(dcterms:description goldbook:16161 "Active process of identification, investigation, and evaluation of various toxic effects in the community with a view to taking measures to reduce or control exposure(s) involving the substance(s) which produces these effects.")
AnnotationAssertion(mito:isMentionedBy goldbook:16161 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16161 "current"^^xsd:string)
Declaration(Class(goldbook:16162))
AnnotationAssertion(rdfs:label goldbook:16162 "toxification")
AnnotationAssertion(dcterms:description goldbook:16162 "Metabolic conversion of a potentially toxic substance to a product that is more toxic.")
AnnotationAssertion(mito:isMentionedBy goldbook:16162 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16162 "current"^^xsd:string)
Declaration(Class(goldbook:16163))
AnnotationAssertion(rdfs:label goldbook:16163 "tracer substance")
AnnotationAssertion(dcterms:description goldbook:16163 "Substance that can be tracked through one or more reactions or systems, often by detecting an incorporated isotope.")
AnnotationAssertion(mito:isMentionedBy goldbook:16163 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16163 "current"^^xsd:string)
Declaration(Class(goldbook:16164))
