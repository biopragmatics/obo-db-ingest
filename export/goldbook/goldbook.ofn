AnnotationAssertion(obo:goldbook#hasStatus goldbook:08963 "current"^^xsd:string)
Declaration(Class(goldbook:08964))
AnnotationAssertion(rdfs:label goldbook:08964 "mediating agent")
AnnotationAssertion(dcterms:description goldbook:08964 "Species that mediates polymerization in reversible-deactivation polymerization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08964 "mediator")
AnnotationAssertion(rdfs:seeAlso goldbook:08964 goldbook:08968)
AnnotationAssertion(rdfs:seeAlso goldbook:08964 goldbook:08935)
