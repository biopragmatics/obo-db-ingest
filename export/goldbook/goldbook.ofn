Declaration(Class(goldbook:14237))
AnnotationAssertion(rdfs:label goldbook:14237 "homopolymer isomorphism")
AnnotationAssertion(dcterms:description goldbook:14237 "Macromolecular isomorphism involving two homopolymers with different constitutional repeating units.")
Declaration(Class(goldbook:14238))
AnnotationAssertion(rdfs:label goldbook:14238 "nanoporous polymer crystal")
AnnotationAssertion(dcterms:description goldbook:14238 "Polymer crystal presenting empty volume elements that can host low-molar-mass guest species.")
Declaration(Class(goldbook:14239))
AnnotationAssertion(rdfs:label goldbook:14239 "polymer clathrate")
