AnnotationAssertion(dcterms:description goldbook:11338 "Paired artery that, in the fetus, returns deoxygenated blood from each half of the fetal body to the placenta, via the umbilical cord.")
AnnotationAssertion(rdfs:comment goldbook:11338 "In the adult, part of the umbilical artery remains open as a branch of the internal iliac artery, and part ceases to be an artery and becomes the medial umbilical ligament."^^xsd:string)
