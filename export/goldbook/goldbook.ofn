AnnotationAssertion(rdfs:label goldbook:Q04986 "quantum")
AnnotationAssertion(dcterms:description goldbook:Q04986 "An elementary particle of electromagnetic energy in the sense of the wave-particle duality.")
AnnotationAssertion(rdfs:seeAlso goldbook:Q04986 goldbook:P04627)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04986 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04986 "current"^^xsd:string)
Declaration(Class(goldbook:Q04987))
AnnotationAssertion(rdfs:label goldbook:Q04987 "quantum counter")
AnnotationAssertion(dcterms:description goldbook:Q04987 "A medium emitting with a quantum yield independent of the excitation energy over a defined spectral range (e.g, concentrated rhodamine 6G solutions between \\(300\\) and \\(600\\ \\rm{nm}\\)). Also used for devices producing an electrical signal proportional to the photon flux absorbed in a medium.")
AnnotationAssertion(rdfs:seeAlso goldbook:Q04987 goldbook:E02250)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04987 goldbook:P04636)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04987 goldbook:Q04991)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04987 doi:10.1351/pac198456020231)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04987 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04987 "current"^^xsd:string)
Declaration(Class(goldbook:Q04988))
AnnotationAssertion(rdfs:label goldbook:Q04988 "quantum efficiency")
AnnotationAssertion(dcterms:description goldbook:Q04988 "For a primary photochemical process, quantum efficiency is identical to quantum yield.")
AnnotationAssertion(rdfs:seeAlso goldbook:Q04988 goldbook:E01902)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04988 goldbook:P04839)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04988 goldbook:Q04991)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04988 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04988 "current"^^xsd:string)
Declaration(Class(goldbook:Q04991))
AnnotationAssertion(rdfs:label goldbook:Q04991 "quantum yield")
AnnotationAssertion(dcterms:description goldbook:Q04991 "The integral quantum yield is \\[\\mathit{\\Phi}(\\lambda) = \\frac{\\rm{number\\ of\\ events}}{\\rm{number\\ of\\ photons\\ absorbed}}\\] For a photochemical reaction, \\[\\mathit{\\Phi}(\\lambda) = \\frac{\\rm{amount\\ of\\ reactant\\ consumed\\ or\\ product\\ formed}}{\\rm{number\\ of\\ photons\\ absorbed}}\\] The differential quantum yield is \\[\\mathit{\\Phi}(\\lambda) = \\frac{{\\rm{d}}x/{\\rm{d}}t}{q_{n,{\\rm{p}}}^{0}[ 1 - 10^{-A(\\lambda)} ]}\\] where \\({\\rm{d}}x/{\\rm{d}}t\\) is the rate of change of a measurable quantity (spectral or any other property), and \\(q_{n\\rm{,p}}^{0}\\) the amount of photons (\\(\\pu{mol}\\) or its equivalent \\(\\rm{einstein}\\)) incident (prior to absorption) per time interval (photon flux, amount basis). \\(A(\\lambda)\\) is the absorbance at the excitation wavelength.")
AnnotationAssertion(rdfs:comment goldbook:Q04991 "Strictly, the term quantum yield applies only for monochromatic excitation. Thus, for the differential quantum yield, the absorbed spectral photon flux density (number basis or amount basis) should be used in the denominator of the equation above when \\(x\\) is either the number concentration (\\(C = N/V\\)), or the amount concentration (\\(c\\)), respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:Q04991 "\\(\\mathit{\\Phi}\\) can be used for photophysical processes (such as, e.g., intersystem crossing, fluorescence and phosphorescence) or photochemical reactions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:A00028)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:A00295)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:I03123)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:M03788)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:P04569)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:P04585)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:P04647)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04991 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04991 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04991 "current"^^xsd:string)
Declaration(Class(goldbook:Q04992))
AnnotationAssertion(rdfs:label goldbook:Q04992 "quarter-transition-time potential")
AnnotationAssertion(dcterms:description goldbook:Q04992 "In chronopotentiometry (at constant current density), the potential of the indicator electrode at the instant when the time that has elapsed since the application of current is equal to one-fourth of the transition time. Appropriate correction for double-layer charging is needed in practice.")
AnnotationAssertion(rdfs:seeAlso goldbook:Q04992 goldbook:C01452)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04992 goldbook:L03488)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04992 goldbook:I03006)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04992 goldbook:T06472)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04992 doi:10.1351/pac198557101491)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04992 "current"^^xsd:string)
Declaration(Class(goldbook:Q04993))
AnnotationAssertion(rdfs:label goldbook:Q04993 "quartet state")
AnnotationAssertion(dcterms:description goldbook:Q04993 "A state having a total electron spin quantum number equal to \\(\\frac{3}{2}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:Q04993 goldbook:M04062)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04993 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04993 "current"^^xsd:string)
Declaration(Class(goldbook:Q04994))
AnnotationAssertion(rdfs:label goldbook:Q04994 "quartz–iodine lamp")
AnnotationAssertion(dcterms:description goldbook:Q04994 "Wolfram (tungsten) filament high-intensity incandescent lamp containing iodine in a quartz envelope. Used primarily as a source of visible radiation.")
AnnotationAssertion(rdfs:comment goldbook:Q04994 "In halogen lamps, the quartz envelope is closer to the filament than the glass used in conventional light bulbs. Heating the filament to a high temperature causes the tungsten (wolfram) atoms to evaporate and combine with the halogen gas. These heavier molecules are then deposited back on the filament surface. This recycling process increases the life of the tungsten (wolfram) filament and enables the lamp to produce more light per unit of input energy. Consequently, halogen lamps are used in a variety of applications, including automobile headlights."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:Q04994 "Halogens other than iodine may be used in these lamps."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04994 goldbook:L03447)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04994 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:Q04994 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04994 "current"^^xsd:string)
Declaration(Class(goldbook:Q04996))
AnnotationAssertion(rdfs:label goldbook:Q04996 "quasi-classical trajectory method")
AnnotationAssertion(dcterms:description goldbook:Q04996 "A procedure for calculating trajectories in which the quantization of the reactants is taken into account, but in which the course of the reaction is treated classically.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:Q04996 "QCT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:Q04996 "QCT method")
AnnotationAssertion(mito:isMentionedBy goldbook:Q04996 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:Q04996 "current"^^xsd:string)
Declaration(Class(goldbook:Q04997))
AnnotationAssertion(rdfs:label goldbook:Q04997 "quasi-enantiomers")
AnnotationAssertion(dcterms:description goldbook:Q04997 "Constitutionally different yet closely related chemical species MX and MY having the opposite chirality sense of the large common chiral moiety M. For example (R)-2-bromobutane is a quasi-enantiomer of (S)-2-chlorobutane.")
AnnotationAssertion(rdfs:seeAlso goldbook:Q04997 goldbook:C01057)
AnnotationAssertion(rdfs:seeAlso goldbook:Q04997 goldbook:C01063)
