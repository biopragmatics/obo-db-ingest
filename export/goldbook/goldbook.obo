id: goldbook:I03069
name: integral detector
def: "A device which measures the accumulated quantity of sample component\(s\) reaching the detector."
property_value: mito:isMentionedBy doi:10.1351/pac199365040819
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:I03070
name: integrating sphere
def: "A hollow sphere having a highly reflecting inside surface used as a device to collect\, with very high efficiency\, light scattered or emitted from a sample contained in it or located outside and near one of the ports. Small ports allow the entrance of light and access to a detector."
property_value: mito:isMentionedBy doi:10.1351/pac199668122223
