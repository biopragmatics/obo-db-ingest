    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10365">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence or abnormal stoppage of menstruation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>menostasis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>amenorrhea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10937"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10366 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10366">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transabdominal procedure in which amniotic fluid is sampled by means of a needle inserted into the amniotic sac.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This procedure is used to screen for infections and abnormalities in the developing fetus.</rdfs:comment>
        <rdfs:label>amniocentesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10371"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10367 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10367">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Composite membrane, formed by fusion of the amnion, interiorly, with the outer chorion that surrounds the developing fetus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>amniochorionic membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10368 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10368">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane that lines the amniotic cavity (amniotic sac) and encloses the embryo of a mammal, bird, or reptile.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>amnion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10370"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10371"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10369 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10369">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any vertebrate animal, such as a reptile, bird, or mammal, that possesses an amnion, chorion, and allantois during embryonic development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>amniote</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10356"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10376"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10370 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10370">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fluid-filled space that surrounds the developing embryo of a mammal, bird, or reptile, bounded by the amniotic sac.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>amniotic cavity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10371"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10371 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10371">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membranous structure in amniotes, within which the embryo and fetus develop.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>It consists of a thin but tough, transparent pair of membranes, the amnion and chorion, that hold the developing embryo (and later fetus) until shortly before birth.</rdfs:comment>
        <rdfs:label>amniotic sac</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10369"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10372 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10372">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a frog (often _027793_) is exposed to a substance starting at the tadpole stage, and the growth and development of the animals is studied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>amphibian metamorphosis assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10716"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10373 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10373">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Flask-like dilatation of a canal or duct.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ampulla</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10484"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10374 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10374">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Terminal part of the large intestine between the rectum and anus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The anal canal arises as the dorsal cavity of the cloaca after division of the cloaca by the urorectal septum, the ventral cavity becoming the urogenital sinus.</rdfs:comment>
        <rdfs:label>anal canal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10375"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10537"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11345"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10375 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10375">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In the embryo, dorsal part of the cloacal membrane after its division of the urorectal septum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anal membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10538"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10615"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10376 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10376">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any vertebrate animal, such as a fish or amphibian, that lacks an amnion, chorion, and allantois during embryonic development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anamniote</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10356"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10369"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10377 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10377">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stage of mitosis and meiosis in which the chromosomes move from the equatorial plate toward opposite ends of the nuclear spindle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anaphase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11022"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10378 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10378">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Slowing or stopping of normal migration of chromosomes during anaphase, resulting in chromosomes being excluded from one of the daughter cells causing aneuploidy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anaphase lag</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10377"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10394"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10379 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10379">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generalized edema in the subcutaneous connective tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>dropsy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hydrosarca</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Anasarca may be congenital (whole body edema) caused by liver failure, renal failure, right-sided heart failure, or severe malnutrition with resultant protein deficiency.</rdfs:comment>
        <rdfs:label>anasarca</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10638"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10380 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10380">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Connection creating continuity between two tubular body structures, e.g. blood vessels or loops of bowel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>An anastomosis may be a surgical construction (as when the two cut ends are joined following resection of a loop of bowel), may result from trauma, or may occur as a natural anatomic feature, typically involving blood vessels (as in an arteriovenous anastomosis bypassing a capillary bed; see arteriovenous shunt).</rdfs:comment>
        <rdfs:label>anastomosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10381 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10381">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Usual positioning of the developing fetus with the back curved forward, head bent forward, and limbs drawn in towards the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This position arises from the natural positioning of the embryo as the germ layers develop.</rdfs:comment>
        <rdfs:label>fetal anatomic position</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10763"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10382 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10382">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chorionic villus that is attached to the region of the endometrium (see also decidua) that interacts with the trophoblast during development of the placenta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anchoring villus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10587"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11371"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10383 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10383">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare benign tumor of the testis histologically resembling the fetal testis: the epithelium contains Sertoli cells that may produce estrogen and cause feminization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Sertoli cell tumor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>arrhenoblastoma</oboInOwl:hasRelatedSynonym>
        <rdfs:label>androblastoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10384 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10384">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance, such as a naturally occurring steroid hormone, that binds to androgen receptors to activate the male accessory sex organs and induce male secondary sexual characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>androgen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10385"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10385 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10385">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Producing masculine characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>androgenic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10386 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10386">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nuclear receptor that is activated by binding of testosterone or dihydrotestosterone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>AR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>androgen receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10385"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11296"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10386"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10387 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10387">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Steroid hormone produced in the adrenal glands and gonads as a common precursor of male (testosterone) and female (estrogen) sex hormones.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>androstenedione</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11296"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10388 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10388">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in the number of erythrocytes or total hemoglobin in the blood that results in a decrease in the oxygen-carrying capacity of the blood, sometimes inducing pallor and fatigue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10389 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10389">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fetus lacking all or most of the neural tissues of brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anencephalus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10390"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10390 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10390">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of a major portion of the brain and its meninges, skull, and scalp that results from abnormal embryonic development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>anencephalia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>anencephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10391 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10391">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interval of sexual inactivity between two periods of estrus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anestrus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10685"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10392 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10392">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent inducing aneuploidy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>aneugen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10394"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10393 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10393">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to a cell or organism with missing or extra chromosomes or parts of chromosomes, and thus an abnormal number of chromosomes that is not an exact multiple of the haploid number.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>aneuploid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10687"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10394 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10394">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of being aneuploid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>aneuploidy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10393"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10395 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10395">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal bulging of the wall of an artery or a chamber of the heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>An aneurysm may present a risk of hemorrhage if it ruptures.</rdfs:comment>
        <rdfs:label>aneurysm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10396 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10396">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell taking part in blood vessel formation. Primordial mesenchymal tissue from which embryonic blood cells and vascular endothelium are differentiated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>vasoformative cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>angioblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10661"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10397 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10397">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development of new blood vessels in the embryo or from pre-existing vessels; formation of capillary networks.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>angiogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10429"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11357"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10398 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10398">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme (EC 3.4.15.1) that converts angiotensin I to angiotensin II, causing blood vessels to constrict thus increasing blood pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ACE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>ACE inhibitors are used clinically to lower blood pressure.</rdfs:comment>
        <rdfs:label>angiotensin converting enzyme</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10398"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ACE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10399 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10399">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital oral anomaly, in which the lingual frenulum (the membrane connecting the underside of the tongue to the floor of the mouth) is unusually short and thick.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>As a result of this, mobility of the tongue tip is decreased.</rdfs:comment>
        <rdfs:label>ankyloglossia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10400 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10400">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of all primary or permanent teeth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anodontia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10401 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10401">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Distance along the perineum between the anus and the base of the vagina or penis, or in the fetus between the anus and the base of the genital tubercle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>AGD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In some species where gender is not obvious at birth, it can be used for a tentative determination of the sex of the neonate.</rdfs:comment>
        <rdfs:comment>The distance is relatively longer in males than females. This in part relates to dihydrotestosterone levels, and abnormal distances may indicate birth defects, feminization in males, etc.</rdfs:comment>
        <rdfs:label>anogenital distance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10759"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11080"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11296"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10401"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AGD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10402 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10402">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deviation in structure or function arising in the embryo or fetus, due to genetic or other causes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>congenital anomaly</oboInOwl:hasRelatedSynonym>
        <rdfs:label>developmental anomaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11356"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10403 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10403">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence of nails.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This rare disorder may be the result of a congenital defect of ectoderm, ichthyosis, severe infection, severe allergic contact dermatitis, self-inflicted trauma, Raynaud phenomenon, lichen planus, epidermolysis bullosa, or severe exfoliative diseases.</rdfs:comment>
        <rdfs:label>anonychia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10835"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10404 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10404">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of one or both eyeballs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anophthalmia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10405 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10405">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of one or both testes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anorchism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10406 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10406">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to the anus and rectum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anorectal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10415"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10407 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10407">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of the (outer ear) pinna, often with narrowing or absence of the ear canal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anotia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11093"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10408 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10408">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of the ovaries to produce, to facilitate maturation of, or to release ova.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anovulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10409 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10409">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total absence of dioxygen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Sometimes anoxia is incorrectly used instead of hypoxia to mean a decreased dioxygen supply to the tissues.</rdfs:comment>
        <rdfs:label>anoxia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10834"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10410 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10410">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Before death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>antemortem</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11110"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10411 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10411">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Before birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>antepartum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10412 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10412">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to inhibition of cell division by mitosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>antimitotic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10413 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10413">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein that inhibits the development of the Müllerian ducts (paramesonephric ducts) in the male embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>AMH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Müllerian inhibiting factor (MIF)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Müllerian-inhibiting hormone (MIH)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Müllerian-inhibiting substance (MIS).</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The Müllerian ducts would otherwise differentiate into the uterus and Fallopian tubes.</rdfs:comment>
        <rdfs:label>anti-Müllerian hormone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11067"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10413"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AMH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10414 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10414">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cavity or chamber, often in bone, with specific meanings in some hollow organs (e.g., the pyloric end or gastric antrum of the stomach).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>antrum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10415 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10415">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>External opening of the rectum to the body surface, controlled by the anal sphincter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>anus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10840"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11247"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10416 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10416">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Great artery arising from the left ventricle, being the main trunk from which the systemic arterial system proceeds</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>aorta</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10417 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10417">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of the vertebrate embryonic mesoderm that gives rise to the genitourinary tract and its blood supply.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>AGM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AGM region</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The AGM region is the first embryonic site for autonomous hematopoiesis and production of hematopoietic stem cells.</rdfs:comment>
        <rdfs:label>aorta-gonad-mesonephros region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10789"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10417"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AGM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10418 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10418">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Curved portion of the aorta between its ascending portion exiting the heart and its descending portion that proceeds to the arteries of the thoracic and abdominal cavities and the lower body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>aortic arch</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10318"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10419 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10419">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spiral septum that, during development, separates the truncus arteriosus into a ventral pulmonary trunk and the ascending aorta dorsally.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>aorticopulmonary septum</oboInOwl:hasRelatedSynonym>
        <rdfs:label>aortopulmonary septum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11156"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11206"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11328"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10420 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10420">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence of the lens of the eye, occurring as a congenital defect or as a result of trauma or surgery.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Aphakia causes a loss of visual accommodation, far sightedness (hyperopia), and a deep anterior chamber of the eye.</rdfs:comment>
        <rdfs:label>aphakia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10421 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10421">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bones and cartilage that support the appendages, including the bones of the shoulders, upper limbs, pelvis, and lower limbs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>appendicular skeleton</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10451"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10422 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10422">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tube-shaped sac (&apos;vermiform appendix&apos;) attached to and opening into the upper end of the large intestine (cecum) in humans and some other mammals. Appendage, blind sac, or diverticulum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>appendix</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10500"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10669"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10423 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10423">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extreme length and slenderness of the fingers or toes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>arachnodactyly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10424 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10424">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Web like membrane that lies between the outer (and much thicker) dura mater and the deeper pia mater, and which covers the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>arachnoid mater</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The arachnoid membrane is separated from the pia mater by the subarachnoid space, in which the cerebrospinal fluid flows and is absorbed by the arachnoid villi.</rdfs:comment>
        <rdfs:label>arachnoid membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10425 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10425">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small projection of the arachnoid membrane into some of the venous sinuses of the dura mater.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>arachnoid granulation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>arachnoid villus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10426 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10426">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A circular area of different color surrounding a central point, such as that surrounding the nipple of the breast, the part of the iris surrounding the pupil of the eye, or an area surrounding a vesicle. Any minute space or interstice in a tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>areola</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11368"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10427 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10427">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital herniation of the brainstem and lower cerebellum through the foramen magnum into the cervical vertebral canal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Chiari malformation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This malformation is often associated with meningocele and spina bifida.</rdfs:comment>
        <rdfs:label>Arnold–Chiari malformation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10689"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10736"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10933"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11004"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11248"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10428 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10428">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme (EC 1.14.14.1) of the cytochrome P450 superfamily that converts testosterone to 17\(\upbeta\)-estradiol and androstenedione to estrone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>estrogen synthetase</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Inhibiting its action is an approach to the management of breast cancer.</rdfs:comment>
        <rdfs:label>aromatase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10485"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11296"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10429 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10429">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in the diameter of arterial vessels that leads to the formation of large conductance arteries from pre-existing arterioles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>arteriogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10430 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10430">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Connection between the arterial and venous sides of the circulation that bypasses the capillary beds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>AV Shunt</oboInOwl:hasRelatedSynonym>
        <rdfs:label>arteriovenous shunt</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10431 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10431">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Introduction of semen into the cervix, uterus or Fallopian tubes by means other than the natural one.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>artificial insemination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10507"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10856"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11202"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10432 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10432">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ligand-activated transcription factor involved in the regulation of biological responses to planar aromatic hydrocarbons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>AHR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It also appears to play a role in cell proliferation and differentiation during vertebrate development, including hematopoiesis and development of the lymphoid and immune systems.</rdfs:comment>
        <rdfs:comment>This receptor has been shown to regulate xenobiotic-metabolizing enzymes such as various forms of cytochrome P450 family 1 members.</rdfs:comment>
        <rdfs:label>aryl hydrocarbon receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11311"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10432"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AHR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10433 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10433">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein coded for by a gene on chromosome 1q21 that forms a complex with ligand-bound aryl hydrocarbon receptor, resulting in translocation of the ligand-binding subunit to the nucleus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ARNT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A t(1;12)(q21;p13) chromosomal translocation, which results in a translocated ETS leukemia (TEL)-ARNT fusion protein, is associated with acute myeloblastic leukemia.</rdfs:comment>
        <rdfs:label>aryl hydrocarbon receptor nucleotide translocator protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11313"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10433"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ARNT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10434 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10434">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total or partial collapse of the lung. Congenital condition characterized by the incomplete expansion of the lungs at birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>atelectasis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10435 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10435">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of one or both nipples.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>athelia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10436 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10436">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence of functioning thymus tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Absence of affect; suppressed emotion.</rdfs:comment>
        <rdfs:label>athymia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10437 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10437">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital absence or abnormal narrowing of a normal opening or normally patent lumen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>clausura</oboInOwl:hasRelatedSynonym>
        <rdfs:label>atresia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10438 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10438">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defect in the septum between the atria of the heart, due to failure of normal closure of the foramen ovale in the perinatal period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ASD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>atrial-septal defect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10737"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11079"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10438"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ASD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10439 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10439">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital baldness caused by an abnormality of the hairless gene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>It may include loss of hair in early childhood, which never regrows.</rdfs:comment>
        <rdfs:label>atrichia congenita</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10440 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10440">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to the atrial and ventricular chambers of the heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>atrioventricular</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10441 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10441">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Each of the two upper chambers of the heart from which blood is passed to the ventricles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The right atrium receives deoxygenated blood from the veins of the body, the left atrium oxygenated blood from the pulmonary vein.</rdfs:comment>
        <rdfs:label>atrium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11156"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10442 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10442">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Wasting away of the body or of an organ or tissue, involving a decrease in size and (or) numbers of cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>atrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10443 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10443">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrow channel connecting the middle ear and the nasopharynx.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Eustachian tube</oboInOwl:hasRelatedSynonym>
        <rdfs:label>auditory tube</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11086"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10444 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10444">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An appendage to the atrium of the heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>auricle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10441"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11093"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10445 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10445">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Postmortem examination of the human organs and body tissue to determine cause of death or pathological condition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>autopsy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11110"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10446 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10446">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Independent twin of a pair of conjoined twins; the other twin is a parasitic twin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>autosite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10555"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11069"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10447 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10447">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in an autosomal gene capable of expression when carried by only one of a pair of homologous chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>autosomal dominant mutation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10449"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10448 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10448">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in an autosomal gene that produces an effect in the organism only when it is homozygous.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>autosomal recessive mutation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10449"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10449 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10449">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any chromosome that is not a sex chromosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>autosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11211"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10450 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10450">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence of a blood supply.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>avascularity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10451 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10451">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bones of the body axis, including the skull, spinal column, ribs and sternum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>axial skeleton</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10421"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11249"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10452 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10452">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence of viable spermatozoa in the semen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>azoospermia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11202"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10453 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10453">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complex structure at the base of the brain consisting of several groups of neurons, the caudate nucleus, the putamen, the globus pallidus, and the substantia nigra.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>basal nuclei</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These ganglia are involved in various functions, including voluntary motor movements and involuntary movements, such as tremors, bruxism (grinding the teeth), athetosis (involuntary writhing movements), and chorea (involuntary jerky movements).</rdfs:comment>
        <rdfs:label>basal ganglia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11012"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10454 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10454">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thin layer of connective tissue underlying an attached epithelial cell layer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>basal lamina</oboInOwl:hasRelatedSynonym>
        <rdfs:label>basement membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10455 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10455">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period in which the developing tooth takes on a bell shape in cross section, immediately preceding the &apos;advanced bell stage&apos;, in which the hard tissues (dentin and enamel) form the crown of the tooth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>bell stage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10456 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10456">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Uterus that is divided into two lateral horns as a result of imperfect fusion of the paired embryonic tubes from which the uterus is formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>In humans it is a uterine malformation, but in some mammalian species, including rodents and pigs, it is normal.</rdfs:comment>
        <rdfs:label>bicornate uterus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10457 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10457">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Early blastula having only two of the three primary germ layers that it will ultimately have; the two layers present are the cells of the epiblast that will give rise to the ectoderm and those of the hypoblast that will become the endoderm during gastrulation - both attached to a basement membrane before the mesoderm has formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>bilaminar blastoderm</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bilaminar embryo</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10664"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10750"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10763"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10829"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10458 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10458">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Start of life as a physically separate being, e.g., the emergence of a baby from the body of its mother, or the hatching of an egg.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>birth</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10459 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10459">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physical or biochemical abnormality that is present at birth, and that may either be inherited or be the result of environmental influence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>congenital defect</oboInOwl:hasRelatedSynonym>
        <rdfs:label>birth defect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10460 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10460">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of cells from which an organ or a body part develops, either in normal development or in the regeneration of a lost body part.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>blastema</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10461 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10461">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fluid-filled cavity in the blastula of a developing embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>cleavage cavity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>segmentation cavity</oboInOwl:hasRelatedSynonym>
        <rdfs:label>blastocoel</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10462 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10462">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Modified blastula that is characteristic of placental mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>It has an outer cell layer, known as the trophoblast, which participates in the development of the placenta, and an inner mass of cells in the blastocoel, which develops into the embryo.</rdfs:comment>
        <rdfs:label>blastocyst</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10463 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10463">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of the cells formed by cleavage of a fertilized egg.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>blastomere</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10528"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10464 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10464">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hollow mass of cells formed after a zygote has undergone approximately six cell divisions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>blastocyst</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>blastodermic vesicle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>blastula</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10465 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10465">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which the early embryo transforms from the morula into the blastula.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>blastulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10975"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10466 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10466">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occluding barrier, formed by the Sertoli cells of the seminiferous tubules, that separates the more mature cells of spermatogenesis from blood-borne products.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Sertoli cell barrier (SCB)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>blood-seminiferous tubule barrier</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The name &quot;blood-testis barrier&quot; is misleading in that it is not a blood-organ barrier in a strict sense, but is formed between Sertoli cells of the seminiferous tubule and, as such, isolates the further developed stages of germ cells from the blood. A more correct term is the &quot;Sertoli cell barrier&quot; (SCB).</rdfs:comment>
        <rdfs:label>blood–testis barrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10762"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11204"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11240"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10467 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10467">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average age at which children reach a given stage of bone maturation, denoting the stage of skeletal development of an individual fetus or child.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>A child’s current height and bone age can be used to predict adult height.</rdfs:comment>
        <rdfs:label>bone age</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10468 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10468">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a family of growth factors involved in bone and cartilage formation and, more generally, in orchestrating tissue architecture through morphogenetic signals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>BMP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bone morphogenic protein</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These proteins are also considered to be metabologens.</rdfs:comment>
        <rdfs:label>bone morphogenetic protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10949"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10972"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10468"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BMP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10469 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10469">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bone morphogenetic protein member of the transforming growth factor \(\upbeta\) (TGF-\(\upbeta\)) superfamily.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>BMP4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bone morphogenic protein-4 (BMP4)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Amongst the multiple functions of BMP4 is a role in early embryonic differentiation, where it is secreted from the notochord and acts with sonic hedgehog protein to establish a dorsal-ventral axis.</rdfs:comment>
        <rdfs:label>bone morphogenetic protein-4</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10468"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11021"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11232"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11235"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10469"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BMP4</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10470 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10470">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital abnormal shortness of fingers and toes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>brachydactylia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>brachydactyly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10471 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10471">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of, relating to, or resembling the gills of a fish or the homologous embryonic structures and their derivatives in higher animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>branchial</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10472 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10472">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In embryology, one of several arches, resembling the gill arches of a fish, found in the embryo of a higher vertebrate; these arches develop into structures of the ear and neck. In biology, one of several bony or cartilaginous arches located on either side of the pharynx and supporting the gills in fish and amphibians.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>gill arch</oboInOwl:hasRelatedSynonym>
        <rdfs:label>branchial arch</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10649"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11086"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10473 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10473">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital cyst arising in the lateral aspect of the neck, from epithelial remnants of a pharyngeal groove.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>branchiogenic cyst</oboInOwl:hasRelatedSynonym>
        <rdfs:label>congenital branchial cyst</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10582"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11084"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10474 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10474">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Shortness of the neck.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>brevicollis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10475 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10475">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Largest subdivision of a lobe of the lung with its air supply from a major branch of the bronchus and having its own arterial blood supply.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>bronchopulmonary segment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10476 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10476">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane present in fetal life that separates the nasal cavities from the pharynx.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>oropharyngeal membrane</oboInOwl:hasRelatedSynonym>
        <rdfs:label>buccopharyngeal membrane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10994"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11086"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10477 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10477">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small protuberance resembling the bud of a plant and having the potential for growth and differentiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>bud</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10478 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10478">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of the frontal lobe of the brain, receiving input from neurons of the nasal mucosa and involved in the sense of smell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>olfactory bulb</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10979"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11012"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10479 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10479">
