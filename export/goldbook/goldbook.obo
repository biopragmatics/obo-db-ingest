[Term]
id: goldbook:14282
name: gel nanoparticle
def: "Particle of gel particle of any shape and an equivalent diameter of approximately \\\(\\pu\{1 nm\}\\\) to \\\(\\pu\{100 nm\}\\\)."
synonym: "nanogel" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-10-06-03
property_value: hasStatus "current" xsd:string
