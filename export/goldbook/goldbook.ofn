Declaration(Class(goldbook:P04736))
AnnotationAssertion(rdfs:label goldbook:P04736 "polymer blend")
AnnotationAssertion(dcterms:description goldbook:P04736 "Macroscopically homogeneous mixture of two or more different species of polymer.")
AnnotationAssertion(rdfs:comment goldbook:P04736 "In most cases, blends are homogeneous on scales larger than several times the wavelengths of visible light."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04736 "In principle, the constituents of a blend are separable by physical means."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04736 "No account is taken of the miscibility or immiscibility of the constituent macromolecules, i.e., no assumption is made regarding the number of phase domains present."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04736 "The use of the term polymer alloy for a polymer blend is discouraged, as the former term includes multiphase copolymers but excludes incompatible polymer blends."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04736 "The number of polymeric components which comprise a blend is often designated by an adjective, viz. binary, ternary, quaternary, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04736 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:P04736 goldbook:IT07239)
AnnotationAssertion(rdfs:seeAlso goldbook:P04736 goldbook:MT07230)
AnnotationAssertion(rdfs:seeAlso goldbook:P04736 goldbook:PT07264)
AnnotationAssertion(rdfs:seeAlso goldbook:P04736 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:P04736 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:P04736 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04736 "current"^^xsd:string)
