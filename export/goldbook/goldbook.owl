        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period between conception and birth during which an embryo or fetus is carried in the uterus of a female mammal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
