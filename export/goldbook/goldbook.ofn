AnnotationAssertion(obo:goldbook#hasStatus goldbook:13604 "current"^^xsd:string)
Declaration(Class(goldbook:13605))
AnnotationAssertion(rdfs:label goldbook:13605 "primary myxedema")
AnnotationAssertion(dcterms:description goldbook:13605 "Atrophic form of diffuse autoimmune thyroiditis.")
AnnotationAssertion(rdfs:seeAlso goldbook:13605 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13605 goldbook:13741)
AnnotationAssertion(mito:isMentionedBy goldbook:13605 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13605 "current"^^xsd:string)
Declaration(Class(goldbook:13606))
AnnotationAssertion(rdfs:label goldbook:13606 "primary sclerosing cholangitis")
AnnotationAssertion(dcterms:description goldbook:13606 "Chronic, non-bacterial, inflammatory narrowing of the bile ducts.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13606 "PSC")
AnnotationAssertion(rdfs:comment goldbook:13606 "Often associated with ulcerative colitis [see inflammatory bowel disease (IBD)]."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13606 goldbook:13334)
AnnotationAssertion(mito:isMentionedBy goldbook:13606 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13606 "current"^^xsd:string)
Declaration(Class(goldbook:13607))
AnnotationAssertion(rdfs:label goldbook:13607 "prime")
AnnotationAssertion(dcterms:description goldbook:13607 "Process of giving an initial sensitization to antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13607 "priming")
AnnotationAssertion(mito:isMentionedBy goldbook:13607 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13607 "current"^^xsd:string)
Declaration(Class(goldbook:13608))
AnnotationAssertion(rdfs:label goldbook:13608 "professional antigen-presenting cell")
AnnotationAssertion(dcterms:description goldbook:13608 "Highly efficient antigen-presenting cell (APC), generally referring to dendritic cells, B cells, or macrophages.")
AnnotationAssertion(rdfs:comment goldbook:13608 "Other cells, e.g., fibroblasts and endothelial cells, that do not constitutively express major histocompatibility complex (MHC) class II molecules may be induced to do so by certain cytokines and are sometimes referred to as nonprofessional antigen-presenting cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13608 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13608 goldbook:12888)
AnnotationAssertion(rdfs:seeAlso goldbook:13608 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:13608 goldbook:13087)
AnnotationAssertion(rdfs:seeAlso goldbook:13608 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13608 goldbook:13432)
AnnotationAssertion(mito:isMentionedBy goldbook:13608 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13608 "current"^^xsd:string)
Declaration(Class(goldbook:13609))
AnnotationAssertion(rdfs:label goldbook:13609 "progressive systemic sclerosis")
AnnotationAssertion(dcterms:description goldbook:13609 "Systemic autoimmune disease marked by formation of hyalinized and thickened collagenous fibrous tissue, with thickening and adhesion of skin to underlying tissues, especially of the hands and face and vascular alterations.")
AnnotationAssertion(rdfs:seeAlso goldbook:13609 goldbook:13709)
AnnotationAssertion(rdfs:seeAlso goldbook:13609 goldbook:13660)
AnnotationAssertion(mito:isMentionedBy goldbook:13609 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13609 "current"^^xsd:string)
Declaration(Class(goldbook:13610))
AnnotationAssertion(rdfs:label goldbook:13610 "proinflammatory cytokine")
AnnotationAssertion(dcterms:description goldbook:13610 "Cytokine that initiates or enhances inflammation.")
AnnotationAssertion(rdfs:seeAlso goldbook:13610 goldbook:13065)
AnnotationAssertion(mito:isMentionedBy goldbook:13610 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13610 "current"^^xsd:string)
Declaration(Class(goldbook:13611))
AnnotationAssertion(rdfs:label goldbook:13611 "proliferation assay")
AnnotationAssertion(dcterms:description goldbook:13611 "Any test that determines the effect on increase in cell number of a test agent such as a cytokine or mitogen.")
AnnotationAssertion(rdfs:seeAlso goldbook:13611 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:13611 goldbook:13461)
AnnotationAssertion(mito:isMentionedBy goldbook:13611 doi:10.1351/PAC-REC-11-06-03)
