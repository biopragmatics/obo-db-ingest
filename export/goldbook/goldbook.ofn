AnnotationAssertion(rdfs:label goldbook:15643 "discordance")
AnnotationAssertion(dcterms:description goldbook:15643 "Any difference in a character between individuals due to genetic differences such as may occur in dizygotic twins, or between matched pairs in a case cohort study.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15643 "genetic discordance")
AnnotationAssertion(rdfs:seeAlso goldbook:15643 goldbook:15538)
AnnotationAssertion(mito:isMentionedBy goldbook:15643 doi:10.1351/pac200779071153)
