AnnotationAssertion(rdfs:label goldbook:13201 "hematopoietic stem cell")
AnnotationAssertion(dcterms:description goldbook:13201 "Self-renewing stem cell that is capable of giving rise to all of the formed elements of the blood (i.e., leukocytes, erythrocytes, and platelets).")
AnnotationAssertion(rdfs:seeAlso goldbook:13201 goldbook:13127)
AnnotationAssertion(rdfs:seeAlso goldbook:13201 goldbook:13580)
AnnotationAssertion(mito:isMentionedBy goldbook:13201 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13201 "current"^^xsd:string)
Declaration(Class(goldbook:13202))
AnnotationAssertion(rdfs:label goldbook:13202 "hemolytic anemia")
AnnotationAssertion(dcterms:description goldbook:13202 "Anemia resulting from the lysis of erythrocytes.")
AnnotationAssertion(rdfs:seeAlso goldbook:13202 goldbook:13127)
AnnotationAssertion(mito:isMentionedBy goldbook:13202 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13202 "current"^^xsd:string)
Declaration(Class(goldbook:13203))
AnnotationAssertion(rdfs:label goldbook:13203 "heparin-induced thrombocytopenia")
AnnotationAssertion(dcterms:description goldbook:13203 "Most frequent antibody-mediated drug-induced thrombocytopenia, which occurs in \\(\\pu{1-}\\pu{2\\%}\\) of patients treated with heparin intravenously for longer than four days.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13203 "HIT")
AnnotationAssertion(rdfs:comment goldbook:13203 "This disease is mediated by antibodies to complexes formed between heparin and the endogenous platelet factor 4 (PF4)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13203 goldbook:13580)
AnnotationAssertion(mito:isMentionedBy goldbook:13203 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13203 "current"^^xsd:string)
Declaration(Class(goldbook:13204))
AnnotationAssertion(rdfs:label goldbook:13204 "hereditary angioneurotic edema")
AnnotationAssertion(dcterms:description goldbook:13204 "Clinical name for a genetic deficiency of the C1 inhibitor of the complement system.")
AnnotationAssertion(rdfs:comment goldbook:13204 "In the absence of C1 inhibitor, spontaneous activation of the complement system can cause diffuse fluid leakage from blood vessels, the most serious consequence of which is epiglottal swelling leading to suffocation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13204 goldbook:12970)
AnnotationAssertion(rdfs:seeAlso goldbook:13204 goldbook:13033)
AnnotationAssertion(mito:isMentionedBy goldbook:13204 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13204 "current"^^xsd:string)
