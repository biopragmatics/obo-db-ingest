consider: goldbook:12625

[Term]
id: goldbook:12627
name: beta-sheet breaker
def: "Compound that on binding to a protein disrupts beta-sheet formation."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-11-23
property_value: hasStatus "current" xsd:string
