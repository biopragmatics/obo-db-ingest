AnnotationAssertion(rdfs:label goldbook:11783 "giant axonal neuropathy")
AnnotationAssertion(dcterms:description goldbook:11783 "Rare human genetic neurological disorder in which the neurofilaments become disordered, resulting in abnormal size and shape of neurons.")
AnnotationAssertion(rdfs:seeAlso goldbook:11783 goldbook:11931)
AnnotationAssertion(mito:isMentionedBy goldbook:11783 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11783 "current"^^xsd:string)
Declaration(Class(goldbook:11784))
AnnotationAssertion(rdfs:label goldbook:11784 "glia")
AnnotationAssertion(dcterms:description goldbook:11784 "Non-neuronal cellular elements of the central and peripheral nervous system having metabolic and support functions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11784 "neuroglia")
AnnotationAssertion(rdfs:comment goldbook:11784 "In the central nervous system, the glia include oligodendroglia, astrocytes, ependymal cells, and microglia cells. In the peripheral nervous system they include ganglion satellite cells and Schwann cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11784 goldbook:12064)
AnnotationAssertion(rdfs:seeAlso goldbook:11784 goldbook:11614)
AnnotationAssertion(rdfs:seeAlso goldbook:11784 goldbook:11756)
