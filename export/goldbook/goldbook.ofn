AnnotationAssertion(rdfs:label goldbook:TT06812 "target")
AnnotationAssertion(dcterms:description goldbook:TT06812 "Any organism, organ, tissue, cell, or cell constituent that is subject to the action of an agent.")
AnnotationAssertion(rdfs:seeAlso goldbook:TT06812 goldbook:C01281)
AnnotationAssertion(mito:isMentionedBy goldbook:TT06812 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:TT06812 "current"^^xsd:string)
