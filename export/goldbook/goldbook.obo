property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:08227
name: attenuated total reflection
def: "Internal reflection from an absorbing material at angles of incidence at or above the critical angle."
synonym: "ATR" RELATED OMO:0003000 []
synonym: "frustrated total internal reflection" []
