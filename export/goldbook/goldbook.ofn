AnnotationAssertion(obo:goldbook#hasStatus goldbook:13618 "current"^^xsd:string)
Declaration(Class(goldbook:13619))
AnnotationAssertion(rdfs:label goldbook:13619 "protein kinase C")
AnnotationAssertion(dcterms:description goldbook:13619 "Member of a kinase family with broad substrate specificity, activated by calcium, diacylglycerol, and (or) phorbol 12-myristate 13-acetate (PMA).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13619 "PKC")
AnnotationAssertion(rdfs:comment goldbook:13619 "It is activated during B-lymphocyte and T-lymphocyte activation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13619 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13619 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13619 goldbook:13566)
AnnotationAssertion(mito:isMentionedBy goldbook:13619 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13619 "current"^^xsd:string)
Declaration(Class(goldbook:13620))
AnnotationAssertion(rdfs:label goldbook:13620 "prozone effect")
AnnotationAssertion(dcterms:description goldbook:13620 "Loss of immunoprecipitation or agglutination that occurs when antibody concentration is increased to an extent that the antibody is in such excess that it is no longer able to effectively cross-link the antigen. A similar phenomenon may occur in antigen excess.")
AnnotationAssertion(mito:isMentionedBy goldbook:13620 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13620 "current"^^xsd:string)
Declaration(Class(goldbook:13621))
AnnotationAssertion(rdfs:label goldbook:13621 "pseudoallergy")
AnnotationAssertion(dcterms:description goldbook:13621 "Inflammatory or anaphylactic reaction with symptoms similar to an allergy but not involving an antigen-specific immune response, e.g., salicylate intolerance, reaction to contrast reagents.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13621 "pseudoallergic reaction")
AnnotationAssertion(rdfs:comment goldbook:13621 "Causes include direct histamine release and/or complement activation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13621 goldbook:12859)
AnnotationAssertion(rdfs:seeAlso goldbook:13621 goldbook:12871)
AnnotationAssertion(mito:isMentionedBy goldbook:13621 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13621 "current"^^xsd:string)
Declaration(Class(goldbook:13622))
AnnotationAssertion(rdfs:label goldbook:13622 "psoriasis")
AnnotationAssertion(dcterms:description goldbook:13622 "Skin disorder that has a hereditary component and is characterized by erythematous patches covered with silvery scales, especially on the elbows, knees, and scalp.")
AnnotationAssertion(rdfs:comment goldbook:13622 "Psoriasis is associated with excessively rapid proliferation of keratinocytes which mature in less than a week."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13622 goldbook:13359)
AnnotationAssertion(mito:isMentionedBy goldbook:13622 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13622 "current"^^xsd:string)
Declaration(Class(goldbook:13623))
AnnotationAssertion(rdfs:label goldbook:13623 "psoriatic")
AnnotationAssertion(dcterms:description goldbook:13623 "Of, relating to, or associated with psoriasis; affected with psoriasis.")
AnnotationAssertion(rdfs:seeAlso goldbook:13623 goldbook:13622)
AnnotationAssertion(mito:isMentionedBy goldbook:13623 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13623 "current"^^xsd:string)
Declaration(Class(goldbook:13624))
AnnotationAssertion(rdfs:label goldbook:13624 "purified protein derivative")
AnnotationAssertion(dcterms:description goldbook:13624 "Partially purified derivative of tuberculin used in the Mantoux test for tuberculosis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13624 "PPD")
AnnotationAssertion(rdfs:seeAlso goldbook:13624 goldbook:13757)
AnnotationAssertion(mito:isMentionedBy goldbook:13624 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13624 "current"^^xsd:string)
Declaration(Class(goldbook:13625))
AnnotationAssertion(rdfs:label goldbook:13625 "purpura")
AnnotationAssertion(dcterms:description goldbook:13625 "Purple discoloration occurring in patches on the skin, mucus membranes, or organs.")
AnnotationAssertion(rdfs:seeAlso goldbook:13625 goldbook:13250)
AnnotationAssertion(mito:isMentionedBy goldbook:13625 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13625 "current"^^xsd:string)
Declaration(Class(goldbook:13626))
AnnotationAssertion(rdfs:label goldbook:13626 "pyrogen")
AnnotationAssertion(dcterms:description goldbook:13626 "Any substance that produces fever.")
AnnotationAssertion(mito:isMentionedBy goldbook:13626 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13626 "current"^^xsd:string)
Declaration(Class(goldbook:13627))
AnnotationAssertion(rdfs:label goldbook:13627 "pyrogen test")
AnnotationAssertion(dcterms:description goldbook:13627 "Any of various tests used to determine whether an agent, usually an infusion or injection fluid, is free of pyrogens.")
AnnotationAssertion(rdfs:seeAlso goldbook:13627 goldbook:13387)
AnnotationAssertion(rdfs:seeAlso goldbook:13627 goldbook:13112)
AnnotationAssertion(rdfs:seeAlso goldbook:13627 goldbook:13338)
AnnotationAssertion(rdfs:seeAlso goldbook:13627 goldbook:13626)
