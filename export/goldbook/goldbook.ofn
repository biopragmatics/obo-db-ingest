AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03901 "current"^^xsd:string)
Declaration(Class(goldbook:M03902))
AnnotationAssertion(rdfs:label goldbook:M03902 "microheterogeneity")
AnnotationAssertion(dcterms:description goldbook:M03902 "A particular glycoprotein may occur in forms that differ in the structure of one or more or its carbohydrate units, a phenomenon known as microheterogeneity.")
AnnotationAssertion(rdfs:seeAlso goldbook:M03902 goldbook:G02656)
AnnotationAssertion(mito:isMentionedBy goldbook:M03902 doi:10.1351/pac198860091389)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03902 "current"^^xsd:string)
Declaration(Class(goldbook:M03903))
AnnotationAssertion(rdfs:label goldbook:M03903 "micrometeorology")
AnnotationAssertion(dcterms:description goldbook:M03903 "The study of the meteorological processes on scales from a millimeter or less up to tens or hundreds of metres; e.g. meteorology of a local site that is usually small and often is confined to a shallow layer of air next to the ground.")
AnnotationAssertion(mito:isMentionedBy goldbook:M03903 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03903 "current"^^xsd:string)
Declaration(Class(goldbook:M03904))
AnnotationAssertion(rdfs:label goldbook:M03904 "micro-network")
AnnotationAssertion(dcterms:description goldbook:M03904 "Polymer network that has dimensions of the order of \\(1\\ \\rm{nm}\\) to \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\).")
AnnotationAssertion(rdfs:comment goldbook:M03904 "Modified from previous version. The definition proposed here is recommended as being more explicit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M03904 goldbook:P04742)
AnnotationAssertion(mito:isMentionedBy goldbook:M03904 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M03904 "current"^^xsd:string)
Declaration(Class(goldbook:M03906))
AnnotationAssertion(rdfs:label goldbook:M03906 "micropore")
AnnotationAssertion(dcterms:description goldbook:M03906 "Pore with width not exceeding about \\(2.0\\ \\rm{nm}\\) (\\(20\\ \\mathrm{Å}\\)).")
AnnotationAssertion(rdfs:seeAlso goldbook:M03906 goldbook:M03672)
AnnotationAssertion(rdfs:seeAlso goldbook:M03906 goldbook:M03853)
