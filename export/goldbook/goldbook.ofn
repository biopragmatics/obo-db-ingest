Declaration(Class(goldbook:11858))
AnnotationAssertion(rdfs:label goldbook:11858 "manganism")
AnnotationAssertion(dcterms:description goldbook:11858 "Condition of manganese poisoning, usually after chronic inhalation exposure to manganese fumes.")
AnnotationAssertion(rdfs:comment goldbook:11858 "Manganism is characterized by neurological and psychiatric disorders including reduced reaction time, lethargy, tremors, and a mask-like face. Impotence and loss of libido have also been reported."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11858 "Low environmental exposures are reported to impair brain development and to reduce performance on neuropsychological tests."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11858 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11858 goldbook:11848)
