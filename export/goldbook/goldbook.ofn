AnnotationAssertion(dcterms:description goldbook:12878 "Antibody administered with the aim of treating a disease.")
AnnotationAssertion(mito:isMentionedBy goldbook:12878 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12878 "current"^^xsd:string)
Declaration(Class(goldbook:12879))
AnnotationAssertion(rdfs:label goldbook:12879 "antibody-dependent cellular cytotoxicity")
AnnotationAssertion(dcterms:description goldbook:12879 "Cytotoxic reaction in which an antibody-coated target cell is directly killed by an Fc receptor-bearing leukocyte, e.g., NK cell, macrophage, neutrophil, or eosinophil.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12879 "ADCC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12879 "antibody-dependent cell-mediated cytotoxicity")
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13071)
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13138)
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13499)
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13117)
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13379)
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13510)
AnnotationAssertion(rdfs:seeAlso goldbook:12879 goldbook:13727)
AnnotationAssertion(mito:isMentionedBy goldbook:12879 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12879 "current"^^xsd:string)
Declaration(Class(goldbook:12880))
AnnotationAssertion(rdfs:label goldbook:12880 "antibody-forming cell assay")
AnnotationAssertion(dcterms:description goldbook:12880 "Assay that measures the humoral immune response mediated by the concerted actions of antigen-presenting cells, T lymphocytes, and B lymphocytes, generally by determination of murine primary IgM or IgG antibodies directed against the T-cell-dependent sheep red blood cell (SRBC) surface antigens after in vivo sensitization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12880 "AFC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "hemolytic plaque assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "Jerne plaque assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "plaque-forming cell (PFC) assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "AFC assay")
AnnotationAssertion(rdfs:comment goldbook:12880 "Due to involvement of multiple cell populations in mounting an antibody response, the AFC assay actually evaluates several immune parameters simultaneously. It is considered to be one of the most sensitive indicator systems for immunotoxicology studies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12880 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:12880 goldbook:13289)
AnnotationAssertion(rdfs:seeAlso goldbook:12880 goldbook:13293)
AnnotationAssertion(rdfs:seeAlso goldbook:12880 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12880 goldbook:12888)
AnnotationAssertion(rdfs:seeAlso goldbook:12880 goldbook:13325)
AnnotationAssertion(mito:isMentionedBy goldbook:12880 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12880 "current"^^xsd:string)
Declaration(Class(goldbook:12881))
AnnotationAssertion(rdfs:label goldbook:12881 "antibody therapy")
AnnotationAssertion(dcterms:description goldbook:12881 "Use of an antibody to target specific cells (often tumor cells) or signal transduction pathways (often via chemokines/cytokines) in the treatment of disease.")
AnnotationAssertion(rdfs:comment goldbook:12881 "The main objectives are stimulation of the patient’s immune system to attack malignant tumor cells and the prevention of tumor growth by blockage of specific cell receptors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12881 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:12881 goldbook:13271)
AnnotationAssertion(mito:isMentionedBy goldbook:12881 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12881 "current"^^xsd:string)
Declaration(Class(goldbook:12882))
AnnotationAssertion(rdfs:label goldbook:12882 "lupus anticoagulant")
AnnotationAssertion(dcterms:description goldbook:12882 "Autoantibody that binds to phospholipids and/or proteins of the cell membrane in systemic lupus erythematosus (SLE), and can interfere with blood clotting and tests of clotting function.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "antibody")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "lupus")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "lupus antibody")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "lupus anticoagulant")
AnnotationAssertion(rdfs:seeAlso goldbook:12882 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:12882 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:12882 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12882 "current"^^xsd:string)
Declaration(Class(goldbook:12883))
AnnotationAssertion(rdfs:label goldbook:12883 "anti-DNA antibody")
AnnotationAssertion(dcterms:description goldbook:12883 "Antibody directed against single-stranded or double-stranded DNA.")
AnnotationAssertion(rdfs:seeAlso goldbook:12883 goldbook:12898)
AnnotationAssertion(rdfs:seeAlso goldbook:12883 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:12883 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12883 "current"^^xsd:string)
Declaration(Class(goldbook:12884))
AnnotationAssertion(rdfs:label goldbook:12884 "anti-erythrocyte antibody")
AnnotationAssertion(dcterms:description goldbook:12884 "Antibody against molecules of the red blood cell, usually against membrane proteins, causing lysis of the red blood cells.")
AnnotationAssertion(rdfs:comment goldbook:12884 "Maternal IgG antibodies specific for the Rhesus (Rh) factor blood group antigen expressed against the erythrocytes of the fetus may lead to hemolytic disease of the newborn."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12884 goldbook:13292)
AnnotationAssertion(rdfs:seeAlso goldbook:12884 goldbook:13649)
AnnotationAssertion(rdfs:seeAlso goldbook:12884 goldbook:12956)
AnnotationAssertion(rdfs:seeAlso goldbook:12884 goldbook:13127)
AnnotationAssertion(rdfs:seeAlso goldbook:12884 goldbook:13202)
AnnotationAssertion(mito:isMentionedBy goldbook:12884 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12884 "current"^^xsd:string)
Declaration(Class(goldbook:12885))
AnnotationAssertion(rdfs:label goldbook:12885 "antigenic")
AnnotationAssertion(dcterms:description goldbook:12885 "Capable of stimulating lymphocytes to produce antibodies.")
AnnotationAssertion(rdfs:seeAlso goldbook:12885 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:12885 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12885 "current"^^xsd:string)
Declaration(Class(goldbook:12886))
AnnotationAssertion(rdfs:label goldbook:12886 "antigenicity")
AnnotationAssertion(dcterms:description goldbook:12886 "Ability of an antigen to bind to a specific antibody or T-cell receptor (TCR); often a measure of its ability to produce immunity.")
AnnotationAssertion(rdfs:seeAlso goldbook:12886 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:12886 goldbook:13272)
AnnotationAssertion(mito:isMentionedBy goldbook:12886 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12886 "current"^^xsd:string)
Declaration(Class(goldbook:12887))
AnnotationAssertion(rdfs:label goldbook:12887 "antigen presentation")
AnnotationAssertion(dcterms:description goldbook:12887 "Display of antigen as peptide fragments bound to major histocompatibility complex (MHC) molecules on the surface of a cell.")
AnnotationAssertion(rdfs:comment goldbook:12887 "T cells recognize antigen only when it is presented in this way."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12887 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12887 goldbook:13434)
AnnotationAssertion(mito:isMentionedBy goldbook:12887 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12887 "current"^^xsd:string)
Declaration(Class(goldbook:12888))
AnnotationAssertion(rdfs:label goldbook:12888 "antigen-presenting cell")
AnnotationAssertion(dcterms:description goldbook:12888 "Cell, such as a dendritic cell or macrophage, that is responsible for making antigens accessible to lymphocytes and other immune effector and regulatory cells, making possible specific recognition by receptors on the cell surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12888 "APC")
AnnotationAssertion(rdfs:comment goldbook:12888 "In a more restricted way, used to describe major histocompatibility complex (MHC) class II-positive cells (accessory cells) that internalize and degrade an antigen (generally by phagocytosis), before a fragment of the antigen molecule is presented on the APC cell surface in association with an MHC molecule. This complex is recognized by either B cells via surface-bound immunoglobulin (Ig) molecules, or by T cells via the T-cell receptor (TCR) for the antigen. Induction of a specific immune response then proceeds."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:12830)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:13087)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:13432)
AnnotationAssertion(rdfs:seeAlso goldbook:12888 goldbook:13562)
AnnotationAssertion(mito:isMentionedBy goldbook:12888 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12888 "current"^^xsd:string)
Declaration(Class(goldbook:12889))
AnnotationAssertion(rdfs:label goldbook:12889 "antigen-presenting groove")
AnnotationAssertion(dcterms:description goldbook:12889 "1) Pocket in a major histocompatibility complex (MHC) molecule that binds antigen for antigen presentation. 2) Hydrophobic binding region in the CD1 protein that anchors lipid-containing antigens causing exposure of the peptide or carbohydrate moiety in a position enabling T-cell receptor (TCR) contact.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12889 "antigen-binding groove")
AnnotationAssertion(rdfs:seeAlso goldbook:12889 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:12889 goldbook:12887)
AnnotationAssertion(rdfs:seeAlso goldbook:12889 goldbook:13434)
AnnotationAssertion(mito:isMentionedBy goldbook:12889 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12889 "current"^^xsd:string)
Declaration(Class(goldbook:12890))
AnnotationAssertion(rdfs:label goldbook:12890 "antigen processing")
AnnotationAssertion(dcterms:description goldbook:12890 "Cleavage of protein antigens in antigen-presenting cells (APCs).")
AnnotationAssertion(rdfs:comment goldbook:12890 "The immunogenic peptides interact with the binding sites of major histocompatibility complex (MHC) class II products (exogenous antigens) or with those in MHC class I products (endogenous antigens, including viruses). The processed antigen-MHC complex is recognized by the antigen receptor complex of T lymphocytes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12890 goldbook:13431)
AnnotationAssertion(rdfs:seeAlso goldbook:12890 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12890 goldbook:12887)
AnnotationAssertion(rdfs:seeAlso goldbook:12890 goldbook:12891)
AnnotationAssertion(rdfs:seeAlso goldbook:12890 goldbook:12888)
AnnotationAssertion(rdfs:seeAlso goldbook:12890 goldbook:13432)
AnnotationAssertion(mito:isMentionedBy goldbook:12890 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12890 "current"^^xsd:string)
Declaration(Class(goldbook:12891))
AnnotationAssertion(rdfs:label goldbook:12891 "antigen receptor")
AnnotationAssertion(dcterms:description goldbook:12891 "Specific antigen-binding receptor on T or B lymphocytes that is transcribed and translated following rearrangements and translocation of V, D, and J genes.")
AnnotationAssertion(rdfs:seeAlso goldbook:12891 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:12891 goldbook:13098)
AnnotationAssertion(rdfs:seeAlso goldbook:12891 goldbook:13354)
AnnotationAssertion(rdfs:seeAlso goldbook:12891 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12891 goldbook:13772)
AnnotationAssertion(mito:isMentionedBy goldbook:12891 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12891 "current"^^xsd:string)
Declaration(Class(goldbook:12892))
AnnotationAssertion(rdfs:label goldbook:12892 "antigen recognition")
AnnotationAssertion(dcterms:description goldbook:12892 "Ability of highly specialized proteins of the immune system to recognize antigens and specifically bind to them.")
AnnotationAssertion(rdfs:comment goldbook:12892 "Types of antigen recognition include that by antibodies, T-cell receptors (TCRs), and toll-like receptors (TLRs)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12892 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:12892 goldbook:13271)
AnnotationAssertion(rdfs:seeAlso goldbook:12892 goldbook:13747)
AnnotationAssertion(mito:isMentionedBy goldbook:12892 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12892 "current"^^xsd:string)
Declaration(Class(goldbook:12893))
AnnotationAssertion(rdfs:label goldbook:12893 "anti-idiotypic antibody")
AnnotationAssertion(dcterms:description goldbook:12893 "Antibody raised against antigenic determinants unique to the variable region of a single antibody.")
AnnotationAssertion(rdfs:seeAlso goldbook:12893 goldbook:13252)
AnnotationAssertion(rdfs:seeAlso goldbook:12893 goldbook:13253)
AnnotationAssertion(rdfs:seeAlso goldbook:12893 goldbook:13773)
AnnotationAssertion(mito:isMentionedBy goldbook:12893 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12893 "current"^^xsd:string)
Declaration(Class(goldbook:12894))
AnnotationAssertion(rdfs:label goldbook:12894 "anti-isotypic antibody")
AnnotationAssertion(dcterms:description goldbook:12894 "Antibody against universal features of a given constant (C) region isotype (such as $\\upgamma\\!$ or $\\upmu\\!$) of one species that is made by immunizing a member of another species with that isotype.")
AnnotationAssertion(rdfs:comment goldbook:12894 "Such antibodies will bind any antibody of that isotype, and are thus useful for detecting bound antibody molecules in immunoassays and other applications."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12894 goldbook:13039)
AnnotationAssertion(rdfs:seeAlso goldbook:12894 goldbook:13347)
AnnotationAssertion(mito:isMentionedBy goldbook:12894 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12894 "current"^^xsd:string)
Declaration(Class(goldbook:12895))
AnnotationAssertion(rdfs:label goldbook:12895 "antimitochondrial antibody")
AnnotationAssertion(dcterms:description goldbook:12895 "Autoantibody producing a mitochondrial staining pattern on sections of various tissues and on tumor cell monolayers.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12895 "AMA")
AnnotationAssertion(rdfs:comment goldbook:12895 "According to the fluorescence pattern, different subtypes can be differentiated. Antimitochondrial antibodies of the subtype 2 (AMA-M2) are directed against antigens of three related 2-oxo acid dehydrogenase complexes (e.g., the E2 subunit of the pyruvate dehydrogenase complex, PDC-E2) localized to the inner mitochondrial membrane. AMA-M2 is a specific marker of primary biliary cirrhosis (PBC)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12895 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:12895 goldbook:13600)
AnnotationAssertion(mito:isMentionedBy goldbook:12895 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12895 "current"^^xsd:string)
Declaration(Class(goldbook:12896))
AnnotationAssertion(rdfs:label goldbook:12896 "antineutrophil cytoplasmic autoantibody")
AnnotationAssertion(dcterms:description goldbook:12896 "Antibody against antigens in the cytoplasm of neutrophils.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12896 "ANCA")
AnnotationAssertion(rdfs:seeAlso goldbook:12896 goldbook:12897)
AnnotationAssertion(rdfs:seeAlso goldbook:12896 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:12896 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12896 "current"^^xsd:string)
Declaration(Class(goldbook:12897))
AnnotationAssertion(rdfs:label goldbook:12897 "antineutrophil cytoplasmic autoantibody associated vasculitis")
AnnotationAssertion(dcterms:description goldbook:12897 "One of a group of autoimmune systemic vasculitides associated with antineutrophil cytoplasmic autoantibodies (ANCAs), e.g., Wegener granulomatosis (WG), microscopic polyangiitis, and Churg–Strauss syndrome.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12897 "ANCA-associated vasculitis")
AnnotationAssertion(rdfs:seeAlso goldbook:12897 goldbook:13782)
AnnotationAssertion(rdfs:seeAlso goldbook:12897 goldbook:12896)
AnnotationAssertion(rdfs:seeAlso goldbook:12897 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:12897 goldbook:13459)
AnnotationAssertion(rdfs:seeAlso goldbook:12897 goldbook:13708)
AnnotationAssertion(mito:isMentionedBy goldbook:12897 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12897 "current"^^xsd:string)
Declaration(Class(goldbook:12898))
AnnotationAssertion(rdfs:label goldbook:12898 "antinuclear antibody")
AnnotationAssertion(dcterms:description goldbook:12898 "Antibody, detectable in the blood, that has the capability of binding to a substance, e.g., DNA, within the nucleus of the cells.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12898 "ANA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12898 "antinuclear factor (ANF)")
AnnotationAssertion(rdfs:comment goldbook:12898 "ANAs are found in patients whose immune system may be predisposed to cause inflammation against their own body tissues. ANAs indicate the possible presence of autoimmunity and are an indication of autoimmune disease, such as rheumatoid arthritis (RA), scleroderma, Sjögren syndrome, systemic lupus erythematosus (SLE), and mixed connective tissue disease (MCTD)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:13680)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:12925)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:13271)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:13465)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:13651)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:13660)
AnnotationAssertion(rdfs:seeAlso goldbook:12898 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:12898 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12898 "current"^^xsd:string)
Declaration(Class(goldbook:12899))
AnnotationAssertion(rdfs:label goldbook:12899 "antiphospholipid syndrome")
AnnotationAssertion(dcterms:description goldbook:12899 "One of the most common autoimmune diseases, characterized by thrombosis, recurrent spontaneous abortions, and the presence of antiphospholipid antibodies.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12899 "APS")
AnnotationAssertion(rdfs:comment goldbook:12899 "Antiphospholipid syndrome may occur as an isolated disease (primary APS) or in combination with another autoimmune disease, especially systemic lupus erythematosus (SLE) (secondary APS)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12899 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:12899 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:12899 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12899 "current"^^xsd:string)
Declaration(Class(goldbook:12900))
AnnotationAssertion(rdfs:label goldbook:12900 "anti-sheep red blood cell IgM response assay")
AnnotationAssertion(dcterms:description goldbook:12900 "Test to determine T-cell-dependent antibody response, usually by enzyme-linked immunosorbent assay (ELISA). Sheep red blood cells (SRBCs) are used as an antigen. Often referred to as the plaque assay.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12900 "SRBC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12900 "plaque assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12900 "SRBC Assay")
AnnotationAssertion(rdfs:comment goldbook:12900 "A similar test is often performed with the tetanus toxoid as the antigen."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12900 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12900 goldbook:13115)
AnnotationAssertion(rdfs:seeAlso goldbook:12900 goldbook:13729)
AnnotationAssertion(mito:isMentionedBy goldbook:12900 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12900 "current"^^xsd:string)
Declaration(Class(goldbook:12901))
AnnotationAssertion(rdfs:label goldbook:12901 "antitoxin")
AnnotationAssertion(dcterms:description goldbook:12901 "Antibody specific for exotoxins produced by certain microorganisms such as the causative agents of diphtheria and tetanus.")
AnnotationAssertion(rdfs:seeAlso goldbook:12901 goldbook:13132)
AnnotationAssertion(mito:isMentionedBy goldbook:12901 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12901 "current"^^xsd:string)
Declaration(Class(goldbook:12902))
AnnotationAssertion(rdfs:label goldbook:12902 "aplastic anemia")
AnnotationAssertion(dcterms:description goldbook:12902 "Greatly decreased formation of erythrocytes and hemoglobin, usually associated with pronounced granulocytopenia and thrombocytopenia, as a result of hypoplastic or aplastic bone marrow.")
AnnotationAssertion(rdfs:comment goldbook:12902 "The diagnosis requires bone marrow biopsy to demonstrate replacement of blood cell precursors with fat cells and rule out other causes of pancytopenia such as neoplastic infiltration."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12902 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:12902 goldbook:13127)
AnnotationAssertion(rdfs:seeAlso goldbook:12902 goldbook:13184)
AnnotationAssertion(rdfs:seeAlso goldbook:12902 goldbook:13532)
AnnotationAssertion(mito:isMentionedBy goldbook:12902 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12902 "current"^^xsd:string)
Declaration(Class(goldbook:12903))
AnnotationAssertion(rdfs:label goldbook:12903 "arthritis")
AnnotationAssertion(dcterms:description goldbook:12903 "Inflammation of a joint or joints.")
AnnotationAssertion(rdfs:seeAlso goldbook:12903 goldbook:13651)
AnnotationAssertion(mito:isMentionedBy goldbook:12903 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12903 "current"^^xsd:string)
Declaration(Class(goldbook:12904))
AnnotationAssertion(rdfs:label goldbook:12904 "Arthus reaction")
AnnotationAssertion(dcterms:description goldbook:12904 "Local antibody-mediated hypersensitivity reaction in which antigen-antibody complexes which fix complement are deposited in the walls of small vessels, often in the skin, causing acute inflammation with an infiltration of neutrophils.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12904 "Gell and Coombs Type III reaction")
AnnotationAssertion(rdfs:seeAlso goldbook:12904 goldbook:13167)
AnnotationAssertion(rdfs:seeAlso goldbook:12904 goldbook:13241)
AnnotationAssertion(rdfs:seeAlso goldbook:12904 goldbook:13510)
AnnotationAssertion(mito:isMentionedBy goldbook:12904 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12904 "current"^^xsd:string)
Declaration(Class(goldbook:12905))
AnnotationAssertion(rdfs:label goldbook:12905 "asthma")
AnnotationAssertion(dcterms:description goldbook:12905 "Chronic respiratory disease characterized by bronchoconstriction, excessive mucus secretion, and edema of the pulmonary alveoli, resulting in difficulty in exhaling, wheezing, and cough.")
AnnotationAssertion(mito:isMentionedBy goldbook:12905 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12905 "current"^^xsd:string)
Declaration(Class(goldbook:12906))
AnnotationAssertion(rdfs:label goldbook:12906 "ataxia telangiectasia")
AnnotationAssertion(dcterms:description goldbook:12906 "Disease characterized by staggering gait, multiple disorganized blood vessels, and an immunodeficiency, associated with a protein called ataxia telangiectasia-mutated (ATM), a protein kinase thought to be important in detection of double-stranded DNA breaks.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12906 "AT")
AnnotationAssertion(rdfs:seeAlso goldbook:12906 goldbook:13281)
