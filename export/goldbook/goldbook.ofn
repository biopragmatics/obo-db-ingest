AnnotationAssertion(obo:goldbook#hasStatus goldbook:13211 "current"^^xsd:string)
Declaration(Class(goldbook:13212))
AnnotationAssertion(rdfs:label goldbook:13212 "high endothelial venule")
AnnotationAssertion(dcterms:description goldbook:13212 "Specialized venule in lymphoid tissues that has walls permeable to migrating lymphocytes, allowing them to move from blood into the lymphoid tissues.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13212 "HEV")
AnnotationAssertion(rdfs:seeAlso goldbook:13212 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13212 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13212 "current"^^xsd:string)
Declaration(Class(goldbook:13213))
AnnotationAssertion(rdfs:label goldbook:13213 "highly active antiretroviral therapy")
AnnotationAssertion(dcterms:description goldbook:13213 "Approach to the treatment of acquired immune deficiency syndrome (AIDS) patients involving a combination of nucleoside analogs, which prevent reverse transcription, with drugs that inhibit responses to the virus.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13213 "HAART")
AnnotationAssertion(rdfs:seeAlso goldbook:13213 goldbook:12833)
AnnotationAssertion(mito:isMentionedBy goldbook:13213 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13213 "current"^^xsd:string)
