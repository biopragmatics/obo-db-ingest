[Term]
id: goldbook:O04310
name: optical purity
def: "The ratio of the observed optical rotation of a sample consisting of a mixture of enantiomers to the optical rotation of one pure enantiomer."
property_value: mito:isMentionedBy doi:10.1351/pac199668122193
property_value: hasStatus "current" xsd:string
