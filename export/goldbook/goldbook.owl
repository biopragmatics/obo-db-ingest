        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.Y06728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.A00564 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.A00564">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds having the structure $\ce{RN=CR2}$ ($\ce{R eq H}$). Many consider the term to include the compounds $\ce{RN=CRH}$ ($\ce{R eq H}$), thus making azomethines synonymous with Schiff bases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>azomethines</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.I02957"/>
