AnnotationAssertion(rdfs:seeAlso goldbook:V06589 goldbook:C01244)
AnnotationAssertion(rdfs:seeAlso goldbook:V06589 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:V06589 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:V06589 "current"^^xsd:string)
