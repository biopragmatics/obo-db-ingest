Declaration(Class(goldbook:13103))
AnnotationAssertion(rdfs:label goldbook:13103 "draining lymph node")
AnnotationAssertion(dcterms:description goldbook:13103 "Lymph node that is downstream of a site of infection and thus receives antigens and microbes from the site via the lymphatic system.")
AnnotationAssertion(rdfs:comment goldbook:13103 "Draining lymph nodes often enlarge enormously during an immune response and can be palpated; they were originally called swollen glands."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13103 goldbook:13397)
AnnotationAssertion(rdfs:seeAlso goldbook:13103 goldbook:13395)
