AnnotationAssertion(rdfs:seeAlso goldbook:11759 goldbook:12163)
AnnotationAssertion(mito:isMentionedBy goldbook:11759 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11759 "current"^^xsd:string)
Declaration(Class(goldbook:11760))
AnnotationAssertion(rdfs:label goldbook:11760 "ergotism")
AnnotationAssertion(dcterms:description goldbook:11760 "Poisoning produced by eating food affected by ergot (ergotamine alkaloids), substances produced by the fungus Claviceps purpurea that contaminate rye and wheat.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11760 "ignis infernalis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11760 "ignis sacer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11760 "St Anthony’s fire")
AnnotationAssertion(rdfs:comment goldbook:11760 "Ergotism typically results in hallucinations, headache, vomiting, diarrhea, a painful burning sensation in the limbs and extremities, and gangrene of the fingers and toes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11760 goldbook:11799)
AnnotationAssertion(rdfs:seeAlso goldbook:11760 goldbook:11800)
AnnotationAssertion(mito:isMentionedBy goldbook:11760 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11760 "current"^^xsd:string)
