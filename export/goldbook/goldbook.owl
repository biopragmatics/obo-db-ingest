    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10762">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gamete or an embryonic cell that can develop into a gamete.</dcterms:description>
