AnnotationAssertion(rdfs:comment goldbook:13420 "Used as a check on accuracy in counting the proportion of cell types, e.g., a value of \\(\\pu{(100 \\pm 10)\\%}\\) being acceptable and reflecting the uncertainty of the method."^^xsd:string)
