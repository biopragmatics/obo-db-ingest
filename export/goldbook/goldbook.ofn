AnnotationAssertion(obo:goldbook#hasStatus goldbook:GT07536 "current"^^xsd:string)
Declaration(Class(goldbook:GT07537))
AnnotationAssertion(rdfs:label goldbook:GT07537 "gelation temperature")
AnnotationAssertion(dcterms:description goldbook:GT07537 "Temperature threshold for the formation of a thermoreversible gel.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:GT07537 "gel temperature")
AnnotationAssertion(rdfs:comment goldbook:GT07537 "A thermoreversible gel is usually formed by cooling a polymer solution. In these cases, the gel temperature is a maximum temperature at which the presence of network is observed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:GT07537 "Since gel temperatures depend on the method of determination, this should always be indicated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07537 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07537 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07537 goldbook:TT07531)
AnnotationAssertion(mito:isMentionedBy goldbook:GT07537 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:GT07537 "current"^^xsd:string)
Declaration(Class(goldbook:GT07551))
AnnotationAssertion(rdfs:label goldbook:GT07551 "gel fraction")
AnnotationAssertion(dcterms:description goldbook:GT07551 "Mass fraction of the network material resulting from a network-forming polymerization or crosslinking process.")
AnnotationAssertion(rdfs:comment goldbook:GT07551 "The gel fraction comprises a single molecule spanning the entire volume of the material sample."^^xsd:string)
