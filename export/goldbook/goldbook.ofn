Declaration(Class(goldbook:10331))
AnnotationAssertion(rdfs:label goldbook:10331 "acrocephaly")
AnnotationAssertion(dcterms:description goldbook:10331 "Type of cephalic disorder where the top of the skull is pointed or conical due to premature closure of the coronal suture plus any other suture.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10331 "acrocephalia")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10331 "oxycephaly")
Declaration(Class(goldbook:10332))
