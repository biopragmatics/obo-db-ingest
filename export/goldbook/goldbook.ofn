Declaration(Class(goldbook:08965))
AnnotationAssertion(rdfs:label goldbook:08965 "primary species")
AnnotationAssertion(dcterms:description goldbook:08965 "Species that is formed from an initiator or monomer molecule and that is capable of initiating polymerization.")
AnnotationAssertion(rdfs:comment goldbook:08965 "In radical polymerization a primary radical may be formed by the action of heat, irradiation or electron-transfer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08965 "In radical polymerization, recombination of primary radicals and their reactions with other radicals leads to reduced initiator efficiency."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08965 "The term 'primary species' is also used to designate a species centred on a primary carbon atom, for example, an ethyl radical."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08965 goldbook:08960)
AnnotationAssertion(rdfs:seeAlso goldbook:08965 goldbook:08969)
AnnotationAssertion(mito:isMentionedBy goldbook:08965 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08965 "current"^^xsd:string)
Declaration(Class(goldbook:08966))
AnnotationAssertion(rdfs:label goldbook:08966 "propagating species")
AnnotationAssertion(dcterms:description goldbook:08966 "Active species formed by addition to monomer that is capable of adding further monomer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08966 "active macromolecule (in RDP)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08966 "active polymer chain")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08966 "growing chain")
AnnotationAssertion(rdfs:comment goldbook:08966 "The propagating species are chain carriers in chain polymerization."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08966 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08966 "current"^^xsd:string)
Declaration(Class(goldbook:08967))
