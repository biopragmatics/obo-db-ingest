AnnotationAssertion(rdfs:label goldbook:W06676 "Wiegner effect")
AnnotationAssertion(dcterms:description goldbook:W06676 "Synonymous with suspension effect (in an ion-selective electrode).")
AnnotationAssertion(rdfs:seeAlso goldbook:W06676 goldbook:S06199)
AnnotationAssertion(mito:isMentionedBy goldbook:W06676 doi:10.1351/pac199466122527)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06676 "current"^^xsd:string)
