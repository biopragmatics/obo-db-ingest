AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12175 "Morris water maze test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12175 "water navigation test")
AnnotationAssertion(rdfs:comment goldbook:12175 "It is intended to test spatial memory and learning."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12175 goldbook:11637)
AnnotationAssertion(rdfs:seeAlso goldbook:12175 goldbook:11859)
AnnotationAssertion(mito:isMentionedBy goldbook:12175 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12175 "current"^^xsd:string)
Declaration(Class(goldbook:12176))
AnnotationAssertion(rdfs:label goldbook:12176 "Wernicke aphasia")
AnnotationAssertion(dcterms:description goldbook:12176 "Type of aphasia associated with damage to Wernicke’s area or alternatively the medial temporal lobe of the brain, characterized by preservation of speech but with loss of meaningful language and language comprehension.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12176 "fluent aphasia")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12176 "receptive aphasia")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12176 "sensory aphasia")
