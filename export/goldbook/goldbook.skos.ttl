    skos:prefLabel "polybenzoxazole" .

goldbook:15273 a skos:Concept ;
    skos:altLabel "polyurethane" ;
    skos:definition "Polymer composed of macromolecules containing carbamate (formerly urethane) or N-substituted carbamate linkages in the backbone: \\[\\ce{-NR-CO-O\\bond{-}}\\] where \\(\\ce{R}\\) is hydrogen, alkyl, aryl, heteroaryl, substituted alkyl, substituted aryl, or substituted heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycarbamate" .

goldbook:15274 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing carbodiimide linkages in the backbone: \\[\\ce{-N=C=N\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
