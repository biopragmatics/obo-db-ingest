AnnotationAssertion(dcterms:description goldbook:LT07410 "Acronym for lifetime-associated spectra.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:LT07410 "LAS")
AnnotationAssertion(rdfs:seeAlso goldbook:LT07410 goldbook:GT07389)
AnnotationAssertion(mito:isMentionedBy goldbook:LT07410 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:LT07410 "current"^^xsd:string)
