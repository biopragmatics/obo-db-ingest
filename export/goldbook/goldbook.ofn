AnnotationAssertion(rdfs:seeAlso goldbook:M04021 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:M04021 goldbook:S05441)
AnnotationAssertion(rdfs:seeAlso goldbook:M04021 goldbook:U06579)
