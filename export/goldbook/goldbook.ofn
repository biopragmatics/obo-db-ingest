AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10678 "17β-estradiol")
Declaration(Class(goldbook:10679))
AnnotationAssertion(rdfs:label goldbook:10679 "estriol")
AnnotationAssertion(dcterms:description goldbook:10679 "Hormonally active metabolite of estradiol, eliminated in urine, especially during pregnancy.")
Declaration(Class(goldbook:10680))
AnnotationAssertion(rdfs:label goldbook:10680 "estrogen")
AnnotationAssertion(dcterms:description goldbook:10680 "Any substance, natural or synthetic, that exerts the hormonal effects of the natural estrogen, estradiol, usually by interaction with the estrogen receptor.")
Declaration(Class(goldbook:10681))
AnnotationAssertion(rdfs:label goldbook:10681 "<em>in vitro</em> estrogen activity assay")
AnnotationAssertion(dcterms:description goldbook:10681 """Procedure in which a tumor cell line is exposed to a test substance and activation of the estrogen receptor is studied by a reporter molecule in order to assess the estrogen-sensitivity of the tumor.
Test using estrogen-sensitive cells to evaluate estrogenic activity of a substance or environmental sample.""")
Declaration(Class(goldbook:10682))
AnnotationAssertion(rdfs:label goldbook:10682 "estrogen-mimetic")
AnnotationAssertion(dcterms:description goldbook:10682 "Behaving like an estrogen.")
Declaration(Class(goldbook:10683))
AnnotationAssertion(rdfs:label goldbook:10683 "estrogenic")
AnnotationAssertion(dcterms:description goldbook:10683 "Exhibiting hormonal activity similar to that of estrogens.")
Declaration(Class(goldbook:10684))
AnnotationAssertion(rdfs:label goldbook:10684 "estrous cycle")
AnnotationAssertion(dcterms:description goldbook:10684 "Sequence of recurring physiological uterine, ovarian, and other changes, induced by reproductive hormones in higher female animals, resulting in readiness for insemination. This cycle starts in adulthood (at menarche), transiently discontinues during pregnancy, and disappears at the menopause.")
Declaration(Class(goldbook:10685))
AnnotationAssertion(rdfs:label goldbook:10685 "estrus")
AnnotationAssertion(dcterms:description goldbook:10685 "Recurrent period of sexual receptivity and arousal in the female of most mammals except the higher primates, during which conception is possible.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10685 "heat")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10685 "oestrus")
Declaration(Class(goldbook:10686))
