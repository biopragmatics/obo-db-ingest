AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03253 "current"^^xsd:string)
Declaration(Class(goldbook:I03254))
AnnotationAssertion(rdfs:label goldbook:I03254 "irradiance")
AnnotationAssertion(dcterms:description goldbook:I03254 "Radiant power, \\(P\\), of all wavelengths incident from all upward directions on a small element of surface containing the point under consideration divided by the area of the element. SI unit is \\(\\rm{W m}^{-2}\\).")
AnnotationAssertion(rdfs:comment goldbook:I03254 "Mathematical definition: \\(E = \\frac{\\rm{d}P}{\\rm{d}S}\\). If the radiant power is constant over the surface area considered, \\(E = \\frac{P}{S}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:I03254 "Alternative definition: Integral, taken over the hemisphere visible from the given point, of the expression \\(L\\, \\rm{cos}\\,\\theta\\,\\rm{d}\\varOmega\\), where \\(L\\) is the radiance at the given point in the various directions of the incident elementary beams of solid angle \\(\\varOmega\\) and \\(\\theta\\) is the angle between any of the beams and the normal to the surface at the given point. \\[E = \\int_{2\\pi}L\\, \\rm{cos}\\,\\theta\\, \\rm{d}\\varOmega\\]"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:I03254 "This term refers to a beam not scattered or reflected by the target or its surroundings. For a beam incident from all directions, fluence rate (\\(E_{o}\\)) is an equivalent term."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:I03254 "\\(E = \\int_{\\lambda}E_{\\lambda}\\, \\rm{d}\\lambda\\) where \\(E_{\\lambda}\\) is the spectral irradiance at wavelength \\(\\lambda\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:I03254 goldbook:R05046)
AnnotationAssertion(rdfs:seeAlso goldbook:I03254 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:I03254 goldbook:FT07376)
AnnotationAssertion(rdfs:seeAlso goldbook:I03254 goldbook:R05037)
AnnotationAssertion(rdfs:seeAlso goldbook:I03254 goldbook:S05817)
AnnotationAssertion(rdfs:seeAlso goldbook:I03254 goldbook:VT07496)
AnnotationAssertion(rdfs:seeAlso goldbook:I03254 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:I03254 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03254 "current"^^xsd:string)
