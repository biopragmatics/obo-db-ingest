AnnotationAssertion(rdfs:label goldbook:16094 "slope factor")
AnnotationAssertion(dcterms:description goldbook:16094 "Value, in inverse concentration or dose units, derived from the slope of a dose-response curve; in practice, limited to carcinogenic effects with the curve assumed to be linear at low concentrations or doses.")
AnnotationAssertion(rdfs:comment goldbook:16094 "The product of the slope factor and the exposure is taken to reflect the probability of producing the related effect."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16094 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16094 "current"^^xsd:string)
