[Term]
id: goldbook:13268
name: immune response-associated protein
def: "Protein found in antigen-presenting cells \(APCs\) and B lymphocytes in mice."
synonym: "Ia protein" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-11-06-03
property_value: hasStatus "current" xsd:string
consider: goldbook:12888
consider: goldbook:12937
consider: goldbook:13248

[Term]
id: goldbook:13269
name: immune response genes
def: "Genes\, including those within the major histocompatibility complex \(MHC\)\, that together determine the overall level of immune response to a given antigen."
synonym: "ir genes" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-11-06-03
property_value: hasStatus "current" xsd:string
