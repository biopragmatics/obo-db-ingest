AnnotationAssertion(rdfs:seeAlso goldbook:12075 goldbook:11794)
AnnotationAssertion(mito:isMentionedBy goldbook:12075 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12075 "current"^^xsd:string)
