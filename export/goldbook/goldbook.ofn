Declaration(Class(goldbook:G02614))
AnnotationAssertion(rdfs:label goldbook:G02614 "generation time")
AnnotationAssertion(dcterms:description goldbook:G02614 "The average time required by a cell for the completion of one cell cycle.")
AnnotationAssertion(mito:isMentionedBy goldbook:G02614 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02614 "current"^^xsd:string)
Declaration(Class(goldbook:G02615))
AnnotationAssertion(rdfs:label goldbook:G02615 "genetic code")
AnnotationAssertion(dcterms:description goldbook:G02615 "The set of rules which governs the relationship between the linear order of the nucleotides in an mRNA molecule and the sequence of the amino acids in the protein which it encodes. The genetic code is a triplet code, nearly universal. It is not overlapping: a mutation which alters only a single nucleotide in a gene can change only one amino acid in the encoded protein. It is degenerate: it assigns each of the 20 amino acids to one or more of 61 of the 64 possible nucleotide triplets (cf. codon) that can be constructed from four nucleotides. The remaining three triplets are used to signal the termination of a genetic message.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:G02615 "mRNA")
AnnotationAssertion(rdfs:seeAlso goldbook:G02615 goldbook:C01123)
AnnotationAssertion(rdfs:seeAlso goldbook:G02615 goldbook:M03857)
AnnotationAssertion(rdfs:seeAlso goldbook:G02615 goldbook:M04074)
AnnotationAssertion(rdfs:seeAlso goldbook:G02615 goldbook:N04255)
AnnotationAssertion(rdfs:seeAlso goldbook:G02615 goldbook:ST06775)
AnnotationAssertion(rdfs:seeAlso goldbook:G02615 goldbook:T06274)
AnnotationAssertion(mito:isMentionedBy goldbook:G02615 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02615 "current"^^xsd:string)
Declaration(Class(goldbook:G02616))
AnnotationAssertion(rdfs:label goldbook:G02616 "genome")
AnnotationAssertion(dcterms:description goldbook:G02616 "The complete set of chromosomal and extrachromosomal genes of an organism, a cell, an organelle or a virus; the complete DNA component of an organism.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:G02616 "DNA")
AnnotationAssertion(rdfs:seeAlso goldbook:G02616 goldbook:D01597)
