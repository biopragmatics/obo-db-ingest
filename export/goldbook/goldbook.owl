    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.S06127">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The parent compound $\ce{HN=S=NH}$ and hydrocarbyl derivatives.</dcterms:description>
