[Term]
id: goldbook:08120
name: reference material producer
def: "Technically competent body that produces a reference material compliant with the appropriate guidance documents and issues the reference material documentation."
comment: ""Body" refers to an organization."
comment: "ISO 17034 provides the general requirements for the competence of reference material producers."
comment: "The relevant guidance documents are the ISO Guides 31 and 35."
synonym: "RM producer" []
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0819
property_value: hasStatus "current" xsd:string
