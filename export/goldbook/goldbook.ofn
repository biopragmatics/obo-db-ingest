AnnotationAssertion(dcterms:description goldbook:15623 "Obsolete term for cytochrome P450 I, A1, and A2, one of the major families of the cytochromes P450 hemoproteins.")
AnnotationAssertion(rdfs:comment goldbook:15623 "During the monooxygenation of certain substances, often a detoxification process, these iso-enzymes may produce intermediates which can initiate mutations, cancer, immunotoxic reactions, and adverse effects."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15623 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15623 "current"^^xsd:string)
Declaration(Class(goldbook:15624))
