[Term]
id: goldbook:09336
name: inelastic scattering cross section
def: "Cross section for inelastic scattering by an electron traversing a material."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0404
property_value: hasStatus "current" xsd:string
