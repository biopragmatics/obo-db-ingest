AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10540 "talipes")
Declaration(Class(goldbook:10541))
AnnotationAssertion(rdfs:label goldbook:10541 "coarctation")
AnnotationAssertion(dcterms:description goldbook:10541 "Narrowing or constriction of a short section of a blood vessel, commonly of the aorta.")
Declaration(Class(goldbook:10542))
AnnotationAssertion(rdfs:label goldbook:10542 "cochlea")
AnnotationAssertion(dcterms:description goldbook:10542 "Spiral cavity of the inner ear containing the organ of Corti that transduces sound into nerve impulses.")
Declaration(Class(goldbook:10543))
AnnotationAssertion(rdfs:label goldbook:10543 "coelom")
