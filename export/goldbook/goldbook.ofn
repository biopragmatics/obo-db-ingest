AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02588 "current"^^xsd:string)
Declaration(Class(goldbook:G02589))
AnnotationAssertion(rdfs:label goldbook:G02589 "gas-phase-grown carbon fibres")
AnnotationAssertion(dcterms:description goldbook:G02589 "Carbon fibres grown in an atmosphere of hydrocarbons with the aid of fine particulate solid catalysts such as iron or other transition metals and consisting of graphitizable carbon.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:G02589 "CVD")
AnnotationAssertion(rdfs:comment goldbook:G02589 "Gas-phase-grown carbon fibres transform during graphitization heat treatment into graphite fibres. These show a very high degree of preferred orientation and are particularly suitable for intercalation treatments. The term 'vapour-grown carbon fibres' alternatively used in the literature is acceptable. The use of the term 'CVD fibres' is not recommended as an alternative for gas-phase-grown carbon fibres since the term 'CVD fibres' also describes fibres grown by a chemical vapour deposition (CVD) process on substrate fibres."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02589 goldbook:C00831)
AnnotationAssertion(rdfs:seeAlso goldbook:G02589 goldbook:G02686)
AnnotationAssertion(rdfs:seeAlso goldbook:G02589 goldbook:G02690)
AnnotationAssertion(rdfs:seeAlso goldbook:G02589 goldbook:G02692)
AnnotationAssertion(rdfs:seeAlso goldbook:G02589 goldbook:H02889)
AnnotationAssertion(mito:isMentionedBy goldbook:G02589 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02589 "current"^^xsd:string)
Declaration(Class(goldbook:G02590))
AnnotationAssertion(rdfs:label goldbook:G02590 "gas sensing electrode")
AnnotationAssertion(dcterms:description goldbook:G02590 "A sensor composed of an indicator and a reference electrode in contact with a thin film of solution which is separated from the bulk of the sample solution by a gas-permeable membrane or an air gap. This intermediate solution interacts with the gaseous species (penetrated through the membrane or an air gap) in such a way as to produce a change in a measured constituent (e.g. the $\\ce{H^{+}}$ activity) of the intermediate solution. This change is then sensed by the ion-selective electrode and is related to the partial pressure of the gaseous species in the sample. [Note: In electrochemical literature the term gas electrode is used for the classical, redox-equilibrium-based gas electrodes as well, such as the hydrogen or the chlorine gas electrodes ($\\ce{Pt(s)}$|$\\ce{H2(g)}$|$\\ce{H^{+}(aq)}$ or $\\ce{Pt(s)}$|$\\ce{Cl2(g)}$|$\\ce{Cl^{-}(aq)}$]. These electrodes respond both to the partial pressure of the gas ($\\ce{H2}$ or $\\ce{Cl2}$) and to the ionic activities ($\\ce{H^{+}}$ or $\\ce{Cl^{-}}$). The Clark oxygen electrode fits under this classification although, in contrast to other gas sensors, it is an amperometric and not a potentiometric device.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02590 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:G02590 goldbook:I03244)
AnnotationAssertion(rdfs:seeAlso goldbook:G02590 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:G02590 goldbook:P04420)
AnnotationAssertion(rdfs:seeAlso goldbook:G02590 goldbook:R05229)
AnnotationAssertion(rdfs:seeAlso goldbook:G02590 goldbook:T06345)
AnnotationAssertion(mito:isMentionedBy goldbook:G02590 doi:10.1351/pac199466122527)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02590 "current"^^xsd:string)
