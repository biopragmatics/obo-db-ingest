AnnotationAssertion(mito:isMentionedBy goldbook:16038 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16038 "current"^^xsd:string)
Declaration(Class(goldbook:16039))
AnnotationAssertion(rdfs:label goldbook:16039 "regulatory sequence")
AnnotationAssertion(dcterms:description goldbook:16039 "DNA sequence to which specific proteins bind to activate or repress the expression of a gene.")
AnnotationAssertion(mito:isMentionedBy goldbook:16039 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16039 "current"^^xsd:string)
Declaration(Class(goldbook:16040))
AnnotationAssertion(rdfs:label goldbook:16040 "relative excess risk")
AnnotationAssertion(dcterms:description goldbook:16040 "Measure that can be used in comparison of adverse reactions to drugs, or other exposures, based solely on the component of risk due to the exposure or drug under investigation, removing the risk due to background exposure experienced by all in the population. The relative excess risk, \\(R\\), is given by \\[R = (R_{1} - R_{0})/(R_{2} - R_{0})\\] where \\(R_{1}\\) is the rate in the population, \\(R_{2}\\) is the rate in the comparison population, and \\(R_{0}\\) is the rate in the general population.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16040 "RER")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16040 "comparative risk")
AnnotationAssertion(rdfs:comment goldbook:16040 "Rate is used here as in epidemiology."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16040 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16040 "current"^^xsd:string)
Declaration(Class(goldbook:16041))
AnnotationAssertion(rdfs:label goldbook:16041 "relative systemic availability")
AnnotationAssertion(dcterms:description goldbook:16041 "Quantity of metabolizable substance divided by product of quantity of absorbed substance and exposure.")
AnnotationAssertion(mito:isMentionedBy goldbook:16041 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16041 "current"^^xsd:string)
Declaration(Class(goldbook:16042))
AnnotationAssertion(rdfs:label goldbook:16042 "remedy")
AnnotationAssertion(dcterms:description goldbook:16042 "Anything, such as a medicine or therapy, that relieves pain, cures disease, or corrects a disorder.")
AnnotationAssertion(mito:isMentionedBy goldbook:16042 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16042 "current"^^xsd:string)
Declaration(Class(goldbook:16043))
AnnotationAssertion(rdfs:label goldbook:16043 "renal plasma flow")
AnnotationAssertion(dcterms:description goldbook:16043 "Volume of plasma passing through the kidneys in unit time.")
AnnotationAssertion(mito:isMentionedBy goldbook:16043 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16043 "current"^^xsd:string)
Declaration(Class(goldbook:16044))
