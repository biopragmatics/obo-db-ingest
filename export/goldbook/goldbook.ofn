AnnotationAssertion(rdfs:comment goldbook:13569 "Aftershave lotions, sunscreens, and certain topical sulfa drugs may be changed into allergens, while coal tar and certain oils used in manufacturing may become irritants after exposure to sunlight."^^xsd:string)
