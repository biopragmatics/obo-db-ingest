        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease of a joint.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>arthrosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>arthropathy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15479 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15479">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Joint or articulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>arthrosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15480 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15480">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of pneumoconiosis caused by inhalation of asbestos fibers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>asbestosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15984"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15481 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15481">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill roundworms (Ascaridae).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>ascaricide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15482 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15482">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition resulting from insufficient intake of oxygen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Symptoms include breathing difficulty, impairment of senses, and, in extreme, convulsions, unconsciousness and death.</rdfs:comment>
        <rdfs:label>asphyxia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15483 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15483">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that blocks the transport or use of oxygen by living organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>asphyxiant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15484 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15484">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Uptake and incorporation of substances by a living organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>assimilation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15485 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15485">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Weakness; lack or loss of strength.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>asthenia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15486 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15486">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>adj., Causing contraction, usually locally after topical application. n., Substance causing cells to shrink, thus causing tissue contraction or stoppage of secretions and discharges; such substances may be applied to skin to harden and protect it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>adstringent</oboInOwl:hasRelatedSynonym>
        <rdfs:label>astringent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15487 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15487">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological condition in which there is thickening, hardening, and loss of elasticity of the walls of blood vessels, characterized by a variable combination of changes of the innermost layer consisting of local accumulation of lipids, complex carbohydrates, blood and blood components, fibrous tissue, and calcium deposits. In addition, the outer layer becomes thickened and there is fatty degeneration of the middle layer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>atherosclerosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15476"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15488 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15488">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that attracts animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Some attractants fulfill natural biological functions such as mating or predation, others may be used to attract animals for monitoring or for control.</rdfs:comment>
        <rdfs:label>attractant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15489 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15489">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane-bound body (secondary lysosome) in which parts of the cell are digested.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>autophagosome</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15490 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15490">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction with dioxygen at moderate temperatures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>autooxidation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autoxidation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15491 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15491">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparently spontaneous, usually slow reaction of foodstuff components with dioxygen in an aerobic environment at moderate temperatures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>autoxidation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15492 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15492">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism unable to synthesize an organic molecule which is required for its growth: When the compound is given to the organism with the other nutrients it requires, growth of the organism may occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>auxotroph</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15493 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15493">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill birds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>avicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15494 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15494">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process that reverses the effect of a mutation which had inactivated a gene; thus, it restores the wild phenotype.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>back-mutation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15495 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15495">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>DNA vector into which large DNA fragments can be inserted and cloned in a bacterial host.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>BAC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bacterial artificial chromosome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15495"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BAC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15496 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15496">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill bacteria.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bactericide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15497 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15497">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lung disease caused by the inhalation of dust from sugar-cane residues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bagassosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15498 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15498">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Triple-layered structure on which epithelium sits: It consists of an electron-dense layer (lamina densa) between two electron-transparent layers (lamina lucida). The lamina densa is composed of type IV collagen, and the lamina lucida contains the glycoprotein laminin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>basal lamina</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15499 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15499">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation expressing the build up and decay in concentration of a substance (usually in plasma) based on first-order uptake and elimination in a one-compartment model, having the form \[C = [fDk_{\rm{a}}/V(k_{\rm{a}} - k_{\rm{e}})] [\exp(-k_{\rm{e}}t) - \exp(-k_{\rm{a}}t)] \]where \(C\) is the concentration and \(D\) the dose of the substance, \(f\) the fraction absorbed, and \(V\) the volume of distribution. \(k_{\rm{a}}\) and \(k_{\rm{e}}\) are the first-order rate constants of uptake and elimination, respectively, and \(t\) is time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>Bateman function</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15500 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15500">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological monitoring guidance value set at the \(90^{\rm{th}}\) percentile of available biological monitoring results collected from a representative sample of workplaces with good occupational hygiene practices.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>benchmark guidance value</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15501 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15501">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Response, expressed as an excess of background, at which a benchmark dose or benchmark concentration is set.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>benchmark response</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15502 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15502">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of a disease, producing no persisting harmful effects. Tumor that does not invade other tissues (see metastasis ), having lost growth control but not positional control.Note: Such a tumor is not carcinogenic but may cause mechanical damage to adjacent tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>benign</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15879"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15503 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15503">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serious and usually permanent lung damage resulting from chronic inhalation of beryllium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>berylliosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>beryllium disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15504 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15504">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any sample that is not a random sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biased sample</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15505 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15505">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Orange-yellow pigment, a breakdown product of heme-containing proteins (hemoglobin, myoglobin, cytochromes), which circulates in the blood plasma bound to albumin or as water-soluble glucuronide conjugates, and is excreted in the bile by the liver.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bilirubin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15506 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15506">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of living organisms to concentrate a substance obtained either directly from the environment or indirectly through its food.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bioaccumulation potential</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15507 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15507">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction or series of reactions, usually enzyme-catalyzed, associated with a specific physiological event in a living organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biochemical mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15508 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15508">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Removal, usually from the aqueous phase, of a test substance in the presence of living organisms by biological processes supplemented by physicochemical reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bioelimination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15509 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15509">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metabolic conversion of a xenobiotic to a less toxic derivative.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bioinactivation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15550"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15510 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15510">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science of the movements involved in the distribution of substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biokinetics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15511 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15511">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete circulatory process through which a substance passes in the biosphere. It may involve transport through the various media (air, water, soil), followed by environmental transformation, and carriage through various ecosystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biological cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15512 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15512">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound derived from living organisms and their products for use in medicine or as a pesticide, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>biopreparation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>biological preparation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15513 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15513">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organ, tissue (including blood), secretion, or excretion product taken from an organism as a sample reflecting the state of the whole organism. Organism taken as a sample reflecting the state of a population or their environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biological specimen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15514 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15514">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Military operations using any organism (bacteria, virus, or other disease-causing organism) or toxin found in nature, to kill, injure, or incapacitate human beings, animals, or plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>germ warfare</oboInOwl:hasRelatedSynonym>
        <rdfs:label>biological warfare</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15515 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15515">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excision of a small piece of living tissue for microscopic or biochemical examination; usually performed to establish a diagnosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biopsy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15516 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15516">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adjective applied to a substance that arrests the growth or multiplication of living organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biostatic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15517 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15517">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>All living organisms as a totality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>biota</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15518 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15518">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metal chelator that has been used in the treatment of arsenic, antimony, gold, mercury, and lead poisoning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3-dimercaptopropan-1-ol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>British anti-Lewisite</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dimercaprol</oboInOwl:hasRelatedSynonym>
        <rdfs:label>2,3-bis(sulfanyl)propan-1-ol</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15519 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15519">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Single dose of a substance, originally a large pill. Dose of a substance administered by a single rapid intravenous injection. Concentrated mass of food ready to be swallowed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bolus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15520 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15520">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance with activity against pests, that is produced naturally within a plant and may act as a defense against predators.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>botanical pesticide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15521 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15521">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute food poisoning caused by botulinum toxin produced in food by the bacterium Clostridium botulinum and characterized by muscle weakness and paralysis; disturbances of vision, swallowing, and speech; and a high mortality rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>botulism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15522 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15522">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prefix meaning slow as in bradycardia or bradypnoea.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>brady-</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15523"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15523 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15523">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally slow breathing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>bradypnoea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16128"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15524 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15524">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Space within a radius of \(\pu{0.5 m}\) from a person’s face.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>breathing zone</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15525 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15525">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrowing of the air passages through the bronchi of the lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
