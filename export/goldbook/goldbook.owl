        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the influence of hereditary factors on the response of individuals or populations to environmental factors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ecogenetics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10632 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10632">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In an embryo, outermost layer that develops into the epidermis of the skin and the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ectoderm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10457"/>
