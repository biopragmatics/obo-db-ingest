AnnotationAssertion(rdfs:label goldbook:C00781 "calibration mixture")
AnnotationAssertion(dcterms:description goldbook:C00781 "A gaseous or liquid mixture of known composition, generally comprising one or more calibration components and an inert diluent, used directly for testing and calibration of analytical instruments.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00781 goldbook:I03026)
AnnotationAssertion(mito:isMentionedBy goldbook:C00781 doi:10.1351/pac199062112167)
