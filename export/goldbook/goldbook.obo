property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:10052
name: exploratory data analysis
def: "Summary of the main characteristics of data\, often using graphical methods."
comment: "Exploratory data analysis is recommended before deciding an approach to chemometric modelling."
synonym: "EDA" RELATED OMO:0003000 []
synonym: "initial data analysis" []
property_value: mito:isMentionedBy doi:10.1515/pac-2015-0605
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:10053
name: mean centering
def: "Data pre-processing in which the mean value of a variable is subtracted from data across all objects. \\\[a_\{i\,j\}^\{\\ast\} = a_\{i\,j\} - \\frac\{1\}\{n\} \\sum \\limits_\{i\\\,=\\\,1\}^\{n\} a_\{i\,j\}\\\]"
comment: "Mean centering emphasises the differences between samples rather than differences between the samples and the variable’s origin (zero)."
comment: "Mean centering is generally applied with other data pre-processing methods."
comment: "Mean centering is generally recommended for principal component analysis, partial least squares and discriminant analysis of data, where relative values across the samples are more important than their absolute deviation from zero. Mean centering is not compatible with non-negativity constraints in, for example, multivariate curve resolution."
synonym: "centering" []
property_value: mito:isMentionedBy doi:10.1515/pac-2015-0605
property_value: hasStatus "current" xsd:string
