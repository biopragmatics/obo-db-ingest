AnnotationAssertion(rdfs:label goldbook:11755 "enkephalin")
AnnotationAssertion(dcterms:description goldbook:11755 "Either of two endogenous pentapeptides with opiate-like effects that are especially involved in modulating pain responses in the central nervous system.")
AnnotationAssertion(rdfs:seeAlso goldbook:11755 goldbook:11754)
AnnotationAssertion(rdfs:seeAlso goldbook:11755 goldbook:11975)
AnnotationAssertion(rdfs:seeAlso goldbook:11755 goldbook:11983)
