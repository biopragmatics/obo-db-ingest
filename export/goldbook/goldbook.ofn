AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT06777 "current"^^xsd:string)
Declaration(Class(goldbook:CT06814))
AnnotationAssertion(rdfs:label goldbook:CT06814 "carrier protein")
AnnotationAssertion(dcterms:description goldbook:CT06814 "Protein to which a specific ligand or hapten is conjugated.Unlabeled protein introduced into an assay at relatively high concentrations which distributes in a fractionation process in the same manner as labeled protein analyte, present in very low concentrations.Protein added to prevent non-specific interaction of reagents with surfaces, sample components, and each other.Protein found in cell membranes, which facilitates transport of a ligand across the membrane.")
