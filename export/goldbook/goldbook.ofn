Declaration(Class(goldbook:QT06977))
AnnotationAssertion(rdfs:label goldbook:QT06977 "quantitative structure–activity relationship")
AnnotationAssertion(dcterms:description goldbook:QT06977 "Quantitative structure–activity relationships (QSAR) are mathematical relationships linking chemical structure and pharmacological activity in a quantitative manner for a series of compounds. Methods which can be used in QSAR include various regression and pattern recognition techniques.QSAR is often taken to be equivalent to chemometrics or multivariate statistical data analysis. It is sometimes used in a more limited sense as equivalent to Hansch analysis. QSAR is a subset of the more general term SPC.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:QT06977 "QSAR")
AnnotationAssertion(rdfs:seeAlso goldbook:QT06977 goldbook:HT06962)
AnnotationAssertion(rdfs:seeAlso goldbook:QT06977 goldbook:ST06982)
AnnotationAssertion(rdfs:seeAlso goldbook:QT06977 goldbook:CT06948)
AnnotationAssertion(rdfs:seeAlso goldbook:QT06977 goldbook:PT06976)
AnnotationAssertion(mito:isMentionedBy goldbook:QT06977 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:QT06977 "current"^^xsd:string)
Declaration(Class(goldbook:QT07469))
AnnotationAssertion(rdfs:label goldbook:QT07469 "quantum mechanics/molecular mechanics")
AnnotationAssertion(dcterms:description goldbook:QT07469 "Hybrid procedure for the treatment of large molecular systems. A crucial part of the system (e.g., the chromophore and its surroundings) is treated explicitly by quantum mechanical (QM) techniques, whereas the rest of the system is approximated by a classical or molecular mechanics (MM) force field treatment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:QT07469 "QC/MM")
AnnotationAssertion(rdfs:comment goldbook:QT07469 "Sometimes called QC/MM."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:QT07469 goldbook:C01076)
AnnotationAssertion(mito:isMentionedBy goldbook:QT07469 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:QT07469 "current"^^xsd:string)
