AnnotationAssertion(mito:isMentionedBy goldbook:CT07341 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07341 "current"^^xsd:string)
Declaration(Class(goldbook:CT07342))
AnnotationAssertion(rdfs:label goldbook:CT07342 "color scale")
AnnotationAssertion(dcterms:description goldbook:CT07342 "Series of ordered numbers that represents observable gradations of a given attribute or gradations of a combination of attributes of color perception.")
AnnotationAssertion(mito:isMentionedBy goldbook:CT07342 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07342 "current"^^xsd:string)
Declaration(Class(goldbook:CT07343))
AnnotationAssertion(rdfs:label goldbook:CT07343 "complete active space self-consistent field")
AnnotationAssertion(dcterms:description goldbook:CT07343 "Computational scheme employed in multiconfigurational SCF theory especially suitable for studies of reactivity of excited states. The wavefunction is defined by selecting the set of active orbitals involved in the excitation or chemical reaction under investigation and is constructed as a linear expansion in the set of configuration functions that can be generated by occupying the active orbitals in all ways consistent with an overall spin and space symmetry (full configuration interaction, CI).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:CT07343 "CASSCF")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07343 goldbook:C01256)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07343 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07343 goldbook:MT07075)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07343 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07343 "current"^^xsd:string)
Declaration(Class(goldbook:CT07344))
AnnotationAssertion(rdfs:label goldbook:CT07344 "complete active space self-consistent field second-order perturbation theory")
AnnotationAssertion(dcterms:description goldbook:CT07344 "Theoretical scheme suitable for computations of accurate excitation energies and reaction barriers. In the first step, electron correlation is taken into account only to a certain extent by using a CASSCF formalism (the so called non-dynamic correlation), whereas the remaining electron correlation (the so called dynamic correlation) is included through the use of second-order perturbation theory.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:CT07344 "CASPT2")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07344 goldbook:CT07343)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07344 goldbook:E01984)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07344 goldbook:PT07090)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07344 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07344 "current"^^xsd:string)
Declaration(Class(goldbook:CT07345))
AnnotationAssertion(rdfs:label goldbook:CT07345 "computational photochemistry")
AnnotationAssertion(dcterms:description goldbook:CT07345 "Aspects of research that address the study of photochemical events by means of computer simulations using specialized software tools and strategies in order to get an understanding of the process at a microscopic level. The aim is to uncover the mechanism of known photochemical processes, design new photochemical systems, and predict molecular properties that are experimentally inaccessible.")
AnnotationAssertion(mito:isMentionedBy goldbook:CT07345 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07345 "current"^^xsd:string)
Declaration(Class(goldbook:CT07346))
AnnotationAssertion(rdfs:label goldbook:CT07346 "concentration depolarization")
AnnotationAssertion(dcterms:description goldbook:CT07346 "Loss of emission anisotropy due to transfer of electronic excitation from photo-selected molecules to other molecules with different orientations.")
AnnotationAssertion(rdfs:seeAlso goldbook:CT07346 goldbook:ET07370)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07346 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07346 "current"^^xsd:string)
Declaration(Class(goldbook:CT07347))
AnnotationAssertion(rdfs:label goldbook:CT07347 "conical intersection")
AnnotationAssertion(dcterms:description goldbook:CT07347 "Point of crossing between two electronic states of the same spin multiplicity (most commonly singlets or triplets).")
AnnotationAssertion(rdfs:comment goldbook:CT07347 "In a polyatomic molecule two potential energy surfaces are allowed to cross along a (3N − 8)-dimensional subspace of the (3N − 6)-dimensional nuclear coordinate space (the intersection space) even if they have the same spatial/spin symmetry (N is the number of nuclei). Each point of the intersection space corresponds to a conical intersection. If the energy is plotted against two special internal geometrical coordinates, x1 and x2, which define the so-called branching plane, the potential energy surface would have the form of a double cone in the region surrounding the degeneracy. In the remaining (3N − 8) directions, the energies of the ground and excited state remain degenerate; movement in the branching plane lifts the degeneracy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:CT07347 "From a mechanistic point of view, conical intersections often provide the channel mediating radiationless deactivation and photochemical reaction. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:BT07335)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:C00970)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:D01556)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:IT07400)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:M04062)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:P04585)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:R05056)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:S05699)
AnnotationAssertion(rdfs:seeAlso goldbook:CT07347 goldbook:T06503)
AnnotationAssertion(mito:isMentionedBy goldbook:CT07347 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:CT07347 "current"^^xsd:string)
