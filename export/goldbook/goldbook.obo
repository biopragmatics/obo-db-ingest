consider: goldbook:G02665

[Term]
id: goldbook:A00186
name: agonist
def: "Substance which binds to cell receptors normally responding to naturally occurring substances and which produces a response of its own."
property_value: mito:isMentionedBy doi:10.1351/pac199365092003
property_value: hasStatus "current" xsd:string
