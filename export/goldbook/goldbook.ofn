Declaration(Class(goldbook:08969))
AnnotationAssertion(rdfs:label goldbook:08969 "secondary species")
AnnotationAssertion(dcterms:description goldbook:08969 "Species formed by the rearrangement or fragmentation of a primary species that is capable of initiating a polymerization.")
AnnotationAssertion(rdfs:comment goldbook:08969 "The term 'secondary species' is also used to designate a species centred on a secondary carbon atom, e.g., a propan-2-yl radical."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08969 goldbook:08965)
AnnotationAssertion(mito:isMentionedBy goldbook:08969 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08969 "current"^^xsd:string)
Declaration(Class(goldbook:08970))
AnnotationAssertion(rdfs:label goldbook:08970 "stable radical")
AnnotationAssertion(dcterms:description goldbook:08970 "Mediating agent in stable-radical-mediated radical polymerization with sufficient kinetic stability such that it is essentially unreactive towards addition to monomer under the conditions of the experiment.")
AnnotationAssertion(rdfs:comment goldbook:08970 "The stable radical mediating agent need not be thermodynamically stable"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08970 goldbook:08964)
AnnotationAssertion(rdfs:seeAlso goldbook:08970 goldbook:08941)
AnnotationAssertion(rdfs:seeAlso goldbook:08970 goldbook:08921)
AnnotationAssertion(mito:isMentionedBy goldbook:08970 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08970 "current"^^xsd:string)
Declaration(Class(goldbook:08971))
AnnotationAssertion(rdfs:label goldbook:08971 "unimer")
AnnotationAssertion(dcterms:description goldbook:08971 "Species comprising only one monomer unit.")
AnnotationAssertion(rdfs:comment goldbook:08971 "The term is commonly used to designate a dormant species in reversible-deactivation radical polymerization (RDRP) that contains only one monomer unit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08971 goldbook:08952)
AnnotationAssertion(rdfs:seeAlso goldbook:08971 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08971 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08971 "current"^^xsd:string)
Declaration(Class(goldbook:08972))
AnnotationAssertion(rdfs:label goldbook:08972 "substitution chain transfer")
AnnotationAssertion(dcterms:description goldbook:08972 "Chain-transfer process that proceeds by a one-step substitution reaction.")
AnnotationAssertion(rdfs:comment goldbook:08972 "In radical polymerization the process is called homolytic substitution chain transfer and reaction is by a \\(\\rm{S}_{\\rm{H}}2\\) mechanism. An example of a chain-transfer agent that reacts by substitution chain transfer is a thiol."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08972 goldbook:08947)
AnnotationAssertion(mito:isMentionedBy goldbook:08972 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08972 "current"^^xsd:string)
Declaration(Class(goldbook:08973))
AnnotationAssertion(rdfs:label goldbook:08973 "controlled ionic polymerization")
AnnotationAssertion(dcterms:description goldbook:08973 "Term indicating control of a certain kinetic feature of an ionic polymerization or structural aspect of the polymer molecules formed by ionic polymerization, or both.")
AnnotationAssertion(rdfs:comment goldbook:08973 "Generally, the adjective 'controlled' should not be used without specifying the particular kinetic or structural feature that is subject to control."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08973 "The term controlled ionic polymerization is sometimes used to indicate that the initiation is complete within a period that is short with respect to that for propagation such that dispersities are very low and the molar mass can be precisely predicted based on the initial reagent concentrations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08973 goldbook:08908)
AnnotationAssertion(mito:isMentionedBy goldbook:08973 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08973 "current"^^xsd:string)
Declaration(Class(goldbook:08974))
AnnotationAssertion(rdfs:label goldbook:08974 "ionic ring-opening polymerization")
AnnotationAssertion(dcterms:description goldbook:08974 "Ionic polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer.")
AnnotationAssertion(mito:isMentionedBy goldbook:08974 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08974 "current"^^xsd:string)
Declaration(Class(goldbook:08975))
AnnotationAssertion(rdfs:label goldbook:08975 "living ionic polymerization")
AnnotationAssertion(dcterms:description goldbook:08975 "Ionic polymerization in which chain termination and irreversible chain transfer are absent.")
AnnotationAssertion(rdfs:comment goldbook:08975 "Ionic polymerizations, controlled ionic polymerizations and reversible-deactivation ionic polymerizations should not be described as living if there is a non-zero probability of chain termination or irreversible chain transfer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08975 goldbook:08946)
AnnotationAssertion(rdfs:seeAlso goldbook:08975 goldbook:08976)
AnnotationAssertion(mito:isMentionedBy goldbook:08975 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08975 "current"^^xsd:string)
Declaration(Class(goldbook:08976))
AnnotationAssertion(rdfs:label goldbook:08976 "reversible-deactivation ionic polymerization")
AnnotationAssertion(dcterms:description goldbook:08976 "Reversible-deactivation polymerization in which the kinetic-chain carriers are ions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08976 "RDIP")
AnnotationAssertion(rdfs:seeAlso goldbook:08976 goldbook:08912)
AnnotationAssertion(mito:isMentionedBy goldbook:08976 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08976 "current"^^xsd:string)
Declaration(Class(goldbook:08977))
AnnotationAssertion(rdfs:label goldbook:08977 "anionic group-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:08977 "Anionic polymerization in which a specific atom or group is intramolecularly transferred to remain associated with the active chain-end during the course of polymerization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08977 "group-transfer polymerization (GTP)")
AnnotationAssertion(mito:isMentionedBy goldbook:08977 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08977 "current"^^xsd:string)
Declaration(Class(goldbook:08978))
AnnotationAssertion(rdfs:label goldbook:08978 "anionic ring-opening polymerization")
AnnotationAssertion(dcterms:description goldbook:08978 "Anionic polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer.")
AnnotationAssertion(mito:isMentionedBy goldbook:08978 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08978 "current"^^xsd:string)
Declaration(Class(goldbook:08979))
AnnotationAssertion(rdfs:label goldbook:08979 "controlled anionic polymerization")
AnnotationAssertion(dcterms:description goldbook:08979 "Term indicating control of a certain kinetic feature of an anionic polymerization or structural aspect of the polymer molecules formed by anionic polymerization, or both.")
AnnotationAssertion(rdfs:comment goldbook:08979 "Generally, the adjective 'controlled' should not be used without specifying the particular kinetic or structural feature that is subject to control."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08979 "The term 'controlled anionic polymerization' is sometimes used to indicate that the initiation is complete within in a period that is short with respect to the time for propagation such that dispersities are very low and the molar mass can be precisely predicted based on the initial reagent concentrations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08979 goldbook:08908)
AnnotationAssertion(mito:isMentionedBy goldbook:08979 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08979 "current"^^xsd:string)
Declaration(Class(goldbook:08980))
AnnotationAssertion(rdfs:label goldbook:08980 "living anionic polymerization")
AnnotationAssertion(dcterms:description goldbook:08980 "Anionic polymerization in which chain termination and irreversible chain transfer are absent.")
AnnotationAssertion(rdfs:comment goldbook:08980 "Anionic polymerizations, controlled anionic polymerizations and reversible-deactivation anionic polymerizations should not be described as living if there is a non-zero probability of chain termination or irreversible chain transfer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08980 goldbook:08946)
AnnotationAssertion(rdfs:seeAlso goldbook:08980 goldbook:08979)
