AnnotationAssertion(rdfs:comment goldbook:TT07168 "Curing can be induced by the action of heat or suitable radiation, or both."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:TT07168 "A cured thermosetting polymer is called a thermoset."^^xsd:string)
