AnnotationAssertion(rdfs:label goldbook:11723 "dopamine")
AnnotationAssertion(dcterms:description goldbook:11723 "Naturally occurring substance functioning as a neurotransmitter in the sympathetic nervous system, and a metabolic precursor of other substances including adrenalin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11723 "4-(2-aminoethyl)benzene-1,2-diol")
AnnotationAssertion(rdfs:comment goldbook:11723 "It has an inhibitory effect on movement and its depletion in the brain produces the symptoms of rigidity, tremors, and bradykinesia that are characteristic of Parkinson disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11723 goldbook:11998)
AnnotationAssertion(rdfs:seeAlso goldbook:11723 goldbook:11567)
AnnotationAssertion(rdfs:seeAlso goldbook:11723 goldbook:11646)
