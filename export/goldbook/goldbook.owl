        <oboInOwl:hasRelatedSynonym>labioscrotal swelling</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>urogenital ridge</oboInOwl:hasRelatedSynonym>
        <rdfs:label>genital fold</rdfs:label>
