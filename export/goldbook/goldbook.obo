property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13092
name: diabetes mellitus type 1
def: "Disease in which the \\\(\\ce\{\\upbeta\\ cells\}\\\) of the pancreatic islets of Langerhans are destroyed with the result that no insulin is produced."
comment: "The disease is believed to result from an autoimmune attack on the \(\ce{\upbeta\ cells}\). It is also known as insulin-dependent diabetes mellitus (IDDM), as the symptoms can be ameliorated by injections of insulin."
synonym: "diabetes mellitus" []
synonym: "insulin-dependent" []
synonym: "insulin-dependent diabetes mellitus (IDDM)" []
synonym: "type 1 diabetes mellitus" []
