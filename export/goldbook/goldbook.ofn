Declaration(Class(goldbook:ST07636))
AnnotationAssertion(rdfs:label goldbook:ST07636 "supercritical drying of a gel")
AnnotationAssertion(dcterms:description goldbook:ST07636 "Drying of a gel using a supercritical fluid.")
AnnotationAssertion(rdfs:comment goldbook:ST07636 "Since liquid and vapour are indistinguishable in a supercritical fluid, there is no capillary pressure to cause shrinkage and cracking of the pores formed in the gel."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:ST07636 goldbook:C01387)
