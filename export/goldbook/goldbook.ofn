AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07293 "current"^^xsd:string)
Declaration(Class(goldbook:HT07390))
AnnotationAssertion(rdfs:label goldbook:HT07390 "half-life")
AnnotationAssertion(dcterms:description goldbook:HT07390 "Time necessary for thermal bleaching to half of the absorbance of the coloured form of a photochromic compound at a specific wavelength during one cycle.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07390 goldbook:A00028)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07390 goldbook:P04589)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07390 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07390 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07390 "current"^^xsd:string)
Declaration(Class(goldbook:HT07391))
AnnotationAssertion(rdfs:label goldbook:HT07391 "half-life")
AnnotationAssertion(dcterms:description goldbook:HT07391 "Time needed for a concentration of the entity to decrease to \\(1/2\\) of its original value.")
AnnotationAssertion(mito:isMentionedBy goldbook:HT07391 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07391 "current"^^xsd:string)
Declaration(Class(goldbook:HT07392))
AnnotationAssertion(rdfs:label goldbook:HT07392 "heliochromism")
AnnotationAssertion(dcterms:description goldbook:HT07392 "Applied to photochromic compounds possessing a high efficiency for colouring with near-ultraviolet radiation and a low efficiency for bleaching with visible radiation, but a moderate efficiency for thermal fading at ambient temperature. These compounds are activated by unfiltered sunlight and deactivated under diffuse daylight conditions, therefore being suitable for sun-lens applications.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT07392 goldbook:B00681)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07392 goldbook:P04589)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07392 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07392 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07392 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07392 "current"^^xsd:string)
Declaration(Class(goldbook:HT07393))
AnnotationAssertion(rdfs:label goldbook:HT07393 "hula-twist mechanism")
AnnotationAssertion(dcterms:description goldbook:HT07393 "Volume-conserving mechanism of photoisomerization of a double bond in a conjugated system involving simultaneous configurational and conformational isomerization, e.g., the photoinitiated concerted rotation of two adjacent double and single bonds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:HT07393 "HT mechanism")
AnnotationAssertion(rdfs:comment goldbook:HT07393 "Under unconstrained conditions, the conventional one-bond-flip (OBF) process is the dominant process with the hula-twist (HT) being an undetectable higher energy process. It has been proposed that under confined conditions (e.g., a conjugated double bond chromophore in a protein cavity or in a solid matrix), the additional viscosity-dependent barriers make the OBF a less favourable process, allowing the volume-conserving HT to be the dominant process for photoisomerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07393 goldbook:C01076)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07393 goldbook:I03295)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07393 goldbook:OT07432)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07393 goldbook:P04622)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07393 goldbook:V06627)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07393 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07393 "current"^^xsd:string)
Declaration(Class(goldbook:HT07394))
AnnotationAssertion(rdfs:label goldbook:HT07394 "hyperfine")
AnnotationAssertion(dcterms:description goldbook:HT07394 "Interaction between the electron spin S and the nuclear spin I.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:HT07394 "hyperfine interaction")
AnnotationAssertion(mito:isMentionedBy goldbook:HT07394 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07394 "current"^^xsd:string)
Declaration(Class(goldbook:HT07519))
AnnotationAssertion(rdfs:label goldbook:HT07519 "hydrogel")
AnnotationAssertion(dcterms:description goldbook:HT07519 "Gel in which the swelling agent is water.")
AnnotationAssertion(rdfs:comment goldbook:HT07519 "The network component of a hydrogel is usually a polymer network."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:HT07519 "A hydrogel in which the network component is a colloidal network may be referred to as an aquagel."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07519 goldbook:G02600)
