Declaration(Class(goldbook:P04959))
AnnotationAssertion(rdfs:label goldbook:P04959 "pyro")
AnnotationAssertion(dcterms:description goldbook:P04959 "A prefix designating compounds formed by heating a compound, usually with the elimination of water, carbon dioxide, or other simple molecule, e.g. pyroglutamic acid from glutamic acid.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04959 goldbook:E02038)
AnnotationAssertion(mito:isMentionedBy goldbook:P04959 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04959 "current"^^xsd:string)
Declaration(Class(goldbook:P04961))
AnnotationAssertion(rdfs:label goldbook:P04961 "pyrolysis")
AnnotationAssertion(dcterms:description goldbook:P04961 "Thermolysis, usually associated with exposure to a high temperature.")
AnnotationAssertion(rdfs:comment goldbook:P04961 "The term generally refers to reaction in an inert environment."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04961 "Pyrolysis is the commonly used term for a high-temperature treatment that converts a ceramic precursor to a ceramic."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04961 "Modified from previous definition. The definition proposed here is more explicit about the elevated temperatures involved."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04961 goldbook:T06326)
AnnotationAssertion(rdfs:seeAlso goldbook:P04961 goldbook:CT07540)
AnnotationAssertion(rdfs:seeAlso goldbook:P04961 goldbook:CT07541)
AnnotationAssertion(rdfs:seeAlso goldbook:P04961 goldbook:I03026)
AnnotationAssertion(mito:isMentionedBy goldbook:P04961 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04961 "current"^^xsd:string)
Declaration(Class(goldbook:P04962))
AnnotationAssertion(rdfs:label goldbook:P04962 "pyrolysis-gas chromatography")
AnnotationAssertion(dcterms:description goldbook:P04962 "A version of reaction chromatography in which a sample is thermally decomposed to simpler fragments before entering the column.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04962 goldbook:R05167)
AnnotationAssertion(mito:isMentionedBy goldbook:P04962 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04962 "current"^^xsd:string)
Declaration(Class(goldbook:P04963))
AnnotationAssertion(rdfs:label goldbook:P04963 "pyrolytic carbon")
AnnotationAssertion(dcterms:description goldbook:P04963 "A carbon material deposited from gaseous hydrocarbon compounds on suitable underlying substrates (carbon materials, metals, ceramics) at temperatures ranging from \\(1000\\) to \\(2500\\ \\rm{K}\\) (chemical vapour deposition).")
AnnotationAssertion(rdfs:comment goldbook:P04963 "A wide range of microstructures, e.g. isotropic, lamellar, substrate-nucleated and a varied content of remaining hydrogen, can occur in pyrolytic carbons, depending on the deposition conditions (temperature, type, concentration and flow rate of the source gas, surface area of the underlying substrate, etc.). 'Pyrocarbon' which is synonymous with pyrolytic carbon was introduced as a trademark and should not be used as a term. The term pyrolytic carbon does not describe the large range of carbon materials obtained by thermal degradation (thermolysis, pyrolysis) of organic compounds when they are not formed by chemical vapour deposition (CVD). Also, carbon materials, obtained by physical vapour deposition (PVD) are not covered by the term pyrolytic carbon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04963 goldbook:C00841)
AnnotationAssertion(rdfs:seeAlso goldbook:P04963 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:P04963 goldbook:P04961)
AnnotationAssertion(rdfs:seeAlso goldbook:P04963 goldbook:T06326)
AnnotationAssertion(mito:isMentionedBy goldbook:P04963 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04963 "current"^^xsd:string)
Declaration(Class(goldbook:P04964))
AnnotationAssertion(rdfs:label goldbook:P04964 "pyrolytic graphite")
AnnotationAssertion(dcterms:description goldbook:P04964 "A graphite material with a high degree of preferred crystallographic orientation of the c-axes perpendicular to the surface of the substrate, obtained by graphitization heat treatment of pyrolytic carbon or by chemical vapour deposition at temperatures above \\(2500\\ \\rm{K}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:P04964 "HOPG")
AnnotationAssertion(rdfs:comment goldbook:P04964 "'Pyrographite', a synonym for pyrolytic graphite, was introduced as a trademark and should not be used as a term. Hot working of pyrolytic graphite (by heat treatment under compressive stress at temperatures above \\(3000\\ \\rm{K}\\)) results in highly oriented pyrolytic graphite (HOPG)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04964 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:P04964 goldbook:G02687)
AnnotationAssertion(rdfs:seeAlso goldbook:P04964 goldbook:G02692)
AnnotationAssertion(rdfs:seeAlso goldbook:P04964 goldbook:H02823)
AnnotationAssertion(rdfs:seeAlso goldbook:P04964 goldbook:P04963)
AnnotationAssertion(mito:isMentionedBy goldbook:P04964 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04964 "current"^^xsd:string)
Declaration(Class(goldbook:P04965))
AnnotationAssertion(rdfs:label goldbook:P04965 "pyrromethenes")
AnnotationAssertion(dcterms:description goldbook:P04965 "A less preferred term for dipyrrins. (The term 'pyrromethane' has been used for the system with a $\\ce{–CH2\\bond{–}}$ linkage).")
AnnotationAssertion(rdfs:seeAlso goldbook:P04965 goldbook:D01763)
AnnotationAssertion(mito:isMentionedBy goldbook:P04965 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04965 "current"^^xsd:string)
Declaration(Class(goldbook:PT06782))
AnnotationAssertion(rdfs:label goldbook:PT06782 "photosystem")
AnnotationAssertion(dcterms:description goldbook:PT06782 "A membrane-bound complex in plants and photosynthetic bacteria, responsible for light-harvesting and primary electron transfer. Comprises light-harvesting pigments such as chlorophyll; a primary electron-transfer centre, and secondary electron carriers. In green plant photosynthesis, Photosystem I transfers electrons from plastocyanin to a [2Fe-2S] ferredoxin, and contains iron-sulfur proteins. Photosystem II transfers electrons from the oxygen-evolving complex to plastoquinone, and contains an iron centre.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06782 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06782 goldbook:FT06771)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06782 goldbook:IT06780)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06782 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06782 goldbook:P04655)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06782 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06782 "current"^^xsd:string)
Declaration(Class(goldbook:PT06790))
AnnotationAssertion(rdfs:label goldbook:PT06790 "phosphorylation")
AnnotationAssertion(dcterms:description goldbook:PT06790 "A process (catalysed by enzymes) involving the transfer of a phosphate group from a donor to a suitable acceptor; in general, an ester linkage is formed, for example: $\\ce{ATP + alcohol -> ADP + phosphate ester}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06790 goldbook:E02159)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06790 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06790 "current"^^xsd:string)
Declaration(Class(goldbook:PT06791))
AnnotationAssertion(rdfs:label goldbook:PT06791 "polymerase chain reaction")
AnnotationAssertion(dcterms:description goldbook:PT06791 "A laboratory technique to rapidly amplify pre-determined regions of double-stranded DNA. Generally involves the use of a heat-stable DNA polymerase.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:PT06791 "PCR")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06791 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06791 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06791 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06791 "current"^^xsd:string)
Declaration(Class(goldbook:PT06792))
AnnotationAssertion(rdfs:label goldbook:PT06792 "polyhedral symbol")
AnnotationAssertion(dcterms:description goldbook:PT06792 "The polyhedral symbol indicates the geometrical arrangements of the coordinating atoms about the central atom. It consists of one or more capital italic letters derived from common geometric terms (tetrahedron, square plane, octahedron, etc.) which denote the idealised geometry of the ligands around the coordination centre, and an arabic numeral that is the coordination number of the central atom. The polyhedral symbol is used as an affix, enclosed in parentheses, and separated from the name by a hyphen. Examples are T-4, SP-4, TBPY-5, SPY-5, OC-6, and CU-8.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06792 goldbook:C00930)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06792 goldbook:C01329)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06792 goldbook:C01331)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06792 goldbook:L03518)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06792 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06792 "current"^^xsd:string)
Declaration(Class(goldbook:PT06835))
AnnotationAssertion(rdfs:label goldbook:PT06835 "pharmacokinetics")
AnnotationAssertion(dcterms:description goldbook:PT06835 "Process of the uptake of drugs by the body, the biotransformation they undergo, the distribution of the drugs and their metabolites in the tissues, and the elimination of the drugs and their metabolites from the body over a period of time.Study of such processes.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06835 goldbook:B00667)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06835 goldbook:E02038)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06835 goldbook:M03859)
