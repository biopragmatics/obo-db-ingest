Declaration(Class(goldbook:T06471))
AnnotationAssertion(rdfs:label goldbook:T06471 "transition structure")
AnnotationAssertion(dcterms:description goldbook:T06471 "A saddle point on a potential-energy surface. It has one negative force constant in the harmonic force constant matrix.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06471 goldbook:A00092)
AnnotationAssertion(rdfs:seeAlso goldbook:T06471 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:T06471 goldbook:C01145)
