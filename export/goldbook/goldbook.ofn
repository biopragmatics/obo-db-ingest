AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00769 "current"^^xsd:string)
Declaration(Class(goldbook:C00770))
AnnotationAssertion(rdfs:label goldbook:C00770 "cage compound")
AnnotationAssertion(dcterms:description goldbook:C00770 "A polycyclic compound having the shape of a cage. The term is also used for inclusion compounds.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00770 goldbook:C00769)
AnnotationAssertion(rdfs:seeAlso goldbook:C00770 goldbook:I02998)
AnnotationAssertion(mito:isMentionedBy goldbook:C00770 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00770 "current"^^xsd:string)
Declaration(Class(goldbook:C00771))
AnnotationAssertion(rdfs:label goldbook:C00771 "cage effect")
AnnotationAssertion(dcterms:description goldbook:C00771 "When in a condensed phase, or in a dense gas, reactant molecules come together, or species are formed in proximity to one another, and are caged in by surrounding molecules, they may undergo a set of collisions known as an encounter; the term 'cage effect' is then applied.The cage effect is also known as the Franck–Rabinowitch effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00771 goldbook:C00769)
AnnotationAssertion(rdfs:seeAlso goldbook:C00771 goldbook:E02086)
AnnotationAssertion(rdfs:seeAlso goldbook:C00771 goldbook:R05163)
AnnotationAssertion(mito:isMentionedBy goldbook:C00771 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00771 "current"^^xsd:string)
Declaration(Class(goldbook:C00773))
AnnotationAssertion(rdfs:label goldbook:C00773 "calcination")
AnnotationAssertion(dcterms:description goldbook:C00773 "Heating to high temperatures in air or oxygen.")
AnnotationAssertion(rdfs:comment goldbook:C00773 "The term is most likely to be applied to a step in the preparation of a catalyst."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00773 "In sol-gel processing the term applies to the heating of a polymer network containing metal compounds to convert it into an oxide network."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00773 "Modified from previous definition. The definition proposed here is more explicit about the elevated temperatures that are required."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C00773 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:C00773 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:C00773 goldbook:OT07569)
