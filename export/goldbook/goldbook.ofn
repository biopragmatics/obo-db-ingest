AnnotationAssertion(rdfs:label goldbook:S06065 "subchain")
AnnotationAssertion(dcterms:description goldbook:S06065 "An arbitrarily chosen contiguous sequence of constitutional units in a chain.")
AnnotationAssertion(rdfs:comment goldbook:S06065 "The term 'subchain' may be used to define designated subsets of the constitutional units in a chain."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S06065 goldbook:C00946)
