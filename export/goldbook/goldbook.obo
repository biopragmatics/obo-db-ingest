property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15954
name: organic carbon partition coefficient
def: "Measure of the tendency for organic substances to be adsorbed by soil or sediment\, expressed as\: \\\[K_\{\\rm\{oc\}\} = \\frac\{\(\\ce\{mass adsorbed substance\}\)/\(\\ce\{mass organic carbon\}\)\}\{\(\\ce\{mass concentration of absorbed substance\}\)\}\\\]"
comment: "The \(K_{\rm{oc}}\) is substance-specific and is largely independent of soil properties."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15955
name: osteo-
