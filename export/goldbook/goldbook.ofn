AnnotationAssertion(dcterms:description goldbook:10329 "Either of two passages in the ear, one leading to the tympanic membrane (external acoustic meatus), and one for passage of nerves and blood vessels (internal acoustic meatus).")
Declaration(Class(goldbook:10330))
