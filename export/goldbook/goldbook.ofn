Declaration(Class(goldbook:I02948))
AnnotationAssertion(rdfs:label goldbook:I02948 "imides")
AnnotationAssertion(dcterms:description goldbook:I02948 "Diacyl derivatives of ammonia or primary amines, especially those cyclic compounds derived from diacids, e.g.  In additive nomenclature, in which imide is analogous to oxide, the term is used to name compounds of the type $\\ce{R3Y^{+}-N^{-}R}$ ($\\ce{Y = N, P}$) and $\\ce{R2Z^{+}-N^{-}R}$ ($\\ce{Z = O, S, Se, Te}$), which are the products of formal attachment of an $\\ce{RN=}$ group to $\\ce{N}$, $\\ce{P}$, $\\ce{O}$, $\\ce{S}$, $\\ce{Se}$, $\\ce{Te}$. E.g. amine imides, azomethine imides.Salts having the anion $\\ce{RN^{2−}}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02948 goldbook:A00134)
AnnotationAssertion(rdfs:seeAlso goldbook:I02948 goldbook:A00271)
AnnotationAssertion(rdfs:seeAlso goldbook:I02948 goldbook:A00274)
AnnotationAssertion(rdfs:seeAlso goldbook:I02948 goldbook:A00358)
AnnotationAssertion(rdfs:seeAlso goldbook:I02948 goldbook:A00512)
AnnotationAssertion(rdfs:seeAlso goldbook:I02948 goldbook:A00562)
AnnotationAssertion(mito:isMentionedBy goldbook:I02948 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02948 "current"^^xsd:string)
Declaration(Class(goldbook:I02949))
AnnotationAssertion(rdfs:label goldbook:I02949 "imidic acids")
AnnotationAssertion(dcterms:description goldbook:I02949 "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing $\\ce{=O}$ by $\\ce{=NR}$; thus tautomers of amides. In organic chemistry an unspecified imidic acid is generally a carboximidic acid, $\\ce{RC(=NR)(OH)}$. E.g. $\\ce{RS(=NH)2(OH)}$ a sulfonodiimidic acid.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02949 goldbook:A00266)
AnnotationAssertion(rdfs:seeAlso goldbook:I02949 goldbook:I02959)
AnnotationAssertion(rdfs:seeAlso goldbook:I02949 goldbook:O04374)
AnnotationAssertion(mito:isMentionedBy goldbook:I02949 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02949 "current"^^xsd:string)
Declaration(Class(goldbook:I02950))
AnnotationAssertion(rdfs:label goldbook:I02950 "imidines")
AnnotationAssertion(dcterms:description goldbook:I02950 "Analogues of cyclic acid anhydrides in which $\\ce{=O}$ has been replaced by $\\ce{=NR}$ and $\\ce{–O\\bond{–}}$ by $\\ce{–NR\\bond{–}}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02950 goldbook:A00072)
AnnotationAssertion(rdfs:seeAlso goldbook:I02950 goldbook:D01670)
AnnotationAssertion(mito:isMentionedBy goldbook:I02950 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02950 "current"^^xsd:string)
Declaration(Class(goldbook:I02953))
AnnotationAssertion(rdfs:label goldbook:I02953 "imidoyl carbenes")
AnnotationAssertion(dcterms:description goldbook:I02953 "Carbenes having the structure $\\ce{RC(=NR)C{:}–R}$. Imidoyl is a shortened but imprecise term for carboximidoyl, $\\ce{RC(=NH)\\bond{–}}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02953 goldbook:C00806)
AnnotationAssertion(mito:isMentionedBy goldbook:I02953 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02953 "current"^^xsd:string)
Declaration(Class(goldbook:I02954))
AnnotationAssertion(rdfs:label goldbook:I02954 "imidoyl nitrenes")
AnnotationAssertion(dcterms:description goldbook:I02954 "Nitrenes having the structure .")
AnnotationAssertion(rdfs:seeAlso goldbook:I02954 goldbook:N04145)
AnnotationAssertion(rdfs:seeAlso goldbook:I02954 goldbook:I02953)
AnnotationAssertion(mito:isMentionedBy goldbook:I02954 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02954 "current"^^xsd:string)
Declaration(Class(goldbook:I02957))
AnnotationAssertion(rdfs:label goldbook:I02957 "imines")
AnnotationAssertion(dcterms:description goldbook:I02957 "Compounds having the structure $\\ce{RN=CR2}$ ($\\ce{R} = \\ce{H}$, hydrocarbyl). Thus analogues of aldehydes or ketones, having NR doubly bonded to carbon; aldimines have the structure $\\ce{RCH=NR}$, ketimines have the structure $\\ce{R'2C=NR}$ ($\\ce{R'}  eq \\ce{H}$). Imines include azomethines and Schiff bases. Imine is used as a suffix in systematic nomenclature to denote the $\\ce{C=NH}$ group excluding the carbon atom.An obsolete term for azacycloalkanes.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02957 goldbook:S05498)
AnnotationAssertion(rdfs:seeAlso goldbook:I02957 goldbook:A00208)
AnnotationAssertion(rdfs:seeAlso goldbook:I02957 goldbook:A00209)
AnnotationAssertion(rdfs:seeAlso goldbook:I02957 goldbook:A00564)
AnnotationAssertion(rdfs:seeAlso goldbook:I02957 goldbook:H02891)
AnnotationAssertion(rdfs:seeAlso goldbook:I02957 goldbook:K03381)
AnnotationAssertion(rdfs:seeAlso goldbook:I02957 goldbook:K03386)
AnnotationAssertion(mito:isMentionedBy goldbook:I02957 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02957 "current"^^xsd:string)
Declaration(Class(goldbook:I02958))
AnnotationAssertion(rdfs:label goldbook:I02958 "iminium compounds")
AnnotationAssertion(dcterms:description goldbook:I02958 "Salts in which the cation has the structure $\\ce{R2C=N^{+}R2}$. Thus N-hydronated imines and their N-substituted derivatives. The synonymous terms imonium compounds and immonium compounds are irregularly formed and should not be used.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02958 goldbook:C00907)
AnnotationAssertion(rdfs:seeAlso goldbook:I02958 goldbook:I02957)
AnnotationAssertion(rdfs:seeAlso goldbook:I02958 goldbook:Q05003)
AnnotationAssertion(mito:isMentionedBy goldbook:I02958 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02958 "current"^^xsd:string)
Declaration(Class(goldbook:I02959))
AnnotationAssertion(rdfs:label goldbook:I02959 "imino acids")
AnnotationAssertion(dcterms:description goldbook:I02959 "An obsolete term, which should not be used, for imidic acids.Any carboxylic acids having an imino substituent, $\\ce{HN=}$, replacing two hydrogens. A shortened form of imino carboxylic acid.Obsolescent term for azaalkanoic acids and azacycloalkane-2-carboxylic acids, e.g. proline:")
AnnotationAssertion(rdfs:seeAlso goldbook:I02959 goldbook:C00852)
AnnotationAssertion(rdfs:seeAlso goldbook:I02959 goldbook:I02949)
AnnotationAssertion(mito:isMentionedBy goldbook:I02959 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02959 "current"^^xsd:string)
Declaration(Class(goldbook:I02960))
AnnotationAssertion(rdfs:label goldbook:I02960 "imino carbenes")
AnnotationAssertion(dcterms:description goldbook:I02960 "This term systematically means carbenes bearing an imino or N-substituted imino group, $\\ce{RN=}$, somewhere in the molecule. E.g. $\\ce{R–C:–CH2C(=NR)R}$. It is listed here in order to warn against its misuse for alkylideneamino carbenes.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02960 goldbook:C00806)
AnnotationAssertion(rdfs:seeAlso goldbook:I02960 goldbook:N04153)
AnnotationAssertion(mito:isMentionedBy goldbook:I02960 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02960 "current"^^xsd:string)
Declaration(Class(goldbook:I02962))
AnnotationAssertion(rdfs:label goldbook:I02962 "iminoxyl radicals")
AnnotationAssertion(dcterms:description goldbook:I02962 "Synonymous with alkylideneaminoxyl radicals. The term can be regarded as a contraction of iminyloxyl radicals.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02962 goldbook:A00230)
AnnotationAssertion(mito:isMentionedBy goldbook:I02962 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02962 "current"^^xsd:string)
Declaration(Class(goldbook:I02964))
AnnotationAssertion(rdfs:label goldbook:I02964 "iminylium ions")
AnnotationAssertion(dcterms:description goldbook:I02964 "Cations having the structure $\\ce{R2C=N^{+}}$. A contraction of alkaniminylium ions. Alkylideneaminylium ions is a synonymous term. A subclass of nitrenium ions.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02964 goldbook:N04146)
AnnotationAssertion(mito:isMentionedBy goldbook:I02964 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02964 "current"^^xsd:string)
Declaration(Class(goldbook:I02965))
AnnotationAssertion(rdfs:label goldbook:I02965 "iminyl radicals")
AnnotationAssertion(dcterms:description goldbook:I02965 "Radicals having the structure $\\ce{R2C=N^{.}}$. A contraction of alkaniminyl radicals, e.g. $\\ce{CH3–CH=N^{.}}$, ethaniminyl. A synonymous term is alkylideneaminyl radicals.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02965 goldbook:R05066)
AnnotationAssertion(rdfs:seeAlso goldbook:I02965 goldbook:A00231)
AnnotationAssertion(rdfs:seeAlso goldbook:I02965 goldbook:A00289)
AnnotationAssertion(mito:isMentionedBy goldbook:I02965 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02965 "current"^^xsd:string)
Declaration(Class(goldbook:I02966))
AnnotationAssertion(rdfs:label goldbook:I02966 "immersional wetting")
AnnotationAssertion(dcterms:description goldbook:I02966 "A process in which a solid or liquid, $\\ce{\\upbeta\\!}$, is covered with a liquid, $\\ce{\\upalpha\\!}$, both of which were initially in contact with a gas or liquid, $\\ce{\\updelta\\!}$, without changing the area of the $\\ce{\\upalpha\\!\\updelta\\!\\mbox{-}}$interface.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02966 goldbook:I03082)
AnnotationAssertion(mito:isMentionedBy goldbook:I02966 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02966 "current"^^xsd:string)
Declaration(Class(goldbook:I02967))
AnnotationAssertion(rdfs:label goldbook:I02967 "immission")
AnnotationAssertion(dcterms:description goldbook:I02967 "A Germanic term, pronounced in English, 'eye-mission'; the transfer of pollutants from the atmosphere to a 'receptor'; for example, pollutants retained by the lungs. It does not have the same meaning as ground level concentration, but is the opposite in meaning to emission. This term has not been used commonly in the English language.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02967 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:I02967 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02967 "current"^^xsd:string)
Declaration(Class(goldbook:I02968))
AnnotationAssertion(rdfs:label goldbook:I02968 "immission dose")
AnnotationAssertion(dcterms:description goldbook:I02968 "The integral of the immission flow into the receptor over the exposure period.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02968 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:I02968 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02968 "current"^^xsd:string)
Declaration(Class(goldbook:I02969))
AnnotationAssertion(rdfs:label goldbook:I02969 "immission flux")
AnnotationAssertion(dcterms:description goldbook:I02969 "The immission rate divided by the unit surface area of the receptor.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02969 goldbook:I02970)
AnnotationAssertion(rdfs:seeAlso goldbook:I02969 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:I02969 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02969 "current"^^xsd:string)
Declaration(Class(goldbook:I02970))
AnnotationAssertion(rdfs:label goldbook:I02970 "immission rate")
AnnotationAssertion(dcterms:description goldbook:I02970 "The mass (or other physical quantity) of pollutant transferring per unit time into a receptor.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02970 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:I02970 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02970 "current"^^xsd:string)
Declaration(Class(goldbook:I02971))
AnnotationAssertion(rdfs:label goldbook:I02971 "immobile adsorption")
AnnotationAssertion(dcterms:description goldbook:I02971 "A situation in which the freedom of molecules of adsorbate to move about the surface is limited. Adsorption is immobile when \\(k\\ T\\) is small compared to \\(\\Delta E\\), the energy barrier separating adjacent sites. The adsorbate has little chance of migrating to neighbouring sites and such adsorption is necessarily localized.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02971 goldbook:A00155)
AnnotationAssertion(rdfs:seeAlso goldbook:I02971 goldbook:A00152)
AnnotationAssertion(mito:isMentionedBy goldbook:I02971 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I02971 "current"^^xsd:string)
Declaration(Class(goldbook:I02972))
AnnotationAssertion(rdfs:label goldbook:I02972 "immobilized phase")
AnnotationAssertion(dcterms:description goldbook:I02972 "A stationary phase in which is immobilized on the support particles, or on the inner wall of the column tubing e.g. by in situ polymerization (cross-linking) after coating.")
AnnotationAssertion(rdfs:seeAlso goldbook:I02972 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:I02972 doi:10.1351/pac199365040819)
