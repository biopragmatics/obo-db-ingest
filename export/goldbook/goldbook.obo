[Term]
id: goldbook:14937
name: population ecology
def: "Study of the variations in time and space in the sizes and densities of populations\, and of the factors causing these variations."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-08-07-09
property_value: hasStatus "current" xsd:string
