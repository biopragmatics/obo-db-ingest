AnnotationAssertion(rdfs:seeAlso goldbook:S05603 goldbook:R05046)
AnnotationAssertion(mito:isMentionedBy goldbook:S05603 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05603 "current"^^xsd:string)
Declaration(Class(goldbook:S05604))
AnnotationAssertion(rdfs:label goldbook:S05604 "sensitive volume")
AnnotationAssertion(dcterms:description goldbook:S05604 "That volume of the detector where an incident radiant power produces a measurable output.")
