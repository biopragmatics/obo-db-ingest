    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10763">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of three distinct layers of cells (endoderm, ectoderm, and mesoderm) that become recognizable as the embryo develops.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
