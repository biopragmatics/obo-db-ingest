[Term]
id: goldbook:08633
name: local mode
def: "Mode of vibration localized in one type of bond."
comment: "For highly excited \(\ce{CH}\) stretching vibrations anharmonic interactions mix the normal modes of vibration to the point that each observed mode of vibration behaves as a local mode."
synonym: "local mode" []
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
