Declaration(Class(goldbook:09714))
AnnotationAssertion(rdfs:label goldbook:09714 "peptide nucleic acid")
AnnotationAssertion(dcterms:description goldbook:09714 "Synthetic deoxyribonucleic acid (DNA) mimic, which contains 2-aminoethylglycine linkages instead of the negatively charged phosphodiesteric backbone of oligonucleotides.")
Declaration(Class(goldbook:09715))
