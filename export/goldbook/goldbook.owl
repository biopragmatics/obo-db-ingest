    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11250">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of the central nervous system outside the brain and inside the vertebral column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spinal cord</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10501"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11251 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11251">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the corkscrew-like arterioles in premenstrual or progestational endometrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
