Declaration(Class(goldbook:B00675))
AnnotationAssertion(rdfs:label goldbook:B00675 "bismuthines")
AnnotationAssertion(dcterms:description goldbook:B00675 "$\\ce{BiH3}$ and compounds derived from it by substituting one, two or three hydrogen atoms by hydrocarbyl groups: $\\ce{R3Bi}$, $\\ce{RBiH2}$, $\\ce{R2BiH}$ ($\\ce{R}  eq \\ce{RH}$) are called primary, secondary and tertiary bismuthines, respectively. A specific bismuthine is preferably named as a substituted bismuthane, e.g. $\\ce{(CH3)3Bi}$ trimethylbismuthane.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00675 goldbook:B00674)
AnnotationAssertion(mito:isMentionedBy goldbook:B00675 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00675 "current"^^xsd:string)
