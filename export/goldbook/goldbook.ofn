AnnotationAssertion(rdfs:seeAlso goldbook:C01199 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:C01199 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01199 "current"^^xsd:string)
Declaration(Class(goldbook:C01200))
AnnotationAssertion(rdfs:label goldbook:C01200 "competitive inhibition")
AnnotationAssertion(dcterms:description goldbook:C01200 "The reduction in rate due to reduction or loss of activity of a catalyst caused by adsorption of poison which is not greatly preferred to adsorption of reactant.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01200 goldbook:A00155)
AnnotationAssertion(rdfs:seeAlso goldbook:C01200 goldbook:C00876)
AnnotationAssertion(mito:isMentionedBy goldbook:C01200 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01200 "current"^^xsd:string)
Declaration(Class(goldbook:C01202))
AnnotationAssertion(rdfs:label goldbook:C01202 "complementary DNA")
AnnotationAssertion(dcterms:description goldbook:C01202 "A single-stranded DNA molecule with a nucleotide sequence that is complementary to an RNA molecule; cDNA is formed by the action of the enzyme reverse transcriptase on an RNA template. After conversion to the double-stranded form, cDNA is used for molecular cloning or for hybridization studies.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:C01202 "cDNA")
AnnotationAssertion(rdfs:seeAlso goldbook:C01202 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:C01202 goldbook:R05386)
AnnotationAssertion(rdfs:seeAlso goldbook:C01202 goldbook:E02159)
