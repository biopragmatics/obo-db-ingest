AnnotationAssertion(rdfs:seeAlso goldbook:13616 goldbook:13137)
AnnotationAssertion(rdfs:seeAlso goldbook:13616 goldbook:13292)
AnnotationAssertion(mito:isMentionedBy goldbook:13616 doi:10.1351/PAC-REC-11-06-03)
