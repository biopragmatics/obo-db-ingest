AnnotationAssertion(rdfs:label goldbook:IT07396 "IC")
AnnotationAssertion(dcterms:description goldbook:IT07396 "Frequently used acronym for internal conversion.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07396 goldbook:I03102)
