Declaration(Class(goldbook:G02608))
AnnotationAssertion(rdfs:label goldbook:G02608 "general acid–base catalysis")
AnnotationAssertion(dcterms:description goldbook:G02608 "Catalysis by acids or bases in solution is said to be general when it is possible to detect catalysis brought about by species other than the ions formed from the solvent itself (e.g. when water is the solvent, by species other than $\\ce{H^{+}}$ and $\\ce{OH^{−}}$ ions).")
AnnotationAssertion(rdfs:seeAlso goldbook:G02608 goldbook:C00874)
AnnotationAssertion(rdfs:seeAlso goldbook:G02608 goldbook:G02609)
AnnotationAssertion(rdfs:seeAlso goldbook:G02608 goldbook:G02610)
AnnotationAssertion(mito:isMentionedBy goldbook:G02608 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02608 "current"^^xsd:string)
Declaration(Class(goldbook:G02609))
AnnotationAssertion(rdfs:label goldbook:G02609 "general acid catalysis")
AnnotationAssertion(dcterms:description goldbook:G02609 "The catalysis of a chemical reaction by a series of Brønsted acids (which may include the solvated hydrogen ion) so that the rate of the catalysed part of the reaction is given by \\(\\sum k_{\\rm{HA}}\\ [HA]\\) multiplied by some function of substrate concentrations. (The acids $\\ce{HA}$ are unchanged by the overall reaction.) General catalysis by acids can be experimentally distinguished from specific catalysis by hydrogen cations (hydrons) by observation of the rate of reaction as a function of buffer concentration.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02609 goldbook:B00744)
AnnotationAssertion(rdfs:seeAlso goldbook:G02609 goldbook:C00874)
AnnotationAssertion(rdfs:seeAlso goldbook:G02609 goldbook:C00885)
AnnotationAssertion(rdfs:seeAlso goldbook:G02609 goldbook:H02904)
