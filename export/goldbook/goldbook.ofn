Declaration(Class(goldbook:U06546))
AnnotationAssertion(rdfs:label goldbook:U06546 "ultimate capacity")
AnnotationAssertion(dcterms:description goldbook:U06546 "The theoretical maximum capacity of a solvent containing a given concentration of extractant for a solute under any conditions. Where appropriate the term stoichiometric capacity can be used.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:U06546 "stoichiometric capacity")
AnnotationAssertion(rdfs:seeAlso goldbook:U06546 goldbook:E02299)
