Ontology(<https://w3id.org/biopragmatics/resources/goldbook/goldbook.ofn>
Annotation(dcterms:title "IUPAC Gold Book Compendium of Chemical Terminology"^^xsd:string)
Annotation(dcterms:license "CC-BY-SA-4.0"^^xsd:string)
Annotation(dcterms:description "The Compendium is popularly referred to as the \"Gold Book\", in recognition of the contribution of the late Victor Gold, who initiated work on the first edition. It is one of the series of IUPAC \"Colour Books\" on chemical nomenclature, terminology, symbols and units (see the list of source documents), and collects together terminology definitions from IUPAC recommendations already published in Pure and Applied Chemistry and in the other Colour Books.

Terminology definitions published by IUPAC are drafted by international committees of experts in the appropriate chemistry sub-disciplines, and ratified by IUPAC's Interdivisional Committee on Terminology, Nomenclature and Symbols (ICTNS). In this edition of the Compendium these IUPAC-approved definitions are supplemented with some definitions from ISO and from the International Vocabulary of Basic and General Terms in Metrology; both these sources are recognised by IUPAC as authoritative. The result is a collection of nearly 7000 terms, with authoritative definitions, spanning the whole range of chemistry.

The API can be accessed [here](https://goldbook.iupac.org/pages/api)"^^xsd:string)
Annotation(foaf:homepage "https://goldbook.iupac.org"^^xsd:anyURI)
Annotation(doap:mailing-list "goldbook@iupac.org"^^xsd:string)
Annotation(doap:maintainer orcid:0000-0002-0703-7776)
Annotation(oboInOwl:auto-generated-by "PyOBO v0.12.24-dev-a418863a on 2026-06-01T12:02:26.890050 by https://github.com/biopragmatics/pyobo/blob/main/src/pyobo/sources/goldbook.py"^^xsd:string)

Declaration(Class(goldbook:08003))
AnnotationAssertion(rdfs:label goldbook:08003 "analytical chemistry")
AnnotationAssertion(dcterms:description goldbook:08003 "Scientific discipline that develops and applies strategies, instruments, and procedures to obtain information on the composition and nature of matter in space and time.")
Declaration(Class(goldbook:08004))
AnnotationAssertion(rdfs:label goldbook:08004 "chemical analysis")
AnnotationAssertion(dcterms:description goldbook:08004 "Application of analytical chemistry.")
Declaration(Class(goldbook:08005))
AnnotationAssertion(rdfs:label goldbook:08005 "additive matrix effect")
AnnotationAssertion(dcterms:description goldbook:08005 "Matrix effect that is independent of the measured quantity value of the measurand.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08005 "background interference")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08005 "translational matrix effect")
Declaration(Class(goldbook:08006))
AnnotationAssertion(rdfs:label goldbook:08006 "analytical run")
AnnotationAssertion(dcterms:description goldbook:08006 "Set of measurements of the same quantity performed under repeatability conditions of measurement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08006 "run")
Declaration(Class(goldbook:08007))
AnnotationAssertion(rdfs:label goldbook:08007 "background indication")
AnnotationAssertion(dcterms:description goldbook:08007 "Indication obtained from a phenomenon, body, or substance similar to the one under investigation but for which a quantity of interest is supposed not to be present or is not contributing to the indication.")
Declaration(Class(goldbook:08008))
AnnotationAssertion(rdfs:label goldbook:08008 "blank correction")
AnnotationAssertion(dcterms:description goldbook:08008 "Step in a measurement procedure in which the effect of a blank indication is removed from an indication.")
Declaration(Class(goldbook:08009))
AnnotationAssertion(rdfs:label goldbook:08009 "blank indication")
AnnotationAssertion(dcterms:description goldbook:08009 "Indication obtained from a sample of blank material under the measurement conditions for the measurand.")
Declaration(Class(goldbook:08010))
AnnotationAssertion(rdfs:label goldbook:08010 "blank material")
AnnotationAssertion(dcterms:description goldbook:08010 "Material which contains no, or as little as possible, of the analyte of interest used in measurement to establish a blank indication.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08010 "blank")
Declaration(Class(goldbook:08011))
AnnotationAssertion(rdfs:label goldbook:08011 "calibration certificate")
AnnotationAssertion(dcterms:description goldbook:08011 "Document issued by a technically competent organization providing information about a calibration.")
Declaration(Class(goldbook:08012))
AnnotationAssertion(rdfs:label goldbook:08012 "calibration interval")
AnnotationAssertion(dcterms:description goldbook:08012 "Time period between calibrations over which the performance of the measuring system may be expected to meet specified requirements.")
Declaration(Class(goldbook:08013))
AnnotationAssertion(rdfs:label goldbook:08013 "certified property value")
AnnotationAssertion(dcterms:description goldbook:08013 "Property value of a reference material, accompanied by statements of associated uncertainty and traceability and identified as a certified property value in the reference material certificate.")
Declaration(Class(goldbook:08014))
AnnotationAssertion(rdfs:label goldbook:08014 "chemical purity")
AnnotationAssertion(dcterms:description goldbook:08014 "Mass (amount of substance or number of entities) of a specified component divided by the mass (amount of substance or number of entities, respectively) of the system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08014 "purity")
Declaration(Class(goldbook:08015))
AnnotationAssertion(rdfs:label goldbook:08015 "consensus property value")
AnnotationAssertion(dcterms:description goldbook:08015 "Property value derived from a collection of results.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08015 "consensus value")
Declaration(Class(goldbook:08016))
AnnotationAssertion(rdfs:label goldbook:08016 "conventional quantity value")
AnnotationAssertion(dcterms:description goldbook:08016 "Quantity value attributed by agreement to a quantity for a given purpose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08016 "conventional value")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08016 "conventional value of a quantity")
Declaration(Class(goldbook:08017))
AnnotationAssertion(rdfs:label goldbook:08017 "critical value")
AnnotationAssertion(dcterms:description goldbook:08017 "Measured quantity value for a quantity of a component in a material, above which the component is declared to be present.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08017 "critical level")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08017 "decision level")
Declaration(Class(goldbook:08018))
AnnotationAssertion(rdfs:label goldbook:08018 "determination")
AnnotationAssertion(dcterms:description goldbook:08018 "Set of operations that are carried out on an object in order to provide qualitative or quantitative information about this object.")
Declaration(Class(goldbook:08019))
AnnotationAssertion(rdfs:label goldbook:08019 "interferent")
AnnotationAssertion(dcterms:description goldbook:08019 "Component of the matrix that embodies an influence quantity.")
Declaration(Class(goldbook:08020))
AnnotationAssertion(rdfs:label goldbook:08020 "intermediate measurement precision")
AnnotationAssertion(dcterms:description goldbook:08020 "Measurement precision under intermediate precision conditions of measurement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08020 "intermediate precision")
Declaration(Class(goldbook:08021))
AnnotationAssertion(rdfs:label goldbook:08021 "laboratory bias")
AnnotationAssertion(dcterms:description goldbook:08021 "Contribution to measurement bias that is attributed to systematic effects on measurement results made in a laboratory.")
Declaration(Class(goldbook:08022))
AnnotationAssertion(rdfs:label goldbook:08022 "limit of quantification")
AnnotationAssertion(dcterms:description goldbook:08022 "Smallest or largest measured quantity value, obtained by a given measurement procedure, which fulfils a requirement of fitness for purpose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08022 "quantification limit")
Declaration(Class(goldbook:08023))
AnnotationAssertion(rdfs:label goldbook:08023 "linearity of a measuring system")
AnnotationAssertion(dcterms:description goldbook:08023 "Ability of a measuring system to provide measured quantity values that are directly proportional to the quantity value of the measurand.")
Declaration(Class(goldbook:08024))
AnnotationAssertion(rdfs:label goldbook:08024 "linearity of calibration")
AnnotationAssertion(dcterms:description goldbook:08024 "Closeness of agreement between indications obtained using calibrators in the first step of a calibration and indications predicted by the calibration function for the calibrators’ reference quantity values.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08024 "calibration linearity")
Declaration(Class(goldbook:08025))
AnnotationAssertion(rdfs:label goldbook:08025 "material homogeneity")
AnnotationAssertion(dcterms:description goldbook:08025 "Uniform structure or composition of a material with respect to one or more specified properties.")
Declaration(Class(goldbook:08026))
AnnotationAssertion(rdfs:label goldbook:08026 "material recovery")
AnnotationAssertion(dcterms:description goldbook:08026 "Mass (volume, amount of substance) of a specified component isolated from a system divided by the mass (volume, amount of substance) of the system prior to isolation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08026 "recovery")
Declaration(Class(goldbook:08027))
AnnotationAssertion(rdfs:label goldbook:08027 "material stability")
AnnotationAssertion(dcterms:description goldbook:08027 "Constancy of a property of a material over time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08027 "stability")
Declaration(Class(goldbook:08028))
AnnotationAssertion(rdfs:label goldbook:08028 "measurement procedure")
AnnotationAssertion(dcterms:description goldbook:08028 "Detailed description of a measurement according to one or more measurement principles and to a given measurement method, based on a measurement model and including any calculation to obtain a measurement result.")
Declaration(Class(goldbook:08029))
AnnotationAssertion(rdfs:label goldbook:08029 "measurement procedure bias")
AnnotationAssertion(dcterms:description goldbook:08029 "Contribution to measurement bias that is attributed to systematic effects on measurement results made according to a measurement procedure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08029 "measurement method bias")
Declaration(Class(goldbook:08030))
AnnotationAssertion(rdfs:label goldbook:08030 "measurement procedure with standard addition")
AnnotationAssertion(dcterms:description goldbook:08030 "Measurement procedure in which indications are obtained for an analytical sample as well as for analytical samples with addition(s) of a measurement standard.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08030 "standard addition")
Declaration(Class(goldbook:08031))
AnnotationAssertion(rdfs:label goldbook:08031 "measurement reproducibility")
AnnotationAssertion(dcterms:description goldbook:08031 "Measurement precision under reproducibility conditions of measurement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08031 "reproducibility")
Declaration(Class(goldbook:08032))
AnnotationAssertion(rdfs:label goldbook:08032 "metrological compatibility of measurement results")
AnnotationAssertion(dcterms:description goldbook:08032 "Property of a set of measurement results for a specified measurand, such that the absolute value of the difference of any pair of measured quantity values from two different measurement results is smaller than some chosen multiple of the standard measurement uncertainty of that difference.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08032 "metrological compatibility")
Declaration(Class(goldbook:08033))
AnnotationAssertion(rdfs:label goldbook:08033 "metrological equivalence of measurement results")
AnnotationAssertion(dcterms:description goldbook:08033 "Property of two or more measurement results for a given measurand which have metrological compatibility of measurement results, so that they are each acceptable for the same specified intended use.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08033 "equivalence of measurement results")
Declaration(Class(goldbook:08034))
AnnotationAssertion(rdfs:label goldbook:08034 "minimum sample size")
AnnotationAssertion(dcterms:description goldbook:08034 "Lower limit of sample size stipulated in documentation taken for chemical analysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08034 "minimum sample intake")
Declaration(Class(goldbook:08035))
AnnotationAssertion(rdfs:label goldbook:08035 "multiplicative matrix effect")
AnnotationAssertion(dcterms:description goldbook:08035 "Matrix effect that is proportional to the measured quantity value of the measurand.")
Declaration(Class(goldbook:08036))
AnnotationAssertion(rdfs:label goldbook:08036 "non-certified property value")
AnnotationAssertion(dcterms:description goldbook:08036 "Property value that is provided for information only but is not certified by a reference material producer.")
Declaration(Class(goldbook:08037))
AnnotationAssertion(rdfs:label goldbook:08037 "object traceability")
