AnnotationAssertion(rdfs:label goldbook:11752 "encephalopathy")
AnnotationAssertion(dcterms:description goldbook:11752 "Any disorder of the brain that affects its functioning.")
AnnotationAssertion(rdfs:comment goldbook:11752 "Common causes include trauma, infection, liver failure, anoxia, kidney failure, or exposure to a neurotoxin."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11752 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11752 goldbook:11952)
