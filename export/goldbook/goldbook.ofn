AnnotationAssertion(rdfs:label goldbook:A00127 "acyloxyl radicals")
AnnotationAssertion(dcterms:description goldbook:A00127 "Oxygen-centered radicals consisting of an acyl radical bonded to an oxygen atom. E.g. .")
AnnotationAssertion(mito:isMentionedBy goldbook:A00127 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00127 "current"^^xsd:string)
Declaration(Class(goldbook:A00129))
AnnotationAssertion(rdfs:label goldbook:A00129 "acyl species")
AnnotationAssertion(dcterms:description goldbook:A00129 "Acyl intermediates include acyl anions, acyl radicals and acyl cations (synonym acylium ions) which are formally derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by removal of a hydroxyl cation $\\ce{HO^{+}}$, a hydroxyl radical $\\ce{HO^{.}}$ or a hydroxyl anion $\\ce{HO^{-}}$, respectively, and replacement analogues of such intermediates. Acyl anions, radicals and cations can formally be represented by canonical forms having a negative charge, an unpaired electron or a positive charge on the acid-generating element of the oxoacid.Acyl anions, e.g. Acyl radicals, e.g. Acyl cations, e.g.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00129 goldbook:A00123)
AnnotationAssertion(rdfs:seeAlso goldbook:A00129 goldbook:A00358)
AnnotationAssertion(rdfs:seeAlso goldbook:A00129 goldbook:C00907)
AnnotationAssertion(rdfs:seeAlso goldbook:A00129 goldbook:I03096)
