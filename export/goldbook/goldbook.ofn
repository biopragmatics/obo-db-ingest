Declaration(Class(goldbook:09430))
AnnotationAssertion(rdfs:label goldbook:09430 "stop event")
AnnotationAssertion(dcterms:description goldbook:09430 "Registration of a particle by a time-to-digital converter in secondary ion mass spectrometry.")
Declaration(Class(goldbook:09431))
AnnotationAssertion(rdfs:label goldbook:09431 "transformation probability")
AnnotationAssertion(dcterms:description goldbook:09431 "Probability of a defined charged or neutral species being produced, by consumption of a defined parent atomic or molecular configuration at a surface, as a result of sputtering in secondary ion mass spectrometry.")
Declaration(Class(goldbook:09432))
AnnotationAssertion(rdfs:label goldbook:09432 "ultra-shallow depth profile")
AnnotationAssertion(dcterms:description goldbook:09432 "Depth profile in secondary-ion mass spectrometry where the depth over which significant changes occur is less than \\(\\pu{10 nm}\\).")
Declaration(Class(goldbook:09433))
AnnotationAssertion(rdfs:label goldbook:09433 "useful ion yield")
