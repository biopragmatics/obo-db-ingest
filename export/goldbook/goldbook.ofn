AnnotationAssertion(dcterms:description goldbook:11087 "Autosomal recessive disorder resulting from mutations that impair the function of the enzyme phenylalanine 4-monooxygenase (EC 1.14.16.1).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11087 "PKU")
AnnotationAssertion(rdfs:comment goldbook:11087 "The resulting failure of phenylalanine metabolism in the liver leads to its accumulation, causing mental retardation, seizures, and other neurological disorders in untreated individuals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11087 "The excess phenylalanine is metabolized to phenyl pyruvate (\"phenylketone\") that is detected in the urine and is used for screening newborns."^^xsd:string)
