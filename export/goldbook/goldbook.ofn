Declaration(Class(goldbook:O04348))
AnnotationAssertion(rdfs:label goldbook:O04348 "Ostwald ripening")
AnnotationAssertion(dcterms:description goldbook:O04348 "Dissolution of small crystals or sol particles and the redeposition of the dissolved species on the surfaces of larger crystals or sol particles.")
AnnotationAssertion(rdfs:comment goldbook:O04348 "The process occurs because smaller particles have a higher surface energy, hence higher total Gibbs energy, than larger particles, giving rise to an apparent higher solubility."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:O04348 "Modified from previous definition. The definition proposed here is recommended for its inclusion of sol particles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:O04348 goldbook:D01806)
AnnotationAssertion(rdfs:seeAlso goldbook:O04348 goldbook:S05727)
AnnotationAssertion(rdfs:seeAlso goldbook:O04348 goldbook:S05740)
AnnotationAssertion(mito:isMentionedBy goldbook:O04348 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04348 "current"^^xsd:string)
Declaration(Class(goldbook:O04350))
AnnotationAssertion(rdfs:label goldbook:O04350 "outer Helmholtz plane")
AnnotationAssertion(dcterms:description goldbook:O04350 "At an electrified interface, the locus of the electrical centres of non-specifically adsorbed ions in their position of closest approach.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:O04350 "OHP")
AnnotationAssertion(rdfs:seeAlso goldbook:O04350 goldbook:I03082)
