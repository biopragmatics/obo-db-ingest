AnnotationAssertion(rdfs:label goldbook:12181 "withdrawal")
AnnotationAssertion(dcterms:description goldbook:12181 "Cessation of exposure to a substance, being characterized by adverse symptoms.")
AnnotationAssertion(rdfs:comment goldbook:12181 "The symptoms may be physiological or psychological in origin."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12181 goldbook:11564)
AnnotationAssertion(mito:isMentionedBy goldbook:12181 doi:10.1515/pac-2015-0103)
