AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10654 "atrioventricular canal cushion")
Declaration(Class(goldbook:10655))
AnnotationAssertion(rdfs:label goldbook:10655 "endocardium")
AnnotationAssertion(dcterms:description goldbook:10655 "Endothelial lining of the heart chambers, also containing small blood vessels and a few bundles of smooth muscle, continuous with the endothelium of the great blood vessels.")
Declaration(Class(goldbook:10656))
AnnotationAssertion(rdfs:label goldbook:10656 "endochondral ossification")
AnnotationAssertion(dcterms:description goldbook:10656 "Formation and growth of bone tissue (especially of the long bones) during fetal development of the mammalian skeletal system, and in repair of bone fractures, that takes place in the presence of cartilage.")
Declaration(Class(goldbook:10657))
AnnotationAssertion(rdfs:label goldbook:10657 "endocrine")
AnnotationAssertion(dcterms:description goldbook:10657 "Pertaining to hormones or to glands that secrete hormones directly into the bloodstream.")
Declaration(Class(goldbook:10658))
AnnotationAssertion(rdfs:label goldbook:10658 "endocrine disrupter")
AnnotationAssertion(dcterms:description goldbook:10658 "Exogenous substance that, at some dose, alters function(s) of the endocrine system and consequently causes adverse health effects in an intact organism, its progeny, or (sub)populations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10658 "endocrine modifier")
Declaration(Class(goldbook:10659))
AnnotationAssertion(rdfs:label goldbook:10659 "endoderm")
