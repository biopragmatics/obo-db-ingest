AnnotationAssertion(dcterms:description goldbook:13821 "Repulsive interaction of fluorous and non-fluorous structures.")
AnnotationAssertion(rdfs:seeAlso goldbook:13821 goldbook:13822)
AnnotationAssertion(mito:isMentionedBy goldbook:13821 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13821 "current"^^xsd:string)
Declaration(Class(goldbook:13822))
AnnotationAssertion(rdfs:label goldbook:13822 "fluorous")
AnnotationAssertion(dcterms:description goldbook:13822 "Pertaining to the presence of a sufficient number of carbon-fluorine bonds as to cause a substance to be insoluble in water or common organic solvents but soluble in fluorocarbons.")
AnnotationAssertion(mito:isMentionedBy goldbook:13822 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13822 "current"^^xsd:string)
Declaration(Class(goldbook:13823))
AnnotationAssertion(rdfs:label goldbook:13823 "foldamer")
AnnotationAssertion(dcterms:description goldbook:13823 "Polymer or oligomer molecule that adopts a secondary structure stabilized by noncovalent interactions.")
AnnotationAssertion(rdfs:comment goldbook:13823 "A helix, \\(\\ce{\\upbeta\\mbox{-}sheet}\\), or globule are typical secondary structures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13823 goldbook:13824)
AnnotationAssertion(mito:isMentionedBy goldbook:13823 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13823 "current"^^xsd:string)
Declaration(Class(goldbook:13824))
AnnotationAssertion(rdfs:label goldbook:13824 "globule")
AnnotationAssertion(dcterms:description goldbook:13824 "Conformation of a macromolecule in which the constitutional units collectively arrange into a compact ovoid or spherical shape.")
AnnotationAssertion(mito:isMentionedBy goldbook:13824 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13824 "current"^^xsd:string)
Declaration(Class(goldbook:13825))
AnnotationAssertion(rdfs:label goldbook:13825 "globule-to-coil transition")
AnnotationAssertion(dcterms:description goldbook:13825 "Reverse of a coil-to-globule transition.")
AnnotationAssertion(rdfs:seeAlso goldbook:13825 goldbook:13802)
AnnotationAssertion(mito:isMentionedBy goldbook:13825 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13825 "current"^^xsd:string)
Declaration(Class(goldbook:13826))
AnnotationAssertion(rdfs:label goldbook:13826 "hemicarceplex")
AnnotationAssertion(dcterms:description goldbook:13826 "Complex formed by a hemicarcerand and an entrapped guest.")
AnnotationAssertion(rdfs:seeAlso goldbook:13826 goldbook:13799)
AnnotationAssertion(rdfs:seeAlso goldbook:13826 goldbook:13827)
AnnotationAssertion(mito:isMentionedBy goldbook:13826 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13826 "current"^^xsd:string)
Declaration(Class(goldbook:13827))
AnnotationAssertion(rdfs:label goldbook:13827 "hemicarcerand")
AnnotationAssertion(dcterms:description goldbook:13827 "Host molecule that allows guest molecules to enter and exit its cavities in accordance with a change in the equilibrium conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:13827 goldbook:13800)
AnnotationAssertion(mito:isMentionedBy goldbook:13827 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13827 "current"^^xsd:string)
Declaration(Class(goldbook:13828))
AnnotationAssertion(rdfs:label goldbook:13828 "hexagonal mesophase")
AnnotationAssertion(dcterms:description goldbook:13828 "Columnar mesophase characterized by a hexagonal packing of the molecular column.")
AnnotationAssertion(rdfs:seeAlso goldbook:13828 goldbook:13804)
AnnotationAssertion(mito:isMentionedBy goldbook:13828 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13828 "current"^^xsd:string)
Declaration(Class(goldbook:13829))
AnnotationAssertion(rdfs:label goldbook:13829 "honeycomb polymer film")
AnnotationAssertion(dcterms:description goldbook:13829 "Hexagonal array of holes in a polymer film.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13829 "honeycomb polymer")
AnnotationAssertion(rdfs:comment goldbook:13829 "The cross-sectional dimensions of the holes of a hexagonal array are usually less than \\(\\pu{1 mm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13829 "A method that utilizes the condensation of micrometer-size water droplets on the surface of solutions of block copolymers for the preparation of ordered micrometer-size honeycomb structures has led to the use of the extended term, honeycomb polymer from breath figures."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13829 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13829 "current"^^xsd:string)
Declaration(Class(goldbook:13830))
AnnotationAssertion(rdfs:label goldbook:13830 "hydrophilic interaction")
AnnotationAssertion(dcterms:description goldbook:13830 "Attractive interaction between hydrophilic groups, molecules, or substances.")
AnnotationAssertion(mito:isMentionedBy goldbook:13830 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13830 "current"^^xsd:string)
Declaration(Class(goldbook:13831))
AnnotationAssertion(rdfs:label goldbook:13831 "hydrophobic")
AnnotationAssertion(dcterms:description goldbook:13831 "Qualifier indicating capacity of a molecular entity or of a substituent to interact repulsively with polar molecules, in particular with water or with polar groups.")
AnnotationAssertion(rdfs:comment goldbook:13831 "Literally translated as \"water hating\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13831 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13831 "current"^^xsd:string)
Declaration(Class(goldbook:13832))
AnnotationAssertion(rdfs:label goldbook:13832 "inverse opal")
AnnotationAssertion(dcterms:description goldbook:13832 "Colloidal crystal of spherical voids with a periodic structure within a solid polymer continuum.")
AnnotationAssertion(rdfs:comment goldbook:13832 "An inverse opal is usually produced by assembling spheres, filling the interstitial spaces with solid, and removing the spheres."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13832 goldbook:13803)
AnnotationAssertion(mito:isMentionedBy goldbook:13832 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13832 "current"^^xsd:string)
Declaration(Class(goldbook:13833))
AnnotationAssertion(rdfs:label goldbook:13833 "lamella")
AnnotationAssertion(dcterms:description goldbook:13833 "Organized structure extended in two dimensions and of uniform thickness resembling a thin layer, a plate, or a membrane.")
AnnotationAssertion(mito:isMentionedBy goldbook:13833 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13833 "current"^^xsd:string)
Declaration(Class(goldbook:13834))
AnnotationAssertion(rdfs:label goldbook:13834 "lamellar block copolymer")
AnnotationAssertion(dcterms:description goldbook:13834 "Assembly of block copolymer molecules in which like blocks are segregated in lamella.")
AnnotationAssertion(rdfs:comment goldbook:13834 "Individual lamellae are usually of a thickness of \\(\\pu{5\\!-\\! 100 nm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13834 goldbook:13833)
AnnotationAssertion(mito:isMentionedBy goldbook:13834 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13834 "current"^^xsd:string)
Declaration(Class(goldbook:13835))
AnnotationAssertion(rdfs:label goldbook:13835 "layer-by-layer assembly")
AnnotationAssertion(dcterms:description goldbook:13835 "Process whereby multilayered structures of molecules or particles of a substance are assembled on a solid substrate by sequential adsorption of monolayers held together by noncovalent interactions.")
AnnotationAssertion(rdfs:comment goldbook:13835 "The material at the liquid surface need not necessarily be present as a solid monolayer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13835 "Layer-by-layer assembly is often used to alternately transfer polyelectrolytes that are positively and negatively charged."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13835 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13835 "current"^^xsd:string)
Declaration(Class(goldbook:13837))
AnnotationAssertion(rdfs:label goldbook:13837 "mechanically interlocked molecular architecture")
AnnotationAssertion(dcterms:description goldbook:13837 "Supramolecular structure in which molecules are linked only as a consequence of their topology.")
AnnotationAssertion(mito:isMentionedBy goldbook:13837 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13837 "current"^^xsd:string)
Declaration(Class(goldbook:13838))
AnnotationAssertion(rdfs:label goldbook:13838 "metallomesogen")
AnnotationAssertion(dcterms:description goldbook:13838 "Mesogen composed of molecules incorporating one or more metal atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:13838 goldbook:13798)
AnnotationAssertion(rdfs:seeAlso goldbook:13838 goldbook:13812)
AnnotationAssertion(mito:isMentionedBy goldbook:13838 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13838 "current"^^xsd:string)
Declaration(Class(goldbook:13839))
AnnotationAssertion(rdfs:label goldbook:13839 "micellar rod")
AnnotationAssertion(dcterms:description goldbook:13839 "Rod-like mesogens with the capacity to form micellar aggregates.")
AnnotationAssertion(mito:isMentionedBy goldbook:13839 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13839 "current"^^xsd:string)
Declaration(Class(goldbook:13840))
AnnotationAssertion(rdfs:label goldbook:13840 "microstructure")
AnnotationAssertion(dcterms:description goldbook:13840 "Structure of material in which at least one of the features repeats over distances of the order of micrometers.")
AnnotationAssertion(mito:isMentionedBy goldbook:13840 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13840 "current"^^xsd:string)
Declaration(Class(goldbook:13841))
AnnotationAssertion(rdfs:label goldbook:13841 "molecular imprinting")
AnnotationAssertion(dcterms:description goldbook:13841 "Technique to create templated cavities in polymer matrices with memory of the template molecules to be used in molecular recognition.")
AnnotationAssertion(mito:isMentionedBy goldbook:13841 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13841 "current"^^xsd:string)
Declaration(Class(goldbook:13842))
AnnotationAssertion(rdfs:label goldbook:13842 "nanodomain")
AnnotationAssertion(dcterms:description goldbook:13842 "Region of a self-assembled entity with an equivalent diameter of approximately \\(\\pu{(1\\!-\\! 100) nm}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:13842 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13842 "current"^^xsd:string)
Declaration(Class(goldbook:13843))
AnnotationAssertion(rdfs:label goldbook:13843 "nanoscopic polymer film")
AnnotationAssertion(dcterms:description goldbook:13843 "Polymer film that has lateral dimensions in the range of \\(\\pu{(1\\!-\\! 100) nm}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:13843 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13843 "current"^^xsd:string)
Declaration(Class(goldbook:13844))
AnnotationAssertion(rdfs:label goldbook:13844 "organophilic")
AnnotationAssertion(dcterms:description goldbook:13844 "Qualifier indicating tendency of a molecular entity or of a pendent group thereof to interact favourably with nonpolar organic solvents.")
AnnotationAssertion(rdfs:comment goldbook:13844 "The term is especially used of colloids that form solvates in organic solvents and thereby swell."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13844 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13844 "current"^^xsd:string)
Declaration(Class(goldbook:13845))
AnnotationAssertion(rdfs:label goldbook:13845 "organophilic interaction")
AnnotationAssertion(dcterms:description goldbook:13845 "Attractive interaction between organophilic molecules or materials.")
AnnotationAssertion(mito:isMentionedBy goldbook:13845 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13845 "current"^^xsd:string)
Declaration(Class(goldbook:13846))
AnnotationAssertion(rdfs:label goldbook:13846 "orientation parameter")
AnnotationAssertion(dcterms:description goldbook:13846 "Order parameter applied to macroscopic assemblies of ordered materials, such as crystal assemblies in fibers.")
AnnotationAssertion(mito:isMentionedBy goldbook:13846 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13846 "current"^^xsd:string)
Declaration(Class(goldbook:13847))
AnnotationAssertion(rdfs:label goldbook:13847 "pendent chain")
AnnotationAssertion(dcterms:description goldbook:13847 "Oligomeric or polymeric offshoot from a macromolecular chain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13847 "branch")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13847 "side-chain")
AnnotationAssertion(rdfs:comment goldbook:13847 "An oligomeric branch may be termed a \"short-chain branch\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13847 "A polymeric branch may be termed a \"ong-chain branch\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13847 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13847 "current"^^xsd:string)
Declaration(Class(goldbook:13848))
AnnotationAssertion(rdfs:label goldbook:13848 "polymersome")
AnnotationAssertion(dcterms:description goldbook:13848 "Vesicle with radius ranging from \\(\\pu{50 nm}\\) to greater than \\(\\pu{5 \\upmu m}\\) constructed from an amphiphilic synthetic block copolymer.")
AnnotationAssertion(rdfs:comment goldbook:13848 "Most reported polymersomes serve as hosts for an aqueous solution and are useful for the accommodation or temporary trapping of molecules such as drugs, enzymes, and other proteins and peptides in in vivo applications."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13848 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13848 "current"^^xsd:string)
Declaration(Class(goldbook:13849))
AnnotationAssertion(rdfs:label goldbook:13849 "polymolecular")
AnnotationAssertion(dcterms:description goldbook:13849 "Consisting of many molecules.")
AnnotationAssertion(mito:isMentionedBy goldbook:13849 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13849 "current"^^xsd:string)
Declaration(Class(goldbook:13850))
AnnotationAssertion(rdfs:label goldbook:13850 "polyrotaxane")
AnnotationAssertion(dcterms:description goldbook:13850 "Polymer comprising mechanically interlocked molecular architectures typically of a macromolecule threaded through one or more macrocycles.")
AnnotationAssertion(rdfs:comment goldbook:13850 "The macrocycle(s) may be threaded onto the polymer backbone or side-chains."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13850 "A polyrotaxane may also be composed of macromolecules comprising one or more macrocyclic main-chain or side-chain units threaded with linear chains."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13850 goldbook:13837)
AnnotationAssertion(rdfs:seeAlso goldbook:13850 goldbook:13847)
AnnotationAssertion(mito:isMentionedBy goldbook:13850 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13850 "current"^^xsd:string)
Declaration(Class(goldbook:13851))
AnnotationAssertion(rdfs:label goldbook:13851 "ditopic receptor")
AnnotationAssertion(dcterms:description goldbook:13851 "Receptor with two binding sites.")
AnnotationAssertion(rdfs:comment goldbook:13851 "Ditopic receptors can be either homotopic or heterotopic according to whether or not the binding sites are the same (typically, self-complementary binding sites) or different."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13851 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13851 "current"^^xsd:string)
Declaration(Class(goldbook:13852))
AnnotationAssertion(rdfs:label goldbook:13852 "rod-coil copolymer")
AnnotationAssertion(dcterms:description goldbook:13852 "Copolymer the molecules of which consist of rigid and flexible blocks.")
AnnotationAssertion(mito:isMentionedBy goldbook:13852 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13852 "current"^^xsd:string)
Declaration(Class(goldbook:13853))
AnnotationAssertion(rdfs:label goldbook:13853 "Scatchard equation")
AnnotationAssertion(dcterms:description goldbook:13853 "Equation used to calculate the association constant, \\(K_{\\rm{a}}\\), of a ligand with a protein molecule.")
AnnotationAssertion(rdfs:comment goldbook:13853 "The Scatchard equation is \\[\\frac{r}{c} = -K_{\\rm{a}} r + K_{\\rm{a}} n\\] in which \\(r\\) is the ratio of the concentration of bound ligand to the concentration of available protein binding sites, \\(c\\) is the concentration of free ligand, and \\(n\\) is the number of binding sites per protein molecule."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13853 "The association constant, \\(K_{\\rm{a}}\\), has units of reciprocal concentration."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13853 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13853 "current"^^xsd:string)
Declaration(Class(goldbook:13854))
AnnotationAssertion(rdfs:label goldbook:13854 "Scatchard plot")
AnnotationAssertion(dcterms:description goldbook:13854 "Linear plot of \\(r/c\\) against \\(r\\) in accordance with the Scatchard equation.")
AnnotationAssertion(rdfs:seeAlso goldbook:13854 goldbook:13853)
AnnotationAssertion(mito:isMentionedBy goldbook:13854 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13854 "current"^^xsd:string)
Declaration(Class(goldbook:13855))
AnnotationAssertion(rdfs:label goldbook:13855 "main-chain self-assembly")
AnnotationAssertion(dcterms:description goldbook:13855 "Inter- or intra-molecular self-assembly of constitutional units within the backbones of polymer molecules.")
AnnotationAssertion(mito:isMentionedBy goldbook:13855 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13855 "current"^^xsd:string)
Declaration(Class(goldbook:13856))
AnnotationAssertion(rdfs:label goldbook:13856 "side-chain self-assembly")
AnnotationAssertion(dcterms:description goldbook:13856 "Inter- or intra-molecular self-assembly of side-chains or constitutional units of polymer molecules.")
AnnotationAssertion(mito:isMentionedBy goldbook:13856 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13856 "current"^^xsd:string)
Declaration(Class(goldbook:13857))
AnnotationAssertion(rdfs:label goldbook:13857 "shell-crosslinked micelle")
AnnotationAssertion(dcterms:description goldbook:13857 "Core-shell structure formed by self-assembly of amphiphiles and subsequently covalently crosslinked through functionalities in the shell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13857 "knedel")
AnnotationAssertion(rdfs:comment goldbook:13857 "The amphiphiles are often amphiphilic block copolymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13857 "Such structures are used, e.g., in drug delivery and dye encapsulation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13857 goldbook:13806)
AnnotationAssertion(rdfs:seeAlso goldbook:13857 goldbook:13795)
AnnotationAssertion(rdfs:seeAlso goldbook:13857 goldbook:13805)
AnnotationAssertion(mito:isMentionedBy goldbook:13857 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13857 "current"^^xsd:string)
Declaration(Class(goldbook:13858))
AnnotationAssertion(rdfs:label goldbook:13858 "smectic")
AnnotationAssertion(dcterms:description goldbook:13858 "Pertaining to the arrangement and orientation of molecules in a smectic mesophase.")
AnnotationAssertion(rdfs:seeAlso goldbook:13858 goldbook:13859)
AnnotationAssertion(mito:isMentionedBy goldbook:13858 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13858 "current"^^xsd:string)
Declaration(Class(goldbook:13859))
AnnotationAssertion(rdfs:label goldbook:13859 "smectic mesophase")
AnnotationAssertion(dcterms:description goldbook:13859 "Mesophase that has the molecules arranged in layers with a well-defined layer spacing or periodicity.")
AnnotationAssertion(rdfs:comment goldbook:13859 "There are several types of smectic mesophases, characterised by a variety of molecular arrangements within the layers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13859 "Although the total number of smectic mesophases cannot be specified, the following types have been defined: \\(SmA\\), \\(SmB\\), \\(SmC\\), \\(SmF\\), and \\(SmI\\). The alphabetical order of suffixes merely indicates an order of discovery."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13859 "Smectic mesophases are amongst the class of liquid-crystal mesophases."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13859 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13859 "current"^^xsd:string)
Declaration(Class(goldbook:13860))
AnnotationAssertion(rdfs:label goldbook:13860 "spherand")
AnnotationAssertion(dcterms:description goldbook:13860 "Macrocyclic compound capable of completely enveloping a cation, having donor atoms (\\(\\ce{O}\\), \\(\\ce{N}\\), \\(\\ce{S}\\)) arranged such that they provide a solvation sphere to the encapsulated cation.")
AnnotationAssertion(mito:isMentionedBy goldbook:13860 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13860 "current"^^xsd:string)
Declaration(Class(goldbook:13861))
AnnotationAssertion(rdfs:label goldbook:13861 "π-π stacking")
AnnotationAssertion(dcterms:description goldbook:13861 "Inter- or intra-molecular alignment of aromatic groups within molecules induced by the interactional overlap of their \\(\\ce{\\uppi\\mbox{-}orbitals}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13861 "pi-pi stacking")
AnnotationAssertion(rdfs:comment goldbook:13861 "\\(\\ce{\\uppi\\mbox{-}\\uppi}\\) Interactions become stronger as the number of \\(\\ce{\\uppi\\mbox{-}electrons}\\) increases."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13861 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13861 "current"^^xsd:string)
Declaration(Class(goldbook:13862))
AnnotationAssertion(rdfs:label goldbook:13862 "T-stacking")
AnnotationAssertion(dcterms:description goldbook:13862 "Orthogonal alignment of constitutional units within molecules that lead to favourable interactions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13862 "edge-face interaction")
AnnotationAssertion(rdfs:comment goldbook:13862 "T-stacking is often seen in proteins where the partially positively charged hydrogen atom of one aromatic system points to the centre of the aromatic plane of another aromatic system."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13862 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13862 "current"^^xsd:string)
Declaration(Class(goldbook:13863))
AnnotationAssertion(rdfs:label goldbook:13863 "static self-assembly")
AnnotationAssertion(dcterms:description goldbook:13863 "Self-assembly at equilibrium.")
AnnotationAssertion(mito:isMentionedBy goldbook:13863 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13863 "current"^^xsd:string)
Declaration(Class(goldbook:13864))
AnnotationAssertion(rdfs:label goldbook:13864 "stimuli-responsive polymer")
AnnotationAssertion(dcterms:description goldbook:13864 "Polymer that responds reversibly to external stimulus or stimuli.")
AnnotationAssertion(rdfs:comment goldbook:13864 "The external stimuli might be temperature, incident radiation, \\(\\pu{pH}\\), etc., and responses would be manifest as changes in a physical property such as conformation, aggregation, liquid-crystalline state, absorption spectrum, emission spectrum, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13864 goldbook:13794)
AnnotationAssertion(mito:isMentionedBy goldbook:13864 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13864 "current"^^xsd:string)
Declaration(Class(goldbook:13865))
AnnotationAssertion(rdfs:label goldbook:13865 "solvophilic")
AnnotationAssertion(dcterms:description goldbook:13865 "Qualifier indicating an affinity for solvents.")
AnnotationAssertion(mito:isMentionedBy goldbook:13865 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13865 "current"^^xsd:string)
Declaration(Class(goldbook:13866))
AnnotationAssertion(rdfs:label goldbook:13866 "solvophobic")
AnnotationAssertion(dcterms:description goldbook:13866 "Qualifier indicating a lack of affinity for solvents.")
AnnotationAssertion(mito:isMentionedBy goldbook:13866 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13866 "current"^^xsd:string)
Declaration(Class(goldbook:13867))
AnnotationAssertion(rdfs:label goldbook:13867 "supramolecular association")
AnnotationAssertion(dcterms:description goldbook:13867 "Self-assembly involving reversible, noncovalent, directional interactions of molecules that result in a high-molecular-mass entity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13867 "Lehn association")
AnnotationAssertion(rdfs:comment goldbook:13867 "Use of the term \"supramolecular polymerization\" is discouraged."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13867 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13867 "current"^^xsd:string)
Declaration(Class(goldbook:13868))
AnnotationAssertion(rdfs:label goldbook:13868 "template polymerization")
AnnotationAssertion(dcterms:description goldbook:13868 "Polymerization of monomer molecules adsorbed and oriented (a) on a surface, (b) in a polymer lattice, (c) on polymer molecules in solution, or (d) round a metal ion whereby the structure of the polymer chains formed is controlled by the orientation of the monomer molecules.")
AnnotationAssertion(mito:isMentionedBy goldbook:13868 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13868 "current"^^xsd:string)
Declaration(Class(goldbook:13869))
AnnotationAssertion(rdfs:label goldbook:13869 "lipid vesicle")
AnnotationAssertion(dcterms:description goldbook:13869 "Vesicle constructed from a lipid bilayer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13869 "liposome")
AnnotationAssertion(rdfs:comment goldbook:13869 "Liposomes have potential use in drug delivery."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13869 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13869 "current"^^xsd:string)
Declaration(Class(goldbook:13870))
AnnotationAssertion(rdfs:label goldbook:13870 "artificial")
AnnotationAssertion(dcterms:description goldbook:13870 "Qualifier for something that is made by human activity, rather than occurring naturally.")
AnnotationAssertion(mito:isMentionedBy goldbook:13870 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13870 "current"^^xsd:string)
Declaration(Class(goldbook:13871))
AnnotationAssertion(rdfs:label goldbook:13871 "artificial polymer")
AnnotationAssertion(dcterms:description goldbook:13871 "Man-made polymer that is not a biopolymer.")
AnnotationAssertion(rdfs:comment goldbook:13871 "Artificial polymer should also be used in the case of chemically modified biopolymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13871 "Biochemists are now capable of synthesizing copies of biopolymers that should be named synthetic biopolymers to make a distinction with true biopolymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13871 "Genetic engineering is now capable of generating non-natural analogues of biopolymers that should be referred to as artificial biopolymers, e.g., artificial protein, artificial polynucleotide, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13871 goldbook:13907)
AnnotationAssertion(mito:isMentionedBy goldbook:13871 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13871 "current"^^xsd:string)
Declaration(Class(goldbook:13872))
AnnotationAssertion(rdfs:label goldbook:13872 "bioactive")
AnnotationAssertion(dcterms:description goldbook:13872 "Qualifier for a substance that provokes any response from a living system.")
AnnotationAssertion(rdfs:comment goldbook:13872 "This definition is derived from \"material which has been designed to induce specific biological activity\" and is limited to material made bioactive on purpose. However, the concept of bioactivity does not imply beneficial action only, although the term is often used positively, i.e., to reflect a beneficial action."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13872 goldbook:13873)
AnnotationAssertion(mito:isMentionedBy goldbook:13872 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13872 "current"^^xsd:string)
Declaration(Class(goldbook:13873))
AnnotationAssertion(rdfs:label goldbook:13873 "bioactivity")
AnnotationAssertion(dcterms:description goldbook:13873 "Capability of a substance, such as a drug or a vaccine, to provoke a response from a living matter.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13873 "biological activity")
AnnotationAssertion(rdfs:comment goldbook:13873 "There is no polymer (solid or in solution) that is inert in contact with a living system, because of adsorption and/or physical-chemical interactions with life elements (biopolymers, cells, and tissues)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13873 "Stealth is often used to reflect the absence of recognition by defense proteins of the complement, and more generally opsonins that serve as binding enhancers for the process of phagocytosis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13873 goldbook:13945)
AnnotationAssertion(mito:isMentionedBy goldbook:13873 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13873 "current"^^xsd:string)
Declaration(Class(goldbook:13874))
AnnotationAssertion(rdfs:label goldbook:13874 "bioadhesion")
AnnotationAssertion(dcterms:description goldbook:13874 "Adhesion of cells or tissues to the surface of a material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13874 "bioattachment")
AnnotationAssertion(rdfs:comment goldbook:13874 "Cell adhesion is generally followed by proliferation as a biofilm or as a tissue."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13874 "Assessing of adhesion is made after washing to eliminate unattached cells."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13874 "The use of the term \"bioattachment\" is discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13874 goldbook:13879)
AnnotationAssertion(mito:isMentionedBy goldbook:13874 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13874 "current"^^xsd:string)
Declaration(Class(goldbook:13875))
AnnotationAssertion(rdfs:label goldbook:13875 "bioalteration")
AnnotationAssertion(dcterms:description goldbook:13875 "Cell-mediated chemical modification without main chain scission.")
AnnotationAssertion(mito:isMentionedBy goldbook:13875 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13875 "current"^^xsd:string)
Declaration(Class(goldbook:13877))
AnnotationAssertion(rdfs:label goldbook:13877 "biodegradability")
AnnotationAssertion(dcterms:description goldbook:13877 "Capability of being degraded by biological activity.")
AnnotationAssertion(rdfs:comment goldbook:13877 "In vitro activity of isolated enzymes cannot be considered as biological activity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13877 goldbook:13873)
AnnotationAssertion(rdfs:seeAlso goldbook:13877 goldbook:13905)
AnnotationAssertion(mito:isMentionedBy goldbook:13877 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13877 "current"^^xsd:string)
Declaration(Class(goldbook:13878))
AnnotationAssertion(rdfs:label goldbook:13878 "biodisintegration")
AnnotationAssertion(dcterms:description goldbook:13878 "Disintegration resulting from the action of cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:13878 goldbook:13903)
AnnotationAssertion(mito:isMentionedBy goldbook:13878 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13878 "current"^^xsd:string)
Declaration(Class(goldbook:13879))
AnnotationAssertion(rdfs:label goldbook:13879 "biofilm")
AnnotationAssertion(dcterms:description goldbook:13879 "Aggregate of microorganisms in which cells that are frequently embedded within a self-produced matrix of extracellular polymeric substance (EPS) adhere to each other and/or to a surface.")
AnnotationAssertion(rdfs:comment goldbook:13879 "A biofilm is a fixed system that can be adapted internally to environmental conditions by its inhabitants."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13879 "The self-produced matrix of EPS, which is also referred to as slime, is a polymeric conglomeration generally composed of extracellular biopolymers in various structural forms."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13879 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13879 "current"^^xsd:string)
Declaration(Class(goldbook:13880))
AnnotationAssertion(rdfs:label goldbook:13880 "biofragmentation")
AnnotationAssertion(dcterms:description goldbook:13880 "Fragmentation resulting from the action of cells.")
AnnotationAssertion(mito:isMentionedBy goldbook:13880 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13880 "current"^^xsd:string)
Declaration(Class(goldbook:13881))
AnnotationAssertion(rdfs:label goldbook:13881 "biomaterial")
AnnotationAssertion(dcterms:description goldbook:13881 "Material exploited in contact with living tissues, organisms, or microorganisms.")
AnnotationAssertion(rdfs:comment goldbook:13881 "The notion of exploitation includes utility for applications and for fundamental research to understand reciprocal perturbations as well."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13881 "The definition \"non-viable material used in a medical device, intended to interact with biological systems\" recommended in cannot be extended to the environmental field where people mean \"material of natural origin\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13881 "This general term should not be confused with the terms biopolymer or biomacromolecule. The use of \"polymeric biomaterial\" is recommended when one deals with polymer or polymer device of therapeutic or biological interest."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13881 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13881 "current"^^xsd:string)
Declaration(Class(goldbook:13882))
AnnotationAssertion(rdfs:label goldbook:13882 "biomineralization")
AnnotationAssertion(dcterms:description goldbook:13882 "Mineralization caused by cell-mediated phenomena.")
AnnotationAssertion(rdfs:comment goldbook:13882 "Biomineralization is a process generally concomitant to biodegradation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13882 goldbook:13912)
AnnotationAssertion(mito:isMentionedBy goldbook:13882 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13882 "current"^^xsd:string)
Declaration(Class(goldbook:13883))
AnnotationAssertion(rdfs:label goldbook:13883 "biostability")
AnnotationAssertion(dcterms:description goldbook:13883 "Resistance to the deleterious action of living systems that allows preservation of the initial characteristics of a substance.")
AnnotationAssertion(rdfs:comment goldbook:13883 "If the substance is involved in an application, the term has to be related to a desired duration of performance, because almost any material ages in contact with living systems and biochemical processes regardless of the domain."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13883 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13883 "current"^^xsd:string)
Declaration(Class(goldbook:13884))
AnnotationAssertion(rdfs:label goldbook:13884 "biotic")
AnnotationAssertion(dcterms:description goldbook:13884 "Pertaining to, or produced by, living cells or organisms.")
AnnotationAssertion(mito:isMentionedBy goldbook:13884 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13884 "current"^^xsd:string)
Declaration(Class(goldbook:13885))
AnnotationAssertion(rdfs:label goldbook:13885 "bulk degradation")
AnnotationAssertion(dcterms:description goldbook:13885 "Homogeneous degradation affecting the volume of a sample.")
AnnotationAssertion(rdfs:comment goldbook:13885 "The molar mass of the whole sample decreases progressively as opposed to the constancy observed in the case of erosion and bioerosion."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13885 "This expression is often used when degradation is faster inside than at the surface. This is not appropriate. Nevertheless, it should be adopted specifically in opposition to erosion. In this case, the molar mass distribution becomes rapidly bimodal."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13885 "Generally, degradation is faster inside because of autocatalysis by entrapped degradation byproducts or by the presence of a chain-cleaving reagent entrapped within the matrix."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13885 goldbook:13890)
AnnotationAssertion(rdfs:seeAlso goldbook:13885 goldbook:13906)
AnnotationAssertion(mito:isMentionedBy goldbook:13885 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13885 "current"^^xsd:string)
Declaration(Class(goldbook:13886))
AnnotationAssertion(rdfs:label goldbook:13886 "controlled delivery")
AnnotationAssertion(dcterms:description goldbook:13886 "Supply of a substance according to desired rate and amount over time.")
AnnotationAssertion(rdfs:comment goldbook:13886 "If only a delayed or prolonged release is obtained without matching a desired release profile, the expression sustained delivery is to be used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13886 goldbook:13920)
AnnotationAssertion(mito:isMentionedBy goldbook:13886 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13886 "current"^^xsd:string)
Declaration(Class(goldbook:13887))
AnnotationAssertion(rdfs:label goldbook:13887 "degradability")
AnnotationAssertion(dcterms:description goldbook:13887 "Capability of undergoing degradation.")
AnnotationAssertion(rdfs:seeAlso goldbook:13887 goldbook:13890)
AnnotationAssertion(mito:isMentionedBy goldbook:13887 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13887 "current"^^xsd:string)
Declaration(Class(goldbook:13888))
AnnotationAssertion(rdfs:label goldbook:13888 "degradable macromolecule")
AnnotationAssertion(dcterms:description goldbook:13888 "Macromolecule that is able to undergo chain scissions under specific conditions, resulting in a decrease of molar mass.")
AnnotationAssertion(mito:isMentionedBy goldbook:13888 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13888 "current"^^xsd:string)
Declaration(Class(goldbook:13889))
AnnotationAssertion(rdfs:label goldbook:13889 "degradable polymer")
AnnotationAssertion(dcterms:description goldbook:13889 "Polymer in which macromolecules are able to undergo chain scissions, resulting in a decrease of molar mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:13889 goldbook:13890)
AnnotationAssertion(mito:isMentionedBy goldbook:13889 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13889 "current"^^xsd:string)
Declaration(Class(goldbook:13890))
AnnotationAssertion(rdfs:label goldbook:13890 "degradation")
AnnotationAssertion(dcterms:description goldbook:13890 "Progressive loss of the performance or of the characteristics of a substance or a device.")
AnnotationAssertion(rdfs:comment goldbook:13890 "The process of degradation may be specified by a prefix or an adjective preceding the term \"degradation\". For example, degradation caused by the action of water is termed \"hydrodegradation\" or hydrolysis; by visible or ultraviolet light is termed \"photodegradation\"; by the action of oxygen or by the combined action of light and oxygen is termed \"oxidative degradation\" or \"photooxidative degradation\", respectively; by the action of heat or by the combined effect of chemical agents and heat is termed \"thermal degradation\" or \"thermochemical degradation\", respectively; by the combined action of heat and oxygen is termed \"thermooxidative degradation\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13890 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13890 "current"^^xsd:string)
Declaration(Class(goldbook:13891))
AnnotationAssertion(rdfs:label goldbook:13891 "degradation")
AnnotationAssertion(dcterms:description goldbook:13891 "Degradation that results in desired changes in the values of in-use properties of the material because of macromolecule cleavage and molar mass decrease.")
AnnotationAssertion(rdfs:comment goldbook:13891 "Adapted where the definition is general. For biorelated polymers, the definition is purposely and specifically limited to the chemical degradation of macromolecules in order to make a clear distinction with the physical degradation of the material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13891 "In any condition, degradation must be used instead of biodegradation when the mechanism of chain scission is not known or demonstrated as cell-mediated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13891 "Degradation can result from the action of enzymes (see enzymatic degradation), or from the action of cells, organisms, and/or microorganisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13891 goldbook:13903)
AnnotationAssertion(rdfs:seeAlso goldbook:13891 goldbook:13905)
AnnotationAssertion(mito:isMentionedBy goldbook:13891 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13891 "current"^^xsd:string)
Declaration(Class(goldbook:13892))
AnnotationAssertion(rdfs:label goldbook:13892 "degree of bioassimilation")
AnnotationAssertion(dcterms:description goldbook:13892 "Mass fraction of a substance that is bioassimilated.")
AnnotationAssertion(mito:isMentionedBy goldbook:13892 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13892 "current"^^xsd:string)
Declaration(Class(goldbook:13893))
AnnotationAssertion(rdfs:label goldbook:13893 "degree of biodegradation")
AnnotationAssertion(dcterms:description goldbook:13893 "Mass fraction of a substance that is biodegraded under specified conditions as measured through specified phenomena or techniques sensitive to mineral and biomass formations.")
AnnotationAssertion(rdfs:comment goldbook:13893 "Expressions like degree of biodegradability, extent of biodegradability, etc., are improper because a property reflected by the suffix \"ity\" cannot be quantified contrary to a deed reflected by \"tion\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13893 goldbook:13877)
AnnotationAssertion(mito:isMentionedBy goldbook:13893 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13893 "current"^^xsd:string)
Declaration(Class(goldbook:13894))
AnnotationAssertion(rdfs:label goldbook:13894 "degree of biodisintegration")
AnnotationAssertion(dcterms:description goldbook:13894 "Mass fraction of a biodisintegrated substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:13894 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13894 "current"^^xsd:string)
Declaration(Class(goldbook:13895))
AnnotationAssertion(rdfs:label goldbook:13895 "degree of biofragmentation")
AnnotationAssertion(dcterms:description goldbook:13895 "Mass fraction of the original material that is biofragmented.")
AnnotationAssertion(mito:isMentionedBy goldbook:13895 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13895 "current"^^xsd:string)
Declaration(Class(goldbook:13896))
AnnotationAssertion(rdfs:label goldbook:13896 "degree of biomineralization")
AnnotationAssertion(dcterms:description goldbook:13896 "Mass fraction of a substance that is biomineralized.")
AnnotationAssertion(mito:isMentionedBy goldbook:13896 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13896 "current"^^xsd:string)
Declaration(Class(goldbook:13897))
AnnotationAssertion(rdfs:label goldbook:13897 "degree of degradation")
AnnotationAssertion(dcterms:description goldbook:13897 "Mass fraction of a polymer that is degraded under specified conditions as measured through a specified phenomenon sensitive to molecular dimensions.")
AnnotationAssertion(rdfs:seeAlso goldbook:13897 goldbook:13890)
AnnotationAssertion(mito:isMentionedBy goldbook:13897 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13897 "current"^^xsd:string)
Declaration(Class(goldbook:13898))
AnnotationAssertion(rdfs:label goldbook:13898 "degree of disintegration")
AnnotationAssertion(dcterms:description goldbook:13898 "Mass fraction of the particles of defined size issued from a fragmented substance.")
AnnotationAssertion(rdfs:comment goldbook:13898 "The size is generally defined by sieving. It is a practical characteristic in composting."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13898 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13898 "current"^^xsd:string)
Declaration(Class(goldbook:13899))
AnnotationAssertion(rdfs:label goldbook:13899 "degree of fragmentation")
AnnotationAssertion(dcterms:description goldbook:13899 "Mass fraction of a substance that is fragmented.")
AnnotationAssertion(mito:isMentionedBy goldbook:13899 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13899 "current"^^xsd:string)
Declaration(Class(goldbook:13900))
AnnotationAssertion(rdfs:label goldbook:13900 "degree of mineralization")
AnnotationAssertion(dcterms:description goldbook:13900 "Mass fraction of a substance that is mineralized.")
AnnotationAssertion(mito:isMentionedBy goldbook:13900 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13900 "current"^^xsd:string)
Declaration(Class(goldbook:13901))
AnnotationAssertion(rdfs:label goldbook:13901 "depolymerase")
AnnotationAssertion(dcterms:description goldbook:13901 "Enzyme that is able to catalyse the depolymerization of a biomacromolecule.")
AnnotationAssertion(rdfs:comment goldbook:13901 "A depolymerase does not necessarily convert all the macromolecules to monomer molecules, occasionally, a specific oligomer is the end-product, depending on the mechanism."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13901 "This term is generally used in the case of macromolecules produced by bacteria, because bacteria have the potential to degrade the biopolymers they synthesized."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13901 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13901 "current"^^xsd:string)
Declaration(Class(goldbook:13902))
AnnotationAssertion(rdfs:label goldbook:13902 "deterioration")
AnnotationAssertion(dcterms:description goldbook:13902 "Deleterious alteration of a material in quality, serviceability, or vigor.")
AnnotationAssertion(rdfs:comment goldbook:13902 "Deterioration can result from physical and/or chemical phenomena."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13902 "Deterioration is connected to a loss of performances and thus to the function, whereas degradation is connected with a loss of properties."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13902 "Polymer deterioration is more general than polymer degradation, which reflects loss of properties resulting from chemical cleavage of macromolecules only."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13902 goldbook:13890)
AnnotationAssertion(mito:isMentionedBy goldbook:13902 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13902 "current"^^xsd:string)
Declaration(Class(goldbook:13903))
AnnotationAssertion(rdfs:label goldbook:13903 "disintegration")
AnnotationAssertion(dcterms:description goldbook:13903 "Fragmentation to particles of a defined size.")
AnnotationAssertion(rdfs:comment goldbook:13903 "The limiting size is generally defined according to sieving conditions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13903 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13903 "current"^^xsd:string)
Declaration(Class(goldbook:13904))
AnnotationAssertion(rdfs:label goldbook:13904 "durability")
AnnotationAssertion(dcterms:description goldbook:13904 "Ability of a material to retain the values of its properties under specified conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:13904 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13904 "current"^^xsd:string)
Declaration(Class(goldbook:13905))
AnnotationAssertion(rdfs:label goldbook:13905 "enzymatic degradation")
AnnotationAssertion(dcterms:description goldbook:13905 "Degradation caused by the catalytic action of enzymes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13905 "enzymatic decomposition")
AnnotationAssertion(rdfs:comment goldbook:13905 "Sometimes called enzymic degradation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13905 "Degradation caused by enzymes can be observed under biotic or abiotic conditions but only degradation due to cell bioactivity can be called biodegradation, otherwise enzymatic degradation is to be used, especially in the case of in vitro abiotic conditions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13905 goldbook:13890)
AnnotationAssertion(rdfs:seeAlso goldbook:13905 goldbook:13873)
AnnotationAssertion(rdfs:seeAlso goldbook:13905 goldbook:13884)
AnnotationAssertion(mito:isMentionedBy goldbook:13905 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13905 "current"^^xsd:string)
Declaration(Class(goldbook:13906))
AnnotationAssertion(rdfs:label goldbook:13906 "erosion")
AnnotationAssertion(dcterms:description goldbook:13906 "Degradation that occurs at the surface and progresses from it into the bulk.")
AnnotationAssertion(rdfs:comment goldbook:13906 "See enzymatic degradation. In the case of polymers, water-soluble enzymes can hardly diffuse into the macromolecular network, except, maybe, in some hydrogels. They adhere to surfaces to cause erosion."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13906 "Erosion can also result from chemical degradation when the degrading reagent reacts faster than it diffuses inside. There is a risk of confusion that can be eliminated after careful and detailed investigation of the degradation mechanism. (See bioerosion.)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13906 "The wording bulk erosion is incorrect and its use therefore discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13906 goldbook:13890)
AnnotationAssertion(rdfs:seeAlso goldbook:13906 goldbook:13905)
AnnotationAssertion(mito:isMentionedBy goldbook:13906 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13906 "current"^^xsd:string)
Declaration(Class(goldbook:13907))
AnnotationAssertion(rdfs:label goldbook:13907 "genetic engineering")
AnnotationAssertion(dcterms:description goldbook:13907 "Process of inserting new genetic information into existing cells in order to modify a specific organism for the purpose of changing its characteristics.")
AnnotationAssertion(mito:isMentionedBy goldbook:13907 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13907 "current"^^xsd:string)
Declaration(Class(goldbook:13908))
AnnotationAssertion(rdfs:label goldbook:13908 "maximum degree of biodegradation")
AnnotationAssertion(dcterms:description goldbook:13908 "Greater value of the degree of biodegradation that can be reached under selected experimental conditions.")
AnnotationAssertion(rdfs:comment goldbook:13908 "This expression reflects the fact that some biodegradable parts of a biodegradable material may not be accessible to biodegradation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13908 "Not to be confused with ultimate degradation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13908 goldbook:13923)
AnnotationAssertion(mito:isMentionedBy goldbook:13908 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13908 "current"^^xsd:string)
Declaration(Class(goldbook:13909))
AnnotationAssertion(rdfs:label goldbook:13909 "microcapsule")
AnnotationAssertion(dcterms:description goldbook:13909 "Hollow microparticle composed of a solid shell surrounding a core-forming space available to permanently or temporarily entrapped substances.")
AnnotationAssertion(rdfs:comment goldbook:13909 "The substances can be drugs, pesticides, dyes, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13909 goldbook:13910)
AnnotationAssertion(mito:isMentionedBy goldbook:13909 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13909 "current"^^xsd:string)
Declaration(Class(goldbook:13910))
AnnotationAssertion(rdfs:label goldbook:13910 "microparticle")
AnnotationAssertion(dcterms:description goldbook:13910 "Particle with dimensions between \\(\\pu{1E-7}\\) and \\(\\pu{1E-4 m}\\).")
AnnotationAssertion(rdfs:comment goldbook:13910 "The lower limit between micro- and nano-sizing is still a matter of debate. (See nanoparticle.)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13910 "To be consistent with the prefix \"micro\" and the range imposed by the definition, dimensions of microparticles should be expressed in \\(\\pu{\\upmu\\!m}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13910 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13910 "current"^^xsd:string)
Declaration(Class(goldbook:13911))
AnnotationAssertion(rdfs:label goldbook:13911 "microsphere")
AnnotationAssertion(dcterms:description goldbook:13911 "Microparticle of spherical shape without membrane or any distinct outer layer.")
AnnotationAssertion(rdfs:comment goldbook:13911 "The absence of outer layer forming a distinct phase is important to distinguish microspheres from microcapsules because it leads to first-order diffusion phenomena, whereas diffusion is zero order in the case of microcapsules."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13911 goldbook:13909)
AnnotationAssertion(mito:isMentionedBy goldbook:13911 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13911 "current"^^xsd:string)
Declaration(Class(goldbook:13912))
AnnotationAssertion(rdfs:label goldbook:13912 "mineralization")
AnnotationAssertion(dcterms:description goldbook:13912 "Process through which an organic substance becomes impregnated by or turned into inorganic substances.")
AnnotationAssertion(rdfs:comment goldbook:13912 "A particular case is the process by which living organisms produce and structure minerals often to harden or stiffen existing tissues. (See biomineralization.)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13912 "In the case of polymer biodegradation, this term is used to reflect conversion to _015233_ and \\(\\ce{H2O}\\) and other inorganics. \\(\\ce{CH4}\\) can be considered as part of the mineralization process because it comes up in parallel to the minerals in anaerobic composting, also called methanization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13912 goldbook:13882)
AnnotationAssertion(mito:isMentionedBy goldbook:13912 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13912 "current"^^xsd:string)
Declaration(Class(goldbook:13913))
AnnotationAssertion(rdfs:label goldbook:13913 "nanocapsule")
AnnotationAssertion(dcterms:description goldbook:13913 "Hollow nanoparticle composed of a solid shell that surrounds a core-forming space available to entrap substances.")
AnnotationAssertion(mito:isMentionedBy goldbook:13913 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13913 "current"^^xsd:string)
Declaration(Class(goldbook:13914))
AnnotationAssertion(rdfs:label goldbook:13914 "nanosphere")
AnnotationAssertion(dcterms:description goldbook:13914 "Nanoparticle of spherical shape without membrane or any distinct outer layer.")
AnnotationAssertion(rdfs:comment goldbook:13914 "A nanosphere is composed of a matrix where substances can be permanently or temporarily embedded, dissolved, or covalently bound."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13914 goldbook:13911)
AnnotationAssertion(mito:isMentionedBy goldbook:13914 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13914 "current"^^xsd:string)
Declaration(Class(goldbook:13915))
AnnotationAssertion(rdfs:label goldbook:13915 "plastic")
AnnotationAssertion(dcterms:description goldbook:13915 "Generic term used in the case of polymeric material that may contain other substances to improve performance and/or reduce costs.")
AnnotationAssertion(rdfs:comment goldbook:13915 "The use of this term instead of polymer is a source of confusion and thus is not recommended."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13915 "This term is used in polymer engineering for materials often compounded that can be processed by flow."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13915 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13915 "current"^^xsd:string)
Declaration(Class(goldbook:13917))
AnnotationAssertion(rdfs:label goldbook:13917 "solid dispersion")
AnnotationAssertion(dcterms:description goldbook:13917 "Solid multiphasic mixture with at least one polymer component dominating.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13917 "solid dispersion polymer")
AnnotationAssertion(rdfs:comment goldbook:13917 "The nonpolymeric components can act as fillers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13917 "The dispersed compounds can be in clusters of particles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13917 "Solid dispersion is commonly prepared by three different methods, namely, solventbased, fusion-melt, and hybrid fusion-solvent methods."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13917 "In pharmaceutical preparations, incompatible polymer-drug mixtures are generally solid dispersions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13917 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13917 "current"^^xsd:string)
Declaration(Class(goldbook:13919))
AnnotationAssertion(rdfs:label goldbook:13919 "stimulus-responsive polymer")
AnnotationAssertion(dcterms:description goldbook:13919 "Polymer that responds or that is designed to respond to a stimulus like pH, light, heat, etc. change, and provides a predetermined action.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13919 "smart polymer")
AnnotationAssertion(rdfs:comment goldbook:13919 "The generated action can be unique or cyclic. It generally results from cooperative phenomena."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13919 "The stimulus can affect macromolecules or macromolecule assemblies forming the polymer."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13919 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13919 "current"^^xsd:string)
Declaration(Class(goldbook:13920))
AnnotationAssertion(rdfs:label goldbook:13920 "sustained delivery")
AnnotationAssertion(dcterms:description goldbook:13920 "Supply of a substance from a container where it is temporarily entrapped for the sake of achieving a prolonged action.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13920 "prolonged delivery")
AnnotationAssertion(rdfs:comment goldbook:13920 "In some cases, the container is a polymer processed as implant, film, microparticle, or nanoparticle, auto-assembly of molecules, or a macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13920 "The substance can be temporarily embedded, dissolved, or covalently bound."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13920 "The term is relevant to the release of substances like pesticides, dyes, drugs, etc."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13920 "In the case of sustained delivery according to required specifications, the use of controlled delivery is recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13920 goldbook:13886)
AnnotationAssertion(rdfs:seeAlso goldbook:13920 goldbook:13936)
AnnotationAssertion(rdfs:seeAlso goldbook:13920 goldbook:13910)
AnnotationAssertion(mito:isMentionedBy goldbook:13920 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13920 "current"^^xsd:string)
Declaration(Class(goldbook:13921))
AnnotationAssertion(rdfs:label goldbook:13921 "synthetic biopolymer")
AnnotationAssertion(dcterms:description goldbook:13921 "Copy of a biopolymer man-made using abiotic chemical routes.")
AnnotationAssertion(rdfs:seeAlso goldbook:13921 goldbook:13870)
AnnotationAssertion(mito:isMentionedBy goldbook:13921 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13921 "current"^^xsd:string)
Declaration(Class(goldbook:13922))
AnnotationAssertion(rdfs:label goldbook:13922 "theoretical degree of biodegradation")
AnnotationAssertion(dcterms:description goldbook:13922 "Degree of biodegradation that corresponds to conversion of all the organic matter present in an original polymer-based item to minerals and biomass.")
AnnotationAssertion(rdfs:comment goldbook:13922 "This expression is used as reference to assess biodegradable components that are not accessible to biodegradation from those that are bioavailable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13922 goldbook:13893)
AnnotationAssertion(rdfs:seeAlso goldbook:13922 goldbook:13876)
AnnotationAssertion(mito:isMentionedBy goldbook:13922 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13922 "current"^^xsd:string)
Declaration(Class(goldbook:13923))
AnnotationAssertion(rdfs:label goldbook:13923 "ultimate biodegradation")
AnnotationAssertion(dcterms:description goldbook:13923 "Complete breakdown of a compound to either fully oxidized or reduced simple molecules (such as carbon dioxide/methane, nitrate/ammonium, and water).")
AnnotationAssertion(rdfs:comment goldbook:13923 "This term reflects the end-products of biodegradation. As such, it differs from the theoretical degree of biodegradation, which depends on the presence of non-biodegradable components."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13923 "The use of this expression is not recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13923 goldbook:13922)
AnnotationAssertion(mito:isMentionedBy goldbook:13923 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13923 "current"^^xsd:string)
Declaration(Class(goldbook:13924))
AnnotationAssertion(rdfs:label goldbook:13924 "artificial organ")
AnnotationAssertion(dcterms:description goldbook:13924 "Medical device that replaces, in part or in whole, the function of one of the organs of the body.")
AnnotationAssertion(mito:isMentionedBy goldbook:13924 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13924 "current"^^xsd:string)
Declaration(Class(goldbook:13925))
AnnotationAssertion(rdfs:label goldbook:13925 "biomedical")
AnnotationAssertion(dcterms:description goldbook:13925 "Qualifier for a domain grouping scientific and practical activities related to therapy.")
AnnotationAssertion(rdfs:comment goldbook:13925 "The term is relevant to therapy in surgery, medicine, pharmacology, dentistry, etc."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13925 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13925 "current"^^xsd:string)
Declaration(Class(goldbook:13926))
AnnotationAssertion(rdfs:label goldbook:13926 "bioprosthesis")
AnnotationAssertion(dcterms:description goldbook:13926 "Implantable prosthesis that consists totally or substantially of nonviable, treated donor tissue.")
AnnotationAssertion(mito:isMentionedBy goldbook:13926 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13926 "current"^^xsd:string)
Declaration(Class(goldbook:13927))
AnnotationAssertion(rdfs:label goldbook:13927 "bioresorbability")
AnnotationAssertion(dcterms:description goldbook:13927 "Ability to be eliminated from an animal or human body through natural pathways.")
AnnotationAssertion(rdfs:comment goldbook:13927 "Natural pathways are kidneys through glomerular filtration and lungs after metabolization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13927 "Bioassimilation with formation of novel biomass is a particular means of elimination often combined with the other pathways."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13927 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13927 "current"^^xsd:string)
Declaration(Class(goldbook:13928))
AnnotationAssertion(rdfs:label goldbook:13928 "bioresorption")
AnnotationAssertion(dcterms:description goldbook:13928 "Disappearance of a substance from an organism by processes of metabolism, secretion, or excretion.")
AnnotationAssertion(rdfs:comment goldbook:13928 "Bioresorption is now considered as pertinent and should be used specifically only when foreign material and residues have been shown assimilated or eliminated from the living host, regardless of the followed route, namely, lungs or kidneys or insertion in biochemical processes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13928 "In the case of polymers or high-molar-mass macromolecules that are retained in parenteral compartments, degradation or biodegradation is necessary prior to bioresorption."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13928 "This concept does not apply to the environment as everything, including degradation by-products issued from outdoor degradation or biodegradation can only be stored or chemically transformed on Earth, so far."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13928 goldbook:13890)
AnnotationAssertion(mito:isMentionedBy goldbook:13928 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13928 "current"^^xsd:string)
Declaration(Class(goldbook:13929))
AnnotationAssertion(rdfs:label goldbook:13929 "bone cement")
AnnotationAssertion(dcterms:description goldbook:13929 "Synthetic, self-curing organic or inorganic material used to fill up a cavity or to create a mechanical fixation.")
AnnotationAssertion(rdfs:comment goldbook:13929 "In situ self-curing can be the source of released reagents that can cause local and/or systemic toxicity as in the case of the monomer released from methacrylics-based bone cement used in orthopedic surgery."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13929 "In dentistry, polymer-based cements are also used as fillers of cavities. They are generally cured photochemically using UV radiation in contrast to bone cements."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13929 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13929 "current"^^xsd:string)
Declaration(Class(goldbook:13930))
AnnotationAssertion(rdfs:label goldbook:13930 "carcinogenicity")
AnnotationAssertion(dcterms:description goldbook:13930 "Ability or tendency to produce cancer.")
AnnotationAssertion(rdfs:comment goldbook:13930 "In general, polymers are not known as carcinogens or mutagens, however, residual monomers or additives can cause genetic mutations."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13930 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13930 "current"^^xsd:string)
Declaration(Class(goldbook:13931))
AnnotationAssertion(rdfs:label goldbook:13931 "drug carrier")
AnnotationAssertion(dcterms:description goldbook:13931 "Macromolecule or polymer used to transport a pharmacologically active compound to be released later on due to an abiotic or biotic process.")
AnnotationAssertion(rdfs:comment goldbook:13931 "A complementary property of a polymeric drug carrier is targeting, which can be obtained by specific interactions with a receptor if bearing a specific ligand or by selection depending on other factors such as permeation through membranes or capillaries."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13931 goldbook:13884)
AnnotationAssertion(rdfs:seeAlso goldbook:13931 goldbook:13886)
AnnotationAssertion(rdfs:seeAlso goldbook:13931 goldbook:13941)
AnnotationAssertion(rdfs:seeAlso goldbook:13931 goldbook:13920)
AnnotationAssertion(rdfs:seeAlso goldbook:13931 goldbook:13946)
AnnotationAssertion(mito:isMentionedBy goldbook:13931 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13931 "current"^^xsd:string)
Declaration(Class(goldbook:13932))
AnnotationAssertion(rdfs:label goldbook:13932 "foreign body reaction")
AnnotationAssertion(dcterms:description goldbook:13932 "Cellular response of the inflammatory and wound healing processes following introduction of a foreign object in a human or animal body.")
AnnotationAssertion(rdfs:comment goldbook:13932 "The foreign object can be a medical device, a prosthesis, a particle or any compound introduced accidentally."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13932 "The foreign body reaction results in more or less intense events such as fibrous tissue formation, macrophage activation, giant cells formation, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13932 goldbook:13944)
AnnotationAssertion(mito:isMentionedBy goldbook:13932 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13932 "current"^^xsd:string)
Declaration(Class(goldbook:13933))
AnnotationAssertion(rdfs:label goldbook:13933 "host response")
AnnotationAssertion(dcterms:description goldbook:13933 "Reaction of a living system to the presence of a substance or a material.")
AnnotationAssertion(mito:isMentionedBy goldbook:13933 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13933 "current"^^xsd:string)
Declaration(Class(goldbook:13934))
AnnotationAssertion(rdfs:label goldbook:13934 "hybrid artificial organ")
AnnotationAssertion(dcterms:description goldbook:13934 "Artificial organ that is a combination of viable cells and one or more biomaterials.")
AnnotationAssertion(rdfs:seeAlso goldbook:13934 goldbook:13881)
AnnotationAssertion(mito:isMentionedBy goldbook:13934 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13934 "current"^^xsd:string)
Declaration(Class(goldbook:13935))
AnnotationAssertion(rdfs:label goldbook:13935 "immunogenicity")
AnnotationAssertion(dcterms:description goldbook:13935 "Ability of a material or substance to elicit a cellular immune response and/or antibody production.")
AnnotationAssertion(mito:isMentionedBy goldbook:13935 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13935 "current"^^xsd:string)
Declaration(Class(goldbook:13936))
AnnotationAssertion(rdfs:label goldbook:13936 "implant")
AnnotationAssertion(dcterms:description goldbook:13936 "Medical device made from one or more biomaterials that is intentionally placed within the body, either totally or partially buried beneath an epithelial surface.")
AnnotationAssertion(rdfs:comment goldbook:13936 "There are also other devices implanted that are not medical devices, e.g., for cosmetic, cultural, or aesthetic purposes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13936 goldbook:13881)
AnnotationAssertion(mito:isMentionedBy goldbook:13936 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13936 "current"^^xsd:string)
Declaration(Class(goldbook:13937))
AnnotationAssertion(rdfs:label goldbook:13937 "macromolecular prodrug")
AnnotationAssertion(dcterms:description goldbook:13937 "Prodrug in which the temporary chemical entity is a macromolecule.")
AnnotationAssertion(rdfs:comment goldbook:13937 "In this particular case of prodrug, the macromolecule carries several drug molecules generally. These molecules are linked to the carrier through cleavable bonds."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13937 goldbook:13943)
AnnotationAssertion(mito:isMentionedBy goldbook:13937 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13937 "current"^^xsd:string)
Declaration(Class(goldbook:13938))
AnnotationAssertion(rdfs:label goldbook:13938 "medical device")
AnnotationAssertion(dcterms:description goldbook:13938 "Instrument, apparatus, implement, machine, contrivance, in vitro reagent, or other similar or related article, including any component, part of accessory, which is intended for use in the diagnosis of disease or other conditions, or in the cure, mitigation, treatment, or prevention of disease in man.")
AnnotationAssertion(mito:isMentionedBy goldbook:13938 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13938 "current"^^xsd:string)
Declaration(Class(goldbook:13939))
AnnotationAssertion(rdfs:label goldbook:13939 "pharmaceutical")
AnnotationAssertion(dcterms:description goldbook:13939 "Qualifier for substances or systems, including polymers, exploited by the pharmaceutical industry.")
AnnotationAssertion(rdfs:comment goldbook:13939 "A pharmaceutical substance can be exploited for its bioactivity or as an excipient."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13939 "The term \"pharmaceutical\" is also used as short form for a pharmaceutical substance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13939 goldbook:13873)
AnnotationAssertion(mito:isMentionedBy goldbook:13939 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13939 "current"^^xsd:string)
Declaration(Class(goldbook:13940))
AnnotationAssertion(rdfs:label goldbook:13940 "pharmacological")
AnnotationAssertion(dcterms:description goldbook:13940 "Qualifiers for substances, including macromolecules or polymers, and actions involved in pharmacology.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13940 "pharmacologic")
AnnotationAssertion(rdfs:comment goldbook:13940 "A pharmacological polymer can be bioactive by itself or because it is used as a temporary carrier of a bioactive substance of interest in pharmacology."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13940 goldbook:13872)
AnnotationAssertion(rdfs:seeAlso goldbook:13940 goldbook:13937)
AnnotationAssertion(rdfs:seeAlso goldbook:13940 goldbook:13942)
AnnotationAssertion(mito:isMentionedBy goldbook:13940 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13940 "current"^^xsd:string)
Declaration(Class(goldbook:13941))
AnnotationAssertion(rdfs:label goldbook:13941 "pharmacologically active")
AnnotationAssertion(dcterms:description goldbook:13941 "Qualifier for a substance that exhibits bioactivity of pharmacological interest.")
AnnotationAssertion(rdfs:seeAlso goldbook:13941 goldbook:13873)
AnnotationAssertion(rdfs:seeAlso goldbook:13941 goldbook:13940)
AnnotationAssertion(mito:isMentionedBy goldbook:13941 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13941 "current"^^xsd:string)
Declaration(Class(goldbook:13942))
AnnotationAssertion(rdfs:label goldbook:13942 "pharmacology")
AnnotationAssertion(dcterms:description goldbook:13942 "Science of drugs including their origin, composition, pharmacokinetics, pharmacodynamics, therapeutic use, and toxicology.")
AnnotationAssertion(mito:isMentionedBy goldbook:13942 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13942 "current"^^xsd:string)
Declaration(Class(goldbook:13943))
AnnotationAssertion(rdfs:label goldbook:13943 "prodrug")
AnnotationAssertion(dcterms:description goldbook:13943 "Compound that undergoes biotransformation before exhibiting pharmacological effects.")
AnnotationAssertion(rdfs:comment goldbook:13943 "Prodrugs can thus be viewed as drugs containing specialized nontoxic protective groups used in a transient manner to alter or to eliminate undesirable properties in the parent molecule."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13943 goldbook:13940)
AnnotationAssertion(mito:isMentionedBy goldbook:13943 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13943 "current"^^xsd:string)
Declaration(Class(goldbook:13944))
AnnotationAssertion(rdfs:label goldbook:13944 "prosthesis")
AnnotationAssertion(dcterms:description goldbook:13944 "Device that replaces a limb, organ, or tissue of the body.")
AnnotationAssertion(mito:isMentionedBy goldbook:13944 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13944 "current"^^xsd:string)
Declaration(Class(goldbook:13945))
AnnotationAssertion(rdfs:label goldbook:13945 "stealth")
AnnotationAssertion(dcterms:description goldbook:13945 "Qualifier for a macromolecule, a surface, or a device that is not detected by defense proteins of the complement and the Mononuclear Phagocyte System, especially macrophages, after introduction in parental compartments.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13945 "stealth biomedical polymer")
AnnotationAssertion(rdfs:comment goldbook:13945 "Detection by natural defenses generally leads to the destruction of the device or of the surrounding tissues."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13945 "Surfaces are often decorated by chemical entities aimed at suppressing the activation of the natural defense processes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13945 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13945 "current"^^xsd:string)
Declaration(Class(goldbook:13946))
AnnotationAssertion(rdfs:label goldbook:13946 "targeting")
AnnotationAssertion(dcterms:description goldbook:13946 "Exploitation of specific or nonspecific interactions to target a particular part of a living system, or a particular type of cells.")
AnnotationAssertion(mito:isMentionedBy goldbook:13946 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13946 "current"^^xsd:string)
Declaration(Class(goldbook:13947))
AnnotationAssertion(rdfs:label goldbook:13947 "therapeutic polymer")
AnnotationAssertion(dcterms:description goldbook:13947 "Polymer aimed at helping therapists in treating diseases or trauma.")
AnnotationAssertion(mito:isMentionedBy goldbook:13947 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13947 "current"^^xsd:string)
Declaration(Class(goldbook:13948))
AnnotationAssertion(rdfs:label goldbook:13948 "thrombogenicity")
AnnotationAssertion(dcterms:description goldbook:13948 "Property of a material (or substance) that induces and/or promotes the formation of a thrombus.")
AnnotationAssertion(mito:isMentionedBy goldbook:13948 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13948 "current"^^xsd:string)
Declaration(Class(goldbook:13949))
AnnotationAssertion(rdfs:label goldbook:13949 "tissue engineering")
AnnotationAssertion(dcterms:description goldbook:13949 "Use of a combination of cells, engineering and materials methods, and suitable biochemical and physico-chemical factors to improve or replace biological functions.")
AnnotationAssertion(rdfs:comment goldbook:13949 "While most definitions of tissue engineering cover a broad range of applications, in practice the term is closely associated with applications that repair or replace portions of or whole tissues (i.e., bone, cartilage, blood vessels, bladder, skin, etc.)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13949 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13949 "current"^^xsd:string)
Declaration(Class(goldbook:13950))
AnnotationAssertion(rdfs:label goldbook:13950 "transplant")
AnnotationAssertion(dcterms:description goldbook:13950 "Complete structure, such as an organ that is transferred from a site in a donor to a site in a recipient for the purpose of the reconstruction of the recipient site.")
AnnotationAssertion(mito:isMentionedBy goldbook:13950 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13950 "current"^^xsd:string)
Declaration(Class(goldbook:13951))
AnnotationAssertion(rdfs:label goldbook:13951 "aerobic biodegradation")
AnnotationAssertion(dcterms:description goldbook:13951 "Biodegradation in the presence of molecular oxygen.")
AnnotationAssertion(rdfs:comment goldbook:13951 "Oxygen is generally supplied by the atmosphere."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13951 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13951 "current"^^xsd:string)
Declaration(Class(goldbook:13952))
AnnotationAssertion(rdfs:label goldbook:13952 "anaerobic biodegradation")
AnnotationAssertion(dcterms:description goldbook:13952 "Biodegradation in the absence of oxygen.")
AnnotationAssertion(rdfs:seeAlso goldbook:13952 goldbook:13912)
AnnotationAssertion(mito:isMentionedBy goldbook:13952 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13952 "current"^^xsd:string)
Declaration(Class(goldbook:13953))
AnnotationAssertion(rdfs:label goldbook:13953 "bioplastic")
AnnotationAssertion(dcterms:description goldbook:13953 "Biobased polymer derived from the biomass or issued from monomers derived from the biomass and which, at some stage in its processing into finished products, can be shaped by flow.")
AnnotationAssertion(rdfs:comment goldbook:13953 "Bioplastic is generally used as the opposite of polymer derived from fossil resources."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13953 "Bioplastic is misleading because it suggests that any polymer derived from the biomass is environmentally friendly."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13953 "The use of the term \"bioplastic\" is discouraged. Use the expression \"biobased polymer\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13953 "A biobased polymer similar to a petrobased one does not imply any superiority with respect to the environment unless the comparison of respective life cycle assessments is favourable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13953 goldbook:13958)
AnnotationAssertion(rdfs:seeAlso goldbook:13953 goldbook:13960)
AnnotationAssertion(mito:isMentionedBy goldbook:13953 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13953 "current"^^xsd:string)
Declaration(Class(goldbook:13954))
AnnotationAssertion(rdfs:label goldbook:13954 "compost")
AnnotationAssertion(dcterms:description goldbook:13954 "Solid product resulting from the decomposition of organic wastes by fermentation.")
AnnotationAssertion(rdfs:comment goldbook:13954 "A compost is generally processed in personal composters or industrially to be used as fertilizer. In the latter case, specifications in structure and quality are to be provided."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13954 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13954 "current"^^xsd:string)
Declaration(Class(goldbook:13955))
AnnotationAssertion(rdfs:label goldbook:13955 "conditioning film")
AnnotationAssertion(dcterms:description goldbook:13955 "Film that is rapidly formed on the surface of a solid in contact with a biological system (in the widest sense) that conditions the surface for subsequent interaction with constituents of the biological system.")
AnnotationAssertion(rdfs:comment goldbook:13955 "Frequently, the conditioning film consists of proteins that prepare almost any surface for subsequent colonization by microorganisms or cells."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13955 "Not to be confused with conditioning film in packaging."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13955 "The term can be applied to the surface of any material that is in contact with blood or body fluids because the very first event is coverage by more or less denaturized adhering proteins."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13955 "Not to be confused with biofilm, which implies the presence of cells or microorganisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13955 goldbook:13879)
AnnotationAssertion(mito:isMentionedBy goldbook:13955 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13955 "current"^^xsd:string)
Declaration(Class(goldbook:13956))
AnnotationAssertion(rdfs:label goldbook:13956 "ecotoxicity")
AnnotationAssertion(dcterms:description goldbook:13956 "Consequence of adverse effects caused by a substance on the environment and on organisms living in it.")
AnnotationAssertion(rdfs:comment goldbook:13956 "Using the term is recommended when adverse effects concern water, air, sediments, etc."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13956 "If only living organisms (animals, plants, microorganisms) are concerned, the use of toxicity is recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13956 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13956 "current"^^xsd:string)
Declaration(Class(goldbook:13957))
AnnotationAssertion(rdfs:label goldbook:13957 "environmentally degradable polymer")
AnnotationAssertion(dcterms:description goldbook:13957 "Polymer that can be degraded by the action of the environment, through, for example, air, light, heat, or microorganisms.")
AnnotationAssertion(rdfs:comment goldbook:13957 "When it is to be a source of material, such a polymer must be designed to degrade into products at a predictable rate compatible with the application. Such products are usually of lower molar mass than the original polymer."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13957 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13957 "current"^^xsd:string)
Declaration(Class(goldbook:13958))
AnnotationAssertion(rdfs:label goldbook:13958 "environmentally friendly")
AnnotationAssertion(dcterms:description goldbook:13958 "Qualifiers for a substance, device, or process that has minimal deleterious impact on the environment, which is air, water, minerals, living systems, etc.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13958 "ecocompatible")
AnnotationAssertion(rdfs:comment goldbook:13958 "The assignment of these qualifiers to a polymer must be based on a consistent life cycle assessment."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13958 "Ecocompatible is introduced to complement biocompatible, whose meaning is limited to living systems."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13958 goldbook:13960)
AnnotationAssertion(mito:isMentionedBy goldbook:13958 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13958 "current"^^xsd:string)
Declaration(Class(goldbook:13959))
AnnotationAssertion(rdfs:label goldbook:13959 "green polymer")
AnnotationAssertion(dcterms:description goldbook:13959 "Polymer that conforms to the concept of green chemistry.")
AnnotationAssertion(rdfs:comment goldbook:13959 "Green polymer does not necessarily mean environmentally friendly polymer or biobased polymer although the confusion is often made in the literature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13959 goldbook:13958)
AnnotationAssertion(mito:isMentionedBy goldbook:13959 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13959 "current"^^xsd:string)
Declaration(Class(goldbook:13960))
AnnotationAssertion(rdfs:label goldbook:13960 "life cycle assessment")
AnnotationAssertion(dcterms:description goldbook:13960 "Investigation and valuation of the environmental impacts of a given product or service caused or necessitated by its existence.")
AnnotationAssertion(rdfs:comment goldbook:13960 "Also known as life cycle analysis, LCA, ecobalance, and cradle-to-grave analysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13960 "Assessing the life cycle of a polymer or a plastic must take into account all the factors that can be identified from the up-stage raw material to the waste management."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13960 goldbook:13915)
AnnotationAssertion(rdfs:seeAlso goldbook:13960 goldbook:13964)
AnnotationAssertion(mito:isMentionedBy goldbook:13960 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13960 "current"^^xsd:string)
Declaration(Class(goldbook:13961))
AnnotationAssertion(rdfs:label goldbook:13961 "mulching film")
AnnotationAssertion(dcterms:description goldbook:13961 "Polymer film aimed at covering seeded area in order to protect the growing plants from weeds and cold and preserve humidity.")
AnnotationAssertion(rdfs:comment goldbook:13961 "Such film acts as a mobile green house."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13961 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13961 "current"^^xsd:string)
Declaration(Class(goldbook:13962))
AnnotationAssertion(rdfs:label goldbook:13962 "sustainability")
AnnotationAssertion(dcterms:description goldbook:13962 "Developments that meet the needs of the present without compromising the ability of future generations to meet their needs.")
AnnotationAssertion(rdfs:comment goldbook:13962 "Other definitions are not recommended in the context of biorelated polymers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13962 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13962 "current"^^xsd:string)
Declaration(Class(goldbook:13963))
AnnotationAssertion(rdfs:label goldbook:13963 "waste")
AnnotationAssertion(dcterms:description goldbook:13963 "Residue left when a compound or a product reaches the end of its initial usefulness.")
AnnotationAssertion(rdfs:comment goldbook:13963 "Also referred to as rubbish, trash, garbage, or junk depending upon the type of material and the regional terminology."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13963 "In living organisms, waste relates to unwanted substances or toxins that are expelled from them."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13963 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13963 "current"^^xsd:string)
Declaration(Class(goldbook:13964))
AnnotationAssertion(rdfs:label goldbook:13964 "waste management")
AnnotationAssertion(dcterms:description goldbook:13964 "Control of the collection, treatment and disposal of wastes.")
AnnotationAssertion(rdfs:seeAlso goldbook:13964 goldbook:13963)
AnnotationAssertion(mito:isMentionedBy goldbook:13964 doi:10.1351/PAC-REC-10-12-04)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13964 "current"^^xsd:string)
Declaration(Class(goldbook:13965))
AnnotationAssertion(rdfs:label goldbook:13965 "macrocyclic component")
AnnotationAssertion(dcterms:description goldbook:13965 "Molecule that has at least one ring (cycle) large enough to allow it to be threaded onto a linear subchain of another molecule.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13965 "MC")
AnnotationAssertion(rdfs:comment goldbook:13965 "To thread a simple hydrocarbon chain such as a polyethylene chain, at least a 24-membered ring is needed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13965 "In a macromolecular rotaxane, a macrocyclic component can be a discrete macrocyclic molecule or a macromolecule that includes one or more threadable ring(s). Examples and structure representations of both are shown: "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13965 "The literature on rotaxanes frequently cites the word \"macrocycle\" as a contraction of (and an abbreviation for) macrocyclic component. A use of the word \"macrocycle\" in rotaxane terminology is incompatible with the IUPAC definition of a macrocycle, which is \"a cyclic macromolecule or a macromolecular cyclic portion of a macromolecule\":  Such a macrocycle is virtually never used as a macrocyclic component in a rotaxane assembly. Therefore, since the term \"macrocycle\" is ambiguous, its use should be avoided in the macromolecular rotaxane literature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13965 goldbook:13968)
AnnotationAssertion(rdfs:seeAlso goldbook:13965 goldbook:13984)
AnnotationAssertion(rdfs:seeAlso goldbook:13965 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13965 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13965 "current"^^xsd:string)
Declaration(Class(goldbook:13966))
AnnotationAssertion(rdfs:label goldbook:13966 "macromolecular component")
AnnotationAssertion(dcterms:description goldbook:13966 "Macromolecule that is part of a rotaxane assembly.")
AnnotationAssertion(rdfs:comment goldbook:13966 "A macromolecular component can be a macrocyclic component or a threading component of a rotaxane or both."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13966 goldbook:13965)
AnnotationAssertion(rdfs:seeAlso goldbook:13966 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13966 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13966 "current"^^xsd:string)
Declaration(Class(goldbook:13967))
AnnotationAssertion(rdfs:label goldbook:13967 "macromolecular pseudorotaxane")
AnnotationAssertion(dcterms:description goldbook:13967 "Pseudorotaxane, at least one component of which is a macromolecule.")
AnnotationAssertion(rdfs:comment goldbook:13967 "Structural differences between macromolecular pseudorotaxanes and macromolecular rotaxanes are neither substantial nor always obvious; macromolecular rotaxanes from which macromolecular component(s) can be dethreaded (i.e., the macromolecular rotaxane becomes a macromolecular pseudorotaxane) under some specific conditions are known. Therefore, the overwhelming majority of definitions concerning macromolecular rotaxanes are fully applicable also to macromolecular pseudorotaxanes after replacing the word \"rotaxane\" with the word \"pseudorotaxane\"; also, nomenclature rules are the same for both of these compound classes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13967 "A macromolecular pseudorotaxane in which only one end of a threading component is capped with a stopper is sometimes called a \"macromolecular semirotaxane\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13967 goldbook:13972)
AnnotationAssertion(rdfs:seeAlso goldbook:13967 goldbook:13968)
AnnotationAssertion(rdfs:seeAlso goldbook:13967 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13967 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13967 "current"^^xsd:string)
Declaration(Class(goldbook:13968))
AnnotationAssertion(rdfs:label goldbook:13968 "macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13968 "Rotaxane, at least one component of which is a macromolecule.")
AnnotationAssertion(rdfs:comment goldbook:13968 "A macromolecular rotaxane is composed of a macromolecular chain with either at least one cyclic molecule threaded onto its linear section or at least one linear molecule threaded through its threadable cycle."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13968 "Rotaxane constitutional unit(s) may be located within a specific part of a macromolecular rotaxane: (i) within end-group(s); (ii) within a main chain (see main-chain macromolecular rotaxane); (iii) within side chains (see side-chain macromolecular rotaxane)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13968 goldbook:13976)
AnnotationAssertion(rdfs:seeAlso goldbook:13968 goldbook:13969)
AnnotationAssertion(rdfs:seeAlso goldbook:13968 goldbook:13974)
AnnotationAssertion(rdfs:seeAlso goldbook:13968 goldbook:13975)
AnnotationAssertion(rdfs:seeAlso goldbook:13968 goldbook:13981)
AnnotationAssertion(mito:isMentionedBy goldbook:13968 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13968 "current"^^xsd:string)
Declaration(Class(goldbook:13969))
AnnotationAssertion(rdfs:label goldbook:13969 "main-chain macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13969 "Macromolecular rotaxane in which rotaxane constitutional units are exclusively located within the main macromolecular chain.")
AnnotationAssertion(rdfs:comment goldbook:13969 "Structure representations of basic constitutional units of main-chain macromolecular rotaxanes are as follows:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are end-groups of a threading component."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13969 goldbook:13968)
AnnotationAssertion(rdfs:seeAlso goldbook:13969 goldbook:13976)
AnnotationAssertion(rdfs:seeAlso goldbook:13969 goldbook:13981)
AnnotationAssertion(mito:isMentionedBy goldbook:13969 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13969 "current"^^xsd:string)
Declaration(Class(goldbook:13970))
AnnotationAssertion(rdfs:label goldbook:13970 "main-chain rotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13970 "Polymer composed of macromolecular assemblies that are main-chain macromolecular rotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13970 "main-chain polyrotaxane")
AnnotationAssertion(rdfs:seeAlso goldbook:13970 goldbook:13969)
AnnotationAssertion(rdfs:seeAlso goldbook:13970 goldbook:13973)
AnnotationAssertion(rdfs:seeAlso goldbook:13970 goldbook:13980)
AnnotationAssertion(mito:isMentionedBy goldbook:13970 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13970 "current"^^xsd:string)
Declaration(Class(goldbook:13971))
AnnotationAssertion(rdfs:label goldbook:13971 "molecular shuttle")
AnnotationAssertion(dcterms:description goldbook:13971 "Rotaxane or pseudorotaxane comprising a threading component upon which is threaded a macrocyclic component that, depending on the conditions, can reside at either a specific recognition site on the threading component or away from any recognition site.")
AnnotationAssertion(rdfs:comment goldbook:13971 "Rotaxane polymers composed of molecules that contain units of the molecular shuttle type are a special class of functional polymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13971 goldbook:13980)
AnnotationAssertion(rdfs:seeAlso goldbook:13971 goldbook:13972)
AnnotationAssertion(rdfs:seeAlso goldbook:13971 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13971 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13971 "current"^^xsd:string)
Declaration(Class(goldbook:13972))
AnnotationAssertion(rdfs:label goldbook:13972 "pseudorotaxane")
AnnotationAssertion(dcterms:description goldbook:13972 "Rotaxane-like molecular assembly in which the threading component(s) has(have) ends small enough to permit threading or dethreading of the macrocyclic component(s).")
AnnotationAssertion(rdfs:comment goldbook:13972 "The stability of a pseudorotaxane may arise not only from spatially hindered dethreading of its components, but also from interaction between threading and macrocyclic components, e.g., donor-acceptor or electrostatic or coordination (see recognition site)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13972 "Pseudorotaxanes in which only one end of a threading component is capped with a stopper are sometimes called \"semirotaxanes\" or \"half-capped pseudorotaxanes\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13972 goldbook:13965)
AnnotationAssertion(rdfs:seeAlso goldbook:13972 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13972 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13972 "current"^^xsd:string)
Declaration(Class(goldbook:13973))
AnnotationAssertion(rdfs:label goldbook:13973 "pseudorotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13973 "Polymer composed of macromolecules that are macromolecular pseudorotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13973 "polypseudorotaxane")
AnnotationAssertion(rdfs:comment goldbook:13973 "A narrower definition of pseudorotaxane polymer as \"a rotaxane polymer without bulky end-groups preventing dethreading of cyclic molecules\" has also been published."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13973 "A pseudorotaxane polymer in the molecule of which only one end of a threading component is capped with a stopper is sometimes called \"semirotaxane polymer\" or \"polysemirotaxane\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13973 "Though the synonym \"polypseudorotaxane\" currently appears in the literature, its use is discouraged. This term, from a purely semantic point of view, implies many threaded rings, a polymer formed from a pseudorotaxane, while a molecule of a pseudorotaxane polymer can comprise a single threaded ring."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13973 "Pseudorotaxane polymers are sometimes referred to in the literature as \"pseudopolyrotaxanes\". Use of this term is strongly discouraged owing to possible misinterpretation as \"pseudopolymeric\" or \"pseudomacromolecular\" rotaxane."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13973 goldbook:13967)
AnnotationAssertion(rdfs:seeAlso goldbook:13973 goldbook:13972)
AnnotationAssertion(rdfs:seeAlso goldbook:13973 goldbook:13980)
AnnotationAssertion(rdfs:seeAlso goldbook:13973 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13973 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13973 "current"^^xsd:string)
Declaration(Class(goldbook:13974))
AnnotationAssertion(rdfs:label goldbook:13974 "regular macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13974 "Macromolecular rotaxane, the structure of which essentially comprises the repetition of a single constitutional unit of the rotaxane type, referred to as the rotaxane constitutional repeating unit, rot-CRU, with all units connected identically with respect to directional sense.")
AnnotationAssertion(rdfs:comment goldbook:13974 "Structure representations of typical regular macromolecular rotaxanes are: "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13974 goldbook:13968)
AnnotationAssertion(rdfs:seeAlso goldbook:13974 goldbook:13975)
AnnotationAssertion(mito:isMentionedBy goldbook:13974 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13974 "current"^^xsd:string)
Declaration(Class(goldbook:13975))
AnnotationAssertion(rdfs:label goldbook:13975 "rotaxane constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:13975 "Constitutional repeating unit (CRU) that has a rotaxane structure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13975 "<em>rot</em>-CRU")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13975 "rotaxane CRU")
AnnotationAssertion(rdfs:comment goldbook:13975 "Constitutional repeating unit is the smallest constitutional unit the repetition of which constitutes a regular macromolecule, a regular oligomer molecule, a regular block, or a regular chain."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13975 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13975 "current"^^xsd:string)
Declaration(Class(goldbook:13976))
AnnotationAssertion(rdfs:label goldbook:13976 "rotaxane constitutional unit")
AnnotationAssertion(dcterms:description goldbook:13976 "Constitutional unit (CU) that has a rotaxane structure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13976 "<em>rot</em>-CU")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13976 "rotaxane CU")
AnnotationAssertion(rdfs:comment goldbook:13976 "Constitutional unit is an atom or group of atoms (with pendant atoms or groups, if any) comprising a part of the essential structure of a macromolecule, an oligomer molecule, a block, or a chain."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13976 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13976 "current"^^xsd:string)
Declaration(Class(goldbook:13977))
AnnotationAssertion(rdfs:label goldbook:13977 "rotaxane end-unit")
AnnotationAssertion(dcterms:description goldbook:13977 "Constitutional unit of a macromolecular rotaxane consisting of an end-group of its macromolecular component and a complementary threading or macrocyclic component.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13977 "<em>rot</em>-EU")
AnnotationAssertion(rdfs:comment goldbook:13977 "End-group is a constitutional unit that is an extremity of a macromolecule or oligomer molecule. An end-group is attached to only one constitutional unit of a macromolecule or oligomer molecule."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13977 goldbook:13965)
AnnotationAssertion(rdfs:seeAlso goldbook:13977 goldbook:13968)
AnnotationAssertion(rdfs:seeAlso goldbook:13977 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13977 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13977 "current"^^xsd:string)
Declaration(Class(goldbook:13978))
AnnotationAssertion(rdfs:label goldbook:13978 "rotaxane monomer")
AnnotationAssertion(dcterms:description goldbook:13978 "Monomer that is a rotaxane.")
AnnotationAssertion(mito:isMentionedBy goldbook:13978 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13978 "current"^^xsd:string)
Declaration(Class(goldbook:13979))
AnnotationAssertion(rdfs:label goldbook:13979 "rotaxane monomeric unit")
AnnotationAssertion(dcterms:description goldbook:13979 "Monomeric unit (monomer unit, mer) that has a rotaxane structure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13979 "<em>rot</em>-MU")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13979 "rotaxane monomer unit")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13979 "rotaxane MU")
AnnotationAssertion(mito:isMentionedBy goldbook:13979 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13979 "current"^^xsd:string)
Declaration(Class(goldbook:13980))
AnnotationAssertion(rdfs:label goldbook:13980 "rotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13980 "Polymer composed of macromolecules that are macromolecular rotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13980 "polymeric rotaxane")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13980 "polyrotaxane")
AnnotationAssertion(rdfs:comment goldbook:13980 "A narrower definition of rotaxane polymer: \"Polymer composed of macromolecules consisting of cyclic molecules threaded by a linear macromolecule that is eventually capped with bulky end-units preventing dethreading of cyclic molecules\" has previously been published."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13980 "Though the synonym \"polyrotaxane\" currently appears in the literature, its use is discouraged. This term, from a purely semantic point of view, namely, implies many threaded rings, i.e., a polymer formed from a rotaxane, while a molecule of a rotaxane polymer can comprise a single threaded ring."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13980 goldbook:13968)
AnnotationAssertion(mito:isMentionedBy goldbook:13980 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13980 "current"^^xsd:string)
Declaration(Class(goldbook:13981))
AnnotationAssertion(rdfs:label goldbook:13981 "side-chain macromolecular rotaxane")
AnnotationAssertion(dcterms:description goldbook:13981 "Macromolecular rotaxane in which rotaxane constitutional units are located exclusively in side chains of the macromolecule.")
AnnotationAssertion(rdfs:comment goldbook:13981 "Typical structure representations of the most common side-chain rotaxane constitutional units are as follows:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are end-groups of a threading component and \\(\\ce{R}\\) is a capping group of a side chain."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13981 goldbook:13968)
AnnotationAssertion(rdfs:seeAlso goldbook:13981 goldbook:13976)
AnnotationAssertion(rdfs:seeAlso goldbook:13981 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13981 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13981 "current"^^xsd:string)
Declaration(Class(goldbook:13982))
AnnotationAssertion(rdfs:label goldbook:13982 "side-chain rotaxane polymer")
AnnotationAssertion(dcterms:description goldbook:13982 "Polymer composed of macromolecular assemblies that are side-chain macromolecular rotaxanes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13982 "side-chain polyrotaxane")
AnnotationAssertion(rdfs:seeAlso goldbook:13982 goldbook:13973)
AnnotationAssertion(rdfs:seeAlso goldbook:13982 goldbook:13980)
AnnotationAssertion(rdfs:seeAlso goldbook:13982 goldbook:13981)
AnnotationAssertion(mito:isMentionedBy goldbook:13982 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13982 "current"^^xsd:string)
Declaration(Class(goldbook:13983))
AnnotationAssertion(rdfs:label goldbook:13983 "stopper")
AnnotationAssertion(dcterms:description goldbook:13983 "Group bulky enough to prevent dethreading of a given macrocyclic component from a threading component or its translocation to another linear section of the threading component.")
AnnotationAssertion(rdfs:comment goldbook:13983 "A stopper can be positioned at the end of the whole chain: end-group stopper, or along it: internal stopper. The latter is often a part of a rotaxane constitutional repeating unit."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13983 "Whether a group functions as a stopper or not depends on the size of the macrocyclic component. Accordingly, when stoppers are mentioned, the macrocyclic component should also be mentioned. Examples of stoppers for \\(\\upbeta\\)-cyclodextrin macrocyclic component are \\(\\ce{-CPh3}\\) end-groups or \\(\\ce{-CPh2\\bond{-}}\\) groups included in constitutional repeating units: "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13983 "A more complex threading component may contain several linear sections due to the presence of branch points or internal large groups that prevent movement of macrocyclic components from one linear section to another."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13983 goldbook:13965)
AnnotationAssertion(rdfs:seeAlso goldbook:13983 goldbook:13975)
AnnotationAssertion(rdfs:seeAlso goldbook:13983 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13983 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13983 "current"^^xsd:string)
Declaration(Class(goldbook:13984))
AnnotationAssertion(rdfs:label goldbook:13984 "threadable ring")
AnnotationAssertion(dcterms:description goldbook:13984 "Key part of a macrocyclic component: molecular ring (cycle) large enough to be threaded onto a linear subchain of a threading component.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13984 "threadable cycle")
AnnotationAssertion(rdfs:comment goldbook:13984 "A threadable ring (cycle) should be distinguished from other smaller, non-threadable rings within a complex macrocyclic component, such as benzene, cyclooctane, or similar rings."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13984 goldbook:13965)
AnnotationAssertion(rdfs:seeAlso goldbook:13984 goldbook:13985)
AnnotationAssertion(mito:isMentionedBy goldbook:13984 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13984 "current"^^xsd:string)
Declaration(Class(goldbook:13985))
AnnotationAssertion(rdfs:label goldbook:13985 "threading component")
AnnotationAssertion(dcterms:description goldbook:13985 "Molecule with at least one linear section onto which at least one macrocyclic component is threaded.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13985 "TC")
AnnotationAssertion(rdfs:comment goldbook:13985 "In the context of macromolecular rotaxanes, a threading component may be either a macromolecular chain with a linear section or a linear low-M molecule if a macromolecular component includes threadable ring(s)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13985 "For a rotaxane, the word \"linear\" is to be interpreted broadly. The linear section of a threading component can be either an unbranched chain or a linear subchain of a branched chain or a network chain, or it can be a linear chain or subchain that includes small cyclic parts that do not prevent threading through a macrocyclic component."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13985 goldbook:13965)
AnnotationAssertion(rdfs:seeAlso goldbook:13985 goldbook:13968)
AnnotationAssertion(rdfs:seeAlso goldbook:13985 goldbook:13984)
AnnotationAssertion(mito:isMentionedBy goldbook:13985 doi:10.1351/PAC-REC-11-10-15)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13985 "current"^^xsd:string)
Declaration(Class(goldbook:13986))
AnnotationAssertion(rdfs:label goldbook:13986 "absorbed local spectral photon flux density")
AnnotationAssertion(dcterms:description goldbook:13986 "Local value of the spectral photon radiance, or spectral photon flux density, defined for a three-dimensional space, often in terms of napierian properties.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13986 "local spectral photon density absorption rate")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13986 "local volumetric rate of photon absorption")
AnnotationAssertion(rdfs:comment goldbook:13986 "Mathematical expression for one spatial dimension is \\[L_{\\rm{p},\\lambda}^{\\rm{a}} (x,t) = \\alpha_{\\lambda}(\\boldsymbol{x},t) L_{\\rm{p},\\lambda} (x,t)\\] where \\(L_{\\rm{p},\\lambda}^{\\rm{a}} (x,t)\\) is the time-dependent spectral photon radiance incident from one direction at a point defined by the space coordinate \\(x\\). \\(\\alpha_{\\lambda}(\\boldsymbol{x},t)\\) is the linear napierian absorption coefficient. SI unit is \\(\\pu{s-1 m-4}\\) in photon number basis and \\(\\pu{mol s-1 m-4}\\) in chemical amount basis. Common unit is \\(\\pu{s-1 cm-3 nm-1}\\) and \\(\\pu{einstein s-1 cm-3 nm-1}\\), respectively. The above equation is valid for a collimated beam of radiation. In this case, \\[E_{\\rm{p},\\lambda,o} = L_{\\rm{p,}\\lambda}(\\boldsymbol{x},t)\\] with the subindex 'o' (the letter o) indicating radiation from all directions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13986 "For a divergent beam, the mathematical definition is: \\[L_{\\rm{p},\\lambda}^{\\rm{a}} (\\boldsymbol{x},t) = \\alpha_{\\lambda}(\\boldsymbol{x},t) L_{\\rm{p},\\lambda,o} (\\boldsymbol{x},t)\\], with \\(\\boldsymbol{x}\\) a position vector in a three-dimensional space. Units are the same as above. In this case: \\[E_{\\rm{p},\\lambda,o} (\\boldsymbol{x},t) = \\int_{4\\uppi} L_{\\rm{p},\\lambda}(\\boldsymbol{x},t) {\\rm{d}}\\mathit{\\Omega}\\]. In a three-dimensional space, units of \\(L_{\\rm{p},\\lambda}(\\boldsymbol{x},t)\\) are \\(\\pu{mol s-1 m-3 sr-1}\\). Thus, the integral over the solid angle \\(\\mathit{\\Omega}\\) is needed to obtain \\(L_{\\rm{p},\\lambda}\\) in units \\(\\pu{mol s-1 m-4}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13986 "Rigorously speaking, the general definition should be written in terms of \\(E_{\\rm{p},\\lambda,o}\\). However, for a collimated beam of radiation, it is clearer to write it directly in terms of \\(L_{\\rm{p},\\lambda}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13986 "Also called local volumetric rate of photon absorption, LVRPA [either \\(e_{\\lambda}^{\\rm{a}}(x,t)\\) for one-dimensional or \\(e_{\\lambda}^{\\rm{a}}(\\boldsymbol{x},t)\\) for three-dimensional absorbed photon flux densities, respectively] in."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13986 "In practice, for polychromatic radiation, the quantity is integrated in the wavelength range used."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13986 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13986 "current"^^xsd:string)
Declaration(Class(goldbook:13987))
AnnotationAssertion(rdfs:label goldbook:13987 "absorbed local spectral radiance")
AnnotationAssertion(dcterms:description goldbook:13987 "Local value of the spectral radiance, or energy density absorption rate, defined for a three-dimensional space, often in terms of napierian properties.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13987 "local volumetric rate of energy absorption")
AnnotationAssertion(rdfs:comment goldbook:13987 "Mathematical expression for one spatial dimension is \\[L_{\\lambda}^{\\rm{a}} (x,t) = \\alpha_{\\lambda} (\\boldsymbol{x},t) L_{\\lambda} (x,t)\\] where \\(L_{\\lambda}(x,t)\\) is the time-dependent spectral radiance incident from one direction at a point \\(x\\) defined in the space coordinates, \\(\\alpha_{\\lambda}(\\boldsymbol{x},t)\\) is the space- and time-dependent linear napierian absorption coefficient. SI unit is \\(\\pu{W m-4}\\). Common unit is \\(\\pu{W cm-3 nm-1}\\).The equation above is valid for a collimated beam of radiation, for which \\(E_{\\lambda,{\\rm{o}}}(\\boldsymbol{x},t) = L_{\\lambda}(\\boldsymbol{x},t)\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13987 "For a divergent beam, the mathematical definition is: \\[L_{\\lambda}^{\\rm{a}} (\\boldsymbol{x},t) = \\alpha_{\\lambda} (\\boldsymbol{x},t) E_{\\lambda,o} (\\boldsymbol{x},t)\\]. In this case, \\(\\boldsymbol{x}\\) is a position vector in a three-dimensional space. Units are the same as above."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13987 "Rigorously speaking, the general definition should be written in terms of \\(E_{\\lambda,o}\\). However, for a collimated beam of radiation, it is clearer to write it directly in terms of \\(L_{\\lambda}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13987 "Also called local volumetric rate of energy absorption, LVREA, [either \\(e_{\\lambda}^{\\rm{a}}(x,t)\\) for one spatial dimension or \\(e_{\\lambda}^{\\rm{a}}(\\boldsymbol{x},t)\\) for three dimensions]."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13987 "In practice, for polychromatic irradiation, the quantity is integrated in the wavelength range used."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13987 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13987 "current"^^xsd:string)
Declaration(Class(goldbook:13988))
AnnotationAssertion(rdfs:label goldbook:13988 "absorbed radiant density")
AnnotationAssertion(dcterms:description goldbook:13988 "Monochromatic radiant energy, per time interval (spectral radiance) coming from all directions and absorbed by a system integrated over the whole volume and averaged per volume \\(V\\), \\(\\langle L_{\\lambda}^{\\rm{a}}\\left(t \\right) \\rangle_{V}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13988 "absorbed spectral radiant density")
AnnotationAssertion(rdfs:comment goldbook:13988 "Mathematical expression: \\[\\langle L_{\\lambda}^{\\rm{a}} \\left(t \\right) \\rangle_{V} = \\frac{1}{V} \\int_{V} L_{\\lambda}^{\\rm{a}} (\\boldsymbol{x},t) {\\rm{d}}V = \\frac{1}{V}\\int_{V} \\alpha_{\\lambda}(\\boldsymbol{x},t) E_{\\lambda,o} (\\boldsymbol{x},t) {\\rm{d}}V\\] over the absorption volume \\(V\\), with \\(\\boldsymbol{x}\\) a position vector in a three-dimensional space, \\(\\alpha (\\boldsymbol{x},t)\\) the space- and time-dependent linear napierian absorption coefficient (absorption coefficients are always spectral and the subscript \\(\\lambda\\) may be omitted), and \\(E_{\\lambda,o} (\\boldsymbol{x},t)\\) the incident from all directions space- and time-dependent spectral fluence rate. SI unit is \\(\\pu{W m-4}\\). Common unit is \\(\\pu{W cm-3 nm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13988 "In practice, for polychromatic irradiation, the quantity is integrated in the wavelength range used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13988 goldbook:14092)
AnnotationAssertion(mito:isMentionedBy goldbook:13988 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13988 "current"^^xsd:string)
Declaration(Class(goldbook:13989))
AnnotationAssertion(rdfs:label goldbook:13989 "accumulation layer")
AnnotationAssertion(dcterms:description goldbook:13989 "Subsurface space where the majority carriers accumulate near the surface of a semiconductor because of band bending caused by the surface potential.")
AnnotationAssertion(rdfs:comment goldbook:13989 "The surface charge is of opposite sign to that of the majority charge carriers in the semiconductor. This leads to accumulation of the majority charge carriers in a subsurface layer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13989 goldbook:14004)
AnnotationAssertion(rdfs:seeAlso goldbook:13989 goldbook:14027)
AnnotationAssertion(mito:isMentionedBy goldbook:13989 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13989 "current"^^xsd:string)
Declaration(Class(goldbook:13990))
AnnotationAssertion(rdfs:label goldbook:13990 "active state")
AnnotationAssertion(dcterms:description goldbook:13990 "Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier that interacts with species at the solid/liquid, liquid/liquid, solid/gas, or liquid/gas interfaces with formation of, e.g., chemisorbed species.")
AnnotationAssertion(rdfs:seeAlso goldbook:13990 goldbook:14035)
AnnotationAssertion(mito:isMentionedBy goldbook:13990 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13990 "current"^^xsd:string)
Declaration(Class(goldbook:13991))
AnnotationAssertion(rdfs:label goldbook:13991 "active state")
AnnotationAssertion(dcterms:description goldbook:13991 "Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier or reactive intermediate that interacts with molecular entities at an interface with the formation of reaction products or intermediates.")
AnnotationAssertion(rdfs:seeAlso goldbook:13991 goldbook:14043)
AnnotationAssertion(mito:isMentionedBy goldbook:13991 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13991 "current"^^xsd:string)
Declaration(Class(goldbook:13992))
AnnotationAssertion(rdfs:label goldbook:13992 "area-related parameters")
AnnotationAssertion(dcterms:description goldbook:13992 "Quantities expressed in terms of 'per area' are denoted as area-related parameters.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13992 "areal parameters")
AnnotationAssertion(rdfs:comment goldbook:13992 "In photocatalysis, the area-related parameters do not characterise the catalyst as they do in heterogeneous dark catalysis. In general, the properties of a photocatalyst are not directly proportional to its area, especially in view of the fact that light may not equally reach every part of the surface of a particle. The light may not enter the pores of a porous surface and in this case only the outer area behaves as catalyst. A similar situation may occur when particles are aggregated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13992 "When the surface area that is accessed by the light cannot be established, it is recommended to use the total surface area in terms of the \\(\\rm{BET}(\\ce{N2})\\) area. This implies that most probably a lower limit of the quantity is obtained, because the surface determined by \\(\\ce{N2}\\) adsorption will be larger than that reached by the radiation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13992 goldbook:13997)
AnnotationAssertion(mito:isMentionedBy goldbook:13992 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13992 "current"^^xsd:string)
Declaration(Class(goldbook:13993))
AnnotationAssertion(rdfs:label goldbook:13993 "artificial photosynthesis")
AnnotationAssertion(dcterms:description goldbook:13993 "Photocatalytic production of substances from simple compounds (e.g., \\(\\ce{H2}\\) and \\(\\ce{O2}\\) from water, \\(\\ce{H2}\\) from hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation absorbed by chromophoric systems, often included in microheterogeneous media, mimicking the action of antennae and reaction centres in natural photosynthetic organisms.")
AnnotationAssertion(rdfs:comment goldbook:13993 "Antennae (also called light-harvesting centres) are molecular structures enhancing the wavelength range and sensitivity of the photosynthetic units, due to an increase in light absorption."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13993 goldbook:14029)
AnnotationAssertion(mito:isMentionedBy goldbook:13993 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13993 "current"^^xsd:string)
Declaration(Class(goldbook:13994))
AnnotationAssertion(rdfs:label goldbook:13994 "band-to-band recombination")
AnnotationAssertion(dcterms:description goldbook:13994 "Recombination of charge carriers occurring via a one-step electron transition from the conduction band to the valence band in a semiconductor or insulator.")
AnnotationAssertion(mito:isMentionedBy goldbook:13994 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13994 "current"^^xsd:string)
Declaration(Class(goldbook:13995))
AnnotationAssertion(rdfs:label goldbook:13995 "black body")
AnnotationAssertion(dcterms:description goldbook:13995 "Idealised object absorbing all incident radiant power, regardless of wavelength and transforming it all into heat. No electromagnetic radiation passes through it and none is reflected. A black body is a perfect absorber of radiant energy. Therefore, it is also a perfect emitter of radiation. The wavelength distribution of the radiation of a black body depends only on its temperature and not on its internal nature or structure.")
AnnotationAssertion(mito:isMentionedBy goldbook:13995 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13995 "current"^^xsd:string)
Declaration(Class(goldbook:13996))
AnnotationAssertion(rdfs:label goldbook:13996 "black-body-like photocatalytic reactor")
AnnotationAssertion(dcterms:description goldbook:13996 "Reactor used to determine quantum yields of photoadsorption and photocatalysed reactions when the catalyst is in the form of a powdered layer (or powder dispersion). The incident photons are (nearly) all absorbed by the catalyst, provided that the dispersion layer is sufficiently thick (or the dispersion is sufficiently concentrated).")
AnnotationAssertion(rdfs:comment goldbook:13996 "To use the black-body-like photocatalytic reactor for the determination of quantum yields, the radiation arriving at the device should be monochromatic (\\(\\lambda + {\\rm{d}}\\lambda\\)) and the temperature well controlled."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13996 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13996 "current"^^xsd:string)
Declaration(Class(goldbook:13997))
AnnotationAssertion(rdfs:label goldbook:13997 "Brunauer–Emmett–Teller surface area")
AnnotationAssertion(dcterms:description goldbook:13997 "Specific surface area (\\(\\pu{m2 kg-1}\\)) determined from the adsorption isotherm of a gas with the help of the Brunauer, Emmett, and Teller model using the conventional value for the molecular cross-section.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13997 "BET")
AnnotationAssertion(rdfs:comment goldbook:13997 "The most common gas used is \\(\\ce{N2}\\) with the conventional molecular cross-section of \\(\\pu{0.162 nm2}\\). With nitrogen, the total area is measured; this area includes the area in pores (that may not be reached by light). In this case, the expression \\(\\rm{BET}(\\ce{N2})\\) is used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13997 "The area-related parameters do not characterise the catalyst in photocatalysis as they do in heterogeneous dark catalysis. The properties of a photocatalyst are not directly proportional to their area, in view of the fact that light does not equally reach every part of the surface area or particle."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13997 goldbook:13992)
AnnotationAssertion(mito:isMentionedBy goldbook:13997 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13997 "current"^^xsd:string)
Declaration(Class(goldbook:13998))
AnnotationAssertion(rdfs:label goldbook:13998 "catalyst photoactivation")
AnnotationAssertion(dcterms:description goldbook:13998 "Generation or alteration of the catalytic activity (selectivity) of a substance after its interaction with light.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13998 "catalyst photomodification")
AnnotationAssertion(rdfs:comment goldbook:13998 "Typically, the term refers to catalytic activity (selectivity) occurring in the dark after irradiation has terminated."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13998 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13998 "current"^^xsd:string)
Declaration(Class(goldbook:13999))
AnnotationAssertion(rdfs:label goldbook:13999 "catalytic site")
AnnotationAssertion(dcterms:description goldbook:13999 "Site at which catalysed chemical transformations take place.")
AnnotationAssertion(rdfs:comment goldbook:13999 "The area-related parameters do not characterise the catalyst in heterogeneous photocatalysis as they do in heterogeneous dark catalysis, inasmuch as the density and concentration of active sites are often unknown. Thus, the properties of a photocatalyst are not directly proportional to their area, in view of the fact that light does not equally reach every part of the surface or particle. Note also that photocatalysts may include several phases, in which case the overall area is physically not meaningful."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13999 "If the assumption can be made that the active sites are distributed over the entire (photo)catalyst surface, then the heterogeneous reactions are described \"per area\". The generally accepted \\(\\rm{BET}(\\ce{N2})\\) surface area is used. In spite of the fact that there is no direct correlation between the number of active sites and the \\(\\rm{BET}(\\ce{N2})\\) area, the use of the latter may help when no alternative exists."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13999 "Quantities expressed in terms of \"per \\(\\rm{BET}(\\ce{N2})\\) area\" should be denoted as area-related, which also implies that a lower limit of the quantity is given, because the surface determined by \\(\\ce{N2}\\) adsorption will be larger than that reached by the radiation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13999 goldbook:13997)
AnnotationAssertion(rdfs:seeAlso goldbook:13999 goldbook:13992)
AnnotationAssertion(mito:isMentionedBy goldbook:13999 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13999 "current"^^xsd:string)
Declaration(Class(goldbook:14000))
AnnotationAssertion(rdfs:label goldbook:14000 "catalysed photochemical reaction")
AnnotationAssertion(dcterms:description goldbook:14000 "Enhancement (alteration) of efficiency of photochemical reactions upon direct excitation of photoactive reactants via an intermediate interaction of these reactants with certain compounds that act as catalysts (promoters) of the appropriate chemical transformations of the reactants.")
AnnotationAssertion(rdfs:comment goldbook:14000 "Sometimes this process can be identical with photocatalysis."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14000 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14000 "current"^^xsd:string)
Declaration(Class(goldbook:14001))
AnnotationAssertion(rdfs:label goldbook:14001 "Coekelbergs effect")
AnnotationAssertion(dcterms:description goldbook:14001 "Adsorption at the surface of a pre-irradiated adsorbent (the photocatalyst) occurring in the dark, after the irradiation in the presence of the photoadsorbate entities is terminated, i.e., after preliminary photoadsorption.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14001 "Coekelbergs–Solonitsyn effect")
AnnotationAssertion(rdfs:seeAlso goldbook:14001 goldbook:14087)
AnnotationAssertion(mito:isMentionedBy goldbook:14001 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14001 "current"^^xsd:string)
Declaration(Class(goldbook:14002))
AnnotationAssertion(rdfs:label goldbook:14002 "colour centres")
AnnotationAssertion(dcterms:description goldbook:14002 "Lattice defects (typically vacancies) that trap one or more electrons or holes in ionic crystals. They constitute a long-lived deep trap with a low efficiency of trapping of a carrier of the opposite sign.")
AnnotationAssertion(rdfs:comment goldbook:14002 "Colour centres accumulate in irradiated solids and give rise to photoinduced extrinsic absorption bands (photoinduced colour) in semiconductors and insulators. The dominant decay pathway of colour centres upon irradiation at moderate temperatures is photoionisation with the formation of free carriers and empty traps."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14002 "The surface F (anion vacancies occupied by electrons) and V centres (trapped holes) in semiconductors and insulators are also colour centres with the distinction that they act as metastable active states of photocatalytic centres."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14002 "Monitoring the photocolouration of a metal oxide during a surface photochemical reaction probes whether the reaction is photocatalytic."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14002 goldbook:14003)
AnnotationAssertion(rdfs:seeAlso goldbook:14002 goldbook:14010)
AnnotationAssertion(rdfs:seeAlso goldbook:14002 goldbook:14014)
AnnotationAssertion(rdfs:seeAlso goldbook:14002 goldbook:14043)
AnnotationAssertion(mito:isMentionedBy goldbook:14002 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14002 "current"^^xsd:string)
Declaration(Class(goldbook:14003))
AnnotationAssertion(rdfs:label goldbook:14003 "deep energy trap")
AnnotationAssertion(dcterms:description goldbook:14003 "Trap defined by an energy level (of trapped carriers) within the bandgap energy of a semiconductor or insulator with an energy difference between it and the conduction band (for electrons) or valence band (for holes) much greater than the energy of thermal excitation of the solid at a given temperature.")
AnnotationAssertion(rdfs:comment goldbook:14003 "The dominant decay pathway of the trap is either by trapping of carriers of the opposite sign (see recombination centre) or by photoionisation (see colour centres)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14003 "Some active states of a photocatalytic centre are called a deep trap (as in solid-state physics)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14003 goldbook:13991)
AnnotationAssertion(rdfs:seeAlso goldbook:14003 goldbook:14002)
AnnotationAssertion(rdfs:seeAlso goldbook:14003 goldbook:14081)
AnnotationAssertion(mito:isMentionedBy goldbook:14003 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14003 "current"^^xsd:string)
Declaration(Class(goldbook:14004))
AnnotationAssertion(rdfs:label goldbook:14004 "depletion layer")
AnnotationAssertion(dcterms:description goldbook:14004 "Subsurface space where the majority carriers are forced away owing to band bending caused by the surface potential. (i) The subsurface layer of an n-type semiconductor becomes depleted of electrons, which are the majority carriers, as a consequence of upward band bending. (ii) The subsurface layer of a p-type semiconductor becomes enriched by electrons (depleted of holes) as a consequence of downward band bending.")
AnnotationAssertion(rdfs:comment goldbook:14004 "The surface charge sign is identical to the sign of the majority charge carriers. The surface charge (surface potential) in semiconductors is produced as a result of adsorption or contact with the medium (an electrolyte or another surface)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14004 goldbook:14027)
AnnotationAssertion(mito:isMentionedBy goldbook:14004 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14004 "current"^^xsd:string)
Declaration(Class(goldbook:14005))
AnnotationAssertion(rdfs:label goldbook:14005 "direct bandgap semiconductor")
AnnotationAssertion(dcterms:description goldbook:14005 "Semiconductor or dielectric materials whose first band-to-band transition occurs from the highest level in the valence band to the lowest level in the conduction band possessing the same electron momentum, i.e., \\(\\boldsymbol{p}_{\\rm{max}} = \\boldsymbol{p}_{\\rm{min}}\\), with \\(\\boldsymbol{p}_{\\rm{max}}\\) and \\(\\boldsymbol{p}_{\\rm{min}}\\) the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively.")
AnnotationAssertion(rdfs:comment goldbook:14005 "On photoexcitation, the electrons change their energy owing to the absorption of photons and maintain the same momentum."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14005 goldbook:14022)
AnnotationAssertion(mito:isMentionedBy goldbook:14005 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14005 "current"^^xsd:string)
Declaration(Class(goldbook:14006))
AnnotationAssertion(rdfs:label goldbook:14006 "dynamic photoadsorption process")
AnnotationAssertion(dcterms:description goldbook:14006 "Simultaneous (or synchronous) formation of adsorbed species (adsorbate) via photoadsorption and detachment by photodesorption to yield the same species, both processes occurring under photoexcitation of the solid photocatalyst (adsorbent).")
AnnotationAssertion(rdfs:seeAlso goldbook:14006 goldbook:14048)
AnnotationAssertion(mito:isMentionedBy goldbook:14006 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14006 "current"^^xsd:string)
Declaration(Class(goldbook:14007))
AnnotationAssertion(rdfs:label goldbook:14007 "effective radiation-catalytic activity")
AnnotationAssertion(dcterms:description goldbook:14007 "Number of product entities (atoms, molecules, or radicals) generated by each \\(\\pu{100 eV}\\) of radiation incident on the system.")
AnnotationAssertion(rdfs:comment goldbook:14007 "In SI units, it refers to the amount of substance in \\(\\pu{\\upmu mol}\\) generated for each joule of radiation incident on the system. SI unit is \\(\\pu{\\upmu mol J-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14007 "It is convenient to use the amount of substance \\(\\ce{B}\\) in \\(\\pu{E-7 mol}\\) of \\(\\ce{B}\\), generated for each joule of radiation incident on the system. By choosing this (submultiple of) SI unit, a number almost identical to the _009683_ value (within \\(\\pu{4\\%}\\)) in the obsolete unit \\(\\pu{(100 eV)-1}\\) is obtained, as \\(\\pu{(100 eV)-1} = \\pu{1.036E-7 mol J-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14007 goldbook:14069)
AnnotationAssertion(mito:isMentionedBy goldbook:14007 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14007 "current"^^xsd:string)
Declaration(Class(goldbook:14008))
AnnotationAssertion(rdfs:label goldbook:14008 "electrical double layer")
AnnotationAssertion(dcterms:description goldbook:14008 "Array of charged species and oriented dipoles existing at a solid-solution interface. The solid may be a metal or a semiconductor. Double refers to the fact that the surface charge and its counter charge at the solution side are included.")
AnnotationAssertion(rdfs:comment goldbook:14008 "Often the solution side is considered to be composed of a thin inner layer of (hydrated) ions in contact with the surface and a diffuse layer further out in solution."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14008 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14008 "current"^^xsd:string)
Declaration(Class(goldbook:14009))
AnnotationAssertion(rdfs:label goldbook:14009 "exciton absorption")
AnnotationAssertion(dcterms:description goldbook:14009 "Absorption of ultraviolet, visible, or infrared radiation yielding optical information on the excitons in solids. Exciton absorption bands in a spectrum of a semiconductor or insulator are located on the long wavelength side of the fundamental absorption edge.")
AnnotationAssertion(rdfs:seeAlso goldbook:14009 goldbook:14017)
AnnotationAssertion(mito:isMentionedBy goldbook:14009 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14009 "current"^^xsd:string)
Declaration(Class(goldbook:14010))
AnnotationAssertion(rdfs:label goldbook:14010 "extrinsic absorption")
AnnotationAssertion(dcterms:description goldbook:14010 "Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators corresponding to optical transitions of electrons from defect energy levels (within the bandgap energy) to conduction band levels, or holes to valence band levels (photoionisation of defects), or from the ground state level to excited levels of a given intrinsic defect of any sort.")
AnnotationAssertion(rdfs:comment goldbook:14010 "Typically, extrinsic absorption bands are a few tenths to a few \\(\\pu{eV}\\) distant from the fundamental absorption edge in semiconductors and insulators. The red limits of photocatalytic reactions are determined by photoexcitation of photocatalysts in the extrinsic absorption bands."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14010 "Doping of a catalyst creates an extrinsic defect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14010 goldbook:14017)
AnnotationAssertion(rdfs:seeAlso goldbook:14010 goldbook:14026)
AnnotationAssertion(mito:isMentionedBy goldbook:14010 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14010 "current"^^xsd:string)
Declaration(Class(goldbook:14011))
AnnotationAssertion(rdfs:label goldbook:14011 "extrinsic defect")
AnnotationAssertion(dcterms:description goldbook:14011 "Imperfection in a solid semiconductor (or insulator) connected with surface defects of any sort involving extrinsic chemical units in relation to the chemical formula of the solid, particularly adsorbed species of any sort.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14011 "extrinsic surface defect")
AnnotationAssertion(rdfs:comment goldbook:14011 "These extrinsic surface defects play an essential role in heterogeneous photocatalysis. For example, they can serve as photocatalytic centres (sites). Surface defects, as well as bulk defects located in the near-surface region, can serve as entities that absorb ultraviolet, visible, or infrared radiation and generate free charge carriers. Surface defects can trap charge carriers and serve as recombination centres, thereby influencing the concentration of photocarriers at the surface of photocatalyst particles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14011 "Doping of a catalyst creates an extrinsic defect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14011 goldbook:14018)
AnnotationAssertion(rdfs:seeAlso goldbook:14011 goldbook:14040)
AnnotationAssertion(rdfs:seeAlso goldbook:14011 goldbook:14043)
AnnotationAssertion(rdfs:seeAlso goldbook:14011 goldbook:14081)
AnnotationAssertion(mito:isMentionedBy goldbook:14011 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14011 "current"^^xsd:string)
Declaration(Class(goldbook:14012))
AnnotationAssertion(rdfs:label goldbook:14012 "F centres")
AnnotationAssertion(dcterms:description goldbook:14012 "Anion vacancies occupied by electrons in semiconductors.")
AnnotationAssertion(rdfs:seeAlso goldbook:14012 goldbook:14002)
AnnotationAssertion(mito:isMentionedBy goldbook:14012 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14012 "current"^^xsd:string)
Declaration(Class(goldbook:14013))
AnnotationAssertion(rdfs:label goldbook:14013 "Fermi level splitting")
AnnotationAssertion(dcterms:description goldbook:14013 "Splitting of the Fermi level in irradiated semiconductors and insulators into two Fermi quasi-levels for electrons \\(E_{\\rm{F}}^{\\rm{e}}\\) and for holes \\(E_{\\rm{F}}^{\\rm{h}}\\), displaced toward the bottom of the conduction band and toward the top of the valence band, respectively.")
AnnotationAssertion(rdfs:comment goldbook:14013 "The larger the radiant power of the radiation, the larger is the Fermi level energy splitting, \\(\\Delta {\\rm{F}} = E_{\\rm{F}}^{\\rm{e}} - E_{\\rm{F}}^{\\rm{h}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14013 "The positions of the Fermi quasi-levels within the bandgap energy determine the concentration of free thermalised photocarriers in irradiated solid photocatalysts."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14013 goldbook:14040)
AnnotationAssertion(mito:isMentionedBy goldbook:14013 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14013 "current"^^xsd:string)
Declaration(Class(goldbook:14014))
AnnotationAssertion(rdfs:label goldbook:14014 "free charge carriers")
AnnotationAssertion(dcterms:description goldbook:14014 "Applies to free electrons or free holes.")
AnnotationAssertion(rdfs:seeAlso goldbook:14014 goldbook:14015)
AnnotationAssertion(mito:isMentionedBy goldbook:14014 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14014 "current"^^xsd:string)
Declaration(Class(goldbook:14015))
AnnotationAssertion(rdfs:label goldbook:14015 "free electrons")
AnnotationAssertion(dcterms:description goldbook:14015 "Photoexcited electrons from the valence band into the conduction band in semiconductors and insulators.")
AnnotationAssertion(rdfs:comment goldbook:14015 "Thermoexcitation or doping with certain impurities also leads to formation of free electrons in the conduction band of semiconductors. In metals and n-type semiconductors free electrons exist originally."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14015 "The expression \"free electron carrier\" is redundant and not recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14015 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14015 "current"^^xsd:string)
Declaration(Class(goldbook:14016))
AnnotationAssertion(rdfs:label goldbook:14016 "fundamental absorption")
AnnotationAssertion(dcterms:description goldbook:14016 "Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators inducing optical transitions of electrons originating exclusively from the valence band to the conduction band to yield free electron-hole pairs and/or exciton absorption bands.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14016 "intrinsic absorption")
AnnotationAssertion(rdfs:seeAlso goldbook:14016 goldbook:14010)
AnnotationAssertion(mito:isMentionedBy goldbook:14016 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14016 "current"^^xsd:string)
Declaration(Class(goldbook:14017))
AnnotationAssertion(rdfs:label goldbook:14017 "fundamental absorption edge")
AnnotationAssertion(dcterms:description goldbook:14017 "High wavelength limit of the fundamental absorption band in the spectrum of semiconductors and of insulators.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14017 "fundamental absorption threshold")
AnnotationAssertion(rdfs:seeAlso goldbook:14017 goldbook:14016)
AnnotationAssertion(mito:isMentionedBy goldbook:14017 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14017 "current"^^xsd:string)
Declaration(Class(goldbook:14018))
AnnotationAssertion(rdfs:label goldbook:14018 "heterogeneous photocatalysis")
AnnotationAssertion(dcterms:description goldbook:14018 "Photocatalysis taking place at the interfacial boundary between two phases (solid/liquid, solid/gas, liquid/gas).")
AnnotationAssertion(mito:isMentionedBy goldbook:14018 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14018 "current"^^xsd:string)
Declaration(Class(goldbook:14019))
AnnotationAssertion(rdfs:label goldbook:14019 "heterogeneous radiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14019 "Radiation catalysis taking place in heterogeneous systems.")
AnnotationAssertion(rdfs:seeAlso goldbook:14019 goldbook:14067)
AnnotationAssertion(mito:isMentionedBy goldbook:14019 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14019 "current"^^xsd:string)
Declaration(Class(goldbook:14020))
AnnotationAssertion(rdfs:label goldbook:14020 "homogeneous photocatalysis")
AnnotationAssertion(dcterms:description goldbook:14020 "Photocatalysis taking place in homogeneous systems.")
AnnotationAssertion(mito:isMentionedBy goldbook:14020 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14020 "current"^^xsd:string)
Declaration(Class(goldbook:14021))
AnnotationAssertion(rdfs:label goldbook:14021 "homogeneous radiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14021 "Radiation catalysis taking place in homogeneous systems.")
AnnotationAssertion(rdfs:seeAlso goldbook:14021 goldbook:14067)
AnnotationAssertion(mito:isMentionedBy goldbook:14021 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14021 "current"^^xsd:string)
Declaration(Class(goldbook:14022))
AnnotationAssertion(rdfs:label goldbook:14022 "indirect bandgap semiconductor")
AnnotationAssertion(dcterms:description goldbook:14022 "Semiconductor or dielectric materials with a first band-to-band transition from the highest level in the valence band to the lowest level in the conduction band requiring the change of electron momentum, that is \\(\\boldsymbol{p}_{\\rm{max}}  eq \\boldsymbol{p}_{\\rm{min}}\\), where \\(\\boldsymbol{p}_{\\rm{max}}\\) and \\(\\boldsymbol{p}_{\\rm{min}}\\) are the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively.")
AnnotationAssertion(rdfs:comment goldbook:14022 "Direct band-to-band electronic transitions between two bands of different momentum (e.g., \\(\\boldsymbol{p}_{\\rm{max}} \\neq \\boldsymbol{p}_{\\rm{min}}\\)) are forbidden because momentum must be conserved. Upon excitation, such changes occur owing to interaction of the electronic subsystem with the phonons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14022 goldbook:14005)
AnnotationAssertion(mito:isMentionedBy goldbook:14022 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14022 "current"^^xsd:string)
Declaration(Class(goldbook:14023))
AnnotationAssertion(rdfs:label goldbook:14023 "in-scattering")
AnnotationAssertion(dcterms:description goldbook:14023 "Physical phenomenon considering scattered radiative energy from rays in any direction \\(\\mathit{\\Omega}'\\) into the direction \\(\\mathit{\\Omega}\\) of the rays considered in the radiative transfer equation (RTE).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14023 "scattering in (into the beam under consideration)")
AnnotationAssertion(rdfs:comment goldbook:14023 "Mathematical definition: \\[{\\rm{Sc}}_{\\rm{in}} = \\frac{\\sigma_{\\lambda} (\\boldsymbol{x},t)}{4\\pi} \\int_{4\\pi} B_{\\lambda} (\\mathit{\\Omega}' \\rightarrow \\mathit{\\Omega}) L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\ {\\rm{d}}\\mathit{\\Omega}'\\] where \\(\\boldsymbol{x}\\) is the spatial coordinate in a three-dimensional space along the propagation of the beam, \\(t\\) is the time coordinate, \\(\\sigma_{\\lambda} (\\boldsymbol{x},t)\\) is the space- and time-dependent napierian linear scattering coefficient, \\(L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) is the incident time- and space-dependent radiance and \\(B_{\\lambda}\\) is the phase function, i.e., a distribution function acting as a source of photons from any direction \\(\\mathit{\\Omega}'\\) into the direction \\(\\mathit{\\Omega}\\) under consideration. SI unit is \\(\\pu{W sr-1 m-4}\\). Common unit is \\(\\pu{W sr-1 cm-3 nm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14023 "Mathematical expression in photon terms: \\[{\\rm{Sc}}_{\\rm{in}} = \\frac{\\sigma_{\\lambda}(\\boldsymbol{x},t)}{4\\pi} \\int_{4\\pi} B_{\\lambda} (\\mathit{\\Omega}' \\rightarrow \\mathit{\\Omega}) L_{\\rm{p},\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\ {\\rm{d}}\\mathit{\\Omega}'\\] with \\(L_{\\rm{p},\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) the incident spectral photon radiance. SI unit is \\(\\pu{s-1 sr-1 m-4}\\) in photon number basis and \\(\\pu{mol s-1 sr-1 m-4}\\) in chemical amount basis. Common unit is \\(\\pu{s-1 sr-1 cm-3 nm-1}\\) in photon number basis and \\(\\pu{einstein s-1 sr-1 cm-3 nm-1}\\) in chemical amount basis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14023 goldbook:14030)
AnnotationAssertion(rdfs:seeAlso goldbook:14023 goldbook:14077)
AnnotationAssertion(mito:isMentionedBy goldbook:14023 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14023 "current"^^xsd:string)
Declaration(Class(goldbook:14024))
AnnotationAssertion(rdfs:label goldbook:14024 "interparticle electron transfer")
AnnotationAssertion(dcterms:description goldbook:14024 "Electron transfer taking place from a photoexcited semiconductor onto another semiconductor (or insulator) in its ground state leading to vectorial (irreversible) charge transfer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14024 "IPET")
AnnotationAssertion(mito:isMentionedBy goldbook:14024 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14024 "current"^^xsd:string)
Declaration(Class(goldbook:14025))
AnnotationAssertion(rdfs:label goldbook:14025 "intrinsic emission")
AnnotationAssertion(dcterms:description goldbook:14025 "Band-to-band recombination of electrons and holes (or exciton decay) in a semiconductor or insulator leading to luminescence.")
AnnotationAssertion(mito:isMentionedBy goldbook:14025 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14025 "current"^^xsd:string)
Declaration(Class(goldbook:14026))
AnnotationAssertion(rdfs:label goldbook:14026 "intrinsic defects")
AnnotationAssertion(dcterms:description goldbook:14026 "Imperfections connected with surface point defects (zero-dimensional), linear defects (one-dimensional), or square defects (two-dimensional) not including extrinsic chemical units in relation to the chemical formula of the solid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14026 "intrinsic surface defects")
AnnotationAssertion(rdfs:comment goldbook:14026 "Surface vacancies, anionic vacancies (in n-type semiconductors), cationic vacancies (in p-type semiconductors), interstitial cations, edges, corners and kinks are some examples of intrinsic surface defects."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14026 goldbook:14011)
AnnotationAssertion(mito:isMentionedBy goldbook:14026 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14026 "current"^^xsd:string)
Declaration(Class(goldbook:14027))
AnnotationAssertion(rdfs:label goldbook:14027 "inversion layer")
AnnotationAssertion(dcterms:description goldbook:14027 "Layer formed when band bending places the Fermi level on the surface close to the band of the bulk minority charge carriers. This leads to a higher concentration of the minority charge carriers on the surface relative to the concentration of the majority charge carriers, an opposite situation to that in the bulk.")
AnnotationAssertion(rdfs:seeAlso goldbook:14027 goldbook:13989)
AnnotationAssertion(rdfs:seeAlso goldbook:14027 goldbook:14004)
AnnotationAssertion(mito:isMentionedBy goldbook:14027 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14027 "current"^^xsd:string)
Declaration(Class(goldbook:14028))
AnnotationAssertion(rdfs:label goldbook:14028 "local differential absorption")
AnnotationAssertion(dcterms:description goldbook:14028 "Absorption term in the radiative transfer equation (RTE). Mathematical expression is \\[\\alpha_{\\lambda} (\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x}/t)\\] with \\(\\alpha_{\\lambda} (\\boldsymbol{x},t)\\) the space- and time-dependent linear napierian absorption coefficient and \\(L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) the spectral radiance arriving at position \\(x\\) and time \\(t\\) from every possible angular directions \\(\\mathit{\\Omega}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:14028 goldbook:14077)
AnnotationAssertion(mito:isMentionedBy goldbook:14028 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14028 "current"^^xsd:string)
Declaration(Class(goldbook:14029))
AnnotationAssertion(rdfs:label goldbook:14029 "natural photosynthesis")
AnnotationAssertion(dcterms:description goldbook:14029 "Production of complex organic substances by higher plants, algae and photosynthesising bacteria from simple compounds (e.g., carbon dioxide and water, hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation energy absorbed by, e.g., chlorophyll, chlorophyll-protein complexes, and natural chromoproteins.")
AnnotationAssertion(rdfs:seeAlso goldbook:14029 goldbook:13993)
AnnotationAssertion(mito:isMentionedBy goldbook:14029 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14029 "current"^^xsd:string)
Declaration(Class(goldbook:14030))
AnnotationAssertion(rdfs:label goldbook:14030 "out-scattering")
AnnotationAssertion(dcterms:description goldbook:14030 "Physical process by which the incoming electromagnetic radiation is forced to deviate from a straight trajectory by non-uniformities in the medium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14030 "scattering out (out of the beam under consideration)")
AnnotationAssertion(rdfs:comment goldbook:14030 "Physical phenomenon taking into account scattered radiative energy from the rays in the direction \\(\\mathit{\\Omega}\\) considered in the radiative transfer equation (RTE) into any direction \\(\\mathit{\\Omega}'\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14030 "Mathematical definition: \\({\\rm{Sc}}_{\\rm{out}} = \\sigma_{\\lambda} (\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) where \\(\\boldsymbol{x}\\) is the coordinate in a three-dimensional space in the path of the beam, \\(t\\) is the time coordinate, \\(\\sigma_{\\lambda} (\\boldsymbol{x},t)\\) is the space- and time-dependent linear napierian scattering coefficient, \\(L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) is the incident space- and time-dependent radiance in the direction \\(\\mathit{\\Omega}\\). SI unit is \\(\\pu{W sr-1 m-4}\\). Common unit is \\(\\pu{W sr-1 cm-3 nm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14030 "The mathematical definition in photon terms is: \\({\\rm{Sc}}_{\\rm{out}} = \\sigma_{\\lambda} (\\boldsymbol{x},t) L_{\\rm{p},\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) with \\(L_{\\rm{p},\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) the incident space- and time-dependent photon radiance. SI unit is \\(\\pu{s-1 sr-1 m-4}\\) in photon number basis and \\(\\pu{mol s-1 sr-1 m-4}\\) in chemical amount basis. Common unit in photon number basis is \\(\\pu{s-1 sr-1 cm-3 nm-1}\\) and \\(\\pu{einstein s-1 sr-1 cm-3 nm-1}\\) in chemical amount basis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14030 goldbook:14023)
AnnotationAssertion(rdfs:seeAlso goldbook:14030 goldbook:14077)
AnnotationAssertion(mito:isMentionedBy goldbook:14030 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14030 "current"^^xsd:string)
Declaration(Class(goldbook:14031))
AnnotationAssertion(rdfs:label goldbook:14031 "phase function")
AnnotationAssertion(dcterms:description goldbook:14031 "Distribution function representing the fraction of photons scattered from any direction \\(\\mathit{\\Omega}'\\) into the direction \\(\\mathit{\\Omega}\\) under consideration in the radiative transfer equation (RTE). Dimension one.")
AnnotationAssertion(rdfs:seeAlso goldbook:14031 goldbook:14077)
AnnotationAssertion(mito:isMentionedBy goldbook:14031 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14031 "current"^^xsd:string)
Declaration(Class(goldbook:14032))
AnnotationAssertion(rdfs:label goldbook:14032 "photoadsorbate")
AnnotationAssertion(dcterms:description goldbook:14032 "Entity (molecule, atom, or ion) bound to the surface of a solid (semiconductor or insulator) particle (typically to a photoadsorption centre) as the result of photoexcitation of either the solid or the entity (molecule, atom, or ion).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14032 "photoadsorbed species")
AnnotationAssertion(rdfs:comment goldbook:14032 "When photoadsorption is a step in a photocatalytic reaction, the photoadsorbed entity may be considered an intermediate in the given reaction."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14032 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14032 "current"^^xsd:string)
Declaration(Class(goldbook:14033))
AnnotationAssertion(rdfs:label goldbook:14033 "photoadsorption area number")
AnnotationAssertion(dcterms:description goldbook:14033 "Maximum amount of substance photoadsorbed per area on the uniformly irradiated surface of an adsorbent.")
AnnotationAssertion(rdfs:comment goldbook:14033 "Photoadsorption area number should be preferred to photoadsorption capacity (the original name given to this term), since the latter term is reserved for the fractional number, referring to the number of regular sites available for photoadsorption."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14033 "Mathematical expression, \\(\\gamma^{\\rm{s}} = N_{\\rm{max}}/S\\), where \\(N_{\\rm{max}}\\) is the maximal number of entities or moles photoadsorbed and \\(S\\) the total surface area. Experimental values of \\(\\gamma^{\\rm{s}}\\) in entities are in the range \\(\\pu{E10 - E12 cm-2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14033 "The quantity \\(N_{\\rm{max}}\\) can be obtained by approximation from photoadsorption kinetics \\(N(t)\\) on a uniformly irradiated surface provided that(i) the powdered sample is uniformly irradiated. Then, the area of the irradiated surface is \\(S = m a^{\\rm{s}}\\), where \\(m\\) is the mass of the sample and \\(a^{\\rm{s}}\\) is the specific surface area (\\(\\pu{m2 kg-1}\\)) of a given adsorbent, or(ii) the efficiency of desorption of the adsorbed species (via a physical process) is negligible. Then the number of photocatalytic centres can be estimated from the photoadsorption area number, \\(\\gamma^{\\rm{s}}\\), to determine TON and TOF for a given photocatalytic reaction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14033 goldbook:14032)
AnnotationAssertion(rdfs:seeAlso goldbook:14033 goldbook:14034)
AnnotationAssertion(rdfs:seeAlso goldbook:14033 goldbook:14037)
AnnotationAssertion(mito:isMentionedBy goldbook:14033 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14033 "current"^^xsd:string)
Declaration(Class(goldbook:14034))
AnnotationAssertion(rdfs:label goldbook:14034 "photoadsorption capacity")
AnnotationAssertion(dcterms:description goldbook:14034 "Maximal number of entities (molecules, atoms, or ions) per regular surface site that can be photoadsorbed at a uniformly irradiated surface of an adsorbent, \\(\\theta_{\\rm{max}} = N_{\\rm{max}}/N^{\\rm{ss}}\\) where \\(N_{\\rm{max}}\\) is the maximal number of entities photoadsorbed and \\(N^{\\rm{ss}}\\) is the number of surface sites (mainly regular surface sites, i.e., regular lattice ions or atoms; typically, \\(N^{\\rm{ss}}\\) ca. \\(\\pu{E15 cm-2}\\)).")
AnnotationAssertion(rdfs:comment goldbook:14034 "\\(\\theta_{\\rm{max}}\\) is a quantity of dimension one (a fractional number). \\(\\theta_{\\rm{max}}\\) is about \\(\\pu{E-5 - E-3}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14034 "This term has been often called maximal photoadsorption capacity. This denomination is redundant, because capacity already refers to the maximal possible value of a property."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14034 goldbook:14006)
AnnotationAssertion(rdfs:seeAlso goldbook:14034 goldbook:14032)
AnnotationAssertion(rdfs:seeAlso goldbook:14034 goldbook:14037)
AnnotationAssertion(rdfs:seeAlso goldbook:14034 goldbook:14083)
AnnotationAssertion(rdfs:seeAlso goldbook:14034 goldbook:14101)
AnnotationAssertion(mito:isMentionedBy goldbook:14034 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14034 "current"^^xsd:string)
Declaration(Class(goldbook:14035))
AnnotationAssertion(rdfs:label goldbook:14035 "photoadsorption centre")
AnnotationAssertion(dcterms:description goldbook:14035 "Surface site or defect in its active state after photoexcitation capable of photoadsorbing species by a chemical interaction with the adsorbate entities (molecules, atoms, or ions).")
AnnotationAssertion(rdfs:seeAlso goldbook:14035 goldbook:13990)
AnnotationAssertion(mito:isMentionedBy goldbook:14035 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14035 "current"^^xsd:string)
Declaration(Class(goldbook:14036))
AnnotationAssertion(rdfs:label goldbook:14036 "photoadsorption efficiency")
AnnotationAssertion(dcterms:description goldbook:14036 "Ratio of the maximal (typically the initial) rate of photoadsorption of entities \\(\\ce{B}\\) (molecules, atoms, or ions) to the integrated incident (superscript 0, zero) photon flux, \\(\\int_{\\lambda_{1}}^{\\lambda_{2}} q_{\\rm{p},\\lambda}^{0}{\\rm{d}}\\lambda = q_{\\rm{p}}^{0} = {\\rm{d}}N_{\\rm{p}}^{0}/{\\rm{d}}t\\), in the wavelength range \\(\\lambda_{1}{-}\\lambda_{2}\\). Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects.")
AnnotationAssertion(rdfs:comment goldbook:14036 "Mathematical expression: \\[P_{\\rm{AE}} = \\frac{{\\rm{d}}N_{\\ce{B}}/{\\rm{d}}t}{\\int_{\\lambda_{1}}^{\\lambda_{2}} q_{\\rm{p},\\lambda}^{0}{\\rm{d}}\\lambda} \\ {\\rm{for}}\\ t \\to 0\\] where \\({\\rm{d}}N_{\\ce{B}}/{\\rm{d}}t\\) is the rate of adsorption of entities (the initial quasi-stationary rate of photoadsorption)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14036 "The initial rate of photoadsorption in SI units is \\({\\rm{d}}p/{\\rm{d}}t\\) (\\(\\pu{Pa s-1}\\)) for gas/solid systems, with \\(p\\) the pressure and in SI-coherent units \\({\\rm{d}}c/{\\rm{d}}t\\) (\\(\\pu{mol L-3 s-1}\\)) for liquid/solid systems, with \\(c\\) the amount concentration of the adsorbate in solution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14036 "For \\(P_{\\rm{AE}}\\) determined under first-order conditions on photon flux and zero-order on concentration (or pressure), it corresponds to the efficiency of formation of the active photoadsorption centre."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14036 goldbook:14035)
AnnotationAssertion(mito:isMentionedBy goldbook:14036 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14036 "current"^^xsd:string)
Declaration(Class(goldbook:14037))
AnnotationAssertion(rdfs:label goldbook:14037 "photoadsorption fraction")
AnnotationAssertion(dcterms:description goldbook:14037 "Number of entities (atoms, molecules or ions) photoadsorbed per regular surface site at a uniformly irradiated surface of an adsorbent.")
AnnotationAssertion(rdfs:comment goldbook:14037 "Mathematical expression: \\(\\theta_{\\rm{ph}} = N/N^{\\rm{ss}}\\) with \\(N\\) the number of entities photoadsorbed and \\(N^{\\rm{ss}}\\) the number of surface sites (mainly regular surface sites, i.e., regular lattice ions or atoms; typically, \\(N^{\\rm{ss}}\\) ca. \\(\\pu{E15 cm-2}\\)). \\(\\theta_{\\rm{ph}}\\) is a quantity of dimension one (it is a fractional number)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14037 "\\(\\theta_{\\rm{ph}}\\) has been called photoadsorption number; fraction is preferred. It should not be called capacity, since the term capacity should be reserved for the maximal adsorption number."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14037 "The photoadsorption fraction, \\(\\theta_{\\rm{ph}}\\), is smaller than the photoadsorption capacity, \\(\\theta_{\\rm{max}}\\) (i.e., \\(\\theta_{\\rm{ph}} \\lt \\theta_{\\rm{max}}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14037 goldbook:14032)
AnnotationAssertion(rdfs:seeAlso goldbook:14037 goldbook:14033)
AnnotationAssertion(rdfs:seeAlso goldbook:14037 goldbook:14034)
AnnotationAssertion(rdfs:seeAlso goldbook:14037 goldbook:14083)
AnnotationAssertion(mito:isMentionedBy goldbook:14037 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14037 "current"^^xsd:string)
Declaration(Class(goldbook:14038))
AnnotationAssertion(rdfs:label goldbook:14038 "photoadsorption photonic yield")
AnnotationAssertion(dcterms:description goldbook:14038 "Ratio of the maximal (typically the initial) rate of photoadsorption of entities \\(\\ce{B}\\) (molecules, atoms, or ions) on a surface to the incident (superscript 0, zero) photon flux, \\(q_{\\rm{p},\\lambda}^{0} = {\\rm{d}}N_{\\rm{p},\\lambda}^{0}/{\\rm{d}}t\\) at a given wavelength. Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects.")
AnnotationAssertion(rdfs:comment goldbook:14038 "Mathematical expression: \\(\\frac{{\\rm{d}}N_{\\ce{B}}/{\\rm{d}}t}{q_{\\rm{p},\\lambda}^{0}} \\ \\ {\\rm{for}}\\ t \\to 0\\)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14038 "Yield refers to the use of monochromatic irradiation, whereas efficiency is reserved for irradiation within a wavelength range. Photonic refers to incident radiation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14038 goldbook:14036)
AnnotationAssertion(rdfs:seeAlso goldbook:14038 goldbook:14039)
AnnotationAssertion(mito:isMentionedBy goldbook:14038 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14038 "current"^^xsd:string)
Declaration(Class(goldbook:14039))
AnnotationAssertion(rdfs:label goldbook:14039 "photoadsorption quantum yield")
AnnotationAssertion(dcterms:description goldbook:14039 "Ratio of the number of photoadsorbed entities \\(\\ce{B}\\) (molecules, atoms, or ions) on a surface to the number of photons of ultraviolet, visible, or infrared radiation (at a given wavelength \\(\\lambda\\)) absorbed by the system (typically by the adsorbent) during the initial stage of irradiation.")
AnnotationAssertion(rdfs:comment goldbook:14039 "Mathematical expression: \\(\\mathit{\\Phi}_{\\rm{ads}} = \\frac{{\\rm{d}}N_{\\ce{B}}/{\\rm{d}}t}{{\\rm{d}}N_{\\rm{p},\\lambda}/{\\rm{d}}t}\\), for \\(t \\to 0\\), i.e., the ratio of the initial rates of photoadsorption and monochromatic photons absorbed, with \\(N_{\\ce{B}}\\) the number of entities adsorbed and \\(N_{\\rm{p},\\lambda}\\) the number of photons of wavelength \\(\\lambda\\) absorbed. The photoadsorption quantum yield has been called \\(K_{\\rm{a}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14039 goldbook:14032)
AnnotationAssertion(rdfs:seeAlso goldbook:14039 goldbook:14036)
AnnotationAssertion(rdfs:seeAlso goldbook:14039 goldbook:14038)
AnnotationAssertion(mito:isMentionedBy goldbook:14039 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14039 "current"^^xsd:string)
Declaration(Class(goldbook:14040))
AnnotationAssertion(rdfs:label goldbook:14040 "photocarrier")
AnnotationAssertion(dcterms:description goldbook:14040 "Nonequilibrium free electron or free hole generated in a solid by ultraviolet, visible, or infrared absorption and occupying energy levels in the conduction band or the valence band, respectively.")
AnnotationAssertion(rdfs:comment goldbook:14040 "Electrons occupying energy levels near the bottom of the conduction band and holes occupying energy levels near the top of the valence band (thermalised carriers) are considered as quasi-chemical intermediates. Nonthermalised (hot) carriers can also be involved in photocatalysed reactions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14040 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14040 "current"^^xsd:string)
Declaration(Class(goldbook:14041))
AnnotationAssertion(rdfs:label goldbook:14041 "photocatalytic active centre")
AnnotationAssertion(dcterms:description goldbook:14041 "Surface centre, i.e., either a surface defect or a regular surface site, at which a chemical transformation takes place after converting the centre into an active state by a photophysical process, e.g., by photoexcitation.")
AnnotationAssertion(rdfs:comment goldbook:14041 "The number of photoactive centres is very often difficult to establish, particularly on solid surfaces and in suspended particles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14041 "When the density of the active centres is unknown, the reaction rates may be related to the \\(\\rm{BET}(\\ce{N2})\\) area with the understanding that the parameter or property of the system will be a lower limit of the actual value, because the surface determined by \\(\\ce{N2}\\) adsorption will be larger than that reached by the radiation. See Note 2 under the definition of Brunauer–Emmett–Teller (BET) surface area."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14041 "The photophysical process may include one or several processes such as direct excitation of the photocatalytic centre via absorption of ultraviolet, visible, or infrared radiation, via photocarrier trapping, via interaction with excitons, or via energy and/or electron transfer from a photoexcited reagent or intermediate."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14041 goldbook:13997)
AnnotationAssertion(rdfs:seeAlso goldbook:14041 goldbook:13999)
AnnotationAssertion(rdfs:seeAlso goldbook:14041 goldbook:14040)
AnnotationAssertion(mito:isMentionedBy goldbook:14041 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14041 "current"^^xsd:string)
Declaration(Class(goldbook:14042))
AnnotationAssertion(rdfs:label goldbook:14042 "photocatalytic activity")
AnnotationAssertion(dcterms:description goldbook:14042 "Number of entities (product) formed in a photocatalytic process (alternatively the number of reactant entities disappearing) divided by the number of photons absorbed by the photocatalyst at one single wavelength or within a defined wavelength range. For one wavelength it has the same meaning as quantum yield, whereas within a defined wavelength range it has the same meaning as quantum efficiency.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14042 "PCA")
AnnotationAssertion(rdfs:comment goldbook:14042 "This quantity has a well-defined meaning only when the reaction conditions are also stated and the results reported in terms of the initial conditions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14042 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14042 "current"^^xsd:string)
Declaration(Class(goldbook:14043))
AnnotationAssertion(rdfs:label goldbook:14043 "photocatalytic centre")
AnnotationAssertion(dcterms:description goldbook:14043 "Surface centre, i.e., a surface defect or a regular surface site, in an active or electronically excited state at which a chemical transformation takes place.")
AnnotationAssertion(rdfs:seeAlso goldbook:14043 goldbook:13999)
AnnotationAssertion(rdfs:seeAlso goldbook:14043 goldbook:14041)
AnnotationAssertion(mito:isMentionedBy goldbook:14043 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14043 "current"^^xsd:string)
Declaration(Class(goldbook:14044))
AnnotationAssertion(rdfs:label goldbook:14044 "photocatalytic efficiency")
AnnotationAssertion(dcterms:description goldbook:14044 "Number of entities (product) formed (alternatively the number of reactant entities disappearing) divided by the number of ultraviolet, visible, or infrared photons incident (prior to absorption) on the system and in a wavelength range \\(\\lambda_{1}{-}\\lambda_{2}\\).")
AnnotationAssertion(rdfs:comment goldbook:14044 "Quantity relevant in applications of photocatalysis where the interest is to assess an engineering efficiency of energy out vs. energy in. In this context, the quantity has a well-defined meaning only when the operating conditions are also stated and results reported in terms of the initial conditions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14044 "When using photon flux (number basis or chemical amount basis) the term photonic efficiency is preferred, as efficiency refers to excitation within a wavelength range, whereas for monochromatic irradiation (and incident photons) the term photonic yield should be used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14044 goldbook:14057)
AnnotationAssertion(rdfs:seeAlso goldbook:14044 goldbook:14058)
AnnotationAssertion(mito:isMentionedBy goldbook:14044 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14044 "current"^^xsd:string)
Declaration(Class(goldbook:14045))
AnnotationAssertion(rdfs:label goldbook:14045 "photocatalytic oxidation")
AnnotationAssertion(dcterms:description goldbook:14045 "Commonly used to describe the oxidation of pollutants by the action of ultraviolet, visible, or infrared radiation and a catalyst.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14045 "PCO")
AnnotationAssertion(rdfs:comment goldbook:14045 "Often used to describe the oxidation of organic pollutants at low concentrations by UV-light irradiation of \\(\\ce{TiO2}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14045 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14045 "current"^^xsd:string)
Declaration(Class(goldbook:14046))
AnnotationAssertion(rdfs:label goldbook:14046 "photocorrosion")
AnnotationAssertion(dcterms:description goldbook:14046 "Decomposition of the photocatalyst or of the electrodes as a result of a photoinduced reaction.")
AnnotationAssertion(rdfs:comment goldbook:14046 "Photocorrosion is one of the factors limiting the turnover number in heterogeneous photocatalysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14046 "Process taking place during photoelectrochemical etching."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14046 goldbook:14018)
AnnotationAssertion(rdfs:seeAlso goldbook:14046 goldbook:14101)
AnnotationAssertion(mito:isMentionedBy goldbook:14046 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14046 "current"^^xsd:string)
Declaration(Class(goldbook:14047))
AnnotationAssertion(rdfs:label goldbook:14047 "photocurrent")
AnnotationAssertion(dcterms:description goldbook:14047 "Photogeneration and movement of charge between two electrodes in a photovoltaic cell or a photoelectrochemical cell as a result of photoprocesses induced by light absorption.")
AnnotationAssertion(mito:isMentionedBy goldbook:14047 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14047 "current"^^xsd:string)
Declaration(Class(goldbook:14048))
AnnotationAssertion(rdfs:label goldbook:14048 "photodesorption")
AnnotationAssertion(dcterms:description goldbook:14048 "Desorption induced by the absorption of ultraviolet, visible, or infrared radiation either by the adsorbate or by the adsorbent.")
AnnotationAssertion(rdfs:comment goldbook:14048 "Photodesorption can be a step in the overall mechanism in heterogeneous photocatalysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14048 "Photodesorption is the inverse process of photoadsorption. For a particular system, both processes (or reactions) are induced by ultraviolet, visible, or infrared radiation of the same wavelength region."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14048 goldbook:14006)
AnnotationAssertion(rdfs:seeAlso goldbook:14048 goldbook:14018)
AnnotationAssertion(mito:isMentionedBy goldbook:14048 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14048 "current"^^xsd:string)
Declaration(Class(goldbook:14049))
AnnotationAssertion(rdfs:label goldbook:14049 "photodesorption quantum yield")
AnnotationAssertion(dcterms:description goldbook:14049 "Number of entities evolving into the medium from a surface divided by the number of photons absorbed at a given wavelength by a solid or by an adsorbed entity treated as a surface extrinsic defect (centre).")
AnnotationAssertion(rdfs:comment goldbook:14049 "Mathematical expression of the integral photodesorption quantum yield: \\[\\mathit{\\Phi}_{\\rm{des}} = \\frac{N_{\\rm{des}}}{N_{\\rm{p},\\lambda}}\\] where \\(N_{\\rm{des}}\\) is the number of species desorbed and \\(N_{\\rm{p},\\lambda}\\) the number of photons of a particular wavelength absorbed during a given irradiation time."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14049 "The differential expression is: \\[\\mathit{\\Phi}_{\\rm{des}} = \\frac{{\\rm{d}}N_{\\rm{des}}/{\\rm{d}}t}{q_{\\rm{p},\\lambda}}\\] where \\({\\rm{d}}N_{\\rm{des}}/{\\rm{d}}t\\) is the initial (quasistationary) or maximal photodesorption rate and \\(q_{\\rm{p},\\lambda} = {\\rm{d}}N_{\\rm{p},\\lambda}/{\\rm{d}}t\\) is the spectral photon flux absorbed by a solid or by an adsorbed entity treated as a surface extrinsic defect (centre)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14049 "Should photoexcitation of a system be due to absorption by pre-adsorbed species (see extrinsic absorption), \\(\\phi_{\\rm{des}}\\) would not depend on the concentration of pre-adsorbed species."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14049 "In practice, for polychromatic irradiation, integration is performed in the wavelength range used and the quantity should be called photodesorption quantum efficiency."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14049 goldbook:14010)
AnnotationAssertion(rdfs:seeAlso goldbook:14049 goldbook:14011)
AnnotationAssertion(rdfs:seeAlso goldbook:14049 goldbook:14048)
AnnotationAssertion(mito:isMentionedBy goldbook:14049 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14049 "current"^^xsd:string)
Declaration(Class(goldbook:14050))
AnnotationAssertion(rdfs:label goldbook:14050 "photoelectrocatalysis")
AnnotationAssertion(dcterms:description goldbook:14050 "Electrochemically assisted photocatalysis. The role of the photocatalyst is played by a photoelectrode, often a semiconductor.")
AnnotationAssertion(rdfs:comment goldbook:14050 "In photoelectrocatalytic transformations it is possible to identify an electrode and an electrolyte combination in the system along with an explicit, generally macroscopic, electrical circuit for the charge transfer and/or for applying an additional electric potential to the system. This is not so in photocatalysis by colloids or fine dispersions of semiconductors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14050 goldbook:14051)
AnnotationAssertion(mito:isMentionedBy goldbook:14050 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14050 "current"^^xsd:string)
Declaration(Class(goldbook:14051))
AnnotationAssertion(rdfs:label goldbook:14051 "photoelectrode")
AnnotationAssertion(dcterms:description goldbook:14051 "Electrode capable of initiating electrochemical transformations after absorbing ultraviolet, visible, or infrared radiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14051 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14051 "current"^^xsd:string)
Declaration(Class(goldbook:14052))
AnnotationAssertion(rdfs:label goldbook:14052 "photoelectrosynthesis")
AnnotationAssertion(dcterms:description goldbook:14052 "Process by which ultraviolet, visible, or infrared radiation is absorbed by a semiconductor, electron transfer occurs at the interface between the semiconductor and a liquid and the output is chemical energy, i.e., radiant energy is stored as chemical energy.")
AnnotationAssertion(mito:isMentionedBy goldbook:14052 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14052 "current"^^xsd:string)
Declaration(Class(goldbook:14053))
AnnotationAssertion(rdfs:label goldbook:14053 "photogenerated catalysis")
AnnotationAssertion(dcterms:description goldbook:14053 "Initiation of chemical transformations through the photochemical formation of molecular species, which (once formed) are catalytically active even without the action of ultraviolet, visible, or infrared radiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14053 goldbook:13999)
AnnotationAssertion(mito:isMentionedBy goldbook:14053 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14053 "current"^^xsd:string)
Declaration(Class(goldbook:14054))
AnnotationAssertion(rdfs:label goldbook:14054 "photogenerated charge carrier")
AnnotationAssertion(dcterms:description goldbook:14054 "Charge carrying entity, especially an electron or a hole, in a semiconductor, produced by the absorption of ultraviolet, visible, or infrared radiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14054 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14054 "current"^^xsd:string)
Declaration(Class(goldbook:14055))
AnnotationAssertion(rdfs:label goldbook:14055 "photoinitiator")
AnnotationAssertion(dcterms:description goldbook:14055 "Agent initiating certain chemical transformations under the action of ultraviolet, visible, or infrared radiation and consumed therewith.")
AnnotationAssertion(rdfs:comment goldbook:14055 "A photocatalyst can also act as a photoinitiator that, however, will not be consumed."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14055 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14055 "current"^^xsd:string)
Declaration(Class(goldbook:14056))
AnnotationAssertion(rdfs:label goldbook:14056 "photomineralisation")
AnnotationAssertion(dcterms:description goldbook:14056 "Complete photodegradation of an organic compound into carbon dioxide and water, and other simple inorganic compounds (depending on the hetero-atom in the compound) upon absorption of ultraviolet, visible, or infrared radiation by the photocatalyst or by the adsorbate.")
AnnotationAssertion(mito:isMentionedBy goldbook:14056 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14056 "current"^^xsd:string)
Declaration(Class(goldbook:14057))
AnnotationAssertion(rdfs:label goldbook:14057 "photonic efficiency")
AnnotationAssertion(dcterms:description goldbook:14057 "Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons within a defined wavelength interval inside the irradiation window of the reactor.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14057 "FQE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14057 "formal quantum efficiency")
AnnotationAssertion(rdfs:comment goldbook:14057 "A quantity called formal quantum efficiency (FQE) is sometimes used as synonymous for photonic efficiency and calculated from the known spectral distribution of the excitation source and the known absorption spectrum of the reaction system. It is calculated as the ratio between the rate of reaction and the incident photon flux."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14057 "When monochromatic radiation is used, formal quantum efficiency is \\(\\xi\\); otherwise formal quantum efficiency \\(\\neq \\xi\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14057 "Mathematical definition: \\[\\xi = \\frac{{\\rm{d}}n/{\\rm{d}}t}{\\int_{\\lambda_{1}}^{\\lambda_{2}} q_{n,\\rm{p},\\lambda}^{0}{\\rm{d}}\\lambda}\\] when using the incident spectral photon flux, chemical amount basis, \\(q_{n,\\rm{p},\\lambda}^{0}\\) with \\(n\\) (mol) the amount of substance produced or consumed, and \\[\\xi = \\frac{{\\rm{d}}N/{\\rm{d}}t}{\\int_{\\lambda_{1}}^{\\lambda_{2}} q_{\\rm{p},\\lambda}^{0} {\\rm{d}}\\lambda}\\] when using the incident spectral photon flux, number basis, \\(q_{\\rm{p},\\lambda}^{0}\\) with \\(N\\) the number of entities produced or consumed. The superscript 0 (zero) emphasises the fact that the incident number of photons (prior to absorption) is used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14057 goldbook:14044)
AnnotationAssertion(rdfs:seeAlso goldbook:14057 goldbook:14058)
AnnotationAssertion(rdfs:seeAlso goldbook:14057 goldbook:14084)
AnnotationAssertion(mito:isMentionedBy goldbook:14057 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14057 "current"^^xsd:string)
Declaration(Class(goldbook:14058))
AnnotationAssertion(rdfs:label goldbook:14058 "photonic yield")
AnnotationAssertion(dcterms:description goldbook:14058 "Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons of monochromatic light inside the irradiation window of the reactor.")
AnnotationAssertion(rdfs:comment goldbook:14058 "Mathematical definition: \\[\\frac{{\\rm{d}}n/{\\rm{d}}t}{q_{n,\\rm{p},\\lambda}^{0}}\\] when using the incident spectral photon flux, chemical amount basis, \\(q_{n,\\rm{p},\\lambda}^{0}\\), with \\(n\\) (mol) the amount of substance produced or consumed, and \\[\\frac{{\\rm{d}}N/{\\rm{d}}t}{q_{\\rm{p},\\lambda}^{0}}\\] when using the incident spectral photon flux, number basis, \\(q_{\\rm{p},\\lambda}^{0}\\), with \\(N\\) the number of entities produced or consumed. The superscript 0 (zero) emphasises the fact that the incident number of photons (prior to absorption) is used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14058 goldbook:14057)
AnnotationAssertion(mito:isMentionedBy goldbook:14058 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14058 "current"^^xsd:string)
Declaration(Class(goldbook:14059))
AnnotationAssertion(rdfs:label goldbook:14059 "photonic yield spectrum")
AnnotationAssertion(dcterms:description goldbook:14059 "Plot of the photonic yield of a given photoprocess, measured at the same photon flux of incident (prior to absorption) light, as a function of a measure of the energy of the photons, i.e., for monochromatic irradiation.")
AnnotationAssertion(rdfs:comment goldbook:14059 "In practice, the photonic yield spectrum is obtained by normalising the rate of the given process to a certain number of incident photons provided that the photoresponse is linear on the incident photon fluence."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14059 "Should the fluence dependence of the photoresponse be nonlinear (as is often the case in catalysed photoresponses), a plot of the photoresponse vs. fluence should be made at several wavelengths and a standard response should be chosen (e.g., two-lg reduction). A plot of the inverse of the \"standard response\" level as a function of wavelength is then the action spectrum of the photoresponse."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14059 "Note that in photocatalysis the term yield is reserved for monochromatic irradiation, whereas the term efficiency is used for irradiation within a wavelength range. This is different from the use of efficiency as defined by IUPAC in photochemistry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14059 goldbook:14058)
AnnotationAssertion(mito:isMentionedBy goldbook:14059 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14059 "current"^^xsd:string)
Declaration(Class(goldbook:14060))
AnnotationAssertion(rdfs:label goldbook:14060 "photoradiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14060 "Radiation catalysis under conditions not allowing a distinction between the effect of ultraviolet, visible, or infrared and of ionising radiation as well as the case in which the ionising radiation alone generates emission of chemically active light (e.g., the 'Cherenkov' light emission).")
AnnotationAssertion(rdfs:seeAlso goldbook:14060 goldbook:14067)
AnnotationAssertion(mito:isMentionedBy goldbook:14060 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14060 "current"^^xsd:string)
Declaration(Class(goldbook:14061))
AnnotationAssertion(rdfs:label goldbook:14061 "photosensitised reaction")
AnnotationAssertion(dcterms:description goldbook:14061 "Reaction initiated by photosensitisation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14061 goldbook:14000)
AnnotationAssertion(mito:isMentionedBy goldbook:14061 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14061 "current"^^xsd:string)
Declaration(Class(goldbook:14062))
AnnotationAssertion(rdfs:label goldbook:14062 "photothermocatalysis")
AnnotationAssertion(dcterms:description goldbook:14062 "Catalysis occurring by the combined action of electronic excitation due to absorption of ultraviolet or visible radiation and thermal energy (infrared radiation or exothermic reactions) including catalytic phenomena.")
AnnotationAssertion(rdfs:comment goldbook:14062 "This often occurs upon exposure of a heterogeneous photocatalyst to infrared-light, laser emission, or solar radiation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14062 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14062 "current"^^xsd:string)
Declaration(Class(goldbook:14063))
AnnotationAssertion(rdfs:label goldbook:14063 "physical pathway")
AnnotationAssertion(dcterms:description goldbook:14063 "Set of physical processes leading to the relaxation of the electronically excited system without chemical transformations.")
AnnotationAssertion(rdfs:comment goldbook:14063 "Examples are radiative and nonradiative relaxations in molecules and surface complexes from the excited state to the ground state, recombination and trapping of free charge carriers and recombination decay of trapped carriers (particularly, recombination decay of carriers trapped by surface-active centres)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14063 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14063 "current"^^xsd:string)
Declaration(Class(goldbook:14064))
AnnotationAssertion(rdfs:label goldbook:14064 "radiant dose")
AnnotationAssertion(dcterms:description goldbook:14064 "Radiant energy (\\(Q\\), SI unit is \\(\\pu{J}\\)) or amount of photons (in \\(\\pu{mol}\\) or the non-SI unit einstein) absorbed per area or volume by an object irradiated during a given exposure time.")
AnnotationAssertion(mito:isMentionedBy goldbook:14064 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14064 "current"^^xsd:string)
Declaration(Class(goldbook:14065))
AnnotationAssertion(rdfs:label goldbook:14065 "radiation-activation")
AnnotationAssertion(dcterms:description goldbook:14065 "Increasing of catalytic activity or alteration of selectivity of a substance after its exposure to high-energy radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14065 "radioactivation")
AnnotationAssertion(rdfs:seeAlso goldbook:14065 goldbook:13999)
AnnotationAssertion(mito:isMentionedBy goldbook:14065 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14065 "current"^^xsd:string)
Declaration(Class(goldbook:14066))
AnnotationAssertion(rdfs:label goldbook:14066 "radiation adsorption")
AnnotationAssertion(dcterms:description goldbook:14066 "The word combination may be misleading. Usually radiation is absorbed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14066 "radiation-induced adsorption")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14066 "radioadsorption")
AnnotationAssertion(mito:isMentionedBy goldbook:14066 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14066 "current"^^xsd:string)
Declaration(Class(goldbook:14067))
AnnotationAssertion(rdfs:label goldbook:14067 "radiation catalysis")
AnnotationAssertion(dcterms:description goldbook:14067 "Change in the rate of a chemical reaction under the action of ionising radiation in the presence of a radiation catalyst.")
AnnotationAssertion(rdfs:comment goldbook:14067 "When using ionising radiation, from vacuum ultraviolet to higher energy, the phenomenon of photocatalysis cannot be distinguished from the phenomenon of radiation catalysis. Due to the nonselective absorption of ionising radiation, excitation of all reaction partners (both the reactants and the reaction catalysts) is possible. Thus, the phenomena globally designated as radiation catalysis include both direct radiation-induced and catalysed processes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14067 goldbook:14068)
AnnotationAssertion(mito:isMentionedBy goldbook:14067 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14067 "current"^^xsd:string)
Declaration(Class(goldbook:14068))
AnnotationAssertion(rdfs:label goldbook:14068 "radiation catalyst")
AnnotationAssertion(dcterms:description goldbook:14068 "Substance absorbing ionising radiation and able to produce chemical transformations of the reaction partners, repeatedly producing intermediate transformations and regenerating its chemical composition after each cycle of such interactions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14068 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14068 "current"^^xsd:string)
Declaration(Class(goldbook:14069))
AnnotationAssertion(rdfs:label goldbook:14069 "radiation-chemical yield")
AnnotationAssertion(dcterms:description goldbook:14069 "Number of entities of a product formed (alternatively, the number of entities of a reactant disappearing) generated per \\(\\pu{100 eV}\\) of energy absorbed from ionising radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14069 "G value")
AnnotationAssertion(rdfs:comment goldbook:14069 "Mathematical expression: \\(G = 100 (N_{\\ce{B}}/Q)\\) where \\(N_{\\ce{B}}\\) is the number of entities \\(\\ce{B}\\) formed (or disappeared) and \\(Q\\) is the absorbed radiation energy in \\(\\pu{eV}\\). Unit is \\(\\pu{(100 eV)-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14069 "In SI units it refers to the amount of substance in \\(\\pu{\\upmu mol}\\) generated for each joule of radiation absorbed by the system. SI unit is \\(\\pu{\\upmu mol J-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14069 "It is convenient to use the amount of substance  \\(\\ce{B}\\) in \\(\\pu{E-7 mol}\\) of \\(\\ce{B}\\), generated for each joule of radiation absorbed on the system. By choosing this (submultiple of) SI coherent unit, a number almost identical to the \\(G\\) value (within \\(\\pu{4\\%}\\)) in the obsolete unit \\(\\pu{(100 eV)-1}\\) is obtained, as \\(\\pu{(100 eV)-1} = \\pu{1.036E-7 mol J-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14069 "When the energy absorbed by the radiation catalyst cannot be calculated (as is often the case in radiation catalysis), the radiation chemical yield is calculated in terms of the energy absorbed by the system. In this case, it is an apparent yield."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14069 goldbook:14007)
AnnotationAssertion(rdfs:seeAlso goldbook:14069 goldbook:14068)
AnnotationAssertion(mito:isMentionedBy goldbook:14069 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14069 "current"^^xsd:string)
Declaration(Class(goldbook:14070))
AnnotationAssertion(rdfs:label goldbook:14070 "radiation desorption")
AnnotationAssertion(dcterms:description goldbook:14070 "Desorption from solid or liquid interfaces induced by absorption of radiation by the solid or liquid adsorbent.")
AnnotationAssertion(mito:isMentionedBy goldbook:14070 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14070 "current"^^xsd:string)
Declaration(Class(goldbook:14071))
AnnotationAssertion(rdfs:label goldbook:14071 "radiation-generated catalysis")
AnnotationAssertion(dcterms:description goldbook:14071 "Initiation of chemical transformations through the formation, by absorption of high-energy radiation, of substances that are catalytically active even in the absence of the radiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14071 goldbook:14067)
AnnotationAssertion(mito:isMentionedBy goldbook:14071 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14071 "current"^^xsd:string)
Declaration(Class(goldbook:14072))
AnnotationAssertion(rdfs:label goldbook:14072 "radiation-induced adsorption")
AnnotationAssertion(dcterms:description goldbook:14072 "Adsorption of a molecular entity at solid or liquid interfaces induced by absorption of high-energy radiation by the solid or the liquid adsorbent.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14072 "radiation adsorption")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14072 "radioadsorption")
AnnotationAssertion(rdfs:comment goldbook:14072 "The word combination radiation adsorption is misleading. Usually, radiation is absorbed."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14072 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14072 "current"^^xsd:string)
Declaration(Class(goldbook:14073))
AnnotationAssertion(rdfs:label goldbook:14073 "radiation sensitisation")
AnnotationAssertion(dcterms:description goldbook:14073 "Chemical change or physical process occurring in one entity (e.g., biological molecules, cells, and living organisms) as a result of initial absorption of high-energy radiation by the medium in the presence of another entity called the radiation sensitiser.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14073 "radiosensitisation")
AnnotationAssertion(rdfs:comment goldbook:14073 "High-energy radiation is absorbed usually nonspecifically in the medium (e.g., solvent) and all chemical reactions arise from the products of this primary energy absorption."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14073 goldbook:14074)
AnnotationAssertion(mito:isMentionedBy goldbook:14073 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14073 "current"^^xsd:string)
Declaration(Class(goldbook:14074))
AnnotationAssertion(rdfs:label goldbook:14074 "radiation sensitiser")
AnnotationAssertion(dcterms:description goldbook:14074 "Chemical substance that increases the radiation sensitivity of, in particular, biological molecules, cells and biological organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14074 "radiosensitiser")
AnnotationAssertion(rdfs:seeAlso goldbook:14074 goldbook:14073)
AnnotationAssertion(mito:isMentionedBy goldbook:14074 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14074 "current"^^xsd:string)
Declaration(Class(goldbook:14075))
AnnotationAssertion(rdfs:label goldbook:14075 "radiation-stimulated diffusion")
AnnotationAssertion(dcterms:description goldbook:14075 "Increase of diffusion of an adsorbate under the action of ionising radiation absorbed by either the adsorbent and/or the adsorbate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14075 "radiostimulated diffusion")
AnnotationAssertion(mito:isMentionedBy goldbook:14075 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14075 "current"^^xsd:string)
Declaration(Class(goldbook:14076))
AnnotationAssertion(rdfs:label goldbook:14076 "radiation thermal catalysis")
AnnotationAssertion(dcterms:description goldbook:14076 "Radiation catalysis under the action of large radiation fluxes that simultaneously heat the system as a consequence of absorption of energy from radiationless deactivation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14076 "radiothermal catalysis")
AnnotationAssertion(mito:isMentionedBy goldbook:14076 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14076 "current"^^xsd:string)
Declaration(Class(goldbook:14077))
AnnotationAssertion(rdfs:label goldbook:14077 "radiative transfer equation")
AnnotationAssertion(dcterms:description goldbook:14077 "When a photon beam of radiance \\(L_{\\lambda}\\) and angular distribution \\(\\mathit{\\Omega}\\) passes along a single direction of propagation through a medium, which is totally absorbing and/or scattering, i.e., the processes occurring are described by the following equation: \\[\\begin{array} \\\\ \\frac{{\\rm{d}}L_{\\Omega,\\lambda}(\\boldsymbol{x},t)}{{\\rm{d}}s} + \\underbrace{\\alpha_{\\lambda}(\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t)}_{\\rm{adsorption}} + \\underbrace{\\sigma_{\\lambda}(\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t)}_{\\rm{out\\mbox{-}scattering}} = \\\\ \\underbrace{j_{\\lambda}(\\boldsymbol{x},t)}_{\\rm{emission}} + \\underbrace{\\frac{\\sigma_{\\lambda}(\\boldsymbol{x},t)}{4\\pi}B_{\\lambda}(\\mathit{\\Omega}' \\to \\mathit{\\Omega}) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t){\\rm{d}}\\mathit{\\Omega}'}_{\\rm{in\\mbox{-}scattering}} \\end{array}\\] where \\(\\frac{{\\rm{d}}L_{\\Omega,\\lambda}(\\boldsymbol{x},t)}{{\\rm{d}}s}\\) is the directional derivative along the direction \\(s\\) at a point \\(\\boldsymbol{x}\\) in the reaction space of the incident radiance, \\(\\alpha_{\\lambda}(\\boldsymbol{x},t)\\) is the space- and time-dependent spectral linear napierian absorption coefficient, \\(\\sigma_{\\lambda}(\\boldsymbol{x},t)\\) is the space- and time-dependent spectral linear napierian scattering coefficient, \\(j_{\\lambda}(\\boldsymbol{x},t)\\) represents the spontaneous and/or induced emission, and \\(B_{\\lambda}\\) is the phase function. All quantities are a function of time. The RTE is written for the direction \\(s\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14077 "RTE")
AnnotationAssertion(rdfs:comment goldbook:14077 "Absorption and out-scattering reduce the radiance along the axis of propagation, whereas in-scattering and emission, increases it. Normally, emission can be safely neglected in photocatalysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14077 "The RTE is a representation of the (radiation) energy conservation law and its solution in cases with complex geometry and in the presence of scattering remains a challenging issue."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14077 "Back scattering and forward scattering are global effects derived from the integration of absorption, in-scattering, out-scattering, and emission."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14077 goldbook:14023)
AnnotationAssertion(rdfs:seeAlso goldbook:14077 goldbook:14028)
AnnotationAssertion(rdfs:seeAlso goldbook:14077 goldbook:14030)
AnnotationAssertion(rdfs:seeAlso goldbook:14077 goldbook:14031)
AnnotationAssertion(mito:isMentionedBy goldbook:14077 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14077 "current"^^xsd:string)
Declaration(Class(goldbook:14078))
AnnotationAssertion(rdfs:label goldbook:14078 "rate of generation")
AnnotationAssertion(dcterms:description goldbook:14078 "Number of carriers (or electron-hole pairs, or excitons) produced per time interval and per volume of a solid photocatalyst particle due to the absorption of light.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14078 "rate of photogeneration")
AnnotationAssertion(rdfs:comment goldbook:14078 "The rate of photogeneration in the bulk of optical uniform photocatalyst particles depends on the distance (\\(x\\)) from the irradiated surface."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14078 "The rate of photogeneration of carriers, \\(g(x)\\), has the general mathematical expression: \\[g(x) = \\alpha(\\lambda)\\ E_{\\rm{p},\\lambda}^{0}\\ (1 - \\rho) \\exp[-\\alpha(\\lambda)x]\\] where \\(\\alpha(\\lambda)\\) is the napierian (spectral) absorption coefficient, \\(E_{\\rm{p},\\lambda}^{0}\\) is the incident (superscript 0) spectral photon irradiance and \\(\\rho\\) the reflectance. SI unit of \\(g(x)\\) is \\(\\pu{m-3 s-1}\\) for \\(q_{n,\\rm{p},\\lambda}^{0}\\) in photon number basis and \\(\\pu{mol m-3 s-1}\\) for \\(q_{\\rm{p},\\lambda}^{0}\\) in chemical amount basis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14078 "\\(g(x)\\) is related to the number of photogenerated electrons (\\(N_{\\rm{e}}\\)) and holes (\\(N_{\\rm{h}}\\)) as \\(N_{\\rm{e}} = g(x) \\tau_{\\rm{e}}\\) and \\(N_{\\rm{h}} = g(x) \\tau_{\\rm{h}}\\), where \\(\\tau_{\\rm{e}}\\) and \\(\\tau_{\\rm{h}}\\) are the lifetimes of the free electrons and holes, respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14078 "In kinetic studies of photocatalysed reactions, the rate of generation is typically considered as a constant \\(g = \\alpha(\\lambda)\\ E_{\\rm{p}, \\lambda}^{0}\\) (uniform generation), which corresponds to the so-called weak light absorption case [\\(\\alpha(\\lambda) x \\ll 1\\)]."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14078 goldbook:14094)
AnnotationAssertion(mito:isMentionedBy goldbook:14078 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14078 "current"^^xsd:string)
Declaration(Class(goldbook:14079))
AnnotationAssertion(rdfs:label goldbook:14079 "rate of surface recombination")
AnnotationAssertion(dcterms:description goldbook:14079 "Decay of carriers at the surface of a solid or interface between different phases, e.g., at the crystal surface.")
AnnotationAssertion(rdfs:comment goldbook:14079 "Inverse of the lifetime of free carriers in the bulk of the particle. The greater \\(s\\) is, the smaller is the stationary concentration of photocarriers at the surface (and vice versa). SI unit is \\(\\pu{s-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14079 goldbook:14014)
AnnotationAssertion(rdfs:seeAlso goldbook:14079 goldbook:14040)
AnnotationAssertion(rdfs:seeAlso goldbook:14079 goldbook:14098)
AnnotationAssertion(mito:isMentionedBy goldbook:14079 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14079 "current"^^xsd:string)
Declaration(Class(goldbook:14080))
AnnotationAssertion(rdfs:label goldbook:14080 "recombination of photocarriers")
AnnotationAssertion(dcterms:description goldbook:14080 "Two-step transition of an electron from the conduction band to a defect centre and then further to the valence band, or from the defect centre to the valence band (first step) and a subsequent transition of the conduction band electron to the defect centre (second step).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14080 "recombination of photocarriers via defects")
AnnotationAssertion(rdfs:seeAlso goldbook:14080 goldbook:14081)
AnnotationAssertion(mito:isMentionedBy goldbook:14080 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14080 "current"^^xsd:string)
Declaration(Class(goldbook:14081))
AnnotationAssertion(rdfs:label goldbook:14081 "recombination centre")
AnnotationAssertion(dcterms:description goldbook:14081 "Defect in semiconductors and insulators capable of sequential capture of free charge carriers of both signs with high efficiency.")
AnnotationAssertion(rdfs:comment goldbook:14081 "Provides a path for the recombination of free electrons and holes at high rates. Typically, in imperfect wide-bandgap energy solids, the rate of photoinduced carrier recombination through recombination centres at moderate photon irradiance is larger than the rate of band-to-band recombination."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14081 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14081 "current"^^xsd:string)
Declaration(Class(goldbook:14082))
AnnotationAssertion(rdfs:label goldbook:14082 "regular surface")
AnnotationAssertion(dcterms:description goldbook:14082 "Perfect surface of a solid without heterogeneity or defect.")
AnnotationAssertion(rdfs:comment goldbook:14082 "Rigorously speaking, this is a theoretical notion. In practice, however, this term is used to refer to local space regions of real relaxed and reconstructed surfaces if the perturbations caused by the nearest adjacent (surface) defects can be neglected."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14082 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14082 "current"^^xsd:string)
Declaration(Class(goldbook:14083))
AnnotationAssertion(rdfs:label goldbook:14083 "regular surface site")
AnnotationAssertion(dcterms:description goldbook:14083 "Zero-dimension site (atom, ion, or interstitial position) at a regular surface.")
AnnotationAssertion(rdfs:comment goldbook:14083 "It can be a photocatalytic centre (site) in the ground (not active) state in some particular cases of heterogeneous photocatalysis as, e.g., in the case when pre-physisorbed entities trap photocarriers in the course of the photocatalysed reaction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14083 goldbook:14018)
AnnotationAssertion(rdfs:seeAlso goldbook:14083 goldbook:14040)
AnnotationAssertion(rdfs:seeAlso goldbook:14083 goldbook:14043)
AnnotationAssertion(rdfs:seeAlso goldbook:14083 goldbook:14082)
AnnotationAssertion(mito:isMentionedBy goldbook:14083 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14083 "current"^^xsd:string)
Declaration(Class(goldbook:14084))
AnnotationAssertion(rdfs:label goldbook:14084 "relative photonic efficiency")
AnnotationAssertion(dcterms:description goldbook:14084 "Ratio of the photonic efficiency (\\(\\xi\\)) of a chemical process to the corresponding photonic efficiency of a standard process under otherwise identical conditions in the same reactor configuration and operation.")
AnnotationAssertion(rdfs:comment goldbook:14084 "For measurements carried out at constant photon flux, \\(\\xi_{\\rm{rel}}\\) can be estimated as the ratio of the corresponding reaction initial rates (for \\(t \\to 0\\)), determined under identical conditions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14084 "Protocols for the determination of \\(\\xi_{\\rm{rel}}\\) have been reported."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14084 "See the restrictions about the determination of quantum yields in photocatalysis mentioned in the Introduction of the source IUPAC Recommendation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14084 goldbook:14057)
AnnotationAssertion(mito:isMentionedBy goldbook:14084 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14084 "current"^^xsd:string)
Declaration(Class(goldbook:14085))
AnnotationAssertion(rdfs:label goldbook:14085 "scattering albedo")
AnnotationAssertion(dcterms:description goldbook:14085 "Efficiency of scattering, i.e., ratio of scattering coefficient, \\(\\sigma(\\lambda_{\\rm{i}})\\), to the total attenuance coefficient, \\(\\beta(\\lambda_{\\rm{i}})\\), at a particular wavelength \\(\\lambda_{\\rm{i}}\\).")
AnnotationAssertion(rdfs:comment goldbook:14085 "Mathematical expression: \\(\\sigma(\\lambda_{\\rm{i}})/\\beta(\\lambda_{\\rm{i}})\\). Dimension one."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14085 "A scattering albedo of 1 indicates total scattering, whereas a scattering albedo of 0 indicates that all attenuance is due to absorption."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14085 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14085 "current"^^xsd:string)
Declaration(Class(goldbook:14086))
AnnotationAssertion(rdfs:label goldbook:14086 "shallow trap")
AnnotationAssertion(dcterms:description goldbook:14086 "Energy level (of trapped carrier) within the bandgap energy, near the bottom of the conduction band (electron shallow trap) and near the top of the valence band (hole shallow band) at an energy such that \\(E_{\\rm{trap}} \\approx kT\\), with \\(k\\) the Boltzmann constant and \\(T\\) the thermodynamic temperature.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14086 "shallow energy trap")
AnnotationAssertion(mito:isMentionedBy goldbook:14086 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14086 "current"^^xsd:string)
Declaration(Class(goldbook:14087))
AnnotationAssertion(rdfs:label goldbook:14087 "Solonitsyn effect")
AnnotationAssertion(dcterms:description goldbook:14087 "Adsorption (or reaction) after preliminary irradiation of a photocatalyst in vacuum (or in the absence of reagent).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14087 "post-adsorption")
AnnotationAssertion(rdfs:seeAlso goldbook:14087 goldbook:14001)
AnnotationAssertion(mito:isMentionedBy goldbook:14087 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14087 "current"^^xsd:string)
Declaration(Class(goldbook:14088))
AnnotationAssertion(rdfs:label goldbook:14088 "sonophotocatalytic reactor")
AnnotationAssertion(dcterms:description goldbook:14088 "Reactor in which a hybrid technique combining 'sonochemical' and photocatalytic reactions is used.")
AnnotationAssertion(rdfs:comment goldbook:14088 "This type of reactor has been proposed for the treatment of wastewaters."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14088 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14088 "current"^^xsd:string)
Declaration(Class(goldbook:14089))
AnnotationAssertion(rdfs:label goldbook:14089 "space charge region")
AnnotationAssertion(dcterms:description goldbook:14089 "Region formed within a semiconductor in contact with another phase in which there is a band bending that can be upward or downward.")
AnnotationAssertion(rdfs:seeAlso goldbook:14089 goldbook:14004)
AnnotationAssertion(mito:isMentionedBy goldbook:14089 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14089 "current"^^xsd:string)
Declaration(Class(goldbook:14090))
AnnotationAssertion(rdfs:label goldbook:14090 "specific photoadsorption number")
AnnotationAssertion(dcterms:description goldbook:14090 "Maximum number of entities (molecules, atoms or radicals) adsorbed as a result of irradiation divided by the surface area and by the mass of adsorbent.")
AnnotationAssertion(rdfs:comment goldbook:14090 "This definition, per area and per mass, is misleading. It is included for historical reasons and was originally called specific photoadsorption capacity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14090 goldbook:14034)
AnnotationAssertion(mito:isMentionedBy goldbook:14090 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14090 "current"^^xsd:string)
Declaration(Class(goldbook:14091))
AnnotationAssertion(rdfs:label goldbook:14091 "specific absorption coefficient")
AnnotationAssertion(dcterms:description goldbook:14091 "Linear napierian, \\(\\alpha_{\\lambda}^{\\ast}\\), or linear decadic, \\(a_{\\lambda}^{\\ast}\\), absorption coefficient divided by the mass concentration, \\(\\rho\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14091 "specific linear decadic spectral absorption coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14091 "specific linear Napierian spectral absorption coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14091 "specific spectral absorption coefficient")
AnnotationAssertion(rdfs:comment goldbook:14091 "The asterisk as superscript indicates that it is a specific property."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14091 "Absorption coefficient is always a spectral property; the subscript \\(\\lambda\\) may be omitted but the wavelength should be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14091 "Mathematical definition: \\[\\alpha_{\\lambda}^{\\ast} = \\frac{\\alpha_{\\lambda}}{\\rho} \\quad {\\rm{or}} \\quad a_{\\lambda}^{\\ast} = \\frac{a_{\\lambda}}{\\rho}\\] SI unit is \\(\\pu{m kg-1}\\) , common unit is \\(\\pu{m g-1}\\) or \\(\\pu{cm2 g-1 nm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14091 "For reacting systems with mass fluctuations and high scattering, space- and time-dependent specific, napierian and decadic, absorption coefficients are necessary, i.e., \\(\\alpha_{\\lambda}^{\\ast}(\\boldsymbol{x},t)\\) and \\(a_{\\lambda}^{\\ast}(\\boldsymbol{x},t)\\), respectively; \\(\\boldsymbol{x}\\) defines the position in a three-dimensional space."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14091 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14091 "current"^^xsd:string)
Declaration(Class(goldbook:14092))
AnnotationAssertion(rdfs:label goldbook:14092 "specific napierian attenuance coefficient")
AnnotationAssertion(dcterms:description goldbook:14092 "Attenuance (napierian), \\(D_{\\rm{e}}\\), divided by the absorption pathlength, \\(l\\), and the mass concentration, \\(\\rho\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14092 "specific Napierian extinction coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14092 "specific Napierian spectral extinction coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14092 "specific spectral Napierian attenuance coefficient")
AnnotationAssertion(rdfs:comment goldbook:14092 "Mathematical expression: \\[\\beta_{\\lambda}^{\\ast} = \\left(\\frac{1}{\\rho\\,l}\\right) \\ln \\left(\\frac{P_{\\lambda}^{0}}{P_{\\lambda}}\\right) = \\frac{D_{\\rm{e},\\lambda}}{\\rho\\,l}\\] where \\(P_{\\lambda}^{0}\\) and \\(P_{\\lambda}\\) are, respectively, the incident and transmitted spectral radiant power or the incident and transmitted spectral photon flux."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14092 "In common use for \\(l\\) in \\(\\pu{cm}\\) and \\(\\rho\\) in (\\(\\pu{g cm-3}\\)), \\(\\beta_{\\lambda}^{\\ast}\\) is in \\(\\pu{cm2 g-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14092 "Sometimes called mass napierian (spectral) attenuance coefficient."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14092 "Strictly speaking, the spectral quantity should be used, which is the derivative of the specific napierian attenuance coefficient with respect to \\(\\lambda\\), i.e., \\({\\rm{d}}\\beta\\!\\ast\\!(\\lambda)/{\\rm{d}}\\lambda\\) in common units \\(\\pu{cm2 g-1 nm-1}\\) or in \\(\\pu{cm g-1}\\). In practice, the subscript is omitted and the respective unit is not taken into account. The wavelength should be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14092 "The specific napierian attenuance coefficient reduces to specific napierian absorption coefficient for a non-reflecting and non-scattering sample."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14092 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14092 "current"^^xsd:string)
Declaration(Class(goldbook:14093))
AnnotationAssertion(rdfs:label goldbook:14093 "specific napierian scattering coefficient")
AnnotationAssertion(dcterms:description goldbook:14093 "Fraction of attenuance (napierian) not due to absorbance, divided by the pathlength, \\(l\\), within the scattering medium and the mass concentration, \\(\\rho\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14093 "specific spectral napierian scattering coefficient")
AnnotationAssertion(rdfs:comment goldbook:14093 "Mathematical expression: \\[\\sigma_{\\lambda}^{\\ast} = \\sigma_{\\lambda}/\\rho = [D_{\\rm{e},\\lambda} - A_{\\rm{e},\\lambda}]/(l\\,\\rho)\\], where \\(\\rho\\) is the mass concentration. The absorbance should be subtracted from the total attenuance for the calculation of \\(\\rho_{\\lambda}\\) and \\(\\rho_{\\lambda}^{\\ast}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14093 "The superscript asterisk indicates that it is a specific property."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14093 "Sometimes called mass napierian (spectral) scattering coefficient."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14093 "Strictly speaking, the spectral quantity should be used, which is the derivative of the specific napierian scattering coefficient with respect to \\(\\lambda\\), i.e., \\({\\rm{d}}\\sigma\\!\\ast\\!(\\lambda)/{\\rm{d}}\\lambda\\) in common units \\(\\pu{cm2 g-1 nm-1}\\) or in \\(\\pu{cm g-1}\\). In practice, the subscript is omitted and the respective unit is not taken into account. The wavelength should be specified."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14093 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14093 "current"^^xsd:string)
Declaration(Class(goldbook:14094))
AnnotationAssertion(rdfs:label goldbook:14094 "spectral photon irradiance")
AnnotationAssertion(dcterms:description goldbook:14094 "Derivative of photon irradiance, \\(E_{\\rm{p}}\\), with respect to wavelength, \\(\\lambda\\).")
AnnotationAssertion(rdfs:comment goldbook:14094 "Mathematical expression: \\(E_{\\rm{p},\\lambda} = {\\rm{d}}E_{\\rm{p}}/{\\rm{d}}\\lambda\\). SI unit is \\(\\pu{s-1 m-3}\\); common unit is \\(\\pu{s-1 m-2 nm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14094 "This quantity can be expressed on a chemical amount basis by dividing \\(E_{p,\\lambda}\\) by the Avogadro constant, the name then being \"spectral photon irradiance, amount basis\", the symbol \\(E_{n,{\\rm{p}},\\lambda}\\) and the SI unit \\(\\pu{mol s-1 m-3}\\); common unit is \\(\\pu{einstein s-1 m-2 nm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14094 "All spectral terms may also be defined as derivatives with respect to frequency, \\(\\nu\\), or wavenumber, \\(\\tilde{\\nu}\\) and are referred to, when necessary, as in terms of wavelength, or frequency or wavenumber, respectively."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14094 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14094 "current"^^xsd:string)
Declaration(Class(goldbook:14095))
AnnotationAssertion(rdfs:label goldbook:14095 "spectral photonic yield")
AnnotationAssertion(dcterms:description goldbook:14095 "Dependence of the photonic yield on the photon energy (wavelength, frequency, or wavenumber) of the radiation for a given photoreaction obtained at a certain incident (prior to absorption) photon irradiance in a given spectral range.")
AnnotationAssertion(rdfs:comment goldbook:14095 "In practice, it is normalised to a certain spectral photon flux provided that photoresponse scales linearly with it."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14095 "Information concerning the photoexcitation of a solid photocatalyst can be obtained from a comparison of the spectral quantum yield with the spectral photonic efficiency."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14095 goldbook:14057)
AnnotationAssertion(rdfs:seeAlso goldbook:14095 goldbook:14058)
AnnotationAssertion(rdfs:seeAlso goldbook:14095 goldbook:14096)
AnnotationAssertion(mito:isMentionedBy goldbook:14095 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14095 "current"^^xsd:string)
Declaration(Class(goldbook:14096))
AnnotationAssertion(rdfs:label goldbook:14096 "spectral quantum yield")
AnnotationAssertion(dcterms:description goldbook:14096 "Dependence of the quantum yield on the photon energy (wavelength, frequency or wavenumber) of the radiation absorbed by the reactant for a given photoreaction.")
AnnotationAssertion(rdfs:comment goldbook:14096 "To obtain information on the spectral variation of activity of a photocatalyst, the measured photoresponse must scale linearly with the photon flux at all wavelengths."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14096 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14096 "current"^^xsd:string)
Declaration(Class(goldbook:14097))
AnnotationAssertion(rdfs:label goldbook:14097 "surface-active site")
AnnotationAssertion(dcterms:description goldbook:14097 "Surface regular or defect site that can initiate the chemical transformation of reagents.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14097 "surface-active centre")
AnnotationAssertion(rdfs:seeAlso goldbook:14097 goldbook:14012)
AnnotationAssertion(rdfs:seeAlso goldbook:14097 goldbook:14102)
AnnotationAssertion(mito:isMentionedBy goldbook:14097 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14097 "current"^^xsd:string)
Declaration(Class(goldbook:14098))
AnnotationAssertion(rdfs:label goldbook:14098 "surface recombination")
AnnotationAssertion(dcterms:description goldbook:14098 "Recombination of charge carriers at a solid surface or at an interface between different phases.")
AnnotationAssertion(rdfs:comment goldbook:14098 "In theoretical models of heterogeneous photocatalysis, the photocarriers exchange between the solid and the reactants yielding products that may be considered as a specific type of surface recombination products."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14098 goldbook:14040)
AnnotationAssertion(rdfs:seeAlso goldbook:14098 goldbook:14079)
AnnotationAssertion(mito:isMentionedBy goldbook:14098 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14098 "current"^^xsd:string)
Declaration(Class(goldbook:14099))
AnnotationAssertion(rdfs:label goldbook:14099 "thermal bleaching")
AnnotationAssertion(dcterms:description goldbook:14099 "Loss of absorption by the colour centres because of heating of the solid semiconductor or insulator.")
AnnotationAssertion(rdfs:seeAlso goldbook:14099 goldbook:14002)
AnnotationAssertion(mito:isMentionedBy goldbook:14099 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14099 "current"^^xsd:string)
Declaration(Class(goldbook:14100))
AnnotationAssertion(rdfs:label goldbook:14100 "thermophotocatalysis")
AnnotationAssertion(dcterms:description goldbook:14100 "A photocatalytic phenomenon occurring when the system is also heated by the ultraviolet, visible, or infrared radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14100 "light-initiated thermocatalytic phenomena")
AnnotationAssertion(rdfs:comment goldbook:14100 "In case of high photon flux, thermochemical processes may take place as a result of radiationless deactivation of excited species, in addition to photochemical processes. This often occurs upon exposure of a heterogeneous photocatalyst to pulsed IR-light or pulsed laser emission."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14100 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14100 "current"^^xsd:string)
Declaration(Class(goldbook:14101))
AnnotationAssertion(rdfs:label goldbook:14101 "turnover number")
AnnotationAssertion(dcterms:description goldbook:14101 "Number of times, \\(n\\), that the overall reaction (the photochemical transformation) goes through a photocatalytic cycle.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:14101 "TON")
AnnotationAssertion(rdfs:comment goldbook:14101 "It can be equally applied to homogeneous and heterogeneous systems."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14101 "TON is a number, whereas in traditional catalysis, e.g., enzyme kinetics, it is defined per certain time period."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14101 "In heterogeneous photocatalysis it is the ratio of the number of photoinduced transformations for a given period of time to the number of active sites or photocatalytic centres in their ground state. Should the number of active sites be known, TON could be expressed per number of sites."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14101 "TON is a quantity of dimension one attributed in photocatalysis to the overall system that contains the photocatalyst, even if, in heterogeneous photocatalysis, part of the photocatalyst active centres appears to be not irradiated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14101 "In homogeneous photocatalysis it is the ratio of the number of photoinduced transformations for a given period to the number of ground state photocatalyst entities."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14101 goldbook:14018)
AnnotationAssertion(rdfs:seeAlso goldbook:14101 goldbook:14020)
AnnotationAssertion(mito:isMentionedBy goldbook:14101 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14101 "current"^^xsd:string)
Declaration(Class(goldbook:14102))
AnnotationAssertion(rdfs:label goldbook:14102 "V centres")
AnnotationAssertion(dcterms:description goldbook:14102 "Trapped holes in semiconductors.")
AnnotationAssertion(rdfs:seeAlso goldbook:14102 goldbook:14002)
AnnotationAssertion(mito:isMentionedBy goldbook:14102 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14102 "current"^^xsd:string)
Declaration(Class(goldbook:14103))
AnnotationAssertion(rdfs:label goldbook:14103 "volatile organic chemical/compounds")
AnnotationAssertion(dcterms:description goldbook:14103 "Term commonly used to designate organic gas-phase pollutants frequently degraded by photocatalytic procedures.")
AnnotationAssertion(rdfs:comment goldbook:14103 "Often used for any organic compound with a vapor pressure higher than \\(\\pu{10 Pa}\\) at \\(\\pu{T} = \\pu{293 K}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14103 doi:10.1351/PAC-REC-09-09-36)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14103 "current"^^xsd:string)
Declaration(Class(goldbook:14104))
AnnotationAssertion(rdfs:label goldbook:14104 "absorbance assay")
AnnotationAssertion(dcterms:description goldbook:14104 "Assay in which response is determined by the detection of light absorption by an assay component.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14104 "optical density assay (obsolete)")
AnnotationAssertion(rdfs:comment goldbook:14104 "The concentration of the absorbing species can be quantified using the Beer–Lambert law (or Beer–Lambert–Bouguer law) \\[A = \\varepsilon cl = \\lg\\left(\\frac{P_{0}}{P}\\right)\\] where \\(\\varepsilon\\) is the molar absorption coefficient of the absorbing species, \\(l\\) is the absorption path length, and \\(c\\) the amount concentration. A sample is irradiated with a specific wavelength of light, typically in the ultraviolet or visible spectral region; the spectral radiant power of incident light on the sample (\\(P_{0}\\)) and transmitted radiation after passing through the sample (\\(P\\)) are used to calculate absorbance (\\(A\\))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14104 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14104 "current"^^xsd:string)
Declaration(Class(goldbook:14105))
AnnotationAssertion(rdfs:label goldbook:14105 "active")
AnnotationAssertion(dcterms:description goldbook:14105 "Sample that produces a response or signal above a defined threshold at a tested concentration in a single assay or screen.")
AnnotationAssertion(rdfs:comment goldbook:14105 "When the properties and identity of an active or hit are confirmed by subsequent experiment it becomes a confirmed hit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14105 goldbook:14123)
AnnotationAssertion(rdfs:seeAlso goldbook:14105 goldbook:14150)
AnnotationAssertion(rdfs:seeAlso goldbook:14105 goldbook:14189)
AnnotationAssertion(mito:isMentionedBy goldbook:14105 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14105 "current"^^xsd:string)
Declaration(Class(goldbook:14106))
AnnotationAssertion(rdfs:label goldbook:14106 "activity distribution")
AnnotationAssertion(dcterms:description goldbook:14106 "Graphical representation of the number of samples present in each activity range.")
AnnotationAssertion(rdfs:comment goldbook:14106 "Often shown as a frequency distribution graph, it provides an overview of the screening results and typically allows the determination of the overall background signal and threshold for selection of actives."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14106 goldbook:14105)
AnnotationAssertion(mito:isMentionedBy goldbook:14106 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14106 "current"^^xsd:string)
Declaration(Class(goldbook:14107))
AnnotationAssertion(rdfs:label goldbook:14107 "allosteric site")
AnnotationAssertion(dcterms:description goldbook:14107 "Binding site on a protein, distinct from the site recognized by an endogenous agonist (i.e., the orthosteric site) in the case of a receptor, or substrate in the case of an enzyme, that when occupied by a ligand effects a conformational change in the protein, thus altering its signaling, catalytic properties, or its capability to interact with other macromolecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:14107 goldbook:14173)
AnnotationAssertion(mito:isMentionedBy goldbook:14107 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14107 "current"^^xsd:string)
Declaration(Class(goldbook:14108))
AnnotationAssertion(rdfs:label goldbook:14108 "artifact")
AnnotationAssertion(dcterms:description goldbook:14108 "Observation, effect, or result that is inaccurate because it is produced by the methodology used in scientific investigation or by experimental error.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14108 "artefact")
AnnotationAssertion(mito:isMentionedBy goldbook:14108 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14108 "current"^^xsd:string)
Declaration(Class(goldbook:14109))
AnnotationAssertion(rdfs:label goldbook:14109 "assay validation")
AnnotationAssertion(dcterms:description goldbook:14109 "Experiments conducted to verify that the output measurements of the assay are consistently reflective of the activity against the target.")
AnnotationAssertion(rdfs:comment goldbook:14109 "Results are compared internally over multiple runs and externally (when available) to existing literature parameters such as \\(K_{\\rm{d}}\\), \\(K_{\\rm{i}}\\), \\(K_{\\rm{m}}\\), or \\(\\pu{EC_{50}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14109 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14109 "current"^^xsd:string)
Declaration(Class(goldbook:14110))
AnnotationAssertion(rdfs:label goldbook:14110 "automated device")
AnnotationAssertion(dcterms:description goldbook:14110 "Device that performs one or more functions without human intervention by means of direct control or by programmed operations.")
AnnotationAssertion(rdfs:comment goldbook:14110 "Often referred to as a peripheral or peripheral device when it is an instrument incorporated into a module, a workstation, or a fully automated system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14110 goldbook:14159)
AnnotationAssertion(rdfs:seeAlso goldbook:14110 goldbook:14164)
AnnotationAssertion(rdfs:seeAlso goldbook:14110 goldbook:14202)
AnnotationAssertion(mito:isMentionedBy goldbook:14110 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14110 "current"^^xsd:string)
Declaration(Class(goldbook:14111))
AnnotationAssertion(rdfs:label goldbook:14111 "binding assay")
AnnotationAssertion(dcterms:description goldbook:14111 "Assay in which the specific physical association or interaction between two molecules (e.g., ligand–receptor, antibody–antigen, protein–protein, ligand–transport protein) is measured.")
AnnotationAssertion(rdfs:comment goldbook:14111 "The assay can be homogeneous or heterogeneous, competitive or noncompetitive, and may be run at equilibrium or in kinetic mode. Appropriate assay controls and/or standard reagents are often needed to determine the specific binding in contrast to nonspecific adsorption processes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14111 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14111 "current"^^xsd:string)
Declaration(Class(goldbook:14112))
AnnotationAssertion(rdfs:label goldbook:14112 "binding isotherm")
AnnotationAssertion(dcterms:description goldbook:14112 "Graphical representation of the relationship between the amount of ligand that is specifically bound to a receptor per mass of binding material and the amount of free ligand.")
AnnotationAssertion(rdfs:comment goldbook:14112 "For a system containing a single binding site and lacking cooperative interactions, the binding isotherm is described by \\[B = B_{\\max}[\\ce{L}]/(K_{\\rm{d}} + [\\ce{L}])\\] where \\(\\ce{B}\\) is the amount of ligand specifically bound, \\([\\ce{L}]\\) is the amount concentration of free ligand, \\(K_{\\rm{d}}\\) is the equilibrium dissociation constant of the ligand, and \\(B_{\\rm{max}}\\) is the maximal specific binding of a ligand. The equation describes a hyperbola with \\(B_{\\rm{max}}\\) as the asymptote. \\(B_{\\rm{max}}\\) is defined quantitatively as the amount of ligand bound per mass of binding material, with units, e.g., \\(\\pu{pmol mg-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14112 "A Scatchard plot was formerly used to determine \\(B_{\\rm{max}}\\) and \\(K_{\\rm{d}}\\). It is now more common to determine these parameters by nonlinear least-squares fitting to the binding equation given above."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14112 "The total number of receptors or binding sites in the system is proportional to \\(B_{\\rm{max}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14112 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14112 "current"^^xsd:string)
Declaration(Class(goldbook:14113))
AnnotationAssertion(rdfs:label goldbook:14113 "cell-based assay")
AnnotationAssertion(dcterms:description goldbook:14113 "Assay in which the response of live cells to a test sample is measured.")
AnnotationAssertion(rdfs:comment goldbook:14113 "The type of cells, parameters measured, and detection systems used vary widely."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14113 "Assay parameters are controlled with respect to conditions such as \\(\\ce{CO2}\\), \\(\\ce{O2}\\), temperature, and \\(\\pu{pH}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14113 goldbook:14119)
AnnotationAssertion(rdfs:seeAlso goldbook:14113 goldbook:14125)
AnnotationAssertion(rdfs:seeAlso goldbook:14113 goldbook:14141)
AnnotationAssertion(mito:isMentionedBy goldbook:14113 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14113 "current"^^xsd:string)
Declaration(Class(goldbook:14114))
AnnotationAssertion(rdfs:label goldbook:14114 "cell membrane preparation")
AnnotationAssertion(dcterms:description goldbook:14114 "Preparation from tissue or cells, in which the membranous elements, generally the cell membrane, are enriched in relation to other cellular constituents.")
AnnotationAssertion(rdfs:comment goldbook:14114 "These are obtained by disruption of the cells and differential centrifugation or other techniques to isolate the desired components."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14114 "Cell membrane preparations are the standard biological material for receptor binding assays. Cell membranes are typically lipid-rich."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14114 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14114 "current"^^xsd:string)
Declaration(Class(goldbook:14115))
AnnotationAssertion(rdfs:label goldbook:14115 "cell mortality")
AnnotationAssertion(dcterms:description goldbook:14115 "Ratio of counted dead cells to the total number of observed cells.")
AnnotationAssertion(rdfs:comment goldbook:14115 "Dead cells are often counted using apoptosis or nuclear markers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14115 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14115 "current"^^xsd:string)
Declaration(Class(goldbook:14116))
AnnotationAssertion(rdfs:label goldbook:14116 "cell viability")
AnnotationAssertion(dcterms:description goldbook:14116 "Ratio of counted live cells to the total number of observed cells.")
AnnotationAssertion(rdfs:comment goldbook:14116 "Live cells are often counted using nuclear, membrane, or metabolic markers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14116 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14116 "current"^^xsd:string)
Declaration(Class(goldbook:14117))
AnnotationAssertion(rdfs:label goldbook:14117 "channel blocker")
AnnotationAssertion(dcterms:description goldbook:14117 "Compound that reduces or eliminates the conductance of an ion channel by impeding the movement of ions through that channel.")
AnnotationAssertion(rdfs:comment goldbook:14117 "Dihydropyridine antagonists such as nifedipine, which also block the conductance of some L-type calcium channels, are not classified as channel blockers since their action is to inhibit channel gating."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14117 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14117 "current"^^xsd:string)
Declaration(Class(goldbook:14118))
AnnotationAssertion(rdfs:label goldbook:14118 "channel opener")
AnnotationAssertion(dcterms:description goldbook:14118 "Compound that increases the conductance of an ion channel by a mechanism other than alteration of membrane potential or activation of the cognate receptor.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14118 "channel activator")
AnnotationAssertion(mito:isMentionedBy goldbook:14118 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14118 "current"^^xsd:string)
Declaration(Class(goldbook:14119))
AnnotationAssertion(rdfs:label goldbook:14119 "chemotaxis assay")
AnnotationAssertion(dcterms:description goldbook:14119 "Cell-based assay in which the rate and/or direction of cell migration is measured.")
AnnotationAssertion(rdfs:comment goldbook:14119 "Typically, the response to a test sample is detected by means of a fluorescent probe or with label-free methods. Classical chemotaxis assays utilized the Boyden chamber and required manual counting of migrating cells under the microscope."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14119 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14119 "current"^^xsd:string)
Declaration(Class(goldbook:14120))
AnnotationAssertion(rdfs:label goldbook:14120 "combinatorial library")
AnnotationAssertion(dcterms:description goldbook:14120 "Set of compounds prepared by combinatorial chemistry. It may consist of a collection of pools, or sublibraries. Its composition may be described by the chemset notation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14120 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14120 "current"^^xsd:string)
Declaration(Class(goldbook:14121))
AnnotationAssertion(rdfs:label goldbook:14121 "compound collection")
AnnotationAssertion(dcterms:description goldbook:14121 "Set of chemicals that has been assembled and annotated for easy storage and retrieval and that is available for screening.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14121 "compound deck")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14121 "compound library")
AnnotationAssertion(rdfs:comment goldbook:14121 "Generally consists of compounds synthesized by combinatorial or standard synthetic methods or purchased from commercial sources, or of natural products as pure samples. Compounds may be stored in dry powder form, or dissolved at a fixed concentration in a solvent, such as dimethylsulfoxide."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14121 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14121 "current"^^xsd:string)
Declaration(Class(goldbook:14122))
AnnotationAssertion(rdfs:label goldbook:14122 "concentration–response relationship")
AnnotationAssertion(dcterms:description goldbook:14122 "Association between compound concentration and the resultant magnitude of the continuously graded change produced, in an assay.")
AnnotationAssertion(rdfs:seeAlso goldbook:14122 goldbook:14132)
AnnotationAssertion(mito:isMentionedBy goldbook:14122 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14122 "current"^^xsd:string)
Declaration(Class(goldbook:14123))
AnnotationAssertion(rdfs:label goldbook:14123 "confirmed hit")
AnnotationAssertion(dcterms:description goldbook:14123 "Sample that produces activity above the hit threshold in an assay and whose structural identity has been confirmed.")
AnnotationAssertion(mito:isMentionedBy goldbook:14123 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14123 "current"^^xsd:string)
Declaration(Class(goldbook:14124))
AnnotationAssertion(rdfs:label goldbook:14124 "counter-screen")
AnnotationAssertion(dcterms:description goldbook:14124 "Screen in which test samples are assessed against a target for unwanted activity.")
AnnotationAssertion(rdfs:comment goldbook:14124 "This target may or may not be structurally or functionally related to the intended target."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14124 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14124 "current"^^xsd:string)
Declaration(Class(goldbook:14125))
AnnotationAssertion(rdfs:label goldbook:14125 "cytotoxicity assay")
AnnotationAssertion(dcterms:description goldbook:14125 "Cell-based assay in which damage to cell structure or function caused by a test sample is determined.")
AnnotationAssertion(rdfs:seeAlso goldbook:14125 goldbook:14115)
AnnotationAssertion(rdfs:seeAlso goldbook:14125 goldbook:14116)
AnnotationAssertion(mito:isMentionedBy goldbook:14125 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14125 "current"^^xsd:string)
Declaration(Class(goldbook:14126))
AnnotationAssertion(rdfs:label goldbook:14126 "efficacy")
AnnotationAssertion(dcterms:description goldbook:14126 "Extent to which a compound activates a receptor to produce a response in an assay under saturating conditions.")
AnnotationAssertion(rdfs:comment goldbook:14126 "Usually compared to results with the positive and negative assay controls. When the compound produces a maximal signal that is \\(\\pu{100\\%}\\) of that of the positive control, it is said to be a full agonist and has high efficacy. When the effect plateaus with increasing concentration to reach an intermediary level of activity, the compound is said to be a partial agonist with lower efficacy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14126 "Due to the common overexpression of receptors in screening assays, it is not always possible to detect differences in efficacy among full agonists. A more accurate assessment of relative efficacy may require systems with lower receptor expression where it is often found that one agonist may show partial agonist character."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14126 goldbook:14174)
AnnotationAssertion(mito:isMentionedBy goldbook:14126 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14126 "current"^^xsd:string)
Declaration(Class(goldbook:14127))
AnnotationAssertion(rdfs:label goldbook:14127 "electrochemiluminescence assay")
AnnotationAssertion(dcterms:description goldbook:14127 "Assay in which light emitted by electrogenerated luminescence is detected and used to quantify a label, e.g., ruthenium(II) tris-(bipyridine), on one of the two assay binding components.")
AnnotationAssertion(mito:isMentionedBy goldbook:14127 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14127 "current"^^xsd:string)
Declaration(Class(goldbook:14128))
AnnotationAssertion(rdfs:label goldbook:14128 "end-point assay")
AnnotationAssertion(dcterms:description goldbook:14128 "Kinetic assay run for a set constant incubation time. Typically, at the end of the set incubation time, a reagent that stops the reaction is added to allow postponed measurement of the signal.")
AnnotationAssertion(rdfs:seeAlso goldbook:14128 goldbook:14152)
AnnotationAssertion(rdfs:seeAlso goldbook:14128 goldbook:14130)
AnnotationAssertion(mito:isMentionedBy goldbook:14128 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14128 "current"^^xsd:string)
Declaration(Class(goldbook:14129))
AnnotationAssertion(rdfs:label goldbook:14129 "epitope mapping")
AnnotationAssertion(dcterms:description goldbook:14129 "Identification and localization of the specific regions of protein molecules that are recognized by the immune system.")
AnnotationAssertion(mito:isMentionedBy goldbook:14129 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14129 "current"^^xsd:string)
Declaration(Class(goldbook:14130))
AnnotationAssertion(rdfs:label goldbook:14130 "equilibrium assay")
AnnotationAssertion(dcterms:description goldbook:14130 "Assay in which there is sufficient incubation time for the plateau phase of the signal to be reached and equilibrium has been established between the reactants.")
AnnotationAssertion(rdfs:comment goldbook:14130 "At this point, the signal is time-independent."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14130 goldbook:14128)
AnnotationAssertion(rdfs:seeAlso goldbook:14130 goldbook:14152)
AnnotationAssertion(mito:isMentionedBy goldbook:14130 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14130 "current"^^xsd:string)
Declaration(Class(goldbook:14131))
AnnotationAssertion(rdfs:label goldbook:14131 "equilibrium association constant")
AnnotationAssertion(dcterms:description goldbook:14131 "Ratio, at equilibrium, of \\([\\ce{AB}]/[\\ce{A}][\\ce{B}]\\) for the reversible binding interaction of \\(\\ce{A}\\) and \\(\\ce{B}\\) to yield the complex \\(\\ce{AB}\\).")
AnnotationAssertion(rdfs:comment goldbook:14131 "Equal to \\(1/K_{\\rm{d}}\\), or \\(k_{\\rm{on}}/k_{\\rm{off}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14131 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14131 "current"^^xsd:string)
Declaration(Class(goldbook:14132))
AnnotationAssertion(rdfs:label goldbook:14132 "equilibrium dissociation constant")
AnnotationAssertion(dcterms:description goldbook:14132 "Ratio, at equilibrium, of \\([\\ce{A}][\\ce{B}]/[\\ce{AB}]\\), for the reversible binding interaction of \\(\\ce{A}\\) and \\(\\ce{B}\\) to yield the complex \\(\\ce{AB}\\).")
AnnotationAssertion(rdfs:comment goldbook:14132 "Reciprocal of \\(K_{\\rm{a}}\\) (\\(K_{\\rm{d}} = 1/K_{\\rm{a}}\\)), equal to \\(k_{\\rm{off}}/k_{\\rm{on}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14132 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14132 "current"^^xsd:string)
Declaration(Class(goldbook:14133))
AnnotationAssertion(rdfs:label goldbook:14133 "flow cytometry assay")
AnnotationAssertion(dcterms:description goldbook:14133 "Cell-based assay in which the response is dependent on the detection of the phenotype of cells as determined through the light-scattering properties of each cell, and, typically, the fluorescence intensity of a relevant probe.")
AnnotationAssertion(rdfs:comment goldbook:14133 "Flow cytometry has been adapted to fluorescently labeled bead-based assays."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14133 "In fluorescence-activated cell sorting, single cells are rapidly passed through a channel where they are optically analyzed and separated based on the specific light-scattering and fluorescent characteristics of each individual cell."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14133 goldbook:14113)
AnnotationAssertion(mito:isMentionedBy goldbook:14133 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14133 "current"^^xsd:string)
Declaration(Class(goldbook:14134))
AnnotationAssertion(rdfs:label goldbook:14134 "fluorescence correlation assay")
AnnotationAssertion(dcterms:description goldbook:14134 "Assay in which fluctuations in fluorescence intensity are detected and used to characterize a species that is labeled with a fluorescent probe.")
AnnotationAssertion(rdfs:comment goldbook:14134 "The fluctuations are measured for a small volume of the total assay sample and are attributed to local diffusion of the probe in the detected volume or interactions that change the quantum yield of fluorescence."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14134 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14134 "current"^^xsd:string)
Declaration(Class(goldbook:14135))
AnnotationAssertion(rdfs:label goldbook:14135 "fluorescence polarisation")
AnnotationAssertion(dcterms:description goldbook:14135 "Dimensionless value determined from the fluorescence intensities (\\(I\\)) measured parallel (\\(I_{\\Vert}\\)) and perpendicular (\\(I_{\\perp}\\)) to the excitation plane: \\[p = \\frac{I_{\\Vert} - I_{\\perp}}{I_{\\Vert} + I_{\\perp}}\\]")
AnnotationAssertion(rdfs:comment goldbook:14135 "Fluorescence anisotropy (\\(r\\)) differs only in normalization and is determined from \\[r = (I_{\\Vert} - I_{\\perp})/(I_{\\Vert} + 2I_{\\perp})\\]"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14135 goldbook:14136)
AnnotationAssertion(mito:isMentionedBy goldbook:14135 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14135 "current"^^xsd:string)
Declaration(Class(goldbook:14136))
AnnotationAssertion(rdfs:label goldbook:14136 "fluorescence polarisation assay")
AnnotationAssertion(dcterms:description goldbook:14136 "Assay in which the association between an intrinsically fluorescent ligand, or a ligand linked to a fluorescent probe, and a larger macromolecule is detected.")
AnnotationAssertion(rdfs:comment goldbook:14136 "The degree to which the labeled ligand depolarizes plane-polarized light is directly proportional to the rate at which it tumbles in solution. Tumbling will be slower when the ligand is associated with the larger macromolecule as compared to free in solution, consequently resulting in a lower degree of depolarization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14136 goldbook:14135)
AnnotationAssertion(rdfs:seeAlso goldbook:14136 goldbook:14147)
AnnotationAssertion(mito:isMentionedBy goldbook:14136 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14136 "current"^^xsd:string)
Declaration(Class(goldbook:14137))
AnnotationAssertion(rdfs:label goldbook:14137 "fluorescence resonance energy transfer assay")
AnnotationAssertion(dcterms:description goldbook:14137 "Assay based on the nonradiative energy transfer that occurs when the emission spectrum of a fluorescent donor molecule overlaps with the absorption spectrum of an energy acceptor molecule.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14137 "FRET")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14137 "FRET assay")
AnnotationAssertion(rdfs:comment goldbook:14137 "The donor and the acceptor fluorophores are linked directly or indirectly to two binding partners, and energy transfer occurs when the fluorophores are in close proximity with proper alignment of donor and acceptor electronic dipoles, i.e., when the binding partners interact."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14137 "The fluorophores can be either of small molecule or protein nature."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14137 "Use of a donor with a long fluorescence lifetime allows time-delayed (or time-resolved) fluorescence measurement (TR-FRET), providing conditions where other fluorophores in the assay medium are not detected."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14137 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14137 "current"^^xsd:string)
Declaration(Class(goldbook:14138))
AnnotationAssertion(rdfs:label goldbook:14138 "functional assay")
AnnotationAssertion(dcterms:description goldbook:14138 "Assay in which the biological or physiological activity of the target is measured.")
AnnotationAssertion(mito:isMentionedBy goldbook:14138 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14138 "current"^^xsd:string)
Declaration(Class(goldbook:14139))
AnnotationAssertion(rdfs:label goldbook:14139 "heterogeneous assay")
AnnotationAssertion(dcterms:description goldbook:14139 "Assay in which the response is detected only after the physical separation by methods such as filtration or centrifugation of one or more assay components.")
AnnotationAssertion(rdfs:seeAlso goldbook:14139 goldbook:14140)
AnnotationAssertion(rdfs:seeAlso goldbook:14139 goldbook:14146)
AnnotationAssertion(mito:isMentionedBy goldbook:14139 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14139 "current"^^xsd:string)
Declaration(Class(goldbook:14140))
AnnotationAssertion(rdfs:label goldbook:14140 "heterogeneous binding assay")
AnnotationAssertion(dcterms:description goldbook:14140 "Assay in which one binding component is immobilized to a surface (e.g., cellular membrane, glass, gold, bead, or biopolymer layer) while its binding partner is freely diffusible.")
AnnotationAssertion(rdfs:comment goldbook:14140 "The extent of interaction between the binding partners is determined after their physical separation, which is usually achieved by filtration, centrifugation, magnetic field, or chromatography."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14140 "Used to qualitatively discriminate specific and non-specific interaction or quantitatively determine the concentration of a component part of a mixture."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14140 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14140 "current"^^xsd:string)
Declaration(Class(goldbook:14141))
AnnotationAssertion(rdfs:label goldbook:14141 "high-content screening assay")
AnnotationAssertion(dcterms:description goldbook:14141 "A cell-based assay that produces multiple biological readouts.")
AnnotationAssertion(rdfs:comment goldbook:14141 "Most commonly used in relation to the mathematical (quantitative) analysis of an image acquired using an automated microscope. Analysis algorithms are used to quantify cellular parameters (e.g., number, motility, neurite outgrowth, size, shape) and subcellular events (e.g., receptor internalization, protein translocation, protein expression nuclei shape)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14141 goldbook:14113)
AnnotationAssertion(mito:isMentionedBy goldbook:14141 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14141 "current"^^xsd:string)
Declaration(Class(goldbook:14142))
AnnotationAssertion(rdfs:label goldbook:14142 "high-performance liquid chromatography assay")
AnnotationAssertion(dcterms:description goldbook:14142 "Assay in which response is determined after the physical separation of assay components using high-performance liquid chromatography (HPLC) with concurrent detection, usually by monitoring absorbance at an appropriate wavelength.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14142 "HPLC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14142 "HPLC Assay")
AnnotationAssertion(rdfs:comment goldbook:14142 "Changes in the concentration of assay components at one or more times over the course of the assay can be determined by the relative area under the detection peaks as compared to assay controls and standards."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14142 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14142 "current"^^xsd:string)
Declaration(Class(goldbook:14143))
AnnotationAssertion(rdfs:label goldbook:14143 "high throughput")
AnnotationAssertion(dcterms:description goldbook:14143 "Relative term, applied to the generation of a large number of results in a short timeframe (e.g., \\(\\pu{E5}\\) in a week or a month).")
AnnotationAssertion(rdfs:comment goldbook:14143 "Usually achieved by employing some degree of automation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14143 goldbook:14200)
AnnotationAssertion(mito:isMentionedBy goldbook:14143 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14143 "current"^^xsd:string)
Declaration(Class(goldbook:14144))
AnnotationAssertion(rdfs:label goldbook:14144 "hit rate")
AnnotationAssertion(dcterms:description goldbook:14144 "Proportion of hits from a screen that displays confirmed activity beyond a minimum defined level, the hit threshold. It is expressed as a percentage of the number of samples screened.")
AnnotationAssertion(rdfs:seeAlso goldbook:14144 goldbook:14145)
AnnotationAssertion(mito:isMentionedBy goldbook:14144 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14144 "current"^^xsd:string)
Declaration(Class(goldbook:14145))
AnnotationAssertion(rdfs:label goldbook:14145 "hit threshold")
AnnotationAssertion(dcterms:description goldbook:14145 "Minimum activity that defines actives in a primary screen.")
AnnotationAssertion(rdfs:comment goldbook:14145 "It is usually expressed as percentage of inhibition or stimulation relative to assay controls."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14145 "A widely used hit threshold is \\(\\pu{50\\%}\\) inhibition. A more statistically meaningful and equally common threshold is three standard deviations from the mean."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14145 goldbook:14105)
AnnotationAssertion(rdfs:seeAlso goldbook:14145 goldbook:14184)
AnnotationAssertion(mito:isMentionedBy goldbook:14145 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14145 "current"^^xsd:string)
Declaration(Class(goldbook:14146))
AnnotationAssertion(rdfs:label goldbook:14146 "homogeneous assay")
AnnotationAssertion(dcterms:description goldbook:14146 "Assay in which all reagents and reactants are of a uniform phase (typically, liquid phase) and assay response is detected without the need for physical separation of assay components.")
AnnotationAssertion(rdfs:seeAlso goldbook:14146 goldbook:14139)
AnnotationAssertion(mito:isMentionedBy goldbook:14146 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14146 "current"^^xsd:string)
Declaration(Class(goldbook:14147))
AnnotationAssertion(rdfs:label goldbook:14147 "homogeneous binding assay")
AnnotationAssertion(dcterms:description goldbook:14147 "Single-phase system used to qualitatively discriminate between specific and nonspecific interactions or quantitatively determine the concentration of a component part of a mixture.")
AnnotationAssertion(rdfs:seeAlso goldbook:14147 goldbook:14136)
AnnotationAssertion(mito:isMentionedBy goldbook:14147 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14147 "current"^^xsd:string)
Declaration(Class(goldbook:14148))
AnnotationAssertion(rdfs:label goldbook:14148 "image-based assay")
AnnotationAssertion(dcterms:description goldbook:14148 "Assay in which image analysis algorithms that determine the compartmentalization of fluorescent probes give topological as well as quantitative information.")
AnnotationAssertion(rdfs:comment goldbook:14148 "The use of automated cellular imaging for screening has been made possible by the development of digital imaging technology."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14148 goldbook:14141)
AnnotationAssertion(mito:isMentionedBy goldbook:14148 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14148 "current"^^xsd:string)
Declaration(Class(goldbook:14149))
AnnotationAssertion(rdfs:label goldbook:14149 "immobilised metal ion affinity-based fluorescence polarisation assay")
AnnotationAssertion(dcterms:description goldbook:14149 "Assay in which the interaction between nanoparticles coated with triply charged metal ions and phosphate groups on a substrate that carries a fluorescent tag is detected.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14149 "IMAP™")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14149 "IMAP™ assay")
AnnotationAssertion(rdfs:comment goldbook:14149 "The phosphorylated fluorescent substrate bound to the nanoparticle will exhibit high fluorescence polarization relative to the unbound (unphosphorylated) peptide substrate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14149 "Used for kinase assays where a phosphate group is added to a peptide substrate or for phosphatase assays where the phosphate is removed from a peptide substrate."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14149 goldbook:14135)
AnnotationAssertion(mito:isMentionedBy goldbook:14149 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14149 "current"^^xsd:string)
Declaration(Class(goldbook:14150))
AnnotationAssertion(rdfs:label goldbook:14150 "inactive")
AnnotationAssertion(dcterms:description goldbook:14150 "Sample that, at the tested concentration, does not produce a response above the hit threshold in an assay.")
AnnotationAssertion(rdfs:comment goldbook:14150 "A sample may also be designated as inactive when attempts to confirm an active fail."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14150 goldbook:14105)
AnnotationAssertion(rdfs:seeAlso goldbook:14150 goldbook:14108)
AnnotationAssertion(mito:isMentionedBy goldbook:14150 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14150 "current"^^xsd:string)
Declaration(Class(goldbook:14151))
AnnotationAssertion(rdfs:label goldbook:14151 "inverse agonist")
AnnotationAssertion(dcterms:description goldbook:14151 "Ligand that decreases signaling through a receptor below the level of constitutive activity.")
AnnotationAssertion(rdfs:comment goldbook:14151 "Several receptors, especially when expressed at high levels, exhibit constitutively active signaling. Demonstrating an inverse agonist effect is dependent upon the constitutive activity of the particular receptor which is manifested in the absence of a conventional agonist. Upwards of \\(\\pu{85\\%}\\) of antagonists identified in screens of GPCRs are actually inverse agonists."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14151 goldbook:14174)
AnnotationAssertion(mito:isMentionedBy goldbook:14151 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14151 "current"^^xsd:string)
Declaration(Class(goldbook:14152))
AnnotationAssertion(rdfs:label goldbook:14152 "kinetic assay")
AnnotationAssertion(dcterms:description goldbook:14152 "Assay in which the time dependence of the signal intensity is measured. Signal values are typically acquired at several time intervals in order to calculate kinetic parameters.")
AnnotationAssertion(rdfs:comment goldbook:14152 "Kinetic assays are generally designed such that the change in signal with time is linear throughout the experiment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14152 goldbook:14128)
AnnotationAssertion(rdfs:seeAlso goldbook:14152 goldbook:14130)
AnnotationAssertion(mito:isMentionedBy goldbook:14152 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14152 "current"^^xsd:string)
Declaration(Class(goldbook:14153))
AnnotationAssertion(rdfs:label goldbook:14153 "label-free assay")
AnnotationAssertion(dcterms:description goldbook:14153 "Assay in which there is no requirement to modify one of the interacting components in order to facilitate signal detection.")
AnnotationAssertion(rdfs:comment goldbook:14153 "Used to monitor macromolecule/macromolecule or small-molecule/macromolecule binding, as well as cell adhesion or cell signaling."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14153 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14153 "current"^^xsd:string)
Declaration(Class(goldbook:14154))
AnnotationAssertion(rdfs:label goldbook:14154 "label-free detection")
AnnotationAssertion(dcterms:description goldbook:14154 "Direct detection of compound activity on a target without the requirement for a labeled reagent.")
AnnotationAssertion(mito:isMentionedBy goldbook:14154 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14154 "current"^^xsd:string)
Declaration(Class(goldbook:14155))
AnnotationAssertion(rdfs:label goldbook:14155 "lead identification")
AnnotationAssertion(dcterms:description goldbook:14155 "Process that is targeted toward the generation of at least one compound series that meets the requirements for progression to lead optimization.")
AnnotationAssertion(rdfs:comment goldbook:14155 "Typically, it encompasses the steps from the detection of initial activity (via high-throughput screening and other lead-finding activities) through hit confirmation and hit-to-lead activities."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14155 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14155 "current"^^xsd:string)
Declaration(Class(goldbook:14156))
AnnotationAssertion(rdfs:label goldbook:14156 "lead optimisation")
AnnotationAssertion(dcterms:description goldbook:14156 "Process in which the drug-like properties of an initial lead or lead series are improved.")
AnnotationAssertion(rdfs:comment goldbook:14156 "Typically, biological activity will be enhanced, in vivo efficacy will be demonstrated, and compounds with a physicochemical, pharmacological, and toxicological profile consistent with progression to the clinic will be identified."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14156 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14156 "current"^^xsd:string)
Declaration(Class(goldbook:14157))
AnnotationAssertion(rdfs:label goldbook:14157 "library")
AnnotationAssertion(dcterms:description goldbook:14157 "Collection of samples (e.g., chemical compounds, natural products, over-expression library of a microbe) available for screening. Set of compounds produced through combinatorial chemistry or other means that expands around a single core structure.")
AnnotationAssertion(mito:isMentionedBy goldbook:14157 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14157 "current"^^xsd:string)
Declaration(Class(goldbook:14158))
AnnotationAssertion(rdfs:label goldbook:14158 "ligand-activated channel")
AnnotationAssertion(dcterms:description goldbook:14158 "Any ion channel that is gated (i.e., opened or closed) by a ligand.")
AnnotationAssertion(rdfs:comment goldbook:14158 "Distinct from voltage-gated or stretch-activated ion channels."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14158 goldbook:14201)
AnnotationAssertion(mito:isMentionedBy goldbook:14158 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14158 "current"^^xsd:string)
Declaration(Class(goldbook:14159))
AnnotationAssertion(rdfs:label goldbook:14159 "liquid handler")
AnnotationAssertion(dcterms:description goldbook:14159 "Automated device that accurately and precisely delivers programmed, predefined quantities of liquid to a microplate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14159 "liquid handling machine")
AnnotationAssertion(rdfs:comment goldbook:14159 "It may be free-standing or incorporated as a workstation into a fully automated system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14159 goldbook:14110)
AnnotationAssertion(rdfs:seeAlso goldbook:14159 goldbook:14161)
AnnotationAssertion(rdfs:seeAlso goldbook:14159 goldbook:14202)
AnnotationAssertion(mito:isMentionedBy goldbook:14159 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14159 "current"^^xsd:string)
Declaration(Class(goldbook:14160))
AnnotationAssertion(rdfs:label goldbook:14160 "luminescence assay")
AnnotationAssertion(dcterms:description goldbook:14160 "Assay in which response is measured by the detection of light of a nonradiative origin, such as bioluminescence or chemiluminescence.")
AnnotationAssertion(mito:isMentionedBy goldbook:14160 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14160 "current"^^xsd:string)
Declaration(Class(goldbook:14161))
AnnotationAssertion(rdfs:label goldbook:14161 "microplate")
AnnotationAssertion(dcterms:description goldbook:14161 "Any of a number of plates containing a series of wells which may be used for storage or to perform individual assays.")
AnnotationAssertion(rdfs:comment goldbook:14161 "Typically, these plates are constructed of a variety of clear and opaque plastics, and can contain from 6 to 3456 individual wells."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14161 "White plates are typically used for luminescence, assay black plates for fluorescence assays, and clear plates for absorbance assays."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14161 goldbook:14162)
AnnotationAssertion(rdfs:seeAlso goldbook:14161 goldbook:14176)
AnnotationAssertion(mito:isMentionedBy goldbook:14161 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14161 "current"^^xsd:string)
Declaration(Class(goldbook:14162))
AnnotationAssertion(rdfs:label goldbook:14162 "microplate standards")
AnnotationAssertion(dcterms:description goldbook:14162 "Defined footprint, height, flanges, and well positions for 96-, 384-, and 1536-well microplates.")
AnnotationAssertion(rdfs:comment goldbook:14162 "These standards have been established by the Society for Biomolecular Sciences (SBS) and the American National Standards Institute (ANSI) and accredited by ANSI. They are numbered as ANSI-SBS-1 (2004) – Microplate footprint; ANSI-SBS-2 (2004) – Microplate Height; ANSI-SBS-3 (2004) – Microplate Flange; and ANSI-SBS-4 (2004) – Microplate Well Positions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14162 goldbook:14161)
AnnotationAssertion(mito:isMentionedBy goldbook:14162 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14162 "current"^^xsd:string)
Declaration(Class(goldbook:14163))
AnnotationAssertion(rdfs:label goldbook:14163 "miniaturisation")
AnnotationAssertion(dcterms:description goldbook:14163 "Experimental design aimed at decreasing the reaction volume of an assay and consequently the amount and cost of reagents.")
AnnotationAssertion(mito:isMentionedBy goldbook:14163 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14163 "current"^^xsd:string)
Declaration(Class(goldbook:14164))
AnnotationAssertion(rdfs:label goldbook:14164 "module")
AnnotationAssertion(dcterms:description goldbook:14164 "Individual automated device within a fully automated assay system that usually performs a complete single assay step or procedure.")
AnnotationAssertion(rdfs:comment goldbook:14164 "A fully enclosed module may allow for the control of temperature, humidity, and the gaseous environment."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14164 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14164 "current"^^xsd:string)
Declaration(Class(goldbook:14165))
AnnotationAssertion(rdfs:label goldbook:14165 "molecular imprinted polymers")
AnnotationAssertion(dcterms:description goldbook:14165 "Synthetic polymers in which well-defined volume cavities (imprints) created by template molecules mimic a biomolecular specific ligand–receptor interaction.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14165 "MIPs")
AnnotationAssertion(rdfs:comment goldbook:14165 "These artificially generated recognition sites have shapes, sizes, and functionalities complementary to the template molecule, and are capable of rebinding the template molecule in preference to other closely related structures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14165 "MIPs have found uses as stationary phases in chromatography, as recognition elements in chemosensors, and as enzyme mimics in catalysis."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14165 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14165 "current"^^xsd:string)
Declaration(Class(goldbook:14166))
AnnotationAssertion(rdfs:label goldbook:14166 "multiplex assay")
AnnotationAssertion(dcterms:description goldbook:14166 "Assay in which the activity of a single sample against more than one target is measured in a single test.")
AnnotationAssertion(mito:isMentionedBy goldbook:14166 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14166 "current"^^xsd:string)
Declaration(Class(goldbook:14167))
AnnotationAssertion(rdfs:label goldbook:14167 "natural product")
AnnotationAssertion(dcterms:description goldbook:14167 "Complex mixture derived from natural (biological) sources used in screening as a resource for identification of lead compounds. Pure compound of natural (biological) origin (whether obtained by purification of natural mixtures or by laboratory synthesis), as opposed to compounds originating from synthetic chemistry.Note: Typical origins include extracts from microbes and higher organisms from terrestrial or marine environments.")
AnnotationAssertion(mito:isMentionedBy goldbook:14167 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14167 "current"^^xsd:string)
Declaration(Class(goldbook:14168))
AnnotationAssertion(rdfs:label goldbook:14168 "negative assay control")
AnnotationAssertion(dcterms:description goldbook:14168 "Experimental conditions designed to produce the signal reflective of the absence of the process under investigation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14168 "low control")
AnnotationAssertion(rdfs:comment goldbook:14168 "For a binding or an activation mechanism, it is typically the signal measured in the absence of a test compound and is often relevant to the determination of the background signal. For an inhibitory or antagonist mechanism, it is the maximal signal, obtained in the absence of the reference inhibitor."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14168 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14168 "current"^^xsd:string)
Declaration(Class(goldbook:14169))
AnnotationAssertion(rdfs:label goldbook:14169 "noncompetitive binding assay")
AnnotationAssertion(dcterms:description goldbook:14169 "Assay in which the interaction of a ligand with a receptor is measured without a requirement for added competing agents. It can be homogeneous or heterogeneous.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14169 "indirect binding assay")
AnnotationAssertion(mito:isMentionedBy goldbook:14169 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14169 "current"^^xsd:string)
Declaration(Class(goldbook:14170))
AnnotationAssertion(rdfs:label goldbook:14170 "nuclease assay")
AnnotationAssertion(dcterms:description goldbook:14170 "Method used to determine the presence or quantify the amount of specific target nucleotide sequences.")
AnnotationAssertion(mito:isMentionedBy goldbook:14170 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14170 "current"^^xsd:string)
Declaration(Class(goldbook:14171))
AnnotationAssertion(rdfs:label goldbook:14171 "off-rate")
AnnotationAssertion(dcterms:description goldbook:14171 "Rate of dissociation of the enzyme-substrate (\\(\\ce{ES}\\)) complex to enzyme (\\(\\ce{E}\\)) and substrate (\\(\\ce{S}\\)) or of ligand–receptor (\\(\\ce{LR}\\)) to receptor (\\(\\ce{R}\\)) and ligand (\\(\\ce{L}\\)).")
AnnotationAssertion(mito:isMentionedBy goldbook:14171 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14171 "current"^^xsd:string)
Declaration(Class(goldbook:14172))
AnnotationAssertion(rdfs:label goldbook:14172 "on-rate")
AnnotationAssertion(dcterms:description goldbook:14172 "Rate of formation of the enzyme-substrate (\\(\\ce{ES}\\)) or ligand–receptor (\\(\\ce{LR}\\)) complex.")
AnnotationAssertion(mito:isMentionedBy goldbook:14172 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14172 "current"^^xsd:string)
Declaration(Class(goldbook:14173))
AnnotationAssertion(rdfs:label goldbook:14173 "orthosteric site")
AnnotationAssertion(dcterms:description goldbook:14173 "Binding site recognized by the endogenous agonist of a receptor.")
AnnotationAssertion(rdfs:seeAlso goldbook:14173 goldbook:14107)
AnnotationAssertion(mito:isMentionedBy goldbook:14173 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14173 "current"^^xsd:string)
Declaration(Class(goldbook:14174))
AnnotationAssertion(rdfs:label goldbook:14174 "partial agonist")
AnnotationAssertion(dcterms:description goldbook:14174 "Agonist that is unable to induce a maximal receptor response in a given biological assay, regardless of the amount applied.")
AnnotationAssertion(rdfs:seeAlso goldbook:14174 goldbook:14126)
AnnotationAssertion(mito:isMentionedBy goldbook:14174 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14174 "current"^^xsd:string)
Declaration(Class(goldbook:14175))
AnnotationAssertion(rdfs:label goldbook:14175 "pipettor")
AnnotationAssertion(dcterms:description goldbook:14175 "Device that aspirates and dispenses liquid (\\(\\pu{nL}\\) to \\(\\pu{mL}\\) range) for the purposes of transferring from a source to destination.")
AnnotationAssertion(rdfs:comment goldbook:14175 "The device may be fully manual, electronic, single-channel, multi-channel (typically 8- or 12-channel), or part of a liquid handler."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14175 goldbook:14159)
AnnotationAssertion(mito:isMentionedBy goldbook:14175 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14175 "current"^^xsd:string)
Declaration(Class(goldbook:14176))
AnnotationAssertion(rdfs:label goldbook:14176 "plate format")
AnnotationAssertion(dcterms:description goldbook:14176 "Number and configuration of wells on a microplate.")
AnnotationAssertion(rdfs:comment goldbook:14176 "The most widely used formats are arrays of 96 wells (8 by 12) or 384 wells (16 by 24) or 1536 wells (32 by 48)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14176 goldbook:14161)
AnnotationAssertion(rdfs:seeAlso goldbook:14176 goldbook:14162)
AnnotationAssertion(mito:isMentionedBy goldbook:14176 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14176 "current"^^xsd:string)
Declaration(Class(goldbook:14177))
AnnotationAssertion(rdfs:label goldbook:14177 "plate gripper")
AnnotationAssertion(dcterms:description goldbook:14177 "Handling device that positions microplates on a workstation.")
AnnotationAssertion(rdfs:comment goldbook:14177 "A plate gripper may also be used to move microplates between independent modules of an automated platform. Often used in combination with plate stackers, washers, and readers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14177 goldbook:14161)
AnnotationAssertion(mito:isMentionedBy goldbook:14177 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14177 "current"^^xsd:string)
Declaration(Class(goldbook:14178))
AnnotationAssertion(rdfs:label goldbook:14178 "plate map")
AnnotationAssertion(dcterms:description goldbook:14178 "Layout of samples and controls configured on a plate during an assay.")
AnnotationAssertion(rdfs:comment goldbook:14178 "For a primary screen in 384-well plates, columns 1, 2, and/or 23 and 24 are controls, and the remaining columns are for individual test compounds. For secondary screening, more complex layouts are used and each row may contain a single compound at varying concentrations."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14178 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14178 "current"^^xsd:string)
Declaration(Class(goldbook:14179))
AnnotationAssertion(rdfs:label goldbook:14179 "plate reader")
AnnotationAssertion(dcterms:description goldbook:14179 "Automated device that uses optical and/or computer vision techniques to detect biological, chemical, or physical events in samples stored in microplates.")
AnnotationAssertion(rdfs:comment goldbook:14179 "Use of plate readers reduces or eliminates human subjectivity in the evaluation of plate contents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14179 "Often used in conjunction with a plate stacker."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14179 "An absorbance plate reader measures color intensity in each well."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14179 goldbook:14110)
AnnotationAssertion(rdfs:seeAlso goldbook:14179 goldbook:14180)
AnnotationAssertion(mito:isMentionedBy goldbook:14179 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14179 "current"^^xsd:string)
Declaration(Class(goldbook:14180))
AnnotationAssertion(rdfs:label goldbook:14180 "plate stacker")
AnnotationAssertion(dcterms:description goldbook:14180 "Automated device that loads, unloads, and restacks microplates.")
AnnotationAssertion(rdfs:comment goldbook:14180 "The device is usually part of system that integrates a plate reader, a liquid handler, or other device to minimize manual microplate handling."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14180 goldbook:14110)
AnnotationAssertion(mito:isMentionedBy goldbook:14180 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14180 "current"^^xsd:string)
Declaration(Class(goldbook:14181))
AnnotationAssertion(rdfs:label goldbook:14181 "plate washer")
AnnotationAssertion(dcterms:description goldbook:14181 "Automated device used to wash the wells of microplates.")
AnnotationAssertion(rdfs:comment goldbook:14181 "The device usually has functions that allow precise height adjustment for minimized residual volume, and digitally controlled aspiration or dispensing pumps to provide high accuracy and flow control."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14181 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14181 "current"^^xsd:string)
Declaration(Class(goldbook:14182))
AnnotationAssertion(rdfs:label goldbook:14182 "positive assay control")
AnnotationAssertion(dcterms:description goldbook:14182 "Experimental conditions designed to produce the signal reflective of maximum biological effect in an assay.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14182 "high control")
AnnotationAssertion(rdfs:comment goldbook:14182 "For a binding or an activation mechanism, it is typically the signal measured in the presence of a test compound. For an inhibitory or antagonist mechanism, it is the minimum signal, obtained in the absence of the reference inhibitor."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14182 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14182 "current"^^xsd:string)
Declaration(Class(goldbook:14183))
AnnotationAssertion(rdfs:label goldbook:14183 "potency")
AnnotationAssertion(dcterms:description goldbook:14183 "Dose of drug required to produce a specific effect of given intensity as compared to a standard reference.")
AnnotationAssertion(rdfs:comment goldbook:14183 "Potency is a comparative rather than an absolute expression of drug activity. Drug potency depends on both affinity and efficacy. Thus, two agonists can be equipotent, but have different intrinsic efficacies with compensating differences in affinity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14183 "More potent compounds have lower \\(\\pu{IC_{50}}\\) or \\(\\pu{EC_{50}}\\) values implying that less is needed for an effect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14183 goldbook:14126)
AnnotationAssertion(mito:isMentionedBy goldbook:14183 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14183 "current"^^xsd:string)
Declaration(Class(goldbook:14184))
AnnotationAssertion(rdfs:label goldbook:14184 "primary screen")
AnnotationAssertion(dcterms:description goldbook:14184 "Initial screen applied to assess the activity of a collection of compounds and identify hits or actives against a biological target of interest.")
AnnotationAssertion(rdfs:comment goldbook:14184 "This screen identifies hits or actives from a library."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14184 goldbook:14105)
AnnotationAssertion(rdfs:seeAlso goldbook:14184 goldbook:14157)
AnnotationAssertion(rdfs:seeAlso goldbook:14184 goldbook:14191)
AnnotationAssertion(mito:isMentionedBy goldbook:14184 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14184 "current"^^xsd:string)
Declaration(Class(goldbook:14185))
AnnotationAssertion(rdfs:label goldbook:14185 "radioligand")
AnnotationAssertion(dcterms:description goldbook:14185 "Ligand into which a radioisotope has been incorporated as a label.")
AnnotationAssertion(mito:isMentionedBy goldbook:14185 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14185 "current"^^xsd:string)
Declaration(Class(goldbook:14186))
AnnotationAssertion(rdfs:label goldbook:14186 "robot")
AnnotationAssertion(dcterms:description goldbook:14186 "Automated device that performs tasks (i.e., screen functions) that would normally be performed by a human.")
AnnotationAssertion(rdfs:comment goldbook:14186 "A robot in laboratory automation is usually used to move microplates in an automated assay procedure and usually consists of either a robotic arm with at least three degrees of freedom or a plate gripper."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14186 goldbook:14161)
AnnotationAssertion(rdfs:seeAlso goldbook:14186 goldbook:14177)
AnnotationAssertion(rdfs:seeAlso goldbook:14186 goldbook:14189)
AnnotationAssertion(mito:isMentionedBy goldbook:14186 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14186 "current"^^xsd:string)
Declaration(Class(goldbook:14187))
AnnotationAssertion(rdfs:label goldbook:14187 "scheduling software")
AnnotationAssertion(dcterms:description goldbook:14187 "Computer program used to organize the chronological sequence of experimental methods to be followed to execute an automated high-throughput screening campaign.")
AnnotationAssertion(rdfs:comment goldbook:14187 "Based on the experimental needs of the campaign and constraints imposed by the programmer, this software uses an iterative process to determine the optimal order of the use of robots, liquid handlers, and modules to minimize screening time."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14187 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14187 "current"^^xsd:string)
Declaration(Class(goldbook:14188))
AnnotationAssertion(rdfs:label goldbook:14188 "scintillation proximity assay")
AnnotationAssertion(dcterms:description goldbook:14188 "Homogeneous assay in which beads incorporated with scintillant emit light in the presence of radiolabeled molecules within the proximity of the bead’s scintillant detection.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:14188 "SPA™")
AnnotationAssertion(rdfs:comment goldbook:14188 "An alternative form of the assay incorporates the scintillant into the base of a microplate instead of a bead (FlashPlate™)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14188 goldbook:14146)
AnnotationAssertion(mito:isMentionedBy goldbook:14188 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14188 "current"^^xsd:string)
Declaration(Class(goldbook:14189))
AnnotationAssertion(rdfs:label goldbook:14189 "screen")
AnnotationAssertion(dcterms:description goldbook:14189 "Execution, analysis, and interpretation of a large number of assays to evaluate the activity of a collection of samples against a target.")
AnnotationAssertion(rdfs:comment goldbook:14189 "A screen will often employ automation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14189 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14189 "current"^^xsd:string)
Declaration(Class(goldbook:14190))
AnnotationAssertion(rdfs:label goldbook:14190 "screen validation")
AnnotationAssertion(dcterms:description goldbook:14190 "Assay conditions, as determined by assay validation, are performed in the chosen plate format with an acceptable signal to background ratio as described by the Z′ factor.")
AnnotationAssertion(rdfs:comment goldbook:14190 "Validation typically requires testing a number of samples a minimum of three times and allows for the estimation of false positives, false negatives, and the selection of statistically significant thresholds."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14190 goldbook:14109)
AnnotationAssertion(rdfs:seeAlso goldbook:14190 goldbook:14176)
AnnotationAssertion(mito:isMentionedBy goldbook:14190 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14190 "current"^^xsd:string)
Declaration(Class(goldbook:14191))
AnnotationAssertion(rdfs:label goldbook:14191 "secondary screen")
AnnotationAssertion(dcterms:description goldbook:14191 "Screen applied to independently confirm actives from the primary screen.")
AnnotationAssertion(rdfs:comment goldbook:14191 "A secondary screen may employ an assay that differs in type from the primary screen (e.g., biochemical assay vs. cell-based assay) or it may be of the same type with different readout."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14191 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14191 "current"^^xsd:string)
Declaration(Class(goldbook:14192))
AnnotationAssertion(rdfs:label goldbook:14192 "selectivity assay")
AnnotationAssertion(dcterms:description goldbook:14192 "Assay used to determine the relative potency of active or lead compounds toward an alternative target.")
AnnotationAssertion(rdfs:comment goldbook:14192 "A selectivity assay (or panel of assays) may include targets of the same family or unrelated targets."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14192 goldbook:14124)
AnnotationAssertion(mito:isMentionedBy goldbook:14192 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14192 "current"^^xsd:string)
Declaration(Class(goldbook:14193))
AnnotationAssertion(rdfs:label goldbook:14193 "stably transfected cells")
AnnotationAssertion(dcterms:description goldbook:14193 "Eukaryotic cells into which recombinant DNA has been introduced and incorporated into the genome, so that the cells replicate the new DNA in a stable fashion.")
AnnotationAssertion(rdfs:comment goldbook:14193 "The biological material thus obtained is expected to show low variability and therefore increase assay reproducibility."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14193 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14193 "current"^^xsd:string)
Declaration(Class(goldbook:14194))
AnnotationAssertion(rdfs:label goldbook:14194 "standard error of the mean")
AnnotationAssertion(dcterms:description goldbook:14194 "Sample standard deviation divided by the square root of the sample size.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14194 "SEM")
AnnotationAssertion(mito:isMentionedBy goldbook:14194 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14194 "current"^^xsd:string)
Declaration(Class(goldbook:14195))
AnnotationAssertion(rdfs:label goldbook:14195 "sublibrary")
AnnotationAssertion(dcterms:description goldbook:14195 "Portion of a library that is grouped or selected based on similarity of structure or biological effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:14195 goldbook:14157)
AnnotationAssertion(mito:isMentionedBy goldbook:14195 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14195 "current"^^xsd:string)
Declaration(Class(goldbook:14196))
AnnotationAssertion(rdfs:label goldbook:14196 "surface plasmon resonance assay")
AnnotationAssertion(dcterms:description goldbook:14196 "Assay in which the binding of a ligand to a target immobilized on the gold surface of a chip is detected by changes in the angle of the light reflected from the surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14196 "SPR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14196 "SPR Assay")
AnnotationAssertion(rdfs:comment goldbook:14196 "This assay type is not usually used for high-throughput screening but has been expanded to multiple simultaneous detection channels and has improved sensitivity to detect low-molecular-weight binding molecules."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14196 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14196 "current"^^xsd:string)
Declaration(Class(goldbook:14197))
AnnotationAssertion(rdfs:label goldbook:14197 "targeted library")
AnnotationAssertion(dcterms:description goldbook:14197 "Library designed, on the basis of preexisting information, to generate enhanced activity or hit rate against a particular biological target or target class.")
AnnotationAssertion(mito:isMentionedBy goldbook:14197 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14197 "current"^^xsd:string)
Declaration(Class(goldbook:14198))
AnnotationAssertion(rdfs:label goldbook:14198 "total internal reflection fluorescence")
AnnotationAssertion(dcterms:description goldbook:14198 "Spectroscopic technique that discriminates between labeled molecules in the homogeneous phase and those interacting with binding partners immobilized at a surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14198 "TIRF")
AnnotationAssertion(rdfs:comment goldbook:14198 "TIRF measurements are restricted to a thin layer and are achieved by exciting the fluorophore with an evanescent wave, created by total internal reflection at the glass/aqueous interface of the wave guide. The goal of using TIRF in biological applications is to study events close to the interface of two different media."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14198 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14198 "current"^^xsd:string)
Declaration(Class(goldbook:14199))
AnnotationAssertion(rdfs:label goldbook:14199 "transiently transfected cells")
AnnotationAssertion(dcterms:description goldbook:14199 "Eukaryotic cells into which recombinant DNA has been introduced and expressed by cellular transcription, but without incorporation into the stable genome.")
AnnotationAssertion(mito:isMentionedBy goldbook:14199 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14199 "current"^^xsd:string)
Declaration(Class(goldbook:14200))
AnnotationAssertion(rdfs:label goldbook:14200 "ultra-high throughput")
AnnotationAssertion(dcterms:description goldbook:14200 "Relative term, currently applied to the screening of \\(\\pu{E5}\\) test samples in a \\(\\pu{24\\!\\mbox{-}h}\\) period.")
AnnotationAssertion(rdfs:seeAlso goldbook:14200 goldbook:14143)
AnnotationAssertion(mito:isMentionedBy goldbook:14200 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14200 "current"^^xsd:string)
Declaration(Class(goldbook:14201))
AnnotationAssertion(rdfs:label goldbook:14201 "voltage-activated channel")
AnnotationAssertion(dcterms:description goldbook:14201 "Ion channel that is specifically activated, or gated, by the surrounding potential difference across the cell membrane near the channel (or near the cell, neuron, or synapse).")
AnnotationAssertion(mito:isMentionedBy goldbook:14201 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14201 "current"^^xsd:string)
Declaration(Class(goldbook:14202))
AnnotationAssertion(rdfs:label goldbook:14202 "workstation")
AnnotationAssertion(dcterms:description goldbook:14202 "Programmable device used to automate a single operation (such as liquid handling) on a microplate supplied to the device by a robot (automated stacker system or a robotic manipulator).")
AnnotationAssertion(rdfs:seeAlso goldbook:14202 goldbook:14161)
AnnotationAssertion(rdfs:seeAlso goldbook:14202 goldbook:14186)
AnnotationAssertion(mito:isMentionedBy goldbook:14202 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14202 "current"^^xsd:string)
Declaration(Class(goldbook:14203))
AnnotationAssertion(rdfs:label goldbook:14203 "Z factor")
AnnotationAssertion(dcterms:description goldbook:14203 "Dimensionless statistical parameter that provides a practical assessment of assay performance in the presence of test compounds. \\[Z = 1 - 3(\\sigma_{\\rm{s}} + \\sigma_{\\rm{c}})/\\vert\\mu_{\\rm{s}} - \\mu_{\\rm{c}}\\vert\\] where \\(\\mu_{\\rm{s}}\\) denotes the mean of the library sample signal, \\(\\mu_{\\rm{c}}\\) the mean of the control signal and \\(\\sigma_{\\rm{s}}\\), \\(\\sigma_{\\rm{c}}\\) the corresponding standard deviations. \\(1 \\gt Z \\ge 0.5\\) generally categorizes an excellent assay.")
AnnotationAssertion(mito:isMentionedBy goldbook:14203 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14203 "current"^^xsd:string)
Declaration(Class(goldbook:14204))
AnnotationAssertion(rdfs:label goldbook:14204 "Z′ factor")
AnnotationAssertion(dcterms:description goldbook:14204 "Dimensionless statistical parameter used extensively in biomolecular screening, and a characteristic of an assay without the intervention of test compounds. It provides a practical index of the quality and reliability of the assay, and can be used as a guide to assay development and optimization. \\[Z' = 1 - 3(\\sigma_{\\rm{c^{+}}} + \\sigma_{\\rm{c^{-}}})/(\\vert\\mu_{\\rm{c^{+}}} - \\mu_{\\rm{c^{-}}}\\vert)\\] where \\(\\sigma_{\\rm{c^{+}}}\\) and \\(\\sigma_{\\rm{c^{-}}}\\) are the standard deviations of the high and low controls and \\(\\mu_{\\rm{c^{+}}}\\) and \\(\\mu_{\\rm{c^{-}}}\\) are the means of the high and low controls, respectively. A graphical illustration of the parameters used in the calculation of \\(Z'\\) is provided below.")
AnnotationAssertion(rdfs:comment goldbook:14204 "The useful range of \\(Z'\\) values is from 0 (very poor) to +1 (excellent). In most cases, a \\(Z'\\) factor greater than \\(\\pu{0.5}\\) is required for an assay to be accepted for high-throughput screening."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14204 doi:10.1351/PAC-REC-09-05-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14204 "current"^^xsd:string)
Declaration(Class(goldbook:14205))
AnnotationAssertion(rdfs:label goldbook:14205 "two-phase model")
AnnotationAssertion(dcterms:description goldbook:14205 "Model based on the assumption that the polymer sample consists only of domains of a crystalline phase and of an amorphous phase.")
AnnotationAssertion(mito:isMentionedBy goldbook:14205 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14205 "current"^^xsd:string)
Declaration(Class(goldbook:14206))
AnnotationAssertion(rdfs:label goldbook:14206 "axial advancement per constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:14206 "Projected length of a constitutional repeating unit (CRU) on the chain axis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14206 "unit height")
AnnotationAssertion(rdfs:comment goldbook:14206 "The axial advancement per CRU is characteristic of the conformation of a polymer chain. A large axial advancement per CRU is said to define a more extended conformation and a small axial advancement per CRU is said to define a more contracted conformation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14206 "The value of \\(h\\) is obtained from the equation \\[h = \\frac{c}{M_{\\rm{R}}}\\] where \\(c\\) is the chain identity period and \\(M_{\\rm{R}}\\) is the number of CRUs in \\(c\\). In cases where the equivalence postulate does not apply, \\(h\\) is an average value."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14206 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14206 "current"^^xsd:string)
Declaration(Class(goldbook:14207))
AnnotationAssertion(rdfs:label goldbook:14207 "directional chain")
AnnotationAssertion(dcterms:description goldbook:14207 "Polymer chain that may be oriented in two distinguishable, opposite directions along the chain axis.")
AnnotationAssertion(rdfs:comment goldbook:14207 "The two possible chain orientations can be mutually interconverted through a rotation around a twofold axis orthogonal to the chain axis."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14207 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14207 "current"^^xsd:string)
Declaration(Class(goldbook:14208))
AnnotationAssertion(rdfs:label goldbook:14208 "directional stem")
AnnotationAssertion(dcterms:description goldbook:14208 "Stem of a directional chain.")
AnnotationAssertion(rdfs:seeAlso goldbook:14208 goldbook:14207)
AnnotationAssertion(mito:isMentionedBy goldbook:14208 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14208 "current"^^xsd:string)
Declaration(Class(goldbook:14209))
AnnotationAssertion(rdfs:label goldbook:14209 "helix pitch")
AnnotationAssertion(dcterms:description goldbook:14209 "Distance between successive helical windings projected on the chain axis.")
AnnotationAssertion(rdfs:comment goldbook:14209 "The value of \\(p\\) is obtained from the equation \\[p = \\frac{c}{N}\\] where \\(c\\) is the chain identity period and \\(N\\) is the number of helical windings in \\(c\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14209 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14209 "current"^^xsd:string)
Declaration(Class(goldbook:14210))
AnnotationAssertion(rdfs:label goldbook:14210 "ideal crystalline chain conformation")
AnnotationAssertion(dcterms:description goldbook:14210 "Minimum energy conformation of an isolated polymer chain constructed according to the equivalence postulate and approximating the conformation found in a crystalline phase.")
AnnotationAssertion(rdfs:comment goldbook:14210 "If the symmetry elements present in the crystal do not correspond with those that characterize the ideal crystalline chain conformation, the chain conformation may be distorted in the crystal."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14210 "Symmetry elements characterizing the ideal crystalline chain conformation may be noncrystallographic (see rod group), i.e., they may not apply to the packing in certain crystal polymorphs. For example, the ideal crystalline chain conformation of isotactic polypropylene is \\(3_{1}\\) helix but, while the \\(\\ce{\\upbeta\\mbox{-}phase}\\) crystal structure allows for the helical \\(3_{1}\\) symmetry operator, the \\(\\ce{\\upalpha\\mbox{-}}\\) or the \\(\\ce{\\upgamma\\mbox{-}phase}\\) of this polymer do not."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14210 goldbook:14219)
AnnotationAssertion(rdfs:seeAlso goldbook:14210 goldbook:14214)
AnnotationAssertion(mito:isMentionedBy goldbook:14210 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14210 "current"^^xsd:string)
Declaration(Class(goldbook:14211))
AnnotationAssertion(rdfs:label goldbook:14211 "left-handed helix")
AnnotationAssertion(dcterms:description goldbook:14211 "Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds clockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period).")
AnnotationAssertion(rdfs:comment goldbook:14211 "In compliance with prevailing stereochemical terminology conventions the descriptor \\(M\\) (minus) is recommended rather than \\(L\\), presently widely used in polymer literature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14211 goldbook:14213)
AnnotationAssertion(mito:isMentionedBy goldbook:14211 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14211 "current"^^xsd:string)
Declaration(Class(goldbook:14212))
AnnotationAssertion(rdfs:label goldbook:14212 "multiple helix")
AnnotationAssertion(dcterms:description goldbook:14212 "Helical arrangement comprising two or more intertwined helical chains sharing the same axis.")
AnnotationAssertion(rdfs:comment goldbook:14212 "The intertwined helical chains are usually identical and displaced along the chain axis direction by \\(c/n\\), where \\(c\\) is the chain identity period of the single helix and \\(n\\) the number of helices in the multiple helix."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14212 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14212 "current"^^xsd:string)
Declaration(Class(goldbook:14213))
AnnotationAssertion(rdfs:label goldbook:14213 "right-handed helix")
AnnotationAssertion(dcterms:description goldbook:14213 "Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds anticlockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period).")
AnnotationAssertion(rdfs:comment goldbook:14213 "In compliance with prevailing stereochemical terminology conventions, the descriptor \\(P\\) (plus) is recommended rather than \\(R\\), presently widely used in polymer literature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14213 goldbook:14211)
AnnotationAssertion(mito:isMentionedBy goldbook:14213 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14213 "current"^^xsd:string)
Declaration(Class(goldbook:14214))
AnnotationAssertion(rdfs:label goldbook:14214 "rod group")
AnnotationAssertion(dcterms:description goldbook:14214 "Symmetry group of a three-dimensional array of atoms, regularly repeating along one direction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14214 "line repetition group")
AnnotationAssertion(rdfs:comment goldbook:14214 "The symmetry of isolated polymer chains, with translational periodicity along the chain axis direction, may be described by either the rod group, or the equivalent line-repetition-group approach. Whereas the line-repetition-group description has been developed in the polymer science community, rod groups originate in the crystallographic community and are more systematic. Table 1 shows the symmetry group symbols of some linear polymers according to both the rod-group and the line-repetitiongroup description."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14214 "Details concerning the symbols used are explained in crystallographic literature can be found in the recommendation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14214 "For reasons related to space filling, in the case of crystallographic rod groups, only two-, three-, four-, and sixfold screw axes are taken into consideration. Such limitations do not exist in the case of isolated chains for which any helical symmetry may, in principle, be acceptable. In other words, rod groups in are a subset of those applicable to ideal crystalline chain conformations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14214 goldbook:14210)
AnnotationAssertion(mito:isMentionedBy goldbook:14214 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14214 "current"^^xsd:string)
Declaration(Class(goldbook:14215))
AnnotationAssertion(rdfs:label goldbook:14215 "rotation per helix residue")
AnnotationAssertion(dcterms:description goldbook:14215 "Angle of rotation about the chain axis per helix residue.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14215 "unit twist")
AnnotationAssertion(rdfs:comment goldbook:14215 "The value of \\(t\\) is obtained from the equation \\[t = \\frac{2\\pi N}{M}\\] where \\(N\\) is the number of helix turns in a chain identity period \\(c\\) and \\(M\\) is the number of helix residues in \\(c\\). In cases where the equivalence postulate does not apply, \\(t\\) is an average value."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14215 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14215 "current"^^xsd:string)
Declaration(Class(goldbook:14216))
AnnotationAssertion(rdfs:label goldbook:14216 "translational chain repeating unit")
AnnotationAssertion(dcterms:description goldbook:14216 "Smallest structural unit of a polymer chain that is repeated by translation in the crystal lattice along the chain axis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14216 "fiber repeat unit")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14216 "physical repeating unit")
AnnotationAssertion(rdfs:comment goldbook:14216 "The translational chain repeating unit may differ for different crystal polymorphs of a given crystalline polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14216 goldbook:14219)
AnnotationAssertion(mito:isMentionedBy goldbook:14216 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14216 "current"^^xsd:string)
Declaration(Class(goldbook:14217))
AnnotationAssertion(rdfs:label goldbook:14217 "anticlined stems")
AnnotationAssertion(dcterms:description goldbook:14217 "Stems in a crystal having opposite side-group orientations with respect to the chain axis (see (a) in figure).(a) Pairs of anticlined stems and (b) pairs of isoclined stems of regioregular poly(3-butylthiophene), i.e., poly(3-n-butylthiophene-2,5-diyl). Since regioregular poly(3-n-butylthiophene-2,5-diyl) is also a directional chain, (a) is an example of antidirectional packing of two chains, while (b) is an example of isodirectional packing.")
AnnotationAssertion(rdfs:comment goldbook:14217 "Anticlined stems occur in crystalline poly-α-olefins, and also in regioregular poly(3-alkylthiophenes), polyphosphazenes, and polysiloxanes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14217 goldbook:14218)
AnnotationAssertion(rdfs:seeAlso goldbook:14217 goldbook:14207)
AnnotationAssertion(rdfs:seeAlso goldbook:14217 goldbook:14222)
AnnotationAssertion(rdfs:seeAlso goldbook:14217 goldbook:14223)
AnnotationAssertion(mito:isMentionedBy goldbook:14217 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14217 "current"^^xsd:string)
Declaration(Class(goldbook:14218))
AnnotationAssertion(rdfs:label goldbook:14218 "antidirectional packing")
AnnotationAssertion(dcterms:description goldbook:14218 "In a parallel-chain crystal, the crystalline packing of directional stems with opposite chain axis orientations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14218 "antiparallel packing")
AnnotationAssertion(rdfs:comment goldbook:14218 "Usually, stems of opposite orientations occur in equal numbers in parallel-chain crystals."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14218 goldbook:14208)
AnnotationAssertion(mito:isMentionedBy goldbook:14218 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14218 "current"^^xsd:string)
Declaration(Class(goldbook:14219))
AnnotationAssertion(rdfs:label goldbook:14219 "crystal polymorph")
AnnotationAssertion(dcterms:description goldbook:14219 "One of the different crystalline phases in which a given substance is able to crystallize.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14219 "crystal modification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14219 "crystalline form")
AnnotationAssertion(rdfs:comment goldbook:14219 "Different polymer crystal polymorphs are characterized by different crystal lattices and different packing of stems."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14219 "A given polymer in its different crystal polymorphs may display the same conformation and the same chain identity period, but possibly involve packing of isochiral only or of enantiomeric helices (e.g., isotactic polypropylene in its \\(\\ce{\\upalpha\\mbox{-}form}\\), \\(\\ce{\\upbeta\\mbox{-}form}\\), and \\(\\ce{\\upgamma\\mbox{-}form}\\); syndiotactic polypropylene, forms I and II. Polymorphs are, in such cases, isoconformational, and polymorphism is determined only by different modes of packing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14219 "In other cases, along with the packing, the local conformations of chains are different in its different crystal polymorphs. The chain identity period and the symmetry will also differ (e.g., isotactic poly(but-1-ene), crystal forms I, II, and III; syndiotactic polypropylene, crystalline forms I, III, and IV)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14219 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14219 "current"^^xsd:string)
Declaration(Class(goldbook:14220))
AnnotationAssertion(rdfs:label goldbook:14220 "frustration")
AnnotationAssertion(dcterms:description goldbook:14220 "Feature of crystalline packing characterized by different crystalline arrangements of chain stems at two (or more) sites that would be expected to be equivalent.")
AnnotationAssertion(rdfs:comment goldbook:14220 "The term \"frustration\" signifies that some chains can achieve the minimum energycconformation or an optimal packing arrangement, while others cannot."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14220 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14220 "current"^^xsd:string)
Declaration(Class(goldbook:14221))
AnnotationAssertion(rdfs:label goldbook:14221 "isochiral stem packing")
AnnotationAssertion(dcterms:description goldbook:14221 "Crystalline packing of stems having the same helicity.")
AnnotationAssertion(rdfs:comment goldbook:14221 "The term is applicable to macromolecules that are chiral or adopt a chiral conformation in the crystal (e.g., a helical conformation)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14221 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14221 "current"^^xsd:string)
Declaration(Class(goldbook:14222))
AnnotationAssertion(rdfs:label goldbook:14222 "isoclined stems")
AnnotationAssertion(dcterms:description goldbook:14222 "Stems in a crystal having the same side-group orientation with respect to the chain axis (see figure (b) in anticlined stems).")
AnnotationAssertion(rdfs:comment goldbook:14222 "Isoclined stems occur, for example, in crystalline poly-α-olefins, regioregular poly(3-alkylthiophenes), polyphosphazenes, and polysiloxanes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14222 goldbook:14217)
AnnotationAssertion(mito:isMentionedBy goldbook:14222 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14222 "current"^^xsd:string)
Declaration(Class(goldbook:14223))
AnnotationAssertion(rdfs:label goldbook:14223 "isodirectional packing")
AnnotationAssertion(dcterms:description goldbook:14223 "In a parallel-chain crystal, the crystalline packing of directional stems with the same chain axis orientation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14223 "parallel packing")
AnnotationAssertion(rdfs:comment goldbook:14223 "The term \"isodirectional packing\" is less ambiguous than the more common \"parallel packing\". The latter is often used in the description of crystalline polymorphs of natural polymers (e.g., cellulose I)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14223 "Crystal packings in which all chains are isodirectional are very unlikely in the case of synthetic polymers except in as-polymerized systems, provided a directional extendedchain crystallization process immediately follows polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14223 goldbook:14208)
AnnotationAssertion(mito:isMentionedBy goldbook:14223 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14223 "current"^^xsd:string)
Declaration(Class(goldbook:14224))
AnnotationAssertion(rdfs:label goldbook:14224 "packing of chain stems")
AnnotationAssertion(dcterms:description goldbook:14224 "Spatial arrangement of polymer chain stems in a polymer crystal.")
AnnotationAssertion(rdfs:comment goldbook:14224 "Crystals require tridimensional translational periodicity in their packing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14224 "The mode of packing is influenced by the kinetics and thermodynamics of the crystallization process. In some cases, pre-existing structural organization and chain folding may also play a role."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14224 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14224 "current"^^xsd:string)
Declaration(Class(goldbook:14225))
AnnotationAssertion(rdfs:label goldbook:14225 "polymorphic polymer crystal")
AnnotationAssertion(dcterms:description goldbook:14225 "Polymer crystal formed by domains of different crystal polymorphs of the same polymer.")
AnnotationAssertion(rdfs:comment goldbook:14225 "Isotactic polypropylene has been shown to form crystals containing \\(\\ce{\\upalpha\\mbox{-}}\\) and \\(\\ce{\\upgamma\\mbox{-}phase}\\) domains in which well-defined relationships between the lattices of the two phases in different domains are preserved."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14225 goldbook:14219)
AnnotationAssertion(mito:isMentionedBy goldbook:14225 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14225 "current"^^xsd:string)
Declaration(Class(goldbook:14226))
AnnotationAssertion(rdfs:label goldbook:14226 "racemic packing")
AnnotationAssertion(dcterms:description goldbook:14226 "Packing in a polymer crystal in which stems of opposite helicity coexist in equal numbers.")
AnnotationAssertion(rdfs:comment goldbook:14226 "Applicable to macromolecules that are chiral or adopt chiral conformations in the crystal. One example of the former case is the crystal structure in which poly(ʟ-lactide) and poly(ᴅ-lactide) stems coexist in equal numbers, i.e., the so-called polylactide stereocomplex. The second case is much more frequent: it applies to most isotactic vinyl polymer crystal polymorphs where the polymer chains are not intrinsically chiral but adopt helical, and thus chiral conformations. Left-handed helices and right-handed helices are, however, isoenergetic and equiprobable and coexist in equal numbers, often giving rise to centrosymmetric crystals."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14226 goldbook:14211)
AnnotationAssertion(rdfs:seeAlso goldbook:14226 goldbook:14219)
AnnotationAssertion(rdfs:seeAlso goldbook:14226 goldbook:14213)
AnnotationAssertion(mito:isMentionedBy goldbook:14226 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14226 "current"^^xsd:string)
Declaration(Class(goldbook:14227))
AnnotationAssertion(rdfs:label goldbook:14227 "symmetry breaking")
AnnotationAssertion(dcterms:description goldbook:14227 "Vanishing, in a specific crystal polymorph, of selected symmetry elements present in other crystal polymorphs, or in selected minimum energy conformations of isolated molecules of a given substance.")
AnnotationAssertion(rdfs:comment goldbook:14227 "The symmetry elements that vanish are frequently intramolecular. Symmetry breaking in polymers in such cases leads to deviations from the ideal crystalline chain conformation and from the equivalence postulate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14227 "Crystal polymorphs affected by symmetry breaking are usually stable at low temperature under conditions that optimize packing energy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14227 goldbook:14219)
AnnotationAssertion(rdfs:seeAlso goldbook:14227 goldbook:14210)
AnnotationAssertion(mito:isMentionedBy goldbook:14227 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14227 "current"^^xsd:string)
Declaration(Class(goldbook:14228))
AnnotationAssertion(rdfs:label goldbook:14228 "orientational disorder")
AnnotationAssertion(dcterms:description goldbook:14228 "Structural disorder at given crystallographic positions, resulting from the statistical coexistence within crystals of directional stems with opposite orientations.")
AnnotationAssertion(rdfs:comment goldbook:14228 "A typical example is provided by the statistical coexistence of chains with opposite orientations at each crystallographic position in the crystal structures of poly-α-olefins, for example, in the \\(\\ce{\\upalpha\\mbox{-}form}\\) of polypropylene."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14228 goldbook:14208)
AnnotationAssertion(mito:isMentionedBy goldbook:14228 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14228 "current"^^xsd:string)
Declaration(Class(goldbook:14229))
AnnotationAssertion(rdfs:label goldbook:14229 "paracrystal")
AnnotationAssertion(dcterms:description goldbook:14229 "Crystal model characterized by lattice distortions and hence by limited order along given lattice directions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14229 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14229 "current"^^xsd:string)
Declaration(Class(goldbook:14230))
AnnotationAssertion(rdfs:label goldbook:14230 "paracrystalline disorder of the first kind")
AnnotationAssertion(dcterms:description goldbook:14230 "Structural disorder in a paracrystal, resulting from uncorrelated displacements of the atoms around their average positions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14230 "uncorrelated paracrystalline disorder")
AnnotationAssertion(rdfs:comment goldbook:14230 "Displacements are generally due to thermal vibrations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14230 goldbook:14229)
AnnotationAssertion(mito:isMentionedBy goldbook:14230 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14230 "current"^^xsd:string)
Declaration(Class(goldbook:14231))
AnnotationAssertion(rdfs:label goldbook:14231 "paracrystalline disorder of the second kind")
AnnotationAssertion(dcterms:description goldbook:14231 "Structural disorder in a paracrystal, resulting from permanent atomic displacements from the ordered crystallographic positions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14231 "correlated paracrystalline disorder")
AnnotationAssertion(rdfs:seeAlso goldbook:14231 goldbook:14229)
AnnotationAssertion(mito:isMentionedBy goldbook:14231 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14231 "current"^^xsd:string)
Declaration(Class(goldbook:14232))
AnnotationAssertion(rdfs:label goldbook:14232 "paracrystalline distortion factor")
AnnotationAssertion(dcterms:description goldbook:14232 "Ratio of the statistical fluctuation \\(\\Delta a_{ik}\\) of a lattice vector \\(a_{i}\\) along the direction \\(a_{k}\\) \\[g_{ik} = \\frac{\\Delta a_{ik}}{a_{k}}\\]")
AnnotationAssertion(rdfs:comment goldbook:14232 "Values of \\(g\\) range from \\(\\pu{0}\\) (distortion-free crystal) to \\(\\pu{0.03}\\) (typical bulk polymer), to \\(\\pu{0.12}\\) (\\(\\ce{SiO2}\\) glass) to \\(\\pu{1}\\) (Boltzmann gas)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14232 "\\(g\\) can be determined from measurements of the integral breadth of successive orders of Bragg reflections [18b]."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14232 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14232 "current"^^xsd:string)
Declaration(Class(goldbook:14233))
AnnotationAssertion(rdfs:label goldbook:14233 "crystalline polymer-inclusion complex")
AnnotationAssertion(dcterms:description goldbook:14233 "Crystal comprising a polymer guest within a low-molar-mass host.")
AnnotationAssertion(rdfs:comment goldbook:14233 "A number of different crystalline polymer-inclusion complexes may be obtained, for example, by the crystallization of polyethylene, 1,4-polybutadiene, and other polymers within urea, perhydrotriphenylene, or cyclotriphosphazene crystals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14233 "The stems in polymer inclusion complexes are generally isolated. They are often not conformationally ordered."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14233 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14233 "current"^^xsd:string)
Declaration(Class(goldbook:14234))
AnnotationAssertion(rdfs:label goldbook:14234 "crystalline-polymer molecular complex")
AnnotationAssertion(dcterms:description goldbook:14234 "Crystalline molecular complex between different polymers.")
AnnotationAssertion(rdfs:comment goldbook:14234 "Very few examples of polymer complexes are known. The best characterized is the complex of isotactic and syndiotactic poly(methyl methacrylate)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14234 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14234 "current"^^xsd:string)
Declaration(Class(goldbook:14235))
AnnotationAssertion(rdfs:label goldbook:14235 "isomorphous polymer co-crystal")
AnnotationAssertion(dcterms:description goldbook:14235 "Crystal consisting of two or more structurally different polymers, resulting in macromolecular isomorphism.")
AnnotationAssertion(mito:isMentionedBy goldbook:14235 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14235 "current"^^xsd:string)
Declaration(Class(goldbook:14236))
AnnotationAssertion(rdfs:label goldbook:14236 "copolymer isomorphism")
AnnotationAssertion(dcterms:description goldbook:14236 "Macromolecular isomorphism involving copolymers.")
AnnotationAssertion(mito:isMentionedBy goldbook:14236 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14236 "current"^^xsd:string)
Declaration(Class(goldbook:14237))
AnnotationAssertion(rdfs:label goldbook:14237 "homopolymer isomorphism")
AnnotationAssertion(dcterms:description goldbook:14237 "Macromolecular isomorphism involving two homopolymers with different constitutional repeating units.")
AnnotationAssertion(rdfs:seeAlso goldbook:14237 goldbook:14235)
AnnotationAssertion(mito:isMentionedBy goldbook:14237 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14237 "current"^^xsd:string)
Declaration(Class(goldbook:14238))
AnnotationAssertion(rdfs:label goldbook:14238 "nanoporous polymer crystal")
AnnotationAssertion(dcterms:description goldbook:14238 "Polymer crystal presenting empty volume elements that can host low-molar-mass guest species.")
AnnotationAssertion(rdfs:comment goldbook:14238 "A nanoporous polymer crystal is often obtained (e.g., in the case of syndiotactic polystyrene) by removing the low-molar-mass guest species from a polymer clathrate."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14238 goldbook:14239)
AnnotationAssertion(mito:isMentionedBy goldbook:14238 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14238 "current"^^xsd:string)
Declaration(Class(goldbook:14239))
AnnotationAssertion(rdfs:label goldbook:14239 "polymer clathrate")
AnnotationAssertion(dcterms:description goldbook:14239 "Polymer co-crystal in which low-molar-mass guest species are hosted in molecular-sized cages or cavities containing more than one guest molecule.")
AnnotationAssertion(rdfs:comment goldbook:14239 "Polymer clathrates are formed by many polymers with low-molar-mass compounds, particularly water. Examples are frequent among biological polymers (e.g., amylose) but also some synthetic polymers give polymer clathrates (e.g., poly(ethylene oxide) with various inorganic and organic species)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14239 "Guest molecules are often packed isolated from each other or in columns."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14239 goldbook:14240)
AnnotationAssertion(mito:isMentionedBy goldbook:14239 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14239 "current"^^xsd:string)
Declaration(Class(goldbook:14240))
AnnotationAssertion(rdfs:label goldbook:14240 "polymer co-crystal")
AnnotationAssertion(dcterms:description goldbook:14240 "Crystal structure in which at least two substances coexist, one of which is a polymer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14240 "polymer mixed crystal")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14240 "polymer-based crystalline molecular complex")
AnnotationAssertion(rdfs:comment goldbook:14240 "Types of polymer co-crystals are: (1) polymer clathrate, (2) isomorphous polymer co-crystal, (3) crystalline polymer-inclusion complex. Examples are provided under each separate entry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14240 goldbook:14233)
AnnotationAssertion(rdfs:seeAlso goldbook:14240 goldbook:14235)
AnnotationAssertion(rdfs:seeAlso goldbook:14240 goldbook:14239)
AnnotationAssertion(rdfs:seeAlso goldbook:14240 goldbook:14271)
AnnotationAssertion(mito:isMentionedBy goldbook:14240 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14240 "current"^^xsd:string)
Declaration(Class(goldbook:14241))
AnnotationAssertion(rdfs:label goldbook:14241 "irregular adjacent re-entry model")
AnnotationAssertion(dcterms:description goldbook:14241 "Adjacent re-entry model in which the fold period can vary.")
AnnotationAssertion(rdfs:seeAlso goldbook:14241 goldbook:14244)
AnnotationAssertion(mito:isMentionedBy goldbook:14241 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14241 "current"^^xsd:string)
Declaration(Class(goldbook:14242))
AnnotationAssertion(rdfs:label goldbook:14242 "regular adjacent re-entry model")
AnnotationAssertion(dcterms:description goldbook:14242 "Idealized adjacent re-entry model in which the fold periods are assumed to have all the same length.")
AnnotationAssertion(rdfs:comment goldbook:14242 "This model is probably only approached for isothermal growth at small supercooling from dilute solution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14242 goldbook:14244)
AnnotationAssertion(rdfs:seeAlso goldbook:14242 goldbook:14273)
AnnotationAssertion(mito:isMentionedBy goldbook:14242 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14242 "current"^^xsd:string)
Declaration(Class(goldbook:14243))
AnnotationAssertion(rdfs:label goldbook:14243 "chain-extended crystal")
AnnotationAssertion(dcterms:description goldbook:14243 "Folded-chain crystal in which each macromolecule makes one, or, at most, a few folds.")
AnnotationAssertion(mito:isMentionedBy goldbook:14243 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14243 "current"^^xsd:string)
Declaration(Class(goldbook:14244))
AnnotationAssertion(rdfs:label goldbook:14244 "fold period")
AnnotationAssertion(dcterms:description goldbook:14244 "Thickness of a lamellar parallel-chain crystal in the direction of its stems.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14244 "fold length")
AnnotationAssertion(rdfs:comment goldbook:14244 "The fold period corresponds to the long period in the case of solution crystallized stacked lamellar crystals with the chain axis perpendicular to the lamellar surface."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14244 "In melt-crystallized polymers, consisting of lamellar crystals with the chain axis perpendicular to the lamellar surface, the fold period is shorter than the long period because the amorphous layer includes not only the folds but other non-crystallized components."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14244 "For lamellar crystals with chains whose axes are not normal to the lamellar surface, the fold period is longer than the long period."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14244 "The fold period is controlled by the crystallization temperature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14244 goldbook:14251)
AnnotationAssertion(mito:isMentionedBy goldbook:14244 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14244 "current"^^xsd:string)
Declaration(Class(goldbook:14245))
AnnotationAssertion(rdfs:label goldbook:14245 "non-parallel-chain crystal")
AnnotationAssertion(dcterms:description goldbook:14245 "Polymer crystal in which the stems are aligned along two or more different crystallographic directions.")
AnnotationAssertion(rdfs:comment goldbook:14245 "So far, the only example of non-parallel-chain polymer crystal is the \\(\\ce{\\upgamma\\mbox{-}polymorph}\\) of isotactic polypropylene, where double-layers of parallel chains alternate with identical double-layers rotated by approximately \\(\\pu{80\\!^{\\circ}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14245 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14245 "current"^^xsd:string)
Declaration(Class(goldbook:14246))
AnnotationAssertion(rdfs:label goldbook:14246 "solidification model")
AnnotationAssertion(dcterms:description goldbook:14246 "Model of crystalline polymer formed by lamellar crystallization from the melt, in which some stems of a macromolecule belong to one crystal, whilst other stems of the same macromolecule are in different crystals.")
AnnotationAssertion(mito:isMentionedBy goldbook:14246 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14246 "current"^^xsd:string)
Declaration(Class(goldbook:14247))
AnnotationAssertion(rdfs:label goldbook:14247 "amorphous domain")
AnnotationAssertion(dcterms:description goldbook:14247 "Phase domain consisting of matter in the amorphous state.")
AnnotationAssertion(rdfs:comment goldbook:14247 "The linear dimensions of amorphous domains in crystalline polymers range from \\(\\pu{1 nm}\\) upwards."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14247 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14247 "current"^^xsd:string)
Declaration(Class(goldbook:14248))
AnnotationAssertion(rdfs:label goldbook:14248 "bundle crystal")
AnnotationAssertion(dcterms:description goldbook:14248 "Crystal in which the chains predominantly extend from the crystal surface, resulting in a fringed-micelle model morphology.")
AnnotationAssertion(mito:isMentionedBy goldbook:14248 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14248 "current"^^xsd:string)
Declaration(Class(goldbook:14249))
AnnotationAssertion(rdfs:label goldbook:14249 "hedrite")
AnnotationAssertion(dcterms:description goldbook:14249 "Polyhedral aggregate of lamellar crystals resulting in a morphology that resembles that of a polymer single crystal, at least from one viewing direction.")
AnnotationAssertion(rdfs:comment goldbook:14249 "A hedrite is a type of axialite."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14249 goldbook:14255)
AnnotationAssertion(mito:isMentionedBy goldbook:14249 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14249 "current"^^xsd:string)
Declaration(Class(goldbook:14250))
AnnotationAssertion(rdfs:label goldbook:14250 "lamellar crystal sector")
AnnotationAssertion(dcterms:description goldbook:14250 "Portion of a lamellar crystal, often bounded by a well-defined crystal face.")
AnnotationAssertion(rdfs:comment goldbook:14250 "The term generally applies to solution-crystallized lamellar crystals. Sectors are described using the indexing of the crystal face bounding it."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14250 "The fold plane prevailing in a sector is normally assumed to correspond to the crystal face bounding the sector."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14250 "For some crystal morphologies, the fold surfaces of a sector make an angular discontinuity with the fold surfaces of contiguous sectors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14250 "Lamellar crystal sectors in folded-chain crystals correspond to fold domains."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14250 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14250 "current"^^xsd:string)
Declaration(Class(goldbook:14251))
AnnotationAssertion(rdfs:label goldbook:14251 "long period")
AnnotationAssertion(dcterms:description goldbook:14251 "Average periodicity (repeating distance) of the layers of lamellar crystals in a stacked assembly.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14251 "long spacing")
AnnotationAssertion(rdfs:comment goldbook:14251 "The long period is usually measured by SAXS (small-angle X-ray scattering), SANS (small-angle neutron scattering), atomic force microscopy (AFM), or transmission electron microscopy (TEM), and is the sum of the average thickness of the lamellar crystals and the average thickness of the amorphous inter-lamellar region."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14251 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14251 "current"^^xsd:string)
Declaration(Class(goldbook:14252))
AnnotationAssertion(rdfs:label goldbook:14252 "polycrystalline polymer")
AnnotationAssertion(dcterms:description goldbook:14252 "Crystalline polymer in which a large number of polymer crystallites coexist.")
AnnotationAssertion(rdfs:comment goldbook:14252 "Polymer crystallites and amorphous domains in a specimen may be organized randomly or with some degree of order."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14252 goldbook:14247)
AnnotationAssertion(rdfs:seeAlso goldbook:14252 goldbook:14253)
AnnotationAssertion(mito:isMentionedBy goldbook:14252 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14252 "current"^^xsd:string)
Declaration(Class(goldbook:14253))
AnnotationAssertion(rdfs:label goldbook:14253 "polymer fibre")
AnnotationAssertion(dcterms:description goldbook:14253 "Uniaxially oriented polymer filament with macroscopic cylindrical symmetry, in which the average direction of the polymer chain axis coincides with the cylindrical symmetry axis.")
AnnotationAssertion(rdfs:comment goldbook:14253 "A crystalline polymer fiber generally consists of lamellar crystals or fringed micelle-type crystals (see fringed micelle model) with an interconnecting amorphous phase, or, rarely, of extended-chain crystals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14253 "The cylindrical symmetry shown by crystalline polymer fibers is not at the molecular scale but results from the random orientation of crystallites around the axis of the fiber."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14253 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14253 "current"^^xsd:string)
Declaration(Class(goldbook:14254))
AnnotationAssertion(rdfs:label goldbook:14254 "polymer fibril")
AnnotationAssertion(dcterms:description goldbook:14254 "Small diameter polymer fiber consisting of a small number of polymer chains.")
AnnotationAssertion(rdfs:seeAlso goldbook:14254 goldbook:14253)
AnnotationAssertion(mito:isMentionedBy goldbook:14254 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14254 "current"^^xsd:string)
Declaration(Class(goldbook:14255))
AnnotationAssertion(rdfs:label goldbook:14255 "polymer single crystal")
AnnotationAssertion(dcterms:description goldbook:14255 "Individually distinct polymer crystal whose lattice, at crystallization, is characterized by a single orientation.")
AnnotationAssertion(rdfs:comment goldbook:14255 "Polymer single crystals obtained from dilute solutions are comparatively large, i.e, they have lateral dimensions typically of a few micrometers, which can reach tens of micrometers in some instances. They are normally delimited by well-defined boundary surfaces and may, in rare instances, be manipulated individually."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14255 "The thickness of individual polymer single crystals (inclusive of the fold surfaces thickness) is now measured by AFM (atomic force microscopy) along with transmission electron microscopy, while average values are derived using SAXS (small-angle X-ray scattering) and SANS (small-angle neutron scattering)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14255 goldbook:14260)
AnnotationAssertion(mito:isMentionedBy goldbook:14255 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14255 "current"^^xsd:string)
Declaration(Class(goldbook:14256))
AnnotationAssertion(rdfs:label goldbook:14256 "row structure")
AnnotationAssertion(dcterms:description goldbook:14256 "Polycrystalline polymer morphology resulting from nucleation of polymer lamellar crystals by multiple fibrillar structures or by macroscopic linear objects such as fibers.")
AnnotationAssertion(rdfs:comment goldbook:14256 "Shish-kebab structures are the simplest form of row structures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14256 "Row structures result frequently by heteroepitaxy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14256 goldbook:14252)
AnnotationAssertion(rdfs:seeAlso goldbook:14256 goldbook:14264)
AnnotationAssertion(mito:isMentionedBy goldbook:14256 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14256 "current"^^xsd:string)
Declaration(Class(goldbook:14257))
AnnotationAssertion(rdfs:label goldbook:14257 "dominant lamellae")
AnnotationAssertion(dcterms:description goldbook:14257 "Lamellar crystals radiating from the center of the spherulite which, by splaying, constitute the initial skeleton of the spherulite.")
AnnotationAssertion(rdfs:comment goldbook:14257 "Crystallization of dominant lamellae is largely associated with primary crystallization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14257 "In the isothermal crystallization of crystalline polymers there is normally a single population of dominant lamellae, characterized by a single thickness."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14257 "The thickness and perfection of dominant lamellae is greater than for subsidiary lamellae, especially in non-isothermal crystallization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14257 goldbook:14266)
AnnotationAssertion(rdfs:seeAlso goldbook:14257 goldbook:14267)
AnnotationAssertion(rdfs:seeAlso goldbook:14257 goldbook:14258)
AnnotationAssertion(mito:isMentionedBy goldbook:14257 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14257 "current"^^xsd:string)
Declaration(Class(goldbook:14258))
AnnotationAssertion(rdfs:label goldbook:14258 "subsidiary lamellae")
AnnotationAssertion(dcterms:description goldbook:14258 "Lamellar crystals nucleated either epitaxially or incoherently on dominant lamellae.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14258 "infilling lamellae")
AnnotationAssertion(rdfs:comment goldbook:14258 "Subsidiary lamellae can appear as pockets of lamellae in different locations within a spherulite, with no well-defined relation to dominant lamellae."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14258 "Crystallization of subsidiary lamellae is generally associated with secondary crystallization, but may start before dominant lamellae meet at spherulite boundaries."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14258 "The thickness and perfection of subsidiary lamellae is reduced as compared to dominant lamellae, especially in non-isothermal crystallization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14258 "In typical crystalline polymers there may be populations of subsidiary lamellae characterized by bimodal thickness distributions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14258 goldbook:14257)
AnnotationAssertion(rdfs:seeAlso goldbook:14258 goldbook:14267)
AnnotationAssertion(mito:isMentionedBy goldbook:14258 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14258 "current"^^xsd:string)
Declaration(Class(goldbook:14259))
AnnotationAssertion(rdfs:label goldbook:14259 "transcrystalline layer")
AnnotationAssertion(dcterms:description goldbook:14259 "Polycrystalline layer nucleated and shaped by a pre-existing planar surface within or in contact with a polymer melt.")
AnnotationAssertion(rdfs:comment goldbook:14259 "In growth from unoriented melts, as in compression-molding, the transcrystalline layer consists of closely spaced, highly asymmetric spherulites, nucleated on the surface and elongated in the direction normal to the surface of the molded articles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14259 "In growth from oriented melts, as in injection-molding, two transcrystalline layers may result. The first is the skin layer and is formed by individual lamellae, while the second consists of spherulites. Both grow preferentially in the direction perpendicular to the flow direction and the external surface of the molded articles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14259 goldbook:14256)
AnnotationAssertion(mito:isMentionedBy goldbook:14259 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14259 "current"^^xsd:string)
Declaration(Class(goldbook:14260))
AnnotationAssertion(rdfs:label goldbook:14260 "twinned polymer crystal")
AnnotationAssertion(dcterms:description goldbook:14260 "Polymer crystal in which two or more single crystalline domains of the same crystal polymorph, with different lattice orientations, coexist.")
AnnotationAssertion(rdfs:comment goldbook:14260 "Some of the lattice directions, very often the chain axis directions, remain parallel in the different domains of twinned crystals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14260 "The lattice orientations in the different domains of twinned crystals are generally symmetry-related."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14260 goldbook:14219)
AnnotationAssertion(rdfs:seeAlso goldbook:14260 goldbook:14255)
AnnotationAssertion(mito:isMentionedBy goldbook:14260 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14260 "current"^^xsd:string)
Declaration(Class(goldbook:14261))
AnnotationAssertion(rdfs:label goldbook:14261 "cellulation")
AnnotationAssertion(dcterms:description goldbook:14261 "Division of the growth front of individual or groups of dominant lamellae into divergent 'cells', with the impurities and the less crystallizable molecules segregated between the cells and at the spherulite boundaries.")
AnnotationAssertion(rdfs:seeAlso goldbook:14261 goldbook:14257)
AnnotationAssertion(mito:isMentionedBy goldbook:14261 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14261 "current"^^xsd:string)
Declaration(Class(goldbook:14262))
AnnotationAssertion(rdfs:label goldbook:14262 "confined-spaces crystallisation")
AnnotationAssertion(dcterms:description goldbook:14262 "Polymer crystallization occurring inside elongated cavities, spheres, galleries, or layers formed by a host material different from the polymer.")
AnnotationAssertion(rdfs:comment goldbook:14262 "Morphology and polymorphism may be significantly affected by confined crystallization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14262 "At least one dimension of the cavities must be of the order of a few nanometers, i.e., close to typical dimensions of a polymer crystallite and, in particular, to lamellar thickness."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14262 "Stems may be isolated in the cavities of the frequently nonpolymeric host material, as in the cases of zeolites and the fully trans-form of perhydrotriphenylene in the crystalline state. In such cases, the polymer stems are usually highly disordered."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14262 "Stems may aggregate in small, disordered bundle crystals or in relatively large lamellar crystals, typically within layered inorganic materials."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14262 "Spherical structures may result from the crystallization of one of the two components in a heterogeneous polymer blend (e.g., in a polyethylene-polycarbonate blend) while lamellar, hexagonally packed cylindrical and inverse cylindrical morphologies are frequent in block copolymers with a crystallizable block (e.g., in poly(ethylene oxide)-block-polystyrene))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14262 goldbook:14248)
AnnotationAssertion(mito:isMentionedBy goldbook:14262 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14262 "current"^^xsd:string)
Declaration(Class(goldbook:14263))
AnnotationAssertion(rdfs:label goldbook:14263 "degree of supercooling")
AnnotationAssertion(dcterms:description goldbook:14263 "Temperature difference between the equilibrium melting temperature and the temperature of a supercooled melt.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14263 "degree of undercooling")
AnnotationAssertion(rdfs:seeAlso goldbook:14263 goldbook:14272)
AnnotationAssertion(mito:isMentionedBy goldbook:14263 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14263 "current"^^xsd:string)
Declaration(Class(goldbook:14264))
AnnotationAssertion(rdfs:label goldbook:14264 "heteroepitaxy")
AnnotationAssertion(dcterms:description goldbook:14264 "Epitaxy between crystals of different substances.")
AnnotationAssertion(rdfs:comment goldbook:14264 "Heteroepitaxy may occur between crystals of different polymers. However, the heteroepitaxy of low-molecular-weight systems (e.g., alkanes) on polymer crystals (e.g., polyethylene), and of polymer crystals on crystals of low-molecular-weight substances can also occur. Heteroepitaxy has also been observed for polymer crystals on ionic substances and minerals like clay and mica."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14264 "For some polymers, heteroepitaxy may be used to favor by nucleation the development of a crystalline phase that is not obtained normally."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14264 "Polymer crystals with unusual orientations with respect to the substrate may be obtained by epitaxial crystallization involving heteroepitaxy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14264 "Heteroepitaxy is often used to enhance nucleation and reduce spherulites’ size in commercial processes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14264 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14264 "current"^^xsd:string)
Declaration(Class(goldbook:14265))
AnnotationAssertion(rdfs:label goldbook:14265 "homoepitaxy")
AnnotationAssertion(dcterms:description goldbook:14265 "Epitaxy between crystals of the same substance.")
AnnotationAssertion(rdfs:comment goldbook:14265 "Homoepitaxy may occur between crystals of the same crystal polymorph but different morphology as in the crystallization of chain-folded crystals on fibril-like extended-chain crystals in shish-kebabs. Similarly, in non-isothermal crystallization, lamellar crystals of lower thickness are often nucleated on thicker crystals, preserving a unique orientation of the crystal lattice."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14265 "A less frequent homoepitaxy may occur, as for the \\(\\ce{\\upalpha\\mbox{-}polymorph}\\) of isotactic polypropylene, between crystals of the same crystal polymorph and morphology but with a different, well-defined orientation of the crystal lattice."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14265 "Homoepitaxy may allow the development of crystals of the same polymer but in two distinct crystal polymorphs with well-defined mutual orientations, as in the case of \\(\\ce{\\upgamma\\mbox{-}isotactic}\\) polypropylene grown on \\(\\ce{\\upalpha\\mbox{-}isotactic}\\) polypropylene."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14265 "A new crystal layer, initiated by secondary nucleation, or the formation of a twinned polymer crystal, can be seen as a form of homoepitaxy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14265 goldbook:14219)
AnnotationAssertion(rdfs:seeAlso goldbook:14265 goldbook:14267)
AnnotationAssertion(rdfs:seeAlso goldbook:14265 goldbook:14260)
AnnotationAssertion(mito:isMentionedBy goldbook:14265 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14265 "current"^^xsd:string)
Declaration(Class(goldbook:14266))
AnnotationAssertion(rdfs:label goldbook:14266 "isothermal crystallisation")
AnnotationAssertion(dcterms:description goldbook:14266 "Crystallization taking place at constant temperature.")
AnnotationAssertion(mito:isMentionedBy goldbook:14266 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14266 "current"^^xsd:string)
Declaration(Class(goldbook:14267))
AnnotationAssertion(rdfs:label goldbook:14267 "non-isothermal crystallisation")
AnnotationAssertion(dcterms:description goldbook:14267 "Crystallization taking place under varying temperature conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14267 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14267 "current"^^xsd:string)
Declaration(Class(goldbook:14268))
AnnotationAssertion(rdfs:label goldbook:14268 "primary nucleus")
AnnotationAssertion(dcterms:description goldbook:14268 "The smallest crystalline entity, the further growth of which is thermodynamically favored.")
AnnotationAssertion(mito:isMentionedBy goldbook:14268 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14268 "current"^^xsd:string)
Declaration(Class(goldbook:14269))
AnnotationAssertion(rdfs:label goldbook:14269 "secondary nucleation")
AnnotationAssertion(dcterms:description goldbook:14269 "Nucleation of a new molecular layer on a growing crystal face.Note: Secondary nucleation refers to the further growth of an already-existing crystal.")
AnnotationAssertion(mito:isMentionedBy goldbook:14269 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14269 "current"^^xsd:string)
Declaration(Class(goldbook:14270))
AnnotationAssertion(rdfs:label goldbook:14270 "self-nucleation")
AnnotationAssertion(dcterms:description goldbook:14270 "Heterogeneous nucleation by crystals of the same polymer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14270 "self-seeding")
AnnotationAssertion(mito:isMentionedBy goldbook:14270 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14270 "current"^^xsd:string)
Declaration(Class(goldbook:14271))
AnnotationAssertion(rdfs:label goldbook:14271 "polymer co-crystallisation")
AnnotationAssertion(dcterms:description goldbook:14271 "Crystallization, within the same crystal, of a polymer and at least one other component.")
AnnotationAssertion(rdfs:comment goldbook:14271 "The following possibilities need to be considered: (1) a polymer and a low-molar-mass species forming a polymer clathrate; (2) a molecular complex of different polymers (see polymer co-crystal); and (3) different polymers displaying some degree of isomorphism (isomorphous polymer co-crystal)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14271 goldbook:14235)
AnnotationAssertion(rdfs:seeAlso goldbook:14271 goldbook:14239)
AnnotationAssertion(rdfs:seeAlso goldbook:14271 goldbook:14240)
AnnotationAssertion(mito:isMentionedBy goldbook:14271 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14271 "current"^^xsd:string)
Declaration(Class(goldbook:14272))
AnnotationAssertion(rdfs:label goldbook:14272 "supercooled melt")
AnnotationAssertion(dcterms:description goldbook:14272 "Metastable melt of a crystallizable polymer at temperatures below its equilibrium melting temperature \\(T^{\\circ}_{\\rm{m}}\\).")
AnnotationAssertion(rdfs:comment goldbook:14272 "The term is not applicable to the amorphous component of a crystalline polymer, i.e., after crystallization has occurred."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14272 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14272 "current"^^xsd:string)
Declaration(Class(goldbook:14273))
AnnotationAssertion(rdfs:label goldbook:14273 "supercooling")
AnnotationAssertion(dcterms:description goldbook:14273 "The process of cooling a melt to a temperature below its equilibrium melting point, without crystallization occurring.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14273 "undercooling")
AnnotationAssertion(mito:isMentionedBy goldbook:14273 doi:10.1351/PAC-REC-10-11-13)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14273 "current"^^xsd:string)
Declaration(Class(goldbook:14274))
AnnotationAssertion(rdfs:label goldbook:14274 "polymer particle")
AnnotationAssertion(dcterms:description goldbook:14274 "Particle of polymer of any shape.")
AnnotationAssertion(rdfs:comment goldbook:14274 "For the description of a particle, the expression \"size\" is often used. However, because this expression does not have a sufficiently precise meaning its usage is not recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14274 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14274 "current"^^xsd:string)
Declaration(Class(goldbook:14275))
AnnotationAssertion(rdfs:label goldbook:14275 "polymer bead")
AnnotationAssertion(dcterms:description goldbook:14275 "Sphere of polymer, usually with a diameter in the range from one-tenth to a few millimeters.")
AnnotationAssertion(mito:isMentionedBy goldbook:14275 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14275 "current"^^xsd:string)
Declaration(Class(goldbook:14276))
AnnotationAssertion(rdfs:label goldbook:14276 "polymer microparticle")
AnnotationAssertion(dcterms:description goldbook:14276 "Particle of polymer of any shape with an equivalent diameter from approximately \\(\\pu{0.1 \\upmu m}\\) to \\(\\pu{100 \\upmu m}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:14276 goldbook:14290)
AnnotationAssertion(mito:isMentionedBy goldbook:14276 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14276 "current"^^xsd:string)
Declaration(Class(goldbook:14277))
AnnotationAssertion(rdfs:label goldbook:14277 "polymer microsphere")
AnnotationAssertion(dcterms:description goldbook:14277 "Polymer microparticle of spherical shape.")
AnnotationAssertion(rdfs:seeAlso goldbook:14277 goldbook:14276)
AnnotationAssertion(mito:isMentionedBy goldbook:14277 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14277 "current"^^xsd:string)
Declaration(Class(goldbook:14278))
AnnotationAssertion(rdfs:label goldbook:14278 "polymer nanoparticle")
AnnotationAssertion(dcterms:description goldbook:14278 "Particle of polymer of any shape and an equivalent diameter from approximately \\(\\pu{1 nm}\\) to \\(\\pu{100 nm}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:14278 goldbook:14290)
AnnotationAssertion(mito:isMentionedBy goldbook:14278 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14278 "current"^^xsd:string)
Declaration(Class(goldbook:14279))
AnnotationAssertion(rdfs:label goldbook:14279 "polymer nanosphere")
AnnotationAssertion(dcterms:description goldbook:14279 "Polymer nanoparticle of spherical shape.")
AnnotationAssertion(rdfs:seeAlso goldbook:14279 goldbook:14278)
AnnotationAssertion(mito:isMentionedBy goldbook:14279 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14279 "current"^^xsd:string)
Declaration(Class(goldbook:14280))
AnnotationAssertion(rdfs:label goldbook:14280 "polymer gel particle")
AnnotationAssertion(dcterms:description goldbook:14280 "Particle of gel in which the network component is a polymer.")
AnnotationAssertion(mito:isMentionedBy goldbook:14280 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14280 "current"^^xsd:string)
Declaration(Class(goldbook:14281))
AnnotationAssertion(rdfs:label goldbook:14281 "gel microparticle")
AnnotationAssertion(dcterms:description goldbook:14281 "Particle of gel of any shape with an equivalent diameter of approximately \\(\\pu{0.1 \\upmu m}\\) to \\(\\pu{100 \\upmu m}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14281 "microgel")
AnnotationAssertion(rdfs:seeAlso goldbook:14281 goldbook:14290)
AnnotationAssertion(mito:isMentionedBy goldbook:14281 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14281 "current"^^xsd:string)
Declaration(Class(goldbook:14282))
AnnotationAssertion(rdfs:label goldbook:14282 "gel nanoparticle")
AnnotationAssertion(dcterms:description goldbook:14282 "Particle of gel particle of any shape and an equivalent diameter of approximately \\(\\pu{1 nm}\\) to \\(\\pu{100 nm}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14282 "nanogel")
AnnotationAssertion(rdfs:seeAlso goldbook:14282 goldbook:14290)
AnnotationAssertion(mito:isMentionedBy goldbook:14282 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14282 "current"^^xsd:string)
Declaration(Class(goldbook:14283))
AnnotationAssertion(rdfs:label goldbook:14283 "polymer network particle")
AnnotationAssertion(dcterms:description goldbook:14283 "Particle having any shape and composed of a polymer network and possibly species of finite molar mass.")
AnnotationAssertion(mito:isMentionedBy goldbook:14283 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14283 "current"^^xsd:string)
Declaration(Class(goldbook:14284))
AnnotationAssertion(rdfs:label goldbook:14284 "artificial latex")
AnnotationAssertion(dcterms:description goldbook:14284 "Latex obtained by emulsification of a polymer or oligomer solution in a liquid or by emulsification of a liquid polymer or liquid oligomer in a liquid.")
AnnotationAssertion(mito:isMentionedBy goldbook:14284 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14284 "current"^^xsd:string)
Declaration(Class(goldbook:14285))
AnnotationAssertion(rdfs:label goldbook:14285 "hybrid latex")
AnnotationAssertion(dcterms:description goldbook:14285 "Latex comprising a polymer of relatively high molar mass and an oligomer or an alkyd resin, in which there is usually chemical bonding between the two components, formed either during latex synthesis or subsequently after formation of a film from the latex. Latex comprising multicomponent particles that contain both organic and inorganic material phases.")
AnnotationAssertion(mito:isMentionedBy goldbook:14285 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14285 "current"^^xsd:string)
Declaration(Class(goldbook:14286))
AnnotationAssertion(rdfs:label goldbook:14286 "inverse latex")
AnnotationAssertion(dcterms:description goldbook:14286 "Nonaqueous latex in which the dispersed phase comprises hydrophilic polymer usually swollen with water.")
AnnotationAssertion(rdfs:comment goldbook:14286 "An inverse latex is usually formed by inverse emulsion, inverse micro-emulsion, or inverse mini-emulsion polymerizations in which water-soluble monomer(s) dissolved in the dispersed phase is (are) polymerized."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14286 goldbook:14307)
AnnotationAssertion(rdfs:seeAlso goldbook:14286 goldbook:14335)
AnnotationAssertion(mito:isMentionedBy goldbook:14286 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14286 "current"^^xsd:string)
Declaration(Class(goldbook:14287))
AnnotationAssertion(rdfs:label goldbook:14287 "latex particle")
AnnotationAssertion(dcterms:description goldbook:14287 "Polymer particle that is present in a latex.")
AnnotationAssertion(mito:isMentionedBy goldbook:14287 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14287 "current"^^xsd:string)
Declaration(Class(goldbook:14288))
AnnotationAssertion(rdfs:label goldbook:14288 "natural latex")
AnnotationAssertion(dcterms:description goldbook:14288 "Latex, the dispersed phase of which is obtained from various plants.")
AnnotationAssertion(rdfs:comment goldbook:14288 "The dispersed phase is often polyisoprene (2-methyl-1,3-butadiene).Example: Latex from the rubber tree, Hevea brasiliensis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14288 "Many plants when wounded produce a milky, sticky sap that is referred to as a latex."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14288 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14288 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14288 "current"^^xsd:string)
Declaration(Class(goldbook:14289))
AnnotationAssertion(rdfs:label goldbook:14289 "synthetic latex")
AnnotationAssertion(dcterms:description goldbook:14289 "Latex obtained as a product of an emulsion, mini-emulsion, micro-emulsion, or dispersion polymerization.")
AnnotationAssertion(rdfs:seeAlso goldbook:14289 goldbook:14348)
AnnotationAssertion(rdfs:seeAlso goldbook:14289 goldbook:14317)
AnnotationAssertion(rdfs:seeAlso goldbook:14289 goldbook:14316)
AnnotationAssertion(mito:isMentionedBy goldbook:14289 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14289 "current"^^xsd:string)
Declaration(Class(goldbook:14290))
AnnotationAssertion(rdfs:label goldbook:14290 "equivalent particle diameter")
AnnotationAssertion(dcterms:description goldbook:14290 "Diameter of a hypothetical spherical particle of the same composition that, using a given particle-size determination method, would give the same diameter as a substance composed of spherical or nonspherical particles at the same concentration.")
AnnotationAssertion(rdfs:comment goldbook:14290 "Although the equivalent particle diameter is not a precisely defined quantity, as its value depends on the experimental method used for its determination, it is useful for particle characterization."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14290 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14290 "current"^^xsd:string)
Declaration(Class(goldbook:14291))
AnnotationAssertion(rdfs:label goldbook:14291 "number-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14291 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{N}} \\right\\rangle = \\bar d_{\\rm{N}} = \\frac{\\Sigma N_{i} d_{i}}{\\Sigma N_{i}}\\]")
AnnotationAssertion(rdfs:comment goldbook:14291 "In the formulae, \\(N_{i}\\) denotes the number of particles of diameter \\(d_{i}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14291 "Averages may be denoted by \\(\\left\\langle ~ \\right\\rangle\\) or by \\(\\bar{~}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14291 "In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14291 "Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \\(z\\mbox{-}\\rm{average}\\) diameter is the fifth momentum over the fourth one)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14291 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14291 "current"^^xsd:string)
Declaration(Class(goldbook:14292))
AnnotationAssertion(rdfs:label goldbook:14292 "surface-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14292 "Calculated using the following equation: \\[\\left\\langle {d_{\\rm{s}}} \\right\\rangle = \\bar d_{\\rm{s}} = \\frac{\\Sigma {N_{i}} {d_{i}^{3}}}{\\Sigma {N_{i}} {d_{i}^{2}}}\\]")
AnnotationAssertion(rdfs:comment goldbook:14292 "In the formulae, \\(N_{i}\\) denotes the number of particles of diameter \\(d_{i}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14292 "Averages may be denoted by \\(\\left\\langle ~ \\right\\rangle\\) or by \\(\\bar{~}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14292 "In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14292 "Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \\(z\\mbox{-}\\rm{average}\\) diameter is the fifth momentum over the fourth one)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14292 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14292 "current"^^xsd:string)
Declaration(Class(goldbook:14293))
AnnotationAssertion(rdfs:label goldbook:14293 "mass-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14293 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{m}} \\right\\rangle = \\bar d_{\\rm{m}} = \\frac{\\Sigma {N_{i}} {d_{i}^{4}}}{\\Sigma {N_{i}} {d_{i}^{3}}}\\]")
AnnotationAssertion(rdfs:comment goldbook:14293 "In the formulae, \\(N_{i}\\) denotes the number of particles of diameter \\(d_{i}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14293 "Averages may be denoted by \\(\\left\\langle ~ \\right\\rangle\\) or by \\(\\bar{~}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14293 "In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14293 "Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \\(z\\mbox{-}\\rm{average}\\) diameter is the fifth momentum over the fourth one)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14293 "The definition of mass-average diameter is meaningful only for latexes where the particles all have the same density."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14293 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14293 "current"^^xsd:string)
Declaration(Class(goldbook:14294))
AnnotationAssertion(rdfs:label goldbook:14294 "z-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14294 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{z}} \\right\\rangle = \\bar d_{\\rm{z}} = \\frac{\\Sigma N_{i} d_{i}^{5}}{\\Sigma N_{i}d_{i}^{4}}\\]")
AnnotationAssertion(rdfs:comment goldbook:14294 "In the formulae, \\(N_{i}\\) denotes the number of particles of diameter \\(d_{i}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14294 "Averages may be denoted by \\(\\left\\langle ~ \\right\\rangle\\) or by \\(\\bar{~}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14294 "In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14294 "Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \\(z\\mbox{-}\\rm{average}\\) diameter is the fifth momentum over the fourth one)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14294 "The definition of the \\(z\\mbox{-}\\rm{average}\\) diameter is meaningful only for latexes where the particles all have the same density and refractive index"^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14294 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14294 "current"^^xsd:string)
Declaration(Class(goldbook:14295))
AnnotationAssertion(rdfs:label goldbook:14295 "volume-average particle diameter")
AnnotationAssertion(dcterms:description goldbook:14295 "Calculated using the following equation: \\[\\left\\langle d_{\\rm{v}} \\right\\rangle = \\bar d_{\\rm{v}} = \\left(\\frac{\\Sigma N_{i} d_{i}^{3}}{\\Sigma N_{i}}\\right)^{1/3}\\]")
AnnotationAssertion(rdfs:comment goldbook:14295 "In the formulae, \\(N_{i}\\) denotes the number of particles of diameter \\(d_{i}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14295 "Averages may be denoted by \\(\\left\\langle ~ \\right\\rangle\\) or by \\(\\bar{~}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14295 "In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14295 "Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \\(z\\mbox{-}\\rm{average}\\) diameter is the fifth momentum over the fourth one)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14295 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14295 "current"^^xsd:string)
Declaration(Class(goldbook:14296))
AnnotationAssertion(rdfs:label goldbook:14296 "particle-diameter dispersity")
AnnotationAssertion(dcterms:description goldbook:14296 "Calculated using the following equation: \\[Ɖ_{\\rm{d}} = \\left\\langle d_{\\rm{m}} \\right\\rangle /\\!\\left\\langle d_{\\rm{N}} \\right\\rangle = \\bar d_{\\rm{m}}/\\bar d_{\\rm{N}} = \\frac{\\Sigma N_{i}\\Sigma N_{i} d_{i}^{4}}{\\Sigma N_{i} d_{i} \\Sigma N_{i} d_{i}^{3}}\\]")
AnnotationAssertion(rdfs:comment goldbook:14296 "In the formulae, \\(N_{i}\\) denotes the number of particles of diameter \\(d_{i}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14296 "Averages may be denoted by \\(\\left\\langle ~ \\right\\rangle\\) or by \\(\\bar{~}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14296 "In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14296 "The term \"particle-diameter dispersity\" and the symbol \\(Ɖ_{\\rm{d}}\\) are an extension of the terms molar-mass dispersity (\\(Ɖ_{\\rm{m}}\\)) and degree-of-polymerization dispersity (\\(Ɖ_{\\rm{X}}\\)), where \\(Ɖ_{\\rm{m}} = \\bar M_{\\rm{m}}/\\bar M_{\\rm{n}}\\) and \\(Ɖ_{\\rm{X}} = \\bar X_{\\rm{m}}/\\bar X_{\\rm{n}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14296 "For \"particle-diameter dispersity\", the term \"diameter-polydispersity index\" is not recommended as \"polydispersity\" is an undefined quantity. The term \"non-uniformity factor\" is also not recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14296 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14296 "current"^^xsd:string)
Declaration(Class(goldbook:14297))
AnnotationAssertion(rdfs:label goldbook:14297 "homogeneous particle")
AnnotationAssertion(dcterms:description goldbook:14297 "Particle that is spatially uniform with respect to chemical composition of the constituent polymer(s).")
AnnotationAssertion(rdfs:comment goldbook:14297 "A particle that is chemically homogeneous but has a radial distribution function of composition that is not step-like is not a homogeneous particle. Similarly, a block-copolymer micelle is not a homogeneous particle, although all constituent copolymer molecules can have identical compositions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14297 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14297 "current"^^xsd:string)
Declaration(Class(goldbook:14298))
AnnotationAssertion(rdfs:label goldbook:14298 "multicomponent particle")
AnnotationAssertion(dcterms:description goldbook:14298 "Inhomogeneous particle consisting of two or more immiscible components.Examples of two-phase particle morphology.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14298 "composite particle")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14298 "structured particle")
AnnotationAssertion(rdfs:comment goldbook:14298 "The components can be solid, liquid, or gaseous."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14298 "Multicomponent particles are often obtained by sequential polymerizations of different monomers or monomer mixtures."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14298 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14298 "current"^^xsd:string)
Declaration(Class(goldbook:14299))
AnnotationAssertion(rdfs:label goldbook:14299 "core-shell particle")
AnnotationAssertion(dcterms:description goldbook:14299 "Polymer particle comprising at least two phase domains, one of which (the core) lies within the other(s) that form the polymeric outer layer(s) (the shell(s)).")
AnnotationAssertion(rdfs:comment goldbook:14299 "Examples of core-shell particles are shown in multicomponent particle. A core may be composed of one single-phase domain of one type of polymer or copolymer block in a shell of a different type of polymer (or copolymer block)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14299 "Core-shell particles may be obtained by seeded emulsion polymerization in which the seed particles form the cores of the new particles, and polymer produced in the second stage and subsequent stages, if any, forms the shell."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14299 "Core-shell particles in which polymer synthesized in the second stage is located within one single domain, and the particles and polymer constituting the initial seed are located in the shell are usually called inverted core-shell particles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14299 goldbook:14329)
AnnotationAssertion(rdfs:seeAlso goldbook:14299 goldbook:14300)
AnnotationAssertion(rdfs:seeAlso goldbook:14299 goldbook:14298)
AnnotationAssertion(rdfs:seeAlso goldbook:14299 goldbook:14376)
AnnotationAssertion(mito:isMentionedBy goldbook:14299 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14299 "current"^^xsd:string)
Declaration(Class(goldbook:14300))
AnnotationAssertion(rdfs:label goldbook:14300 "inverted core-shell particle")
AnnotationAssertion(dcterms:description goldbook:14300 "Core-shell particle in which polymer synthesized in the second stage is located in the core of the particle and polymer constituting the initial seed is located in the shell.")
AnnotationAssertion(rdfs:seeAlso goldbook:14300 goldbook:14298)
AnnotationAssertion(mito:isMentionedBy goldbook:14300 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14300 "current"^^xsd:string)
Declaration(Class(goldbook:14301))
AnnotationAssertion(rdfs:label goldbook:14301 "multilayered particle")
AnnotationAssertion(dcterms:description goldbook:14301 "Multicomponent particle made of at least two different polymers, with an inner core of one polymer and with at least two layers of different polymers.")
AnnotationAssertion(rdfs:seeAlso goldbook:14301 goldbook:14298)
AnnotationAssertion(mito:isMentionedBy goldbook:14301 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14301 "current"^^xsd:string)
Declaration(Class(goldbook:14302))
AnnotationAssertion(rdfs:label goldbook:14302 "occluded particle")
AnnotationAssertion(dcterms:description goldbook:14302 "Multicomponent particle in which one polymer forms more than one phase domain within a matrix of another polymer.")
AnnotationAssertion(rdfs:comment goldbook:14302 "The number and size of the domains can vary, and their spatial distribution within the particles is often not uniform."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14302 "This type of particle is also referred to as having microdomain morphology."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14302 goldbook:14298)
AnnotationAssertion(mito:isMentionedBy goldbook:14302 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14302 "current"^^xsd:string)
Declaration(Class(goldbook:14303))
AnnotationAssertion(rdfs:label goldbook:14303 "partially engulfed particle")
AnnotationAssertion(dcterms:description goldbook:14303 "Multicomponent particle in which one or more polymer(s) cover(s) most, but not all, of the particle surface.")
AnnotationAssertion(rdfs:comment goldbook:14303 "The degree of coverage may vary when neither polymer is preferentially covering the other one. The morphology is commonly referred to as a hemisphere."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14303 goldbook:14298)
AnnotationAssertion(mito:isMentionedBy goldbook:14303 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14303 "current"^^xsd:string)
Declaration(Class(goldbook:14304))
AnnotationAssertion(rdfs:label goldbook:14304 "macroporous particle")
AnnotationAssertion(dcterms:description goldbook:14304 "Particle containing pores of diameters exceeding about \\(\\pu{50 nm}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:14304 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14304 "current"^^xsd:string)
Declaration(Class(goldbook:14305))
AnnotationAssertion(rdfs:label goldbook:14305 "mesoporous particle")
AnnotationAssertion(dcterms:description goldbook:14305 "Particle containing pores of diameters between approximately \\(\\pu{2 \\upmu m}\\) and \\(\\pu{50 \\upmu m}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:14305 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14305 "current"^^xsd:string)
Declaration(Class(goldbook:14306))
AnnotationAssertion(rdfs:label goldbook:14306 "microporous particle")
AnnotationAssertion(dcterms:description goldbook:14306 "Particle containing pores of diameters not exceeding \\(\\pu{2 nm}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:14306 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14306 "current"^^xsd:string)
Declaration(Class(goldbook:14307))
AnnotationAssertion(rdfs:label goldbook:14307 "dispersed phase")
AnnotationAssertion(dcterms:description goldbook:14307 "Phase constituted of particles of any size and of any nature dispersed in a continuous phase of a different composition.")
AnnotationAssertion(rdfs:seeAlso goldbook:14307 goldbook:14308)
AnnotationAssertion(mito:isMentionedBy goldbook:14307 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14307 "current"^^xsd:string)
Declaration(Class(goldbook:14308))
AnnotationAssertion(rdfs:label goldbook:14308 "continuous phase")
AnnotationAssertion(dcterms:description goldbook:14308 "Phase not interrupted in space")
AnnotationAssertion(rdfs:comment goldbook:14308 "The continuous phase may be gaseous, liquid, or solid."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14308 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14308 "current"^^xsd:string)
Declaration(Class(goldbook:14309))
AnnotationAssertion(rdfs:label goldbook:14309 "dispersion medium")
AnnotationAssertion(dcterms:description goldbook:14309 "Matrix for the dispersed phase.")
AnnotationAssertion(rdfs:comment goldbook:14309 "The dispersion medium is the continuous phase of the dispersion."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14309 "If the continuous phase is a gas, the dispersion is called an aerosol."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14309 goldbook:14308)
AnnotationAssertion(rdfs:seeAlso goldbook:14309 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14309 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14309 "current"^^xsd:string)
Declaration(Class(goldbook:14310))
AnnotationAssertion(rdfs:label goldbook:14310 "nonaqueous dispersion")
AnnotationAssertion(dcterms:description goldbook:14310 "Dispersion in which the continuous phase is nonaqueous.")
AnnotationAssertion(rdfs:seeAlso goldbook:14310 goldbook:14308)
AnnotationAssertion(mito:isMentionedBy goldbook:14310 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14310 "current"^^xsd:string)
Declaration(Class(goldbook:14311))
AnnotationAssertion(rdfs:label goldbook:14311 "polymer dispersion")
AnnotationAssertion(dcterms:description goldbook:14311 "Dispersion in which the dispersed phase consists of a polymer.")
AnnotationAssertion(rdfs:seeAlso goldbook:14311 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14311 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14311 "current"^^xsd:string)
Declaration(Class(goldbook:14312))
AnnotationAssertion(rdfs:label goldbook:14312 "colloid stabiliser")
AnnotationAssertion(dcterms:description goldbook:14312 "Compound increasing stability of a colloid.")
AnnotationAssertion(rdfs:comment goldbook:14312 "A colloid stabilizer may be added to a colloid or synthesized during colloid preparation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14312 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14312 "current"^^xsd:string)
Declaration(Class(goldbook:14313))
AnnotationAssertion(rdfs:label goldbook:14313 "polymer colloid")
AnnotationAssertion(dcterms:description goldbook:14313 "Colloidal dispersion in which at least one of the phases is a polymer, either organic, or inorganic or some combination of the two.")
AnnotationAssertion(rdfs:comment goldbook:14313 "The term \"polymer colloid\" is more general than latex. In a latex the dispersed phase is always a polymer, whereas in a polymer colloid this need not be so."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14313 "Particles of a liquid or a gas dispersed in a polymer, particles comprising \"empty\" shells made of polymers, and aerosols of polymer particles are all known examples."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14313 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14313 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14313 "current"^^xsd:string)
Declaration(Class(goldbook:14314))
AnnotationAssertion(rdfs:label goldbook:14314 "polymer emulsion")
AnnotationAssertion(dcterms:description goldbook:14314 "Emulsion in which the dispersed phase is a liquid polymer or a polymer solution.")
AnnotationAssertion(rdfs:comment goldbook:14314 "The dispersing phase may be a low-molecular-weight liquid or a solution of another polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14314 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14314 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14314 "current"^^xsd:string)
Declaration(Class(goldbook:14315))
AnnotationAssertion(rdfs:label goldbook:14315 "macro-emulsion")
AnnotationAssertion(dcterms:description goldbook:14315 "Emulsion in which the particles of the dispersed phase have diameters from approximately \\(\\pu{1 \\upmu m}\\) to \\(\\pu{100 \\upmu m}\\).")
AnnotationAssertion(rdfs:comment goldbook:14315 "Macro-emulsions comprise large droplets and thus are \"unstable\" in the sense that the droplets sediment or float, depending on the densities of the dispersed phase and dispersion medium. Separation of the dispersed and continuous phases usually occurs within time periods from a few seconds to a few hours, depending upon the viscosity of the fluid medium and the size and density of the droplets."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14315 "Macro-emulsions usually contain low-molecular-weight or polymeric surfactants that decrease the rates of coalescence of dispersed droplets. Droplets of the dispersed phase may be also stabilized by adsorption of solid particles onto their surface (so-called Pickering stabilization)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14315 goldbook:14308)
AnnotationAssertion(rdfs:seeAlso goldbook:14315 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14315 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14315 "current"^^xsd:string)
Declaration(Class(goldbook:14316))
AnnotationAssertion(rdfs:label goldbook:14316 "mini-emulsion")
AnnotationAssertion(dcterms:description goldbook:14316 "Emulsion in which the particles of the dispersed phase have diameters in the range from approximately \\(\\pu{50 nm}\\) to \\(\\pu{1 \\upmu m}\\).")
AnnotationAssertion(rdfs:comment goldbook:14316 "Mini-emulsions are usually stabilized against diffusion degradation (Ostwald ripening) by a compound insoluble in the continuous phase."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14316 "The dispersed phase contains mixed stabilizers, e.g., an ionic surfactant, such as sodium dodecyl sulfate (n-dodecyl sulfate sodium) and a short aliphatic chain alcohol (\"co-surfactant\") for colloidal stability, or a water-insoluble compound, such as a hydrocarbon (\"co-stabilizer\" frequently and improperly called a \"co-surfactant\") limiting diffusion degradation. Mini-emulsions are usually stable for at least several days."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14316 goldbook:14308)
AnnotationAssertion(rdfs:seeAlso goldbook:14316 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14316 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14316 "current"^^xsd:string)
Declaration(Class(goldbook:14317))
AnnotationAssertion(rdfs:label goldbook:14317 "micro-emulsion")
AnnotationAssertion(dcterms:description goldbook:14317 "Dispersion made of water, oil, and surfactant(s) that is an isotropic and thermodynamically stable system with dispersed domain diameter varying approximately from \\(\\pu{1 nm}\\) to \\(\\pu{100 nm}\\), usually \\(\\pu{10 nm}\\) to \\(\\pu{50 nm}\\).")
AnnotationAssertion(rdfs:comment goldbook:14317 "In a micro-emulsion the domains of the dispersed phase are either globular or interconnected (to give a bicontinuous micro-emulsion)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14317 "The average diameter of droplets in macro-emulsion (usually referred to as an \"emulsion\") is close to one millimeter (i.e., \\(\\pu{E-3 m}\\)). Therefore, since micro- means \\(\\pu{E-6 m}\\) and emulsion implies that droplets of the dispersed phase have diameters close to \\(\\pu{E-3 m}\\), the micro-emulsion denotes a system with the size range of the dispersed phase in the \\(\\pu{E-6} \\times \\pu{E-3 m} = \\pu{E-9 m}\\) range."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14317 "The term \"micro-emulsion\" has come to take on special meaning. Entities of the dispersed phase are usually stabilized by surfactant and/or surfactant-cosurfactant (e.g., aliphatic alcohol) systems."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14317 "The term \"oil\" refers to any water-insoluble liquid."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14317 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14317 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14317 "current"^^xsd:string)
Declaration(Class(goldbook:14318))
AnnotationAssertion(rdfs:label goldbook:14318 "hemi-micelle")
AnnotationAssertion(dcterms:description goldbook:14318 "Type of micelle that exists in relatively small numbers below the critical micelle concentration.")
AnnotationAssertion(mito:isMentionedBy goldbook:14318 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14318 "current"^^xsd:string)
Declaration(Class(goldbook:14319))
AnnotationAssertion(rdfs:label goldbook:14319 "ad-micelle")
AnnotationAssertion(dcterms:description goldbook:14319 "Surfactant bilayer formed on a charged adsorbing surface.")
AnnotationAssertion(rdfs:comment goldbook:14319 "Ad-micelles are usually formed on inorganic particles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14319 "In the case of particles with charged surfaces the surfactant molecules are oriented with their charged head-groups toward the particle surfaces. In the case of further addition of surfactant, a surface bilayer may form, which is termed an ad-micelle (adsorbed micelle)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14319 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14319 "current"^^xsd:string)
Declaration(Class(goldbook:14320))
AnnotationAssertion(rdfs:label goldbook:14320 "micellar aggregation number")
AnnotationAssertion(dcterms:description goldbook:14320 "Number of molecules constituting a micelle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14320 "micellar degree of association")
AnnotationAssertion(mito:isMentionedBy goldbook:14320 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14320 "current"^^xsd:string)
Declaration(Class(goldbook:14321))
AnnotationAssertion(rdfs:label goldbook:14321 "micellar charge")
AnnotationAssertion(dcterms:description goldbook:14321 "Combined charge of the surfactant ions and counterions tightly bound to a micelle.")
AnnotationAssertion(rdfs:comment goldbook:14321 "Micelle with tightly bound ions behaves as a unit carrying the net charge."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14321 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14321 "current"^^xsd:string)
Declaration(Class(goldbook:14322))
AnnotationAssertion(rdfs:label goldbook:14322 "micellar relative molar mass")
AnnotationAssertion(dcterms:description goldbook:14322 "Mass of a mole of micelles divided by the molar mass constant. The relative molar mass of micelles (mic) is thus \\(M_{\\rm{r,mic}} = M_{\\rm{mic}}/M_{\\rm{u}}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14322 "micellar molecular weight")
AnnotationAssertion(rdfs:comment goldbook:14322 "1/12 of the molar mass of \\(\\ce{^{12}C}\\) is termed \"molar mass constant\" with symbol \\(M_{\\rm{u}} = M(\\ce{^{12}C})/12 = N_{\\rm{A}} m_{\\rm{u}}\\) and unit \\(\\pu{g mol-1}\\) where \\(m_{\\rm{u}}\\) is the \"atomic mass constant\" with unit \\(\\pu{u}\\) or \\(\\pu{Da}\\), and \\(N_{\\rm{A}}\\) is the Avogadro constant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14322 "The micellar relative molar mass refers to a neutral micelle and thus includes the mass of counterions that compensate the charge of surfactant molecules in micelles."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14322 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14322 "current"^^xsd:string)
Declaration(Class(goldbook:14323))
AnnotationAssertion(rdfs:label goldbook:14323 "particle number concentration")
AnnotationAssertion(dcterms:description goldbook:14323 "Number of particles per volume of suspending medium.")
AnnotationAssertion(mito:isMentionedBy goldbook:14323 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14323 "current"^^xsd:string)
Declaration(Class(goldbook:14324))
AnnotationAssertion(rdfs:label goldbook:14324 "solids content")
AnnotationAssertion(dcterms:description goldbook:14324 "Mass fraction of nonvolatile material in a polymer dispersion.")
AnnotationAssertion(rdfs:seeAlso goldbook:14324 goldbook:14311)
AnnotationAssertion(mito:isMentionedBy goldbook:14324 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14324 "current"^^xsd:string)
Declaration(Class(goldbook:14325))
AnnotationAssertion(rdfs:label goldbook:14325 "polymer content")
AnnotationAssertion(dcterms:description goldbook:14325 "Mass fraction of polymer in a polymer dispersion.")
AnnotationAssertion(rdfs:seeAlso goldbook:14325 goldbook:14311)
AnnotationAssertion(mito:isMentionedBy goldbook:14325 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14325 "current"^^xsd:string)
Declaration(Class(goldbook:14326))
AnnotationAssertion(rdfs:label goldbook:14326 "dispersed-phase concentration")
AnnotationAssertion(dcterms:description goldbook:14326 "Amount concentration of a species within the dispersed phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14326 "dispersed-phase amount concentration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14326 "particle-phase amount concentration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14326 "particle-phase concentration")
AnnotationAssertion(rdfs:comment goldbook:14326 "If the dispersed phase depends on quantities such as radius, \\(r\\), time, \\(t\\), etc., the recommended symbols are \\([\\ce{A}]_{\\rm{p}}(r,t,\\ldots)\\) and \\([\\ce{M}]_{\\rm{p}}(r,t,\\ldots)\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14326 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14326 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14326 "current"^^xsd:string)
Declaration(Class(goldbook:14327))
AnnotationAssertion(rdfs:label goldbook:14327 "continuous-phase concentration")
AnnotationAssertion(dcterms:description goldbook:14327 "Concentration of species within the continuous phase of a dispersion.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14327 "continuous-phase amount concentration")
AnnotationAssertion(rdfs:comment goldbook:14327 "If the continuous phase is water, the symbols \\([\\ce{A}]_{\\rm{w}}\\) and \\([\\ce{M}]_{\\rm{w}}\\) are usually used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14327 "If the continuous-phase concentration depends on quantities such as time \\(t\\), etc., the recommended symbols are \\([\\ce{A}]_{\\rm{cont}}(t,\\ldots)\\) and \\([\\ce{M}]_{\\rm{cont}}(t,\\ldots)\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14327 goldbook:14308)
AnnotationAssertion(mito:isMentionedBy goldbook:14327 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14327 "current"^^xsd:string)
Declaration(Class(goldbook:14328))
AnnotationAssertion(rdfs:label goldbook:14328 "polymer mass fraction")
AnnotationAssertion(dcterms:description goldbook:14328 "Mass fraction of polymer within the dispersed phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:14328 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14328 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14328 "current"^^xsd:string)
Declaration(Class(goldbook:14329))
AnnotationAssertion(rdfs:label goldbook:14329 "emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14329 "Polymerization whereby monomer(s), initiator, dispersion medium, and possibly colloid stabilizer constitute initially an inhomogeneous system resulting in particles of colloidal dimensions containing the formed polymer.")
AnnotationAssertion(rdfs:comment goldbook:14329 "With the exception of mini-emulsion polymerization, the term \"emulsion polymerization\" does not mean that polymerization occurs in the droplets of a monomer emulsion."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14329 goldbook:14345)
AnnotationAssertion(mito:isMentionedBy goldbook:14329 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14329 "current"^^xsd:string)
Declaration(Class(goldbook:14330))
AnnotationAssertion(rdfs:label goldbook:14330 "ab initio emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14330 "Emulsion polymerization in which no seed particles are added.")
AnnotationAssertion(rdfs:seeAlso goldbook:14330 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14330 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14330 "current"^^xsd:string)
Declaration(Class(goldbook:14331))
AnnotationAssertion(rdfs:label goldbook:14331 "batch emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14331 "Emulsion polymerization in which all the ingredients are placed in a reactor prior to reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:14331 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14331 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14331 "current"^^xsd:string)
Declaration(Class(goldbook:14332))
AnnotationAssertion(rdfs:label goldbook:14332 "continuous emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14332 "Emulsion polymerization in which all the ingredients are added continuously and the product latex is removed continuously.")
AnnotationAssertion(rdfs:seeAlso goldbook:14332 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14332 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14332 "current"^^xsd:string)
Declaration(Class(goldbook:14333))
AnnotationAssertion(rdfs:label goldbook:14333 "emulsifier-free emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14333 "Emulsion polymerization carried out without the addition of a colloid stabilizer.")
AnnotationAssertion(rdfs:comment goldbook:14333 "In an emulsifier-free emulsion polymerization, a colloid stabilizer is produced in situ (e.g., the polymerization of styrene initiated with potassium persulfate yields macromolecules with anionic end groups providing ionic stabilization of the colloidal polystyrene particles)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14333 "Other names, such as emulsifier-less, soap-less, soap-free, surfactant-less, and surfactant-free emulsion polymerization, that are sometimes used, are not recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14333 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14333 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14333 "current"^^xsd:string)
Declaration(Class(goldbook:14334))
AnnotationAssertion(rdfs:label goldbook:14334 "encapsulating emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14334 "Emulsion polymerization leading to the encapsulation of a solid within polymer particles or liquid polymer droplets.")
AnnotationAssertion(rdfs:comment goldbook:14334 "An encapsulating emulsion polymerization is often performed inside ad-micelles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14334 goldbook:14329)
AnnotationAssertion(rdfs:seeAlso goldbook:14334 goldbook:14319)
AnnotationAssertion(mito:isMentionedBy goldbook:14334 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14334 "current"^^xsd:string)
Declaration(Class(goldbook:14335))
AnnotationAssertion(rdfs:label goldbook:14335 "inverse emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14335 "Emulsion polymerization in a nonaqueous medium in which the dispersed phase is usually an aqueous solution, initially of monomer(s), and finally of polymer.")
AnnotationAssertion(rdfs:seeAlso goldbook:14335 goldbook:14329)
AnnotationAssertion(rdfs:seeAlso goldbook:14335 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14335 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14335 "current"^^xsd:string)
Declaration(Class(goldbook:14336))
AnnotationAssertion(rdfs:label goldbook:14336 "monomer-flooded emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14336 "Semi-continuous emulsion polymerization in which the monomer(s) is(are) fed to the reactor at a rate that exceeds the rate of polymerization.")
AnnotationAssertion(rdfs:comment goldbook:14336 "A monomer-flooded emulsion polymerization refers to a state where the monomer concentration in the polymer particles is at or greater than its equilibrium swelling value and therefore droplets may be formed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14336 goldbook:14340)
AnnotationAssertion(mito:isMentionedBy goldbook:14336 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14336 "current"^^xsd:string)
Declaration(Class(goldbook:14337))
AnnotationAssertion(rdfs:label goldbook:14337 "monomer-starved emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14337 "Semi-continuous emulsion polymerization in which the polymerization rate is controlled by the feed rate(s) of monomer(s), in such a way that, for most of the process, the polymerization rate equals the monomer(s) feed rate(s).")
AnnotationAssertion(rdfs:comment goldbook:14337 "Usually a monomer-starved emulsion polymerization refers to a state where the monomer concentration in the polymer particles is less than its equilibrium swelling value."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14337 goldbook:14340)
AnnotationAssertion(mito:isMentionedBy goldbook:14337 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14337 "current"^^xsd:string)
Declaration(Class(goldbook:14338))
AnnotationAssertion(rdfs:label goldbook:14338 "power-feed emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14338 "Semi-continuous emulsion copolymerization in which the instantaneous composition of the formed copolymer is the same as that of the added monomer mixture(s).")
AnnotationAssertion(rdfs:comment goldbook:14338 "A power-feed emulsion polymerization is normally achieved by feeding to the reactor monomer mixture(s) from one or more reservoirs under monomer-starved conditions. In the simplest case, reservoirs I and II are initially filled with monomers \\(\\ce{A}\\) and \\(\\ce{B}\\), respectively. During polymerization the contents of reservoir I are continuously pumped into the reactor and the contents of reservoir II are continuously pumped into reservoir I at definite rates."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14338 goldbook:14340)
AnnotationAssertion(mito:isMentionedBy goldbook:14338 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14338 "current"^^xsd:string)
Declaration(Class(goldbook:14339))
AnnotationAssertion(rdfs:label goldbook:14339 "seeded emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14339 "Emulsion polymerization with seed particles are formed in situ or added initially to the polymerizing mixture.")
AnnotationAssertion(rdfs:comment goldbook:14339 "Under certain conditions the seed particles capture enough radical species from the aqueous phase so that no new particles are formed. In such polymerization, the number of growing particles is equal to the number of seed particles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14339 goldbook:14329)
AnnotationAssertion(rdfs:seeAlso goldbook:14339 goldbook:14376)
AnnotationAssertion(mito:isMentionedBy goldbook:14339 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14339 "current"^^xsd:string)
Declaration(Class(goldbook:14340))
AnnotationAssertion(rdfs:label goldbook:14340 "semi-continuous emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14340 "Emulsion polymerization in which some of the ingredients are initially placed in a reactor and the remaining ingredients are added during the polymerization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14340 "semi-batch emulsion polymerization")
AnnotationAssertion(rdfs:seeAlso goldbook:14340 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14340 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14340 "current"^^xsd:string)
Declaration(Class(goldbook:14341))
AnnotationAssertion(rdfs:label goldbook:14341 "vesicle polymerisation")
AnnotationAssertion(dcterms:description goldbook:14341 "Polymerization inside the bilayer of a vesicle leading to formation of polymer inside the bilayer.")
AnnotationAssertion(rdfs:comment goldbook:14341 "The bilayer may contain polymerizable and non-polymerizable molecules."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14341 "Usually phase separation occurs leading to entities with inhomogeneously distributed polymer (e.g., entities that contain a latex particle inside the vesicle’s bilayer)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14341 "The morphology of such entities is called \"parachute\" morphology, owing to similarity of their shape to the shape of parachute canopy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14341 "In the case of reactive copolymerizing surfactants (i.e., surfmers) hollow spherical entities can sometimes be obtained with a homogeneous distribution of polymer in the bilayer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14341 goldbook:14377)
AnnotationAssertion(mito:isMentionedBy goldbook:14341 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14341 "current"^^xsd:string)
Declaration(Class(goldbook:14342))
AnnotationAssertion(rdfs:label goldbook:14342 "micro-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14342 "Emulsion polymerization in which the starting system is a micro-emulsion and the final latex comprises colloidal particles of polymer dispersed in an aqueous medium.")
AnnotationAssertion(rdfs:comment goldbook:14342 "Diameters of polymer particles formed in the micro-emulsion polymerization usually are between \\(\\pu{10 nm}\\) and \\(\\pu{50 nm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14342 goldbook:14329)
AnnotationAssertion(rdfs:seeAlso goldbook:14342 goldbook:14317)
AnnotationAssertion(mito:isMentionedBy goldbook:14342 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14342 "current"^^xsd:string)
Declaration(Class(goldbook:14343))
AnnotationAssertion(rdfs:label goldbook:14343 "inverse micro-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14343 "Emulsion polymerization in which the starting system is a micro-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:14343 goldbook:14329)
AnnotationAssertion(rdfs:seeAlso goldbook:14343 goldbook:14308)
AnnotationAssertion(rdfs:seeAlso goldbook:14343 goldbook:14307)
AnnotationAssertion(rdfs:seeAlso goldbook:14343 goldbook:14317)
AnnotationAssertion(mito:isMentionedBy goldbook:14343 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14343 "current"^^xsd:string)
Declaration(Class(goldbook:14344))
AnnotationAssertion(rdfs:label goldbook:14344 "micellar polymerisation")
AnnotationAssertion(dcterms:description goldbook:14344 "Polymerization of a polymerizable surfactant in solution above its critical micelle concentration.")
AnnotationAssertion(rdfs:comment goldbook:14344 "The initial micellar structure usually is not preserved during the polymerization."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14344 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14344 "current"^^xsd:string)
Declaration(Class(goldbook:14345))
AnnotationAssertion(rdfs:label goldbook:14345 "mini-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14345 "Polymerization of a mini-emulsion of monomer in which all of the polymerization occurs within preexisting monomer particles without the formation of new particles.")
AnnotationAssertion(rdfs:seeAlso goldbook:14345 goldbook:14316)
AnnotationAssertion(mito:isMentionedBy goldbook:14345 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14345 "current"^^xsd:string)
Declaration(Class(goldbook:14346))
AnnotationAssertion(rdfs:label goldbook:14346 "inverse mini-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14346 "Emulsion polymerization in which the starting system is a mini-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:14346 goldbook:14329)
AnnotationAssertion(rdfs:seeAlso goldbook:14346 goldbook:14308)
AnnotationAssertion(rdfs:seeAlso goldbook:14346 goldbook:14307)
AnnotationAssertion(rdfs:seeAlso goldbook:14346 goldbook:14316)
AnnotationAssertion(mito:isMentionedBy goldbook:14346 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14346 "current"^^xsd:string)
Declaration(Class(goldbook:14347))
AnnotationAssertion(rdfs:label goldbook:14347 "precipitation polymerisation")
AnnotationAssertion(dcterms:description goldbook:14347 "Polymerization in which monomer(s), initiator(s) and colloid stabilizer(s) are dissolved in a solvent and this continuous phase that is a nonsolvent for the formed polymer beyond a critical molecular weight.")
AnnotationAssertion(rdfs:seeAlso goldbook:14347 goldbook:14308)
AnnotationAssertion(mito:isMentionedBy goldbook:14347 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14347 "current"^^xsd:string)
Declaration(Class(goldbook:14348))
AnnotationAssertion(rdfs:label goldbook:14348 "dispersion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14348 "Precipitation polymerization in which monomer(s), initiator(s), and colloid stabilizer(s) are dissolved in a solvent forming initially a homogeneous system that produces polymer and results in the formation of polymer particles.")
AnnotationAssertion(rdfs:comment goldbook:14348 "The process usually results in polymer particles of colloidal dimensions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14348 goldbook:14347)
AnnotationAssertion(mito:isMentionedBy goldbook:14348 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14348 "current"^^xsd:string)
Declaration(Class(goldbook:14349))
AnnotationAssertion(rdfs:label goldbook:14349 "seeded dispersion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14349 "Dispersion polymerization in which seed particles are formed in situ or added prior to initiation of the polymerization.")
AnnotationAssertion(rdfs:seeAlso goldbook:14349 goldbook:14348)
AnnotationAssertion(rdfs:seeAlso goldbook:14349 goldbook:14376)
AnnotationAssertion(mito:isMentionedBy goldbook:14349 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14349 "current"^^xsd:string)
Declaration(Class(goldbook:14350))
AnnotationAssertion(rdfs:label goldbook:14350 "precipitation polycondensation")
AnnotationAssertion(dcterms:description goldbook:14350 "Precipitation polymerization proceeding by polycondensation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14350 goldbook:14347)
AnnotationAssertion(mito:isMentionedBy goldbook:14350 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14350 "current"^^xsd:string)
Declaration(Class(goldbook:14351))
AnnotationAssertion(rdfs:label goldbook:14351 "dispersion polycondensation")
AnnotationAssertion(dcterms:description goldbook:14351 "Dispersion polymerization proceeding by polycondensation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14351 goldbook:14348)
AnnotationAssertion(mito:isMentionedBy goldbook:14351 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14351 "current"^^xsd:string)
Declaration(Class(goldbook:14352))
AnnotationAssertion(rdfs:label goldbook:14352 "precipitation polyaddition")
AnnotationAssertion(dcterms:description goldbook:14352 "Precipitation polymerization proceeding by polyaddition.")
AnnotationAssertion(rdfs:seeAlso goldbook:14352 goldbook:14347)
AnnotationAssertion(mito:isMentionedBy goldbook:14352 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14352 "current"^^xsd:string)
Declaration(Class(goldbook:14353))
AnnotationAssertion(rdfs:label goldbook:14353 "dispersion polyaddition")
AnnotationAssertion(dcterms:description goldbook:14353 "Dispersion polymerization proceeding by polyaddition.")
AnnotationAssertion(rdfs:seeAlso goldbook:14353 goldbook:14348)
AnnotationAssertion(mito:isMentionedBy goldbook:14353 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14353 "current"^^xsd:string)
Declaration(Class(goldbook:14354))
AnnotationAssertion(rdfs:label goldbook:14354 "suspension polymerisation")
AnnotationAssertion(dcterms:description goldbook:14354 "Polymerization in which polymer is formed in monomer, or monomer-solvent droplets in a continuous phase that is a nonsolvent for both the monomer and the formed polymer.")
AnnotationAssertion(rdfs:comment goldbook:14354 "In suspension polymerization, the initiator is located mainly in the monomer phase."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14354 "Monomer or monomer-solvent droplets in suspension polymerization have diameters usually exceeding \\(\\pu{10 \\upmu m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14354 goldbook:14308)
AnnotationAssertion(mito:isMentionedBy goldbook:14354 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14354 "current"^^xsd:string)
Declaration(Class(goldbook:14355))
AnnotationAssertion(rdfs:label goldbook:14355 "micro-suspension polymerisation")
AnnotationAssertion(dcterms:description goldbook:14355 "Suspension polymerization in which the diameter of the monomer droplets is of the order of a few \\(\\pu{\\upmu m}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:14355 goldbook:14354)
AnnotationAssertion(mito:isMentionedBy goldbook:14355 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14355 "current"^^xsd:string)
Declaration(Class(goldbook:14356))
AnnotationAssertion(rdfs:label goldbook:14356 "average number of radicals per particle")
AnnotationAssertion(dcterms:description goldbook:14356 "Ratio of the total number of radicals in particles to the number of particles.")
AnnotationAssertion(mito:isMentionedBy goldbook:14356 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14356 "current"^^xsd:string)
Declaration(Class(goldbook:14357))
AnnotationAssertion(rdfs:label goldbook:14357 "critical oligomer degree of polymerisation for irreversible entry")
AnnotationAssertion(dcterms:description goldbook:14357 "Lowest degree of polymerization of aqueous-phase oligomer-radicals needed for irreversible capture by colloidal particles, micelles, or both during a polymerization.")
AnnotationAssertion(mito:isMentionedBy goldbook:14357 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14357 "current"^^xsd:string)
Declaration(Class(goldbook:14358))
AnnotationAssertion(rdfs:label goldbook:14358 "critical oligomer degree of polymerisation for precipitation")
AnnotationAssertion(dcterms:description goldbook:14358 "Lowest degree of polymerization of oligomer-radicals that precipitate from the continuous phase during a polymerization.")
AnnotationAssertion(rdfs:comment goldbook:14358 "\\(j_{\\rm{crit}}\\) is usually equal to the degree of polymerization at which oligomer-radicals undergo a coil-to-globule transition."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14358 goldbook:14308)
AnnotationAssertion(mito:isMentionedBy goldbook:14358 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14358 "current"^^xsd:string)
Declaration(Class(goldbook:14359))
AnnotationAssertion(rdfs:label goldbook:14359 "intervals in emulsion polymerisations")
AnnotationAssertion(dcterms:description goldbook:14359 "Periods in an emulsion polymerization defined by the formation of polymer particles, and the presence or absence of monomer droplets in the polymerizing mixture.")
AnnotationAssertion(rdfs:comment goldbook:14359 "In naming particular intervals, the word \"interval\" is always written with a capital I."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14359 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14359 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14359 "current"^^xsd:string)
Declaration(Class(goldbook:14360))
AnnotationAssertion(rdfs:label goldbook:14360 "interval 1 in emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14360 "Period in a batch ab initio emulsion polymerization during which the formation of particles takes place.")
AnnotationAssertion(rdfs:seeAlso goldbook:14360 goldbook:14330)
AnnotationAssertion(rdfs:seeAlso goldbook:14360 goldbook:14331)
AnnotationAssertion(mito:isMentionedBy goldbook:14360 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14360 "current"^^xsd:string)
Declaration(Class(goldbook:14361))
AnnotationAssertion(rdfs:label goldbook:14361 "interval 2 in emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14361 "Period in an emulsion polymerization during which no new particles are formed and monomer droplets are present.")
AnnotationAssertion(rdfs:comment goldbook:14361 "This interval is associated with an approximately constant value of the average number of radicals per particle, an approximately constant value of monomer concentration in the particles, and, thus, an approximately constant rate of polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14361 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14361 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14361 "current"^^xsd:string)
Declaration(Class(goldbook:14362))
AnnotationAssertion(rdfs:label goldbook:14362 "interval 3 in emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14362 "Period in an emulsion polymerization during which no new particles are formed and no monomer droplets are present.")
AnnotationAssertion(rdfs:seeAlso goldbook:14362 goldbook:14329)
AnnotationAssertion(mito:isMentionedBy goldbook:14362 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14362 "current"^^xsd:string)
Declaration(Class(goldbook:14363))
AnnotationAssertion(rdfs:label goldbook:14363 "zero-one behaviour")
AnnotationAssertion(dcterms:description goldbook:14363 "Limiting behaviour in an emulsion, mini-emulsion, or micro-emulsion polymerization during which the entry of a radical into a particle that contains a growing radical results in termination before significant propagation has occurred.")
AnnotationAssertion(rdfs:comment goldbook:14363 "This type of behaviour commonly occurs for small particles, the size of which depends on the type of monomer and on polymerization conditions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14363 "The value of the average number of radicals per particle (\\(\\bar N\\)) for a zero-one system can never exceed \\(\\pu{0.5}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14363 goldbook:14356)
AnnotationAssertion(rdfs:seeAlso goldbook:14363 goldbook:14342)
AnnotationAssertion(rdfs:seeAlso goldbook:14363 goldbook:14316)
AnnotationAssertion(mito:isMentionedBy goldbook:14363 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14363 "current"^^xsd:string)
Declaration(Class(goldbook:14364))
AnnotationAssertion(rdfs:label goldbook:14364 "compartmentalisation behaviour")
AnnotationAssertion(dcterms:description goldbook:14364 "Zero-one behaviour wherein radicals are isolated, each being located within a different latex particle.")
AnnotationAssertion(rdfs:seeAlso goldbook:14364 goldbook:14363)
AnnotationAssertion(mito:isMentionedBy goldbook:14364 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14364 "current"^^xsd:string)
Declaration(Class(goldbook:14365))
AnnotationAssertion(rdfs:label goldbook:14365 "pseudo-bulk behaviour")
AnnotationAssertion(dcterms:description goldbook:14365 "Behaviour in an emulsion, mini-emulsion, micro-emulsion, suspension, or dispersion polymerization wherein the kinetics are such that the rate equations are the same as those for polymerization in bulk.")
AnnotationAssertion(rdfs:comment goldbook:14365 "In a pseudo-bulk system, the average number of radicals per particle, \\(\\bar N\\), can take any value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14365 "Common extreme cases are (i) when the value of \\(\\bar N\\) is so high that each particle effectively behaves as a micro-reactor, and (ii) when the value of \\(\\bar N\\) is low, exit is very rapid and the exited radical re-enters another particle, may grow to a significant degree of polymerization, and so on before any termination event."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14365 goldbook:14356)
AnnotationAssertion(rdfs:seeAlso goldbook:14365 goldbook:14348)
AnnotationAssertion(rdfs:seeAlso goldbook:14365 goldbook:14317)
AnnotationAssertion(rdfs:seeAlso goldbook:14365 goldbook:14316)
AnnotationAssertion(mito:isMentionedBy goldbook:14365 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14365 "current"^^xsd:string)
Declaration(Class(goldbook:14366))
AnnotationAssertion(rdfs:label goldbook:14366 "homogeneous micellisation nucleation")
AnnotationAssertion(dcterms:description goldbook:14366 "Formation of primary particles as a result of micelle formation from surface-active oligomer radicals formed in a polymerization.")
AnnotationAssertion(rdfs:comment goldbook:14366 "The surface-active oligomer radicals are usually formed by polymerization with initiators providing ionic end-groups."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14366 goldbook:14374)
AnnotationAssertion(mito:isMentionedBy goldbook:14366 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14366 "current"^^xsd:string)
Declaration(Class(goldbook:14367))
AnnotationAssertion(rdfs:label goldbook:14367 "micellar nucleation")
AnnotationAssertion(dcterms:description goldbook:14367 "Formation of primary particles as a result of polymerization within monomer-swollen micelles initiated by the capture of primary radicals or oligomer-radicals.")
AnnotationAssertion(rdfs:seeAlso goldbook:14367 goldbook:14374)
AnnotationAssertion(rdfs:seeAlso goldbook:14367 goldbook:14375)
AnnotationAssertion(mito:isMentionedBy goldbook:14367 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14367 "current"^^xsd:string)
Declaration(Class(goldbook:14368))
AnnotationAssertion(rdfs:label goldbook:14368 "coagulative nucleation")
AnnotationAssertion(dcterms:description goldbook:14368 "A process combining nucleation by any mechanism with subsequent coagulation being a significant event in formation of colloidally stable particles.")
AnnotationAssertion(rdfs:comment goldbook:14368 "The term \"coagulative nucleation\" does not mean that nucleation is caused by coagulation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14368 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14368 "current"^^xsd:string)
Declaration(Class(goldbook:14369))
AnnotationAssertion(rdfs:label goldbook:14369 "phase-transfer event in a dispersed system")
AnnotationAssertion(dcterms:description goldbook:14369 "Transport of any species (radical, monomer, chain-transfer agent, etc.) from the continuous to the discrete phase and vice-versa.")
AnnotationAssertion(mito:isMentionedBy goldbook:14369 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14369 "current"^^xsd:string)
Declaration(Class(goldbook:14370))
AnnotationAssertion(rdfs:label goldbook:14370 "radical entry")
AnnotationAssertion(dcterms:description goldbook:14370 "Irreversible transport of a radical from the continuous to the dispersed phase.")
AnnotationAssertion(rdfs:comment goldbook:14370 "This type of transport frequently involves a radical arising directly from initiator. An example is the sulfate radical anion \\(\\ce{SO4^{.-}}\\), with the systematic name tetraoxidosulfate (\\(•1-\\)) (where the part in parentheses is pronounced \"dot one minus\"), propagating with monomer in the aqueous phase until the resulting oligomeric species enters a particle irreversibly."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14370 goldbook:14307)
AnnotationAssertion(mito:isMentionedBy goldbook:14370 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14370 "current"^^xsd:string)
Declaration(Class(goldbook:14371))
AnnotationAssertion(rdfs:label goldbook:14371 "radical entry frequency")
AnnotationAssertion(dcterms:description goldbook:14371 "Average number of entry events per particle per unit interval of time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14371 "entry frequency")
AnnotationAssertion(rdfs:comment goldbook:14371 "The term \"entry rate coefficient\" is incorrect and is not recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14371 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14371 "current"^^xsd:string)
Declaration(Class(goldbook:14372))
AnnotationAssertion(rdfs:label goldbook:14372 "radical exit")
AnnotationAssertion(dcterms:description goldbook:14372 "Reversible or irreversible transport of a radical from the dispersed to the continuous phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14372 "radical desorption")
AnnotationAssertion(rdfs:comment goldbook:14372 "This type of transport is frequently through transfer of the radical activity at the end of a macroradical within a particle to a smaller species which may then diffuse irreversibly out of the parent particle into the continuous phase."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14372 goldbook:14308)
AnnotationAssertion(mito:isMentionedBy goldbook:14372 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14372 "current"^^xsd:string)
Declaration(Class(goldbook:14373))
AnnotationAssertion(rdfs:label goldbook:14373 "radical exit frequency")
AnnotationAssertion(dcterms:description goldbook:14373 "Average number of exit events per particle per unit interval of time per radical.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14373 "exit frequency")
AnnotationAssertion(rdfs:comment goldbook:14373 "The term \"exit rate coefficient\" is incorrect and is not recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14373 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14373 "current"^^xsd:string)
Declaration(Class(goldbook:14375))
AnnotationAssertion(rdfs:label goldbook:14375 "primary radical")
AnnotationAssertion(dcterms:description goldbook:14375 "Radicals formed from an initiator molecule.")
AnnotationAssertion(rdfs:comment goldbook:14375 "\"Primary radical\" describes the radical before it reacts with any molecule of monomer."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14375 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14375 "current"^^xsd:string)
Declaration(Class(goldbook:14376))
AnnotationAssertion(rdfs:label goldbook:14376 "seed particle")
AnnotationAssertion(dcterms:description goldbook:14376 "Particle in a polymer colloid that is the locus of subsequent polymerization.")
AnnotationAssertion(rdfs:comment goldbook:14376 "A seed particle is either added to a polymerization mixture before the polymerization begins, or is formed in situ."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14376 goldbook:14313)
AnnotationAssertion(mito:isMentionedBy goldbook:14376 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14376 "current"^^xsd:string)
Declaration(Class(goldbook:14377))
AnnotationAssertion(rdfs:label goldbook:14377 "surfmer")
AnnotationAssertion(dcterms:description goldbook:14377 "Monomer with the properties of a surfactant.")
AnnotationAssertion(mito:isMentionedBy goldbook:14377 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14377 "current"^^xsd:string)
Declaration(Class(goldbook:14378))
AnnotationAssertion(rdfs:label goldbook:14378 "inisurf")
AnnotationAssertion(dcterms:description goldbook:14378 "Initiator with the properties of a surfactant.")
AnnotationAssertion(mito:isMentionedBy goldbook:14378 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14378 "current"^^xsd:string)
Declaration(Class(goldbook:14379))
AnnotationAssertion(rdfs:label goldbook:14379 "transurf")
AnnotationAssertion(dcterms:description goldbook:14379 "Chain-transfer agent with the properties of a surfactant.")
AnnotationAssertion(mito:isMentionedBy goldbook:14379 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14379 "current"^^xsd:string)
Declaration(Class(goldbook:14380))
AnnotationAssertion(rdfs:label goldbook:14380 "breaking of an emulsion")
AnnotationAssertion(dcterms:description goldbook:14380 "Formation of a system with separate macrophases from an emulsion.")
AnnotationAssertion(mito:isMentionedBy goldbook:14380 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14380 "current"^^xsd:string)
Declaration(Class(goldbook:14381))
AnnotationAssertion(rdfs:label goldbook:14381 "critical coagulation concentration")
AnnotationAssertion(dcterms:description goldbook:14381 "Minimum concentration of electrolyte at and above which rapid coagulation occurs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14381 "critical coagulation amount concentration")
AnnotationAssertion(rdfs:comment goldbook:14381 "Rapid coagulation occurs when the only forces between the particles are the attractive van der Waals forces, all other forces being negligible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14381 "As the value of the \\({\\rm{c}}_{\\rm{cc}}\\) depends to some extent on the experimental circumstances (method of mixing, time between mixing and determining the state of coagulation, criterion for measuring degree of coagulation, etc.), these should be clearly stated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14381 goldbook:14384)
AnnotationAssertion(mito:isMentionedBy goldbook:14381 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14381 "current"^^xsd:string)
Declaration(Class(goldbook:14382))
AnnotationAssertion(rdfs:label goldbook:14382 "heterocoagulation")
AnnotationAssertion(dcterms:description goldbook:14382 "Coagulation of particles of different kinds or sizes, or both.")
AnnotationAssertion(mito:isMentionedBy goldbook:14382 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14382 "current"^^xsd:string)
Declaration(Class(goldbook:14383))
AnnotationAssertion(rdfs:label goldbook:14383 "homocoagulation")
AnnotationAssertion(dcterms:description goldbook:14383 "Coagulation of colloidal particles of the same size and kind.")
AnnotationAssertion(mito:isMentionedBy goldbook:14383 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14383 "current"^^xsd:string)
Declaration(Class(goldbook:14384))
AnnotationAssertion(rdfs:label goldbook:14384 "fast coagulation rate")
AnnotationAssertion(dcterms:description goldbook:14384 "Rate of coagulation in the absence of any repulsive barrier between particles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14384 "rapid coagulation rate")
AnnotationAssertion(rdfs:comment goldbook:14384 "The fast coagulation rate is usually measured by adding electrolyte at an increasing concentration, until the observed coagulation rate becomes independent of the electrolyte concentration."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14384 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14384 "current"^^xsd:string)
Declaration(Class(goldbook:14385))
AnnotationAssertion(rdfs:label goldbook:14385 "fast coagulation rate coefficient")
AnnotationAssertion(dcterms:description goldbook:14385 "Rate coefficient for fast coagulation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14385 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14385 "current"^^xsd:string)
Declaration(Class(goldbook:14387))
AnnotationAssertion(rdfs:label goldbook:14387 "flocculation rate coefficient")
AnnotationAssertion(dcterms:description goldbook:14387 "Rate coefficient for flocculation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14387 goldbook:14386)
AnnotationAssertion(mito:isMentionedBy goldbook:14387 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14387 "current"^^xsd:string)
Declaration(Class(goldbook:14388))
AnnotationAssertion(rdfs:label goldbook:14388 "micellisation")
AnnotationAssertion(dcterms:description goldbook:14388 "Process in which surface-active molecules or ions aggregate into micelles.")
AnnotationAssertion(mito:isMentionedBy goldbook:14388 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14388 "current"^^xsd:string)
Declaration(Class(goldbook:14389))
AnnotationAssertion(rdfs:label goldbook:14389 "orthokinetic coagulation")
AnnotationAssertion(dcterms:description goldbook:14389 "Coagulation due to collisions of particles induced by hydrodynamic motion.")
AnnotationAssertion(rdfs:comment goldbook:14389 "Orthokinetic coagulation occurs when shear-induced collisions dominate over collisions due to Brownian motion."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14389 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14389 "current"^^xsd:string)
Declaration(Class(goldbook:14390))
AnnotationAssertion(rdfs:label goldbook:14390 "particle monolayer")
AnnotationAssertion(dcterms:description goldbook:14390 "Monolayer of particles deposited at an interface.")
AnnotationAssertion(rdfs:comment goldbook:14390 "A monolayer of regularly deposited particles is called a two-dimensional colloidal crystal."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14390 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14390 "current"^^xsd:string)
Declaration(Class(goldbook:14391))
AnnotationAssertion(rdfs:label goldbook:14391 "perikinetic coagulation")
AnnotationAssertion(dcterms:description goldbook:14391 "Coagulation due to collisions of particles caused by their Brownian motion.")
AnnotationAssertion(rdfs:comment goldbook:14391 "Perikinetic coagulation occurs in the absence of mixing or under conditions where shear-induced collisions are negligible compared to diffusion-induced collisions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14391 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14391 "current"^^xsd:string)
Declaration(Class(goldbook:14392))
AnnotationAssertion(rdfs:label goldbook:14392 "slow coagulation rate")
AnnotationAssertion(dcterms:description goldbook:14392 "Rate of coagulation in presence of repulsive barriers between particles.")
AnnotationAssertion(mito:isMentionedBy goldbook:14392 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14392 "current"^^xsd:string)
Declaration(Class(goldbook:14393))
AnnotationAssertion(rdfs:label goldbook:14393 "slow coagulation rate coefficient")
AnnotationAssertion(dcterms:description goldbook:14393 "Rate coefficient for slow coagulation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14393 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14393 "current"^^xsd:string)
Declaration(Class(goldbook:14394))
AnnotationAssertion(rdfs:label goldbook:14394 "stability ratio")
AnnotationAssertion(dcterms:description goldbook:14394 "Ratio \\(W = k_{\\rm{fast}}/k_{\\rm{slow}}\\) or \\(W = k_{\\rm{fast}}/k_{\\rm{floc}}\\), for coagulation or flocculation, respectively, with \\(k_{\\rm{fast}}\\), \\(k_{\\rm{slow}}\\), and \\(k_{\\rm{floc}}\\) measured under the same mixing (or hydrodynamic) conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14394 "Fuchs stability ratio")
AnnotationAssertion(rdfs:comment goldbook:14394 "When comparing \\(W\\) with theory, the fast coagulation rates are often approximated by the Smoluchowski rates of coagulation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14394 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14394 "current"^^xsd:string)
Declaration(Class(goldbook:14395))
AnnotationAssertion(rdfs:label goldbook:14395 "colloidally stable system")
AnnotationAssertion(dcterms:description goldbook:14395 "System in which the particles essentially do not aggregate or sediment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14395 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14395 "current"^^xsd:string)
Declaration(Class(goldbook:14396))
AnnotationAssertion(rdfs:label goldbook:14396 "electrostatic stabilisation")
AnnotationAssertion(dcterms:description goldbook:14396 "Stabilization of a colloid resulting from the mutual repulsion of the electrical double layers surrounding its particles.")
AnnotationAssertion(mito:isMentionedBy goldbook:14396 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14396 "current"^^xsd:string)
Declaration(Class(goldbook:14397))
AnnotationAssertion(rdfs:label goldbook:14397 "electrosteric stabilisation")
AnnotationAssertion(dcterms:description goldbook:14397 "Stabilization of a colloid that has both steric and electrostatic stabilization characteristics.")
AnnotationAssertion(rdfs:seeAlso goldbook:14397 goldbook:14396)
AnnotationAssertion(mito:isMentionedBy goldbook:14397 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14397 "current"^^xsd:string)
Declaration(Class(goldbook:14398))
AnnotationAssertion(rdfs:label goldbook:14398 "steric stabilisation")
AnnotationAssertion(dcterms:description goldbook:14398 "Stabilization of a colloid resulting from covering particles with a layer of molecules solvated by the continuous medium.")
AnnotationAssertion(mito:isMentionedBy goldbook:14398 doi:10.1351/PAC-REC-10-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14398 "current"^^xsd:string)
Declaration(Class(goldbook:14399))
AnnotationAssertion(rdfs:label goldbook:14399 "ecotoxicology")
AnnotationAssertion(dcterms:description goldbook:14399 "Study of the toxic effects of chemical and physical agents on all living organisms, especially on populations and communities within defined ecosystems; it includes transfer pathways of these agents and their interactions with the environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14399 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14399 "current"^^xsd:string)
Declaration(Class(goldbook:14400))
AnnotationAssertion(rdfs:label goldbook:14400 "mutagenicity")
AnnotationAssertion(dcterms:description goldbook:14400 "Ability of a physical, chemical, or biological agent to induce (or generate) heritable changes (mutations) in the genotype in a cell as a consequence of alterations or loss of genes or chromosomes (or parts thereof).")
AnnotationAssertion(mito:isMentionedBy goldbook:14400 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14400 "current"^^xsd:string)
Declaration(Class(goldbook:14401))
AnnotationAssertion(rdfs:label goldbook:14401 "ultrafine particle")
AnnotationAssertion(dcterms:description goldbook:14401 "Particle in air of aerodynamic diameter \\(\\pu{\\lt 0.1 \\upmu m}\\).")
AnnotationAssertion(rdfs:comment goldbook:14401 "The fraction of the air particulates referred to as ultrafines is often referred to as the \\(\\pu{PM_{0.1}}\\) fraction."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14401 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14401 "current"^^xsd:string)
Declaration(Class(goldbook:14402))
AnnotationAssertion(rdfs:label goldbook:14402 "toxicogenetics")
AnnotationAssertion(dcterms:description goldbook:14402 "Study of the influence of hereditary factors on the effects of potentially toxic substances on individual organisms.")
AnnotationAssertion(mito:isMentionedBy goldbook:14402 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14402 "current"^^xsd:string)
Declaration(Class(goldbook:14403))
AnnotationAssertion(rdfs:label goldbook:14403 "reproductive toxicity")
AnnotationAssertion(dcterms:description goldbook:14403 "Ability of a physical, chemical, or biological agent to induce adverse effects in the reproductive system.")
AnnotationAssertion(mito:isMentionedBy goldbook:14403 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14403 "current"^^xsd:string)
Declaration(Class(goldbook:14404))
AnnotationAssertion(rdfs:label goldbook:14404 "reproductive toxicology")
AnnotationAssertion(dcterms:description goldbook:14404 "Study of the non-heritable adverse effects of substances on male and female reproductive function or capacity and on resultant progeny.")
AnnotationAssertion(mito:isMentionedBy goldbook:14404 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14404 "current"^^xsd:string)
Declaration(Class(goldbook:14405))
AnnotationAssertion(rdfs:label goldbook:14405 "risk assessment management process")
AnnotationAssertion(dcterms:description goldbook:14405 "Global term for the whole process from hazard identification to risk management.")
AnnotationAssertion(mito:isMentionedBy goldbook:14405 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14405 "current"^^xsd:string)
Declaration(Class(goldbook:14406))
AnnotationAssertion(rdfs:label goldbook:14406 "risk management")
AnnotationAssertion(dcterms:description goldbook:14406 "Decision-making process involving considerations of political, social, economic, and engineering factors with relevant risk assessments relating to a potential hazard so as to develop, analyze, and compare regulatory options and to select the optimal regulatory response for safety from that hazard.")
AnnotationAssertion(rdfs:comment goldbook:14406 "Essentially risk management is the combination of three steps: risk evaluation; emission and exposure control; risk monitoring."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14406 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14406 "current"^^xsd:string)
Declaration(Class(goldbook:14407))
AnnotationAssertion(rdfs:label goldbook:14407 "safety")
AnnotationAssertion(dcterms:description goldbook:14407 "Reciprocal of risk: practical certainty that injury will not result from a hazard under defined conditions.")
AnnotationAssertion(rdfs:comment goldbook:14407 "Safety of a drug or other substance in the context of human health: the extent to which a substance may be used in the amount necessary for the intended therapeutic purpose with a minimum risk of adverse health effects."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14407 "Safety (toxicological): The high probability that injury will not result from exposure to a substance under defined conditions of quantity and manner of use, ideally controlled to minimize exposure."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14407 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14407 "current"^^xsd:string)
Declaration(Class(goldbook:14408))
AnnotationAssertion(rdfs:label goldbook:14408 "safety data sheet")
AnnotationAssertion(dcterms:description goldbook:14408 "Single page giving toxicological and other safety advice, usually associated with a particular preparation, substance, process, use pattern, or exposure scenario.")
AnnotationAssertion(mito:isMentionedBy goldbook:14408 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14408 "current"^^xsd:string)
Declaration(Class(goldbook:14409))
AnnotationAssertion(rdfs:label goldbook:14409 "immunotoxicity")
AnnotationAssertion(dcterms:description goldbook:14409 "Ability of a physical, chemical, or biological agent to induce adverse effects in the immune system.")
AnnotationAssertion(mito:isMentionedBy goldbook:14409 doi:10.1351/PAC-REC-09-03-01)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14409 "current"^^xsd:string)
Declaration(Class(goldbook:14410))
AnnotationAssertion(rdfs:label goldbook:14410 "dormant polymer chain")
AnnotationAssertion(dcterms:description goldbook:14410 "Temporarily deactivated chain carrier.")
AnnotationAssertion(mito:isMentionedBy goldbook:14410 doi:10.1351/PAC-REC-08-04-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14410 "current"^^xsd:string)
Declaration(Class(goldbook:14411))
AnnotationAssertion(rdfs:label goldbook:14411 "reversible chain deactivation")
AnnotationAssertion(dcterms:description goldbook:14411 "Deactivation of a chain carrier in a chain polymerisation, reversibly converting the active center into an inactive one and then, within the lifetime of a growing macromolecule, regenerating an active center on the same original chain carrier.")
AnnotationAssertion(mito:isMentionedBy goldbook:14411 doi:10.1351/PAC-REC-08-04-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14411 "current"^^xsd:string)
Declaration(Class(goldbook:14412))
AnnotationAssertion(rdfs:label goldbook:14412 "degenerate-transfer radical polymerisation")
AnnotationAssertion(dcterms:description goldbook:14412 "Controlled reversible-deactivation radical polymerization in which the deactivation of the radicals involves degenerative transfer (DT) of a group (or atom).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14412 "DTRP")
AnnotationAssertion(mito:isMentionedBy goldbook:14412 doi:10.1351/PAC-REC-08-04-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14412 "current"^^xsd:string)
Declaration(Class(goldbook:14413))
AnnotationAssertion(rdfs:label goldbook:14413 "absorbate")
AnnotationAssertion(dcterms:description goldbook:14413 "Substance that enters and is retained inside a solid or semisolid matrix (absorbent).")
AnnotationAssertion(rdfs:seeAlso goldbook:14413 goldbook:14414)
AnnotationAssertion(mito:isMentionedBy goldbook:14413 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14413 "current"^^xsd:string)
Declaration(Class(goldbook:14414))
AnnotationAssertion(rdfs:label goldbook:14414 "absorbent")
AnnotationAssertion(dcterms:description goldbook:14414 "Solid or semisolid matrix that is able to accommodate and retain an absorbate.")
AnnotationAssertion(rdfs:seeAlso goldbook:14414 goldbook:14413)
AnnotationAssertion(rdfs:seeAlso goldbook:14414 goldbook:15040)
AnnotationAssertion(mito:isMentionedBy goldbook:14414 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14414 "current"^^xsd:string)
Declaration(Class(goldbook:14415))
AnnotationAssertion(rdfs:label goldbook:14415 "abundance")
AnnotationAssertion(dcterms:description goldbook:14415 "Total number of individual organisms in a population, seen over a defined period of time in a certain place.Note: For fish, an estimate of total weight may replace number. Total number of organisms per unit of habitat space seen over a defined period. Amount of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all elements in a given medium (e.g., the Earth’s crust). Amount of an isotope of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all isotopes of the element.")
AnnotationAssertion(rdfs:seeAlso goldbook:14415 goldbook:14728)
AnnotationAssertion(rdfs:seeAlso goldbook:14415 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14415 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14415 "current"^^xsd:string)
Declaration(Class(goldbook:14416))
AnnotationAssertion(rdfs:label goldbook:14416 "abundant element")
AnnotationAssertion(dcterms:description goldbook:14416 "Element which is of common occurrence in the Earth’s crust.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14416 "abundant metal")
AnnotationAssertion(rdfs:comment goldbook:14416 "Abundance may be defined in terms of occurrence in other regions, e.g., oceans, \"freshwater\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14416 goldbook:14415)
AnnotationAssertion(mito:isMentionedBy goldbook:14416 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14416 "current"^^xsd:string)
Declaration(Class(goldbook:14417))
AnnotationAssertion(rdfs:label goldbook:14417 "accessible")
AnnotationAssertion(dcterms:description goldbook:14417 "Capable of being entered or reached; easy of access; such as one can go to, come into the presence of, reach, or lay hold of; get-at-able.")
AnnotationAssertion(mito:isMentionedBy goldbook:14417 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14417 "current"^^xsd:string)
Declaration(Class(goldbook:14418))
AnnotationAssertion(rdfs:label goldbook:14418 "acclimatisation")
AnnotationAssertion(dcterms:description goldbook:14418 "Processes, including selection and adaptation, by which a population of microorganisms develops the ability to degrade a substance, or develops a tolerance to it. In experimental systems, allowing an organism to adjust to its environment prior to undertaking a study. Modification of biological processes or structures in the maintenance of homeostasis in response to change in some environmental quality such as temperature, salinity, light, radiation, or toxicant concentration. Note: It is an expression of phenotypic plasticity of individuals in response to a sublethal change in some environmental factor.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14418 "acclimatation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14418 "acclimation")
AnnotationAssertion(rdfs:seeAlso goldbook:14418 goldbook:14711)
AnnotationAssertion(rdfs:seeAlso goldbook:14418 goldbook:14744)
AnnotationAssertion(rdfs:seeAlso goldbook:14418 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14418 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14418 "current"^^xsd:string)
Declaration(Class(goldbook:14419))
AnnotationAssertion(rdfs:label goldbook:14419 "acid precipitation")
AnnotationAssertion(dcterms:description goldbook:14419 "Rain, fog, snow, sleet, or other particulate matter from the atmosphere with a _000078_ below \\(\\pu{5.6}\\) deposited from the air.")
AnnotationAssertion(rdfs:comment goldbook:14419 "Rain under clean air conditions has a _000078_ slightly under \\(\\pu{6}\\). This natural acidity is caused by dissolved carbon dioxide dissociating to form carbonate and hydrogencarbonate ions. \"Acid rain\" is caused by sulfur in fossil fuels, and nitrogen from the air combining with oxygen to form sulfur oxides and nitrogen oxides during combustion."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14419 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14419 "current"^^xsd:string)
Declaration(Class(goldbook:14420))
AnnotationAssertion(rdfs:label goldbook:14420 "acid-volatile sulfide")
AnnotationAssertion(dcterms:description goldbook:14420 "Soil- and sediment-associated solid-phase sulfides extractable with cold hydrochloric acid.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14420 "AVS")
AnnotationAssertion(rdfs:comment goldbook:14420 "AVS may be chemically available by acid extraction without being bioavailable. Thus, AVS can reduce metal toxicity by binding metals in anoxic soils or sediments, thereby rendering them unavailable to most living organisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14420 goldbook:15036)
AnnotationAssertion(rdfs:seeAlso goldbook:14420 goldbook:14473)
AnnotationAssertion(mito:isMentionedBy goldbook:14420 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14420 "current"^^xsd:string)
Declaration(Class(goldbook:14421))
AnnotationAssertion(rdfs:label goldbook:14421 "acute")
AnnotationAssertion(dcterms:description goldbook:14421 "Of short duration, in relation to exposure or effect; the effect usually shows a rapid onset. Note 1: In regulatory toxicology, 'acute' refers to studies where dosing is either single or limited to one day although the total study duration may extend to two weeks to permit appearance of toxicity in susceptible organ systems. Note 2: In aquatic ecotoxicology, exposure of the test organisms is typically continuous and of four days or less. In clinical medicine, sudden and severe, having a rapid onset.")
AnnotationAssertion(rdfs:seeAlso goldbook:14421 goldbook:14524)
AnnotationAssertion(mito:isMentionedBy goldbook:14421 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14421 "current"^^xsd:string)
Declaration(Class(goldbook:14422))
AnnotationAssertion(rdfs:label goldbook:14422 "acute-to-chronic toxicity ratio")
AnnotationAssertion(dcterms:description goldbook:14422 "Numerical dimensionless quantity that is the ratio of an acute toxicity test result (e.g., \\(\\pu{LC_{50}}\\)) to a chronic toxicity test result (e.g., maximum acceptable toxicant concentration, MATC) where both are expressed in the same units (e.g., \\(\\pu{mg L-1}\\)). Ideally, the data are for the same chemical species.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14422 "ACR")
AnnotationAssertion(rdfs:comment goldbook:14422 "It is in principle the inverse of an application factor and is used in a similar manner. The ACR is commonly used for estimating chronic toxicity of a chemical on the basis of its acute toxicity. The ACR should be greater than one because the ratio compares an acute to a chronic value."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14422 goldbook:14421)
AnnotationAssertion(rdfs:seeAlso goldbook:14422 goldbook:15121)
AnnotationAssertion(rdfs:seeAlso goldbook:14422 goldbook:14524)
AnnotationAssertion(rdfs:seeAlso goldbook:14422 goldbook:14832)
AnnotationAssertion(mito:isMentionedBy goldbook:14422 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14422 "current"^^xsd:string)
Declaration(Class(goldbook:14423))
AnnotationAssertion(rdfs:label goldbook:14423 "additive effect")
AnnotationAssertion(dcterms:description goldbook:14423 "Consequence that follows exposure to two or more physicochemical agents that act jointly but do not interact: the total effect is the simple sum of the effects of separate exposures to the agents under the same conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14423 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14423 "current"^^xsd:string)
Declaration(Class(goldbook:14424))
AnnotationAssertion(rdfs:label goldbook:14424 "additive index")
AnnotationAssertion(dcterms:description goldbook:14424 "Quantification of the joint action of toxicants in mixture by adding measures of their toxicity calculated in relation to the toxicity of a reference toxicant.")
AnnotationAssertion(mito:isMentionedBy goldbook:14424 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14424 "current"^^xsd:string)
Declaration(Class(goldbook:14425))
AnnotationAssertion(rdfs:label goldbook:14425 "adenylate energy charge")
AnnotationAssertion(dcterms:description goldbook:14425 "Index reflecting the balance of energy transfer between catabolic and anabolic processes, calculated from the equation \\[\\rm{AEC} = ([\\ce{ATP}] + ½[\\ce{ADP})/([\\ce{ATP}] + [\\ce{ADP}] + [\\ce{AMP}])\\] where \\(\\ce{ATP}\\), \\(\\ce{ADP}\\), and \\(\\ce{AMP}\\) are the amount concentrations of adenosine tri-, di-, and monophosphate, respectively.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14425 "AEC")
AnnotationAssertion(mito:isMentionedBy goldbook:14425 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14425 "current"^^xsd:string)
Declaration(Class(goldbook:14426))
AnnotationAssertion(rdfs:label goldbook:14426 "adsorption factor")
AnnotationAssertion(dcterms:description goldbook:14426 "Ratio of the amount of substance adsorbed at the interface of a condensed layer and a liquid or gaseous phase to the total amount of the substance available for adsorption.")
AnnotationAssertion(mito:isMentionedBy goldbook:14426 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14426 "current"^^xsd:string)
Declaration(Class(goldbook:14427))
AnnotationAssertion(rdfs:label goldbook:14427 "age class")
AnnotationAssertion(dcterms:description goldbook:14427 "Group of organisms of the same age within a population.")
AnnotationAssertion(rdfs:seeAlso goldbook:14427 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14427 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14427 "current"^^xsd:string)
Declaration(Class(goldbook:14428))
AnnotationAssertion(rdfs:label goldbook:14428 "age composition")
AnnotationAssertion(dcterms:description goldbook:14428 "Distribution of organisms among the various age classes present in the population. The sum of the number of individuals in all age classes equals the population size.")
AnnotationAssertion(rdfs:seeAlso goldbook:14428 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14428 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14428 "current"^^xsd:string)
Declaration(Class(goldbook:14429))
AnnotationAssertion(rdfs:label goldbook:14429 "age distribution")
AnnotationAssertion(dcterms:description goldbook:14429 "Composition of a population in terms of how its abundance is distributed across age classes.")
AnnotationAssertion(rdfs:seeAlso goldbook:14429 goldbook:14415)
AnnotationAssertion(rdfs:seeAlso goldbook:14429 goldbook:14427)
AnnotationAssertion(rdfs:seeAlso goldbook:14429 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14429 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14429 "current"^^xsd:string)
Declaration(Class(goldbook:14430))
AnnotationAssertion(rdfs:label goldbook:14430 "age-specific death rate")
AnnotationAssertion(dcterms:description goldbook:14430 "Mean number of deaths as tabulated for a life table interval or for a specific age class in a given year, expressed per \\(\\pu{1000}\\) in that interval or age class.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14430 "age-specific mortality")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14430 "age-specific number of individuals dying")
AnnotationAssertion(rdfs:seeAlso goldbook:14430 goldbook:14427)
AnnotationAssertion(mito:isMentionedBy goldbook:14430 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14430 "current"^^xsd:string)
Declaration(Class(goldbook:14431))
AnnotationAssertion(rdfs:label goldbook:14431 "aggregation error")
AnnotationAssertion(dcterms:description goldbook:14431 "Error in Bayesian probability analysis of model systems resulting from the use of a single set of parameters to represent a collection of distinct entities, such as individuals, in a population.")
AnnotationAssertion(rdfs:seeAlso goldbook:14431 goldbook:14463)
AnnotationAssertion(rdfs:seeAlso goldbook:14431 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14431 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14431 "current"^^xsd:string)
Declaration(Class(goldbook:14432))
AnnotationAssertion(rdfs:label goldbook:14432 "air pollution tolerance index")
AnnotationAssertion(dcterms:description goldbook:14432 "Empirical index used to assess the tolerance of individual plants to contaminated air. The numerical value of \\(T_{\\rm{I}}\\) is obtained by combining various quantities according to the recipe \\([A (T + P) + R]/10\\), where \\(A\\) is the mass of ascorbic acid divided by the dry mass of a leaf, expressed as \\(\\pu{mg/g}\\), \\(T\\) is the total mass of chlorophyll divided by the fresh mass, expressed as \\(\\pu{mg/g}\\), \\(P\\) is the pH of a leaf extract, and \\(R\\) is the mass of water in the leaf divided by the wet mass, expressed as percent.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14432 "APTI")
AnnotationAssertion(rdfs:comment goldbook:14432 "In common usage, the equation is not formulated as a coherent equation, but requires the given units."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14432 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14432 "current"^^xsd:string)
Declaration(Class(goldbook:14433))
AnnotationAssertion(rdfs:label goldbook:14433 "alga")
AnnotationAssertion(dcterms:description goldbook:14433 "Any of various chiefly aquatic, eukaryotic, photosynthetic organisms, ranging in size from single-celled forms to the giant kelp.")
AnnotationAssertion(rdfs:comment goldbook:14433 "Algae of various species, often unicells, are used for toxicity testing in ecotoxicology. They are an important component of aquatic food webs."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14433 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14433 "current"^^xsd:string)
Declaration(Class(goldbook:14434))
AnnotationAssertion(rdfs:label goldbook:14434 "algal bloom")
AnnotationAssertion(dcterms:description goldbook:14434 "Rapid increase in the abundance of phytoplankton or benthic algae in a given area, often as a result of an increased availability of nutrients or light, or increase in temperature (e.g., the spring bloom).")
AnnotationAssertion(rdfs:seeAlso goldbook:14434 goldbook:14468)
AnnotationAssertion(rdfs:seeAlso goldbook:14434 goldbook:14918)
AnnotationAssertion(mito:isMentionedBy goldbook:14434 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14434 "current"^^xsd:string)
Declaration(Class(goldbook:14435))
AnnotationAssertion(rdfs:label goldbook:14435 "algicide")
AnnotationAssertion(dcterms:description goldbook:14435 "Substance intended to kill algae.")
AnnotationAssertion(mito:isMentionedBy goldbook:14435 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14435 "current"^^xsd:string)
Declaration(Class(goldbook:14436))
AnnotationAssertion(rdfs:label goldbook:14436 "algistatic")
AnnotationAssertion(dcterms:description goldbook:14436 "Inhibiting algal population growth.")
AnnotationAssertion(rdfs:seeAlso goldbook:14436 goldbook:14435)
AnnotationAssertion(rdfs:seeAlso goldbook:14436 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14436 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14436 "current"^^xsd:string)
Declaration(Class(goldbook:14437))
AnnotationAssertion(rdfs:label goldbook:14437 "allogenic succession")
AnnotationAssertion(dcterms:description goldbook:14437 "Sequential appearance of species driven by external influences that alter local conditions; e.g., silt deposits changing a marshland to woodland.")
AnnotationAssertion(rdfs:seeAlso goldbook:14437 goldbook:15077)
AnnotationAssertion(mito:isMentionedBy goldbook:14437 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14437 "current"^^xsd:string)
Declaration(Class(goldbook:14438))
AnnotationAssertion(rdfs:label goldbook:14438 "ambient")
AnnotationAssertion(dcterms:description goldbook:14438 "Surrounding (applied to environmental media such as air, water, sediment, or soil).")
AnnotationAssertion(rdfs:seeAlso goldbook:14438 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14438 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14438 "current"^^xsd:string)
Declaration(Class(goldbook:14439))
AnnotationAssertion(rdfs:label goldbook:14439 "ambient monitoring")
AnnotationAssertion(dcterms:description goldbook:14439 "Continuous or repeated measurement of agents in the environment to evaluate ambient exposure and health risk by comparison with appropriate reference values based on knowledge of the probable relationship between exposure and resultant adverse health effects.")
AnnotationAssertion(rdfs:seeAlso goldbook:14439 goldbook:14438)
AnnotationAssertion(mito:isMentionedBy goldbook:14439 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14439 "current"^^xsd:string)
Declaration(Class(goldbook:14440))
AnnotationAssertion(rdfs:label goldbook:14440 "anadromous")
AnnotationAssertion(dcterms:description goldbook:14440 "Showing anadromy.")
AnnotationAssertion(rdfs:seeAlso goldbook:14440 goldbook:14441)
AnnotationAssertion(mito:isMentionedBy goldbook:14440 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14440 "current"^^xsd:string)
Declaration(Class(goldbook:14441))
AnnotationAssertion(rdfs:label goldbook:14441 "anadromy")
AnnotationAssertion(dcterms:description goldbook:14441 "Life-history pattern that is characterized by egg incubation and early juvenile development in freshwater, migration to seawater for adult development, and a return to freshwater for spawning.")
AnnotationAssertion(rdfs:comment goldbook:14441 "Obligatory anadromy is the term applied where migration to seawater is required for survival."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14441 goldbook:14797)
AnnotationAssertion(rdfs:seeAlso goldbook:14441 goldbook:14516)
AnnotationAssertion(mito:isMentionedBy goldbook:14441 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14441 "current"^^xsd:string)
Declaration(Class(goldbook:14442))
AnnotationAssertion(rdfs:label goldbook:14442 "analysis plan")
AnnotationAssertion(dcterms:description goldbook:14442 "Scheme that defines the exact format and design of the assessment, explicitly states the data needed, and describes the methods and design for analyzing these data.")
AnnotationAssertion(mito:isMentionedBy goldbook:14442 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14442 "current"^^xsd:string)
Declaration(Class(goldbook:14443))
AnnotationAssertion(rdfs:label goldbook:14443 "anthropogenic")
AnnotationAssertion(dcterms:description goldbook:14443 "Caused by or influenced by human activities. Describing a conversion factor used to calculate a dose or concentration affecting a human that has been derived from data obtained with another species, e.g., the rat.")
AnnotationAssertion(mito:isMentionedBy goldbook:14443 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14443 "current"^^xsd:string)
Declaration(Class(goldbook:14444))
AnnotationAssertion(rdfs:label goldbook:14444 "antisymmetry")
AnnotationAssertion(dcterms:description goldbook:14444 "Quality of a population of bilaterally symmetrical individuals in which the difference in measurement of a trait made from the right and left sides of individuals from that population produces a bimodal distribution.")
AnnotationAssertion(rdfs:seeAlso goldbook:14444 goldbook:14696)
AnnotationAssertion(rdfs:seeAlso goldbook:14444 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14444 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14444 "current"^^xsd:string)
Declaration(Class(goldbook:14445))
AnnotationAssertion(rdfs:label goldbook:14445 "arcsine square root transformation")
AnnotationAssertion(dcterms:description goldbook:14445 "\\(\\arcsin \\sqrt{P}\\), where \\(P\\) is the value of a measured effect, e.g., the proportion of exposed organisms in a population.")
AnnotationAssertion(rdfs:comment goldbook:14445 "This transformation of effects data often fulfills an assumption of homogeneous variances for proportions of exposed individuals responding to a stimulus."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14445 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14445 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14445 "current"^^xsd:string)
Declaration(Class(goldbook:14446))
AnnotationAssertion(rdfs:label goldbook:14446 "artificial soil test")
AnnotationAssertion(dcterms:description goldbook:14446 "Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by adding the earthworms to an artificial soil made of sand, clay mineral, and peat, containing the substance of concern.")
AnnotationAssertion(rdfs:seeAlso goldbook:14446 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14446 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14446 "current"^^xsd:string)
Declaration(Class(goldbook:14447))
AnnotationAssertion(rdfs:label goldbook:14447 "artisol test")
AnnotationAssertion(dcterms:description goldbook:14447 "Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by placing the worms in an artificial substrate consisting of silica, water, and glass balls, containing the substance of concern.")
AnnotationAssertion(rdfs:comment goldbook:14447 "In the artisol test, the earthworms ingest the silica paste as they do soil."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14447 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14447 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14447 "current"^^xsd:string)
Declaration(Class(goldbook:14448))
AnnotationAssertion(rdfs:label goldbook:14448 "aryl hydrocarbon hydroxylase")
AnnotationAssertion(dcterms:description goldbook:14448 "Enzyme activity attributed to cytochrome P-450 monooxygenase isoforms and often measured in units of benzo[a]pyrene hydroxylation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14448 "AHH")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14448 "unspecific mono-oxygenase")
AnnotationAssertion(mito:isMentionedBy goldbook:14448 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14448 "current"^^xsd:string)
Declaration(Class(goldbook:14449))
AnnotationAssertion(rdfs:label goldbook:14449 "as low as reasonably achievable")
AnnotationAssertion(dcterms:description goldbook:14449 "Describing the situation in which everything practicable is done to reduce risks to the minimum with the approval of the regulatory authorities.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14449 "ALARA")
AnnotationAssertion(rdfs:seeAlso goldbook:14449 goldbook:14943)
AnnotationAssertion(mito:isMentionedBy goldbook:14449 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14449 "current"^^xsd:string)
Declaration(Class(goldbook:14450))
AnnotationAssertion(rdfs:label goldbook:14450 "assemblage")
AnnotationAssertion(dcterms:description goldbook:14450 "Set of coexisting populations defined by phylogeny, location, or life style. Assemblages are intermediate between populations and communities.")
AnnotationAssertion(rdfs:comment goldbook:14450 "An operational definition is \"species located in the same place at the same time\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14450 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14450 goldbook:14914)
AnnotationAssertion(rdfs:seeAlso goldbook:14450 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14450 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14450 "current"^^xsd:string)
Declaration(Class(goldbook:14451))
AnnotationAssertion(rdfs:label goldbook:14451 "assessment endpoint")
AnnotationAssertion(dcterms:description goldbook:14451 "Ecological property that is to be protected and the precise parameter to be measured for this property.")
AnnotationAssertion(rdfs:seeAlso goldbook:14451 goldbook:14836)
AnnotationAssertion(mito:isMentionedBy goldbook:14451 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14451 "current"^^xsd:string)
Declaration(Class(goldbook:14452))
AnnotationAssertion(rdfs:label goldbook:14452 "Association Française de Normalisation test")
AnnotationAssertion(dcterms:description goldbook:14452 "Commercially available test kit, certified by AFNOR as valid and equivalent to a standardized method.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14452 "AFNOR test")
AnnotationAssertion(mito:isMentionedBy goldbook:14452 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14452 "current"^^xsd:string)
Declaration(Class(goldbook:14453))
AnnotationAssertion(rdfs:label goldbook:14453 "asymptotic threshold concentration")
AnnotationAssertion(dcterms:description goldbook:14453 "Concentration of a chemical at which some percentage of a population of test organisms is in a state of approximate homeostasis for a prolonged period of time (\\(\\pu{48 h}\\) or more).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14453 "ATCN")
AnnotationAssertion(rdfs:comment goldbook:14453 "This can be demonstrated as the concentration at which the toxicity curve is approximately asymptotic (parallel) to the time axis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14453 "The asymptotic \\(\\pu{LC_{50}}\\) is the concentration at which the \\(\\pu{LC_{50}}\\) remains constant no matter how long exposure continues, i.e., there is no evidence of significantly increasing effects due to a longer exposure time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14453 goldbook:14744)
AnnotationAssertion(rdfs:seeAlso goldbook:14453 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14453 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14453 "current"^^xsd:string)
Declaration(Class(goldbook:14454))
AnnotationAssertion(rdfs:label goldbook:14454 "atmospheric deposition")
AnnotationAssertion(dcterms:description goldbook:14454 "Process that transfers a chemical from the atmosphere to the Earth’s surface (land, water, or vegetation) by either dry impingement or by transport in rain or snow.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14454 "deposition")
AnnotationAssertion(rdfs:seeAlso goldbook:14454 goldbook:15135)
AnnotationAssertion(mito:isMentionedBy goldbook:14454 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14454 "current"^^xsd:string)
Declaration(Class(goldbook:14456))
AnnotationAssertion(rdfs:label goldbook:14456 "aufwuchs")
AnnotationAssertion(dcterms:description goldbook:14456 "Floral and (or) or faunal communities attached to submerged surfaces in aquatic ecosystems.")
AnnotationAssertion(rdfs:seeAlso goldbook:14456 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14456 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14456 goldbook:14907)
AnnotationAssertion(mito:isMentionedBy goldbook:14456 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14456 "current"^^xsd:string)
Declaration(Class(goldbook:14457))
AnnotationAssertion(rdfs:label goldbook:14457 "autogenic succession")
AnnotationAssertion(dcterms:description goldbook:14457 "Sequential appearance of species driven by processes operating within the community environment (compare allogenic succession), e.g., primary and secondary successions that occur on newly exposed land.")
AnnotationAssertion(rdfs:seeAlso goldbook:14457 goldbook:14437)
AnnotationAssertion(rdfs:seeAlso goldbook:14457 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14457 goldbook:15077)
AnnotationAssertion(mito:isMentionedBy goldbook:14457 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14457 "current"^^xsd:string)
Declaration(Class(goldbook:14458))
AnnotationAssertion(rdfs:label goldbook:14458 "autotroph")
AnnotationAssertion(dcterms:description goldbook:14458 "Organism that is independent of outside sources for organic food materials and manufactures its own organic material from inorganic sources.")
AnnotationAssertion(mito:isMentionedBy goldbook:14458 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14458 "current"^^xsd:string)
Declaration(Class(goldbook:14459))
AnnotationAssertion(rdfs:label goldbook:14459 "autotrophic succession")
AnnotationAssertion(dcterms:description goldbook:14459 "Sequential appearance of species in a location principally involving plants.")
AnnotationAssertion(rdfs:seeAlso goldbook:14459 goldbook:15077)
AnnotationAssertion(mito:isMentionedBy goldbook:14459 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14459 "current"^^xsd:string)
Declaration(Class(goldbook:14460))
AnnotationAssertion(rdfs:label goldbook:14460 "axenic culture")
AnnotationAssertion(dcterms:description goldbook:14460 "Growth of organisms of a single species in the absence of cells or living organisms of any other species.")
AnnotationAssertion(mito:isMentionedBy goldbook:14460 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14460 "current"^^xsd:string)
Declaration(Class(goldbook:14461))
AnnotationAssertion(rdfs:label goldbook:14461 "baseline toxicity")
AnnotationAssertion(dcterms:description goldbook:14461 "General, nonspecific, reversible mode of toxic action that can be produced in most living organisms by the presence of sufficient amounts of many organic chemicals.")
AnnotationAssertion(rdfs:comment goldbook:14461 "Effects result from the general disruption of cellular activity. The mechanism producing disruption is unknown, with the main theories being binding to proteins in cell membranes and \"swelling\" of the lipid portion of cell membranes resulting from the presence of organic chemicals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14461 "Hydrophobicity dominates the expression of baseline toxicity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14461 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14461 "current"^^xsd:string)
Declaration(Class(goldbook:14462))
AnnotationAssertion(rdfs:label goldbook:14462 "Bayesian")
AnnotationAssertion(dcterms:description goldbook:14462 "Attributed to Thomas Bayes (1702–1761), English mathematician. The term is used to designate concepts relating to inverse probability, especially Bayes’ theorem, a theorem expressing the probability of one of a number of mutually exclusive events \\(H_{\\rm{i}}\\), given some other event \\(E\\), in terms of the probabilities of all the \\(H_{\\rm{i}}\\) independently of \\(E\\) and the probabilities of \\(E\\) given each \\(H_{\\rm{i}}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:14462 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14462 "current"^^xsd:string)
Declaration(Class(goldbook:14463))
AnnotationAssertion(rdfs:label goldbook:14463 "Bayesian probability")
AnnotationAssertion(dcterms:description goldbook:14463 "Subjective or objective concept of probability as a 'measure of the state of knowledge'.")
AnnotationAssertion(rdfs:comment goldbook:14463 "Assessment of probability in Bayesian theory can be approached as, e.g., odds for one or the other result of a stochastic outcome. Modern machine learning methods are frequently based on Bayesian theory."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14463 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14463 "current"^^xsd:string)
Declaration(Class(goldbook:14464))
AnnotationAssertion(rdfs:label goldbook:14464 "behavioural teratology")
AnnotationAssertion(dcterms:description goldbook:14464 "Study of behavioral abnormalities in otherwise apparently normal individuals after exposure in the embryonic state to a substance or physical agent.")
AnnotationAssertion(mito:isMentionedBy goldbook:14464 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14464 "current"^^xsd:string)
Declaration(Class(goldbook:14465))
AnnotationAssertion(rdfs:label goldbook:14465 "behavioural toxicology")
AnnotationAssertion(dcterms:description goldbook:14465 "Study of abnormal behavior produced by exposure to a substance or physical agent.")
AnnotationAssertion(mito:isMentionedBy goldbook:14465 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14465 "current"^^xsd:string)
Declaration(Class(goldbook:14466))
AnnotationAssertion(rdfs:label goldbook:14466 "beneficial metal")
AnnotationAssertion(dcterms:description goldbook:14466 "Non-essential metal which in some form (chemical species) at an appropriate dose can improve health of defined organisms, commonly human beings.")
AnnotationAssertion(mito:isMentionedBy goldbook:14466 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14466 "current"^^xsd:string)
Declaration(Class(goldbook:14467))
AnnotationAssertion(rdfs:label goldbook:14467 "benefit")
AnnotationAssertion(dcterms:description goldbook:14467 "Advantage to, or improvement in condition of, an individual, a population, a species, an assemblage, a community, or an ecosystem.")
AnnotationAssertion(rdfs:comment goldbook:14467 "For risk/benefit comparisons, the probability of benefit is the appropriate comparator."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14467 goldbook:14450)
AnnotationAssertion(rdfs:seeAlso goldbook:14467 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14467 goldbook:14544)
AnnotationAssertion(rdfs:seeAlso goldbook:14467 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14467 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14467 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14467 "current"^^xsd:string)
Declaration(Class(goldbook:14468))
AnnotationAssertion(rdfs:label goldbook:14468 "benthic")
AnnotationAssertion(dcterms:description goldbook:14468 "Living on the bottom of an aquatic system.")
AnnotationAssertion(mito:isMentionedBy goldbook:14468 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14468 "current"^^xsd:string)
Declaration(Class(goldbook:14469))
AnnotationAssertion(rdfs:label goldbook:14469 "bioaccessible")
AnnotationAssertion(dcterms:description goldbook:14469 "Able to come in contact with a living organism and perhaps interact with it with the possibility of absorption into the organism.")
AnnotationAssertion(rdfs:comment goldbook:14469 "Contact with a living organism may not result in any interaction of the substance with, and absorption by, the organism. In other words, bioaccessibility is a necessary precursor of bioavailability but not, on its own, sufficient for bioavailability to occur."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14469 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14469 "current"^^xsd:string)
Declaration(Class(goldbook:14470))
AnnotationAssertion(rdfs:label goldbook:14470 "bioaccumulation")
AnnotationAssertion(dcterms:description goldbook:14470 "Progressive increase in the amount of a substance in an organism or part of an organism that occurs because the rate of intake from all contributing sources and by all possible routes exceeds the organism’s ability to eliminate the substance from its body.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14470 "accumulation in biology")
AnnotationAssertion(rdfs:comment goldbook:14470 "Bioaccumulation of organic molecules usually correlates with lipophilicity. Bioaccumulation of metal ions tends to correlate with strong binding to biomolecules or incorporation into bone and teeth."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14470 goldbook:14476)
AnnotationAssertion(rdfs:seeAlso goldbook:14470 goldbook:14484)
AnnotationAssertion(mito:isMentionedBy goldbook:14470 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14470 "current"^^xsd:string)
Declaration(Class(goldbook:14471))
AnnotationAssertion(rdfs:label goldbook:14471 "bioaccumulation factor")
AnnotationAssertion(dcterms:description goldbook:14471 "Ratio of tissue chemical residue to chemical concentration in an external environmental phase (e.g., sediment, water, soil, air, or food). BAF is measured at a steady state in situations where organisms are exposed to multiple sources (e.g., water, sediment, food), unless noted otherwise.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14471 "accumulation factor")
AnnotationAssertion(rdfs:comment goldbook:14471 "The concentration in the organism is typically expressed per unit body mass or per gram of lipid (bioaccumulation factor, lipid-based)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14471 "The concentration in sediment may be expressed per gram dry weight of sediment or per gram of organic carbon and may be referred to as the biota-sediment accumulation factor (BSAF)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14471 "The compound may have entered the organism by any available route and from any component of the water or sediment."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14471 "In relation to uptake from food, the concentration in the organism is typically expressed per unit body mass or per gram of lipid and the concentration in food is expressed per gram dry weight of food."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14471 goldbook:14498)
AnnotationAssertion(rdfs:seeAlso goldbook:14471 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14471 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14471 "current"^^xsd:string)
Declaration(Class(goldbook:14472))
AnnotationAssertion(rdfs:label goldbook:14472 "bioactivation")
AnnotationAssertion(dcterms:description goldbook:14472 "Metabolic conversion of a xenobiotic to a more toxic derivative or to one that has more of an effect on living organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14472 "activation")
AnnotationAssertion(rdfs:seeAlso goldbook:14472 goldbook:15100)
AnnotationAssertion(mito:isMentionedBy goldbook:14472 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14472 "current"^^xsd:string)
Declaration(Class(goldbook:14473))
AnnotationAssertion(rdfs:label goldbook:14473 "bioavailable")
AnnotationAssertion(dcterms:description goldbook:14473 "Able to be absorbed by living organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14473 "available")
AnnotationAssertion(rdfs:seeAlso goldbook:14473 goldbook:14469)
AnnotationAssertion(mito:isMentionedBy goldbook:14473 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14473 "current"^^xsd:string)
Declaration(Class(goldbook:14474))
AnnotationAssertion(rdfs:label goldbook:14474 "biocenosis")
AnnotationAssertion(dcterms:description goldbook:14474 "All the interacting organisms living together in a specified habitat.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "biocoenosis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "biological community")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "biotic community")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "ecological community")
AnnotationAssertion(rdfs:comment goldbook:14474 "The area occupied by a biocenosis is defined by a characteristic assembly of species."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14474 goldbook:14450)
AnnotationAssertion(rdfs:seeAlso goldbook:14474 goldbook:14728)
AnnotationAssertion(mito:isMentionedBy goldbook:14474 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14474 "current"^^xsd:string)
Declaration(Class(goldbook:14475))
AnnotationAssertion(rdfs:label goldbook:14475 "biocide")
AnnotationAssertion(dcterms:description goldbook:14475 "Substance intended to kill living organisms. Nonagricultural pesticide used to control the severity and incidence of pests or diseases, e.g., algicide, slimicide, or disinfectant for the control of algal, fungal, or bacterial growth.")
AnnotationAssertion(mito:isMentionedBy goldbook:14475 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14475 "current"^^xsd:string)
Declaration(Class(goldbook:14476))
AnnotationAssertion(rdfs:label goldbook:14476 "bioconcentration")
AnnotationAssertion(dcterms:description goldbook:14476 "Process leading to a higher concentration of a substance in an organism than in environmental media to which it is exposed.")
AnnotationAssertion(rdfs:comment goldbook:14476 "Usually applied to uptake by aquatic organisms directly from water."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14476 goldbook:14470)
AnnotationAssertion(mito:isMentionedBy goldbook:14476 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14476 "current"^^xsd:string)
Declaration(Class(goldbook:14477))
AnnotationAssertion(rdfs:label goldbook:14477 "bioconcentration factor")
AnnotationAssertion(dcterms:description goldbook:14477 "Measure of the tendency for a substance in water to accumulate in aquatic organisms defined as the ratio of the concentration of the substance of concern in the organism to the concentration in water at equilibrium.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14477 "BCF")
AnnotationAssertion(rdfs:comment goldbook:14477 "The equilibrium concentration of a substance in an aquatic organism can be estimated by multiplying its concentration in the surrounding water by its BCF in that organism."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14477 "This parameter is an important determinant for human intake of contaminants from water by ingestion of aquatic food."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14477 goldbook:14549)
AnnotationAssertion(mito:isMentionedBy goldbook:14477 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14477 "current"^^xsd:string)
Declaration(Class(goldbook:14478))
AnnotationAssertion(rdfs:label goldbook:14478 "lipid-based bioconcentration factor")
AnnotationAssertion(dcterms:description goldbook:14478 "Ratio of the concentration of the substance of concern in the lipid fraction of the test organism to the concentration in the ambient water.")
AnnotationAssertion(rdfs:seeAlso goldbook:14478 goldbook:14438)
AnnotationAssertion(mito:isMentionedBy goldbook:14478 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14478 "current"^^xsd:string)
Declaration(Class(goldbook:14479))
AnnotationAssertion(rdfs:label goldbook:14479 "biodiversity")
AnnotationAssertion(dcterms:description goldbook:14479 "Occurrence of a number of species within a given ecosystem or biome, or the presence of a number of community types in a given area.")
AnnotationAssertion(rdfs:comment goldbook:14479 "In special cases, biodiversity may include a degree of genetic variation within a single species."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14479 "Biodiversity is often a measure of the health of biological systems."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14479 "Biodiversity can be measured on many biological levels, but the term most commonly refers to the number of different species in a defined area (species richness) and is quantified by calculating a diversity index which takes into account the relative abundance of individuals of each species."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14479 goldbook:14415)
AnnotationAssertion(rdfs:seeAlso goldbook:14479 goldbook:14489)
AnnotationAssertion(rdfs:seeAlso goldbook:14479 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14479 goldbook:14599)
AnnotationAssertion(rdfs:seeAlso goldbook:14479 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14479 goldbook:15051)
AnnotationAssertion(mito:isMentionedBy goldbook:14479 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14479 "current"^^xsd:string)
Declaration(Class(goldbook:14480))
AnnotationAssertion(rdfs:label goldbook:14480 "biodiversity action plan")
AnnotationAssertion(dcterms:description goldbook:14480 "Internationally recognized program designed to protect and restore biological systems containing threatened species and habitats.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14480 "BAP")
AnnotationAssertion(rdfs:comment goldbook:14480 "The original impetus for these plans derives from the 1992 Convention on Biological Diversity (CBD)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14480 "The principal elements of a BAP typically include: (a) preparing inventories of biological information for selected species or habitats; (b) assessing the conservation status of species within specified ecosystems; (c) creation of targets for conservation and restoration; and (d) establishing budgets, timelines, and institutional partnerships for implementing the BAP."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14480 goldbook:14728)
AnnotationAssertion(mito:isMentionedBy goldbook:14480 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14480 "current"^^xsd:string)
Declaration(Class(goldbook:14481))
AnnotationAssertion(rdfs:label goldbook:14481 "biogeochemical cycle")
AnnotationAssertion(dcterms:description goldbook:14481 "Movement of elements or molecules among organisms and nonliving compartments of the atmosphere, lithosphere, and hydrosphere.")
AnnotationAssertion(rdfs:comment goldbook:14481 "Examples of biogeochemical cycles are the carbon, nitrogen, phosphorus, and sulfur cycles. These are defined as the global flow of \\(\\ce{C}\\), \\(\\ce{N}\\), \\(\\ce{P}\\), and \\(\\ce{S}\\) atoms, respectively, from plants through animals to the atmosphere, soil, water, and back to plants."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14481 "The water cycle refers to the global flow of water from surface and ground water sources to soil, plants, animals, and the atmosphere, and back to soil and surface water."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14481 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14481 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14481 "current"^^xsd:string)
Declaration(Class(goldbook:14482))
AnnotationAssertion(rdfs:label goldbook:14482 "biological indicator")
AnnotationAssertion(dcterms:description goldbook:14482 "Any biological species or group of species whose performance, abundance, or population status is used to determine the health of an environment or ecosystem by systematic monitoring of chemical, physiological, or behavioral changes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14482 "bioindicator")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14482 "indicator species")
AnnotationAssertion(rdfs:comment goldbook:14482 "Deviation of bioindicator performance indicates some adverse effect. In a wider sense, the number and abundance of different indicator species (biodiversity, species richness) is used to calculate biotic indices."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14482 "Bioindicator is commonly misused as a synonym for the term biomarker. Such use is to be deprecated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14482 goldbook:14415)
AnnotationAssertion(rdfs:seeAlso goldbook:14482 goldbook:14479)
AnnotationAssertion(rdfs:seeAlso goldbook:14482 goldbook:14499)
AnnotationAssertion(rdfs:seeAlso goldbook:14482 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14482 goldbook:14932)
AnnotationAssertion(rdfs:seeAlso goldbook:14482 goldbook:15051)
AnnotationAssertion(mito:isMentionedBy goldbook:14482 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14482 "current"^^xsd:string)
Declaration(Class(goldbook:14483))
AnnotationAssertion(rdfs:label goldbook:14483 "biological determinant")
AnnotationAssertion(dcterms:description goldbook:14483 "Property of living organisms that affects human or environmental health.")
AnnotationAssertion(rdfs:comment goldbook:14483 "Biological determinants may be either endogenous or exogenous. Endogenous biological determinants include genetic characteristics and physiological state. Exogenous biological determinants are other living organisms with which the organisms of concern interact, e.g., beneficial or harmful microorganisms."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14483 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14483 "current"^^xsd:string)
Declaration(Class(goldbook:14484))
AnnotationAssertion(rdfs:label goldbook:14484 "biomagnification")
AnnotationAssertion(dcterms:description goldbook:14484 "Sequence of processes by which higher concentrations of a substance are attained in organisms at higher trophic levels. Result of these processes of bioconcentration and bioaccumulation by which tissue concentrations of bioaccumulated chemicals increase as the chemical passes up through two or more trophic levels. Note: Biomagnification occurs in a food chain as a consequence of efficient transfer of a substance from food to consumer accompanied by the lack of, or very slow, excretion or degradation of the substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14484 "bioamplification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14484 "ecological magnification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14484 "trophic enrichment")
AnnotationAssertion(rdfs:seeAlso goldbook:14484 goldbook:15113)
AnnotationAssertion(mito:isMentionedBy goldbook:14484 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14484 "current"^^xsd:string)
Declaration(Class(goldbook:14485))
AnnotationAssertion(rdfs:label goldbook:14485 "biomagnification factor")
AnnotationAssertion(dcterms:description goldbook:14485 "Ratio of concentrations of a compound at two consecutive trophic levels at steady state. It can also be expressed in terms of a rate constant-based bioaccumulation model \\[B = C_{n}/C_{n-1} = \\alpha f/k_{\\rm{e}}\\] where \\(\\alpha\\) is assimilation efficiency, \\(f\\) is feeding rate, and \\(k_{\\rm{e}}\\) is the first-order elimination constant. \\(B\\) can be calculated from field data on assumed trophic relations or from laboratory feeding experiments.")
AnnotationAssertion(rdfs:seeAlso goldbook:14485 goldbook:14484)
AnnotationAssertion(mito:isMentionedBy goldbook:14485 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14485 "current"^^xsd:string)
Declaration(Class(goldbook:14486))
AnnotationAssertion(rdfs:label goldbook:14486 "biomarker of effect")
AnnotationAssertion(dcterms:description goldbook:14486 "Biomarker that, depending upon the magnitude, can be recognized as associated with an established or possible health impairment or disease.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14486 "effect biomarker")
AnnotationAssertion(mito:isMentionedBy goldbook:14486 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14486 "current"^^xsd:string)
Declaration(Class(goldbook:14487))
AnnotationAssertion(rdfs:label goldbook:14487 "biomarker of exposure")
AnnotationAssertion(dcterms:description goldbook:14487 "Biomarker that relates exposure to a xenobiotic to the levels of the substance or its metabolite, or of the product of an interaction between the substance and some target molecule or cell, that can be measured in a compartment within an organism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14487 "exposure biomarker")
AnnotationAssertion(rdfs:seeAlso goldbook:14487 goldbook:14537)
AnnotationAssertion(mito:isMentionedBy goldbook:14487 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14487 "current"^^xsd:string)
Declaration(Class(goldbook:14488))
AnnotationAssertion(rdfs:label goldbook:14488 "biomarker of susceptibility")
AnnotationAssertion(dcterms:description goldbook:14488 "Biomarker of an inherent or acquired ability of an organism to respond to exposure to a specific substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14488 "susceptibility biomarker")
AnnotationAssertion(mito:isMentionedBy goldbook:14488 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14488 "current"^^xsd:string)
Declaration(Class(goldbook:14489))
AnnotationAssertion(rdfs:label goldbook:14489 "biome")
AnnotationAssertion(dcterms:description goldbook:14489 "Set of plants and animals that occupy a certain geographic area.")
AnnotationAssertion(rdfs:comment goldbook:14489 "The term is usually applied to large areas occupied by climax communities arising as a result of interactions between biotic and abiotic factors,"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14489 goldbook:14528)
AnnotationAssertion(mito:isMentionedBy goldbook:14489 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14489 "current"^^xsd:string)
Declaration(Class(goldbook:14490))
AnnotationAssertion(rdfs:label goldbook:14490 "biomodification")
AnnotationAssertion(dcterms:description goldbook:14490 "Alteration of the chemical or physical properties of a substance by the action of living organisms.")
AnnotationAssertion(mito:isMentionedBy goldbook:14490 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14490 "current"^^xsd:string)
Declaration(Class(goldbook:14491))
AnnotationAssertion(rdfs:label goldbook:14491 "biomonitor")
AnnotationAssertion(dcterms:description goldbook:14491 "n. Organism that provides quantitative information on the quality of the environment around it.Note: The ideal substance biomonitor would indicate the presence of a specific pollutant and provide additional information about the amount present. v. To use organisms to monitor pollutants and to deduce possible effects on biota or routes of toxicant exposure to humans.")
AnnotationAssertion(mito:isMentionedBy goldbook:14491 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14491 "current"^^xsd:string)
Declaration(Class(goldbook:14492))
AnnotationAssertion(rdfs:label goldbook:14492 "biomonitoring type 1")
AnnotationAssertion(dcterms:description goldbook:14492 "Determination of community changes along a gradient or among sites differing in levels of pollution.")
AnnotationAssertion(rdfs:seeAlso goldbook:14492 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14492 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14492 "current"^^xsd:string)
Declaration(Class(goldbook:14493))
AnnotationAssertion(rdfs:label goldbook:14493 "biomonitoring type 2")
AnnotationAssertion(dcterms:description goldbook:14493 "Determination of bioaccumulation in organisms among sites notionally varying in the level of contamination.")
AnnotationAssertion(rdfs:seeAlso goldbook:14493 goldbook:14470)
AnnotationAssertion(mito:isMentionedBy goldbook:14493 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14493 "current"^^xsd:string)
Declaration(Class(goldbook:14494))
AnnotationAssertion(rdfs:label goldbook:14494 "biomonitoring type 3")
AnnotationAssertion(dcterms:description goldbook:14494 "Determination of effects on organisms using tools such as biochemical markers in sentinel species or some measure of diminished fitness or condition of individuals.")
AnnotationAssertion(mito:isMentionedBy goldbook:14494 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14494 "current"^^xsd:string)
Declaration(Class(goldbook:14495))
AnnotationAssertion(rdfs:label goldbook:14495 "biomonitoring type 4")
AnnotationAssertion(dcterms:description goldbook:14495 "Determination of genetically based resistance in populations of contaminated areas.")
AnnotationAssertion(rdfs:seeAlso goldbook:14495 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14495 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14495 "current"^^xsd:string)
Declaration(Class(goldbook:14496))
AnnotationAssertion(rdfs:label goldbook:14496 "biopesticide")
AnnotationAssertion(dcterms:description goldbook:14496 "Biological agent with pesticidal activity, e.g., the bacterium Bacillus thuringiensis when used to kill insects.")
AnnotationAssertion(mito:isMentionedBy goldbook:14496 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14496 "current"^^xsd:string)
Declaration(Class(goldbook:14497))
AnnotationAssertion(rdfs:label goldbook:14497 "bioremediation")
AnnotationAssertion(dcterms:description goldbook:14497 "Use of biological organisms such as plants or microbes to aid in removing hazardous substances from an area.")
AnnotationAssertion(mito:isMentionedBy goldbook:14497 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14497 "current"^^xsd:string)
Declaration(Class(goldbook:14498))
AnnotationAssertion(rdfs:label goldbook:14498 "biota-sediment accumulation factor")
AnnotationAssertion(dcterms:description goldbook:14498 "Ratio of lipid-normalized tissue chemical residue to carbon-normalized sediment substance concentration (units of mass lipid/mass organic carbon).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14498 "BSAF")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14498 "accumulation factor (AF)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14498 "bioavailability index (BI)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14498 "biota-sediment factor (BSF)")
AnnotationAssertion(rdfs:seeAlso goldbook:14498 goldbook:14471)
AnnotationAssertion(mito:isMentionedBy goldbook:14498 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14498 "current"^^xsd:string)
Declaration(Class(goldbook:14499))
AnnotationAssertion(rdfs:label goldbook:14499 "biotic index")
AnnotationAssertion(dcterms:description goldbook:14499 "One of several ranking systems calculated from the presence or abundance of sensitive species relative to tolerant species.")
AnnotationAssertion(rdfs:comment goldbook:14499 "Biotic indices measure decreased environmental quality from effects on especially sensitive species and should not be compared to diversity indices, which measure community structure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14499 goldbook:14536)
AnnotationAssertion(rdfs:seeAlso goldbook:14499 goldbook:14599)
AnnotationAssertion(mito:isMentionedBy goldbook:14499 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14499 "current"^^xsd:string)
Declaration(Class(goldbook:14500))
AnnotationAssertion(rdfs:label goldbook:14500 "biotic ligand")
AnnotationAssertion(dcterms:description goldbook:14500 "Component of a living organism to which an ion or other substance in aqueous solution can bind, usually with subsequent beneficial or harmful effect on the physiology of the organism.")
AnnotationAssertion(mito:isMentionedBy goldbook:14500 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14500 "current"^^xsd:string)
Declaration(Class(goldbook:14501))
AnnotationAssertion(rdfs:label goldbook:14501 "biotic ligand model")
AnnotationAssertion(dcterms:description goldbook:14501 "Model that integrates the interactions of metals with ligands in water to calculate the speciation (based on hardness, salinity, and presence of other metals) and the concentration of ionic species producing toxicity. The BLM chemically and mathematically models the organism’s target site as ligand(s) competing with nonbiotic ligands, based on the concept that toxicity occurs when a metal-(biotic ligand) complex reaches a critical concentration.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14501 "BLM")
AnnotationAssertion(rdfs:comment goldbook:14501 "The BLM is a development of the free ion activity model (FIAM) for calculating free metal ions in relation to water-borne ligands and the Windermere humic aqueous model (WHAM) for calculating metal speciation in relation to organic species in water."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14501 "For fish, the biotic ligand for metal ions is either known or suspected to be the ion channel proteins in the gill surface that regulate the ionic composition of the blood. For other organisms, it is hypothesized that a biotic ligand exists and that mortality can be modeled in a similar way."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14501 "The model is a generalization of the FIAM. The difference between the BLM and the FIAM is the consideration of competitive binding at the biotic ligand, which models the protective effects of other metal cations, and the direct influence of \\(\\rm{pH}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14501 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14501 "current"^^xsd:string)
Declaration(Class(goldbook:14502))
AnnotationAssertion(rdfs:label goldbook:14502 "biotic score")
AnnotationAssertion(dcterms:description goldbook:14502 "Weighted measurement of organisms present—the weighted part is determined by each group’s pollution tolerance or intolerance. As pollution increases in a stream, the biotic score value tends to increase.")
AnnotationAssertion(mito:isMentionedBy goldbook:14502 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14502 "current"^^xsd:string)
Declaration(Class(goldbook:14503))
AnnotationAssertion(rdfs:label goldbook:14503 "biotope")
AnnotationAssertion(dcterms:description goldbook:14503 "Habitat shared by many species, most often an area that is uniform in environmental conditions and in its distribution of animal and plant life.")
AnnotationAssertion(rdfs:seeAlso goldbook:14503 goldbook:14728)
AnnotationAssertion(mito:isMentionedBy goldbook:14503 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14503 "current"^^xsd:string)
Declaration(Class(goldbook:14504))
AnnotationAssertion(rdfs:label goldbook:14504 "bioturbation")
AnnotationAssertion(dcterms:description goldbook:14504 "Group of processes whereby organisms affect the structure of sediment.")
AnnotationAssertion(rdfs:comment goldbook:14504 "Bioturbation consists of two processes, particle mixing and irrigation, mainly executed by infaunal organisms but also by epifaunal organisms and bottom-feeding fish."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14504 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14504 "current"^^xsd:string)
Declaration(Class(goldbook:14505))
AnnotationAssertion(rdfs:label goldbook:14505 "biphasic dose–effect model")
AnnotationAssertion(dcterms:description goldbook:14505 "Model of adverse effect vs. dose relationship that, owing to hormesis, dips down from the control level before increasing with the dose; individuals exposed to low, but nontoxic concentrations are healthier than individuals not exposed to the chemical.Note: Biphasic dose–effect curves occur for any nutrient. Hormesis is a phenomenon associated with compounds that have no nutrient properties. Model of adverse effect vs. dose relationship that changes slope owing to a change in the mechanism of toxic action.Note: This may, e.g., be due to saturation of a transport or metabolic system.")
AnnotationAssertion(rdfs:seeAlso goldbook:14505 goldbook:14601)
AnnotationAssertion(rdfs:seeAlso goldbook:14505 goldbook:14745)
AnnotationAssertion(mito:isMentionedBy goldbook:14505 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14505 "current"^^xsd:string)
Declaration(Class(goldbook:14506))
AnnotationAssertion(rdfs:label goldbook:14506 "birth rate")
AnnotationAssertion(dcterms:description goldbook:14506 "(in demography) Number of live births in a defined administrative jurisdiction in a calendar year divided by a midyear population of the jurisdiction, with the customary multiplier of \\(\\pu{1000}\\) to produce a whole number rather than a decimal or a fraction. Note: An alternative statistic is total fertility rate, the average number of children born to each woman over the course of her life. In general, the total fertility rate is a better indicator of fertility rates because, unlike the crude birth rate, it is not affected by the age distribution of the population. (in ecology) Number of births, \\(B\\), in a population of a defined size, \\(N\\), during a specified time interval \\(\\Delta t\\). The rate is calculated from the formula \\[B = \\Delta N/\\Delta t\\] where \\(\\Delta N\\) is the change in the number of births in a limited time period \\(\\Delta t\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:14506 goldbook:14904)
AnnotationAssertion(rdfs:seeAlso goldbook:14506 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14506 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14506 "current"^^xsd:string)
Declaration(Class(goldbook:14507))
AnnotationAssertion(rdfs:label goldbook:14507 "boomerang effect")
AnnotationAssertion(dcterms:description goldbook:14507 "Delayed damage from earlier environmental contamination.")
AnnotationAssertion(rdfs:comment goldbook:14507 "Sometimes stated as \"what you throw away can come back to hurt you\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14507 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14507 "current"^^xsd:string)
Declaration(Class(goldbook:14508))
AnnotationAssertion(rdfs:label goldbook:14508 "borderline metal ions")
AnnotationAssertion(dcterms:description goldbook:14508 "Metal ions intermediate in properties between class a and class b metal ions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14508 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14508 "current"^^xsd:string)
Declaration(Class(goldbook:14509))
AnnotationAssertion(rdfs:label goldbook:14509 "bottom-up ecotoxicological study")
AnnotationAssertion(dcterms:description goldbook:14509 "Approach to investigating ecotoxicological effects that starts with a determination of the presence and nature of any adverse effects via responses at the suborganismal (cellular and biochemical) levels of organization rather than via the community and (or) ecosystem levels of organization.")
AnnotationAssertion(rdfs:seeAlso goldbook:14509 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14509 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14509 goldbook:15098)
AnnotationAssertion(mito:isMentionedBy goldbook:14509 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14509 "current"^^xsd:string)
Declaration(Class(goldbook:14510))
AnnotationAssertion(rdfs:label goldbook:14510 "Brillouin index")
AnnotationAssertion(dcterms:description goldbook:14510 "Quantitative value for community species diversity calculated as \\[H_{\\rm{B}} = (\\ln N! - \\sum \\ln n_{i}!)/N\\] where \\(N\\) is the total number of individuals and \\(n_{i}\\) is the number of individuals in the \\(i^{\\rm{th}}\\) species.")
AnnotationAssertion(rdfs:comment goldbook:14510 "Evenness for the Brillouin index is estimated as \\(E = H_{\\rm{B}}/H_{\\rm{Bmax}}\\) where \\(H_{\\rm{Bmax}}\\) is the maximum possible Brillouin diversity which occurs when all species are equally abundant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14510 "When a subsample is taken from a given area, the Brillouin index provides a better estimate of diversity than the Shannon–Wiener index for samples of the same size. It also corresponds to situations of sampling without replacement, whereas the Shannon–Wiener index is appropriate for sampling with replacement."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14510 goldbook:15031)
AnnotationAssertion(rdfs:seeAlso goldbook:14510 goldbook:14599)
AnnotationAssertion(mito:isMentionedBy goldbook:14510 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14510 "current"^^xsd:string)
Declaration(Class(goldbook:14511))
AnnotationAssertion(rdfs:label goldbook:14511 "broodstock")
AnnotationAssertion(dcterms:description goldbook:14511 "Adult fish producing either eggs or sperm.")
AnnotationAssertion(mito:isMentionedBy goldbook:14511 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14511 "current"^^xsd:string)
Declaration(Class(goldbook:14512))
AnnotationAssertion(rdfs:label goldbook:14512 "calcinosis")
AnnotationAssertion(dcterms:description goldbook:14512 "Any pathological condition characterized by the deposition of calcium salts in tissues.")
AnnotationAssertion(mito:isMentionedBy goldbook:14512 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14512 "current"^^xsd:string)
Declaration(Class(goldbook:14513))
AnnotationAssertion(rdfs:label goldbook:14513 "calcium sink")
AnnotationAssertion(dcterms:description goldbook:14513 "Tissue such as arthropod cuticle, bivalve shell, or vertebrate bone that renders calcium or elements with similar biological behavior (such as lead or cadmium) less bioavailable during trophic interactions, thus providing a mechanism for trophic dilution.")
AnnotationAssertion(rdfs:seeAlso goldbook:14513 goldbook:14473)
AnnotationAssertion(mito:isMentionedBy goldbook:14513 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14513 "current"^^xsd:string)
Declaration(Class(goldbook:14514))
AnnotationAssertion(rdfs:label goldbook:14514 "carrying capacity")
AnnotationAssertion(dcterms:description goldbook:14514 "Maximum population size expressed as total number of individuals, biomass, or population density that a given unit of habitat is capable of sustaining.")
AnnotationAssertion(rdfs:seeAlso goldbook:14514 goldbook:14728)
AnnotationAssertion(rdfs:seeAlso goldbook:14514 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14514 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14514 "current"^^xsd:string)
Declaration(Class(goldbook:14515))
AnnotationAssertion(rdfs:label goldbook:14515 "catadromous")
AnnotationAssertion(dcterms:description goldbook:14515 "Describing a species exhibiting catadromy.")
AnnotationAssertion(rdfs:seeAlso goldbook:14515 goldbook:14516)
AnnotationAssertion(mito:isMentionedBy goldbook:14515 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14515 "current"^^xsd:string)
Declaration(Class(goldbook:14516))
AnnotationAssertion(rdfs:label goldbook:14516 "catadromy")
AnnotationAssertion(dcterms:description goldbook:14516 "Life-history pattern that is characterized by egg incubation and early juvenile development in seawater, migration to freshwater for adult development, and return to seawater for spawning.")
AnnotationAssertion(rdfs:comment goldbook:14516 "Obligatory catadromy is the term applied where migration to freshwater is required for survival."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14516 goldbook:14441)
AnnotationAssertion(mito:isMentionedBy goldbook:14516 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14516 "current"^^xsd:string)
Declaration(Class(goldbook:14517))
AnnotationAssertion(rdfs:label goldbook:14517 "catagenesis")
AnnotationAssertion(dcterms:description goldbook:14517 "Long-term geochemical alteration to organic matter, involving high temperatures and pressures deep below the surface of the Earth.")
AnnotationAssertion(mito:isMentionedBy goldbook:14517 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14517 "current"^^xsd:string)
Declaration(Class(goldbook:14518))
AnnotationAssertion(rdfs:label goldbook:14518 "cetaceans")
AnnotationAssertion(dcterms:description goldbook:14518 "Whales, dolphins, and porpoises, in the order Cetacea.")
AnnotationAssertion(mito:isMentionedBy goldbook:14518 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14518 "current"^^xsd:string)
Declaration(Class(goldbook:14519))
AnnotationAssertion(rdfs:label goldbook:14519 "Chapman mechanism")
AnnotationAssertion(dcterms:description goldbook:14519 "Series of reactions by which ozone is formed in the stratosphere.")
AnnotationAssertion(mito:isMentionedBy goldbook:14519 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14519 "current"^^xsd:string)
Declaration(Class(goldbook:14520))
AnnotationAssertion(rdfs:label goldbook:14520 "chemical time bomb")
AnnotationAssertion(dcterms:description goldbook:14520 "Substance or substances in a component of the environment which are not currently bioavailable but which may become bioavailable at an unknown time in the future with harmful consequences.")
AnnotationAssertion(rdfs:seeAlso goldbook:14520 goldbook:14473)
AnnotationAssertion(mito:isMentionedBy goldbook:14520 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14520 "current"^^xsd:string)
Declaration(Class(goldbook:14521))
AnnotationAssertion(rdfs:label goldbook:14521 "chloride cell")
AnnotationAssertion(dcterms:description goldbook:14521 "Specialized cell with a role in ion regulation, characterized by large numbers of mitochondria, an extensive intracellular tubular network and a high concentration of \\(\\ce{Na+}\\)/\\(\\ce{K+}\\) ATPase. This cell is found in salt-secreting glands like the rectal gland of elasmobranchs, the nasal gland of seabirds, and the gills of both seawater and freshwater fish, mainly on the primary lamellae but also on the secondary lamellae.")
AnnotationAssertion(mito:isMentionedBy goldbook:14521 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14521 "current"^^xsd:string)
Declaration(Class(goldbook:14522))
AnnotationAssertion(rdfs:label goldbook:14522 "chlorinity")
AnnotationAssertion(dcterms:description goldbook:14522 "Proportion by mass of dissolved chloride ions in water.")
AnnotationAssertion(mito:isMentionedBy goldbook:14522 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14522 "current"^^xsd:string)
Declaration(Class(goldbook:14523))
AnnotationAssertion(rdfs:label goldbook:14523 "chlorofluorocarbon")
AnnotationAssertion(dcterms:description goldbook:14523 "Carbon-based chemical containing chlorine and fluorine, responsible for ozone depletion in the stratosphere.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14523 "CFC")
AnnotationAssertion(rdfs:comment goldbook:14523 "Formerly commonly used as aerosol propellants and refrigeration coolants, but now prohibited in many countries."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14523 goldbook:14863)
AnnotationAssertion(mito:isMentionedBy goldbook:14523 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14523 "current"^^xsd:string)
Declaration(Class(goldbook:14524))
AnnotationAssertion(rdfs:label goldbook:14524 "chronic effect")
AnnotationAssertion(dcterms:description goldbook:14524 "Consequence that develops slowly and (or) has a long-lasting course: may be applied to an effect which develops rapidly and is long lasting.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14524 "long-term effect")
AnnotationAssertion(rdfs:seeAlso goldbook:14524 goldbook:14421)
AnnotationAssertion(mito:isMentionedBy goldbook:14524 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14524 "current"^^xsd:string)
Declaration(Class(goldbook:14525))
AnnotationAssertion(rdfs:label goldbook:14525 "chlorosis")
AnnotationAssertion(dcterms:description goldbook:14525 "Loss of green color in plants owing to the lack of production or the destruction of chlorophyll.")
AnnotationAssertion(mito:isMentionedBy goldbook:14525 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14525 "current"^^xsd:string)
Declaration(Class(goldbook:14526))
AnnotationAssertion(rdfs:label goldbook:14526 "cladistics")
AnnotationAssertion(dcterms:description goldbook:14526 "Systematic classification of groups of organisms on the basis of shared characteristics thought to derive from a common ancestor. Also, the study of the branching of evolutionary lines of descent and the relationship between branches.")
AnnotationAssertion(mito:isMentionedBy goldbook:14526 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14526 "current"^^xsd:string)
Declaration(Class(goldbook:14527))
AnnotationAssertion(rdfs:label goldbook:14527 "cladogram")
AnnotationAssertion(dcterms:description goldbook:14527 "Dendrogram illustrating the supposed evolutionary relationships between clades; a diagram showing cladistic relationships.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14527 "evolutionary tree")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14527 "phylogenetic tree")
AnnotationAssertion(rdfs:comment goldbook:14527 "Cladograms are often based on such information as the number of differences in amino acids or nucleic acid bases in common proteins or genes, respectively. From estimated mutation rates, the evolutionary time can be estimated. Accordingly, cladograms have two components, branching order (showing group relationships) and branch length (showing extent of evolution)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14527 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14527 "current"^^xsd:string)
Declaration(Class(goldbook:14528))
AnnotationAssertion(rdfs:label goldbook:14528 "climax community")
AnnotationAssertion(dcterms:description goldbook:14528 "Community of plants and animals in a steady state due to ecological succession resulting in a composition of the community best adapted to average conditions in the area. The term is sometimes applied to soil development.")
AnnotationAssertion(rdfs:seeAlso goldbook:14528 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14528 goldbook:15036)
AnnotationAssertion(rdfs:seeAlso goldbook:14528 goldbook:15077)
AnnotationAssertion(mito:isMentionedBy goldbook:14528 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14528 "current"^^xsd:string)
Declaration(Class(goldbook:14529))
AnnotationAssertion(rdfs:label goldbook:14529 "cold condensation theory")
AnnotationAssertion(dcterms:description goldbook:14529 "Theory that pollutants with high vapor pressure, e.g., mercury or persistent organic pollutants (POPs), in the air will condense onto soil, water, and biota at cool temperatures. Consequently, the ratios for POP concentrations in the air and on condensed phases decrease as one moves from warmer to cooler climates.")
AnnotationAssertion(rdfs:seeAlso goldbook:14529 goldbook:14909)
AnnotationAssertion(rdfs:seeAlso goldbook:14529 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14529 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14529 "current"^^xsd:string)
Declaration(Class(goldbook:14530))
AnnotationAssertion(rdfs:label goldbook:14530 "cometabolism")
AnnotationAssertion(dcterms:description goldbook:14530 "Microbial transformation of a compound (that is normally unable to support cell replication) in the requisite presence of a transformable cosubstrate that supports cell replication.")
AnnotationAssertion(rdfs:comment goldbook:14530 "The mechanisms of cometabolism considered likely in most cases involve an enzyme or enzymes that change the substrate to a product or products not further transformed by other enzymes (dead-end metabolites)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14530 goldbook:14552)
AnnotationAssertion(rdfs:seeAlso goldbook:14530 goldbook:14565)
AnnotationAssertion(rdfs:seeAlso goldbook:14530 goldbook:15022)
AnnotationAssertion(mito:isMentionedBy goldbook:14530 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14530 "current"^^xsd:string)
Declaration(Class(goldbook:14531))
AnnotationAssertion(rdfs:label goldbook:14531 "community")
AnnotationAssertion(dcterms:description goldbook:14531 "Assembly of populations of different species of living organisms, usually interdependent on and interacting with each other, within a specified location in space and time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14531 "biocommunity")
AnnotationAssertion(rdfs:seeAlso goldbook:14531 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14531 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14531 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14531 "current"^^xsd:string)
Declaration(Class(goldbook:14532))
AnnotationAssertion(rdfs:label goldbook:14532 "community conditioning hypothesis")
AnnotationAssertion(dcterms:description goldbook:14532 "Hypothesis that ecological communities retain information about events in their history and will not return to their original state after perturbation.")
AnnotationAssertion(rdfs:comment goldbook:14532 "This hypothesis was derived from the concept of nonequilibrium community ecology and was developed as a framework for understanding the persistence of dose-related responses in multispecies toxicity tests."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14532 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14532 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14532 "current"^^xsd:string)
Declaration(Class(goldbook:14533))
AnnotationAssertion(rdfs:label goldbook:14533 "community stability")
AnnotationAssertion(dcterms:description goldbook:14533 "Tendency of a community to return to its original state after a disturbance (competition, temporarily changing environment, etc.).")
AnnotationAssertion(rdfs:seeAlso goldbook:14533 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14533 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14533 "current"^^xsd:string)
Declaration(Class(goldbook:14534))
AnnotationAssertion(rdfs:label goldbook:14534 "community resilience")
AnnotationAssertion(dcterms:description goldbook:14534 "Ability of a community to return to its former state after perturbation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14534 "ecological resilience")
AnnotationAssertion(rdfs:comment goldbook:14534 "A community with high resilience will return to its original state faster than one with low resilience."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14534 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14534 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14534 "current"^^xsd:string)
Declaration(Class(goldbook:14535))
AnnotationAssertion(rdfs:label goldbook:14535 "community resistance")
AnnotationAssertion(dcterms:description goldbook:14535 "Ability of a community to avoid displacement from its present state by a disturbance.")
AnnotationAssertion(rdfs:seeAlso goldbook:14535 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14535 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14535 "current"^^xsd:string)
Declaration(Class(goldbook:14536))
AnnotationAssertion(rdfs:label goldbook:14536 "community structure")
AnnotationAssertion(dcterms:description goldbook:14536 "Species present in a community and their relative abundances.")
AnnotationAssertion(rdfs:seeAlso goldbook:14536 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14536 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14536 "current"^^xsd:string)
Declaration(Class(goldbook:14537))
AnnotationAssertion(rdfs:label goldbook:14537 "compartment")
AnnotationAssertion(dcterms:description goldbook:14537 "Conceptualized part of the body (organs, tissues, cells, or fluids) considered as an independent system for purposes of modeling and assessment of distribution and clearance of a substance. Part of an ecosystem considered as an independent system for purposes of assessment of uptake, distribution, and dissipation of a substance.")
AnnotationAssertion(rdfs:seeAlso goldbook:14537 goldbook:14619)
AnnotationAssertion(mito:isMentionedBy goldbook:14537 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14537 "current"^^xsd:string)
Declaration(Class(goldbook:14538))
AnnotationAssertion(rdfs:label goldbook:14538 "competitive exclusion")
AnnotationAssertion(dcterms:description goldbook:14538 "Outcompetition from a niche of one species by another that uses the available resources of the niche more efficiently, eventually resulting in the exclusion of the outcompeted species.")
AnnotationAssertion(rdfs:seeAlso goldbook:14538 goldbook:14877)
AnnotationAssertion(mito:isMentionedBy goldbook:14538 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14538 "current"^^xsd:string)
Declaration(Class(goldbook:14539))
AnnotationAssertion(rdfs:label goldbook:14539 "complimentary niches")
AnnotationAssertion(dcterms:description goldbook:14539 "Niches where coexisting species occupy a similar position along one niche dimension, e.g., altitude, but differ along another, e.g., diet.")
AnnotationAssertion(rdfs:seeAlso goldbook:14539 goldbook:14877)
AnnotationAssertion(mito:isMentionedBy goldbook:14539 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14539 "current"^^xsd:string)
Declaration(Class(goldbook:14540))
AnnotationAssertion(rdfs:label goldbook:14540 "concentration–response curve")
AnnotationAssertion(dcterms:description goldbook:14540 "Graph of the relation between exposure concentration and the proportion of individuals in a population responding with a defined effect.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14540 "exposure–response curve")
AnnotationAssertion(rdfs:seeAlso goldbook:14540 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14540 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14540 "current"^^xsd:string)
Declaration(Class(goldbook:14541))
AnnotationAssertion(rdfs:label goldbook:14541 "conceptual model")
AnnotationAssertion(dcterms:description goldbook:14541 "Linkage and interrelationship of assessment endpoint(s) and stressors.")
AnnotationAssertion(rdfs:comment goldbook:14541 "Establishing this includes evaluation of potential exposure pathways, effects, and ecological receptors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14541 "Conceptual models include hypotheses of risk and a diagram of the conceptual model."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14541 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14541 "current"^^xsd:string)
Declaration(Class(goldbook:14542))
AnnotationAssertion(rdfs:label goldbook:14542 "conceptual model diagram")
AnnotationAssertion(dcterms:description goldbook:14542 "Figure showing pathways of exposure of organisms and illustrating areas of uncertainty or concern.")
AnnotationAssertion(mito:isMentionedBy goldbook:14542 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14542 "current"^^xsd:string)
Declaration(Class(goldbook:14543))
AnnotationAssertion(rdfs:label goldbook:14543 "conceptual site model")
AnnotationAssertion(dcterms:description goldbook:14543 "Integration of information on contaminants of potential concern (COPCs), ecological resources, evaluated exposure routes, fate and transport mechanisms, evaluated COPC toxicity, identified assessment endpoints, and risk questions and hypotheses, into a description of all that is known and (or) expected about a contaminated site.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14543 "CSM")
AnnotationAssertion(mito:isMentionedBy goldbook:14543 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14543 "current"^^xsd:string)
Declaration(Class(goldbook:14544))
AnnotationAssertion(rdfs:label goldbook:14544 "condition")
AnnotationAssertion(dcterms:description goldbook:14544 "State of health determining potential for reproduction and growth.")
AnnotationAssertion(rdfs:comment goldbook:14544 "Mainly used in fish, mussel, and oyster ecology."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14544 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14544 "current"^^xsd:string)
Declaration(Class(goldbook:14545))
AnnotationAssertion(rdfs:label goldbook:14545 "condition factor")
AnnotationAssertion(dcterms:description goldbook:14545 "Parameter used to describe growth in fish. It reflects real growth and nutritional status better than simple measurement of body mass.")
AnnotationAssertion(rdfs:comment goldbook:14545 "The condition factor, \\(K\\), is calculated from the following equation: \\[K = m/l^{3}\\] with mass, \\(m\\) and length \\(l\\) of the fish. The usual units are \\(\\pu{g cm-3}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14545 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14545 "current"^^xsd:string)
Declaration(Class(goldbook:14546))
AnnotationAssertion(rdfs:label goldbook:14546 "condition index")
AnnotationAssertion(dcterms:description goldbook:14546 "Any quantitative measure of the condition in relation to a defined baseline.")
AnnotationAssertion(rdfs:comment goldbook:14546 "In mussels, various shell indexes (volume/length, mass/length), glycogen concentration (w/bw), or relative organ mass are used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14546 goldbook:14544)
AnnotationAssertion(mito:isMentionedBy goldbook:14546 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14546 "current"^^xsd:string)
Declaration(Class(goldbook:14547))
AnnotationAssertion(rdfs:label goldbook:14547 "conservation biology")
AnnotationAssertion(dcterms:description goldbook:14547 "Science applied to the conservation of genes, populations, species, and ecosystems.")
AnnotationAssertion(rdfs:comment goldbook:14547 "This science is concerned with the phenomena that affect the maintenance, loss, and restoration of biological diversity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14547 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14547 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14547 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14547 "current"^^xsd:string)
Declaration(Class(goldbook:14548))
AnnotationAssertion(rdfs:label goldbook:14548 "conservation ecology")
AnnotationAssertion(dcterms:description goldbook:14548 "Science of analyzing and protecting the Earth’s biological diversity.")
AnnotationAssertion(rdfs:comment goldbook:14548 "Conservation ecology is based on the biological, physical, and social sciences, economics, and the practice of natural-resource management. It concentrates on population dynamics issues associated with the small population sizes of rare species (e.g., minimum viable populations)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14548 goldbook:14859)
AnnotationAssertion(rdfs:seeAlso goldbook:14548 goldbook:14936)
AnnotationAssertion(mito:isMentionedBy goldbook:14548 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14548 "current"^^xsd:string)
Declaration(Class(goldbook:14549))
AnnotationAssertion(rdfs:label goldbook:14549 "contaminant")
AnnotationAssertion(dcterms:description goldbook:14549 "Minor impurity present in a substance. Extraneous material inadvertently added to a sample prior to or during chemical or biological analysis. In some contexts, as in relation to gas cleaning equipment, used as a synonym for 'pollutant', especially on a small scale. Unintended component in food that may pose a hazard to the consumer. Any undesirable solid, liquid, or gaseous matter occurring, as a result of human activities, in a solid, liquid, or gaseous environmental medium, even without adverse effects being observed.")
AnnotationAssertion(rdfs:seeAlso goldbook:14549 goldbook:14928)
AnnotationAssertion(mito:isMentionedBy goldbook:14549 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14549 "current"^^xsd:string)
Declaration(Class(goldbook:14550))
AnnotationAssertion(rdfs:label goldbook:14550 "continuous effect")
AnnotationAssertion(dcterms:description goldbook:14550 "Change that can be measured on a continuum from zero (or even a negative value) to positive values such as growth and reproduction.")
AnnotationAssertion(rdfs:seeAlso goldbook:14550 goldbook:14965)
AnnotationAssertion(mito:isMentionedBy goldbook:14550 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14550 "current"^^xsd:string)
Declaration(Class(goldbook:14551))
AnnotationAssertion(rdfs:label goldbook:14551 "control")
AnnotationAssertion(dcterms:description goldbook:14551 "Treatment in a toxicity test that duplicates all the conditions of the exposure treatments but contains no test material, in order to determine the absence of toxicity under basic test conditions (e.g., health of test organisms, quality of dilution water).")
AnnotationAssertion(mito:isMentionedBy goldbook:14551 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14551 "current"^^xsd:string)
Declaration(Class(goldbook:14552))
AnnotationAssertion(rdfs:label goldbook:14552 "cooxidation")
AnnotationAssertion(dcterms:description goldbook:14552 "Cometabolism whereby growing microorganisms oxidize a compound without using either carbon or energy derived from the oxidation of that compound.")
AnnotationAssertion(rdfs:seeAlso goldbook:14552 goldbook:14530)
AnnotationAssertion(mito:isMentionedBy goldbook:14552 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14552 "current"^^xsd:string)
Declaration(Class(goldbook:14553))
AnnotationAssertion(rdfs:label goldbook:14553 "copepod")
AnnotationAssertion(dcterms:description goldbook:14553 "Minute marine or freshwater crustacean, usually having six pairs of limbs on the thorax; some are abundant in plankton and others are parasitic on fish, marine mammals, and macro-invertebrates.")
AnnotationAssertion(mito:isMentionedBy goldbook:14553 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14553 "current"^^xsd:string)
Declaration(Class(goldbook:14554))
AnnotationAssertion(rdfs:label goldbook:14554 "corrosive")
AnnotationAssertion(dcterms:description goldbook:14554 "n. Substance having the capability or tendency to cause slow destruction. adj. Gradually destructive; steadily harmful.")
AnnotationAssertion(mito:isMentionedBy goldbook:14554 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14554 "current"^^xsd:string)
Declaration(Class(goldbook:14555))
AnnotationAssertion(rdfs:label goldbook:14555 "cost–benefit analysis")
AnnotationAssertion(dcterms:description goldbook:14555 "Procedure for determining the relationship of the expected benefits of a proposed action to the expected costs in order to decide whether the action provides the best option for the investment of limited resources.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14555 "CBA")
AnnotationAssertion(rdfs:seeAlso goldbook:14555 goldbook:14556)
AnnotationAssertion(mito:isMentionedBy goldbook:14555 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14555 "current"^^xsd:string)
Declaration(Class(goldbook:14556))
AnnotationAssertion(rdfs:label goldbook:14556 "cost-effectiveness analysis")
AnnotationAssertion(dcterms:description goldbook:14556 "Procedure for determining whether the expected beneficial effects of a defined course of action justify the cost when selecting among competing options for the use of limited resources.")
AnnotationAssertion(rdfs:comment goldbook:14556 "Mainly used for comparing the relative value of various clinical strategies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14556 goldbook:14555)
AnnotationAssertion(mito:isMentionedBy goldbook:14556 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14556 "current"^^xsd:string)
Declaration(Class(goldbook:14557))
AnnotationAssertion(rdfs:label goldbook:14557 "cough")
AnnotationAssertion(dcterms:description goldbook:14557 "Abrupt, periodic reversal of water flow over the gills that dislodges and eliminates excess mucus from the gills’ surfaces.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14557 "gill purge")
AnnotationAssertion(mito:isMentionedBy goldbook:14557 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14557 "current"^^xsd:string)
Declaration(Class(goldbook:14558))
AnnotationAssertion(rdfs:label goldbook:14558 "critical body residue")
AnnotationAssertion(dcterms:description goldbook:14558 "Whole-body concentration of a chemical that is associated with a given adverse biological response.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14558 "CBR")
AnnotationAssertion(rdfs:comment goldbook:14558 "This assumes each organism is a single compartment, rather than multiple compartments as in reality. It has utility as a first approximation of dose."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14558 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14558 "current"^^xsd:string)
Declaration(Class(goldbook:14559))
AnnotationAssertion(rdfs:label goldbook:14559 "critical life-stage testing")
AnnotationAssertion(dcterms:description goldbook:14559 "Toxicity testing focused on the species life stage thought to be the most sensitive to the toxicant, such as newly hatched individuals.")
AnnotationAssertion(mito:isMentionedBy goldbook:14559 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14559 "current"^^xsd:string)
Declaration(Class(goldbook:14560))
AnnotationAssertion(rdfs:label goldbook:14560 "cross-resistance")
AnnotationAssertion(dcterms:description goldbook:14560 "Condition in which enhanced tolerance to one toxicant also enhances tolerance to another.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14560 "cotolerance")
AnnotationAssertion(mito:isMentionedBy goldbook:14560 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14560 "current"^^xsd:string)
Declaration(Class(goldbook:14561))
AnnotationAssertion(rdfs:label goldbook:14561 "culture")
AnnotationAssertion(dcterms:description goldbook:14561 "n. Stock of healthy cells, tissue, microorganisms, or plants raised under well-defined and controlled conditions. v. To maintain a stock of healthy organisms under well-defined and controlled conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14561 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14561 "current"^^xsd:string)
Declaration(Class(goldbook:14562))
AnnotationAssertion(rdfs:label goldbook:14562 "cumulative dose")
AnnotationAssertion(dcterms:description goldbook:14562 "Total dose resulting from repeated exposures or continuous exposure over a defined time to a substance or to radiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14562 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14562 "current"^^xsd:string)
Declaration(Class(goldbook:14563))
AnnotationAssertion(rdfs:label goldbook:14563 "cumulative exposure")
AnnotationAssertion(dcterms:description goldbook:14563 "Total exposure resulting from repeated and continuous exposure over a defined time to a substance or to radiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14563 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14563 "current"^^xsd:string)
Declaration(Class(goldbook:14564))
AnnotationAssertion(rdfs:label goldbook:14564 "Daphnia")
AnnotationAssertion(dcterms:description goldbook:14564 "Small, mostly planktonic, crustaceans, between \\(\\pu{0.2 mm}\\) and \\(\\pu{5 mm}\\) in length.")
AnnotationAssertion(rdfs:comment goldbook:14564 "Daphnia are members of the order Cladocera, and are one of the several small aquatic crustaceans commonly called water fleas because of their saltatory swimming style (although fleas are insects and thus only very distantly related). Daphnia spp. live in various aquatic environments ranging from acidic swamps to freshwater lakes, ponds, streams, and rivers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14564 "Toxicity tests on Daphnia are required by most regulatory authorities. The results are often interpreted as applicable by extrapolation to the protection of all crustaceans."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14564 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14564 "current"^^xsd:string)
Declaration(Class(goldbook:14565))
AnnotationAssertion(rdfs:label goldbook:14565 "dead-end metabolite")
AnnotationAssertion(dcterms:description goldbook:14565 "Substance formed by a microbe’s metabolism of a substrate (most often during cometabolism) that cannot be further metabolized by that organism.")
AnnotationAssertion(rdfs:comment goldbook:14565 "Dead-end metabolites may be further metabolized by coexisting organisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14565 goldbook:14530)
AnnotationAssertion(mito:isMentionedBy goldbook:14565 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14565 "current"^^xsd:string)
Declaration(Class(goldbook:14566))
AnnotationAssertion(rdfs:label goldbook:14566 "death")
AnnotationAssertion(dcterms:description goldbook:14566 "In assessing population ecology, death of an individual is loss of the ability to reproduce.")
AnnotationAssertion(rdfs:seeAlso goldbook:14566 goldbook:14760)
AnnotationAssertion(mito:isMentionedBy goldbook:14566 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14566 "current"^^xsd:string)
Declaration(Class(goldbook:14567))
AnnotationAssertion(rdfs:label goldbook:14567 "death")
AnnotationAssertion(dcterms:description goldbook:14567 "Irreversible cessation of all vital functions of an organism.")
AnnotationAssertion(mito:isMentionedBy goldbook:14567 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14567 "current"^^xsd:string)
Declaration(Class(goldbook:14568))
AnnotationAssertion(rdfs:label goldbook:14568 "death rate")
AnnotationAssertion(dcterms:description goldbook:14568 "Number of deaths \\(D\\) in a closed population of size \\(N\\) during a specified time interval, \\(\\Delta t\\). The rate is calculated from the formula \\[D = -\\Delta N/\\Delta t\\] where \\(\\Delta N\\) is the change in number of deaths over a specified time period.")
AnnotationAssertion(rdfs:seeAlso goldbook:14568 goldbook:14905)
AnnotationAssertion(rdfs:seeAlso goldbook:14568 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14568 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14568 "current"^^xsd:string)
Declaration(Class(goldbook:14569))
AnnotationAssertion(rdfs:label goldbook:14569 "dechlorinated water")
AnnotationAssertion(dcterms:description goldbook:14569 "Chlorinated water (usually municipal drinking water) that has been treated to remove chlorine and chlorinated compounds from solution.")
AnnotationAssertion(mito:isMentionedBy goldbook:14569 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14569 "current"^^xsd:string)
Declaration(Class(goldbook:14570))
AnnotationAssertion(rdfs:label goldbook:14570 "decomposer")
AnnotationAssertion(dcterms:description goldbook:14570 "Organism that breaks down dead matter or wastes of other organisms.")
AnnotationAssertion(mito:isMentionedBy goldbook:14570 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14570 "current"^^xsd:string)
Declaration(Class(goldbook:14571))
AnnotationAssertion(rdfs:label goldbook:14571 "defoliant")
AnnotationAssertion(dcterms:description goldbook:14571 "Substance used for removal of leaves by its toxic action on living plants.")
AnnotationAssertion(rdfs:seeAlso goldbook:14571 goldbook:15100)
AnnotationAssertion(mito:isMentionedBy goldbook:14571 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14571 "current"^^xsd:string)
Declaration(Class(goldbook:14572))
AnnotationAssertion(rdfs:label goldbook:14572 "demographic stochasticity")
AnnotationAssertion(dcterms:description goldbook:14572 "Variability in population growth rates arising from random differences among individuals in survival and reproduction within a season.")
AnnotationAssertion(rdfs:comment goldbook:14572 "Such variability is important only in populations that are fairly small."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14572 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14572 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14572 "current"^^xsd:string)
Declaration(Class(goldbook:14573))
AnnotationAssertion(rdfs:label goldbook:14573 "demography")
AnnotationAssertion(dcterms:description goldbook:14573 "Study of populations, especially their age structure and growth rates.")
AnnotationAssertion(rdfs:seeAlso goldbook:14573 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14573 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14573 "current"^^xsd:string)
Declaration(Class(goldbook:14574))
AnnotationAssertion(rdfs:label goldbook:14574 "density dependence")
AnnotationAssertion(dcterms:description goldbook:14574 "Variation in characteristics of individuals or of a population produced by changes in the density of the population.")
AnnotationAssertion(rdfs:comment goldbook:14574 "Density dependence may be seen in mortality rate, birth rate, fítness, sensitivity to environmental toxins, transmission of pathogens, and parasites, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14574 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14574 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14574 "current"^^xsd:string)
Declaration(Class(goldbook:14575))
AnnotationAssertion(rdfs:label goldbook:14575 "deposit feeder")
AnnotationAssertion(dcterms:description goldbook:14575 "Animal that feeds on particles of matter in the soil or sediment, usually the top soil or sediment where it is filled with organic matter. Feeding takes place either by ingesting soil or sediment or by trapping particles as they fall.")
AnnotationAssertion(rdfs:seeAlso goldbook:14575 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14575 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14575 "current"^^xsd:string)
Declaration(Class(goldbook:14576))
AnnotationAssertion(rdfs:label goldbook:14576 "depuration")
AnnotationAssertion(dcterms:description goldbook:14576 "Loss of a substance from an organism owing to elimination and degradation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14576 "depuration time")
AnnotationAssertion(rdfs:comment goldbook:14576 "The rate of depuration is expressed by its half life or the time needed to eliminate \\(\\pu{50\\%}\\) of the substance in a noncontaminated medium. This term is often referred to as the depuration time (\\(\\pu{DT_{50}}\\))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14576 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14576 "current"^^xsd:string)
Declaration(Class(goldbook:14577))
AnnotationAssertion(rdfs:label goldbook:14577 "derived characteristic")
AnnotationAssertion(dcterms:description goldbook:14577 "Predicted property of a substance that is dependent upon, or is an approximation of, a fundamental property and the prevailing environmental conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14577 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14577 "current"^^xsd:string)
Declaration(Class(goldbook:14578))
AnnotationAssertion(rdfs:label goldbook:14578 "deterministic")
AnnotationAssertion(dcterms:description goldbook:14578 "Term applied to effects, of which the extent varies with the dose and for which a threshold is believed to exist.")
AnnotationAssertion(mito:isMentionedBy goldbook:14578 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14578 "current"^^xsd:string)
Declaration(Class(goldbook:14579))
AnnotationAssertion(rdfs:label goldbook:14579 "deterministic analysis")
AnnotationAssertion(dcterms:description goldbook:14579 "Detailed study in which all population and environmental parameters are assumed to be constant and accurately specified.")
AnnotationAssertion(rdfs:seeAlso goldbook:14579 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14579 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14579 "current"^^xsd:string)
Declaration(Class(goldbook:14580))
AnnotationAssertion(rdfs:label goldbook:14580 "deterministic model")
AnnotationAssertion(dcterms:description goldbook:14580 "Mathematical model that is fully specified and does not include a stochastic component.")
AnnotationAssertion(mito:isMentionedBy goldbook:14580 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14580 "current"^^xsd:string)
Declaration(Class(goldbook:14581))
AnnotationAssertion(rdfs:label goldbook:14581 "detritus")
AnnotationAssertion(dcterms:description goldbook:14581 "Organic debris from decomposing plants and animals.")
AnnotationAssertion(mito:isMentionedBy goldbook:14581 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14581 "current"^^xsd:string)
Declaration(Class(goldbook:14582))
AnnotationAssertion(rdfs:label goldbook:14582 "detrivorous")
AnnotationAssertion(dcterms:description goldbook:14582 "Describing an organism that survives by eating detritus.")
AnnotationAssertion(rdfs:seeAlso goldbook:14582 goldbook:14581)
AnnotationAssertion(mito:isMentionedBy goldbook:14582 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14582 "current"^^xsd:string)
Declaration(Class(goldbook:14583))
AnnotationAssertion(rdfs:label goldbook:14583 "developmental reference dose")
AnnotationAssertion(dcterms:description goldbook:14583 "Reference dose determined for developmental consequences of a single, maternal exposure during development.")
AnnotationAssertion(mito:isMentionedBy goldbook:14583 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14583 "current"^^xsd:string)
Declaration(Class(goldbook:14584))
AnnotationAssertion(rdfs:label goldbook:14584 "developmental stability")
AnnotationAssertion(dcterms:description goldbook:14584 "Potential of an organism to develop into a consistent phenotype in an environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14584 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14584 "current"^^xsd:string)
Declaration(Class(goldbook:14585))
AnnotationAssertion(rdfs:label goldbook:14585 "diatom")
AnnotationAssertion(dcterms:description goldbook:14585 "Member of a major group of eukaryotic algae, among the most common types of phytoplankton. Unicellular, some form chains or simple colonies. Diatom cells are encased in a frustule, of widely diverse form, made of silica (hydrated silicon dioxide).")
AnnotationAssertion(mito:isMentionedBy goldbook:14585 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14585 "current"^^xsd:string)
Declaration(Class(goldbook:14586))
AnnotationAssertion(rdfs:label goldbook:14586 "diffuse source")
AnnotationAssertion(dcterms:description goldbook:14586 "Release into the environment from multiple sources covering a wide area as opposed to point source.")
AnnotationAssertion(rdfs:seeAlso goldbook:14586 goldbook:14927)
AnnotationAssertion(mito:isMentionedBy goldbook:14586 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14586 "current"^^xsd:string)
Declaration(Class(goldbook:14587))
AnnotationAssertion(rdfs:label goldbook:14587 "dilution paradigm")
AnnotationAssertion(dcterms:description goldbook:14587 "Belief that pollution is alleviated by dilution.")
AnnotationAssertion(rdfs:comment goldbook:14587 "Sometimes stated as \"The solution to pollution is dilution.\""^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14587 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14587 "current"^^xsd:string)
Declaration(Class(goldbook:14588))
AnnotationAssertion(rdfs:label goldbook:14588 "dilution water")
AnnotationAssertion(dcterms:description goldbook:14588 "Water used to dilute the test material in an aquatic toxicity test in order to prepare either different concentrations of a test chemical or different percentages of an effluent for the various test treatments.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14588 "diluent")
AnnotationAssertion(rdfs:comment goldbook:14588 "The water (negative) control in a test is prepared with dilution water only."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14588 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14588 "current"^^xsd:string)
Declaration(Class(goldbook:14589))
AnnotationAssertion(rdfs:label goldbook:14589 "direct ecological effect")
AnnotationAssertion(dcterms:description goldbook:14589 "Effect where a stressor acts immediately on an ecological component of interest and not through the consequences of effects on other components of the ecosystem.")
AnnotationAssertion(rdfs:seeAlso goldbook:14589 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14589 goldbook:14757)
AnnotationAssertion(mito:isMentionedBy goldbook:14589 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14589 "current"^^xsd:string)
Declaration(Class(goldbook:14590))
AnnotationAssertion(rdfs:label goldbook:14590 "directional asymmetry")
AnnotationAssertion(dcterms:description goldbook:14590 "Deviation within a population from a mean of zero for the difference between a trait measured from the right and left sides of bilaterally symmetrical individuals from that population.")
AnnotationAssertion(rdfs:seeAlso goldbook:14590 goldbook:14444)
AnnotationAssertion(rdfs:seeAlso goldbook:14590 goldbook:14696)
AnnotationAssertion(rdfs:seeAlso goldbook:14590 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14590 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14590 "current"^^xsd:string)
Declaration(Class(goldbook:14591))
AnnotationAssertion(rdfs:label goldbook:14591 "direct toxicity")
AnnotationAssertion(dcterms:description goldbook:14591 "Toxicity that results from, and is readily attributable to, substances acting at the sites of toxic action in and (or) on the exposed organisms that are exhibiting the adverse biological response in question.")
AnnotationAssertion(mito:isMentionedBy goldbook:14591 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14591 "current"^^xsd:string)
Declaration(Class(goldbook:14592))
AnnotationAssertion(rdfs:label goldbook:14592 "discharge")
AnnotationAssertion(dcterms:description goldbook:14592 "Release of any waste into the environment from a point source.")
AnnotationAssertion(rdfs:comment goldbook:14592 "Usually applied to release of liquid waste into water but may be applied to release to air."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14592 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14592 "current"^^xsd:string)
Declaration(Class(goldbook:14593))
AnnotationAssertion(rdfs:label goldbook:14593 "discrimination ratio")
AnnotationAssertion(dcterms:description goldbook:14593 "Ratio measuring the degree of isotopic discrimination, with a ratio of 1 indicating no discrimination.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14593 "discrimination factor")
AnnotationAssertion(rdfs:comment goldbook:14593 "In the context of discrimination between elements such as cesium and potassium in a trophic exchange, a discrimination factor or ratio is expressed as \\([\\ce{Cs}]_{\\rm{food}}/[\\ce{K}]_{\\rm{food}}\\) divided by \\([\\ce{Cs}]_{\\rm{body}}/[\\ce{K}]_{\\rm{body}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14593 goldbook:14777)
AnnotationAssertion(mito:isMentionedBy goldbook:14593 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14593 "current"^^xsd:string)
Declaration(Class(goldbook:14594))
AnnotationAssertion(rdfs:label goldbook:14594 "dispersant")
AnnotationAssertion(dcterms:description goldbook:14594 "Substance used to disperse liquid spills, e.g., oil spills in water.")
AnnotationAssertion(mito:isMentionedBy goldbook:14594 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14594 "current"^^xsd:string)
Declaration(Class(goldbook:14595))
AnnotationAssertion(rdfs:label goldbook:14595 "dissolved organic carbon")
AnnotationAssertion(dcterms:description goldbook:14595 "Amount concentration of carbon found dissolved in water samples from aquatic systems, measured as total elemental carbon.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14595 "DOC")
AnnotationAssertion(rdfs:comment goldbook:14595 "The \"dissolved\" fraction of organic carbon is an operational classification. Operationally, DOC is defined as the organic matter that is able to pass through a defined filter (filters generally range in size between \\(\\pu{0.7 \\upmu m}\\) and \\(\\pu{0.22 \\upmu m}\\)). Conversely, particulate organic carbon (POC) in water is that carbon that is too large and is filtered out of a sample."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14595 "The DOC in marine and freshwater systems is part of the greatest cycled reservoir of organic matter on Earth and consists mostly of humic substances."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14595 "DOC is important in the transport and bioavailability of pollutants in aquatic systems."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14595 "Metals may form strong complexes with DOC, increasing metal solubility and concentration in water, while also reducing metal bioavailability."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14595 goldbook:14597)
AnnotationAssertion(rdfs:seeAlso goldbook:14595 goldbook:14928)
AnnotationAssertion(mito:isMentionedBy goldbook:14595 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14595 "current"^^xsd:string)
Declaration(Class(goldbook:14596))
AnnotationAssertion(rdfs:label goldbook:14596 "dissolved oxygen content")
AnnotationAssertion(dcterms:description goldbook:14596 "Amount concentration of oxygen dissolved in water at a particular temperature and pressure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14596 "DOC")
AnnotationAssertion(rdfs:comment goldbook:14596 "This can be a limiting factor on the growth of aquatic populations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14596 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14596 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14596 "current"^^xsd:string)
Declaration(Class(goldbook:14597))
AnnotationAssertion(rdfs:label goldbook:14597 "dissolved organic matter")
AnnotationAssertion(dcterms:description goldbook:14597 "Analogous to dissolved organic carbon, but refers to the entire organic pool dissolved in water.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14597 "DOM")
AnnotationAssertion(rdfs:seeAlso goldbook:14597 goldbook:14595)
AnnotationAssertion(mito:isMentionedBy goldbook:14597 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14597 "current"^^xsd:string)
Declaration(Class(goldbook:14598))
AnnotationAssertion(rdfs:label goldbook:14598 "disturbance")
AnnotationAssertion(dcterms:description goldbook:14598 "Event that introduces, removes, or redistributes organisms, changing the colonization potential of a given environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14598 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14598 "current"^^xsd:string)
Declaration(Class(goldbook:14599))
AnnotationAssertion(rdfs:label goldbook:14599 "diversity index")
AnnotationAssertion(dcterms:description goldbook:14599 "Mathematical descriptor of species variation within a community.")
AnnotationAssertion(rdfs:comment goldbook:14599 "All diversity indices are based on the relative abundance of a species, i.e., the sum of all individuals of that species divided by the sum of all individuals in the community of interest."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14599 goldbook:14510)
AnnotationAssertion(rdfs:seeAlso goldbook:14599 goldbook:15031)
AnnotationAssertion(rdfs:seeAlso goldbook:14599 goldbook:15034)
AnnotationAssertion(rdfs:seeAlso goldbook:14599 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14599 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14599 "current"^^xsd:string)
Declaration(Class(goldbook:14600))
AnnotationAssertion(rdfs:label goldbook:14600 "dose–effect")
AnnotationAssertion(dcterms:description goldbook:14600 "Relation between dose and the magnitude of a measured biological change.")
AnnotationAssertion(mito:isMentionedBy goldbook:14600 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14600 "current"^^xsd:string)
Declaration(Class(goldbook:14601))
AnnotationAssertion(rdfs:label goldbook:14601 "dose–effect curve")
AnnotationAssertion(dcterms:description goldbook:14601 "Graph of the relation between dose and the magnitude of the biological change produced measured in appropriate units.")
AnnotationAssertion(mito:isMentionedBy goldbook:14601 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14601 "current"^^xsd:string)
Declaration(Class(goldbook:14602))
AnnotationAssertion(rdfs:label goldbook:14602 "dose–effect relationship")
AnnotationAssertion(dcterms:description goldbook:14602 "Association between dose and the resulting magnitude of a continuously graded change, either in an individual or in a population.")
AnnotationAssertion(rdfs:seeAlso goldbook:14602 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14602 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14602 "current"^^xsd:string)
Declaration(Class(goldbook:14603))
AnnotationAssertion(rdfs:label goldbook:14603 "dose–response curve")
AnnotationAssertion(dcterms:description goldbook:14603 "Graph of the relation between dose and the proportion of individuals in a population responding with a defined biological effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:14603 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14603 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14603 "current"^^xsd:string)
Declaration(Class(goldbook:14604))
AnnotationAssertion(rdfs:label goldbook:14604 "dose–response relationship")
AnnotationAssertion(dcterms:description goldbook:14604 "Association between dose and the incidence of a defined biological effect in an exposed population usually expressed as percentage.")
AnnotationAssertion(rdfs:seeAlso goldbook:14604 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14604 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14604 "current"^^xsd:string)
Declaration(Class(goldbook:14605))
AnnotationAssertion(rdfs:label goldbook:14605 "drainage basin")
AnnotationAssertion(dcterms:description goldbook:14605 "Area of land where water from rain or snow melt drains downhill into a body of water, such as a river, lake, dam, estuary, wetland, sea, or ocean.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "catchment")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "catchment area")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "catchment basin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "drainage area")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "river basin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "water basin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "watershed")
AnnotationAssertion(rdfs:comment goldbook:14605 "A drainage basin includes the streams and rivers that convey the water as well as the land surfaces from which water drains into those channels, separated from adjacent basins by a drainage divide."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14605 "A drainage basin acts like a funnel, collecting all the water within the area covered by the basin and channeling it into a waterway. Each drainage basin is separated topographically from adjacent basins by a ridge, hill, or mountain, which is known as a water divide."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14605 goldbook:14661)
AnnotationAssertion(rdfs:seeAlso goldbook:14605 goldbook:15136)
AnnotationAssertion(mito:isMentionedBy goldbook:14605 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14605 "current"^^xsd:string)
Declaration(Class(goldbook:14606))
AnnotationAssertion(rdfs:label goldbook:14606 "dynamic energy budget theory")
AnnotationAssertion(dcterms:description goldbook:14606 "Theory that simple quantitative rules may be applied to define the organization of metabolism of individual organisms.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14606 "DEB")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14606 "DEB theory")
AnnotationAssertion(rdfs:comment goldbook:14606 "\"Dynamic\" refers to changes in energy budgets in relation to individual life cycle. The theory includes stoichiometric constraints and mass balance equations, allometric relationships, organizational uncoupling of metabolic modules, strong and weak homeostasis, and partionability of reserve kinetics."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14606 "In relation to ecotoxicology, effects of toxicants on energy allocation have been modeled by Kooijman and Bedaux."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14606 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14606 "current"^^xsd:string)
Declaration(Class(goldbook:14607))
AnnotationAssertion(rdfs:label goldbook:14607 "dynamically fragile community")
AnnotationAssertion(dcterms:description goldbook:14607 "Community that is stable for only a very limited range of environmental characteristics, e.g., a stable and predictable environment with respect to predator–prey ratios or disturbances caused by humans.")
AnnotationAssertion(rdfs:seeAlso goldbook:14607 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14607 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14607 "current"^^xsd:string)
Declaration(Class(goldbook:14608))
AnnotationAssertion(rdfs:label goldbook:14608 "dynamically robust community")
AnnotationAssertion(dcterms:description goldbook:14608 "Community that is stable within a wide range of conditions, e.g., in very variable and unpredictable environments.")
AnnotationAssertion(rdfs:seeAlso goldbook:14608 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14608 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14608 "current"^^xsd:string)
Declaration(Class(goldbook:14609))
AnnotationAssertion(rdfs:label goldbook:14609 "dynamic stability hypothesis")
AnnotationAssertion(dcterms:description goldbook:14609 "Hypothesis that long food chains are less stable than short food chains.")
AnnotationAssertion(mito:isMentionedBy goldbook:14609 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14609 "current"^^xsd:string)
Declaration(Class(goldbook:14610))
AnnotationAssertion(rdfs:label goldbook:14610 "ecology")
AnnotationAssertion(dcterms:description goldbook:14610 "Branch of biology that studies the interactions between living organisms and all factors (including other organisms) in their environment. Such interactions encompass environmental factors that determine the distributions of living organisms.")
AnnotationAssertion(mito:isMentionedBy goldbook:14610 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14610 "current"^^xsd:string)
Declaration(Class(goldbook:14611))
AnnotationAssertion(rdfs:label goldbook:14611 "ecological character")
AnnotationAssertion(dcterms:description goldbook:14611 "Sum of biological, physical, and chemical components of an ecosystem and their interactions that maintain the ecosystem and its products, functions, and attributes.")
AnnotationAssertion(rdfs:seeAlso goldbook:14611 goldbook:14619)
AnnotationAssertion(mito:isMentionedBy goldbook:14611 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14611 "current"^^xsd:string)
Declaration(Class(goldbook:14612))
AnnotationAssertion(rdfs:label goldbook:14612 "ecological energetics")
AnnotationAssertion(dcterms:description goldbook:14612 "Study of the flow of energy within an ecological system from the time the energy enters the living system until it is irretrievably lost from the system as heat.")
AnnotationAssertion(rdfs:comment goldbook:14612 "It is also referred to as production ecology, because ecologists use the word \"production\" to describe the process of energy input and storage in ecosystems."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14612 goldbook:14619)
AnnotationAssertion(mito:isMentionedBy goldbook:14612 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14612 "current"^^xsd:string)
Declaration(Class(goldbook:14613))
AnnotationAssertion(rdfs:label goldbook:14613 "ecological epidemiology")
AnnotationAssertion(dcterms:description goldbook:14613 "Application of epidemiological methods to determine the cause, incidence, prevalence, and distribution of adverse effects in nonhuman species inhabiting contaminated sites; it is frequently associated with retrospective ecological risk assessment.")
AnnotationAssertion(rdfs:seeAlso goldbook:14613 goldbook:14995)
AnnotationAssertion(mito:isMentionedBy goldbook:14613 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14613 "current"^^xsd:string)
Declaration(Class(goldbook:14614))
AnnotationAssertion(rdfs:label goldbook:14614 "ecological imbalance")
AnnotationAssertion(dcterms:description goldbook:14614 "Change in any biological, physical, or chemical components of an ecosystem, or in their interactions, which result in change in ecological character and its functions and attributes.")
AnnotationAssertion(rdfs:seeAlso goldbook:14614 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14614 goldbook:15050)
AnnotationAssertion(mito:isMentionedBy goldbook:14614 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14614 "current"^^xsd:string)
Declaration(Class(goldbook:14615))
AnnotationAssertion(rdfs:label goldbook:14615 "ecological mortality")
AnnotationAssertion(dcterms:description goldbook:14615 "Toxicant-related diminution of fitness of an individual functioning within an ecosystem that is of a magnitude sufficient to be equivalent to somatic death.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14615 "ecological death")
AnnotationAssertion(rdfs:comment goldbook:14615 "This concept implies that an individual organism may be so incapacitated by an environmental change that, though still alive, its contribution to the ecosystem becomes negligible."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14615 goldbook:14619)
AnnotationAssertion(mito:isMentionedBy goldbook:14615 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14615 "current"^^xsd:string)
Declaration(Class(goldbook:14616))
AnnotationAssertion(rdfs:label goldbook:14616 "ecological parameter")
AnnotationAssertion(dcterms:description goldbook:14616 "Measurable variable whose value is a determinant of the characteristics of an ecosystem.")
AnnotationAssertion(rdfs:seeAlso goldbook:14616 goldbook:14619)
AnnotationAssertion(mito:isMentionedBy goldbook:14616 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14616 "current"^^xsd:string)
Declaration(Class(goldbook:14617))
AnnotationAssertion(rdfs:label goldbook:14617 "ecophysiology")
AnnotationAssertion(dcterms:description goldbook:14617 "Study of physiology and tolerance limits of species that enhances understanding of their distribution in relation to abiotic conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14617 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14617 "current"^^xsd:string)
Declaration(Class(goldbook:14618))
AnnotationAssertion(rdfs:label goldbook:14618 "ecoregion")
AnnotationAssertion(dcterms:description goldbook:14618 "Any of a number of regions into which a continent, country, etc., can be divided according to their distinct environmental conditions and habitat types. Large area of land or water with a characteristic, geographically distinct assemblage of natural communities and species comprising a recurring pattern of ecosystems associated with characteristic combinations of soil and landform.Note: The biodiversity of ecosystems in an ecoregion is often distinct from that of other ecoregions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14618 "bioregion")
AnnotationAssertion(rdfs:seeAlso goldbook:14618 goldbook:14479)
AnnotationAssertion(rdfs:seeAlso goldbook:14618 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14618 goldbook:14728)
AnnotationAssertion(rdfs:seeAlso goldbook:14618 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14618 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14618 "current"^^xsd:string)
Declaration(Class(goldbook:14619))
AnnotationAssertion(rdfs:label goldbook:14619 "ecosystem")
AnnotationAssertion(dcterms:description goldbook:14619 "Grouping of organisms (microorganisms, plants, animals) interacting together, with and through their physical and chemical environments, to form a functional entity within a defined environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14619 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14619 "current"^^xsd:string)
Declaration(Class(goldbook:14620))
AnnotationAssertion(rdfs:label goldbook:14620 "ecotone")
AnnotationAssertion(dcterms:description goldbook:14620 "Area of gradual transition between two or more ecosystems.")
AnnotationAssertion(rdfs:seeAlso goldbook:14620 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14620 goldbook:14624)
AnnotationAssertion(mito:isMentionedBy goldbook:14620 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14620 "current"^^xsd:string)
Declaration(Class(goldbook:14621))
AnnotationAssertion(rdfs:label goldbook:14621 "ecotoxicologically relevant concentration")
AnnotationAssertion(dcterms:description goldbook:14621 "Concentration of a pesticide (active ingredient, formulations, and relevant metabolites) that is likely to affect a determinable ecological characteristic of an exposed system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14621 "ERC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14621 "environmentally relevant concentration")
AnnotationAssertion(mito:isMentionedBy goldbook:14621 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14621 "current"^^xsd:string)
Declaration(Class(goldbook:14622))
AnnotationAssertion(rdfs:label goldbook:14622 "edaphic")
AnnotationAssertion(dcterms:description goldbook:14622 "Pertaining to the soil.")
AnnotationAssertion(rdfs:seeAlso goldbook:14622 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14622 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14622 "current"^^xsd:string)
Declaration(Class(goldbook:14623))
AnnotationAssertion(rdfs:label goldbook:14623 "eddy motion")
AnnotationAssertion(dcterms:description goldbook:14623 "Movement in a current of water or air, that is contrary to the direction of the main current, especially in a circular motion, leading to irregularity in the motion of molecules.")
AnnotationAssertion(mito:isMentionedBy goldbook:14623 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14623 "current"^^xsd:string)
Declaration(Class(goldbook:14624))
AnnotationAssertion(rdfs:label goldbook:14624 "edge effect")
AnnotationAssertion(dcterms:description goldbook:14624 "Influence of the closeness of contrasting environments on an ecosystem, seen at boundaries between natural habitats, especially forests, and disturbed or developed land.")
AnnotationAssertion(rdfs:comment goldbook:14624 "Edge effects lead to changes in species richness and population size at the boundary between two communities, most pronounced in small habitat fragments where they may extend throughout the patch."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14624 "Ecotones often have species assemblages with high species richness (\\(S\\)) and high abundance of individuals relative to those of the adjacent communities."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14624 goldbook:14620)
AnnotationAssertion(rdfs:seeAlso goldbook:14624 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14624 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14624 goldbook:14728)
AnnotationAssertion(rdfs:seeAlso goldbook:14624 goldbook:14932)
AnnotationAssertion(rdfs:seeAlso goldbook:14624 goldbook:15051)
AnnotationAssertion(mito:isMentionedBy goldbook:14624 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14624 "current"^^xsd:string)
Declaration(Class(goldbook:14625))
AnnotationAssertion(rdfs:label goldbook:14625 "effect time")
AnnotationAssertion(dcterms:description goldbook:14625 "Time taken for a substance to produce a precisely defined effect.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14625 "ET")
AnnotationAssertion(rdfs:comment goldbook:14625 "\\(\\pu{ET_{50}}\\) is the median time it takes for a toxicant to produce a precisely defined effect in \\(\\pu{50\\%}\\) of a population."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14625 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14625 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14625 "current"^^xsd:string)
Declaration(Class(goldbook:14626))
AnnotationAssertion(rdfs:label goldbook:14626 "effects assessment")
AnnotationAssertion(dcterms:description goldbook:14626 "Component of risk assessment concerned with quantifying the manner in which the frequency and intensity of effects increase with increasing exposure to a contaminant or other source of stress (also known as dose–response assessment or toxicity assessment).")
AnnotationAssertion(mito:isMentionedBy goldbook:14626 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14626 "current"^^xsd:string)
Declaration(Class(goldbook:14627))
AnnotationAssertion(rdfs:label goldbook:14627 "elasticity")
AnnotationAssertion(dcterms:description goldbook:14627 "Ability of a community to return to its prestressed condition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14627 "community elasticity")
AnnotationAssertion(rdfs:seeAlso goldbook:14627 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14627 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14627 "current"^^xsd:string)
Declaration(Class(goldbook:14628))
AnnotationAssertion(rdfs:label goldbook:14628 "elutriate")
AnnotationAssertion(dcterms:description goldbook:14628 "Aqueous solution obtained after adding water to a solid substance (e.g., sediment, tailings, drilling mud, or dredging spoil), shaking the mixture, then centrifuging or filtering it or decanting the supernatant.")
AnnotationAssertion(rdfs:comment goldbook:14628 "An operational definition is water collected from vigorous shaking (\\(\\pu{15 min}\\) to \\(\\pu{30 min}\\)) of one part sediment with four parts water. This mixture is allowed to settle, and the liquid phase is centrifuged and may be filtered."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14628 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14628 "current"^^xsd:string)
Declaration(Class(goldbook:14629))
AnnotationAssertion(rdfs:label goldbook:14629 "elutriate test")
AnnotationAssertion(dcterms:description goldbook:14629 "Test in which a nonbenthic species, such as Daphnia magna, is exposed to an elutriate produced by mixing test sediment with water and then centrifuging the mixture.")
AnnotationAssertion(rdfs:comment goldbook:14629 "The elutriate test was developed for evaluating the potential effects of disposing of dredged material in open water. Analyses of elutriate samples measure the water-soluble constituents potentially released from sediment to the water column during dredge disposal operations"^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14629 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14629 "current"^^xsd:string)
Declaration(Class(goldbook:14630))
AnnotationAssertion(rdfs:label goldbook:14630 "emergent properties")
AnnotationAssertion(dcterms:description goldbook:14630 "New properties emerging with upward steps in hierarchical systems, such as ecological communities or ecosystems, that cannot be predicted solely from our limited understanding of the system’s parts or components.")
AnnotationAssertion(rdfs:comment goldbook:14630 "Such properties arise during the self-organization of complex systems and are the product of the evolution of these systems."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14630 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14630 goldbook:14619)
AnnotationAssertion(mito:isMentionedBy goldbook:14630 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14630 "current"^^xsd:string)
Declaration(Class(goldbook:14631))
AnnotationAssertion(rdfs:label goldbook:14631 "emission standard")
AnnotationAssertion(dcterms:description goldbook:14631 "Quantitative limit on the emission or discharge of a substance from a source, usually expressed in terms of a time-weighted average concentration or a ceiling value.")
AnnotationAssertion(mito:isMentionedBy goldbook:14631 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14631 "current"^^xsd:string)
Declaration(Class(goldbook:14632))
AnnotationAssertion(rdfs:label goldbook:14632 "endemic")
AnnotationAssertion(dcterms:description goldbook:14632 "Pertaining to a species found in a discrete geographical unit, such as an island, habitat type, or other defined area or zone.")
AnnotationAssertion(rdfs:seeAlso goldbook:14632 goldbook:14728)
AnnotationAssertion(mito:isMentionedBy goldbook:14632 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14632 "current"^^xsd:string)
Declaration(Class(goldbook:14633))
AnnotationAssertion(rdfs:label goldbook:14633 "endemism")
AnnotationAssertion(dcterms:description goldbook:14633 "Ecological state of being unique to a place.")
AnnotationAssertion(rdfs:comment goldbook:14633 "There are two subcategories of endemism-paleoendemism and neoendemism. Paleoendemism refers to a species that was formerly widespread but is now restricted to a smaller area. Neoendemism refers to a species that has recently arisen, e.g., by hybridization (see  and is now classified as a separate species. This is a common process in plants especially those that exhibit polyploidy."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14633 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14633 "current"^^xsd:string)
Declaration(Class(goldbook:14634))
AnnotationAssertion(rdfs:label goldbook:14634 "endotherm")
AnnotationAssertion(dcterms:description goldbook:14634 "'Warm-blooded organism' that regulates its body temperature to be (almost) constant.")
AnnotationAssertion(mito:isMentionedBy goldbook:14634 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14634 "current"^^xsd:string)
Declaration(Class(goldbook:14635))
AnnotationAssertion(rdfs:label goldbook:14635 "endpoint")
AnnotationAssertion(dcterms:description goldbook:14635 "Objective of measurement of a toxicity test.")
AnnotationAssertion(rdfs:comment goldbook:14635 "Endpoints vary with the level of biological organization being examined and may include changes in biochemical markers or enzyme activities, mortality or survival, growth, reproduction, primary production, and changes in structure, abundance, and function in a community. Endpoints are used as criteria for toxicity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14635 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14635 "current"^^xsd:string)
Declaration(Class(goldbook:14636))
AnnotationAssertion(rdfs:label goldbook:14636 "endpoint assessment")
AnnotationAssertion(dcterms:description goldbook:14636 "Quantitative or quantifiable expression of the environmental value considered to be at risk in a risk analysis.")
AnnotationAssertion(mito:isMentionedBy goldbook:14636 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14636 "current"^^xsd:string)
Declaration(Class(goldbook:14637))
AnnotationAssertion(rdfs:label goldbook:14637 "environmental assessment")
AnnotationAssertion(dcterms:description goldbook:14637 "Short, preliminary assessment of potential environmental harm used to determine if a full environmental impact statement (EIS) is required.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14637 "EA")
AnnotationAssertion(rdfs:seeAlso goldbook:14637 goldbook:14643)
AnnotationAssertion(mito:isMentionedBy goldbook:14637 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14637 "current"^^xsd:string)
Declaration(Class(goldbook:14638))
AnnotationAssertion(rdfs:label goldbook:14638 "environmental availability")
AnnotationAssertion(dcterms:description goldbook:14638 "Portion of the total amount of a substance present in the environment that is involved in a particular process and is subject to physicochemical and biological modifying influences.")
AnnotationAssertion(rdfs:seeAlso goldbook:14638 goldbook:14639)
AnnotationAssertion(mito:isMentionedBy goldbook:14638 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14638 "current"^^xsd:string)
Declaration(Class(goldbook:14639))
AnnotationAssertion(rdfs:label goldbook:14639 "environmental bioavailability")
AnnotationAssertion(dcterms:description goldbook:14639 "Ratio of uptake clearance to the rate at which an organism encounters a given contaminant in an environmental medium (e.g., soil, sediment, water, food) being processed by the organism.")
AnnotationAssertion(rdfs:comment goldbook:14639 "This is a measure of an organism’s extraction efficiency, via respiratory, dietary, and surface absorption processes, from the environmentally available (bioaccessible) portion of a material."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14639 goldbook:14469)
AnnotationAssertion(rdfs:seeAlso goldbook:14639 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14639 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14639 "current"^^xsd:string)
Declaration(Class(goldbook:14640))
AnnotationAssertion(rdfs:label goldbook:14640 "environmental epidemiology")
AnnotationAssertion(dcterms:description goldbook:14640 "Subdiscipline of human epidemiology concerned with diseases caused by chemical or physical agents in the environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14640 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14640 "current"^^xsd:string)
Declaration(Class(goldbook:14641))
AnnotationAssertion(rdfs:label goldbook:14641 "environmental fate")
AnnotationAssertion(dcterms:description goldbook:14641 "Destiny of a chemical or biological pollutant after release into the natural environment.")
AnnotationAssertion(rdfs:seeAlso goldbook:14641 goldbook:14928)
AnnotationAssertion(mito:isMentionedBy goldbook:14641 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14641 "current"^^xsd:string)
Declaration(Class(goldbook:14642))
AnnotationAssertion(rdfs:label goldbook:14642 "environmental impact assessment")
AnnotationAssertion(dcterms:description goldbook:14642 "Appraisal of the possible environmental consequences of a past, ongoing, or planned action, resulting in the production of an environmental impact statement or 'finding of no significant impact' (FONSI).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14642 "EIA")
AnnotationAssertion(mito:isMentionedBy goldbook:14642 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14642 "current"^^xsd:string)
Declaration(Class(goldbook:14643))
AnnotationAssertion(rdfs:label goldbook:14643 "environmental impact statement")
AnnotationAssertion(dcterms:description goldbook:14643 "Report resulting from an environmental impact assessment.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14643 "EIS")
AnnotationAssertion(rdfs:seeAlso goldbook:14643 goldbook:14642)
AnnotationAssertion(mito:isMentionedBy goldbook:14643 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14643 "current"^^xsd:string)
Declaration(Class(goldbook:14644))
AnnotationAssertion(rdfs:label goldbook:14644 "environmental quality objective")
AnnotationAssertion(dcterms:description goldbook:14644 "Overall state to be aimed for in a particular aspect of the natural environment, for example, 'water in an estuary such that shellfish populations survive in good health'.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14644 "EQO")
AnnotationAssertion(rdfs:comment goldbook:14644 "Unlike an environmental quality standard, the EQO is usually expressed in qualitative and not quantitative terms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14644 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14644 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14644 "current"^^xsd:string)
Declaration(Class(goldbook:14645))
AnnotationAssertion(rdfs:label goldbook:14645 "environmental quality standard")
AnnotationAssertion(dcterms:description goldbook:14645 "Amount concentration or mass concentration of a substance that should not be exceeded in an environmental system, often expressed as a time-weighted average measurement over a defined period.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14645 "EQS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14645 "ambient standard")
AnnotationAssertion(rdfs:seeAlso goldbook:14645 goldbook:14800)
AnnotationAssertion(mito:isMentionedBy goldbook:14645 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14645 "current"^^xsd:string)
Declaration(Class(goldbook:14646))
AnnotationAssertion(rdfs:label goldbook:14646 "environmental risk analysis")
AnnotationAssertion(dcterms:description goldbook:14646 "Determination of the probability of adverse effects on humans and other biota resulting from an environmental hazard (a chemical, physical, or biological agent occurring in or mediated by the environment).")
AnnotationAssertion(mito:isMentionedBy goldbook:14646 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14646 "current"^^xsd:string)
Declaration(Class(goldbook:14647))
AnnotationAssertion(rdfs:label goldbook:14647 "environmental risk assessment")
AnnotationAssertion(dcterms:description goldbook:14647 "Estimate of the probability that harm will result from a defined exposure to a substance in an environmental medium. The estimate is valid only for a given species and set of conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14647 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14647 "current"^^xsd:string)
Declaration(Class(goldbook:14648))
AnnotationAssertion(rdfs:label goldbook:14648 "environmental security")
AnnotationAssertion(dcterms:description goldbook:14648 "United Nations concept, defined as the relative stability of Earth’s natural ecosystems against human activity, most notably  global climate change caused by human release of greenhouse gas; deforestation caused by so-called 'clearing' of lands; or soil depletion and desertification caused by intensive monoculture techniques.")
AnnotationAssertion(rdfs:seeAlso goldbook:14648 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14648 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14648 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14648 "current"^^xsd:string)
Declaration(Class(goldbook:14649))
AnnotationAssertion(rdfs:label goldbook:14649 "environmental transformation")
AnnotationAssertion(dcterms:description goldbook:14649 "Chemical transformation of a substance resulting from interactions in the environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14649 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14649 "current"^^xsd:string)
Declaration(Class(goldbook:14650))
AnnotationAssertion(rdfs:label goldbook:14650 "environmental transport")
AnnotationAssertion(dcterms:description goldbook:14650 "Movement of contaminants from their point of release through the various compartments to locations where exposure is assumed to occur.")
AnnotationAssertion(rdfs:seeAlso goldbook:14650 goldbook:14537)
AnnotationAssertion(rdfs:seeAlso goldbook:14650 goldbook:14549)
AnnotationAssertion(mito:isMentionedBy goldbook:14650 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14650 "current"^^xsd:string)
Declaration(Class(goldbook:14651))
AnnotationAssertion(rdfs:label goldbook:14651 "enzootic")
AnnotationAssertion(dcterms:description goldbook:14651 "Present in a community or among a group of animals; term applied to a disease prevailing continually in a region.")
AnnotationAssertion(rdfs:seeAlso goldbook:14651 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14651 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14651 "current"^^xsd:string)
Declaration(Class(goldbook:14652))
AnnotationAssertion(rdfs:label goldbook:14652 "epibenthic")
AnnotationAssertion(dcterms:description goldbook:14652 "Living on the bed of an aquatic system, normally on sediment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14652 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14652 "current"^^xsd:string)
Declaration(Class(goldbook:14653))
AnnotationAssertion(rdfs:label goldbook:14653 "epifauna")
AnnotationAssertion(dcterms:description goldbook:14653 "Animals that live on the surface of soil or of the bed of an aquatic system, normally on sediment.")
AnnotationAssertion(rdfs:seeAlso goldbook:14653 goldbook:14765)
AnnotationAssertion(rdfs:seeAlso goldbook:14653 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14653 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14653 "current"^^xsd:string)
Declaration(Class(goldbook:14654))
AnnotationAssertion(rdfs:label goldbook:14654 "episodic")
AnnotationAssertion(dcterms:description goldbook:14654 "Discontinuous.")
AnnotationAssertion(mito:isMentionedBy goldbook:14654 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14654 "current"^^xsd:string)
Declaration(Class(goldbook:14655))
AnnotationAssertion(rdfs:label goldbook:14655 "epizootic")
AnnotationAssertion(dcterms:description goldbook:14655 "Outbreak of disease in a population or in a large number of individuals of a species.")
AnnotationAssertion(rdfs:seeAlso goldbook:14655 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14655 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14655 "current"^^xsd:string)
Declaration(Class(goldbook:14656))
AnnotationAssertion(rdfs:label goldbook:14656 "equilibrium")
AnnotationAssertion(dcterms:description goldbook:14656 "State of a system in which the macroscopic properties of the system become uniform and independent of time. If the temperature is uniform throughout the system, a state of thermal equilibrium has been reached; if the pressure is uniform, a state of hydrostatic equilibrium has been reached; and if the chemical potential of each component is uniform, a state of chemical equilibrium has been reached. If all these quantities become uniform, the system is said to be in a state of complete thermodynamic equilibrium.")
AnnotationAssertion(rdfs:comment goldbook:14656 "Complete thermodynamic equilibrium can be expressed in many ways, depending on which variables are of interest. For solubility purposes, the important variables are \\(T\\), \\(p\\) and the chemical potentials \\(\\mu_{i}\\) of the \\(C\\) components. Equilibrium conditions involving these variables may be obtained by the condition that the variation of the Gibbs energy, expressed in terms of \\(T\\), \\(p\\) and the amount of substance \\(n_{i}\\) of the \\(C\\) components, is zero, \\(\\updelta G(T,p,n_{i}) = 0\\), i.e., the Gibbs energy is a minimum. If the variation is negative, an irreversible change of the system can occur."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14656 "Solubility equilibrium is an example of a state of complete thermodynamic equilibrium. For example, a saturated solution of a solid in a liquid at a fixed temperature and pressure is in a state of complete thermodynamic equilibrium. If the system is subjected to a small increase in temperature, a small portion of solid will dissolve to restore the equilibrium (if the solubility increases with temperature), while if there is a small decrease in temperature, a small portion of solid will precipitate. This is the basis for determining accurate values of solubility by approaching the equilibrium solubility from both supersaturation and undersaturation directions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14656 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14656 "current"^^xsd:string)
Declaration(Class(goldbook:14657))
AnnotationAssertion(rdfs:label goldbook:14657 "equilibrium partitioning")
AnnotationAssertion(dcterms:description goldbook:14657 "Tendency for a substance to achieve the same fugacity (chemical activity) in different compartments of a complex system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14657 "EqP")
AnnotationAssertion(mito:isMentionedBy goldbook:14657 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14657 "current"^^xsd:string)
Declaration(Class(goldbook:14658))
AnnotationAssertion(rdfs:label goldbook:14658 "equilibrium partitioning approach")
AnnotationAssertion(dcterms:description goldbook:14658 "Approach to estimating the fate of chemicals in the aquatic environment that is based on equilibrium partitioning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14658 "EqP approach")
AnnotationAssertion(rdfs:comment goldbook:14658 "The EqP approach is often exploited (primarily for organics), for interpretation and extrapolation purposes, by normalizing chemical concentrations based on the lipid content of the aquatic organisms and the organic carbon content of the sediments. These normalized biota-sediment accumulation factor (BSAF) values are considered to be independent of particular sediments and species."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14658 goldbook:14498)
AnnotationAssertion(rdfs:seeAlso goldbook:14658 goldbook:14657)
AnnotationAssertion(mito:isMentionedBy goldbook:14658 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14658 "current"^^xsd:string)
Declaration(Class(goldbook:14659))
AnnotationAssertion(rdfs:label goldbook:14659 "essential nutrient")
AnnotationAssertion(dcterms:description goldbook:14659 "Substance that is absolutely required for the normal growth and development of a defined organism throughout a complete life cycle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14659 "essential element")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14659 "essential metal")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14659 "nutrient")
AnnotationAssertion(rdfs:comment goldbook:14659 "According to criteria of essentiality suggested by Arnon and Stout, a nutrient can be called essential if: (i) its deficiency makes it impossible for an organism to complete its life cycle; (ii) its deficiency is specific to the element in question and can be corrected only by supplying this element; and (iii) the nutrient is directly involved in the organism’s nutrition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14659 "It has been suggested that an element should be considered essential if its addition enhances growth or if it can substitute for one of the elements that satisfy the criteria of Arnon and Stout. It has also been suggested that three other elements, which do not satisfy the criteria for many plant species but contribute indirectly to their survival, should be classified as essential. These elements are nickel (urea transformations), cobalt (\\(\\ce{N2}\\) fixation), and silicon."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14659 "Related terms are \"essential element\" and \"essential metal\", which may be given the same definition, simply by substituting \"element\" or \"metal\" for nutrient."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14659 "The term is often used misleadingly since it is meaningless unless accompanied by a statement of which organisms show a requirement for the nutrient."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14659 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14659 "current"^^xsd:string)
Declaration(Class(goldbook:14660))
AnnotationAssertion(rdfs:label goldbook:14660 "estuarine")
AnnotationAssertion(dcterms:description goldbook:14660 "Belonging to an estuary.")
AnnotationAssertion(rdfs:seeAlso goldbook:14660 goldbook:14661)
AnnotationAssertion(mito:isMentionedBy goldbook:14660 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14660 "current"^^xsd:string)
Declaration(Class(goldbook:14661))
AnnotationAssertion(rdfs:label goldbook:14661 "estuary")
AnnotationAssertion(dcterms:description goldbook:14661 "(general) Tidal opening, an inlet, or creek through which the tide enters; an arm of the sea indenting the land. Rare in modern use. (specific) Tidal mouth of a great river, where the tide meets the current of freshwater. Note 1: An estuary is a semi-enclosed coastal body of water with a free connection to the open sea made up of brackish water, typically the tidal mouth of rivers, often associated with sedimentation of material from terrestrial runoff. Note 2: An estuary is often associated with a high rate of biological productivity.")
AnnotationAssertion(mito:isMentionedBy goldbook:14661 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14661 "current"^^xsd:string)
Declaration(Class(goldbook:14662))
AnnotationAssertion(rdfs:label goldbook:14662 "etiologic agent")
AnnotationAssertion(dcterms:description goldbook:14662 "Factor contributing to the cause of a disease.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14662 "etiological agent")
AnnotationAssertion(mito:isMentionedBy goldbook:14662 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14662 "current"^^xsd:string)
Declaration(Class(goldbook:14663))
AnnotationAssertion(rdfs:label goldbook:14663 "Euler–Lotka equation")
AnnotationAssertion(dcterms:description goldbook:14663 "Equation used to estimate the intrinsic rate of increase from life-table data.")
AnnotationAssertion(mito:isMentionedBy goldbook:14663 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14663 "current"^^xsd:string)
Declaration(Class(goldbook:14664))
AnnotationAssertion(rdfs:label goldbook:14664 "eutrophic")
AnnotationAssertion(dcterms:description goldbook:14664 "Describing an environment having a high concentration of nutrients. Note: The term is usually used to describe nutrient-rich bodies of water or soil having a high or excessive rate of biological production. In medicine, tending to promote nutrition.")
AnnotationAssertion(rdfs:seeAlso goldbook:14664 goldbook:14893)
AnnotationAssertion(mito:isMentionedBy goldbook:14664 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14664 "current"^^xsd:string)
Declaration(Class(goldbook:14665))
AnnotationAssertion(rdfs:label goldbook:14665 "eutrophication")
AnnotationAssertion(dcterms:description goldbook:14665 "Process producing a high concentration of nutrient salts and a high or excessive rate of biological production in water.")
AnnotationAssertion(rdfs:comment goldbook:14665 "Usually involves depletion of the oxygen content caused by decay of organic matter resulting from high primary production as a result of enhanced input of nutrients."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14665 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14665 "current"^^xsd:string)
Declaration(Class(goldbook:14666))
AnnotationAssertion(rdfs:label goldbook:14666 "eutrophy")
AnnotationAssertion(dcterms:description goldbook:14666 "State of being eutrophic. (in medicine) Good nutrition.")
AnnotationAssertion(rdfs:seeAlso goldbook:14666 goldbook:14664)
AnnotationAssertion(rdfs:seeAlso goldbook:14666 goldbook:14894)
AnnotationAssertion(mito:isMentionedBy goldbook:14666 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14666 "current"^^xsd:string)
Declaration(Class(goldbook:14667))
AnnotationAssertion(rdfs:label goldbook:14667 "evolution")
AnnotationAssertion(dcterms:description goldbook:14667 "Transformation of animals, plants, and other living organisms into different forms by the accumulation of changes over successive generations. Transmutation of species. Origination or transformation of an organism, organ, physiological process, biological molecule, etc., by a series of changes. Note: The theory of evolution (in general) is the proposition that all living organisms have undergone a process of alteration and diversification from simple primordial forms during the Earth’s history; (in particular) it is a scientific theory proposing a mechanism for this process, now especially that based on Darwin’s theory of the natural selection of genetically inherited and adaptive variation (see neo-Darwinism)")
AnnotationAssertion(rdfs:seeAlso goldbook:14667 goldbook:14874)
AnnotationAssertion(mito:isMentionedBy goldbook:14667 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14667 "current"^^xsd:string)
Declaration(Class(goldbook:14668))
AnnotationAssertion(rdfs:label goldbook:14668 "exchange diffusion")
AnnotationAssertion(dcterms:description goldbook:14668 "Diffusion across a membrane by means of a carrier molecule that requires no energy and involves the exchange of two ions across the membrane.")
AnnotationAssertion(mito:isMentionedBy goldbook:14668 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14668 "current"^^xsd:string)
Declaration(Class(goldbook:14669))
AnnotationAssertion(rdfs:label goldbook:14669 "expected life span")
AnnotationAssertion(dcterms:description goldbook:14669 "Average length of time an organism can be expected to survive, or a substance can be expected to persist.")
AnnotationAssertion(mito:isMentionedBy goldbook:14669 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14669 "current"^^xsd:string)
Declaration(Class(goldbook:14670))
AnnotationAssertion(rdfs:label goldbook:14670 "experimental ecosystem")
AnnotationAssertion(dcterms:description goldbook:14670 "Manmade construction intended to simulate a natural environment.")
AnnotationAssertion(rdfs:seeAlso goldbook:14670 goldbook:14802)
AnnotationAssertion(rdfs:seeAlso goldbook:14670 goldbook:14808)
AnnotationAssertion(rdfs:seeAlso goldbook:14670 goldbook:14846)
AnnotationAssertion(rdfs:seeAlso goldbook:14670 goldbook:14852)
AnnotationAssertion(mito:isMentionedBy goldbook:14670 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14670 "current"^^xsd:string)
Declaration(Class(goldbook:14671))
AnnotationAssertion(rdfs:label goldbook:14671 "exploitation competition")
AnnotationAssertion(dcterms:description goldbook:14671 "Interspecies competition in which species compete for some limiting resource such as food.")
AnnotationAssertion(mito:isMentionedBy goldbook:14671 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14671 "current"^^xsd:string)
Declaration(Class(goldbook:14672))
AnnotationAssertion(rdfs:label goldbook:14672 "exponential growth")
AnnotationAssertion(dcterms:description goldbook:14672 "Growth of cells, organisms, or populations in which the number or mass increases exponentially and growth at any time is proportional to the number or mass present.")
AnnotationAssertion(rdfs:comment goldbook:14672 "The mathematical relationship is of the same form as that for exponential decay."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14672 goldbook:14725)
AnnotationAssertion(rdfs:seeAlso goldbook:14672 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14672 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14672 "current"^^xsd:string)
Declaration(Class(goldbook:14673))
AnnotationAssertion(rdfs:label goldbook:14673 "exposure assessment")
AnnotationAssertion(dcterms:description goldbook:14673 "Process of measuring or estimating concentration (or intensity), duration, and frequency of exposures to an agent present in the environment or, if estimating hypothetical exposures, that might arise from the release of a substance, or radionuclide, into the environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14673 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14673 "current"^^xsd:string)
Declaration(Class(goldbook:14674))
AnnotationAssertion(rdfs:label goldbook:14674 "exposure characterisation")
AnnotationAssertion(dcterms:description goldbook:14674 "Description of the presence and characteristics of contact between the contaminant and the ecological entity of concern, and a summary of this information in an exposure profile.")
AnnotationAssertion(rdfs:seeAlso goldbook:14674 goldbook:14549)
AnnotationAssertion(mito:isMentionedBy goldbook:14674 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14674 "current"^^xsd:string)
Declaration(Class(goldbook:14675))
AnnotationAssertion(rdfs:label goldbook:14675 "exposure pathway")
AnnotationAssertion(dcterms:description goldbook:14675 "Route by which an individual is exposed to a contaminant, including the source and point of contact.")
AnnotationAssertion(rdfs:seeAlso goldbook:14675 goldbook:14549)
AnnotationAssertion(mito:isMentionedBy goldbook:14675 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14675 "current"^^xsd:string)
Declaration(Class(goldbook:14676))
AnnotationAssertion(rdfs:label goldbook:14676 "exposure profile")
AnnotationAssertion(dcterms:description goldbook:14676 "Outline of the magnitude and spatio-temporal pattern of exposure developed during the process of ecological risk assessment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14676 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14676 "current"^^xsd:string)
Declaration(Class(goldbook:14677))
AnnotationAssertion(rdfs:label goldbook:14677 "exposure scenario")
AnnotationAssertion(dcterms:description goldbook:14677 "Model of the likely exposure of selected populations following release of a substance into a natural environment.")
AnnotationAssertion(rdfs:seeAlso goldbook:14677 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14677 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14677 "current"^^xsd:string)
Declaration(Class(goldbook:14678))
AnnotationAssertion(rdfs:label goldbook:14678 "extinction probability")
AnnotationAssertion(dcterms:description goldbook:14678 "Probability that a population will eventually become extinct. Probability that a population will become extinct within a specified interval of time.")
AnnotationAssertion(rdfs:comment goldbook:14678 "Very small populations are likely to go extinct just by chance due to demographic stochasticity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14678 goldbook:14572)
AnnotationAssertion(rdfs:seeAlso goldbook:14678 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14678 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14678 "current"^^xsd:string)
Declaration(Class(goldbook:14679))
AnnotationAssertion(rdfs:label goldbook:14679 "extrapolation")
AnnotationAssertion(dcterms:description goldbook:14679 "Calculation, based on quantitative observations in exposed test species or in vitro test systems, of predicted dose–effect and dose–response relationships for a substance in the same species at other doses or in humans and other species at similar doses.")
AnnotationAssertion(rdfs:comment goldbook:14679 "The term may be applied to predictions of such relationships in susceptible groups from knowledge of a group used for testing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14679 "The term may also be used for qualitative information applied to species or conditions that are different from the ones in which the original investigations were carried out."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14679 goldbook:14600)
AnnotationAssertion(rdfs:seeAlso goldbook:14679 goldbook:14604)
AnnotationAssertion(mito:isMentionedBy goldbook:14679 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14679 "current"^^xsd:string)
Declaration(Class(goldbook:14680))
AnnotationAssertion(rdfs:label goldbook:14680 "extrapolation factor")
AnnotationAssertion(dcterms:description goldbook:14680 "Quantity used in effect and exposure assessments to adjust estimated exposures or concentrations/doses for uncertainties, to make corrections in the data, or to improve safety.")
AnnotationAssertion(rdfs:seeAlso goldbook:14680 goldbook:14626)
AnnotationAssertion(mito:isMentionedBy goldbook:14680 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14680 "current"^^xsd:string)
Declaration(Class(goldbook:14681))
AnnotationAssertion(rdfs:label goldbook:14681 "facilitated diffusion")
AnnotationAssertion(dcterms:description goldbook:14681 "Passive diffusion down a gradient, not requiring energy, but occurring at a rate faster than expected by simple diffusion alone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14681 "facilitated transport")
AnnotationAssertion(rdfs:comment goldbook:14681 "Facilitated diffusion may involve a membrane channel or a carrier molecule, often a protein. In the latter case, it may be referred to as facilitated transport. Both processes exhibit ligand specificity and saturation kinetics."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14681 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14681 "current"^^xsd:string)
Declaration(Class(goldbook:14682))
AnnotationAssertion(rdfs:label goldbook:14682 "fate")
AnnotationAssertion(dcterms:description goldbook:14682 "Disposition of a material in various environmental compartments (e.g., soil or sediment, water, air, biota) as a result of transport, partitioning, transformation, and degradation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14682 goldbook:14537)
AnnotationAssertion(rdfs:seeAlso goldbook:14682 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14682 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14682 "current"^^xsd:string)
Declaration(Class(goldbook:14683))
AnnotationAssertion(rdfs:label goldbook:14683 "feasibility study")
AnnotationAssertion(dcterms:description goldbook:14683 "Part of a remedial investigation that compares the various options available for remediation and identifies those that are practicable.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14683 "FS")
AnnotationAssertion(rdfs:seeAlso goldbook:14683 goldbook:14989)
AnnotationAssertion(mito:isMentionedBy goldbook:14683 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14683 "current"^^xsd:string)
Declaration(Class(goldbook:14684))
AnnotationAssertion(rdfs:label goldbook:14684 "fecundity selection")
AnnotationAssertion(dcterms:description goldbook:14684 "Component of the life cycle of an individual in which natural selection can occur, involving the production of more offspring by matings of certain genotype pairs than are produced by other genotype pairs.")
AnnotationAssertion(mito:isMentionedBy goldbook:14684 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14684 "current"^^xsd:string)
Declaration(Class(goldbook:14685))
AnnotationAssertion(rdfs:label goldbook:14685 "fertilisation effect")
AnnotationAssertion(dcterms:description goldbook:14685 "Enhanced growth of plants as a result of exposure to low levels of pollutants such as nitrogen and sulfur oxides in acid precipitation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14685 goldbook:14928)
AnnotationAssertion(mito:isMentionedBy goldbook:14685 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14685 "current"^^xsd:string)
Declaration(Class(goldbook:14686))
AnnotationAssertion(rdfs:label goldbook:14686 "fertiliser")
AnnotationAssertion(dcterms:description goldbook:14686 "Substance applied to soil or hydroponic systems for improving the root nutrition of plants with the aim of increasing crop yields and (or) controlling production.")
AnnotationAssertion(rdfs:seeAlso goldbook:14686 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14686 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14686 "current"^^xsd:string)
Declaration(Class(goldbook:14687))
AnnotationAssertion(rdfs:label goldbook:14687 "final acute value")
AnnotationAssertion(dcterms:description goldbook:14687 "Estimate of the concentration of a substance corresponding to a cumulative probability of \\(\\pu{0.05}\\) in the acute toxicity values for all species for which acceptable acute tests have been conducted on the material.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14687 "FAV")
AnnotationAssertion(mito:isMentionedBy goldbook:14687 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14687 "current"^^xsd:string)
Declaration(Class(goldbook:14688))
AnnotationAssertion(rdfs:label goldbook:14688 "final chronic value")
AnnotationAssertion(dcterms:description goldbook:14688 "Estimate of the concentration of a substance corresponding to a cumulative probability of \\(\\pu{0.05}\\) in the chronic toxicity values for all genera for which acceptable chronic tests have been conducted on the material.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14688 "FCV")
AnnotationAssertion(rdfs:comment goldbook:14688 "The FCV can also be calculated by dividing the final acute value (FAV) by the final acute-to-chronic toxicity ratio (ACR)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14688 goldbook:14422)
AnnotationAssertion(rdfs:seeAlso goldbook:14688 goldbook:14687)
AnnotationAssertion(mito:isMentionedBy goldbook:14688 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14688 "current"^^xsd:string)
Declaration(Class(goldbook:14689))
AnnotationAssertion(rdfs:label goldbook:14689 "finding of no significant impact")
AnnotationAssertion(dcterms:description goldbook:14689 "Statement of no significant impact of a major federal action concluded after an environmental assessment (EA).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14689 "FONSI")
AnnotationAssertion(rdfs:seeAlso goldbook:14689 goldbook:14637)
AnnotationAssertion(mito:isMentionedBy goldbook:14689 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14689 "current"^^xsd:string)
Declaration(Class(goldbook:14690))
AnnotationAssertion(rdfs:label goldbook:14690 "finite rate of increase")
AnnotationAssertion(dcterms:description goldbook:14690 "Rate of increase of population size measured over set intervals, such as between age classes of a life table or generations of a population with nonoverlapping generations, e.g., an annual plant.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14690 "multiplicative growth factor per generation")
AnnotationAssertion(rdfs:seeAlso goldbook:14690 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14690 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14690 "current"^^xsd:string)
Declaration(Class(goldbook:14691))
AnnotationAssertion(rdfs:label goldbook:14691 "fish acute toxicity syndromes")
AnnotationAssertion(dcterms:description goldbook:14691 "Behavioral, physiological, and biochemical responses of fish used to classify chemicals by mode of action.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14691 "FATS")
AnnotationAssertion(mito:isMentionedBy goldbook:14691 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14691 "current"^^xsd:string)
Declaration(Class(goldbook:14692))
AnnotationAssertion(rdfs:label goldbook:14692 "fitness advantage")
AnnotationAssertion(dcterms:description goldbook:14692 "Increased relative fitness of a resistant genotype in a polluted environment compared to a nonresistant genotype.")
AnnotationAssertion(mito:isMentionedBy goldbook:14692 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14692 "current"^^xsd:string)
Declaration(Class(goldbook:14693))
AnnotationAssertion(rdfs:label goldbook:14693 "fitness cost")
AnnotationAssertion(dcterms:description goldbook:14693 "Reduced relative fitness of a resistant genotype in an unpolluted environment compared to a nonresistant genotype.")
AnnotationAssertion(mito:isMentionedBy goldbook:14693 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14693 "current"^^xsd:string)
Declaration(Class(goldbook:14694))
AnnotationAssertion(rdfs:label goldbook:14694 "flow-through system")
AnnotationAssertion(dcterms:description goldbook:14694 "Exposure system for aquatic toxicity tests in which the test material solutions and control water flow into and out of test chambers on a once-through basis either intermittently or continuously.")
AnnotationAssertion(mito:isMentionedBy goldbook:14694 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14694 "current"^^xsd:string)
Declaration(Class(goldbook:14695))
AnnotationAssertion(rdfs:label goldbook:14695 "flow-through test")
AnnotationAssertion(dcterms:description goldbook:14695 "Aquatic toxicity test performed in a flow-through system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14695 "continuous flow test")
AnnotationAssertion(rdfs:seeAlso goldbook:14695 goldbook:14694)
AnnotationAssertion(mito:isMentionedBy goldbook:14695 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14695 "current"^^xsd:string)
Declaration(Class(goldbook:14696))
AnnotationAssertion(rdfs:label goldbook:14696 "fluctuating asymmetry")
AnnotationAssertion(dcterms:description goldbook:14696 "Deviation from perfect bilateral symmetry for a population of a bilaterally symmetrical species that is thought to reflect developmental instability.")
AnnotationAssertion(rdfs:comment goldbook:14696 "A trait is measured from the right and left sides of each individual, and the variance in the difference (right–left) for the population is a measure of fluctuating asymmetry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14696 goldbook:14444)
AnnotationAssertion(rdfs:seeAlso goldbook:14696 goldbook:14590)
AnnotationAssertion(rdfs:seeAlso goldbook:14696 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14696 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14696 "current"^^xsd:string)
Declaration(Class(goldbook:14697))
AnnotationAssertion(rdfs:label goldbook:14697 "fluid feeder")
AnnotationAssertion(dcterms:description goldbook:14697 "Organism that feeds on the fluids of other animals or of plants.")
AnnotationAssertion(mito:isMentionedBy goldbook:14697 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14697 "current"^^xsd:string)
Declaration(Class(goldbook:14698))
AnnotationAssertion(rdfs:label goldbook:14698 "food chain")
AnnotationAssertion(dcterms:description goldbook:14698 "Hierarchical sequence of transfer of substances from prey organism to predator organism.")
AnnotationAssertion(rdfs:comment goldbook:14698 "Interconnected food chains combine to form a food web in which most organisms consume or are consumed by more than one other type of organism."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14698 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14698 "current"^^xsd:string)
Declaration(Class(goldbook:14699))
AnnotationAssertion(rdfs:label goldbook:14699 "food-mass feeder")
AnnotationAssertion(dcterms:description goldbook:14699 "Animal that feeds on the body parts of other animals.")
AnnotationAssertion(mito:isMentionedBy goldbook:14699 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14699 "current"^^xsd:string)
Declaration(Class(goldbook:14700))
AnnotationAssertion(rdfs:label goldbook:14700 "fossil")
AnnotationAssertion(dcterms:description goldbook:14700 "Mineralized or otherwise preserved remnant or trace (such as a footprint) of an animal, plant, and other organism.")
AnnotationAssertion(mito:isMentionedBy goldbook:14700 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14700 "current"^^xsd:string)
Declaration(Class(goldbook:14701))
AnnotationAssertion(rdfs:label goldbook:14701 "free ion activity model")
AnnotationAssertion(dcterms:description goldbook:14701 "Model for acute metal toxicity to aquatic organisms based on the idea that toxicity occurs when the concentration of the free metal cation in solution reaches a certain level.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14701 "FIAM")
AnnotationAssertion(rdfs:comment goldbook:14701 "This model has been developed into the biotic ligand model."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14701 goldbook:14501)
AnnotationAssertion(mito:isMentionedBy goldbook:14701 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14701 "current"^^xsd:string)
Declaration(Class(goldbook:14702))
AnnotationAssertion(rdfs:label goldbook:14702 "Freundlich adsorption isotherm")
AnnotationAssertion(dcterms:description goldbook:14702 "Empirical equation that describes the adsorption of a contaminant to soil. The equation is \\[x/m = (K_{\\rm{f}} C_{\\rm{e}}) \\exp (1/n)\\] where \\(x/m\\) is the mass ratio of concentrations of adsorbed substance at equilibrium divided by the concentration of the contaminant in soil, \\(C_{\\rm{e}}\\) is the contaminant concentration in the aqueous phase at equilibrium, \\(K_{\\rm{f}}\\) is the equilibrium constant (the Freundlich adsorption constant), and \\(1/n\\) is a contaminant specific exponent.")
AnnotationAssertion(rdfs:seeAlso goldbook:14702 goldbook:14549)
AnnotationAssertion(rdfs:seeAlso goldbook:14702 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14702 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14702 "current"^^xsd:string)
Declaration(Class(goldbook:14703))
AnnotationAssertion(rdfs:label goldbook:14703 "fulvic acid")
AnnotationAssertion(dcterms:description goldbook:14703 "Humic substance that is soluble at all \\(\\rm{pH}\\)s.")
AnnotationAssertion(rdfs:comment goldbook:14703 "Most of the humic substance in natural water is fulvic acid."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14703 goldbook:14746)
AnnotationAssertion(mito:isMentionedBy goldbook:14703 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14703 "current"^^xsd:string)
Declaration(Class(goldbook:14704))
AnnotationAssertion(rdfs:label goldbook:14704 "functional redundancy")
AnnotationAssertion(dcterms:description goldbook:14704 "Apparently unaltered maintenance of community function despite changes in structure.")
AnnotationAssertion(rdfs:seeAlso goldbook:14704 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14704 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14704 "current"^^xsd:string)
Declaration(Class(goldbook:14705))
AnnotationAssertion(rdfs:label goldbook:14705 "functional response")
AnnotationAssertion(dcterms:description goldbook:14705 "Change in some predator function, such as prey consumption rate, in response to changes in prey density.")
AnnotationAssertion(mito:isMentionedBy goldbook:14705 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14705 "current"^^xsd:string)
Declaration(Class(goldbook:14706))
AnnotationAssertion(rdfs:label goldbook:14706 "fundamental niche")
AnnotationAssertion(dcterms:description goldbook:14706 "Environmental conditions under which a species can thrive.")
AnnotationAssertion(rdfs:seeAlso goldbook:14706 goldbook:14747)
AnnotationAssertion(rdfs:seeAlso goldbook:14706 goldbook:14877)
AnnotationAssertion(mito:isMentionedBy goldbook:14706 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14706 "current"^^xsd:string)
Declaration(Class(goldbook:14707))
AnnotationAssertion(rdfs:label goldbook:14707 "Gaia hypothesis")
AnnotationAssertion(dcterms:description goldbook:14707 "Hypothesis proposed by James Lovelock that the Earth’s temperature, albedo, and surface chemistry are homeostatically regulated by the sum of all the biota of the Earth.")
AnnotationAssertion(mito:isMentionedBy goldbook:14707 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14707 "current"^^xsd:string)
Declaration(Class(goldbook:14708))
AnnotationAssertion(rdfs:label goldbook:14708 "gametic selection")
AnnotationAssertion(dcterms:description goldbook:14708 "Natural selection resulting from differential success of gametes produced by heterozygotes.")
AnnotationAssertion(mito:isMentionedBy goldbook:14708 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14708 "current"^^xsd:string)
Declaration(Class(goldbook:14709))
AnnotationAssertion(rdfs:label goldbook:14709 "gastrointestinal excretion")
AnnotationAssertion(dcterms:description goldbook:14709 "Excretion through the intestinal mucosa by active or passive processes.")
AnnotationAssertion(rdfs:comment goldbook:14709 "This may involve loss by normal cell sloughing of the intestine wall."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14709 "Some chemical species of metallic elements such as cadmium and mercury can experience significant levels of gastrointestinal excretion."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14709 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14709 "current"^^xsd:string)
Declaration(Class(goldbook:14710))
AnnotationAssertion(rdfs:label goldbook:14710 "general adaptation syndrome")
AnnotationAssertion(dcterms:description goldbook:14710 "Specific syndrome associated with Selyean stress composed of three phases: the alarm reaction, adaptation or resistance, and exhaustion; adaptation in all phases of the GAS results in restoration of homeostasis or reduced deviation from homeostasis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14710 "GAS")
AnnotationAssertion(rdfs:seeAlso goldbook:14710 goldbook:15025)
AnnotationAssertion(mito:isMentionedBy goldbook:14710 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14710 "current"^^xsd:string)
Declaration(Class(goldbook:14711))
AnnotationAssertion(rdfs:label goldbook:14711 "genetic adaptation")
AnnotationAssertion(dcterms:description goldbook:14711 "Result of random genetic variation due to mutation and (or) to changes in allele frequencies, causing variation in the survival and reproductive success of individuals and hence of groups of organisms, with the consequence that those best adjusted to their environment flourish.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14711 "adaptation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14711 "evolutionary adaptation")
AnnotationAssertion(rdfs:comment goldbook:14711 "This process underlies the concept of natural selection leading to Darwinian evolution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14711 goldbook:14871)
AnnotationAssertion(mito:isMentionedBy goldbook:14711 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14711 "current"^^xsd:string)
Declaration(Class(goldbook:14712))
AnnotationAssertion(rdfs:label goldbook:14712 "genetic drift")
AnnotationAssertion(dcterms:description goldbook:14712 "Evolutionary process of change in the allele frequencies in a population due to random changes in the frequency by which different alleles are transferred to the next generation.")
AnnotationAssertion(rdfs:comment goldbook:14712 "In small populations, genetic drift may result in extinction of some alleles leading to evolutionary change over time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14712 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14712 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14712 "current"^^xsd:string)
Declaration(Class(goldbook:14713))
AnnotationAssertion(rdfs:label goldbook:14713 "genetic hitchhiking")
AnnotationAssertion(dcterms:description goldbook:14713 "Situation in which a scored locus is acting only as a marker for a closely linked gene that is actually responsible for the difference in tolerance among genotypes. More generally, it is the condition 'in which a given allele changes in frequency as a result of linkage or gametic phase disequilibrium with another selected locus'.")
AnnotationAssertion(mito:isMentionedBy goldbook:14713 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14713 "current"^^xsd:string)
Declaration(Class(goldbook:14714))
AnnotationAssertion(rdfs:label goldbook:14714 "genetic risk")
AnnotationAssertion(dcterms:description goldbook:14714 "Risk to the progeny of an exposed individual of an adverse effect associated with heritable genetic damage, e.g., damage to germ cells leading to a nonviable fetus or an offspring with a birth defect.")
AnnotationAssertion(mito:isMentionedBy goldbook:14714 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14714 "current"^^xsd:string)
Declaration(Class(goldbook:14716))
AnnotationAssertion(rdfs:label goldbook:14716 "genus")
AnnotationAssertion(dcterms:description goldbook:14716 "Low-level taxonomic rank used in the classification of living and fossil organisms.")
AnnotationAssertion(rdfs:comment goldbook:14716 "Like almost all other taxonomic units, genera may sometimes be divided into subgenera, singular: subgenus. The largest main taxonomic unit below the genus is the species."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14716 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14716 "current"^^xsd:string)
Declaration(Class(goldbook:14717))
AnnotationAssertion(rdfs:label goldbook:14717 "geographic information system")
AnnotationAssertion(dcterms:description goldbook:14717 "Computerized system to handle spatial data at a reasonable cost; most allow one to archive, organize, integrate, statistically analyze, and display many kinds of spatial information using a common coordinate system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14717 "GIS")
AnnotationAssertion(mito:isMentionedBy goldbook:14717 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14717 "current"^^xsd:string)
Declaration(Class(goldbook:14718))
AnnotationAssertion(rdfs:label goldbook:14718 "global distillation")
AnnotationAssertion(dcterms:description goldbook:14718 "Process by which persistent and relatively volatile organochlorine compounds are distilled from warmer regions of use to cooler regions of the globe.")
AnnotationAssertion(mito:isMentionedBy goldbook:14718 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14718 "current"^^xsd:string)
Declaration(Class(goldbook:14719))
AnnotationAssertion(rdfs:label goldbook:14719 "global fractionation")
AnnotationAssertion(dcterms:description goldbook:14719 "Process by which some persistent organic pollutants (POPs) move more rapidly than others toward the polar regions. Because POPs differ in their individual rates of degradation, vapor pressure, and lipophilicity, a fractionation occurs. The net result is a redistribution of the different POPs from the equator or site of origin toward the cold polar regions of the Earth.")
AnnotationAssertion(rdfs:seeAlso goldbook:14719 goldbook:14909)
AnnotationAssertion(mito:isMentionedBy goldbook:14719 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14719 "current"^^xsd:string)
Declaration(Class(goldbook:14720))
AnnotationAssertion(rdfs:label goldbook:14720 "global warming")
AnnotationAssertion(dcterms:description goldbook:14720 "Heating up of the Earth’s climate thought to result from the increased atmospheric carbon dioxide (\\(\\ce{CO2}\\)) concentrations from fossil fuel burning, release of other greenhouse gases, and the worldwide destruction of forests.")
AnnotationAssertion(mito:isMentionedBy goldbook:14720 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14720 "current"^^xsd:string)
Declaration(Class(goldbook:14721))
AnnotationAssertion(rdfs:label goldbook:14721 "good laboratory practice principles")
AnnotationAssertion(dcterms:description goldbook:14721 "Fundamental rules incorporated in Organization for Economic Cooperation and Development (OECD) guidelines and national regulations concerned with the process of effective organization and the conditions under which laboratory studies are properly planned, performed, monitored, recorded, and reported.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14721 "GLP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14721 "GLP principles")
AnnotationAssertion(mito:isMentionedBy goldbook:14721 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14721 "current"^^xsd:string)
Declaration(Class(goldbook:14722))
AnnotationAssertion(rdfs:label goldbook:14722 "graded effect")
AnnotationAssertion(dcterms:description goldbook:14722 "Consequence that can be measured on a graded scale of intensity or severity and its magnitude related directly to the dose or concentration of the substance producing it.")
AnnotationAssertion(rdfs:seeAlso goldbook:14722 goldbook:14965)
AnnotationAssertion(mito:isMentionedBy goldbook:14722 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14722 "current"^^xsd:string)
Declaration(Class(goldbook:14723))
AnnotationAssertion(rdfs:label goldbook:14723 "grasshopper effect")
AnnotationAssertion(dcterms:description goldbook:14723 "Global distillation of persistent organic pollutants (POPs) involving seasonal cycling of temperatures such that movement toward the higher latitudes occurs in annual pulses.")
AnnotationAssertion(rdfs:seeAlso goldbook:14723 goldbook:14718)
AnnotationAssertion(rdfs:seeAlso goldbook:14723 goldbook:14909)
AnnotationAssertion(mito:isMentionedBy goldbook:14723 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14723 "current"^^xsd:string)
Declaration(Class(goldbook:14724))
AnnotationAssertion(rdfs:label goldbook:14724 "greenhouse gases")
AnnotationAssertion(dcterms:description goldbook:14724 "Atmospheric gases that are relatively transparent to sunlight entering the atmosphere but absorb infrared radiation generated at the Earth’s surface. They include water vapor, carbon dioxide (\\(\\ce{CO2}\\)), methane, dinitrogen oxide (nitrous oxide), chlorofluorocarbons (CFCs), chloroethane (methylchloroform), carbon tetrachloride, and the fire retardant, halon. Ozone in the troposphere can also act as a greenhouse gas.")
AnnotationAssertion(mito:isMentionedBy goldbook:14724 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14724 "current"^^xsd:string)
Declaration(Class(goldbook:14725))
AnnotationAssertion(rdfs:label goldbook:14725 "growth")
AnnotationAssertion(dcterms:description goldbook:14725 "Increase in size.")
AnnotationAssertion(rdfs:seeAlso goldbook:14725 goldbook:14672)
AnnotationAssertion(rdfs:seeAlso goldbook:14725 goldbook:14774)
AnnotationAssertion(rdfs:seeAlso goldbook:14725 goldbook:14811)
AnnotationAssertion(mito:isMentionedBy goldbook:14725 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14725 "current"^^xsd:string)
Declaration(Class(goldbook:14726))
AnnotationAssertion(rdfs:label goldbook:14726 "growth dilution")
AnnotationAssertion(dcterms:description goldbook:14726 "Decrease in contaminant concentration in a growing organism because the amount of tissue in which the contaminant is distributed is increasing.")
AnnotationAssertion(rdfs:seeAlso goldbook:14726 goldbook:14549)
AnnotationAssertion(mito:isMentionedBy goldbook:14726 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14726 "current"^^xsd:string)
Declaration(Class(goldbook:14727))
AnnotationAssertion(rdfs:label goldbook:14727 "guild")
AnnotationAssertion(dcterms:description goldbook:14727 "Group of functionally similar species whose members interact strongly with one another but weakly with the remainder of the community.")
AnnotationAssertion(mito:isMentionedBy goldbook:14727 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14727 "current"^^xsd:string)
Declaration(Class(goldbook:14728))
AnnotationAssertion(rdfs:label goldbook:14728 "habitat")
AnnotationAssertion(dcterms:description goldbook:14728 "Spatial area (geographical area) where a particular species population lives, large enough to comprise a breeding population. Note: A microhabitat or microenvironment is the immediate surroundings and other physical factors of an individual plant or animal within its habitat. Physical conditions that surround a species, or species population, or assemblage of species, or community.")
AnnotationAssertion(rdfs:seeAlso goldbook:14728 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14728 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14728 "current"^^xsd:string)
Declaration(Class(goldbook:14729))
AnnotationAssertion(rdfs:label goldbook:14729 "hardness")
AnnotationAssertion(dcterms:description goldbook:14729 "Concentration of all metallic cations, except those of the alkali metals, present in water.")
AnnotationAssertion(rdfs:comment goldbook:14729 "In general, the concentration of calcium and magnesium ions in water, frequently expressed as \\(\\pu{mg L-1}\\) calcium carbonate or equivalent, is used as a measure of hardness."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14729 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14729 "current"^^xsd:string)
Declaration(Class(goldbook:14730))
AnnotationAssertion(rdfs:label goldbook:14730 "hard water")
AnnotationAssertion(dcterms:description goldbook:14730 "Water that contains mineral salts of divalent cations, commonly calcium and magnesium and sometimes iron(II) (ferrous) ions, principally as hydrogencarbonates, chlorides, and sulfates.")
AnnotationAssertion(rdfs:comment goldbook:14730 "Hardness caused by calcium hydrogencarbonate is known as temporary, because boiling converts the hydrogencarbonate to calcium carbonate (\\(\\ce{CaCO3}\\)), which has a very low solubility; hardness from the other salts is called permanent."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14730 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14730 "current"^^xsd:string)
Declaration(Class(goldbook:14731))
AnnotationAssertion(rdfs:label goldbook:14731 "Hardy–Weinberg equilibrium")
AnnotationAssertion(dcterms:description goldbook:14731 "State of a population if the frequencies of different alleles of all genes in the genome remain constant between generations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14731 "genetic equilibrium")
AnnotationAssertion(rdfs:comment goldbook:14731 "The Hardy–Weinberg equilibrium requires the following conditions: (1) the population is large (\"infinite\"), (2) mating is random, (3) there is no selection, (4) the net mutation rate is zero, and (5) there is no migration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14731 "The Hardy–Weinberg equilibrium is a very rare situation in natural populations. Deviation from the Hardy–Weinberg equilibrium is the basis for microevolution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14731 goldbook:14853)
AnnotationAssertion(rdfs:seeAlso goldbook:14731 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14731 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14731 "current"^^xsd:string)
Declaration(Class(goldbook:14732))
AnnotationAssertion(rdfs:label goldbook:14732 "harm")
AnnotationAssertion(dcterms:description goldbook:14732 "Adverse effect to an ecosystem, community, population, species, individual organism, organ, tissue, or cell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14732 "damage")
AnnotationAssertion(rdfs:seeAlso goldbook:14732 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14732 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14732 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14732 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14732 "current"^^xsd:string)
Declaration(Class(goldbook:14733))
AnnotationAssertion(rdfs:label goldbook:14733 "hazard assessment")
AnnotationAssertion(dcterms:description goldbook:14733 "Determination of factors controlling the likely effects of a hazard such as the dose–effect and dose–response relationships, variations in target susceptibility, bioaccumulation potential, persistence, and mechanism of toxicity.")
AnnotationAssertion(rdfs:seeAlso goldbook:14733 goldbook:14470)
AnnotationAssertion(rdfs:seeAlso goldbook:14733 goldbook:14600)
AnnotationAssertion(rdfs:seeAlso goldbook:14733 goldbook:14604)
AnnotationAssertion(rdfs:seeAlso goldbook:14733 goldbook:15085)
AnnotationAssertion(mito:isMentionedBy goldbook:14733 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14733 "current"^^xsd:string)
Declaration(Class(goldbook:14734))
AnnotationAssertion(rdfs:label goldbook:14734 "hazard evaluation")
AnnotationAssertion(dcterms:description goldbook:14734 "Identification and assessment of the potential adverse effects that could result from manufacture, use, and disposal of a material in a specified quantity and manner.")
AnnotationAssertion(mito:isMentionedBy goldbook:14734 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14734 "current"^^xsd:string)
Declaration(Class(goldbook:14735))
AnnotationAssertion(rdfs:label goldbook:14735 "hazard identification")
AnnotationAssertion(dcterms:description goldbook:14735 "Determination of substances of concern, their adverse effects, target populations, and conditions of exposure, taking into account toxicity data and knowledge of effects on human health, other organisms, and their environment.")
AnnotationAssertion(rdfs:seeAlso goldbook:14735 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14735 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14735 "current"^^xsd:string)
Declaration(Class(goldbook:14736))
AnnotationAssertion(rdfs:label goldbook:14736 "hazard index")
AnnotationAssertion(dcterms:description goldbook:14736 "Sum of the hazard quotients for substances that affect the same target organ or organ system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14736 "HI")
AnnotationAssertion(rdfs:comment goldbook:14736 "Ideally, hazard quotients should be combined for pollutants that cause adverse effects by the same mechanism. Aggregate exposures below an HI of \\(\\pu{1.0}\\) are unlikely to result in adverse health effects over a lifetime of exposure. An HI greater than \\(\\pu{1.0}\\) does not necessarily suggest a likelihood of adverse effects. The HI cannot be translated to a probability that adverse effects will occur, and is not likely to be proportional to risk."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14736 goldbook:14737)
AnnotationAssertion(mito:isMentionedBy goldbook:14736 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14736 "current"^^xsd:string)
Declaration(Class(goldbook:14737))
AnnotationAssertion(rdfs:label goldbook:14737 "hazard quotient")
AnnotationAssertion(dcterms:description goldbook:14737 "Ratio of toxicant exposure (estimated or measured) to a reference value regarded as corresponding to a threshold of toxicity; often this is determined as the predicted environmental concentration (PEC) divided by the predicted no-effect concentration (PNEC).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14737 "HQ")
AnnotationAssertion(rdfs:comment goldbook:14737 "If the hazard quotient exceeds unity, the toxicant may produce an adverse effect, but normally this will require an HQ of several times unity; an HQ of less than one indicates that no adverse effects are likely over a lifetime of exposure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14737 goldbook:14944)
AnnotationAssertion(rdfs:seeAlso goldbook:14737 goldbook:14945)
AnnotationAssertion(mito:isMentionedBy goldbook:14737 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14737 "current"^^xsd:string)
Declaration(Class(goldbook:14738))
AnnotationAssertion(rdfs:label goldbook:14738 "hazardous concentration")
AnnotationAssertion(dcterms:description goldbook:14738 "Concentration of a substance producing a defined effect on \\(\\pu{\\textit{p} \\%}\\) (usually \\(\\pu{5\\%}\\)) of species of concern, derived by means of a statistical extrapolation procedure.")
AnnotationAssertion(rdfs:seeAlso goldbook:14738 goldbook:15052)
AnnotationAssertion(mito:isMentionedBy goldbook:14738 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14738 "current"^^xsd:string)
Declaration(Class(goldbook:14739))
AnnotationAssertion(rdfs:label goldbook:14739 "heavy metal")
AnnotationAssertion(dcterms:description goldbook:14739 "Term used commonly but erroneously when referring to metal toxicity.")
AnnotationAssertion(rdfs:comment goldbook:14739 "The term is deprecated as it has no generally agreed meaning and sometimes is even applied to nonmetals. It is a source of confusion to be avoided. The term \"metal\" is often adequate."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14739 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14739 "current"^^xsd:string)
Declaration(Class(goldbook:14740))
AnnotationAssertion(rdfs:label goldbook:14740 "heterotherm")
AnnotationAssertion(dcterms:description goldbook:14740 "Animal that partially regulates body temperature, sometimes maintaining its body temperature at a certain level, e.g., when active, but at other times allowing it to fluctuate with the environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14740 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14740 "current"^^xsd:string)
Declaration(Class(goldbook:14741))
AnnotationAssertion(rdfs:label goldbook:14741 "heterotroph")
AnnotationAssertion(dcterms:description goldbook:14741 "Organism obtaining organic food by eating other organisms or their excreta.")
AnnotationAssertion(rdfs:comment goldbook:14741 "Animals, fungi, and most bacteria are heterotrophs."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14741 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14741 "current"^^xsd:string)
Declaration(Class(goldbook:14742))
AnnotationAssertion(rdfs:label goldbook:14742 "heterotrophic succession")
AnnotationAssertion(dcterms:description goldbook:14742 "Temporal sequential appearance of different heterotrophic species at a location, most often decomposer organisms.")
AnnotationAssertion(rdfs:seeAlso goldbook:14742 goldbook:15077)
AnnotationAssertion(mito:isMentionedBy goldbook:14742 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14742 "current"^^xsd:string)
Declaration(Class(goldbook:14743))
AnnotationAssertion(rdfs:label goldbook:14743 "heterozygote advantage")
AnnotationAssertion(dcterms:description goldbook:14743 "Greater Darwinian fitness (reproductive output) from heterozygous than from homozygous individuals of a species. This tends to preserve variation in the population gene pool.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14743 "heterosis")
AnnotationAssertion(rdfs:seeAlso goldbook:14743 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14743 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14743 "current"^^xsd:string)
Declaration(Class(goldbook:14744))
AnnotationAssertion(rdfs:label goldbook:14744 "homeostasis")
AnnotationAssertion(dcterms:description goldbook:14744 "Totality of processes occurring in an open system or a closed system, especially a living organism, enabling it to regulate its internal environment to maintain stable, constant conditions or the outcome of these processes.")
AnnotationAssertion(mito:isMentionedBy goldbook:14744 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14744 "current"^^xsd:string)
Declaration(Class(goldbook:14745))
AnnotationAssertion(rdfs:label goldbook:14745 "hormesis")
AnnotationAssertion(dcterms:description goldbook:14745 "Unexpected and unexplained but favorable biological response to low-level exposure to a substance or physical agent generally considered to be harmful.")
AnnotationAssertion(mito:isMentionedBy goldbook:14745 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14745 "current"^^xsd:string)
Declaration(Class(goldbook:14746))
AnnotationAssertion(rdfs:label goldbook:14746 "humic substances")
AnnotationAssertion(dcterms:description goldbook:14746 "Nonvolatile organic anionic polyelectrolytes, of biological origin, in the molecular mass range \\(\\pu{500\\!{-}\\! 5000}\\), which have complex structures and are variable in composition.")
AnnotationAssertion(rdfs:comment goldbook:14746 "Humic substances occur naturally as deposits on sediment and soil particles and constitute \\(\\pu{30\\!{-}\\! 50 \\%}\\) of the dissolved organic carbon (DOC) in natural waters. Humic substances are classified according to solubility and may contain humic acid, fulvic acid, and humin."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14746 goldbook:14595)
AnnotationAssertion(rdfs:seeAlso goldbook:14746 goldbook:14703)
AnnotationAssertion(rdfs:seeAlso goldbook:14746 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14746 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14746 "current"^^xsd:string)
Declaration(Class(goldbook:14747))
AnnotationAssertion(rdfs:label goldbook:14747 "Hutchinsonian niche")
AnnotationAssertion(dcterms:description goldbook:14747 "Intersection of ranges of tolerances for sets of resources utilized by organisms, represented mathematically by a multidimensional hypervolume whose dimensions correspond to environmental variables. Any species is considered unimodally distributed, i.e., confined to a habitat in the niche.")
AnnotationAssertion(rdfs:comment goldbook:14747 "This niche concept is quantifiable and therefore particularly useful to ecologists. Hutchinson’s niche is the most accepted concept of the niche in use today. In practice, it is impossible to identify and quantify all the resources utilized by an organism. Thus, typically the limiting factors receive most attention."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14747 "Two aspects of the niche can be visualized: A realized niche for a species is the sum of niche dimensions unique to that particular species. A fundamental niche is the total sum of the species niche dimensions including parts shared with other species and parts unshared."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14747 goldbook:14706)
AnnotationAssertion(rdfs:seeAlso goldbook:14747 goldbook:14728)
AnnotationAssertion(rdfs:seeAlso goldbook:14747 goldbook:14877)
AnnotationAssertion(rdfs:seeAlso goldbook:14747 goldbook:14973)
AnnotationAssertion(mito:isMentionedBy goldbook:14747 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14747 "current"^^xsd:string)
Declaration(Class(goldbook:14748))
AnnotationAssertion(rdfs:label goldbook:14748 "hybrid")
AnnotationAssertion(dcterms:description goldbook:14748 "Result of interbreeding between two animals or plants of different taxa.Note: Hybrids between different species within the same genus are sometimes known as interspecific hybrids or crosses. Hybrids between different subspecies within a species are known as intra-specific hybrids. Hybrids between different genera are sometimes known as intergeneric hybrids. Cross-breed between populations, breeds, or cultivars within a single species.Note: Hybridization is often used in plant and animal breeding to obtain desirable characteristics not found or inconsistently present in the parent individuals or populations.")
AnnotationAssertion(rdfs:seeAlso goldbook:14748 goldbook:14716)
AnnotationAssertion(rdfs:seeAlso goldbook:14748 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14748 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14748 "current"^^xsd:string)
Declaration(Class(goldbook:14749))
AnnotationAssertion(rdfs:label goldbook:14749 "hypoxemia")
AnnotationAssertion(dcterms:description goldbook:14749 "Deficient oxygenation of the blood.")
AnnotationAssertion(mito:isMentionedBy goldbook:14749 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14749 "current"^^xsd:string)
Declaration(Class(goldbook:14750))
AnnotationAssertion(rdfs:label goldbook:14750 "hypoxic")
AnnotationAssertion(dcterms:description goldbook:14750 "Dioxygen-deficient")
AnnotationAssertion(mito:isMentionedBy goldbook:14750 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14750 "current"^^xsd:string)
Declaration(Class(goldbook:14751))
AnnotationAssertion(rdfs:label goldbook:14751 "incipient LC<sub>50</sub>")
AnnotationAssertion(dcterms:description goldbook:14751 "Concentration of a chemical which is lethal to \\(\\pu{50\\%}\\) of the test organisms as a result of exposure for periods long enough for acute lethal action to cease; in other words, the concentration below which \\(\\pu{50\\%}\\) of individuals will have a normal lifespan despite the previous exposure to a toxicant.")
AnnotationAssertion(mito:isMentionedBy goldbook:14751 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14751 "current"^^xsd:string)
Declaration(Class(goldbook:14752))
AnnotationAssertion(rdfs:label goldbook:14752 "incremental unit risk estimate")
AnnotationAssertion(dcterms:description goldbook:14752 "For an air pollutant, the additional lifetime cancer risk occurring in a hypothetical population in which all individuals are exposed continuously from birth throughout their lifetimes to a concentration of \\(\\pu{1 \\upmu g m-3}\\) of the pollutant in the air they breathe.")
AnnotationAssertion(rdfs:seeAlso goldbook:14752 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14752 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14752 "current"^^xsd:string)
Declaration(Class(goldbook:14753))
AnnotationAssertion(rdfs:label goldbook:14753 "independent joint action")
AnnotationAssertion(dcterms:description goldbook:14753 "Production of an effect by each toxicant in a given exposure that is independent of the others and occurs by a different mode of action.")
AnnotationAssertion(mito:isMentionedBy goldbook:14753 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14753 "current"^^xsd:string)
Declaration(Class(goldbook:14754))
AnnotationAssertion(rdfs:label goldbook:14754 "index of biological integrity")
AnnotationAssertion(dcterms:description goldbook:14754 "Composite index combining 12 qualities of fish communities of warm-water, low-gradient streams to determine the level of stream degradation.")
AnnotationAssertion(rdfs:comment goldbook:14754 "This index has been modified and widely used in the United States."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14754 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14754 "current"^^xsd:string)
Declaration(Class(goldbook:14755))
AnnotationAssertion(rdfs:label goldbook:14755 "indicator species")
AnnotationAssertion(dcterms:description goldbook:14755 "Species whose presence shows the occurrence of defined environmental conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14755 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14755 "current"^^xsd:string)
Declaration(Class(goldbook:14756))
AnnotationAssertion(rdfs:label goldbook:14756 "indigenous")
AnnotationAssertion(dcterms:description goldbook:14756 "Native to a given region or ecosystem.")
AnnotationAssertion(rdfs:comment goldbook:14756 "The term is applied to a native species to distinguish it from species introduced as a result of human activity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14756 "\"Indigenous\" is not synonymous with \"endemic\". In ecology, endemic means exclusively native to the biota of a specific place, whereas an indigenous species may occur in two or more different habitats."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14756 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14756 goldbook:14632)
AnnotationAssertion(rdfs:seeAlso goldbook:14756 goldbook:14728)
AnnotationAssertion(mito:isMentionedBy goldbook:14756 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14756 "current"^^xsd:string)
Declaration(Class(goldbook:14757))
AnnotationAssertion(rdfs:label goldbook:14757 "indirect ecological effect")
AnnotationAssertion(dcterms:description goldbook:14757 "Effect resulting from imposed biotic or abiotic factors which alter ecosystem properties that in turn favor or disfavor an ecological component of importance (e.g., a species) and thus indirectly lead to improved or reduced fitness of that species. Result of imposed biotic or abiotic factors allowing indigenous or new species to dominate, thereby affecting ecosystem composition.")
AnnotationAssertion(rdfs:seeAlso goldbook:14757 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14757 goldbook:14756)
AnnotationAssertion(mito:isMentionedBy goldbook:14757 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14757 "current"^^xsd:string)
Declaration(Class(goldbook:14758))
AnnotationAssertion(rdfs:label goldbook:14758 "indirect photolysis")
AnnotationAssertion(dcterms:description goldbook:14758 "Degradation of a contaminant through interaction with other molecules in solution that have absorbed light energy. This can occur through energy transfer or by chemical reaction with short-lived reactive species.")
AnnotationAssertion(rdfs:comment goldbook:14758 "Dissolved humic and fulvic acids are good examples of photoactive compounds that can increase the degradation of contaminants through indirect photolysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14758 goldbook:14549)
AnnotationAssertion(rdfs:seeAlso goldbook:14758 goldbook:14703)
AnnotationAssertion(mito:isMentionedBy goldbook:14758 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14758 "current"^^xsd:string)
Declaration(Class(goldbook:14759))
AnnotationAssertion(rdfs:label goldbook:14759 "indirect toxicity")
AnnotationAssertion(dcterms:description goldbook:14759 "Adverse effects that result from agent(s) acting on and producing changes in the chemical, physical, and (or) biological environment external to the organisms under study (e.g., decrease in food for predatory species due to direct toxicity from a chemical to prey may produce adverse effects in the predator species due to starvation rather than inducing any direct chemical toxicity in predator organisms).")
AnnotationAssertion(mito:isMentionedBy goldbook:14759 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14759 "current"^^xsd:string)
Declaration(Class(goldbook:14760))
AnnotationAssertion(rdfs:label goldbook:14760 "individual")
AnnotationAssertion(dcterms:description goldbook:14760 "One whole organism.")
AnnotationAssertion(rdfs:comment goldbook:14760 "Individuals have size, shape, and health or condition. They grow, reproduce, and die over time."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14760 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14760 "current"^^xsd:string)
Declaration(Class(goldbook:14761))
AnnotationAssertion(rdfs:label goldbook:14761 "individual effective dose")
AnnotationAssertion(dcterms:description goldbook:14761 "Concept forming the basis for most dose–response models, which holds that there exists a smallest dose needed to kill any particular individual. The IED is a characteristic of an individual.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14761 "IED")
AnnotationAssertion(rdfs:seeAlso goldbook:14761 goldbook:14604)
AnnotationAssertion(mito:isMentionedBy goldbook:14761 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14761 "current"^^xsd:string)
Declaration(Class(goldbook:14762))
AnnotationAssertion(rdfs:label goldbook:14762 "industrial ecology")
AnnotationAssertion(dcterms:description goldbook:14762 "Study of the flows of materials and energy in the industrial environment and the effects of these flows on natural systems.")
AnnotationAssertion(mito:isMentionedBy goldbook:14762 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14762 "current"^^xsd:string)
Declaration(Class(goldbook:14763))
AnnotationAssertion(rdfs:label goldbook:14763 "industrial melanism")
AnnotationAssertion(dcterms:description goldbook:14763 "Gradual increase to predominance of melanic forms in populations from industrialized regions.")
AnnotationAssertion(rdfs:seeAlso goldbook:14763 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14763 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14763 "current"^^xsd:string)
Declaration(Class(goldbook:14764))
AnnotationAssertion(rdfs:label goldbook:14764 "inertia")
AnnotationAssertion(dcterms:description goldbook:14764 "Community’s ability to resist change.")
AnnotationAssertion(mito:isMentionedBy goldbook:14764 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14764 "current"^^xsd:string)
Declaration(Class(goldbook:14765))
AnnotationAssertion(rdfs:label goldbook:14765 "infauna")
AnnotationAssertion(dcterms:description goldbook:14765 "Animals living in the sediment of aquatic systems but not on the surface.")
AnnotationAssertion(rdfs:seeAlso goldbook:14765 goldbook:14653)
AnnotationAssertion(mito:isMentionedBy goldbook:14765 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14765 "current"^^xsd:string)
Declaration(Class(goldbook:14766))
AnnotationAssertion(rdfs:label goldbook:14766 "initiating event")
AnnotationAssertion(dcterms:description goldbook:14766 "Specific action that results in a risk being incurred.")
AnnotationAssertion(mito:isMentionedBy goldbook:14766 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14766 "current"^^xsd:string)
Declaration(Class(goldbook:14767))
AnnotationAssertion(rdfs:label goldbook:14767 "integrated risk information system")
AnnotationAssertion(dcterms:description goldbook:14767 "USEPA database containing reference doses, slope factors, and drinking-water health advisories (one-day, ten-day, longer-term, and lifetime advisories), and associated information.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:14767 "IRIS")
AnnotationAssertion(mito:isMentionedBy goldbook:14767 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14767 "current"^^xsd:string)
Declaration(Class(goldbook:14768))
AnnotationAssertion(rdfs:label goldbook:14768 "interference competition")
AnnotationAssertion(dcterms:description goldbook:14768 "Interspecies competition in which one species interferes with another, as might occur with territoriality or aggressive behavior.")
AnnotationAssertion(mito:isMentionedBy goldbook:14768 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14768 "current"^^xsd:string)
Declaration(Class(goldbook:14769))
AnnotationAssertion(rdfs:label goldbook:14769 "interspecies competition")
AnnotationAssertion(dcterms:description goldbook:14769 "Interference with or inhibition of one species by another.")
AnnotationAssertion(mito:isMentionedBy goldbook:14769 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14769 "current"^^xsd:string)
Declaration(Class(goldbook:14770))
AnnotationAssertion(rdfs:label goldbook:14770 "interspecific competition")
AnnotationAssertion(dcterms:description goldbook:14770 "Competition by different species for the same (limited) resources.")
AnnotationAssertion(mito:isMentionedBy goldbook:14770 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14770 "current"^^xsd:string)
Declaration(Class(goldbook:14771))
AnnotationAssertion(rdfs:label goldbook:14771 "interspecific interaction")
AnnotationAssertion(dcterms:description goldbook:14771 "Relations between different species in a community.")
AnnotationAssertion(rdfs:seeAlso goldbook:14771 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14771 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14771 "current"^^xsd:string)
Declaration(Class(goldbook:14772))
AnnotationAssertion(rdfs:label goldbook:14772 "interstitial water")
AnnotationAssertion(dcterms:description goldbook:14772 "Water in sediment or soil that surrounds the solid particles. The amount of interstitial water is calculated and expressed as the percentage ratio of the mass of water in the sediment to the mass of the wet sediment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14772 "pore water")
AnnotationAssertion(rdfs:seeAlso goldbook:14772 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14772 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14772 "current"^^xsd:string)
Declaration(Class(goldbook:14773))
AnnotationAssertion(rdfs:label goldbook:14773 "intraspecific competition")
AnnotationAssertion(dcterms:description goldbook:14773 "Competition by individuals of the same species (population) for the same (limited) resources.")
AnnotationAssertion(mito:isMentionedBy goldbook:14773 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14773 "current"^^xsd:string)
Declaration(Class(goldbook:14774))
AnnotationAssertion(rdfs:label goldbook:14774 "intrinsic rate of growth")
AnnotationAssertion(dcterms:description goldbook:14774 "\\(r = ({\\rm{natality}} + {\\rm{immigration}}) - ({\\rm{mortality}} + {\\rm{emigration}})\\)")
AnnotationAssertion(rdfs:seeAlso goldbook:14774 goldbook:14725)
AnnotationAssertion(mito:isMentionedBy goldbook:14774 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14774 "current"^^xsd:string)
Declaration(Class(goldbook:14775))
AnnotationAssertion(rdfs:label goldbook:14775 "intrinsic rate of increase")
AnnotationAssertion(dcterms:description goldbook:14775 "Rate of increase in the size of a population growing under no constraints.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14775 "Malthusian rate of increase")
AnnotationAssertion(rdfs:seeAlso goldbook:14775 goldbook:14828)
AnnotationAssertion(rdfs:seeAlso goldbook:14775 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14775 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14775 "current"^^xsd:string)
Declaration(Class(goldbook:14776))
AnnotationAssertion(rdfs:label goldbook:14776 "isobole approach")
AnnotationAssertion(dcterms:description goldbook:14776 "Approach used to visualize or quantify joint action of chemical mixtures by plotting a graph (isobologram) of equally effective dose pairs (isoboles) for a single effect level. A particular effect level is selected, such as \\(\\pu{50\\%}\\) of the maximum, and doses of drugs \\(\\ce{A}\\) and \\(\\ce{B}\\) (each alone) that give this effect are plotted as axial points in a Cartesian plot. The straight line connecting \\(\\ce{A}\\) and \\(\\ce{B}\\) is the locus of points (dose pairs) that will produce this effect in a simply additive combination. This line of additivity allows a comparison with the actual dose pair that produces this effect level experimentally.")
AnnotationAssertion(mito:isMentionedBy goldbook:14776 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14776 "current"^^xsd:string)
Declaration(Class(goldbook:14777))
AnnotationAssertion(rdfs:label goldbook:14777 "isotopic discrimination")
AnnotationAssertion(dcterms:description goldbook:14777 "The differential behavior of isotopes occurring if the rate or extent of participation in some biological or chemical process depends significantly on the mass of the isotope. Also called the isotope effect.")
AnnotationAssertion(mito:isMentionedBy goldbook:14777 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14777 "current"^^xsd:string)
Declaration(Class(goldbook:14778))
AnnotationAssertion(rdfs:label goldbook:14778 "iteroparous species")
AnnotationAssertion(dcterms:description goldbook:14778 "Species that reproduces more than once.")
AnnotationAssertion(mito:isMentionedBy goldbook:14778 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14778 "current"^^xsd:string)
Declaration(Class(goldbook:14779))
AnnotationAssertion(rdfs:label goldbook:14779 "Kamofsky’s law")
AnnotationAssertion(dcterms:description goldbook:14779 "Any agent will be teratogenic if it is present at concentrations or intensities producing cell toxicity.")
AnnotationAssertion(mito:isMentionedBy goldbook:14779 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14779 "current"^^xsd:string)
Declaration(Class(goldbook:14780))
AnnotationAssertion(rdfs:label goldbook:14780 "keystone habitat")
AnnotationAssertion(dcterms:description goldbook:14780 "High-quality habitat patch essential to maintaining the vitality of the metapopulation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14780 goldbook:14728)
AnnotationAssertion(rdfs:seeAlso goldbook:14780 goldbook:14850)
AnnotationAssertion(mito:isMentionedBy goldbook:14780 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14780 "current"^^xsd:string)
Declaration(Class(goldbook:14781))
AnnotationAssertion(rdfs:label goldbook:14781 "keystone species")
AnnotationAssertion(dcterms:description goldbook:14781 "Species, usually a top predator, that influences the ecological community by its activity or role, not its numerical dominance.")
AnnotationAssertion(rdfs:seeAlso goldbook:14781 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14781 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14781 "current"^^xsd:string)
Declaration(Class(goldbook:14782))
AnnotationAssertion(rdfs:label goldbook:14782 "k-strategy")
AnnotationAssertion(dcterms:description goldbook:14782 "Equilibrium strategy for species involving effective interactions with each other in the community, allowing coexistence of many species. Equilibrium species are more effective competitors than opportunistic species.")
AnnotationAssertion(rdfs:seeAlso goldbook:14782 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14782 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14782 "current"^^xsd:string)
Declaration(Class(goldbook:14783))
AnnotationAssertion(rdfs:label goldbook:14783 "larva")
AnnotationAssertion(dcterms:description goldbook:14783 "Recently hatched insect, fish, or other organism that has different physical characteristics than those seen in the adult, requiring metamorphosis to reach the adult body structure.")
AnnotationAssertion(mito:isMentionedBy goldbook:14783 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14783 "current"^^xsd:string)
Declaration(Class(goldbook:14784))
AnnotationAssertion(rdfs:label goldbook:14784 "law of frequence")
AnnotationAssertion(dcterms:description goldbook:14784 "According to this 'law', there are comparatively many rare (low abundance) species, and possibly comparatively many common (high abundance) species, but relatively few in the middle (of medium abundance).")
AnnotationAssertion(rdfs:comment goldbook:14784 "Thus, if one collects data on species presence/absence in a set of quadrants, one tends to find a J-shaped pattern in the distribution of species frequencies."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14784 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14784 "current"^^xsd:string)
Declaration(Class(goldbook:14785))
AnnotationAssertion(rdfs:label goldbook:14785 "leach")
AnnotationAssertion(dcterms:description goldbook:14785 "With reference to a soluble chemical or mineral, drain away from soil, ash, or similar material by the action of percolating liquid, especially rainwater.")
AnnotationAssertion(rdfs:seeAlso goldbook:14785 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14785 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14785 "current"^^xsd:string)
Declaration(Class(goldbook:14786))
AnnotationAssertion(rdfs:label goldbook:14786 "leachate")
AnnotationAssertion(dcterms:description goldbook:14786 "Water or waste-water that has percolated through a column of soil or solid waste in the environment, carrying with it substances dissolved from the soil or waste.")
AnnotationAssertion(rdfs:seeAlso goldbook:14786 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14786 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14786 "current"^^xsd:string)
Declaration(Class(goldbook:14787))
AnnotationAssertion(rdfs:label goldbook:14787 "lentic")
AnnotationAssertion(dcterms:description goldbook:14787 "Related to standing water riparian-wetland areas such as lakes, ponds, seeps, bogs, and meadows.")
AnnotationAssertion(rdfs:seeAlso goldbook:14787 goldbook:14997)
AnnotationAssertion(mito:isMentionedBy goldbook:14787 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14787 "current"^^xsd:string)
Declaration(Class(goldbook:14788))
AnnotationAssertion(rdfs:label goldbook:14788 "lentic water")
AnnotationAssertion(dcterms:description goldbook:14788 "Nonflowing or still inland water; e.g., lakes, ponds.")
AnnotationAssertion(mito:isMentionedBy goldbook:14788 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14788 "current"^^xsd:string)
Declaration(Class(goldbook:14789))
AnnotationAssertion(rdfs:label goldbook:14789 "Leslie matrix")
AnnotationAssertion(dcterms:description goldbook:14789 "Square matrix used in population biology to predict population growth. The top row of the matrix is the fecundity for each age class of mothers, and a subdiagonal is constructed from the number of individuals surviving from age class \\(x\\) to \\(x + 1\\). Multiplied by the population vector of the number of female offspring in each age class \\(x\\) at time \\(t\\), it predicts the age distribution of the population at the next time step \\(t + 1\\), corresponding to the age class interval \\(x + 1\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:14789 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14789 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14789 "current"^^xsd:string)
Declaration(Class(goldbook:14790))
AnnotationAssertion(rdfs:label goldbook:14790 "lethal")
AnnotationAssertion(dcterms:description goldbook:14790 "Deadly; fatal; causing death.")
AnnotationAssertion(mito:isMentionedBy goldbook:14790 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14790 "current"^^xsd:string)
Declaration(Class(goldbook:14791))
AnnotationAssertion(rdfs:label goldbook:14791 "lethal body burden")
AnnotationAssertion(dcterms:description goldbook:14791 "Total body uptake of a substance that is associated with mortality in short-term exposures.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14791 "LBB")
AnnotationAssertion(mito:isMentionedBy goldbook:14791 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14791 "current"^^xsd:string)
Declaration(Class(goldbook:14792))
AnnotationAssertion(rdfs:label goldbook:14792 "lethal time")
AnnotationAssertion(dcterms:description goldbook:14792 "Time taken for a defined percentage, usually \\(\\pu{50\\%}\\), of a test population to die.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14792 "LT")
AnnotationAssertion(rdfs:comment goldbook:14792 "The median lethal time (MLT) for \\(\\pu{50\\%}\\) of the test population is referred to as the \\(\\pu{MLT_{50}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14792 goldbook:14625)
AnnotationAssertion(rdfs:seeAlso goldbook:14792 goldbook:14838)
AnnotationAssertion(rdfs:seeAlso goldbook:14792 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14792 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14792 "current"^^xsd:string)
Declaration(Class(goldbook:14793))
AnnotationAssertion(rdfs:label goldbook:14793 "lethality")
AnnotationAssertion(dcterms:description goldbook:14793 "Ability to cause death.")
AnnotationAssertion(mito:isMentionedBy goldbook:14793 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14793 "current"^^xsd:string)
Declaration(Class(goldbook:14794))
AnnotationAssertion(rdfs:label goldbook:14794 "Liebig's law of the minimum")
AnnotationAssertion(dcterms:description goldbook:14794 "Observation that a population’s size (number of individuals or biomass) is limited by some essential factor in the environment that is scarce relative to the amount of other essential factors, e.g., phosphorus-limited algal growth in a lake.")
AnnotationAssertion(rdfs:seeAlso goldbook:14794 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14794 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14794 "current"^^xsd:string)
Declaration(Class(goldbook:14795))
AnnotationAssertion(rdfs:label goldbook:14795 "life cycle")
AnnotationAssertion(dcterms:description goldbook:14795 "Series of stages, from a given point in one generation to the same point in next generation, e.g., egglarva-adult-egg (hyphenated when used as an adjective, e.g., life-cycle strategy).")
AnnotationAssertion(rdfs:seeAlso goldbook:14795 goldbook:14797)
AnnotationAssertion(rdfs:seeAlso goldbook:14795 goldbook:14796)
AnnotationAssertion(mito:isMentionedBy goldbook:14795 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14795 "current"^^xsd:string)
Declaration(Class(goldbook:14796))
AnnotationAssertion(rdfs:label goldbook:14796 "life-cycle study")
AnnotationAssertion(dcterms:description goldbook:14796 "Comprehensive study to determine the impact of a substance or mixture on the survival, growth, reproduction, development, or other important qualities at all stages of a species life cycle.")
AnnotationAssertion(mito:isMentionedBy goldbook:14796 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14796 "current"^^xsd:string)
Declaration(Class(goldbook:14797))
AnnotationAssertion(rdfs:label goldbook:14797 "life history")
AnnotationAssertion(dcterms:description goldbook:14797 "Description of life-cycle events through which an organism passes, with particular reference to those events that influence survival and reproduction.")
AnnotationAssertion(rdfs:seeAlso goldbook:14797 goldbook:14795)
AnnotationAssertion(mito:isMentionedBy goldbook:14797 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14797 "current"^^xsd:string)
Declaration(Class(goldbook:14798))
AnnotationAssertion(rdfs:label goldbook:14798 "life table")
AnnotationAssertion(dcterms:description goldbook:14798 "Statistical table that follows a hypothetical cohort of \\(\\pu{100000}\\) persons born at the same time as they progress through successive ages, with the cohort reduced from one age to the next according to a set of death rates by age until all persons eventually die.")
AnnotationAssertion(rdfs:comment goldbook:14798 "In ecology, fertility for each age class is normally included in the tables."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14798 "The life table is used mainly to indicate expectation of life at various ages. However, it also provides information on numbers of individuals who survive to various ages, median age at death, age-specific death rates, and the probability of dying at certain ages."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14798 goldbook:14430)
AnnotationAssertion(rdfs:seeAlso goldbook:14798 goldbook:14568)
AnnotationAssertion(rdfs:seeAlso goldbook:14798 goldbook:14610)
AnnotationAssertion(mito:isMentionedBy goldbook:14798 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14798 "current"^^xsd:string)
Declaration(Class(goldbook:14799))
AnnotationAssertion(rdfs:label goldbook:14799 "life-table response experiment")
AnnotationAssertion(dcterms:description goldbook:14799 "Retrospective comparison of two or more populations in which the response variable is a life table or a complete set of stage-specific vital rates.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14799 "LTRE")
AnnotationAssertion(rdfs:seeAlso goldbook:14799 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14799 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14799 "current"^^xsd:string)
Declaration(Class(goldbook:14800))
AnnotationAssertion(rdfs:label goldbook:14800 "limit value")
AnnotationAssertion(dcterms:description goldbook:14800 "Limit concentration at or below which Member States of the European Community must set their environmental quality standard and emission standard for a particular substance according to Community Directives.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14800 "LV")
AnnotationAssertion(rdfs:seeAlso goldbook:14800 goldbook:14631)
AnnotationAssertion(rdfs:seeAlso goldbook:14800 goldbook:14645)
AnnotationAssertion(mito:isMentionedBy goldbook:14800 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14800 "current"^^xsd:string)
Declaration(Class(goldbook:14801))
AnnotationAssertion(rdfs:label goldbook:14801 "limited life-span paradigm")
AnnotationAssertion(dcterms:description goldbook:14801 "Model based on the assumption that the maximum life span of an individual organism is an inherent, genetically defined property of that organism.")
AnnotationAssertion(mito:isMentionedBy goldbook:14801 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14801 "current"^^xsd:string)
Declaration(Class(goldbook:14802))
AnnotationAssertion(rdfs:label goldbook:14802 "limnocorrals")
AnnotationAssertion(dcterms:description goldbook:14802 "Artificial enclosures placed in the pelagic region of ponds, lakes, or marine environments. These systems vary in size from as little as \\(\\pu{2 L}\\) to over \\(\\pu{2.5E6 L}\\); however, most of these systems have a volume between \\(\\pu{1000 L}\\) and \\(\\pu{E4 L}\\).")
AnnotationAssertion(rdfs:comment goldbook:14802 "These systems may or may not be in contact with the profundal region. Fish are generally excluded from these test systems."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14802 goldbook:14903)
AnnotationAssertion(mito:isMentionedBy goldbook:14802 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14802 "current"^^xsd:string)
Declaration(Class(goldbook:14803))
AnnotationAssertion(rdfs:label goldbook:14803 "limnology")
AnnotationAssertion(dcterms:description goldbook:14803 "Study incorporating the study of all aspects of inland freshwater habitats including lakes, ponds, rivers, streams, swamps, wetlands, groundwaters, and reservoirs that make up inland water systems")
AnnotationAssertion(rdfs:seeAlso goldbook:14803 goldbook:14728)
AnnotationAssertion(mito:isMentionedBy goldbook:14803 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14803 "current"^^xsd:string)
Declaration(Class(goldbook:14804))
AnnotationAssertion(rdfs:label goldbook:14804 "linear free energy relationship")
AnnotationAssertion(dcterms:description goldbook:14804 "An empirical relationship in which numerical parameters are associated with small perturbations in a parent molecule and are subsequently correlated with the change in the Gibbs energy of a certain reaction of the parent molecule vs. the perturbed molecules.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14804 "LFER")
AnnotationAssertion(rdfs:comment goldbook:14804 "A classical example is the well-known Hammett equation, in which sigma (\\(\\upsigma\\)) values are constructed for specific substituents on a benzoic acid parent molecule. The linear correlation is then between the (summed) sigma values for a set of compounds and the \\(\\pu{p}K_{\\rm{a}}\\) (free energy of acid dissociation) of those compounds."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14804 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14804 "current"^^xsd:string)
Declaration(Class(goldbook:14805))
AnnotationAssertion(rdfs:label goldbook:14805 "Litchfield method")
AnnotationAssertion(dcterms:description goldbook:14805 "Simple, semigraphical method for analyzing survival time data and estimating \\(\\pu{LT_{50}}\\) values.")
AnnotationAssertion(mito:isMentionedBy goldbook:14805 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14805 "current"^^xsd:string)
Declaration(Class(goldbook:14806))
AnnotationAssertion(rdfs:label goldbook:14806 "Litchfield–Wilcoxon method")
AnnotationAssertion(dcterms:description goldbook:14806 "Semigraphical method for estimating a median lethal concentration (\\(\\pu{LC_{50}}\\)), median lethal dose (\\(\\pu{LD_{50}}\\)), or median effective concentration (\\(\\pu{EC_{50}}\\)). Although very easy to perform, it is the most subjective method for such estimations because it involves fitting a line to data by eye.")
AnnotationAssertion(mito:isMentionedBy goldbook:14806 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14806 "current"^^xsd:string)
Declaration(Class(goldbook:14807))
AnnotationAssertion(rdfs:label goldbook:14807 "littoral")
AnnotationAssertion(dcterms:description goldbook:14807 "Belonging to the shore of a lake, river, pond, or especially the sea. Intertidal zone, sometimes referring specifically to the shallow well-lit region along the shore.")
AnnotationAssertion(mito:isMentionedBy goldbook:14807 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14807 "current"^^xsd:string)
Declaration(Class(goldbook:14808))
AnnotationAssertion(rdfs:label goldbook:14808 "littoral enclosures")
AnnotationAssertion(dcterms:description goldbook:14808 "Isolated shore regions of freshwater ponds separated from the main body of water by plastic dividers used for ecotoxicological testing. These test systems generally have a volume of \\(\\pu{1000 L}\\) to \\(\\pu{5E4 L}\\) and a maximum depth of \\(\\pu{2 m}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:14808 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14808 "current"^^xsd:string)
Declaration(Class(goldbook:14809))
AnnotationAssertion(rdfs:label goldbook:14809 "loading")
AnnotationAssertion(dcterms:description goldbook:14809 "Ratio of animal biomass to the volume of test solution in an exposure chamber.")
AnnotationAssertion(mito:isMentionedBy goldbook:14809 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14809 "current"^^xsd:string)
Declaration(Class(goldbook:14810))
AnnotationAssertion(rdfs:label goldbook:14810 "logistic curve")
AnnotationAssertion(dcterms:description goldbook:14810 "Function, often applied to growth curves, fitting the general equation \\[y = k/(1 + e^{a+bt})\\] where \\(t\\) represents time, \\(y\\) the body weight or population size, \\(k\\) the rate of growth, and \\(a\\) and \\(b \\gt 0\\) are constants. In the logistic equation the percentage rate of increase decreases linearly as size increases. The resulting curve continually rises, slowly at first, more rapidly in the middle phase, and slowly again near the end of growth.")
AnnotationAssertion(rdfs:seeAlso goldbook:14810 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14810 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14810 "current"^^xsd:string)
Declaration(Class(goldbook:14811))
AnnotationAssertion(rdfs:label goldbook:14811 "logistic growth")
AnnotationAssertion(dcterms:description goldbook:14811 "Growth of a population under environmental constraints that set a maximum population size, giving an S-shaped curve.")
AnnotationAssertion(rdfs:seeAlso goldbook:14811 goldbook:14514)
AnnotationAssertion(rdfs:seeAlso goldbook:14811 goldbook:14725)
AnnotationAssertion(rdfs:seeAlso goldbook:14811 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14811 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14811 "current"^^xsd:string)
Declaration(Class(goldbook:14812))
AnnotationAssertion(rdfs:label goldbook:14812 "logit transformation")
AnnotationAssertion(dcterms:description goldbook:14812 "In competitive binding assays, the logit-log dose relationship, in which the response is defined by \\[R = {\\rm{logit}}\\,(y) = \\ln [y/(1 - y)]\\] where \\(y = b/b_{0}\\), \\(b\\) is fraction of tracer bound and \\(b_{0}\\) is the value of \\(b\\) with no unlabelled ligand in the system.")
AnnotationAssertion(rdfs:comment goldbook:14812 "Logit-transformed assay data frequently yield straight-line dose-response data, amenable to statistical analysis. More generally in toxicology, the transformation is applied to dose-response data where \\(b_{0}\\) denotes the maximum response in the absence of a toxic substance."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14812 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14812 "current"^^xsd:string)
Declaration(Class(goldbook:14813))
AnnotationAssertion(rdfs:label goldbook:14813 "log-normal transformation")
AnnotationAssertion(dcterms:description goldbook:14813 "Transformation of data with a logarithmic function that results in a normal distribution.")
AnnotationAssertion(mito:isMentionedBy goldbook:14813 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14813 "current"^^xsd:string)
Declaration(Class(goldbook:14814))
AnnotationAssertion(rdfs:label goldbook:14814 "Lorax incongruity")
AnnotationAssertion(dcterms:description goldbook:14814 "Delusion of selfless motivation in environmental stewardship or advocacy.")
AnnotationAssertion(rdfs:comment goldbook:14814 "The Lorax is a character in a popular children’s book by Dr. Seuss who \"speaks for the trees, for the trees have no tongues\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14814 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14814 "current"^^xsd:string)
Declaration(Class(goldbook:14815))
AnnotationAssertion(rdfs:label goldbook:14815 "loss of life expectancy")
AnnotationAssertion(dcterms:description goldbook:14815 "Calculated estimate of loss in lifetime associated with a risk factor; it is estimated as the simple difference between life expectancy without the risk factor and life expectancy with the risk factor.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14815 "LLE")
AnnotationAssertion(mito:isMentionedBy goldbook:14815 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14815 "current"^^xsd:string)
Declaration(Class(goldbook:14816))
AnnotationAssertion(rdfs:label goldbook:14816 "lotic")
AnnotationAssertion(dcterms:description goldbook:14816 "Related to flowing continental waters, such as rivers and streams.")
AnnotationAssertion(mito:isMentionedBy goldbook:14816 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14816 "current"^^xsd:string)
Declaration(Class(goldbook:14817))
AnnotationAssertion(rdfs:label goldbook:14817 "lotic mesocosms")
AnnotationAssertion(dcterms:description goldbook:14817 "Streams of various sizes used to evaluate the effects of substances. Unlike lentic systems, no standardized design has been developed for flowing-water test systems.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14817 "lotic microcosms")
AnnotationAssertion(rdfs:seeAlso goldbook:14817 goldbook:14787)
AnnotationAssertion(mito:isMentionedBy goldbook:14817 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14817 "current"^^xsd:string)
Declaration(Class(goldbook:14818))
AnnotationAssertion(rdfs:label goldbook:14818 "lotic water")
AnnotationAssertion(dcterms:description goldbook:14818 "Flowing continental waters, such as rivers and streams.")
AnnotationAssertion(mito:isMentionedBy goldbook:14818 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14818 "current"^^xsd:string)
Declaration(Class(goldbook:14819))
AnnotationAssertion(rdfs:label goldbook:14819 "lowest effective dose")
AnnotationAssertion(dcterms:description goldbook:14819 "Lowest dose of a chemical inducing a specified effect in a specified fraction of exposed individuals.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14819 "LED")
AnnotationAssertion(mito:isMentionedBy goldbook:14819 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14819 "current"^^xsd:string)
Declaration(Class(goldbook:14820))
AnnotationAssertion(rdfs:label goldbook:14820 "lowest-observed-effect concentration")
AnnotationAssertion(dcterms:description goldbook:14820 "Lowest concentration of a material used in an aquatic toxicity test that has a statistically significant adverse effect on the exposed population of test organisms compared with controls.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14820 "LOEC")
AnnotationAssertion(rdfs:comment goldbook:14820 "When derived from a life cycle or partial life cycle test, it is numerically the same as the upper limit of the maximum acceptable toxicant concentration (MATC). Also called lowest-observed-adverse-effect level (LOAEL)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14820 goldbook:14832)
AnnotationAssertion(rdfs:seeAlso goldbook:14820 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14820 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14820 "current"^^xsd:string)
Declaration(Class(goldbook:14821))
AnnotationAssertion(rdfs:label goldbook:14821 "l<i>x</i> life table or schedule")
AnnotationAssertion(dcterms:description goldbook:14821 "Life table that summarizes mortality data for populations.")
AnnotationAssertion(rdfs:comment goldbook:14821 "\"\\({\\rm{l}}x\\)\" is the number of individuals in a cohort alive at age or stage class, \\(x\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14821 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14821 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14821 "current"^^xsd:string)
Declaration(Class(goldbook:14822))
AnnotationAssertion(rdfs:label goldbook:14822 "l<i>x</i>m<i>x</i> life table")
AnnotationAssertion(dcterms:description goldbook:14822 "Life table that summarizes both mortality and natality data for populations.")
AnnotationAssertion(rdfs:comment goldbook:14822 "\"\\({\\rm{l}}x\\)\" is the actual number or the proportion (as a decimal or percentage) of survivors at the beginning of age interval \\(x\\). Since several samples are often averaged together, the \\({\\rm{l}}x\\) values may not always be whole numbers. \"\\({\\rm{m}}x\\)\" is the number of female births to each age group of \"mothers\"; the number of eggs or young which are female (in a species with a 1:1 sex ratio, this is \\({\\rm{m}}x/2\\) where \\({\\rm{m}}x\\) is the total eggs or young produced per female at age \\(x\\)). Since, for most organisms, one male can fertilize a number of females, the size of the population is more dependent on the number of females present, and the calculations are usually done using only females."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14822 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14822 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14822 "current"^^xsd:string)
Declaration(Class(goldbook:14823))
AnnotationAssertion(rdfs:label goldbook:14823 "MacArthur–Wilson model")
AnnotationAssertion(dcterms:description goldbook:14823 "Model of island colonization giving the mathematical relationship \\[S(t) = S_{\\rm{EQ}}(1 - e^{-Gt})\\] where \\(S(t)\\) is the number of species present at time \\(t\\), \\(S_{\\rm{EQ}}\\) is the equilibrium number of species for the island, and \\(G\\) is the rate constant for colonization of the island.")
AnnotationAssertion(mito:isMentionedBy goldbook:14823 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14823 "current"^^xsd:string)
Declaration(Class(goldbook:14824))
AnnotationAssertion(rdfs:label goldbook:14824 "macrocosm")
AnnotationAssertion(dcterms:description goldbook:14824 "Large multi-species test system.")
AnnotationAssertion(rdfs:seeAlso goldbook:14824 goldbook:14846)
AnnotationAssertion(rdfs:seeAlso goldbook:14824 goldbook:14852)
AnnotationAssertion(mito:isMentionedBy goldbook:14824 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14824 "current"^^xsd:string)
Declaration(Class(goldbook:14825))
AnnotationAssertion(rdfs:label goldbook:14825 "macronutrient")
AnnotationAssertion(dcterms:description goldbook:14825 "Imprecise term referring to a nutrient required for survival, or present in biological fluids or compartments at a level easily measured by existing analytical techniques.")
AnnotationAssertion(rdfs:seeAlso goldbook:14825 goldbook:14659)
AnnotationAssertion(mito:isMentionedBy goldbook:14825 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14825 "current"^^xsd:string)
Declaration(Class(goldbook:14826))
AnnotationAssertion(rdfs:label goldbook:14826 "macrophyte")
AnnotationAssertion(dcterms:description goldbook:14826 "Aquatic plant large enough to be seen easily with the naked eye (as distinct from phytoplankton and small algae).")
AnnotationAssertion(rdfs:comment goldbook:14826 "The term \"aquatic macrophyte\" has no taxonomic significance."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14826 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14826 "current"^^xsd:string)
Declaration(Class(goldbook:14827))
AnnotationAssertion(rdfs:label goldbook:14827 "male-mediated toxicity")
AnnotationAssertion(dcterms:description goldbook:14827 "Disease or birth defects produced by a father’s exposure to a physical or chemical agent.")
AnnotationAssertion(mito:isMentionedBy goldbook:14827 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14827 "current"^^xsd:string)
Declaration(Class(goldbook:14828))
AnnotationAssertion(rdfs:label goldbook:14828 "Malthusian theory")
AnnotationAssertion(dcterms:description goldbook:14828 "Model, developed by Thomas R. Malthus (1766–1834), implying that, unchecked by environmental or social constraints, human populations would double every 25 years, regardless of the initial population size. Thus, if \\(X_{i}\\) denotes the population size during time period \\(i\\) and \\(r\\) the population growth rate, the Malthusian population model gives the relationship \\[X(I + 1) = (1 + r)X_{i}\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:14828 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14828 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14828 "current"^^xsd:string)
Declaration(Class(goldbook:14829))
AnnotationAssertion(rdfs:label goldbook:14829 "mass balance equation")
AnnotationAssertion(dcterms:description goldbook:14829 "Equation that expresses the total mass of a chemical in terms of all the various forms and concentrations in different environmental compartments (including biota) in which it occurs.")
AnnotationAssertion(mito:isMentionedBy goldbook:14829 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14829 "current"^^xsd:string)
Declaration(Class(goldbook:14830))
AnnotationAssertion(rdfs:label goldbook:14830 "maturity index")
AnnotationAssertion(dcterms:description goldbook:14830 "Index for pollution based on the proportions of species in a soil nematode community that fall into various categories ranging from colonizers (\\(r\\mbox{-}\\rm{strategists}\\)) to persisters (\\(k\\mbox{-}\\rm{strategists}\\)).")
AnnotationAssertion(rdfs:seeAlso goldbook:14830 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14830 goldbook:14782)
AnnotationAssertion(rdfs:seeAlso goldbook:14830 goldbook:15005)
AnnotationAssertion(rdfs:seeAlso goldbook:14830 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14830 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14830 "current"^^xsd:string)
Declaration(Class(goldbook:14831))
AnnotationAssertion(rdfs:label goldbook:14831 "maulstick incongruity")
AnnotationAssertion(dcterms:description goldbook:14831 "Assignment of ecological or biological significance of a contaminant’s effect based primarily on statements of statistical significance but contrary to biological probability.")
AnnotationAssertion(mito:isMentionedBy goldbook:14831 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14831 "current"^^xsd:string)
Declaration(Class(goldbook:14832))
AnnotationAssertion(rdfs:label goldbook:14832 "maximum acceptable toxicant concentration")
AnnotationAssertion(dcterms:description goldbook:14832 "Geometric mean of the lowest exposure concentration that causes a statistically significant adverse effect (lowest-observed-effect concentration, LOEC) and the highest exposure concentration where no effect is observed (no-observed-effect concentration, NOEC) in a life-cycle (full chronic) or partial lifecycle (partial chronic) test.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14832 "MATC")
AnnotationAssertion(rdfs:comment goldbook:14832 "Calculation of an MATC requires quantitative life-cycle toxicity data on the effects of a material on survival, growth, and reproduction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14832 goldbook:14820)
AnnotationAssertion(rdfs:seeAlso goldbook:14832 goldbook:14885)
AnnotationAssertion(mito:isMentionedBy goldbook:14832 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14832 "current"^^xsd:string)
Declaration(Class(goldbook:14833))
AnnotationAssertion(rdfs:label goldbook:14833 "maximum likelihood estimation")
AnnotationAssertion(dcterms:description goldbook:14833 "Parametric method used to fit dose- or concentration-effect data to the log-normal, log-logistic, or other models.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14833 "MLE")
AnnotationAssertion(rdfs:comment goldbook:14833 "Probit and logit approaches are most often applied with MLE methods."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14833 goldbook:14953)
AnnotationAssertion(mito:isMentionedBy goldbook:14833 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14833 "current"^^xsd:string)
Declaration(Class(goldbook:14834))
AnnotationAssertion(rdfs:label goldbook:14834 "mean absorption time")
AnnotationAssertion(dcterms:description goldbook:14834 "Mean time required for absorption of a drug or contaminant calculated as the difference in mean residence time (MRT) of the material introduced by the (noninstantaneous) route of interest and the MRT for the same material injected intravenously.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14834 "MAT")
AnnotationAssertion(mito:isMentionedBy goldbook:14834 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14834 "current"^^xsd:string)
Declaration(Class(goldbook:14835))
AnnotationAssertion(rdfs:label goldbook:14835 "mean generation time")
AnnotationAssertion(dcterms:description goldbook:14835 "Average time interval required for a bacterial cell to divide or for the population to double under a defined set of conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:14835 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14835 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14835 "current"^^xsd:string)
Declaration(Class(goldbook:14836))
AnnotationAssertion(rdfs:label goldbook:14836 "measurement endpoint")
AnnotationAssertion(dcterms:description goldbook:14836 "Measurable response to a stressor (e.g., fledglings produced per nest each year) that is related to the valued qualities of the assessment endpoint (e.g., reproductive success of bald eagles).")
AnnotationAssertion(mito:isMentionedBy goldbook:14836 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14836 "current"^^xsd:string)
Declaration(Class(goldbook:14837))
AnnotationAssertion(rdfs:label goldbook:14837 "median effective time")
AnnotationAssertion(dcterms:description goldbook:14837 "For sublethal or ambiguously lethal effects, the median time until \\(\\pu{50\\%}\\) of the exposed individuals respond.")
AnnotationAssertion(mito:isMentionedBy goldbook:14837 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14837 "current"^^xsd:string)
Declaration(Class(goldbook:14838))
AnnotationAssertion(rdfs:label goldbook:14838 "median inhibitory time")
AnnotationAssertion(dcterms:description goldbook:14838 "Time required for a toxicant to inhibit a specified process in \\(\\pu{50\\%}\\) of a population under test conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14838 "inhibitory time (IT)")
AnnotationAssertion(rdfs:seeAlso goldbook:14838 goldbook:14625)
AnnotationAssertion(rdfs:seeAlso goldbook:14838 goldbook:14792)
AnnotationAssertion(rdfs:seeAlso goldbook:14838 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14838 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14838 "current"^^xsd:string)
Declaration(Class(goldbook:14839))
AnnotationAssertion(rdfs:label goldbook:14839 "median time to death")
AnnotationAssertion(dcterms:description goldbook:14839 "Median time resulting in death for \\(\\pu{50\\%}\\) of the exposed organisms.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14839 "MTTD")
AnnotationAssertion(mito:isMentionedBy goldbook:14839 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14839 "current"^^xsd:string)
Declaration(Class(goldbook:14840))
AnnotationAssertion(rdfs:label goldbook:14840 "median tolerance limit")
AnnotationAssertion(dcterms:description goldbook:14840 "Concentration of a substance in air, water, sediment, or soil at which \\(\\pu{50\\%}\\) of the test organisms survive after a specified time of exposure. The \\(\\pu{TL_{50}}\\) (equivalent to the \\(\\pu{TL_{m}}\\)) is usually expressed as a time-dependent value (e.g., \\(\\pu{24\\!\\mbox{-}h}\\) or \\(\\pu{96\\!\\mbox{-}h}\\) \\(\\pu{TL_{50}}\\); the estimated concentration at which \\(\\pu{50\\%}\\) of test organisms survive after \\(\\pu{24 h}\\) or \\(\\pu{96 h}\\) of exposure).")
AnnotationAssertion(rdfs:comment goldbook:14840 "Unlike lethal concentration and lethal dose, the term \"tolerance limit\" is applicable in designating the level of any measurable lethal condition (e.g., extremes in \\(\\rm{pH}\\), temperature, dissolved oxygen). \\(\\pu{TL_{m}}\\) and \\(\\pu{TL_{50}}\\) have been replaced by median lethal concentration (\\(\\pu{LC_{50}}\\)) and median effective concentration (\\(\\pu{EC_{50}}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14840 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14840 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14840 "current"^^xsd:string)
Declaration(Class(goldbook:14841))
AnnotationAssertion(rdfs:label goldbook:14841 "meiofauna")
AnnotationAssertion(dcterms:description goldbook:14841 "Small benthic invertebrates living in interstices of soil or sediment or in aquatic systems.")
AnnotationAssertion(rdfs:comment goldbook:14841 "The term loosely defines a group of organisms by their size, larger than microfauna but smaller than macrofauna. In practice, these are usually organisms that can pass through a \\(\\pu{1 mm}\\) mesh but will be retained by a \\(\\pu{45 \\upmu m}\\) mesh, but the exact dimensions vary from researcher to researcher. Whether an organism will pass through a \\(\\pu{1\\!\\mbox{-}mm}\\) mesh may depend upon whether it is alive or dead at the time of sorting."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14841 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14841 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14841 "current"^^xsd:string)
Declaration(Class(goldbook:14842))
AnnotationAssertion(rdfs:label goldbook:14842 "meiotic drive")
AnnotationAssertion(dcterms:description goldbook:14842 "Any process that causes some alleles to be over-represented in the gametes which are formed during meiosis.")
AnnotationAssertion(rdfs:comment goldbook:14842 "With normal Mendelian segregation at a genetic locus, on average half of an organism’s offspring inherit one of the alleles and the other half the other allele. This term refers to rare cases in which Mendel’s laws are broken, and one of the alleles is consistently found in more than half the offspring."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14842 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14842 "current"^^xsd:string)
Declaration(Class(goldbook:14843))
AnnotationAssertion(rdfs:label goldbook:14843 "melanic forms")
AnnotationAssertion(dcterms:description goldbook:14843 "Individuals or subspecies with increased dark pigmentation.")
AnnotationAssertion(mito:isMentionedBy goldbook:14843 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14843 "current"^^xsd:string)
Declaration(Class(goldbook:14844))
AnnotationAssertion(rdfs:label goldbook:14844 "melanism")
AnnotationAssertion(dcterms:description goldbook:14844 "Increased black or nearly black pigmentation of skin, feathers, or hair of an organism, resulting from (increased) synthesis of melanin.")
AnnotationAssertion(rdfs:seeAlso goldbook:14844 goldbook:14763)
AnnotationAssertion(mito:isMentionedBy goldbook:14844 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14844 "current"^^xsd:string)
Declaration(Class(goldbook:14845))
AnnotationAssertion(rdfs:label goldbook:14845 "Mendelism")
AnnotationAssertion(dcterms:description goldbook:14845 "Fundamental principles of inheritance (especially the laws of segregation and independent assortment and the existence of dominant and recessive characters), propounded originally by Gregor Mendel (1822–1884) and forming the basis for the science of classical genetics.")
AnnotationAssertion(mito:isMentionedBy goldbook:14845 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14845 "current"^^xsd:string)
Declaration(Class(goldbook:14846))
AnnotationAssertion(rdfs:label goldbook:14846 "mesocosm")
AnnotationAssertion(dcterms:description goldbook:14846 "Enclosed and essentially self-sufficient (but not necessarily isolated) experimental environment or ecosystem that is on a larger scale than a laboratory microcosm.")
AnnotationAssertion(rdfs:comment goldbook:14846 "A mesocosm is normally used outdoors or, in some manner, incorporated intimately with the ecosystem that it is designed to reflect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14846 goldbook:14619)
AnnotationAssertion(rdfs:seeAlso goldbook:14846 goldbook:14824)
AnnotationAssertion(rdfs:seeAlso goldbook:14846 goldbook:14852)
AnnotationAssertion(mito:isMentionedBy goldbook:14846 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14846 "current"^^xsd:string)
Declaration(Class(goldbook:14847))
AnnotationAssertion(rdfs:label goldbook:14847 "meta-analysis")
AnnotationAssertion(dcterms:description goldbook:14847 "Process of using statistical methods to combine the results of different studies. In the biomedical sciences, the systematic evaluation of a problem using information (commonly in the form of statistical tables and other data) from a number of independent studies.")
AnnotationAssertion(rdfs:comment goldbook:14847 "A common application is the pooling of results from a number of small randomized controlled trials, none in itself large enough to demonstrate statistically significant differences, but capable of doing so in aggregate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14847 "Meta-analysis has a qualitative component, i.e., application of predetermined quality criteria (e.g., completeness of data, absence of bias) and a quantitative component, i.e., integration of numerical information."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14847 "Meta-analysis includes overview and data pooling aspects, but implies more than either of these processes. Meta-analysis carries the risk of several biases reinforcing each other. Because of such problems inherent in the pooling of data from different studies, interpretation of the results of meta-analysis must be very cautious."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14847 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14847 "current"^^xsd:string)
Declaration(Class(goldbook:14848))
AnnotationAssertion(rdfs:label goldbook:14848 "metallothionein-like proteins")
AnnotationAssertion(dcterms:description goldbook:14848 "Poorly characterized, cysteine-rich metal-binding proteins or proteins not conforming precisely to the classic properties of metallothioneins.")
AnnotationAssertion(mito:isMentionedBy goldbook:14848 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14848 "current"^^xsd:string)
Declaration(Class(goldbook:14849))
AnnotationAssertion(rdfs:label goldbook:14849 "metameter")
AnnotationAssertion(dcterms:description goldbook:14849 "Measurement or a transformation of a measurement used in the analysis of biological tests, e.g., the probit metameter.")
AnnotationAssertion(mito:isMentionedBy goldbook:14849 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14849 "current"^^xsd:string)
Declaration(Class(goldbook:14850))
AnnotationAssertion(rdfs:label goldbook:14850 "metapopulation")
AnnotationAssertion(dcterms:description goldbook:14850 "Set of local populations which interact via dispersing individuals among local populations; though not all local populations in a metapopulation need interact directly with every other local population.")
AnnotationAssertion(rdfs:comment goldbook:14850 "A metapopulation is generally considered to consist of several distinct populations together with areas of suitable habitat which are currently unoccupied. Each population cycles in relative independence of the other populations and eventually goes extinct as a consequence of demographic stochasticity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14850 "Individuals may immigrate to a small metapopulation and rescue that population from extinction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14850 goldbook:14572)
AnnotationAssertion(rdfs:seeAlso goldbook:14850 goldbook:14728)
AnnotationAssertion(rdfs:seeAlso goldbook:14850 goldbook:14932)
AnnotationAssertion(rdfs:seeAlso goldbook:14850 goldbook:14992)
AnnotationAssertion(mito:isMentionedBy goldbook:14850 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14850 "current"^^xsd:string)
Declaration(Class(goldbook:14851))
AnnotationAssertion(rdfs:label goldbook:14851 "method of multiple working hypotheses")
AnnotationAssertion(dcterms:description goldbook:14851 "Method proposed to reduce precipitate explanation by considering all plausible hypotheses simultaneously in testing so that equal amounts of effort and attention are provided to each.")
AnnotationAssertion(mito:isMentionedBy goldbook:14851 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14851 "current"^^xsd:string)
Declaration(Class(goldbook:14852))
AnnotationAssertion(rdfs:label goldbook:14852 "microcosm")
AnnotationAssertion(dcterms:description goldbook:14852 "Artificial multi-species test system that simulates major characteristics of the natural environment for the purposes of ecotoxicological effects and risk assessment; such systems are normally terrestrial or aquatic and may contain plants, animals (vertebrates and invertebrates), and microorganisms.")
AnnotationAssertion(rdfs:comment goldbook:14852 "The terms mesocosm and macrocosm are used to refer to larger and more complex systems than microcosms, but the distinction is often not clearly defined."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14852 goldbook:14824)
AnnotationAssertion(rdfs:seeAlso goldbook:14852 goldbook:14846)
AnnotationAssertion(mito:isMentionedBy goldbook:14852 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14852 "current"^^xsd:string)
Declaration(Class(goldbook:14853))
AnnotationAssertion(rdfs:label goldbook:14853 "microevolution")
AnnotationAssertion(dcterms:description goldbook:14853 "Evolutionary change below the species level; a small change in the genetic make-up of a population from generation to generation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14853 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14853 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14853 "current"^^xsd:string)
Declaration(Class(goldbook:14854))
AnnotationAssertion(rdfs:label goldbook:14854 "microphyte")
AnnotationAssertion(dcterms:description goldbook:14854 "Plant of microscopic size.")
AnnotationAssertion(mito:isMentionedBy goldbook:14854 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14854 "current"^^xsd:string)
Declaration(Class(goldbook:14855))
AnnotationAssertion(rdfs:label goldbook:14855 "Microtox® test")
AnnotationAssertion(dcterms:description goldbook:14855 "Test involving luminescent marine bacteria of the Vibrio sp. [e.g., V. (Photobacterium) phosphoreum, V. fischeri, V. harveyi]. A decrease in bioluminescence is thought to reflect toxic action.")
AnnotationAssertion(mito:isMentionedBy goldbook:14855 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14855 "current"^^xsd:string)
Declaration(Class(goldbook:14856))
AnnotationAssertion(rdfs:label goldbook:14856 "mineral")
AnnotationAssertion(dcterms:description goldbook:14856 "Naturally occurring substance, usually crystalline, which has a particular chemical composition and specific physical properties.")
AnnotationAssertion(mito:isMentionedBy goldbook:14856 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14856 "current"^^xsd:string)
Declaration(Class(goldbook:14857))
AnnotationAssertion(rdfs:label goldbook:14857 "minimum significant difference")
AnnotationAssertion(dcterms:description goldbook:14857 "Difference between groups (in tests with, e.g., salmonid fish, the difference in average weights or average mortality) that would have to occur before it could be concluded that there was a significant difference between the groups.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14857 "MSD")
AnnotationAssertion(rdfs:comment goldbook:14857 "The MSD is provided by Dunnett’s multiple range test."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14857 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14857 "current"^^xsd:string)
Declaration(Class(goldbook:14858))
AnnotationAssertion(rdfs:label goldbook:14858 "minimal time to effect or response")
AnnotationAssertion(dcterms:description goldbook:14858 "Minimum time required to get an effect or response. Regardless of the toxicant concentration, the effect, or response, cannot occur any faster than this minimum time.")
AnnotationAssertion(mito:isMentionedBy goldbook:14858 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14858 "current"^^xsd:string)
Declaration(Class(goldbook:14859))
AnnotationAssertion(rdfs:label goldbook:14859 "minimum viable population")
AnnotationAssertion(dcterms:description goldbook:14859 "Smallest population size of a species allowing survival in the wild.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14859 "MVP")
AnnotationAssertion(rdfs:comment goldbook:14859 "More specifically, MVP is the smallest possible size at which a biological population can exist without facing extinction from natural disasters or demographic or environmental changes, or genetic drift."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14859 "MVP is used in the fields of biology, ecology, and conservation biology/ecology."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14859 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14859 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14859 "current"^^xsd:string)
Declaration(Class(goldbook:14860))
AnnotationAssertion(rdfs:label goldbook:14860 "mixing zone")
AnnotationAssertion(dcterms:description goldbook:14860 "Area where an effluent discharge undergoes initial dilution and is extended to cover the secondary mixing in the ambient water body.")
AnnotationAssertion(rdfs:comment goldbook:14860 "A mixing zone is an allocated impact zone where water quality criteria can be exceeded as long as acutely toxic conditions are prevented."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14860 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14860 "current"^^xsd:string)
Declaration(Class(goldbook:14861))
AnnotationAssertion(rdfs:label goldbook:14861 "model error")
AnnotationAssertion(dcterms:description goldbook:14861 "Elements of uncertainty associated with the discrepancy between the model and the real world.")
AnnotationAssertion(mito:isMentionedBy goldbook:14861 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14861 "current"^^xsd:string)
Declaration(Class(goldbook:14862))
AnnotationAssertion(rdfs:label goldbook:14862 "monitoring test")
AnnotationAssertion(dcterms:description goldbook:14862 "Test designed to be applied on a routine basis, with some degree of control, to ensure that the quality of an environmental compartment, biological endpoint, or effluent has not exceeded some prescribed criteria range. In a biomonitoring test, organisms are used as 'sensors' to detect changes in the quality of water or effluent. A monitoring test implies generation of information, on a continuous or other regular basis.")
AnnotationAssertion(rdfs:seeAlso goldbook:14862 goldbook:14537)
AnnotationAssertion(mito:isMentionedBy goldbook:14862 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14862 "current"^^xsd:string)
Declaration(Class(goldbook:14863))
AnnotationAssertion(rdfs:label goldbook:14863 "Montreal protocol")
AnnotationAssertion(dcterms:description goldbook:14863 "Officially the Protocol on Substances That Deplete the Ozone Layer, a treaty signed on 16 September 1987, in Montreal by 25 nations; there are now 168 subscribing nations. The protocol sets limits on the production of chlorofluorocarbons (CFCs), halons, and related substances that release chlorine or bromine to the ozone layer of the atmosphere.")
AnnotationAssertion(rdfs:seeAlso goldbook:14863 goldbook:14523)
AnnotationAssertion(mito:isMentionedBy goldbook:14863 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14863 "current"^^xsd:string)
Declaration(Class(goldbook:14864))
AnnotationAssertion(rdfs:label goldbook:14864 "morphodynamics")
AnnotationAssertion(dcterms:description goldbook:14864 "Study of the interaction and adjustment of the seafloor topography and fluid hydrodynamic processes, seafloor morphologies, and sequences of change dynamics involving the motion of sediment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14864 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14864 "current"^^xsd:string)
Declaration(Class(goldbook:14865))
AnnotationAssertion(rdfs:label goldbook:14865 "mortality")
AnnotationAssertion(dcterms:description goldbook:14865 "Death rate, the number of dead individuals per unit time.")
AnnotationAssertion(rdfs:comment goldbook:14865 "Natality and mortality graphs together form a life table."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14865 goldbook:14514)
AnnotationAssertion(mito:isMentionedBy goldbook:14865 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14865 "current"^^xsd:string)
Declaration(Class(goldbook:14866))
AnnotationAssertion(rdfs:label goldbook:14866 "most-sensitive-species approach")
AnnotationAssertion(dcterms:description goldbook:14866 "Ecotoxicological approach in which results for the most sensitive of all tested species are used as an indicator of the toxicant concentration below which the entire community is protected from adverse effects.")
AnnotationAssertion(rdfs:seeAlso goldbook:14866 goldbook:14531)
AnnotationAssertion(mito:isMentionedBy goldbook:14866 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14866 "current"^^xsd:string)
Declaration(Class(goldbook:14867))
AnnotationAssertion(rdfs:label goldbook:14867 "moving average method")
AnnotationAssertion(dcterms:description goldbook:14867 "Method of estimating \\(\\pu{LC_{50}}\\), \\(\\pu{EC_{50}}\\), or \\(\\pu{LD_{50}}\\). It can be implemented with straightforward equations if the toxicant concentrations are set in a geometric series and there are equal numbers of individuals exposed in each treatment.")
AnnotationAssertion(mito:isMentionedBy goldbook:14867 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14867 "current"^^xsd:string)
Declaration(Class(goldbook:14868))
AnnotationAssertion(rdfs:label goldbook:14868 "multiple heterosis")
AnnotationAssertion(dcterms:description goldbook:14868 "Higher fitness of an individual as a composite or summed effect of heterozygote superiority (heterosis) at each of a series of loci.")
AnnotationAssertion(mito:isMentionedBy goldbook:14868 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14868 "current"^^xsd:string)
Declaration(Class(goldbook:14869))
AnnotationAssertion(rdfs:label goldbook:14869 "mutualism")
AnnotationAssertion(dcterms:description goldbook:14869 "Interaction between two or more species, giving fitness benefit to all the involved species, e.g., increased carrying capacity.")
AnnotationAssertion(rdfs:comment goldbook:14869 "Similar interactions within one species are called cooperation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14869 "Symbiosis is the form of mutualism leading to the closest spatial or physical association. The process may be obligate, meaning the involved species cannot survive alone. Examples include cleaner fish, pollination and seed dispersal, gut flora, and nitrogen fixation by fungi."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14869 goldbook:14514)
AnnotationAssertion(mito:isMentionedBy goldbook:14869 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14869 "current"^^xsd:string)
Declaration(Class(goldbook:14870))
AnnotationAssertion(rdfs:label goldbook:14870 "National Academy of Sciences paradigm of risk assessment")
AnnotationAssertion(dcterms:description goldbook:14870 "Model for risk assessment with four components—hazard identification, exposure assessment, dose–response assessment, and risk characterization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14870 "NAS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14870 "NAS paradigm of risk assessment")
AnnotationAssertion(rdfs:comment goldbook:14870 "This model is used for both human and ecological risk assessments."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14870 goldbook:14673)
AnnotationAssertion(rdfs:seeAlso goldbook:14870 goldbook:14735)
AnnotationAssertion(mito:isMentionedBy goldbook:14870 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14870 "current"^^xsd:string)
Declaration(Class(goldbook:14871))
AnnotationAssertion(rdfs:label goldbook:14871 "natural selection")
AnnotationAssertion(dcterms:description goldbook:14871 "Evolutionary theory, originally proposed by Darwin, of the preferential survival and reproduction of organisms better adapted to their environment as a result of genetic adaptation.")
AnnotationAssertion(rdfs:seeAlso goldbook:14871 goldbook:14711)
AnnotationAssertion(mito:isMentionedBy goldbook:14871 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14871 "current"^^xsd:string)
Declaration(Class(goldbook:14872))
AnnotationAssertion(rdfs:label goldbook:14872 "natural radiation background")
AnnotationAssertion(dcterms:description goldbook:14872 "Cosmic radiation emitted from stars and long-lived terrestrial radionuclides that are ubiquitously present in the Earth’s soils.")
AnnotationAssertion(rdfs:seeAlso goldbook:14872 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14872 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14872 "current"^^xsd:string)
Declaration(Class(goldbook:14873))
AnnotationAssertion(rdfs:label goldbook:14873 "nekton")
AnnotationAssertion(dcterms:description goldbook:14873 "Aggregate of actively swimming animals in a body of water ranging from microscopic organisms to whales.")
AnnotationAssertion(mito:isMentionedBy goldbook:14873 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14873 "current"^^xsd:string)
Declaration(Class(goldbook:14874))
AnnotationAssertion(rdfs:label goldbook:14874 "neo-Darwinism")
AnnotationAssertion(dcterms:description goldbook:14874 "Theory of biological evolution (widely accepted since the 1920s) based on Darwin’s theory of natural selection but incorporating the theories of later biologists regarding genes, inheritance, and mutation, particularly those of Weismann and Mendel.")
AnnotationAssertion(rdfs:seeAlso goldbook:14874 goldbook:14845)
AnnotationAssertion(rdfs:seeAlso goldbook:14874 goldbook:15134)
AnnotationAssertion(mito:isMentionedBy goldbook:14874 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14874 "current"^^xsd:string)
Declaration(Class(goldbook:14875))
AnnotationAssertion(rdfs:label goldbook:14875 "neophyte")
AnnotationAssertion(dcterms:description goldbook:14875 "Plant found newly in an area where it had not been recorded previously.")
AnnotationAssertion(mito:isMentionedBy goldbook:14875 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14875 "current"^^xsd:string)
Declaration(Class(goldbook:14876))
AnnotationAssertion(rdfs:label goldbook:14876 "net reproductive rate")
AnnotationAssertion(dcterms:description goldbook:14876 "Expected number of females to be produced during the lifetime of a newborn female as estimated with a life table.")
AnnotationAssertion(mito:isMentionedBy goldbook:14876 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14876 "current"^^xsd:string)
Declaration(Class(goldbook:14877))
AnnotationAssertion(rdfs:label goldbook:14877 "niche")
AnnotationAssertion(dcterms:description goldbook:14877 "Group of conditions and resources, facilitating but limiting survival, growth, and reproduction of a defined group of organisms or species.")
AnnotationAssertion(rdfs:comment goldbook:14877 "The niche influences how a population responds to the abundance of its resources and enemies."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14877 "The niche is influenced by its inhabiting populations."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14877 "The abiotic or physical environment is part of the niche because it influences how populations affect, and are affected by, resources and enemies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14877 goldbook:14747)
AnnotationAssertion(rdfs:seeAlso goldbook:14877 goldbook:14539)
AnnotationAssertion(rdfs:seeAlso goldbook:14877 goldbook:14706)
AnnotationAssertion(rdfs:seeAlso goldbook:14877 goldbook:14878)
AnnotationAssertion(rdfs:seeAlso goldbook:14877 goldbook:14932)
AnnotationAssertion(rdfs:seeAlso goldbook:14877 goldbook:14973)
AnnotationAssertion(mito:isMentionedBy goldbook:14877 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14877 "current"^^xsd:string)
Declaration(Class(goldbook:14878))
AnnotationAssertion(rdfs:label goldbook:14878 "niche preemption")
AnnotationAssertion(dcterms:description goldbook:14878 "Rapid use and preemption of resources by a species that exploits them to the exclusion or severe disadvantage of another species.")
AnnotationAssertion(rdfs:seeAlso goldbook:14878 goldbook:14877)
AnnotationAssertion(mito:isMentionedBy goldbook:14878 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14878 "current"^^xsd:string)
Declaration(Class(goldbook:14879))
AnnotationAssertion(rdfs:label goldbook:14879 "niche width")
AnnotationAssertion(dcterms:description goldbook:14879 "Term referring to the area which a species could physically inhabit.")
AnnotationAssertion(rdfs:comment goldbook:14879 "This area is defined by suitable climate and available food sources appropriate to that species as well as other factors such as temperature and air or water pressure levels. The niche width often differs from the realized niche."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14879 goldbook:14973)
AnnotationAssertion(mito:isMentionedBy goldbook:14879 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14879 "current"^^xsd:string)
Declaration(Class(goldbook:14880))
AnnotationAssertion(rdfs:label goldbook:14880 "not in my backyard principle")
AnnotationAssertion(dcterms:description goldbook:14880 "Public acceptance of necessary provisions (e.g., waste incinerators) provided they do not affect the individual’s quality of life.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14880 "NIMBY")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14880 "NIMBY principle")
AnnotationAssertion(mito:isMentionedBy goldbook:14880 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14880 "current"^^xsd:string)
Declaration(Class(goldbook:14881))
AnnotationAssertion(rdfs:label goldbook:14881 "nine aspects of disease association")
AnnotationAssertion(dcterms:description goldbook:14881 "Nine aspects of evidence, defined by Bradford-Hill (1965), fostering the accuracy of linkage between a risk factor and disease: strength of association, consistency of association, specificity of association, temporal association, biological gradient (dose-response) in the association, biological plausibility, coherence of the association, experimental support of association, and analogy.")
AnnotationAssertion(mito:isMentionedBy goldbook:14881 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14881 "current"^^xsd:string)
Declaration(Class(goldbook:14882))
AnnotationAssertion(rdfs:label goldbook:14882 "\"no action\" alternative")
AnnotationAssertion(dcterms:description goldbook:14882 "Scenario in which one assesses if the contaminants at the waste site pose, or will pose in the future, a risk if left alone.")
AnnotationAssertion(mito:isMentionedBy goldbook:14882 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14882 "current"^^xsd:string)
Declaration(Class(goldbook:14883))
AnnotationAssertion(rdfs:label goldbook:14883 "nonstochastic health effects")
AnnotationAssertion(dcterms:description goldbook:14883 "Effects that are dependent on the magnitude of the dose in excess of a threshold.")
AnnotationAssertion(mito:isMentionedBy goldbook:14883 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14883 "current"^^xsd:string)
Declaration(Class(goldbook:14884))
AnnotationAssertion(rdfs:label goldbook:14884 "nontarget organisms")
AnnotationAssertion(dcterms:description goldbook:14884 "Organisms that are not the intended targets of a particular use of a pesticide.")
AnnotationAssertion(mito:isMentionedBy goldbook:14884 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14884 "current"^^xsd:string)
Declaration(Class(goldbook:14885))
AnnotationAssertion(rdfs:label goldbook:14885 "no-observed-effect concentration")
AnnotationAssertion(dcterms:description goldbook:14885 "Special case of the no-observed-effect level (NOEL), commonly used in aquatic toxicology.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14885 "NOEC")
AnnotationAssertion(rdfs:comment goldbook:14885 "When derived from a life-cycle or partial life-cycle test, it is numerically the same as the lower limit of the maximum acceptable toxicant concentration (MATC)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14885 goldbook:14832)
AnnotationAssertion(mito:isMentionedBy goldbook:14885 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14885 "current"^^xsd:string)
Declaration(Class(goldbook:14886))
AnnotationAssertion(rdfs:label goldbook:14886 "no-response level")
AnnotationAssertion(dcterms:description goldbook:14886 "Maximum dose of a substance at which no specified response is observed in a defined population and under defined conditions of exposure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14886 "NRL")
AnnotationAssertion(rdfs:seeAlso goldbook:14886 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14886 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14886 "current"^^xsd:string)
Declaration(Class(goldbook:14887))
AnnotationAssertion(rdfs:label goldbook:14887 "normit")
AnnotationAssertion(dcterms:description goldbook:14887 "Metameter equal to the normal equivalent deviation (NED). The resulting analysis of dose– or concentration-effect data with the normit metameter is often called normit analysis and is essentially equivalent to probit analysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:14887 goldbook:15140)
AnnotationAssertion(mito:isMentionedBy goldbook:14887 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14887 "current"^^xsd:string)
Declaration(Class(goldbook:14888))
AnnotationAssertion(rdfs:label goldbook:14888 "numerical response")
AnnotationAssertion(dcterms:description goldbook:14888 "Change in predator or grazer number through increased reproductive output, decreased mortality, or increased immigration in response to changes in prey or food densities.")
AnnotationAssertion(mito:isMentionedBy goldbook:14888 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14888 "current"^^xsd:string)
Declaration(Class(goldbook:14889))
AnnotationAssertion(rdfs:label goldbook:14889 "octanol-air partition coefficient")
AnnotationAssertion(dcterms:description goldbook:14889 "Partition coefficient for a compound between octanol and air. Like \\(K_{\\rm{ow}}\\), it is a measure of lipophilicity.")
AnnotationAssertion(mito:isMentionedBy goldbook:14889 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14889 "current"^^xsd:string)
Declaration(Class(goldbook:14890))
AnnotationAssertion(rdfs:label goldbook:14890 "octanol-water partition coefficient")
AnnotationAssertion(dcterms:description goldbook:14890 "Ratio of the solubility of a chemical in octanol to its solubility in water at equilibrium.")
AnnotationAssertion(rdfs:comment goldbook:14890 "Measure of lipophilicity, used in the assessment of both the uptake and physiological distribution of organic chemicals and prediction of their environmental fate."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14890 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14890 "current"^^xsd:string)
Declaration(Class(goldbook:14891))
AnnotationAssertion(rdfs:label goldbook:14891 "octaves")
AnnotationAssertion(dcterms:description goldbook:14891 "Log2 classes (e.g., 1–2, 2–4, 4–8, 8–16, 16–32,... individuals) used in species-abundance curves and representing doubling of the numbers of individuals in a species.")
AnnotationAssertion(mito:isMentionedBy goldbook:14891 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14891 "current"^^xsd:string)
Declaration(Class(goldbook:14892))
AnnotationAssertion(rdfs:label goldbook:14892 "Oklo natural reactors")
AnnotationAssertion(dcterms:description goldbook:14892 "Naturally occurring nuclear reactors arising through biogeochemical processes approximately 1.8 billion years ago in Oklo (Gabon, Africa).")
AnnotationAssertion(mito:isMentionedBy goldbook:14892 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14892 "current"^^xsd:string)
Declaration(Class(goldbook:14893))
AnnotationAssertion(rdfs:label goldbook:14893 "oligotrophic")
AnnotationAssertion(dcterms:description goldbook:14893 "Describing an environment having a low concentration of nutrients.")
AnnotationAssertion(rdfs:comment goldbook:14893 "The term is usually used to describe bodies of water or soils with very low nutrient levels and low rates of biological production."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14893 goldbook:14664)
AnnotationAssertion(rdfs:seeAlso goldbook:14893 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14893 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14893 "current"^^xsd:string)
Declaration(Class(goldbook:14894))
AnnotationAssertion(rdfs:label goldbook:14894 "oligotrophy")
AnnotationAssertion(dcterms:description goldbook:14894 "State of being oligotrophic. Obligate or facultative capacity to live in low-nutrient habitats.")
AnnotationAssertion(rdfs:seeAlso goldbook:14894 goldbook:14666)
AnnotationAssertion(rdfs:seeAlso goldbook:14894 goldbook:14728)
AnnotationAssertion(mito:isMentionedBy goldbook:14894 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14894 "current"^^xsd:string)
Declaration(Class(goldbook:14895))
AnnotationAssertion(rdfs:label goldbook:14895 "optimal-foraging theory")
AnnotationAssertion(dcterms:description goldbook:14895 "Theory that the ideal forager will obtain a maximum net rate of energy gain by optimally allocating its time and energy to the various components of foraging.")
AnnotationAssertion(mito:isMentionedBy goldbook:14895 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14895 "current"^^xsd:string)
Declaration(Class(goldbook:14896))
AnnotationAssertion(rdfs:label goldbook:14896 "optimal stress response")
AnnotationAssertion(dcterms:description goldbook:14896 "Optimal stress response involves a shift in the balance in energy allocation between somatic growth rate and longevity (survival) to optimize Darwinian fitness under stressful conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:14896 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14896 "current"^^xsd:string)
Declaration(Class(goldbook:14897))
AnnotationAssertion(rdfs:label goldbook:14897 "ozone layer")
AnnotationAssertion(dcterms:description goldbook:14897 "Part of the Earth’s atmosphere, mainly located in the lower portion of the stratosphere, approximately \\(\\pu{15\\!-\\! 35 km}\\) above the Earth's surface, containing relatively high concentrations (a few micromoles per litre) of ozone (\\(\\ce{O3}\\)) which is higher than concentrations in the lower atmosphere. The thickness varies seasonally and geographically.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14897 "ozonosphere")
AnnotationAssertion(mito:isMentionedBy goldbook:14897 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14897 "current"^^xsd:string)
Declaration(Class(goldbook:14898))
AnnotationAssertion(rdfs:label goldbook:14898 "palaeontology")
AnnotationAssertion(dcterms:description goldbook:14898 "Branch of science that deals with extinct and fossil humans, animals, and plants, or more generally with evidence of organic life during the geological past.")
AnnotationAssertion(mito:isMentionedBy goldbook:14898 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14898 "current"^^xsd:string)
Declaration(Class(goldbook:14899))
AnnotationAssertion(rdfs:label goldbook:14899 "paradigm")
AnnotationAssertion(dcterms:description goldbook:14899 "Model or template. Body of concepts that, in a particular branch of science, has withstood rigorous testing, and is generally accepted by scientists working in that field as offering true explanations of fact and observation.Note: This usage is derived from the work of the philosopher T. S. Kuhn (1922–1996).")
AnnotationAssertion(mito:isMentionedBy goldbook:14899 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14899 "current"^^xsd:string)
Declaration(Class(goldbook:14900))
AnnotationAssertion(rdfs:label goldbook:14900 "partial kill")
AnnotationAssertion(dcterms:description goldbook:14900 "Treatment in a toxicity test in which some, but not all, exposed individuals are killed.")
AnnotationAssertion(mito:isMentionedBy goldbook:14900 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14900 "current"^^xsd:string)
Declaration(Class(goldbook:14901))
AnnotationAssertion(rdfs:label goldbook:14901 "pathway")
AnnotationAssertion(dcterms:description goldbook:14901 "Sequence of enzymatic or other reactions by which one biological material is converted to another.")
AnnotationAssertion(mito:isMentionedBy goldbook:14901 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14901 "current"^^xsd:string)
Declaration(Class(goldbook:14902))
AnnotationAssertion(rdfs:label goldbook:14902 "pedosphere")
AnnotationAssertion(dcterms:description goldbook:14902 "Part of the Earth made up of soils and where important soil processes are occurring.")
AnnotationAssertion(rdfs:seeAlso goldbook:14902 goldbook:15036)
AnnotationAssertion(mito:isMentionedBy goldbook:14902 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14902 "current"^^xsd:string)
Declaration(Class(goldbook:14903))
AnnotationAssertion(rdfs:label goldbook:14903 "pelagic")
AnnotationAssertion(dcterms:description goldbook:14903 "Of or relating to the open sea, as distinguished from the shallow water near the coast; dwelling on or near the surface of the open sea or ocean; oceanic. Now chiefly: (Ecology) designating, relating to, or inhabiting that region of the sea which consists of open water of any depth, away from or independent of both the shore and the sea floor (and so contrasted with the littoral and benthic regions).")
AnnotationAssertion(rdfs:seeAlso goldbook:14903 goldbook:14610)
AnnotationAssertion(mito:isMentionedBy goldbook:14903 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14903 "current"^^xsd:string)
Declaration(Class(goldbook:14904))
AnnotationAssertion(rdfs:label goldbook:14904 "per capita birth rate")
AnnotationAssertion(dcterms:description goldbook:14904 "Average number of offspring per population member per time unit. Calculated from birth rate \\(B\\) and population size \\(N\\) as \\[b = B/N\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:14904 goldbook:14906)
AnnotationAssertion(rdfs:seeAlso goldbook:14904 goldbook:14932)
AnnotationAssertion(rdfs:seeAlso goldbook:14904 goldbook:14939)
AnnotationAssertion(mito:isMentionedBy goldbook:14904 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14904 "current"^^xsd:string)
Declaration(Class(goldbook:14905))
AnnotationAssertion(rdfs:label goldbook:14905 "per capita death rate")
AnnotationAssertion(dcterms:description goldbook:14905 "Average number of deaths per population member per time unit. Calculated from death rate \\(D\\) and population size \\(N\\) as \\[m = D/N\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:14905 goldbook:14906)
AnnotationAssertion(rdfs:seeAlso goldbook:14905 goldbook:14932)
AnnotationAssertion(rdfs:seeAlso goldbook:14905 goldbook:14939)
AnnotationAssertion(mito:isMentionedBy goldbook:14905 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14905 "current"^^xsd:string)
Declaration(Class(goldbook:14906))
AnnotationAssertion(rdfs:label goldbook:14906 "per capita rate of increase")
AnnotationAssertion(dcterms:description goldbook:14906 "Relative increase, \\(r\\), in the population per unit of time expressed per capita. \\[r = b - m\\] where \\(b\\) is per capita birth rate and \\(m\\) is per capita death rate.")
AnnotationAssertion(rdfs:seeAlso goldbook:14906 goldbook:14904)
AnnotationAssertion(rdfs:seeAlso goldbook:14906 goldbook:14905)
AnnotationAssertion(rdfs:seeAlso goldbook:14906 goldbook:14932)
AnnotationAssertion(mito:isMentionedBy goldbook:14906 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14906 "current"^^xsd:string)
Declaration(Class(goldbook:14907))
AnnotationAssertion(rdfs:label goldbook:14907 "periphyton")
AnnotationAssertion(dcterms:description goldbook:14907 "Matrix of algae, microbes, and detritus attached to submerged surfaces in aquatic ecosystems.")
AnnotationAssertion(rdfs:seeAlso goldbook:14907 goldbook:14456)
AnnotationAssertion(rdfs:seeAlso goldbook:14907 goldbook:14581)
AnnotationAssertion(rdfs:seeAlso goldbook:14907 goldbook:14619)
AnnotationAssertion(mito:isMentionedBy goldbook:14907 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14907 "current"^^xsd:string)
Declaration(Class(goldbook:14908))
AnnotationAssertion(rdfs:label goldbook:14908 "persistent inorganic pollutant")
AnnotationAssertion(dcterms:description goldbook:14908 "Inorganic substance that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14908 "PIP")
AnnotationAssertion(rdfs:comment goldbook:14908 "Some inorganic chemicals, like crocidolite asbestos, are persistent in almost all circumstances, but others, like metal sulfides, are persistent only in unreactive environments; sulfides can generate hydrogen sulfide in a reducing environment or sulfates and sulfuric acid in oxidizing environments. As with organic substances, persistence is often a function of environmental properties."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14908 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14908 "current"^^xsd:string)
Declaration(Class(goldbook:14909))
AnnotationAssertion(rdfs:label goldbook:14909 "persistent organic pollutant")
AnnotationAssertion(dcterms:description goldbook:14909 "Organic chemical that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:14909 "POP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14909 "bioaccumulative chemicals of concern (BCC)")
AnnotationAssertion(rdfs:seeAlso goldbook:14909 goldbook:14470)
AnnotationAssertion(mito:isMentionedBy goldbook:14909 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14909 "current"^^xsd:string)
Declaration(Class(goldbook:14910))
AnnotationAssertion(rdfs:label goldbook:14910 "phenology")
AnnotationAssertion(dcterms:description goldbook:14910 "Life history.")
AnnotationAssertion(mito:isMentionedBy goldbook:14910 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14910 "current"^^xsd:string)
Declaration(Class(goldbook:14911))
AnnotationAssertion(rdfs:label goldbook:14911 "photoperiod")
AnnotationAssertion(dcterms:description goldbook:14911 "The duration of illumination and darkness over a \\(\\pu{24\\!\\mbox{-}h}\\) day.")
AnnotationAssertion(mito:isMentionedBy goldbook:14911 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14911 "current"^^xsd:string)
Declaration(Class(goldbook:14912))
AnnotationAssertion(rdfs:label goldbook:14912 "pH-partition hypothesis")
AnnotationAssertion(dcterms:description goldbook:14912 "Hypothesis that bioavailability is governed by the diffusion of the unionized form of an ionizable substance through the gastrointestinal lumen, as determined by \\(\\pu{p}K_{\\rm{a}}\\) and \\(\\rm{pH}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:14912 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14912 "current"^^xsd:string)
Declaration(Class(goldbook:14913))
AnnotationAssertion(rdfs:label goldbook:14913 "phylogenetics")
AnnotationAssertion(dcterms:description goldbook:14913 "Branch of biology that deals with phylogeny, especially with the deduction of the historical relationships between groups of organisms.")
AnnotationAssertion(rdfs:seeAlso goldbook:14913 goldbook:14526)
AnnotationAssertion(rdfs:seeAlso goldbook:14913 goldbook:14914)
AnnotationAssertion(rdfs:seeAlso goldbook:14913 goldbook:15088)
AnnotationAssertion(mito:isMentionedBy goldbook:14913 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14913 "current"^^xsd:string)
Declaration(Class(goldbook:14914))
AnnotationAssertion(rdfs:label goldbook:14914 "phylogeny")
AnnotationAssertion(dcterms:description goldbook:14914 "Pattern of historical relationships between species or other groups resulting from divergence during evolution.")
AnnotationAssertion(rdfs:comment goldbook:14914 "Phylogenetic relationships are shown in diagrams (cladograms, phylogenetic trees, evolutionary trees)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14914 "Palaeontology is important for understanding phylogeny. Without the fossils of the many groups of organisms now extinct, it could not be understood how present life forms are interrelated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:14914 "Phylogenetics, the science of phylogeny, is part of the larger field of systematics, also including taxonomy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:14914 goldbook:14898)
AnnotationAssertion(rdfs:seeAlso goldbook:14914 goldbook:14700)
AnnotationAssertion(rdfs:seeAlso goldbook:14914 goldbook:14527)
AnnotationAssertion(rdfs:seeAlso goldbook:14914 goldbook:14913)
AnnotationAssertion(rdfs:seeAlso goldbook:14914 goldbook:15090)
AnnotationAssertion(mito:isMentionedBy goldbook:14914 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14914 "current"^^xsd:string)
Declaration(Class(goldbook:14915))
AnnotationAssertion(rdfs:label goldbook:14915 "phylum")
AnnotationAssertion(dcterms:description goldbook:14915 "Taxonomic rank at the level below Kingdom and above Class")
AnnotationAssertion(rdfs:comment goldbook:14915 "Formally, a phylum can be used for any biological domain, but traditionally it was always used for animals, whereas \"division\" was traditionally often used for plants, fungi, etc."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:14915 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14915 "current"^^xsd:string)
Declaration(Class(goldbook:14916))
AnnotationAssertion(rdfs:label goldbook:14916 "physiological adaptation")
AnnotationAssertion(dcterms:description goldbook:14916 "Change in an organism, in response to changing conditions of the environment, which takes place without any irreversible disruptions of the given biological system and without exceeding normal (homeostatic) capacities of its response. Process by which an organism stabilizes its physiological condition after an environmental change.Note: If this process exceeds the homeostatic range, it becomes pathological and results in symptoms of disease (adverse effects).")
AnnotationAssertion(mito:isMentionedBy goldbook:14916 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14916 "current"^^xsd:string)
Declaration(Class(goldbook:14917))
AnnotationAssertion(rdfs:label goldbook:14917 "phytochelatin")
AnnotationAssertion(dcterms:description goldbook:14917 "Class of cysteine-rich peptides in plants that are induced by and bind to metals. They can function in the regulation and detoxification of metals by plants.")
AnnotationAssertion(rdfs:seeAlso goldbook:14917 goldbook:14848)
AnnotationAssertion(mito:isMentionedBy goldbook:14917 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14917 "current"^^xsd:string)
Declaration(Class(goldbook:14918))
AnnotationAssertion(rdfs:label goldbook:14918 "phytoplankton")
AnnotationAssertion(dcterms:description goldbook:14918 "Photosynthesizing organisms found in the plankton.")
AnnotationAssertion(rdfs:seeAlso goldbook:14918 goldbook:14924)
AnnotationAssertion(mito:isMentionedBy goldbook:14918 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14918 "current"^^xsd:string)
Declaration(Class(goldbook:14919))
AnnotationAssertion(rdfs:label goldbook:14919 "phytotoxic")
AnnotationAssertion(dcterms:description goldbook:14919 "Toxic to plants.")
AnnotationAssertion(rdfs:seeAlso goldbook:14919 goldbook:15100)
AnnotationAssertion(mito:isMentionedBy goldbook:14919 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14919 "current"^^xsd:string)
Declaration(Class(goldbook:14920))
AnnotationAssertion(rdfs:label goldbook:14920 "Pielou’s <i>J</i>")
AnnotationAssertion(dcterms:description goldbook:14920 "Measure of species evenness for a sample from a community. It is calculated from the following equation: \\[{\\rm{Pielouߴs}}\\ J = \\frac{H'}{\\log S}\\] where \\(H'\\) is the Shannon–Wiener diversity measure and \\(S\\) is the average species richness.")
AnnotationAssertion(rdfs:seeAlso goldbook:14920 goldbook:15031)
AnnotationAssertion(rdfs:seeAlso goldbook:14920 goldbook:14531)
AnnotationAssertion(rdfs:seeAlso goldbook:14920 goldbook:15049)
AnnotationAssertion(rdfs:seeAlso goldbook:14920 goldbook:15051)
AnnotationAssertion(mito:isMentionedBy goldbook:14920 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14920 "current"^^xsd:string)
Declaration(Class(goldbook:14921))
AnnotationAssertion(rdfs:label goldbook:14921 "pinnipeds")
AnnotationAssertion(dcterms:description goldbook:14921 "Seals, sea lions, and walruses.")
AnnotationAssertion(mito:isMentionedBy goldbook:14921 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14921 "current"^^xsd:string)
Declaration(Class(goldbook:14922))
AnnotationAssertion(rdfs:label goldbook:14922 "piscivorous")
AnnotationAssertion(dcterms:description goldbook:14922 "Feeding on fish.")
AnnotationAssertion(mito:isMentionedBy goldbook:14922 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14922 "current"^^xsd:string)
Declaration(Class(goldbook:14923))
AnnotationAssertion(rdfs:label goldbook:14923 "planktivorous")
AnnotationAssertion(dcterms:description goldbook:14923 "Feeding on plankton.")
AnnotationAssertion(rdfs:seeAlso goldbook:14923 goldbook:14924)
AnnotationAssertion(mito:isMentionedBy goldbook:14923 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14923 "current"^^xsd:string)
Declaration(Class(goldbook:14924))
AnnotationAssertion(rdfs:label goldbook:14924 "plankton")
AnnotationAssertion(dcterms:description goldbook:14924 "Organisms living suspended in the water column and incapable of moving against water currents.")
AnnotationAssertion(mito:isMentionedBy goldbook:14924 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14924 "current"^^xsd:string)
Declaration(Class(goldbook:14925))
AnnotationAssertion(rdfs:label goldbook:14925 "planktotrophic larva")
AnnotationAssertion(dcterms:description goldbook:14925 "Planktonic-dispersing larva that derives its nourishment by feeding in the plankton.")
AnnotationAssertion(rdfs:seeAlso goldbook:14925 goldbook:14924)
AnnotationAssertion(mito:isMentionedBy goldbook:14925 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14925 "current"^^xsd:string)
Declaration(Class(goldbook:14926))
AnnotationAssertion(rdfs:label goldbook:14926 "poikilotherm")
AnnotationAssertion(dcterms:description goldbook:14926 "'Cold-blooded organism' (such as an amphibian, reptile, or fish) with a body temperature varying with, but usually slightly higher than, the temperature of its environment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14926 "ectotherm")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14926 "exotherm")
AnnotationAssertion(rdfs:seeAlso goldbook:14926 goldbook:14634)
AnnotationAssertion(mito:isMentionedBy goldbook:14926 doi:10.1351/PAC-REC-08-07-09)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:14926 "current"^^xsd:string)
