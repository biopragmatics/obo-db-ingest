AnnotationAssertion(dcterms:description goldbook:11611 "Web of blood vessels with one or more abnormal communications between arteries and veins that bypass the capillary system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11611 "AVM")
AnnotationAssertion(rdfs:comment goldbook:11611 "They may cause hemorrhage, seizures, headaches, paralysis or loss of speech, memory or vision."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11611 goldbook:11800)
AnnotationAssertion(rdfs:seeAlso goldbook:11611 goldbook:11806)
AnnotationAssertion(rdfs:seeAlso goldbook:11611 goldbook:11989)
AnnotationAssertion(mito:isMentionedBy goldbook:11611 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11611 "current"^^xsd:string)
Declaration(Class(goldbook:11612))
AnnotationAssertion(rdfs:label goldbook:11612 "associative avoidance test")
AnnotationAssertion(dcterms:description goldbook:11612 "Avoidance test in which the test animal has learned to develop an association between the stimulus and the delivery of an aversive event.")
AnnotationAssertion(rdfs:seeAlso goldbook:11612 goldbook:11626)
AnnotationAssertion(mito:isMentionedBy goldbook:11612 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11612 "current"^^xsd:string)
Declaration(Class(goldbook:11613))
AnnotationAssertion(rdfs:label goldbook:11613 "associative learning")
AnnotationAssertion(dcterms:description goldbook:11613 "Process in which a new behavior arises as a consequence of association with a particular stimulus, sometimes restricted to learning through classical conditioning.")
AnnotationAssertion(rdfs:seeAlso goldbook:11613 goldbook:11687)
AnnotationAssertion(mito:isMentionedBy goldbook:11613 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11613 "current"^^xsd:string)
Declaration(Class(goldbook:11614))
AnnotationAssertion(rdfs:label goldbook:11614 "astrocyte")
AnnotationAssertion(dcterms:description goldbook:11614 "Glial cell of ectodermal origin in the central nervous system, characterized by filamentous protoplasmic extensions.")
AnnotationAssertion(rdfs:seeAlso goldbook:11614 goldbook:11785)
AnnotationAssertion(mito:isMentionedBy goldbook:11614 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11614 "current"^^xsd:string)
Declaration(Class(goldbook:11615))
AnnotationAssertion(rdfs:label goldbook:11615 "reactive astrocyte")
AnnotationAssertion(dcterms:description goldbook:11615 "Astrocyte that, after injury or excessive neural activity, undergoes morphological (including extension of pseudopodia) and biochemical (notably increased synthesis of glial fibrillary acidic protein) changes and participates in astrocytic scar formation.")
AnnotationAssertion(rdfs:seeAlso goldbook:11615 goldbook:11614)
AnnotationAssertion(rdfs:seeAlso goldbook:11615 goldbook:11616)
AnnotationAssertion(rdfs:seeAlso goldbook:11615 goldbook:11787)
AnnotationAssertion(mito:isMentionedBy goldbook:11615 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11615 "current"^^xsd:string)
Declaration(Class(goldbook:11616))
AnnotationAssertion(rdfs:label goldbook:11616 "astrocytic scar")
AnnotationAssertion(dcterms:description goldbook:11616 "Clustering of reactive astrocytes separating a localized brain injury from surrounding uninjured tissue.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11616 "glial scar")
AnnotationAssertion(rdfs:seeAlso goldbook:11616 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11616 goldbook:11615)
AnnotationAssertion(mito:isMentionedBy goldbook:11616 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11616 "current"^^xsd:string)
Declaration(Class(goldbook:11617))
AnnotationAssertion(rdfs:label goldbook:11617 "astrocytoma")
AnnotationAssertion(dcterms:description goldbook:11617 "Tumor within the substance of the brain or spinal cord made up of astrocytes.")
AnnotationAssertion(rdfs:comment goldbook:11617 "Astrocytomas are classified from Grade I (least aggressive) to Grade IV (most aggressive)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11617 "This type of tumor does not usually spread outside the brain and spinal cord and it does not usually affect other organs."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11617 goldbook:11614)
AnnotationAssertion(rdfs:seeAlso goldbook:11617 goldbook:11647)
AnnotationAssertion(mito:isMentionedBy goldbook:11617 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11617 "current"^^xsd:string)
Declaration(Class(goldbook:11618))
AnnotationAssertion(rdfs:label goldbook:11618 "astrogliosis")
AnnotationAssertion(dcterms:description goldbook:11618 "Localized site of reactive astrocytes, distinct from an astrocytic scar.")
AnnotationAssertion(rdfs:seeAlso goldbook:11618 goldbook:11616)
AnnotationAssertion(rdfs:seeAlso goldbook:11618 goldbook:11615)
AnnotationAssertion(mito:isMentionedBy goldbook:11618 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11618 "current"^^xsd:string)
Declaration(Class(goldbook:11619))
AnnotationAssertion(rdfs:label goldbook:11619 "ataxia")
AnnotationAssertion(dcterms:description goldbook:11619 "Loss of muscular coordination (see motor coordination) resulting in abnormal clumsiness.")
AnnotationAssertion(rdfs:seeAlso goldbook:11619 goldbook:11884)
AnnotationAssertion(mito:isMentionedBy goldbook:11619 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11619 "current"^^xsd:string)
Declaration(Class(goldbook:11620))
AnnotationAssertion(rdfs:label goldbook:11620 "athetosis")
AnnotationAssertion(dcterms:description goldbook:11620 "Condition in which inappropriate muscle contraction causes involuntary writhing movements.")
AnnotationAssertion(mito:isMentionedBy goldbook:11620 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11620 "current"^^xsd:string)
Declaration(Class(goldbook:11621))
AnnotationAssertion(rdfs:label goldbook:11621 "atony")
AnnotationAssertion(dcterms:description goldbook:11621 "Lacking muscular tone.")
AnnotationAssertion(mito:isMentionedBy goldbook:11621 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11621 "current"^^xsd:string)
Declaration(Class(goldbook:11622))
AnnotationAssertion(rdfs:label goldbook:11622 "attention deficit hyperactivity disorder")
AnnotationAssertion(dcterms:description goldbook:11622 "Neuropsychiatric disorder of childhood characterized by decreased attention span, impulsiveness and hyperactivity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11622 "ADHD")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11622 "hyperkinetic disorder")
AnnotationAssertion(rdfs:comment goldbook:11622 "Both genetic and environmental factors (such as lead exposure) are implicated in increased risk."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11622 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11622 "current"^^xsd:string)
Declaration(Class(goldbook:11623))
AnnotationAssertion(rdfs:label goldbook:11623 "aura")
AnnotationAssertion(dcterms:description goldbook:11623 "Constellation of symptoms experienced before a migraine headache or seizure.")
AnnotationAssertion(rdfs:comment goldbook:11623 "It may consist of flashing light, blurred vision, an odor, numbness, weakness, difficulty in speaking, or the feeling of a wind blowing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11623 goldbook:11874)
AnnotationAssertion(mito:isMentionedBy goldbook:11623 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11623 "current"^^xsd:string)
Declaration(Class(goldbook:11624))
AnnotationAssertion(rdfs:label goldbook:11624 "autism")
AnnotationAssertion(dcterms:description goldbook:11624 "Neurodevelopmental disorder, present from early childhood, characterized by great difficulty in communicating and forming relationships with other people and in using abstract concepts.")
AnnotationAssertion(rdfs:comment goldbook:11624 "It is now considered part of a range of conditions (autism spectrum disorders) that includes Asperger syndrome, Rett syndrome, and childhood disintegrative disorder."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11624 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11624 "current"^^xsd:string)
Declaration(Class(goldbook:11625))
AnnotationAssertion(rdfs:label goldbook:11625 "autonomic nervous system")
AnnotationAssertion(dcterms:description goldbook:11625 "Part of the peripheral nervous system controlling the bodily functions that are not consciously directed, e.g., breathing, heart rate, and digestive processes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11625 "ANS")
AnnotationAssertion(rdfs:seeAlso goldbook:11625 goldbook:12003)
AnnotationAssertion(mito:isMentionedBy goldbook:11625 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11625 "current"^^xsd:string)
Declaration(Class(goldbook:11626))
AnnotationAssertion(rdfs:label goldbook:11626 "avoidance test")
AnnotationAssertion(dcterms:description goldbook:11626 "Associative learning pairing an adverse event with a non-specific stimulus such that the animal learns to respond in a manner to avoid the adverse event.")
AnnotationAssertion(rdfs:seeAlso goldbook:11626 goldbook:11613)
AnnotationAssertion(mito:isMentionedBy goldbook:11626 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11626 "current"^^xsd:string)
Declaration(Class(goldbook:11627))
AnnotationAssertion(rdfs:label goldbook:11627 "axon")
AnnotationAssertion(dcterms:description goldbook:11627 "Long thread-like process of a neuron along which impulses are conducted from the cell body to the nerve ending.")
AnnotationAssertion(mito:isMentionedBy goldbook:11627 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11627 "current"^^xsd:string)
Declaration(Class(goldbook:11628))
AnnotationAssertion(rdfs:label goldbook:11628 "axonal degeneration")
AnnotationAssertion(dcterms:description goldbook:11628 "Progressive loss of structure and function of an axon, typically in a peripheral-to-central direction.")
AnnotationAssertion(rdfs:seeAlso goldbook:11628 goldbook:11627)
AnnotationAssertion(mito:isMentionedBy goldbook:11628 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11628 "current"^^xsd:string)
Declaration(Class(goldbook:11629))
AnnotationAssertion(rdfs:label goldbook:11629 "axonal transport")
AnnotationAssertion(dcterms:description goldbook:11629 "Movement of organelles and biomolecules to (retrograde) and from (anterograde) a neuron’s cell body, within the cytoplasm of its axon (the axoplasm).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11629 "axoplasmic transport")
AnnotationAssertion(rdfs:seeAlso goldbook:11629 goldbook:11627)
AnnotationAssertion(mito:isMentionedBy goldbook:11629 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11629 "current"^^xsd:string)
Declaration(Class(goldbook:11630))
AnnotationAssertion(rdfs:label goldbook:11630 "axonopathy")
AnnotationAssertion(dcterms:description goldbook:11630 "Damage (peripheral neuropathy) to multiple nerves in roughly the same areas on both sides of the body, causing weakness, numbness, and paresthesia.")
AnnotationAssertion(rdfs:comment goldbook:11630 "This often occurs as a symmetrical polyneuropathy involving nerves in roughly the same areas on both sides of the body."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11630 goldbook:11996)
AnnotationAssertion(rdfs:seeAlso goldbook:11630 goldbook:12004)
AnnotationAssertion(rdfs:seeAlso goldbook:11630 goldbook:12014)
AnnotationAssertion(mito:isMentionedBy goldbook:11630 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11630 "current"^^xsd:string)
Declaration(Class(goldbook:11631))
AnnotationAssertion(rdfs:label goldbook:11631 "bar test")
AnnotationAssertion(dcterms:description goldbook:11631 "Test for catalepsy in which a mouse is placed on a bar oriented parallel to and approximately \\(\\pu{2.5 cm}\\) off the ground. Typically, if the mouse remains immobile on the bar for more than 20 seconds, it is considered to be cataleptic.")
AnnotationAssertion(rdfs:comment goldbook:11631 "The test can also be used for evaluating motor coordination."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11631 goldbook:12132)
AnnotationAssertion(mito:isMentionedBy goldbook:11631 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11631 "current"^^xsd:string)
Declaration(Class(goldbook:11632))
AnnotationAssertion(rdfs:label goldbook:11632 "Barnes maze")
AnnotationAssertion(dcterms:description goldbook:11632 "Circular platform equipped with some 20 equidistant holes near the outer rim, one of which is marked by visual cues and is an escape hole for a rodent that is placed near the middle of the platform and subjected to an adverse stimulus, e.g., bright light.")
AnnotationAssertion(rdfs:comment goldbook:11632 "Measured parameters include latency to escape, path length, number of errors, and velocity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11632 "The test is used to evaluate cognitive deficits."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11632 goldbook:11702)
AnnotationAssertion(rdfs:seeAlso goldbook:11632 goldbook:11859)
AnnotationAssertion(mito:isMentionedBy goldbook:11632 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11632 "current"^^xsd:string)
Declaration(Class(goldbook:11633))
AnnotationAssertion(rdfs:label goldbook:11633 "Bayley scale")
AnnotationAssertion(dcterms:description goldbook:11633 "Range of scores on play tasks performed by infants age 0–3 years, intended to assess development of motor, cognitive, and language skills against norms for age-matched normal child development.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11633 "Bayley scales of infant development (BSID)")
AnnotationAssertion(mito:isMentionedBy goldbook:11633 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11633 "current"^^xsd:string)
Declaration(Class(goldbook:11634))
AnnotationAssertion(rdfs:label goldbook:11634 "beading")
AnnotationAssertion(dcterms:description goldbook:11634 "Focal bead-like swellings in dendrites and axons.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11634 "neuritic beading")
AnnotationAssertion(rdfs:comment goldbook:11634 "These swellings can be an early neuropathological sign in neuronal injury, e.g., in epilepsy, trauma, ischemia, aging, and neurodegenerative diseases."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11634 goldbook:11627)
AnnotationAssertion(rdfs:seeAlso goldbook:11634 goldbook:11926)
AnnotationAssertion(mito:isMentionedBy goldbook:11634 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11634 "current"^^xsd:string)
Declaration(Class(goldbook:11635))
AnnotationAssertion(rdfs:label goldbook:11635 "beam walking test")
AnnotationAssertion(dcterms:description goldbook:11635 "Assessment of the ability of an animal to remain upright and to walk on an elevated and relatively narrow beam.")
AnnotationAssertion(rdfs:comment goldbook:11635 "Unilateral brain injury tends to induce a hemiparesis-like effect which can cause the animal to slip to one side, usually that which is contralateral to the injury site."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11635 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11635 goldbook:11995)
AnnotationAssertion(mito:isMentionedBy goldbook:11635 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11635 "current"^^xsd:string)
Declaration(Class(goldbook:11636))
AnnotationAssertion(rdfs:label goldbook:11636 "Benton test")
AnnotationAssertion(dcterms:description goldbook:11636 "Procedure in which patterns on cards are memorized by a test subject who then attempts to recognize them on other cards presented subsequently.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11636 "Benton visual memory test")
AnnotationAssertion(rdfs:comment goldbook:11636 "The test measures short-term visual memory."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11636 "Test conditions have repeatedly been modified, and variations such as asking the subject to redraw the pattern are in use."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11636 goldbook:11925)
AnnotationAssertion(mito:isMentionedBy goldbook:11636 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11636 "current"^^xsd:string)
Declaration(Class(goldbook:11637))
AnnotationAssertion(rdfs:label goldbook:11637 "Biel water maze")
AnnotationAssertion(dcterms:description goldbook:11637 "A water labyrinth, described by Biel (1940), where rodents are forced to swim until they find a small underwater platform that allows them to escape.")
AnnotationAssertion(rdfs:comment goldbook:11637 "Used to study possible neurotoxic effects on spatial learning, memory and others."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11637 "The Cincinnati water maze is related to the Biel water maze."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11637 goldbook:11859)
AnnotationAssertion(rdfs:seeAlso goldbook:11637 goldbook:11948)
AnnotationAssertion(mito:isMentionedBy goldbook:11637 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11637 "current"^^xsd:string)
Declaration(Class(goldbook:11638))
AnnotationAssertion(rdfs:label goldbook:11638 "bipolar disorder")
AnnotationAssertion(dcterms:description goldbook:11638 "Psychiatric illness characterized by mood shifts with periods of severe depressive illness and one or more episodes of exaggerated activity levels (manic behavior).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11638 "manic-depressive disorder")
AnnotationAssertion(mito:isMentionedBy goldbook:11638 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11638 "current"^^xsd:string)
Declaration(Class(goldbook:11639))
AnnotationAssertion(rdfs:label goldbook:11639 "β-blocker")
AnnotationAssertion(dcterms:description goldbook:11639 "Any of a class of drugs that targets the $\\ce{\\upbeta\\!\\mbox{-}adrenergic receptor}$, interferes with binding of adrenalin and other related substances to the receptor, and weakens their effects.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenergic antagonist")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenergic blocking agent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenergic receptor antagonist")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenoreceptor antagonist")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-antagonist")
AnnotationAssertion(rdfs:seeAlso goldbook:11639 goldbook:11567)
AnnotationAssertion(rdfs:seeAlso goldbook:11639 goldbook:11570)
AnnotationAssertion(mito:isMentionedBy goldbook:11639 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11639 "current"^^xsd:string)
Declaration(Class(goldbook:11640))
AnnotationAssertion(rdfs:label goldbook:11640 "blood–brain barrier")
AnnotationAssertion(dcterms:description goldbook:11640 "Selectively permeable structure that restricts the exit of blood cells and many substances from the brain capillaries into the extracellular space of the brain.")
AnnotationAssertion(rdfs:comment goldbook:11640 "It consists of a layer of tightly packed cells (chiefly endothelial cells and astrocytes) and basement membrane, continuous along the brain capillaries."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11640 goldbook:11614)
AnnotationAssertion(rdfs:seeAlso goldbook:11640 goldbook:11647)
AnnotationAssertion(mito:isMentionedBy goldbook:11640 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11640 "current"^^xsd:string)
Declaration(Class(goldbook:11641))
AnnotationAssertion(rdfs:label goldbook:11641 "blood–cerebrospinal fluid barrier")
AnnotationAssertion(dcterms:description goldbook:11641 "Functional restriction by cells of the choroid plexus of transit of substances from the cerebrospinal fluid into the extracellular space of the brain.")
AnnotationAssertion(mito:isMentionedBy goldbook:11641 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11641 "current"^^xsd:string)
Declaration(Class(goldbook:11642))
AnnotationAssertion(rdfs:label goldbook:11642 "blood–retinal barrier")
AnnotationAssertion(dcterms:description goldbook:11642 "Functional restriction of transit of substances from the blood to the retina by non-fenestrated endothelial cells with tight junctions.")
AnnotationAssertion(mito:isMentionedBy goldbook:11642 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11642 "current"^^xsd:string)
Declaration(Class(goldbook:11643))
AnnotationAssertion(rdfs:label goldbook:11643 "Boston naming test")
AnnotationAssertion(dcterms:description goldbook:11643 "Procedure in which 60 pictures are shown to a subject who has to name them quickly.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11643 "BNT")
AnnotationAssertion(rdfs:comment goldbook:11643 "The BNT is a neuropsychological test and is used to study brain function and learning disabilities in children."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11643 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11643 "current"^^xsd:string)
Declaration(Class(goldbook:11644))
AnnotationAssertion(rdfs:label goldbook:11644 "brachial plexus")
AnnotationAssertion(dcterms:description goldbook:11644 "Bundle of nerve fibers that begins in the spine at the base of the neck, travels through the axilla (armpit region), and into the arm.")
AnnotationAssertion(rdfs:comment goldbook:11644 "Damage to these motor and sensory nerves affects muscle function and sensation in the arm and chest."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11644 goldbook:11912)
AnnotationAssertion(rdfs:seeAlso goldbook:11644 goldbook:12169)
AnnotationAssertion(mito:isMentionedBy goldbook:11644 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11644 "current"^^xsd:string)
Declaration(Class(goldbook:11645))
AnnotationAssertion(rdfs:label goldbook:11645 "bradycardia")
AnnotationAssertion(dcterms:description goldbook:11645 "Abnormally slow heart rate.")
AnnotationAssertion(rdfs:seeAlso goldbook:11645 goldbook:12117)
AnnotationAssertion(mito:isMentionedBy goldbook:11645 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11645 "current"^^xsd:string)
Declaration(Class(goldbook:11646))
AnnotationAssertion(rdfs:label goldbook:11646 "bradykinesia")
AnnotationAssertion(dcterms:description goldbook:11646 "Abnormally slow body movement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11646 "hypokinesia")
AnnotationAssertion(mito:isMentionedBy goldbook:11646 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11646 "current"^^xsd:string)
Declaration(Class(goldbook:11647))
AnnotationAssertion(rdfs:label goldbook:11647 "brain")
AnnotationAssertion(dcterms:description goldbook:11647 "That part of the central nervous system contained within the cranium.")
AnnotationAssertion(mito:isMentionedBy goldbook:11647 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11647 "current"^^xsd:string)
Declaration(Class(goldbook:11648))
AnnotationAssertion(rdfs:label goldbook:11648 "brain-derived neurotrophic factor")
AnnotationAssertion(dcterms:description goldbook:11648 "Protein secreted by the brain that acts on neurons in the central and peripheral nervous systems; a member of the neurotrophin family of growth factors, related to the nerve growth factor (NGF).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11648 "BDNF")
AnnotationAssertion(rdfs:comment goldbook:11648 "It is also secreted by contracting skeletal muscle and can be classified as a myokine."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11648 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11648 goldbook:11914)
AnnotationAssertion(rdfs:seeAlso goldbook:11648 goldbook:12003)
AnnotationAssertion(mito:isMentionedBy goldbook:11648 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11648 "current"^^xsd:string)
Declaration(Class(goldbook:11649))
AnnotationAssertion(rdfs:label goldbook:11649 "brain herniation")
AnnotationAssertion(dcterms:description goldbook:11649 "Movement of part of the brain across structures within the skull such as a shift across such structures as the falx cerebri, the tentorium cerebelli, and even sometimes through the foramen magnum in the base of the skull (through which the spinal cord connects with the brain).")
AnnotationAssertion(rdfs:comment goldbook:11649 "This is caused by high intracranial pressure and may have fatal results."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11649 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11649 goldbook:11768)
AnnotationAssertion(rdfs:seeAlso goldbook:11649 goldbook:11836)
AnnotationAssertion(rdfs:seeAlso goldbook:11649 goldbook:12126)
AnnotationAssertion(mito:isMentionedBy goldbook:11649 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11649 "current"^^xsd:string)
Declaration(Class(goldbook:11650))
AnnotationAssertion(rdfs:label goldbook:11650 "brain slice")
AnnotationAssertion(dcterms:description goldbook:11650 "Slice of brain tissue immersed in artificial cerebrospinal fluid, used in electrophysiology experiments to allow study of a synapse or neural circuit in isolation from the rest of the brain, and in metabolic studies, under controlled physiological conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:11650 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11650 goldbook:11919)
AnnotationAssertion(rdfs:seeAlso goldbook:11650 goldbook:12109)
AnnotationAssertion(mito:isMentionedBy goldbook:11650 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11650 "current"^^xsd:string)
Declaration(Class(goldbook:11651))
AnnotationAssertion(rdfs:label goldbook:11651 "brainstem")
AnnotationAssertion(dcterms:description goldbook:11651 "Unpaired subdivision of the brain, continuous with the spinal cord, that includes the thalamus, hypothalamus, pons, medulla oblongata, and the mesencephalon.")
AnnotationAssertion(rdfs:seeAlso goldbook:11651 goldbook:11647)
AnnotationAssertion(mito:isMentionedBy goldbook:11651 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11651 "current"^^xsd:string)
