AnnotationAssertion(dcterms:description goldbook:10675 "Sequence of events, where epithelial cells detach, migrate, and become mesenchymal stem cells that can differentiate.")
Declaration(Class(goldbook:10676))
AnnotationAssertion(rdfs:label goldbook:10676 "epoxide hydrolase")
AnnotationAssertion(dcterms:description goldbook:10676 "Detoxification enzyme (EC 3.3.2.9), located mainly in the endoplasmic reticulum, that hydrolyzes epoxides, converting them to metabolites that can be more rapidly excreted.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10676 "epoxide hydratase")
Declaration(Class(goldbook:10677))
