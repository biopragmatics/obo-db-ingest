AnnotationAssertion(rdfs:label goldbook:R05427 "ruby laser")
AnnotationAssertion(dcterms:description goldbook:R05427 "A pulsed source of coherent radiation emitting mainly at \\(\\pu{694.3 nm}\\) from chromium ions ($\\ce{Cr^{3+}}$) in aluminium oxide.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05427 goldbook:C01130)
