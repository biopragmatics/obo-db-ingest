AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04728 "current"^^xsd:string)
Declaration(Class(goldbook:P04730))
AnnotationAssertion(rdfs:label goldbook:P04730 "polygranular carbon")
AnnotationAssertion(dcterms:description goldbook:P04730 "A carbon material composed of grains, which can be clearly distinguished by means of optical microscopy.")
AnnotationAssertion(rdfs:comment goldbook:P04730 "Industrial carbon materials (such as electrodes) are mostly polygranular, but special grades are agranular materials, such as glass-like carbon, carbon fibres or pyrolytic carbon. Such materials are covered by the term agranular carbon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04730 goldbook:A00188)
AnnotationAssertion(rdfs:seeAlso goldbook:P04730 goldbook:C00831)
AnnotationAssertion(rdfs:seeAlso goldbook:P04730 goldbook:C00841)
AnnotationAssertion(rdfs:seeAlso goldbook:P04730 goldbook:G02639)
AnnotationAssertion(rdfs:seeAlso goldbook:P04730 goldbook:P04963)
AnnotationAssertion(mito:isMentionedBy goldbook:P04730 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04730 "current"^^xsd:string)
Declaration(Class(goldbook:P04731))
AnnotationAssertion(rdfs:label goldbook:P04731 "polygranular graphite")
AnnotationAssertion(dcterms:description goldbook:P04731 "A graphite material composed of grains which can be clearly distinguished by means of optical microscopy.")
AnnotationAssertion(rdfs:comment goldbook:P04731 "From the viewpoint of crystallinity, a polygranular graphite is always a polycrystalline graphite but not vice versa. Most industrial graphite materials are polygranular. Monogranular materials consist mostly of non-graphitic carbon, such materials are called monolithic or agranular carbons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04731 goldbook:A00188)
AnnotationAssertion(rdfs:seeAlso goldbook:P04731 goldbook:C01433)
AnnotationAssertion(rdfs:seeAlso goldbook:P04731 goldbook:G02684)
