AnnotationAssertion(rdfs:label goldbook:13198 "heavy chain")
AnnotationAssertion(dcterms:description goldbook:13198 "Larger of the two types of polypeptide chain found in immunoglobulin (Ig) molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13198 "H-chain")
AnnotationAssertion(rdfs:comment goldbook:13198 "Each heavy chain is linked by disulfide bonds to a light chain and to another, identical heavy chain. Each heavy chain consists of an Fc fragment and an Fd fragment. Heavy chains carry the antigenic determinants that differentiate the various immunoglobulin classes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13198 goldbook:13137)
AnnotationAssertion(rdfs:seeAlso goldbook:13198 goldbook:13139)
AnnotationAssertion(mito:isMentionedBy goldbook:13198 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13198 "current"^^xsd:string)
Declaration(Class(goldbook:13199))
AnnotationAssertion(rdfs:label goldbook:13199 "helper T lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13199 "Member of a subclass of T lymphocytes that provides help (in the form of cytokines and/or cognate interactions) necessary for the expression of effector function by other cells in the immune system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13199 "Th")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13199 "helper cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13199 "helper T cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13199 "T helper cell")
AnnotationAssertion(rdfs:comment goldbook:13199 "Helper T cells recognize antigen in association with major histocompatibility complex (MHC) class II gene products. Depending on their capacity to produce various cytokines, one can functionally differentiate Th1 [interleukin-2- (IL-2-) and IFN-γ-producing] and Th2 (interleukins IL-3-, IL-4-, and IL-6-producing) cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13199 goldbook:13163)
AnnotationAssertion(rdfs:seeAlso goldbook:13199 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13199 goldbook:13718)
