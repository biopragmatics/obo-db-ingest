AnnotationAssertion(rdfs:label goldbook:12154 "uncus")
AnnotationAssertion(dcterms:description goldbook:12154 "Anterior projection of the gray matter surrounding the hippocampus, covered by a region of the temporal lobe, involved in olfaction.")
AnnotationAssertion(rdfs:comment goldbook:12154 "Often a source of seizures accompanied by hallucinations and a sense of unpleasant odors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12154 "The uncus may herniate over the notch of the tentorium and compress the third cranial nerve."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12154 goldbook:11700)
AnnotationAssertion(rdfs:seeAlso goldbook:12154 goldbook:11799)
AnnotationAssertion(rdfs:seeAlso goldbook:12154 goldbook:11970)
