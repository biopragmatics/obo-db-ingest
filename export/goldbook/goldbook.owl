        <owl:annotatedTarget>ES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10652 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10652">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>encephalitis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10653 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10653">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital protrusion of brain tissue through a fissure or defect in the skull.</dcterms:description>
