        <oboInOwl:hasRelatedSynonym>achromasia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>achromatosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>albinism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10888"/>
    </owl:Class>
    


