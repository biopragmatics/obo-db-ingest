AnnotationAssertion(mito:isMentionedBy goldbook:16125 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16125 "current"^^xsd:string)
Declaration(Class(goldbook:16126))
AnnotationAssertion(rdfs:label goldbook:16126 "systematic sample")
AnnotationAssertion(dcterms:description goldbook:16126 "Subset selected according to some simple rule such as specified date or alphabetic classification.")
AnnotationAssertion(mito:isMentionedBy goldbook:16126 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16126 "current"^^xsd:string)
Declaration(Class(goldbook:16127))
AnnotationAssertion(rdfs:label goldbook:16127 "tachy-")
AnnotationAssertion(dcterms:description goldbook:16127 "Prefix meaning rapid as in tachycardia and tachypnoea.")
AnnotationAssertion(rdfs:seeAlso goldbook:16127 goldbook:16128)
