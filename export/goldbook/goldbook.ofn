Declaration(Class(goldbook:S05686))
AnnotationAssertion(rdfs:label goldbook:S05686 "single escape peak")
AnnotationAssertion(dcterms:description goldbook:S05686 "In a $\\upgamma\\!\\mbox{-}\\rm{ray\\ spectrum}$, the peak due to pair production in the detector and escape, from the sensitive part of the detector, of one of the photons of \\(511\\ \\rm{keV}\\) resulting from annihilation.")
