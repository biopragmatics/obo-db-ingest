[Term]
id: goldbook:E02072
name: enantiomerically pure
def: "A sample all of whose molecules have \(within limits of detection\) the same chirality sense. Use of homochiral as a synonym is strongly discouraged."
synonym: "enantiopure" []
synonym: "homochiral" []
property_value: mito:isMentionedBy doi:10.1351/pac199668122193
property_value: hasStatus "current" xsd:string
consider: goldbook:C01063

[Term]
id: goldbook:E02075
name: enantiomeric ratio
def: "The ratio of the percentage of one enantiomer in a mixture to that of the other e.g. \\\(70\\left\(\\!+\\!\\right\)\\\,\\colon\\\,30\\left\(\\!-\\!\\right\)\\\)."
property_value: mito:isMentionedBy doi:10.1351/pac199668122193
property_value: hasStatus "current" xsd:string
