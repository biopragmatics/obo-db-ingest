AnnotationAssertion(rdfs:label goldbook:S05825 "spectral radiant exitance")
AnnotationAssertion(dcterms:description goldbook:S05825 "The radiant exitance, \\(M\\), at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-3}\\), but a commonly used unit is \\(\\rm{W m}^{-2}\\ \\rm{nm}^{-1}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05825 goldbook:R05041)
