AnnotationAssertion(dcterms:description goldbook:10031 "Device used as an intermediary to compare examination standards.")
AnnotationAssertion(rdfs:comment goldbook:10031 "Sometimes, examination standards are used as transfer examination devices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10031 goldbook:10019)
AnnotationAssertion(mito:isMentionedBy goldbook:10031 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10031 "current"^^xsd:string)
Declaration(Class(goldbook:10032))
AnnotationAssertion(rdfs:label goldbook:10032 "intrinsic examination standard")
AnnotationAssertion(dcterms:description goldbook:10032 "Examination standard based on a reproducible nominal property of a phenomenon or substance.")
AnnotationAssertion(rdfs:comment goldbook:10032 "A nominal property value of an intrinsic examination standard is assigned by consensus and does not need to be established by relating it to another examination standard of the same type."^^xsd:string)
