AnnotationAssertion(rdfs:seeAlso goldbook:H02855 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:H02855 goldbook:H02854)
AnnotationAssertion(mito:isMentionedBy goldbook:H02855 doi:10.1351/pac199668122287)
