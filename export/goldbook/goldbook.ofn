Declaration(Class(goldbook:B00572))
AnnotationAssertion(rdfs:label goldbook:B00572 "β-decay")
AnnotationAssertion(dcterms:description goldbook:B00572 "Nuclear decay in which a β-particle is emitted or in which orbital electron capture occurs.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00572 goldbook:N04227)
AnnotationAssertion(rdfs:seeAlso goldbook:B00572 goldbook:E01980)
AnnotationAssertion(rdfs:seeAlso goldbook:B00572 goldbook:B00573)
