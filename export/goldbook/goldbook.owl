    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.H02774 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.H02774">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds having the general formula $\ce{R2C(OH)OR&apos;}$ ($\ce{R&apos;}  eq \ce{H}$).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>hemiacetals</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02776"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.L03438"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.H02775 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.H02775">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>$\ce{\upalpha\!\mbox{-}Amino}$ alcohols, improperly called carbinolamines (the adducts of ammonia, or of primary or secondary amines to the carbonyl group of aldehydes and ketones) $\ce{R2C(OH)NR2}$. Compounds of structure $\ce{R2C(OR&apos;)NR2}$ ($\ce{R}  eq \ce{H}$) are hemiaminal ethers, or $\ce{\upalpha\!\mbox{-}amino}$ ethers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>hemiaminals</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00204"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00270"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.A00274"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.E02221"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.K03386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.H02776 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.H02776">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hemiacetals having the structure $\ce{R2C(OH)OR}$ ($\ce{R}  eq \ce{H}$), derived from ketones by formal addition of an alcohol to the carbonyl group. This term, once abandoned, has been reinstated as a subclass of hemiacetals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>hemiketals</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02774"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.K03386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.H02778 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.H02778">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chloro(porphyrinato)iron(III) complexes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>hemins</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.H02773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.H02779 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.H02779">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Iron–porphyrin complexes, having one or two basic ligands (e.g. piperidine, amines).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
