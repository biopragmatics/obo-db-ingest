consider: goldbook:T06446

[Term]
id: goldbook:S05498
name: Schiff bases
def: "Imines bearing a hydrocarbyl group on the nitrogen atom $\\ce\{R2C=NR'\}$ \($\\ce\{R'\}  eq \\ce\{H\}$\). Considered by many to be synonymous with azomethines."
synonym: "Schiff's bases" []
property_value: mito:isMentionedBy doi:10.1351/pac199567081307
property_value: hasStatus "current" xsd:string
