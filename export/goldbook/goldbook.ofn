Declaration(Class(goldbook:S06005))
AnnotationAssertion(rdfs:label goldbook:S06005 "steroids")
AnnotationAssertion(dcterms:description goldbook:S06005 "Naturally occurring compounds and synthetic analogues, based on the cyclopenta[a]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at C-10 and C-13, and often an alkyl group at C-17. By extension, one or more bond scissions, ring expansions and/or ring contractions of the skeleton may have occurred. Natural steroids are derived biogenetically from triterpenoids.")
AnnotationAssertion(rdfs:seeAlso goldbook:S06005 goldbook:A00228)
AnnotationAssertion(rdfs:seeAlso goldbook:S06005 goldbook:T06510)
AnnotationAssertion(mito:isMentionedBy goldbook:S06005 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S06005 "current"^^xsd:string)
Declaration(Class(goldbook:S06006))
AnnotationAssertion(rdfs:label goldbook:S06006 "sterols")
AnnotationAssertion(dcterms:description goldbook:S06006 "Natural products derived from the steroid skeleton and containing a hydroxy group in the 3 position, closely related to cholestan-3-ol.")
AnnotationAssertion(rdfs:seeAlso goldbook:S06006 goldbook:S06005)
AnnotationAssertion(mito:isMentionedBy goldbook:S06006 doi:10.1351/pac199567081307)
