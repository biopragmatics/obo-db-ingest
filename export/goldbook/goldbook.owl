    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10645">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structure resembling an embryo which is formed by embryonic stem cells or teratocarcinoma cells when they are removed from a growth-promoting medium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>embryoid body</rdfs:label>
