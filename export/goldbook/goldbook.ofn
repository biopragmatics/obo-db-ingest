AnnotationAssertion(rdfs:label goldbook:S05696 "singlet-singlet absorption")
AnnotationAssertion(dcterms:description goldbook:S05696 "Absorption which results in the transition from the singlet ground state of the molecule into singlet excited states (\\(\\rm{S}_{0}\\) → \\(\\rm{S}_{\\rm{n}}\\)) and leads to the UV/visible absorption spectrum.")
