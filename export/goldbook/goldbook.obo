property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:12788
name: melting temperature
def: "Temperature at which the last trace of crystallinity disappears upon heating."
comment: "An experimentally determined melting temperature is not necessarily identical with the equilibrium melting temperature. See equilibrium melting temperature and Hoffman–Weeks plot."
comment: "Experimentally determined values of the melting temperature may depend on the method and the experimental conditions, for example, sample mass, heating rate, etc."
comment: "If \(T_{\rm{m}}\) is determined using DSC or DTA, then the characteristic temperature (Figure 2) used should be stated."
comment: "This temperature usually refers to the highest temperature of the melting range, i.e., when the last and therefore the most perfectly ordered crystals or the largest crystals melt."
synonym: "melting point" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-02
property_value: hasStatus "current" xsd:string
