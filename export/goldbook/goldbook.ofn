AnnotationAssertion(rdfs:label goldbook:13149 "fibrinolysis")
AnnotationAssertion(dcterms:description goldbook:13149 "Enzymatic lysis of a fibrin clot.")
AnnotationAssertion(mito:isMentionedBy goldbook:13149 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13149 "current"^^xsd:string)
Declaration(Class(goldbook:13150))
AnnotationAssertion(rdfs:label goldbook:13150 "fibrinolytic")
AnnotationAssertion(dcterms:description goldbook:13150 "Pertaining to, characterized by, or causing the breakdown of fibrin (fibrinolysis), usually by the action of plasmin.")
AnnotationAssertion(rdfs:seeAlso goldbook:13150 goldbook:13149)
AnnotationAssertion(mito:isMentionedBy goldbook:13150 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13150 "current"^^xsd:string)
Declaration(Class(goldbook:13151))
AnnotationAssertion(rdfs:label goldbook:13151 "first line of defence")
AnnotationAssertion(dcterms:description goldbook:13151 "Surface tissues, notably the skin, respiratory tract, and gastrointestinal tract.")
AnnotationAssertion(rdfs:comment goldbook:13151 "These tissues are rich in immunocompetent cells that form a first line of defense by recognizing pathogens, destroying them with secretory antibodies, or preventing their intrusion into the organism."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13151 "Internal organs may also have a first line of defense, e.g., the microglia have been considered as a first line of defense against brain infections."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13151 goldbook:13277)
AnnotationAssertion(mito:isMentionedBy goldbook:13151 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13151 "current"^^xsd:string)
Declaration(Class(goldbook:13152))
AnnotationAssertion(rdfs:label goldbook:13152 "flow cytometry")
AnnotationAssertion(dcterms:description goldbook:13152 "Method of sorting and measuring types of cells by fluorescent labeling of markers on the surface of the cells. It is sometimes referred to as fluorescence-assisted (or activated) cell sorting (FACS) analysis.")
AnnotationAssertion(mito:isMentionedBy goldbook:13152 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13152 "current"^^xsd:string)
Declaration(Class(goldbook:13153))
AnnotationAssertion(rdfs:label goldbook:13153 "fluorescein isothiocyanate")
AnnotationAssertion(dcterms:description goldbook:13153 "Green fluorescent dye used to 'tag' antibodies for use in immunofluorescence.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13153 "FITC")
AnnotationAssertion(rdfs:seeAlso goldbook:13153 goldbook:13285)
AnnotationAssertion(mito:isMentionedBy goldbook:13153 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13153 "current"^^xsd:string)
Declaration(Class(goldbook:13154))
AnnotationAssertion(rdfs:label goldbook:13154 "fluorescence-activated cell sorting")
AnnotationAssertion(dcterms:description goldbook:13154 "Fluorescence-assisted cell sorting.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13154 "FACS")
AnnotationAssertion(rdfs:seeAlso goldbook:13154 goldbook:13152)
AnnotationAssertion(mito:isMentionedBy goldbook:13154 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13154 "current"^^xsd:string)
Declaration(Class(goldbook:13155))
AnnotationAssertion(rdfs:label goldbook:13155 "fluorescent antibody")
AnnotationAssertion(dcterms:description goldbook:13155 "Antibody conjugated to a fluorescent dye such as fluorescein isothiocyanate (FITC).")
AnnotationAssertion(rdfs:seeAlso goldbook:13155 goldbook:13153)
AnnotationAssertion(mito:isMentionedBy goldbook:13155 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13155 "current"^^xsd:string)
Declaration(Class(goldbook:13156))
AnnotationAssertion(rdfs:label goldbook:13156 "follicular dendritic cell")
AnnotationAssertion(dcterms:description goldbook:13156 "Major histocompatibility complex (MHC) class II-negative Fc receptor-positive dendritic cell which bears immune complexes on its surface and is probably involved in the generation of antibody-secreting cells and maintenance of B-cell memory (see memory cell) in germinal centers.")
AnnotationAssertion(rdfs:comment goldbook:13156 "This is a different cell type from the dendritic cell."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13156 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13156 goldbook:13138)
AnnotationAssertion(rdfs:seeAlso goldbook:13156 goldbook:13432)
AnnotationAssertion(rdfs:seeAlso goldbook:13156 goldbook:13087)
AnnotationAssertion(rdfs:seeAlso goldbook:13156 goldbook:13172)
AnnotationAssertion(rdfs:seeAlso goldbook:13156 goldbook:13257)
AnnotationAssertion(rdfs:seeAlso goldbook:13156 goldbook:13452)
AnnotationAssertion(mito:isMentionedBy goldbook:13156 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13156 "current"^^xsd:string)
Declaration(Class(goldbook:13157))
AnnotationAssertion(rdfs:label goldbook:13157 "footpad test")
AnnotationAssertion(dcterms:description goldbook:13157 "Test for allergic contact dermatitis in which the test substance is injected into the front footpad of a guinea pig and challenge is performed seven days later.")
AnnotationAssertion(rdfs:seeAlso goldbook:13157 goldbook:12858)
AnnotationAssertion(rdfs:seeAlso goldbook:13157 goldbook:12997)
AnnotationAssertion(rdfs:seeAlso goldbook:13157 goldbook:13041)
AnnotationAssertion(mito:isMentionedBy goldbook:13157 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13157 "current"^^xsd:string)
Declaration(Class(goldbook:13158))
AnnotationAssertion(rdfs:label goldbook:13158 "Forssman antigen")
AnnotationAssertion(dcterms:description goldbook:13158 "Glycolipid heterophile antigen (globopentosylceramide) expressed on cell surfaces during embryonic and adult life in rodents and other mammals, and found in many pathogens, but probably not in humans.")
AnnotationAssertion(rdfs:comment goldbook:13158 "Anti-Forssman antibodies directed against the terminal sugar moiety are commonly found in plasma and may be involved in Guillain–Barré syndrome (GBS)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13158 "Anti-Forssman antibodies reportedly disrupt tight junction formation, apical-basal polarization, and cell adhesion."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13158 goldbook:13210)
AnnotationAssertion(mito:isMentionedBy goldbook:13158 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13158 "current"^^xsd:string)
Declaration(Class(goldbook:13159))
AnnotationAssertion(rdfs:label goldbook:13159 "framework region")
AnnotationAssertion(dcterms:description goldbook:13159 "One of several relatively conserved amino acid sequences that flank the hypervariable regions in immunoglobulin (Ig) and T-cell receptor (TCR) variable (V) regions and maintain a common overall structure for all V region domains.")
AnnotationAssertion(rdfs:seeAlso goldbook:13159 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13159 goldbook:13245)
AnnotationAssertion(rdfs:seeAlso goldbook:13159 goldbook:13773)
AnnotationAssertion(mito:isMentionedBy goldbook:13159 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13159 "current"^^xsd:string)
Declaration(Class(goldbook:13160))
AnnotationAssertion(rdfs:label goldbook:13160 "Freund’s adjuvant")
AnnotationAssertion(dcterms:description goldbook:13160 "Complete Freund’s adjuvant is an emulsion of aqueous antigen in mineral oil that contains heat-killed Mycobacteria.")
AnnotationAssertion(rdfs:comment goldbook:13160 "Incomplete Freund’s adjuvant lacks the Mycobacteria."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13160 "It can cause painful local inflammation and should be used with care."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13160 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13160 "current"^^xsd:string)
Declaration(Class(goldbook:13161))
AnnotationAssertion(rdfs:label goldbook:13161 "γ:δ T cell")
AnnotationAssertion(dcterms:description goldbook:13161 "Lymphocyte whose T-cell receptor (TCR) is a heterodimer of a \\(\\ce{\\upgamma\\mbox{-}chain}\\) and a \\(\\ce{\\updelta\\mbox{-}chain}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:13161 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13161 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13161 goldbook:13162)
AnnotationAssertion(mito:isMentionedBy goldbook:13161 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13161 "current"^^xsd:string)
Declaration(Class(goldbook:13162))
AnnotationAssertion(rdfs:label goldbook:13162 "γ:δ T-cell receptor")
AnnotationAssertion(dcterms:description goldbook:13162 "T-cell receptor (TCR) composed of two different glycoprotein chains, designated \\(\\upgamma\\) and \\(\\updelta\\), assembled in a \\(\\ce{\\upgamma\\mbox{:}\\updelta\\ heterodimer}\\).")
AnnotationAssertion(rdfs:comment goldbook:13162 "Cells bearing these receptors are called γ:δ T cells. The group of γ:δ T cells is much less common than α:β T cells, and usually found in the gut mucosa, in a population of lymphocytes known as intra-epithelial lymphocytes (IELs)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13162 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13162 goldbook:13342)
AnnotationAssertion(rdfs:seeAlso goldbook:13162 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13162 goldbook:13473)
AnnotationAssertion(rdfs:seeAlso goldbook:13162 goldbook:12826)
AnnotationAssertion(rdfs:seeAlso goldbook:13162 goldbook:13161)
AnnotationAssertion(mito:isMentionedBy goldbook:13162 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13162 "current"^^xsd:string)
Declaration(Class(goldbook:13163))
AnnotationAssertion(rdfs:label goldbook:13163 "γ-interferon")
AnnotationAssertion(dcterms:description goldbook:13163 "Member of a group of cytokines, the interferons, which has as its primary action the activation of macrophages and can induce cells to resist viral replication.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13163 "IFN-γ")
AnnotationAssertion(rdfs:comment goldbook:13163 "γ-interferon is a product of CD4+ Th1 cells, CD8+ T cells, and natural killer (NK) cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13163 goldbook:12974)
AnnotationAssertion(rdfs:seeAlso goldbook:13163 goldbook:12977)
AnnotationAssertion(rdfs:seeAlso goldbook:13163 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13163 goldbook:13718)
AnnotationAssertion(rdfs:seeAlso goldbook:13163 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:13163 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13163 goldbook:13499)
AnnotationAssertion(mito:isMentionedBy goldbook:13163 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13163 "current"^^xsd:string)
Declaration(Class(goldbook:13164))
AnnotationAssertion(rdfs:label goldbook:13164 "gp120")
AnnotationAssertion(dcterms:description goldbook:13164 "Viral glycoprotein, non-covalently associated with gp41 in the viral envelope of human immunodeficiency virus (HIV).")
AnnotationAssertion(rdfs:comment goldbook:13164 "The gp120 portion of the glycoprotein complex binds with high affinity to the cell-surface molecule CD4. Before fusion and entry of the virus, gp120 must bind to a coreceptor in the membrane of the host cell, for instance chemokine receptors (mainly CCR5)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13164 goldbook:12973)
AnnotationAssertion(rdfs:seeAlso goldbook:13164 goldbook:13049)
AnnotationAssertion(rdfs:seeAlso goldbook:13164 goldbook:13228)
AnnotationAssertion(mito:isMentionedBy goldbook:13164 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13164 "current"^^xsd:string)
Declaration(Class(goldbook:13165))
AnnotationAssertion(rdfs:label goldbook:13165 "gammaglobulin")
AnnotationAssertion(dcterms:description goldbook:13165 "One of a group of serum proteins, mostly immunoglobulins (Ig), which have the greatest mobility towards the cathode during electrophoresis.")
AnnotationAssertion(mito:isMentionedBy goldbook:13165 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13165 "current"^^xsd:string)
Declaration(Class(goldbook:13166))
AnnotationAssertion(rdfs:label goldbook:13166 "autoimmune gastritis")
AnnotationAssertion(dcterms:description goldbook:13166 "Autoimmune-mediated destruction of the gastric mucosa that may result in the development of pernicious anemia.")
AnnotationAssertion(rdfs:comment goldbook:13166 "Autoimmune gastritis is associated with autoantibodies to \\(\\ce{H^{+}}/\\ce{K^{+}}\\)-ATPase of gastric parietal cells as well as autoantibodies to the intrinsic factor produced by these cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13166 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13166 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13166 goldbook:13473)
AnnotationAssertion(rdfs:seeAlso goldbook:13166 goldbook:13557)
AnnotationAssertion(mito:isMentionedBy goldbook:13166 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13166 "current"^^xsd:string)
Declaration(Class(goldbook:13167))
AnnotationAssertion(rdfs:label goldbook:13167 "Gell and Coombs classification")
AnnotationAssertion(dcterms:description goldbook:13167 "Classification of immune mechanisms of tissue injury into four types: type I, immediate-type hypersensitivity reactions, mediated by interaction of immunoglobulin E (IgE) antibody and antigen causing the release of histamine and other mediators; type II, antibody-mediated hypersensitivity reactions, due to antibody–antigen interactions on cell surfaces; type III, immune complex, local or general inflammatory responses due to formation of circulating immune complexes and their deposition in tissues; and type IV cell-mediated hypersensitivity reactions, initiated by sensitized T lymphocytes either by release of lymphokines or by T-cell-mediated cytotoxicity [see cytotoxic T lymphocyte (CTL)].")
AnnotationAssertion(rdfs:seeAlso goldbook:13167 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13167 goldbook:13072)
AnnotationAssertion(rdfs:seeAlso goldbook:13167 goldbook:13241)
AnnotationAssertion(rdfs:seeAlso goldbook:13167 goldbook:13255)
AnnotationAssertion(rdfs:seeAlso goldbook:13167 goldbook:13257)
AnnotationAssertion(rdfs:seeAlso goldbook:13167 goldbook:13288)
AnnotationAssertion(rdfs:seeAlso goldbook:13167 goldbook:13415)
AnnotationAssertion(mito:isMentionedBy goldbook:13167 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13167 "current"^^xsd:string)
Declaration(Class(goldbook:13168))
AnnotationAssertion(rdfs:label goldbook:13168 "gene knockout")
AnnotationAssertion(dcterms:description goldbook:13168 "Method of disabling a specific gene by homologous recombination with an introduced DNA construct designed for that purpose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13168 "gene targeting")
AnnotationAssertion(rdfs:seeAlso goldbook:13168 goldbook:13365)
AnnotationAssertion(rdfs:seeAlso goldbook:13168 goldbook:13366)
