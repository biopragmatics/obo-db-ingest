AnnotationAssertion(dcterms:description goldbook:12155 "Neuron whose cell body lies in the cerebral cortex or brainstem and whose axon carries impulses to a lower motor neuron.")
AnnotationAssertion(rdfs:seeAlso goldbook:12155 goldbook:11627)
AnnotationAssertion(rdfs:seeAlso goldbook:12155 goldbook:11651)
AnnotationAssertion(rdfs:seeAlso goldbook:12155 goldbook:11855)
