AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08039 "analytical recovery")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08039 "recovery")
Declaration(Class(goldbook:08040))
AnnotationAssertion(rdfs:label goldbook:08040 "repeatability condition of measurement")
AnnotationAssertion(dcterms:description goldbook:08040 "Condition of measurement, out of a set of conditions that includes the same measurement procedure, same operators, same measuring system, same operating conditions, and same location, and replicate measurements on the same or similar objects over a short period of time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08040 "repeatability condition")
Declaration(Class(goldbook:08041))
AnnotationAssertion(rdfs:label goldbook:08041 "run bias")
