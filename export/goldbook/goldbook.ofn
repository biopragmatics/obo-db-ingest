AnnotationAssertion(dcterms:description goldbook:10754 """Of or relating to human or animal reproduction.
Of or relating to the genital organs.
Of or relating to the final stage of psychosexual maturation.""")
Declaration(Class(goldbook:10755))
AnnotationAssertion(rdfs:label goldbook:10755 "genitalia")
AnnotationAssertion(dcterms:description goldbook:10755 """Plural of genital.
Externally visible sex organs.""")
Declaration(Class(goldbook:10756))
AnnotationAssertion(rdfs:label goldbook:10756 "genital fold")
AnnotationAssertion(dcterms:description goldbook:10756 "Embryonic structure that will develop into the penis and scrotum in males or the labia in females.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10756 "genital ridge")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10756 "genitourinary ridge")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10756 "labioscrotal swelling")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10756 "urogenital ridge")
Declaration(Class(goldbook:10757))
AnnotationAssertion(rdfs:label goldbook:10757 "genital organ")
AnnotationAssertion(dcterms:description goldbook:10757 "Organ of reproduction or generation, both external and internal to the body.")
Declaration(Class(goldbook:10758))
AnnotationAssertion(rdfs:label goldbook:10758 "genital tract")
AnnotationAssertion(dcterms:description goldbook:10758 "Genital passages of the urogenital apparatus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10758 "genital duct")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10758 "reproductive tract")
Declaration(Class(goldbook:10759))
