AnnotationAssertion(mito:isMentionedBy goldbook:F02545 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02545 "current"^^xsd:string)
Declaration(Class(goldbook:F02546))
AnnotationAssertion(rdfs:label goldbook:F02546 "full energy peak")
AnnotationAssertion(dcterms:description goldbook:F02546 "Of a spectrum of radiation, the part of the spectral response curve corresponding to the total absorption in a detecting material of the energy of the detected radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:F02546 "total absorption peak")
AnnotationAssertion(rdfs:seeAlso goldbook:F02546 goldbook:A00036)
AnnotationAssertion(mito:isMentionedBy goldbook:F02546 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02546 "current"^^xsd:string)
Declaration(Class(goldbook:F02547))
AnnotationAssertion(rdfs:label goldbook:F02547 "fullerenes")
AnnotationAssertion(dcterms:description goldbook:F02547 "Compounds composed solely of an even number of carbon atoms, which form a cage-like fused-ring polycyclic system with twelve five-membered rings and the rest six-membered rings. The archetypal example isfullerene, where the atoms and bonds delineate a truncated icosahedron. The term has been broadened to include any closed cage structure consisting entirely of three-coordinate carbon atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02547 goldbook:C00769)
AnnotationAssertion(rdfs:seeAlso goldbook:F02547 goldbook:P04724)
AnnotationAssertion(mito:isMentionedBy goldbook:F02547 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02547 "current"^^xsd:string)
Declaration(Class(goldbook:F02548))
AnnotationAssertion(rdfs:label goldbook:F02548 "fulminates")
AnnotationAssertion(dcterms:description goldbook:F02548 "Compounds having the structure $\\ce{RON=C{:}}$. So called because fulminic acid (actually $\\ce{HC#N^{+}–O^{−}}$ formonitrile oxide) was previously considered to be $\\ce{HON=C{:}}$.Salts of fulminic acid, e.g. $\\ce{Na^{+}[–C#N^{+}O^{−}]}$.")
AnnotationAssertion(mito:isMentionedBy goldbook:F02548 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02548 "current"^^xsd:string)
Declaration(Class(goldbook:F02549))
AnnotationAssertion(rdfs:label goldbook:F02549 "fulvalenes")
AnnotationAssertion(dcterms:description goldbook:F02549 "The hydrocarbon fulvalene and its derivatives formed by substitution (and by extension, analogues formed by replacement of one or more carbon atoms of the fulvalene skeleton by a heteroatom).")
AnnotationAssertion(mito:isMentionedBy goldbook:F02549 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02549 "current"^^xsd:string)
Declaration(Class(goldbook:F02550))
AnnotationAssertion(rdfs:label goldbook:F02550 "fulvenes")
AnnotationAssertion(dcterms:description goldbook:F02550 "The hydrocarbon fulvene and its derivatives formed by substitution (and by extension, analogues formed by replacement of one or more carbon atoms of the fulvene skeleton by a heteroatom).")
AnnotationAssertion(mito:isMentionedBy goldbook:F02550 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02550 "current"^^xsd:string)
Declaration(Class(goldbook:F02551))
AnnotationAssertion(rdfs:label goldbook:F02551 "fume")
AnnotationAssertion(dcterms:description goldbook:F02551 "Fine solid particles (aerosol), predominantly less than \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter, which result from the condensation of vapour from some types of chemical reaction. Usually this is formed from the gaseous state generally after volatilization from melted substances and often accompanied by chemical reactions such as oxidation.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02551 goldbook:A00176)
AnnotationAssertion(rdfs:seeAlso goldbook:F02551 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:F02551 goldbook:V06632)
AnnotationAssertion(mito:isMentionedBy goldbook:F02551 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02551 "current"^^xsd:string)
Declaration(Class(goldbook:F02552))
AnnotationAssertion(rdfs:label goldbook:F02552 "fumes")
AnnotationAssertion(dcterms:description goldbook:F02552 "In popular usage, a term often taken to mean airborne effluents, unpleasant and malodorous, which might arise from chemical processes.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02552 goldbook:S05719)
AnnotationAssertion(mito:isMentionedBy goldbook:F02552 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02552 "current"^^xsd:string)
Declaration(Class(goldbook:F02553))
AnnotationAssertion(rdfs:label goldbook:F02553 "fumigation")
AnnotationAssertion(dcterms:description goldbook:F02553 "An atmospheric phenomenon in which pollution, retained by an inversion layer near its level of emission, is brought rapidly to ground level as the inversion breaks up. This term also applies to the exposure of material (e.g. grain) to chemicals to kill insects, etc.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02553 goldbook:I03146)
AnnotationAssertion(mito:isMentionedBy goldbook:F02553 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02553 "current"^^xsd:string)
Declaration(Class(goldbook:F02554))
AnnotationAssertion(rdfs:label goldbook:F02554 "functional class name")
AnnotationAssertion(dcterms:description goldbook:F02554 "A name that expresses the characteristic group as a class term written as a separate word following the name of a parent structure or a name derived from a parent structure. In the latter case, when the derived name is that for a substituent group (formerly called a 'radical'), the method has been called 'radicofunctional nomenclature'.")
AnnotationAssertion(mito:isMentionedBy goldbook:F02554 doi:10.1351/pac199971071327)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02554 "current"^^xsd:string)
Declaration(Class(goldbook:F02555))
AnnotationAssertion(rdfs:label goldbook:F02555 "functional group")
AnnotationAssertion(dcterms:description goldbook:F02555 "Organic compounds are thought of as consisting of a relatively unreactive backbone, for example a chain of \\(\\rm{sp}^{3}\\) hybridized carbon atoms, and one or several functional groups. The functional group is an atom, or a group of atoms that has similar chemical properties whenever it occurs in different compounds. It defines the characteristic physical and chemical properties of families of organic compounds.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02555 goldbook:B00574)
AnnotationAssertion(rdfs:seeAlso goldbook:F02555 goldbook:U06567)
AnnotationAssertion(mito:isMentionedBy goldbook:F02555 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02555 "current"^^xsd:string)
Declaration(Class(goldbook:F02556))
AnnotationAssertion(rdfs:label goldbook:F02556 "functional parent")
AnnotationAssertion(dcterms:description goldbook:F02556 "A structure the name of which implies the presence of one or more characteristic groups and which has one or more hydrogen atoms attached to at least one of its skeletal atoms or one of its characteristic groups, or in which at least one of its characteristic groups can form at least one kind of functional modification.")
AnnotationAssertion(rdfs:comment goldbook:F02556 "A parent hydride bearing a characteristic group denoted by a suffix, for example, cyclohexanol, is not considered to be a functional parent, but may be described as a 'functionalized parent hydride'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:F02556 goldbook:C00976)
AnnotationAssertion(rdfs:seeAlso goldbook:F02556 goldbook:P04405)
AnnotationAssertion(mito:isMentionedBy goldbook:F02556 doi:10.1351/pac199971071327)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02556 "current"^^xsd:string)
Declaration(Class(goldbook:F02558))
AnnotationAssertion(rdfs:label goldbook:F02558 "furanocoumarins")
AnnotationAssertion(dcterms:description goldbook:F02558 "An alternative name for furocoumarins.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02558 goldbook:F02562)
AnnotationAssertion(mito:isMentionedBy goldbook:F02558 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02558 "current"^^xsd:string)
Declaration(Class(goldbook:F02559))
AnnotationAssertion(rdfs:label goldbook:F02559 "furanoses")
AnnotationAssertion(dcterms:description goldbook:F02559 "Cyclic hemiacetal forms of monosaccharides in which the ring is five-membered (i.e. a tetrahydrofuran skeleton).")
AnnotationAssertion(rdfs:seeAlso goldbook:F02559 goldbook:M04021)
AnnotationAssertion(mito:isMentionedBy goldbook:F02559 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02559 "current"^^xsd:string)
Declaration(Class(goldbook:F02561))
AnnotationAssertion(rdfs:label goldbook:F02561 "furnace pyrolysis")
AnnotationAssertion(dcterms:description goldbook:F02561 "A flowing stream of gas (hydrogen, oxygen, nitrogen, chlorine, etc.) required to produce volatile species of the elements being determined, is passed over the test sample in a heated furnace. The analytes leave the furnace in the gas stream, or are entrained by a carrier gas. The analytes in the gas stream may be collected in an absorbing solution, on a carbon or other filter or by condensation on a cool surface. In the case of mercury this can also be done by amalgamation with a noble metal. The analytes may then be swept and released from the trap, by heating, into a sampling source for analysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02561 goldbook:C00863)
AnnotationAssertion(rdfs:seeAlso goldbook:F02561 goldbook:F02384)
AnnotationAssertion(rdfs:seeAlso goldbook:F02561 goldbook:T06285)
AnnotationAssertion(mito:isMentionedBy goldbook:F02561 doi:10.1351/pac198860091461)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02561 "current"^^xsd:string)
Declaration(Class(goldbook:F02562))
AnnotationAssertion(rdfs:label goldbook:F02562 "furocoumarins")
AnnotationAssertion(dcterms:description goldbook:F02562 "Derivatives (mostly of natural origin) of the linear furocoumarin skeleton, psoralen, or its angular isomer, angelicin, variously substituted with hydroxy, methoxy, alkyl, or hydroxymethyl groups, among others.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02562 goldbook:I03289)
AnnotationAssertion(mito:isMentionedBy goldbook:F02562 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02562 "current"^^xsd:string)
Declaration(Class(goldbook:F02563))
AnnotationAssertion(rdfs:label goldbook:F02563 "fusion")
AnnotationAssertion(dcterms:description goldbook:F02563 "The amalgamation of two distinct cells or macromolecules into a single integrated unit.")
AnnotationAssertion(mito:isMentionedBy goldbook:F02563 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02563 "current"^^xsd:string)
Declaration(Class(goldbook:F02564))
AnnotationAssertion(rdfs:label goldbook:F02564 "fusion name")
AnnotationAssertion(dcterms:description goldbook:F02564 "A composite name for a polycyclic parent structure having the maximum number of non-cumulative double bonds and at least one ortho fusion. Name formation involves the dissection of the structure into contiguous components having recognized trivial or semisystematic names, one of which is selected as the 'base component'. attachment of the other components is described by prefixes.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02564 goldbook:A00512)
AnnotationAssertion(rdfs:seeAlso goldbook:F02564 goldbook:CT07545)
AnnotationAssertion(rdfs:seeAlso goldbook:F02564 goldbook:C01437)
AnnotationAssertion(mito:isMentionedBy goldbook:F02564 doi:10.1351/pac199971071327)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02564 "current"^^xsd:string)
Declaration(Class(goldbook:FT06771))
AnnotationAssertion(rdfs:label goldbook:FT06771 "ferredoxin")
AnnotationAssertion(dcterms:description goldbook:FT06771 "A protein containing more than one iron and acid-labile sulfur, that displays electron-transfer activity but not classical enzyme function.")
AnnotationAssertion(rdfs:seeAlso goldbook:FT06771 goldbook:AT06794)
AnnotationAssertion(mito:isMentionedBy goldbook:FT06771 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT06771 "current"^^xsd:string)
Declaration(Class(goldbook:FT06786))
AnnotationAssertion(rdfs:label goldbook:FT06786 "Fenton reaction")
AnnotationAssertion(dcterms:description goldbook:FT06786 "$\\ce{Fe^{2+} + H2O2 -> Fe^{3+} + OH^{.} + OH^{−}}$ . This is the iron-salt-dependent decomposition of dihydrogen peroxide, generating the highly reactive hydroxyl radical, possibly via an oxoiron(IV) intermediate. Addition of a reducing agent, such as ascorbate, leads to a cycle which increases the damage to biological molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:FT06786 goldbook:HT06787)
AnnotationAssertion(rdfs:seeAlso goldbook:FT06786 goldbook:D01547)
AnnotationAssertion(rdfs:seeAlso goldbook:FT06786 goldbook:S05447)
AnnotationAssertion(mito:isMentionedBy goldbook:FT06786 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT06786 "current"^^xsd:string)
Declaration(Class(goldbook:FT06824))
AnnotationAssertion(rdfs:label goldbook:FT06824 "first-pass effect")
AnnotationAssertion(dcterms:description goldbook:FT06824 "Biotransformation and, in some cases, elimination of a substance in the liver after absorption from the intestine and before it reaches the systemic circulation.")
AnnotationAssertion(rdfs:seeAlso goldbook:FT06824 goldbook:B00667)
AnnotationAssertion(rdfs:seeAlso goldbook:FT06824 goldbook:E02038)
AnnotationAssertion(rdfs:seeAlso goldbook:FT06824 goldbook:ST06802)
AnnotationAssertion(mito:isMentionedBy goldbook:FT06824 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT06824 "current"^^xsd:string)
Declaration(Class(goldbook:FT06825))
AnnotationAssertion(rdfs:label goldbook:FT06825 "fractionation")
AnnotationAssertion(dcterms:description goldbook:FT06825 "Process of classification of an analyte or a group of analytes from a sample according to physical (e.g., size, solubility) or chemical (e.g., bonding, reactivity) properties.")
AnnotationAssertion(rdfs:seeAlso goldbook:FT06825 goldbook:S05740)
AnnotationAssertion(mito:isMentionedBy goldbook:FT06825 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT06825 "current"^^xsd:string)
Declaration(Class(goldbook:FT06876))
AnnotationAssertion(rdfs:label goldbook:FT06876 "fouling")
AnnotationAssertion(dcterms:description goldbook:FT06876 "Process resulting in loss of performance of a membrane due to the deposition of suspended or dissolved substances on its external surfaces, at its pore openings, or within its pores.")
AnnotationAssertion(rdfs:seeAlso goldbook:FT06876 goldbook:MT06878)
AnnotationAssertion(mito:isMentionedBy goldbook:FT06876 doi:10.1351/pac199668071479)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT06876 "current"^^xsd:string)
Declaration(Class(goldbook:FT07172))
AnnotationAssertion(rdfs:label goldbook:FT07172 "ferroelectric polymer")
AnnotationAssertion(dcterms:description goldbook:FT07172 "Polymer in which spontaneous polarization arises when dipoles become arranged parallel to each other by electric fields.")
AnnotationAssertion(rdfs:comment goldbook:FT07172 "Poly(vinylidene fluoride) after being subjected to a corona discharge is an example of a ferroelectric polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07172 goldbook:F02347)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07172 goldbook:P04712)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07172 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07172 "current"^^xsd:string)
Declaration(Class(goldbook:FT07173))
AnnotationAssertion(rdfs:label goldbook:FT07173 "ferromagnetic polymer")
AnnotationAssertion(dcterms:description goldbook:FT07173 "Polymer that exhibits magnetic properties because it has unpaired electron spins aligned parallel to each other or electron spins that can easily be so aligned.")
AnnotationAssertion(mito:isMentionedBy goldbook:FT07173 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07173 "current"^^xsd:string)
Declaration(Class(goldbook:FT07174))
AnnotationAssertion(rdfs:label goldbook:FT07174 "functional polymer")
AnnotationAssertion(dcterms:description goldbook:FT07174 "Polymer that bears specified chemical groups.Polymer that has specified physical, chemical, biological, pharmacological, or other uses which depend on specific chemical groups.")
AnnotationAssertion(rdfs:comment goldbook:FT07174 "Examples of functions of functional polymers (definition 2) are catalytic activity, selective binding of particular species, capture and transport of electric charge carriers or energy, conversion of light to charge carriers and vice versa, and transport of drugs to a particular organ in which the drug is released."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07174 goldbook:C00796)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07174 goldbook:D01863)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07174 goldbook:E01923)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07174 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07174 "current"^^xsd:string)
Declaration(Class(goldbook:FT07301))
AnnotationAssertion(rdfs:label goldbook:FT07301 "fibrillar morphology")
AnnotationAssertion(dcterms:description goldbook:FT07301 "Morphology in which phase domains have shapes with one dimension much larger than the other two dimensions.")
AnnotationAssertion(rdfs:comment goldbook:FT07301 "Fibrillar phase domains have the appearance of fibres."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07301 goldbook:MT07285)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07301 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07301 "current"^^xsd:string)
Declaration(Class(goldbook:FT07375))
AnnotationAssertion(rdfs:label goldbook:FT07375 "fatigue")
AnnotationAssertion(dcterms:description goldbook:FT07375 "Loss of performance over time, due to chemical degradation. The major cause of fatigue is oxidation.")
AnnotationAssertion(rdfs:comment goldbook:FT07375 "Although photochromism is a non-destructive process, side reactions can occur."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07375 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07375 goldbook:P04589)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07375 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07375 "current"^^xsd:string)
Declaration(Class(goldbook:FT07376))
AnnotationAssertion(rdfs:label goldbook:FT07376 "fluence rate")
AnnotationAssertion(dcterms:description goldbook:FT07376 "Total radiant power, \\(P\\), incident from all directions onto a small sphere divided by the cross-sectional area of that sphere. SI unit is \\(\\rm{W m}^{-2}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:FT07376 "radiant energy fluence rate")
AnnotationAssertion(rdfs:comment goldbook:FT07376 "Mathematical definition: \\(E_{\\rm{o}} = \\frac{\\rm{d}P}{\\rm{d}S} = \\frac{\\rm{d}H_{\\rm{o}}}{\\rm{d}t}\\). If the radiant power is constant over the area \\(S\\), \\(E_{\\rm{o}} = \\frac{P}{S}\\). Equivalent definition: \\(E_{\\rm{o}} = \\int_{4\\pi}L\\rm{d}\\varOmega\\), with \\(\\varOmega\\) the solid angle of each beam passing through the given point on the surface and \\(L\\) the radiance of the beam at that point."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07376 "Fluence rate is identical to spherical irradiance and reduces to irradiance, \\(E\\), for a parallel and perpendicularly incident beam not scattered or reflected by the target or its surroundings."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07376 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07376 goldbook:I03254)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07376 goldbook:R05037)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07376 goldbook:R05046)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07376 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07376 "current"^^xsd:string)
Declaration(Class(goldbook:FT07377))
AnnotationAssertion(rdfs:label goldbook:FT07377 "fluorescence lifetime")
AnnotationAssertion(dcterms:description goldbook:FT07377 "Parameter describing the time evolution of the decay of the fluorescent radiant intensity.")
AnnotationAssertion(rdfs:seeAlso goldbook:FT07377 goldbook:R05045)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07377 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07377 "current"^^xsd:string)
Declaration(Class(goldbook:FT07378))
AnnotationAssertion(rdfs:label goldbook:FT07378 "fluorescence resonance energy transfer")
AnnotationAssertion(dcterms:description goldbook:FT07378 "Term frequently and inappropriately applied to resonance energy transfer in the sense of Förster-resonance-energy transfer (FRET), which does not involve the emission of radiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:FT07378 "FRET")
AnnotationAssertion(rdfs:seeAlso goldbook:FT07378 goldbook:FT07381)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07378 goldbook:E02056)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07378 goldbook:R05333)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07378 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07378 "current"^^xsd:string)
Declaration(Class(goldbook:FT07379))
AnnotationAssertion(rdfs:label goldbook:FT07379 "fluorogenic")
AnnotationAssertion(dcterms:description goldbook:FT07379 "Property of a material in which fluorescence is induced or enhanced by the addition of another molecular entity.")
AnnotationAssertion(rdfs:comment goldbook:FT07379 "An example is a non-fluorescent compound consisting of a pyrene connected to a maleimide group (which quenches the pyrene fluorescence). A reaction in which the maleimide moiety is converted to a succinimide derivative results in the recovery of the pyrene fluorescence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07379 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07379 goldbook:M03968)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07379 goldbook:R05206)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07379 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07379 "current"^^xsd:string)
Declaration(Class(goldbook:FT07380))
AnnotationAssertion(rdfs:label goldbook:FT07380 "fluorophore")
AnnotationAssertion(dcterms:description goldbook:FT07380 "Molecular entity (often organic) that emits fluorescence.")
AnnotationAssertion(rdfs:seeAlso goldbook:FT07380 goldbook:F02453)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07380 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07380 "current"^^xsd:string)
Declaration(Class(goldbook:FT07381))
AnnotationAssertion(rdfs:label goldbook:FT07381 "Förster-resonance-energy transfer")
AnnotationAssertion(dcterms:description goldbook:FT07381 "Non-radiative excitation transfer between two molecular entities separated by distances considerably exceeding the sum of their van der Waals radii. It describes the transfer in terms of the interaction between the transition (dipole) moments of the entities in the very weak dipole-dipole coupling limit. It is a Coulombic interaction frequently called a dipole-dipole coupling. The transfer rate constant from donor to acceptor, \\(k_{\\rm{T}}\\), is given by \\[k_{\\rm{T}} = k_{\\rm{D}}\\left ( \\frac{R_{0}}{r} \\right )^{6}=\\frac{1}{\\tau _{D}^{0}}\\left ( \\frac{R_{0}}{r}\\right )^{6}\\] where \\(k_{\\rm{D}}\\) and \\(\\tau_{\\rm{D}}^{0}\\) are the emission rate constant and the lifetime of the excited donor in the absence of transfer, respectively, \\(r\\) is the distance between the donor and the acceptor and \\(R_{0}\\) is the critical quenching radius or Förster radius, i.e., the distance at which transfer and spontaneous decay of the excited donor are equally probable (\\(k_{\\rm{T}} = k_{\\rm{D}}\\)) (see Note 3). \\(R_{0}\\) is given by \\[R_{0} = Const.\\left ( \\frac{\\kappa^{2}\\mathit{\\Phi}_{D}^{0}J }{n^{4}} \\right )^{1/6}\\] where \\(\\kappa\\) is the orientation factor, \\(\\mathit{\\Phi} _{D}^{0}\\) is the fluorescence quantum yield of the donor in the absence of transfer, \\(n\\) is the average refractive index of the medium in the wavelength range where spectral overlap is significant, \\(J\\) is the spectral overlap integral reflecting the degree of overlap of the donor emission spectrum with the acceptor absorption spectrum and given by \\[J = \\int _{\\lambda }I_{\\lambda}^{D}(\\lambda)\\epsilon _{A}\\left ( \\lambda \\right )\\lambda^{4}\\rm{d}\\lambda\\] where \\(I_{\\lambda}^{D}(\\lambda)\\) is the normalized spectral radiant intensity of the donor so that \\(\\int_{\\lambda}I_{\\lambda}^{D}(\\lambda)\\rm{d}\\lambda = 1\\). \\(\\varepsilon_{\\rm{A}}({\\lambda})\\) is the molar decadic absorption coefficient of the acceptor. See Note 3 for the value of \\(Const.\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:FT07381 "FRET")
AnnotationAssertion(rdfs:comment goldbook:FT07381 "The bandpass \\(\\Delta \\lambda\\) is a constant in spectrophotometers and spectrofluorometers using gratings. Thus, the scale is linear in wavelength and it is convenient to express and calculate the integrals in wavelengths instead of wavenumbers in order to avoid confusion."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07381 "In practical terms, the integral \\(\\int_{\\lambda}I_{\\lambda}^{D}(\\lambda)\\rm{d}\\lambda\\) is the area under the plot of the donor emission intensity versus the emission wavelength."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07381 "A practical expression for \\(R_{0}\\) is: \\[\\frac{R_{0}}{\\pu{nm}} = \\pu{2.108E-2} \\left \\{\\kappa^{2}\\mathit{\\Phi}_{D}^{0}n^{-4} \\int_{\\lambda} I_{\\lambda}^{D}(\\lambda)\\left[ \\frac{\\epsilon_{A}(\\lambda)}{\\pu{dm3 mol-1 cm-1}} \\right] \\left(\\frac{\\lambda}{\\pu{nm}} \\right)^{4}{\\rm{d}}\\lambda \\right\\}^{1/6}\\] The orientation factor \\(\\kappa\\) is given by \\[\\kappa  = \\cos \\theta_{\\rm{DA}} - 3\\cos \\theta_{\\rm{D}}\\cos \\theta_{\\rm{A}} = \\sin \\theta_{\\rm{D}}\\sin \\theta_{\\rm{A}}\\varphi - 2\\cos \\theta_{\\rm{D}}\\cos \\theta_{\\rm{A}}\\] where \\(\\theta_{\\rm{DA}}\\) is the angle between the donor and acceptor moments, and \\(\\theta_{\\rm{D}}\\) and \\(\\theta_{\\rm{A}}\\) are the angles between these, respectively, and the separation vector; \\(\\varphi\\) is the angle between the projections of the transition moments on a plane perpendicular to the line through the centres. \\(\\kappa^{2}\\) can in principle take values from 0 (perpendicular transition moments) to 4 (collinear transition moments). When the transition moments are parallel and perpendicular to the separation vector, \\(\\kappa^{2} = 1\\). When they are in line (i.e., their moments are strictly along the separation vector), \\(\\kappa^{2} = 4\\). For randomly oriented transition (dipole) moments, e.g., in fluid solutions, \\(\\kappa^{2} = 2/3\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07381 "The transfer quantum efficiency is defined as \\[\\mathit{\\Phi} _{\\rm{T}} = \\frac{k_{\\rm{T}}}{k_{\\rm{D}}+k_{\\rm{T}}}\\] and can be related to the ratio\\(\\frac{r}{R_{0}}\\) as follows: \\[\\mathit{\\Phi} _{\\rm{T}} = \\frac{1}{1 + \\left ( \\frac{r}{R_{0}} \\right )^{6}}\\] or written in the following form:\\[\\mathit{\\Phi} _{\\rm{T}} = 1 - \\frac{\\tau_{\\rm{D}} }{\\tau_{\\rm{D}}^{0}}\\] where \\(\\tau_{\\rm{D}}\\) is the donor excited-state lifetime in the presence of acceptor, and \\(\\tau_{\\rm{D}}^{0}\\) in the absence of acceptor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07381 "FRET is sometimes inappropriately called fluorescence-resonance energy transfer. This is not correct because there is no fluorescence involved in FRET."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07381 "Foerster is an alternative and acceptable spelling for Förster."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:A00043)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:C01025)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:F02488)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:E02056)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:E02060)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:E02256)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:L03515)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:M03972)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:Q04988)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:Q04991)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:O04322)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:R05240)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:R05333)
