[Term]
id: goldbook:S05865
name: spin-flip transition
def: "A rotation of electron spins\, above a critical magnetic field\, \\\(H_\{\\rm\{c\}\}\\\)\, in an antiferromagnet from parallel to largely perpendicular alignment\, relative to an applied magnetic field\, \\\(H_\{\\rm\{a\}\}\\\)\, for \\\(H_\{\\rm\{a\}\}>H_\{\\rm\{c\}\}\\\)."
property_value: mito:isMentionedBy doi:10.1351/pac199466030577
property_value: hasStatus "current" xsd:string
