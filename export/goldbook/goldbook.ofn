Declaration(Class(goldbook:13612))
AnnotationAssertion(rdfs:label goldbook:13612 "properdin")
AnnotationAssertion(dcterms:description goldbook:13612 "Relatively heat-labile, normal serum protein (a euglobulin) that, in the presence of complement component C3 and magnesium ions, is involved in the alternative pathway of complement activation, and acts nonspecifically against Gram-negative bacteria and viruses and may contribute to the lysis of erythrocytes.")
AnnotationAssertion(rdfs:comment goldbook:13612 "It migrates as a β3-globulin and, although not an antibody, may act in conjunction with complement-fixing antibody."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13612 goldbook:12866)
AnnotationAssertion(rdfs:seeAlso goldbook:13612 goldbook:13127)
AnnotationAssertion(rdfs:seeAlso goldbook:13612 goldbook:13130)
AnnotationAssertion(mito:isMentionedBy goldbook:13612 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13612 "current"^^xsd:string)
Declaration(Class(goldbook:13613))
AnnotationAssertion(rdfs:label goldbook:13613 "proteasome")
AnnotationAssertion(dcterms:description goldbook:13613 "Cytoplasmic and nuclear multiprotein proteolytic complex involved in degradation of excess, damaged, or misfolded proteins.")
AnnotationAssertion(rdfs:comment goldbook:13613 "Cytoplasmic proteasome is important in antigen processing and presentation by major histocompatibility complex (MHC) molecules."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13613 goldbook:13434)
AnnotationAssertion(mito:isMentionedBy goldbook:13613 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13613 "current"^^xsd:string)
Declaration(Class(goldbook:13614))
AnnotationAssertion(rdfs:label goldbook:13614 "protectin")
AnnotationAssertion(dcterms:description goldbook:13614 "Member of the Ly-6 family of cell surface molecules that prevents insertion of the membrane attack complex (MAC) into the membrane, thereby protecting cells from complement-induced lysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13614 "CD59")
AnnotationAssertion(rdfs:seeAlso goldbook:13614 goldbook:13370)
AnnotationAssertion(rdfs:seeAlso goldbook:13614 goldbook:13450)
AnnotationAssertion(mito:isMentionedBy goldbook:13614 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13614 "current"^^xsd:string)
Declaration(Class(goldbook:13615))
AnnotationAssertion(rdfs:label goldbook:13615 "protective immunity")
AnnotationAssertion(dcterms:description goldbook:13615 "Protection against infectious agents conferred by vaccination.")
AnnotationAssertion(rdfs:seeAlso goldbook:13615 goldbook:13771)
AnnotationAssertion(mito:isMentionedBy goldbook:13615 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13615 "current"^^xsd:string)
