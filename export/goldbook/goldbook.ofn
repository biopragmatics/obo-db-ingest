AnnotationAssertion(rdfs:label goldbook:A00246 "allylic intermediates")
AnnotationAssertion(dcterms:description goldbook:A00246 "Carbanions, carbenium ions or radicals, formally derived by detachment of one hydron, hydride or hydrogen from the $\\ce{CH3}$ group of propene or derivatives thereof. E.g. $\\ce{H2C=CHCH2^{+}}$ allyl cation.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00246 goldbook:C00804)
