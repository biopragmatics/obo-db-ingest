AnnotationAssertion(rdfs:comment goldbook:11806 "When occurring in the brain, this is a hemorrhagic stroke."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11806 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11806 goldbook:12098)
AnnotationAssertion(mito:isMentionedBy goldbook:11806 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11806 "current"^^xsd:string)
