Declaration(Class(goldbook:P04715))
AnnotationAssertion(rdfs:label goldbook:P04715 "polarized interphases")
AnnotationAssertion(dcterms:description goldbook:P04715 "Ideally, interphases for which there are no common components between the phases or the exchange of these is hindered.")
AnnotationAssertion(mito:isMentionedBy goldbook:P04715 doi:10.1351/pac198355081251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04715 "current"^^xsd:string)
Declaration(Class(goldbook:P04720))
AnnotationAssertion(rdfs:label goldbook:P04720 "polyaddition")
AnnotationAssertion(dcterms:description goldbook:P04720 "A polymerization in which the growth of polymer chains proceeds by addition reactions between molecules of all degrees of polymerization.")
AnnotationAssertion(rdfs:comment goldbook:P04720 "The growth steps are expressed by: \\[\\rm{P}_{x} + \\rm{P}_{y}\\rightarrow \\rm{P}_{x + y}\\hspace{35pt} \\{x\\}\\in \\{1,2, \\dots \\infty\\}; \\{y\\}\\in \\{1,2, \\dots \\infty \\}\\] where \\(\\rm{P}_{x}\\) and \\(\\rm{P}_{y}\\) denote chains of degrees of polymerization \\(x\\) and \\(y\\), respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04720 "The earlier term 'addition polymerization' embraced both the current concepts of 'polyaddition' and 'chain polymerization', but did not include 'condensative chain polymerization'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04720 goldbook:C00946)
AnnotationAssertion(rdfs:seeAlso goldbook:P04720 goldbook:C00958)
AnnotationAssertion(rdfs:seeAlso goldbook:P04720 goldbook:D01569)
AnnotationAssertion(rdfs:seeAlso goldbook:P04720 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:P04720 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04720 "current"^^xsd:string)
Declaration(Class(goldbook:P04722))
AnnotationAssertion(rdfs:label goldbook:P04722 "polycondensation")
AnnotationAssertion(dcterms:description goldbook:P04722 "A polymerization in which the growth of polymer chains proceeds by condensation reactions between molecules of all degrees of polymerization.")
AnnotationAssertion(rdfs:comment goldbook:P04722 "The growth steps are expressed by: \\[\\rm{P}_{x} + \\rm{P}_{y}\\rightarrow \\rm{P}_{x + y} + L\\hspace{35pt} \\{x\\}\\in \\{1,2, \\dots \\infty\\}; \\{y\\}\\in \\{1,2, \\dots \\infty \\}\\] where \\(\\rm{P}_{x}\\) and \\(\\rm{P}_{y}\\) denote chains of degree of polymerization \\(x\\) and \\(y\\), respectively, and \\(\\rm{L}\\) a low-molar-mass by-product."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04722 "The earlier term 'polycondensation' was synonymous with 'condensation polymerization'. It should be noted that the current definitions of polycondensation and condensative chain polymerization were both embraced by the earlier term 'polycondensation'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04722 goldbook:C00946)
AnnotationAssertion(rdfs:seeAlso goldbook:P04722 goldbook:C00958)
AnnotationAssertion(rdfs:seeAlso goldbook:P04722 goldbook:D01569)
AnnotationAssertion(rdfs:seeAlso goldbook:P04722 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:P04722 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04722 "current"^^xsd:string)
Declaration(Class(goldbook:P04723))
AnnotationAssertion(rdfs:label goldbook:P04723 "polycrystalline graphite")
AnnotationAssertion(dcterms:description goldbook:P04723 "A graphite material with coherent crystallographic domains of limited size regardless of the perfection and preferred orientation (texture) of their crystalline structure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:P04723 "HOPG")
AnnotationAssertion(rdfs:comment goldbook:P04723 "The common use of the term polycrystalline graphite for polygranular graphite is in line with this definition but may be inexact because usually all grains of polygranular graphite are polycrystalline themselves. Polycrystalline graphite can exhibit a random orientation, more or less preferred orientation, or a highly oriented texture as in some pyrolytic graphites There is no sharp transition, however, between the typical polycrystalline texture and the 'single crystal-like' texture of highly oriented pyrolytic graphite (HOPG)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04723 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:P04723 goldbook:G02687)
AnnotationAssertion(rdfs:seeAlso goldbook:P04723 goldbook:H02823)
AnnotationAssertion(rdfs:seeAlso goldbook:P04723 goldbook:P04731)
AnnotationAssertion(rdfs:seeAlso goldbook:P04723 goldbook:P04964)
AnnotationAssertion(mito:isMentionedBy goldbook:P04723 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04723 "current"^^xsd:string)
Declaration(Class(goldbook:P04726))
AnnotationAssertion(rdfs:label goldbook:P04726 "polydisperse medium")
AnnotationAssertion(dcterms:description goldbook:P04726 "A colloidal system in which many particle sizes occur.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04726 goldbook:C01172)
AnnotationAssertion(mito:isMentionedBy goldbook:P04726 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04726 "current"^^xsd:string)
Declaration(Class(goldbook:P04728))
AnnotationAssertion(rdfs:label goldbook:P04728 "polyelectrolyte")
AnnotationAssertion(dcterms:description goldbook:P04728 "Polymer composed of macromolecules in which a substantial portion of the constitutional units contains ionic or ionizable groups, or both.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04728 "polymer electrolyte")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:P04728 "polymeric electrolyte")
AnnotationAssertion(rdfs:comment goldbook:P04728 "The terms polyelectrolyte, polymer electrolyte, and polymeric electrolyte should not be confused with the term solid polymer electrolyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:P04728 "Polyelectrolytes can be either synthetic or natural. nucleic acids, proteins, teichoic acids, some polypeptides, and some polysaccharides are examples of natural polyelectrolytes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04728 goldbook:N04245)
AnnotationAssertion(rdfs:seeAlso goldbook:P04728 goldbook:P04749)
AnnotationAssertion(rdfs:seeAlso goldbook:P04728 goldbook:P04752)
