AnnotationAssertion(dcterms:description goldbook:10321 "Intentional termination of a pregnancy with death of the embryo or fetus.")
Declaration(Class(goldbook:10322))
AnnotationAssertion(rdfs:label goldbook:10322 "spontaneous abortion")
