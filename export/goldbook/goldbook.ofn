Declaration(Class(goldbook:10660))
AnnotationAssertion(rdfs:label goldbook:10660 "endometrium")
AnnotationAssertion(dcterms:description goldbook:10660 "Inner lining of the uterus that is shed during menstruation.")
Declaration(Class(goldbook:10661))
AnnotationAssertion(rdfs:label goldbook:10661 "endothelium")
AnnotationAssertion(dcterms:description goldbook:10661 "Layer of flat cells that line the blood vessels, lymphatic vessels, and the chambers of the heart.")
Declaration(Class(goldbook:10662))
AnnotationAssertion(rdfs:label goldbook:10662 "environmental factor")
