AnnotationAssertion(obo:goldbook#hasStatus goldbook:12123 "current"^^xsd:string)
Declaration(Class(goldbook:12124))
AnnotationAssertion(rdfs:label goldbook:12124 "temperature sensitivity")
AnnotationAssertion(dcterms:description goldbook:12124 "Adverse responsiveness to heat or cold. Note: It is associated with a number of medical conditions, some physiologically well-defined (as in cold intolerance in hypothyroidism) and others less so (as in reported chronic fatigue syndrome). Phenotype arising from engineered or selected gene mutations in experimental organisms characterized by an altered temperature permissive for optimal growth or survival.")
AnnotationAssertion(mito:isMentionedBy goldbook:12124 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12124 "current"^^xsd:string)
Declaration(Class(goldbook:12125))
AnnotationAssertion(rdfs:label goldbook:12125 "temporal lobe")
AnnotationAssertion(dcterms:description goldbook:12125 "One of the four major lobes of each cerebral hemisphere, situated at the base of the brain.")
AnnotationAssertion(rdfs:comment goldbook:12125 "It is involved in memory, language comprehension, emotion, and processing sensory input."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12125 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:12125 goldbook:11854)
AnnotationAssertion(mito:isMentionedBy goldbook:12125 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12125 "current"^^xsd:string)
Declaration(Class(goldbook:12126))
