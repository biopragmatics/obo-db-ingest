AnnotationAssertion(dcterms:description goldbook:08361 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
Declaration(Class(goldbook:08362))
AnnotationAssertion(rdfs:label goldbook:08362 "HN(CO)CA")
AnnotationAssertion(dcterms:description goldbook:08362 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
Declaration(Class(goldbook:08363))
AnnotationAssertion(rdfs:label goldbook:08363 "HNCA")
AnnotationAssertion(dcterms:description goldbook:08363 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
Declaration(Class(goldbook:08364))
AnnotationAssertion(rdfs:label goldbook:08364 "HNCO")
AnnotationAssertion(dcterms:description goldbook:08364 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
Declaration(Class(goldbook:08365))
AnnotationAssertion(rdfs:label goldbook:08365 "homonuclear decoupling")
AnnotationAssertion(dcterms:description goldbook:08365 "Spin decoupling in nuclear magnetic resonance spectroscopy between two signals of the same nuclear isotope.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08365 "decoupling")
Declaration(Class(goldbook:08366))
AnnotationAssertion(rdfs:label goldbook:08366 "imaginary NMR spectrum")
AnnotationAssertion(dcterms:description goldbook:08366 "In nuclear magnetic resonance spectroscopy, one of two equally sized blocks of frequency data \\(\\pu{90\\!^{\\circ}}\\) out of phase to each other produced by Fourier transformation of the time domain signal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08366 "imaginary spectrum")
Declaration(Class(goldbook:08367))
AnnotationAssertion(rdfs:label goldbook:08367 "incredible natural-abundance double-quantum transfer experiment")
AnnotationAssertion(dcterms:description goldbook:08367 "Nuclear magnetic resonance spectroscopy experiment designed to show homonuclear spin-spin coupling correlations between low natural abundance nuclei such as \\(\\ce{^{13}C}\\).")
Declaration(Class(goldbook:08368))
AnnotationAssertion(rdfs:label goldbook:08368 "insensitive nuclei enhanced by polarization transfer")
AnnotationAssertion(dcterms:description goldbook:08368 "Pulse sequence in nuclear magnetic resonance spectroscopy that involves the transfer of nuclear spin polarization from spins with large Boltzmann population differences to nuclear spins of interest with low Boltzmann population differences.")
Declaration(Class(goldbook:08369))
AnnotationAssertion(rdfs:label goldbook:08369 "inversion pulse")
AnnotationAssertion(dcterms:description goldbook:08369 "Pulse in nuclear magnetic resonance spectroscopy that completely inverts the magnetization of a spin, e.g., \\(+z\\) to \\(-z\\).")
Declaration(Class(goldbook:08370))
AnnotationAssertion(rdfs:label goldbook:08370 "inversion recovery sequence")
AnnotationAssertion(dcterms:description goldbook:08370 "Spin echo sequence preceded by a \\(\\pu{180\\!^{\\circ}}\\) inversion pulse used to determine spin-lattice relaxation times in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08370 "inversion recovery")
Declaration(Class(goldbook:08371))
AnnotationAssertion(rdfs:label goldbook:08371 "inversion time")
AnnotationAssertion(dcterms:description goldbook:08371 "Time between the inversion pulse and the sampling pulse(s) in an inversion recovery sequence.")
Declaration(Class(goldbook:08372))
AnnotationAssertion(rdfs:label goldbook:08372 "J-modulated spin-echo")
AnnotationAssertion(dcterms:description goldbook:08372 "Nuclear magnetic resonance pulse sequence that refocuses spin vectors that have fanned out due to field inhomogeneity or chemical shift differences.")
Declaration(Class(goldbook:08373))
AnnotationAssertion(rdfs:label goldbook:08373 "J-resolved spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08373 "Two-dimensional nuclear magnetic resonance spectroscopy resolving chemical shift information in one dimension and spin-spin coupling in the second.")
Declaration(Class(goldbook:08374))
AnnotationAssertion(rdfs:label goldbook:08374 "Knight shift")
AnnotationAssertion(dcterms:description goldbook:08374 "Frequency shift in the nuclear magnetic resonance spectrum of a paramagnetic species that refers to the relative shift \\(\\boldsymbol{K}\\) in NMR frequency for atoms in a metal (e.g., sodium) compared with the same atoms in a nonmetallic environment (e.g., as a salt).")
Declaration(Class(goldbook:08375))
AnnotationAssertion(rdfs:label goldbook:08375 "Larmor angular frequency")
AnnotationAssertion(dcterms:description goldbook:08375 "Frequency at which nuclei with a nuclear spin precess (Larmor precession) around the direction of an external magnetic induction \\(\\boldsymbol{B}_{0}\\). \\(\\boldsymbol{\\omega}_{\\rm{L}} = -\\gamma \\boldsymbol{B}_{0}\\), where \\(\\gamma\\) is the magnetogyric ratio of the nucleus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08375 "Larmor frequency")
Declaration(Class(goldbook:08376))
AnnotationAssertion(rdfs:label goldbook:08376 "Larmor precession")
AnnotationAssertion(dcterms:description goldbook:08376 "Precession of the magnetic moment (\\(\\boldsymbol{M}\\)) of an object at an angular frequency, \\(\\boldsymbol{\\omega}_{\\rm{L}}\\), about a static magnetic induction (\\(\\boldsymbol{B_{0}}\\)), named after Joseph Larmor.")
Declaration(Class(goldbook:08377))
AnnotationAssertion(rdfs:label goldbook:08377 "magic angle spinning")
AnnotationAssertion(dcterms:description goldbook:08377 "Technique in solid-state nuclear magnetic resonance spectroscopy to remove or reduce the influence of anisotropic interactions by rapid sample rotation about the magic angle, where \\(\\boldsymbol{B_{0}}\\) is external magnetic induction and \\(\\uptheta\\) is the axis of rotation of the sample at an angle of approx. \\(\\pu{54.74\\!^{\\circ}}\\) to the external magnetic induction.")
Declaration(Class(goldbook:08378))
AnnotationAssertion(rdfs:label goldbook:08378 "multiple-quantum magic angle spinning NMR")
AnnotationAssertion(dcterms:description goldbook:08378 "Measurement method of nuclear magnetic resonance spectroscopy used to obtain high-resolution NMR spectra of quadrupolar nuclei by removal of the anisotropy of the quadrupole interaction, involving creating a triple-quantum (or \\(5{\\rm{Q}}\\)) coherence.")
Declaration(Class(goldbook:08379))
AnnotationAssertion(rdfs:label goldbook:08379 "multiplet")
AnnotationAssertion(dcterms:description goldbook:08379 "Feature in a nuclear magnetic resonance spectrum that is split but is too complex to easily interpret.")
Declaration(Class(goldbook:08380))
AnnotationAssertion(rdfs:label goldbook:08380 "net dephasing time")
AnnotationAssertion(dcterms:description goldbook:08380 "Measured time constant associated with spin-spin relaxation for loss of magnetization in the \\(xy\\) plane.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08380 "T2-star")
Declaration(Class(goldbook:08381))
AnnotationAssertion(rdfs:label goldbook:08381 "non-uniform sampling")
AnnotationAssertion(dcterms:description goldbook:08381 "Technique employed within a high dimensionality nuclear magnetic resonance spectroscopy experiment that acquires only a subset of the data points traditionally acquired linearly thus enabling a reduction in experiment time or an increased resolution in the resultant spectra.")
Declaration(Class(goldbook:08382))
AnnotationAssertion(rdfs:label goldbook:08382 "nuclear electric quadrupole moment")
AnnotationAssertion(dcterms:description goldbook:08382 "Parameter that describes the effective shape of the ellipsoid of nuclear charge distribution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08382 "quadrupole moment of a nucleus")
Declaration(Class(goldbook:08383))
AnnotationAssertion(rdfs:label goldbook:08383 "nuclear magnetic resonance relaxometry")
AnnotationAssertion(dcterms:description goldbook:08383 "Measurement method of nuclear magnetic resonance spectroscopy to measure nuclear relaxation variables.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08383 "relaxometry")
Declaration(Class(goldbook:08384))
AnnotationAssertion(rdfs:label goldbook:08384 "nuclear magnetic resonance spectrum")
AnnotationAssertion(dcterms:description goldbook:08384 "Representation of nuclear magnetic resonance spectroscopy data with at least one dimension a frequency domain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08384 "NMR spectrum")
Declaration(Class(goldbook:08385))
AnnotationAssertion(rdfs:label goldbook:08385 "nuclear Overhauser effect")
AnnotationAssertion(dcterms:description goldbook:08385 "Change of intensity of one resonance when the spin transitions of another are somehow perturbed from their equilibrium populations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08385 "nuclear Overhauser enhancement")
Declaration(Class(goldbook:08386))
AnnotationAssertion(rdfs:label goldbook:08386 "nuclear Overhauser effect difference spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08386 "One dimensional nuclear magnetic resonance spectroscopy that yields, through subtraction of spectra generated with and without selective excitation of a specific resonance, the nuclear Overhauser enhancement of nuclei spatially close to a selectively excited nucleus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08386 "nOe difference spectroscopy")
Declaration(Class(goldbook:08387))
AnnotationAssertion(rdfs:label goldbook:08387 "nuclear Overhauser effect spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08387 "Measurement method of nuclear magnetic resonance spectroscopy based on the nuclear Overhauser effect to observe nuclei that are close to each other in space.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08387 "nuclear Overhauser enhancement spectroscopy")
Declaration(Class(goldbook:08388))
AnnotationAssertion(rdfs:label goldbook:08388 "nuclear quadrupole resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08388 "Measurement method of nuclear magnetic resonance spectroscopy where splitting of the nuclear spin states is determined by the electrostatic interaction of the nuclear charge density with the external electric potential of the surrounding electron cloud.")
Declaration(Class(goldbook:08389))
AnnotationAssertion(rdfs:label goldbook:08389 "observation frequency")
AnnotationAssertion(dcterms:description goldbook:08389 "Frequency corresponding to the centre of the spectrum window for a given nucleus under observation and the nominal frequency used to generate the hard, full spectrum pulses.")
Declaration(Class(goldbook:08390))
AnnotationAssertion(rdfs:label goldbook:08390 "Pake doublet")
AnnotationAssertion(dcterms:description goldbook:08390 "Characteristic line shape seen in solid-state nuclear magnetic resonance spectroscopy arising from dipolar coupling between two nuclei.")
Declaration(Class(goldbook:08391))
AnnotationAssertion(rdfs:label goldbook:08391 "phase correction")
AnnotationAssertion(dcterms:description goldbook:08391 "Linear combination of the real and imaginary parts of a 1-D nuclear magnetic resonance spectrum to produce peaks with pure absorption mode line shape.")
Declaration(Class(goldbook:08392))
AnnotationAssertion(rdfs:label goldbook:08392 "phase cycling")
AnnotationAssertion(dcterms:description goldbook:08392 "Component of nuclear magnetic resonance spectroscopy experiment that repeats a pulse sequence changing only the phases of the pulse(s) and the phase-sensitive detector reference.")
Declaration(Class(goldbook:08393))
AnnotationAssertion(rdfs:label goldbook:08393 "powder pattern")
AnnotationAssertion(dcterms:description goldbook:08393 "Very broad and distinctive line shape seen in a static solid-state nuclear magnetic resonance spectroscopy experiment with a typical magnitude of \\(\\pu{E2}\\) to \\(\\pu{E5 Hz}\\).")
Declaration(Class(goldbook:08394))
AnnotationAssertion(rdfs:label goldbook:08394 "precession")
AnnotationAssertion(dcterms:description goldbook:08394 "Classical description of the behaviour of nuclear magnetic moments, in which the vectors rotate about the \\(\\boldsymbol{B_{0}}\\) axis at their Larmor angular frequencies.")
Declaration(Class(goldbook:08395))
AnnotationAssertion(rdfs:label goldbook:08395 "presaturation")
AnnotationAssertion(dcterms:description goldbook:08395 "Technique to suppress a particular nuclear magnetic resonance spectroscopy signal where a long low-power pulse is applied to that specific resonance prior to the main pulse sequence.")
Declaration(Class(goldbook:08396))
AnnotationAssertion(rdfs:label goldbook:08396 "pulse sequence")
AnnotationAssertion(dcterms:description goldbook:08396 "Timed series of radiofrequency pulses and magnetic field gradients that define a part or whole of a nuclear magnetic resonance spectroscopy experiment.")
Declaration(Class(goldbook:08397))
AnnotationAssertion(rdfs:label goldbook:08397 "pulsed-field gradient")
AnnotationAssertion(dcterms:description goldbook:08397 "Short, timed pulse in nuclear magnetic resonance spectroscopy that momentarily destroys the magnetic field homogeneity within the sample through a spatial-dependent field intensity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08397 "gradient pulse")
Declaration(Class(goldbook:08398))
AnnotationAssertion(rdfs:label goldbook:08398 "pure shift yielded by chirp excitation")
AnnotationAssertion(dcterms:description goldbook:08398 "Nuclear magnetic resonance spectroscopy experiment generating homonuclear spin-spin decoupled spectra.")
Declaration(Class(goldbook:08399))
AnnotationAssertion(rdfs:label goldbook:08399 "quadrature detection")
AnnotationAssertion(dcterms:description goldbook:08399 "Collection of time domain nuclear magnetic resonance spectroscopy data on both the \\(x\\) and \\(y\\ (\\rm{g})\\) axes of the rotating frame of reference to allow discrimination of positive and negative frequencies.")
Declaration(Class(goldbook:08400))
AnnotationAssertion(rdfs:label goldbook:08400 "quadrupolar nuclide")
AnnotationAssertion(dcterms:description goldbook:08400 "Nuclide with spin quantum number \\(I \\gt &half;\\) and a non-spherical distribution of charge in the nucleus giving rise to a nuclear electric quadrupole moment (\\(eQ\\)).")
Declaration(Class(goldbook:08401))
AnnotationAssertion(rdfs:label goldbook:08401 "quadrupolar relaxation")
AnnotationAssertion(dcterms:description goldbook:08401 "Relaxation mechanism in nuclear magnetic resonance spectroscopy arising from intramolecular quadrupolar interactions with electric field gradients.")
Declaration(Class(goldbook:08402))
AnnotationAssertion(rdfs:label goldbook:08402 "radiation damping")
AnnotationAssertion(dcterms:description goldbook:08402 "Line-broadening effect on intense signals in high field nuclear magnetic resonance spectroscopy.")
Declaration(Class(goldbook:08403))
AnnotationAssertion(rdfs:label goldbook:08403 "radiofrequency coil")
AnnotationAssertion(dcterms:description goldbook:08403 "In nuclear magnetic resonance spectroscopy, an inductor-capacitor resonant circuit used to set up \\(B_{1}\\) magnetic inductions in a sample and to detect the signal from the sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08403 "RF coil")
Declaration(Class(goldbook:08404))
AnnotationAssertion(rdfs:label goldbook:08404 "real spectrum")
AnnotationAssertion(dcterms:description goldbook:08404 "In nuclear magnetic resonance spectroscopy, one of two equally sized blocks of frequency data \\(\\pu{90\\!^{\\circ}}\\) out of phase to each other produced by Fourier transformation of the time domain signal.")
Declaration(Class(goldbook:08405))
AnnotationAssertion(rdfs:label goldbook:08405 "relaxation reagent")
AnnotationAssertion(dcterms:description goldbook:08405 "Paramagnetic species added to a sample in a nuclear magnetic resonance spectroscopy experiment to promote more rapid spin-lattice relaxation and allow a faster pulse repetition rate.")
Declaration(Class(goldbook:08406))
AnnotationAssertion(rdfs:label goldbook:08406 "repetition time")
AnnotationAssertion(dcterms:description goldbook:08406 "Time duration between repetitions of a nuclear magnetic resonance pulse sequence including the pulse sequence, acquisition time and relaxation delay.")
Declaration(Class(goldbook:08407))
AnnotationAssertion(rdfs:label goldbook:08407 "residual dipolar coupling")
AnnotationAssertion(dcterms:description goldbook:08407 "Dipolar coupling, but of a reduced magnitude to that seen in solids, observed in a liquid sample between spins in a molecule where there is incomplete averaging of spatially anisotropic dipolar couplings.")
Declaration(Class(goldbook:08408))
AnnotationAssertion(rdfs:label goldbook:08408 "rotating-frame NOE spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08408 "Measurement method of nuclear magnetic resonance spectroscopy yielding through-space correlations via spin-spin relaxation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08408 "cross-relaxation appropriate for minimolecules emulated by locked spins (CAMELPSIN)")
Declaration(Class(goldbook:08409))
AnnotationAssertion(rdfs:label goldbook:08409 "rotational echo double resonance")
AnnotationAssertion(dcterms:description goldbook:08409 "Measurement method of nuclear magnetic resonance spectroscopy allowing recoupling of heteronuclear dipolar coupling under magic angle spinning.")
Declaration(Class(goldbook:08410))
AnnotationAssertion(rdfs:label goldbook:08410 "saturation transfer difference spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08410 "Measurement method of nuclear magnetic resonance spectroscopy that allows detection of transient binding of small molecule ligands to macromolecular receptors.")
Declaration(Class(goldbook:08411))
AnnotationAssertion(rdfs:label goldbook:08411 "selective decoupling")
AnnotationAssertion(dcterms:description goldbook:08411 "Spin decoupling of a specific resonance by selective irradiation.")
Declaration(Class(goldbook:08412))
AnnotationAssertion(rdfs:label goldbook:08412 "selective excitation")
AnnotationAssertion(dcterms:description goldbook:08412 "Application of a frequency selective radiofrequency pulse(s) to a single resonance or a discrete band of frequencies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08412 "selective irradiation")
Declaration(Class(goldbook:08413))
AnnotationAssertion(rdfs:label goldbook:08413 "selective pulse")
AnnotationAssertion(dcterms:description goldbook:08413 "Radiofrequency pulse with a narrow frequency spectral bandwidth (long, low-power pulse) to excite nuclei in a limited chemical shift range (see selective excitation).")
Declaration(Class(goldbook:08414))
AnnotationAssertion(rdfs:label goldbook:08414 "single crystal nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08414 "Solid-state nuclear magnetic resonance spectroscopy on a single crystal in a similar manner to that used in X-ray diffraction.")
Declaration(Class(goldbook:08415))
AnnotationAssertion(rdfs:label goldbook:08415 "solid-state nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08415 "Application of nuclear magnetic resonance spectroscopy to solids.")
Declaration(Class(goldbook:08416))
AnnotationAssertion(rdfs:label goldbook:08416 "solvent suppression")
AnnotationAssertion(dcterms:description goldbook:08416 "In nuclear magnetic resonance spectroscopy reduction or removal of large, unwanted resonances from solvents to improve spectrum quality and dynamic range through selective excitation and exploiting differences in relaxation times between solvent and analyte signals.")
Declaration(Class(goldbook:08417))
AnnotationAssertion(rdfs:label goldbook:08417 "spectral width")
AnnotationAssertion(dcterms:description goldbook:08417 "Frequency range that describes the width of the spectrum window of a specific nucleus in nuclear magnetic resonance spectroscopy.")
Declaration(Class(goldbook:08418))
AnnotationAssertion(rdfs:label goldbook:08418 "spin")
AnnotationAssertion(dcterms:description goldbook:08418 "Intrinsic angular momentum of a nucleus (or other sub-atomic particle).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08418 "nuclear spin")
Declaration(Class(goldbook:08419))
AnnotationAssertion(rdfs:label goldbook:08419 "spin decoupling")
AnnotationAssertion(dcterms:description goldbook:08419 "Irradiation of a nucleus in nuclear magnetic resonance spectroscopy to prevent spin-spin coupling.")
Declaration(Class(goldbook:08420))
AnnotationAssertion(rdfs:label goldbook:08420 "spin echo")
AnnotationAssertion(dcterms:description goldbook:08420 "Refocusing of spin magnetization usually by two consecutive radiofrequency pulses.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08420 "Hahn echo")
Declaration(Class(goldbook:08421))
AnnotationAssertion(rdfs:label goldbook:08421 "spin system")
AnnotationAssertion(dcterms:description goldbook:08421 "Group of magnetic nuclei that interact amongst themselves through spin-spin coupling but do not interact with any nuclei outside the spin system.")
Declaration(Class(goldbook:08422))
AnnotationAssertion(rdfs:label goldbook:08422 "spin-lattice relaxation")
AnnotationAssertion(dcterms:description goldbook:08422 "Mechanism in nuclear magnetic resonance spectroscopy by which the component of the magnetization vector along the direction of the static magnetic induction reaches thermodynamic equilibrium with its surroundings through loss of energy of the excited nuclear spins to the surrounding molecular lattice. The resultant exponential decay of signal is characterized by the spin-lattice relaxation time \\(T_{1}\\) (reciprocal of the rate constant of this mechanism).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08422 "$T_1$ relaxation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08422 "$T1$ relaxation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08422 "longitudinal relaxation")
Declaration(Class(goldbook:08423))
AnnotationAssertion(rdfs:label goldbook:08423 "spin-lattice relaxation time")
AnnotationAssertion(dcterms:description goldbook:08423 "Reciprocal of the rate constant of longitudinal relaxation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08423 "spin-lattice time constant")
Declaration(Class(goldbook:08424))
AnnotationAssertion(rdfs:label goldbook:08424 "spinning sidebands")
AnnotationAssertion(dcterms:description goldbook:08424 "Satellite peaks in a nuclear magnetic resonance spectrum symetrically spaced either side of a main peak at a frequency offset related to the rate of spinning of the sample.")
Declaration(Class(goldbook:08425))
AnnotationAssertion(rdfs:label goldbook:08425 "spin-spin relaxation")
AnnotationAssertion(dcterms:description goldbook:08425 "Loss of magnetization in the \\(xy\\) plane (in the absence of \\(\\boldsymbol{B_{0}}\\) inhomogeneities) through the interchange of energy between nuclear spins resulting in some precessing faster than the Larmor angular frequency and some slower.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08425 "T2 relaxation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08425 "transverse relaxation")
Declaration(Class(goldbook:08426))
AnnotationAssertion(rdfs:label goldbook:08426 "spin-spin relaxation time")
AnnotationAssertion(dcterms:description goldbook:08426 "Reciprocal of the rate constant of spin-spin relaxation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08426 "transverse relaxation time")
Declaration(Class(goldbook:08427))
AnnotationAssertion(rdfs:label goldbook:08427 "static magnetic flux density")
AnnotationAssertion(dcterms:description goldbook:08427 "Flux density of the magnetic field of a nuclear magnetic resonance spectrometer about whose direction the nuclear magnetic moment precesses.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08427 "magnetic flux density")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08427 "static magnetic field")
Declaration(Class(goldbook:08428))
AnnotationAssertion(rdfs:label goldbook:08428 "symmetrization")
AnnotationAssertion(dcterms:description goldbook:08428 "Method of removing artefacts from a two-dimensional nuclear magnetic resonance spectrum that are symmetrical about the diagonal (e.g., HH COSY) or the \\(\\rm{f}1\\) axis (e.g., tilted J-resolved spectra). Values equidistant from midline are compared and replaced the lower (or average) value of the two.")
Declaration(Class(goldbook:08429))
AnnotationAssertion(rdfs:label goldbook:08429 "<em>t</em><sub>1</sub>")
AnnotationAssertion(dcterms:description goldbook:08429 "Time domain arising from the regular increments of the delay period in two-dimensional nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08429 "$t_1$ in 2-D NMR")
Declaration(Class(goldbook:08430))
AnnotationAssertion(rdfs:label goldbook:08430 "<em>t</em><sub>2</sub>")
AnnotationAssertion(dcterms:description goldbook:08430 "Time domain in two-dimensional nuclear magnetic resonance spectroscopy arising from direct free induction decay detection.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08430 "$t_2$ in 2-D NMR")
Declaration(Class(goldbook:08431))
AnnotationAssertion(rdfs:label goldbook:08431 "<em>t</em><sub>1</sub> noise")
AnnotationAssertion(dcterms:description goldbook:08431 "Streaks of spurious artefact signals in a two-dimensional nuclear magnetic resonance spectrum parallel to the \\(\\rm{f}1\\) axis at the \\(\\rm{f}2\\) of a strong resonance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08431 "$t_1$ noise in 2-D NMR")
Declaration(Class(goldbook:08432))
AnnotationAssertion(rdfs:label goldbook:08432 "three-dimensional nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08432 "Measurement method of nuclear magnetic resonance spectroscopy in which data are collected in three time domains.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08432 "3-D NMR")
Declaration(Class(goldbook:08433))
AnnotationAssertion(rdfs:label goldbook:08433 "time domain")
AnnotationAssertion(dcterms:description goldbook:08433 "Condition in nuclear magnetic resonance spectroscopy where the independent variable of all functions is time.")
Declaration(Class(goldbook:08434))
AnnotationAssertion(rdfs:label goldbook:08434 "time domain nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08434 "Measurement method of nuclear magnetic resonance spectroscopy run at low magnetic field strengths where data analysis is performed directly on the free induction decay, often through the extraction of relaxation time constants")
Declaration(Class(goldbook:08435))
AnnotationAssertion(rdfs:label goldbook:08435 "total correlation spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08435 "Two-dimensional nuclear magnetic resonance homonuclear correlation experiment, which creates correlations between all protons within a given spin system, not just between geminal or vicinal protons as in COSY.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08435 "homonuclear Hartmann-Hahn spectroscopy (HOHAHA)")
Declaration(Class(goldbook:08436))
AnnotationAssertion(rdfs:label goldbook:08436 "total suppression of spinning sidebands")
AnnotationAssertion(dcterms:description goldbook:08436 "Technique to suppress spinning sidebands in solid-state nuclear magnetic resonance spectroscopy with cross polarization in magic angle spinning experiments.")
Declaration(Class(goldbook:08437))
AnnotationAssertion(rdfs:label goldbook:08437 "transverse relaxation optimized spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08437 "Measurement method of nuclear magnetic resonance spectroscopy, usually in protein NMR, that improves peak sharpness for molecules having a molecular mass of greater than \\(\\pu{100 kDa}\\).")
Declaration(Class(goldbook:08438))
AnnotationAssertion(rdfs:label goldbook:08438 "triple-resonance nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08438 "Measurement method of nuclear magnetic resonance spectroscopy using three NMR-active nuclei.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08438 "triple-resonance NMR")
Declaration(Class(goldbook:08439))
AnnotationAssertion(rdfs:label goldbook:08439 "two-dimensional nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08439 "Measurement method of nuclear magnetic resonance spectroscopy in which data are collected in two time domains: acquisition of the free induction decay (\\(t_{2}\\)) and a successively incremented delay (\\(t_{1}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08439 "2-D NMR")
Declaration(Class(goldbook:08440))
AnnotationAssertion(rdfs:label goldbook:08440 "wideband, alternating-phase, low-power technique for residual splitting")
AnnotationAssertion(dcterms:description goldbook:08440 "Cluster of pulses applied repeatedly for heteronuclear decoupling.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08440 "WALTZ decoupling")
Declaration(Class(goldbook:08441))
AnnotationAssertion(rdfs:label goldbook:08441 "Zeeman levels")
AnnotationAssertion(dcterms:description goldbook:08441 "Energy levels of a nucleus arising from the interaction of its magnetic dipole with an external magnetic field.")
Declaration(Class(goldbook:08442))
AnnotationAssertion(rdfs:label goldbook:08442 "zero-field nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08442 "Measurement method of nuclear magnetic resonance spectroscopy in which nuclear magnetic resonance spectra are acquired in an environment carefully screened from magnetic fields, including from the Earth’s field allowing the direct detection of J-spectra in the absence of Zeeman interactions (see Zeeman levels).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08442 "zero-field NMR")
Declaration(Class(goldbook:08443))
AnnotationAssertion(rdfs:label goldbook:08443 "ablation by sputtering")
AnnotationAssertion(dcterms:description goldbook:08443 "Bombardment of a sample surface with ions resulting in the removal of atoms from their lattice sites, and thus an ongoing discharge process that causes continuous ablation of the sample.")
Declaration(Class(goldbook:08444))
AnnotationAssertion(rdfs:label goldbook:08444 "ablation efficiency")
AnnotationAssertion(dcterms:description goldbook:08444 "Mass of sample removed in laser-induced breakdown spectroscopy divided by the energy delivered by the laser beam.")
Declaration(Class(goldbook:08445))
AnnotationAssertion(rdfs:label goldbook:08445 "ablation rate")
AnnotationAssertion(dcterms:description goldbook:08445 "Depth of sample layer removed in the glow discharge process per unit time.")
Declaration(Class(goldbook:08446))
AnnotationAssertion(rdfs:label goldbook:08446 "ablation threshold fluence")
AnnotationAssertion(dcterms:description goldbook:08446 "Minimum fluence required to achieve ablation of the sample.")
Declaration(Class(goldbook:08447))
AnnotationAssertion(rdfs:label goldbook:08447 "acid transient effects")
AnnotationAssertion(dcterms:description goldbook:08447 "Increase in signal equilibration time or in wash out time caused by a modification in inorganic acid concentration.")
Declaration(Class(goldbook:08448))
AnnotationAssertion(rdfs:label goldbook:08448 "additional gases")
AnnotationAssertion(dcterms:description goldbook:08448 "Gases added to a combustion mixture.")
Declaration(Class(goldbook:08449))
AnnotationAssertion(rdfs:label goldbook:08449 "aerosol transport phenomena")
AnnotationAssertion(dcterms:description goldbook:08449 "Processes occurring inside the spray chamber or desolvation system responsible for the modification of the primary aerosol to finally yield the tertiary aerosol.")
Declaration(Class(goldbook:08450))
AnnotationAssertion(rdfs:label goldbook:08450 "analyte transport rate")
AnnotationAssertion(dcterms:description goldbook:08450 "Mass of analyte reaching the plasma per unit time.")
Declaration(Class(goldbook:08451))
AnnotationAssertion(rdfs:label goldbook:08451 "atomic absorption spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08451 "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the absorption of characteristic electromagnetic radiation by atoms in the vapour phase.")
Declaration(Class(goldbook:08452))
AnnotationAssertion(rdfs:label goldbook:08452 "atomic emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08452 "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the intensity of characteristic electromagnetic radiation emitted by atoms or molecules.")
Declaration(Class(goldbook:08453))
AnnotationAssertion(rdfs:label goldbook:08453 "atomic excitation source")
AnnotationAssertion(dcterms:description goldbook:08453 "Atomizer intended to convert free atoms to an excited state.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08453 "excitation source")
Declaration(Class(goldbook:08454))
AnnotationAssertion(rdfs:label goldbook:08454 "atomic fluorescence spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08454 "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the re-emission of characteristic electromagnetic radiation by atoms, following the absorption of radiation in the vapour phase.")
Declaration(Class(goldbook:08455))
AnnotationAssertion(rdfs:label goldbook:08455 "atomic vapour")
AnnotationAssertion(dcterms:description goldbook:08455 "Vapour containing free atoms of analyte.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08455 "atomic vapor")
Declaration(Class(goldbook:08456))
AnnotationAssertion(rdfs:label goldbook:08456 "atomization curve")
AnnotationAssertion(dcterms:description goldbook:08456 "Graph of absorbance against atomization temperature.")
Declaration(Class(goldbook:08457))
AnnotationAssertion(rdfs:label goldbook:08457 "axial viewing mode")
AnnotationAssertion(dcterms:description goldbook:08457 "Inductively-coupled plasma optical emission spectrometer configuration in which the entrance slit is aligned with the main plasma axis.")
Declaration(Class(goldbook:08458))
AnnotationAssertion(rdfs:label goldbook:08458 "background continuum emission")
AnnotationAssertion(dcterms:description goldbook:08458 "Intense continuous background usually observed in laser-induced breakdown spectra.")
Declaration(Class(goldbook:08459))
AnnotationAssertion(rdfs:label goldbook:08459 "background equivalent concentration")
AnnotationAssertion(dcterms:description goldbook:08459 "Concentration of a given element measured at a given wavelength providing the same intensity as the background.")
Declaration(Class(goldbook:08460))
AnnotationAssertion(rdfs:label goldbook:08460 "breakdown threshold fluence")
AnnotationAssertion(dcterms:description goldbook:08460 "Minimum fluence required to achieve measurable emission signals")
Declaration(Class(goldbook:08461))
AnnotationAssertion(rdfs:label goldbook:08461 "capacitive microwave plasma")
AnnotationAssertion(dcterms:description goldbook:08461 "Plasma generated by a capacitor in presence of a microwave field.")
Declaration(Class(goldbook:08462))
AnnotationAssertion(rdfs:label goldbook:08462 "characteristic line")
AnnotationAssertion(dcterms:description goldbook:08462 "Spectral line of an atom used for the measurement of analyte concentration by atomic spectroscopy.")
Declaration(Class(goldbook:08463))
AnnotationAssertion(rdfs:label goldbook:08463 "continuum source")
AnnotationAssertion(dcterms:description goldbook:08463 "Source that emits electromagnetic radiation with relatively constant intensity over a broad spectral region.")
Declaration(Class(goldbook:08464))
AnnotationAssertion(rdfs:label goldbook:08464 "depth-profiling")
AnnotationAssertion(dcterms:description goldbook:08464 "Process by which the sample is sputtered 'atomic layer by layer' using suitable conditions.")
Declaration(Class(goldbook:08465))
AnnotationAssertion(rdfs:label goldbook:08465 "direct current glow discharge optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08465 "Measurement method using optical emission spectroscopy in which atomization and excitation occur in a glow electric discharge sustained by a direct current electric field.")
Declaration(Class(goldbook:08466))
AnnotationAssertion(rdfs:label goldbook:08466 "dispersion of a sample")
AnnotationAssertion(dcterms:description goldbook:08466 "Conversion of the whole or part of a liquid or solid sample into a physical form sufficiently finely divided to allow it to be atomized (see atomization) upon introduction into the atomizer.")
Declaration(Class(goldbook:08467))
AnnotationAssertion(rdfs:label goldbook:08467 "double-pulse laser-induced breakdown spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08467 "Measurement method of laser-induced breakdown spectroscopy in which reactions are induced by the interaction of the evolved plasma and the remaining part of the laser pulse, or with a following laser pulse provided from a second laser system.")
Declaration(Class(goldbook:08468))
AnnotationAssertion(rdfs:label goldbook:08468 "dual viewing mode")
AnnotationAssertion(dcterms:description goldbook:08468 "Inductively-coupled plasma spectrometer that allows axial viewing mode or radial viewing mode.")
Declaration(Class(goldbook:08469))
AnnotationAssertion(rdfs:label goldbook:08469 "electric discharge")
AnnotationAssertion(dcterms:description goldbook:08469 "Transmission of electrical current by a plasma in an applied electric field through a normally non-conducting medium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08469 "discharge")
Declaration(Class(goldbook:08470))
AnnotationAssertion(rdfs:label goldbook:08470 "electron number density")
AnnotationAssertion(dcterms:description goldbook:08470 "Number of free electrons in vapour phase per volume unit.")
Declaration(Class(goldbook:08471))
AnnotationAssertion(rdfs:label goldbook:08471 "electrothermal atomic absorption spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08471 "Measurement method of atomic absorption spectroscopy in which the sample is atomized by an electrothermal atomizer.")
Declaration(Class(goldbook:08472))
AnnotationAssertion(rdfs:label goldbook:08472 "electrothermal vaporization")
AnnotationAssertion(dcterms:description goldbook:08472 "Technique for sample introduction based on the use of a solid furnace heated at a controlled temperature to vaporize the sample prior to its introduction into an inductively-coupled plasma.")
Declaration(Class(goldbook:08473))
AnnotationAssertion(rdfs:label goldbook:08473 "<em>E</em><sub>sum</sub>")
AnnotationAssertion(dcterms:description goldbook:08473 "Energy that must be supplied to an atom to transfer it from the ground atomic state to a given ionic excited state.")
Declaration(Class(goldbook:08474))
AnnotationAssertion(rdfs:label goldbook:08474 "flame atomic spectrometer")
AnnotationAssertion(dcterms:description goldbook:08474 "Spectrometer to make measurements by flame atomic spectroscopy.")
Declaration(Class(goldbook:08475))
AnnotationAssertion(rdfs:label goldbook:08475 "flame atomic spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08475 "Measurement method of atomic spectroscopy that uses a flame to excite atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08475 "flame atomic spectrometry")
Declaration(Class(goldbook:08476))
AnnotationAssertion(rdfs:label goldbook:08476 "flame")
AnnotationAssertion(dcterms:description goldbook:08476 "Continuously flowing mixture of hot gases with a stationary position that derives its heat content from a strongly exothermic, irreversible chemical reaction between a fuel and an oxidant.")
Declaration(Class(goldbook:08477))
AnnotationAssertion(rdfs:label goldbook:08477 "flow spoiler")
AnnotationAssertion(dcterms:description goldbook:08477 "Component of a flame atomic spectrometer for creating turbulence in the stream of mist in the spray chamber and removing the largest droplets from this mist by deposition.")
Declaration(Class(goldbook:08478))
AnnotationAssertion(rdfs:label goldbook:08478 "gate delay")
AnnotationAssertion(dcterms:description goldbook:08478 "Time between the application of a laser pulse and the start of detection in laser-induced breakdown spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08478 "time delay in laser induced breakdown spectroscopy")
Declaration(Class(goldbook:08479))
AnnotationAssertion(rdfs:label goldbook:08479 "GD-OES spectrometers with simultaneous detection")
AnnotationAssertion(dcterms:description goldbook:08479 "Spectrometers for glow discharge optical emission spectroscopy that allow simultaneous monitoring of selected spectral ranges or the whole emission spectra.")
Declaration(Class(goldbook:08480))
AnnotationAssertion(rdfs:label goldbook:08480 "generator coupling efficiency")
AnnotationAssertion(dcterms:description goldbook:08480 "Fraction of the energy generated being used for creating and maintaining the plasma in an inductively-coupled plasma spectrometer.")
Declaration(Class(goldbook:08481))
AnnotationAssertion(rdfs:label goldbook:08481 "glow discharge source")
AnnotationAssertion(dcterms:description goldbook:08481 "Component of an atomic emission spectrometer employing a glow electric discharge used in atomic emission spectroscopy for qualitative and quantitative analysis of solid materials.")
Declaration(Class(goldbook:08482))
AnnotationAssertion(rdfs:label goldbook:08482 "glow electric discharge")
AnnotationAssertion(dcterms:description goldbook:08482 "Electric discharge in gas at low pressure (\\(\\pu{100}\\) to \\(\\pu{1000 Pa}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08482 "glow discharge")
Declaration(Class(goldbook:08483))
AnnotationAssertion(rdfs:label goldbook:08483 "glow-discharge optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08483 "Optical emission spectroscopy in which a glow electric discharge excites atoms at the surface of a sample, which is made the cathode of the discharge.")
Declaration(Class(goldbook:08484))
AnnotationAssertion(rdfs:label goldbook:08484 "Grimm-type cathode")
AnnotationAssertion(dcterms:description goldbook:08484 "Cathode for a glow electric discharge consisting of a flat sample, which is cooled during the discharge process so that thermal volatilization is suppressed and the sample material is removed by sputtering only.")
Declaration(Class(goldbook:08485))
AnnotationAssertion(rdfs:label goldbook:08485 "hollow-cathode discharge source")
AnnotationAssertion(dcterms:description goldbook:08485 "Glow discharge source with a graphite cathode, into which the sample is inserted in the form of drillings, a pressed pellet or a dry solution residue.")
Declaration(Class(goldbook:08486))
AnnotationAssertion(rdfs:label goldbook:08486 "hollow-cathode lamp")
AnnotationAssertion(dcterms:description goldbook:08486 "Glow discharge source of spectral lines of an atom in which the cathode is made of the desired element.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08486 "line source")
Declaration(Class(goldbook:08487))
AnnotationAssertion(rdfs:label goldbook:08487 "incident power")
AnnotationAssertion(dcterms:description goldbook:08487 "Power supplied by a generator to the plasma.")
Declaration(Class(goldbook:08488))
AnnotationAssertion(rdfs:label goldbook:08488 "inductively-coupled plasma")
AnnotationAssertion(dcterms:description goldbook:08488 "Plasma produced by induction by means of a high-frequency (about \\(\\pu{2500 Hz}\\)) electromagnetic field. The region of gas at high temperature and free from the field is taken as the region of observation.")
Declaration(Class(goldbook:08489))
AnnotationAssertion(rdfs:label goldbook:08489 "inductively-coupled plasma spectrometry")
AnnotationAssertion(dcterms:description goldbook:08489 "Measurement method of atomic spectroscopy that uses an inductively-coupled plasma to excite and ionize atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08489 "inductively-coupled plasma spectroscopy")
Declaration(Class(goldbook:08490))
AnnotationAssertion(rdfs:label goldbook:08490 "inductively-coupled plasma mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:08490 "Measurement method of atomic spectrometry that uses an inductively-coupled plasma to excite and ionize atoms with measurement of the number and kind of ions in the plasma using mass spectrometry.")
Declaration(Class(goldbook:08491))
AnnotationAssertion(rdfs:label goldbook:08491 "inductively-coupled plasma optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08491 "Measurement method of atomic spectroscopy that uses an inductively-coupled plasma to excite and ionize atoms with measurement of the number and kind of ions in the plasma from their emission of electromagnetic radiation (see optical emission spectroscopy).")
Declaration(Class(goldbook:08492))
AnnotationAssertion(rdfs:label goldbook:08492 "inductively-coupled plasma robustness")
AnnotationAssertion(dcterms:description goldbook:08492 "Ability of an inductively-coupled plasma to withstand slight modification in the operating conditions and/or matrix composition with no significant changes in its fundamental characteristics (i.e., temperatures, electron number density) or the analytical figures of merit (i.e., sensitivity, detection limits or signal-to-noise ratio)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08492 "plasma robustness")
Declaration(Class(goldbook:08493))
AnnotationAssertion(rdfs:label goldbook:08493 "inductively-coupled plasma thermal pinch")
AnnotationAssertion(dcterms:description goldbook:08493 "Decrease in the inductively-coupled plasma volume normally caused when an organic volatile solution is delivered to it. Organic vapours diffuse towards the outermost area of the plasma and its volume decreases.")
Declaration(Class(goldbook:08494))
AnnotationAssertion(rdfs:label goldbook:08494 "inductively-coupled plasma torch")
AnnotationAssertion(dcterms:description goldbook:08494 "Quartz component of an inductively-coupled plasma spectrometer where the plasma is generated and stabilized.")
Declaration(Class(goldbook:08495))
AnnotationAssertion(rdfs:label goldbook:08495 "initial plasma radiation zone")
AnnotationAssertion(dcterms:description goldbook:08495 "Inductively-coupled plasma volume in inductively-coupled plasma optical emission spectroscopy where the analytically-relevant light emission begins to be observed.")
Declaration(Class(goldbook:08496))
AnnotationAssertion(rdfs:label goldbook:08496 "interference curve")
AnnotationAssertion(dcterms:description goldbook:08496 "Graph of absorbance or intensity plotted as a function of the concentration of an interfering element in an atomic spectroscopy experiment.")
Declaration(Class(goldbook:08497))
AnnotationAssertion(rdfs:label goldbook:08497 "inverse Bremsstrahlung")
AnnotationAssertion(dcterms:description goldbook:08497 "Absorption of photon energy by free electrons.")
Declaration(Class(goldbook:08498))
AnnotationAssertion(rdfs:label goldbook:08498 "ionic cloud")
AnnotationAssertion(dcterms:description goldbook:08498 "Gas phase containing free ions of analyte.")
Declaration(Class(goldbook:08499))
AnnotationAssertion(rdfs:label goldbook:08499 "laser ablation")
AnnotationAssertion(dcterms:description goldbook:08499 "Removal of material as an aerosol from a surface on irradiation by a laser beam.")
Declaration(Class(goldbook:08500))
AnnotationAssertion(rdfs:label goldbook:08500 "laser induced breakdown spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08500 "Measurement method of atomic spectroscopy that uses a focused laser beam to ablate, atomize and excite atoms from a sample surface with subsequent measurement of the generated electromagnetic radiation.")
Declaration(Class(goldbook:08501))
AnnotationAssertion(rdfs:label goldbook:08501 "laser-induced breakdown spectrum")
AnnotationAssertion(dcterms:description goldbook:08501 "Emission spectrum generated as a consequence of the decay of the excited states generated in a laser-induced plasma that consists of a continuous background and element-specific atomic or ionic lines and molecular bands.")
Declaration(Class(goldbook:08502))
AnnotationAssertion(rdfs:label goldbook:08502 "laser-induced plasma")
AnnotationAssertion(dcterms:description goldbook:08502 "Local plasma formed by the interaction between a laser beam and a solid sample and initiated by the production of primary electrons by multiphoton ionization and thermionic photoemission mechanisms.")
Declaration(Class(goldbook:08503))
AnnotationAssertion(rdfs:label goldbook:08503 "line-broadening")
AnnotationAssertion(dcterms:description goldbook:08503 "Increase in the theoretical width of a spectral line owing to thermal motion of emitting atoms (Doppler effect), to electric field (Stark effect), to self-absorption and to pressure (Lorentz effect).")
Declaration(Class(goldbook:08504))
AnnotationAssertion(rdfs:label goldbook:08504 "line profile")
AnnotationAssertion(dcterms:description goldbook:08504 "Graph of the variation of emitted radiation intensity as a function of wavelength (emission line) or the variation of the absorption factor as a function of wavelength (absorption line).")
Declaration(Class(goldbook:08505))
AnnotationAssertion(rdfs:label goldbook:08505 "low sample consumption system")
AnnotationAssertion(dcterms:description goldbook:08505 "Liquid-sample introduction system to an inductively-coupled plasma spectrometer adapted to work at sample flow rates below \\(\\pu{100 \\upmu L min-1}\\).")
Declaration(Class(goldbook:08506))
AnnotationAssertion(rdfs:label goldbook:08506 "measurement efficiency")
AnnotationAssertion(dcterms:description goldbook:08506 "Number of detector events per atom in the sample.")
Declaration(Class(goldbook:08507))
AnnotationAssertion(rdfs:label goldbook:08507 "microwave cavity")
AnnotationAssertion(dcterms:description goldbook:08507 "Resonant cavity that permits focusing a microwave field inside a discharge tube thus giving rise to a standing wave.")
Declaration(Class(goldbook:08508))
AnnotationAssertion(rdfs:label goldbook:08508 "microwave-induced plasma")
AnnotationAssertion(dcterms:description goldbook:08508 "Plasma generated in a microwave cavity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08508 "microwave plasma")
Declaration(Class(goldbook:08509))
AnnotationAssertion(rdfs:label goldbook:08509 "nebulization")
AnnotationAssertion(dcterms:description goldbook:08509 "Conversion of a liquid into an aerosol consisting of droplets suspended in a gas stream.")
Declaration(Class(goldbook:08510))
AnnotationAssertion(rdfs:label goldbook:08510 "nebulizer")
AnnotationAssertion(dcterms:description goldbook:08510 "Device for producing nebulization.")
Declaration(Class(goldbook:08511))
AnnotationAssertion(rdfs:label goldbook:08511 "non-specific emission or attenuation")
AnnotationAssertion(dcterms:description goldbook:08511 "Electromagnetic radiation, within the bandpass filter used, emitted by, or absorption caused by, atoms, molecules and radicals that are subject to the atomizer by all components, apart from the analyte, that are present there during measurement.")
Declaration(Class(goldbook:08512))
AnnotationAssertion(rdfs:label goldbook:08512 "normal plasma analytical zone")
AnnotationAssertion(dcterms:description goldbook:08512 "Inductively-coupled plasma volume mainly responsible for emission of analytically-useful light because processes leading to excited species, such as droplet desolvation, element vaporization, atomization (or ionization) and excitation have been completed.")
Declaration(Class(goldbook:08513))
AnnotationAssertion(rdfs:label goldbook:08513 "optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08513 "Measurement principle of atomic emission spectroscopy in which the emitted electromagnetic radiation is in the range of frequencies from the infrared, through visible, to the ultra-violet region.")
Declaration(Class(goldbook:08514))
AnnotationAssertion(rdfs:label goldbook:08514 "overall efficiency of atomization")
AnnotationAssertion(dcterms:description goldbook:08514 "In atomic spectroscopy, mass of analyte converted into free atoms in the atomizer divided by mass of analyte entering the dispersion device.")
Declaration(Class(goldbook:08515))
AnnotationAssertion(rdfs:label goldbook:08515 "Penning excitation")
AnnotationAssertion(dcterms:description goldbook:08515 "Collisional excitation and ionization mechanism of inductively-coupled plasma spectrometry involving analyte atoms and metastable argon atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08515 "Penning ionization")
Declaration(Class(goldbook:08516))
AnnotationAssertion(rdfs:label goldbook:08516 "percentage transmission")
AnnotationAssertion(dcterms:description goldbook:08516 "In atomic spectroscopy, flux of mass of sample divided by the flux of mass of solvent blank, measured under the same conditions, expressed as a percentage.")
Declaration(Class(goldbook:08517))
AnnotationAssertion(rdfs:label goldbook:08517 "permanent modifier")
AnnotationAssertion(dcterms:description goldbook:08517 "Substance added together with the sample or standards in electrothermal atomic absorption spectroscopy that is refractory, or forms a refractory species (e.g., a carbide), and thus does not need to be renewed for several atomization cycles.")
Declaration(Class(goldbook:08518))
AnnotationAssertion(rdfs:label goldbook:08518 "plasma arc")
AnnotationAssertion(dcterms:description goldbook:08518 "Plasma formed by an arc-discharge.")
Declaration(Class(goldbook:08519))
AnnotationAssertion(rdfs:label goldbook:08519 "plasma excitation temperature")
AnnotationAssertion(dcterms:description goldbook:08519 "Temperature governing the number density of atomic species in their ground state and excited states following a Boltzmann distribution.")
Declaration(Class(goldbook:08520))
AnnotationAssertion(rdfs:label goldbook:08520 "plasma gases")
AnnotationAssertion(dcterms:description goldbook:08520 "Gas streams used to maintain and stabilize the inductively-coupled plasma. The external stream is the main constituent of the plasma and confines the plasma avoiding melting of the torch walls; the intermediate gas stream keeps the plasma at a given height above the top of the torch and, the central stream carries the aerosol and promotes its injection in the plasma central channel.")
Declaration(Class(goldbook:08521))
AnnotationAssertion(rdfs:label goldbook:08521 "plasma induction zone")
AnnotationAssertion(dcterms:description goldbook:08521 "Inductively-coupled plasma volume where there is a maximum interaction between the electromagnetic field and the plasma gas (mostly argon). This is the plasma’s hottest area and has a toroidal configuration.")
Declaration(Class(goldbook:08522))
AnnotationAssertion(rdfs:label goldbook:08522 "plasma ionization temperature")
AnnotationAssertion(dcterms:description goldbook:08522 "Temperature associated with the energy level of plasma ions.")
Declaration(Class(goldbook:08523))
AnnotationAssertion(rdfs:label goldbook:08523 "plasma local thermodynamic equilibrium")
AnnotationAssertion(dcterms:description goldbook:08523 "Condition for which the temperatures estimated from different particles (atoms, molecules, ions, electrons) constituting a plasma are locally coincident.")
Declaration(Class(goldbook:08524))
AnnotationAssertion(rdfs:label goldbook:08524 "plasma shielding")
AnnotationAssertion(dcterms:description goldbook:08524 "Prevention of laser pulse energy from reaching a sample surface as a result of the presence of a laser-induced plasma.")
Declaration(Class(goldbook:08525))
AnnotationAssertion(rdfs:label goldbook:08525 "plasma termination")
AnnotationAssertion(dcterms:description goldbook:08525 "Extinction of the plasma after a laser pulse as a consequence of self-absorption (quenching) and recombination of electrons and ions.")
Declaration(Class(goldbook:08526))
AnnotationAssertion(rdfs:label goldbook:08526 "platform atomization")
AnnotationAssertion(dcterms:description goldbook:08526 "Sample support made of graphite that is inserted into the atomizer tube in electrothermal atomic absorption spectroscopy. The sample, a liquid or a solid, is deposited onto this platform, from which it undergoes all the transformations leading to atomization. The use of a platform delays atomization, until a more stabilized temperature in the gas phase is reached.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08526 "L’vov platform")
Declaration(Class(goldbook:08527))
AnnotationAssertion(rdfs:label goldbook:08527 "pneumatic nebulizers")
AnnotationAssertion(dcterms:description goldbook:08527 "Nebulizers for which the aerosol generation principle is based on the exposure of the liquid sample to a high velocity gas stream.")
Declaration(Class(goldbook:08528))
AnnotationAssertion(rdfs:label goldbook:08528 "preheating inductively-coupled plasma zone")
AnnotationAssertion(dcterms:description goldbook:08528 "Inductively-coupled plasma volume where tertiary aerosols suffer from complete solvent evaporation, element salt vaporization and dissociation into atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08528 "preheating plasma zone")
Declaration(Class(goldbook:08529))
AnnotationAssertion(rdfs:label goldbook:08529 "primary aerosol")
AnnotationAssertion(dcterms:description goldbook:08529 "Aerosol generated by a nebulizer.")
Declaration(Class(goldbook:08531))
AnnotationAssertion(rdfs:label goldbook:08531 "pulse energy")
AnnotationAssertion(dcterms:description goldbook:08531 "Total optical energy content of a laser pulse. Integral of optical power over pulse duration.")
Declaration(Class(goldbook:08532))
AnnotationAssertion(rdfs:label goldbook:08532 "pulsed laser")
AnnotationAssertion(dcterms:description goldbook:08532 "Laser system that emits electromagnetic radiation in the form of pulses of a defined and constant duration.")
Declaration(Class(goldbook:08533))
AnnotationAssertion(rdfs:label goldbook:08533 "pyrolysis curve")
AnnotationAssertion(dcterms:description goldbook:08533 "Graph of absorbance against pyrolysis temperature in electrothermal atomic absorption spectroscopy.")
Declaration(Class(goldbook:08534))
AnnotationAssertion(rdfs:label goldbook:08534 "quartz atomizer")
AnnotationAssertion(dcterms:description goldbook:08534 "Atomizer that is used to atomize those elements that form volatile species (e.g., hydrides) at relatively low temperatures (e.g., \\(\\pu{1000^{\\circ}C}\\) or below).")
Declaration(Class(goldbook:08535))
AnnotationAssertion(rdfs:label goldbook:08535 "radial viewing mode")
AnnotationAssertion(dcterms:description goldbook:08535 "Inductively-coupled plasma optical emission spectrometer configuration in which the plasma and the entrance slit are perpendicular and from which the signal is taken perpendicularly to the main plasma axis.")
Declaration(Class(goldbook:08536))
AnnotationAssertion(rdfs:label goldbook:08536 "radiofrequency generator")
AnnotationAssertion(dcterms:description goldbook:08536 "Component of an inductively-coupled plasma spectrometer responsible for the generation of alternating current in the radiofrequency portion of the electromagnetic spectrum (see table).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08536 "RF generator")
Declaration(Class(goldbook:08537))
AnnotationAssertion(rdfs:label goldbook:08537 "radiofrequency glow discharge optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08537 "Optical emission spectroscopy in which a radiofrequency-powered glow discharge is operated with frequencies in the low megahertz range.")
Declaration(Class(goldbook:08538))
AnnotationAssertion(rdfs:label goldbook:08538 "reference flux density")
AnnotationAssertion(dcterms:description goldbook:08538 "Intensity transmitted by the reference medium in a double-beam spectrometer.")
Declaration(Class(goldbook:08539))
AnnotationAssertion(rdfs:label goldbook:08539 "reflected power")
AnnotationAssertion(dcterms:description goldbook:08539 "Incident power that is not absorbed by the plasma.")
Declaration(Class(goldbook:08540))
AnnotationAssertion(rdfs:label goldbook:08540 "repetition rate")
AnnotationAssertion(dcterms:description goldbook:08540 "Number of laser pulses emitted by a pulsed laser system per unit time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08540 "pulse frequency")
Declaration(Class(goldbook:08541))
AnnotationAssertion(rdfs:label goldbook:08541 "resonant inelastic X-ray scattering")
AnnotationAssertion(dcterms:description goldbook:08541 "Measurement method of inelastic X-ray spectroscopy that uses a hard or soft X-ray beam to excite transitions of core-level electrons into empty energy levels. The subsequent transition of an electron into the core state is accompanied by X-ray emission with characteristic momentum and energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08541 "resonant X-ray emission")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08541 "resonant X-ray Raman")
Declaration(Class(goldbook:08542))
AnnotationAssertion(rdfs:label goldbook:08542 "Saha’s ionization equation")
AnnotationAssertion(dcterms:description goldbook:08542 "Equation that relates the ionization state of an element present in a gas in thermal equilibrium to the temperature and the pressure of the medium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08542 "Saha–Langmuir equation")
Declaration(Class(goldbook:08543))
AnnotationAssertion(rdfs:label goldbook:08543 "sample flux density")
AnnotationAssertion(dcterms:description goldbook:08543 "Intensity transmitted by the atomizer when the latter is supplied with the sample solution or a reference solution.")
Declaration(Class(goldbook:08544))
AnnotationAssertion(rdfs:label goldbook:08544 "saturator")
AnnotationAssertion(dcterms:description goldbook:08544 "Buffer containing interfering element(s) in sufficient quantity to reach the limit of enhancement or dispersion (i.e., saturation) of the interference curve.")
Declaration(Class(goldbook:08545))
AnnotationAssertion(rdfs:label goldbook:08545 "sequential detection")
AnnotationAssertion(dcterms:description goldbook:08545 "Sequential spectrometers use a dispersive element (grating) in combination with entrance and exit slits for selection of specific wavelengths. Geometric arrangements include the Czerny-Turner and the Ebert-geometry, both offering high resolution measurements. However, they do not permit simultaneous recording of different spectral lines, even for single emission line intensity, and adjacent spectral background has also to be measured sequentially.")
Declaration(Class(goldbook:08546))
AnnotationAssertion(rdfs:label goldbook:08546 "solvent blank flux density")
AnnotationAssertion(dcterms:description goldbook:08546 "Intensity transmitted by the atomizer when the latter is supplied with the solvent blank.")
Declaration(Class(goldbook:08547))
AnnotationAssertion(rdfs:label goldbook:08547 "solvent nucleation")
AnnotationAssertion(dcterms:description goldbook:08547 "Solvent condensation on solid particles or droplets contained in an aerosol.")
Declaration(Class(goldbook:08548))
AnnotationAssertion(rdfs:label goldbook:08548 "solvent transport rate")
AnnotationAssertion(dcterms:description goldbook:08548 "Mass of solvent, both in liquid and vapour forms, reaching an inductively-coupled plasma per unit of time.")
Declaration(Class(goldbook:08549))
AnnotationAssertion(rdfs:label goldbook:08549 "spectral background")
AnnotationAssertion(dcterms:description goldbook:08549 "Electromagnetic radiation, within the bandpass used, emitted by, and/or in the case of atomic absorption spectroscopy, absorbed in, the atomizer when nothing is supplied to the atomizer but the gases involved in its operation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08549 "flame background")
Declaration(Class(goldbook:08550))
AnnotationAssertion(rdfs:label goldbook:08550 "spectral line")
AnnotationAssertion(dcterms:description goldbook:08550 "In atomic spectroscopy, a very narrow band of frequencies of electromagnetic radiation emitted or absorbed by atoms, which undergo a single electronic transition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08550 "line")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08550 "spectral line")
Declaration(Class(goldbook:08551))
AnnotationAssertion(rdfs:label goldbook:08551 "spray chamber")
AnnotationAssertion(dcterms:description goldbook:08551 "Chamber of a nebulizer in which the sprayed liquid is converted to mist. Some of the droplets of this mist may evaporate, coalesce, or deposit in the chamber and subsequently drain away as waste.")
Declaration(Class(goldbook:08552))
AnnotationAssertion(rdfs:label goldbook:08552 "sputter rate")
AnnotationAssertion(dcterms:description goldbook:08552 "Mass of material removed from a sample surface in unit time.")
Declaration(Class(goldbook:08553))
AnnotationAssertion(rdfs:label goldbook:08553 "stop-flow conditions")
AnnotationAssertion(dcterms:description goldbook:08553 "Stoppage to the otherwise constant flow of argon gas to the atomizer in electrothermal atomic absorption spectroscopy, that can be programmed to occur during atomization, for the purpose of increasing the residence time of the analyte atoms and thus the associated signal.")
Declaration(Class(goldbook:08554))
AnnotationAssertion(rdfs:label goldbook:08554 "synchrotron X-ray spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08554 "X-ray spectroscopy performed using a high intensity, continuous polychromatic synchrotron X-ray source.")
Declaration(Class(goldbook:08555))
AnnotationAssertion(rdfs:label goldbook:08555 "tertiary aerosol")
AnnotationAssertion(dcterms:description goldbook:08555 "Aerosol that reaches an inductively-coupled plasma.")
Declaration(Class(goldbook:08556))
AnnotationAssertion(rdfs:label goldbook:08556 "thermal dispersion")
AnnotationAssertion(dcterms:description goldbook:08556 "Procedures whereby an aerosol is produced at a high temperature, for example by sparks, arcs, furnaces, lasers, cathodic sputtering or electron-beam.")
Declaration(Class(goldbook:08557))
AnnotationAssertion(rdfs:label goldbook:08557 "thermal volatilization")
AnnotationAssertion(dcterms:description goldbook:08557 "Process in glow-discharge atomic emission spectroscopy in which sample volatilization occurs by heating due to sample bombardment with argon ions.")
Declaration(Class(goldbook:08558))
AnnotationAssertion(rdfs:label goldbook:08558 "time-resolved laser-induced breakdown spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08558 "Measurement method of laser-induced breakdown spectroscopy in which the emitted radiation is monitored with time resolution sufficiently high to resolve different stages in the lifetime of the laser-induced plasma.")
Declaration(Class(goldbook:08559))
AnnotationAssertion(rdfs:label goldbook:08559 "total sample consumption system")
AnnotationAssertion(dcterms:description goldbook:08559 "Liquid-sample introduction system able to achieve \\(\\pu{100\\%}\\) transport efficiency.")
Declaration(Class(goldbook:08560))
AnnotationAssertion(rdfs:label goldbook:08560 "transport efficiency")
AnnotationAssertion(dcterms:description goldbook:08560 "Mass of analyte entering the atomizer of a flame atomic spectrometer or the plasma of an inductively-coupled plasma spectrometer divided by the mass of analyte entering the dispersion device.")
Declaration(Class(goldbook:08561))
AnnotationAssertion(rdfs:label goldbook:08561 "ultrasonic nebulizers")
AnnotationAssertion(dcterms:description goldbook:08561 "Nebulizers whose aerosol generation principle is based on the transfer of the energy from a vibrating transducer to the liquid sample.")
Declaration(Class(goldbook:08562))
AnnotationAssertion(rdfs:label goldbook:08562 "wall atomization")
AnnotationAssertion(dcterms:description goldbook:08562 "Electrothermal atomic absorption spectroscopy in which the sample is deposited directly onto the wall of the electrothermal atomizer tube, from which it undergoes all the transformations leading to atomization.")
Declaration(Class(goldbook:08563))
AnnotationAssertion(rdfs:label goldbook:08563 "wash out time")
AnnotationAssertion(dcterms:description goldbook:08563 "Time required for the output signal of an inductively-coupled plasma spectrometer for a given analyte to fall back to baseline levels from the end of sampling time and/or after introducing a blank solution.")
Declaration(Class(goldbook:08564))
AnnotationAssertion(rdfs:label goldbook:08564 "X-ray emission spectrum")
AnnotationAssertion(dcterms:description goldbook:08564 "Spectrum comprising the continuum Bremsstrahlung and the most energetic characteristic spectral lines defined by differences in binding energy between electron energy levels.")
Declaration(Class(goldbook:08565))
AnnotationAssertion(rdfs:label goldbook:08565 "amorphous material transmitting infrared radiation")
AnnotationAssertion(dcterms:description goldbook:08565 "Amorphous glasses made from elements of groups 4, 5 and 6 of the Periodic Table that transmit infrared radiation.")
Declaration(Class(goldbook:08566))
AnnotationAssertion(rdfs:label goldbook:08566 "amplitude modulation")
AnnotationAssertion(dcterms:description goldbook:08566 "Modulation of the amplitude of a beam of electromagnetic radiation; by the movement of a moving mirror in a rapid scan Fourier-transform spectrometer or by a mechanical chopper in other spectrometers.")
Declaration(Class(goldbook:08567))
AnnotationAssertion(rdfs:label goldbook:08567 "anisotropic Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08567 "Raman scattering by the anisotropic part of the derived polarizability tensor.")
Declaration(Class(goldbook:08568))
AnnotationAssertion(rdfs:label goldbook:08568 "anomalous dispersion")
AnnotationAssertion(dcterms:description goldbook:08568 "Changes in real refractive index of a material in the vicinity of an absorption band in which real refractive index decreases markedly with decreasing wavenumber on the high wavenumber side of an absorption band, then increases rapidly through the band centre and decreases markedly on the low wavenumber side of the band, before resuming normal dispersion at wavenumbers far from the band.")
Declaration(Class(goldbook:08569))
AnnotationAssertion(rdfs:label goldbook:08569 "anomalously polarized Raman band")
AnnotationAssertion(dcterms:description goldbook:08569 "Raman band with a depolarization ratio greater than \\(\\pu{0.75}\\), as is frequently observed in surface-enhanced resonance Raman spectroscopy.")
Declaration(Class(goldbook:08570))
AnnotationAssertion(rdfs:label goldbook:08570 "anti-Stokes Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08570 "Raman scattering of electromagnetic radiation in which the scattered radiation has greater energy (greater wavenumber) than the exciting radiation.")
Declaration(Class(goldbook:08571))
AnnotationAssertion(rdfs:label goldbook:08571 "asymmetric top")
AnnotationAssertion(dcterms:description goldbook:08571 "Rotor whose three principal moments of inertia are all different.")
Declaration(Class(goldbook:08572))
AnnotationAssertion(rdfs:label goldbook:08572 "atomic polar tensor")
AnnotationAssertion(dcterms:description goldbook:08572 "3 × 3 tensor that gives the change in the components of the molecular dipole moment when the atom is displaced in three-dimensional space.")
Declaration(Class(goldbook:08573))
AnnotationAssertion(rdfs:label goldbook:08573 "attenuated total reflection spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08573 "Measurement method of vibrational spectroscopy based on internal reflection from an absorbing material at angles of incidence at or above the critical angle (attenuated total reflection).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08573 "frustrated total internal reflection spectroscopy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08573 "internal reflection spectroscopy (IRS)")
Declaration(Class(goldbook:08574))
AnnotationAssertion(rdfs:label goldbook:08574 "band shape")
AnnotationAssertion(dcterms:description goldbook:08574 "Description of the profile of a spectral band.")
Declaration(Class(goldbook:08575))
AnnotationAssertion(rdfs:label goldbook:08575 "Bragg filter")
AnnotationAssertion(dcterms:description goldbook:08575 "Optical filter used, for example, to attenuate Rayleigh scattering while transmitting light subject to Raman shift.")
Declaration(Class(goldbook:08576))
AnnotationAssertion(rdfs:label goldbook:08576 "centre burst")
AnnotationAssertion(dcterms:description goldbook:08576 "Spectral region of an interferogram around zero-path-difference where intensity is greatest.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08576 "center burst")
Declaration(Class(goldbook:08577))
AnnotationAssertion(rdfs:label goldbook:08577 "Christiansen effect")
AnnotationAssertion(dcterms:description goldbook:08577 "Collections of solid particles that are transparent to electromagnetic radiation of a particular wavelength and are slightly larger than the wavelength of the radiation transmit poorly due to reflection and scattering from the interfaces. The transmission increases markedly at wavenumbers at which the refractive index of the particles is close to that of the surrounding medium.")
Declaration(Class(goldbook:08578))
AnnotationAssertion(rdfs:label goldbook:08578 "Christiansen filter")
AnnotationAssertion(dcterms:description goldbook:08578 "Optical filter based on the Christiansen effect.")
Declaration(Class(goldbook:08579))
AnnotationAssertion(rdfs:label goldbook:08579 "coherent anti-Stokes Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08579 """Measurement method of Raman spectroscopy that uses third-order susceptibility and is one of several four-wave mixing spectroscopies. The excitation is through lasers of wavenumber \\(\\tilde{
u}_{1}\\) and \\(\\tilde{
u}_{2}\\), which coincide spatially and temporally in the sample and produce an output laser of wavenumber \\(\\tilde{
u}_{3} = 2\\tilde{
u}_{1} - \\tilde{
u}_{2}\\).""")
Declaration(Class(goldbook:08580))
AnnotationAssertion(rdfs:label goldbook:08580 "combination transition")
AnnotationAssertion(dcterms:description goldbook:08580 "Transition in which more than one vibration changes its degree of excitation; i.e., in which more than one vibrational quantum number changes.")
Declaration(Class(goldbook:08581))
AnnotationAssertion(rdfs:label goldbook:08581 "continuous scan interferometer")
AnnotationAssertion(dcterms:description goldbook:08581 "Interferometer in which the optical path difference is continually changed.")
Declaration(Class(goldbook:08582))
AnnotationAssertion(rdfs:label goldbook:08582 "Coriolis coupling")
AnnotationAssertion(dcterms:description goldbook:08582 "Coupling between rotational and vibrational molecular motion caused by Coriolis forces.")
Declaration(Class(goldbook:08583))
AnnotationAssertion(rdfs:label goldbook:08583 "Coriolis force")
AnnotationAssertion(dcterms:description goldbook:08583 "In vibrational theory, the motion of a polyatomic molecule is usually initially regarded as the independent superposition of a rotation and a vibration, with the vibration considered in a coordinate system that rotates with the molecule. This initial treatment must be corrected for centrifugal forces and for Coriolis forces. The Coriolis force on an atom is given by \\(F_{\\rm{Coriolis}} = 2m v_{\\rm{a}} \\omega \\sin \\varphi\\), where \\(m\\) is the mass of the atom, \\(v_{\\rm{a}}\\) is its apparent velocity in the rotating coordinate system, \\(\\omega\\) is the angular velocity of the coordinate system, and \\(\\varphi\\) is the angle between the velocity vector and the axis of rotation.")
Declaration(Class(goldbook:08584))
AnnotationAssertion(rdfs:label goldbook:08584 "critical angle")
AnnotationAssertion(dcterms:description goldbook:08584 "Smallest angle of incidence at which total internal reflection occurs.")
Declaration(Class(goldbook:08585))
AnnotationAssertion(rdfs:label goldbook:08585 "deformation vibration")
AnnotationAssertion(dcterms:description goldbook:08585 "Vibration in which the dominant change from equilibrium is in one or more valence angles.")
Declaration(Class(goldbook:08586))
AnnotationAssertion(rdfs:label goldbook:08586 "depolarization ratio")
AnnotationAssertion(dcterms:description goldbook:08586 "Raman intensity with the electric vector of the scattered electromagnetic radiation perpendicular to that of the incident radiation divided by the Raman intensity with electric vectors parallel.")
Declaration(Class(goldbook:08587))
AnnotationAssertion(rdfs:label goldbook:08587 "depolarized Raman band")
AnnotationAssertion(dcterms:description goldbook:08587 "Raman band with depolarization ratio \\(\\rho = 0.75\\) for linear polarized incident radiation in normal Raman spectroscopy.")
Declaration(Class(goldbook:08588))
AnnotationAssertion(rdfs:label goldbook:08588 "difference transition")
AnnotationAssertion(dcterms:description goldbook:08588 "Combination transition that does not start at the ground state and in which at least one vibration decreases and at least one vibration increases its degree of excitation; i.e., a transition in which more than one vibrational quantum number changes and at least one becomes smaller.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08588 "difference band")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08588 "difference tone")
Declaration(Class(goldbook:08589))
AnnotationAssertion(rdfs:label goldbook:08589 "divided spinning cell")
AnnotationAssertion(dcterms:description goldbook:08589 "Measuring instrument for Raman spectroscopy incorporating a dish-shaped cell that is divided by a vertical partition through its middle to allow different liquids in its two halves. It is rotated about a vertical axis through its centre and the Raman scattered radiation from each half is measured alternately. With a standard liquid in one half and a sample in the other it is used to determine Raman scattering intensities relative to the standard.")
Declaration(Class(goldbook:08590))
AnnotationAssertion(rdfs:label goldbook:08590 "dynamic spectrum")
AnnotationAssertion(dcterms:description goldbook:08590 "Spectrum of a material under the influence of an applied external perturbation represented by a variable \\(\\tau\\), relative to a reference spectrum.")
Declaration(Class(goldbook:08591))
AnnotationAssertion(rdfs:label goldbook:08591 "electrical anharmonicity")
AnnotationAssertion(dcterms:description goldbook:08591 "Influence of terms that are of \\(2^{\\rm{nd}}\\) and higher order in the normal coordinate \\(Q\\) in the expansion of the electric dipole moment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08591 "anharmonicity")
Declaration(Class(goldbook:08592))
AnnotationAssertion(rdfs:label goldbook:08592 "electrical harmonicity")
AnnotationAssertion(dcterms:description goldbook:08592 "Influence of the linear term, \\(\\Sigma_{k} (\\partial \\boldsymbol{\\mu}/\\partial Q_{k}) Q_{k}\\), in the expansion of the electric dipole moment. \\(Q\\) is the normal coordinate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08592 "harmonicity")
Declaration(Class(goldbook:08593))
AnnotationAssertion(rdfs:label goldbook:08593 "electron energy loss spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08593 "Measurement method of vibrational spectroscopy in which a constant-energy beam of electrons passes through or is reflected from a sample and the energy distribution in the transmitted or reflected beam is analysed to give a spectrum of number of electrons against electron energy loss.")
Declaration(Class(goldbook:08594))
AnnotationAssertion(rdfs:label goldbook:08594 "electro-optic parameter")
AnnotationAssertion(dcterms:description goldbook:08594 "Characteristic quantity used in the analysis of absolute infrared intensity data chosen on the assumption that the electric dipole moment of the molecule can be described as the vector sum of bond dipole moments.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08594 "equilibrium charge, charge flux (ECCF)")
Declaration(Class(goldbook:08595))
AnnotationAssertion(rdfs:label goldbook:08595 "ellipticity")
AnnotationAssertion(dcterms:description goldbook:08595 "Degree to which linearly polarized incident electromagnetic radiation becomes elliptically polarized in an absorbing optically active medium. \\[\\tan\\;\\psi = (E_{\\rm{R}} - E_{\\rm{L}})/(E_{\\rm{R}} + E_{\\rm{L}}) = \\tanh (k^{\\rm{L}} - k^{\\rm{R}})\\pi l/\\lambda\\] where \\(E_{\\rm{R}}\\) and \\(E_{\\rm{L}}\\) are the electric vectors of right and left circularly polarized radiation, \\(k^{\\rm{L}}\\) and \\(k^{\\rm{R}}\\) are the absorption indices of the sample for left and right circularly polarized radiation, \\(\\lambda\\) is the wavelength of the radiation and \\(l\\) is the path-length through the medium.")
Declaration(Class(goldbook:08596))
AnnotationAssertion(rdfs:label goldbook:08596 "evanescent wave")
AnnotationAssertion(dcterms:description goldbook:08596 "Part of a standing-wave normal to a reflecting surface that extends beyond the reflecting surface when an electromagnetic wave undergoes total internal reflection.")
Declaration(Class(goldbook:08597))
AnnotationAssertion(rdfs:label goldbook:08597 "Evans hole")
AnnotationAssertion(dcterms:description goldbook:08597 "Unexpected minimum or hole in a broad absorption band due to a gap being created in a broad distribution of states by Fermi resonance.")
Declaration(Class(goldbook:08598))
AnnotationAssertion(rdfs:label goldbook:08598 "excitation profile")
AnnotationAssertion(dcterms:description goldbook:08598 "Graph of Raman intensity at the desired Raman shift against wavenumber of the excitation.")
Declaration(Class(goldbook:08599))
AnnotationAssertion(rdfs:label goldbook:08599 "external reflection spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08599 "Measurement method of spectroscopy in which radiation is reflected from a sample of higher refractive index than that of the incident medium.")
Declaration(Class(goldbook:08600))
AnnotationAssertion(rdfs:label goldbook:08600 "extraordinary wave")
AnnotationAssertion(dcterms:description goldbook:08600 "In a uniaxial crystal electromagnetic radiation with electric vector oblique to the optic axis and which does not obey the normal laws of refraction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08600 "extraordinary ray")
Declaration(Class(goldbook:08601))
AnnotationAssertion(rdfs:label goldbook:08601 "Fermi resonance")
AnnotationAssertion(dcterms:description goldbook:08601 "Cubic anharmonic resonance (see anharmonicity), i.e., any interaction caused by cubic terms in the vibrational potential energy.")
Declaration(Class(goldbook:08602))
AnnotationAssertion(rdfs:label goldbook:08602 "finesse")
AnnotationAssertion(dcterms:description goldbook:08602 "Free spectral range divided by resolution.")
Declaration(Class(goldbook:08603))
AnnotationAssertion(rdfs:label goldbook:08603 "fingerprint bands")
AnnotationAssertion(dcterms:description goldbook:08603 "Infrared and Raman bands that are characteristic of a particular molecule rather than a functional group.")
Declaration(Class(goldbook:08604))
AnnotationAssertion(rdfs:label goldbook:08604 "fingerprint region")
AnnotationAssertion(dcterms:description goldbook:08604 "Region of a spectrum that contains fingerprint bands as well as bands with characteristic group frequencies.")
Declaration(Class(goldbook:08605))
AnnotationAssertion(rdfs:label goldbook:08605 "Fourier-transform infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08605 "Infrared spectroscopy in which a Fourier-transform spectrometer is used to separate the transmitted electromagnetic radiation into its component wavenumbers.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08605 "Fourier-transform infrared spectrometry")
Declaration(Class(goldbook:08606))
AnnotationAssertion(rdfs:label goldbook:08606 "Fourier-transform Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08606 "Raman spectroscopy in which a Fourier-transform spectrometer is used to separate the scattered electromagnetic radiation into its component wavenumbers.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08606 "Fourier-transform Raman spectrometry")
Declaration(Class(goldbook:08607))
AnnotationAssertion(rdfs:label goldbook:08607 "free spectral range")
AnnotationAssertion(dcterms:description goldbook:08607 """For a Fabry-Perot or laser cavity, wavenumber interval between successive longitudinal cavity modes of vibration; \\(\\Delta \\tilde{
u} = 1/(2nl)\\), where \\(l\\) is the cavity spacing and \\(n\\) is the refractive index of the material in the cavity.""")
Declaration(Class(goldbook:08608))
AnnotationAssertion(rdfs:label goldbook:08608 "grazing incidence")
AnnotationAssertion(dcterms:description goldbook:08608 "Angle of incidence of a beam of electromagnetic radiation greater than \\(\\pu{70\\!^{\\circ}}\\).")
Declaration(Class(goldbook:08609))
AnnotationAssertion(rdfs:label goldbook:08609 "group frequency")
AnnotationAssertion(dcterms:description goldbook:08609 "Frequency in vibrational spectroscopy that is characteristic of a particular chemical functional group.")
Declaration(Class(goldbook:08610))
AnnotationAssertion(rdfs:label goldbook:08610 "harmonic constant")
AnnotationAssertion(dcterms:description goldbook:08610 """Coefficient of (\\(
u + &half;\\)) in the vibrational term value, determined by the harmonic terms in the vibrational potential energy.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08610 "harmonic wavenumber")
Declaration(Class(goldbook:08611))
AnnotationAssertion(rdfs:label goldbook:08611 "homogeneous line-broadening")
AnnotationAssertion(dcterms:description goldbook:08611 "Line-broadening by mechanisms that affect every molecule of the same species in the sample in the same way.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08611 "homogeneous broadening")
Declaration(Class(goldbook:08612))
AnnotationAssertion(rdfs:label goldbook:08612 "hot transition")
AnnotationAssertion(dcterms:description goldbook:08612 "Electronic transition between an excited state and a state in which all vibrational quantum numbers are the same or greater.")
Declaration(Class(goldbook:08613))
AnnotationAssertion(rdfs:label goldbook:08613 "hyper-Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08613 "Raman spectroscopy in which scattering occurs through hyperpolarizabilities. A two-photon technique in which an intense pulsed beam of electromagnetic radiation is focused onto the sample. When sufficient power is present in the pulse, two photons may interact with the one molecule to create a virtual state at double the frequency of the laser excitation. Raman scattering from this virtual state to an excited vibrational state of the ground state then occurs.")
Declaration(Class(goldbook:08614))
AnnotationAssertion(rdfs:label goldbook:08614 "hyperspectral imaging")
AnnotationAssertion(dcterms:description goldbook:08614 "Measurement method to obtain information about the spatial composition of a sample by obtaining a spectrum at each spatially resolved point of the sample.")
Declaration(Class(goldbook:08615))
AnnotationAssertion(rdfs:label goldbook:08615 "improper rotation axis")
AnnotationAssertion(dcterms:description goldbook:08615 "In spectroscopy, a rotation-reflection axis, which is a symmetry element such that rotation by \\(2\\pi/n\\) about the axis followed by reflection through a plane perpendicular to the axis transforms an object into itself.")
Declaration(Class(goldbook:08616))
AnnotationAssertion(rdfs:label goldbook:08616 "inelastic electron tunnelling spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08616 "Measurement method of vibrational spectroscopy to obtain spectra of molecules on metal oxide surfaces.")
Declaration(Class(goldbook:08617))
AnnotationAssertion(rdfs:label goldbook:08617 "infrared radiation")
AnnotationAssertion(dcterms:description goldbook:08617 "Electromagnetic radiation of wavelength between approximately \\(\\pu{780 nm}\\) and \\(\\pu{1000 \\upmu m}\\) or of wavenumber between approximately \\(\\pu{13000 cm-1}\\) and \\(\\pu{10 cm-1}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08617 "infrared")
Declaration(Class(goldbook:08618))
AnnotationAssertion(rdfs:label goldbook:08618 "infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08618 "Measurement principle of vibrational spectroscopy using infrared radiation.")
Declaration(Class(goldbook:08619))
AnnotationAssertion(rdfs:label goldbook:08619 "inhomogeneous broadening")
AnnotationAssertion(dcterms:description goldbook:08619 "Line-broadening by mechanisms that arise from an ensemble of spectroscopically non-equivalent molecules of the same species. Such molecules exist, for example, when molecules occupy non-equivalent sites in a condensed phase, and when gaseous molecules have different velocities and, thus, shift the observed wavenumber differently through the Doppler effect.")
Declaration(Class(goldbook:08620))
AnnotationAssertion(rdfs:label goldbook:08620 "interference fringes")
AnnotationAssertion(dcterms:description goldbook:08620 "Sinusoidal intensity variation due to interference of electromagnetic radiation that undergoes multiple reflection between two flat and parallel surfaces.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08620 "channel fringes")
Declaration(Class(goldbook:08621))
AnnotationAssertion(rdfs:label goldbook:08621 "interference record")
AnnotationAssertion(dcterms:description goldbook:08621 "Record of the signal from the detector of a two-beam interferometer as the optical path difference between the two beams is varied.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08621 "interference function")
Declaration(Class(goldbook:08622))
AnnotationAssertion(rdfs:label goldbook:08622 "interferogram")
AnnotationAssertion(dcterms:description goldbook:08622 "Pattern formed by wave interference produced by an interferometer, especially one represented on a screen or chart recorder.")
Declaration(Class(goldbook:08623))
AnnotationAssertion(rdfs:label goldbook:08623 "internal reflection")
AnnotationAssertion(dcterms:description goldbook:08623 "Reflection of electromagnetic radiation from a material of lesser refractive index than that of the incident medium.")
Declaration(Class(goldbook:08624))
AnnotationAssertion(rdfs:label goldbook:08624 "internal reflection element")
AnnotationAssertion(dcterms:description goldbook:08624 "Transparent or semi-transparent material of high refractive index that carries infrared radiation to a sample in internal reflection and attenuated total reflection measurements.")
Declaration(Class(goldbook:08625))
AnnotationAssertion(rdfs:label goldbook:08625 "inverse Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08625 """Raman scattering showing absorption when Stokes Raman scattering exceeds anti-Stokes Raman scattering, in an experiment in which a sample is simultaneously illuminated by coincident beams from a continuum source and a pulse laser at \\(\\tilde{
u}_{0}\\). Energy is absorbed from the continuum at \\(\\tilde{
u}_{0} + \\tilde{
u}_{\\rm{s}}\\) where \\(\\tilde{
u}_{\\rm{s}}\\) is the wavenumber of a Raman-active vibration in the sample that is excited by this process, and this energy is emitted at \\(\\tilde{
u}_{0}\\).""")
Declaration(Class(goldbook:08626))
AnnotationAssertion(rdfs:label goldbook:08626 "inverse spatially offset Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08626 "Variant of spatially offset Raman spectroscopy in which a sample is illuminated with a ring of laser light and the Raman scattering is collected from the centre of the ring.")
Declaration(Class(goldbook:08627))
AnnotationAssertion(rdfs:label goldbook:08627 "IRTRAN™")
AnnotationAssertion(dcterms:description goldbook:08627 "Kinds of crystal transparent to infrared radiation used as windows and filters in infrared spectroscopy.")
Declaration(Class(goldbook:08628))
AnnotationAssertion(rdfs:label goldbook:08628 "Jacquinot stop")
AnnotationAssertion(dcterms:description goldbook:08628 "Aperture in the optics of a Fourier-transform spectrometer, typically between the source and the interferometer, designed to be the limiting aperture when no other optical element such as the detector serves this purpose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08628 "J-stop")
Declaration(Class(goldbook:08629))
AnnotationAssertion(rdfs:label goldbook:08629 "kinetic coupling")
AnnotationAssertion(dcterms:description goldbook:08629 "Coupling of vibrational displacements through terms in the vibrational kinetic energy.")
Declaration(Class(goldbook:08630))
AnnotationAssertion(rdfs:label goldbook:08630 "KRS-5")
AnnotationAssertion(dcterms:description goldbook:08630 "Eutectic (\\(\\pu{42 \\% TlBr, 58 \\% TlI}\\)) mixture of thallium bromide and thallium iodide transparent to infrared radiation used as window in infrared spectroscopy.")
Declaration(Class(goldbook:08631))
AnnotationAssertion(rdfs:label goldbook:08631 "Kubelka–Munk function")
AnnotationAssertion(dcterms:description goldbook:08631 "\\(f(R_{\\infty}) = (1 – R_{\\infty})^{2}/2R_{\\infty}\\), where \\(R_{\\infty}\\) is the diffuse reflectance from a sample of infinite depth.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08631 "remission function")
Declaration(Class(goldbook:08632))
AnnotationAssertion(rdfs:label goldbook:08632 "lifetime broadening")
AnnotationAssertion(dcterms:description goldbook:08632 "Homogeneous line-broadening due to the limited lifetime of energy states involved in a transition.")
Declaration(Class(goldbook:08633))
AnnotationAssertion(rdfs:label goldbook:08633 "local mode")
AnnotationAssertion(dcterms:description goldbook:08633 "Mode of vibration localized in one type of bond.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08633 "local mode")
Declaration(Class(goldbook:08634))
AnnotationAssertion(rdfs:label goldbook:08634 "local molar polarizability")
AnnotationAssertion(dcterms:description goldbook:08634 """Defined under the assumption of the Lorentz local field by the Lorentz-Lorenz formula: \\[\\hat{\\alpha}_{\\rm{m}}(\\tilde{
u}) = 3V_{\\rm{m}}\\epsilon_{0} \\frac{\\hat{\\epsilon}(\\tilde{
u}) - 1}{\\hat{\\epsilon}(\\tilde{
u}) + 2} = 3V_{\\rm{m}}{\\epsilon}_{0}\\,\\frac{\\hat{n}^{2}(\\tilde{
u}) - 1}{\\hat{n}^{2}(\\tilde{
u}) + 2}\\] where \\(V_{\\rm{m}}\\) is the molar volume and \\(\\hat{\\epsilon}\\) and \\(\\boldsymbol{\\hat{n}}\\) are the complex dielectric constant and refractive index, respectively. To allow description of absorption, \\(\\hat{\\alpha}_{\\rm{m}}(\\tilde{
u})\\) is complex: \\(\\hat{\\alpha}_{\\rm{m}}(\\tilde{
u}) = \\alpha_{\\rm{m}}'(\\tilde{
u}) + \\rm{i}\\alpha_{\\rm{m}}''(\\tilde{
u})\\).""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08634 "molar polarizability")
Declaration(Class(goldbook:08635))
AnnotationAssertion(rdfs:label goldbook:08635 "mechanical anharmonicity")
AnnotationAssertion(dcterms:description goldbook:08635 "Influence of cubic and higher-order terms in vibrational potential energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08635 "anharmonicity")
Declaration(Class(goldbook:08636))
AnnotationAssertion(rdfs:label goldbook:08636 "mechanical harmonicity")
AnnotationAssertion(dcterms:description goldbook:08636 "Influence of quadratic terms in vibrational potential energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08636 "harmonicity")
Declaration(Class(goldbook:08638))
AnnotationAssertion(rdfs:label goldbook:08638 "molar ellipticity")
AnnotationAssertion(dcterms:description goldbook:08638 "Ellipticity divided by the amount concentration of the optically active absorbing material and by the path-length at temperature (\\(t\\)) and wavelength (\\(\\lambda\\)).")
Declaration(Class(goldbook:08639))
AnnotationAssertion(rdfs:label goldbook:08639 "multiplex advantage")
AnnotationAssertion(dcterms:description goldbook:08639 "Decrease in measurement uncertainty obtained by measuring intensity at many different wavelengths simultaneously, as is done, for example, in Fourier-transform spectroscopy.")
Declaration(Class(goldbook:08641))
AnnotationAssertion(rdfs:label goldbook:08641 "natural linewidth")
AnnotationAssertion(dcterms:description goldbook:08641 "Line width of a molecular spectral band that arises from the probability of spontaneous emission in the absence of radiation fields and interaction with other molecules or entities.")
Declaration(Class(goldbook:08642))
AnnotationAssertion(rdfs:label goldbook:08642 "near-infrared radiation")
AnnotationAssertion(dcterms:description goldbook:08642 "Infrared radiation of which vacuum wavenumbers range from approximately \\(\\pu{12800 cm-1}\\) to \\(\\pu{4800 cm-1}\\) and wavelengths range from approximately \\(\\pu{780 nm}\\) to \\(\\pu{2500 nm}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08642 "near-IR")
Declaration(Class(goldbook:08643))
AnnotationAssertion(rdfs:label goldbook:08643 "non-dispersive infrared spectroscopies")
AnnotationAssertion(dcterms:description goldbook:08643 "Kinds of infrared spectroscopy in which the effect of the sample on the radiation from the source is measured as a whole without exploring the dependence on wavenumber.")
Declaration(Class(goldbook:08644))
AnnotationAssertion(rdfs:label goldbook:08644 "normal coordinate")
AnnotationAssertion(dcterms:description goldbook:08644 "Formal mathematical description of a normal vibration. When the potential energy, \\(V\\), is harmonic and the kinetic energy, \\(T\\), is calculated in the limit of infinitesimally small displacements, the normal coordinates are defined as independent entities such that '(for non-linear molecules)'\\[V = &half;\\sum_{k=1}^{3N-6}\\lambda_{k}Q_{k}^{2}\\ {\\rm{and}}\\ T = &half;\\sum_{k=1}^{3N-6}\\dot Q_{k}^{2}\\]where \\(\\lambda_{k}\\) is the \\(k^{\\rm{th}}\\) eigenvalue and \\(\\dot {Q}\\) is \\(\\partial Q/\\partial t\\). Normal coordinate \\(Q_{k}\\) is related to the internal displacement coordinates, \\(R_{i}\\), through the elements, \\(L_{ik} = \\partial R_{i}/\\partial Q_{k}\\) of the \\(k^{\\rm{th}}\\) column of the eigenvector matrix \\(\\boldsymbol{L}\\). Normal coordinates are not independent when the potential energy is anharmonic, or the displacements are not infinitesimal.")
Declaration(Class(goldbook:08645))
AnnotationAssertion(rdfs:label goldbook:08645 "normal coordinate analysis")
AnnotationAssertion(dcterms:description goldbook:08645 "Calculation of the normal modes of vibrations of a molecule or crystal under the assumptions that the potential energy is harmonic and the displacements from equilibrium are infinitesimal.")
Declaration(Class(goldbook:08646))
AnnotationAssertion(rdfs:label goldbook:08646 "normal dispersion of the refractive index")
AnnotationAssertion(dcterms:description goldbook:08646 "Slow decrease of real refractive index of a material in a non-absorbing spectral region far from regions of strong absorption as the wavenumber decreases.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08646 "normal dispersion")
Declaration(Class(goldbook:08647))
AnnotationAssertion(rdfs:label goldbook:08647 "normal incidence")
AnnotationAssertion(dcterms:description goldbook:08647 "Incidence of a beam of electromagnetic radiation when the angle of incidence \\(\\theta = \\pu{0\\!^{\\circ}}\\), i.e., the incident radiation beam is normal to the surface.")
Declaration(Class(goldbook:08648))
AnnotationAssertion(rdfs:label goldbook:08648 "normal mode")
AnnotationAssertion(dcterms:description goldbook:08648 "One of the \\(3N - 6\\) (\\(3N - 5\\) for a linear molecule) modes of vibration that would add to give the total vibrational motion in a molecule if the interatomic potential were strictly quadratic in the displacements from equilibrium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08648 "normal mode")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08648 "normal vibration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08648 "normal vibration mode")
Declaration(Class(goldbook:08649))
AnnotationAssertion(rdfs:label goldbook:08649 "normalized tunnelling intensity")
AnnotationAssertion(dcterms:description goldbook:08649 "Second differential of intensity with respect to bias voltage divided by first differential of intensity with respect to bias voltage.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08649 "constant resolution tunnelling intensity")
Declaration(Class(goldbook:08650))
AnnotationAssertion(rdfs:label goldbook:08650 "optical absorption depth")
AnnotationAssertion(dcterms:description goldbook:08650 "Depth in a sample at which the intensity of an incident beam is reduced to \\(1/\\rm{e}\\) of its value at the surface of the sample.")
Declaration(Class(goldbook:08651))
AnnotationAssertion(rdfs:label goldbook:08651 "optical constants")
AnnotationAssertion(dcterms:description goldbook:08651 "Collective name for the real refractive index, \\(n\\) and the absorption index (imaginary refractive index), \\(k\\).")
Declaration(Class(goldbook:08652))
AnnotationAssertion(rdfs:label goldbook:08652 "optical null double beam spectrometer")
AnnotationAssertion(dcterms:description goldbook:08652 "Spectrometer in which the ratio of the radiant power in the two beams at each wavenumber is measured opto-mechanically by inserting a linear optical attenuator into the reference beam until the two signals measured by the detector are equal, then measuring the displacement of the optical attenuator.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08652 "NTI double beam spectrometer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08652 "null-balance double beam spectrometer")
Declaration(Class(goldbook:08653))
AnnotationAssertion(rdfs:label goldbook:08653 "optical path difference")
AnnotationAssertion(dcterms:description goldbook:08653 "Path-length difference between the arms of a two-beam interferometer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08653 "optical retardation")
Declaration(Class(goldbook:08654))
AnnotationAssertion(rdfs:label goldbook:08654 "optical rotatory dispersion")
AnnotationAssertion(dcterms:description goldbook:08654 "Wavelength dependence of the angle of rotation of the plane of linearly-polarized radiation when transmitted through optically active materials.")
Declaration(Class(goldbook:08655))
AnnotationAssertion(rdfs:label goldbook:08655 "ordinary wave")
AnnotationAssertion(dcterms:description goldbook:08655 "In a uniaxial crystal electromagnetic radiation with electric vector perpendicular to the optic axis and which obeys the normal laws of refraction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08655 "ordinary ray")
Declaration(Class(goldbook:08656))
AnnotationAssertion(rdfs:label goldbook:08656 "overtone transition")
AnnotationAssertion(dcterms:description goldbook:08656 "Transition between the ground state and a state in which a single mode of vibration is multiply excited.")
Declaration(Class(goldbook:08657))
AnnotationAssertion(rdfs:label goldbook:08657 "pATR spectrum")
AnnotationAssertion(dcterms:description goldbook:08657 "\\(-\\log_{10}\\) of the spectrum obtained in attenuated total reflection spectroscopy.")
Declaration(Class(goldbook:08658))
AnnotationAssertion(rdfs:label goldbook:08658 "photoacoustic saturation")
AnnotationAssertion(dcterms:description goldbook:08658 "Condition in photoacoustic spectroscopy in which all bands with greater than a certain absorption intensity appear to have the same intensity.")
Declaration(Class(goldbook:08659))
AnnotationAssertion(rdfs:label goldbook:08659 "photothermal spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08659 "Measurement method of spectroscopy in which the absorption of electromagnetic radiation by a sample is detected as a result of the heat generated by the absorption.")
Declaration(Class(goldbook:08660))
AnnotationAssertion(rdfs:label goldbook:08660 "polarized Raman band")
AnnotationAssertion(dcterms:description goldbook:08660 "Raman band with depolarization ratio \\(\\rho \\le 0.75\\) for linear polarized incident radiation in normal Raman spectroscopy.")
Declaration(Class(goldbook:08661))
AnnotationAssertion(rdfs:label goldbook:08661 "potential coupling")
AnnotationAssertion(dcterms:description goldbook:08661 "Coupling of vibrational displacements through terms in the vibrational potential energy. The second-order (quadratic) terms cause harmonic potential coupling while the cubic and higher terms cause anharmonic potential coupling.")
Declaration(Class(goldbook:08662))
AnnotationAssertion(rdfs:label goldbook:08662 "p-polarization")
AnnotationAssertion(dcterms:description goldbook:08662 "Polarization when electromagnetic radiation is incident upon a surface with its electric vector in the plane of incidence and, therefore, inclined to the reflecting surface unless the incidence is normal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08662 "TM polarization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08662 "transverse magnetic polarization")
Declaration(Class(goldbook:08663))
AnnotationAssertion(rdfs:label goldbook:08663 "pressure broadening")
AnnotationAssertion(dcterms:description goldbook:08663 "Increase in the line width of a spectral line of a gas due to molecular collisions and other intermolecular interactions that reduce the lifetime of an excited state.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08663 "collision broadening")
Declaration(Class(goldbook:08664))
AnnotationAssertion(rdfs:label goldbook:08664 "quantum cascade laser")
AnnotationAssertion(dcterms:description goldbook:08664 "Laser that emits mid-infrared radiation.")
Declaration(Class(goldbook:08665))
AnnotationAssertion(rdfs:label goldbook:08665 "Raman band")
AnnotationAssertion(dcterms:description goldbook:08665 "Spectral band in Raman spectroscopy.")
Declaration(Class(goldbook:08666))
AnnotationAssertion(rdfs:label goldbook:08666 "Raman optical activity")
AnnotationAssertion(dcterms:description goldbook:08666 "Phenomenon that vibrations in chiral molecules and materials Raman scattering right circularly polarized incident radiation to a different extent than left circularly polarized incident radiation.")
Declaration(Class(goldbook:08667))
AnnotationAssertion(rdfs:label goldbook:08667 "Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08667 "Inelastic scattering of electromagnetic radiation by molecules that are excited to higher energy levels.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08667 "normal Raman scattering")
Declaration(Class(goldbook:08668))
AnnotationAssertion(rdfs:label goldbook:08668 "Raman shift")
AnnotationAssertion(dcterms:description goldbook:08668 "Difference in wavenumber between the incident and scattered electromagnetic radiation in Raman spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08668 "Raman wavenumber shift")
Declaration(Class(goldbook:08669))
AnnotationAssertion(rdfs:label goldbook:08669 "Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08669 "Measurement principle of vibrational spectroscopy based on Raman scattering.")
Declaration(Class(goldbook:08670))
AnnotationAssertion(rdfs:label goldbook:08670 "Raman spectrum")
AnnotationAssertion(dcterms:description goldbook:08670 "Graph of the intensity of scattered electromagnetic radiation in Raman spectroscopy against Raman shift.")
Declaration(Class(goldbook:08671))
AnnotationAssertion(rdfs:label goldbook:08671 "Raman wavenumber shift")
AnnotationAssertion(dcterms:description goldbook:08671 "Wavenumber of exciting electromagnetic radiation minus wavenumber of the scattered radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08671 "Raman shift")
Declaration(Class(goldbook:08672))
AnnotationAssertion(rdfs:label goldbook:08672 "rapid-scan Fourier-transform infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08672 "Fourier-transform infrared spectroscopy in which the optical path difference is continually changed at a rate of \\(\\pu{0.05 cm s-1}\\) or greater.")
Declaration(Class(goldbook:08673))
AnnotationAssertion(rdfs:label goldbook:08673 "reflection-absorption at grazing incidence")
AnnotationAssertion(dcterms:description goldbook:08673 "Reflection-absorption with very thin layers of an absorbing material on a metallic substrate and the angle of incidence between \\(\\pu{70\\!^{\\circ}}\\) and \\(\\pu{90\\!^{\\circ}}\\).")
Declaration(Class(goldbook:08674))
AnnotationAssertion(rdfs:label goldbook:08674 "resonance Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08674 "Raman scattering that occurs through the polarizability of a molecule, (not the hyperpolarizabilities) and is excited by electromagnetic radiation that is in resonance with electronic transitions or vibronic transitions in the sample.")
Declaration(Class(goldbook:08675))
AnnotationAssertion(rdfs:label goldbook:08675 "rotational branch")
AnnotationAssertion(dcterms:description goldbook:08675 "Spectral lines in the rotation-vibration spectrum of a gas that derive from the same change in rotation quantum number, \\(J\\).")
Declaration(Class(goldbook:08676))
AnnotationAssertion(rdfs:label goldbook:08676 "rotation-vibration spectrum")
AnnotationAssertion(dcterms:description goldbook:08676 "Spectrum that shows absorption or emission of radiation during transitions between rotational-vibrational states of a molecule.")
Declaration(Class(goldbook:08677))
AnnotationAssertion(rdfs:label goldbook:08677 "scattering geometry")
AnnotationAssertion(dcterms:description goldbook:08677 "Relation between the propagation directions, \\(k_{\\rm{i}}\\), \\(k_{\\rm{s}}\\), and the polarization directions, \\(p_{\\rm{i}}\\), \\(p_{\\rm{s}}\\), of the incident and scattered radiation, usually expressed in terms of laboratory-fixed or crystal-fixed Cartesian axes.")
Declaration(Class(goldbook:08678))
AnnotationAssertion(rdfs:label goldbook:08678 "site splitting")
AnnotationAssertion(dcterms:description goldbook:08678 "Appearance of more than one band in the spectrum of a crystal when only one is seen in that of the gas, when this splitting is attributed to either the molecule lying on a crystal site of lower symmetry than that of the gaseous molecule or to molecules occupying more than one type of crystal site. See crystal field splitting.")
Declaration(Class(goldbook:08679))
AnnotationAssertion(rdfs:label goldbook:08679 "spatially offset Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08679 "Measurement method of Raman spectroscopy in which the sample is illuminated at one location, and the Raman signal is collected from a different location on the sample surface.")
Declaration(Class(goldbook:08680))
AnnotationAssertion(rdfs:label goldbook:08680 "spherical top")
AnnotationAssertion(dcterms:description goldbook:08680 "Molecule whose three principal moments of inertia are all the same. An isotropic molecule.")
Declaration(Class(goldbook:08681))
AnnotationAssertion(rdfs:label goldbook:08681 "step-scan interferometer")
AnnotationAssertion(dcterms:description goldbook:08681 "Interferometer (typically used for Fourier-transform infrared spectroscopy) in which the optical path difference is changed by a certain amount, held constant, or modulated if phase modulation is desired, while the signal at the current path difference is recorded, then the process is repeated.")
Declaration(Class(goldbook:08682))
AnnotationAssertion(rdfs:label goldbook:08682 "stimulated Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08682 "Two-photon Raman scattering occurs when a picosecond pump beam is used to create a virtual state and a probe beam of a frequency to match the frequency of Stokes Raman scattering from the virtual state to a specific vibrational level. The Stokes emission is stimulated thus depopulating the virtual state very quickly and increasing the scattering efficiency for the chosen vibration by orders of magnitude. SRS is a non-linear process, so sufficient photons from both the pump and probe beams must be present on the molecule at the one time.")
Declaration(Class(goldbook:08683))
AnnotationAssertion(rdfs:label goldbook:08683 "Stokes–Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08683 "Raman scattering of electromagnetic radiation in which the scattered radiation has lesser energy (lesser wavenumber) than the exciting radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08683 "Stokes scattering")
Declaration(Class(goldbook:08684))
AnnotationAssertion(rdfs:label goldbook:08684 "sum band")
AnnotationAssertion(dcterms:description goldbook:08684 "Band resulting from a sum transition.")
Declaration(Class(goldbook:08685))
AnnotationAssertion(rdfs:label goldbook:08685 "sum transition")
AnnotationAssertion(dcterms:description goldbook:08685 "Combination transition between the ground state and a state in which more than one vibration is excited; i.e., a transition from the ground state in which more than one quantum number increases.")
Declaration(Class(goldbook:08686))
AnnotationAssertion(rdfs:label goldbook:08686 "sum-frequency spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08686 "Nonlinear optical technique in which pulsed lasers at frequencies \\(\\omega_{1}\\) and \\(\\omega_{2}\\) are overlapped at a surface and light emitted at the sum of the two frequencies, \\(\\omega_{1} + \\omega_{2}\\), is detected. One laser is normally in the mid-infrared and the other in the visible or near-infrared.")
Declaration(Class(goldbook:08687))
AnnotationAssertion(rdfs:label goldbook:08687 "surface-enhanced hyper-Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08687 "Measurement method of Raman spectroscopy by which the Raman spectrum is significantly enhanced simultaneously by both the hyper-Raman (see hyper-Raman spectroscopy) and surface-enhanced Raman (see surface-enhanced Raman spectroscopy) effects.")
Declaration(Class(goldbook:08688))
AnnotationAssertion(rdfs:label goldbook:08688 "surface-enhanced infrared absorption")
AnnotationAssertion(dcterms:description goldbook:08688 "Measurement method of infrared spectroscopy by which the intensity of absorption bands of molecules within a few nanometers of the surface of metal particles is increased by interactions with surface plasmons (the collective resonance of electrons near the surface of metal islands).")
Declaration(Class(goldbook:08689))
AnnotationAssertion(rdfs:label goldbook:08689 "surface-enhanced Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08689 "Measurement method of Raman spectroscopy by which the intensity of vibrational bands in the Raman spectra of molecules within a few nanometers of the surface of microscopically rough metals, metal colloids and metal nanoparticles is increased by several orders of magnitude.")
Declaration(Class(goldbook:08690))
AnnotationAssertion(rdfs:label goldbook:08690 "surface-enhanced resonance Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08690 "Measurement method of surface-enhanced Raman spectroscopy (SERS) by which the Raman spectrum is significantly enhanced when the conditions occur that whilst undergoing SERS the molecules are excited by radiation that is in resonance with electronic transitions in the sample.")
Declaration(Class(goldbook:08691))
AnnotationAssertion(rdfs:label goldbook:08691 "surface-enhanced, spatially offset Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08691 "Measurement method of Raman spectroscopy that combines spatially offset Raman spectroscopy and surface-enhanced Raman spectroscopy (SERS) enabling the detection of a SERS signal deep within diffusely scattering samples.")
Declaration(Class(goldbook:08692))
AnnotationAssertion(rdfs:label goldbook:08692 "symmetric")
AnnotationAssertion(dcterms:description goldbook:08692 "Term used in at least two senses in vibrational spectroscopy. In general usage, a symmetric molecule is a molecule with high symmetry. In more specific usage, a property is symmetric with respect to a symmetry element if it remains unchanged by the action of the corresponding symmetry operation.")
Declaration(Class(goldbook:08693))
AnnotationAssertion(rdfs:label goldbook:08693 "symmetric top")
AnnotationAssertion(dcterms:description goldbook:08693 "Molecule that has two equal principal moments of inertia with the third one different.")
Declaration(Class(goldbook:08694))
AnnotationAssertion(rdfs:label goldbook:08694 "symmetry coordinate")
AnnotationAssertion(dcterms:description goldbook:08694 "Each \\(S_{i}\\) is a linear combination of general coordinates, usually internal coordinates, constructed to take advantage of the molecular symmetry. The \\(S_{i}\\) are elements of the vector \\(\\boldsymbol{S}\\). They have the same units as the general coordinates from which they were constructed.")
Declaration(Class(goldbook:08695))
AnnotationAssertion(rdfs:label goldbook:08695 "symmorphic space group")
AnnotationAssertion(dcterms:description goldbook:08695 "Space group that does not contain screw-axes and glide planes.")
Declaration(Class(goldbook:08696))
AnnotationAssertion(rdfs:label goldbook:08696 "thermal diffusion depth")
AnnotationAssertion(dcterms:description goldbook:08696 "In photoacoustic spectroscopy, \\(L = \\sqrt{(D/\\pi f)}\\), where \\(D\\) is thermal diffusivity and \\(f\\) is modulation frequency of the electromagnetic radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08696 "thermal wave decay length")
Declaration(Class(goldbook:08697))
AnnotationAssertion(rdfs:label goldbook:08697 "thermal diffusivity")
AnnotationAssertion(dcterms:description goldbook:08697 "Thermal conductivity divided by the product of the specific heat and the density.")
Declaration(Class(goldbook:08698))
AnnotationAssertion(rdfs:label goldbook:08698 "thermal wave decay coefficient")
AnnotationAssertion(dcterms:description goldbook:08698 "Reciprocal of the thermal diffusion depth (\\(L\\)). \\(a_{\\rm{s}} = 1/L\\).")
Declaration(Class(goldbook:08699))
AnnotationAssertion(rdfs:label goldbook:08699 "tip-enhanced Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08699 "Measurement method of Raman spectroscopy combining surface-enhanced Raman spectroscopy and scanning using an atomic force microscope or scanning tunnelling microscope to give complementary maps of a surface.")
Declaration(Class(goldbook:08700))
AnnotationAssertion(rdfs:label goldbook:08700 "total internal reflection")
AnnotationAssertion(dcterms:description goldbook:08700 "Internal reflection from a non-absorbing material at angles of incidence at or above the critical angle.")
Declaration(Class(goldbook:08701))
AnnotationAssertion(rdfs:label goldbook:08701 "transflectance")
AnnotationAssertion(dcterms:description goldbook:08701 "Spectral intensity of a transflected beam divided by spectral intensity of the incident beam in a transflection experiment.")
Declaration(Class(goldbook:08702))
AnnotationAssertion(rdfs:label goldbook:08702 "transflection")
AnnotationAssertion(dcterms:description goldbook:08702 "Reflection absorption at near-normal incidence when the thickness of the absorbing medium is large enough to yield an interpretable spectrum. The substrate is usually a mirror for mid-infrared measurements and a ceramic disk for near-infrared measurements. The angle of incidence is typically between \\(\\pu{0\\!^{\\circ}}\\) and \\(\\pu{45\\!^{\\circ}}\\).")
Declaration(Class(goldbook:08703))
AnnotationAssertion(rdfs:label goldbook:08703 "transmission Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08703 "Measurement method of Raman spectroscopy in which the sample is illuminated on one side and the Raman signal is collected from the opposite side.")
Declaration(Class(goldbook:08704))
AnnotationAssertion(rdfs:label goldbook:08704 "vibrational circular dichroism")
AnnotationAssertion(dcterms:description goldbook:08704 "Circular dichroism, \\(k^{\\rm{L}} – k^{\\rm{R}}\\), for vibrational transitions.")
Declaration(Class(goldbook:08705))
AnnotationAssertion(rdfs:label goldbook:08705 "vibrational eigenvector")
AnnotationAssertion(dcterms:description goldbook:08705 """Part of the solution of the matrix equation of normal coordinate analysis, \\(\\boldsymbol{G\\!F\\!L} = \\boldsymbol{L \\lambda}\\). Each element \\(L_{ik}\\) of \\(\\boldsymbol{L}\\) is a vibrational eigenvector, and gives the change in internal coordinate \\(R_{i}\\) during unit change in the normal coordinate \\(Q_{k}\\), as shown in matrix form by \\(\\boldsymbol{R} = \\boldsymbol{LQ}\\), i.e., \\(L_{ik} = \\partial R_{i}/\\partial Q_{k}\\).
Eigenvectors are sometimes expressed in terms of symmetry coordinates or Cartesian coordinates.""")
Declaration(Class(goldbook:08706))
AnnotationAssertion(rdfs:label goldbook:08706 "vibrational kinetic energy")
AnnotationAssertion(dcterms:description goldbook:08706 "Kinetic energy of the molecule as a function of the displacements of the atoms from equilibrium positions. For Cartesian displacement coordinates (\\(x, y, z\\)), \\[T = \\sum_{\\alpha}&frac12;m_{\\alpha}(\\dot x_{\\alpha}^{2} + \\dot y_{\\alpha}^{2} + \\dot z_{\\alpha}^{2})\\] where the sum is over all atoms and \\(\\dot{x}_{\\alpha}\\), etc., are the displacement velocities. For internal coordinates \\[T = &frac12;\\boldsymbol{P}^{t}\\boldsymbol{GP} = &frac12;\\dot{\\boldsymbol{R}}^{t}{\\boldsymbol{G}}^{-1}\\dot {\\boldsymbol{R}} = &frac12;\\sum_{ij}G_{ij}^{-1}\\dot R_{i}\\dot R_{j}\\] where \\(\\dot {\\boldsymbol{R}}^{t}\\) and \\(\\dot {\\boldsymbol{R}}\\) are the row and column vector, respectively, of the \\(\\partial R_{i}/\\partial t\\), \\(\\boldsymbol{P}^{t}\\) and \\(\\boldsymbol{P}\\) are the row and column vector, respectively, of the momenta conjugate to the \\(R_{i}\\), \\(\\boldsymbol{G}^{-1}\\) is the inverse of the \\(\\boldsymbol{G}\\) matrix and \\(G_{ij}^{-1}\\) is the \\(ij^{\\rm{th}}\\) element of \\(\\boldsymbol{G}^{-1}\\). The elements of the \\(\\boldsymbol{G}\\) matrix are defined by \\[G_{ij} = \\sum_{\\alpha} \\frac{1}{m_{\\alpha}} B_{i\\alpha} B_{j\\alpha}\\] where \\(B_{i\\alpha}\\) and \\(B_{j\\alpha}\\) relate the \\(i^{\\rm{th}}\\) and \\(j^{\\rm{th}}\\) internal coordinate to the \\(\\alpha^{\\rm{th}}\\) Cartesian coordinate through the equation \\(\\boldsymbol{R} = \\boldsymbol{BX}\\) in which \\(\\boldsymbol{X}\\) is the column vector of the Cartesian coordinates.")
Declaration(Class(goldbook:08707))
AnnotationAssertion(rdfs:label goldbook:08707 "vibrational potential energy")
AnnotationAssertion(dcterms:description goldbook:08707 """Potential energy of the molecule as a function of the displacements of the atoms from equilibrium positions. The harmonic terms are quadratic in the displacements and the anharmonic terms are of cubic, quartic and higher orders in the displacements.
\\(Q\\) are normal coordinates \\[2V = \\sum\\limits_{k}\\lambda_{k}Q_{k}^{2} + \\sum\\limits_{ijk}k_{ijk}Q_{i}Q_{j}Q_{k} + higher\\,order\\,terms\\]
In terms of internal coordinates, \\[2V = \\sum\\limits_{i} F_{ii} R_i^{2} + \\sum\\limits_{i,j
e i} F_{ij} R_{i} R_{j} + \\sum\\limits_{i,j,k} F_{ijk} R_{i} R_{j} R_{k} + higher\\,order\\,terms\\]""")
Declaration(Class(goldbook:08708))
AnnotationAssertion(rdfs:label goldbook:08708 "vibrational spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08708 "Measurement principle of spectroscopy to analyse molecular properties based on vibrations (bond stretching or deformation modes) in chemical species.")
Declaration(Class(goldbook:08709))
AnnotationAssertion(rdfs:label goldbook:08709 "vibrational term value")
AnnotationAssertion(dcterms:description goldbook:08709 "Vibrational energy, \\(E\\), expressed in wavenumber units. \\(G = E/(hc)\\), where \\(h\\) is the Planck constant and \\(c\\) is the speed of light in vacuum.")
Declaration(Class(goldbook:08710))
AnnotationAssertion(rdfs:label goldbook:08710 "volume reflection")
AnnotationAssertion(dcterms:description goldbook:08710 "Re-emergence of electromagnetic radiation from the surface of incidence after penetrating into a powdered sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08710 "Kubelka–Munk reflection")
Declaration(Class(goldbook:08711))
AnnotationAssertion(rdfs:label goldbook:08711 "absolute counting efficiency")
AnnotationAssertion(dcterms:description goldbook:08711 "Number of particles or photons counted by a radiation detector divided by the number emitted by a radiation source.")
Declaration(Class(goldbook:08712))
AnnotationAssertion(rdfs:label goldbook:08712 "accelerator mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:08712 "Mass spectrometry technique in which atoms and molecules from a sample are ionized, accelerated to mega-electron volt (\\(\\pu{1 MeV} = \\pu{1.602176634E-13 J}\\)) energies, and separated according to their momentum, charge, and energy, allowing high discrimination for the measurement of nuclide abundances.")
Declaration(Class(goldbook:08713))
AnnotationAssertion(rdfs:label goldbook:08713 "activity growth curve")
AnnotationAssertion(dcterms:description goldbook:08713 "Graph of the activity of a radioactive nuclide as a function of time and showing the increase of activity through the decay of the precursor or as a result of activation.")
Declaration(Class(goldbook:08714))
AnnotationAssertion(rdfs:label goldbook:08714 "backscattering analysis")
AnnotationAssertion(dcterms:description goldbook:08714 "Measurement principle in which the backscattering of nuclear radiation impinging on a sample is applied to measure the structure and composition of materials.")
Declaration(Class(goldbook:08716))
AnnotationAssertion(rdfs:label goldbook:08716 "calibration, k0 method")
AnnotationAssertion(dcterms:description goldbook:08716 "Calibration method of neutron activation analysis in which the \\(k_{0}\\) proportionality factors, together with a value of the neutron flux (as a function of the neutron energy) and with a value of the radiation detector's response for gamma radiation (as a function of the gamma-ray energy) are used for establishing a relationship between the number of counts measured and the corresponding amounts of elements in a material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08716 "<em>k</em><sub>0</sub> method of calibration")
Declaration(Class(goldbook:08717))
AnnotationAssertion(rdfs:label goldbook:08717 "calibrator")
AnnotationAssertion(dcterms:description goldbook:08717 "Measured amount of an element with stated measurement uncertainty that is simultaneously irradiated with the sample during activation analysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08717 "comparator (obsolete)")
Declaration(Class(goldbook:08718))
AnnotationAssertion(rdfs:label goldbook:08718 "channeling effect")
AnnotationAssertion(dcterms:description goldbook:08718 "Range- (traveling distance) increasing effect caused by the decrease in interaction cross sections of the incident particles with atoms in a single crystal when a highly collimated particle beam impinges on a crystal along its principal axis or principal plane.")
Declaration(Class(goldbook:08719))
AnnotationAssertion(rdfs:label goldbook:08719 "channels ratio method")
AnnotationAssertion(dcterms:description goldbook:08719 "Measurement method to obtain a quenching correction by counting the spectrum in two separate channels, the ratio of which gives the degree of quenching.")
Declaration(Class(goldbook:08720))
AnnotationAssertion(rdfs:label goldbook:08720 "Compton scattering analysis")
AnnotationAssertion(dcterms:description goldbook:08720 "Measurement principle in which wavelengths and angular distribution of Compton scattered electrons is applied in order to reconstruct X-ray and gamma-ray spectra.")
Declaration(Class(goldbook:08721))
AnnotationAssertion(rdfs:label goldbook:08721 "cross reactivity")
AnnotationAssertion(dcterms:description goldbook:08721 "Ability of substances other than the analyte to bind to the binding reagent and ability of substances other than the binding reagent to bind the analyte in competitive binding assays.")
Declaration(Class(goldbook:08722))
AnnotationAssertion(rdfs:label goldbook:08722 "cross section")
AnnotationAssertion(dcterms:description goldbook:08722 "Characteristic area related to the probability of a specified interaction or reaction between an incident nuclear radiation and a target particle or system of particles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08722 "microscopic cross section")
Declaration(Class(goldbook:08723))
AnnotationAssertion(rdfs:label goldbook:08723 "delayed-neutron activation analysis")
AnnotationAssertion(dcterms:description goldbook:08723 "Neutron activation analysis where neutrons are counted after a delay to allow interfering species to decay.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08723 "delayed-neutron analysis (DNA)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08723 "delayed-neutron counting (DNC)")
Declaration(Class(goldbook:08724))
AnnotationAssertion(rdfs:label goldbook:08724 "directly-ionizing radiation")
AnnotationAssertion(dcterms:description goldbook:08724 "Beam of particles capable of removing one or more orbital electrons in a single quantum event from a specified atom resulting in an ion.")
Declaration(Class(goldbook:08725))
AnnotationAssertion(rdfs:label goldbook:08725 "external standardization for quenching correction")
AnnotationAssertion(dcterms:description goldbook:08725 "Measurement method to obtain a quenching correction through the use of a gamma-radiation source to generate a spectrum of Compton electrons within the sample vial.")
Declaration(Class(goldbook:08726))
AnnotationAssertion(rdfs:label goldbook:08726 "flux monitor")
AnnotationAssertion(dcterms:description goldbook:08726 "Radiation detector to measure energy flux density.")
Declaration(Class(goldbook:08727))
AnnotationAssertion(rdfs:label goldbook:08727 "flux perturbation")
AnnotationAssertion(dcterms:description goldbook:08727 "Change of energy flux density or energy distribution of particles or photons in an object as a result of effects such as flux depression and/or self-shielding.")
Declaration(Class(goldbook:08728))
AnnotationAssertion(rdfs:label goldbook:08728 "gamma-ray spectrometry")
AnnotationAssertion(dcterms:description goldbook:08728 "Measurement principle of the quantitative study of the energy spectra of gamma-ray sources.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08728 "gamma-ray spectroscopy (obsolete)")
Declaration(Class(goldbook:08729))
AnnotationAssertion(rdfs:label goldbook:08729 "half-value thickness")
AnnotationAssertion(dcterms:description goldbook:08729 "Thickness of a specified material that, when introduced into the path of a given beam of radiation, reduces the intensity of a specified radiation by one half.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08729 "half thickness")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08729 "half-value layer thickness")
Declaration(Class(goldbook:08730))
AnnotationAssertion(rdfs:label goldbook:08730 "indirectly-ionizing radiation")
AnnotationAssertion(dcterms:description goldbook:08730 "Beam of electrically neutral particles that cause ionization by interacting with atoms in a material, producing electrically-charged particles that subsequently cause direct ionization in the material.")
Declaration(Class(goldbook:08731))
AnnotationAssertion(rdfs:label goldbook:08731 "<em>in-vivo</em> neutron activation analysis")
AnnotationAssertion(dcterms:description goldbook:08731 "Measurement method of neutron activation analysis in which a living organism is exposed to neutrons to measure the concentrations of elements in that living organism.")
Declaration(Class(goldbook:08732))
AnnotationAssertion(rdfs:label goldbook:08732 "ion beam analysis")
AnnotationAssertion(dcterms:description goldbook:08732 "Measurement principle in which elementary particles resulting from nuclear reactions of charged particles with nuclei in a material are applied in order to measure the amount and depth distribution of elements in materials.")
Declaration(Class(goldbook:08733))
AnnotationAssertion(rdfs:label goldbook:08733 "isotopic label")
AnnotationAssertion(dcterms:description goldbook:08733 "Radioactive or stable isotope of a specified element distinguishable by the observer but not by the system used to identify an isotopic tracer.")
Declaration(Class(goldbook:08735))
AnnotationAssertion(rdfs:label goldbook:08735 "monoisotopic element")
AnnotationAssertion(dcterms:description goldbook:08735 "Chemical element having only one stable nuclide.")
Declaration(Class(goldbook:08736))
AnnotationAssertion(rdfs:label goldbook:08736 "Mössbauer spectrometry")
AnnotationAssertion(dcterms:description goldbook:08736 "Measurement method in which recoil-less resonance gamma ray scattering and absorption in solids is applied to measure the nuclear environment of atoms of elements in a material.")
Declaration(Class(goldbook:08737))
AnnotationAssertion(rdfs:label goldbook:08737 "muon induced X-ray emission analysis")
AnnotationAssertion(dcterms:description goldbook:08737 "Measurement method of X-ray analysis in which characteristic X-radiation emitted upon irradiation of a material with a beam of muons of certain energy is used to measure the chemical composition and chemical state of an element.")
Declaration(Class(goldbook:08738))
AnnotationAssertion(rdfs:label goldbook:08738 "near edge X-ray absorption fine structure")
AnnotationAssertion(dcterms:description goldbook:08738 "Measurement method of X-ray absorption analysis similar to X-ray absorption near edge structure, but usually reserved for soft X-rays with photon energy less than \\(\\pu{1 keV}\\).")
Declaration(Class(goldbook:08739))
AnnotationAssertion(rdfs:label goldbook:08739 "neutron activation analysis")
AnnotationAssertion(dcterms:description goldbook:08739 "Activation analysis using neutrons as the incident particles.")
Declaration(Class(goldbook:08740))
AnnotationAssertion(rdfs:label goldbook:08740 "neutron depth profiling")
AnnotationAssertion(dcterms:description goldbook:08740 "Measurement method of activation analysis for near-surface-depth light elements in which a thermal neutron or cold neutron (see: neutron energy) beam passes through a material with target nuclei that emit monoenergetic charged particles upon neutron absorption. The reduction of the energy of an emitted charged particle measures the depth of the target nuclei in a material.")
Declaration(Class(goldbook:08741))
AnnotationAssertion(rdfs:label goldbook:08741 "neutron diffraction analysis")
AnnotationAssertion(dcterms:description goldbook:08741 "Measurement method in which the diffraction of neutrons is applied to measure parameters of the atomic and/or magnetic structure of a material.")
Declaration(Class(goldbook:08742))
AnnotationAssertion(rdfs:label goldbook:08742 "neutron energy")
AnnotationAssertion(dcterms:description goldbook:08742 "Kinetic energy of a free neutron.")
Declaration(Class(goldbook:08743))
AnnotationAssertion(rdfs:label goldbook:08743 "neutron scattering analysis")
AnnotationAssertion(dcterms:description goldbook:08743 "Measurement method in which the elastic or inelastic scattering of neutrons by the target nuclei is applied to study the composition and structure of a material.")
Declaration(Class(goldbook:08744))
AnnotationAssertion(rdfs:label goldbook:08744 "non-radiative quenching")
AnnotationAssertion(dcterms:description goldbook:08744 "Deactivation of an electronically-excited state by interaction with the external environment through a non-radiative process.")
Declaration(Class(goldbook:08745))
AnnotationAssertion(rdfs:label goldbook:08745 "nuclear capture")
AnnotationAssertion(dcterms:description goldbook:08745 "Process in which an atomic nucleus acquires an additional particle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08745 "capture")
Declaration(Class(goldbook:08746))
AnnotationAssertion(rdfs:label goldbook:08746 "nuclide precursor")
AnnotationAssertion(dcterms:description goldbook:08746 "Radionuclide which precedes a nuclide in a decay chain.")
Declaration(Class(goldbook:08747))
AnnotationAssertion(rdfs:label goldbook:08747 "particle flux density")
AnnotationAssertion(dcterms:description goldbook:08747 "Number of particles (or photons) incident on a plane perpendicular to the incident radiation per unit time per unit area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08747 "fluence rate (obsolete)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08747 "photon flux density")
Declaration(Class(goldbook:08748))
AnnotationAssertion(rdfs:label goldbook:08748 "particle-induced gamma-ray-emission analysis")
AnnotationAssertion(dcterms:description goldbook:08748 "Measurement principle in which the energies and intensities of characteristic prompt gamma-radiation emitted during nuclear reactions with charged particles other than electrons is used to measure the amounts of elements in a material.")
Declaration(Class(goldbook:08749))
AnnotationAssertion(rdfs:label goldbook:08749 "perturbed angular correlation spectrometry")
AnnotationAssertion(dcterms:description goldbook:08749 "Measurement method of gamma-ray spectrometry in which coincidence counting is used for the measurement of parameters describing hyperfine interactions, with internal or external electrical or magnetic field gradients, of the spin of an intermediate level between two gamma-ray transitions in cascade emitted in the decay of a radionuclide.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08749 "perturbed directional correlation spectrometry")
Declaration(Class(goldbook:08750))
AnnotationAssertion(rdfs:label goldbook:08750 "positron annihilation analysis")
AnnotationAssertion(dcterms:description goldbook:08750 "Measurement principle in which the annihilation of positrons is applied to study the microscopic structure of materials.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08750 "positron annihilation spectroscopy for chemical analysis (PASCA)")
Declaration(Class(goldbook:08751))
AnnotationAssertion(rdfs:label goldbook:08751 "positron emission tomography")
AnnotationAssertion(dcterms:description goldbook:08751 "Imaging method based on the detection of pairs of gamma rays emitted indirectly by a positron-emitting isotopic tracer.")
Declaration(Class(goldbook:08752))
AnnotationAssertion(rdfs:label goldbook:08752 "positron lifetime spectrometry")
AnnotationAssertion(dcterms:description goldbook:08752 "Measurement method of positron annihilation analysis in which the time interval between the emission of positrons from a radioactive source and the detection of gamma rays due to the annihilation of these positrons with electrons from the surrounding matter is the lifetime of the positron or positronium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08752 "positron annihilation lifetime spectrometry (PALS)")
Declaration(Class(goldbook:08753))
AnnotationAssertion(rdfs:label goldbook:08753 "prompt gamma radiation")
AnnotationAssertion(dcterms:description goldbook:08753 "Gamma radiation emitted during the de-excitation of a compound nucleus formed in a nuclear capture reaction.")
Declaration(Class(goldbook:08754))
AnnotationAssertion(rdfs:label goldbook:08754 "prompt gamma-ray analysis")
AnnotationAssertion(dcterms:description goldbook:08754 "Measurement principle in which gamma radiation emitted during the de-excitation of the compound nucleus formed by neutron capture is applied to measure the amounts of elements in a material.")
Declaration(Class(goldbook:08755))
AnnotationAssertion(rdfs:label goldbook:08755 "pulse pile-up")
AnnotationAssertion(dcterms:description goldbook:08755 "Processing by a radiation counter of pulses resulting from the simultaneous absorption of independent particles or photons in a radiation detector, resulting in them being counted as one single particle or photon with energy between the individual energies and the sum of these energies.")
Declaration(Class(goldbook:08757))
AnnotationAssertion(rdfs:label goldbook:08757 "radiation filter")
AnnotationAssertion(dcterms:description goldbook:08757 "Material interposed in the path of radiation to modify the energy distribution of the radiation.")
Declaration(Class(goldbook:08758))
AnnotationAssertion(rdfs:label goldbook:08758 "radioactive steady state")
AnnotationAssertion(dcterms:description goldbook:08758 "Among the radionuclides of a decay chain, the state that prevails when the ratios between the activities of successive radionuclides remain constant.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08758 "radioactive equilibrium")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08758 "secular equilibrium")
Declaration(Class(goldbook:08759))
AnnotationAssertion(rdfs:label goldbook:08759 "recovery time")
AnnotationAssertion(dcterms:description goldbook:08759 "Period of time after the dead time of a radiation counter during which the output pulses are smaller than the original.")
Declaration(Class(goldbook:08760))
AnnotationAssertion(rdfs:label goldbook:08760 "relative counting efficiency")
AnnotationAssertion(dcterms:description goldbook:08760 "Absolute counting efficiency of a given radiation counter divided by the absolute counting efficiency of a reference radiation counter.")
Declaration(Class(goldbook:08761))
AnnotationAssertion(rdfs:label goldbook:08761 "scanning proton microscopy")
AnnotationAssertion(dcterms:description goldbook:08761 "Measurement method of X-ray fluorescence analysis in which protons are focused and collimated to form a micro beam to obtain an image of a surface.")
Declaration(Class(goldbook:08762))
AnnotationAssertion(rdfs:label goldbook:08762 "selectively-labelled isotopic tracer")
AnnotationAssertion(dcterms:description goldbook:08762 "An isotopically labelled compound is designated as selectively labelled when a mixture of isotopically substituted compounds is formally added to the analogous isotopically unmodified compound in such a way that the position(s), but not necessarily the number, of each labelling nuclide is defined.")
Declaration(Class(goldbook:08763))
AnnotationAssertion(rdfs:label goldbook:08763 "specific activity (radionuclide)")
AnnotationAssertion(dcterms:description goldbook:08763 "Activity of a specified radionuclide (\\(\\ce{R}\\)) per unit mass of that nuclide.")
Declaration(Class(goldbook:08764))
AnnotationAssertion(rdfs:label goldbook:08764 "synchrotron radiation induced X-ray fluorescence analysis")
AnnotationAssertion(dcterms:description goldbook:08764 "Measurement method of X-ray fluorescence analysis in which synchrotron X-radiation is used to irradiate the substance.")
Declaration(Class(goldbook:08765))
AnnotationAssertion(rdfs:label goldbook:08765 "total reflection X-ray fluorescence analysis")
AnnotationAssertion(dcterms:description goldbook:08765 "Measurement method of X-ray fluorescence analysis in which a collimated X-ray flux impinges on a smooth surface under a grazing angle; rendering total reflection is used to excite atoms in the top layers of the material for measurement of the amounts of elements.")
Declaration(Class(goldbook:08766))
AnnotationAssertion(rdfs:label goldbook:08766 "X-ray absorption analysis")
AnnotationAssertion(dcterms:description goldbook:08766 "Measurement principle of X-ray analysis in which the absorption spectrum is used to measure the number of atoms, species, and other parameters of chemical elements.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08766 "X-ray absorption spectroscopy (XAS)")
Declaration(Class(goldbook:08767))
AnnotationAssertion(rdfs:label goldbook:08767 "X-ray absorption edge")
AnnotationAssertion(dcterms:description goldbook:08767 "Increase in X-ray absorption observed at the energy at which a strongly bound electron is released.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08767 "absorption edge")
Declaration(Class(goldbook:08768))
AnnotationAssertion(rdfs:label goldbook:08768 "X-ray absorption near edge structure")
AnnotationAssertion(dcterms:description goldbook:08768 "Measurement method of X-ray absorption analysis in which the fine structure of the adsorption spectrum in the range \\(\\pu{30 eV}\\) below to \\(\\pu{50 eV}\\) above the absorption edge is used to measure parameters describing the chemical state, coordination environment, and local geometry distortion for the X-ray absorbing atom.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08768 "X-ray absorption near edge fine structure")
Declaration(Class(goldbook:08769))
AnnotationAssertion(rdfs:label goldbook:08769 "X-ray analysis")
AnnotationAssertion(dcterms:description goldbook:08769 "Measurement principle in which characteristic X-radiation, produced upon irradiation of a material with elementary particles or photons, is applied to measure amounts of elements in a material.")
Declaration(Class(goldbook:08770))
AnnotationAssertion(rdfs:label goldbook:08770 "X-ray computed micro-tomography")
AnnotationAssertion(dcterms:description goldbook:08770 "Measurement method based on the transmission of X-rays to obtain three-dimensional images of a sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08770 "X-ray micro-tomography (XMT)")
Declaration(Class(goldbook:08771))
AnnotationAssertion(rdfs:label goldbook:08771 "X-ray diffraction analysis")
AnnotationAssertion(dcterms:description goldbook:08771 "Measurement method using diffraction of X-radiation to obtain the spatial arrangement of atoms in a crystalline sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08771 "X-ray diffraction (XRD)")
Declaration(Class(goldbook:08772))
AnnotationAssertion(rdfs:label goldbook:08772 "X-ray fluorescence microscopy")
AnnotationAssertion(dcterms:description goldbook:08772 "Measurement method of X-ray fluorescence to obtain quantitative and spatial information about elements in a sample.")
Declaration(Class(goldbook:08773))
AnnotationAssertion(rdfs:label goldbook:08773 "actuator")
AnnotationAssertion(dcterms:description goldbook:08773 "Transducer that converts the energy supplied or taken from the surroundings into some mechanical motion.")
Declaration(Class(goldbook:08774))
AnnotationAssertion(rdfs:label goldbook:08774 "antisoliton")
AnnotationAssertion(dcterms:description goldbook:08774 "Soliton with the negative amplitude or opposite spin with respect to a given soliton.")
Declaration(Class(goldbook:08775))
AnnotationAssertion(rdfs:label goldbook:08775 "charge carrier")
AnnotationAssertion(dcterms:description goldbook:08775 "Particle or quasiparticle capable of transporting an electric charge.")
Declaration(Class(goldbook:08776))
AnnotationAssertion(rdfs:label goldbook:08776 "charge carrier concentration")
AnnotationAssertion(dcterms:description goldbook:08776 "Number of charge carriers per unit volume.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08776 "concentration of charge carriers")
Declaration(Class(goldbook:08777))
AnnotationAssertion(rdfs:label goldbook:08777 "charge carrier diffusion")
AnnotationAssertion(dcterms:description goldbook:08777 "Purely random, thermally induced motion of charge carriers.")
Declaration(Class(goldbook:08778))
AnnotationAssertion(rdfs:label goldbook:08778 "charge carrier generation")
AnnotationAssertion(dcterms:description goldbook:08778 "Process whereby charge carriers are created.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08778 "charge generation")
Declaration(Class(goldbook:08779))
AnnotationAssertion(rdfs:label goldbook:08779 "charge carrier injection")
AnnotationAssertion(dcterms:description goldbook:08779 "Process whereby charge carriers in excess of the thermodynamic equilibrium level are introduced into a conductor, a semiconductor or an insulator from another material.")
Declaration(Class(goldbook:08780))
AnnotationAssertion(rdfs:label goldbook:08780 "charge carrier mobility")
AnnotationAssertion(dcterms:description goldbook:08780 "Drift velocity (\\(v_{\\rm{d}}\\)) of charge carriers divided by the electric field strength (\\(E\\)). \\[\\mu = v_{\\rm{d}}/E \\quad (\\rm{unit}{:}\\ \\pu{m2 V-1 s-1})\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08780 "charge mobility")
Declaration(Class(goldbook:08781))
AnnotationAssertion(rdfs:label goldbook:08781 "charge carrier recombination")
AnnotationAssertion(dcterms:description goldbook:08781 "Process whereby an electron in the conduction band (in LUMO level) loses its excess energy and re-occupies the energy state of a hole in the valence band (in HOMO level).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08781 "charge recombination")
Declaration(Class(goldbook:08782))
AnnotationAssertion(rdfs:label goldbook:08782 "charge transfer")
AnnotationAssertion(dcterms:description goldbook:08782 "Transfer of charge carriers between two sites of the same molecular entity (intramolecular CT) or between two molecular entities occurring in close proximity (intermolecular CT).")
Declaration(Class(goldbook:08783))
AnnotationAssertion(rdfs:label goldbook:08783 "charge-transfer exciton")
AnnotationAssertion(dcterms:description goldbook:08783 "Exciton formed by a charge-transfer transition.")
Declaration(Class(goldbook:08784))
AnnotationAssertion(rdfs:label goldbook:08784 "conductor")
AnnotationAssertion(dcterms:description goldbook:08784 "Material having the ability to transmit energy or charge carriers or both.")
Declaration(Class(goldbook:08785))
AnnotationAssertion(rdfs:label goldbook:08785 "conjugated polymer")
AnnotationAssertion(dcterms:description goldbook:08785 "A polymer composed of molecules whose backbone is a sequence of alternating single and multiple bonds:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen, alkyl, aryl or heteroaryl and Ar is arenediyl (formerly: arylene) or heteroarenediyl (formerly: heteroarylene).")
Declaration(Class(goldbook:08786))
AnnotationAssertion(rdfs:label goldbook:08786 "π-conjugated system")
AnnotationAssertion(dcterms:description goldbook:08786 "Molecule or a part of a molecule, of which structure may be represented as a system of alternating single and multiple bonds, in which, eventually, a multiple bond can be replaced by an atom with a pair of non-bonding electrons or an atom carrying a negative charge.")
Declaration(Class(goldbook:08787))
AnnotationAssertion(rdfs:label goldbook:08787 "coulomb radius")
AnnotationAssertion(dcterms:description goldbook:08787 "Distance between two oppositely charged charge carriers at which the energy of their Coulombic attraction is equal to \\(kT\\), where \\(k\\) is the Boltzmann constant and \\(T\\) the absolute temperature.")
Declaration(Class(goldbook:08788))
AnnotationAssertion(rdfs:label goldbook:08788 "dark electric conductivity")
AnnotationAssertion(dcterms:description goldbook:08788 "Electric conductivity of a material in the dark where the free charge-carrier photogeneration is excluded.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08788 "dark conductivity")
Declaration(Class(goldbook:08789))
AnnotationAssertion(rdfs:label goldbook:08789 "delocalization of electrons")
AnnotationAssertion(dcterms:description goldbook:08789 "Redistribution of electron density in a molecular entity as compared with a model assuming individual atoms in the same valence states connected by localized bonds.")
Declaration(Class(goldbook:08790))
AnnotationAssertion(rdfs:label goldbook:08790 "dielectric material")
AnnotationAssertion(dcterms:description goldbook:08790 "Material which polarizes when exposed to an external electric field, because it creates its own internal electric field oriented against the external field.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08790 "dielectric")
Declaration(Class(goldbook:08791))
AnnotationAssertion(rdfs:label goldbook:08791 "dispersive transport")
AnnotationAssertion(dcterms:description goldbook:08791 "Irregular charge transport in which charge carriers move with an ill-defined mean velocity owing to the high variety of dwell times spent at different transport sites.")
Declaration(Class(goldbook:08792))
AnnotationAssertion(rdfs:label goldbook:08792 "double injection")
AnnotationAssertion(dcterms:description goldbook:08792 "Simultaneous injection of both types of charge carriers (electrons and holes) into a material or a device.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08792 "double charge carrier injection")
Declaration(Class(goldbook:08793))
AnnotationAssertion(rdfs:label goldbook:08793 "drift current")
AnnotationAssertion(dcterms:description goldbook:08793 "Electric current caused by electric drift.")
Declaration(Class(goldbook:08794))
AnnotationAssertion(rdfs:label goldbook:08794 "drift velocity")
AnnotationAssertion(dcterms:description goldbook:08794 "Average velocity that a charge carrier attains due to an applied electric field.")
Declaration(Class(goldbook:08795))
AnnotationAssertion(rdfs:label goldbook:08795 "electret")
AnnotationAssertion(dcterms:description goldbook:08795 "Dielectric material with a permanent or quasi-permanent electric dipole.")
Declaration(Class(goldbook:08796))
AnnotationAssertion(rdfs:label goldbook:08796 "electric conductor")
AnnotationAssertion(dcterms:description goldbook:08796 "Material that is able to transmit electric current.")
Declaration(Class(goldbook:08797))
AnnotationAssertion(rdfs:label goldbook:08797 "electric drift")
AnnotationAssertion(dcterms:description goldbook:08797 "Oriented flow of otherwise randomly moving charge carriers induced by an applied external electric field.")
Declaration(Class(goldbook:08798))
AnnotationAssertion(rdfs:label goldbook:08798 "electrically conducting polymer composite")
AnnotationAssertion(dcterms:description goldbook:08798 "Composite composed of a non-conducting polymer matrix in which irregular powdered or fibrous particles of an electrically conducting material are evenly dispersed in an amount exceeding the percolation threshold for electric conductivity and so the composite exhibits electric conductivity close to that of the conducting filler.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08798 "conducting polymer composite")
Declaration(Class(goldbook:08799))
AnnotationAssertion(rdfs:label goldbook:08799 "electrochromic polymer")
AnnotationAssertion(dcterms:description goldbook:08799 "Polymer that exhibits electrochromism.")
Declaration(Class(goldbook:08800))
AnnotationAssertion(rdfs:label goldbook:08800 "electrofluorescence")
AnnotationAssertion(dcterms:description goldbook:08800 "Electroluminescence originated from singlet-state excitons.")
Declaration(Class(goldbook:08801))
AnnotationAssertion(rdfs:label goldbook:08801 "electroinjection")
AnnotationAssertion(dcterms:description goldbook:08801 "Process of charge carrier injection induced by an applied external electric field.")
Declaration(Class(goldbook:08802))
AnnotationAssertion(rdfs:label goldbook:08802 "electromagnetic field")
AnnotationAssertion(dcterms:description goldbook:08802 "Physical field composed of two interconnected, mutually orthogonal fields, an electric field and a magnetic field, which mediates interactions of charged, dipolar and multipolar objects.")
Declaration(Class(goldbook:08803))
AnnotationAssertion(rdfs:label goldbook:08803 "electromagnetic field responsive polymer")
AnnotationAssertion(dcterms:description goldbook:08803 "Polymer showing a noticeable response of its physical or chemical properties during or upon exposure to an electromagnetic field or one of its components: electric field and magnetic field.")
Declaration(Class(goldbook:08804))
AnnotationAssertion(rdfs:label goldbook:08804 "electron-deficient molecule")
AnnotationAssertion(dcterms:description goldbook:08804 "Molecule that has fewer valence electrons than required for forming normal two-center two-electron chemical bonds and thus contains multicenter chemical bonds.")
Declaration(Class(goldbook:08805))
AnnotationAssertion(rdfs:label goldbook:08805 "electron-rich molecule")
AnnotationAssertion(dcterms:description goldbook:08805 "Molecule that has more valence electrons than is needed to link its atoms by single covalent bonds.")
Declaration(Class(goldbook:08806))
AnnotationAssertion(rdfs:label goldbook:08806 "electron tunneling")
AnnotationAssertion(dcterms:description goldbook:08806 "Quantum mechanical effect of passing an electron through a potential energy barrier separating two energy equivalent regions.")
