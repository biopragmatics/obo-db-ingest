AnnotationAssertion(dcterms:description goldbook:12141 "Construction of an image of a three-dimensional structure from a series of planar sections obtained with penetrating waves.")
AnnotationAssertion(rdfs:comment goldbook:12141 "Wave sources include light (optical tomography), X-rays, an electron beam producing X-rays (electron beam tomography; EBT), and γ-rays (positron emission tomography; PET),"^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:12141 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12141 "current"^^xsd:string)
