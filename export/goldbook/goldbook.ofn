AnnotationAssertion(dcterms:description goldbook:A00250 "A copolymer consisting of macromolecules comprising two species of monomeric units in alternating sequence.")
AnnotationAssertion(rdfs:comment goldbook:A00250 "An alternating copolymer may be considered as a homopolymer derived from an implicit or hypothetical monomer."^^xsd:string)
