AnnotationAssertion(rdfs:label goldbook:11954 "retrograde neurotransmission")
AnnotationAssertion(dcterms:description goldbook:11954 "Neurotransmission wherein a neurotransmitter is sent from the postsynaptic to the presynaptic membrane in order to modify a signal.")
AnnotationAssertion(rdfs:seeAlso goldbook:11954 goldbook:11955)
