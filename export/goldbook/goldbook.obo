[Term]
id: goldbook:CT06938
name: concave isotherm
def: "Distribution isotherm\, the slope of which is continuously increasing."
comment: "The resulting chromatographic peak is fronting. In gas-liquid chromatography, overloading often results in a concave isotherm."
property_value: mito:isMentionedBy doi:10.1351/pac199668081591
property_value: hasStatus "current" xsd:string
