AnnotationAssertion(rdfs:comment goldbook:11729 "When prodynorphin is cleaved during processing by proprotein convertase 2 (PC2), multiple active peptides are released: dynorphin A, dynorphin B, and α/β-neo-endorphin."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11729 "Depolarization of a neuron containing prodynorphin stimulates PC2 processing, which occurs within synaptic vesicles in the presynaptic terminal."^^xsd:string)
