AnnotationAssertion(rdfs:label goldbook:11106 "polymorphism")
AnnotationAssertion(dcterms:description goldbook:11106 """Occurrence of a gene in more than one distinct nucleotide sequence in a population, resulting from mutation(s) and potentially producing gene products with different levels of function.
Note: It is sometimes considered that the least frequent of polymorphic gene sequences should be present in at least \\(\\pu{1\\%}\\) of the population; otherwise the variant is a mutation rather than a polymorphism.
Occurrence of different phenotypes of a single trait.""")
Declaration(Class(goldbook:11107))
AnnotationAssertion(rdfs:label goldbook:11107 "polyploidy")
AnnotationAssertion(dcterms:description goldbook:11107 "Occurrence of more than two complete sets of chromosomes.")
Declaration(Class(goldbook:11108))
AnnotationAssertion(rdfs:label goldbook:11108 "porencephaly")
AnnotationAssertion(dcterms:description goldbook:11108 "Occurrence of a cyst in the substance of the brain that usually communicates with one of the lateral ventricles.")
Declaration(Class(goldbook:11109))
AnnotationAssertion(rdfs:label goldbook:11109 "post-implantation")
AnnotationAssertion(dcterms:description goldbook:11109 "Occurring after the early embryo embeds in the lining of the uterus.")
Declaration(Class(goldbook:11110))
AnnotationAssertion(rdfs:label goldbook:11110 "postmortem")
AnnotationAssertion(dcterms:description goldbook:11110 "After death.")
Declaration(Class(goldbook:11111))
AnnotationAssertion(rdfs:label goldbook:11111 "postnatal")
AnnotationAssertion(dcterms:description goldbook:11111 "Referring to events in the life of the mother or fetus following birth.")
Declaration(Class(goldbook:11112))
AnnotationAssertion(rdfs:label goldbook:11112 "postpartum")
AnnotationAssertion(dcterms:description goldbook:11112 "Period following the birth of an infant, often considered to be about six weeks in the human.")
Declaration(Class(goldbook:11113))
AnnotationAssertion(rdfs:label goldbook:11113 "predatory mite test")
AnnotationAssertion(dcterms:description goldbook:11113 "Procedure in which adult females of the predatory mite (_027814_ considered representative of soil fauna) are exposed to a test substance in artificial soil and the number of surviving females and of juveniles is determined.")
Declaration(Class(goldbook:11114))
AnnotationAssertion(rdfs:label goldbook:11114 "pre-eclampsia")
AnnotationAssertion(dcterms:description goldbook:11114 "Pathological condition in pregnancy with symptoms of high blood pressure, kidney dysfunction and edema.")
Declaration(Class(goldbook:11115))
AnnotationAssertion(rdfs:label goldbook:11115 "pre-embryo")
AnnotationAssertion(dcterms:description goldbook:11115 "Fertilized ovum up to \\(\\pu{14 days}\\) of age and before implantation.")
Declaration(Class(goldbook:11116))
AnnotationAssertion(rdfs:label goldbook:11116 "pregnancy")
AnnotationAssertion(dcterms:description goldbook:11116 "State of a female between conception and the termination of gestation.")
Declaration(Class(goldbook:11117))
AnnotationAssertion(rdfs:label goldbook:11117 "pre-implantation")
AnnotationAssertion(dcterms:description goldbook:11117 "Occurring before the early embryo embeds in the lining of the uterus.")
Declaration(Class(goldbook:11118))
AnnotationAssertion(rdfs:label goldbook:11118 "premature birth")
AnnotationAssertion(dcterms:description goldbook:11118 "Delivery before the expected length of gestation for the species; in humans taken as birth before a gestational age of \\(\\pu{37 weeks}\\).")
Declaration(Class(goldbook:11119))
AnnotationAssertion(rdfs:label goldbook:11119 "prenatal")
AnnotationAssertion(dcterms:description goldbook:11119 "Referring to events in the life of the mother or fetus preceding birth.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11119 "antenatal")
Declaration(Class(goldbook:11120))
AnnotationAssertion(rdfs:label goldbook:11120 "prenatal development study")
AnnotationAssertion(dcterms:description goldbook:11120 "Procedure in which a substance is administered to pregnant animals (usually rodents or rabbits) from the time of implantation until closure of the hard palate. The animals are killed one to two days before a scheduled delivery, whereupon uterine contents and the fetuses are evaluated for abnormalities.")
Declaration(Class(goldbook:11121))
AnnotationAssertion(rdfs:label goldbook:11121 "preoptic area")
AnnotationAssertion(dcterms:description goldbook:11121 "Region of the anterior hypothalamus primarily involved in regulating body temperature.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11121 "preoptic region")
Declaration(Class(goldbook:11122))
AnnotationAssertion(rdfs:label goldbook:11122 "prepubertal")
AnnotationAssertion(dcterms:description goldbook:11122 "Stage of human development before the onset of puberty.")
Declaration(Class(goldbook:11123))
AnnotationAssertion(rdfs:label goldbook:11123 "prepubescence")
AnnotationAssertion(dcterms:description goldbook:11123 "Period before pubescence.")
Declaration(Class(goldbook:11124))
AnnotationAssertion(rdfs:label goldbook:11124 "prepuce")
AnnotationAssertion(dcterms:description goldbook:11124 "Skin protecting the glans penis in the male (foreskin) or the clitoris in the female (clitoral hood).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11124 "clitoral hood")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11124 "foreskin")
Declaration(Class(goldbook:11125))
AnnotationAssertion(rdfs:label goldbook:11125 "preputial separation")
AnnotationAssertion(dcterms:description goldbook:11125 "Separation of the prepuce from the glans penis.")
Declaration(Class(goldbook:11126))
AnnotationAssertion(rdfs:label goldbook:11126 "primary sex organ")
AnnotationAssertion(dcterms:description goldbook:11126 "Gonads, which form gametes; ovaries in the female and testes in the male.")
Declaration(Class(goldbook:11127))
AnnotationAssertion(rdfs:label goldbook:11127 "primitive axis")
AnnotationAssertion(dcterms:description goldbook:11127 "Thickening of the embryonic tissue extending forward from the primitive streak.")
Declaration(Class(goldbook:11128))
AnnotationAssertion(rdfs:label goldbook:11128 "primitive groove")
AnnotationAssertion(dcterms:description goldbook:11128 "Shallow depression in the primitive streak that extends anteriorly to communicate with the yolk sac.")
Declaration(Class(goldbook:11129))
AnnotationAssertion(rdfs:label goldbook:11129 "primitive node")
AnnotationAssertion(dcterms:description goldbook:11129 "Group of cells at the anterior end of the primitive streak, involved in secreting chemical signals that regulate differentiation of the germ layers during gastrulation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11129 "primitive knot")
Declaration(Class(goldbook:11130))
AnnotationAssertion(rdfs:label goldbook:11130 "primitive pit")
AnnotationAssertion(dcterms:description goldbook:11130 "Depression in the primitive node contiguous with the notochord.")
Declaration(Class(goldbook:11131))
AnnotationAssertion(rdfs:label goldbook:11131 "primitive streak")
AnnotationAssertion(dcterms:description goldbook:11131 "Structure forming in the blastula during early embryogenesis that establishes bilateral symmetry and determines the site of gastrulation and germ layer formation.")
Declaration(Class(goldbook:11132))
AnnotationAssertion(rdfs:label goldbook:11132 "primordial follicle")
AnnotationAssertion(dcterms:description goldbook:11132 "Early stage of the oocyte in which it is surrounded by a single layer of follicular cells.")
Declaration(Class(goldbook:11133))
AnnotationAssertion(rdfs:label goldbook:11133 "primordial germ cell")
AnnotationAssertion(dcterms:description goldbook:11133 "Germ cell in the earliest stages of development.")
Declaration(Class(goldbook:11134))
AnnotationAssertion(rdfs:label goldbook:11134 "primordium")
AnnotationAssertion(dcterms:description goldbook:11134 "Organ or tissue at its earliest recognizable stage of development.")
Declaration(Class(goldbook:11135))
AnnotationAssertion(rdfs:label goldbook:11135 "proctodeum")
AnnotationAssertion(dcterms:description goldbook:11135 "Ectodermal depression of the caudal end of the embryo, where later the anus is formed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11135 "anal pit")
Declaration(Class(goldbook:11136))
AnnotationAssertion(rdfs:label goldbook:11136 "progesterone")
AnnotationAssertion(dcterms:description goldbook:11136 "Steroidal hormone produced in the ovary by the corpus luteum.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11136 "pregn-4-ene-3,20-dione")
Declaration(Class(goldbook:11137))
AnnotationAssertion(rdfs:label goldbook:11137 "progestin")
AnnotationAssertion(dcterms:description goldbook:11137 "Synthetic variant of progesterone, often used in oral contraceptive pills or to suppress hyperplasia of the endometrium.")
Declaration(Class(goldbook:11138))
AnnotationAssertion(rdfs:label goldbook:11138 "progestogen")
AnnotationAssertion(dcterms:description goldbook:11138 "Member of a family of hormones, based on the 21-carbon pregnane skeleton, involved in maintaining gestation and regulating the ovarian cycle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11138 "gestagen")
Declaration(Class(goldbook:11139))
AnnotationAssertion(rdfs:label goldbook:11139 "prolactin")
AnnotationAssertion(dcterms:description goldbook:11139 "Hormone released from the anterior pituitary gland that stimulates milk production after childbirth.")
Declaration(Class(goldbook:11140))
AnnotationAssertion(rdfs:label goldbook:11140 "prolapse")
AnnotationAssertion(dcterms:description goldbook:11140 "Falling or slipping out of place of an organ or other body part.")
Declaration(Class(goldbook:11141))
AnnotationAssertion(rdfs:label goldbook:11141 "pronephros")
AnnotationAssertion(dcterms:description goldbook:11141 "Collection of cells in the vertebrate embryo that represent the earliest stage of development of the kidney.")
Declaration(Class(goldbook:11142))
AnnotationAssertion(rdfs:label goldbook:11142 "pronucleus")
AnnotationAssertion(dcterms:description goldbook:11142 "Haploid nucleus formed by either the head of the sperm or the nucleus of the oocyte after fertilization but before their nuclei fuse to form the diploid zygotic nucleus.")
Declaration(Class(goldbook:11143))
AnnotationAssertion(rdfs:label goldbook:11143 "prophase")
AnnotationAssertion(dcterms:description goldbook:11143 "First phase of meiosis or mitosis in which thickening and orientation of the chromosomes occurs.")
Declaration(Class(goldbook:11144))
AnnotationAssertion(rdfs:label goldbook:11144 "prosencephalon")
AnnotationAssertion(dcterms:description goldbook:11144 "Most forward part of the brain that includes most of the cerebral cortex, the thalamus and hypothalamus, and the basal ganglia.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11144 "forebrain")
Declaration(Class(goldbook:11145))
AnnotationAssertion(rdfs:label goldbook:11145 "prostate")
AnnotationAssertion(dcterms:description goldbook:11145 "Male exocrine gland whose secretion contributes alkaline fluid to the ejaculate (see ejaculation).")
Declaration(Class(goldbook:11146))
AnnotationAssertion(rdfs:label goldbook:11146 "protamine")
AnnotationAssertion(dcterms:description goldbook:11146 "Small, basic (arginine-rich) protein involved in sperm maturation and DNA packaging during spermatogenesis.")
Declaration(Class(goldbook:11147))
AnnotationAssertion(rdfs:label goldbook:11147 "protein kinase")
AnnotationAssertion(dcterms:description goldbook:11147 "Any enzyme catalyzing protein phosphorylation, often for the purpose of signal transduction.")
Declaration(Class(goldbook:11148))
AnnotationAssertion(rdfs:label goldbook:11148 "proximal")
AnnotationAssertion(dcterms:description goldbook:11148 "Nearer to an anatomical point of origin or attachment, or the midline of the body.")
Declaration(Class(goldbook:11149))
AnnotationAssertion(rdfs:label goldbook:11149 "pseudohermaphrodite")
AnnotationAssertion(dcterms:description goldbook:11149 "Organism possessing either male (testes) or female (ovaries) gonads, but with ambiguous external genitalia.")
Declaration(Class(goldbook:11150))
AnnotationAssertion(rdfs:label goldbook:11150 "pseudopregnancy")
AnnotationAssertion(dcterms:description goldbook:11150 "Development of signs of pregnancy in the absence of an embryo.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11150 "false pregnancy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11150 "pseudocyesis")
Declaration(Class(goldbook:11151))
AnnotationAssertion(rdfs:label goldbook:11151 "psychomotor retardation")
AnnotationAssertion(dcterms:description goldbook:11151 "Delayed development of both cognitive and motor function.")
Declaration(Class(goldbook:11152))
AnnotationAssertion(rdfs:label goldbook:11152 "puberty")
AnnotationAssertion(dcterms:description goldbook:11152 "Process in which an individual undergoes sexual development, including the onset of gametogenesis, changes in hormonal secretions, secondary sexual characteristics, and reproductive competence.")
Declaration(Class(goldbook:11153))
AnnotationAssertion(rdfs:label goldbook:11153 "pubescent")
AnnotationAssertion(dcterms:description goldbook:11153 "Being in the early stage of puberty.")
Declaration(Class(goldbook:11154))
AnnotationAssertion(rdfs:label goldbook:11154 "pubic")
AnnotationAssertion(dcterms:description goldbook:11154 "Relating to the region of the most ventral bone of the pelvis (the pubic bone), and thus the region around the genital area, normally showing hair growth (pubic hair) in the adult.")
Declaration(Class(goldbook:11155))
AnnotationAssertion(rdfs:label goldbook:11155 "pubic symphysis")
AnnotationAssertion(dcterms:description goldbook:11155 "Cartilaginous joint between the pubic bones forming the front of the pelvis.")
Declaration(Class(goldbook:11156))
AnnotationAssertion(rdfs:label goldbook:11156 "pulmonary")
AnnotationAssertion(dcterms:description goldbook:11156 "Pertaining to the lungs.")
Declaration(Class(goldbook:11157))
AnnotationAssertion(rdfs:label goldbook:11157 "pulmonary artery")
AnnotationAssertion(dcterms:description goldbook:11157 "Large vessel that transports blood from the heart to the lungs.")
Declaration(Class(goldbook:11158))
AnnotationAssertion(rdfs:label goldbook:11158 "pulmonary valve stenosis")
AnnotationAssertion(dcterms:description goldbook:11158 "Condition in which the flow of blood from the heart to the lungs is slowed by a deformity on or near the pulmonary valve that controls the blood flow from the right heart to the lungs.")
Declaration(Class(goldbook:11159))
AnnotationAssertion(rdfs:label goldbook:11159 "pup")
AnnotationAssertion(dcterms:description goldbook:11159 """(n) Young or newborn dog, rat or seal.
(v) Give birth to a pup.""")
Declaration(Class(goldbook:11160))
AnnotationAssertion(rdfs:label goldbook:11160 "pyloric stenosis")
AnnotationAssertion(dcterms:description goldbook:11160 "Narrowing of the sphincter (the pylorus) between the stomach and duodenum.")
Declaration(Class(goldbook:11161))
AnnotationAssertion(rdfs:label goldbook:11161 "quickening")
AnnotationAssertion(dcterms:description goldbook:11161 "Initial awareness of fetal movement by the pregnant mother, usually occurring early in the second trimester.")
Declaration(Class(goldbook:11162))
AnnotationAssertion(rdfs:label goldbook:11162 "rachischisis")
AnnotationAssertion(dcterms:description goldbook:11162 "Failure of the neural tube to close in utero, resulting in a birth defect that leaves a fissure in the vertebral column with part of the spinal cord exposed.")
Declaration(Class(goldbook:11163))
AnnotationAssertion(rdfs:label goldbook:11163 "nuclear receptor")
AnnotationAssertion(dcterms:description goldbook:11163 "Receptor that encounters its ligand in the cytosol and translocates to the nucleus, where it binds DNA and acts as a factor regulating gene transcription.")
Declaration(Class(goldbook:11164))
AnnotationAssertion(rdfs:label goldbook:11164 "recessive")
AnnotationAssertion(dcterms:description goldbook:11164 "In genetics, relating to or denoting heritable characteristics controlled by genes which are expressed in offspring only when inherited from both parents.")
Declaration(Class(goldbook:11165))
AnnotationAssertion(rdfs:label goldbook:11165 "reciprocal mesenchymal-epithelial interaction")
AnnotationAssertion(dcterms:description goldbook:11165 "Process in tissue or organ development in which epithelium induces changes in the mesenchyme and the mesenchyme also induces changes in the epithelium, through paracrine signaling.")
Declaration(Class(goldbook:11166))
AnnotationAssertion(rdfs:label goldbook:11166 "reciprocal translocation")
AnnotationAssertion(dcterms:description goldbook:11166 "Chromosomal translocation in which crossing over between two non-homologous chromosomes leads to each carrying genetic material from the other.")
Declaration(Class(goldbook:11167))
AnnotationAssertion(rdfs:label goldbook:11167 "genetic recombination")
AnnotationAssertion(dcterms:description goldbook:11167 """Referring to new gene sequences, and thus to new heritable information, caused by gene crossovers, occurring naturally in either meiosis or mitosis, or constructed artificially for the purpose of introducing a new trait into an organism or cell line.
In immunology, random scrambling of specific gene sequences to produce the vast array of possible immunoglobulin and T cell receptor sequences required to recognize, potentially, all possible antigens.""")
Declaration(Class(goldbook:11168))
AnnotationAssertion(rdfs:label goldbook:11168 "rectum")
AnnotationAssertion(dcterms:description goldbook:11168 "Terminal part of the large intestine, ending at the anus.")
Declaration(Class(goldbook:11169))
AnnotationAssertion(rdfs:label goldbook:11169 "5α-reductase")
AnnotationAssertion(dcterms:description goldbook:11169 "Enzyme (EC 1.3.99.5) that converts testosterone to 5\\(\\upalpha\\)-dihydrotestosterone in peripheral tissues.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11169 "alpha-reductase")
Declaration(Class(goldbook:11170))
AnnotationAssertion(rdfs:label goldbook:11170 "5α-reductase deficiency")
AnnotationAssertion(dcterms:description goldbook:11170 "Condition caused by a mutation of the $\\ce{5\\upalpha\\!\\mbox{-}reductase}$ type II gene, with autosomal recessive inheritance.")
Declaration(Class(goldbook:11171))
AnnotationAssertion(rdfs:label goldbook:11171 "renal")
AnnotationAssertion(dcterms:description goldbook:11171 "Pertaining to the kidneys.")
Declaration(Class(goldbook:11172))
AnnotationAssertion(rdfs:label goldbook:11172 "reproductive senescence")
AnnotationAssertion(dcterms:description goldbook:11172 "Progressive decline in reproductive capacity with age, marked by menopause in females.")
Declaration(Class(goldbook:11173))
AnnotationAssertion(rdfs:label goldbook:11173 "reproductive toxicant")
AnnotationAssertion(dcterms:description goldbook:11173 "Agent that interferes with reproductive function, including sexual performance, fertility, and development of the fetus and embryo.")
Declaration(Class(goldbook:11174))
AnnotationAssertion(rdfs:label goldbook:11174 "reproductive toxicity test")
AnnotationAssertion(dcterms:description goldbook:11174 "Procedure based on specific guidelines in which adverse effects of a substance on reproduction and development are studied either in animals or by use of in vitro assays.")
Declaration(Class(goldbook:11175))
AnnotationAssertion(rdfs:label goldbook:11175 "resorption")
AnnotationAssertion(dcterms:description goldbook:11175 """Removal of mineralized tissue by natural processes, as in the breakdown of bone by osteoclasts or the disappearance of a tooth.\r
Disintegration and assimilation of an embryo or fetus through a natural process involving lysis and removal of all the products of conception by cells of the maternal immune system.\r
In multigestational pregnancies, death of one fetus followed by absorption of its tissue by another, sometimes referred to as a 'vanishing twin'.""")
Declaration(Class(goldbook:11176))
AnnotationAssertion(rdfs:label goldbook:11176 "restriction site")
AnnotationAssertion(dcterms:description goldbook:11176 "Short DNA nucleotide sequence that is recognized by a sequence-specific enzyme (restriction enzyme) that cleaves the double stranded DNA.")
Declaration(Class(goldbook:11177))
AnnotationAssertion(rdfs:label goldbook:11177 "rete")
AnnotationAssertion(dcterms:description goldbook:11177 "Fibrous mesh or network.")
Declaration(Class(goldbook:11178))
AnnotationAssertion(rdfs:label goldbook:11178 "rete testis")
AnnotationAssertion(dcterms:description goldbook:11178 "Rete in the testis that carries sperm from the seminiferous tubules.")
Declaration(Class(goldbook:11179))
AnnotationAssertion(rdfs:label goldbook:11179 "retina")
AnnotationAssertion(dcterms:description goldbook:11179 "Multicell-layer membrane in the back of the eye that is sensitive to light and transduces incoming optical information into signals that are necessary for vision.")
Declaration(Class(goldbook:11180))
AnnotationAssertion(rdfs:label goldbook:11180 "retinoic acid")
AnnotationAssertion(dcterms:description goldbook:11180 "Acidic metabolite of vitamin A.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11180 "(2E,4E,6E,8E)-3,7-dimethyl-9-(2,6,6-trimethylcyclohex-1-en-1-yl)nona-2,4,6,8-tetraenoic acid")
Declaration(Class(goldbook:11181))
AnnotationAssertion(rdfs:label goldbook:11181 "retinopathy")
AnnotationAssertion(dcterms:description goldbook:11181 "Noninflammatory degenerative disease of the retina.")
Declaration(Class(goldbook:11182))
AnnotationAssertion(rdfs:label goldbook:11182 "congenital retinoschisis")
AnnotationAssertion(dcterms:description goldbook:11182 "Congenital splitting of the retina into two layers.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11182 "juvenile retinoschisis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11182 "X-linked retinoschisis")
Declaration(Class(goldbook:11183))
AnnotationAssertion(rdfs:label goldbook:11183 "retroperitoneal")
AnnotationAssertion(dcterms:description goldbook:11183 "Outside of and posterior to the peritoneum.")
Declaration(Class(goldbook:11184))
AnnotationAssertion(rdfs:label goldbook:11184 "reverse genetics")
AnnotationAssertion(dcterms:description goldbook:11184 "Approach to elucidating the function of a gene by studying the effects on phenotype of expressed variations in a known DNA sequence.")
Declaration(Class(goldbook:11185))
AnnotationAssertion(rdfs:label goldbook:11185 "rhesus factor")
AnnotationAssertion(dcterms:description goldbook:11185 "Antigen that occurs on the red blood cells of about 85 per cent of humans and can cause hemolytic disease of the newborn (erythroblastosis fetalis) and hemolytic transfusion reactions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11185 "Rh factor")
Declaration(Class(goldbook:11186))
AnnotationAssertion(rdfs:label goldbook:11186 "rhombencephalon")
AnnotationAssertion(dcterms:description goldbook:11186 "Posterior portion of the brain that includes the cerebellum, pons, and medulla.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11186 "hindbrain")
Declaration(Class(goldbook:11187))
AnnotationAssertion(rdfs:label goldbook:11187 "RNA interference")
AnnotationAssertion(dcterms:description goldbook:11187 "Effect of small, often double-stranded RNA targeting a specific messenger RNA (mRNA), blocking its translation, and thereby silencing expression of the corresponding gene.")
Declaration(Class(goldbook:11188))
AnnotationAssertion(rdfs:label goldbook:11188 "Robertsonian translocation")
AnnotationAssertion(dcterms:description goldbook:11188 "Chromosomal translocation in which chromosomes with acrocentric centromeres break the centromere to fuse the long arms into a new large chromosome and the short arms into another small one that may be lost, leaving a karyotype in the human of \\(\\pu{45}\\) chromosomes.")
Declaration(Class(goldbook:11189))
AnnotationAssertion(rdfs:label goldbook:11189 "rostral")
AnnotationAssertion(dcterms:description goldbook:11189 """Pertaining to, resembling, or having a rostrum or beak.
Situated toward the beak (thus, oral and nasal region), which may mean superior (in relationships of areas of the spinal cord) or anterior or ventral (in relationships of brain areas).
Closer to the head.""")
Declaration(Class(goldbook:11190))
AnnotationAssertion(rdfs:label goldbook:11190 "runt")
AnnotationAssertion(dcterms:description goldbook:11190 "Smallest and weakest animal of a litter.")
Declaration(Class(goldbook:11191))
AnnotationAssertion(rdfs:label goldbook:11191 "sacral agenesis")
AnnotationAssertion(dcterms:description goldbook:11191 "Absence or significant underdevelopment of the lower part of the spine and the lower limbs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11191 "caudal regression syndrome")
Declaration(Class(goldbook:11192))
AnnotationAssertion(rdfs:label goldbook:11192 "sagittal")
AnnotationAssertion(dcterms:description goldbook:11192 "Vertical (longitudinal) plane dividing the body into right and left sections.")
Declaration(Class(goldbook:11193))
AnnotationAssertion(rdfs:label goldbook:11193 "salpingectomy")
AnnotationAssertion(dcterms:description goldbook:11193 "Surgical removal of the Fallopian tubes.")
Declaration(Class(goldbook:11194))
AnnotationAssertion(rdfs:label goldbook:11194 "saturation mutagenesis")
AnnotationAssertion(dcterms:description goldbook:11194 "Mutagenesis screening in which a large number of mutations are introduced in a target area of the genome with the aim of identifying all the genes or their functions that are associated with that area.")
Declaration(Class(goldbook:11195))
AnnotationAssertion(rdfs:label goldbook:11195 "scaphocephaly")
AnnotationAssertion(dcterms:description goldbook:11195 "Elongated and narrow head with decrease of the parietal regions and conspicuous frontal and occipital protrusions; a type of craniosynostosis.")
Declaration(Class(goldbook:11196))
AnnotationAssertion(rdfs:label goldbook:11196 "scoliosis")
AnnotationAssertion(dcterms:description goldbook:11196 "Abnormal lateral and rotational curvature of the vertebral spinal column.")
Declaration(Class(goldbook:11197))
AnnotationAssertion(rdfs:label goldbook:11197 "scrotum")
AnnotationAssertion(dcterms:description goldbook:11197 "Pouch of skin containing the testicles and their accessory tissues.")
Declaration(Class(goldbook:11198))
AnnotationAssertion(rdfs:label goldbook:11198 "secondary sexual characteristic")
AnnotationAssertion(dcterms:description goldbook:11198 "Feature of the adult animal, appearing during puberty in humans and distinct between the sexes, although not part of the reproductive system.")
Declaration(Class(goldbook:11199))
AnnotationAssertion(rdfs:label goldbook:11199 "seizure")
AnnotationAssertion(dcterms:description goldbook:11199 "Sudden change in neural activity, leading to convulsions and (or) changes in consciousness of varying degrees of severity.")
Declaration(Class(goldbook:11200))
AnnotationAssertion(rdfs:label goldbook:11200 "selector gene")
AnnotationAssertion(dcterms:description goldbook:11200 "Member of a group of genes that codes factors driving differentiation and regional patterning during development.")
Declaration(Class(goldbook:11201))
AnnotationAssertion(rdfs:label goldbook:11201 "sella turcica")
AnnotationAssertion(dcterms:description goldbook:11201 "Depression on the upper surface of the sphenoid bone, accommodating the pituitary gland.")
Declaration(Class(goldbook:11202))
AnnotationAssertion(rdfs:label goldbook:11202 "semen")
AnnotationAssertion(dcterms:description goldbook:11202 "Fluid, containing spermatozoa, that is expelled from the penis during ejaculation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11202 "seminal fluid")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11202 "ejaculate (<em>n.</em>)")
Declaration(Class(goldbook:11203))
AnnotationAssertion(rdfs:label goldbook:11203 "seminal vesicle")
AnnotationAssertion(dcterms:description goldbook:11203 "One of a pair of glands of the male reproductive system that together produce a significant portion of the semen.")
Declaration(Class(goldbook:11204))
AnnotationAssertion(rdfs:label goldbook:11204 "seminiferous tubule")
AnnotationAssertion(dcterms:description goldbook:11204 "One of numerous coiled tubes, found in the testis, in the walls of which spermatogenesis occurs.")
Declaration(Class(goldbook:11205))
AnnotationAssertion(rdfs:label goldbook:11205 "sensitized strain")
AnnotationAssertion(dcterms:description goldbook:11205 "Model organism containing a mutation in a pathway (e.g., metabolic or signal transducing) that does not itself cause a change in phenotype, but makes the organism more sensitive to another change elsewhere in the pathway.")
Declaration(Class(goldbook:11206))
AnnotationAssertion(rdfs:label goldbook:11206 "septum")
AnnotationAssertion(dcterms:description goldbook:11206 "In anatomy, thin wall dividing two cavities or masses of softer tissue.")
Declaration(Class(goldbook:11207))
AnnotationAssertion(rdfs:label goldbook:11207 "serous")
AnnotationAssertion(dcterms:description goldbook:11207 "Containing, resembling, or secreting serum.")
Declaration(Class(goldbook:11208))
AnnotationAssertion(rdfs:label goldbook:11208 "Sertoli cell")
AnnotationAssertion(dcterms:description goldbook:11208 "Somatic cell in the seminiferous tubule that supports spermatogenesis.")
Declaration(Class(goldbook:11209))
