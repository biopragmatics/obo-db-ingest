AnnotationAssertion(obo:goldbook#hasStatus goldbook:12974 "current"^^xsd:string)
Declaration(Class(goldbook:12975))
AnnotationAssertion(rdfs:label goldbook:12975 "CD5+ B lymphocyte")
AnnotationAssertion(dcterms:description goldbook:12975 "Lymphocyte of type B-1a, which is predominant in fetal lymphoid organs and in neonatal cord blood.")
AnnotationAssertion(rdfs:comment goldbook:12975 "In adults, these cells range from \\(\\pu{2}\\) to \\(\\pu{6\\%}\\) of total mononuclear cells in peripheral blood. They utilize an immunoglobulin (Ig) variable (V) gene repertoire different from that of CD5– B cells and they produce natural autoantibodies."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12975 "The expansion of autoreactive B1-a cells has been reported in peripheral blood of patients with autoimmune diseases [e.g., rheumatoid arthritis (RA), Sjögren syndrome, antiphospholipid syndrome (APS)]. In RA these cells can account for up to \\(\\pu{20\\%}\\) of circulating B cells and may produce rheumatoid factor."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12975 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:12975 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:12975 goldbook:13680)
