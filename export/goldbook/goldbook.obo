[Term]
id: goldbook:14926
name: poikilotherm
def: "'Cold-blooded organism' \(such as an amphibian\, reptile\, or fish\) with a body temperature varying with\, but usually slightly higher than\, the temperature of its environment."
synonym: "ectotherm" []
synonym: "exotherm" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-08-07-09
property_value: hasStatus "current" xsd:string
