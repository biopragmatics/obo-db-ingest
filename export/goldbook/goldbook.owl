        <dcterms:description>Period from fertilization to the end of major organogenesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>embryonic period</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11048"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10651 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10651">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Undifferentiated, pluripotent cell from an early stage of the pre-implantation embryo (inner cell mass of the blastocyst).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ES cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Embryonic stem cells have the potential to proliferate and differentiate into various cell types of the body.</rdfs:comment>
        <rdfs:label>embryonic stem cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11103"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.10651"/>
