AnnotationAssertion(rdfs:seeAlso goldbook:10020 goldbook:09979)
AnnotationAssertion(rdfs:seeAlso goldbook:10020 goldbook:09998)
AnnotationAssertion(mito:isMentionedBy goldbook:10020 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10020 "current"^^xsd:string)
Declaration(Class(goldbook:10021))
AnnotationAssertion(rdfs:label goldbook:10021 "examination calibration")
AnnotationAssertion(dcterms:description goldbook:10021 "Process that confers to one or more persons or to a device the capacity to provide nominal property values from specified examinations after having examined one or more examination standards.")
AnnotationAssertion(rdfs:comment goldbook:10021 "Examination calibration differs from that of calibration in the VIM, because in examination calibration there is no explicit mention of \"nominal indication\" and \"examination uncertainty\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10021 goldbook:10019)
AnnotationAssertion(rdfs:seeAlso goldbook:10021 goldbook:09984)
AnnotationAssertion(rdfs:seeAlso goldbook:10021 goldbook:09996)
AnnotationAssertion(mito:isMentionedBy goldbook:10021 doi:10.1515/pac-2011-0613)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:10021 "current"^^xsd:string)
Declaration(Class(goldbook:10022))
AnnotationAssertion(rdfs:label goldbook:10022 "reference examination procedure")
AnnotationAssertion(dcterms:description goldbook:10022 "Examination procedure accepted as providing examination results fit for their intended use in assessing examination trueness of examined values) obtained from other examination procedures for nominal properties of the same kind-of-nominal-property, in examination calibration, or in characterizing nominal reference materials.")
AnnotationAssertion(rdfs:seeAlso goldbook:10022 goldbook:09990)
AnnotationAssertion(rdfs:seeAlso goldbook:10022 goldbook:09984)
