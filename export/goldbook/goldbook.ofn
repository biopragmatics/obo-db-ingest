AnnotationAssertion(dcterms:description goldbook:10759 "Primordium of the penis or clitoris.")
Declaration(Class(goldbook:10760))
AnnotationAssertion(rdfs:label goldbook:10760 "genotoxic")
AnnotationAssertion(dcterms:description goldbook:10760 "Capable of causing a change to the structure of the genome.")
Declaration(Class(goldbook:10761))
AnnotationAssertion(rdfs:label goldbook:10761 "germ cell gene mutation assay")
AnnotationAssertion(dcterms:description goldbook:10761 "Procedure in which mutations induced by an agent are studied in germ line cells or somatic stem cells from a transgenic animal (rodent), containing reporter genes for detection of various mutations.")
Declaration(Class(goldbook:10762))
