Declaration(Class(goldbook:14288))
AnnotationAssertion(rdfs:label goldbook:14288 "natural latex")
AnnotationAssertion(dcterms:description goldbook:14288 "Latex, the dispersed phase of which is obtained from various plants.")
Declaration(Class(goldbook:14289))
