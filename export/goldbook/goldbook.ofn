AnnotationAssertion(rdfs:comment goldbook:11832 "IPSPs are commonly produced by inhibitory neurotransmitters such as γ-aminobutyric acid (GABA) and glycine."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11832 "Postsynaptic electrical activity is in part a function of the balance of IPSPs and excitatory post-synaptic potentials (EPSPs)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11832 goldbook:11562)
