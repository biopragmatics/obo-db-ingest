[Term]
id: goldbook:E02223
name: euatmotic reaction
def: "An isothermal\, reversible reaction between two \(or more\) solid phases during the heating of a system as a result of which a single vapour phase is produced."
property_value: mito:isMentionedBy doi:10.1351/pac199466030577
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:E02225
name: eutectic reaction
def: "An isothermal\, reversible reaction between two \(or more\) solid phases during the heating of a system\, as a result of which a single liquid phase is produced."
property_value: mito:isMentionedBy doi:10.1351/pac199466030577
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:E02226
name: evaluation function
def: "The inverse of the calibration function."
property_value: mito:isMentionedBy doi:10.1351/pac199567101699
property_value: hasStatus "current" xsd:string
