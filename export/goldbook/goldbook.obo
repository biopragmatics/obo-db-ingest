[Term]
id: goldbook:08700
name: total internal reflection
def: "Internal reflection from a non-absorbing material at angles of incidence at or above the critical angle."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:08701
name: transflectance
def: "Spectral intensity of a transflected beam divided by spectral intensity of the incident beam in a transflection experiment."
comment: "'Transflectance' has also been used to mean transflection, and this usage is strongly discouraged."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
