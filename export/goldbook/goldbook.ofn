AnnotationAssertion(dcterms:description goldbook:08318 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
Declaration(Class(goldbook:08319))
AnnotationAssertion(rdfs:label goldbook:08319 "CC(CO)NH")
AnnotationAssertion(dcterms:description goldbook:08319 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
Declaration(Class(goldbook:08320))
