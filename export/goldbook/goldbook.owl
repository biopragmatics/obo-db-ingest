        <oboInOwl:hasRelatedSynonym>spine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vertebral column</oboInOwl:hasRelatedSynonym>
        <rdfs:label>spinal column</rdfs:label>
    </owl:Class>
    


