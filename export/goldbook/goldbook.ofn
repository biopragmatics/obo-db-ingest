AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03631 "current"^^xsd:string)
Declaration(Class(goldbook:L03634))
AnnotationAssertion(rdfs:label goldbook:L03634 "lowest-observed-effect-level")
AnnotationAssertion(dcterms:description goldbook:L03634 "Lowest concentration or amount of a substance, found by experiment or observation, that causes any alteration in morphology, functional capacity, growth, development, or life span of target organisms distinguishable from normal (control) organisms of the same species and strain under the same defined conditions of exposure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:L03634 "LOEL")
AnnotationAssertion(rdfs:seeAlso goldbook:L03634 goldbook:LT06909)
