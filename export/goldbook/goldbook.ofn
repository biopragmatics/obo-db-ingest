AnnotationAssertion(obo:goldbook#hasStatus goldbook:13342 "current"^^xsd:string)
Declaration(Class(goldbook:13343))
AnnotationAssertion(rdfs:label goldbook:13343 "invariant chain")
AnnotationAssertion(dcterms:description goldbook:13343 "Protein (\\(\\pu{31 kDa}\\)) of the endoplasmic reticulum lumen that binds to newly formed major histocompatibility complex (MHC) heterodimeric proteins, preventing binding of endogenous peptides to their groove.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13343 "CD74")
AnnotationAssertion(rdfs:comment goldbook:13343 "This protein acts as a chaperone for these molecules until they leave the Golgi apparatus and enter the endosome pathway. It is degraded proteolytically but leaves a fragment (called CLIP) bound within the groove of the major histocompatibility complex (MHC) class III molecules. In acid vesicles, after leaving the Golgi apparatus, CLIP exchanges with peptides derived from exogenous antigens."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13343 goldbook:13111)
AnnotationAssertion(rdfs:seeAlso goldbook:13343 goldbook:13430)
AnnotationAssertion(rdfs:seeAlso goldbook:13343 goldbook:13433)
AnnotationAssertion(mito:isMentionedBy goldbook:13343 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13343 "current"^^xsd:string)
Declaration(Class(goldbook:13344))
AnnotationAssertion(rdfs:label goldbook:13344 "islet cell antibodies")
AnnotationAssertion(dcterms:description goldbook:13344 "Autoantibodies reacting with endocrine (pancreatic islet) cells and detectable by indirect immunofluorescence on pancreatic cryostat sections.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13344 "ICA")
AnnotationAssertion(rdfs:comment goldbook:13344 "Islet cell antibodies are diagnostic markers of diabetes mellitus type 1."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13344 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13344 goldbook:13092)
AnnotationAssertion(rdfs:seeAlso goldbook:13344 goldbook:13328)
AnnotationAssertion(mito:isMentionedBy goldbook:13344 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13344 "current"^^xsd:string)
