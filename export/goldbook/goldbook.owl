        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10648 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10648">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method to evaluate the potential for early embryonic loss in rodents caused by accelerated or retarded arrival of embryos into the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>embryo transport rate analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
