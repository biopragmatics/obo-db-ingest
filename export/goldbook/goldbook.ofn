AnnotationAssertion(dcterms:description goldbook:12153 "Not in a conscious state. In psychoanalytic theory, describing feelings and motivations of which one is unaware that nevertheless shape behavior.")
AnnotationAssertion(rdfs:seeAlso goldbook:12153 goldbook:11690)
AnnotationAssertion(mito:isMentionedBy goldbook:12153 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12153 "current"^^xsd:string)
