    <!-- http://dx.doi.org/10.1351/goldbook.10773 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10773">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of steroid hormones, such as cortisone, produced by the adrenal cortex, inhibiting inflammation, and mediating a response to stress that alters protein, fat, and carbohydrate metabolism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>glucocorticoid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10344"/>
