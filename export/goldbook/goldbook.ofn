Declaration(Class(goldbook:F02363))
AnnotationAssertion(rdfs:label goldbook:F02363 "filler")
AnnotationAssertion(dcterms:description goldbook:F02363 "Filler (also called grist) is a petroleum- or coal-based coke fraction of a green, carbon mix or formulation. Coarse particles, \\(>0.425\\ \\mathrm{mm}\\), are sometimes referred to as tailings; fine particles, \\(")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:F02363 "grist")
AnnotationAssertion(rdfs:seeAlso goldbook:F02363 goldbook:G02684)
