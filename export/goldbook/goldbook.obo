[Term]
id: goldbook:E02251
name: excitation energy
def: "Kinetic energy of bombarding particles at the surface of the solid."
synonym: "acceleration energy" []
synonym: "initial energy" []
property_value: mito:isMentionedBy doi:10.1351/pac198355122023
property_value: hasStatus "current" xsd:string
