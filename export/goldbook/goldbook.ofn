AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04018 "current"^^xsd:string)
Declaration(Class(goldbook:M04019))
AnnotationAssertion(rdfs:label goldbook:M04019 "monomer molecule")
AnnotationAssertion(dcterms:description goldbook:M04019 "A molecule which can undergo polymerization thereby contributing constitutional units to the essential structure of a macromolecule.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04019 goldbook:C01288)
AnnotationAssertion(rdfs:seeAlso goldbook:M04019 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:M04019 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04019 "current"^^xsd:string)
