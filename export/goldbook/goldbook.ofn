AnnotationAssertion(obo:goldbook#hasStatus goldbook:S06237 "current"^^xsd:string)
Declaration(Class(goldbook:S06239))
AnnotationAssertion(rdfs:label goldbook:S06239 "Szilard–Chalmers effect")
AnnotationAssertion(dcterms:description goldbook:S06239 "The rupture of the chemical bond between an atom and the molecule of which the atom is part, as a result of a nuclear reaction of that atom.")
AnnotationAssertion(rdfs:seeAlso goldbook:S06239 goldbook:CT07009)
AnnotationAssertion(mito:isMentionedBy goldbook:S06239 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S06239 "current"^^xsd:string)
Declaration(Class(goldbook:ST06754))
AnnotationAssertion(rdfs:label goldbook:ST06754 "sialon")
AnnotationAssertion(dcterms:description goldbook:ST06754 "A generic name for compounds or solid solutions in the system $\\ce{M–Si–Al–O–N}$ where $\\ce{M}$ is a metal. (The use of capitals as in SiAlON is discouraged since they suggest a chemical composition.)")
AnnotationAssertion(mito:isMentionedBy goldbook:ST06754 doi:10.1351/pac199971091765)
