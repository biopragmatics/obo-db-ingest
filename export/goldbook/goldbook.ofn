AnnotationAssertion(mito:isMentionedBy goldbook:11802 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11802 "current"^^xsd:string)
Declaration(Class(goldbook:11803))
AnnotationAssertion(rdfs:label goldbook:11803 "hematoma")
AnnotationAssertion(dcterms:description goldbook:11803 "Region of bleeding into a tissue or organ.")
AnnotationAssertion(rdfs:comment goldbook:11803 "Often a result of trauma, defective blood clotting or drugs that suppress blood clotting."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11803 "Hematoma of the brain is a common cause of stroke and is accompanied by potentially lethal increase of intracranial pressure and neuronal damage."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11803 goldbook:11836)
AnnotationAssertion(rdfs:seeAlso goldbook:11803 goldbook:12098)
AnnotationAssertion(mito:isMentionedBy goldbook:11803 doi:10.1515/pac-2015-0103)
