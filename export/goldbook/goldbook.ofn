AnnotationAssertion(dcterms:description goldbook:13424 "Large (\\(\\pu{10\\!{-}\\! 20 \\upmu m}\\) diameter) ameboid and phagocytic cell found in many tissues, especially in areas of inflammation, derived from blood monocytes and playing an important role in host defense mechanisms.")
AnnotationAssertion(rdfs:comment goldbook:13424 "Two main functions are recognized: phagocytosis and antigen presentation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13424 goldbook:12887)
AnnotationAssertion(rdfs:seeAlso goldbook:13424 goldbook:13226)
AnnotationAssertion(rdfs:seeAlso goldbook:13424 goldbook:13467)
