[Term]
id: goldbook:D01853
name: doublet state
def: "A state having a total electron spin quantum number equal to \\\(\\frac\{1\}\{2\}\\\)."
property_value: mito:isMentionedBy doi:10.1351/pac199668122223
property_value: hasStatus "current" xsd:string
