AnnotationAssertion(obo:goldbook#hasStatus goldbook:OT07087 "current"^^xsd:string)
Declaration(Class(goldbook:OT07179))
AnnotationAssertion(rdfs:label goldbook:OT07179 "optically active polymer")
AnnotationAssertion(dcterms:description goldbook:OT07179 "Polymer capable of rotating the polarization plane of a transmitted beam of linear-polarized light.")
AnnotationAssertion(rdfs:comment goldbook:OT07179 "The optical activity originates from the presence of chiral elements in a polymer such as chiral centers or chiral axes due to long-range conformational order in a polymer (helicity)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07179 goldbook:C01057)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07179 goldbook:H02763)
