Declaration(Class(goldbook:10805))
AnnotationAssertion(rdfs:label goldbook:10805 "homeobox gene")
AnnotationAssertion(dcterms:description goldbook:10805 "Gene containing a homeobox sequence.")
Declaration(Class(goldbook:10806))
AnnotationAssertion(rdfs:label goldbook:10806 "homeosis")
AnnotationAssertion(dcterms:description goldbook:10806 "Replacement of part of one segment of an insect or other segmented animal by a structure characteristic of a different segment, especially through mutation.")
Declaration(Class(goldbook:10807))
AnnotationAssertion(rdfs:label goldbook:10807 "homologous")
AnnotationAssertion(dcterms:description goldbook:10807 """Having the same relationship, relative position, or structure.
(Of organs) Similar in position, structure, and evolutionary origin but not necessarily in function.
(Of chromosomes) Pairing at meiosis and having the same structural features and pattern of genes.
(Of a series of chemical compounds) Having the same functional group(s) but differing in structure by a fixed group of atoms.""")
Declaration(Class(goldbook:10808))
AnnotationAssertion(rdfs:label goldbook:10808 "homologous recombination")
AnnotationAssertion(dcterms:description goldbook:10808 "Crossing over between two similar or identical strands of DNA, resulting in exchange of corresponding stretches of DNA between two sister chromosomes.")
Declaration(Class(goldbook:10809))
AnnotationAssertion(rdfs:label goldbook:10809 "honey bee larval toxicity test")
AnnotationAssertion(dcterms:description goldbook:10809 "Procedure in which larvae of the honey bee (Apis mellifera) are exposed to a test chemical in the diet and subsequent mortality is recorded daily up to the \\(\\pu{72\\!\\!{-}\\!h}\\) \\(\\pu{LD_{50}}\\).")
Declaration(Class(goldbook:10810))
AnnotationAssertion(rdfs:label goldbook:10810 "hormone")
AnnotationAssertion(dcterms:description goldbook:10810 "Substance formed in one organ or part of the body and carried in the blood to another organ or part where it selectively alters functional activity.")
Declaration(Class(goldbook:10811))
AnnotationAssertion(rdfs:label goldbook:10811 "Human Genome Project")
AnnotationAssertion(dcterms:description goldbook:10811 "International research project that started in 1990 with the goal of determining the base-pair sequence of the human genome. The project was declared complete in 2003.")
Declaration(Class(goldbook:10812))
AnnotationAssertion(rdfs:label goldbook:10812 "hydatidiform mole")
AnnotationAssertion(dcterms:description goldbook:10812 "Vesicular or polycystic mass resulting from the proliferation of the trophoblast, with hydropic degeneration and avascularity of the chorionic villi.")
Declaration(Class(goldbook:10813))
AnnotationAssertion(rdfs:label goldbook:10813 "hydranencephaly")
AnnotationAssertion(dcterms:description goldbook:10813 "Rare condition in which the brain’s cerebral hemispheres are replaced by sacs filled with cerebrospinal fluid.")
Declaration(Class(goldbook:10814))
AnnotationAssertion(rdfs:label goldbook:10814 "hydrocele")
AnnotationAssertion(dcterms:description goldbook:10814 "Accumulation of serous fluid in a sacculated cavity; specifically, such an accumulation in the space of the tunica vaginalis testis, or in a separate pocket along the spermatic cord.")
Declaration(Class(goldbook:10815))
AnnotationAssertion(rdfs:label goldbook:10815 "hydrocephalus")
AnnotationAssertion(dcterms:description goldbook:10815 "Accumulation of excess cerebrospinal fluid within the ventricles of the brain; head enlargement and brain damage may occur.")
Declaration(Class(goldbook:10816))
AnnotationAssertion(rdfs:label goldbook:10816 "hydromicrocephaly")
AnnotationAssertion(dcterms:description goldbook:10816 "Microcephaly with excess cerebrospinal fluid.")
Declaration(Class(goldbook:10817))
AnnotationAssertion(rdfs:label goldbook:10817 "hydronephrosis")
AnnotationAssertion(dcterms:description goldbook:10817 "Swelling of the funnel-shaped part of the kidney, where urine is collected to enter the ureter.")
Declaration(Class(goldbook:10818))
AnnotationAssertion(rdfs:label goldbook:10818 "hydrops")
AnnotationAssertion(dcterms:description goldbook:10818 "Gross edema of the entire body, with severe anemia, occurring in hemolytic disease of the newborn.")
Declaration(Class(goldbook:10819))
AnnotationAssertion(rdfs:label goldbook:10819 "hydroureter")
AnnotationAssertion(dcterms:description goldbook:10819 "Dilation of a ureter with fluid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10819 "ureterectasia")
Declaration(Class(goldbook:10820))
AnnotationAssertion(rdfs:label goldbook:10820 "hygroma")
AnnotationAssertion(dcterms:description goldbook:10820 "Accumulation of fluid in a sac, cyst, or bursa.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10820 "hydroma")
Declaration(Class(goldbook:10821))
AnnotationAssertion(rdfs:label goldbook:10821 "hymen")
AnnotationAssertion(dcterms:description goldbook:10821 "Thin, membranous fold of highly variable appearance that, before its rupture, partly occludes the opening of the vagina.")
Declaration(Class(goldbook:10822))
AnnotationAssertion(rdfs:label goldbook:10822 "hyoid arch")
AnnotationAssertion(dcterms:description goldbook:10822 "Second pharyngeal or branchial arch of the developing embryo, from which different tissues around the neck, ear, and face will develop.")
Declaration(Class(goldbook:10823))
AnnotationAssertion(rdfs:label goldbook:10823 "hypaxial")
AnnotationAssertion(dcterms:description goldbook:10823 "Ventral to the long axis of the body.")
Declaration(Class(goldbook:10824))
AnnotationAssertion(rdfs:label goldbook:10824 "hyperextension")
AnnotationAssertion(dcterms:description goldbook:10824 "Extension of a limb or part of a limb beyond the normal limit.")
Declaration(Class(goldbook:10825))
AnnotationAssertion(rdfs:label goldbook:10825 "hyperflexion")
AnnotationAssertion(dcterms:description goldbook:10825 "Flexion of a limb or part of a limb beyond the normal limit.")
Declaration(Class(goldbook:10826))
AnnotationAssertion(rdfs:label goldbook:10826 "hyperplasia")
AnnotationAssertion(dcterms:description goldbook:10826 "Abnormal multiplication or increase in the number of normal cells in a tissue or organ.")
Declaration(Class(goldbook:10827))
AnnotationAssertion(rdfs:label goldbook:10827 "hypertelorism")
AnnotationAssertion(dcterms:description goldbook:10827 "Abnormally wide space between two organs, especially referring to the eyes.")
Declaration(Class(goldbook:10828))
AnnotationAssertion(rdfs:label goldbook:10828 "hypertrophy")
AnnotationAssertion(dcterms:description goldbook:10828 "Enlargement of an organ or tissue as a result of the increase in the size of its cells.")
Declaration(Class(goldbook:10829))
AnnotationAssertion(rdfs:label goldbook:10829 "hypoblast")
AnnotationAssertion(dcterms:description goldbook:10829 "Innermost of the three primary germ layers, adjacent to the blastocyst cavity, that develops into the endoderm.")
Declaration(Class(goldbook:10830))
AnnotationAssertion(rdfs:label goldbook:10830 "hypogonadism")
AnnotationAssertion(dcterms:description goldbook:10830 "Inadequate functioning of the testes or ovaries as manifested by deficiencies in gametogenesis or in secretion of gonadal hormones.")
Declaration(Class(goldbook:10831))
AnnotationAssertion(rdfs:label goldbook:10831 "hypoplasia")
AnnotationAssertion(dcterms:description goldbook:10831 "Underdevelopment or atrophy of a tissue or organ.")
Declaration(Class(goldbook:10832))
AnnotationAssertion(rdfs:label goldbook:10832 "hypospadias")
AnnotationAssertion(dcterms:description goldbook:10832 "Birth defect in which the urethra opens on the underside of the penis, or into the vagina.")
Declaration(Class(goldbook:10833))
AnnotationAssertion(rdfs:label goldbook:10833 "hypothalamus")
AnnotationAssertion(dcterms:description goldbook:10833 "Region at the base of the brain containing specialized nerve cells that help activate, control, and integrate peripheral autonomic mechanisms, endocrine activities, and some somatic functions such as body temperature, sleep, and appetite.")
Declaration(Class(goldbook:10834))
AnnotationAssertion(rdfs:label goldbook:10834 "hypoxia")
AnnotationAssertion(dcterms:description goldbook:10834 """Abnormally low dioxygen content or tension.
Deficiency of dioxygen in the inspired air, in blood, or in tissues, short of anoxia.""")
Declaration(Class(goldbook:10835))
AnnotationAssertion(rdfs:label goldbook:10835 "ichthyosis")
AnnotationAssertion(dcterms:description goldbook:10835 "Congenital disorder of keratinization, characterized by dryness and scaling of the skin, often associated with other defects and with abnormalities of lipid metabolism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10835 "fish-scale disease")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10835 "fish-skin disease")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10835 "xeroderma")
Declaration(Class(goldbook:10836))
AnnotationAssertion(rdfs:label goldbook:10836 "identical twins")
AnnotationAssertion(dcterms:description goldbook:10836 "Twins resulting from one zygote that, at an early stage of embryonic development, separated into two independently growing cell aggregations giving rise to two individuals of the same sex and identical genetic constitution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10836 "monozygotic twins")
Declaration(Class(goldbook:10837))
AnnotationAssertion(rdfs:label goldbook:10837 "ileocecal")
AnnotationAssertion(dcterms:description goldbook:10837 "Relating to the ileum and the cecum.")
Declaration(Class(goldbook:10838))
AnnotationAssertion(rdfs:label goldbook:10838 "ileum")
AnnotationAssertion(dcterms:description goldbook:10838 "Third portion of the small intestine, between the jejunum and the cecum.")
Declaration(Class(goldbook:10839))
AnnotationAssertion(rdfs:label goldbook:10839 "iliac artery")
AnnotationAssertion(dcterms:description goldbook:10839 "Main artery of the pelvis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10839 "hypogastric artery")
Declaration(Class(goldbook:10840))
AnnotationAssertion(rdfs:label goldbook:10840 "imperforate anus")
AnnotationAssertion(dcterms:description goldbook:10840 "Congenital absence of an anal opening due to the persistence of epithelial plug (persistence of the anal membrane) or to complete absence of the anal canal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10840 "anal atresia")
Declaration(Class(goldbook:10841))
AnnotationAssertion(rdfs:label goldbook:10841 "implantation")
AnnotationAssertion(dcterms:description goldbook:10841 "Embedding of the early embryo in the lining of the uterus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10841 "nidation")
Declaration(Class(goldbook:10842))
AnnotationAssertion(rdfs:label goldbook:10842 "imposex")
AnnotationAssertion(dcterms:description goldbook:10842 "Pseudohermaphroditic condition in female gastropods (snails) manifested by the development (imposition) of male characteristics such as a penis or vas deferens.")
Declaration(Class(goldbook:10843))
AnnotationAssertion(rdfs:label goldbook:10843 "imprinting")
AnnotationAssertion(dcterms:description goldbook:10843 "Differential expression of a gene, depending on whether it was transmitted through the sperm or the egg.")
Declaration(Class(goldbook:10844))
AnnotationAssertion(rdfs:label goldbook:10844 "inbred strain")
AnnotationAssertion(dcterms:description goldbook:10844 "Strain of an animal that has been inbred by brother-sister matings for more than \\(\\pu{20}\\) generations, and consequently all the individuals of the strain are more than \\(\\pu{98\\%}\\) genetically identical.")
Declaration(Class(goldbook:10845))
AnnotationAssertion(rdfs:label goldbook:10845 "female fertility index")
AnnotationAssertion(dcterms:description goldbook:10845 "In rodents, number of pregnant females divided by the number of females mated, multiplied by 100.")
Declaration(Class(goldbook:10846))
AnnotationAssertion(rdfs:label goldbook:10846 "gestation index")
AnnotationAssertion(dcterms:description goldbook:10846 "In rodents, number of females with live born offspring divided by number of females with evidence of pregnancy, multiplied by \\(\\pu{100}\\).")
Declaration(Class(goldbook:10847))
AnnotationAssertion(rdfs:label goldbook:10847 "male fertility index")
AnnotationAssertion(dcterms:description goldbook:10847 "In rodents, number of males impregnating females divided by number of males mated, multiplied by \\(\\pu{100}\\).")
Declaration(Class(goldbook:10848))
AnnotationAssertion(rdfs:label goldbook:10848 "tubular fertility index")
AnnotationAssertion(dcterms:description goldbook:10848 "Percentage of seminiferous tubules containing identifiable spermatogonia.")
Declaration(Class(goldbook:10849))
AnnotationAssertion(rdfs:label goldbook:10849 "induced pluripotent stem cell")
AnnotationAssertion(dcterms:description goldbook:10849 "Pluripotent stem cell that is generated from an adult cell by genetic reprogramming.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10849 "iPS cell")
Declaration(Class(goldbook:10850))
AnnotationAssertion(rdfs:label goldbook:10850 "infertility")
AnnotationAssertion(dcterms:description goldbook:10850 "Persistent inability of either a male or a female to achieve conception or to produce offspring.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10850 "barrenness")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10850 "infecundity")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10850 "sterility")
Declaration(Class(goldbook:10851))
AnnotationAssertion(rdfs:label goldbook:10851 "infundibulum")
AnnotationAssertion(dcterms:description goldbook:10851 "Anatomical funnel-shaped opening, often referring to the hollow stalk that connects the hypothalamus and the posterior pituitary gland, or to the portion of the Fallopian tube that receives the ovum.")
Declaration(Class(goldbook:10852))
AnnotationAssertion(rdfs:label goldbook:10852 "inguinal canal")
AnnotationAssertion(dcterms:description goldbook:10852 "Passage in the lower anterior abdominal wall, which in men conveys the spermatic cord and in women the round ligament of the uterus.")
Declaration(Class(goldbook:10853))
AnnotationAssertion(rdfs:label goldbook:10853 "inhibin")
AnnotationAssertion(dcterms:description goldbook:10853 "Any of a group of peptide hormones secreted by the follicular granulosa cells of the ovary and the Sertoli cells of the testis, inhibiting follicle-stimulating hormone secretion by the anterior pituitary.")
Declaration(Class(goldbook:10854))
AnnotationAssertion(rdfs:label goldbook:10854 "iniencephaly")
AnnotationAssertion(dcterms:description goldbook:10854 "Malformation producing a cranial defect at the occiput, with the brain exposed, often combined with a cervical rachischisis and retroflexion.")
Declaration(Class(goldbook:10855))
AnnotationAssertion(rdfs:label goldbook:10855 "iniopagus")
AnnotationAssertion(dcterms:description goldbook:10855 "Twins conjoined at the occiput.")
Declaration(Class(goldbook:10856))
AnnotationAssertion(rdfs:label goldbook:10856 "insemination")
AnnotationAssertion(dcterms:description goldbook:10856 "Delivery of sperm into the female reproductive system for the purpose or with the result of causing pregnancy.")
Declaration(Class(goldbook:10857))
AnnotationAssertion(rdfs:label goldbook:10857 "integrin")
AnnotationAssertion(dcterms:description goldbook:10857 "Any of a family of cell membrane glycoproteins that mediate cell-to-cell and cell-to-extracellular matrix interactions.")
Declaration(Class(goldbook:10858))
AnnotationAssertion(rdfs:label goldbook:10858 "intermediate filament")
AnnotationAssertion(dcterms:description goldbook:10858 "Any of a group of fibrous proteins (including keratin fibres, neurofilaments, desmin, and vimentin) that make up part of the cytoskeleton of most eukaryotic cells; so named because, at about \\(\\pu{10 nm}\\) diameter, they are intermediate in thickness between actin filaments and microtubules.")
Declaration(Class(goldbook:10859))
AnnotationAssertion(rdfs:label goldbook:10859 "intersexuality")
AnnotationAssertion(dcterms:description goldbook:10859 "Condition of having both male and female characteristics: thus, the state of being intermediate between the sexes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10859 "intersex")
Declaration(Class(goldbook:10860))
AnnotationAssertion(rdfs:label goldbook:10860 "intracytoplasmic sperm injection")
AnnotationAssertion(dcterms:description goldbook:10860 "Infertility treatment in which the sperm is injected through the membrane of the egg into its cytoplasm.")
Declaration(Class(goldbook:10861))
AnnotationAssertion(rdfs:label goldbook:10861 "intramembrous ossification")
AnnotationAssertion(dcterms:description goldbook:10861 "Creation of bone tissue during fetal development of jawed vertebrates, as well as during the healing of bone fractures; the tissue forms from mesenchymal stem cells residing in an extracellular matrix devoid of collagen.")
Declaration(Class(goldbook:10862))
AnnotationAssertion(rdfs:label goldbook:10862 "intrauterine")
AnnotationAssertion(dcterms:description goldbook:10862 "Within the uterus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10862 "in utero")
Declaration(Class(goldbook:10863))
AnnotationAssertion(rdfs:label goldbook:10863 "intrauterine growth restriction")
AnnotationAssertion(dcterms:description goldbook:10863 "Subnormal, poor growth of the fetus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10863 "intrauterine growth retardation")
Declaration(Class(goldbook:10864))
AnnotationAssertion(rdfs:label goldbook:10864 "intrinsic pathway")
AnnotationAssertion(dcterms:description goldbook:10864 "Apoptotic pathway of cell death initiated from within the cell by signals initiated by mitochondrial damage and (or) DNA damage, a defective cell cycle, detachment from the extracellular matrix, hypoxia, loss of cell survival factors, or other types of severe cell stress; characterized by the activation of caspase 9.")
Declaration(Class(goldbook:10865))
AnnotationAssertion(rdfs:label goldbook:10865 "chromosomal inversion")
AnnotationAssertion(dcterms:description goldbook:10865 "Rearrangement of a chromosome in which, after breakage at two points, a segment is reversed, resulting in a change in sequence of nucleotides.")
Declaration(Class(goldbook:10866))
AnnotationAssertion(rdfs:label goldbook:10866 "<em>in vitro</em> fertilization")
AnnotationAssertion(dcterms:description goldbook:10866 "Fertilization outside the body, used as a treatment for infertility.")
Declaration(Class(goldbook:10867))
AnnotationAssertion(rdfs:label goldbook:10867 "ischemia")
AnnotationAssertion(dcterms:description goldbook:10867 "Local deficiency of blood supply, and hence of dioxygen, to an organ or tissue, caused by constriction or obstruction of the blood vessels.")
Declaration(Class(goldbook:10868))
AnnotationAssertion(rdfs:label goldbook:10868 "isotretinoin")
AnnotationAssertion(dcterms:description goldbook:10868 "Vitamin A-like medication (13-cis retinoic acid) used, among other things, for acne treatment.")
Declaration(Class(goldbook:10869))
AnnotationAssertion(rdfs:label goldbook:10869 "jejunum")
AnnotationAssertion(dcterms:description goldbook:10869 "Second part of the small intestine between the duodenum and ileum.")
Declaration(Class(goldbook:10870))
AnnotationAssertion(rdfs:label goldbook:10870 "karyolysis")
AnnotationAssertion(dcterms:description goldbook:10870 "Dissolution of a cell nucleus, especially during mitosis and meiosis but also following necrosis.")
Declaration(Class(goldbook:10871))
AnnotationAssertion(rdfs:label goldbook:10871 "karyorrhexis")
AnnotationAssertion(dcterms:description goldbook:10871 "Irreversible fragmentation of the nucleus of a dying cell following karyolysis, whereby its chromatin is distributed irregularly throughout the cytoplasm.")
Declaration(Class(goldbook:10872))
AnnotationAssertion(rdfs:label goldbook:10872 "karyotype")
AnnotationAssertion(dcterms:description goldbook:10872 """Characterization of the number, form, and size of the chromosomes of an individual or a species.
Photomicrograph of an individual’s chromosomes, arranged according to a standard classification for the species.""")
Declaration(Class(goldbook:10873))
AnnotationAssertion(rdfs:label goldbook:10873 "keratin")
AnnotationAssertion(dcterms:description goldbook:10873 "Fibrous protein forming the main structural constituent of hair, feathers, hoofs, claws, horns, etc.")
Declaration(Class(goldbook:10874))
AnnotationAssertion(rdfs:label goldbook:10874 "keratinization")
AnnotationAssertion(dcterms:description goldbook:10874 "Replacement of the outer epithelial layer of cells, especially in skin, with keratin-rich structures.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10874 "cornification")
Declaration(Class(goldbook:10875))
AnnotationAssertion(rdfs:label goldbook:10875 "ketoacidosis")
AnnotationAssertion(dcterms:description goldbook:10875 "Acidosis, as in diabetes, pregnancy, or starvation, accompanied by the accumulation of ketone bodies in body tissues and fluids.")
Declaration(Class(goldbook:10876))
AnnotationAssertion(rdfs:label goldbook:10876 "ketone body")
AnnotationAssertion(dcterms:description goldbook:10876 "Ketone that is an intermediate product of the breakdown of fats in the body; any of three compounds, acetoacetic acid, acetone, and (or) \\(\\upbeta\\)-hydroxybutanoic acid, found in excess in blood and urine of persons with metabolic disorders.")
Declaration(Class(goldbook:10877))
AnnotationAssertion(rdfs:label goldbook:10877 "Klinefelter syndrome")
AnnotationAssertion(dcterms:description goldbook:10877 "Syndrome in males resulting from a genetic defect in which an extra female X chromosome (thus an XXY genotype) is present in a male, characterized by small testes, long legs, enlarged breasts, reduced sperm production, and mental retardation.")
Declaration(Class(goldbook:10878))
AnnotationAssertion(rdfs:label goldbook:10878 "knockout mutation")
AnnotationAssertion(dcterms:description goldbook:10878 "Mutation that leads to the loss of function of a particular gene.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10878 "null mutation")
Declaration(Class(goldbook:10879))
AnnotationAssertion(rdfs:label goldbook:10879 "kyphosis")
AnnotationAssertion(dcterms:description goldbook:10879 "Rearward curvature or convexity of the spine in excess of normal, resulting in a protuberant upper back.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10879 "hunchback")
Declaration(Class(goldbook:10880))
AnnotationAssertion(rdfs:label goldbook:10880 "labor")
AnnotationAssertion(dcterms:description goldbook:10880 "Physical efforts of expulsion of the fetus and the placenta from the uterus during birth.")
Declaration(Class(goldbook:10881))
AnnotationAssertion(rdfs:label goldbook:10881 "lactation")
AnnotationAssertion(dcterms:description goldbook:10881 "Secretion of milk from the mammary gland, usually to feed the infant during the neonatal period.")
Declaration(Class(goldbook:10882))
AnnotationAssertion(rdfs:label goldbook:10882 "lactation period")
AnnotationAssertion(dcterms:description goldbook:10882 "Time following pregnancy during which the mammary glands secrete milk.")
Declaration(Class(goldbook:10883))
AnnotationAssertion(rdfs:label goldbook:10883 "lamina propria")
AnnotationAssertion(dcterms:description goldbook:10883 "Layer of connective tissue, underlying the epithelium of a mucus membrane, containing capillaries and lymphatic vessels, as well as fibroblasts and cells of the immune system.")
Declaration(Class(goldbook:10884))
AnnotationAssertion(rdfs:label goldbook:10884 "larynx")
AnnotationAssertion(dcterms:description goldbook:10884 "Part of the respiratory tract between the pharynx and the trachea, having walls of cartilage and muscle and containing the vocal cords.")
Declaration(Class(goldbook:10885))
AnnotationAssertion(rdfs:label goldbook:10885 "leprosy")
AnnotationAssertion(dcterms:description goldbook:10885 "Disease caused by infection with the bacterium Mycobacterium leprae, often affecting the skin and nerves and causing body parts to become deformed.")
Declaration(Class(goldbook:10886))
AnnotationAssertion(rdfs:label goldbook:10886 "leptocephaly")
AnnotationAssertion(dcterms:description goldbook:10886 "Malformation characterized by an abnormally tall, narrow cranium.")
Declaration(Class(goldbook:10887))
AnnotationAssertion(rdfs:label goldbook:10887 "leptodactyly")
AnnotationAssertion(dcterms:description goldbook:10887 "Abnormally slender digits.")
Declaration(Class(goldbook:10888))
AnnotationAssertion(rdfs:label goldbook:10888 "leucism")
AnnotationAssertion(dcterms:description goldbook:10888 "Lack of pigmentation in the skin, hair, or feathers as a result of a failure of pigment cells to develop, or to migrate to those locations from their origin in the neural crest, in the embryo.")
Declaration(Class(goldbook:10889))
AnnotationAssertion(rdfs:label goldbook:10889 "leukopenia")
AnnotationAssertion(dcterms:description goldbook:10889 "Abnormally low concentration of white cells (leukocytes) in the blood.")
Declaration(Class(goldbook:10890))
AnnotationAssertion(rdfs:label goldbook:10890 "levocardia")
AnnotationAssertion(dcterms:description goldbook:10890 "Normal position of the heart in the left hemithorax with the apex pointed to the left, and transposition of other viscera.")
Declaration(Class(goldbook:10891))
AnnotationAssertion(rdfs:label goldbook:10891 "Leydig cell")
AnnotationAssertion(dcterms:description goldbook:10891 "Cell in the testis that produces androgens, mainly testosterone, in the presence of luteinizing hormone.")
Declaration(Class(goldbook:10892))
AnnotationAssertion(rdfs:label goldbook:10892 "ligamentum arteriosum")
AnnotationAssertion(dcterms:description goldbook:10892 "Fibrous remnant of the ductus arteriosis linking the aortic arch and the top of the left pulmonary artery.")
Declaration(Class(goldbook:10893))
AnnotationAssertion(rdfs:label goldbook:10893 "limb bud")
AnnotationAssertion(dcterms:description goldbook:10893 "Embryonic outgrowth of mesoderm covered in ectoderm that will give rise to one of the forelimbs or hindlimbs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10893 "arm bud")
Declaration(Class(goldbook:10894))
AnnotationAssertion(rdfs:label goldbook:10894 "linkage analysis")
AnnotationAssertion(dcterms:description goldbook:10894 "Technique that studies patterns of heredity in high-risk families, in order to locate a disease-causing gene mutation by identifying co-inherited traits, usually by producing a LOD score.")
Declaration(Class(goldbook:10895))
AnnotationAssertion(rdfs:label goldbook:10895 "linkage disequilibrium")
AnnotationAssertion(dcterms:description goldbook:10895 "Occurrence in members of a population of combinations of linked genes in non-random proportions, implying that the genes are close enough together on a chromosome to make it unlikely that they will be separated by recombination (see homologous recombination) during meiosis.")
Declaration(Class(goldbook:10896))
AnnotationAssertion(rdfs:label goldbook:10896 "lipidosis")
AnnotationAssertion(dcterms:description goldbook:10896 "Disorder of fat metabolism characterized by the accumulation of abnormal levels of certain lipids in the body.")
Declaration(Class(goldbook:10897))
AnnotationAssertion(rdfs:label goldbook:10897 "litter")
AnnotationAssertion(dcterms:description goldbook:10897 "Multiple offspring produced by a mammal from one pregnancy.")
Declaration(Class(goldbook:10898))
AnnotationAssertion(rdfs:label goldbook:10898 "locus")
AnnotationAssertion(dcterms:description goldbook:10898 "Specific location of a gene or DNA sequence on a chromosome.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10898 "loci")
Declaration(Class(goldbook:10899))
AnnotationAssertion(rdfs:label goldbook:10899 "LOD score")
AnnotationAssertion(dcterms:description goldbook:10899 "Ratio of the likelihood of two or more loci remaining together when chromosomes recombine (true linkage) to the likelihood of this occurring by chance alone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10899 "logarithm (base 10) of odds")
Declaration(Class(goldbook:10900))
AnnotationAssertion(rdfs:label goldbook:10900 "lordosis")
AnnotationAssertion(dcterms:description goldbook:10900 "Forward (ventral) curvature of the spine in the lumbar and cervical regions.")
Declaration(Class(goldbook:10901))
AnnotationAssertion(rdfs:label goldbook:10901 "lumbar puncture")
AnnotationAssertion(dcterms:description goldbook:10901 "Piercing into the subarachnoid space of the lumbar region in order to obtain spinal fluid for diagnostic purposes or to inject a drug.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10901 "spinal tap")
Declaration(Class(goldbook:10902))
AnnotationAssertion(rdfs:label goldbook:10902 "luteal phase")
AnnotationAssertion(dcterms:description goldbook:10902 "Phase of the human menstrual cycle, usually lasting \\(\\pu{14 days}\\), beginning with formation of the corpus luteum and ending, in the absence of fertilization, with the onset of menstruation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10902 "menstrual cycle")
Declaration(Class(goldbook:10903))
AnnotationAssertion(rdfs:label goldbook:10903 "luteinizing hormone")
AnnotationAssertion(dcterms:description goldbook:10903 "Hormone made by the pituitary gland that acts on the ovary to control egg maturation and to trigger ovulation. The same hormone acts in the testes to trigger production of testosterone.")
Declaration(Class(goldbook:10904))
AnnotationAssertion(rdfs:label goldbook:10904 "lymphatic")
AnnotationAssertion(dcterms:description goldbook:10904 "Relating to lymph or its secretion.")
Declaration(Class(goldbook:10905))
AnnotationAssertion(rdfs:label goldbook:10905 "lymphoid")
AnnotationAssertion(dcterms:description goldbook:10905 "Relating to or denoting tissue responsible for producing lymphocytes and antibodies.")
Declaration(Class(goldbook:10906))
AnnotationAssertion(rdfs:label goldbook:10906 "Lyon hypothesis")
AnnotationAssertion(dcterms:description goldbook:10906 "Hypothesis (named after Mary Lyon) that random inactivation of all but one X chromosome occurs in each female mammalian cell in early development, thus explaining why the effect of the X chromosome on phenotype is the same in males with one copy as in females with two copies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10906 "Lyon law")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10906 "lyonization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10906 "X-inactivation")
Declaration(Class(goldbook:10907))
AnnotationAssertion(rdfs:label goldbook:10907 "lysosomal storage disease")
AnnotationAssertion(dcterms:description goldbook:10907 "One of a group of rare inherited metabolic disorders resulting from a defect in lysosomal function, commonly a deficiency of enzymes required for the metabolism of lipids, glycoproteins, or mucopolysaccharides, resulting in their accumulation in the cell.")
Declaration(Class(goldbook:10908))
AnnotationAssertion(rdfs:label goldbook:10908 "macrocephaly")
AnnotationAssertion(dcterms:description goldbook:10908 "Congenital disorder characterized by an abnormally large head and (or) brain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10908 "megacephaly")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10908 "megalocephaly")
Declaration(Class(goldbook:10909))
AnnotationAssertion(rdfs:label goldbook:10909 "macroglossia")
AnnotationAssertion(dcterms:description goldbook:10909 "Congenital disorder characterized by an abnormally enlarged tongue.")
Declaration(Class(goldbook:10910))
AnnotationAssertion(rdfs:label goldbook:10910 "macrognathia")
AnnotationAssertion(dcterms:description goldbook:10910 "Congenital disorder characterized by enlargement or elongation of the jaw.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10910 "megagnathia")
Declaration(Class(goldbook:10911))
AnnotationAssertion(rdfs:label goldbook:10911 "macromelia")
AnnotationAssertion(dcterms:description goldbook:10911 "Congenital disorder characterized by an abnormally large limb or limbs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10911 "megalomelia")
Declaration(Class(goldbook:10912))
AnnotationAssertion(rdfs:label goldbook:10912 "macrosomia")
AnnotationAssertion(dcterms:description goldbook:10912 "Congenital disorder characterized by an abnormally large body or body part.")
Declaration(Class(goldbook:10913))
AnnotationAssertion(rdfs:label goldbook:10913 "macrostomia")
AnnotationAssertion(dcterms:description goldbook:10913 "Congenital disorder characterized by an abnormally large size of the mouth.")
Declaration(Class(goldbook:10914))
AnnotationAssertion(rdfs:label goldbook:10914 "malformation")
AnnotationAssertion(dcterms:description goldbook:10914 "Structural defect as a result of abnormal development.")
Declaration(Class(goldbook:10915))
AnnotationAssertion(rdfs:label goldbook:10915 "malignant")
AnnotationAssertion(dcterms:description goldbook:10915 """Occurring in a severe form, tending to become progressively worse, resistant to treatment, and likely to result in death.
In cancer, cells showing both uncontrolled growth and a tendency to invade and destroy other tissues.""")
Declaration(Class(goldbook:10916))
AnnotationAssertion(rdfs:label goldbook:10916 "mammary gland")
AnnotationAssertion(dcterms:description goldbook:10916 "Milk-producing organ in female mammals.")
