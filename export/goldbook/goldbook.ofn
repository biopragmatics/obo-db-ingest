Declaration(Class(goldbook:H02930))
AnnotationAssertion(rdfs:label goldbook:H02930 "hysteresis")
AnnotationAssertion(dcterms:description goldbook:H02930 "Regarding a material quantity or instrument's reading; the dependence of a value on the direction of change from a previous characteristic value. It may be quantified by the difference between the upscale and downscale variation starting from fixed lower and upper measurement points (inversion).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:H02930 "electrode memory")
AnnotationAssertion(rdfs:seeAlso goldbook:H02930 goldbook:I03146)
AnnotationAssertion(rdfs:seeAlso goldbook:H02930 goldbook:R05189)
AnnotationAssertion(mito:isMentionedBy goldbook:H02930 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:H02930 "current"^^xsd:string)
Declaration(Class(goldbook:HT06787))
AnnotationAssertion(rdfs:label goldbook:HT06787 "Haber–Weiss reaction")
AnnotationAssertion(dcterms:description goldbook:HT06787 "The Haber–Weiss cycle consists of the following two reactions: $\\ce{H2O2 + OH^{.} -> H2O + O2^{−} + H^{+}}$and$\\ce{H2O2 + O2^{-} -> O2 + OH^{-} + OH^{.}}$ The second reaction achieved notoriety as a possible source of hydroxyl radicals. However, it has a negligible rate constant. It is believed that iron(III) complexes can catalyse this reaction: first, Fe(III) is reduced by superoxide, followed by oxidation by dihydrogen peroxide.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT06787 goldbook:FT06786)
AnnotationAssertion(rdfs:seeAlso goldbook:HT06787 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:HT06787 goldbook:O04322)
AnnotationAssertion(mito:isMentionedBy goldbook:HT06787 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT06787 "current"^^xsd:string)
Declaration(Class(goldbook:HT06827))
AnnotationAssertion(rdfs:label goldbook:HT06827 "hazard")
AnnotationAssertion(dcterms:description goldbook:HT06827 "Set of inherent properties of a substance, mixture of substances, or a process involving substances that, under production, usage, or disposal conditions, make it capable of causing adverse effects to organisms or the environment, depending on the degree of exposure; in other words, it is a source of danger.")
AnnotationAssertion(rdfs:seeAlso goldbook:HT06827 goldbook:AT06809)
