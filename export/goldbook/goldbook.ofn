AnnotationAssertion(obo:goldbook#hasStatus goldbook:08981 "current"^^xsd:string)
Declaration(Class(goldbook:08982))
AnnotationAssertion(rdfs:label goldbook:08982 "nucleophilic chain polymerization")
AnnotationAssertion(dcterms:description goldbook:08982 "Chain polymerization in which the active centres are nucleophilic species.")
AnnotationAssertion(rdfs:comment goldbook:08982 "Anionic polymerization is an example of nucleophilic chain polymerization."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08982 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08982 "current"^^xsd:string)
