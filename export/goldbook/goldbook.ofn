AnnotationAssertion(obo:goldbook#hasStatus goldbook:13725 "current"^^xsd:string)
Declaration(Class(goldbook:13726))
AnnotationAssertion(rdfs:label goldbook:13726 "tandem conjugate")
AnnotationAssertion(dcterms:description goldbook:13726 "Molecular construct with two fluorochromes where the first excites the second by its emission.")
AnnotationAssertion(rdfs:comment goldbook:13726 "Used in flow cytometry analysis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13726 goldbook:13152)
AnnotationAssertion(mito:isMentionedBy goldbook:13726 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13726 "current"^^xsd:string)
Declaration(Class(goldbook:13727))
AnnotationAssertion(rdfs:label goldbook:13727 "target cell")
AnnotationAssertion(dcterms:description goldbook:13727 "Cell killed by one of the body’s killer cells, such as a cytotoxic T lymphocyte or natural killer (NK) cell.")
AnnotationAssertion(rdfs:seeAlso goldbook:13727 goldbook:13072)
AnnotationAssertion(rdfs:seeAlso goldbook:13727 goldbook:13361)
AnnotationAssertion(rdfs:seeAlso goldbook:13727 goldbook:13499)
AnnotationAssertion(mito:isMentionedBy goldbook:13727 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13727 "current"^^xsd:string)
Declaration(Class(goldbook:13728))
AnnotationAssertion(rdfs:label goldbook:13728 "terminal deoxynucleotidyl transferase")
AnnotationAssertion(dcterms:description goldbook:13728 "Enzyme that inserts non-coded nucleotides at the junctions of V, D, and J gene segments of immunoglobulin (Ig) and T-cell receptor (TCR) locus DNA, thus increasing the diversity of antigen-specific recognition.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13728 "TDT")
AnnotationAssertion(rdfs:seeAlso goldbook:13728 goldbook:13098)
AnnotationAssertion(rdfs:seeAlso goldbook:13728 goldbook:13354)
