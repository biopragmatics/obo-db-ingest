[Term]
id: goldbook:15321
name: conjugate phases
def: "Two phases of variable composition in mutual thermodynamic equilibrium."
property_value: mito:isMentionedBy doi:10.1351/pac200880020233
property_value: hasStatus "current" xsd:string
