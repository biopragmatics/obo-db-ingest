AnnotationAssertion(rdfs:label goldbook:A00243 "allotropes")
AnnotationAssertion(dcterms:description goldbook:A00243 "Different structural modifications of an element.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00243 doi:10.1515/pac-2014-0718)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00243 "current"^^xsd:string)
Declaration(Class(goldbook:A00244))
AnnotationAssertion(rdfs:label goldbook:A00244 "allotropic transition")
AnnotationAssertion(dcterms:description goldbook:A00244 "A transition of a pure element, at a defined temperature and pressure, from one crystal structure to another which contains the same atoms but which has different properties. Examples: The transition of graphite to diamond, that of body-centred-cubic iron to face-centred-cubic iron, and the transition of orthorhombic sulfur to monoclinic sulfur.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00244 "allotriomorphic transition")
