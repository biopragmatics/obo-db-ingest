Declaration(Class(goldbook:L03625))
AnnotationAssertion(rdfs:label goldbook:L03625 "loose end")
AnnotationAssertion(dcterms:description goldbook:L03625 "Polymer chain within a network which is connected by a junction-point at one end only.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03625 goldbook:NT07562)
AnnotationAssertion(mito:isMentionedBy goldbook:L03625 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03625 "current"^^xsd:string)
Declaration(Class(goldbook:L03628))
AnnotationAssertion(rdfs:label goldbook:L03628 "Lorentzian band shape")
AnnotationAssertion(dcterms:description goldbook:L03628 "This band shape is described by the function: \\[F\\left( u -  u _{0}\\right) = \\frac{1}{\\pi }\\ \\gamma \\ (( u -  u _{0})^{2}+\\gamma ^{2})^{-1}\\] where \\( u_{0}\\) is the mean band position, \\(\\gamma \\) is the half band width at half maximum, and \\(F\\ ( u -  u _{0})\\) is the frequency distribution function.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03628 goldbook:G02597)
AnnotationAssertion(rdfs:seeAlso goldbook:L03628 goldbook:F02526)
AnnotationAssertion(mito:isMentionedBy goldbook:L03628 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03628 "current"^^xsd:string)
Declaration(Class(goldbook:L03629))
AnnotationAssertion(rdfs:label goldbook:L03629 "Lorenz–Mie theory")
AnnotationAssertion(dcterms:description goldbook:L03629 "Theory of light scattering by isotropic, homogeneous spheres.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03629 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:L03629 goldbook:L03525)
AnnotationAssertion(mito:isMentionedBy goldbook:L03629 doi:10.1351/pac198355060931)
