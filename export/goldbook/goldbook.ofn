AnnotationAssertion(rdfs:label goldbook:11838 "ion channel")
AnnotationAssertion(dcterms:description goldbook:11838 "Pore-forming transmembrane protein that can gate the transmembrane flux of small ions.")
AnnotationAssertion(rdfs:comment goldbook:11838 "Ion channels are generally involved in regulation of the electrical membrane potential and cell volume."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11838 "Both voltage-gated and ligand-gated channels promote electrical signals in neurons and muscle cells."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11838 "Many of the known channels are susceptible to inhibition by specific neurotoxins."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11838 goldbook:11851)
