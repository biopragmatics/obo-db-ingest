AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10325 "secondary sex organ")
Declaration(Class(goldbook:10326))
AnnotationAssertion(rdfs:label goldbook:10326 "β-<em>N</em>-acetylhexosaminidase")
AnnotationAssertion(dcterms:description goldbook:10326 "Hydrolytic enzyme (EC 3.2.1.52) that acts on ganglioside \\(\\rm{G}_{\\rm{M2}}\\), producing N-acetyl-D-galactosamine and ganglioside \\(\\rm{G}_{\\rm{M3}}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10326 "hexosaminidase A")
Declaration(Class(goldbook:10327))
