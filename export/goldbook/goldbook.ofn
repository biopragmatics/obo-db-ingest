AnnotationAssertion(rdfs:label goldbook:12157 "vasoconstriction")
AnnotationAssertion(dcterms:description goldbook:12157 "Decrease in the diameter of the lumen of a blood vessel (especially in the arteries and arterioles) as a result of contraction of smooth muscles in the vessel walls.")
AnnotationAssertion(rdfs:comment goldbook:12157 "This results in an increase in vascular resistance followed by an increase in blood pressure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12157 goldbook:12160)
AnnotationAssertion(mito:isMentionedBy goldbook:12157 doi:10.1515/pac-2015-0103)
