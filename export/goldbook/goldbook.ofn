AnnotationAssertion(rdfs:seeAlso goldbook:12925 goldbook:12919)
AnnotationAssertion(mito:isMentionedBy goldbook:12925 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12925 "current"^^xsd:string)
