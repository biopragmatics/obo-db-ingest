AnnotationAssertion(obo:goldbook#hasStatus goldbook:12995 "current"^^xsd:string)
Declaration(Class(goldbook:12996))
AnnotationAssertion(rdfs:label goldbook:12996 "central tolerance")
AnnotationAssertion(dcterms:description goldbook:12996 "Specific immunological tolerance due to the induction of lymphocyte apoptosis or anergy within the primary lymphoid organs (bone marrow in the case of B cell tolerance and the thymus for T cells).")
AnnotationAssertion(rdfs:seeAlso goldbook:12996 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:12996 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12996 goldbook:12875)
