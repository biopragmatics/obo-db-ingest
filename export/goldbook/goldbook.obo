consider: goldbook:F02515

[Term]
id: goldbook:S05875
name: spin–spin coupling
def: "The interaction between the spin magnetic moments of different electrons and/or nuclei. It causes\, e.g. the multiplet pattern in nuclear magnetic resonance spectra."
property_value: mito:isMentionedBy doi:10.1351/pac199668122223
property_value: hasStatus "current" xsd:string
