AnnotationAssertion(obo:goldbook#hasStatus goldbook:16022 "current"^^xsd:string)
Declaration(Class(goldbook:16023))
AnnotationAssertion(rdfs:label goldbook:16023 "readily biodegradable")
AnnotationAssertion(dcterms:description goldbook:16023 "Arbitrary classification of substances that have passed certain specified screening tests for ultimate biodegradability; these tests are so stringent that such compounds will be rapidly and completely biodegraded in a wide variety of aerobic environments.")
AnnotationAssertion(mito:isMentionedBy goldbook:16023 doi:10.1351/pac200779071153)
