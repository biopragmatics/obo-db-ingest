property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15767
name: hemoglobinuria
def: "Presence of free hemoglobin in the urine."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15768
name: hemolysin
def: "Substance that damages the membrane of erythrocytes causing the release of hemoglobin."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15769
name: hemolysis
def: "Release of hemoglobin from erythrocytes\, and its appearance in the plasma."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15770
name: hemoperfusion
def: "Passing blood through a column of charcoal or adsorbent resin for the removal of drugs or toxins."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15771
