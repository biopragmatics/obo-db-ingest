Declaration(Class(goldbook:12920))
AnnotationAssertion(rdfs:label goldbook:12920 "autoimmune hemolytic anemia")
AnnotationAssertion(dcterms:description goldbook:12920 "Autoimmune disease in which antibodies initiate complement lysis of erythrocytes.")
AnnotationAssertion(rdfs:comment goldbook:12920 "Autoimmune hemolytic anemia may be idiopathic, secondary to lymphoproliferative, autoimmune [e.g., systemic lupus erythematosus (SLE)], or chronic inflammatory disorders, postinfectious or drug-induced."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12920 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:12920 goldbook:13127)
AnnotationAssertion(rdfs:seeAlso goldbook:12920 goldbook:13249)
AnnotationAssertion(rdfs:seeAlso goldbook:12920 goldbook:13710)
AnnotationAssertion(mito:isMentionedBy goldbook:12920 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12920 "current"^^xsd:string)
