AnnotationAssertion(dcterms:description goldbook:12152 "Member of a class of drugs based on tryptamine that act as serotonin receptor agonists.")
AnnotationAssertion(rdfs:comment goldbook:12152 "Used for pain relief in the treatment of migraine headache."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12152 goldbook:11874)
