Declaration(Class(goldbook:OT07433))
AnnotationAssertion(rdfs:label goldbook:OT07433 "one-photon photochromism")
AnnotationAssertion(dcterms:description goldbook:OT07433 "Photochromic process involving a one-photon mechanism. In this case, the photoproduct B is formed from the singlet or from the triplet state of the thermodynamically-stable molecular entity A.")
