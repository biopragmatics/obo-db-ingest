AnnotationAssertion(rdfs:label goldbook:12134 "tetrodotoxin-insensitive")
AnnotationAssertion(dcterms:description goldbook:12134 "Denoting a class of sodium ion channels, found mainly in the heart, that is not blocked by tetrodotoxin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12134 "TTX-insensitive")
AnnotationAssertion(rdfs:comment goldbook:12134 "Their significance lies in experimental characterization of channel subtypes in neuromuscular physiology, development, and drug design."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12134 goldbook:11838)
AnnotationAssertion(rdfs:seeAlso goldbook:12134 goldbook:12133)
