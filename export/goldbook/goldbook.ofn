AnnotationAssertion(mito:isMentionedBy goldbook:13396 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13396 "current"^^xsd:string)
Declaration(Class(goldbook:13397))
AnnotationAssertion(rdfs:label goldbook:13397 "lymph node")
AnnotationAssertion(dcterms:description goldbook:13397 "Any of the small rounded gland-like structures of the lymphatic system, which occur along the lymphatic vessels and which are responsible for removing bacteria, viruses, and foreign molecules from the lymph stream and for producing lymphocytes and antibodies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13397 "lymph gland")
AnnotationAssertion(rdfs:seeAlso goldbook:13397 goldbook:13395)
AnnotationAssertion(rdfs:seeAlso goldbook:13397 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13397 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13397 "current"^^xsd:string)
Declaration(Class(goldbook:13398))
AnnotationAssertion(rdfs:label goldbook:13398 "lymphoblast")
AnnotationAssertion(dcterms:description goldbook:13398 "Abnormal cell with a large nucleus and scanty cytoplasm, thought to be the precursor of the lymphocyte, found in blood and blood-forming organs in patients with lymphoblastic leukemia.")
AnnotationAssertion(rdfs:seeAlso goldbook:13398 goldbook:13378)
AnnotationAssertion(rdfs:seeAlso goldbook:13398 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13398 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13398 "current"^^xsd:string)
Declaration(Class(goldbook:13399))
AnnotationAssertion(rdfs:label goldbook:13399 "lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13399 "Small leucocyte found in the blood, lymph, and lymphoid tissues that has a single round nucleus and little or no granulation in the cytoplasm.")
AnnotationAssertion(rdfs:comment goldbook:13399 "Lymphocytes may be either B cells, which produce humoral immunity, or T cells, which produce cell-mediated immunity (CMI)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13399 "Lymphocytes constitute about a quarter of the total leucocytes in the blood stream but occur in large numbers in the lymph nodes and other lymphatic tissue."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13399 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13399 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13399 goldbook:12995)
