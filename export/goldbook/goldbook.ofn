AnnotationAssertion(rdfs:label goldbook:D01590 "density")
AnnotationAssertion(dcterms:description goldbook:D01590 "Mass of a sample or body divided by its volume.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01590 "mass density")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01590 "specific weight")
