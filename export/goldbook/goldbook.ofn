AnnotationAssertion(rdfs:label goldbook:S05698 "singlet-singlet energy transfer")
AnnotationAssertion(dcterms:description goldbook:S05698 "Transfer of excitation from an electronically excited donor in a singlet state to produce an electronically excited acceptor in a singlet state.")
