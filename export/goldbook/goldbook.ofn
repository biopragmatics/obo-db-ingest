AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04021 "current"^^xsd:string)
Declaration(Class(goldbook:M04022))
AnnotationAssertion(rdfs:label goldbook:M04022 "monotectic reaction")
AnnotationAssertion(dcterms:description goldbook:M04022 "The reversible transition, on cooling, of a liquid to a mixture of a second liquid and a solid: \\[\\rm{liquid}_{1}\\rightleftarrows \\rm{liquid}_{2}+\\rm{solid}\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:M04022 goldbook:R05379)
AnnotationAssertion(mito:isMentionedBy goldbook:M04022 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04022 "current"^^xsd:string)
Declaration(Class(goldbook:M04023))
AnnotationAssertion(rdfs:label goldbook:M04023 "monotectoid reaction")
AnnotationAssertion(dcterms:description goldbook:M04023 "A reaction in a system containing two solid solution phases, \\(\\alpha\\mathit{'}\\) and \\(\\alpha\\mathit{''}\\) in which \\(\\alpha\\mathit{'}\\) decomposes into \\(\\alpha\\mathit{''}\\) and a new phase \\(\\beta \\): \\[\\alpha\\mathit{'}\\rightleftharpoons \\alpha\\mathit{''}+\\beta \\]")
AnnotationAssertion(rdfs:seeAlso goldbook:M04023 goldbook:M03940)
AnnotationAssertion(mito:isMentionedBy goldbook:M04023 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04023 "current"^^xsd:string)
Declaration(Class(goldbook:M04024))
AnnotationAssertion(rdfs:label goldbook:M04024 "monotectoid temperature")
AnnotationAssertion(dcterms:description goldbook:M04024 "The maximum temperature at which a monotectoid reaction can occur.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04024 goldbook:M04023)
AnnotationAssertion(mito:isMentionedBy goldbook:M04024 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04024 "current"^^xsd:string)
Declaration(Class(goldbook:M04026))
AnnotationAssertion(rdfs:label goldbook:M04026 "monoterpenoids")
AnnotationAssertion(dcterms:description goldbook:M04026 "Terpenoids having a $\\ce{C10}$ skeleton.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04026 goldbook:T06279)
AnnotationAssertion(mito:isMentionedBy goldbook:M04026 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04026 "current"^^xsd:string)
Declaration(Class(goldbook:M04028))
AnnotationAssertion(rdfs:label goldbook:M04028 "monotropic transition")
AnnotationAssertion(dcterms:description goldbook:M04028 "The irreversible transition from a metastable polymorphic form to the stable polymorph. Example: The transition of metastable $\\ce{CaCO3}$ (aragonite-type) to the stable $\\ce{CaCO3}$ (calcite-type).")
AnnotationAssertion(rdfs:comment goldbook:M04028 "For liquid crystals the term refers to a liquid crystal to liquid-crystal transition that occurs below the melting point and is revealed by supercooling of the crystal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M04028 goldbook:I03258)
AnnotationAssertion(rdfs:seeAlso goldbook:M04028 goldbook:LT06856)
AnnotationAssertion(rdfs:seeAlso goldbook:M04028 goldbook:L03579)
AnnotationAssertion(rdfs:seeAlso goldbook:M04028 goldbook:M03821)
AnnotationAssertion(rdfs:seeAlso goldbook:M04028 goldbook:M03872)
AnnotationAssertion(rdfs:seeAlso goldbook:M04028 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:M04028 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04028 "current"^^xsd:string)
Declaration(Class(goldbook:M04029))
AnnotationAssertion(rdfs:label goldbook:M04029 "mordant")
AnnotationAssertion(dcterms:description goldbook:M04029 "Substance that fixes a dyestuff in or on a material by combining with the dye to form an insoluble compound, used to fix or intensify stains in a tissue or cell preparation.")
AnnotationAssertion(mito:isMentionedBy goldbook:M04029 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04029 "current"^^xsd:string)
Declaration(Class(goldbook:M04030))
AnnotationAssertion(rdfs:label goldbook:M04030 "More O'Ferrall–Jencks diagram")
AnnotationAssertion(dcterms:description goldbook:M04030 "Visualization of the potential energy surfaces for a reacting system, as a function of two chosen coordinates. It is particularly useful to discuss structural effects on the transition state geometry for processes occurring either by stepwise or concerted routes. The use of such diagrams, first suggested for elimination reactions, was later extended to acid–base catalysis and to certain other reactions.")
AnnotationAssertion(rdfs:comment goldbook:M04030 "Structural changes influencing vibrational modes of the transition states cause changes in transition state geometry. Changes in the direction of the reaction coordinate (reactant or product stabilizing- or destabilizing factors) cause changes according to the Hammond principle. Structural changes perpendicular to the reaction coordinate (anti-Hammond effects, perpendicular effects) cause changes opposite to the Hammond behavior, i.e., the easier the process related to the structural change, the more advanced it will be at the transition state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M04030 goldbook:H02734)
AnnotationAssertion(rdfs:seeAlso goldbook:M04030 goldbook:C00874)
AnnotationAssertion(rdfs:seeAlso goldbook:M04030 goldbook:E02038)
AnnotationAssertion(rdfs:seeAlso goldbook:M04030 goldbook:T06468)
AnnotationAssertion(mito:isMentionedBy goldbook:M04030 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04030 "current"^^xsd:string)
Declaration(Class(goldbook:M04031))
AnnotationAssertion(rdfs:label goldbook:M04031 "Morin transition")
AnnotationAssertion(dcterms:description goldbook:M04031 "A transition specific to $\\ce{\\upalpha-Fe2O3}$ in which there is a change in the direction of the atomic magnetic moments in the antiferromagnetic state from parallel to perpendicular to the c-axis. Synonymous with spin-flop transition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:M04031 "spin-flop transition")
AnnotationAssertion(mito:isMentionedBy goldbook:M04031 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04031 "current"^^xsd:string)
Declaration(Class(goldbook:M04032))
AnnotationAssertion(rdfs:label goldbook:M04032 "morphotropic transition")
AnnotationAssertion(dcterms:description goldbook:M04032 "An abrupt change in the structure of a solid solution with variation in composition.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04032 goldbook:M03940)
AnnotationAssertion(mito:isMentionedBy goldbook:M04032 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04032 "current"^^xsd:string)
Declaration(Class(goldbook:M04033))
AnnotationAssertion(rdfs:label goldbook:M04033 "Mössbauer effect")
AnnotationAssertion(dcterms:description goldbook:M04033 "Resonance absorption of γ-radiation by nuclei arranged in a crystal lattice in such a way that the recoil momentum is shared by many atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04033 goldbook:R05326)
AnnotationAssertion(rdfs:seeAlso goldbook:M04033 goldbook:A00036)
AnnotationAssertion(rdfs:seeAlso goldbook:M04033 goldbook:M04007)
AnnotationAssertion(rdfs:seeAlso goldbook:M04033 goldbook:R02568)
AnnotationAssertion(mito:isMentionedBy goldbook:M04033 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04033 "current"^^xsd:string)
Declaration(Class(goldbook:M04034))
AnnotationAssertion(rdfs:label goldbook:M04034 "Mössbauer thickness")
AnnotationAssertion(dcterms:description goldbook:M04034 "The effective thickness of a source (\\(t_{s}\\)) or absorber (\\(t_{a}\\)) in the optical path.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04034 goldbook:A00034)
AnnotationAssertion(mito:isMentionedBy goldbook:M04034 doi:10.1351/pac197645030211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04034 "current"^^xsd:string)
Declaration(Class(goldbook:M04037))
AnnotationAssertion(rdfs:label goldbook:M04037 "Mott transition")
AnnotationAssertion(dcterms:description goldbook:M04037 "A transition occurring only in 'single-valent' systems from strongly correlated (\\(U > W\\)) to weakly correlated (\\(U < W\\)) electrons as a result of a change of bandwidth \\(W\\). \\(W\\) reflects the strength of the interatomic interactions in a periodic array of like atoms and \\(U\\) is a measure of the intra-atomic interactions, i.e. the electrostatic energy involved in the creation of polar states by transferring an electron from one atom to the next, as shown schematically by the disproportionation reaction: \\[\\rm{M}^{n+}+\\rm{M}^{n+}\\rightarrow \\rm{M}^{(n+1)+}+\\rm{M}^{(n- 1)+}\\] A \\(U > W\\) produces a magnetic semiconductor; a \\(U < W\\) gives rise to a metal (normally nonmagnetic). Note also that \\(U\\) and \\(W\\) can be altered by changes in interatomic distances, brought about through temperature or pressure variations or by introducing an alloying element. Synonymous with Mott–Hubbard transition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:M04037 "Mott–Hubbard transition")
AnnotationAssertion(rdfs:seeAlso goldbook:M04037 goldbook:D01799)
AnnotationAssertion(rdfs:seeAlso goldbook:M04037 goldbook:S05591)
AnnotationAssertion(mito:isMentionedBy goldbook:M04037 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04037 "current"^^xsd:string)
Declaration(Class(goldbook:M04041))
AnnotationAssertion(rdfs:label goldbook:M04041 "mucopolysaccharides")
AnnotationAssertion(dcterms:description goldbook:M04041 "Polysaccharides composed of alternating units from uronic acids and glycosamines, and commonly partially esterified with sulfuric acid.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04041 goldbook:P04752)
AnnotationAssertion(rdfs:seeAlso goldbook:M04041 goldbook:G02658)
AnnotationAssertion(rdfs:seeAlso goldbook:M04041 goldbook:U06579)
AnnotationAssertion(mito:isMentionedBy goldbook:M04041 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04041 "current"^^xsd:string)
Declaration(Class(goldbook:M04042))
AnnotationAssertion(rdfs:label goldbook:M04042 "multi-centre bond")
AnnotationAssertion(dcterms:description goldbook:M04042 "Representation of some molecular entities solely by localized two-electron two-centre bonds appears to be unsatisfactory. Instead, multi-centre bonds have to be considered in which electron pairs occupy orbitals encompassing three or more atomic centres. Examples include the three-centre bonds in diborane, the delocalized $\\ce{\\uppi\\!\\mbox{-}bonding}$ of benzene and bridged carbocations.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04042 goldbook:B00697)
AnnotationAssertion(rdfs:seeAlso goldbook:M04042 goldbook:B00737)
AnnotationAssertion(rdfs:seeAlso goldbook:M04042 goldbook:M03986)
AnnotationAssertion(mito:isMentionedBy goldbook:M04042 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04042 "current"^^xsd:string)
Declaration(Class(goldbook:M04043))
AnnotationAssertion(rdfs:label goldbook:M04043 "multi-centre reaction")
AnnotationAssertion(dcterms:description goldbook:M04043 "A synonym for pericyclic reaction. The number of 'centres' is the number of atoms not bonded initially, between which single bonds are breaking or new bonds are formed in the transition state. This number does not necessarily correspond to the ring size of the transition state for the pericyclic reaction. Thus, a Diels–Alder reaction is a 'four-centre reaction'. This terminology has largely been superseded by the more detailed one developed for the various pericyclic reactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04043 goldbook:C01496)
AnnotationAssertion(rdfs:seeAlso goldbook:M04043 goldbook:P04491)
AnnotationAssertion(rdfs:seeAlso goldbook:M04043 goldbook:S05660)
AnnotationAssertion(rdfs:seeAlso goldbook:M04043 goldbook:T06468)
AnnotationAssertion(mito:isMentionedBy goldbook:M04043 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04043 "current"^^xsd:string)
Declaration(Class(goldbook:M04044))
AnnotationAssertion(rdfs:label goldbook:M04044 "multi-channel pulse height analyser")
AnnotationAssertion(dcterms:description goldbook:M04044 "A pulse amplitude analyser which includes a storage function to record the number of pulses received per channel.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04044 goldbook:C00970)
AnnotationAssertion(rdfs:seeAlso goldbook:M04044 goldbook:P04945)
AnnotationAssertion(mito:isMentionedBy goldbook:M04044 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04044 "current"^^xsd:string)
Declaration(Class(goldbook:M04049))
AnnotationAssertion(rdfs:label goldbook:M04049 "multilayer")
AnnotationAssertion(dcterms:description goldbook:M04049 "A system of adjacent layers or monolayers. The term bilayer applies to the particular case of a multilayer two monolayers thick. Monolayers and multilayers may be alternatively named 'films' provided boundaries can be defined for them.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04049 goldbook:B00643)
AnnotationAssertion(rdfs:seeAlso goldbook:M04049 goldbook:F02366)
AnnotationAssertion(rdfs:seeAlso goldbook:M04049 goldbook:L03488)
AnnotationAssertion(rdfs:seeAlso goldbook:M04049 goldbook:M04015)
AnnotationAssertion(mito:isMentionedBy goldbook:M04049 doi:10.1351/pac199466081667)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04049 "current"^^xsd:string)
Declaration(Class(goldbook:M04050))
AnnotationAssertion(rdfs:label goldbook:M04050 "multilayer adsorption")
AnnotationAssertion(dcterms:description goldbook:M04050 "Adsorption such that the adsorption space accommodates more than one layer of molecules, and not all adsorbed molecules are in contact with the surface layer of the adsorbent.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04050 goldbook:A00153)
AnnotationAssertion(rdfs:seeAlso goldbook:M04050 goldbook:S06181)
AnnotationAssertion(mito:isMentionedBy goldbook:M04050 doi:10.1351/pac197231040577)
AnnotationAssertion(mito:isMentionedBy goldbook:M04050 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04050 "current"^^xsd:string)
Declaration(Class(goldbook:M04053))
AnnotationAssertion(rdfs:label goldbook:M04053 "multiphoton ionization")
AnnotationAssertion(dcterms:description goldbook:M04053 "Occurs when an atom or molecule and their concomitant ions have energy states whereby the energy in two or more photons is absorbed.")
AnnotationAssertion(mito:isMentionedBy goldbook:M04053 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04053 "current"^^xsd:string)
Declaration(Class(goldbook:M04054))
AnnotationAssertion(rdfs:label goldbook:M04054 "multiphoton process")
AnnotationAssertion(dcterms:description goldbook:M04054 "A process involving interaction of two or more photons with a molecular entity.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04054 goldbook:B00669)
AnnotationAssertion(rdfs:seeAlso goldbook:M04054 goldbook:T06542)
AnnotationAssertion(mito:isMentionedBy goldbook:M04054 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04054 "current"^^xsd:string)
Declaration(Class(goldbook:M04056))
AnnotationAssertion(rdfs:label goldbook:M04056 "multiple-pass cell")
AnnotationAssertion(dcterms:description goldbook:M04056 "Permits multiple passage of radiation to increase the absorption pathlength. It is constructed in such a way that mirrors either form part of the cell or are mounted in the sample cell holder.")
AnnotationAssertion(mito:isMentionedBy goldbook:M04056 doi:10.1351/pac198860091449)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04056 "current"^^xsd:string)
Declaration(Class(goldbook:M04057))
AnnotationAssertion(rdfs:label goldbook:M04057 "multiple peak scanning")
AnnotationAssertion(dcterms:description goldbook:M04057 "An alternative to multiple ion detection which emphasizes that monitoring of peaks rather than detection of ions is the important feature.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04057 goldbook:MT06831)
AnnotationAssertion(mito:isMentionedBy goldbook:M04057 doi:10.1351/pac197850010065)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04057 "current"^^xsd:string)
Declaration(Class(goldbook:M04058))
AnnotationAssertion(rdfs:label goldbook:M04058 "multiple scattering")
AnnotationAssertion(dcterms:description goldbook:M04058 "Successive rescattering of radiation within the scattering medium.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04058 goldbook:L03525)
AnnotationAssertion(rdfs:seeAlso goldbook:M04058 goldbook:S05487)
AnnotationAssertion(mito:isMentionedBy goldbook:M04058 doi:10.1351/pac198355060931)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04058 "current"^^xsd:string)
Declaration(Class(goldbook:M04059))
AnnotationAssertion(rdfs:label goldbook:M04059 "multiplex spectrometer")
AnnotationAssertion(dcterms:description goldbook:M04059 "A spectrometer in which a single photodetector simultaneously receives signals from different spectral bands which are specifically encoded. In the case of frequency multiplexing, each spectral band is modulated at a specific frequency. Decoding is achieved by filtering out, by electronic means, the corresponding signals. Frequency multiplexing may be realized by changing the path difference between the two interfering beams at a uniform rate. Fourier transform of the interferogram so obtained yields the spectrum. This method is called Fourier transform spectrometry (FTS).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:M04059 "FTS")
AnnotationAssertion(rdfs:seeAlso goldbook:M04059 goldbook:F02493)
AnnotationAssertion(rdfs:seeAlso goldbook:M04059 goldbook:S05837)
AnnotationAssertion(mito:isMentionedBy goldbook:M04059 doi:10.1351/pac199567101725)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04059 "current"^^xsd:string)
Declaration(Class(goldbook:M04061))
AnnotationAssertion(rdfs:label goldbook:M04061 "multiplicative name")
AnnotationAssertion(dcterms:description goldbook:M04061 "A name that expresses the multiple occurrence of identical parent structures, two or more of which are connected by a symmetrical structure expressible by means of a multivalent simple or composite prefix.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04061 goldbook:CT07545)
AnnotationAssertion(mito:isMentionedBy goldbook:M04061 doi:10.1351/pac199971071327)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04061 "current"^^xsd:string)
Declaration(Class(goldbook:M04062))
AnnotationAssertion(rdfs:label goldbook:M04062 "multiplicity")
AnnotationAssertion(dcterms:description goldbook:M04062 "The number of possible orientations, calculated as \\(2\\ S+1\\), of the spin angular momentum corresponding to a given total spin quantum number (\\(S\\)), for the same spatial electronic wavefunction. A state of singlet multiplicity has \\(S=0\\) and \\(2\\ S+1=1\\). A doublet state has \\(S=\\frac{1}{2}\\), \\(2\\ S+1=2\\), etc. Note that when \\(S>L\\) (the total orbital angular momentum possible) there are only \\(2\\ L+1\\) orientations of total angular momentum possible.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:M04062 "spin multiplicity")
AnnotationAssertion(rdfs:seeAlso goldbook:M04062 goldbook:A00353)
AnnotationAssertion(rdfs:seeAlso goldbook:M04062 goldbook:D01853)
AnnotationAssertion(mito:isMentionedBy goldbook:M04062 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04062 "current"^^xsd:string)
Declaration(Class(goldbook:M04063))
AnnotationAssertion(rdfs:label goldbook:M04063 "multiply labelled")
AnnotationAssertion(dcterms:description goldbook:M04063 "A selectively labelled compound may be multiply labelled when in the unmodified compound there is more than one atom of the same element at the position where the isotopic modification occurs, e.g. $\\ce{H}$ in $\\ce{CH4}$, or there are several atoms of the same element at different positions where the isotopic modification occurs, e.g. $\\ce{C}$ in $\\ce{C4H8O}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04063 goldbook:S05556)
AnnotationAssertion(mito:isMentionedBy goldbook:M04063 doi:10.1351/pac198153101887)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04063 "current"^^xsd:string)
Declaration(Class(goldbook:M04065))
AnnotationAssertion(rdfs:label goldbook:M04065 "multistage sampling")
AnnotationAssertion(dcterms:description goldbook:M04065 "Samples taken in a series of steps with the sampling portions constituting the sample (units or increments) at each step being selected from the larger or greater number of portions of the previous step, or from a primary or composite sample. The first set of portions (units or increments) taken from the population available for sampling is the primary sample. The subsequent samples (secondary, tertiary, etc.) are the sets of subsamples, units, items, individuals or increments taken from the preceding step. The units may be different steps of multistage sampling (e.g. pallets, cases, packages).")
AnnotationAssertion(rdfs:seeAlso goldbook:M04065 goldbook:C01212)
AnnotationAssertion(rdfs:seeAlso goldbook:M04065 goldbook:P04841)
AnnotationAssertion(mito:isMentionedBy goldbook:M04065 doi:10.1351/pac199062061193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04065 "current"^^xsd:string)
Declaration(Class(goldbook:M04066))
AnnotationAssertion(rdfs:label goldbook:M04066 "multi-strand chain")
AnnotationAssertion(dcterms:description goldbook:M04066 "A chain that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through more than four atoms, more than two on at least one side of each constitutional unit.")
AnnotationAssertion(rdfs:comment goldbook:M04066 "A chain that comprises constitutional units joined to each other through \\(n\\) atoms on at least one side of each constitutional unit is termed an n-strand chain, e.g. three-strand chain. If an uncertainty exists in defining \\(n\\), the highest possible number is selected."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M04066 goldbook:C00946)
AnnotationAssertion(rdfs:seeAlso goldbook:M04066 goldbook:C01288)
AnnotationAssertion(mito:isMentionedBy goldbook:M04066 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04066 "current"^^xsd:string)
Declaration(Class(goldbook:M04067))
AnnotationAssertion(rdfs:label goldbook:M04067 "multi-strand macromolecule")
AnnotationAssertion(dcterms:description goldbook:M04067 "A macromolecule that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through more than four atoms, more than two on at least one side of each constitutional unit.")
AnnotationAssertion(rdfs:comment goldbook:M04067 "A macromolecule that comprises constitutional units joined to each other through \\(n\\) atoms on at least one side of each constitutional unit is termed an n-strand macromolecule, e.g. three-strand macromolecule. If an ambiguity exists in defining \\(n\\), the highest possible number is selected."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:M04067 goldbook:C01288)
AnnotationAssertion(rdfs:seeAlso goldbook:M04067 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:M04067 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04067 "current"^^xsd:string)
Declaration(Class(goldbook:M04068))
AnnotationAssertion(rdfs:label goldbook:M04068 "munchnones")
AnnotationAssertion(dcterms:description goldbook:M04068 "Mesoionic compounds having a 1,3-oxazole skeleton bearing an oxygen atom attached to the 5-position with the following delocalized structure:")
AnnotationAssertion(rdfs:seeAlso goldbook:M04068 goldbook:M03842)
AnnotationAssertion(mito:isMentionedBy goldbook:M04068 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04068 "current"^^xsd:string)
Declaration(Class(goldbook:M04071))
AnnotationAssertion(rdfs:label goldbook:M04071 "mustards")
AnnotationAssertion(dcterms:description goldbook:M04071 "Compounds having two $\\ce{\\upbeta\\!\\mbox{-}haloalkyl groups}$ bound to a sulfur atom, as in $\\ce{(XC2H2C2H2)2S}$, and their analogues, the nitrogen (and phosphorus) mustards, $\\ce{(XC2H2C2H2)2NR}$. Compounds having one $\\ce{\\upbeta\\!\\mbox{-}haloalkyl group}$ and one $\\ce{\\upbeta\\!\\mbox{-}hydroxyalkyl group}$ on $\\ce{S}$ are termed hemi- or semi-mustards by some chemists.")
AnnotationAssertion(mito:isMentionedBy goldbook:M04071 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04071 "current"^^xsd:string)
Declaration(Class(goldbook:M04072))
AnnotationAssertion(rdfs:label goldbook:M04072 "mutagenesis")
AnnotationAssertion(dcterms:description goldbook:M04072 "The introduction of permanant heritable changes i.e. mutations into the DNA of an organism.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04072 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:M04072 goldbook:M04074)
AnnotationAssertion(mito:isMentionedBy goldbook:M04072 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04072 "current"^^xsd:string)
Declaration(Class(goldbook:M04073))
AnnotationAssertion(rdfs:label goldbook:M04073 "mutarotation")
AnnotationAssertion(dcterms:description goldbook:M04073 "The change in optical rotation accompanying epimerization. In sugar chemistry this term usually refers to epimerization at the hemiacetal carbon atom.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04073 goldbook:E02166)
AnnotationAssertion(rdfs:seeAlso goldbook:M04073 goldbook:O04312)
AnnotationAssertion(mito:isMentionedBy goldbook:M04073 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04073 "current"^^xsd:string)
Declaration(Class(goldbook:M04074))
AnnotationAssertion(rdfs:label goldbook:M04074 "mutation")
AnnotationAssertion(dcterms:description goldbook:M04074 "A heritable change in the nucleotide sequence of genomic DNA (or RNA in RNA viruses), or in the number of genes or chromosomes in a cell, which may occur spontaneously or be brought about by chemical mutagens or by radiation (induced mutation).")
AnnotationAssertion(rdfs:seeAlso goldbook:M04074 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:M04074 goldbook:R05386)
AnnotationAssertion(rdfs:seeAlso goldbook:M04074 goldbook:C01077)
AnnotationAssertion(rdfs:seeAlso goldbook:M04074 goldbook:G02604)
AnnotationAssertion(rdfs:seeAlso goldbook:M04074 goldbook:N04255)
AnnotationAssertion(rdfs:seeAlso goldbook:M04074 goldbook:ST06775)
AnnotationAssertion(mito:isMentionedBy goldbook:M04074 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04074 "current"^^xsd:string)
Declaration(Class(goldbook:M04075))
AnnotationAssertion(rdfs:label goldbook:M04075 "mutation rate")
AnnotationAssertion(dcterms:description goldbook:M04075 "The frequency (\\(\\rm{h}^{-1}\\)) with which a mutation occurs within a organism or gene. In general, rates of spontaneous mutation vary between one in \\(10^{4}\\) and one in \\(10^{8}\\) per gene per generation, and can be considerably increased by mutagens.")
AnnotationAssertion(rdfs:seeAlso goldbook:M04075 goldbook:G02604)
AnnotationAssertion(rdfs:seeAlso goldbook:M04075 goldbook:M04074)
AnnotationAssertion(mito:isMentionedBy goldbook:M04075 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04075 "current"^^xsd:string)
Declaration(Class(goldbook:M04077))
AnnotationAssertion(rdfs:label goldbook:M04077 "Myelin cylinders")
AnnotationAssertion(dcterms:description goldbook:M04077 "Birefringent cylinders which form spontaneously from lipid-containing material in contact with water.")
AnnotationAssertion(mito:isMentionedBy goldbook:M04077 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:M04077 "current"^^xsd:string)
Declaration(Class(goldbook:MT06760))
AnnotationAssertion(rdfs:label goldbook:MT06760 "mobility")
AnnotationAssertion(dcterms:description goldbook:MT06760 "Mass transport is described by a mobility \\(b\\), defined by: \\[b_{i} = \\frac{ u _{i}}{\\boldsymbol{F}_{i}}\\] where \\( u _{i}\\) is the average drift velocity and \\(\\boldsymbol{F}_{i}\\) is the force on particle \\(i\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06760 goldbook:D01859)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06760 goldbook:F02480)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06760 goldbook:M03955)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06760 doi:10.1351/pac199971071307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06760 "current"^^xsd:string)
Declaration(Class(goldbook:MT06765))
AnnotationAssertion(rdfs:label goldbook:MT06765 "metalloenzyme")
AnnotationAssertion(dcterms:description goldbook:MT06765 "An enzyme that, in the active state, contains one or more metal ions which are essential for its biological function.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06765 goldbook:E02159)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06765 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06765 "current"^^xsd:string)
Declaration(Class(goldbook:MT06778))
AnnotationAssertion(rdfs:label goldbook:MT06778 "magnetic circular dichroism")
AnnotationAssertion(dcterms:description goldbook:MT06778 "Magnetic circular dichroism is observed when a sample differentially absorbs left- and right- circularly polarized light in a magnetic field parallel to the light beam.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:MT06778 "MCD")
AnnotationAssertion(rdfs:comment goldbook:MT06778 "The MCD signal, \\(\\Delta\\), is calculated as \\[\\Delta  = \\frac{\\alpha(\\lambda)^{-}\\,-\\,\\alpha(\\lambda)^{+}}{\\alpha(\\lambda)^{-}\\,+\\,\\alpha(\\lambda)^{+}}\\] with \\(\\alpha(\\lambda)^{-}\\) and \\(\\alpha(\\lambda)^{+}\\) the absorption coefficients for right and left circularly polarized light, respectively. The spectra are a representation of \\(\\Delta\\) vs wavelength. Often, \\(\\Delta\\) is recorded as a function of the applied field (up to \\(10\\ \\rm{T}\\)) and the temperature."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT06778 "Phenomenon related to 'magnetically induced optical activity (Faraday effect)' by the 'Kramers-Kronig transformations', which connect optical refraction and absorption, i.e., MCD is observed in optically active materials at wavelengths with non-vanishing absorption. It occurs for diamagnetic, paramagnetic and (anti)-ferromagnetic material and has been observed from IR (infrared) to X-ray regions. MCD optical transitions in molecular species arise if (i) degenerate electronic states are split in the presence of a magnetic field (first-order-Zeeman effect) or (ii) states are mixed together by the applied magnetic field (second-order-Zeeman effect). This may occur in the initial or the final states."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT06778 "MCD is used as a probe of paramagnetism that permits the identification of the electronic and magnetic properties of the ground states of transition metal ion centres. The wavelength dependence of MCD can be used also to identify and assign optical transitions from metal ion sites."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT06778 "Technique complementary to both EPR and electronic absorption spectroscopies in facilitating assignment of the ground-state spin and electronic transitions of a molecular entity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:Z06739)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:A00381)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:D01668)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:DT07357)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:IT07399)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:O04303)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:P04404)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06778 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06778 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06778 "current"^^xsd:string)
Declaration(Class(goldbook:MT06781))
AnnotationAssertion(rdfs:label goldbook:MT06781 "magnetic susceptibility")
AnnotationAssertion(dcterms:description goldbook:MT06781 "For paramagnetic materials, the magnetic susceptibility may be measured experimentally and used to give information on the molecular magnetic dipole moment, and hence on the electronic structure of the molecules in the material. The paramagnetic contribution to the molar magnetic susceptibility of a material, \\(\\chi \\), is related to the molecular magnetic dipole moment \\(m\\) by the curie relation: \\(\\chi = \\frac{\\rm{constant x}\\ m^{2}}{T}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06781 goldbook:C01444)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06781 goldbook:D01761)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06781 goldbook:P04404)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06781 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06781 "current"^^xsd:string)
Declaration(Class(goldbook:MT06795))
AnnotationAssertion(rdfs:label goldbook:MT06795 "magnetic resonance imaging")
AnnotationAssertion(dcterms:description goldbook:MT06795 "The visualisation of the distribution of nuclear spins (usually water) in a body by using a magnetic field gradient (NMR imaging). A similar technique, but less widely used, is to visualise the distribution of paramagnetic centres (EPR imaging).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:MT06795 "MRI")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06795 goldbook:G02669)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06795 goldbook:P04404)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06795 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06795 "current"^^xsd:string)
Declaration(Class(goldbook:MT06830))
AnnotationAssertion(rdfs:label goldbook:MT06830 "metabolic half-life")
AnnotationAssertion(dcterms:description goldbook:MT06830 "Time required for one-half of the quantity of a substance in the body to be metabolised.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:MT06830 "metabolic half-time")
AnnotationAssertion(mito:isMentionedBy goldbook:MT06830 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06830 "current"^^xsd:string)
Declaration(Class(goldbook:MT06831))
AnnotationAssertion(rdfs:label goldbook:MT06831 "monitoring")
AnnotationAssertion(dcterms:description goldbook:MT06831 "Continuous or repeated observation, measurement, and evaluation of health and/or environmental or technical data for defined purposes, according to prearranged schedules in space and time, using comparable methods for sensing and data collection.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06831 goldbook:C01148)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06831 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06831 "current"^^xsd:string)
Declaration(Class(goldbook:MT06832))
AnnotationAssertion(rdfs:label goldbook:MT06832 "Monte Carlo study")
AnnotationAssertion(dcterms:description goldbook:MT06832 "Simulation and analysis of a sequence of events using random numbers to generate possible outcomes in an iterative process.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06832 goldbook:ST06775)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06832 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06832 "current"^^xsd:string)
Declaration(Class(goldbook:MT06833))
AnnotationAssertion(rdfs:label goldbook:MT06833 "mutagen")
AnnotationAssertion(dcterms:description goldbook:MT06833 "Agent that can induce heritable changes (mutations) of the genotype in a cell as a consequence of alterations or loss of genetic material.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06833 goldbook:G02617)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06833 goldbook:M04074)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06833 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06833 "current"^^xsd:string)
Declaration(Class(goldbook:MT06853))
AnnotationAssertion(rdfs:label goldbook:MT06853 "mesomorphic state")
AnnotationAssertion(dcterms:description goldbook:MT06853 "A state of matter in which the degree of molecular order is intermediate between the perfect three-dimensional, long-range positional and orientational order found in solid crystals and the absence of long-range order found in isotropic liquids, gases, and amorphous solids.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06853 goldbook:I03353)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06853 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06853 "current"^^xsd:string)
Declaration(Class(goldbook:MT06858))
AnnotationAssertion(rdfs:label goldbook:MT06858 "mesogenic group")
AnnotationAssertion(dcterms:description goldbook:MT06858 "A part of a molecule or macromolecule endowed with sufficient anisotropy in both attractive and repulsive forces to contribute strongly to mesophase or, in particular, liquid-crystal mesophase formation in low-molar-mass and polymeric substances.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06858 goldbook:AT06776)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06858 goldbook:LT06856)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06858 goldbook:M03849)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06858 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06858 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06858 "current"^^xsd:string)
Declaration(Class(goldbook:MT06869))
AnnotationAssertion(rdfs:label goldbook:MT06869 "main-chain polymer liquid crystal")
AnnotationAssertion(dcterms:description goldbook:MT06869 "A polymer, whose molecules have mesogenic units only in their main chains.")
AnnotationAssertion(mito:isMentionedBy goldbook:MT06869 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06869 "current"^^xsd:string)
Declaration(Class(goldbook:MT06870))
AnnotationAssertion(rdfs:label goldbook:MT06870 "mesogen")
AnnotationAssertion(dcterms:description goldbook:MT06870 "A compound that under suitable conditions of temperature, pressure, and concentration can exist as a mesophase or, in particular, as a liquid-crystal (LC) phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06870 goldbook:LT06855)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06870 goldbook:M03849)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06870 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06870 "current"^^xsd:string)
Declaration(Class(goldbook:MT06878))
AnnotationAssertion(rdfs:label goldbook:MT06878 "membrane")
AnnotationAssertion(dcterms:description goldbook:MT06878 "Structure, having lateral dimensions much greater than its thickness, through which transfer may occur under a variety of driving forces.")
AnnotationAssertion(mito:isMentionedBy goldbook:MT06878 doi:10.1351/pac199668071479)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06878 "current"^^xsd:string)
Declaration(Class(goldbook:MT06887))
AnnotationAssertion(rdfs:label goldbook:MT06887 "microfiltration")
AnnotationAssertion(dcterms:description goldbook:MT06887 "Pressure-driven membrane-based separation process in which particles and dissolved macromolecules larger than \\(0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\) are rejected.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06887 goldbook:MT06878)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06887 doi:10.1351/pac199668071479)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06887 "current"^^xsd:string)
Declaration(Class(goldbook:MT06910))
AnnotationAssertion(rdfs:label goldbook:MT06910 "maximum latent period")
AnnotationAssertion(dcterms:description goldbook:MT06910 "The length of time after which no causal relationship can reasonably be established. This length of time is the period from the last exposure to the point of time at which an exposed person has demonstrated the initial signs or symptoms.")
AnnotationAssertion(mito:isMentionedBy goldbook:MT06910 doi:10.1351/pac200173060993)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06910 "current"^^xsd:string)
Declaration(Class(goldbook:MT06924))
AnnotationAssertion(rdfs:label goldbook:MT06924 "migration time")
AnnotationAssertion(dcterms:description goldbook:MT06924 "The time required for the analyte to move through the effective length of the capillary, \\(L_{\\rm{eff}}\\), that is, from the sample introduction point to the detection point.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06924 goldbook:A00331)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06924 doi:10.1351/pac200476020443)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06924 "current"^^xsd:string)
Declaration(Class(goldbook:MT06927))
AnnotationAssertion(rdfs:label goldbook:MT06927 "migration time of micelles")
AnnotationAssertion(dcterms:description goldbook:MT06927 "Experimentally determined as the migration time of a compound that is completely retained in the micellar phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06927 goldbook:MT06924)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06927 doi:10.1351/pac200476020443)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06927 "current"^^xsd:string)
Declaration(Class(goldbook:MT06928))
AnnotationAssertion(rdfs:label goldbook:MT06928 "mass distribution ratio")
AnnotationAssertion(dcterms:description goldbook:MT06928 "Defined as: \\[k_{\\rm{MEKC}} = \\frac{n_{\\rm{mc}}}{n_{\\rm{aq}}} = K\\cdot \\frac{V_{\\rm{mc}}}{V_{\\rm{aq}}}\\] where \\(n_{\\rm{mc}}\\) and \\(n_{\\rm{aq}}\\) are the chemical amounts of the analyte in the micellar and aqueous phases, respectively, \\(K\\) is the distribution constant and \\(V_{\\rm{mc}}\\) and \\(V_{\\rm{aq}}\\) are the corresponding volumes of the phases.")
AnnotationAssertion(rdfs:comment goldbook:MT06928 "In the case of an electrically neutral analyte, \\(k_{\\rm{MEKC}}\\) can be calculated directly from the migration times: \\[k_{\\rm{MEKC}} = \\frac{t_{\\rm{m}} - t_{\\rm{eo}}}{t_{\\rm{eo}}(1 - t_{\\rm{m}}/t_{\\rm{mc}})}\\]"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT06928 "\\(k_{\\rm{MEKC}}\\) should not be confused with the retention factor (in column chromatography) \\(k\\). However, \\(k_{\\rm{MEKC}}\\) is analogous to the mass distribution ratio (in chromatography)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06928 goldbook:A00331)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06928 goldbook:C01075)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06928 goldbook:C01182)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06928 goldbook:D01813)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06928 goldbook:E02305)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06928 goldbook:M03920)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06928 doi:10.1351/pac200476020443)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06928 "current"^^xsd:string)
Declaration(Class(goldbook:MT06929))
AnnotationAssertion(rdfs:label goldbook:MT06929 "mass distribution ratio")
AnnotationAssertion(dcterms:description goldbook:MT06929 "Defined analogously to mass distribution ratio (in micellar electrokinetic chromatography), \\(k_{\\rm{MEEKC}}\\) by replacing terms for micelles with corresponding terms for micro-emulsion.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06929 goldbook:E02065)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06929 goldbook:MT06928)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06929 goldbook:M03894)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06929 doi:10.1351/pac200476020443)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06929 "current"^^xsd:string)
Declaration(Class(goldbook:MT06966))
AnnotationAssertion(rdfs:label goldbook:MT06966 "MOL file format")
AnnotationAssertion(dcterms:description goldbook:MT06966 "The MOL file format is used to encode chemical structures, substructures and conformations as text-based connection tables. It is used by MDL Information Systems Inc. (e.g., in their MACCS or ISIS programs).")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06966 goldbook:MT06973)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06966 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06966 "current"^^xsd:string)
Declaration(Class(goldbook:MT06967))
AnnotationAssertion(rdfs:label goldbook:MT06967 "molecular connectivity index")
AnnotationAssertion(dcterms:description goldbook:MT06967 "A molecular connectivity index is a numeric descriptor derived from molecular topology.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06967 goldbook:C01274)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06967 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06967 "current"^^xsd:string)
Declaration(Class(goldbook:MT06968))
AnnotationAssertion(rdfs:label goldbook:MT06968 "molecular design")
AnnotationAssertion(dcterms:description goldbook:MT06968 "Molecular design is the application of all techniques leading to the discovery of new chemical entities with specific properties required for the intended application.")
AnnotationAssertion(mito:isMentionedBy goldbook:MT06968 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06968 "current"^^xsd:string)
Declaration(Class(goldbook:MT06969))
AnnotationAssertion(rdfs:label goldbook:MT06969 "molecular dynamics")
AnnotationAssertion(dcterms:description goldbook:MT06969 "Molecular dynamics is a simulation procedure consisting of the computation of the motion of atoms in a molecule or of individual atoms or molecules in solids, liquids and gases, according to Newton's laws of motion. The forces acting on the atoms, required to simulate their motions, are generally calculated using molecular mechanics force fields.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06969 goldbook:M03985)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06969 goldbook:N04135)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06969 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06969 "current"^^xsd:string)
Declaration(Class(goldbook:MT06970))
AnnotationAssertion(rdfs:label goldbook:MT06970 "molecular graphics")
AnnotationAssertion(dcterms:description goldbook:MT06970 "Molecular graphics is a technique for the visualization and manipulation of molecules on a graphical display device.")
AnnotationAssertion(mito:isMentionedBy goldbook:MT06970 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06970 "current"^^xsd:string)
Declaration(Class(goldbook:MT06971))
AnnotationAssertion(rdfs:label goldbook:MT06971 "molecular modeling")
AnnotationAssertion(dcterms:description goldbook:MT06971 "Molecular modeling is the investigation of molecular structures and properties using computational chemistry and graphical visualization techniques in order to provide a plausible three-dimensional representation under a given set of circumstances.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06971 goldbook:CT06952)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06971 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06971 "current"^^xsd:string)
Declaration(Class(goldbook:MT06972))
AnnotationAssertion(rdfs:label goldbook:MT06972 "molecular shape")
AnnotationAssertion(dcterms:description goldbook:MT06972 "The molecular shape is an attribute of a molecule dealing with spatial extension, form, framework, or geometry. It is often described by, e.g., principal axes, ovality, or connectivity indices.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06972 goldbook:C01274)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06972 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06972 "current"^^xsd:string)
Declaration(Class(goldbook:MT06973))
AnnotationAssertion(rdfs:label goldbook:MT06973 "molfile")
AnnotationAssertion(dcterms:description goldbook:MT06973 "A molfile is a table containing atom type, connectivity and a more or less arbitrary 2D or 3D information about a molecule. Well-known file formats include the MOLfile used by MDL Information Systems Inc. (e.g., in the database MACCS), the MOL2 file used by Tripos Associates (e.g., in the modeling package SYBYL), or the CSSR format.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06973 goldbook:MT06966)
AnnotationAssertion(rdfs:seeAlso goldbook:MT06973 goldbook:C01274)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06973 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06973 "current"^^xsd:string)
Declaration(Class(goldbook:MT06974))
AnnotationAssertion(rdfs:label goldbook:MT06974 "multivariate statistics")
AnnotationAssertion(dcterms:description goldbook:MT06974 "Multivariate statistics is a set of statistical tools to analyze data (e.g., chemical and biological) matrices using regression and/or pattern recognition techniques.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT06974 goldbook:PT06976)
AnnotationAssertion(mito:isMentionedBy goldbook:MT06974 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT06974 "current"^^xsd:string)
Declaration(Class(goldbook:MT07068))
AnnotationAssertion(rdfs:label goldbook:MT07068 "maximum hardness principle")
AnnotationAssertion(dcterms:description goldbook:MT07068 "A chemical system at a given temperature will evolve to a configuration of maximum absolute hardness, $\\upeta\\!$, provided that the potential due to the nuclei, plus any external potential and the electronic chemical potential, remain constant. In terms of molecular orbital theory, the highest value of $\\upeta\\!$ reflects the highest possible energy gap between the lowest unoccupied and highest occupied molecular orbitals; this value correlates with the stability of a system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:MT07068 "principle of maximum hardness")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07068 goldbook:ET07025)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07068 goldbook:ET07027)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07068 goldbook:M03996)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07068 goldbook:ST07109)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07068 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07068 "current"^^xsd:string)
Declaration(Class(goldbook:MT07069))
AnnotationAssertion(rdfs:label goldbook:MT07069 "molecular graph")
AnnotationAssertion(dcterms:description goldbook:MT07069 "The graph with differently labelled (coloured) vertices (chromatic graph) which represent different kinds of atoms and differently labelled (coloured) edges related to different types of bonds. Within the topological electron distribution theory, a complete network of the bond paths for a given nuclear configuration.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07069 goldbook:NT07562)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07069 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07069 "current"^^xsd:string)
Declaration(Class(goldbook:MT07070))
AnnotationAssertion(rdfs:label goldbook:MT07070 "molecular graph theory")
AnnotationAssertion(dcterms:description goldbook:MT07070 "The theory which deals with analyses of all consequences of connectivities inherent in molecular structure and chemical transformations. The theory does not produce numerical data but uses available data and searches for regularities that can be attributed to combinatorial and topological origins.")
AnnotationAssertion(mito:isMentionedBy goldbook:MT07070 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07070 "current"^^xsd:string)
Declaration(Class(goldbook:MT07071))
AnnotationAssertion(rdfs:label goldbook:MT07071 "molecular Rydberg state")
AnnotationAssertion(dcterms:description goldbook:MT07071 "An excited electronic state which is composed primarily of atomic orbitals with principal quantum numbers greater than that of the ground state and the valence excited states. Such electronic states typically have a large polarizability.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07071 goldbook:ET07026)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07071 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07071 goldbook:P04711)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07071 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07071 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07071 "current"^^xsd:string)
Declaration(Class(goldbook:MT07072))
AnnotationAssertion(rdfs:label goldbook:MT07072 "Monte Carlo method")
AnnotationAssertion(dcterms:description goldbook:MT07072 "In mathematics, a method originally used for calculating multiple integrals by means of a random sample. The method is used for numerical modelling of many-particle chemical systems, in particular liquids; it is based on the equilibrium statistical mechanics theory. Observables A are calculated as mean values over a great number (\\(\\cong\\rm{10}^{\\rm{5}}-\\rm{10}^{\\rm{6}}\\)) of instant configurations as determined by coordinates of the particles. \\[< A >\\ = \\frac{1}{N}\\sum _{i=1}^{N}A\\{r_{i}\\}\\] where \\(N\\) is the number of configurations. At the first stage, various configurations are randomly generated and then those energetically unrealizable eliminated. An efficient search for the most probable configurations to be entered into the above expression is provided by the Metropolis algorithm based on the principle of Markov's chain theory. While being elaborated for the study of equilibrium chemical systems, MC method is also applied to studies of the dynamics of chemical reactions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:MT07072 "MC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:MT07072 "method of Monte Carlo")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07072 goldbook:R05129)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07072 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07072 "current"^^xsd:string)
Declaration(Class(goldbook:MT07073))
AnnotationAssertion(rdfs:label goldbook:MT07073 "Morse potential")
AnnotationAssertion(dcterms:description goldbook:MT07073 "The empirical function relating the potential energy of a molecule to the inter-atomic distance r accounting for the anharmonicity of bond stretching: \\[E\\left(r\\right) = D_{\\rm{e}}\\ (1- \\rm{e}^{-a\\ (r- r_{\\rm{e}})})^{2}\\] where \\(D_{\\rm{e}}\\) is the bond-dissociation energy, \\(r_{\\rm{e}}\\) is the equilibrium bond length, and \\(a\\) is a parameter characteristic of a given molecule.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07073 goldbook:BT07003)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07073 goldbook:B00699)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07073 goldbook:HT07041)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07073 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07073 "current"^^xsd:string)
Declaration(Class(goldbook:MT07074))
AnnotationAssertion(rdfs:label goldbook:MT07074 "Mulliken population analysis")
AnnotationAssertion(dcterms:description goldbook:MT07074 "A partitioning scheme based on the use of density and overlap matrixes of allocating the electrons of a molecular entity in some fractional manner among its various parts (atoms, bonds, orbitals). As with other schemes of partitioning the electron density in molecules, MPA is arbitrary and strongly dependent on the particular basis set employed. However, comparison of population analyses for a series of molecules is useful for a quantitative description of intra-molecular interactions, chemical reactivity and structural regularities.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:MT07074 "MPA")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07074 goldbook:BT06999)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07074 goldbook:E01986)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07074 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07074 "current"^^xsd:string)
Declaration(Class(goldbook:MT07075))
AnnotationAssertion(rdfs:label goldbook:MT07075 "multiconfiguration SCF method")
AnnotationAssertion(dcterms:description goldbook:MT07075 "Configuration-interaction method in which simultaneous optimization of both the shapes of molecular orbitals and contributions from different electronic configurations is carried out by using the variational method.")
AnnotationAssertion(rdfs:comment goldbook:MT07075 "The MCSCF method with a large enough set of configurations allows a better estimation of the non-dynamic correlation energy than the conventional CIS, CID, and CISD methods."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07075 goldbook:C01349)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07075 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07075 "current"^^xsd:string)
Declaration(Class(goldbook:MT07140))
AnnotationAssertion(rdfs:label goldbook:MT07140 "main-chain scission")
AnnotationAssertion(dcterms:description goldbook:MT07140 "Chemical reaction that results in the breaking of main-chain bonds of a polymer molecule.")
AnnotationAssertion(rdfs:comment goldbook:MT07140 "Some main-chain scissions are classified according to the mechanism of the scission process: hydrolytic, mechano-chemical, thermal, photo-chemical, or oxidative scission. Others are classified according to their location in the backbone relative to a specific structural feature, for example, α-scission (a scission of the C–C bond alpha to the carbon atom of a photo-excited carbonyl group) and β-scission (a scission of the C–C bond beta to the carbon atom bearing a radical), etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07140 goldbook:B00574)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07140 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07140 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07140 "current"^^xsd:string)
Declaration(Class(goldbook:MT07141))
AnnotationAssertion(rdfs:label goldbook:MT07141 "Mechano-chemical reaction")
AnnotationAssertion(dcterms:description goldbook:MT07141 "Chemical reaction that is induced by the direct absorption of mechanical energy.")
AnnotationAssertion(rdfs:comment goldbook:MT07141 "Shearing, stretching, and grinding are typical methods for the mechano-chemical generation of reactive sites, usually macroradicals, in polymer chains that undergo mechano-chemical reactions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07141 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07141 "current"^^xsd:string)
Declaration(Class(goldbook:MT07177))
AnnotationAssertion(rdfs:label goldbook:MT07177 "macroporous polymer")
AnnotationAssertion(dcterms:description goldbook:MT07177 "Glass or rubbery polymer that includes a large number of macropores (\\(50\\ \\rm{nm}\\)–\\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter) that persist when the polymer is immersed in solvents or in the dry state.")
AnnotationAssertion(rdfs:comment goldbook:MT07177 "Macroporous polymers are often network polymers produced in bead form. However, linear polymers can also be prepared in the form of macroporous polymer beads."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07177 "Macroporous polymers swell only slightly in solvents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07177 "Macroporous polymers are used, for example, as precursors for ion-exchange polymers, as adsorbents, as supports for catalysts or reagents, and as stationary phases in size-exclusion chromatography columns."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07177 "Porous polymers with pore diameters from ca \\(2\\) to \\(50\\ \\rm{nm}\\) are called mesoporous polymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07177 goldbook:E02261)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07177 goldbook:NT07562)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07177 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07177 "current"^^xsd:string)
Declaration(Class(goldbook:MT07230))
AnnotationAssertion(rdfs:label goldbook:MT07230 "miscibility")
AnnotationAssertion(dcterms:description goldbook:MT07230 "Capability of a mixture to form a single phase over certain ranges of temperature, pressure, and composition.")
AnnotationAssertion(rdfs:comment goldbook:MT07230 "Whether or not a single phase exists depends on the chemical structure, molar-mass distribution, and molecular architecture of the components present."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07230 "The single phase in a mixture may be confirmed by light scattering, X&#8209;ray scattering, and neutron scattering."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07230 "For a two-component mixture, a necessary and sufficient condition for stable or metastable equilibrium of a homogeneous single phase is \\[\\left ( \\frac{\\delta^{2}\\Delta _{\\rm{mix}}G} {\\delta\\phi ^{2}} \\right)_{T,p} > 0,\\] where \\(\\Delta _{\\rm{mix}}G\\) is the Gibbs energy of mixing and \\(\\phi\\) the composition, where \\(\\phi\\) is usually taken as the volume fraction of one of the components. The system is unstable if the above second derivative is negative. The borderline (spinodal) between metastable and unstable states is defined by the above second derivative equalling zero. If the compositions of two conjugate (coexisting) phases become identical upon a change of temperature or pressure, the third derivative also equals zero (defining a critical state)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07230 "If a mixture is thermodynamically metastable, it will demix if suitably nucleated. If a mixture is thermodynamically unstable, it will demix by spinodal decomposition or by nucleation and growth if suitably nucleated, provided there is minimal kinetic hindrance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:L03525)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:M03872)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:N04116)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:N04244)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:S05487)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:ST07274)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:S05869)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:S05900)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:U06569)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07230 goldbook:V06643)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07230 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07230 "current"^^xsd:string)
Declaration(Class(goldbook:MT07270))
AnnotationAssertion(rdfs:label goldbook:MT07270 "miscibility gap")
AnnotationAssertion(dcterms:description goldbook:MT07270 "Area within the coexistence curve of an isobaric phase diagram (temperature vs composition) or an isothermal phase diagram (pressure vs composition).")
AnnotationAssertion(rdfs:comment goldbook:MT07270 "A miscibility gap is observed at temperatures below an upper critical solution temperature (UCST) or above the lower critical solution temperature (LCST). Its location depends on pressure. In the miscibility gap, there are at least two phases coexisting."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07270 goldbook:C01401)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07270 goldbook:MT07230)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07270 goldbook:UT07280)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07270 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07270 "current"^^xsd:string)
Declaration(Class(goldbook:MT07284))
AnnotationAssertion(rdfs:label goldbook:MT07284 "morphology coarsening")
AnnotationAssertion(dcterms:description goldbook:MT07284 "Process by which phase domains increase in size during the aging of a multiphase material.")
AnnotationAssertion(rdfs:comment goldbook:MT07284 "In the coarsening at the late stage of phase separation, volumes and compositions of phase domains are conserved."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07284 "Representative mechanisms for coarsening at the late stage of phase separation are: (1) material flow in domains driven by interfacial tension (observed in a co-continuous morphology), (2) the growth of domain size by evaporation from smaller droplets and condensation into larger droplets, and (3) coalescence (fusion) of more than two droplets. The mechanisms are usually called (1) Siggia s mechanism, (2) Ostwald ripening (or the Lifshitz–Slyozov mechanism), and (3) coalescence."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07284 "Morphology coarsening can be substantially stopped by, for example, vitrification, crosslinking, and pinning, the slowing down of molecular diffusion across domain interfaces."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07284 goldbook:MT07285)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07284 goldbook:O04348)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07284 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07284 goldbook:D01716)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07284 goldbook:E02227)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07284 goldbook:I03088)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07284 goldbook:P04534)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07284 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07284 "current"^^xsd:string)
Declaration(Class(goldbook:MT07285))
AnnotationAssertion(rdfs:label goldbook:MT07285 "morphology")
AnnotationAssertion(dcterms:description goldbook:MT07285 "Shape, optical appearance, or form of phase domains in substances, such as high polymers, polymer blends, composites, and crystals.")
AnnotationAssertion(rdfs:comment goldbook:MT07285 "For a polymer blend or composite, the morphology describes the structures and shapes observed, often by microscopy or scattering techniques, of the different phase domains present within the mixture."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07285 goldbook:CT07545)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07285 goldbook:P04736)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07285 goldbook:S05487)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07285 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07285 "current"^^xsd:string)
Declaration(Class(goldbook:MT07287))
AnnotationAssertion(rdfs:label goldbook:MT07287 "multiphase copolymer")
AnnotationAssertion(dcterms:description goldbook:MT07287 "Copolymer comprising phase-separated microdomains.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07287 goldbook:C01335)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07287 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07287 "current"^^xsd:string)
Declaration(Class(goldbook:MT07303))
AnnotationAssertion(rdfs:label goldbook:MT07303 "microdomain morphology")
AnnotationAssertion(dcterms:description goldbook:MT07303 "Morphology consisting of phase microdomains.")
AnnotationAssertion(rdfs:comment goldbook:MT07303 "Microdomain morphologies are usually observed in block, graft, and segmented copolymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07303 "The type of morphology observed depends upon the relative abundance of the different types of structural units and the conditions for the generation of the morphology. The most commonly observed morphologies are spheres, cylinders, and lamellae."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07303 goldbook:MT07285)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07303 goldbook:B00682)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07303 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07303 "current"^^xsd:string)
Declaration(Class(goldbook:MT07307))
AnnotationAssertion(rdfs:label goldbook:MT07307 "multicoat morphology")
AnnotationAssertion(dcterms:description goldbook:MT07307 "Morphology observed in a blend of a block copolymer with the homopolymer of one of the blocks and characterized by alternating concentric shells of the copolymer and the homopolymer.")
AnnotationAssertion(rdfs:comment goldbook:MT07307 "The morphology is identical to onion morphology within a matrix of homopolymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07307 goldbook:MT07285)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07307 goldbook:B00683)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07307 goldbook:C01335)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07307 goldbook:H02854)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07307 goldbook:OT07305)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07307 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07307 "current"^^xsd:string)
Declaration(Class(goldbook:MT07309))
AnnotationAssertion(rdfs:label goldbook:MT07309 "multiple inclusion morphology")
AnnotationAssertion(dcterms:description goldbook:MT07309 "Multiphase morphology in which dispersed phase domains of one polymer contain and completely encapsulate many phase domains of a second polymer that may have the same composition as the continuous phase domain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:MT07309 "salami-like morphology")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07309 goldbook:MT07285)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07309 goldbook:PT07286)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07309 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07309 "current"^^xsd:string)
Declaration(Class(goldbook:MT07419))
AnnotationAssertion(rdfs:label goldbook:MT07419 "magic angle")
AnnotationAssertion(dcterms:description goldbook:MT07419 "Upon excitation of an 'isotropic' sample (assuming an ultra short excitation pulse) the relationship between the fluorescence intensity detected at a time \\(t\\) and through a polarization analyser oriented at an angle \\(\\beta\\) with respect to the electric polarization of the exciting beam is given by \\[I(t,\\beta ) \\propto  N(t)\\left [ 1 + (3\\, \\rm{cos}^{2}\\, \\beta - 1)R(t) \\right ]\\] where \\(R(t)\\) is the degree of alignment of the emitting transition dipole in the laboratory frame and \\(N(t)\\) is the excited-state population, both at time \\(t\\). For \\(\\beta = 54.7^{\\,\\unicode{x26ac}}\\) (the magic angle), the dipole-alignment contribution vanishes and \\(I(t,\\,\\beta = 54.7^{\\,\\unicode{x26ac}} ) \\propto N(t)\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:MT07419 "NMR")
AnnotationAssertion(rdfs:comment goldbook:MT07419 "This concept also applies for time-resolved absorption measurements in cases in which photoselection occurs because the detected species do not freely rotate fast enough to make the measurement isotropic within the time of the experiment."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07419 "Applies for steady-state measurements on fixed samples. In this case \\[I(\\beta ) \\propto  N\\left [ 1 + (3\\, \\rm{cos}^{2}\\, \\beta - 1)R \\right ]\\] with \\(I(\\beta)\\) the intensity of the effect observed at an analyser angle \\(\\beta\\) with respect to the electric polarization of the exciting beam, \\(N\\) the excited-state population at steady-state equilibrium, and \\(R\\) the degree of alignment of the transition moment of the excited molecular entity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07419 "The term magic angle is also used in NMR spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07419 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07419 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07419 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07419 goldbook:PT07461)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07419 goldbook:P04712)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07419 goldbook:S05848)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07419 goldbook:T06460)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07419 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07419 "current"^^xsd:string)
Declaration(Class(goldbook:MT07422))
AnnotationAssertion(rdfs:label goldbook:MT07422 "molecular orientation")
AnnotationAssertion(dcterms:description goldbook:MT07422 "Absorption probability (referred to electric dipolar absorption) for a molecular transition with its electric transition moment at an angle \\(\\theta\\) with the electric vector of the light is proportional to \\(\\cos^{2}\\theta\\). For the whole sample it is proportional to the orientation factor \\(K_{\\theta} = \\:< \\cos^{2}\\theta >\\), averaged over all sample molecules. This average is \\(1\\) for a sample with all transition moments perfectly aligned along the electric vector of the light, \\(1/3\\) for an isotropic sample and \\(0\\) for a sample where all transition moments are perpendicular to the electric vector.")
AnnotationAssertion(rdfs:comment goldbook:MT07422 "The directional cosines provide, especially for uniaxial samples, a simple description of exactly those orientation properties of the sample that are relevant for light absorption. With the principal coordinate system (\\(x\\), \\(y\\), \\(z\\)), forming angles \\(\\theta = \\alpha,\\:\\beta,\\:\\gamma\\) with the light electric vector in the \\(z\\) direction, all orientation effects induced by light absorption are contained in \\(K_{\\theta\\theta} = K_{\\theta}\\). Since the sum of \\(K_{\\theta}\\) for three perpendicular molecular axes is equal to \\(1\\), only two independent parameters are required to describe the orientation effects on light absorption."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07422 "A related, commonly used description is based on diagonalized Saupe matrices: \\[S_{\\theta} = (3K_{\\theta} -1)/2\\] The principal (molecular) coordinate system (\\(x\\), \\(y\\), \\(z\\)) forming angles \\(\\theta = \\alpha,\\:\\beta,\\:\\gamma\\) with the light electric vector should be chosen such that the matrix \\(K\\) and the tensor \\(S_{\\theta}\\) are diagonal.To describe processes involving two or more photons, such as luminescence of a uniaxial, aligned sample, an expansion of the directional cosines to the fourth power is required."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:MT07422 "Order parameters (related to 'Wigner matrices') are an alternative to the directional cosine-based description of molecular alignment. Order-parameter methods also work well for non-uniaxial samples and provide a seemingly more complex, but in other ways convenient, description of molecular orientation distributions. Wigner matrices are used as a basis set for an expansion of the orientation–distribution function."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07422 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07422 goldbook:BT06999)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07422 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07422 goldbook:L03641)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07422 goldbook:P04792)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07422 goldbook:P04855)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07422 goldbook:T06460)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07422 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07422 "current"^^xsd:string)
Declaration(Class(goldbook:MT07424))
AnnotationAssertion(rdfs:label goldbook:MT07424 "multireference configuration interaction")
AnnotationAssertion(dcterms:description goldbook:MT07424 "Configuration-interaction method in which the configurations are built by excitation out of a wavefunction obtained by using, e.g., the multiconfiguration SCF method.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:MT07424 "MRCI")
AnnotationAssertion(rdfs:comment goldbook:MT07424 "One of the methods to account for dynamic correlation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07424 goldbook:MT07075)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07424 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07424 "current"^^xsd:string)
Declaration(Class(goldbook:MT07533))
AnnotationAssertion(rdfs:label goldbook:MT07533 "mixed ceramic")
AnnotationAssertion(dcterms:description goldbook:MT07533 "Ceramic material consisting of co-continuous interpenetrating networks of two or more metal carbides, nitrides or oxides.")
AnnotationAssertion(rdfs:seeAlso goldbook:MT07533 goldbook:CT07540)
AnnotationAssertion(mito:isMentionedBy goldbook:MT07533 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:MT07533 "current"^^xsd:string)
Declaration(Class(goldbook:MT07559))
AnnotationAssertion(rdfs:label goldbook:MT07559 "monolith")
AnnotationAssertion(dcterms:description goldbook:MT07559 "Shaped, fabricated, intractable article with a homogeneous microstructure which does not exhibit any structural components distinguishable by optical microscopy.")
AnnotationAssertion(rdfs:comment goldbook:MT07559 "The article is usually fabricated by cold pressing or hot pressing of a polymeric material, or by using a reactive processing technique such as reaction injection moulding, crosslinking, sol-gel processing, sintering, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:MT07559 goldbook:CT07136)
