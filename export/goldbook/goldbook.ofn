AnnotationAssertion(rdfs:label goldbook:S05827 "spectral radiant intensity")
AnnotationAssertion(dcterms:description goldbook:S05827 "The radiation intensity, \\(I\\) at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-1}\\ \\rm{sr}^{-1}\\), but a commonly used unit is \\(\\rm{W nm}^{-1}\\ \\rm{sr}^{-1}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05827 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:S05827 doi:10.1351/pac199668122223)
