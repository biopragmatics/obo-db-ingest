AnnotationAssertion(obo:goldbook#hasStatus goldbook:16152 "current"^^xsd:string)
Declaration(Class(goldbook:16153))
AnnotationAssertion(rdfs:label goldbook:16153 "toxemia")
AnnotationAssertion(dcterms:description goldbook:16153 "Condition in which the blood contains toxins produced by body cells at a local source of infection or derived from the growth of microorganisms. Pregnancy-related condition characterized by high blood pressure, swelling, and fluid retention, and proteins in the urine.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16153 "blood poisoning")
AnnotationAssertion(mito:isMentionedBy goldbook:16153 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16153 "current"^^xsd:string)
Declaration(Class(goldbook:16154))
AnnotationAssertion(rdfs:label goldbook:16154 "toxic dose")
AnnotationAssertion(dcterms:description goldbook:16154 "Amount of a substance that produces intoxication without lethal outcome.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16154 "superthreshold dose")
AnnotationAssertion(mito:isMentionedBy goldbook:16154 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16154 "current"^^xsd:string)
Declaration(Class(goldbook:16155))
AnnotationAssertion(rdfs:label goldbook:16155 "toxicity test")
AnnotationAssertion(dcterms:description goldbook:16155 "Experimental study of the adverse effects of exposure of a living organism to a substance for a defined duration under defined conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:16155 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16155 "current"^^xsd:string)
Declaration(Class(goldbook:16156))
AnnotationAssertion(rdfs:label goldbook:16156 "toxicogenomics")
AnnotationAssertion(dcterms:description goldbook:16156 "Scientific subdiscipline that combines toxicology with genomics to determine how an organism’s genetic make-up influences its response to a toxic substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:16156 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16156 "current"^^xsd:string)
Declaration(Class(goldbook:16157))
