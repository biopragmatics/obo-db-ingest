AnnotationAssertion(rdfs:label goldbook:11794 "Golgi staining")
AnnotationAssertion(dcterms:description goldbook:11794 "Method of silver staining of histological sections of tissue from the nervous system, in which a limited number of neurons stain in their entirety upon formation of microcrystals of silver chromate, thus allowing visualization in the light microscope of some individual neurons in densely packed tissue.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11794 "Golgi’s method")
AnnotationAssertion(rdfs:seeAlso goldbook:11794 goldbook:11916)
AnnotationAssertion(rdfs:seeAlso goldbook:11794 goldbook:12075)
AnnotationAssertion(mito:isMentionedBy goldbook:11794 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11794 "current"^^xsd:string)
