property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15269
name: polyamine
def: "Polymer composed of macromolecules containing imino groups as linkages in the backbone\: \\\[\\ce\{-NR\\bond\{-\}\}\\\] where \\\(\\ce\{R\}\\\) is hydrogen\, alkyl\, aryl\, or heteroaryl."
comment: "A polymer containing only pendent amino groups is excluded. However, in organic chemistry, low-molecular-weight compounds containing three or more amino groups are also called polyamines."
comment: "Quaternized polyamines have iminio linkages, \(\ce{-N^{+}R^{1}R^{2}\bond{-}}\), in the backbone (\(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen, or an alkyl, aryl, or heteroaryl group) and they are a structure-based subclass of ionenes."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-08-01-30
property_value: hasStatus "current" xsd:string

