AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:T06460)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07381 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07381 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07381 "current"^^xsd:string)
Declaration(Class(goldbook:FT07382))
AnnotationAssertion(rdfs:label goldbook:FT07382 "Fourier-transform spectroscopy")
AnnotationAssertion(dcterms:description goldbook:FT07382 "Measurement technique whereby spectra are collected based on measurements of the temporal coherence of a radiative source, using time-domain measurements of the electromagnetic radiation or other type of radiation.")
AnnotationAssertion(rdfs:comment goldbook:FT07382 "This procedure can be applied to a variety of spectroscopies including optical-, @IT07399@- (FTIR), nuclear magnetic @R05326@-, and electron spin-@R05326@ @S05848@. There are several methods for measuring the temporal coherence of the light, including the CW Michelson or @F02493@ and the pulsed Fourier-transform @S05836@ (which is more sensitive and has a much shorter sampling time than conventional spectroscopic techniques)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07382 goldbook:F02493)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07382 goldbook:IT07399)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07382 goldbook:R05326)
