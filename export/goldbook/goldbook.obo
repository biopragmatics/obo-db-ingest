[Term]
id: goldbook:13009
name: chronic rejection
def: "Immunologically triggered reaction occurring in a transplanted organ or tissue\, leading to progressive destruction and finally failure of the transplanted organ occurring two months to many years after transplantation."
comment: "In contrast, hyperacute rejection caused by preformed antibodies starts within minutes after organ transplantation, and acute rejection occurs within 2 to 60 days."
synonym: "chronic graft rejection" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-11-06-03
property_value: hasStatus "current" xsd:string
