AnnotationAssertion(obo:goldbook#hasStatus goldbook:13038 "current"^^xsd:string)
Declaration(Class(goldbook:13039))
AnnotationAssertion(rdfs:label goldbook:13039 "constant region")
AnnotationAssertion(dcterms:description goldbook:13039 "Part of an immunoglobulin (Ig) or T-cell receptor (TCR) that is relatively constant in amino acid sequence among different Ig or TCR molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13039 "C region")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13039 "constant (C) region")
AnnotationAssertion(rdfs:comment goldbook:13039 "In an antibody molecule the constant regions of each chain are composed of up to four C domains. The constant region of an antibody determines its general type of interaction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13039 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13039 goldbook:13773)
AnnotationAssertion(mito:isMentionedBy goldbook:13039 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13039 "current"^^xsd:string)
Declaration(Class(goldbook:13040))
AnnotationAssertion(rdfs:label goldbook:13040 "contact allergen")
AnnotationAssertion(dcterms:description goldbook:13040 "Substance that causes a skin hypersensitivity reaction by direct contact.")
AnnotationAssertion(rdfs:seeAlso goldbook:13040 goldbook:13241)
AnnotationAssertion(mito:isMentionedBy goldbook:13040 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13040 "current"^^xsd:string)
