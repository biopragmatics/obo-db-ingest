Declaration(Class(goldbook:GT07389))
AnnotationAssertion(rdfs:label goldbook:GT07389 "global analysis")
AnnotationAssertion(dcterms:description goldbook:GT07389 "Method for kinetic analysis of time-resolved emission or absorption data.")
AnnotationAssertion(rdfs:comment goldbook:GT07389 "Typical for the analysis of emission (or transient absorption) data. Upon excitation with a particular wavelength, radiant intensity of the emission (or transient absorbance difference) decays are observed as a function of a variable parameter, e.g., the observation wavelength, but otherwise under the same condition. All decays are then analysed together (globally) under the constraint that the lifetimes of the transient species do not vary with the variable parameter, e.g., the observation wavelength in the given example. Lifetime-associated spectra (LAS), also called decay-associated spectra (DAS), are thus obtained. In the case of transient absorption data, the resulting spectra are often called lifetime-associated difference spectra (LADS)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07389 goldbook:A00028)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07389 goldbook:A00036)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07389 goldbook:E02056)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07389 goldbook:L03515)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07389 goldbook:R05045)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07389 goldbook:V06600)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07389 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:GT07389 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:GT07389 "current"^^xsd:string)
Declaration(Class(goldbook:GT07535))
AnnotationAssertion(rdfs:label goldbook:GT07535 "gel point")
AnnotationAssertion(dcterms:description goldbook:GT07535 "Point of incipient network formation in a process forming a chemical or physical polymer network.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:GT07535 "gelation point")
AnnotationAssertion(rdfs:comment goldbook:GT07535 "In both network-forming polymerization and the crosslinking of polymer chains, the gel point is expressed as an extent of chemical reaction (c.f., gel time)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:GT07535 "At the gel point a solid (network) material spanning the entire system is formed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:GT07535 "The gel point is often detected using rheological methods. Different methods can give different gel points because viscosity is tending to infinity at the gel point and a unique value cannot be measured directly."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:GT07551)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:GT07536)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:P04742)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:GT07535 goldbook:V06627)
AnnotationAssertion(mito:isMentionedBy goldbook:GT07535 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:GT07535 "current"^^xsd:string)
Declaration(Class(goldbook:GT07536))
AnnotationAssertion(rdfs:label goldbook:GT07536 "gel time")
AnnotationAssertion(dcterms:description goldbook:GT07536 "Time interval from the start of a network-forming process to the gel point.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:GT07536 "gelation time")
