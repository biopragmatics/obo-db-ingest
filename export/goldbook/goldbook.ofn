Declaration(Class(goldbook:L03653))
AnnotationAssertion(rdfs:label goldbook:L03653 "lyate ion")
AnnotationAssertion(dcterms:description goldbook:L03653 "The anion produced by hydron removal from a solvent molecule. For example, the hydroxide ion is the lyate ion of water.")
AnnotationAssertion(rdfs:seeAlso goldbook:L03653 goldbook:A00358)
AnnotationAssertion(rdfs:seeAlso goldbook:L03653 goldbook:H02904)
