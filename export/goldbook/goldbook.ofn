AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10322 "miscarriage")
Declaration(Class(goldbook:10323))
AnnotationAssertion(rdfs:label goldbook:10323 "accessory rib")
AnnotationAssertion(dcterms:description goldbook:10323 "Rib arising from a cervical vertebra (cervical rib), or supernumerary rib arising from a thoracic or lumbar vertebra.")
Declaration(Class(goldbook:10324))
AnnotationAssertion(rdfs:label goldbook:10324 "accessory sex gland")
