AnnotationAssertion(dcterms:description goldbook:11839 "Neuromuscular disease resulting from a genetic defect in an ion channel.")
AnnotationAssertion(rdfs:comment goldbook:11839 "Documented ion channelopathies include those arising from mutations in channels for \\(\\ce{Na+}\\), \\(\\ce{K+}\\), \\(\\ce{Cl-}\\), and \\(\\ce{Ca^{2+}}\\)."^^xsd:string)
