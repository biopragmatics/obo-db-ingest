Declaration(Class(goldbook:O04381))
AnnotationAssertion(rdfs:label goldbook:O04381 "oxygen-flask combustion")
AnnotationAssertion(dcterms:description goldbook:O04381 "In order to determine elements which are easily volatilized, or are present as volatile species, organic material may be ashed in oxygen in a closed oxygen combustion system. One such method is oxygen-flask combustion by which the test sample is burned in a closed flask containing oxygen and an absorbing solution in which the analytes are subsequently determined.")
AnnotationAssertion(rdfs:seeAlso goldbook:O04381 goldbook:T06285)
AnnotationAssertion(mito:isMentionedBy goldbook:O04381 doi:10.1351/pac198860091461)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04381 "current"^^xsd:string)
