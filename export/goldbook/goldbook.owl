    <!-- http://dx.doi.org/10.1351/goldbook.11149 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11149">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism possessing either male (testes) or female (ovaries) gonads, but with ambiguous external genitalia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pseudohermaphrodite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10698"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10794"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11150 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11150">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development of signs of pregnancy in the absence of an embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>false pregnancy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pseudocyesis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This is commonly called pseudocyesis in humans and pseudopregnancy in other mammals.</rdfs:comment>
        <rdfs:label>pseudopregnancy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11151 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11151">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delayed development of both cognitive and motor function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>psychomotor retardation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11152 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11152">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which an individual undergoes sexual development, including the onset of gametogenesis, changes in hormonal secretions, secondary sexual characteristics, and reproductive competence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>puberty</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11198"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11153 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11153">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Being in the early stage of puberty.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pubescent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11152"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11154 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11154">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to the region of the most ventral bone of the pelvis (the pubic bone), and thus the region around the genital area, normally showing hair growth (pubic hair) in the adult.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pubic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11155 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11155">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cartilaginous joint between the pubic bones forming the front of the pelvis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pubic symphysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11154"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11156 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11156">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pulmonary</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11157 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11157">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large vessel that transports blood from the heart to the lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pulmonary artery</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11158 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11158">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which the flow of blood from the heart to the lungs is slowed by a deformity on or near the pulmonary valve that controls the blood flow from the right heart to the lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pulmonary valve stenosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11156"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11159 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11159">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>(n) Young or newborn dog, rat or seal. (v) Give birth to a pup.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pup</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11160 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11160">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrowing of the sphincter (the pylorus) between the stomach and duodenum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pyloric stenosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11247"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11161 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11161">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Initial awareness of fetal movement by the pregnant mother, usually occurring early in the second trimester.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>quickening</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11318"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11162 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11162">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of the neural tube to close in utero, resulting in a birth defect that leaves a fissure in the vertebral column with part of the spinal cord exposed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>rachischisis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10862"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11163 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11163">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor that encounters its ligand in the cytosol and translocates to the nucleus, where it binds DNA and acts as a factor regulating gene transcription.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>nuclear receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11164 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11164">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In genetics, relating to or denoting heritable characteristics controlled by genes which are expressed in offspring only when inherited from both parents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>recessive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10614"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11165 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11165">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in tissue or organ development in which epithelium induces changes in the mesenchyme and the mesenchyme also induces changes in the epithelium, through paracrine signaling.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>An example occurs during development of the prostate, in which mesenchyme of the urogenital sinus influences differentiation and patterning of the prostatic epithelium, and the developing epithelium induces prostatic mesenchymal cells to differentiate into smooth muscle and other prostatic stromal cells.</rdfs:comment>
        <rdfs:label>reciprocal mesenchymal-epithelial interaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10675"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10941"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11145"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11264"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11345"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11166 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11166">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chromosomal translocation in which crossing over between two non-homologous chromosomes leads to each carrying genetic material from the other.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>If the exchange is equal (i.e., no genetic material is missing) it is called a balanced translocation, and may be without severe consequences for the developing embryo. If extra or missing genetic material results from the process, it is called an unbalanced translocation, and the consequences are often more harmful.</rdfs:comment>
        <rdfs:label>reciprocal translocation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11313"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11167 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11167">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to new gene sequences, and thus to new heritable information, caused by gene crossovers, occurring naturally in either meiosis or mitosis, or constructed artificially for the purpose of introducing a new trait into an organism or cell line. In immunology, random scrambling of specific gene sequences to produce the vast array of possible immunoglobulin and T cell receptor sequences required to recognize, potentially, all possible antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>genetic recombination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11168 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11168">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Terminal part of the large intestine, ending at the anus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>rectum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11169 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11169">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme (EC 1.3.99.5) that converts testosterone to 5\(\upalpha\)-dihydrotestosterone in peripheral tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>alpha-reductase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>5α-reductase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11296"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11170 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11170">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition caused by a mutation of the $\ce{5\upalpha\!\mbox{-}reductase}$ type II gene, with autosomal recessive inheritance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>5α-reductase deficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10449"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11164"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11171 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11171">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the kidneys.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>renal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11172 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11172">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Progressive decline in reproductive capacity with age, marked by menopause in females.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>reproductive senescence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10935"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11173 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11173">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that interferes with reproductive function, including sexual performance, fertility, and development of the fetus and embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Effects on development may include effects on embryo viability, fetal growth, morphogenesis, functional integrity, etc.</rdfs:comment>
        <rdfs:comment>Effects on fertility may include effects on sperm count and sperm viability, oogenesis and ovulation, placental function, lactation, male erectile function, genetic intactness, etc.</rdfs:comment>
        <rdfs:comment>Reproductive toxicants may show long-term effects not detectable before the second or later generations.</rdfs:comment>
        <rdfs:label>reproductive toxicant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10600"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11043"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11370"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11174 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11174">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure based on specific guidelines in which adverse effects of a substance on reproduction and development are studied either in animals or by use of in vitro assays.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>reproductive toxicity test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11175 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11175">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Removal of mineralized tissue by natural processes, as in the breakdown of bone by osteoclasts or the disappearance of a tooth.  Disintegration and assimilation of an embryo or fetus through a natural process involving lysis and removal of all the products of conception by cells of the maternal immune system.  In multigestational pregnancies, death of one fetus followed by absorption of its tissue by another, sometimes referred to as a &apos;vanishing twin&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>resorption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10764"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11176 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11176">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Short DNA nucleotide sequence that is recognized by a sequence-specific enzyme (restriction enzyme) that cleaves the double stranded DNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>restriction site</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11177 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11177">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fibrous mesh or network.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>rete</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11178 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11178">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rete in the testis that carries sperm from the seminiferous tubules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>rete testis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11177"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11204"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11179 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11179">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multicell-layer membrane in the back of the eye that is sensitive to light and transduces incoming optical information into signals that are necessary for vision.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>retina</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11180 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11180">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acidic metabolite of vitamin A.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>(2E,4E,6E,8E)-3,7-dimethyl-9-(2,6,6-trimethylcyclohex-1-en-1-yl)nona-2,4,6,8-tetraenoic acid</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Retinoic acid binds to the retinoic acid receptor (RAR), which then acts as a transcription factor.</rdfs:comment>
        <rdfs:comment>The role of RAR in development (e.g., in regulating homeobox genes) accounts for the teratogenicity of related pharmaceuticals.</rdfs:comment>
        <rdfs:label>retinoic acid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10804"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11290"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11311"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11181 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11181">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Noninflammatory degenerative disease of the retina.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Retinopathy of prematurity (see premature birth) is a risk for preterm infants, possibly induced by oxygen therapy and related to disorganized retinal blood vessels.</rdfs:comment>
        <rdfs:label>retinopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11118"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11179"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11182 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11182">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital splitting of the retina into two layers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>X-linked retinoschisis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>juvenile retinoschisis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>congenital retinoschisis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11183 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11183">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outside of and posterior to the peritoneum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>retroperitoneal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11082"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11184 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11184">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to elucidating the function of a gene by studying the effects on phenotype of expressed variations in a known DNA sequence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The term is intended to indicate the reverse of the approach (starting from a phenotype and working back to identify the gene) of forward genetics.</rdfs:comment>
        <rdfs:label>reverse genetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10738"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11185 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11185">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that occurs on the red blood cells of about 85 per cent of humans and can cause hemolytic disease of the newborn (erythroblastosis fetalis) and hemolytic transfusion reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Rh</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Rh factor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The Rh factor was first identified in the blood of a rhesus monkey.</rdfs:comment>
        <rdfs:label>rhesus factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10792"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11185"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Rh</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11186 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11186">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Posterior portion of the brain that includes the cerebellum, pons, and medulla.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hindbrain</oboInOwl:hasRelatedSynonym>
        <rdfs:label>rhombencephalon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11187 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11187">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Effect of small, often double-stranded RNA targeting a specific messenger RNA (mRNA), blocking its translation, and thereby silencing expression of the corresponding gene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>RNAi</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>As an experimental technique, RNAi uses designed sequences to silence a gene of interest.</rdfs:comment>
        <rdfs:comment>Cells produce two types of small RNA, microRNA (miRNA) and small interfering RNA (siRNA), that are both involved in the regulation of gene expression.</rdfs:comment>
        <rdfs:comment>Short hairpin RNAs (shRNA) are sequences, designed for improved effect in RNAi experiments, that have a base-paired stem representing the double-stranded portion and an intervening unpaired loop.</rdfs:comment>
        <rdfs:label>RNA interference</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11187"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RNAi</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11188 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11188">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chromosomal translocation in which chromosomes with acrocentric centromeres break the centromere to fuse the long arms into a new large chromosome and the short arms into another small one that may be lost, leaving a karyotype in the human of \(\pu{45}\) chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Robertsonian translocation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10503"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10872"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11313"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11189 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11189">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to, resembling, or having a rostrum or beak. Situated toward the beak (thus, oral and nasal region), which may mean superior (in relationships of areas of the spinal cord) or anterior or ventral (in relationships of brain areas). Closer to the head.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>rostral</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11190 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11190">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Smallest and weakest animal of a litter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>A runt may be disadvantaged in competing with its siblings for resources and its mother’s attention.</rdfs:comment>
        <rdfs:label>runt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10897"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11191 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11191">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence or significant underdevelopment of the lower part of the spine and the lower limbs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>caudal regression syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Sacral agenesis is associated with maternal diabetes.</rdfs:comment>
        <rdfs:label>sacral agenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11192 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11192">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vertical (longitudinal) plane dividing the body into right and left sections.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sagittal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11193 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11193">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surgical removal of the Fallopian tubes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>salpingectomy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11194 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11194">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mutagenesis screening in which a large number of mutations are introduced in a target area of the genome with the aim of identifying all the genes or their functions that are associated with that area.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>saturation mutagenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11195 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11195">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Elongated and narrow head with decrease of the parietal regions and conspicuous frontal and occipital protrusions; a type of craniosynostosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Scaphocephaly is a result of the premature closure of the sagittal suture and is usually accompanied by mental retardation.</rdfs:comment>
        <rdfs:label>scaphocephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10568"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11027"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11196 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11196">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal lateral and rotational curvature of the vertebral spinal column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>scoliosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11249"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11197 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11197">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pouch of skin containing the testicles and their accessory tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>scrotum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11198 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11198">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Feature of the adult animal, appearing during puberty in humans and distinct between the sexes, although not part of the reproductive system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Examples include enlargement of the female breasts and sex-specific patterns of body hair, such as facial hair in the male and the male or female pubic escutcheon.</rdfs:comment>
        <rdfs:label>secondary sexual characteristic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11152"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11154"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11199 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11199">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sudden change in neural activity, leading to convulsions and (or) changes in consciousness of varying degrees of severity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>seizure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10558"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10670"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11200 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11200">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a group of genes that codes factors driving differentiation and regional patterning during development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>selector gene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11201 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11201">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Depression on the upper surface of the sphenoid bone, accommodating the pituitary gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sella turcica</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11246"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11202 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11202">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fluid, containing spermatozoa, that is expelled from the penis during ejaculation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ejaculate (&lt;em&gt;n.&lt;/em&gt;)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>seminal fluid</oboInOwl:hasRelatedSynonym>
        <rdfs:label>semen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10641"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11203 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11203">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a pair of glands of the male reproductive system that together produce a significant portion of the semen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Seminal vesicle secretion does not contain spermatozoa, but provides nutrients and an alkaline environment that prolongs their survival.</rdfs:comment>
        <rdfs:label>seminal vesicle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11202"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11204 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11204">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of numerous coiled tubes, found in the testis, in the walls of which spermatogenesis occurs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>seminiferous tubule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11240"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11205 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11205">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model organism containing a mutation in a pathway (e.g., metabolic or signal transducing) that does not itself cause a change in phenotype, but makes the organism more sensitive to another change elsewhere in the pathway.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sensitized strain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11206 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11206">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In anatomy, thin wall dividing two cavities or masses of softer tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>septum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11207 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11207">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Containing, resembling, or secreting serum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>serous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11208 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11208">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Somatic cell in the seminiferous tubule that supports spermatogenesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Tight junctions between Sertoli cells contribute to the blood-testis barrier.</rdfs:comment>
        <rdfs:label>Sertoli cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10466"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11204"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11226"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11240"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11209 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11209">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ovarian tumor composed of both Sertoli and Leydig cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>arrhenoblastoma</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The tumor may secrete androgens, thus causing masculinization.</rdfs:comment>
        <rdfs:label>Sertoli–Leydig cell tumor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11210 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11210">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condensed mass of one inactivated X chromosome seen inside the nuclear membrane of an interphase cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Barr body</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The Barr body is not seen in normal male cells (XY), but one body may be seen in normal female cells (XX). In chromosomal abnormalities, the number seen is one less than the number of X chromosomes.</rdfs:comment>
        <rdfs:label>sex chromatin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10524"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10906"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11385"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11211 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11211">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the pair of chromosomes determining sex; in humans designated an X chromosome and a Y chromosome, with females having an XX genotype and males an XY genotype.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sex chromosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11385"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11387"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11212 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11212">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transcription factor coded by a gene on the Y chromosome that initiates development of the male sex organs (i.e., testicular differentiation) in the embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>SRY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SRY protein</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>testis-determining factor (TDF)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sex-determining region Y protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11311"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11387"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11212"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SRY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11213 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11213">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenotypic difference between the sexes of a species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sexual dimorphism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11214 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11214">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compact area of large cells in the anterior hypothalamus, larger in men than women, and believed to influence sexual behaviour.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>SDN</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sexually dimorphic nucleus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11213"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11214"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SDN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11215 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11215">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of reaching the age or stage when an organism can reproduce sexually.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sexual maturation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11216 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11216">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Age or stage when an organism can reproduce sexually.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sexual maturity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11217 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11217">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Creation of a new organism requiring combination of the genetic material from two different sexes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sexual reproduction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11218 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11218">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of two or more individuals with a common pair of parents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>sib</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sibling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11219 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11219">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process whereby a signal arising outside the cell is converted through a series of intermediate chemical reactions inside the cell to produce a functional change in the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>signal transduction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11220 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11220">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of specialized cardiac muscle cells (&apos;pacemaker cells&apos;) that spontaneously depolarize to initiate rhythmic contraction of the heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>sinuatrial node</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sinoatrial node</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10489"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11221 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11221">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hollow or cavity. Channel for the passage of fluid, lacking the usual lining of a blood or lymphatic vessel; especially a dilatation for the passage of venous blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sinus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10904"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11222 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11222">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cavity at the caudal end of the developing embryonic heart where intra- and extra-embryonic veins meet.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>venous sinus</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The sinus venosus develops into the portion of the right atrium in the adult heart that receives blood from the vena cava.</rdfs:comment>
        <rdfs:label>sinus venosus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10441"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11362"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11223 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11223">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reciprocal exchange of chromatin between two replicated chromosomes that remain attached to each other until anaphase of mitosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>SCE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>SCE is used as a measure of mutagenicity of substances that produce this effect.</rdfs:comment>
        <rdfs:label>sister chromatid exchange</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10377"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11223"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SCE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11224 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11224">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Developmental anomaly in which major visceral organs are found in a mirrored position to their normal location.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>situs inversus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10601"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11225 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11225">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Short interfering RNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>siRNA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>siRNA molecule</oboInOwl:hasRelatedSynonym>
        <rdfs:label>small interfering RNA molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11187"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11225"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>siRNA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11226 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11226">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the body or describing cells that form the body other than germ line cells or undifferentiated stem cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>somatic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11227 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11227">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Programmed process of mutation affecting the variable (V) regions of immunoglobulin (Ig) genes. SHM affects only individual immune cells, and the mutations are not transmitted to offspring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>SHM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mutation (in immunology)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mistargeted SMH is a likely mechanism in the development of B-cell lymphoma.</rdfs:comment>
        <rdfs:comment>This process is part of the way the immune system adapts to new antigens.</rdfs:comment>
        <rdfs:label>somatic hypermutation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11227"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SHM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11228 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11228">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Placental hormone that affects maternal metabolism and supports fetal growth by making more glucose and fatty acids available to the fetus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>human placental lactogen (hPL)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>human chorionic somatomammotropin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11229 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11229">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of peptide growth factors produced by the liver following stimulation by somatotropin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Somatomedin acts directly on cartilage cells to stimulate skeletal growth.</rdfs:comment>
        <rdfs:label>somatomedin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11230"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11230 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11230">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hormone produced in the pituitary gland that stimulates the liver to produce somatomedin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>growth hormone</oboInOwl:hasRelatedSynonym>
        <rdfs:label>somatotropin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11229"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11231 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11231">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of bilaterally paired, segmented masses of mesodermal tissue lying along the notochord that gives rise to the vertebrae and associated muscle and connective tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>somite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11021"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11232 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11232">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein morphogen produced in the notochord that plays a critical role in early development, including vertebrate organogenesis, brain development and limb formation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Production in the embryo is dependent upon secretion of fibroblast growth factors.</rdfs:comment>
        <rdfs:label>sonic hedgehog</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10469"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10720"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10972"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11021"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11048"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11233 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11233">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>(v) Release gametes. (Of mature adult fish, frogs, molluscs, crustacea, etc.). (n) Fertilized eggs of mature adult fish, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spawn</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11234 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11234">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>(n) Release of gametes (eggs or sperm) from mature adult fish, frogs, molluscs, crustacea, etc. (adj) Describing behavior related to the readiness of mature adult fish, etc. to release gametes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spawning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11235 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11235">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of cells in the amphibian embryo that is important in orientation of surrounding cells and facilitates development of the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Cells on the ventral side of the Xenopus blastula secrete factors such as bone morphogenetic protein-4 (BMP-4) to signal the overlying ectoderm to become skin. The Spemann organizer blocks the action of BMP-4 by secreting chordin and noggin, allowing the ectoderm to develop into the brain and spinal cord by default.</rdfs:comment>
        <rdfs:label>Spemann organizer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10469"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10501"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10514"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11236 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11236">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Storage of frozen donor sperm for use in artificial insemination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sperm banking</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11237 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11237">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Haploid cell in the late stage of developing into a spermatozoon, derived from the secondary spermatocyte.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spermatid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11238 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11238">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that kills spermatozoa.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>spermicide</oboInOwl:hasRelatedSynonym>
        <rdfs:label>spermatocide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11239 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11239">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parent cell of a spermatid, derived by mitotic division from a spermatogonium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The primary spermatocyte gives rise to a pair of haploid secondary spermatocytes by meiosis.</rdfs:comment>
        <rdfs:label>spermatocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11237"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11242"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11240 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11240">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Entire process by which spermatogonial stem cells divide and differentiate into spermatozoa.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spermatogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11242"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11241 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11241">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which rodents are exposed to a test substance and chromosome aberrations are then studied microscopically in germ cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spermatogonial chromosome aberration test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11242 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11242">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Primitive cell derived from mitosis of the germ cell that becomes the diploid primary spermatocyte.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>spermatogonium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10608"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10762"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11243 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11243">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mature male gamete.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>sperm</oboInOwl:hasRelatedSynonym>
