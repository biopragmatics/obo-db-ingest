Declaration(Class(goldbook:10628))
AnnotationAssertion(rdfs:label goldbook:10628 "early life stage test")
AnnotationAssertion(dcterms:description goldbook:10628 "Toxicity test using an organism in an early life stage such as the embryo or larva, noting that this stage is often the most sensitive part of the species life cycle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10628 "ELS test")
Declaration(Class(goldbook:10629))
AnnotationAssertion(rdfs:label goldbook:10629 "earthworm reproduction test")
AnnotationAssertion(dcterms:description goldbook:10629 "Procedure in which adult worms (Eisenia sp.) are exposed to a test substance mixed into the soil; number, weight and behaviour of the adult worms are studied after four weeks and the number of juveniles hatched is counted after a further four weeks.")
Declaration(Class(goldbook:10630))
AnnotationAssertion(rdfs:label goldbook:10630 "eclampsia")
AnnotationAssertion(dcterms:description goldbook:10630 "Acute, life-threatening complication of pregnancy characterized by tonic-clonic seizures (convulsions), usually in a woman who has developed pre-eclampsia.")
Declaration(Class(goldbook:10631))
AnnotationAssertion(rdfs:label goldbook:10631 "ecogenetics")
AnnotationAssertion(dcterms:description goldbook:10631 "Study of the influence of hereditary factors on the response of individuals or populations to environmental factors.")
Declaration(Class(goldbook:10632))
AnnotationAssertion(rdfs:label goldbook:10632 "ectoderm")
AnnotationAssertion(dcterms:description goldbook:10632 "In an embryo, outermost layer that develops into the epidermis of the skin and the nervous system.")
Declaration(Class(goldbook:10633))
AnnotationAssertion(rdfs:label goldbook:10633 "ectopia")
AnnotationAssertion(dcterms:description goldbook:10633 "Abnormal location or malpositioning of an organ or body part, usually congenital.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10633 "ectopy")
Declaration(Class(goldbook:10634))
AnnotationAssertion(rdfs:label goldbook:10634 "ectopic expression")
