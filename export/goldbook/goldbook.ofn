AnnotationAssertion(rdfs:label goldbook:12161 "vasospasm")
AnnotationAssertion(dcterms:description goldbook:12161 "Contraction of the muscular wall of blood vessels with sustained vasoconstriction possibly leading to tissue ischemia.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12161 "angiospasm")
AnnotationAssertion(rdfs:seeAlso goldbook:12161 goldbook:12157)
AnnotationAssertion(mito:isMentionedBy goldbook:12161 doi:10.1515/pac-2015-0103)
