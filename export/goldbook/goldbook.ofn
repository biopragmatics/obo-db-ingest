AnnotationAssertion(obo:goldbook#hasStatus goldbook:12097 "current"^^xsd:string)
Declaration(Class(goldbook:12098))
AnnotationAssertion(rdfs:label goldbook:12098 "stroke")
AnnotationAssertion(dcterms:description goldbook:12098 "Acute impairment of circulation to a part of the brain, lasting more than \\(\\pu{24 h}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:12098 goldbook:11647)
AnnotationAssertion(mito:isMentionedBy goldbook:12098 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12098 "current"^^xsd:string)
Declaration(Class(goldbook:12099))
AnnotationAssertion(rdfs:label goldbook:12099 "stupor")
AnnotationAssertion(dcterms:description goldbook:12099 "State of impaired consciousness showing diminution in response to environmental stimulation.")
AnnotationAssertion(rdfs:seeAlso goldbook:12099 goldbook:11690)
AnnotationAssertion(mito:isMentionedBy goldbook:12099 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12099 "current"^^xsd:string)
