AnnotationAssertion(mito:isMentionedBy goldbook:R05428 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05428 "current"^^xsd:string)
Declaration(Class(goldbook:R05429))
AnnotationAssertion(rdfs:label goldbook:R05429 "Rutherford backscattering")
AnnotationAssertion(dcterms:description goldbook:R05429 "Any technique using high energy particles directed toward a sample, in which the bombarding particles are detected and recorded as function of energy and/or angle. The technique is mostly used for determining depth distributions of elements based on the energy of the backscattered particle. In general, $\\ce{He^{+}}$ or $\\ce{H^{+}}$ particles are used at energies in the order of \\(100\\ \\rm{keV}\\) to some \\(\\mathrm{MeV}\\). Also referred to as backscattering spectrometry (BSS).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:R05429 "RBS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:R05429 "backscattering spectroscopy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:R05429 "backscattering spectrometry (BSS)")
AnnotationAssertion(rdfs:seeAlso goldbook:R05429 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:R05429 goldbook:S05848)
AnnotationAssertion(mito:isMentionedBy goldbook:R05429 doi:10.1351/pac197951112243)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05429 "current"^^xsd:string)
Declaration(Class(goldbook:R05430))
AnnotationAssertion(rdfs:label goldbook:R05430 "Rydberg constant")
AnnotationAssertion(dcterms:description goldbook:R05430 "Atomic fundamental physical constant \\(R_{\\infty} = \\frac{E_{h}}{2\\ h\\ c_{0}} = 1.097\\ 373\\ 1534\\ (13)\\times 10^{7}\\ \\rm{m}^{-1}\\), where \\(E_{h}\\) is the Hartree energy, \\(h\\) the Planck constant, and \\(c_{0}\\) the speed of light.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05430 goldbook:H02748)
AnnotationAssertion(rdfs:seeAlso goldbook:R05430 goldbook:P04685)
AnnotationAssertion(mito:isMentionedBy goldbook:R05430 doi:10.6028/jres.092.010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05430 "current"^^xsd:string)
Declaration(Class(goldbook:R05431))
AnnotationAssertion(rdfs:label goldbook:R05431 "Rydberg orbital")
AnnotationAssertion(dcterms:description goldbook:R05431 "For an atom, an orbital with principal quantum number greater than that of any occupied orbital of the ground state. For a molecular entity, a molecular orbital which correlates with a Rydberg atomic orbital in an atomic fragment produced by dissociation. Typically, the extension of the Rydberg orbital is large compared to the size of the atom or molecular entity.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05431 goldbook:D01801)
AnnotationAssertion(rdfs:seeAlso goldbook:R05431 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:R05431 goldbook:M03996)
AnnotationAssertion(mito:isMentionedBy goldbook:R05431 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05431 "current"^^xsd:string)
Declaration(Class(goldbook:R05432))
AnnotationAssertion(rdfs:label goldbook:R05432 "Rydberg transition")
AnnotationAssertion(dcterms:description goldbook:R05432 "An electronic transition described approximately as promotion of an electron from a 'bonding' orbital to a Rydberg orbital. Spectral bands corresponding to Rydberg transitions approximately fit the Rydberg formula: \\[\\sigma = I - \\frac{R}{(n\\,-\\,\\mathit{\\Delta })^{2}}\\] where \\(\\sigma \\) is the wavenumber, \\(I\\) the ionization potential of the atom or molecular entity, \\(n\\) a principal quantum number, \\(R\\) the Rydberg constant, and \\(\\mathit{\\Delta}\\) the quantum defect which differentiates between s, p, d, etc., orbitals. The notation used is, e.g. \\(\\pi \\rightarrow \\mathrm{ns}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:R05432 goldbook:R05430)
AnnotationAssertion(rdfs:seeAlso goldbook:R05432 goldbook:R05431)
AnnotationAssertion(rdfs:seeAlso goldbook:R05432 goldbook:I03208)
AnnotationAssertion(rdfs:seeAlso goldbook:R05432 goldbook:P04877)
AnnotationAssertion(mito:isMentionedBy goldbook:R05432 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05432 "current"^^xsd:string)
Declaration(Class(goldbook:RT06783))
AnnotationAssertion(rdfs:label goldbook:RT06783 "redox potential")
AnnotationAssertion(dcterms:description goldbook:RT06783 "Any oxidation-reduction (redox) reaction can be divided into two half-reactions: one in which a chemical species undergoes oxidation and one in which another chemical species undergoes reduction. If a half-reaction is written as a reduction, the driving force is the reduction potential. If the half-reaction is written as oxidation, the driving force is the oxidation potential related to the reduction potential by a sign change. So the redox potential is the reduction/oxidation potential of a compound measured under standards conditions against a standard reference half-cell. In biological systems the standard redox potential is defined at pH – 7.0 versus the hydrogen electrode and partial pressure of hydrogen = 1 bar.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06783 goldbook:B00596)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06783 goldbook:E01956)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06783 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06783 goldbook:P04420)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06783 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06783 "current"^^xsd:string)
Declaration(Class(goldbook:RT06793))
AnnotationAssertion(rdfs:label goldbook:RT06793 "rubredoxin")
AnnotationAssertion(dcterms:description goldbook:RT06793 "An iron-sulfur protein without acid-labile sulfur, in which an iron centre is coordinated by four sulfur-containing ligands, usually cysteine. The function, where known, is an electron carrier.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06793 goldbook:AT06794)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06793 goldbook:C00859)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06793 goldbook:C01329)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06793 goldbook:IT06780)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06793 goldbook:L03518)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06793 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06793 "current"^^xsd:string)
Declaration(Class(goldbook:RT06807))
AnnotationAssertion(rdfs:label goldbook:RT06807 "risk")
AnnotationAssertion(dcterms:description goldbook:RT06807 "Probability of adverse effects caused under specified circumstances by an agent in an organism, a population, or an ecological system.Expected frequency of occurrence of a harmful event arising from such an exposure.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06807 goldbook:P04855)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06807 goldbook:AT06809)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06807 goldbook:ET06811)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06807 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06807 "current"^^xsd:string)
Declaration(Class(goldbook:RT06808))
AnnotationAssertion(rdfs:label goldbook:RT06808 "risk assessment")
AnnotationAssertion(dcterms:description goldbook:RT06808 "Identification and quantification of the risk resulting from a specific use or occurrence of an agent, taking into account possible harmful effects on individuals exposed to the agent in the amount and manner proposed and all the possible routes of exposure.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06808 goldbook:ET06811)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06808 goldbook:RT06807)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06808 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06808 "current"^^xsd:string)
Declaration(Class(goldbook:RT06841))
AnnotationAssertion(rdfs:label goldbook:RT06841 "receptor")
AnnotationAssertion(dcterms:description goldbook:RT06841 "Molecular structure in or on a cell that specifically recognizes and binds to a compound and acts as a physiological signal transducer, or mediator of, an effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06841 goldbook:T06437)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06841 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06841 "current"^^xsd:string)
Declaration(Class(goldbook:RT06871))
AnnotationAssertion(rdfs:label goldbook:RT06871 "rigid chain")
AnnotationAssertion(dcterms:description goldbook:RT06871 "The rod-like chain of an MCPLC (main-chain polymer liquid crystal) with direct links between the mesogenic groups for which the persistence length is at least comparable with the contour length and much greater than the diameter.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06871 goldbook:MT06869)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06871 goldbook:MT06858)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06871 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06871 "current"^^xsd:string)
Declaration(Class(goldbook:RT06893))
AnnotationAssertion(rdfs:label goldbook:RT06893 "reverse osmosis")
AnnotationAssertion(dcterms:description goldbook:RT06893 "Liquid-phase pressure-driven separation process in which applied transmembrane pressure causes selective movement of solvent against its osmotic pressure difference.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06893 goldbook:O04344)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06893 doi:10.1351/pac199668071479)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06893 "current"^^xsd:string)
Declaration(Class(goldbook:RT06912))
AnnotationAssertion(rdfs:label goldbook:RT06912 "reference dose")
AnnotationAssertion(dcterms:description goldbook:RT06912 "An estimate (with uncertainty spanning perhaps an order of magnitude) of daily exposure to the human population (including sensitive subgroups) that is likely to be without appreciable risk of deleterious effects during a lifetime.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:RT06912 "RfD")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06912 goldbook:ET06811)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06912 goldbook:L03515)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06912 goldbook:RT06807)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06912 doi:10.1351/pac200173060993)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06912 "current"^^xsd:string)
Declaration(Class(goldbook:RT06913))
AnnotationAssertion(rdfs:label goldbook:RT06913 "risk estimation")
AnnotationAssertion(dcterms:description goldbook:RT06913 "Assessment with or without mathematical modeling, of the probability and nature of effects of exposure to a substance based on quantification of dose-effect and dose-response relationships for that substance and the population(s) and environmental components likely to be exposed and on assessment of the levels of potential exposure of people, organisms, and environment at risk.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06913 goldbook:DT06906)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06913 goldbook:ET06811)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06913 goldbook:P04855)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06913 goldbook:RT06807)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06913 doi:10.1351/pac200173060993)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06913 "current"^^xsd:string)
Declaration(Class(goldbook:RT06978))
AnnotationAssertion(rdfs:label goldbook:RT06978 "receptor")
AnnotationAssertion(dcterms:description goldbook:RT06978 "A receptor is a protein or a protein complex in or on a cell that specifically recognizes and binds to a compound acting as a molecular messenger (neurotransmitter, hormone, lymphokine, lectin, drug, etc). In a broader sense, the term receptor is often used as a synonym for any specific (as opposed to non-specific such as binding to plasma proteins) drug binding site, also including nucleic acids such as DNA.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06978 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06978 goldbook:B00649)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06978 goldbook:D01863)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06978 goldbook:N04245)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06978 goldbook:P04898)
AnnotationAssertion(rdfs:seeAlso goldbook:RT06978 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06978 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06978 "current"^^xsd:string)
Declaration(Class(goldbook:RT06979))
AnnotationAssertion(rdfs:label goldbook:RT06979 "regression analysis")
AnnotationAssertion(dcterms:description goldbook:RT06979 "Regression analysis is the use of statistical methods for modeling a set of dependent variables, Y, in terms of combinations of predictions, X. It includes methods such as multiple linear regression (MLR) and partial least squares (PLS).")
AnnotationAssertion(rdfs:seeAlso goldbook:RT06979 goldbook:PT06975)
AnnotationAssertion(mito:isMentionedBy goldbook:RT06979 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT06979 "current"^^xsd:string)
Declaration(Class(goldbook:RT07092))
AnnotationAssertion(rdfs:label goldbook:RT07092 "relative hardness")
AnnotationAssertion(dcterms:description goldbook:RT07092 "The difference between the values of the absolute hardnesses (\\(\\eta \\)) of a given molecule and the corresponding reference structure (\\(\\eta _{\\rm{a}}\\)): \\(\\eta _{\\rm{r}} = \\eta - \\eta _{\\rm{a}}\\). The values of relative hardnesses correlate well with the resonance energies of cyclic compounds and may be used as an index of aromaticity.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07092 goldbook:A00442)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07092 goldbook:R05326)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07092 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07092 "current"^^xsd:string)
Declaration(Class(goldbook:RT07093))
AnnotationAssertion(rdfs:label goldbook:RT07093 "relativistic effects")
AnnotationAssertion(dcterms:description goldbook:RT07093 "Corrections to exact non-relativistic energy from the fact that inner shell electrons in heavy atoms move with velocities comparable in order of magnitude to the velocity of light. The most important relativistic effect is spin–orbit coupling.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07093 goldbook:S05870)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07093 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07093 "current"^^xsd:string)
Declaration(Class(goldbook:RT07094))
AnnotationAssertion(rdfs:label goldbook:RT07094 "resonance hybrid")
AnnotationAssertion(dcterms:description goldbook:RT07094 "A localized valence bond representation of a molecule. This describes pictorially an electronic wavefunction that makes some contribution to the state wavefunction of the system. resonance hybrids are needed to describe the state of a system when that system is not adequately described by a single Lewis structure.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07094 goldbook:R05326)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07094 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07094 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07094 "current"^^xsd:string)
Declaration(Class(goldbook:RT07095))
AnnotationAssertion(rdfs:label goldbook:RT07095 "ribbon delocalisation")
AnnotationAssertion(dcterms:description goldbook:RT07095 "Electron delocalization realized in both acyclic and cyclic $\\ce{\\uppi\\!\\mbox{-}conjugated}$, 1, and $\\ce{\\upsigma\\!\\mbox{-}bonded}$, 2, ribbon-like systems.  For cyclic systems, a variety of linkage fashions between several ribbons (pericyclic, spirocyclic, longicyclic and laticyclic) is possible.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07095 goldbook:D01583)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07095 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07095 "current"^^xsd:string)
Declaration(Class(goldbook:RT07096))
AnnotationAssertion(rdfs:label goldbook:RT07096 "Rydberg state")
AnnotationAssertion(dcterms:description goldbook:RT07096 "An electronic state that arises by the excitation of a valence electron to a diffuse atomic-like orbital. For instance, the lowest lying Rydberg state (n, 3S) of $\\ce{NH3}$ can be described as resulting from the excitation of a non-bonding orbital to a 3S Rydberg orbital.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07096 goldbook:R05431)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07096 goldbook:ET07026)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07096 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07096 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07096 "current"^^xsd:string)
Declaration(Class(goldbook:RT07149))
AnnotationAssertion(rdfs:label goldbook:RT07149 "radiation reaction")
AnnotationAssertion(dcterms:description goldbook:RT07149 "Chemical reaction that is induced by ionizing radiation with $\\upgamma\\!\\mbox{-}\\rm{ray}$, X-ray, electron, or other high-energy beams.")
AnnotationAssertion(rdfs:comment goldbook:RT07149 "Radiation reactions involving polymers often lead to chain scission and crosslinking."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07149 "A photochemical reaction is sometimes regarded as a type of radiation reaction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07149 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07149 goldbook:I03216)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07149 goldbook:P04585)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07149 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07149 "current"^^xsd:string)
Declaration(Class(goldbook:RT07150))
AnnotationAssertion(rdfs:label goldbook:RT07150 "reactive blending")
AnnotationAssertion(dcterms:description goldbook:RT07150 "Mixing process that is accompanied by the chemical reaction(s) of components of a polymer mixture.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:RT07150 "RIM")
AnnotationAssertion(rdfs:comment goldbook:RT07150 "Examples of reactive blending are: (a) blending accompanied by the formation of a polymer-polymer complex, (b) the formation of block or graft copolymers by a combination of radicals formed by the mechano-chemical scission of polymers during blending."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07150 "Reactive blending may also be carried out as reactive extrusion or reaction injection molding (RIM)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07150 goldbook:B00682)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07150 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07150 "current"^^xsd:string)
Declaration(Class(goldbook:RT07164))
AnnotationAssertion(rdfs:label goldbook:RT07164 "reactive polymer")
AnnotationAssertion(dcterms:description goldbook:RT07164 "Polymer having reactive functional groups that can undergo chemical transformation under the conditions required for a given reaction or application.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07164 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07164 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07164 "current"^^xsd:string)
Declaration(Class(goldbook:RT07166))
AnnotationAssertion(rdfs:label goldbook:RT07166 "resin")
AnnotationAssertion(dcterms:description goldbook:RT07166 "Soft solid or highly viscous substance, usually containing prepolymers with reactive groups.")
AnnotationAssertion(rdfs:comment goldbook:RT07166 "This term was used originally because of its analogy with a natural resin (rosin) and designated, in a broad sense, any polymer that is a basic material for plastics, organic coatings, or lacquers. However, the term is now used in a more narrow sense to refer to prepolymers of thermosets (thermosetting polymers)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07166 "The term is sometimes used not only for prepolymers of thermosets, but also for cured thermosets (e.g., epoxy resins, phenolic resins). Use of the term for cured thermosets is strongly discouraged."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07166 "Use of the term 'resin' to describe the polymer beads used in solid-phase synthesis and as polymer supports, catalysts, reagents, and scavengers is also discouraged."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07166 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07166 "current"^^xsd:string)
Declaration(Class(goldbook:RT07193))
AnnotationAssertion(rdfs:label goldbook:RT07193 "resist polymer")
AnnotationAssertion(dcterms:description goldbook:RT07193 "Polymeric material that, when irradiated, undergoes a marked change in solubility in a given solvent or is ablated.")
AnnotationAssertion(rdfs:comment goldbook:RT07193 "A resist polymer under irradiation either forms patterns directly or undergoes chemical reactions leading to pattern formation after subsequent processing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07193 "A resist material that is optimized for use with ultraviolet or visible light, an electron beam, an ion beam, or X-rays is called a photoresist, electron-beam resist, ion-beam resist, or X-ray resist, respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07193 "In a positive-tone resist, also called a positive resist, the material in the irradiated area not covered by a mask is removed, which results in an image with a pattern identical with that on the mask. In a negative-tone resist, also called a negative resist, the non-irradiated area is subsequently removed, which results in an image with a pattern that is the complement of that on the mask."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07193 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07193 goldbook:I03255)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07193 goldbook:P04651)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07193 goldbook:S05740)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07193 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07193 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07193 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07193 "current"^^xsd:string)
Declaration(Class(goldbook:RT07308))
AnnotationAssertion(rdfs:label goldbook:RT07308 "rod-like morphology")
AnnotationAssertion(dcterms:description goldbook:RT07308 "Morphology characterized by cylindrical phase domains.")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07308 goldbook:MT07285)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07308 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07308 "current"^^xsd:string)
Declaration(Class(goldbook:RT07470))
AnnotationAssertion(rdfs:label goldbook:RT07470 "radiation trapping")
AnnotationAssertion(dcterms:description goldbook:RT07470 "Process by which the resonance radiation emitted in a lamp is absorbed and re-emitted many times in the plasma prior to striking the phosphor. This process is called radiation trapping or imprisonment.")
AnnotationAssertion(rdfs:comment goldbook:RT07470 "Radiation trapping lengthens the effective lifetime of emission as viewed from outside the lamp. The control of this trapping is, therefore, an important design consideration for low-pressure lamps."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07470 goldbook:L03447)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07470 goldbook:L03515)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07470 goldbook:R05343)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07470 goldbook:T06492)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07470 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07470 "current"^^xsd:string)
Declaration(Class(goldbook:RT07471))
AnnotationAssertion(rdfs:label goldbook:RT07471 "radical photosubstitution")
AnnotationAssertion(dcterms:description goldbook:RT07471 "Photo-induced substitution resulting from the reaction of radicals produced by photolysis of an appropriate reagent, such as, e.g., halogenated compounds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:RT07471 "free-radical photosubstitution")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07471 goldbook:P04624)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07471 goldbook:R05190)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07471 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07471 "current"^^xsd:string)
Declaration(Class(goldbook:RT07472))
AnnotationAssertion(rdfs:label goldbook:RT07472 "Rehm–Weller equation")
AnnotationAssertion(dcterms:description goldbook:RT07472 "Empirical correlation found between the observed second-order rate constant, \\(k_{\\rm{q}}\\), for an intermolecular electron-transfer reaction and the Gibbs energy of the photoinduced electron transfer process within the encounter complex (\\(\\Delta _{\\rm{ET}}G^{\\,\\unicode{x26ac}}\\)): \\[k_{\\rm{q}} = \\frac{k_{\\rm{d}}}{1+ \\frac {k_{\\rm{d}}}{K_{\\rm{d}}\\, \\rm{Z}}\\left [ \\rm{exp}\\left ( \\frac{\\Delta G^{\\ddagger }}{RT} \\right ) + \\rm{exp}\\left ( \\frac{\\Delta_{\\rm{ET}} G^{o }}{RT} \\right ) \\right ]}\\] with \\(k_{\\rm{d}}\\) and \\(k_{\\rm{-d}}\\) the rate constant for the formation and separation, respectively, of the encounter (precursor) complex, \\(K_{\\rm{d}} = \\: ^{k_{\\rm{d}}}\\! /_{k_{\\rm{-d}}}\\), \\(Z\\) the universal collision frequency factor, \\(R\\) the gas constant, \\(T\\) the absolute temperature and \\(\\Delta G^{\\ddagger}\\) the activation Gibbs energy of the forward electron transfer reaction.")
AnnotationAssertion(rdfs:comment goldbook:RT07472 "In the original formulation of this equation the value \\(\\frac{k_{\\rm{d}}}{K_{\\rm{d}}\\, \\rm{Z}} = 0.25\\) in acetonitrile was used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:A00093)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:C01166)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:E02086)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:E02087)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:G02579)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:I03098)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:P04617)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07472 goldbook:O04322)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07472 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07472 "current"^^xsd:string)
Declaration(Class(goldbook:RT07473))
AnnotationAssertion(rdfs:label goldbook:RT07473 "residual emission anisotropy")
AnnotationAssertion(dcterms:description goldbook:RT07473 "Photoselected molecules hindered in their rotation (e.g., in lipid bilayers or liquid crystals) do not become randomly oriented even after long time periods. Thus, the emission anisotropy does not decay to zero but to a steady value, \\(r_{\\mathrm{\\infty }}\\), called residual emission anisotropy. In the case of a single rotational correlation time, \\(\\tau _{\\mathrm{c}}\\) or \\(\\theta \\), the decay of emission anisotropy following $\\ce{\\updelta\\!\\mbox{-}pulse}$ excitation is given by: \\[r\\left(t\\right)=(r_{0}- r_{\\mathrm{\\infty }})\\ \\exp (- \\frac{t}{\\tau _{\\mathrm{c}}})+r_{\\mathrm{\\infty }}\\] where \\(r_{0}\\) is the fundamental emission anisotropy.")
AnnotationAssertion(rdfs:comment goldbook:RT07473 "The term residual anisotropy is to be preferred to 'limiting anisotropy'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07473 goldbook:AT06776)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07473 goldbook:ET07370)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07473 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07473 "current"^^xsd:string)
Declaration(Class(goldbook:RT07474))
AnnotationAssertion(rdfs:label goldbook:RT07474 "rotational correlation time")
AnnotationAssertion(dcterms:description goldbook:RT07474 "Parameter describing the time dependence of the tumbling of a molecular entity in a medium of viscosity \\(\\eta\\). The rotational correlation time can be obtained from the decay of the fluorescence or phosphorescence anisotropy and is related to the average molecular rotational diffusion coefficient, \\(D_{\\rm{r}}\\), in turn related to the hydrodynamic molecular volume of the fluorophore, \\(V\\), and to \\(\\eta\\) (see Note 3).")
AnnotationAssertion(rdfs:comment goldbook:RT07474 "Mathematical definition: \\(r(t) = r_{\\rm{0}}\\, \\rm{exp}\\! \\left ( -\\frac{t}{\\tau_{\\rm{c}}} \\right )\\) with \\(r(t)\\) the emission anisotropy at time \\(t\\) and \\(r_{\\rm{0}}\\) the fundamental emission anisotropy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07474 "In the case of a spherical emitting species reorienting itself in a homogeneous fluid, \\(\\tau_{\\rm{c}} = \\frac{1}{6D_{\\rm{r}}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07474 "Often, the Stokes–Einstein relationship is used for the calculation of \\(D_{\\rm{r}}\\), i.e., \\(D_{\\rm{r}} = R\\, T/6\\, V\\eta\\) with \\(R\\) the gas constant, \\(T\\) the absolute temperature and \\(V\\) the hydrodynamic molecular volume. However, the use of this relationship at a molecular level is questionable, and \\(D_{\\rm{r}}\\) should be independently determined by time-resolved fluorescence polarization methods. Compare with rotational relaxation time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:E01914)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:S06027)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:AT06776)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:ET07370)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:FT07380)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:G02579)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:P04569)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:P04712)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:R05411)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:RT07475)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07474 goldbook:V06627)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07474 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07474 "current"^^xsd:string)
Declaration(Class(goldbook:RT07475))
AnnotationAssertion(rdfs:label goldbook:RT07475 "rotational relaxation time")
AnnotationAssertion(dcterms:description goldbook:RT07475 "Parameter describing the time-dependence of the tumbling of a molecular entity in a medium of viscosity \\(\\eta\\) as originally defined by Debye, and used by Perrin in the original development of the theories of rotational motion of fluorophores.")
AnnotationAssertion(rdfs:comment goldbook:RT07475 "Related to the rotational correlation time, \\(\\tau_{c}\\), by \\(\\rho = 3\\tau_{c}\\). Thus, in the case of a spherically emitting species reorienting itself in a homogeneous fluid, \\(\\rho = 1/(6\\, D_{r})\\), with \\(D_{r}\\) the rotational diffusion coefficient."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07475 goldbook:D01533)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07475 goldbook:R05411)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07475 goldbook:V06627)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07475 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07475 "current"^^xsd:string)
Declaration(Class(goldbook:RT07526))
AnnotationAssertion(rdfs:label goldbook:RT07526 "responsive gel")
AnnotationAssertion(dcterms:description goldbook:RT07526 "Gel that responds to external electrical, mechanical, thermal, light-induced or chemical stimulation.")
AnnotationAssertion(rdfs:comment goldbook:RT07526 "The use of the term intelligent gel is discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07526 goldbook:G02600)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07526 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07526 "current"^^xsd:string)
Declaration(Class(goldbook:RT07527))
AnnotationAssertion(rdfs:label goldbook:RT07527 "rheopexic gel")
AnnotationAssertion(dcterms:description goldbook:RT07527 "Gel for which the time of solidification after discontinuation of a relatively high shear rate, is reduced by applying a small shear rate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:RT07527 "rheotropic gel")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07527 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07527 goldbook:S05636)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07527 goldbook:S05733)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07527 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07527 "current"^^xsd:string)
Declaration(Class(goldbook:RT07529))
AnnotationAssertion(rdfs:label goldbook:RT07529 "ringing gel")
AnnotationAssertion(dcterms:description goldbook:RT07529 "Gel with energy dissipation in the acoustic frequency range.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:RT07529 "humming gel")
AnnotationAssertion(rdfs:comment goldbook:RT07529 "A ringing gel is often a hydrogel with a surfactant as a third component and has a composition within an isotropic, one-phase region of its ternary phase diagram."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07529 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07529 goldbook:HT07519)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07529 goldbook:I03353)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07529 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07529 "current"^^xsd:string)
Declaration(Class(goldbook:RT07572))
AnnotationAssertion(rdfs:label goldbook:RT07572 "reversible network")
AnnotationAssertion(dcterms:description goldbook:RT07572 "Polymer network that forms or breaks up as the temperature is changed or under the action of a force.")
AnnotationAssertion(rdfs:comment goldbook:RT07572 "The junction points in a reversible network are usually small crystallites or glassy domains such as those formed within block copolymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07572 goldbook:P04742)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07572 goldbook:B00682)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07572 goldbook:NT07562)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07572 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07572 "current"^^xsd:string)
Declaration(Class(goldbook:RT07628))
AnnotationAssertion(rdfs:label goldbook:RT07628 "reaction injection moulding")
AnnotationAssertion(dcterms:description goldbook:RT07628 "Reactive polymer processing that produces polymer monoliths by low-pressure injection and mixing of low-viscosity precursors into moulds.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:RT07628 "RIM")
AnnotationAssertion(rdfs:comment goldbook:RT07628 "Reaction injection moulding commonly uses two-component precursors that produce polymer networks after mixing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07628 goldbook:RT07630)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07628 goldbook:V06627)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07628 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07628 "current"^^xsd:string)
Declaration(Class(goldbook:RT07629))
AnnotationAssertion(rdfs:label goldbook:RT07629 "reinforced reaction injection moulding")
AnnotationAssertion(dcterms:description goldbook:RT07629 "Reaction injection moulding within which glass fibres are included to increase the strength of the moulding.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:RT07629 "RRIM")
AnnotationAssertion(rdfs:seeAlso goldbook:RT07629 goldbook:RT07628)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07629 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07629 "current"^^xsd:string)
Declaration(Class(goldbook:RT07630))
AnnotationAssertion(rdfs:label goldbook:RT07630 "reactive polymer processing")
AnnotationAssertion(dcterms:description goldbook:RT07630 "Process whereby a polymeric monolith is produced through an in-situpolymerization or polymer modification reaction.")
AnnotationAssertion(rdfs:comment goldbook:RT07630 "The polymerization or modification reaction and the transformation of the resulting polymer into a shaped product is accomplished in the same processing equipment."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07630 "This type of processing is commonly accomplished by extrusion or injection moulding."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:RT07630 "Reaction injection moulding and reinforced reaction injection moulding are types of reactive polymer processing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07630 goldbook:RT07628)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07630 goldbook:MT07559)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07630 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07630 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07630 goldbook:RT07164)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07630 goldbook:RT07629)
AnnotationAssertion(rdfs:seeAlso goldbook:RT07630 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:RT07630 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:RT07630 "current"^^xsd:string)
Declaration(Class(goldbook:S04387))
AnnotationAssertion(rdfs:label goldbook:S04387 "π → σ* transition")
AnnotationAssertion(dcterms:description goldbook:S04387 "An electronic transition described approximately as a promotion of an electron from a 'bonding' orbital $\\ce{\\uppi\\!}$ to an 'antibonding' orbital $\\ce{\\upsigma\\!}$ designated as $\\ce{\\upsigma\\!^{\\ast}}$. Such transitions generally involve high transition energies and appear close to or mixed with Rydberg transitions.")
AnnotationAssertion(rdfs:seeAlso goldbook:S04387 goldbook:R05432)
AnnotationAssertion(rdfs:seeAlso goldbook:S04387 goldbook:P04877)
AnnotationAssertion(mito:isMentionedBy goldbook:S04387 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S04387 "current"^^xsd:string)
Declaration(Class(goldbook:S05434))
AnnotationAssertion(rdfs:label goldbook:S05434 "σ, π")
AnnotationAssertion(dcterms:description goldbook:S05434 "The terms are symmetry designations, $\\ce{\\uppi\\! molecular orbitals}$ being antisymmetric with respect to a defining plane containing at least one atom (e.g. the molecular plane of ethene) and $\\ce{\\upsigma\\! molecular orbitals}$ symmetric with respect to the same plane. In practice the terms are used both in this rigorous sense (for orbitals encompassing the entire molecule) and also for localized two-centre orbitals or bonds, and it is necessary to make a clear distinction between the two usages. In the case of two-centre bonds, a $\\ce{\\uppi\\!\\mbox{-}bond}$ has a nodal plane that includes the internuclear bond axis, whereas a $\\ce{\\upsigma\\!\\mbox{-}bond}$ has no such nodal plane. (A $\\ce{\\updelta\\!\\mbox{-}bond}$ in organometallic or inorganic molecular species has two nodes.) Radicals are classified by analogy into $\\ce{\\upsigma\\!\\mbox{-}}$ and $\\ce{\\uppi\\!\\mbox{-}radicals}$. Such two-centre orbitals may take part in molecular orbitals of $\\ce{\\upsigma\\!\\mbox{-}}$ or $\\ce{\\uppi\\!\\mbox{-}symmetry}$. For example, the methyl group in propene contains three $\\ce{C–H}$ bonds, each of which is of local $\\ce{\\upsigma\\!\\mbox{-}symmetry}$ (i.e. without a nodal plane including the internuclear axis), but these three '$\\ce{\\upsigma\\!\\mbox{-}bonds}$' can in turn be combined to form a set of group orbitals one of which has $\\ce{\\uppi\\!\\mbox{-}symmetry}$ with respect to the principal molecular plane and can accordingly interact with the two-centre orbital of $\\ce{\\uppi\\!\\mbox{-}symmetry}$ ($\\ce{\\uppi\\!\\mbox{-}bond}$) of the double-bonded carbon atoms, to form a molecular orbital of $\\ce{\\uppi\\!\\mbox{-}symmetry}$. Such an interaction between the $\\ce{CH3}$ group and the double bond is an example of what is called hyperconjugation. This cannot rigorously be described as '$\\ce{\\upsigma\\!\\mbox{-}\\uppi\\!}$ conjugation' since $\\ce{\\upsigma\\!}$ and $\\ce{\\uppi\\!}$ here refer to different defining planes, and interaction between orbitals of different symmetries (with respect to the same defining plane) is forbidden.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:S05434 "sigma, pi")
AnnotationAssertion(rdfs:seeAlso goldbook:S05434 goldbook:R05066)
AnnotationAssertion(rdfs:seeAlso goldbook:S05434 goldbook:C01267)
AnnotationAssertion(rdfs:seeAlso goldbook:S05434 goldbook:H02924)
AnnotationAssertion(rdfs:seeAlso goldbook:S05434 goldbook:M03996)
AnnotationAssertion(rdfs:seeAlso goldbook:S05434 goldbook:NT07082)
AnnotationAssertion(mito:isMentionedBy goldbook:S05434 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05434 "current"^^xsd:string)
Declaration(Class(goldbook:S05435))
AnnotationAssertion(rdfs:label goldbook:S05435 "σ → σ* transition")
AnnotationAssertion(dcterms:description goldbook:S05435 "An electronic transition described approximately as promotion of an electron from a 'bonding' $\\ce{\\upsigma\\!\\mbox{-}orbital}$ to an 'antibonding' $\\ce{\\upsigma\\!\\mbox{-}orbital}$ designated as \\(\\sigma ^{\\rm{*}}\\). Such transitions generally involve high transition energies, and appear close to or mixed with Rydberg transitions.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05435 goldbook:R05432)
AnnotationAssertion(rdfs:seeAlso goldbook:S05435 goldbook:P04877)
AnnotationAssertion(mito:isMentionedBy goldbook:S05435 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05435 "current"^^xsd:string)
Declaration(Class(goldbook:S05441))
AnnotationAssertion(rdfs:label goldbook:S05441 "saccharides")
AnnotationAssertion(dcterms:description goldbook:S05441 "The monosaccharides (1) and di- (2), oligo- (3 - 10) and polysaccharides (many), which are made up of $n$ monosaccharide units linked to each other by a glycosidic bond. Considered by some to be synonymous with carbohydrates.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05441 goldbook:C00820)
AnnotationAssertion(rdfs:seeAlso goldbook:S05441 goldbook:M04021)
AnnotationAssertion(rdfs:seeAlso goldbook:S05441 goldbook:O04289)
AnnotationAssertion(rdfs:seeAlso goldbook:S05441 goldbook:P04752)
AnnotationAssertion(mito:isMentionedBy goldbook:S05441 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05441 "current"^^xsd:string)
Declaration(Class(goldbook:S05442))
AnnotationAssertion(rdfs:label goldbook:S05442 "Sackur–Tetrode constant")
AnnotationAssertion(dcterms:description goldbook:S05442 "Fundamental physical constant representing the translational contribution to molar entropy; \\(\\frac{S_{0}}{R} = -1.151\\ 693(21)\\) at \\(1\\ \\rm{K}\\) and standard pressure of \\(100\\ \\rm{kPa}\\), where \\(R\\) is the gas constant.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05442 goldbook:E02149)
AnnotationAssertion(rdfs:seeAlso goldbook:S05442 goldbook:G02579)
AnnotationAssertion(rdfs:seeAlso goldbook:S05442 goldbook:S05921)
AnnotationAssertion(mito:isMentionedBy goldbook:S05442 doi:10.6028/jres.092.010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05442 "current"^^xsd:string)
Declaration(Class(goldbook:S05443))
AnnotationAssertion(rdfs:label goldbook:S05443 "sacrificial acceptor")
AnnotationAssertion(dcterms:description goldbook:S05443 "Molecular entity that acts as the electron acceptor in a photoinduced electron transfer process and is not restored in a subsequent oxidation process but is destroyed by irreversible chemical conversion.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05443 goldbook:E01976)
AnnotationAssertion(rdfs:seeAlso goldbook:S05443 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:S05443 goldbook:P04617)
AnnotationAssertion(mito:isMentionedBy goldbook:S05443 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05443 "current"^^xsd:string)
Declaration(Class(goldbook:S05444))
AnnotationAssertion(rdfs:label goldbook:S05444 "sacrificial donor")
AnnotationAssertion(dcterms:description goldbook:S05444 "Molecular entity that acts as the electron donor in a photoinduced electron transfer process and is not restored in a subsequent reduction process but is destroyed by irreversible chemical conversion.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05444 goldbook:E01988)
AnnotationAssertion(rdfs:seeAlso goldbook:S05444 goldbook:P04617)
AnnotationAssertion(mito:isMentionedBy goldbook:S05444 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05444 "current"^^xsd:string)
Declaration(Class(goldbook:S05447))
AnnotationAssertion(rdfs:label goldbook:S05447 "salt")
AnnotationAssertion(dcterms:description goldbook:S05447 "A chemical compound consisting of an assembly of cations and anions.")
AnnotationAssertion(mito:isMentionedBy goldbook:S05447 doi:10.1515/pac-2014-0718)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05447 "current"^^xsd:string)
Declaration(Class(goldbook:S05449))
AnnotationAssertion(rdfs:label goldbook:S05449 "salt form of an ion exchanger")
AnnotationAssertion(dcterms:description goldbook:S05449 "The ionic form of an ion exchanger in which the counter-ions are neither hydrogen nor hydroxide ions. When only one valence is possible for the counter-ion, or its exact form or charge is not known, the symbol or the name of the counter-ion without charge is used, e.g. sodium-form or $\\ce{Na}$-form, tetramethylammonium-form, orthophosphate-form. When one of two or more possible forms is exclusively present, the oxidation state may be indicated by a Roman numeral, e.g. $\\ce{Fe^{II}}$ form, $\\ce{Fe^{III}}$ form.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05449 goldbook:C01371)
AnnotationAssertion(rdfs:seeAlso goldbook:S05449 goldbook:I03171)
AnnotationAssertion(rdfs:seeAlso goldbook:S05449 goldbook:O04365)
AnnotationAssertion(rdfs:seeAlso goldbook:S05449 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:S05449 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05449 "current"^^xsd:string)
Declaration(Class(goldbook:S05450))
AnnotationAssertion(rdfs:label goldbook:S05450 "salting out")
AnnotationAssertion(dcterms:description goldbook:S05450 "The addition of particular electrolytes to an aqueous phase in order to increase the distribution ratio of a particular solute.")
AnnotationAssertion(rdfs:comment goldbook:S05450 "The addition of electrolytes to improve phase separation behaviour should not be referred to as salting out."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05450 "The term is also used for the addition of electrolytes to reduce the mutual partial miscibility of two liquids."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05450 "It has no connection with synergism."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05450 goldbook:MT07230)
AnnotationAssertion(rdfs:seeAlso goldbook:S05450 goldbook:P04534)
AnnotationAssertion(mito:isMentionedBy goldbook:S05450 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05450 "current"^^xsd:string)
Declaration(Class(goldbook:S05451))
AnnotationAssertion(rdfs:label goldbook:S05451 "sample")
AnnotationAssertion(dcterms:description goldbook:S05451 "A portion of material selected from a larger quantity of material. The term needs to be qualified, e.g. bulk sample, representative sample, primary sample, bulked sample, test sample. The term 'sample' implies the existence of a sampling error, i.e. the results obtained on the portions taken are only estimates of the concentration of a constituent or the quantity of a property present in the parent material. If there is no or negligible sampling error, the portion removed is a test portion, aliquot or specimen. The term 'specimen' is used to denote a portion taken under conditions such that the sampling variability cannot be assessed (usually because the population is changing), and is assumed, for convenience, to be zero. The manner of selection of the sample should be prescribed in a sampling plan.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:S05451 "analytical sample")
AnnotationAssertion(rdfs:seeAlso goldbook:S05451 goldbook:B00756)
AnnotationAssertion(rdfs:seeAlso goldbook:S05451 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:S05451 goldbook:P04841)
AnnotationAssertion(rdfs:seeAlso goldbook:S05451 goldbook:R05303)
AnnotationAssertion(rdfs:seeAlso goldbook:S05451 goldbook:S05463)
AnnotationAssertion(rdfs:seeAlso goldbook:S05451 goldbook:T06284)
AnnotationAssertion(rdfs:seeAlso goldbook:S05451 goldbook:T06285)
AnnotationAssertion(mito:isMentionedBy goldbook:S05451 doi:10.1351/pac198961091657)
AnnotationAssertion(mito:isMentionedBy goldbook:S05451 doi:10.1351/pac199062061193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05451 "current"^^xsd:string)
Declaration(Class(goldbook:S05456))
AnnotationAssertion(rdfs:label goldbook:S05456 "sample error")
AnnotationAssertion(dcterms:description goldbook:S05456 "An error which arises when the absorbance of some samples changes with time, e.g. as a result of photochemical reaction, formation of aggregates or adsorption on the cell wall.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05456 goldbook:A00028)
AnnotationAssertion(rdfs:seeAlso goldbook:S05456 goldbook:P04585)
AnnotationAssertion(mito:isMentionedBy goldbook:S05456 doi:10.1351/pac198860091449)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05456 "current"^^xsd:string)
Declaration(Class(goldbook:S05457))
AnnotationAssertion(rdfs:label goldbook:S05457 "sample handling")
AnnotationAssertion(dcterms:description goldbook:S05457 "Any action applied to the sample before the analytical procedure. Such actions include the addition of preservatives, separation procedures, storage at low temperature, protection against light and irradiation, loading, etc.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05457 goldbook:I03255)
AnnotationAssertion(mito:isMentionedBy goldbook:S05457 doi:10.1351/pac198961091657)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05457 "current"^^xsd:string)
Declaration(Class(goldbook:S05459))
AnnotationAssertion(rdfs:label goldbook:S05459 "sampler")
AnnotationAssertion(dcterms:description goldbook:S05459 "A device used to withdraw and deliver a volume or an amount of a sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:S05459 doi:10.1351/pac198961091657)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05459 "current"^^xsd:string)
Declaration(Class(goldbook:S05461))
AnnotationAssertion(rdfs:label goldbook:S05461 "sample unit")
AnnotationAssertion(dcterms:description goldbook:S05461 "The discrete identifiable portion suitable for taking as a sample or as a portion of a sample. These units may be different at different stages of sampling.")
AnnotationAssertion(mito:isMentionedBy goldbook:S05461 doi:10.1351/pac198860091461)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05461 "current"^^xsd:string)
Declaration(Class(goldbook:S05463))
AnnotationAssertion(rdfs:label goldbook:S05463 "sampling error")
AnnotationAssertion(dcterms:description goldbook:S05463 "That part of the total error (the estimate from a sample minus the population value) associated with using only a fraction of the population and extrapolating to the whole, as distinct from analytical or test error. It arises from a lack of homogeneity in the parent population. In chemical analysis, the final test result reflects the value only as it exists in the test portion. It is usually assumed that no sampling error is introduced in preparing the test sample from the laboratory sample. Therefore, the sampling error is usually associated exclusively with the variability of the laboratory sample. Sampling error is determined by replication of the laboratory samples and their multiple analyses. Since sampling error is always associated with analytical error, it must be isolated by the statistical procedure of analysis of variance.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05463 goldbook:L03433)
AnnotationAssertion(rdfs:seeAlso goldbook:S05463 goldbook:R05300)
AnnotationAssertion(rdfs:seeAlso goldbook:S05463 goldbook:T06284)
AnnotationAssertion(rdfs:seeAlso goldbook:S05463 goldbook:T06285)
AnnotationAssertion(mito:isMentionedBy goldbook:S05463 doi:10.1351/pac199062061193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05463 "current"^^xsd:string)
Declaration(Class(goldbook:S05465))
AnnotationAssertion(rdfs:label goldbook:S05465 "sampling interval")
AnnotationAssertion(dcterms:description goldbook:S05465 "In Tast polarography, square-wave polarography, and similar techniques, the interval during which the current is measured or recorded.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05465 goldbook:P04716)
AnnotationAssertion(mito:isMentionedBy goldbook:S05465 doi:10.1351/pac198557101491)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05465 "current"^^xsd:string)
Declaration(Class(goldbook:S05466))
AnnotationAssertion(rdfs:label goldbook:S05466 "sampling plan")
AnnotationAssertion(dcterms:description goldbook:S05466 "A predetermined procedure for the selection, withdrawal, preservation, transportation and preparation of the portions to be removed from a population as samples. Summarizing the test values or observations from the selected portions yields an estimate for the concentration of an analyte or a value for a property determined with a calculable degree of uncertainty at a specified confidence level. A sampling plan includes the designation of the number, location and size of the portions, and instructions for the extent of compositing and for the reduction (in amount and fineness) of the portions to a laboratory sample and to test portions. It may also contain acceptance criteria. Some sampling plans do not include more than instructions for the statistical selection of portions to be removed. Such plans should properly be designated as 'statistical sampling plans'.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05466 goldbook:C01246)
AnnotationAssertion(rdfs:seeAlso goldbook:S05466 goldbook:L03433)
AnnotationAssertion(mito:isMentionedBy goldbook:S05466 doi:10.1351/pac199062061193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05466 "current"^^xsd:string)
Declaration(Class(goldbook:S05467))
AnnotationAssertion(rdfs:label goldbook:S05467 "sampling time")
AnnotationAssertion(dcterms:description goldbook:S05467 "In Tast polarography, square-wave polarography, and similar techniques, the duration of the sampling interval.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05467 goldbook:P04716)
AnnotationAssertion(rdfs:seeAlso goldbook:S05467 goldbook:S05465)
AnnotationAssertion(mito:isMentionedBy goldbook:S05467 doi:10.1351/pac198557101491)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05467 "current"^^xsd:string)
Declaration(Class(goldbook:S05468))
AnnotationAssertion(rdfs:label goldbook:S05468 "sandwich compounds")
AnnotationAssertion(dcterms:description goldbook:S05468 "Compounds in which a metal atom is located between the faces of two parallel and planar (or nearly so) ring structures, e.g. bis(\\(\\eta ^{5}\\)-cyclopentadienyl)iron (ferrocene), dibenzenechromium.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05468 goldbook:M03865)
AnnotationAssertion(mito:isMentionedBy goldbook:S05468 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05468 "current"^^xsd:string)
Declaration(Class(goldbook:S05469))
AnnotationAssertion(rdfs:label goldbook:S05469 "sanitary land fill")
AnnotationAssertion(dcterms:description goldbook:S05469 "An engineered burial of refuse. The refuse is dumped into trenches and compacted by bulldozer, where, it is hoped, aerobic metabolism by microorganisms decomposes the organic matter to stable compounds ($\\ce{H2O}$, $\\ce{CO2}$, etc.). Moisture is essential for the biological degradation and groundwater assists the process except when it fills air voids and prevents the transport of oxygen to the refuse. Land fills of unsatisfactory design can be major sources of air, water and soil pollution.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05469 goldbook:A00171)
AnnotationAssertion(rdfs:seeAlso goldbook:S05469 goldbook:M03858)
AnnotationAssertion(rdfs:seeAlso goldbook:S05469 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:S05469 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05469 "current"^^xsd:string)
Declaration(Class(goldbook:S05470))
AnnotationAssertion(rdfs:label goldbook:S05470 "saprophyte")
AnnotationAssertion(dcterms:description goldbook:S05470 "A microorganism that feeds on dead and decaying organic matter. Saprophytes excrete enzymes that digest organic residues externally, the low molecular weight compounds formed then being absorbed.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05470 goldbook:E02159)
AnnotationAssertion(rdfs:seeAlso goldbook:S05470 goldbook:M04000)
AnnotationAssertion(mito:isMentionedBy goldbook:S05470 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05470 "current"^^xsd:string)
Declaration(Class(goldbook:S05473))
AnnotationAssertion(rdfs:label goldbook:S05473 "saturation")
AnnotationAssertion(dcterms:description goldbook:S05473 "Of an irradiated element for a specified isotope, the steady state reached when the disintegration rate of the nuclide formed is equal to its production rate.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05473 goldbook:A00114)
AnnotationAssertion(rdfs:seeAlso goldbook:S05473 goldbook:N04257)
AnnotationAssertion(mito:isMentionedBy goldbook:S05473 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05473 "current"^^xsd:string)
Declaration(Class(goldbook:S05474))
AnnotationAssertion(rdfs:label goldbook:S05474 "saturation activity")
AnnotationAssertion(dcterms:description goldbook:S05474 "For a specified isotope, the value of the activity of an irradiated element, whence state of saturation is reached.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05474 goldbook:A00114)
AnnotationAssertion(rdfs:seeAlso goldbook:S05474 goldbook:I03331)
AnnotationAssertion(rdfs:seeAlso goldbook:S05474 goldbook:S05473)
AnnotationAssertion(mito:isMentionedBy goldbook:S05474 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05474 "current"^^xsd:string)
Declaration(Class(goldbook:S05476))
AnnotationAssertion(rdfs:label goldbook:S05476 "saturation fraction")
AnnotationAssertion(dcterms:description goldbook:S05476 "Amount-of-substance of a component (solute) in a solution divided by the amount-of-substance of the component when it is saturating the system at constant temperature and pressure. Also referred to simply as saturation, for example oxygen saturation.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05476 goldbook:S05472)
AnnotationAssertion(mito:isMentionedBy goldbook:S05476 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05476 "current"^^xsd:string)
Declaration(Class(goldbook:S05478))
AnnotationAssertion(rdfs:label goldbook:S05478 "saturation transfer")
AnnotationAssertion(dcterms:description goldbook:S05478 "A term used in nuclear magnetic resonance. When a nucleus is strongly irradiated, its spin population may partly be transferred to another nucleus by an exchange process.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05478 goldbook:M03692)
AnnotationAssertion(rdfs:seeAlso goldbook:S05478 goldbook:N04256)
AnnotationAssertion(rdfs:seeAlso goldbook:S05478 goldbook:R05326)
AnnotationAssertion(mito:isMentionedBy goldbook:S05478 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05478 "current"^^xsd:string)
Declaration(Class(goldbook:S05479))
AnnotationAssertion(rdfs:label goldbook:S05479 "saturation vapour pressure")
AnnotationAssertion(dcterms:description goldbook:S05479 "The pressure exerted by a pure substance (at a given temperature) in a system containing only the vapour and condensed phase (liquid or solid) of the substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:S05479 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05479 "current"^^xsd:string)
Declaration(Class(goldbook:S05480))
AnnotationAssertion(rdfs:label goldbook:S05480 "sawhorse projection")
AnnotationAssertion(dcterms:description goldbook:S05480 "A perspective formula indicating the spatial arrangement of bonds on two adjacent carbon atoms. The bond between the two atoms is represented by a diagonal line, the left-hand bottom end of which locates the atom nearer the observer and the right-hand top end the atom that is further away. In general a Newman or zig-zag projection is preferred.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05480 goldbook:N04134)
AnnotationAssertion(rdfs:seeAlso goldbook:S05480 goldbook:P04517)
