AnnotationAssertion(dcterms:description goldbook:12145 "Electrical stimulus applied across the skin to excite nerves for therapeutic purposes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:12145 "TENS")
AnnotationAssertion(rdfs:comment goldbook:12145 "Most often used to control pain."^^xsd:string)
