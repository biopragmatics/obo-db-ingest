[Term]
id: goldbook:M03974
name: molar activity
def: "For a specified isotope\, the activity of the compound divided by the amount of the material in moles\: \\\(A_\{\\rm\{m\}\}=\\frac\{A\}\{n\}\\\)."
property_value: mito:isMentionedBy doi:10.1351/pac199466122513
