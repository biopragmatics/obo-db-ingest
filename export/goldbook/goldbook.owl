    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.ST07574">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semi-interpenetrating polymer network prepared by a process in which the linear or branched components are formed following the completion of the reactions that lead to the formation of the network(s) or vice versa.</dcterms:description>
