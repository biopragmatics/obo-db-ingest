AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01649 "current"^^xsd:string)
Declaration(Class(goldbook:D01650))
AnnotationAssertion(rdfs:label goldbook:D01650 "deviation")
AnnotationAssertion(dcterms:description goldbook:D01650 "The difference between an observed value and the arithmetic mean of the set to which it belongs. It can be calculated by the formula: @D01650-1@")
AnnotationAssertion(mito:isMentionedBy goldbook:D01650 doi:10.1351/pac199466030595)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01650 "current"^^xsd:string)
Declaration(Class(goldbook:D01652))
AnnotationAssertion(rdfs:label goldbook:D01652 "dew point")
AnnotationAssertion(dcterms:description goldbook:D01652 "That temperature at which water vapour present in the atmosphere is just sufficient to saturate it. When air is cooled below the dew point, the excess of water vapour appears as tiny droplets or crystals of ice depending on the temperature of the air mass. This term is also applicable to acid gases as in the problem of acid corrosion and acid smut formation.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01652 goldbook:C01351)
AnnotationAssertion(mito:isMentionedBy goldbook:D01652 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01652 "current"^^xsd:string)
Declaration(Class(goldbook:D01653))
AnnotationAssertion(rdfs:label goldbook:D01653 "dew point hygrometer")
AnnotationAssertion(dcterms:description goldbook:D01653 "Instrument in which the sample is passed over a cooled surface. The temperature at which dew forms on the cooled surface is a function of the water content of the gas passing over the surface.")
AnnotationAssertion(mito:isMentionedBy goldbook:D01653 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01653 "current"^^xsd:string)
Declaration(Class(goldbook:D01654))
AnnotationAssertion(rdfs:label goldbook:D01654 "Dexter excitation transfer")
AnnotationAssertion(dcterms:description goldbook:D01654 "Excitation transfer occurring as a result of an electron exchange mechanism. It requires an overlap of the wavefunctions of the energy donor and the energy acceptor. It is the dominant mechanism in triplet-triplet energy transfer. The transfer rate constant, \\(k_{\\mathrm{ET}}\\), is given by: \\[k_{\\rm{ET}}\\propto \\frac{h}{2\\ \\pi }\\ P^{2}\\ J\\ \\rm{e}^{\\frac{-2\\ r}{L}}\\] where \\(r\\) is the distance between donor (D) and acceptor (A), \\(L\\) and \\(P\\) are constants not easily related to experimentally determinable quantities, and \\(J\\) is the spectral overlap integral. For this mechanism the spin conservation rules are obeyed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01654 "electron exchange excitation transfer")
AnnotationAssertion(rdfs:seeAlso goldbook:D01654 goldbook:E02256)
AnnotationAssertion(rdfs:seeAlso goldbook:D01654 goldbook:R05063)
AnnotationAssertion(rdfs:seeAlso goldbook:D01654 goldbook:O04322)
AnnotationAssertion(rdfs:seeAlso goldbook:D01654 goldbook:S05818)
AnnotationAssertion(rdfs:seeAlso goldbook:D01654 goldbook:T06506)
AnnotationAssertion(mito:isMentionedBy goldbook:D01654 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01654 "current"^^xsd:string)
Declaration(Class(goldbook:D01655))
AnnotationAssertion(rdfs:label goldbook:D01655 "dextrans")
AnnotationAssertion(dcterms:description goldbook:D01655 "Branched poly-$\\ce{\\upalpha\\!}$-ᴅ-glucosides of microbial origin having glycosidic bonds predominantly $\\ce{C-1\\!\\rightarrow\\!C-6}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01655 goldbook:G02661)
AnnotationAssertion(mito:isMentionedBy goldbook:D01655 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01655 "current"^^xsd:string)
Declaration(Class(goldbook:D01656))
AnnotationAssertion(rdfs:label goldbook:D01656 "dextrins")
AnnotationAssertion(dcterms:description goldbook:D01656 "Poly-$\\ce{\\upalpha\\!}$-ᴅ-glucosides of intermediate chain length derived from starch components (amylopectins) by the action of amylases (starch hydrolysing enzymes).")
AnnotationAssertion(rdfs:seeAlso goldbook:D01656 goldbook:C00956)
AnnotationAssertion(rdfs:seeAlso goldbook:D01656 goldbook:C01500)
AnnotationAssertion(rdfs:seeAlso goldbook:D01656 goldbook:D01655)
AnnotationAssertion(rdfs:seeAlso goldbook:D01656 goldbook:E02159)
AnnotationAssertion(mito:isMentionedBy goldbook:D01656 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01656 "current"^^xsd:string)
Declaration(Class(goldbook:D01658))
AnnotationAssertion(rdfs:label goldbook:D01658 "diabatic coupling")
AnnotationAssertion(dcterms:description goldbook:D01658 "Energy coupling between two potential-energy surfaces is sometimes known as diabatic coupling.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01658 goldbook:C01025)
AnnotationAssertion(mito:isMentionedBy goldbook:D01658 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01658 "current"^^xsd:string)
Declaration(Class(goldbook:D01659))
AnnotationAssertion(rdfs:label goldbook:D01659 "diabatic electron transfer")
AnnotationAssertion(dcterms:description goldbook:D01659 "Electron transfer process in which the reacting system has to cross over between different electronic surfaces in passing from reactants to products. For diabatic electron transfer the electronic transmission factor is ≪ 1 (see Marcus equation). The term 'non-adiabatic electron transfer' has also been used and is in fact more widespread, but should be discouraged because it contains a double negation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01659 "non-adiabatic electron transfer")
AnnotationAssertion(rdfs:seeAlso goldbook:D01659 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:D01659 goldbook:M03702)
AnnotationAssertion(rdfs:seeAlso goldbook:D01659 goldbook:A00142)
AnnotationAssertion(rdfs:seeAlso goldbook:D01659 goldbook:T06482)
AnnotationAssertion(mito:isMentionedBy goldbook:D01659 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01659 "current"^^xsd:string)
Declaration(Class(goldbook:D01660))
AnnotationAssertion(rdfs:label goldbook:D01660 "diabatic photoreaction")
AnnotationAssertion(dcterms:description goldbook:D01660 "Within the Born–Oppenheimer approximation, a reaction beginning on one excited state 'potential-energy surface' and ending, as a result of radiationless transition, on another surface, usually that of the ground state. Also called non-adiabatic.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01660 "nonadiabatic photoreaction")
AnnotationAssertion(rdfs:seeAlso goldbook:D01660 goldbook:A00141)
AnnotationAssertion(rdfs:seeAlso goldbook:D01660 goldbook:A00145)
AnnotationAssertion(rdfs:seeAlso goldbook:D01660 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:D01660 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:D01660 goldbook:R05057)
AnnotationAssertion(mito:isMentionedBy goldbook:D01660 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01660 "current"^^xsd:string)
Declaration(Class(goldbook:D01661))
AnnotationAssertion(rdfs:label goldbook:D01661 "diacylamines")
AnnotationAssertion(dcterms:description goldbook:D01661 "Compounds having two acyl groups substituted on ammonia or a primary amine acyl-NR-acyl. They are also known as secondary amides and, especially the cyclic examples derived from diacids, as imides, e.g. $\\ce{[RC(=O)]2NR}$, $\\ce{RS(=O)2NHC(=O)R}$ .")
AnnotationAssertion(rdfs:seeAlso goldbook:D01661 goldbook:A00123)
AnnotationAssertion(rdfs:seeAlso goldbook:D01661 goldbook:A00266)
AnnotationAssertion(rdfs:seeAlso goldbook:D01661 goldbook:I02948)
AnnotationAssertion(mito:isMentionedBy goldbook:D01661 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01661 "current"^^xsd:string)
Declaration(Class(goldbook:D01663))
AnnotationAssertion(rdfs:label goldbook:D01663 "diagram level")
AnnotationAssertion(dcterms:description goldbook:D01663 "A level described by the removal of one electron from the configuration of the neutral ground state. These levels form a spectrum similar to that of a one-electron or hydrogen-like atom but, being single-valency levels, have the energy scale reversed relative to that of single-electron levels. Diagram levels may be divided into valence levels and core levels according to the nature of the electron vacancy. Diagram levels with orbital angular momentum different from zero occur in pairs and form spin doublets.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01663 goldbook:A00353)
AnnotationAssertion(rdfs:seeAlso goldbook:D01663 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:D01663 goldbook:V06588)
AnnotationAssertion(mito:isMentionedBy goldbook:D01663 doi:10.1351/pac199163050735)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01663 "current"^^xsd:string)
Declaration(Class(goldbook:D01665))
AnnotationAssertion(rdfs:label goldbook:D01665 "dialysate")
AnnotationAssertion(dcterms:description goldbook:D01665 "After (complete or incomplete) dialysis two solutions are obtained. The one free from colloidal material is called dialysate; the other one, containing the colloidal particles may be called retentate, dialysis residue, or simply residue, but should not be called dialysate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01665 "dialysis residue")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01665 "residue")
AnnotationAssertion(rdfs:seeAlso goldbook:D01665 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:D01665 goldbook:D01666)
AnnotationAssertion(rdfs:seeAlso goldbook:D01665 goldbook:10289)
AnnotationAssertion(mito:isMentionedBy goldbook:D01665 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01665 "current"^^xsd:string)
Declaration(Class(goldbook:D01666))
AnnotationAssertion(rdfs:label goldbook:D01666 "dialysis")
AnnotationAssertion(dcterms:description goldbook:D01666 "The process of separating a colloidal sol from a colloid-free solution by a membrane permeable to all components of the system except the colloidal ones, and allowing the exchange of the components of small molar mass to proceed for a certain time.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01666 goldbook:C01171)
AnnotationAssertion(rdfs:seeAlso goldbook:D01666 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:D01666 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:D01666 goldbook:S05727)
AnnotationAssertion(mito:isMentionedBy goldbook:D01666 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01666 "current"^^xsd:string)
Declaration(Class(goldbook:D01668))
AnnotationAssertion(rdfs:label goldbook:D01668 "diamagnetic")
AnnotationAssertion(dcterms:description goldbook:D01668 "Substances having a negative magnetic susceptibility are diamagnetic. They are repelled out of a magnetic field.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01668 goldbook:M03689)
AnnotationAssertion(rdfs:seeAlso goldbook:D01668 goldbook:P04404)
AnnotationAssertion(mito:isMentionedBy goldbook:D01668 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01668 "current"^^xsd:string)
Declaration(Class(goldbook:D01670))
AnnotationAssertion(rdfs:label goldbook:D01670 "diamidides")
AnnotationAssertion(dcterms:description goldbook:D01670 "Analogues of acyclic carboxylic acid anhydrides in which $\\ce{=O}$ has been replaced by $\\ce{=NR}$ and $\\ce{–O–}$ by $\\ce{–NR–}$: $\\ce{RC(=NR)NRC(=NR)R}$, N-imidoyl amidines. The name 1,3,5-triazapentadienes is sometimes applied as a class name to diamidides.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01670 goldbook:A00072)
AnnotationAssertion(rdfs:seeAlso goldbook:D01670 goldbook:A00267)
AnnotationAssertion(rdfs:seeAlso goldbook:D01670 goldbook:I02950)
AnnotationAssertion(mito:isMentionedBy goldbook:D01670 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01670 "current"^^xsd:string)
Declaration(Class(goldbook:D01671))
AnnotationAssertion(rdfs:label goldbook:D01671 "diamond")
AnnotationAssertion(dcterms:description goldbook:D01671 "An allotropic form of the element carbon with cubic structure (space group \\(O_{h}^{7}- Fd3m\\)) which is thermodynamically stable at pressures above \\(6\\ \\rm{GPa}\\) at room temperature and metastable at atmospheric pressure. At low pressures diamond converts rapidly to graphite at temperatures above \\(1900\\ \\rm{K}\\) in an inert atmosphere. The chemical bonding between the carbon atoms is covalent with \\(\\mathrm{sp}^{3}\\) hybridization.")
AnnotationAssertion(rdfs:comment goldbook:D01671 "There is also a hexagonal diamond-like structure of the element carbon (lonsdaleite)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:D01671 goldbook:C00821)
AnnotationAssertion(rdfs:seeAlso goldbook:D01671 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:D01671 goldbook:H02874)
AnnotationAssertion(rdfs:seeAlso goldbook:D01671 goldbook:I03026)
AnnotationAssertion(rdfs:seeAlso goldbook:D01671 goldbook:M03872)
AnnotationAssertion(rdfs:seeAlso goldbook:D01671 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:D01671 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01671 "current"^^xsd:string)
Declaration(Class(goldbook:D01672))
AnnotationAssertion(rdfs:label goldbook:D01672 "diamond by CVD")
AnnotationAssertion(dcterms:description goldbook:D01672 "Diamond by CVD (chemical vapour deposition) is formed as crystals or as films from various gaseous hydrocarbons or other organic molecules in the presence of activated, atomic hydrogen. It consists of \\(\\rm{sp}^{3}\\)-hybridized carbon atoms with the three-dimensional crystalline structure of the diamond lattice.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:D01672 "CVD")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01672 "CVD diamond")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01672 "low-pressure diamond")
AnnotationAssertion(rdfs:comment goldbook:D01672 "'CVD diamond' or 'low-pressure diamond' are synonyms of the term diamond by CVD. diamond by CVD can be prepared in a variety of ways. Deposition parameters are: total (low) pressure, partial hydrogen pressure, precursor molecules in the gas phase, temperature for activation of the hydrogen and that of the surface of the underlying substrate. The energy supply for the hydrogen activation may be, for instance: heat, radio frequency, microwave excitation (plasma deposition) or accelerated ions (e.g. $\\ce{Ar^{+}}$ ions). CVD diamond has also been obtained at atmospheric pressure from oxyacetylene torches and by other flame-based methods. Often CVD carbon films consist of a mixture of \\(\\rm{sp}^{2}\\)- and \\(\\rm{sp}^{3}\\)-hybridized carbon atoms and do not have the three-dimensional structure of the diamond lattice. In this case they should be called hard amorphous carbon or diamond-like carbon films."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:D01672 goldbook:A00093)
AnnotationAssertion(rdfs:seeAlso goldbook:D01672 goldbook:D01671)
AnnotationAssertion(rdfs:seeAlso goldbook:D01672 goldbook:D01673)
AnnotationAssertion(rdfs:seeAlso goldbook:D01672 goldbook:H02741)
AnnotationAssertion(rdfs:seeAlso goldbook:D01672 goldbook:H02889)
AnnotationAssertion(mito:isMentionedBy goldbook:D01672 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01672 "current"^^xsd:string)
Declaration(Class(goldbook:D01673))
AnnotationAssertion(rdfs:label goldbook:D01673 "diamond-like carbon films")
AnnotationAssertion(dcterms:description goldbook:D01673 "Diamond-like carbon (DLC) films are hard, amorphous films with a significant fraction of \\(\\mathrm{sp}^{3}\\)-hybridized carbon atoms and which can contain a significant amount of hydrogen. Depending on the deposition conditions, these films can be fully amorphous or contain diamond crystallites. These materials are not called diamond unless a full three-dimensional crystalline lattice of diamond is proven.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:D01673 "DLC")
AnnotationAssertion(rdfs:comment goldbook:D01673 "Diamond-like films without hydrogen can be prepared by carbon ion beam deposition, ion-assisted sputtering from graphite or by laser ablation of graphite. Diamond-like carbon films containing significant contents of hydrogen are prepared by chemical vapour deposition. The hydrogen content is usually over 25 atomic %. The deposition parameters are (low) total pressure, hydrogen partial pressure, precursor molecules and plasma ionization. The plasma activation can be radio frequency, microwave or $\\ce{Ar^{+}}$ ions. High ionization favours amorphous films while high atomic hydrogen contents favour Diamond crystallite formation. Because of the confusion about structure engendered by the term Diamond-like carbon films, the term hard amorphous carbon films has been suggested as a synonym."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:A00093)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:D01671)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:H02741)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:I03183)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:L03459)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:P04420)
AnnotationAssertion(rdfs:seeAlso goldbook:D01673 goldbook:S05895)
AnnotationAssertion(mito:isMentionedBy goldbook:D01673 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01673 "current"^^xsd:string)
Declaration(Class(goldbook:D01674))
AnnotationAssertion(rdfs:label goldbook:D01674 "dianions")
AnnotationAssertion(dcterms:description goldbook:D01674 "Molecular entities bearing two negative charges, which may be located on a single atom or on different atoms or may be delocalized.")
AnnotationAssertion(mito:isMentionedBy goldbook:D01674 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01674 "current"^^xsd:string)
Declaration(Class(goldbook:D01675))
AnnotationAssertion(rdfs:label goldbook:D01675 "diastereoisomer excess")
AnnotationAssertion(dcterms:description goldbook:D01675 "This is defined by analogy with enantiomeric excess, as \\(D_{1}- D_{2}\\) [and the percent diastereoisomer excess as \\(100\\ (D_{1}-D_{2})\\)], where the mole fractions of two diastereoisomers in a mixture or the fractional yields of two diastereoisomers formed in a reaction are \\(D_{1}\\) and \\(D_{2}\\) (\\(D_{1}+D_{2}=1\\)). The term is not applicable if more than two diastereoisomers are present. Frequently this term is abbreviated to \\(\\rm{d.e.}\\)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01675 "diastereoisomeric excess")
AnnotationAssertion(rdfs:seeAlso goldbook:D01675 goldbook:D01679)
AnnotationAssertion(rdfs:seeAlso goldbook:D01675 goldbook:E02070)
AnnotationAssertion(rdfs:seeAlso goldbook:D01675 goldbook:M03980)
AnnotationAssertion(rdfs:seeAlso goldbook:D01675 goldbook:S05991)
AnnotationAssertion(mito:isMentionedBy goldbook:D01675 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01675 "current"^^xsd:string)
Declaration(Class(goldbook:D01678))
AnnotationAssertion(rdfs:label goldbook:D01678 "diastereoisomerization")
AnnotationAssertion(dcterms:description goldbook:D01678 "The interconversion of diastereoisomers.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01678 goldbook:D01679)
AnnotationAssertion(mito:isMentionedBy goldbook:D01678 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01678 "current"^^xsd:string)
Declaration(Class(goldbook:D01679))
AnnotationAssertion(rdfs:label goldbook:D01679 "diastereoisomerism")
AnnotationAssertion(dcterms:description goldbook:D01679 "Stereoisomerism other than enantiomerism. Diastereoisomers (or diastereomers) are stereoisomers not related as mirror images. Diastereoisomers are characterized by differences in physical properties, and by some differences in chemical behaviour towards achiral as well as chiral reagents.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01679 goldbook:S05983)
AnnotationAssertion(rdfs:seeAlso goldbook:D01679 goldbook:A00069)
AnnotationAssertion(rdfs:seeAlso goldbook:D01679 goldbook:C01057)
AnnotationAssertion(rdfs:seeAlso goldbook:D01679 goldbook:E02078)
AnnotationAssertion(rdfs:seeAlso goldbook:D01679 goldbook:S05984)
AnnotationAssertion(mito:isMentionedBy goldbook:D01679 doi:10.1351/pac199466051077)
AnnotationAssertion(mito:isMentionedBy goldbook:D01679 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01679 "current"^^xsd:string)
Declaration(Class(goldbook:D01681))
AnnotationAssertion(rdfs:label goldbook:D01681 "diastereomeric ratio")
AnnotationAssertion(dcterms:description goldbook:D01681 "This is defined by analogy with enantiomeric ratio as the ratio of the percentage of one diastereoisomer in a mixture to that of the other.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01681 goldbook:D01679)
AnnotationAssertion(rdfs:seeAlso goldbook:D01681 goldbook:E02075)
