AnnotationAssertion(rdfs:label goldbook:11884 "motor coordination")
AnnotationAssertion(dcterms:description goldbook:11884 "Cooperation of the motor neurons and the involved muscles to perform a body movement precisely according to spatiotemporal requirements.")
AnnotationAssertion(rdfs:comment goldbook:11884 "Motor coordination involves signals from the organ of equilibrium, the visual system and the cerebellum as well as other neural inputs."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11884 "Impaired coordination results in ataxia."^^xsd:string)
