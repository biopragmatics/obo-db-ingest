[Term]
id: goldbook:I03161
name: ion collector
def: "Device for the capture of selected ions such as a Faraday cup collector \(with a d.c. amplifier\) or an electron multiplier."
property_value: mito:isMentionedBy doi:10.1351/pac199062112167
property_value: hasStatus "current" xsd:string
