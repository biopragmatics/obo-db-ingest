AnnotationAssertion(rdfs:label goldbook:12184 "wrist drop")
AnnotationAssertion(dcterms:description goldbook:12184 "Inability to extend the wrist as a result of peripheral nerve damage, causing drooping of the hand.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12184 "radial nerve palsy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12184 "Teleky’s sign")
AnnotationAssertion(rdfs:comment goldbook:12184 "When associated with the effects of lead poisoning on the radial nerve, it is called Teleky’s sign."^^xsd:string)
