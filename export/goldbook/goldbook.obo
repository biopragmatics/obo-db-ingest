property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15465
name: antimuscarinic
def: "n.\, Substance inhibiting or preventing the actions of muscarine and muscarine-like agents \(e.g.\, atropine\) on the muscarinic acetylcholine receptors. adj.\, Inhibiting or preventing the actions of muscarine and muscarine-like agents on the muscarinic acetylcholine receptors."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15466
