        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Posterior lobe of the pituitary gland, involved in the storage and secretion of oxytocin and vasopressin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
