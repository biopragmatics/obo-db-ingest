property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:14911
name: photoperiod
def: "The duration of illumination and darkness over a \\\(\\pu\{24\\!\\mbox\{-\}h\}\\\) day."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-08-07-09
