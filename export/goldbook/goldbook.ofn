Declaration(Class(goldbook:S05703))
AnnotationAssertion(rdfs:label goldbook:S05703 "sink")
AnnotationAssertion(dcterms:description goldbook:S05703 "The receptor for material which is removed from the atmosphere. Because of long range transport of many pollutants such as $\\ce{SO2}$, sulfuric acid and its salts, the sink region can be many hundreds of kilometres from the source region of the pollutants.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05703 goldbook:RT06841)
AnnotationAssertion(mito:isMentionedBy goldbook:S05703 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05703 "current"^^xsd:string)
Declaration(Class(goldbook:S05704))
AnnotationAssertion(rdfs:label goldbook:S05704 "sintering")
AnnotationAssertion(dcterms:description goldbook:S05704 "Temperature-induced coalescence and densification of porous solid particles below the melting points of their major components.")
AnnotationAssertion(rdfs:comment goldbook:S05704 "The term was originally coined for the process by which fly ash produced in combustion of fuels such as coal is baked at a very high temperature. The sintered material is used in the manufacture of cinder blocks and other ceramic products."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05704 "Modified from previous definition. The definition proposed here is recommended as being more explicit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05704 goldbook:CT07540)
AnnotationAssertion(rdfs:seeAlso goldbook:S05704 goldbook:DT07618)
AnnotationAssertion(rdfs:seeAlso goldbook:S05704 goldbook:M03821)
AnnotationAssertion(mito:isMentionedBy goldbook:S05704 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05704 "current"^^xsd:string)
