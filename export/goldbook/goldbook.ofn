Declaration(Class(goldbook:13174))
AnnotationAssertion(rdfs:label goldbook:13174 "glomerulonephritis")
AnnotationAssertion(dcterms:description goldbook:13174 "Any of a group of kidney diseases involving inflammation of the renal glomeruli, often as a result of antibody–antigen complexes that localize in the kidney.")
AnnotationAssertion(rdfs:comment goldbook:13174 "Acute nephritis is marked by blood in the urine."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13174 goldbook:13506)
AnnotationAssertion(mito:isMentionedBy goldbook:13174 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13174 "current"^^xsd:string)
Declaration(Class(goldbook:13175))
AnnotationAssertion(rdfs:label goldbook:13175 "glomerulonephropathy")
AnnotationAssertion(dcterms:description goldbook:13175 "Disease of the renal glomeruli, which may show either thickening of the glomerular basement membrane due to the accretion of proteins or a minimal change disease, in which there is functional damage but little structural change by light microscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13175 "glomerulopathy")
AnnotationAssertion(mito:isMentionedBy goldbook:13175 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13175 "current"^^xsd:string)
Declaration(Class(goldbook:13176))
AnnotationAssertion(rdfs:label goldbook:13176 "glutamic acid decarboxylase")
AnnotationAssertion(dcterms:description goldbook:13176 "Main autoantigen in diabetes mellitus type 1 and stiff-person syndrome (a neurological autoimmune disease).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13176 "GAD")
AnnotationAssertion(rdfs:comment goldbook:13176 "GAD is localized in pancreatic \\(\\ce{\\upbeta\\ cells}\\) and γ-aminobutyric acid-responsive (GABAergic) neurons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13176 goldbook:12914)
AnnotationAssertion(rdfs:seeAlso goldbook:13176 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13176 goldbook:13092)
