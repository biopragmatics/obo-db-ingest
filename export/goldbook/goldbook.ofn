AnnotationAssertion(dcterms:description goldbook:09434 "Image resolution in secondary ion mass spectrometry obtained in practice.")
Declaration(Class(goldbook:09435))
AnnotationAssertion(rdfs:label goldbook:09435 "absorption length")
