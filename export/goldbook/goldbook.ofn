AnnotationAssertion(rdfs:label goldbook:11406 "applicability domain")
AnnotationAssertion(dcterms:description goldbook:11406 "The property or structure space for which the predictions of a computational model are considered to be reliable.")
AnnotationAssertion(mito:isMentionedBy goldbook:11406 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11406 "current"^^xsd:string)
Declaration(Class(goldbook:11407))
AnnotationAssertion(rdfs:label goldbook:11407 "area under the curve")
AnnotationAssertion(dcterms:description goldbook:11407 "The area under a graph curve, such as the number of actives identified by an algorithm as a function of the number of compounds tested, commonly used as a  measure of the discriminating ability of an algorithm to correctly classify a test molecule.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11407 "AUC")
AnnotationAssertion(rdfs:comment goldbook:11407 "In pharmacokinetics AUC is the area under the plot of plasma concentration versus time, which is used to evaluate drug exposure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11407 goldbook:11502)
AnnotationAssertion(rdfs:seeAlso goldbook:11407 goldbook:11405)
AnnotationAssertion(mito:isMentionedBy goldbook:11407 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11407 "current"^^xsd:string)
Declaration(Class(goldbook:11408))
AnnotationAssertion(rdfs:label goldbook:11408 "autocorrelation vector")
AnnotationAssertion(dcterms:description goldbook:11408 "A vector that describes a molecular structure in which each element corresponds to a distance (number of bonds in a 2D structure or a binned interatomic  distance in a 3D structure) between atoms of a particular type and the count of the number of times that distance is found in the structure.")
AnnotationAssertion(rdfs:seeAlso goldbook:11408 goldbook:11398)
AnnotationAssertion(mito:isMentionedBy goldbook:11408 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11408 "current"^^xsd:string)
Declaration(Class(goldbook:11409))
AnnotationAssertion(rdfs:label goldbook:11409 "basis set superposition error")
AnnotationAssertion(dcterms:description goldbook:11409 "An artifactual increase in calculated stability of the supersystem (the system formed by noncovalent interaction between two or more molecular entities, e.g. hydrogen bond system) resulting from the basis set of the supersystem being larger than for the component subsystems. The BSSE arises from a lowering of the quantum mechanical energy when the electron density of each subsystem spreads into the basis functions provided by the other subsystems.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11409 "BSSE")
AnnotationAssertion(mito:isMentionedBy goldbook:11409 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11409 "current"^^xsd:string)
Declaration(Class(goldbook:11410))
AnnotationAssertion(rdfs:label goldbook:11410 "Bayesian regularized neural network")
AnnotationAssertion(dcterms:description goldbook:11410 "A feed-forward neural network that uses Bayesian statistics to optimize the complexity and predictive power of the model.")
AnnotationAssertion(rdfs:seeAlso goldbook:11410 goldbook:11411)
AnnotationAssertion(mito:isMentionedBy goldbook:11410 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11410 "current"^^xsd:string)
Declaration(Class(goldbook:11411))
AnnotationAssertion(rdfs:label goldbook:11411 "Bayesian statistics")
AnnotationAssertion(dcterms:description goldbook:11411 "A branch of statistics in which the evidence of the state of a system is expressed in terms of degrees of belief (probabilities).")
AnnotationAssertion(mito:isMentionedBy goldbook:11411 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11411 "current"^^xsd:string)
Declaration(Class(goldbook:11412))
AnnotationAssertion(rdfs:label goldbook:11412 "Bayes’s theorem")
AnnotationAssertion(dcterms:description goldbook:11412 "A method for calculating prior probability estimates of an event that can be revised in accordance with new observations.")
AnnotationAssertion(rdfs:seeAlso goldbook:11412 goldbook:11496)
AnnotationAssertion(mito:isMentionedBy goldbook:11412 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11412 "current"^^xsd:string)
Declaration(Class(goldbook:11413))
AnnotationAssertion(rdfs:label goldbook:11413 "belief theory")
AnnotationAssertion(dcterms:description goldbook:11413 "A method to combine probability estimate states that given two or more probabilities \\(P_{i}\\) that a particular event is true, the combined probability of the event is given by: \\[P = 1 - \\Pi (1 - {P_{i}})\\]")
AnnotationAssertion(mito:isMentionedBy goldbook:11413 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11413 "current"^^xsd:string)
Declaration(Class(goldbook:11414))
AnnotationAssertion(rdfs:label goldbook:11414 "bilinear equation")
AnnotationAssertion(dcterms:description goldbook:11414 "A QSAR equation that describes the non-linear dependence of the relative biological potency (\\(\\log 1/C\\)) of a molecule on log P by the following form: \\[log(1/{C_i}) = a\\log P_{i} - b \\log (\\beta P_{i} + 1) + c\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:11414 goldbook:11452)
AnnotationAssertion(rdfs:seeAlso goldbook:11414 goldbook:11469)
AnnotationAssertion(mito:isMentionedBy goldbook:11414 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11414 "current"^^xsd:string)
Declaration(Class(goldbook:11415))
AnnotationAssertion(rdfs:label goldbook:11415 "bit string")
AnnotationAssertion(dcterms:description goldbook:11415 "A description of a molecule in a fixed length vector, each element of which is set from corresponding structural keys or calculated by hashing a molecular  fingerprint.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11415 "bitmap")
AnnotationAssertion(rdfs:seeAlso goldbook:11415 goldbook:11454)
AnnotationAssertion(rdfs:seeAlso goldbook:11415 goldbook:11474)
AnnotationAssertion(rdfs:seeAlso goldbook:11415 goldbook:11519)
AnnotationAssertion(mito:isMentionedBy goldbook:11415 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11415 "current"^^xsd:string)
Declaration(Class(goldbook:11416))
AnnotationAssertion(rdfs:label goldbook:11416 "Boltzmann enhanced discrimination of receiver operating characteristic")
AnnotationAssertion(dcterms:description goldbook:11416 "A generalization of the area under the ROC curve to weight more heavily the early recognition of active compounds.")
AnnotationAssertion(rdfs:seeAlso goldbook:11416 goldbook:11502)
AnnotationAssertion(mito:isMentionedBy goldbook:11416 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11416 "current"^^xsd:string)
Declaration(Class(goldbook:11417))
AnnotationAssertion(rdfs:label goldbook:11417 "bootstrap resampling")
AnnotationAssertion(dcterms:description goldbook:11417 "A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from many models developed using sample sets that contain the same number of observations as the original set, but for which certain observations are randomly omitted and other observations are included more than once.")
AnnotationAssertion(rdfs:seeAlso goldbook:11417 goldbook:11499)
AnnotationAssertion(rdfs:seeAlso goldbook:11417 goldbook:11458)
AnnotationAssertion(mito:isMentionedBy goldbook:11417 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11417 "current"^^xsd:string)
Declaration(Class(goldbook:11418))
AnnotationAssertion(rdfs:label goldbook:11418 "calculated molar refractivity")
AnnotationAssertion(dcterms:description goldbook:11418 "The calculated molar refractivity of a molecule or substituent used as a measure of size and polarizability in 2D-QSAR.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11418 "CMR")
AnnotationAssertion(rdfs:seeAlso goldbook:11418 goldbook:11399)
AnnotationAssertion(mito:isMentionedBy goldbook:11418 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11418 "current"^^xsd:string)
Declaration(Class(goldbook:11419))
AnnotationAssertion(rdfs:label goldbook:11419 "canonical structure representation")
AnnotationAssertion(dcterms:description goldbook:11419 "A unique representation of the chemical structure of a molecule that is independent of the sequence in which the atoms were ordered in the original input file  but is dependent on the algorithm used for the canonicalization.")
AnnotationAssertion(rdfs:comment goldbook:11419 "This representation is used to ensure the uniqueness of molecules in a database and to assist identification of molecules in internet searches."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11419 "At least one canonicalization algorithm exists for any type of structure file that is the basis of a structure search system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11419 goldbook:11405)
AnnotationAssertion(mito:isMentionedBy goldbook:11419 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11419 "current"^^xsd:string)
Declaration(Class(goldbook:11420))
AnnotationAssertion(rdfs:label goldbook:11420 "chance correlation")
AnnotationAssertion(dcterms:description goldbook:11420 "An artificial correlation that can arise when too many properties are screened relative to the number of available observations.")
AnnotationAssertion(mito:isMentionedBy goldbook:11420 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11420 "current"^^xsd:string)
Declaration(Class(goldbook:11421))
AnnotationAssertion(rdfs:label goldbook:11421 "cheminformatics")
AnnotationAssertion(dcterms:description goldbook:11421 "The science of handling, indexing, archiving, searching, and evaluating information that is specific to chemical structures and is used in data mining,  information retrieval, information extraction, and machine learning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11421 "chemoinformatics")
AnnotationAssertion(rdfs:seeAlso goldbook:11421 goldbook:11431)
AnnotationAssertion(rdfs:seeAlso goldbook:11421 goldbook:11470)
AnnotationAssertion(mito:isMentionedBy goldbook:11421 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11421 "current"^^xsd:string)
Declaration(Class(goldbook:11422))
AnnotationAssertion(rdfs:label goldbook:11422 "circular fingerprints")
AnnotationAssertion(dcterms:description goldbook:11422 "Hashed molecular fingerprints that describe, either by atom type or properties, each atom in the molecule; the atoms connected to it (for path length 2); the  atoms connected to them (for path length 4); and the atoms connected to them (for path length 6); etc..")
AnnotationAssertion(rdfs:seeAlso goldbook:11422 goldbook:11474)
AnnotationAssertion(rdfs:seeAlso goldbook:11422 goldbook:11483)
AnnotationAssertion(rdfs:seeAlso goldbook:11422 goldbook:11519)
AnnotationAssertion(mito:isMentionedBy goldbook:11422 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11422 "current"^^xsd:string)
Declaration(Class(goldbook:11423))
AnnotationAssertion(rdfs:label goldbook:11423 "clog P")
AnnotationAssertion(dcterms:description goldbook:11423 "Calculated log of the octan-1-ol/water partition coefficient.")
AnnotationAssertion(mito:isMentionedBy goldbook:11423 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11423 "current"^^xsd:string)
Declaration(Class(goldbook:11424))
AnnotationAssertion(rdfs:label goldbook:11424 "cluster centroid")
AnnotationAssertion(dcterms:description goldbook:11424 "The geometric center of a cluster, often exemplified as the object that is closest to the center.")
AnnotationAssertion(mito:isMentionedBy goldbook:11424 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11424 "current"^^xsd:string)
Declaration(Class(goldbook:11425))
AnnotationAssertion(rdfs:label goldbook:11425 "collinearity")
AnnotationAssertion(dcterms:description goldbook:11425 "A linear relationship between two or more of the descriptors in a model, which can lead to difficulties in interpreting the relative importance of these  descriptors.")
AnnotationAssertion(mito:isMentionedBy goldbook:11425 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11425 "current"^^xsd:string)
Declaration(Class(goldbook:11426))
AnnotationAssertion(rdfs:label goldbook:11426 "comparative molecular similarity analysis")
AnnotationAssertion(dcterms:description goldbook:11426 "A 3D-QSAR method similar to CoMFA that instead uses Gaussian-type functions to calculate the 3D properties of the molecules by the similarity of each molecule  to each probe at each lattice position surrounding the molecules.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11426 "CoMSIA")
AnnotationAssertion(rdfs:seeAlso goldbook:11426 goldbook:11400)
AnnotationAssertion(mito:isMentionedBy goldbook:11426 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11426 "current"^^xsd:string)
Declaration(Class(goldbook:11427))
AnnotationAssertion(rdfs:label goldbook:11427 "concordance")
AnnotationAssertion(dcterms:description goldbook:11427 "The ability of a two-group classification model to correctly classify all molecules.")
AnnotationAssertion(mito:isMentionedBy goldbook:11427 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11427 "current"^^xsd:string)
Declaration(Class(goldbook:11428))
AnnotationAssertion(rdfs:label goldbook:11428 "confusion matrix")
AnnotationAssertion(dcterms:description goldbook:11428 "A table layout that shows the results of a two-class/binary classifier in which columns correspond to the predicted classifications from the model and rows correspond to the observed classifications.")
AnnotationAssertion(rdfs:comment goldbook:11428 "A confusion matrix highlights the numbers of true positives TP (positives classified as positive), true negatives TN (negatives classified as negative), false positives FP (negatives classified as positive) and false negatives FN (positives classified as negatives)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11428 goldbook:11444)
AnnotationAssertion(rdfs:seeAlso goldbook:11428 goldbook:11445)
AnnotationAssertion(rdfs:seeAlso goldbook:11428 goldbook:11527)
AnnotationAssertion(rdfs:seeAlso goldbook:11428 goldbook:11528)
AnnotationAssertion(mito:isMentionedBy goldbook:11428 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11428 "current"^^xsd:string)
Declaration(Class(goldbook:11429))
AnnotationAssertion(rdfs:label goldbook:11429 "continuum")
AnnotationAssertion(dcterms:description goldbook:11429 "The computational representation of a solvent as a continuous medium instead of individual explicit solvent molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:11429 goldbook:11489)
AnnotationAssertion(rdfs:seeAlso goldbook:11429 goldbook:11442)
AnnotationAssertion(mito:isMentionedBy goldbook:11429 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11429 "current"^^xsd:string)
Declaration(Class(goldbook:11430))
AnnotationAssertion(rdfs:label goldbook:11430 "counterpoise correction")
AnnotationAssertion(dcterms:description goldbook:11430 "A method to correct for basis set superposition error.")
AnnotationAssertion(rdfs:seeAlso goldbook:11430 goldbook:11409)
AnnotationAssertion(mito:isMentionedBy goldbook:11430 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11430 "current"^^xsd:string)
Declaration(Class(goldbook:11431))
AnnotationAssertion(rdfs:label goldbook:11431 "data mining")
AnnotationAssertion(dcterms:description goldbook:11431 "The extraction of useful information from large sets of observations.")
AnnotationAssertion(mito:isMentionedBy goldbook:11431 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11431 "current"^^xsd:string)
Declaration(Class(goldbook:11432))
AnnotationAssertion(rdfs:label goldbook:11432 "Daylight fingerprints")
AnnotationAssertion(dcterms:description goldbook:11432 "Path fingerprints that are generated from a structure where atoms are described by atomic number and aromaticity; bonds are described as single, double,  triple, or aromatic; and the results are hashed into a bit string of fixed length.")
AnnotationAssertion(rdfs:comment goldbook:11432 "Although these fingerprints were originally described by Daylight CIS, many other investigators have also implemented them."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11432 goldbook:11483)
AnnotationAssertion(rdfs:seeAlso goldbook:11432 goldbook:11454)
AnnotationAssertion(mito:isMentionedBy goldbook:11432 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11432 "current"^^xsd:string)
Declaration(Class(goldbook:11433))
AnnotationAssertion(rdfs:label goldbook:11433 "de novo design")
AnnotationAssertion(dcterms:description goldbook:11433 "The process whereby a computer algorithm designs new molecules to meet certain single or multiple criteria, defined by an objective function, for example predicted affinity for a binding site or predicted affinity plus appropriate lipophilicity.")
AnnotationAssertion(rdfs:seeAlso goldbook:11433 goldbook:11405)
AnnotationAssertion(mito:isMentionedBy goldbook:11433 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11433 "current"^^xsd:string)
Declaration(Class(goldbook:11434))
AnnotationAssertion(rdfs:label goldbook:11434 "decision tree")
AnnotationAssertion(dcterms:description goldbook:11434 "The result of a recursive partitioning classification method that shows at each branching point the value of the property responsible for the split and the resulting classifications after the split.")
AnnotationAssertion(rdfs:seeAlso goldbook:11434 goldbook:11503)
AnnotationAssertion(mito:isMentionedBy goldbook:11434 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11434 "current"^^xsd:string)
Declaration(Class(goldbook:11435))
AnnotationAssertion(rdfs:label goldbook:11435 "density functional theory")
AnnotationAssertion(dcterms:description goldbook:11435 "A quantum mechanical modeling method used to investigate the electronic structure of molecules using functionals that describe the spatially dependent electron density, rather than the wavefunction as in ab initio and semi-empirical quantum chemical methods.")
AnnotationAssertion(mito:isMentionedBy goldbook:11435 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11435 "current"^^xsd:string)
Declaration(Class(goldbook:11436))
AnnotationAssertion(rdfs:label goldbook:11436 "descriptor")
AnnotationAssertion(dcterms:description goldbook:11436 "A qualitative or quantitative property of a molecule or a part of a molecule.")
AnnotationAssertion(mito:isMentionedBy goldbook:11436 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11436 "current"^^xsd:string)
Declaration(Class(goldbook:11437))
AnnotationAssertion(rdfs:label goldbook:11437 "docking")
AnnotationAssertion(dcterms:description goldbook:11437 "Computational methods that optimize the placement of a ligand in a macromolecular binding site of known or proposed 3D structure and provide a score as to the quality of the fit.")
AnnotationAssertion(rdfs:comment goldbook:11437 "Docking programs differ as to whether conformational and chemical (tautomer, protomer) changes in the binding site are allowed and if only precalculated conformations of the ligand are used or if ligand flexibility is part of the docking."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11437 goldbook:11495)
AnnotationAssertion(mito:isMentionedBy goldbook:11437 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11437 "current"^^xsd:string)
Declaration(Class(goldbook:11438))
AnnotationAssertion(rdfs:label goldbook:11438 "drug-likeness")
AnnotationAssertion(dcterms:description goldbook:11438 "An estimate of the probability that a chemical structure is similar to known drugs based on chemical or physical properties.")
AnnotationAssertion(mito:isMentionedBy goldbook:11438 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11438 "current"^^xsd:string)
Declaration(Class(goldbook:11439))
AnnotationAssertion(rdfs:label goldbook:11439 "energy of the highest occupied molecular orbital")
AnnotationAssertion(dcterms:description goldbook:11439 "The energy of the highest energy level in the ground state of a molecule that contains electrons, sometimes used as a measure of nucleophilicity in QSAR  models.")
AnnotationAssertion(mito:isMentionedBy goldbook:11439 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11439 "current"^^xsd:string)
Declaration(Class(goldbook:11440))
AnnotationAssertion(rdfs:label goldbook:11440 "energy of the lowest unoccupied molecular orbital")
AnnotationAssertion(dcterms:description goldbook:11440 "The energy of the lowest energy level of a molecule that contains no electrons in the ground state, sometimes used as a measure of electrophilicity in QSAR  models.")
AnnotationAssertion(rdfs:comment goldbook:11440 "Also known as the energy of the lowest empty molecular orbital, \\(E_{\\rm{LEMO}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11440 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11440 "current"^^xsd:string)
Declaration(Class(goldbook:11441))
AnnotationAssertion(rdfs:label goldbook:11441 "expert system")
AnnotationAssertion(dcterms:description goldbook:11441 "A system that predicts properties or activities of chemicals from rules devised by domain experts.")
AnnotationAssertion(rdfs:seeAlso goldbook:11441 goldbook:11469)
AnnotationAssertion(mito:isMentionedBy goldbook:11441 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11441 "current"^^xsd:string)
Declaration(Class(goldbook:11442))
AnnotationAssertion(rdfs:label goldbook:11442 "explicit solvent")
AnnotationAssertion(dcterms:description goldbook:11442 "Individual solvent molecules that are included in a computation, in contrast to those implied by a continuum approximation.")
AnnotationAssertion(rdfs:seeAlso goldbook:11442 goldbook:11429)
AnnotationAssertion(mito:isMentionedBy goldbook:11442 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11442 "current"^^xsd:string)
Declaration(Class(goldbook:11443))
AnnotationAssertion(rdfs:label goldbook:11443 "extended connectivity fingerprints")
AnnotationAssertion(dcterms:description goldbook:11443 "Hashed circular fingerprints that encode each atom according to its atomic symbol and hybridization for path length 2, ECFP2; path length 4, ECFP4; and path  length 6, ECFP6.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11443 "ECFP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11443 "ECFP fingerprints")
AnnotationAssertion(rdfs:seeAlso goldbook:11443 goldbook:11422)
AnnotationAssertion(mito:isMentionedBy goldbook:11443 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11443 "current"^^xsd:string)
Declaration(Class(goldbook:11444))
AnnotationAssertion(rdfs:label goldbook:11444 "false negative")
AnnotationAssertion(dcterms:description goldbook:11444 "A model prediction of a negative result, such as no biological activity, when the true result is positive, i.e. activity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11444 "FN")
AnnotationAssertion(rdfs:seeAlso goldbook:11444 goldbook:11428)
AnnotationAssertion(mito:isMentionedBy goldbook:11444 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11444 "current"^^xsd:string)
Declaration(Class(goldbook:11445))
AnnotationAssertion(rdfs:label goldbook:11445 "false positive")
AnnotationAssertion(dcterms:description goldbook:11445 "A model prediction of a positive result, such as biological activity, when the true result is negative, i.e. inactivity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11445 "FP")
AnnotationAssertion(rdfs:seeAlso goldbook:11445 goldbook:11428)
AnnotationAssertion(mito:isMentionedBy goldbook:11445 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11445 "current"^^xsd:string)
Declaration(Class(goldbook:11446))
AnnotationAssertion(rdfs:label goldbook:11446 "force field")
AnnotationAssertion(dcterms:description goldbook:11446 "A set of mathematical functions and their associated parameters used in a molecular mechanics or dynamics calculation of conformations, flexibility, and interactions of molecules.")
AnnotationAssertion(rdfs:comment goldbook:11446 "Within the molecular mechanics approach, a set of potential functions defining bond stretch, bond angle (both valence and dihedral) distortion energy of a molecule as compared with its nonstrained conformation (that characterized by standard values of bond lengths and angles). A set of transferable empirical force constants is preassigned and the harmonic approximation is usually employed. Some force fields may contain terms for interactions between non-bonded atoms, electrostatic, hydrogen bond and other structural effects as well as account for anharmonicity effects. In vibrational spectroscopy, the inverse problem is solved of determining a set of force constants and other parameters of a chosen potential energy functions which would match with experimentally observed vibrational frequencies of a given series of congeneric molecules."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11446 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11446 "current"^^xsd:string)
Declaration(Class(goldbook:11447))
AnnotationAssertion(rdfs:label goldbook:11447 "fragment keys")
AnnotationAssertion(dcterms:description goldbook:11447 "Description of the structure of a molecule as the presence or absence of each of a pre-determined set of molecular substructures, usually associated with a  particular location in a bit string.")
AnnotationAssertion(rdfs:seeAlso goldbook:11447 goldbook:11457)
AnnotationAssertion(rdfs:seeAlso goldbook:11447 goldbook:11415)
AnnotationAssertion(mito:isMentionedBy goldbook:11447 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11447 "current"^^xsd:string)
Declaration(Class(goldbook:11448))
AnnotationAssertion(rdfs:label goldbook:11448 "free energy perturbation")
AnnotationAssertion(dcterms:description goldbook:11448 "A method that uses molecular dynamics or Metropolis Monte Carlo simulations to compute the relative free energy differences between two conditions, typically the solution and bound states of a ligand-protein system.")
AnnotationAssertion(mito:isMentionedBy goldbook:11448 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11448 "current"^^xsd:string)
Declaration(Class(goldbook:11449))
AnnotationAssertion(rdfs:label goldbook:11449 "functional class fingerprints")
AnnotationAssertion(dcterms:description goldbook:11449 "Hashed circular fingerprints that encode each atom according to its property (hydrophobic, hydrogen bond donor, hydrogen bond acceptor, negatively charged, or  positively charged) for path length 2, FCFP2; path length 4, FCFP4; and path length 6, FCFP6.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11449 "FCFP")
AnnotationAssertion(rdfs:seeAlso goldbook:11449 goldbook:11422)
AnnotationAssertion(mito:isMentionedBy goldbook:11449 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11449 "current"^^xsd:string)
Declaration(Class(goldbook:11450))
AnnotationAssertion(rdfs:label goldbook:11450 "global model")
AnnotationAssertion(dcterms:description goldbook:11450 "A computational model designed to cover all of chemistry space although it typically includes a measure of if the molecule for which the properties are to be  predicted is within or outside the applicability domain of the model.")
AnnotationAssertion(rdfs:seeAlso goldbook:11450 goldbook:11406)
AnnotationAssertion(mito:isMentionedBy goldbook:11450 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11450 "current"^^xsd:string)
Declaration(Class(goldbook:11451))
AnnotationAssertion(rdfs:label goldbook:11451 "graph-based method")
AnnotationAssertion(dcterms:description goldbook:11451 "A computational method that converts the problem to be solved into a graph characterized by the character of the objects, such the atoms of a molecule or molecules in a database, and the distances between them.")
AnnotationAssertion(mito:isMentionedBy goldbook:11451 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11451 "current"^^xsd:string)
Declaration(Class(goldbook:11452))
AnnotationAssertion(rdfs:label goldbook:11452 "Hansch equation")
AnnotationAssertion(dcterms:description goldbook:11452 "A QSAR equation that describes the relationship between the logarithm of the relative biological potency of a molecule (\\(\\log (1/C_{i})\\)) and its electronic and hydrophobic properties: \\[\\log (1/C_{i}) = \\rho \\sigma_{i} + b\\,\\log P_{i} - c\\,(\\log P_{i})^{2}\\] in which fitting to the square term provides a parabola with an associated optimum log P.")
AnnotationAssertion(rdfs:seeAlso goldbook:11452 goldbook:11414)
AnnotationAssertion(rdfs:seeAlso goldbook:11452 goldbook:11469)
AnnotationAssertion(mito:isMentionedBy goldbook:11452 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11452 "current"^^xsd:string)
Declaration(Class(goldbook:11453))
AnnotationAssertion(rdfs:label goldbook:11453 "Hansch–Fujita π-constant")
AnnotationAssertion(dcterms:description goldbook:11453 "A constant that describes the contribution of a substituent to the octan-1-ol-water log P of a compound.]")
AnnotationAssertion(rdfs:seeAlso goldbook:11453 goldbook:11469)
AnnotationAssertion(mito:isMentionedBy goldbook:11453 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11453 "current"^^xsd:string)
Declaration(Class(goldbook:11454))
AnnotationAssertion(rdfs:label goldbook:11454 "hashing")
AnnotationAssertion(dcterms:description goldbook:11454 "An algorithm that maps data of variable length, such as the raw descriptors of path or circular fingerprints or InChIs, to a smaller fixed length vector.")
AnnotationAssertion(rdfs:comment goldbook:11454 "Hashed InChIs are named InChIKeys."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11454 goldbook:11455)
AnnotationAssertion(rdfs:seeAlso goldbook:11454 goldbook:11422)
AnnotationAssertion(rdfs:seeAlso goldbook:11454 goldbook:11483)
AnnotationAssertion(mito:isMentionedBy goldbook:11454 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11454 "current"^^xsd:string)
Declaration(Class(goldbook:11455))
AnnotationAssertion(rdfs:label goldbook:11455 "InChIKey")
AnnotationAssertion(dcterms:description goldbook:11455 "A fixed length (character) condensed digital representation of the InChI that is not human-understandable.")
AnnotationAssertion(rdfs:comment goldbook:11455 "This is sometimes referred to as a hashed InChI."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11455 goldbook:11456)
AnnotationAssertion(rdfs:seeAlso goldbook:11455 goldbook:11454)
AnnotationAssertion(mito:isMentionedBy goldbook:11455 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11455 "current"^^xsd:string)
Declaration(Class(goldbook:11456))
AnnotationAssertion(rdfs:label goldbook:11456 "International Chemical Identifier")
AnnotationAssertion(dcterms:description goldbook:11456 "A non-proprietary canonical identifier of chemical substances that can be used in printed and electronic data sources to enable easier linking of diverse data  compilations.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11456 "InChI")
AnnotationAssertion(mito:isMentionedBy goldbook:11456 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11456 "current"^^xsd:string)
Declaration(Class(goldbook:11457))
AnnotationAssertion(rdfs:label goldbook:11457 "ISIS keys")
AnnotationAssertion(dcterms:description goldbook:11457 "Predefined fragment keys that are used in 2D substructure and similarity searching with the ISIS software but are also generated by many other software  programs and used for 2D-QSAR or cluster analysis of molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:11457 goldbook:11521)
AnnotationAssertion(rdfs:seeAlso goldbook:11457 goldbook:11399)
AnnotationAssertion(rdfs:seeAlso goldbook:11457 goldbook:11447)
AnnotationAssertion(rdfs:seeAlso goldbook:11457 goldbook:11512)
AnnotationAssertion(mito:isMentionedBy goldbook:11457 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11457 "current"^^xsd:string)
Declaration(Class(goldbook:11458))
AnnotationAssertion(rdfs:label goldbook:11458 "jackknifing")
AnnotationAssertion(dcterms:description goldbook:11458 "A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from models developed by leaving out one or more observations at a time from the sample set.")
AnnotationAssertion(rdfs:seeAlso goldbook:11458 goldbook:11499)
AnnotationAssertion(rdfs:seeAlso goldbook:11458 goldbook:11417)
AnnotationAssertion(mito:isMentionedBy goldbook:11458 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11458 "current"^^xsd:string)
Declaration(Class(goldbook:11459))
AnnotationAssertion(rdfs:label goldbook:11459 "kappa shape descriptor")
AnnotationAssertion(dcterms:description goldbook:11459 "A type of topological index.")
AnnotationAssertion(rdfs:seeAlso goldbook:11459 goldbook:11525)
AnnotationAssertion(mito:isMentionedBy goldbook:11459 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11459 "current"^^xsd:string)
Declaration(Class(goldbook:11460))
AnnotationAssertion(rdfs:label goldbook:11460 "kernel method")
AnnotationAssertion(dcterms:description goldbook:11460 "Algorithms for pattern analysis that use functions such as Gaussians to enable them to operate in a high-dimensional descriptor space without ever computing  the coordinates of the data in that space.")
AnnotationAssertion(rdfs:comment goldbook:11460 "The support vector machine (SVM) is the most widely used kernel method."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11460 goldbook:11405)
AnnotationAssertion(mito:isMentionedBy goldbook:11460 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11460 "current"^^xsd:string)
Declaration(Class(goldbook:11461))
AnnotationAssertion(rdfs:label goldbook:11461 "leave-some-out cross-validation")
AnnotationAssertion(dcterms:description goldbook:11461 "A form of cross-validation in which more than one observation is left out at each run. Typically many runs with random samplings are performed.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11461 "LSO")
AnnotationAssertion(mito:isMentionedBy goldbook:11461 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11461 "current"^^xsd:string)
Declaration(Class(goldbook:11462))
AnnotationAssertion(rdfs:label goldbook:11462 "leverage")
AnnotationAssertion(dcterms:description goldbook:11462 "The influence of an observation on the coefficients of a fitted equation.")
AnnotationAssertion(rdfs:comment goldbook:11462 "An observation with high leverage may be an outlier or in poorly explored property space."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11462 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11462 "current"^^xsd:string)
Declaration(Class(goldbook:11463))
AnnotationAssertion(rdfs:label goldbook:11463 "ligand efficiency")
AnnotationAssertion(dcterms:description goldbook:11463 "Measure of the free energy of binding per heavy atom count (i.e. non-hydrogen) of a molecule.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11463 "LE")
AnnotationAssertion(rdfs:comment goldbook:11463 "It is used to rank the quality of molecules in drug discovery, particularly in fragment-based lead discovery."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11463 "An LE value of \\(\\pu{1.25 kJ mol-1}\\) per non-hydrogen atom is the minimum requirement of a good lead or fragment."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11463 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11463 "current"^^xsd:string)
Declaration(Class(goldbook:11464))
AnnotationAssertion(rdfs:label goldbook:11464 "linear interaction energy")
AnnotationAssertion(dcterms:description goldbook:11464 "A method that forecasts ligand binding free energies using force field estimations of the receptor-ligand interactions and thermal conformational sampling .")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11464 "LIE")
AnnotationAssertion(rdfs:seeAlso goldbook:11464 goldbook:11446)
AnnotationAssertion(mito:isMentionedBy goldbook:11464 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11464 "current"^^xsd:string)
Declaration(Class(goldbook:11465))
AnnotationAssertion(rdfs:label goldbook:11465 "lipophilic ligand efficiency")
AnnotationAssertion(dcterms:description goldbook:11465 "A measure of the efficiency of ligand binding that is corrected for binding driven by lipophilicity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11465 "LLE")
AnnotationAssertion(rdfs:comment goldbook:11465 "It is calculated as; \\[LLE = \\pu{p}K_{i} - \\log P\\] values of seven or greater are considered characteristic of a good clinical candidate."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11465 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11465 "current"^^xsd:string)
Declaration(Class(goldbook:11466))
AnnotationAssertion(rdfs:label goldbook:11466 "loading of a property")
AnnotationAssertion(dcterms:description goldbook:11466 "The contribution of the property to a principal component or partial least squares latent variable.")
AnnotationAssertion(mito:isMentionedBy goldbook:11466 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11466 "current"^^xsd:string)
Declaration(Class(goldbook:11467))
AnnotationAssertion(rdfs:label goldbook:11467 "local model")
AnnotationAssertion(dcterms:description goldbook:11467 "A computational model that applies to only a subset of molecules, typically a closely related series.")
AnnotationAssertion(rdfs:seeAlso goldbook:11467 goldbook:11450)
AnnotationAssertion(mito:isMentionedBy goldbook:11467 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11467 "current"^^xsd:string)
Declaration(Class(goldbook:11468))
AnnotationAssertion(rdfs:label goldbook:11468 "log <em>D</em>")
AnnotationAssertion(dcterms:description goldbook:11468 "The logarithm of the ratio of the total concentration (neutral and charged species) of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in water at a given \\(\\pu{pH}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:11468 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11468 "current"^^xsd:string)
Declaration(Class(goldbook:11469))
AnnotationAssertion(rdfs:label goldbook:11469 "log <em>P</em>")
AnnotationAssertion(dcterms:description goldbook:11469 "The logarithm of the ratio of the concentration of the uncharged form of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in  water.")
AnnotationAssertion(rdfs:comment goldbook:11469 "Common algorithms to calculate \\(\\log P\\) are CLOGP and ALOGP."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11469 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11469 "current"^^xsd:string)
Declaration(Class(goldbook:11470))
AnnotationAssertion(rdfs:label goldbook:11470 "machine learning")
AnnotationAssertion(dcterms:description goldbook:11470 "A computer algorithm that generates empirical models, such as a model of biological potency as a function of the properties of the molecules, that is derived  from the analysis of a training set for which all the necessary data are available.")
AnnotationAssertion(rdfs:seeAlso goldbook:11470 goldbook:11405)
AnnotationAssertion(rdfs:seeAlso goldbook:11470 goldbook:11503)
AnnotationAssertion(mito:isMentionedBy goldbook:11470 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11470 "current"^^xsd:string)
Declaration(Class(goldbook:11471))
AnnotationAssertion(rdfs:label goldbook:11471 "macromolecular crystallographic information file")
AnnotationAssertion(dcterms:description goldbook:11471 "A file that describes in detail the features of a macromolecular structure and the X‑ray diffraction experiment that was used to derive that structure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11471 "mmCIF")
AnnotationAssertion(mito:isMentionedBy goldbook:11471 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11471 "current"^^xsd:string)
Declaration(Class(goldbook:11472))
AnnotationAssertion(rdfs:label goldbook:11472 "Markush structure")
AnnotationAssertion(dcterms:description goldbook:11472 "A structure diagram that describes a set of related molecules with the structure of the common core and the structures of the substituents at each position.")
AnnotationAssertion(rdfs:comment goldbook:11472 "Markush structures are commonly used in patent claims."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11472 goldbook:11520)
AnnotationAssertion(mito:isMentionedBy goldbook:11472 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11472 "current"^^xsd:string)
Declaration(Class(goldbook:11473))
AnnotationAssertion(rdfs:label goldbook:11473 "molecular diversity")
AnnotationAssertion(dcterms:description goldbook:11473 "A measure of the spread of various properties or chemotypes within a set of compounds.")
AnnotationAssertion(mito:isMentionedBy goldbook:11473 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11473 "current"^^xsd:string)
Declaration(Class(goldbook:11474))
AnnotationAssertion(rdfs:label goldbook:11474 "molecular fingerprints")
AnnotationAssertion(dcterms:description goldbook:11474 "Descriptions of the structure of a molecule calculated from the properties of each of its atoms and bonds that are then usually condensed into a fixed-length string by a hashing algorithm.")
AnnotationAssertion(rdfs:seeAlso goldbook:11474 goldbook:11432)
AnnotationAssertion(rdfs:seeAlso goldbook:11474 goldbook:11405)
AnnotationAssertion(rdfs:seeAlso goldbook:11474 goldbook:11422)
AnnotationAssertion(rdfs:seeAlso goldbook:11474 goldbook:11443)
AnnotationAssertion(rdfs:seeAlso goldbook:11474 goldbook:11449)
AnnotationAssertion(rdfs:seeAlso goldbook:11474 goldbook:11454)
AnnotationAssertion(rdfs:seeAlso goldbook:11474 goldbook:11483)
AnnotationAssertion(mito:isMentionedBy goldbook:11474 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11474 "current"^^xsd:string)
Declaration(Class(goldbook:11475))
AnnotationAssertion(rdfs:label goldbook:11475 "molecular similarity")
AnnotationAssertion(dcterms:description goldbook:11475 "The degree to which two molecules resemble one another as calculated from their respective 2D or 3D properties, molecular fingerprints, fragment keys, or superimposed 3D structures that usually ranges from 1 (identical) to 0 (dissimilar).")
AnnotationAssertion(rdfs:comment goldbook:11475 "Tanimoto or Tversky similarities for 2D structures and Carbo or Hodgkin for 3D structures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11475 goldbook:11400)
AnnotationAssertion(rdfs:seeAlso goldbook:11475 goldbook:11402)
AnnotationAssertion(rdfs:seeAlso goldbook:11475 goldbook:11523)
AnnotationAssertion(rdfs:seeAlso goldbook:11475 goldbook:11529)
AnnotationAssertion(rdfs:seeAlso goldbook:11475 goldbook:11447)
AnnotationAssertion(rdfs:seeAlso goldbook:11475 goldbook:11474)
AnnotationAssertion(mito:isMentionedBy goldbook:11475 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11475 "current"^^xsd:string)
Declaration(Class(goldbook:11476))
AnnotationAssertion(rdfs:label goldbook:11476 "multidimensional scaling")
AnnotationAssertion(dcterms:description goldbook:11476 "A visualization method that converts a dataset of distances between molecules in property space into coordinates in lower dimension space with emphasis on  preserving the relative distances between dissimilar molecules.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11476 "MDS")
AnnotationAssertion(mito:isMentionedBy goldbook:11476 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11476 "current"^^xsd:string)
Declaration(Class(goldbook:11477))
AnnotationAssertion(rdfs:label goldbook:11477 "multiobjective optimization")
AnnotationAssertion(dcterms:description goldbook:11477 "The search for those combinations of properties that produces the best compromise between the various objectives of the search, for example properties of  compounds that are the best trade-off between potency, bioavailability, and selectivity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11477 "MOO")
AnnotationAssertion(rdfs:seeAlso goldbook:11477 goldbook:11480)
AnnotationAssertion(rdfs:seeAlso goldbook:11477 goldbook:11481)
AnnotationAssertion(mito:isMentionedBy goldbook:11477 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11477 "current"^^xsd:string)
Declaration(Class(goldbook:11478))
AnnotationAssertion(rdfs:label goldbook:11478 "orthogonal projections to latent structures")
AnnotationAssertion(dcterms:description goldbook:11478 "A preprocessing method for partial least squares calculations that filters out variation that is not correlated to the property to be fit and so results in  improved interpretability of a PLS model while maintaining its predictivity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11478 "O-PLS")
AnnotationAssertion(mito:isMentionedBy goldbook:11478 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11478 "current"^^xsd:string)
Declaration(Class(goldbook:11479))
AnnotationAssertion(rdfs:label goldbook:11479 "overtraining")
AnnotationAssertion(dcterms:description goldbook:11479 "Training a machine learning model for so long that the original input data is memorized with the result that model predictivity is degraded.")
AnnotationAssertion(mito:isMentionedBy goldbook:11479 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11479 "current"^^xsd:string)
Declaration(Class(goldbook:11480))
AnnotationAssertion(rdfs:label goldbook:11480 "Pareto front")
AnnotationAssertion(dcterms:description goldbook:11480 "The various combinations of predictor properties that lead to optimum predicted compromises in multiple target properties.")
AnnotationAssertion(mito:isMentionedBy goldbook:11480 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11480 "current"^^xsd:string)
Declaration(Class(goldbook:11481))
AnnotationAssertion(rdfs:label goldbook:11481 "Pareto optimization")
AnnotationAssertion(dcterms:description goldbook:11481 "The search for solutions to functions that provide a compromise between several desirable outcomes, such as potency, lack of toxicity, and good absorption, distribution, metabolism, and excretion (ADME) properties.")
AnnotationAssertion(mito:isMentionedBy goldbook:11481 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11481 "current"^^xsd:string)
Declaration(Class(goldbook:11482))
AnnotationAssertion(rdfs:label goldbook:11482 "partial atomic charges")
AnnotationAssertion(dcterms:description goldbook:11482 "Charges assigned to atoms, arising from the uneven distribution of electrons in bonds, that are used to calculate intermolecular interaction energy or to  characterize the charge distribution of a molecule.")
AnnotationAssertion(rdfs:comment goldbook:11482 "The charges can be derived from quantum chemical population analyses, fitted dipole moments or electrostatic potentials, spectroscopic data, or from partitioning electron density."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11482 "There is no firm theoretical basis for the assignment of partial atomic charges, hence there is no \"correct\" one."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11482 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11482 "current"^^xsd:string)
Declaration(Class(goldbook:11483))
AnnotationAssertion(rdfs:label goldbook:11483 "path fingerprints")
AnnotationAssertion(dcterms:description goldbook:11483 "Vectors of Boolean arrays generated from the properties of the atoms and bonds in linear paths, typically two to seven bonds long, hashed into an integer of  fixed determined length.")
AnnotationAssertion(rdfs:seeAlso goldbook:11483 goldbook:11432)
AnnotationAssertion(rdfs:seeAlso goldbook:11483 goldbook:11422)
AnnotationAssertion(rdfs:seeAlso goldbook:11483 goldbook:11454)
AnnotationAssertion(rdfs:seeAlso goldbook:11483 goldbook:11519)
AnnotationAssertion(mito:isMentionedBy goldbook:11483 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11483 "current"^^xsd:string)
Declaration(Class(goldbook:11484))
AnnotationAssertion(rdfs:label goldbook:11484 "protein data bank file")
AnnotationAssertion(dcterms:description goldbook:11484 "A text file that stores the atomic coordinates of a macromolecule, usually a protein or nucleic acid with associated ligands, solvent molecules and ions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11484 "PDB file")
AnnotationAssertion(rdfs:comment goldbook:11484 "The documentation for the file format is at https://files.wwpdb.org/pub/pdb/doc/format_descriptions/Format_v33_Letter.pdf."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11484 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11484 "current"^^xsd:string)
Declaration(Class(goldbook:11485))
AnnotationAssertion(rdfs:label goldbook:11485 "pharmacophore")
AnnotationAssertion(dcterms:description goldbook:11485 "A proposal for the ensemble of steric and electronic features that define the optimal supermolecular intermolecular interaction of a ligand with a specific  biological target structure with the result that it triggers or blocks its biological response.")
AnnotationAssertion(mito:isMentionedBy goldbook:11485 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11485 "current"^^xsd:string)
Declaration(Class(goldbook:11486))
AnnotationAssertion(rdfs:label goldbook:11486 "pipelining programs")
AnnotationAssertion(dcterms:description goldbook:11486 "Visual programming of the computational execution of sequential operations on a dataset, with each node specifying an operation with options, and the nodes processed sequentially.")
AnnotationAssertion(mito:isMentionedBy goldbook:11486 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11486 "current"^^xsd:string)
Declaration(Class(goldbook:11487))
AnnotationAssertion(rdfs:label goldbook:11487 "PLS latent variable")
AnnotationAssertion(dcterms:description goldbook:11487 "One of the vectors of a linear combination of the input descriptors that a partial least squares calculation extracts from a dataset.")
AnnotationAssertion(mito:isMentionedBy goldbook:11487 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11487 "current"^^xsd:string)
Declaration(Class(goldbook:11488))
AnnotationAssertion(rdfs:label goldbook:11488 "PLS loading")
AnnotationAssertion(dcterms:description goldbook:11488 "The contribution of a particular property to a PLS latent variable.")
AnnotationAssertion(rdfs:seeAlso goldbook:11488 goldbook:11487)
AnnotationAssertion(mito:isMentionedBy goldbook:11488 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11488 "current"^^xsd:string)
Declaration(Class(goldbook:11489))
AnnotationAssertion(rdfs:label goldbook:11489 "Poisson–Boltzmann equation")
AnnotationAssertion(dcterms:description goldbook:11489 "A differential equation that uses a mean-field, continuum model to describe the electrostatic interactions in ionic solutions where both ions and solvent are  treated implicitly, resulting in less computational effort to describe biomolecules in ionic aqueous solutions.")
AnnotationAssertion(rdfs:seeAlso goldbook:11489 goldbook:11429)
AnnotationAssertion(mito:isMentionedBy goldbook:11489 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11489 "current"^^xsd:string)
Declaration(Class(goldbook:11490))
AnnotationAssertion(rdfs:label goldbook:11490 "polar surface area")
AnnotationAssertion(dcterms:description goldbook:11490 "Surface area over all polar atoms (usually oxygen and nitrogen), including any attached hydrogen atoms, of a molecule.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11490 "PSA")
AnnotationAssertion(rdfs:comment goldbook:11490 "Polar surface area is a commonly used metric (c.f. molecular descriptor) for the optimisation of cell permeability. Molecules with a PSA of greater than \\(\\pu{1.4 nm2}\\) are usually poor at permeating cell membranes. For molecules to penetrate the blood-brain barrier, the polar surface area should normally be smaller than \\(\\pu{0.6 nm2}\\), although values up to \\(\\pu{0.9 nm2}\\) can be tolerated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11490 "Sometimes sulfur atoms are included in the definition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11490 "The value of PSA depends on the conformation of the molecule and also the algorithm and atomic radii used in the calculation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11490 goldbook:11436)
AnnotationAssertion(rdfs:seeAlso goldbook:11490 goldbook:11526)
AnnotationAssertion(mito:isMentionedBy goldbook:11490 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11490 "current"^^xsd:string)
Declaration(Class(goldbook:11491))
AnnotationAssertion(rdfs:label goldbook:11491 "pose diagram")
AnnotationAssertion(dcterms:description goldbook:11491 "A 2D diagram that shows the interactions between a ligand and a protein in the 3D structure of the complex.")
AnnotationAssertion(mito:isMentionedBy goldbook:11491 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11491 "current"^^xsd:string)
Declaration(Class(goldbook:11492))
AnnotationAssertion(rdfs:label goldbook:11492 "posterior probability")
AnnotationAssertion(dcterms:description goldbook:11492 "The conditional probability that is assigned to a quantity after relevant evidence is taken into account. The prior and posterior probabilities are linked by  the (normalized) likelihood function (Bayes's theorem).")
AnnotationAssertion(rdfs:seeAlso goldbook:11492 goldbook:11412)
AnnotationAssertion(rdfs:seeAlso goldbook:11492 goldbook:11496)
AnnotationAssertion(mito:isMentionedBy goldbook:11492 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11492 "current"^^xsd:string)
Declaration(Class(goldbook:11493))
AnnotationAssertion(rdfs:label goldbook:11493 "prediction set")
AnnotationAssertion(dcterms:description goldbook:11493 "Molecules that have been set aside from model development to test the reliability of the derived model.")
AnnotationAssertion(rdfs:seeAlso goldbook:11493 goldbook:11524)
AnnotationAssertion(mito:isMentionedBy goldbook:11493 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11493 "current"^^xsd:string)
Declaration(Class(goldbook:11494))
AnnotationAssertion(rdfs:label goldbook:11494 "principal component loading")
AnnotationAssertion(dcterms:description goldbook:11494 "The contribution, scaled between \\(\\pu{-1.0}\\) and \\(\\pu{1.0}\\), of an original variable to a particular principal component.")
AnnotationAssertion(mito:isMentionedBy goldbook:11494 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11494 "current"^^xsd:string)
Declaration(Class(goldbook:11495))
AnnotationAssertion(rdfs:label goldbook:11495 "principal component score")
AnnotationAssertion(dcterms:description goldbook:11495 "A property of a molecule calculated from a principal components analysis of the original properties and the value of these properties for the molecule.")
AnnotationAssertion(mito:isMentionedBy goldbook:11495 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11495 "current"^^xsd:string)
Declaration(Class(goldbook:11496))
AnnotationAssertion(rdfs:label goldbook:11496 "prior probability")
AnnotationAssertion(dcterms:description goldbook:11496 "The conditional probability that is assigned to a quantity before relevant evidence is taken into account, for example, the prior probability of an active  compound would be the fraction of the compounds in the dataset that are active.")
AnnotationAssertion(rdfs:comment goldbook:11496 "The prior and posterior probabilities are linked by the (normalized) likelihood function (Bayes theorem)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11496 goldbook:11412)
AnnotationAssertion(rdfs:seeAlso goldbook:11496 goldbook:11492)
AnnotationAssertion(mito:isMentionedBy goldbook:11496 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11496 "current"^^xsd:string)
Declaration(Class(goldbook:11497))
AnnotationAssertion(rdfs:label goldbook:11497 "protein data bank")
AnnotationAssertion(dcterms:description goldbook:11497 "An archive of freely available macromolecular structural data of proteins, nucleic acids, and complex assemblies.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11497 "PDB")
AnnotationAssertion(rdfs:comment goldbook:11497 "The PDB is maintained by the Worldwide Protein Data Bank (wwPDB) with members RSCB PDB (USA), PDBe (Europe), PDBj (Japan), and BMRB (USA) that act as centers for deposition, data processing and distribution of PDB data."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11497 "The URL for the organization is https://www.wwpdb.org."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11497 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11497 "current"^^xsd:string)
Declaration(Class(goldbook:11498))
AnnotationAssertion(rdfs:label goldbook:11498 "q2")
AnnotationAssertion(dcterms:description goldbook:11498 "The square of the leave-one-out cross-validation regression coefficient calculated from the variance of the observed versus predicted values of the target  property, usually potency, of each compound when eliminated during cross-validation.")
AnnotationAssertion(rdfs:comment goldbook:11498 "This is related to r2, which is calculated as the fit of the observed to calculated for the whole dataset."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11498 goldbook:11499)
AnnotationAssertion(mito:isMentionedBy goldbook:11498 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11498 "current"^^xsd:string)
Declaration(Class(goldbook:11499))
AnnotationAssertion(rdfs:label goldbook:11499 "r2")
AnnotationAssertion(dcterms:description goldbook:11499 "The ratio of the sum of squares explained by a regression model (SSR) to the 'total' sum of squares around the mean (SST), or, because SST equals SSR plus the sum of squares of the error or residuals from the fit (SSE): \\[R^{2} = \\frac{{\\rm{SSR}}}{{\\rm{SST}}} = 1 - \\frac{{\\rm{SSE}}}{{\\rm{SST}}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11499 "$R^{2}$")
AnnotationAssertion(rdfs:comment goldbook:11499 "\\(R_{2}\\) values can range between \\(\\pu{0.0}\\) and \\(\\pu{1.0}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11499 "Except for the comparison of different models for the same dataset, \\(R^{2}\\) values are not a good indica- tion of fit of a model because the calculation depends on SST, which is larger if there is more spread in the observed values."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11499 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11499 "current"^^xsd:string)
Declaration(Class(goldbook:11500))
AnnotationAssertion(rdfs:label goldbook:11500 "random forest method")
AnnotationAssertion(dcterms:description goldbook:11500 "A classification method that produces many recursive partitioning models, each with a random selection of predictor properties, and then combines the models  for predictions.")
AnnotationAssertion(rdfs:seeAlso goldbook:11500 goldbook:11503)
AnnotationAssertion(mito:isMentionedBy goldbook:11500 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11500 "current"^^xsd:string)
Declaration(Class(goldbook:11501))
AnnotationAssertion(rdfs:label goldbook:11501 "recall")
AnnotationAssertion(dcterms:description goldbook:11501 "The fraction of the total number of actives, in the top-scoring docking hits, such as the fraction of true actives that are retrieved in the top \\(\\pu{1\\%}\\) scoring molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:11501 goldbook:11516)
AnnotationAssertion(mito:isMentionedBy goldbook:11501 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11501 "current"^^xsd:string)
Declaration(Class(goldbook:11502))
AnnotationAssertion(rdfs:label goldbook:11502 "receiver-operator characteristic curve")
AnnotationAssertion(dcterms:description goldbook:11502 "A plot that shows the result of a test of the performance of a binary classifier by plotting the fraction of true positives identified versus the fraction of  false positives as the discrimination threshold is varied.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11502 "ROC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11502 "ROC curve")
AnnotationAssertion(rdfs:comment goldbook:11502 "ROC curves are frequently used to compare different docking/scoring combinations or virtual screening protocols by the retrieval results from seeding a database of inactive molecules with known actives."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11502 "The area under the ROC curve (AUC) provides a measure of the superiority of the model over random predictions: If the value for the AUC for a ROC curve has the value of \\(\\pu{0.9\\!-\\! 1.0}\\), the fit is considered excellent, whereas an AUC of \\(\\pu{0.5}\\) suggests that the algorithm has no discriminatory power."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11502 "This is an example of using area under the curve as a measure of model performance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11502 goldbook:11416)
AnnotationAssertion(rdfs:seeAlso goldbook:11502 goldbook:11407)
AnnotationAssertion(rdfs:seeAlso goldbook:11502 goldbook:11445)
AnnotationAssertion(rdfs:seeAlso goldbook:11502 goldbook:11528)
AnnotationAssertion(mito:isMentionedBy goldbook:11502 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11502 "current"^^xsd:string)
Declaration(Class(goldbook:11503))
AnnotationAssertion(rdfs:label goldbook:11503 "recursive partitioning")
AnnotationAssertion(dcterms:description goldbook:11503 "A classification method that uses predictor properties to successively divide the data set into subsets such that each resulting subset is enriched in  molecules that are in one class.")
AnnotationAssertion(mito:isMentionedBy goldbook:11503 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11503 "current"^^xsd:string)
Declaration(Class(goldbook:11504))
AnnotationAssertion(rdfs:label goldbook:11504 "regularization")
AnnotationAssertion(dcterms:description goldbook:11504 "Introducing additional information in order to solve an ill-posed problem or to prevent overfitting, usually taking the form of a penalty for complexity of the  model.")
AnnotationAssertion(mito:isMentionedBy goldbook:11504 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11504 "current"^^xsd:string)
Declaration(Class(goldbook:11505))
AnnotationAssertion(rdfs:label goldbook:11505 "response scrambling")
AnnotationAssertion(dcterms:description goldbook:11505 "Evaluation of the robustness of a QSAR or classification model by repeatedly randomizing the target property of compounds, developing models based on this  randomized property, and comparing the statistics of fit of the scrambled models with those of the true model, which should be superior.")
AnnotationAssertion(mito:isMentionedBy goldbook:11505 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11505 "current"^^xsd:string)
Declaration(Class(goldbook:11506))
AnnotationAssertion(rdfs:label goldbook:11506 "R-group decomposition")
AnnotationAssertion(dcterms:description goldbook:11506 "The process whereby the molecules in a dataset are partitioned into the core ('scaffold'), usually user-specified, and the specific substituents ('R-groups')  found at each specific position.")
AnnotationAssertion(mito:isMentionedBy goldbook:11506 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11506 "current"^^xsd:string)
Declaration(Class(goldbook:11507))
AnnotationAssertion(rdfs:label goldbook:11507 "rule of five")
AnnotationAssertion(dcterms:description goldbook:11507 "The rule of five states that molecules that violate two or more of the following rules are likely to have permeability problems; (1) CLOGP calculated octan-1-ol-water log P greater than 5.0; (2) molecular weight greater than 500; (3) more than five hydrogen bond donors; and (4) the sum of oxygen and nitrogen atoms is greater than 10.")
AnnotationAssertion(rdfs:comment goldbook:11507 "Natural products, peptides and other substrates for biological transporters are exceptions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11507 "The original authors also noted that one can calculate the octan-1-ol-water log P with the program MLOGP for which the cut-off is \\(\\pu{4.15}\\). Users often use log P’s calculated with other programs or measured values."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11507 goldbook:11469)
AnnotationAssertion(mito:isMentionedBy goldbook:11507 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11507 "current"^^xsd:string)
Declaration(Class(goldbook:11508))
AnnotationAssertion(rdfs:label goldbook:11508 "scoring")
AnnotationAssertion(dcterms:description goldbook:11508 "A mathematical formula that estimates the binding affinity of a ligand to a macromolecular target based on the structure of the complex.")
AnnotationAssertion(rdfs:comment goldbook:11508 "Scoring is used to select poses and to rank compounds in docking."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11508 goldbook:11437)
AnnotationAssertion(mito:isMentionedBy goldbook:11508 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11508 "current"^^xsd:string)
Declaration(Class(goldbook:11509))
AnnotationAssertion(rdfs:label goldbook:11509 "structure-data format file")
AnnotationAssertion(dcterms:description goldbook:11509 "A computer text file that follows a specified format in which each molecule is described by 2D or 3D coordinates, atom type, and connectivity to other atoms  and also specific user-definable fields that contain other information such as name and biological or chemical properties.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11509 "SDF file")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11509 "SDfile")
AnnotationAssertion(rdfs:comment goldbook:11509 "The format of the files is described in the following document: https://discover.3ds.com/sites/default/files/2020-08/biovia_ctfileformats_2020.pdf (link updated)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11509 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11509 "current"^^xsd:string)
Declaration(Class(goldbook:11510))
AnnotationAssertion(rdfs:label goldbook:11510 "sensitivity analysis")
AnnotationAssertion(dcterms:description goldbook:11510 "Analysis, often by finding approximate derivatives of the output with respect to each input, that determines which of the descriptors in a model has the  greatest influence on the output.")
AnnotationAssertion(rdfs:seeAlso goldbook:11510 goldbook:11436)
AnnotationAssertion(mito:isMentionedBy goldbook:11510 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11510 "current"^^xsd:string)
Declaration(Class(goldbook:11511))
AnnotationAssertion(rdfs:label goldbook:11511 "similarity ensemble approach")
AnnotationAssertion(dcterms:description goldbook:11511 "A method that predicts the probability that a molecule or set of molecules will be active against a particular target by considering its pairwise similarities  to all known ligands for that target.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11511 "SEA")
AnnotationAssertion(mito:isMentionedBy goldbook:11511 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11511 "current"^^xsd:string)
Declaration(Class(goldbook:11512))
AnnotationAssertion(rdfs:label goldbook:11512 "similarity searching")
AnnotationAssertion(dcterms:description goldbook:11512 "A virtual screening method that calculates the molecular similarity of an input 2D or 3D structure to each of the molecules in a database to identify a  requested number of most similar molecules or those above some similarity threshold.")
AnnotationAssertion(rdfs:seeAlso goldbook:11512 goldbook:11523)
AnnotationAssertion(rdfs:seeAlso goldbook:11512 goldbook:11529)
AnnotationAssertion(rdfs:seeAlso goldbook:11512 goldbook:11475)
AnnotationAssertion(rdfs:seeAlso goldbook:11512 goldbook:11533)
AnnotationAssertion(mito:isMentionedBy goldbook:11512 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11512 "current"^^xsd:string)
Declaration(Class(goldbook:11513))
AnnotationAssertion(rdfs:label goldbook:11513 "SMARTS")
AnnotationAssertion(dcterms:description goldbook:11513 "An expansion of the SMILES language that describes a particular specific or generalized substructure.")
AnnotationAssertion(rdfs:seeAlso goldbook:11513 goldbook:11514)
AnnotationAssertion(mito:isMentionedBy goldbook:11513 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11513 "current"^^xsd:string)
Declaration(Class(goldbook:11515))
AnnotationAssertion(rdfs:label goldbook:11515 "SMIRKS")
AnnotationAssertion(dcterms:description goldbook:11515 "A derivative of the SMILES language that describes the transformation in a chemical reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:11515 goldbook:11514)
AnnotationAssertion(mito:isMentionedBy goldbook:11515 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11515 "current"^^xsd:string)
Declaration(Class(goldbook:11516))
AnnotationAssertion(rdfs:label goldbook:11516 "specificity")
AnnotationAssertion(dcterms:description goldbook:11516 "The ability of a two-class model to detect known inactive or non-toxic molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:11516 goldbook:11501)
AnnotationAssertion(mito:isMentionedBy goldbook:11516 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11516 "current"^^xsd:string)
Declaration(Class(goldbook:11517))
AnnotationAssertion(rdfs:label goldbook:11517 "standard error of estimates")
AnnotationAssertion(dcterms:description goldbook:11517 "The standard error of the errors or residuals, observed minus calculated, from a computational model: \\[{\\rm{SEE}} = \\sqrt \\frac{\\sum (Y_{o} - Y_{c})^{2}}{n}\\] in which \\(Y_{o}\\) is the observed value of \\(Y\\), \\(Y_{c}\\) is the calculated value of \\(Y\\), and \\(n\\) is the number of observations.")
AnnotationAssertion(rdfs:comment goldbook:11517 "Sometimes also labeled root mean square deviation (RMSD)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11517 goldbook:11518)
AnnotationAssertion(mito:isMentionedBy goldbook:11517 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11517 "current"^^xsd:string)
Declaration(Class(goldbook:11518))
AnnotationAssertion(rdfs:label goldbook:11518 "standard error of prediction")
AnnotationAssertion(dcterms:description goldbook:11518 "The standard deviation of the errors or residuals, observed minus calculated, from a computational model: \\[{\\rm{SEP}} = \\sqrt \\frac{\\sum (Y_{o} - Y_{p})^{2}}{n - k}\\] in which \\(Y_{o}\\) is the observed value of \\(Y\\), \\(Y_{p}\\) is the predicted value of \\(Y\\), \\(n\\) is the number of observations, and \\(k\\) is the number of terms in the model.")
AnnotationAssertion(rdfs:comment goldbook:11518 "Sometimes also labeled root mean square error of predication (RMSEP)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11518 goldbook:11517)
AnnotationAssertion(mito:isMentionedBy goldbook:11518 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11518 "current"^^xsd:string)
Declaration(Class(goldbook:11519))
AnnotationAssertion(rdfs:label goldbook:11519 "structural keys")
AnnotationAssertion(dcterms:description goldbook:11519 "A pre-established set of substructures the presence or absence of which are used to describe a molecule and are used during substructure searching as a filter  to eliminate molecules that cannot match a query, for clustering or similarity searching, or for developing classification or regression models.")
AnnotationAssertion(rdfs:seeAlso goldbook:11519 goldbook:11474)
AnnotationAssertion(rdfs:seeAlso goldbook:11519 goldbook:11512)
AnnotationAssertion(rdfs:seeAlso goldbook:11519 goldbook:11521)
AnnotationAssertion(mito:isMentionedBy goldbook:11519 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11519 "current"^^xsd:string)
Declaration(Class(goldbook:11520))
AnnotationAssertion(rdfs:label goldbook:11520 "structure diagram")
AnnotationAssertion(dcterms:description goldbook:11520 "A 2D drawing that shows the atoms of a molecular structure and the bonds that connect them.")
AnnotationAssertion(mito:isMentionedBy goldbook:11520 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11520 "current"^^xsd:string)
Declaration(Class(goldbook:11521))
AnnotationAssertion(rdfs:label goldbook:11521 "substructure searching")
AnnotationAssertion(dcterms:description goldbook:11521 "A virtual screening method that uses a graph-based method to discover which molecules in a chemical structure database contain the substructure specified in  the query.")
AnnotationAssertion(rdfs:seeAlso goldbook:11521 goldbook:11451)
AnnotationAssertion(rdfs:seeAlso goldbook:11521 goldbook:11533)
AnnotationAssertion(mito:isMentionedBy goldbook:11521 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11521 "current"^^xsd:string)
Declaration(Class(goldbook:11522))
AnnotationAssertion(rdfs:label goldbook:11522 "supervised learning")
AnnotationAssertion(dcterms:description goldbook:11522 "A machine learning method that aims to discover a relationship between the predictor and the response values, such as exists in a QSAR or recursive  partitioning model.")
AnnotationAssertion(rdfs:seeAlso goldbook:11522 goldbook:11503)
AnnotationAssertion(mito:isMentionedBy goldbook:11522 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11522 "current"^^xsd:string)
Declaration(Class(goldbook:11523))
AnnotationAssertion(rdfs:label goldbook:11523 "Tanimoto similarity")
AnnotationAssertion(dcterms:description goldbook:11523 "A scale that ranges from \\(\\pu{0.0}\\) to \\(\\pu{1.0}\\) when calculated as the ratio of the fingerprint bits or structural keys that both molecules have set divided by the number of bits or keys set in both molecules plus those set either molecule.")
AnnotationAssertion(rdfs:comment goldbook:11523 "In set theory terms the Tanimoto similarity is equal to the ratio of the intersection set to the union set."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11523 "The value of a Tanimoto similarity of a pair of molecules depends on the molecular fingerprint or structural keys used in the calculation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11523 "The Tanimoto similarity can also be calculated for molecules described by continuous variables. The similarities in this case range from \\(\\pu{-1\\!{/}\\! 3}\\) to \\(\\pu{1.0}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11523 goldbook:11529)
AnnotationAssertion(rdfs:seeAlso goldbook:11523 goldbook:11474)
AnnotationAssertion(mito:isMentionedBy goldbook:11523 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11523 "current"^^xsd:string)
Declaration(Class(goldbook:11524))
AnnotationAssertion(rdfs:label goldbook:11524 "test set")
AnnotationAssertion(dcterms:description goldbook:11524 "The set of molecules not used in any way to devise a computational model but instead are used to test its predictivity.")
AnnotationAssertion(rdfs:comment goldbook:11524 "A test set differs from a prediction set in that the molecules and their associated activities may be derived from a source other than that from which the model was derived, for example, compounds tested after the model was developed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11524 goldbook:11493)
AnnotationAssertion(mito:isMentionedBy goldbook:11524 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11524 "current"^^xsd:string)
Declaration(Class(goldbook:11525))
AnnotationAssertion(rdfs:label goldbook:11525 "topological index")
AnnotationAssertion(dcterms:description goldbook:11525 "A numerical value associated with chemical constitution for correlation of chemical structure with various physical properties, chemical reactivity or biological activity. The numerical basis for topological indices is provided (depending on how a molecular graph is converted into a numerical value) by either the adjacency matrix or the topological distance matrix. In the latter the topological distance between two vertices is the number of edges in the shortest path between these.")
AnnotationAssertion(mito:isMentionedBy goldbook:11525 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11525 "current"^^xsd:string)
Declaration(Class(goldbook:11526))
AnnotationAssertion(rdfs:label goldbook:11526 "topological polar surface area")
AnnotationAssertion(dcterms:description goldbook:11526 "An approximation to polar surface area that is calculated from the 2D structure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11526 "TPSA")
AnnotationAssertion(rdfs:seeAlso goldbook:11526 goldbook:11398)
AnnotationAssertion(rdfs:seeAlso goldbook:11526 goldbook:11490)
AnnotationAssertion(mito:isMentionedBy goldbook:11526 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11526 "current"^^xsd:string)
Declaration(Class(goldbook:11527))
AnnotationAssertion(rdfs:label goldbook:11527 "true negative")
AnnotationAssertion(dcterms:description goldbook:11527 "A model prediction of a negative result, such as no biological activity, when the true result is also negative.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11527 "TN")
AnnotationAssertion(rdfs:seeAlso goldbook:11527 goldbook:11428)
AnnotationAssertion(mito:isMentionedBy goldbook:11527 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11527 "current"^^xsd:string)
Declaration(Class(goldbook:11528))
AnnotationAssertion(rdfs:label goldbook:11528 "true positive")
AnnotationAssertion(dcterms:description goldbook:11528 "A model prediction of a positive result, such as biological activity, when the true result is also positive.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11528 "TP")
AnnotationAssertion(rdfs:seeAlso goldbook:11528 goldbook:11428)
AnnotationAssertion(mito:isMentionedBy goldbook:11528 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11528 "current"^^xsd:string)
Declaration(Class(goldbook:11529))
AnnotationAssertion(rdfs:label goldbook:11529 "Tversky similarity")
AnnotationAssertion(dcterms:description goldbook:11529 "An asymmetric measure in which a target structure is compared to a reference structure with user-selectable weighting of the relative importance of the fingerprint bits or structural keys that are present only in the reference versus the fingerprint bits or structural keys that are only in the target, weightings for which the Tanimoto coefficient uses \\(\\pu{1.0}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:11529 goldbook:11523)
AnnotationAssertion(rdfs:seeAlso goldbook:11529 goldbook:11415)
AnnotationAssertion(rdfs:seeAlso goldbook:11529 goldbook:11474)
AnnotationAssertion(rdfs:seeAlso goldbook:11529 goldbook:11519)
AnnotationAssertion(mito:isMentionedBy goldbook:11529 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11529 "current"^^xsd:string)
Declaration(Class(goldbook:11530))
AnnotationAssertion(rdfs:label goldbook:11530 "underdetermined system")
AnnotationAssertion(dcterms:description goldbook:11530 "A system in which the number of descriptors is much larger than the number of observations.")
AnnotationAssertion(mito:isMentionedBy goldbook:11530 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11530 "current"^^xsd:string)
Declaration(Class(goldbook:11531))
AnnotationAssertion(rdfs:label goldbook:11531 "validation set")
AnnotationAssertion(dcterms:description goldbook:11531 "The molecules not used to devise a computational model but instead are used during model development to test for possible over-fitting as seen when additional  properties are added to a model but the predicted potencies of the validation set become less accurate.")
AnnotationAssertion(mito:isMentionedBy goldbook:11531 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11531 "current"^^xsd:string)
Declaration(Class(goldbook:11532))
AnnotationAssertion(rdfs:label goldbook:11532 "virtual reaction")
AnnotationAssertion(dcterms:description goldbook:11532 "The computer encoding of a possible chemical reaction between two explicit or Markush structures or substructures, often with a mapping between the atoms in  the starting material and those in the product.")
AnnotationAssertion(rdfs:seeAlso goldbook:11532 goldbook:11472)
AnnotationAssertion(rdfs:seeAlso goldbook:11532 goldbook:11515)
AnnotationAssertion(mito:isMentionedBy goldbook:11532 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11532 "current"^^xsd:string)
Declaration(Class(goldbook:11533))
AnnotationAssertion(rdfs:label goldbook:11533 "virtual screening")
AnnotationAssertion(dcterms:description goldbook:11533 "Computational methods that rank the molecules in a database by their forecast continuous or categorical biological or chemical properties.")
AnnotationAssertion(rdfs:comment goldbook:11533 "Virtual screening is often used to predict the ability of molecules to bind to a macromolecular target of known 3D structure, to fit a ligand-based hypothesis of bioactivity, for their similarity to known actives, or to be mutagenic."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11533 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11533 "current"^^xsd:string)
Declaration(Class(goldbook:11534))
AnnotationAssertion(rdfs:label goldbook:11534 "workflow")
AnnotationAssertion(dcterms:description goldbook:11534 "The sequence of steps used to perform a certain task.")
AnnotationAssertion(mito:isMentionedBy goldbook:11534 doi:10.1515/pac-2012-1204)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11534 "current"^^xsd:string)
Declaration(Class(goldbook:11535))
AnnotationAssertion(rdfs:label goldbook:11535 "apparent monomer")
AnnotationAssertion(dcterms:description goldbook:11535 "Monomer which from the name of a polymer appears to have been used in the synthesis of the latter when it has actually been prepared from different precursor(s).")
AnnotationAssertion(rdfs:comment goldbook:11535 "The term replaces both of the formerly used terms \"hypothetical monomer\" and \"implicit monomer\", which are now deemed to be obsolete."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11535 doi:10.1515/pac-2015-0702)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11535 "current"^^xsd:string)
Declaration(Class(goldbook:11536))
AnnotationAssertion(rdfs:label goldbook:11536 "block homopolymer")
AnnotationAssertion(dcterms:description goldbook:11536 "Homopolymer that is composed of macromolecules comprising blocks that have at least one constitutional or configurational feature which is not present in the adjacent portions.")
AnnotationAssertion(mito:isMentionedBy goldbook:11536 doi:10.1515/pac-2015-0702)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11536 "current"^^xsd:string)
Declaration(Class(goldbook:11537))
AnnotationAssertion(rdfs:label goldbook:11537 "graft homopolymer")
AnnotationAssertion(dcterms:description goldbook:11537 "Homopolymer composed of macromolecules with one or more species of block connected to the main chain as side chains, these side chains having constitutional or configurational features that differ from those in the main chain.")
AnnotationAssertion(mito:isMentionedBy goldbook:11537 doi:10.1515/pac-2015-0702)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11537 "current"^^xsd:string)
Declaration(Class(goldbook:11538))
AnnotationAssertion(rdfs:label goldbook:11538 "standardization")
AnnotationAssertion(dcterms:description goldbook:11538 "Measurement of the concentration of a component of a solution with a reference measurement standard for the preparation of a secondary measurement standard")
AnnotationAssertion(rdfs:comment goldbook:11538 "Standardization is commonly performed by titration. It may be done by other means such as gravimetric analysis, e.g., standardize \\(\\ce{AgNO3}\\) by precipitating \\(\\ce{AgCl}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11538 "Quantities that denote relative composition include mass concentration, number concentration, amount of substance concentration, molality, mass fraction, amount of substance fraction, and volume fraction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11538 goldbook:09043)
AnnotationAssertion(mito:isMentionedBy goldbook:11538 doi:10.1515/pac-2023-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11538 "current"^^xsd:string)
Declaration(Class(goldbook:11539))
AnnotationAssertion(rdfs:label goldbook:11539 "controlled release")
AnnotationAssertion(dcterms:description goldbook:11539 "Detection principle for a chemically modified electrode (CME) in which an analyte or reagent accumulated at a CME undergoes quantitative release (egress, stripping, expulsion, or microdosing) to the test solution, under electrochemical or chemical control.")
AnnotationAssertion(rdfs:comment goldbook:11539 "Different mechanisms are involved in controlled release from the CME depending on the nature of the analyte or reagent and the method of accumulation. In the case of accumulation by covalent bonding, the anchoring bond is cleaved (ruptured) electrochemically. In the case of ion-exchange accumulation, an ionic (redox or acid-base) analyte or reagent is released by neutralizing its charge or the charge of the ion-exchanging redox polymer film or conducting polymer film."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11539 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11539 "current"^^xsd:string)
Declaration(Class(goldbook:11540))
AnnotationAssertion(rdfs:label goldbook:11540 "all-solid-state ion-selective electrode")
AnnotationAssertion(dcterms:description goldbook:11540 "Ion-selective electrode in which the ion-selective membrane contacts the electronic conductor without internal electrolyte solution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11540 "metal contact ion-selective electrode")
AnnotationAssertion(rdfs:comment goldbook:11540 "Charge transfer is accomplished in the membrane by both ionic and electronic conductivities (mixed conductors)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11540 "The inner reference electrode is replaced by an electronic conductor, e.g., a bromide sensor film of \\(\\ce{AgBr}\\) is reversibly contacted with \\(\\ce{Ag}\\), or an anion sensor based on cation radical salts is contacted with \\(\\ce{Pt}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11540 goldbook:09119)
AnnotationAssertion(mito:isMentionedBy goldbook:11540 doi:10.1515/pac-2018-0109)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11540 "current"^^xsd:string)
Declaration(Class(goldbook:11541))
AnnotationAssertion(rdfs:label goldbook:11541 "self-assembled monolayer")
AnnotationAssertion(dcterms:description goldbook:11541 "Film, one molecule thick, in an ordered assembly on a surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:11541 "SAM")
AnnotationAssertion(mito:isMentionedBy goldbook:11541 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11541 "current"^^xsd:string)
Declaration(Class(goldbook:11542))
AnnotationAssertion(rdfs:label goldbook:11542 "cationized molecule")
AnnotationAssertion(dcterms:description goldbook:11542 "Ion formed by the association of a cation with a molecule \\(\\ce{M}\\).")
AnnotationAssertion(rdfs:comment goldbook:11542 "Cationization with, for instance, \\(\\ce{Ag}\\), leads to high yields of some positive ion fragments or molecular ions. Each ion has a mass given by the sum of the mass of the parent molecule or fragment and the mass of the added metal atom or atoms. The \\(\\ce{Ag}\\) can be used either as the substrate upon which the molecules are deposited or in the form of a sub-monolayer sputtered onto the molecules already on a surface."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11542 "\\(\\ce{NH4^{+}}\\) can be used as well as metals to cationize molecules."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11542 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11542 "current"^^xsd:string)
Declaration(Class(goldbook:11543))
AnnotationAssertion(rdfs:label goldbook:11543 "nominal mass")
AnnotationAssertion(dcterms:description goldbook:11543 "Mass of a molecular ion or molecule calculated using the isotope mass of the most abundant constituent element isotope of each element rounded to the nearest integer value and multiplied by the number of atoms of each element.")
AnnotationAssertion(mito:isMentionedBy goldbook:11543 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11543 "current"^^xsd:string)
Declaration(Class(goldbook:11544))
AnnotationAssertion(rdfs:label goldbook:11544 "reflectron")
AnnotationAssertion(dcterms:description goldbook:11544 "Component of a time-of-flight mass spectrometer that uses a static electric field to reverse the direction of travel of the ions and improves mass resolution by assuring that ions of the same m/z but different translational energy arrive at the detector at the same time.")
AnnotationAssertion(mito:isMentionedBy goldbook:11544 doi:10.1515/pac-2019-0404)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11544 "current"^^xsd:string)
Declaration(Class(goldbook:11545))
AnnotationAssertion(rdfs:label goldbook:11545 "adhesion")
AnnotationAssertion(dcterms:description goldbook:11545 "Attachment of interfaces between phases or components that is maintained by intermolecular forces, chain entanglements, or both.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11545 "tack")
AnnotationAssertion(rdfs:comment goldbook:11545 "Interfacial adhesion is also referred to as tack."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11545 "Adhesive strength (recommended symbol: \\(F_{\\rm{a}}\\), unit: \\(\\pu{N m^{-2}}\\)) is the force required to separate one condensed phase domain from another at the interface between the two phase domains divided by the area of the interface."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11545 "Interfacial tension (recommended symbol: \\(\\upgamma\\), unit: \\(\\pu{N m^{-1}}\\), \\(\\pu{J m^{-2}}\\)) is the change in Gibbs energy per unit change in interfacial area for substances in physical contact."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11545 doi:10.1515/pac-2018-1215)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11545 "current"^^xsd:string)
Declaration(Class(goldbook:11546))
AnnotationAssertion(rdfs:label goldbook:11546 "Michaelis–Menten equation")
AnnotationAssertion(dcterms:description goldbook:11546 "The relationship between the initial rate (velocity) of an enzyme-catalysed reaction \\(v_{0}\\) and the initial substrate concentration \\([\\ce{S}]_{0}\\) in the form \\[v_{0} = V[\\ce{S}]_{0}/(K_{\\rm{M}} + [\\ce{S}]_{0})\\] where \\(V\\) (the limiting rate) and \\(K_{\\rm{M}}\\) (the Michaelis constant) are independent of the initial substrate concentration and constant at a given temperature and a given enzyme concentration. The reaction is then said to display Michaelis–Menten kinetics.")
AnnotationAssertion(rdfs:comment goldbook:11546 "The term ‘hyperbolic kinetics’ is also sometimes used, because a plot of \\(v_{0}\\) against \\([\\ce{S}]_{0}\\) has the form of a rectangular hyperbola through the origin with asymptotes \\(v_{0} = V\\) and \\([\\ce{S}]_{0} = -K_{\\rm{M}}\\). This term, and others that imply the use of particular kinds of plot, should be used with care to avoid ambiguity, as they can be misleading if used out of context."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11546 "The symbol \\(V_{\\rm{max}}\\) and the names \"maximum rate\" and \"maximum velocity\" are also in widespread use, although in general and under normal circumstances there is no finite substrate concentration at which \\(v_{0} = V\\). Hence, there is no maximum in the mathematical sense. The alternative name Michaelis concentration for \\(K_{\\rm{M}}\\) may also be used and has the advantage of emphasizing that the quantity concerned has the dimension of a concentration and is not, in general, an equilibrium constant. The Michaelis constant is the substrate concentration at which \\(v_{0} = V/2\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11546 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11546 "current"^^xsd:string)
Declaration(Class(goldbook:11547))
AnnotationAssertion(rdfs:label goldbook:11547 "protein sequencing")
AnnotationAssertion(dcterms:description goldbook:11547 "Determination of the primary structure of a protein.")
AnnotationAssertion(mito:isMentionedBy goldbook:11547 doi:10.1515/pac-2016-1120)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11547 "current"^^xsd:string)
Declaration(Class(goldbook:11548))
AnnotationAssertion(rdfs:label goldbook:11548 "zone pH")
AnnotationAssertion(dcterms:description goldbook:11548 "pH of the solute zone in pH-zone-refining counter-current chromatography. \\[{\\rm{pH}}_{\\rm{zone}} = \\pu{p}K_{\\rm{a}} + \\log[(K_{\\rm{DS}}/K_{\\rm{S}}) - 1]\\], where \\(K_{\\rm{DS}}\\) is the partition ratio of solute $\\ce{S}$ (an indicator for solute hydrophobicity) and \\(K_{\\rm{S}}\\), the dissociation constant of the solute.")
AnnotationAssertion(rdfs:comment goldbook:11548 "According to theoretical analysis two solutes that differ their zone \\(\\pu{pH}\\) values by \\(\\pu{0.2}\\) or greater can be resolved in \\(\\pu{pH}\\)-zone-refining CCC."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11548 goldbook:09947)
AnnotationAssertion(mito:isMentionedBy goldbook:11548 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11548 "current"^^xsd:string)
Declaration(Class(goldbook:11549))
AnnotationAssertion(rdfs:label goldbook:11549 "intraparticle volume of the column")
AnnotationAssertion(dcterms:description goldbook:11549 "Volume of the mobile phase within the pores of the particles in the stationary phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11549 "intrastitial volume of the column")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11549 "stationary mobile-phase volume")
AnnotationAssertion(rdfs:comment goldbook:11549 "The retention time equivalent to \\(V_{\\rm{i}}\\) is \\(t_{\\rm{i}}\\) \\[t_{\\rm{i}} = \\frac{V_{\\rm{i}}}{F_{\\rm{c}}}\\]"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11549 goldbook:09963)
AnnotationAssertion(mito:isMentionedBy goldbook:11549 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11549 "current"^^xsd:string)
Declaration(Class(goldbook:11550))
AnnotationAssertion(rdfs:label goldbook:11550 "distribution constant (exclusion)")
AnnotationAssertion(dcterms:description goldbook:11550 "Fraction of the intraparticle volume (the volume of the pores) available to the molecules of a particular sample component for diffusion: \\[K_{0} = \\frac{V_{\\rm{R}} - V_0}{V_{\\rm{i}}}\\]")
AnnotationAssertion(rdfs:comment goldbook:11550 "The value of \\(K_{0}\\) varies between zero and unity. For an unretained compound, \\(V_{\\rm{R}} = V_{0}\\) and thus, \\(K_{0} = 0\\). On the other hand, for a compound the molecules of which are smaller than the smallest pores, \\(V_{\\rm{R}} = V_{\\rm{t}}\\) and thus, \\(K_{0} = 1\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11550 "In exclusion chromatography, \\(K_{0}\\) is related to the retention volume of a sample component and the inter- and intraparticle volumes of the column (\\(V_{0}\\) and \\(V_{\\rm{i}}\\), respectively) in a manner analogous to the relationship in general liquid chromatography: \\[V_{\\rm{R}} = V_{0} + K_{0}V_{\\rm{i}}\\]"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11550 goldbook:09961)
AnnotationAssertion(rdfs:seeAlso goldbook:11550 goldbook:11549)
AnnotationAssertion(mito:isMentionedBy goldbook:11550 doi:10.1515/pac-2017-0111)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11550 "current"^^xsd:string)
Declaration(Class(goldbook:11551))
AnnotationAssertion(rdfs:label goldbook:11551 "distribution constant calibration")
AnnotationAssertion(dcterms:description goldbook:11551 "Calibration for extraction when close to equilibrium conditions, using a known for the distribution constant for the analyte.")
AnnotationAssertion(mito:isMentionedBy goldbook:11551 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11551 "current"^^xsd:string)
Declaration(Class(goldbook:11552))
AnnotationAssertion(rdfs:label goldbook:11552 "microextraction (methology)")
AnnotationAssertion(dcterms:description goldbook:11552 "Extraction method characterized by a low phase ratio, so that at equilibrium the fraction extracted is low (i.e. the extraction is not exhaustive).")
AnnotationAssertion(mito:isMentionedBy goldbook:11552 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11552 "current"^^xsd:string)
Declaration(Class(goldbook:11553))
AnnotationAssertion(rdfs:label goldbook:11553 "microextraction (technique)")
AnnotationAssertion(dcterms:description goldbook:11553 "Extraction technique in which the volume (mass) of the extraction phase (liquid or solid) is substantially smaller than the sample volume (mass).")
AnnotationAssertion(rdfs:comment goldbook:11553 "The volume of extraction phase is typically \\(\\pu{\\lt 100 \\upmu L}\\) or (mass \\(\\lt \\pu{10 mg}\\)) and the sample volume is \\(\\gt \\pu{1 mL}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11553 goldbook:10175)
AnnotationAssertion(mito:isMentionedBy goldbook:11553 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11553 "current"^^xsd:string)
Declaration(Class(goldbook:11554))
AnnotationAssertion(rdfs:label goldbook:11554 "microextraction (packed sorbent)")
AnnotationAssertion(dcterms:description goldbook:11554 "Solid-phase extraction using a syringe with a short sorbent bed located between the plunger and the needle.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11554 "MEPS")
AnnotationAssertion(rdfs:comment goldbook:11554 "Typically based on a \\(\\pu{100 \\upmu L}\\) or \\(\\pu{250 \\upmu L}\\) volume syringe with a packed bed containing \\(\\pu{1\\!{–}\\! 2 mg}\\) of sorbent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11554 "The MEPS syringe facilitates low-dead volume sample processing by vertical movement of the plunger."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11554 goldbook:10255)
AnnotationAssertion(rdfs:seeAlso goldbook:11554 goldbook:10163)
AnnotationAssertion(mito:isMentionedBy goldbook:11554 doi:10.1515/pac-2015-0903)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11554 "current"^^xsd:string)
Declaration(Class(goldbook:11556))
AnnotationAssertion(rdfs:label goldbook:11556 "acclimation")
AnnotationAssertion(dcterms:description goldbook:11556 "Adjustment, physiologically and (or) behaviorally, of an organism to its environment or circumstances, e.g., thermoregulation, psychological adjustment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11556 "acclimatization")
AnnotationAssertion(rdfs:comment goldbook:11556 "In biology, acclimation refers to allowing this adjustment prior to initiating experimental observations, whereas the term acclimatization refers to adaptation or selection of an organism or population in its natural environment."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11556 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11556 "current"^^xsd:string)
Declaration(Class(goldbook:11557))
AnnotationAssertion(rdfs:label goldbook:11557 "acetylcholine")
AnnotationAssertion(dcterms:description goldbook:11557 "Substance that functions as a neurotransmitter between nerve cells and between nerves and muscles.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11557 "ACh")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11557 "2-acetoxy-N,N,N-trimethylethanaminium")
AnnotationAssertion(rdfs:seeAlso goldbook:11557 goldbook:11955)
AnnotationAssertion(mito:isMentionedBy goldbook:11557 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11557 "current"^^xsd:string)
Declaration(Class(goldbook:11558))
AnnotationAssertion(rdfs:label goldbook:11558 "acetylcholinesterase")
AnnotationAssertion(dcterms:description goldbook:11558 "Enzyme that hydrolyzes acetylcholine.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11558 "AChE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11558 "acetylcholine hydrolase")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11558 "cholinesterase inhibitor")
AnnotationAssertion(rdfs:seeAlso goldbook:11558 goldbook:11557)
AnnotationAssertion(mito:isMentionedBy goldbook:11558 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11558 "current"^^xsd:string)
Declaration(Class(goldbook:11559))
AnnotationAssertion(rdfs:label goldbook:11559 "acetylcholine receptor")
AnnotationAssertion(dcterms:description goldbook:11559 "Integral membrane protein that allows the cell to respond to the binding of acetylcholine.")
AnnotationAssertion(rdfs:seeAlso goldbook:11559 goldbook:11557)
AnnotationAssertion(mito:isMentionedBy goldbook:11559 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11559 "current"^^xsd:string)
Declaration(Class(goldbook:11560))
AnnotationAssertion(rdfs:label goldbook:11560 "acoustic neuroma")
AnnotationAssertion(dcterms:description goldbook:11560 "Non-malignant intracranial tumor of the eighth cranial nerve.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11560 "acoustic neurinoma")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11560 "vestibular Schwannoma")
AnnotationAssertion(rdfs:comment goldbook:11560 "This tumor arises from the Schwann cells."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11560 "The eighth cranial (vestibulocochlear) nerve is involved in both hearing and balance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11560 goldbook:12064)
AnnotationAssertion(rdfs:seeAlso goldbook:11560 goldbook:11700)
AnnotationAssertion(mito:isMentionedBy goldbook:11560 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11560 "current"^^xsd:string)
Declaration(Class(goldbook:11561))
AnnotationAssertion(rdfs:label goldbook:11561 "acroparesthesia")
AnnotationAssertion(dcterms:description goldbook:11561 "Abnormal feeling of numbness, tingling, or burning of the skin, typically in the extremities.")
AnnotationAssertion(mito:isMentionedBy goldbook:11561 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11561 "current"^^xsd:string)
Declaration(Class(goldbook:11562))
AnnotationAssertion(rdfs:label goldbook:11562 "action potential")
AnnotationAssertion(dcterms:description goldbook:11562 "Brief, spike-like depolarization associated with the passage of an impulse without decrement along the membrane of a muscle cell or nerve cell.")
AnnotationAssertion(rdfs:comment goldbook:11562 "It is used for rapid signaling over a distance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11562 "Action potentials also occur in many endocrine cells."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11562 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11562 "current"^^xsd:string)
Declaration(Class(goldbook:11563))
AnnotationAssertion(rdfs:label goldbook:11563 "active avoidance test")
AnnotationAssertion(dcterms:description goldbook:11563 "Fear-motivated associative avoidance test based on presentation of an adverse stimulus (e.g., an electric current) as a source of discomfort, to create an environment from which the animal or subject would prefer to escape.")
AnnotationAssertion(rdfs:comment goldbook:11563 "In this test, a mouse or rat learns to associate the occurrence of an aversive event with the presentation of a specific stimulus, and to avoid the event by actively moving to a different location. The number of avoidances (moving to the other location during the stimulus signal), number of non-responses or errors (failing to move to the other location during the trial), and response latency (time between signal onset and response), are used as an index of learning."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11563 goldbook:11626)
AnnotationAssertion(mito:isMentionedBy goldbook:11563 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11563 "current"^^xsd:string)
Declaration(Class(goldbook:11564))
AnnotationAssertion(rdfs:label goldbook:11564 "addiction")
AnnotationAssertion(dcterms:description goldbook:11564 "Compulsive, uncontrolled reward-seeking behavior, especially referring to substance use.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11564 "physical dependence")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11564 "psychological dependence")
AnnotationAssertion(rdfs:comment goldbook:11564 "An addiction may be psychological, referring to a craving or felt need for a behavior that produces a desired mental state without a known physiological basis, or it may be a physical (physiological) dependence in which discontinued use of a substance leads to symptoms of withdrawal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11564 goldbook:11798)
AnnotationAssertion(rdfs:seeAlso goldbook:11564 goldbook:12181)
AnnotationAssertion(mito:isMentionedBy goldbook:11564 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11564 "current"^^xsd:string)
Declaration(Class(goldbook:11565))
AnnotationAssertion(rdfs:label goldbook:11565 "adenoma")
AnnotationAssertion(dcterms:description goldbook:11565 "Benign tumor arising from epithelial cells in glandular tissue.")
AnnotationAssertion(mito:isMentionedBy goldbook:11565 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11565 "current"^^xsd:string)
Declaration(Class(goldbook:11566))
AnnotationAssertion(rdfs:label goldbook:11566 "adenosine receptor")
AnnotationAssertion(dcterms:description goldbook:11566 "Any of four types of purinergic receptors that respond to the nucleoside, adenosine, two of which are involved in release of the neurotransmitters, dopamine and glutamate.")
AnnotationAssertion(rdfs:comment goldbook:11566 "The stimulatory effects of caffeine are thought to be due to caffeine’s blockade of adenosine receptors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11566 goldbook:11723)
AnnotationAssertion(rdfs:seeAlso goldbook:11566 goldbook:11792)
AnnotationAssertion(rdfs:seeAlso goldbook:11566 goldbook:11955)
AnnotationAssertion(mito:isMentionedBy goldbook:11566 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11566 "current"^^xsd:string)
