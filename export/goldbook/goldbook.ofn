AnnotationAssertion(obo:goldbook#hasStatus goldbook:12111 "current"^^xsd:string)
Declaration(Class(goldbook:12112))
AnnotationAssertion(rdfs:label goldbook:12112 "synaptic plasticity")
AnnotationAssertion(dcterms:description goldbook:12112 "Ability of synapses to form and reform continually, including to allow learning. Malleability of signal strength arising at the level of synaptic transmission.")
AnnotationAssertion(rdfs:seeAlso goldbook:12112 goldbook:11767)
AnnotationAssertion(rdfs:seeAlso goldbook:12112 goldbook:12017)
AnnotationAssertion(rdfs:seeAlso goldbook:12112 goldbook:12114)
AnnotationAssertion(mito:isMentionedBy goldbook:12112 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12112 "current"^^xsd:string)
Declaration(Class(goldbook:12113))
AnnotationAssertion(rdfs:label goldbook:12113 "synaptic stripping")
AnnotationAssertion(dcterms:description goldbook:12113 "Removal of dysfunctional synapses.")
AnnotationAssertion(rdfs:seeAlso goldbook:12113 goldbook:11872)
AnnotationAssertion(mito:isMentionedBy goldbook:12113 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12113 "current"^^xsd:string)
Declaration(Class(goldbook:12114))
AnnotationAssertion(rdfs:label goldbook:12114 "synaptic transmission")
AnnotationAssertion(dcterms:description goldbook:12114 "Neurotransmitter release, diffusion, and receptor binding, propagating an impulse across a synapse.")
AnnotationAssertion(rdfs:seeAlso goldbook:12114 goldbook:11955)
AnnotationAssertion(rdfs:seeAlso goldbook:12114 goldbook:12109)
AnnotationAssertion(mito:isMentionedBy goldbook:12114 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12114 "current"^^xsd:string)
