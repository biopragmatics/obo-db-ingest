AnnotationAssertion(rdfs:label goldbook:S05692 "single-strand chain")
AnnotationAssertion(dcterms:description goldbook:S05692 "A chain that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through two atoms, one on each constitutional unit.")
