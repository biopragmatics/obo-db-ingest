Declaration(Class(goldbook:12956))
AnnotationAssertion(rdfs:label goldbook:12956 "blood group antigen")
AnnotationAssertion(dcterms:description goldbook:12956 "Surface antigen on erythrocytes, detectable with a specific antibody from other individuals.")
AnnotationAssertion(rdfs:comment goldbook:12956 "The major blood group antigens ABO and Rh (Rhesus) are used in routine blood banking to type blood, but there are many other blood group antigens that can also be detected in cross-matching."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12956 goldbook:12828)
