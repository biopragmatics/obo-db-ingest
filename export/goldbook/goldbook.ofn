AnnotationAssertion(mito:isMentionedBy goldbook:15867 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15867 "current"^^xsd:string)
Declaration(Class(goldbook:15868))
AnnotationAssertion(rdfs:label goldbook:15868 "maximum average daily concentration of an atmospheric pollutant")
AnnotationAssertion(dcterms:description goldbook:15868 "Highest of the average daily concentrations recorded at a definite point of measurement during a certain period of observation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15868 "peak daily average concentration of an air pollutant")
AnnotationAssertion(mito:isMentionedBy goldbook:15868 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15868 "current"^^xsd:string)
Declaration(Class(goldbook:15869))
AnnotationAssertion(rdfs:label goldbook:15869 "maximum contaminant level")
AnnotationAssertion(dcterms:description goldbook:15869 "Under the Safe Drinking Water Act (USA), primary MCL is a regulatory concentration for drinking water which takes into account both adverse effects (including sensitive populations) and technological feasibility (including natural background levels): Secondary MCL is a regulatory concentration based on 'welfare', such as taste and staining, rather than health, but also takes into account technical feasibility.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15869 "MCL")
AnnotationAssertion(rdfs:comment goldbook:15869 "MCL Goals (MCLG) under the Safe Drinking Water Act do not consider feasibility and are zero for all human and animal carcinogens."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15869 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15869 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15869 "current"^^xsd:string)
Declaration(Class(goldbook:15870))
AnnotationAssertion(rdfs:label goldbook:15870 "maximum exposure limit")
AnnotationAssertion(dcterms:description goldbook:15870 "Occupational exposure limit legally defined in the United Kingdom under COSHH as the maximum concentration of an airborne substance, averaged over a reference period, to which employees may be exposed by inhalation under any circumstances, and set on the advice of the HSC Advisory Committee on Toxic Substances.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15870 "MEL")
AnnotationAssertion(rdfs:seeAlso goldbook:15870 goldbook:15695)
AnnotationAssertion(mito:isMentionedBy goldbook:15870 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15870 "current"^^xsd:string)
Declaration(Class(goldbook:15871))
AnnotationAssertion(rdfs:label goldbook:15871 "maximum residue limit")
AnnotationAssertion(dcterms:description goldbook:15871 "Maximum contents of a pesticide residue (expressed as \\(\\pu{mg kg-1}\\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted in or on food commodities and animal feeds.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15871 "MRL")
AnnotationAssertion(rdfs:comment goldbook:15871 "MRLs are based on data obtained following good agricultural practice and foods derived from commodities that comply with the respective MRLs are intended to be toxicologically acceptable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15871 goldbook:15571)
AnnotationAssertion(rdfs:seeAlso goldbook:15871 goldbook:15746)
AnnotationAssertion(mito:isMentionedBy goldbook:15871 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15871 "current"^^xsd:string)
Declaration(Class(goldbook:15872))
AnnotationAssertion(rdfs:label goldbook:15872 "maximum residue limit for veterinary drugs")
AnnotationAssertion(dcterms:description goldbook:15872 "Maximum contents of a drug residue (expressed as \\(\\pu{mg kg-1}\\) or \\(\\pu{\\upmu g kg-1}\\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food commodities and animal feeds.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15872 "MRL")
AnnotationAssertion(rdfs:comment goldbook:15872 "The MRL is based on the type and amount of residue considered to be without any toxicological hazard for human health as expressed by the acceptable daily intake (ADI) or on the basis of a temporary ADI that uses an additional uncertainty factor. It also takes into account other relevant public health risks as well as food technological aspects."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15872 goldbook:15571)
AnnotationAssertion(rdfs:seeAlso goldbook:15872 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15872 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15872 "current"^^xsd:string)
Declaration(Class(goldbook:15873))
AnnotationAssertion(rdfs:label goldbook:15873 "maximum velocity")
AnnotationAssertion(dcterms:description goldbook:15873 "In Michaelis–Menten kinetics, the maximum rate of conversion of a substrate when its concentration is not rate-limiting.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15873 "maximum rate")
AnnotationAssertion(rdfs:seeAlso goldbook:15873 goldbook:15550)
AnnotationAssertion(mito:isMentionedBy goldbook:15873 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15873 "current"^^xsd:string)
Declaration(Class(goldbook:15874))
AnnotationAssertion(rdfs:label goldbook:15874 "mercurialism")
AnnotationAssertion(dcterms:description goldbook:15874 "Chronic poisoning caused by exposure to mercury, often by breathing its vapor but also by skin absorption and, less commonly, by ingestion.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15874 "Mad Hatter syndrome")
AnnotationAssertion(rdfs:comment goldbook:15874 "Central nervous system damage usually predominates."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15874 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15874 "current"^^xsd:string)
Declaration(Class(goldbook:15875))
AnnotationAssertion(rdfs:label goldbook:15875 "mesothelioma")
AnnotationAssertion(dcterms:description goldbook:15875 "Malignant tumor of the mesothelium of the pleura, pericardium, or peritoneum, that may be caused by exposure to asbestos fibers and some other fibers.")
AnnotationAssertion(mito:isMentionedBy goldbook:15875 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15875 "current"^^xsd:string)
Declaration(Class(goldbook:15876))
AnnotationAssertion(rdfs:label goldbook:15876 "metabolic enzymes")
AnnotationAssertion(dcterms:description goldbook:15876 "Proteins that catalyze chemical transformations of body constituents and, in more common usage, of xenobiotics.")
AnnotationAssertion(mito:isMentionedBy goldbook:15876 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15876 "current"^^xsd:string)
Declaration(Class(goldbook:15877))
AnnotationAssertion(rdfs:label goldbook:15877 "metabolic model")
AnnotationAssertion(dcterms:description goldbook:15877 "Analysis and theoretical reconstruction of the way in which the body deals with a specific substance, showing the proportion of the intake that is absorbed, the proportion that is stored and in what tissues, the rate of breakdown in the body and the subsequent fate of the metabolic products, and the rate at which it is eliminated by different organs as unchanged substance or metabolites.")
AnnotationAssertion(mito:isMentionedBy goldbook:15877 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15877 "current"^^xsd:string)
Declaration(Class(goldbook:15878))
AnnotationAssertion(rdfs:label goldbook:15878 "metabolic transformation")
AnnotationAssertion(dcterms:description goldbook:15878 "Biotransformation of a substance that takes place within a living organism.")
AnnotationAssertion(mito:isMentionedBy goldbook:15878 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15878 "current"^^xsd:string)
Declaration(Class(goldbook:15879))
AnnotationAssertion(rdfs:label goldbook:15879 "metastasis")
AnnotationAssertion(dcterms:description goldbook:15879 "Movement of bacteria or body cells, especially cancer cells, from one part of the body to another, resulting in change in location of a disease or of its symptoms from one part of the body to another. Growth of pathogenic microorganisms or of abnormal cells distant from the site of their origin in the body.")
AnnotationAssertion(mito:isMentionedBy goldbook:15879 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15879 "current"^^xsd:string)
Declaration(Class(goldbook:15880))
AnnotationAssertion(rdfs:label goldbook:15880 "methemoglobin")
AnnotationAssertion(dcterms:description goldbook:15880 "Derivative of hemoglobin that is formed when the iron(II) in the heme porphyrin is oxidized to iron(III); this derivative cannot transport dioxygen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15880 "methaemoglobin")
AnnotationAssertion(rdfs:seeAlso goldbook:15880 goldbook:15765)
AnnotationAssertion(mito:isMentionedBy goldbook:15880 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15880 "current"^^xsd:string)
Declaration(Class(goldbook:15881))
AnnotationAssertion(rdfs:label goldbook:15881 "methemoglobinaemia")
AnnotationAssertion(dcterms:description goldbook:15881 "Presence of methaemoglobin in the blood in greater than normal proportion.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15881 "methaemoglobinaemia")
AnnotationAssertion(mito:isMentionedBy goldbook:15881 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15881 "current"^^xsd:string)
Declaration(Class(goldbook:15882))
AnnotationAssertion(rdfs:label goldbook:15882 "methemoglobin-forming substance")
AnnotationAssertion(dcterms:description goldbook:15882 "Substance capable of oxidizing directly or indirectly the iron(II) in hemoglobin to iron(III) to form methemoglobin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15882 "methaemoglobin-forming substance")
AnnotationAssertion(mito:isMentionedBy goldbook:15882 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15882 "current"^^xsd:string)
Declaration(Class(goldbook:15883))
AnnotationAssertion(rdfs:label goldbook:15883 "microalbuminuria")
AnnotationAssertion(dcterms:description goldbook:15883 "Chronic presence of albumin in slight excess in urine.")
AnnotationAssertion(mito:isMentionedBy goldbook:15883 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15883 "current"^^xsd:string)
Declaration(Class(goldbook:15884))
AnnotationAssertion(rdfs:label goldbook:15884 "micromercurialism")
AnnotationAssertion(dcterms:description goldbook:15884 "Early or subclinical effects of exposure to elemental mercury detected at the low exposure levels.")
AnnotationAssertion(mito:isMentionedBy goldbook:15884 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15884 "current"^^xsd:string)
Declaration(Class(goldbook:15885))
AnnotationAssertion(rdfs:label goldbook:15885 "microproteinaemia")
AnnotationAssertion(dcterms:description goldbook:15885 "Chronic presence of microprotein (alpha-1 and beta-2 microglobulin) in blood, indicating proximal renal tubule damage.")
AnnotationAssertion(mito:isMentionedBy goldbook:15885 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15885 "current"^^xsd:string)
Declaration(Class(goldbook:15886))
AnnotationAssertion(rdfs:label goldbook:15886 "midstream sampling")
AnnotationAssertion(dcterms:description goldbook:15886 "Taking an aliquot of a flowing liquid, such as urine, avoiding initial and terminal flow periods which are likely to be unrepresentative.")
AnnotationAssertion(mito:isMentionedBy goldbook:15886 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15886 "current"^^xsd:string)
Declaration(Class(goldbook:15887))
AnnotationAssertion(rdfs:label goldbook:15887 "minimal risk level")
AnnotationAssertion(dcterms:description goldbook:15887 "Estimate of the daily human exposure to a hazardous substance that is likely to be without appreciable risk of adverse noncancer health effects over a specified duration of exposure: This substance-specific estimate is used by ATSDR health assessors to identify contaminants and potential health effects that may be of concern at hazardous waste sites.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15887 "MRL")
AnnotationAssertion(rdfs:seeAlso goldbook:15887 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15887 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15887 "current"^^xsd:string)
Declaration(Class(goldbook:15888))
AnnotationAssertion(rdfs:label goldbook:15888 "miscible")
AnnotationAssertion(dcterms:description goldbook:15888 "Liquid substances capable of mixing without separation into two phases; refers to liquid mixtures.")
AnnotationAssertion(mito:isMentionedBy goldbook:15888 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15888 "current"^^xsd:string)
Declaration(Class(goldbook:15889))
AnnotationAssertion(rdfs:label goldbook:15889 "miticide")
AnnotationAssertion(dcterms:description goldbook:15889 "Substance intended to kill mites.")
AnnotationAssertion(mito:isMentionedBy goldbook:15889 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15889 "current"^^xsd:string)
Declaration(Class(goldbook:15890))
AnnotationAssertion(rdfs:label goldbook:15890 "mitochondrion")
AnnotationAssertion(dcterms:description goldbook:15890 "Eukaryote cytoplasmic organelle that is bounded by an outer membrane and an inner membrane; the inner membrane has folds called cristae that are the center of ATP synthesis in oxidative phosphorylation in the animal cell and supplement ATP synthesis by the chloroplasts in photosynthetic cells.")
AnnotationAssertion(rdfs:comment goldbook:15890 "The mitochondrial matrix within the inner membrane contains ribosomes, many oxidative enzymes, and a circular DNA molecule that carries the genetic information for a number of these enzymes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15890 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15890 "current"^^xsd:string)
Declaration(Class(goldbook:15891))
AnnotationAssertion(rdfs:label goldbook:15891 "molluskicide")
AnnotationAssertion(dcterms:description goldbook:15891 "Substance intended to kill mollusks.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15891 "limacide")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15891 "molluscicide")
AnnotationAssertion(mito:isMentionedBy goldbook:15891 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15891 "current"^^xsd:string)
Declaration(Class(goldbook:15892))
AnnotationAssertion(rdfs:label goldbook:15892 "monooxygenase")
AnnotationAssertion(dcterms:description goldbook:15892 "Enzyme that catalyzes reactions between an organic compound and molecular oxygen in which one atom of the oxygen molecule is incorporated into the organic compound and one atom is reduced to water; involved in the metabolism of many natural and foreign compounds giving both unreactive products and products of different or increased toxicity from that of the parent compound.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15892 "mixed-function oxidase (MFO)")
AnnotationAssertion(rdfs:comment goldbook:15892 "Such enzymes are the main catalysts of phase I reactions in the metabolism of xenobiotics by the endoplasmic reticulum or by preparations of microsomes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15892 goldbook:15662)
AnnotationAssertion(mito:isMentionedBy goldbook:15892 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15892 "current"^^xsd:string)
Declaration(Class(goldbook:15893))
AnnotationAssertion(rdfs:label goldbook:15893 "morbidity")
AnnotationAssertion(dcterms:description goldbook:15893 "Any departure, subjective or objective, from a state of physiological or psychological well-being: In this sense, 'sickness', 'illness', and 'morbid condition' are similarly defined and synonymous.")
AnnotationAssertion(mito:isMentionedBy goldbook:15893 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15893 "current"^^xsd:string)
Declaration(Class(goldbook:15894))
AnnotationAssertion(rdfs:label goldbook:15894 "morbidity rate")
AnnotationAssertion(dcterms:description goldbook:15894 "Term (to be avoided) used loosely to refer to incidence or prevalence rates of disease.")
AnnotationAssertion(rdfs:seeAlso goldbook:15894 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:15894 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15894 "current"^^xsd:string)
Declaration(Class(goldbook:15895))
AnnotationAssertion(rdfs:label goldbook:15895 "morbidity survey")
AnnotationAssertion(dcterms:description goldbook:15895 "Method for the estimation of the prevalence and (or) incidence of a disease or diseases in a population.")
AnnotationAssertion(rdfs:seeAlso goldbook:15895 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:15895 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15895 "current"^^xsd:string)
Declaration(Class(goldbook:15896))
AnnotationAssertion(rdfs:label goldbook:15896 "mortality study")
AnnotationAssertion(dcterms:description goldbook:15896 "Investigation dealing with death rates or proportion of deaths attributed to specific causes as a measure of response.")
AnnotationAssertion(mito:isMentionedBy goldbook:15896 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15896 "current"^^xsd:string)
Declaration(Class(goldbook:15897))
AnnotationAssertion(rdfs:label goldbook:15897 "mucociliary transport")
AnnotationAssertion(dcterms:description goldbook:15897 "Process of removal of particles from the bronchi of the lungs in a mucus stream moved by cilia, thus contributing to uptake from the gastrointestinal tract.")
AnnotationAssertion(mito:isMentionedBy goldbook:15897 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15897 "current"^^xsd:string)
Declaration(Class(goldbook:15898))
AnnotationAssertion(rdfs:label goldbook:15898 "multicompartment model")
AnnotationAssertion(dcterms:description goldbook:15898 "Product of a compartmental analysis requiring more than two compartments.")
AnnotationAssertion(mito:isMentionedBy goldbook:15898 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15898 "current"^^xsd:string)
Declaration(Class(goldbook:15899))
AnnotationAssertion(rdfs:label goldbook:15899 "multifactorial disease")
AnnotationAssertion(dcterms:description goldbook:15899 "Illness with pathogenesis dependent on complex interplay of genetic and (or) environmental factors.")
AnnotationAssertion(mito:isMentionedBy goldbook:15899 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15899 "current"^^xsd:string)
Declaration(Class(goldbook:15900))
AnnotationAssertion(rdfs:label goldbook:15900 "multiple screening")
AnnotationAssertion(dcterms:description goldbook:15900 "Procedure that has evolved by combining single screening tests, and is the logical corollary of mass screening.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15900 "multiphasic screening")
AnnotationAssertion(rdfs:comment goldbook:15900 "Where much time and effort have been spent by a population in attending for a single test such as mass radiography, it is natural to consider the economy of offering other tests at the same time."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:15900 "Multiple (or multiphasic) screening implies the administration of a number of tests, in combination, to large groups of people."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15900 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15900 "current"^^xsd:string)
Declaration(Class(goldbook:15901))
AnnotationAssertion(rdfs:label goldbook:15901 "multipotent")
AnnotationAssertion(dcterms:description goldbook:15901 "Of a cell, capable of giving rise to several different kinds of structure or types of cell.")
AnnotationAssertion(mito:isMentionedBy goldbook:15901 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15901 "current"^^xsd:string)
Declaration(Class(goldbook:15902))
AnnotationAssertion(rdfs:label goldbook:15902 "multistage cluster sampling")
AnnotationAssertion(dcterms:description goldbook:15902 "Cluster sampling with more than two stages, each sampling being made on aggregates (or clusters) in which the clusters already obtained by the preceding sampling have been divided.")
AnnotationAssertion(mito:isMentionedBy goldbook:15902 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15902 "current"^^xsd:string)
Declaration(Class(goldbook:15903))
AnnotationAssertion(rdfs:label goldbook:15903 "multistage model")
AnnotationAssertion(dcterms:description goldbook:15903 "Dose–response model for cancer death estimation of the form \\[P = 1 - \\exp [-(q_{0} + q_{1}d_{1} + q_{2}d_{2} + \\ldots + q_{k}d_{k})]\\] where \\(P\\) is the probability of cancer death from a continuous dose rate, \\(d_{i}\\) , of group (or stage) \\(i = 0, 1, 2 \\ldots\\), the \\(q\\)’s are constants, and \\(k\\) is the number of dose groups (or, if less than the number of dose groups, \\(k\\) is the number of biological stages believed to be required in the carcinogenesis process). With the multistage model, it is assumed that cancer is initiated by cell mutations in a finite series of steps.")
AnnotationAssertion(mito:isMentionedBy goldbook:15903 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15903 "current"^^xsd:string)
Declaration(Class(goldbook:15904))
AnnotationAssertion(rdfs:label goldbook:15904 "murine")
AnnotationAssertion(dcterms:description goldbook:15904 "Of or belonging to the family of rats and mice (Muridae).")
AnnotationAssertion(mito:isMentionedBy goldbook:15904 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15904 "current"^^xsd:string)
Declaration(Class(goldbook:15905))
AnnotationAssertion(rdfs:label goldbook:15905 "myalgia")
AnnotationAssertion(dcterms:description goldbook:15905 "Pain or tenderness in a muscle or group of muscles.")
AnnotationAssertion(mito:isMentionedBy goldbook:15905 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15905 "current"^^xsd:string)
Declaration(Class(goldbook:15906))
AnnotationAssertion(rdfs:label goldbook:15906 "myasthenia")
AnnotationAssertion(dcterms:description goldbook:15906 "Muscular weakness.")
AnnotationAssertion(mito:isMentionedBy goldbook:15906 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15906 "current"^^xsd:string)
Declaration(Class(goldbook:15907))
AnnotationAssertion(rdfs:label goldbook:15907 "mycotoxin")
AnnotationAssertion(dcterms:description goldbook:15907 "Toxin produced by a fungus.")
AnnotationAssertion(mito:isMentionedBy goldbook:15907 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15907 "current"^^xsd:string)
Declaration(Class(goldbook:15908))
AnnotationAssertion(rdfs:label goldbook:15908 "nanotoxicology")
AnnotationAssertion(dcterms:description goldbook:15908 "Scientific discipline involving the study of the actual or potential danger presented by the harmful effects of nanoparticles on living organisms and ecosystems, of the relationship of such harmful effects to exposure, and of the mechanisms of action, diagnosis, prevention, and treatment of intoxications.")
AnnotationAssertion(mito:isMentionedBy goldbook:15908 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15908 "current"^^xsd:string)
Declaration(Class(goldbook:15909))
AnnotationAssertion(rdfs:label goldbook:15909 "natriuretic")
AnnotationAssertion(dcterms:description goldbook:15909 "Substance increasing the rate of excretion of sodium ion in the urine.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15909 "saluretic")
AnnotationAssertion(mito:isMentionedBy goldbook:15909 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15909 "current"^^xsd:string)
Declaration(Class(goldbook:15910))
AnnotationAssertion(rdfs:label goldbook:15910 "natural occurrence")
AnnotationAssertion(dcterms:description goldbook:15910 "Presence of a substance in nature, as distinct from presence resulting from inputs from human activities.")
AnnotationAssertion(rdfs:comment goldbook:15910 "The contamination of the natural environment by some man-made compounds may be so widespread that it is practically impossible to get access to biota with a truly natural level; only \"normal\" levels can be measured, those which are usually prevalent in places where there is no obvious local contamination."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15910 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15910 "current"^^xsd:string)
Declaration(Class(goldbook:15911))
AnnotationAssertion(rdfs:label goldbook:15911 "negligible risk")
AnnotationAssertion(dcterms:description goldbook:15911 "Probability of adverse effects occurring that can reasonably be described as trivial. Probability of adverse effects occurring that is so low that it cannot be reduced appreciably by increased regulation or investment of resources.")
AnnotationAssertion(mito:isMentionedBy goldbook:15911 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15911 "current"^^xsd:string)
Declaration(Class(goldbook:15912))
AnnotationAssertion(rdfs:label goldbook:15912 "nematicide")
AnnotationAssertion(dcterms:description goldbook:15912 "Substance intended to kill nematodes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15912 "nematocide")
AnnotationAssertion(mito:isMentionedBy goldbook:15912 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15912 "current"^^xsd:string)
Declaration(Class(goldbook:15913))
AnnotationAssertion(rdfs:label goldbook:15913 "neoplasia")
AnnotationAssertion(dcterms:description goldbook:15913 "New and abnormal formation of tissue as a tumor or growth by cell proliferation that is faster than normal and continues after the initial stimulus that initiated the proliferation has ceased.")
AnnotationAssertion(mito:isMentionedBy goldbook:15913 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15913 "current"^^xsd:string)
Declaration(Class(goldbook:15914))
AnnotationAssertion(rdfs:label goldbook:15914 "nephritis")
AnnotationAssertion(dcterms:description goldbook:15914 "Inflammation of the kidney, leading to kidney failure, usually accompanied by proteinuria, hematuria, edema, and hypertension.")
AnnotationAssertion(rdfs:seeAlso goldbook:15914 goldbook:15764)
AnnotationAssertion(rdfs:seeAlso goldbook:15914 goldbook:15796)
AnnotationAssertion(rdfs:seeAlso goldbook:15914 goldbook:16012)
AnnotationAssertion(mito:isMentionedBy goldbook:15914 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15914 "current"^^xsd:string)
Declaration(Class(goldbook:15915))
