    <!-- http://dx.doi.org/10.1351/goldbook.15527 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15527">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intermittent violent contraction of the air passages of the lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
