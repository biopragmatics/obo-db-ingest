AnnotationAssertion(dcterms:description goldbook:16158 "Term sometimes used to indicate a combination of investigative methods and techniques for making a quantitative assessment of toxicity and the hazards of potentially toxic substances.")
AnnotationAssertion(mito:isMentionedBy goldbook:16158 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16158 "current"^^xsd:string)
