[Term]
id: goldbook:09036
name: blank titration
def: "Titration performed with titrand containing no analyte."
comment: "A blank titration is used to estimate systematic error such as indicator consumption error."
property_value: mito:isMentionedBy doi:10.1515/pac-2023-0903
property_value: hasStatus "current" xsd:string
