AnnotationAssertion(obo:goldbook#hasStatus goldbook:S06073 "current"^^xsd:string)
Declaration(Class(goldbook:S06074))
AnnotationAssertion(rdfs:label goldbook:S06074 "substance flow rate")
AnnotationAssertion(dcterms:description goldbook:S06074 "Amount-of-substance of a component crossing a surface divided by the time. For clinical chemistry the term component is recommended. ISO uses 'substance'.")
AnnotationAssertion(rdfs:seeAlso goldbook:S06074 goldbook:C01209)
AnnotationAssertion(mito:isMentionedBy goldbook:S06074 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S06074 "current"^^xsd:string)
Declaration(Class(goldbook:S06075))
AnnotationAssertion(rdfs:label goldbook:S06075 "substance fraction")
AnnotationAssertion(dcterms:description goldbook:S06075 "Ratio of the amount-of-substance of the component to the total amount-of-substance in the system containing the component.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:S06075 "ISO")
AnnotationAssertion(rdfs:comment goldbook:S06075 "The term substance fraction is recommended for clinical chemistry, IUPAC also uses amount fraction and amount fraction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S06075 "For clinical chemistry the term component is recommended, ISO uses 'substance'."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S06075 "For clinical chemistry the term system is recommended, ISO uses mixture."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S06075 goldbook:A00296)
