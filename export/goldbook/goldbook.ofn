Declaration(Class(goldbook:LT07408))
AnnotationAssertion(rdfs:label goldbook:LT07408 "LADS")
AnnotationAssertion(dcterms:description goldbook:LT07408 "Acronym for lifetime-associated difference spectra.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:LT07408 "LADS")
