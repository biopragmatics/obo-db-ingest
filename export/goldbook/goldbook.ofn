AnnotationAssertion(rdfs:label goldbook:11785 "glial cell")
AnnotationAssertion(dcterms:description goldbook:11785 "Cellular component of the glia, including oligodendroglial cells, astrocytes, ependymal cells and microglial cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:11785 goldbook:11614)
