AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02630 "current"^^xsd:string)
Declaration(Class(goldbook:G02631))
AnnotationAssertion(rdfs:label goldbook:G02631 "Gibbs energy of activation")
AnnotationAssertion(dcterms:description goldbook:G02631 "The standard Gibbs energy difference between the transition state of a reaction (either an elementary reaction or a stepwise reaction) and the ground state of the reactants. It is calculated from the experimental rate constant \\(k\\) via the conventional form of the absolute rate equation: \\[\\Delta ^{\\ddagger}G = R\\ T\\ \\left[\\ln (\\frac{k_{\\rm{B}}}{h}) - \\ln (\\frac{k}{T})\\right]\\] where \\(k_{\\rm{B}}\\) is the Boltzmann constant and \\(h\\) the Planck constant (\\(\\frac{k_{\\rm{B}}}{h} = 2.083\\ 58\\times 10^{10}\\ \\rm{K}^{-1}\\ \\rm{s}^{-1}\\)). The values of the rate constants, and hence Gibbs energies of activation, depend upon the choice of concentration units (or of the thermodynamic standard state).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:G02631 "standard free energy of activation")
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:B00695)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:G02629)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:P04685)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:A00093)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:E02035)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:E02142)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:E02150)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:O04322)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:S05925)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:S05970)
AnnotationAssertion(rdfs:seeAlso goldbook:G02631 goldbook:T06468)
