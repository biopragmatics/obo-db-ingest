Declaration(Class(goldbook:13680))
AnnotationAssertion(rdfs:label goldbook:13680 "Sjögren syndrome")
AnnotationAssertion(dcterms:description goldbook:13680 "Chronic inflammation of the lachrymal and salivary glands, often accompanied by rheumatoid arthritis (RA) and the presence of autoantibodies in the blood, occurring chiefly among women.")
AnnotationAssertion(rdfs:comment goldbook:13680 "Two types of Sjögren syndrome are distinguished: a primary (isolated) type and a secondary type associated with another underlying autoimmune disease [e.g., RA, systemic lupus erythematosus (SLE), systemic sclerosis (SSc), primary biliary cirrhosis (PBC), autoimmune hepatitis (AIH), multiple sclerosis, autoimmune thyroiditis, etc.]. Ro/SS-A and La/SS-B autoantibodies are used as classification criteria."^^xsd:string)
