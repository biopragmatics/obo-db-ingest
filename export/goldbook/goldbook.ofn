Declaration(Class(goldbook:11998))
AnnotationAssertion(rdfs:label goldbook:11998 "Parkinson disease")
AnnotationAssertion(dcterms:description goldbook:11998 "Degenerative disorder of the central nervous system resulting from decreased production of the neurotransmitterdopamine in the basal ganglia (notably the substantia nigra).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11998 "idiopathic parkinsonism")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11998 "primary parkinsonism")
AnnotationAssertion(rdfs:comment goldbook:11998 "Characterized by rhythmic muscle tremor, rigidity of movement, and a mask-like face."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11998 "Usually idiopathic, although inherited cases occur."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11998 goldbook:11723)
AnnotationAssertion(rdfs:seeAlso goldbook:11998 goldbook:11955)
AnnotationAssertion(rdfs:seeAlso goldbook:11998 goldbook:12103)
AnnotationAssertion(rdfs:seeAlso goldbook:11998 goldbook:12149)
