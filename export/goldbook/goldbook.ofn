AnnotationAssertion(mito:isMentionedBy goldbook:C01077 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01077 "current"^^xsd:string)
Declaration(Class(goldbook:C01079))
AnnotationAssertion(rdfs:label goldbook:C01079 "chemically induced dynamic nuclear polarization")
AnnotationAssertion(dcterms:description goldbook:C01079 "Non-Boltzmann nuclear spin state distribution produced in thermal or photochemical reactions, usually from colligation and diffusion, or disproportionation of radical pairs, and detected by NMR spectroscopy by enhanced absorption or emission signals.")
