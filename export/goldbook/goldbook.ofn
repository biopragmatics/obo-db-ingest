Declaration(Class(goldbook:13104))
AnnotationAssertion(rdfs:label goldbook:13104 "Draize test")
AnnotationAssertion(dcterms:description goldbook:13104 "Context: ocular; Test for potential to cause irritation to the eye in which the test substance is applied directly to the eye of restrained rabbits. Note: Widely criticized as unethical. Now often replaced with an acute eye irritation test using cadaveric chicken eyes. Context: skin; Test for the potential of a material to cause irritation or corrosion following local dermal application. Generally performed with rabbits.")
AnnotationAssertion(mito:isMentionedBy goldbook:13104 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13104 "current"^^xsd:string)
