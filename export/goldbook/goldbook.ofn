AnnotationAssertion(dcterms:description goldbook:16113 "Formation of irreversible cleavage complexes (also referred to as 'suicide complexes') leading to cell death.")
AnnotationAssertion(mito:isMentionedBy goldbook:16113 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16113 "current"^^xsd:string)
Declaration(Class(goldbook:16114))
AnnotationAssertion(rdfs:label goldbook:16114 "summary sheet")
AnnotationAssertion(dcterms:description goldbook:16114 "Two-to-four page summary of a risk assessment.")
AnnotationAssertion(mito:isMentionedBy goldbook:16114 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16114 "current"^^xsd:string)
Declaration(Class(goldbook:16115))
AnnotationAssertion(rdfs:label goldbook:16115 "summation")
AnnotationAssertion(dcterms:description goldbook:16115 "Process of addition of separate postsynaptic responses caused by stimuli that are adjacent in time and space.")
AnnotationAssertion(rdfs:comment goldbook:16115 "Excitation of a synapse evokes a graded potential change in the postsynaptic membrane that may be below the threshold required to trigger an impulse. If two or more such potentials are caused either nearly simultaneously, at different synapses on the same neuron (spatial summation), or in rapid succession at the same synapse (temporal summation), the summed response may be sufficient to trigger a postsynaptic impulse. Summation may occur between excitatory potentials, inhibitory potentials, or between an excitatory and an inhibitory potential."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16115 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16115 "current"^^xsd:string)
Declaration(Class(goldbook:16116))
AnnotationAssertion(rdfs:label goldbook:16116 "Superfund")
AnnotationAssertion(dcterms:description goldbook:16116 "Federal authority, established by the U.S. Comprehensive Environmental Response, Compensation, and Liability Act (CERCLA) in 1980, to respond directly to releases or threatened releases (such as from landfills or waste disposal areas) of hazardous substances that may endanger health or welfare.")
AnnotationAssertion(rdfs:seeAlso goldbook:16116 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:16116 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16116 "current"^^xsd:string)
Declaration(Class(goldbook:16117))
AnnotationAssertion(rdfs:label goldbook:16117 "superoxide dismutase")
AnnotationAssertion(dcterms:description goldbook:16117 "Enzymatic antioxidant that removes the potentially toxic superoxide ion (\\(\\ce{O2^{-}}\\)) by disproportionating it to \\(\\ce{O2}\\) and hydrogen peroxide (\\(\\ce{H2O2}\\)).")
AnnotationAssertion(mito:isMentionedBy goldbook:16117 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16117 "current"^^xsd:string)
Declaration(Class(goldbook:16118))
AnnotationAssertion(rdfs:label goldbook:16118 "surrogate")
AnnotationAssertion(dcterms:description goldbook:16118 "Relatively well studied toxicant whose properties are assumed to apply to an entire chemically and toxicologically related class.")
AnnotationAssertion(mito:isMentionedBy goldbook:16118 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16118 "current"^^xsd:string)
Declaration(Class(goldbook:16119))
AnnotationAssertion(rdfs:label goldbook:16119 "susceptible")
AnnotationAssertion(dcterms:description goldbook:16119 "Describing a group of organisms more vulnerable to a given exposure than the majority of the population to which they belong.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16119 "vulnerable")
AnnotationAssertion(rdfs:comment goldbook:16119 "Susceptibility may reflect gender, age, physiological status, or genetic constitution of the organisms at risk."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16119 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16119 "current"^^xsd:string)
Declaration(Class(goldbook:16120))
AnnotationAssertion(rdfs:label goldbook:16120 "sympatholytic")
AnnotationAssertion(dcterms:description goldbook:16120 "adj., Blocking transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues. n., Agent that blocks transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16120 "anti-adrenergic")
AnnotationAssertion(mito:isMentionedBy goldbook:16120 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16120 "current"^^xsd:string)
Declaration(Class(goldbook:16121))
AnnotationAssertion(rdfs:label goldbook:16121 "symptom")
AnnotationAssertion(dcterms:description goldbook:16121 "Any subjective evidence of a disease or an effect induced by a substance as perceived by the affected subject.")
AnnotationAssertion(mito:isMentionedBy goldbook:16121 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16121 "current"^^xsd:string)
Declaration(Class(goldbook:16122))
AnnotationAssertion(rdfs:label goldbook:16122 "symptomatology")
AnnotationAssertion(dcterms:description goldbook:16122 "General description of all of the signs and symptoms of exposure to a toxicant.")
AnnotationAssertion(rdfs:comment goldbook:16122 "Signs are the overt (observable) responses associated with exposure (such as convulsions, death, etc.), whereas symptoms are covert (subjective) responses (such as nausea, headache, etc.)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16122 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16122 "current"^^xsd:string)
Declaration(Class(goldbook:16123))
AnnotationAssertion(rdfs:label goldbook:16123 "synergist")
AnnotationAssertion(dcterms:description goldbook:16123 "Substance that contributes more than additively to a mutual effect with another substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:16123 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16123 "current"^^xsd:string)
Declaration(Class(goldbook:16124))
AnnotationAssertion(rdfs:label goldbook:16124 "synomone")
AnnotationAssertion(dcterms:description goldbook:16124 "Semiochemical that is produced by one organism inducing a response in an organism of another species that is favorable to both the emitter and the responding organism.")
AnnotationAssertion(rdfs:seeAlso goldbook:16124 goldbook:16082)
AnnotationAssertion(rdfs:seeAlso goldbook:16124 goldbook:15458)
AnnotationAssertion(rdfs:seeAlso goldbook:16124 goldbook:15841)
