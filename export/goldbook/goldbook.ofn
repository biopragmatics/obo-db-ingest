AnnotationAssertion(rdfs:label goldbook:12960 "bone marrow transplantation")
AnnotationAssertion(dcterms:description goldbook:12960 "Transfer of bone marrow from a donor to a recipient whose bone marrow has been ablated.")
AnnotationAssertion(rdfs:comment goldbook:12960 "Bone marrow transplantation is used to treat both non-neoplastic and neoplastic conditions not amenable to other forms of therapy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12960 "It has been used especially in cases of aplastic anemia, acute lymphoblastic (lymphocytic) leukemia (ALL), and acute myelogenous leukemia (AML)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12960 goldbook:12837)
AnnotationAssertion(rdfs:seeAlso goldbook:12960 goldbook:12838)
