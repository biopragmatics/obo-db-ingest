Declaration(Class(goldbook:C00775))
AnnotationAssertion(rdfs:label goldbook:C00775 "calibration")
AnnotationAssertion(dcterms:description goldbook:C00775 "The set of operations which establish, under specified conditions, the relationship between values indicated by the analytical instrument and the corresponding known values of an analyte.")
AnnotationAssertion(rdfs:seeAlso goldbook:C00775 goldbook:A00333)
AnnotationAssertion(rdfs:seeAlso goldbook:C00775 goldbook:C00780)
AnnotationAssertion(mito:isMentionedBy goldbook:C00775 doi:10.1351/pac198961091657)
