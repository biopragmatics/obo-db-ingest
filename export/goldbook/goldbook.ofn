AnnotationAssertion(rdfs:label goldbook:12156 "vagus nerve")
AnnotationAssertion(dcterms:description goldbook:12156 "Tenth cranial nerve, arising from the medulla oblongata.")
AnnotationAssertion(rdfs:comment goldbook:12156 "It carries parasympathetic and motor impulses to the larynx and pharynx, thoracic organs and abdominal viscera, as well as containing afferent fibers that supply information about the state of the organs to the central nervous system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12156 goldbook:11571)
AnnotationAssertion(rdfs:seeAlso goldbook:12156 goldbook:11700)
AnnotationAssertion(rdfs:seeAlso goldbook:12156 goldbook:11993)
