AnnotationAssertion(dcterms:description goldbook:13036 "Differing at a single genetic locus.")
AnnotationAssertion(mito:isMentionedBy goldbook:13036 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13036 "current"^^xsd:string)
