AnnotationAssertion(dcterms:description goldbook:12105 "Abnormal protrusion of brain structures into compartments above the tentorium, or over the edge of the tentorium, due to increased intracranial pressure.")
AnnotationAssertion(rdfs:seeAlso goldbook:12105 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:12105 goldbook:11836)
AnnotationAssertion(rdfs:seeAlso goldbook:12105 goldbook:12126)
AnnotationAssertion(mito:isMentionedBy goldbook:12105 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12105 "current"^^xsd:string)
Declaration(Class(goldbook:12106))
AnnotationAssertion(rdfs:label goldbook:12106 "swimming test")
AnnotationAssertion(dcterms:description goldbook:12106 "Procedure in which a test animal (rodent) is forced to swim to avoid drowning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12106 "behavioral despair test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12106 "forced swimming test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12106 "Porsolt forced swimming test")
AnnotationAssertion(rdfs:comment goldbook:12106 "Most often used to test antidepressants, which increase the time the animal spends in escape-directed swimming behavior."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12106 "Interpretation is controversial, as cessation of swimming could be a learned response to hasten removal by the investigator."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12106 goldbook:11592)
AnnotationAssertion(rdfs:seeAlso goldbook:12106 goldbook:12120)
AnnotationAssertion(mito:isMentionedBy goldbook:12106 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12106 "current"^^xsd:string)
Declaration(Class(goldbook:12107))
AnnotationAssertion(rdfs:label goldbook:12107 "sympathetic nervous system")
AnnotationAssertion(dcterms:description goldbook:12107 "Part of the autonomic nervous system originating in the thoracic and lumbar regions of the spinal cord that tends to inhibit or oppose the physiological effects of the parasympathetic nervous system, as in tending to reduce digestive secretions, increase the heart rate, and contract blood vessels.")
AnnotationAssertion(rdfs:seeAlso goldbook:12107 goldbook:11625)
AnnotationAssertion(rdfs:seeAlso goldbook:12107 goldbook:11856)
AnnotationAssertion(rdfs:seeAlso goldbook:12107 goldbook:11993)
AnnotationAssertion(rdfs:seeAlso goldbook:12107 goldbook:12136)
AnnotationAssertion(mito:isMentionedBy goldbook:12107 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12107 "current"^^xsd:string)
Declaration(Class(goldbook:12108))
AnnotationAssertion(rdfs:label goldbook:12108 "sympathomimetic")
AnnotationAssertion(dcterms:description goldbook:12108 "n., Substance that produces effects resembling those of impulses transmitted by the postganglionic fibers of the sympathetic nervous system. adj., Having the property of producing such effects.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12108 "adrenergic")
AnnotationAssertion(rdfs:seeAlso goldbook:12108 goldbook:11779)
AnnotationAssertion(rdfs:seeAlso goldbook:12108 goldbook:12107)
AnnotationAssertion(mito:isMentionedBy goldbook:12108 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12108 "current"^^xsd:string)
