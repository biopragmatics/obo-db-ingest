AnnotationAssertion(obo:goldbook#hasStatus goldbook:AT07319 "current"^^xsd:string)
Declaration(Class(goldbook:AT07320))
AnnotationAssertion(rdfs:label goldbook:AT07320 "alkene photoisomerization")
AnnotationAssertion(dcterms:description goldbook:AT07320 "Photochemical process with geometrical isomerization of a carbon–carbon double bond.")
AnnotationAssertion(rdfs:comment goldbook:AT07320 "Geometrical isomerization of a C–C double bond is called a cis/trans isomerization in 1,2-disubstituted alkenes. E/Z isomerization is a more general designation applying also to higher substituted alkenes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:AT07320 "This process leads to a photostationary state if both isomers absorb light under the reaction conditions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:AT07320 goldbook:A00224)
AnnotationAssertion(rdfs:seeAlso goldbook:AT07320 goldbook:I03295)
AnnotationAssertion(rdfs:seeAlso goldbook:AT07320 goldbook:P04654)
