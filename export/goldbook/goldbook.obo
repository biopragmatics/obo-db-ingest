property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15809
name: incidence rate
def: "Measure of the frequency at which new events occur in a population."
comment: "This is the value obtained by dividing the number of new events that occur in a defined period by the population at risk of experiencing the event during this period, sometimes expressed as person-time."
