AnnotationAssertion(mito:isMentionedBy goldbook:16097 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16097 "current"^^xsd:string)
Declaration(Class(goldbook:16098))
