AnnotationAssertion(rdfs:label goldbook:12003 "peripheral nervous system")
AnnotationAssertion(dcterms:description goldbook:12003 "One of the two major divisions of the nervous system, made up of the nerves and ganglia lying outside the brain and spinal cord that transmit sensory and motor signals to and from the central nervous system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12003 "PNS")
AnnotationAssertion(rdfs:seeAlso goldbook:12003 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:12003 goldbook:11779)
