Declaration(Class(goldbook:13617))
AnnotationAssertion(rdfs:label goldbook:13617 "proteinase 3")
AnnotationAssertion(dcterms:description goldbook:13617 "Multifunctional enzyme of azurophilic granules of neutrophils and monocytes and the major target of antineutrophil cytoplasmic autoantibodies (ANCA).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13617 "PR3")
AnnotationAssertion(rdfs:comment goldbook:13617 "PR3 autoantibodies are diagnostic markers for Wegener granulomatosis (WG) and are involved in the pathogenesis of this disease. They are also found in patients with other autoimmune systemic vasculitic diseases."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13617 goldbook:13782)
AnnotationAssertion(rdfs:seeAlso goldbook:13617 goldbook:12896)
AnnotationAssertion(rdfs:seeAlso goldbook:13617 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13617 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13617 goldbook:13467)
AnnotationAssertion(rdfs:seeAlso goldbook:13617 goldbook:13510)
AnnotationAssertion(rdfs:seeAlso goldbook:13617 goldbook:13708)
AnnotationAssertion(mito:isMentionedBy goldbook:13617 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13617 "current"^^xsd:string)
Declaration(Class(goldbook:13618))
AnnotationAssertion(rdfs:label goldbook:13618 "protein G")
AnnotationAssertion(dcterms:description goldbook:13618 "Streptococcal cell wall protein that binds to the Fc region of immunoglobulin G (IgG), with a wider species specificity than protein A.")
AnnotationAssertion(rdfs:seeAlso goldbook:13618 goldbook:13137)
AnnotationAssertion(rdfs:seeAlso goldbook:13618 goldbook:13292)
AnnotationAssertion(rdfs:seeAlso goldbook:13618 goldbook:13616)
