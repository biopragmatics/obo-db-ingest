Declaration(Class(goldbook:10120))
AnnotationAssertion(rdfs:label goldbook:10120 "city-block distance")
AnnotationAssertion(dcterms:description goldbook:10120 "Distance (\\(d_{i,j}\\)) between two objects (\\(i\\) and \\(j\\)) calculated as the sum of the absolute difference between \\(k\\) variables (\\(x\\)) that describe the objects. \\[d_{i,j} = \\sum\\limits_{k\\,=\\,1}^{k\\,=\\,N} \\vert x_{i,k} - x_{j,k}\\vert\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10120 "Hamming distance")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10120 "Manhattan distance")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10120 "taxi distance")
Declaration(Class(goldbook:10121))
AnnotationAssertion(rdfs:label goldbook:10121 "complete linkage")
AnnotationAssertion(dcterms:description goldbook:10121 "Linkage criterion in hierarchical clustering in which the distance between two clusters is the distance between those two objects (one from each cluster) that are farthest apart.")
Declaration(Class(goldbook:10122))
AnnotationAssertion(rdfs:label goldbook:10122 "dendrogram")
AnnotationAssertion(dcterms:description goldbook:10122 "Tree diagram used to illustrate the arrangement of clusters produced by hierarchical clustering.")
Declaration(Class(goldbook:10123))
AnnotationAssertion(rdfs:label goldbook:10123 "disjoint principal component analysis")
AnnotationAssertion(dcterms:description goldbook:10123 "Principal-component analysis (PCA) independently performed on each class as a step in classification.")
Declaration(Class(goldbook:10124))
AnnotationAssertion(rdfs:label goldbook:10124 "Euclidean distance")
AnnotationAssertion(dcterms:description goldbook:10124 "Distance (\\(d_{i,j}\\)) between two objects (\\(i\\) and \\(j\\)) calculated as the square root of the sum of the squared differences between \\(k\\) variables (\\(x\\)) that describe the objects. \\[d_{i,j} = \\sqrt {\\sum\\limits_{k\\,=\\,1}^{k\\,=\\,N} (x_{i,k} - x_{j,k})^2}\\]")
Declaration(Class(goldbook:10125))
AnnotationAssertion(rdfs:label goldbook:10125 "forward chaining")
AnnotationAssertion(dcterms:description goldbook:10125 "Inference method from data to hypothesis.")
Declaration(Class(goldbook:10126))
AnnotationAssertion(rdfs:label goldbook:10126 "forward stepwise linear discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10126 "Linear discriminant analysis in which variables to build the discriminant functions are introduced one at a time to maximise the discrimination, until there is no significant improvement.")
Declaration(Class(goldbook:10127))
AnnotationAssertion(rdfs:label goldbook:10127 "fuzzy clustering")
AnnotationAssertion(dcterms:description goldbook:10127 "Classification in which membership of an object in each possible class is given a weight between zero and one.")
Declaration(Class(goldbook:10128))
AnnotationAssertion(rdfs:label goldbook:10128 "hidden layer")
AnnotationAssertion(dcterms:description goldbook:10128 "Group of nodes in an artificial neural network between input layer and output layer.")
Declaration(Class(goldbook:10129))
AnnotationAssertion(rdfs:label goldbook:10129 "hierarchical clustering")
AnnotationAssertion(dcterms:description goldbook:10129 "Pattern recognition in which objects are linked together by use of an appropriate measure of distance between pairs of objects, and a linkage criterion, which specifies the dissimilarity of sets as a function of the pairwise distances between objects.")
Declaration(Class(goldbook:10130))
AnnotationAssertion(rdfs:label goldbook:10130 "<em>k</em>-means clustering")
AnnotationAssertion(dcterms:description goldbook:10130 "Unsupervised classification method which partitions objects into \\(k\\) groups, in which each object belongs to the group with the nearest mean.")
Declaration(Class(goldbook:10131))
AnnotationAssertion(rdfs:label goldbook:10131 "<em>k</em>-nearest neighbour")
AnnotationAssertion(dcterms:description goldbook:10131 "Non-parametric supervised classification method for objects based on the closest training examples in the variable space.")
Declaration(Class(goldbook:10132))
AnnotationAssertion(rdfs:label goldbook:10132 "Kohonen network")
AnnotationAssertion(dcterms:description goldbook:10132 "Type of self-organising map with low dimensional grid.")
Declaration(Class(goldbook:10133))
AnnotationAssertion(rdfs:label goldbook:10133 "linear discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10133 "Discriminant analysis in which the criterion function is based on the pooled covariance matrix.")
Declaration(Class(goldbook:10134))
AnnotationAssertion(rdfs:label goldbook:10134 "Mahalanobis distance")
AnnotationAssertion(dcterms:description goldbook:10134 "Distance (\\(d_{i,j}\\)) between an object characterised by vector of variables \\(\\boldsymbol{x}_{i}\\) and the centroid of a class \\(\\boldsymbol{\\mu}_{j}\\) with covariance matrix \\(\\boldsymbol{S}\\) calculated as \\[d_{i,j} = \\sqrt {(\\boldsymbol{x}_{i} - \\boldsymbol{\\mu}_{j})^T \\boldsymbol{S}^{-1}(\\boldsymbol{x}_{i} - \\boldsymbol{\\mu}_{j})}\\] where \\(\\boldsymbol{S}\\) is the covariance matrix of the variables.")
Declaration(Class(goldbook:10135))
AnnotationAssertion(rdfs:label goldbook:10135 "misclassification rate")
AnnotationAssertion(dcterms:description goldbook:10135 "Fraction of objects incorrectly assigned to a group in supervised classification.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10135 "misclassification frequency")
Declaration(Class(goldbook:10136))
AnnotationAssertion(rdfs:label goldbook:10136 "one-class classification")
AnnotationAssertion(dcterms:description goldbook:10136 "Classification identifying objects of a specific class amongst all objects, by learning from training data containing only objects of the specific class.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10136 "independent classification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10136 "unary classification")
Declaration(Class(goldbook:10137))
AnnotationAssertion(rdfs:label goldbook:10137 "node")
AnnotationAssertion(dcterms:description goldbook:10137 "Locations in an artificial neural network that carry values that are calculated from values of connected nodes and weights by a transfer.")
Declaration(Class(goldbook:10138))
AnnotationAssertion(rdfs:label goldbook:10138 "partial least squares discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10138 "Linear classification in which the criterion function is obtained by partial least squares analysis.")
Declaration(Class(goldbook:10139))
AnnotationAssertion(rdfs:label goldbook:10139 "quadratic discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10139 "Discriminant analysis in which the criterion function is based on the individual within-group covariance matrix.")
Declaration(Class(goldbook:10140))
AnnotationAssertion(rdfs:label goldbook:10140 "regularized discriminant analysis")
AnnotationAssertion(dcterms:description goldbook:10140 "Discriminant analysis in which the criterion function is based on a combination of pooled covariance matrix and the individual within-group covariance matrix.")
Declaration(Class(goldbook:10141))
AnnotationAssertion(rdfs:label goldbook:10141 "similarity index")
AnnotationAssertion(dcterms:description goldbook:10141 "Quantity that describes the equivalence of two objects characterised by multivariate data.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10141 "similarity distance")
Declaration(Class(goldbook:10142))
AnnotationAssertion(rdfs:label goldbook:10142 "single linkage")
AnnotationAssertion(dcterms:description goldbook:10142 "Linkage criterion in hierarchical clustering in which the distance between two clusters is the distance between those two objects (one from each cluster) that are closest together.")
Declaration(Class(goldbook:10143))
AnnotationAssertion(rdfs:label goldbook:10143 "soft independent modelling of class analogy")
AnnotationAssertion(dcterms:description goldbook:10143 "Supervised classification that performs a principal-component analysis on each class, and then an unknown is assigned to the class with which it has the lowest residual variance.")
Declaration(Class(goldbook:10144))
AnnotationAssertion(rdfs:label goldbook:10144 "supervised classification")
AnnotationAssertion(dcterms:description goldbook:10144 "Classification in which, in a first step, a model is built using data from objects of known classes, and in a second step, the model is applied to new data to assign a class to unknown objects.")
Declaration(Class(goldbook:10145))
AnnotationAssertion(rdfs:label goldbook:10145 "Tanimoto similarity index")
AnnotationAssertion(dcterms:description goldbook:10145 "Fraction of variables that are considered to agree between two objects.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10145 "Tanimoto index")
Declaration(Class(goldbook:10146))
AnnotationAssertion(rdfs:label goldbook:10146 "unsupervised classification")
AnnotationAssertion(dcterms:description goldbook:10146 "Classification in which no prior information about membership of groups is known.")
Declaration(Class(goldbook:10147))
AnnotationAssertion(rdfs:label goldbook:10147 "unweighted pair group method with arithmetic mean")
AnnotationAssertion(dcterms:description goldbook:10147 "Linkage criterion in hierarchical clustering in which the distance between two clusters is the average of all distances between pairs of objects.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10147 "average linkage")
Declaration(Class(goldbook:10148))
AnnotationAssertion(rdfs:label goldbook:10148 "Ward’s minimum variance method")
AnnotationAssertion(dcterms:description goldbook:10148 "Linkage criterion in hierarchical clustering in which the within-cluster variance is minimized.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10148 "Ward’s method")
Declaration(Class(goldbook:10149))
AnnotationAssertion(rdfs:label goldbook:10149 "least squares regression")
AnnotationAssertion(dcterms:description goldbook:10149 "Regression that minimizes the sum of squared differences between observed values of a variable and the values predicted by a model.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10149 "LS regression")
Declaration(Class(goldbook:10150))
AnnotationAssertion(rdfs:label goldbook:10150 "errors-in-variables regression")
AnnotationAssertion(dcterms:description goldbook:10150 "Least squares regression in which both the response variable and predictor variable have measurement error.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10150 "total least squares regression")
Declaration(Class(goldbook:10151))
AnnotationAssertion(rdfs:label goldbook:10151 "mean squared error of calibration")
AnnotationAssertion(dcterms:description goldbook:10151 "In calibration for \\(N\\) calibration data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the value predicted by the calibration function. \\[E_{\\rm{MSEC}} = \\frac{\\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i} - c_{i})^2}{N}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10151 "mean residual sum of squares")
Declaration(Class(goldbook:10152))
AnnotationAssertion(rdfs:label goldbook:10152 "multilinear least squares regression")
AnnotationAssertion(dcterms:description goldbook:10152 "Multivariate calibration in which the coefficients of the regression are calculated directly from the indications and values of standards.")
Declaration(Class(goldbook:10153))
AnnotationAssertion(rdfs:label goldbook:10153 "multivariate calibration")
AnnotationAssertion(dcterms:description goldbook:10153 "Calibration in which the indications are multivariate data.")
Declaration(Class(goldbook:10154))
AnnotationAssertion(rdfs:label goldbook:10154 "ordinary least squares regression")
AnnotationAssertion(dcterms:description goldbook:10154 "Least squares regression that minimizes the sum of squared differences between the known values of dependent variable and values predicted by a linear model.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10154 "classical least squares regression")
Declaration(Class(goldbook:10155))
AnnotationAssertion(rdfs:label goldbook:10155 "partial least squares regression")
AnnotationAssertion(dcterms:description goldbook:10155 "Multivariate calibration which finds factors that maximise covariance between two blocks of data.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10155 "partial least squares")
Declaration(Class(goldbook:10156))
AnnotationAssertion(rdfs:label goldbook:10156 "principal components regression")
AnnotationAssertion(dcterms:description goldbook:10156 "Multivariate calibration in which a dependent variable is regressed against the scores of a chosen number of factors obtained from principal-component analysis of the predictor variable.")
Declaration(Class(goldbook:10157))
AnnotationAssertion(rdfs:label goldbook:10157 "root mean squared error of calibration")
AnnotationAssertion(dcterms:description goldbook:10157 "In calibration for \\(N\\) calibration data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the value predicted by the calibration function. \\[E_{\\rm{RMSEC}} = \\sqrt \\frac{\\sum\\limits_{i\\,=\\,1}^{i,=\\,N} (\\hat c_{i} - c_{i})^2}{N}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10157 "standard error of calibration (SEC)")
Declaration(Class(goldbook:10158))
AnnotationAssertion(rdfs:label goldbook:10158 "underfitting of a calibration model")
AnnotationAssertion(dcterms:description goldbook:10158 "Condition in which a model fails to describe the data adequately.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10158 "underfitting")
Declaration(Class(goldbook:10159))
AnnotationAssertion(rdfs:label goldbook:10159 "weighted least squares regression")
AnnotationAssertion(dcterms:description goldbook:10159 "Least squares regression in which a nonnegative constant is associated with each value of the dependent variable.")
Declaration(Class(goldbook:10160))
AnnotationAssertion(rdfs:label goldbook:10160 "boundary layer thickness")
AnnotationAssertion(dcterms:description goldbook:10160 "Distance from the interface beyond which mass transfer is determined by convection.")
Declaration(Class(goldbook:10161))
AnnotationAssertion(rdfs:label goldbook:10161 "breakthrough volume")
AnnotationAssertion(dcterms:description goldbook:10161 "Sample volume at which a defined amount of an analyte pumped continuously through an extraction device will begin to be eluted. Typical breakthrough curve indicating the breakthrough volume \\(V_{\\rm{B}}\\) and the sample volume corresponding to the saturation capacity of the sorbent \\(V_{\\rm{C}}\\) (\\(V_{\\rm{R}}\\) corresponds to the chromatographic elution volume and \\(\\upsigma_{\\rm{v}}\\) the standard deviation of the derivative of the curve).Typical breakthrough curve indicating the breakthrough volume \\(V_{\\rm{B}}\\) and the sample volume corresponding to the saturation capacity of the sorbent \\(V_{\\rm{C}}\\) (\\(V_{\\rm{R}}\\) corresponds to the chromatographic elution volume and \\(\\upsigma_{\\rm{v}}\\) the standard deviation of the derivative of the curve).")
Declaration(Class(goldbook:10162))
AnnotationAssertion(rdfs:label goldbook:10162 "ion-pair extraction")
AnnotationAssertion(dcterms:description goldbook:10162 "Transfer of ions from an aqueous phase to an immiscible liquid (or solid) phase by adding an ion of complementary charge to the aqueous phase.")
Declaration(Class(goldbook:10163))
AnnotationAssertion(rdfs:label goldbook:10163 "sorbent")
AnnotationAssertion(dcterms:description goldbook:10163 "Condensed phase where extraction of analytes can occur at the surface and in the bulk.")
Declaration(Class(goldbook:10164))
AnnotationAssertion(rdfs:label goldbook:10164 "acceptor phase")
AnnotationAssertion(dcterms:description goldbook:10164 "Component of a multi-phase system into which the target analytes are extracted.")
Declaration(Class(goldbook:10165))
AnnotationAssertion(rdfs:label goldbook:10165 "active sampling")
AnnotationAssertion(dcterms:description goldbook:10165 "Continuous extraction with movement of the sample matrix with respect to the extraction phase.")
Declaration(Class(goldbook:10166))
AnnotationAssertion(rdfs:label goldbook:10166 "batch extraction")
AnnotationAssertion(dcterms:description goldbook:10166 "Extraction in which the extraction phase and the sample are confined in an extraction vessel and processed according to a defined procedure.")
Declaration(Class(goldbook:10167))
AnnotationAssertion(rdfs:label goldbook:10167 "calibrant in extraction phase")
AnnotationAssertion(dcterms:description goldbook:10167 "Internal standard that is incorporated in the extraction phase for calibration.")
Declaration(Class(goldbook:10168))
AnnotationAssertion(rdfs:label goldbook:10168 "charcoal tube")
AnnotationAssertion(dcterms:description goldbook:10168 "Tube filled with charcoal typically used to adsorb analytes from the gas or liquid phase.")
Declaration(Class(goldbook:10169))
AnnotationAssertion(rdfs:label goldbook:10169 "continuous extraction")
AnnotationAssertion(dcterms:description goldbook:10169 "Extraction in which the sample is continuously introduced into the extraction device.")
Declaration(Class(goldbook:10170))
AnnotationAssertion(rdfs:label goldbook:10170 "countercurrent extraction")
AnnotationAssertion(dcterms:description goldbook:10170 "Extraction in which both phases are continuously added (or changed) and flow (or move) in opposite directions as the extraction progresses.")
Declaration(Class(goldbook:10171))
AnnotationAssertion(rdfs:label goldbook:10171 "donor phase")
AnnotationAssertion(dcterms:description goldbook:10171 "In extraction, the sample or sample solution.")
Declaration(Class(goldbook:10172))
AnnotationAssertion(rdfs:label goldbook:10172 "dynamic extraction")
AnnotationAssertion(dcterms:description goldbook:10172 "Extraction in which clean (or recycled) extraction phase is continuously passed through the sample.")
Declaration(Class(goldbook:10173))
AnnotationAssertion(rdfs:label goldbook:10173 "exhaustive extraction")
AnnotationAssertion(dcterms:description goldbook:10173 "Type of extraction where the intent is a complete extraction of the analytes.")
Declaration(Class(goldbook:10174))
AnnotationAssertion(rdfs:label goldbook:10174 "external calibration")
AnnotationAssertion(dcterms:description goldbook:10174 "Calibration employing a simplified sample matrix spiked with target analyte embodying a reference value of the measurand.")
Declaration(Class(goldbook:10175))
AnnotationAssertion(rdfs:label goldbook:10175 "extraction phase")
AnnotationAssertion(dcterms:description goldbook:10175 "Liquid, solid, or gas phase in contact with the sample for the purpose of removal of analytes from the sample matrix.")
Declaration(Class(goldbook:10176))
AnnotationAssertion(rdfs:label goldbook:10176 "extraction rate")
AnnotationAssertion(dcterms:description goldbook:10176 "Rate at which analytes are transferred from the sample to the extraction phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10176 "kinetics of extraction")
Declaration(Class(goldbook:10177))
AnnotationAssertion(rdfs:label goldbook:10177 "feed")
AnnotationAssertion(dcterms:description goldbook:10177 "Solution or gas containing analyte introduced into an extraction.")
Declaration(Class(goldbook:10178))
AnnotationAssertion(rdfs:label goldbook:10178 "fluorous extraction")
AnnotationAssertion(dcterms:description goldbook:10178 "Extraction in a biphasic system in which the main component of one phase is a highly fluorinated solvent (liquid-liquid extraction) or highly fluorinated sorbent (solid-phase extraction).")
Declaration(Class(goldbook:10179))
AnnotationAssertion(rdfs:label goldbook:10179 "leaching")
AnnotationAssertion(dcterms:description goldbook:10179 "Dissolution of sample components from a solid with a liquid in which the solid phase is not wholly soluble.")
Declaration(Class(goldbook:10180))
AnnotationAssertion(rdfs:label goldbook:10180 "matrix-matched calibration")
AnnotationAssertion(dcterms:description goldbook:10180 "Calibration employing external calibration in which standard solutions of target are prepared in a solution of analyte-free matrix.")
Declaration(Class(goldbook:10181))
AnnotationAssertion(rdfs:label goldbook:10181 "multiwell sample plate")
AnnotationAssertion(dcterms:description goldbook:10181 "Plate with multiple wells for individual samples.")
Declaration(Class(goldbook:10182))
AnnotationAssertion(rdfs:label goldbook:10182 "optimisation of extraction")
AnnotationAssertion(dcterms:description goldbook:10182 "Adjustment of extraction parameters to achieve a defined goal.")
Declaration(Class(goldbook:10183))
AnnotationAssertion(rdfs:label goldbook:10183 "passive sampling")
AnnotationAssertion(dcterms:description goldbook:10183 "Extraction process driven by diffusion of analytes towards the extraction phase.")
Declaration(Class(goldbook:10184))
AnnotationAssertion(rdfs:label goldbook:10184 "salting in")
AnnotationAssertion(dcterms:description goldbook:10184 "Addition of an electrolyte to an aqueous phase to decrease the distribution ratio of the analyte(s) or matrix.")
Declaration(Class(goldbook:10186))
AnnotationAssertion(rdfs:label goldbook:10186 "sequential extraction")
AnnotationAssertion(dcterms:description goldbook:10186 "Extraction wherein extractants of increasing strength or different chemical character are used in order to extract analytes of interest.")
Declaration(Class(goldbook:10187))
AnnotationAssertion(rdfs:label goldbook:10187 "static extraction")
AnnotationAssertion(dcterms:description goldbook:10187 "Batch extraction in which the extraction phase attains a constant composition before phase separation.")
Declaration(Class(goldbook:10188))
AnnotationAssertion(rdfs:label goldbook:10188 "steady state extraction")
AnnotationAssertion(dcterms:description goldbook:10188 "State of a continuous process operating in such a way that the concentration of solutes in exit streams remains constant with respect to time for constant feed concentrations, even though the two phases are not necessarily in thermodynamic equilibrium in any part of the process.")
Declaration(Class(goldbook:10189))
AnnotationAssertion(rdfs:label goldbook:10189 "time-weighted average sampling")
AnnotationAssertion(dcterms:description goldbook:10189 "A passive sampling or active sampling strategy over a relatively long time, during which the amount of analyte(s) extracted is proportional to its average (mean) concentration over that time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10189 "TWA sampling")
Declaration(Class(goldbook:10190))
AnnotationAssertion(rdfs:label goldbook:10190 "chemical hydride generation")
AnnotationAssertion(dcterms:description goldbook:10190 "Type of chemical vapour generation wherein volatile hydrides are generated by reaction with (usually) borane complexes in aqueous solution.")
Declaration(Class(goldbook:10191))
AnnotationAssertion(rdfs:label goldbook:10191 "closed-loop extraction")
AnnotationAssertion(dcterms:description goldbook:10191 "Extraction by a fixed volume of gas continuously recycled through the sample and a sorbent trap by a pump in a closed-circuit arrangement.Typical apparatus for closed-loop stripping analysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10191 "closed-loop stripping analysis")
Declaration(Class(goldbook:10192))
AnnotationAssertion(rdfs:label goldbook:10192 "cryogenic trap")
AnnotationAssertion(dcterms:description goldbook:10192 "Device used to concentrate volatile analytes from the gas phase by condensation on a cold surface.")
Declaration(Class(goldbook:10193))
AnnotationAssertion(rdfs:label goldbook:10193 "denuder")
AnnotationAssertion(dcterms:description goldbook:10193 "Apparatus for the extraction of volatile analytes from a flowing gas stream by diffusion to the wall of a collection vessel, where they are retained by chemisorption or strong physisorption by the wall coating.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10193 "denuder device")
Declaration(Class(goldbook:10194))
AnnotationAssertion(rdfs:label goldbook:10194 "dynamic headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10194 "Continuous removal of headspace above a sample by a flow of inert gas over or through the sample until all or a significant portion of the analytes have been removed from the sample. Sample vapours are typically transferred to a sorbent trap or cryogenic trap for collection.Typical apparatus for analysis by dynamic headspace (purge and trap). The gas flow (sparging gas) enters at the bottom of the sample container transporting volatile compounds through the headspace and purge head to the desorption tube for collection.")
Declaration(Class(goldbook:10195))
AnnotationAssertion(rdfs:label goldbook:10195 "extractive distillation")
AnnotationAssertion(dcterms:description goldbook:10195 "Separation of close-boiling liquids by fractional distillation in the presence of a low-volatility solvent or salt that selectively interacts with one or more components of the mixture, increasing the difference in vapour pressure of the sample components.")
Declaration(Class(goldbook:10196))
AnnotationAssertion(rdfs:label goldbook:10196 "flash desorption")
AnnotationAssertion(dcterms:description goldbook:10196 "Thermal desorption where the temperature of a packed tube or cryogenic trap is rapidly increased to transfer condensed or sorbed compounds to the gas phase.")
Declaration(Class(goldbook:10197))
AnnotationAssertion(rdfs:label goldbook:10197 "full-evaporation headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10197 "Small volume of sample in a headspace vessel maintained at a temperature sufficient to cause complete evaporation of analytes.")
Declaration(Class(goldbook:10198))
AnnotationAssertion(rdfs:label goldbook:10198 "headspace")
AnnotationAssertion(dcterms:description goldbook:10198 "Volume of gas phase above a sample in a closed container.")
Declaration(Class(goldbook:10199))
AnnotationAssertion(rdfs:label goldbook:10199 "multiple headspace extraction")
AnnotationAssertion(dcterms:description goldbook:10199 "Dynamic gas extraction carried out stepwise, with sequential analysis of a number of headspace samples taken from the same vial.")
Declaration(Class(goldbook:10200))
AnnotationAssertion(rdfs:label goldbook:10200 "simultaneous steam distillation-solvent extraction")
AnnotationAssertion(dcterms:description goldbook:10200 "Extraction in which a sample dispersed in water and a water immiscible organic solvent (extraction phase) in separate flasks are heated simultaneously and their vapours co-condensed and separated into two streams in which water is returned to the sample flask and the extraction phase to the organic solvent flask.Apparatus for simultaneous steam distillation-solvent extraction with a lighter-than-water extraction phase. A = aqueous sample solution or slurry; B = immiscible organic solvent and receiving flask for extracted compounds; C = bowl for phase separation; D, E, F, and G are solvent or vapour transfer arms; and H = entry port for additional solvent or alternative sample introduction position for continuous liquid–liquid extraction. Switching the position of flasks A and B allows extraction with a heavier-than-water extraction solvent.")
Declaration(Class(goldbook:10201))
AnnotationAssertion(rdfs:label goldbook:10201 "sorbent trap")
AnnotationAssertion(dcterms:description goldbook:10201 "Tube filled with porous sorbent typically used to extract analytes from the gas phase.")
Declaration(Class(goldbook:10202))
AnnotationAssertion(rdfs:label goldbook:10202 "static headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10202 "Method of analysis, in which a small aliquot of the gas phase in contact with the sample in a closed container is withdrawn for analysis.")
Declaration(Class(goldbook:10203))
AnnotationAssertion(rdfs:label goldbook:10203 "thermal extraction")
AnnotationAssertion(dcterms:description goldbook:10203 "Release of volatile compounds from a sample by heat.")
Declaration(Class(goldbook:10204))
AnnotationAssertion(rdfs:label goldbook:10204 "thin-layer headspace analysis")
AnnotationAssertion(dcterms:description goldbook:10204 "Dynamic headspace analysis of a flowing sample solution in the form of a thin film on the surface of a heated tube.")
Declaration(Class(goldbook:10205))
AnnotationAssertion(rdfs:label goldbook:10205 "biphasic system")
AnnotationAssertion(dcterms:description goldbook:10205 "Equilibrium system containing two or more solvents forming two phases with a single interface.")
Declaration(Class(goldbook:10206))
AnnotationAssertion(rdfs:label goldbook:10206 "chelation solvent extraction")
AnnotationAssertion(dcterms:description goldbook:10206 "Extraction method wherein charged analytes are extracted from an aqueous phase into an organic phase, assisted by a chelating agent.")
Declaration(Class(goldbook:10207))
AnnotationAssertion(rdfs:label goldbook:10207 "cloud point extraction")
AnnotationAssertion(dcterms:description goldbook:10207 "Coacervative extraction at a temperature above the cloud point temperature.")
Declaration(Class(goldbook:10208))
AnnotationAssertion(rdfs:label goldbook:10208 "coacervative extraction")
AnnotationAssertion(dcterms:description goldbook:10208 "Extraction by a surfactant-rich, water-immiscible phase formed by adding a dehydrating agent to a colloidal solution of the sample and a surfactant above its critical micelle concentration.")
Declaration(Class(goldbook:10209))
AnnotationAssertion(rdfs:label goldbook:10209 "continuous liquid-liquid extraction")
AnnotationAssertion(dcterms:description goldbook:10209 "Extraction in which a water-immiscible extraction solvent is continuously percolated through an aqueous solution and returned to the extraction solvent reservoir.Apparatus for continuous liquid–liquid extraction with a lighter-than-water extraction solvent (left) and a heavier-than-water extraction solvent (right). In each case the extraction solvent is contained in the round bottom flask and the aqueous sample in the vertical glass column.")
Declaration(Class(goldbook:10210))
AnnotationAssertion(rdfs:label goldbook:10210 "Craig countercurrent distribution apparatus")
AnnotationAssertion(dcterms:description goldbook:10210 "Apparatus for extraction based on a multistage countercurrent distribution.")
Declaration(Class(goldbook:10211))
AnnotationAssertion(rdfs:label goldbook:10211 "crosscurrent extraction")
AnnotationAssertion(dcterms:description goldbook:10211 "Extraction comprising a cascading series of states where the raffinate is brought into a subsequent stage and contacted with fresh solvent.")
Declaration(Class(goldbook:10212))
AnnotationAssertion(rdfs:label goldbook:10212 "differential contactor")
AnnotationAssertion(dcterms:description goldbook:10212 "Type of continuous multistage extraction equipment in which there is only one interface at which phase separation by settling occurs.")
Declaration(Class(goldbook:10213))
AnnotationAssertion(rdfs:label goldbook:10213 "dispersing solvent")
AnnotationAssertion(dcterms:description goldbook:10213 "Solvent used to disperse the extraction solvent as fine droplets throughout the sample solution in dispersive liquid–liquid microextraction.")
Declaration(Class(goldbook:10214))
AnnotationAssertion(rdfs:label goldbook:10214 "dispersive liquid-liquid microextraction")
AnnotationAssertion(dcterms:description goldbook:10214 "Extraction of analyte(s) from an aqueous solution by fine droplets of extraction phase dispersed throughout the solution.")
Declaration(Class(goldbook:10215))
AnnotationAssertion(rdfs:label goldbook:10215 "liquid-ion exchange")
AnnotationAssertion(dcterms:description goldbook:10215 "Liquid-liquid distribution process that involves the transfer of ionic species from the extractant to the aqueous phase in exchange for ions from the aqueous phase.")
Declaration(Class(goldbook:10216))
AnnotationAssertion(rdfs:label goldbook:10216 "liquid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10216 "Microextraction technique using a liquid as the extraction phase.")
Declaration(Class(goldbook:10217))
AnnotationAssertion(rdfs:label goldbook:10217 "multistage countercurrent distribution")
AnnotationAssertion(dcterms:description goldbook:10217 "Multistage countercurrent separation based on a discontinuous, differential migration process employing stepwise extraction.")
Declaration(Class(goldbook:10218))
AnnotationAssertion(rdfs:label goldbook:10218 "single-drop microextraction")
AnnotationAssertion(dcterms:description goldbook:10218 "Extraction of analytes from the gas phase or solution by a single drop of extraction solvent.Typical experimental arrangement for single-drop microextraction.")
Declaration(Class(goldbook:10219))
AnnotationAssertion(rdfs:label goldbook:10219 "solidified floating organic drop")
AnnotationAssertion(dcterms:description goldbook:10219 "Droplet of organic solvent recovered from the surface of the sample solution by solidification induced by cooling.")
Declaration(Class(goldbook:10220))
AnnotationAssertion(rdfs:label goldbook:10220 "solidified floating organic drop microextraction")
AnnotationAssertion(dcterms:description goldbook:10220 "Microextraction employing a solidified floating organic drop.")
Declaration(Class(goldbook:10221))
AnnotationAssertion(rdfs:label goldbook:10221 "stage")
AnnotationAssertion(dcterms:description goldbook:10221 "Physically distinct part of an extraction process in which transfer of analyte(s) occurs, followed by phase separation.")
Declaration(Class(goldbook:10222))
AnnotationAssertion(rdfs:label goldbook:10222 "stagewise contactor")
AnnotationAssertion(dcterms:description goldbook:10222 "Type of continuous multi-stage liquid-liquid distribution equipment in which each stage has a physically distinct cycle of interphase contact and separation.")
Declaration(Class(goldbook:10223))
AnnotationAssertion(rdfs:label goldbook:10223 "two-phase aqueous partition")
AnnotationAssertion(dcterms:description goldbook:10223 "Distribution in a biphasic system formed by two aqueous solutions containing structurally incompatible components (two polymers or a polymer and a salt) above a critical concentration.")
Declaration(Class(goldbook:10224))
AnnotationAssertion(rdfs:label goldbook:10224 "matrix-solid phase dispersion")
AnnotationAssertion(dcterms:description goldbook:10224 "Extraction in which samples are blended with an abrasive solid sorbent, forming a free flowing powder from which target analytes are recovered by solvent elution.Typical work flow scheme for solid-phase matrix dispersion. (i) Sample is blended with an abrasive sorbent, (ii) free flowing powder containing sample is packed in a short column, and (iii) target analytes are recovered by elution.")
Declaration(Class(goldbook:10225))
AnnotationAssertion(rdfs:label goldbook:10225 "microwave-assisted extraction")
AnnotationAssertion(dcterms:description goldbook:10225 "Leaching using microwave energy to heat the solvent in contact with the sample or the sample directly.")
Declaration(Class(goldbook:10226))
AnnotationAssertion(rdfs:label goldbook:10226 "pressurized hot-water extraction")
AnnotationAssertion(dcterms:description goldbook:10226 "Extraction by water below its critical point (\\(\\pu{374.15^{\\circ}C}\\) and \\(\\pu{22.064 MPa}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10226 "subcritical water extraction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10226 "superheated water extraction")
Declaration(Class(goldbook:10227))
AnnotationAssertion(rdfs:label goldbook:10227 "pressurized-liquid extraction")
AnnotationAssertion(dcterms:description goldbook:10227 "Leaching performed at elevated temperature and pressure.Schematic diagram of a typical apparatus for pressurized-liquid extraction. Gas flow is used to displace the extraction solvent from the sample chamber.")
Declaration(Class(goldbook:10228))
AnnotationAssertion(rdfs:label goldbook:10228 "Soxhlet extraction")
AnnotationAssertion(dcterms:description goldbook:10228 "Leaching with fresh solvent cycled multiple times through a fine solid sample contained in a porous thimble.Typical apparatus for classical Soxhlet extraction.")
Declaration(Class(goldbook:10229))
AnnotationAssertion(rdfs:label goldbook:10229 "supercritical fluid extraction")
AnnotationAssertion(dcterms:description goldbook:10229 "Use of a supercritical fluid to extract analytes from a solid or supported liquid sample.")
Declaration(Class(goldbook:10230))
AnnotationAssertion(rdfs:label goldbook:10230 "QuEChERS (quick, easy, cheap, effective, rugged and safe) extraction")
AnnotationAssertion(dcterms:description goldbook:10230 "Streamlined multiresidue method for extraction and clean-up of analytes in complex matrices.")
Declaration(Class(goldbook:10231))
AnnotationAssertion(rdfs:label goldbook:10231 "ultrasound-assisted extraction")
AnnotationAssertion(dcterms:description goldbook:10231 "Extraction in which ultrasound energy is used to increase the extraction rate by enhancing the contact area between the sample and solvent and by promoting efficient agitation.")
Declaration(Class(goldbook:10232))
AnnotationAssertion(rdfs:label goldbook:10232 "acid digestion")
AnnotationAssertion(dcterms:description goldbook:10232 "Process in which the sample (analyte and matrix) is dissolved by an acid.")
Declaration(Class(goldbook:10233))
AnnotationAssertion(rdfs:label goldbook:10233 "closed-vessel acid digestion")
AnnotationAssertion(dcterms:description goldbook:10233 "Type of acid digestion performed in a closed vessel at elevated pressure.")
Declaration(Class(goldbook:10234))
AnnotationAssertion(rdfs:label goldbook:10234 "digestion")
AnnotationAssertion(dcterms:description goldbook:10234 "Sample dissolution with simultaneous matrix simplification.")
Declaration(Class(goldbook:10235))
AnnotationAssertion(rdfs:label goldbook:10235 "microwave acid digestion")
AnnotationAssertion(dcterms:description goldbook:10235 "Type of bomb acid digestion with microwave radiation used for sample heating.")
Declaration(Class(goldbook:10236))
AnnotationAssertion(rdfs:label goldbook:10236 "open-vessel acid digestion")
AnnotationAssertion(dcterms:description goldbook:10236 "Type of acid digestion performed at ambient pressure wherein the digestion temperature is limited by the boiling point of the acid.")
Declaration(Class(goldbook:10237))
AnnotationAssertion(rdfs:label goldbook:10237 "UV photochemical digestion")
AnnotationAssertion(dcterms:description goldbook:10237 "Formation of free metal ions in aqueous solution by oxidation under the influence of UV light and possibly an oxidizing agent (e.g. hydrogen peroxide or peroxodisulfate) in order to break down dissolved organic matter and metal complexes.")
Declaration(Class(goldbook:10238))
AnnotationAssertion(rdfs:label goldbook:10238 "cartridge")
AnnotationAssertion(dcterms:description goldbook:10238 "Short disposable column containing a bed of porous particles immobilized between two porous frits.")
Declaration(Class(goldbook:10239))
AnnotationAssertion(rdfs:label goldbook:10239 "conditioning solvent")
AnnotationAssertion(dcterms:description goldbook:10239 "Small volume of solvent used to prepare the sorbent for efficient sample processing.")
Declaration(Class(goldbook:10240))
AnnotationAssertion(rdfs:label goldbook:10240 "elution solvent")
AnnotationAssertion(dcterms:description goldbook:10240 "Small volume of strong solvent used to displace target analytes from the sorbent bed.")
Declaration(Class(goldbook:10241))
AnnotationAssertion(rdfs:label goldbook:10241 "foamed polyurethane sorbent")
AnnotationAssertion(dcterms:description goldbook:10241 "Sorbent consisting of spherical, micron-sized, agglomerated particles bound together in a rigid and highly porous structure used for the extraction of semi-volatile organic compounds from air in high-volume samplers.")
Declaration(Class(goldbook:10242))
AnnotationAssertion(rdfs:label goldbook:10242 "immunosorbents")
AnnotationAssertion(dcterms:description goldbook:10242 "Porous material with surface bound monoclonal or polyclonal antibodies capable of selective extraction of target analytes by formation of reversible antibody-antigen (compound) binding complexes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10242 "immunoaffinity sorbents")
Declaration(Class(goldbook:10243))
AnnotationAssertion(rdfs:label goldbook:10243 "inorganic oxide adsorbent")
AnnotationAssertion(dcterms:description goldbook:10243 "Adsorbent with site-specific polar and ion exchange functional groups that extract analytes from a gas or liquid phase by their complementary interactions with the surface.")
Declaration(Class(goldbook:10244))
AnnotationAssertion(rdfs:label goldbook:10244 "ion-exchange sorbent")
AnnotationAssertion(dcterms:description goldbook:10244 "Porous sorbent material  containing fixed ionic sites with a complementary charge to that of the target analyte(s).")
Declaration(Class(goldbook:10245))
AnnotationAssertion(rdfs:label goldbook:10245 "low-specificity sorbents")
AnnotationAssertion(dcterms:description goldbook:10245 "Sorbent with a non-selective surface used almost exclusively to extract analytes from an aqueous solution. The sorbent has a largely passive role in the extraction, with the driving force being the expulsion of the organic contaminants from waterto minimize disruption of the water structure.")
Declaration(Class(goldbook:10246))
AnnotationAssertion(rdfs:label goldbook:10246 "magnetic nanoparticle sorbent")
AnnotationAssertion(dcterms:description goldbook:10246 "Sorbent consisting of nanometre-sized, spherical particles with a magnetic or magnetisable core surrounded by a sorbent shell.")
Declaration(Class(goldbook:10247))
AnnotationAssertion(rdfs:label goldbook:10247 "mixed-mode sorbent")
AnnotationAssertion(dcterms:description goldbook:10247 "Porous sorbent material with surface co-bonded ion exchange and alkyl functional groups.")
Declaration(Class(goldbook:10248))
AnnotationAssertion(rdfs:label goldbook:10248 "molecularly imprinted polymer sorbent")
AnnotationAssertion(dcterms:description goldbook:10248 "Porous polymer sorbent with synthetic recognition sites with a high specificity for the sorption of a targeted compound or group of structurally-related compounds.")
Declaration(Class(goldbook:10249))
AnnotationAssertion(rdfs:label goldbook:10249 "multiwell extraction plate")
AnnotationAssertion(dcterms:description goldbook:10249 "Regular array of wells in a single moulded body with a short sorbent bed or disc embedded at the base of each well.Multiwell extraction plate.")
Declaration(Class(goldbook:10250))
AnnotationAssertion(rdfs:label goldbook:10250 "needle trap")
AnnotationAssertion(dcterms:description goldbook:10250 "Gas-tight syringe with a sorbent-filled needle.")
Declaration(Class(goldbook:10251))
AnnotationAssertion(rdfs:label goldbook:10251 "particle-embedded glass fibre disc")
AnnotationAssertion(dcterms:description goldbook:10251 "Suspension of micron-sized sorbent particles woven into a glass fibre matrix.")
Declaration(Class(goldbook:10252))
AnnotationAssertion(rdfs:label goldbook:10252 "particle-loaded membrane disc")
AnnotationAssertion(dcterms:description goldbook:10252 "Suspension of micron-sized sorbent particles distributed throughout a web of poly(tetrafluroethylene) microfibrils formed into a thin disc of various diameters.")
Declaration(Class(goldbook:10253))
AnnotationAssertion(rdfs:label goldbook:10253 "restricted-access sorbent")
AnnotationAssertion(dcterms:description goldbook:10253 "Porous material with a biocompatible outer surface and a retentive interior surface.")
Declaration(Class(goldbook:10254))
AnnotationAssertion(rdfs:label goldbook:10254 "rinse solvent")
AnnotationAssertion(dcterms:description goldbook:10254 "Weak solvent used to displace matrix components from a sorbent without displacing the target analyte(s).")
Declaration(Class(goldbook:10255))
AnnotationAssertion(rdfs:label goldbook:10255 "solid-phase extraction")
AnnotationAssertion(dcterms:description goldbook:10255 "Extraction of analytes from a gas, liquid, or fluid by transfer to a solid sorbent.")
Declaration(Class(goldbook:10256))
AnnotationAssertion(rdfs:label goldbook:10256 "solvent desorption")
AnnotationAssertion(dcterms:description goldbook:10256 "Use of a solvent, typically combined with agitation, to remove target analytes from a sorbent.")
Declaration(Class(goldbook:10257))
AnnotationAssertion(rdfs:label goldbook:10257 "sorbent-containing pipette tip")
AnnotationAssertion(dcterms:description goldbook:10257 "Disposable pipette tip with a small packed bed, disc, or monolithic plug of sorbent at its narrow end.Sorbent containing pipette tips in an array for use with a multiwall sample plate.")
Declaration(Class(goldbook:10258))
AnnotationAssertion(rdfs:label goldbook:10258 "sorptive-tape extraction")
AnnotationAssertion(dcterms:description goldbook:10258 "Extraction from the surface of a solid by sorbent or polymer film in the form of a tape in direct contact with, or in the headspace above, the sample.")
Declaration(Class(goldbook:10259))
AnnotationAssertion(rdfs:label goldbook:10259 "stir bar sorptive extraction")
AnnotationAssertion(dcterms:description goldbook:10259 "Extraction of compounds from solution by a sorbent coated magnetic stir bar by rapid stirring (direct immersion) or by exposure to the headspace above a sample (headspace extraction).")
Declaration(Class(goldbook:10260))
AnnotationAssertion(rdfs:label goldbook:10260 "surface-bound macrocyclic sorbent")
AnnotationAssertion(dcterms:description goldbook:10260 "Porous sorbent with surface-bound macrocyclic ligands designed for the extraction of metal ions and some anions from aqueous solution.")
Declaration(Class(goldbook:10261))
AnnotationAssertion(rdfs:label goldbook:10261 "surface-bound phenylboronic acid sorbent")
AnnotationAssertion(dcterms:description goldbook:10261 "Porous sorbent with surface-bound phenylboronic acid groups for the selective extraction of bifunctional compounds by reversible formation of 5- or 6-membered covalent cyclic boronic acid complexes.")
Declaration(Class(goldbook:10262))
AnnotationAssertion(rdfs:label goldbook:10262 "biocompatible solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10262 "Extraction by a matrix-compatible immersion solid-phase microextraction device where the extraction phase and support are chosen to eliminate matrix interferences.")
Declaration(Class(goldbook:10263))
AnnotationAssertion(rdfs:label goldbook:10263 "blade format")
AnnotationAssertion(dcterms:description goldbook:10263 "Solid-phase microextraction device where the extraction phase (sorbent) is dispersed in the form of a thin coating on the surface of a blade.")
Declaration(Class(goldbook:10264))
AnnotationAssertion(rdfs:label goldbook:10264 "coated-vessel format")
AnnotationAssertion(dcterms:description goldbook:10264 "Sample vessel with sorbent-coated walls.")
Declaration(Class(goldbook:10265))
AnnotationAssertion(rdfs:label goldbook:10265 "cold fibre solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10265 "Solid-phase microextraction in the fibre format with a sorbent temperature maintained below that of the sample matrix during extraction.")
Declaration(Class(goldbook:10266))
AnnotationAssertion(rdfs:label goldbook:10266 "fibre format")
AnnotationAssertion(dcterms:description goldbook:10266 "Extraction phase in the form of a thin layer supported on a fibre made of inert material, such as fused silica, stainless steel, or nickel-titanium alloy.")
Declaration(Class(goldbook:10267))
AnnotationAssertion(rdfs:label goldbook:10267 "headspace solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10267 "Solid-phase microextraction where the extraction phase is placed in the headspace above the sample.")
Declaration(Class(goldbook:10268))
AnnotationAssertion(rdfs:label goldbook:10268 "immersion solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10268 "Solid-phase microextraction where the extraction phase is immersed directly into the sample.")
Declaration(Class(goldbook:10269))
AnnotationAssertion(rdfs:label goldbook:10269 "in-needle capillary adsorption trap")
AnnotationAssertion(dcterms:description goldbook:10269 "In-tube format device with a sorbent-coated capillary placed inside a needle.")
Declaration(Class(goldbook:10270))
AnnotationAssertion(rdfs:label goldbook:10270 "in-tube solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10270 "Extraction utilizing a coated open tubular or packed capillary tube as the extraction phase in a flow system.")
Declaration(Class(goldbook:10271))
AnnotationAssertion(rdfs:label goldbook:10271 "matrix-compatible solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10271 "Immersion solid-phase microextraction where the extraction phase is designed to minimize sorption of particles or macromolecules present in the sample matrix.")
Declaration(Class(goldbook:10272))
AnnotationAssertion(rdfs:label goldbook:10272 "membrane-protected solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10272 "Immersion solid-phase microextraction in which the extraction phase is surrounded by a permeable membrane that allows access of analytes to the extraction phase while shielding the extraction phase from matrix components with a potential to interfere in the extraction or subsequent analysis.")
Declaration(Class(goldbook:10273))
AnnotationAssertion(rdfs:label goldbook:10273 "particle sorbent")
AnnotationAssertion(dcterms:description goldbook:10273 "Extraction phase in the form of sorbent particles.")
Declaration(Class(goldbook:10274))
AnnotationAssertion(rdfs:label goldbook:10274 "rotating disk sorptive extraction")
AnnotationAssertion(dcterms:description goldbook:10274 "Sorbent-coated disc consisting of a polytetrafluoroethylene (PTFE) base with an integrated magnet and a sorbent film attached to one side.")
Declaration(Class(goldbook:10275))
AnnotationAssertion(rdfs:label goldbook:10275 "solid-phase dynamic extraction")
AnnotationAssertion(dcterms:description goldbook:10275 "Solid-phase microextraction in which the extraction phase is coated on the internal surface of a needle.")
Declaration(Class(goldbook:10276))
AnnotationAssertion(rdfs:label goldbook:10276 "solid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10276 "Microextraction where the extraction phase is a solid.")
Declaration(Class(goldbook:10277))
AnnotationAssertion(rdfs:label goldbook:10277 "thin film format")
AnnotationAssertion(dcterms:description goldbook:10277 "Solid-phase microextraction where the sorbent is in the form of a thin film on a support or self supported membrane.")
Declaration(Class(goldbook:10278))
AnnotationAssertion(rdfs:label goldbook:10278 "electromembrane extraction")
AnnotationAssertion(dcterms:description goldbook:10278 "Hollow-fibre liquid-phase microextraction in which the extraction is driven by an electrical potential sustained between the sample solution and the acceptor phase, separated by a supported liquid membrane.Typical experimental arrangement for electromembrane extraction of cations (anions extracted by reversing the polarity). SLM, supported liquid membrane in the form of a porous hollow fiber with solvent-filled pores.")
Declaration(Class(goldbook:10279))
AnnotationAssertion(rdfs:label goldbook:10279 "hollow fibre")
AnnotationAssertion(dcterms:description goldbook:10279 "Narrow cylindrical tube prepared from a porous polymer.")
Declaration(Class(goldbook:10280))
AnnotationAssertion(rdfs:label goldbook:10280 "hollow-fibre liquid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10280 "Liquid-phase microextraction of analytes from a liquid (or gaseous) sample by a supported liquid membrane in the form of a porous hollow fibre with solvent-filled pores. The analytes are transferred to an acceptor phase contained in the cavity of the hollow fibre.Typical experimental arrangement for hollow-fiber supported liquid membrane (SLM) for liquid-phase microextraction.")
Declaration(Class(goldbook:10281))
AnnotationAssertion(rdfs:label goldbook:10281 "membrane extraction")
AnnotationAssertion(dcterms:description goldbook:10281 "Extraction of analytes from a sample by permeation through a membrane.")
Declaration(Class(goldbook:10282))
AnnotationAssertion(rdfs:label goldbook:10282 "membrane extraction with sorbent interface")
AnnotationAssertion(dcterms:description goldbook:10282 "Membrane extraction with a sorbent trap for concentration of the permeate.")
Declaration(Class(goldbook:10283))
AnnotationAssertion(rdfs:label goldbook:10283 "microdialysis")
AnnotationAssertion(dcterms:description goldbook:10283 "Dialysis by a short length of hollow-fibre membrane used for sampling.")
Declaration(Class(goldbook:10284))
AnnotationAssertion(rdfs:label goldbook:10284 "non-porous membrane")
AnnotationAssertion(dcterms:description goldbook:10284 "Membrane in which permeation occurs by processes other than flow through pores.")
Declaration(Class(goldbook:10285))
AnnotationAssertion(rdfs:label goldbook:10285 "parallel artificial liquid membrane extraction")
AnnotationAssertion(dcterms:description goldbook:10285 "Extraction of analytes from aqueous samples in a multiwell plate with a porous membrane at the base of each well by migration through the solvent-filled membrane pores into an acceptor phase located in each well.")
Declaration(Class(goldbook:10286))
AnnotationAssertion(rdfs:label goldbook:10286 "perfusate")
AnnotationAssertion(dcterms:description goldbook:10286 "Stream of extraction phase entering a dialysis module.")
Declaration(Class(goldbook:10287))
AnnotationAssertion(rdfs:label goldbook:10287 "permeation")
AnnotationAssertion(dcterms:description goldbook:10287 "Process by which mass transfer occurs through a membrane.")
Declaration(Class(goldbook:10288))
AnnotationAssertion(rdfs:label goldbook:10288 "porous membrane")
AnnotationAssertion(dcterms:description goldbook:10288 "Membrane in which permeation occurs through its porous structure.")
Declaration(Class(goldbook:10289))
AnnotationAssertion(rdfs:label goldbook:10289 "retentate stream")
AnnotationAssertion(dcterms:description goldbook:10289 "Sample left over in membrane separations after initial contact with the membrane.")
Declaration(Class(goldbook:10290))
AnnotationAssertion(rdfs:label goldbook:10290 "semipermeable membrane device")
AnnotationAssertion(dcterms:description goldbook:10290 "Membrane extraction in which the membrane fully encloses an acceptor phase.")
Declaration(Class(goldbook:10291))
AnnotationAssertion(rdfs:label goldbook:10291 "stream")
AnnotationAssertion(dcterms:description goldbook:10291 "The sample in membrane separations prior to contact with the membrane.")
Declaration(Class(goldbook:10292))
AnnotationAssertion(rdfs:label goldbook:10292 "stripping phase")
AnnotationAssertion(dcterms:description goldbook:10292 "Extraction phase in a membrane separation.")
Declaration(Class(goldbook:10293))
AnnotationAssertion(rdfs:label goldbook:10293 "supported liquid membrane")
AnnotationAssertion(dcterms:description goldbook:10293 "Porous membrane with solvent-filled pores.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10293 "artificial liquid membrane")
Declaration(Class(goldbook:10294))
AnnotationAssertion(rdfs:label goldbook:10294 "at-line extraction")
AnnotationAssertion(dcterms:description goldbook:10294 "Flow system with extraction device employing a local detector.")
Declaration(Class(goldbook:10295))
AnnotationAssertion(rdfs:label goldbook:10295 "automated extraction")
AnnotationAssertion(dcterms:description goldbook:10295 "Extraction in a mechanical device regulated by feed-back of information without human intervention.")
Declaration(Class(goldbook:10296))
AnnotationAssertion(rdfs:label goldbook:10296 "automatic extraction")
AnnotationAssertion(dcterms:description goldbook:10296 "Extraction according to manually preselected conditions without further human intervention.")
Declaration(Class(goldbook:10297))
AnnotationAssertion(rdfs:label goldbook:10297 "bead injection")
AnnotationAssertion(dcterms:description goldbook:10297 "Fully renewable (disposable) packed sorbent bed for solid-phase extraction in a flow manifold or mesofluidic platform using programmable flow extraction.Bead-injection protocols for automated solid phase microextraction with sorbent renewal for each assay [Reproduced from  https://www.flowinjectiontutorial.com].a) Injection of a metered amount of particles or beads with reactive surfaces in the flow system followed by mechanical trapping or capture with the aid of external energy sources; b) Injection of a metered volume of sample; c) Interaction of analyte(s) with sorptive surfaces; d) Preconcentration of analyte(s) followed by detection of native species or derivatization products; e) Automatic removal of sorptive surfaces.")
Declaration(Class(goldbook:10298))
AnnotationAssertion(rdfs:label goldbook:10298 "bioaccessibility")
AnnotationAssertion(dcterms:description goldbook:10298 "Fraction of analytes desorbed from a sample potentially available to organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10298 "environmental availabilty")
Declaration(Class(goldbook:10299))
AnnotationAssertion(rdfs:label goldbook:10299 "dynamic bioaccessibility")
AnnotationAssertion(dcterms:description goldbook:10299 "Leaching of analytes from a solid or semi-solid sample in a flow-through device to evaluate their bioaccessibility.")
Declaration(Class(goldbook:10300))
AnnotationAssertion(rdfs:label goldbook:10300 "flow-through extraction")
AnnotationAssertion(dcterms:description goldbook:10300 "Extraction by flow of sample through or over the extraction phase, or vice versa, to enhance the extraction rate.")
Declaration(Class(goldbook:10301))
AnnotationAssertion(rdfs:label goldbook:10301 "flow-through solid-phase spectrometry")
AnnotationAssertion(dcterms:description goldbook:10301 "Continuous optical interrogation of a packed-sorbent bed in a flow system at any stage of the extraction process prior to analyte elution and sorbent regeneration.")
Declaration(Class(goldbook:10302))
AnnotationAssertion(rdfs:label goldbook:10302 "in-line extraction")
AnnotationAssertion(dcterms:description goldbook:10302 "Coupling of a flow system with extraction device to a detector without flow interruption.")
Declaration(Class(goldbook:10303))
AnnotationAssertion(rdfs:label goldbook:10303 "in-syringe microextraction")
AnnotationAssertion(dcterms:description goldbook:10303 "Batch-type extraction in which the barrel of a syringe pump is used as the device for liquid-phase microextraction or dispersive solid-phase microextraction.")
Declaration(Class(goldbook:10304))
AnnotationAssertion(rdfs:label goldbook:10304 "lab-at-valve liquid-phase microextraction")
AnnotationAssertion(dcterms:description goldbook:10304 "Automatic batch-type liquid-phase microextraction by sequential injection analysis using an external extraction container (e.g. pipette tip) connected to a multiposition rotary valve.")
Declaration(Class(goldbook:10305))
AnnotationAssertion(rdfs:label goldbook:10305 "lab-on-a-chip extraction")
AnnotationAssertion(dcterms:description goldbook:10305 "Microfluidic platform containing microconduits to facilitate extraction processes with pressure-driven or electroosmotic flow.")
Declaration(Class(goldbook:10306))
AnnotationAssertion(rdfs:label goldbook:10306 "lab-on-valve extraction")
AnnotationAssertion(dcterms:description goldbook:10306 "Mesofluidic platform containing microconduits for extraction processes mounted on a multi-position rotary valve.")
Declaration(Class(goldbook:10307))
AnnotationAssertion(rdfs:label goldbook:10307 "mechanized extraction")
AnnotationAssertion(dcterms:description goldbook:10307 "Extraction using a device with at least one movable part that replaces or supplements human effort in any (or all) steps of the process.")
Declaration(Class(goldbook:10308))
AnnotationAssertion(rdfs:label goldbook:10308 "mesofluidic extraction device")
AnnotationAssertion(dcterms:description goldbook:10308 "Extraction device with channel widths from \\(\\pu{10 \\upmu m}\\) to \\(\\pu{2 mm}\\) integrated into a flow platform.")
Declaration(Class(goldbook:10309))
AnnotationAssertion(rdfs:label goldbook:10309 "microflow injection analysis extraction device")
AnnotationAssertion(dcterms:description goldbook:10309 "Miniaturized flow injection analysis device for extraction with conduits of a diameter greater than \\(\\pu{0.1 mm}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10309 "μFIA extraction device")
Declaration(Class(goldbook:10310))
AnnotationAssertion(rdfs:label goldbook:10310 "microfluidic extraction device")
AnnotationAssertion(dcterms:description goldbook:10310 "Extraction device with channel widths from \\(\\pu{100 nm}\\) to \\(\\pu{10 \\upmu m}\\) integrated into a flow platform.")
Declaration(Class(goldbook:10311))
AnnotationAssertion(rdfs:label goldbook:10311 "multicommutation flow extraction")
AnnotationAssertion(dcterms:description goldbook:10311 "Programmable flow extraction device with microsolenoid valves for processing microliter sample volumes.")
Declaration(Class(goldbook:10312))
AnnotationAssertion(rdfs:label goldbook:10312 "on-line extraction")
AnnotationAssertion(dcterms:description goldbook:10312 "Coupling of a flow system with an extraction device to a detector via a discontinuous interface.")
Declaration(Class(goldbook:10313))
AnnotationAssertion(rdfs:label goldbook:10313 "programmable flow extraction")
AnnotationAssertion(dcterms:description goldbook:10313 "Multi-bidirectional flow (including stopped flow) of sample and/or extractant through an extraction device controlled by a pump.")
Declaration(Class(goldbook:10314))
AnnotationAssertion(rdfs:label goldbook:10314 "segmented flow analysis")
AnnotationAssertion(dcterms:description goldbook:10314 "Continuous-flow system attaining steady-state extraction/reaction conditions facilitated by injection of air bubbles. This might be extended to immiscible liquids injected as droplets in the flow system. Related term: segmented flow extraction.")
Declaration(Class(goldbook:10315))
AnnotationAssertion(rdfs:label goldbook:10315 "segmented flow extraction")
AnnotationAssertion(dcterms:description goldbook:10315 "Extraction by insertion of the sample solution as equal-size droplets (segments) in a flowing stream of immiscible extraction phase.Typical segmented flow extraction manifold. C, carrier or liquid phase for sample; R, reagent (optional); P, propulsion unit; S, sample; IV, injection valve; MC, mixing coil; DB, displacement bottle (functions as a constant volume pump); ORG, organic solvent; SG, segmenter; EC, extraction coil; PS, phase separator; D, detector (optional); RC, restriction coil; and W, waste.")
Declaration(Class(goldbook:10316))
AnnotationAssertion(rdfs:label goldbook:10316 "sequential injection analysis extraction device")
AnnotationAssertion(dcterms:description goldbook:10316 "Automatic programmable flow extraction through a multi-position rotary valve housing a mesofluidic extraction device.")
Declaration(Class(goldbook:10317))
AnnotationAssertion(rdfs:label goldbook:10317 "A/D ratio")
AnnotationAssertion(dcterms:description goldbook:10317 "Ratio of the adult toxic dose to the developmentally toxic dose.")
Declaration(Class(goldbook:10318))
AnnotationAssertion(rdfs:label goldbook:10318 "abdominal cavity")
AnnotationAssertion(dcterms:description goldbook:10318 "Body cavity between the diaphragm and pelvis that contains the abdominal organs.")
Declaration(Class(goldbook:10319))
AnnotationAssertion(rdfs:label goldbook:10319 "ablepharia")
AnnotationAssertion(dcterms:description goldbook:10319 "Congenital absence of the eyelids.")
Declaration(Class(goldbook:10320))
AnnotationAssertion(rdfs:label goldbook:10320 "abortion")
AnnotationAssertion(dcterms:description goldbook:10320 "Premature termination of pregnancy with the death of the embryo or fetus.")
Declaration(Class(goldbook:10321))
