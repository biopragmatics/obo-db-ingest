    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.A00565 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.A00565">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1,3-Dipolar compounds having the structure</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>azomethine ylides</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.D01753"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.Y06728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.A00566 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.A00566">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>$N$-Hydrocarbyl derivatives of the parent structure $\ce{HN^{+}(O^{−})(OH)2}$. Cf. phosphonic acids.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
        <rdfs:label>azonic acids</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.P04560"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.A00567 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.A00567">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>$N$-Oxides of azo compounds of structure $\ce{RN=N^{+}(O^{−})R}$, e.g. $\ce{PhN=N^{+}(O^{−})Ph}$ azoxybenzene or diphenyldiazene oxide.</dcterms:description>
