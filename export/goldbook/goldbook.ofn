Declaration(Class(goldbook:H02774))
AnnotationAssertion(rdfs:label goldbook:H02774 "hemiacetals")
AnnotationAssertion(dcterms:description goldbook:H02774 "Compounds having the general formula $\\ce{R2C(OH)OR'}$ ($\\ce{R'}  eq \\ce{H}$).")
AnnotationAssertion(rdfs:seeAlso goldbook:H02774 goldbook:H02776)
