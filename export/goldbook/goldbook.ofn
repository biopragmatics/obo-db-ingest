Declaration(Class(goldbook:10650))
AnnotationAssertion(rdfs:label goldbook:10650 "embryonic period")
AnnotationAssertion(dcterms:description goldbook:10650 "Period from fertilization to the end of major organogenesis.")
Declaration(Class(goldbook:10651))
AnnotationAssertion(rdfs:label goldbook:10651 "embryonic stem cell")
AnnotationAssertion(dcterms:description goldbook:10651 "Undifferentiated, pluripotent cell from an early stage of the pre-implantation embryo (inner cell mass of the blastocyst).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10651 "ES cell")
Declaration(Class(goldbook:10652))
AnnotationAssertion(rdfs:label goldbook:10652 "encephalitis")
