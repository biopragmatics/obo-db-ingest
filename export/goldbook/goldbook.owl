        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11341"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11389"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
