AnnotationAssertion(dcterms:description goldbook:11722 "Neurotoxickainic acid analog produced by some algal blooms that causes amnesic shellfish poisoning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11722 "(2S,3S,4S)-4-[(2Z,4E,6R)-6-carboxy-6-methylhexa-2,4-dien-2-yl]-3-(carboxymethyl)pyrrolidine-2-carboxylic acid")
AnnotationAssertion(rdfs:comment goldbook:11722 "Filter-feeding shellfish become contaminated from trapping and eating these algae."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11722 "Domoic acid is produced by the red alga called doumoi in Japan (Chondria armatasome), diatoms of the genus Pseudo-nitzschia, and by some strains of the diatom species Nitzschia navis-varingica."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11722 goldbook:11948)
