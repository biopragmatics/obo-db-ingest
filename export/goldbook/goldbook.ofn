AnnotationAssertion(dcterms:description goldbook:08967 "Diminished rate of polymerization brought about by the action of a retarder.")
AnnotationAssertion(mito:isMentionedBy goldbook:08967 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08967 "current"^^xsd:string)
Declaration(Class(goldbook:08968))
AnnotationAssertion(rdfs:label goldbook:08968 "reversible-addition-fragmentation chain-transfer agent")
AnnotationAssertion(dcterms:description goldbook:08968 "Chain-transfer agent that provides chain transfer by a reversible-addition-fragmentation mechanism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08968 "chain-transfer agent (CTA) (in RAFT polymerization)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08968 "RAFT agent")
AnnotationAssertion(rdfs:comment goldbook:08968 "RAFT agents are mediating agents in RAFT polymerization."^^xsd:string)
