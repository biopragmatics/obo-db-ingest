Declaration(Class(goldbook:10799))
AnnotationAssertion(rdfs:label goldbook:10799 "Hershberger bioassay")
AnnotationAssertion(dcterms:description goldbook:10799 "Short-term in vivo procedure in which the androgenic or antiandrogenic effects of a test substance are studied in castrated, peripubertal male rodents, as indicated by changes in the weights of androgen-dependent tissues.")
Declaration(Class(goldbook:10800))
AnnotationAssertion(rdfs:label goldbook:10800 "hippocampus")
AnnotationAssertion(dcterms:description goldbook:10800 "Structural component of the limbic system of the vertebrate brain involved in short-term and long-term memory and spatial navigation.")
Declaration(Class(goldbook:10801))
