[Term]
id: goldbook:09699
name: deoxyribonucleic acid mismatch
def: "Defect in the double stranded deoxyribonucleic acid \(DNA\) structure in which the DNA double helix contains one \(or more\) non-standard base pairs."
comment: "One mismatch is known as a single mismatch. Multiple mismatches are called multi-base mismatches."
synonym: "DNA mismatch" []
synonym: "mismatch in DNA" []
synonym: "multi-base mismatch" []
synonym: "single mismatch" []
property_value: mito:isMentionedBy doi:10.1515/pac-2016-1120
property_value: hasStatus "current" xsd:string
