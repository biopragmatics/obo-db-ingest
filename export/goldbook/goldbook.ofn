AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08037 "traceability (of an object)")
Declaration(Class(goldbook:08038))
AnnotationAssertion(rdfs:label goldbook:08038 "property value assignment")
AnnotationAssertion(dcterms:description goldbook:08038 "Determination of property values obtained in the course of the production of a reference material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08038 "value assignment")
Declaration(Class(goldbook:08039))
AnnotationAssertion(rdfs:label goldbook:08039 "recovered quantity value ratio")
