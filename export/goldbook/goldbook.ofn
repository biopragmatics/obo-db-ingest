AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00511 "current"^^xsd:string)
Declaration(Class(goldbook:A00512))
AnnotationAssertion(rdfs:label goldbook:A00512 "attachment")
AnnotationAssertion(dcterms:description goldbook:A00512 "A transformation by which one molecular entity (the substrate) is converted into another by the formation of one (and only one) two-centre bond between the substrate and another molecular entity and which involves no other changes in connectivity in the substrate. For example, the formation of an acyl cation by attachment of carbon monoxide to a carbenium ion ($\\ce{R^{+}}$):  The product of an attachment may also be the adduct of the two reactants, but not all adducts can be represented as the products of an attachment. (For example, the Diels–Alder cycloaddition:  results in an adduct of buta-1,3-diene and ethene, but the reaction cannot be described as an attachment since bonds are formed between more than two centres.)")
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:A00138)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:B00697)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:C00812)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:C00907)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:C01153)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:C01274)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:C01496)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:E01979)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:M03986)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:S06082)
AnnotationAssertion(rdfs:seeAlso goldbook:A00512 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:A00512 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00512 "current"^^xsd:string)
Declaration(Class(goldbook:A00514))
AnnotationAssertion(rdfs:label goldbook:A00514 "attenuance filter")
AnnotationAssertion(dcterms:description goldbook:A00514 "An optical device (filter) which reduces the radiant power of a light beam by a constant factor over all wavelengths within its operating range. Sometimes called attenuator or neutral density filter.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00514 "neutral-density filter")
AnnotationAssertion(rdfs:seeAlso goldbook:A00514 goldbook:F02384)
AnnotationAssertion(rdfs:seeAlso goldbook:A00514 goldbook:R05046)
