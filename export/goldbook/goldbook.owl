    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.S06125">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds having the structure $\ce{R2S(=O)=NR}$. (Indexed by Chemical Abstracts Service at the heading sulfoximines). E.g. $\ce{(CH3)2S(=O)=NPh}$ S,S-dimethyl-N-phenylsulfoximide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
