Declaration(Class(goldbook:L03649))
AnnotationAssertion(rdfs:label goldbook:L03649 "lumiphore")
AnnotationAssertion(dcterms:description goldbook:L03649 "A part of a molecular entity (or atom or group of atoms) in which electronic excitation associated with a given emission band is approximately localized. (Analogous to chromophore for absorption spectra).")
