AnnotationAssertion(obo:goldbook#hasStatus goldbook:TT06846 "current"^^xsd:string)
Declaration(Class(goldbook:TT06897))
AnnotationAssertion(rdfs:label goldbook:TT06897 "thermotropic mesophase")
AnnotationAssertion(dcterms:description goldbook:TT06897 "A mesophase formed by heating a solid or cooling an isotropic liquid, or by heating or cooling a thermodynamically stable mesophase.")
AnnotationAssertion(rdfs:seeAlso goldbook:TT06897 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:TT06897 goldbook:M03849)
AnnotationAssertion(rdfs:seeAlso goldbook:TT06897 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:TT06897 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:TT06897 "current"^^xsd:string)
Declaration(Class(goldbook:TT06898))
AnnotationAssertion(rdfs:label goldbook:TT06898 "transition temperature")
AnnotationAssertion(dcterms:description goldbook:TT06898 "The temperature at which the transition from mesophase X to mesophase Y occurs.")
AnnotationAssertion(rdfs:seeAlso goldbook:TT06898 goldbook:M03849)
AnnotationAssertion(mito:isMentionedBy goldbook:TT06898 doi:10.1351/pac200274030493)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:TT06898 "current"^^xsd:string)
Declaration(Class(goldbook:TT06915))
AnnotationAssertion(rdfs:label goldbook:TT06915 "threshold limit value")
AnnotationAssertion(dcterms:description goldbook:TT06915 "The concentration in air to which it is believed that most workers can be exposed daily without an adverse effect (i.e., effectively, the threshold between safe and dangerous concentrations). The values were established (and are revised annually) by the ACGIH and are time-weighted concentrations (TWA) for a 7- or 8-h workday and 40-h workweek, and thus are related to chronic effects. A short-term exposure limit (STEL) is defined as a 15-min TWA exposure, which should not be exceeded at any time during a workday even if the 8-h TWA is within the TLV-TWA.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:TT06915 "TLV")
AnnotationAssertion(rdfs:seeAlso goldbook:TT06915 goldbook:AT06809)
AnnotationAssertion(rdfs:seeAlso goldbook:TT06915 goldbook:ET06811)
AnnotationAssertion(mito:isMentionedBy goldbook:TT06915 doi:10.1351/pac200173060993)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:TT06915 "current"^^xsd:string)
Declaration(Class(goldbook:TT06926))
AnnotationAssertion(rdfs:label goldbook:TT06926 "total velocity of the analyte")
AnnotationAssertion(dcterms:description goldbook:TT06926 "The sum of electrophoretic velocity, \\( u_{\\rm{ep}}\\), of an ion and the electroosmotic velocity, \\( u _{\\rm{eo}}\\). \\[ u_{\\rm{tot}} =  u_{\\rm{ep}}\\,+\\, u_{\\rm{eo}}\\] This quantity can be measured experimentally as the effective length of the capillary divided by the migration time (\\(L_{\\rm{eff}}/t_{\\rm{m}}\\)).")
AnnotationAssertion(rdfs:comment goldbook:TT06926 "Depending on the signs and relative magnitudes of these velocities, the total velocity of an analyte can have either the same or the opposite direction to the electroosmotic velocity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:TT06926 "The total velocity is the velocity of the ion measured as a displacement relative to the capillary wall divided by time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:TT06926 goldbook:ET06925)
AnnotationAssertion(rdfs:seeAlso goldbook:TT06926 goldbook:MT06924)
AnnotationAssertion(mito:isMentionedBy goldbook:TT06926 doi:10.1351/pac200476020443)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:TT06926 "current"^^xsd:string)
Declaration(Class(goldbook:TT07167))
AnnotationAssertion(rdfs:label goldbook:TT07167 "telechelic polymer")
AnnotationAssertion(dcterms:description goldbook:TT07167 "Prepolymer capable of entering into further polymerization or other reactions through its reactive end-groups.")
AnnotationAssertion(rdfs:comment goldbook:TT07167 "Reactive end-groups in telechelic polymers come from initiator or termination or chain-transfer agents in chain polymerizations, but not from monomer(s) as in polycondensations and polyadditions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:TT07167 goldbook:PT07163)
AnnotationAssertion(rdfs:seeAlso goldbook:TT07167 goldbook:I03043)
AnnotationAssertion(rdfs:seeAlso goldbook:TT07167 goldbook:M04017)
