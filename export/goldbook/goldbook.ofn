AnnotationAssertion(rdfs:label goldbook:12115 "syringomyelia")
AnnotationAssertion(dcterms:description goldbook:12115 "Cyst occurring within the spinal cord as a result of accumulation of cerebrospinal fluid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12115 "syrinx")
AnnotationAssertion(mito:isMentionedBy goldbook:12115 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12115 "current"^^xsd:string)
Declaration(Class(goldbook:12116))
AnnotationAssertion(rdfs:label goldbook:12116 "T-maze")
AnnotationAssertion(dcterms:description goldbook:12116 "Simple type of test apparatus with three arms shaped like the letter 'T.' After placing a rodent in the middle, it is recorded how often the animal enters each arm.")
AnnotationAssertion(rdfs:comment goldbook:12116 "Rewards can be used for motivation, or the inborn trend for alternation can be tested."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12116 "The Y-maze is a variation of the T-maze where the apparatus is \"Y\"-shaped."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12116 goldbook:11859)
AnnotationAssertion(mito:isMentionedBy goldbook:12116 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12116 "current"^^xsd:string)
Declaration(Class(goldbook:12117))
AnnotationAssertion(rdfs:label goldbook:12117 "tachycardia")
AnnotationAssertion(dcterms:description goldbook:12117 "Abnormally fast heartbeat.")
AnnotationAssertion(rdfs:seeAlso goldbook:12117 goldbook:11645)
AnnotationAssertion(mito:isMentionedBy goldbook:12117 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12117 "current"^^xsd:string)
Declaration(Class(goldbook:12118))
AnnotationAssertion(rdfs:label goldbook:12118 "tail flick test")
AnnotationAssertion(dcterms:description goldbook:12118 "Procedure in which the tail of a rodent is heated and the time taken for the animal to flick its tail (latency) is taken as a measure of the relative degree of antinociception.")
AnnotationAssertion(rdfs:seeAlso goldbook:12118 goldbook:11595)
AnnotationAssertion(rdfs:seeAlso goldbook:12118 goldbook:12119)
AnnotationAssertion(mito:isMentionedBy goldbook:12118 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12118 "current"^^xsd:string)
Declaration(Class(goldbook:12119))
AnnotationAssertion(rdfs:label goldbook:12119 "tail immersion test")
AnnotationAssertion(dcterms:description goldbook:12119 "Procedure in which the tail of a rodent is placed in a hot water bath (typically between \\(\\pu{54^{\\circ}C}\\) and \\(\\pu{58^{\\circ}C}\\)) and the time it takes the animal to remove the tail from the water is interpreted as a measurement of the relative degree of antinociception.")
AnnotationAssertion(rdfs:seeAlso goldbook:12119 goldbook:11595)
AnnotationAssertion(rdfs:seeAlso goldbook:12119 goldbook:12118)
AnnotationAssertion(mito:isMentionedBy goldbook:12119 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12119 "current"^^xsd:string)
Declaration(Class(goldbook:12120))
AnnotationAssertion(rdfs:label goldbook:12120 "tail suspension test")
AnnotationAssertion(dcterms:description goldbook:12120 "Procedure in which a mouse is suspended by its tail and the time spent attempting to right itself is observed.")
AnnotationAssertion(rdfs:comment goldbook:12120 "Most often used to test antidepressants, which usually increase the time the animal spends in escape-directed righting behavior."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12120 "Both the tail suspension test and the swimming test are sometimes referred to as behavioral despair tests."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12120 goldbook:11592)
AnnotationAssertion(rdfs:seeAlso goldbook:12120 goldbook:12106)
AnnotationAssertion(mito:isMentionedBy goldbook:12120 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12120 "current"^^xsd:string)
Declaration(Class(goldbook:12121))
AnnotationAssertion(rdfs:label goldbook:12121 "tauopathy")
AnnotationAssertion(dcterms:description goldbook:12121 "One of a class of neurodegenerative diseases, including Alzheimer disease, associated with abnormal aggregation of tau proteins.")
AnnotationAssertion(rdfs:seeAlso goldbook:12121 goldbook:11574)
AnnotationAssertion(rdfs:seeAlso goldbook:12121 goldbook:12179)
AnnotationAssertion(rdfs:seeAlso goldbook:12121 goldbook:11926)
