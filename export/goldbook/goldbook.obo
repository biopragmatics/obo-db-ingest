property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:12058
name: rotarod test
def: "Experimental observation of an animal’s \(usually a rodent’s\) ability to stay on a rotating rod without falling off."
comment: "Maintaining an upright position on the rod involves the righting reflex."
comment: "The length of time the animal stays on the rod is a relative measure of motor coordination, balance and resistance to fatigue."
