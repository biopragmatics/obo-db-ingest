    <!-- http://dx.doi.org/10.1351/goldbook.10771 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10771">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease of the eye characterized by increased intraocular pressure, resulting in atrophy of the optic nerve.</dcterms:description>
