Declaration(Class(goldbook:10026))
AnnotationAssertion(rdfs:label goldbook:10026 "primary examination standard")
AnnotationAssertion(dcterms:description goldbook:10026 "Examination standard established using a primary reference examination procedure, or created as an artefact, chosen by convention.")
Declaration(Class(goldbook:10027))
AnnotationAssertion(rdfs:label goldbook:10027 "secondary examination standard")
