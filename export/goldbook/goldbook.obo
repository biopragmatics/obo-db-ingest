property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:12637
name: co-drug
def: "Two chemically linked synergistic drugs designed to improve the drug delivery properties of one or both drugs."
comment: "The constituent drugs are indicated for the same disease, but may exert different therapeutic effects via disparate mechanisms of action."
