AnnotationAssertion(rdfs:label goldbook:C00882 "catalytic activity concentration")
AnnotationAssertion(dcterms:description goldbook:C00882 "Catalytic activity of the component divided by the volume of the system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C00882 "catalytic concentration")
AnnotationAssertion(rdfs:comment goldbook:C00882 "In clinical chemistry litre is recommended as unit for the volume."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00882 "In clinical chemistry the component is usually an enzyme."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00882 "The term 'catalytic concentration' is accepted for use in clinical chemistry."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00882 "Use of the term level as a synonym for concentration is deprecated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:C00882 "In describing a quantity, concentration must be clearly differentiated from content."^^xsd:string)
