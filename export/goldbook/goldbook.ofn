Declaration(Class(goldbook:T06284))
AnnotationAssertion(rdfs:label goldbook:T06284 "test portion")
AnnotationAssertion(dcterms:description goldbook:T06284 "The amount or volume of the test sample taken for analysis, usually of known weight or volume.")
