AnnotationAssertion(rdfs:label goldbook:12912 "atypical interstitial pneumonia")
AnnotationAssertion(dcterms:description goldbook:12912 "Acute or chronic respiratory distress in cattle, in the absence of toxemia or other systemic signs that are characteristic of other pneumonias.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12912 "exogen allergic alveolitis")
AnnotationAssertion(rdfs:comment goldbook:12912 "The causes are unknown, but may include allergic reactions or toxicity due to conversion of tryptophan to toxic 3-methylindole by gut flora."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12912 "Also called bovine pulmonary emphysema, enzootic bovine adenomatosis, pulmonary adenomatosis, mold hypersensitivity, fog fever, and panters."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12912 goldbook:12858)
AnnotationAssertion(rdfs:seeAlso goldbook:12912 goldbook:13241)
AnnotationAssertion(rdfs:seeAlso goldbook:12912 goldbook:13708)
