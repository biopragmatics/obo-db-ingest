AnnotationAssertion(mito:isMentionedBy goldbook:I03327 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03327 "current"^^xsd:string)
Declaration(Class(goldbook:I03328))
AnnotationAssertion(rdfs:label goldbook:I03328 "isotope exchange")
AnnotationAssertion(dcterms:description goldbook:I03328 "A chemical reaction in which the reactant and product chemical species are chemically identical but have different isotopic composition. In such a reaction the isotope distribution tends towards equilibrium (as expressed by fractionation factors) as a result of transfers of isotopically different atoms or groups. For example:")
AnnotationAssertion(mito:isMentionedBy goldbook:I03328 doi:10.1351/pac199466051077)
AnnotationAssertion(mito:isMentionedBy goldbook:I03328 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03328 "current"^^xsd:string)
Declaration(Class(goldbook:I03329))
AnnotationAssertion(rdfs:label goldbook:I03329 "isotope exchange analysis")
AnnotationAssertion(dcterms:description goldbook:I03329 "A kind of quantitative analysis based on the isotope exchange between isotopes of the element to be determined and other isotopes of this element in different valency states or in different molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03329 goldbook:I03328)
AnnotationAssertion(rdfs:seeAlso goldbook:I03329 goldbook:I03331)
AnnotationAssertion(rdfs:seeAlso goldbook:I03329 goldbook:Q04980)
AnnotationAssertion(mito:isMentionedBy goldbook:I03329 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03329 "current"^^xsd:string)
Declaration(Class(goldbook:I03330))
AnnotationAssertion(rdfs:label goldbook:I03330 "isotope pattern")
AnnotationAssertion(dcterms:description goldbook:I03330 "Set of peaks related to ions with the same chemical formula but containing different isotopes; e.g. the 16 and 17 mass/charge peaks in a $\\ce{CH4}$ sample arising from $\\ce{^{12}CH4^{+}}$ and $\\ce{^{13}CH4^{+}}$ ions.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03330 goldbook:I03331)
AnnotationAssertion(mito:isMentionedBy goldbook:I03330 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03330 "current"^^xsd:string)
Declaration(Class(goldbook:I03331))
AnnotationAssertion(rdfs:label goldbook:I03331 "isotopes")
AnnotationAssertion(dcterms:description goldbook:I03331 "Nuclides having the same atomic number but different mass numbers.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03331 goldbook:N04257)
AnnotationAssertion(rdfs:seeAlso goldbook:I03331 goldbook:A00499)
AnnotationAssertion(rdfs:seeAlso goldbook:I03331 goldbook:M03726)
AnnotationAssertion(mito:isMentionedBy goldbook:I03331 doi:10.1351/pac199466122513)
AnnotationAssertion(mito:isMentionedBy goldbook:I03331 doi:10.1515/pac-2014-0718)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03331 "current"^^xsd:string)
Declaration(Class(goldbook:I03332))
AnnotationAssertion(rdfs:label goldbook:I03332 "isotopic abundance")
AnnotationAssertion(dcterms:description goldbook:I03332 "The relative number of atoms of a particular isotopes in a mixture of the isotopes of an element, expressed as a fraction of all the atoms of the element.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03332 goldbook:I03331)
AnnotationAssertion(mito:isMentionedBy goldbook:I03332 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03332 "current"^^xsd:string)
Declaration(Class(goldbook:I03334))
AnnotationAssertion(rdfs:label goldbook:I03334 "isotopically deficient")
AnnotationAssertion(dcterms:description goldbook:I03334 "An isotopically labelled compound may be designated as isotopically deficient when the isotopic content of one or more elements has been depleted, i.e. when one or more nuclide(s) is (are) present in less than a natural ratio.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03334 goldbook:I03336)
AnnotationAssertion(rdfs:seeAlso goldbook:I03334 goldbook:N04257)
AnnotationAssertion(mito:isMentionedBy goldbook:I03334 doi:10.1351/pac198153101887)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03334 "current"^^xsd:string)
Declaration(Class(goldbook:I03335))
AnnotationAssertion(rdfs:label goldbook:I03335 "isotopically enriched ions")
AnnotationAssertion(dcterms:description goldbook:I03335 "When the abundance of a particular nuclide is increased above the level at which it occurs in nature and is incorporated in a molecule, the term 'isotopically enriched ion' is used to describe any ion enriched in the isotope.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03335 goldbook:N04257)
AnnotationAssertion(mito:isMentionedBy goldbook:I03335 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03335 "current"^^xsd:string)
Declaration(Class(goldbook:I03336))
AnnotationAssertion(rdfs:label goldbook:I03336 "isotopically labelled")
AnnotationAssertion(dcterms:description goldbook:I03336 "Describes a mixture of an isotopically unmodified compound with one or more analogous isotopically substituted compound(s).")
AnnotationAssertion(rdfs:seeAlso goldbook:I03336 goldbook:I03338)
AnnotationAssertion(rdfs:seeAlso goldbook:I03336 goldbook:I03339)
AnnotationAssertion(mito:isMentionedBy goldbook:I03336 doi:10.1351/pac198153101887)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03336 "current"^^xsd:string)
Declaration(Class(goldbook:I03337))
AnnotationAssertion(rdfs:label goldbook:I03337 "isotopically modified")
AnnotationAssertion(dcterms:description goldbook:I03337 "Describes a compound that has a macroscopic composition such that the isotopic ratio of nuclides for at least one element deviates measurably from that occurring in nature. It is either an isotopically substituted compound or an isotopically labelled compound.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03337 goldbook:I03336)
AnnotationAssertion(rdfs:seeAlso goldbook:I03337 goldbook:I03338)
AnnotationAssertion(rdfs:seeAlso goldbook:I03337 goldbook:N04257)
AnnotationAssertion(mito:isMentionedBy goldbook:I03337 doi:10.1351/pac198153101887)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03337 "current"^^xsd:string)
Declaration(Class(goldbook:I03338))
AnnotationAssertion(rdfs:label goldbook:I03338 "isotopically substituted")
AnnotationAssertion(dcterms:description goldbook:I03338 "Describes a compound that has a composition such that essentially all the molecules of the compound have only the indicated nuclide at each designated position. For all other positions, the absence of nuclide indication means that the nuclide composition is the natural one.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03338 goldbook:N04257)
AnnotationAssertion(mito:isMentionedBy goldbook:I03338 doi:10.1351/pac198153101887)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03338 "current"^^xsd:string)
Declaration(Class(goldbook:I03339))
AnnotationAssertion(rdfs:label goldbook:I03339 "isotopically unmodified")
AnnotationAssertion(dcterms:description goldbook:I03339 "Describes a compound that has a macroscopic composition such that its constituent nuclides are present in the proportions occurring in nature.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03339 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:I03339 goldbook:N04257)
AnnotationAssertion(mito:isMentionedBy goldbook:I03339 doi:10.1351/pac198153101887)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03339 "current"^^xsd:string)
Declaration(Class(goldbook:I03340))
AnnotationAssertion(rdfs:label goldbook:I03340 "isotopic carrier")
AnnotationAssertion(dcterms:description goldbook:I03340 "A carrier which differs only in isotopic composition from the trace it has to carry.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03340 goldbook:C00860)
AnnotationAssertion(mito:isMentionedBy goldbook:I03340 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03340 "current"^^xsd:string)
Declaration(Class(goldbook:I03341))
AnnotationAssertion(rdfs:label goldbook:I03341 "isotopic enrichment")
AnnotationAssertion(dcterms:description goldbook:I03341 "Any process by which the isotopic abundance of a specified isotopes in a mixture of isotopes of an element is increased.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03341 goldbook:I03331)
AnnotationAssertion(rdfs:seeAlso goldbook:I03341 goldbook:I03332)
AnnotationAssertion(mito:isMentionedBy goldbook:I03341 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03341 "current"^^xsd:string)
Declaration(Class(goldbook:I03342))
AnnotationAssertion(rdfs:label goldbook:I03342 "isotopic enrichment factor")
AnnotationAssertion(dcterms:description goldbook:I03342 "For a material enriched in a specified isotope, the ratio between the isotopic abundance and the natural abundance of that isotope.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03342 goldbook:I03331)
AnnotationAssertion(rdfs:seeAlso goldbook:I03342 goldbook:I03332)
AnnotationAssertion(rdfs:seeAlso goldbook:I03342 goldbook:N04089)
AnnotationAssertion(mito:isMentionedBy goldbook:I03342 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03342 "current"^^xsd:string)
Declaration(Class(goldbook:I03343))
AnnotationAssertion(rdfs:label goldbook:I03343 "isotopic fractionation factor")
AnnotationAssertion(dcterms:description goldbook:I03343 "The ratio \\[\\frac{(x_{1}/x_{2})_{\\rm{A}}}{(x_{1}/x_{2})_{\\rm{B}}}\\] where \\(x\\) is the abundance, expressed as the atom fraction of the isotope distinguished by the subscript numeral, when the two isotopes are equilibrated between two different chemical species $\\ce{A}$ and $\\ce{B}$ (or between specific sites A and B in the same or different chemical species). The term is most commonly met in connection with deuterium solvent isotope effects, when the fractionation factor \\(\\mathit{\\Phi}\\) expresses the ratio: \\[\\varPhi = \\frac{(x_{\\rm{D}}/x_{\\rm{H}})_{\\rm{solute}}}{(x_{\\rm{D}}/x_{\\rm{H}})_{\\rm{solvent}}}  \\] for the exchangeable hydrogen atoms in the chemical species (or sites) concerned. The concept is also applicable to transition states.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03343 goldbook:D01648)
AnnotationAssertion(rdfs:seeAlso goldbook:I03343 goldbook:I03327)
AnnotationAssertion(rdfs:seeAlso goldbook:I03343 goldbook:I03331)
AnnotationAssertion(mito:isMentionedBy goldbook:I03343 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03343 "current"^^xsd:string)
Declaration(Class(goldbook:I03344))
AnnotationAssertion(rdfs:label goldbook:I03344 "isotopic ion")
AnnotationAssertion(dcterms:description goldbook:I03344 "Any ion containing one or more of the less abundant naturally occurring isotopes of the elements that make up its structure, e.g. $\\ce{CH2D^{+}}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03344 goldbook:I03331)
AnnotationAssertion(mito:isMentionedBy goldbook:I03344 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03344 "current"^^xsd:string)
Declaration(Class(goldbook:I03345))
AnnotationAssertion(rdfs:label goldbook:I03345 "isotopic labelling")
AnnotationAssertion(dcterms:description goldbook:I03345 "Labelling in which the resulting product is only different from the initial one by its isotopic composition.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03345 goldbook:L03425)
AnnotationAssertion(mito:isMentionedBy goldbook:I03345 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03345 "current"^^xsd:string)
Declaration(Class(goldbook:I03346))
AnnotationAssertion(rdfs:label goldbook:I03346 "isotopic molecular ion")
AnnotationAssertion(dcterms:description goldbook:I03346 "A molecular ion containing one or more of the less abundant naturally occurring isotopes of the atoms that make up the molecular structure. Thus, for ethyl bromide there exist isotopic molecular ions such as: $\\ce{^{13}CCH5Br^{+.}}$, $\\ce{C2H4DBr^{+.}}$, $\\ce{C2H5^{81}Br^{+.}}$, $\\ce{^{13}C2H5^{81}Br^{+.}}$, etc.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03346 goldbook:I03331)
AnnotationAssertion(mito:isMentionedBy goldbook:I03346 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03346 "current"^^xsd:string)
Declaration(Class(goldbook:I03348))
AnnotationAssertion(rdfs:label goldbook:I03348 "isotopic scrambling")
AnnotationAssertion(dcterms:description goldbook:I03348 "The achievement, or the process of achieving, an equilibrium distribution of isotopes within a specified set of atoms in a chemical species or group of chemical species (for an example, see diagram).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:I03348 "scrambling")
AnnotationAssertion(rdfs:seeAlso goldbook:I03348 goldbook:I03343)
AnnotationAssertion(rdfs:seeAlso goldbook:I03348 goldbook:I03331)
AnnotationAssertion(mito:isMentionedBy goldbook:I03348 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03348 "current"^^xsd:string)
Declaration(Class(goldbook:I03349))
AnnotationAssertion(rdfs:label goldbook:I03349 "isotopic separation")
AnnotationAssertion(dcterms:description goldbook:I03349 "An operation for the purpose of modifying an isotopic abundance in a mixture of isotopes.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03349 goldbook:I03331)
AnnotationAssertion(rdfs:seeAlso goldbook:I03349 goldbook:I03332)
AnnotationAssertion(mito:isMentionedBy goldbook:I03349 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03349 "current"^^xsd:string)
Declaration(Class(goldbook:I03350))
AnnotationAssertion(rdfs:label goldbook:I03350 "isotopic tracer")
AnnotationAssertion(dcterms:description goldbook:I03350 "A tracer which only differs in isotopic composition from the substance to be traced.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03350 goldbook:T06422)
AnnotationAssertion(mito:isMentionedBy goldbook:I03350 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03350 "current"^^xsd:string)
Declaration(Class(goldbook:I03351))
AnnotationAssertion(rdfs:label goldbook:I03351 "isotopologue")
AnnotationAssertion(dcterms:description goldbook:I03351 "A molecular entity that differs only in isotopic composition (number of isotopic substitutions), e.g. $\\ce{CH4}$, $\\ce{CH3D}$, $\\ce{CH2D2}$.")
AnnotationAssertion(mito:isMentionedBy goldbook:I03351 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03351 "current"^^xsd:string)
Declaration(Class(goldbook:I03352))
AnnotationAssertion(rdfs:label goldbook:I03352 "isotopomer")
AnnotationAssertion(dcterms:description goldbook:I03352 "Isomers having the same number of each isotopic atom but differing in their positions. The term is a contraction of 'isotopic isomer'. Isotopomers can be either constitutional isomers (e.g. $\\ce{CH2DCH=O}$ and $\\ce{CH3CD=O}$) or isotopic stereoisomers [e.g. $\\ce{(\\textit{R})-}$ and $\\ce{(\\textit{S})-CH3CHDOH}$ or $\\ce{(\\textit{Z})-}$ and $\\ce{(\\textit{E})-CH3CH=CHD}$].")
AnnotationAssertion(rdfs:seeAlso goldbook:I03352 goldbook:I03289)
AnnotationAssertion(rdfs:seeAlso goldbook:I03352 goldbook:S05984)
AnnotationAssertion(mito:isMentionedBy goldbook:I03352 doi:10.1351/pac199466051077)
AnnotationAssertion(mito:isMentionedBy goldbook:I03352 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03352 "current"^^xsd:string)
Declaration(Class(goldbook:I03353))
AnnotationAssertion(rdfs:label goldbook:I03353 "isotropic")
AnnotationAssertion(dcterms:description goldbook:I03353 "A quantity which is independent of direction. Anisotropic and nonisotropic refer to quantities which are direction dependent.")
AnnotationAssertion(mito:isMentionedBy goldbook:I03353 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03353 "current"^^xsd:string)
Declaration(Class(goldbook:I03354))
AnnotationAssertion(rdfs:label goldbook:I03354 "isotropic carbon")
AnnotationAssertion(dcterms:description goldbook:I03354 "A monolithic carbon material without preferred crystallographic orientation of the microstructure.")
AnnotationAssertion(rdfs:comment goldbook:I03354 "Isotropic carbon can also be a graphite material. The isotropy can be gross (bulk), macroscopic or microscopic, depending on the structural level at which isotropy is obtained. This word is widely used today and its meaning covers all the above levels. For example, the aerospace graphites have isotropy built in by random grain orientation. Some nuclear graphites are isotropic at the crystalline (sub-grain) level."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:I03354 goldbook:C00841)
AnnotationAssertion(rdfs:seeAlso goldbook:I03354 goldbook:G02687)
AnnotationAssertion(rdfs:seeAlso goldbook:I03354 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:I03354 goldbook:N04233)
AnnotationAssertion(mito:isMentionedBy goldbook:I03354 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03354 "current"^^xsd:string)
Declaration(Class(goldbook:I03355))
AnnotationAssertion(rdfs:label goldbook:I03355 "isotropic pitch-based carbon fibres")
AnnotationAssertion(dcterms:description goldbook:I03355 "Carbon fibres obtained by carbonization of isotropic pitch fibres after these have been stabilized (i.e. made non-fusible).")
AnnotationAssertion(rdfs:comment goldbook:I03355 "During fabrication of isotropic pitch-based carbon fibres no means (neither mechanical nor chemical) are applied to achieve preferred orientation of the polyaromatic molecules in the fibre direction. They belong to the carbon fibres type LM (low modulus), and because of the relatively low values of strength and Young's modulus this pitch-based carbon fibres type is not used for high-performance reinforcement purposes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:I03355 goldbook:C00831)
AnnotationAssertion(rdfs:seeAlso goldbook:I03355 goldbook:M03966)
AnnotationAssertion(rdfs:seeAlso goldbook:I03355 goldbook:C00836)
AnnotationAssertion(rdfs:seeAlso goldbook:I03355 goldbook:C00840)
AnnotationAssertion(rdfs:seeAlso goldbook:I03355 goldbook:I03353)
AnnotationAssertion(rdfs:seeAlso goldbook:I03355 goldbook:P04677)
AnnotationAssertion(rdfs:seeAlso goldbook:I03355 goldbook:P04678)
AnnotationAssertion(mito:isMentionedBy goldbook:I03355 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03355 "current"^^xsd:string)
Declaration(Class(goldbook:I03356))
AnnotationAssertion(rdfs:label goldbook:I03356 "isoureas")
AnnotationAssertion(dcterms:description goldbook:I03356 "The imidic acid tautomer of urea, $\\ce{H2NC(=NH)OH}$, and its hydrocarbyl derivatives.")
AnnotationAssertion(rdfs:seeAlso goldbook:I03356 goldbook:H02891)
AnnotationAssertion(mito:isMentionedBy goldbook:I03356 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03356 "current"^^xsd:string)
Declaration(Class(goldbook:IT06772))
AnnotationAssertion(rdfs:label goldbook:IT06772 "ionophore")
AnnotationAssertion(dcterms:description goldbook:IT06772 "A compound which can carry specific ions through membranes of cells or organelles.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT06772 goldbook:O04324)
AnnotationAssertion(mito:isMentionedBy goldbook:IT06772 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT06772 "current"^^xsd:string)
Declaration(Class(goldbook:IT06773))
AnnotationAssertion(rdfs:label goldbook:IT06773 "ion pumps")
AnnotationAssertion(dcterms:description goldbook:IT06773 "Ion pumps enable ions to flow through membranes in a thermodynamically uphill direction by the use of an energy source such as ATP or light. They consist of sugar-containing hetero-peptide assemblies, which open and close upon the binding and subsequent hydrolysis of ATP, usually transporting more than one ion towards the outside or the inside of the membrane.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT06773 goldbook:H02902)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06773 goldbook:MT06878)
AnnotationAssertion(mito:isMentionedBy goldbook:IT06773 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT06773 "current"^^xsd:string)
Declaration(Class(goldbook:IT06779))
AnnotationAssertion(rdfs:label goldbook:IT06779 "iron-sulfur cluster")
AnnotationAssertion(dcterms:description goldbook:IT06779 "A unit comprising two or more iron atoms and bridging sulfur ligands in an iron-sulfur protein. The recommended designation of a cluster consists of the iron and sulfur content, in square brackets, for example, $\\ce{[2\\! Fe-2\\! S]}$, $\\ce{[3\\! Fe-4\\! S]}$. The possible oxidation levels are indicated by the net charge excluding the ligands, for example $\\ce{[4\\! Fe-4\\! S]^{2+}}$; $\\ce{[4\\! Fe-4\\! S]^{+}}$ or ($\\ce{[4\\! Fe-4\\! S]^{2+;1+}}$) cluster.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT06779 goldbook:B00741)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06779 goldbook:CT06769)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06779 goldbook:IT06780)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06779 goldbook:L03518)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06779 goldbook:O04362)
AnnotationAssertion(mito:isMentionedBy goldbook:IT06779 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT06779 "current"^^xsd:string)
Declaration(Class(goldbook:IT06780))
AnnotationAssertion(rdfs:label goldbook:IT06780 "iron-sulfur proteins")
AnnotationAssertion(dcterms:description goldbook:IT06780 "Proteins in which non-haem iron is coordinated with cysteine sulfur and usually also with inorganic sulfur. Divided into three major categories: rubredoxins; 'simple iron-sulfur proteins', containing only iron-sulfur clusters; and 'complex iron-sulfur proteins', containing additional active redox centres such as flavin, molybdenum or haem. In most iron-sulfur proteins, the clusters function as electron-transfer groups, but in others they have other functions, such as catalysis of hydratase/dehydratase reactions, maintenance of protein structure, or regulation of activity.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT06780 goldbook:C00874)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06780 goldbook:F02423)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06780 goldbook:H02714)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06780 goldbook:IT06779)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06780 goldbook:P04898)
AnnotationAssertion(mito:isMentionedBy goldbook:IT06780 doi:10.1351/pac199769061251)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT06780 "current"^^xsd:string)
Declaration(Class(goldbook:IT06828))
AnnotationAssertion(rdfs:label goldbook:IT06828 "incidence")
AnnotationAssertion(dcterms:description goldbook:IT06828 "Number of occurrences of illness commencing, or of persons falling ill, during a given period in a specific population: usually expressed as a rate.")
AnnotationAssertion(mito:isMentionedBy goldbook:IT06828 doi:10.1351/pac200476051033)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT06828 "current"^^xsd:string)
Declaration(Class(goldbook:IT06941))
AnnotationAssertion(rdfs:label goldbook:IT06941 "ideal chromatography")
AnnotationAssertion(dcterms:description goldbook:IT06941 "Chromatographic process, where no peak-broadening effects (such as diffusion, slow mass transfer, etc.) operate.")
AnnotationAssertion(rdfs:comment goldbook:IT06941 "This is a hypothetical case, implying that the plate number is infinite."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06941 goldbook:D01716)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06941 goldbook:P04694)
AnnotationAssertion(mito:isMentionedBy goldbook:IT06941 doi:10.1351/pac199668081591)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT06941 "current"^^xsd:string)
Declaration(Class(goldbook:IT06944))
AnnotationAssertion(rdfs:label goldbook:IT06944 "ideal, non-linear chromatography")
AnnotationAssertion(dcterms:description goldbook:IT06944 "Chromatographic process, where only the curvature of the distribution isotherm determines the shape of the peaks while other peak-broadening processes are neglected.")
AnnotationAssertion(rdfs:comment goldbook:IT06944 "The assumption of ideal, non-linear (INL) chromatography is often made in order to facilitate theoretical treatments. It can be justified in cases of efficient columns and distribution isotherms with prominent non-linearity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06944 goldbook:C01075)
AnnotationAssertion(rdfs:seeAlso goldbook:IT06944 goldbook:DT06932)
AnnotationAssertion(mito:isMentionedBy goldbook:IT06944 doi:10.1351/pac199668081591)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT06944 "current"^^xsd:string)
Declaration(Class(goldbook:IT07055))
AnnotationAssertion(rdfs:label goldbook:IT07055 "individual gauge for localized orbitals")
AnnotationAssertion(dcterms:description goldbook:IT07055 "A method of calculation of nuclear shieldings, in which localized molecular orbitals associated with inner shell, bonding orbitals, and lone pairs have unique origins for the calculation of diamagnetic and paramagnetic terms. With this method, satisfactory estimates of NMR chemical shifts for elements in the first and second rows can be achieved in ab initio calculations with basis sets of moderate size provided sufficiently accurate molecular geometries are used.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:IT07055 "IGLO")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07055 goldbook:D01668)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07055 goldbook:P04404)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07055 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07055 "current"^^xsd:string)
Declaration(Class(goldbook:IT07056))
AnnotationAssertion(rdfs:label goldbook:IT07056 "instability of Hartree–Fock solution")
AnnotationAssertion(dcterms:description goldbook:IT07056 "Existence of additional solutions to the equations of the Hartree–Fock method occurring usually in the case when potential energy surfaces of different electronic states are drawn close together. Within the spin-restricted Hartree–Fock method (RHF), singlet and triplet instabilities are distinguished. The former involves the existence of another solution with lower energy and the electron distribution of lower symmetry. It may be regarded as an indication that the initially assumed molecular shape needs correction. The triplet instability involves rejection of the condition of double occupancy of molecular orbitals and thus transition to the spin-unrestricted Hartree–Fock method (UHF). The triplet instability is a necessary, but insufficient, condition for the conclusion as to the biradical character of the ground state of a given system.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07056 goldbook:H02747)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07056 goldbook:B00671)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07056 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07056 goldbook:MT06972)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07056 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07056 "current"^^xsd:string)
Declaration(Class(goldbook:IT07057))
AnnotationAssertion(rdfs:label goldbook:IT07057 "intrinsic reaction coordinate")
AnnotationAssertion(dcterms:description goldbook:IT07057 "A minimum-energy reaction path on a potential energy surface in mass-weighted coordinates, connecting reactants to products via the transition state.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07057 goldbook:M03931)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07057 goldbook:T06468)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07057 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07057 "current"^^xsd:string)
Declaration(Class(goldbook:IT07058))
AnnotationAssertion(rdfs:label goldbook:IT07058 "ionic bond")
AnnotationAssertion(dcterms:description goldbook:IT07058 "The bond between atoms with sharply different electronegativities. In strict terms, an ionic bond refers to the electrostatic attraction experienced between the electric charges of a cation and an anion, in contrast with a purely covalent bond. In practice, it is preferable to consider the amount of ionic character of a bond rather than referring to purely ionic or purely covalent bonds. The relationship was proposed (L. Pauling) for the estimation of ionic character of a bond between atoms A and B: \\[\\rm{Amount of ionic character} = 1 - e^{-1/4}\\ (\\chi _{\\rm{A}}\\,-\\,\\chi_{\\rm{B}})\\] where \\(\\chi _{\\rm{A}}\\) and \\(\\chi _{\\rm{B}}\\) are the Pauling electronegativities of atoms A and B. This type of bonding is realized mostly in solids.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07058 goldbook:A00358)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07058 goldbook:C00907)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07058 goldbook:C01384)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07058 goldbook:E01990)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07058 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07058 "current"^^xsd:string)
Declaration(Class(goldbook:IT07059))
AnnotationAssertion(rdfs:label goldbook:IT07059 "isoconjugate systems")
AnnotationAssertion(dcterms:description goldbook:IT07059 "Molecular entities with similar conjugate networks which have the same number of $\\ce{\\uppi\\!\\mbox{-}electrons}$, e.g. cyclopentadienide anion and pyrrole or benzene and pyridine.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07059 goldbook:A00358)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07059 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07059 "current"^^xsd:string)
Declaration(Class(goldbook:IT07060))
AnnotationAssertion(rdfs:label goldbook:IT07060 "isogyric reaction")
AnnotationAssertion(dcterms:description goldbook:IT07060 "A reaction in which the number of electron pairs is conserved, for example:  $$\\ce{CH4(^{1}\\textit{A}_{1}) + H(^{2}\\textit{S}) -> CH3(^{2}\\textit{A}^{'}_{2}) + H2(^{1}\\Sigma^{+}_{\\rm{g}})}$$")
AnnotationAssertion(mito:isMentionedBy goldbook:IT07060 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07060 "current"^^xsd:string)
Declaration(Class(goldbook:IT07061))
AnnotationAssertion(rdfs:label goldbook:IT07061 "isostructural reaction")
AnnotationAssertion(dcterms:description goldbook:IT07061 "A ligand exchange reaction, where the structural type of the metal complex remains the same. $$\\ce{ML_{n} + X -> ML_{n-1}X + L + \\Delta\\textit{E}}$$ Although these types of reactions are not necessarily isodesmic reactions, a substantial degree of error cancellation for the calculated energy, $\\Delta E$, is achieved because the coordination sphere of the metal atom $\\ce{M}$ is conserved.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07061 goldbook:C01329)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07061 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07061 "current"^^xsd:string)
Declaration(Class(goldbook:IT07139))
AnnotationAssertion(rdfs:label goldbook:IT07139 "interchange reaction")
AnnotationAssertion(dcterms:description goldbook:IT07139 "Reaction that results in an exchange of atoms or groups between a polymer and low-molar-mass molecules, between polymer molecules, or between sites within the same macromolecule.")
AnnotationAssertion(rdfs:comment goldbook:IT07139 "An interchange reaction that occurs with polyesters is called transesterification."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07139 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07139 "current"^^xsd:string)
Declaration(Class(goldbook:IT07155))
AnnotationAssertion(rdfs:label goldbook:IT07155 "ion-exchange polymer")
AnnotationAssertion(dcterms:description goldbook:IT07155 "Polymer that is able to exchange ions (cations or anions) with ionic components in solution.")
AnnotationAssertion(rdfs:comment goldbook:IT07155 "An ion-exchange polymer in ionized form may also be referred to as a polyanion or a polycation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07155 "Synthetic ion-exchange organic polymers are often network polyelectrolytes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07155 "A membrane having ion-exchange groups is called an ion-exchange membrane."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07155 "Use of the term 'ion-exchange resin' for 'ion-exchange polymer' is strongly discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07155 goldbook:I03167)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07155 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07155 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07155 goldbook:RT07166)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07155 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07155 "current"^^xsd:string)
Declaration(Class(goldbook:IT07175))
AnnotationAssertion(rdfs:label goldbook:IT07175 "impact-modified polymer")
AnnotationAssertion(dcterms:description goldbook:IT07175 "Polymeric material whose impact resistance and toughness have been increased by the incorporation of phase microdomains of a rubbery material.")
AnnotationAssertion(rdfs:comment goldbook:IT07175 "An example is the incorporation of soft polybutadiene domains into glassy polystyrene to produce high-impact polystyrene."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07175 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07175 goldbook:R05315)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07175 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07175 "current"^^xsd:string)
Declaration(Class(goldbook:IT07208))
AnnotationAssertion(rdfs:label goldbook:IT07208 "intrinsically conducting polymer")
AnnotationAssertion(dcterms:description goldbook:IT07208 "Electrically conducting polymer composed of macromolecules having fully conjugated sequences of double bonds along the chains.")
AnnotationAssertion(rdfs:comment goldbook:IT07208 "The bulk electrical conductivity of an intrinsically conducting polymer is comparable to that of some metals and results from its macromolecules acquiring positive or negative charges through oxidation or reduction by an electron-acceptor or -donor (charge-transfer agent), termed a dopant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07208 "Examples of intrinsically conducting polymers are polyacetylene, polythiophene, polypyrrole, or polyaniline. Unlike polymeric electrolytes, in which charge is transported by dissolved ions, charge in intrinsically conducting polymers is transported along and between polymer molecules via generated charge carriers (e.g., holes, electrons)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07208 "An intrinsically conducting polymer should be distinguished from a conducting polymer composite and from a solid polymer electrolyte."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07208 goldbook:ET07205)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07208 goldbook:CT07170)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07208 goldbook:CT07201)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07208 goldbook:DT07203)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07208 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07208 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07208 goldbook:ST07227)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07208 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07208 "current"^^xsd:string)
Declaration(Class(goldbook:IT07210))
AnnotationAssertion(rdfs:label goldbook:IT07210 "ionene")
AnnotationAssertion(dcterms:description goldbook:IT07210 "Polymer composed of macromolecules in which ionized or ionic groups are parts of main chains.")
AnnotationAssertion(rdfs:comment goldbook:IT07210 "Most commonly, the ionic groups in ionenes are quaternary ammonium groups."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07210 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07210 "current"^^xsd:string)
Declaration(Class(goldbook:IT07212))
AnnotationAssertion(rdfs:label goldbook:IT07212 "ionic aggregates in an ionomer")
AnnotationAssertion(dcterms:description goldbook:IT07212 "Domains enriched with ionic groups within an ionomer matrix.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07212 goldbook:I03229)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07212 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07212 "current"^^xsd:string)
Declaration(Class(goldbook:IT07213))
AnnotationAssertion(rdfs:label goldbook:IT07213 "ionic polymer")
AnnotationAssertion(dcterms:description goldbook:IT07213 "Polymer composed of macromolecules containing ionic or ionizable groups, or both, irrespective of their nature, content, and location. Synonym: ion-containing polymer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:IT07213 "ion-containing polymer")
AnnotationAssertion(mito:isMentionedBy goldbook:IT07213 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07213 "current"^^xsd:string)
Declaration(Class(goldbook:IT07215))
AnnotationAssertion(rdfs:label goldbook:IT07215 "ionomer cluster")
AnnotationAssertion(dcterms:description goldbook:IT07215 "Ionic aggregate, in a polymer matrix of low polarity, formed through interactions of ionomer multiplets.")
AnnotationAssertion(rdfs:comment goldbook:IT07215 "The mobility of the polymer segments surrounding the multiplets is reduced relative to that of bulk material. With increasing ion content, the number density of the ionomer multiplets increases, leading to overlapping of the restricted mobility regions around the multiplets and the formation of clusters."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07215 "Typically, an ionomer exhibits two glass transition temperatures (\\(T_{\\rm{g}}\\)), one for the non-polar matrix and the other for clusters."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07215 goldbook:G02640)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07215 goldbook:I03229)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07215 goldbook:M03955)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07215 goldbook:N04262)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07215 goldbook:P04710)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07215 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07215 "current"^^xsd:string)
Declaration(Class(goldbook:IT07216))
AnnotationAssertion(rdfs:label goldbook:IT07216 "ionomer multiplet")
AnnotationAssertion(dcterms:description goldbook:IT07216 "Ionic aggregate, in a polymer matrix of low polarity, formed through the association of ion-pairs in an ionomer.")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07216 goldbook:A00472)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07216 goldbook:I03229)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07216 goldbook:P04710)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07216 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07216 "current"^^xsd:string)
Declaration(Class(goldbook:IT07233))
AnnotationAssertion(rdfs:label goldbook:IT07233 "isomorphic polymer blend")
AnnotationAssertion(dcterms:description goldbook:IT07233 "Polymer blend of two or more different semi-crystalline polymers that are miscible in the crystalline state as well as in the molten state.")
AnnotationAssertion(rdfs:comment goldbook:IT07233 "Such a blend exhibits a single, composition-dependent glass-transition temperature, \\(T_{\\rm{g}}\\), and a single, composition-dependent melting point, \\(T_{\\rm{m}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07233 "This behaviour is extremely rare; very few cases are known."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07233 goldbook:P04736)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07233 goldbook:G02641)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07233 goldbook:M03821)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07233 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07233 "current"^^xsd:string)
Declaration(Class(goldbook:IT07239))
AnnotationAssertion(rdfs:label goldbook:IT07239 "immiscibility")
AnnotationAssertion(dcterms:description goldbook:IT07239 "Inability of a mixture to form a single phase.")
AnnotationAssertion(rdfs:comment goldbook:IT07239 "Immiscibility may be limited to certain ranges of temperature, pressure, and composition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07239 "Immiscibility depends on the chemical structures, molar-mass distributions, and molecular architectures of the components."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07239 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07239 "current"^^xsd:string)
Declaration(Class(goldbook:IT07240))
AnnotationAssertion(rdfs:label goldbook:IT07240 "immiscible polymer blend")
AnnotationAssertion(dcterms:description goldbook:IT07240 "Polymer blend that exhibits immiscibility.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:IT07240 "heterogeneous polymer blend")
AnnotationAssertion(rdfs:seeAlso goldbook:IT07240 goldbook:P04736)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07240 goldbook:IT07239)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07240 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07240 "current"^^xsd:string)
Declaration(Class(goldbook:IT07246))
AnnotationAssertion(rdfs:label goldbook:IT07246 "impregnation")
AnnotationAssertion(dcterms:description goldbook:IT07246 "Penetration of monomeric, oligomeric, or polymeric liquids into an assembly of fibres.")
AnnotationAssertion(rdfs:comment goldbook:IT07246 "The term as defined here is specific to polymer science. An alternative definition of 'impregnation' applies in some other fields of chemistry."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07246 "Impregnation is usually carried out on a woven fabric or a yarn."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07246 goldbook:O04286)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07246 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07246 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07246 "current"^^xsd:string)
Declaration(Class(goldbook:IT07248))
AnnotationAssertion(rdfs:label goldbook:IT07248 "intercalation")
AnnotationAssertion(dcterms:description goldbook:IT07248 "Process by which a substance becomes transferred into pre-existing spaces of molecular dimensions in a second substance.")
AnnotationAssertion(rdfs:comment goldbook:IT07248 "The term as defined here is specific to polymer science. An alternative definition of 'intercalation' applies in some other fields of chemistry."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07248 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07248 "current"^^xsd:string)
Declaration(Class(goldbook:IT07253))
AnnotationAssertion(rdfs:label goldbook:IT07253 "interfacial adhesion")
AnnotationAssertion(dcterms:description goldbook:IT07253 "Adhesion in which interfaces between phases or components are maintained by intermolecular forces, chain entanglements, or both, across the interfaces.")
AnnotationAssertion(rdfs:comment goldbook:IT07253 "Interfacial adhesion is also referred to as tack."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07253 "Adhesive strength (recommended symbol: \\(F_{\\rm{a}}\\), unit: \\(\\rm{N m}^{-2}\\)) is the force required to separate one condensed phase domain from another at the interface between the two phase domains divided by the area of the interface."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07253 "Interfacial tension (recommended symbol: \\(\\gamma\\), unit: \\(\\rm{N m}^{-1}\\), \\(\\pu{J m-2}\\)) is the change in Gibbs energy per unit change in interfacial area for substances in physical contact."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:IT07253 "Use of the term interfacial energy for interfacial tension is not recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07253 goldbook:I03082)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07253 goldbook:I03088)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07253 goldbook:I03098)
AnnotationAssertion(rdfs:seeAlso goldbook:IT07253 goldbook:PT07286)
AnnotationAssertion(mito:isMentionedBy goldbook:IT07253 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:IT07253 "current"^^xsd:string)
