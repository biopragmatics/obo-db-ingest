AnnotationAssertion(mito:isMentionedBy goldbook:15915 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15915 "current"^^xsd:string)
Declaration(Class(goldbook:15916))
AnnotationAssertion(rdfs:label goldbook:15916 "nephrosis")
AnnotationAssertion(dcterms:description goldbook:15916 "Disease of the kidneys marked by degeneration of renal tubular epithelium.")
AnnotationAssertion(rdfs:seeAlso goldbook:15916 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:15916 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15916 "current"^^xsd:string)
Declaration(Class(goldbook:15917))
AnnotationAssertion(rdfs:label goldbook:15917 "nephrotoxic")
AnnotationAssertion(dcterms:description goldbook:15917 "Chemically harmful to the cells of the kidney.")
AnnotationAssertion(mito:isMentionedBy goldbook:15917 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15917 "current"^^xsd:string)
Declaration(Class(goldbook:15918))
AnnotationAssertion(rdfs:label goldbook:15918 "nitrosative stress")
AnnotationAssertion(dcterms:description goldbook:15918 "Adverse effects occurring when the generation of reactive nitrogen species in a system exceeds the system’s ability to neutralize and eliminate them; nitrosative stress may lead to nitrosylation reactions that can alter protein structure, thus inhibiting normal function.")
AnnotationAssertion(mito:isMentionedBy goldbook:15918 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15918 "current"^^xsd:string)
Declaration(Class(goldbook:15919))
AnnotationAssertion(rdfs:label goldbook:15919 "no-acceptable-daily-intake-allocated")
AnnotationAssertion(dcterms:description goldbook:15919 "This expression is applicable to a substance for which the available information is not sufficient to establish its safety, or when the specifications for identity and purity are not adequate, or when the available data show that the substance is hazardous and should not be used.")
AnnotationAssertion(rdfs:comment goldbook:15919 "The basis for the use of the expression should be determined before action is taken; in the first two cases above, not being able to allocate an ADI does not mean that the substance is unsafe."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15919 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15919 "current"^^xsd:string)
Declaration(Class(goldbook:15920))
AnnotationAssertion(rdfs:label goldbook:15920 "nodule")
AnnotationAssertion(dcterms:description goldbook:15920 "Small node or boss that is solid and can be detected by touch.")
AnnotationAssertion(mito:isMentionedBy goldbook:15920 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15920 "current"^^xsd:string)
Declaration(Class(goldbook:15921))
AnnotationAssertion(rdfs:label goldbook:15921 "no-effect dose")
AnnotationAssertion(dcterms:description goldbook:15921 "Amount of a substance that has no effect on the organism.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15921 "NED")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15921 "subthreshold dose")
AnnotationAssertion(rdfs:comment goldbook:15921 "It is lower than the threshold of harmful effect and is estimated while establishing the threshold of harmful effect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15921 goldbook:16136)
AnnotationAssertion(mito:isMentionedBy goldbook:15921 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15921 "current"^^xsd:string)
Declaration(Class(goldbook:15922))
AnnotationAssertion(rdfs:label goldbook:15922 "no-effect level")
AnnotationAssertion(dcterms:description goldbook:15922 "Maximum dose (of a substance) that produces no detectable changes under defined conditions of exposure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15922 "NEL")
AnnotationAssertion(rdfs:comment goldbook:15922 "This term tends to be substituted by no-observed-adverse-effect level (NOAEL) or no-observed-effect level (NOEL)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15922 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15922 "current"^^xsd:string)
Declaration(Class(goldbook:15923))
AnnotationAssertion(rdfs:label goldbook:15923 "non-bioenvironmental transformation")
AnnotationAssertion(dcterms:description goldbook:15923 "Change in the chemical or physical nature of a substance occurring as a result of physicochemical conditions and independent of any biological system.")
AnnotationAssertion(mito:isMentionedBy goldbook:15923 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15923 "current"^^xsd:string)
Declaration(Class(goldbook:15924))
AnnotationAssertion(rdfs:label goldbook:15924 "nonionising radiation")
AnnotationAssertion(dcterms:description goldbook:15924 "Electromagnetic radiation of low energy that is not capable of causing ionization.")
AnnotationAssertion(mito:isMentionedBy goldbook:15924 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15924 "current"^^xsd:string)
Declaration(Class(goldbook:15925))
AnnotationAssertion(rdfs:label goldbook:15925 "nonoccupational exposure")
AnnotationAssertion(dcterms:description goldbook:15925 "Environmental exposure outside the workplace to substances that are otherwise associated with particular work environments and (or) activities and processes that occur there.")
AnnotationAssertion(mito:isMentionedBy goldbook:15925 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15925 "current"^^xsd:string)
Declaration(Class(goldbook:15927))
AnnotationAssertion(rdfs:label goldbook:15927 "nosocomial")
AnnotationAssertion(dcterms:description goldbook:15927 "Associated with a hospital or infirmary, especially used of diseases that may result from treatment in such an institution.")
AnnotationAssertion(rdfs:seeAlso goldbook:15927 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:15927 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15927 "current"^^xsd:string)
Declaration(Class(goldbook:15928))
AnnotationAssertion(rdfs:label goldbook:15928 "nutritional table method")
AnnotationAssertion(dcterms:description goldbook:15928 "Procedure for evaluating the dietary intake of a large number of people.")
AnnotationAssertion(rdfs:comment goldbook:15928 "The accuracy of the method depends on the accuracy with which records of the food consumption can be established and the accuracy of the nutritional tables specifying the concentration of various nutrients, vitamins, essential, and non-essential substances including pesticide residues."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:15928 "For each record of quantity of food consumed during a certain time period, the daily intake of the substance in question is calculated by multiplying the substance concentration in the food item (as obtained from the nutritional table) by the quantity of food consumed and dividing by the time of observation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15928 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15928 "current"^^xsd:string)
Declaration(Class(goldbook:15929))
AnnotationAssertion(rdfs:label goldbook:15929 "nychthemeral")
AnnotationAssertion(dcterms:description goldbook:15929 "Relating to or exhibiting a nychthemeron or \\(\\pu{24\\!\\mbox{-}h}\\) period.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15929 "circadian")
AnnotationAssertion(mito:isMentionedBy goldbook:15929 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15929 "current"^^xsd:string)
Declaration(Class(goldbook:15930))
AnnotationAssertion(rdfs:label goldbook:15930 "objective environment")
AnnotationAssertion(dcterms:description goldbook:15930 "Actual physical, chemical, and social environment as described by objective measurements, such as noise levels in decibels and concentrations of air pollutants.")
AnnotationAssertion(mito:isMentionedBy goldbook:15930 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15930 "current"^^xsd:string)
Declaration(Class(goldbook:15931))
AnnotationAssertion(rdfs:label goldbook:15931 "occupational environment")
AnnotationAssertion(dcterms:description goldbook:15931 "Surrounding conditions at a workplace.")
AnnotationAssertion(mito:isMentionedBy goldbook:15931 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15931 "current"^^xsd:string)
Declaration(Class(goldbook:15932))
AnnotationAssertion(rdfs:label goldbook:15932 "occupational exposure")
AnnotationAssertion(dcterms:description goldbook:15932 "Experience of substances, intensities of radiation, etc., or other conditions while at work.")
AnnotationAssertion(mito:isMentionedBy goldbook:15932 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15932 "current"^^xsd:string)
Declaration(Class(goldbook:15933))
AnnotationAssertion(rdfs:label goldbook:15933 "occupational exposure limit")
AnnotationAssertion(dcterms:description goldbook:15933 "Regulatory level of exposure to substances, intensities of radiation, etc., or other conditions, specified appropriately in relevant government legislation or related codes of practice.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15933 "OEL")
AnnotationAssertion(mito:isMentionedBy goldbook:15933 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15933 "current"^^xsd:string)
Declaration(Class(goldbook:15934))
AnnotationAssertion(rdfs:label goldbook:15934 "occupational exposure standard")
AnnotationAssertion(dcterms:description goldbook:15934 "Level of exposure to substances, intensities of radiation, etc., or other conditions considered to represent specified good practice and a realistic criterion for the control of exposure by appropriate plant design, engineering controls, and, if necessary, the addition and use of personal protective clothing. In UK, health-based exposure limit defined under COSHH Regulations as the concentration of any airborne substance, averaged over a reference period, at which, according to current knowledge, there is no evidence that it is likely to be injurious to employees, if they are exposed by inhalation, day after day, to that concentration, and set on the advice of the HSE Advisory Committee on Toxic Substances.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:15934 "OES")
AnnotationAssertion(rdfs:seeAlso goldbook:15934 goldbook:15695)
AnnotationAssertion(rdfs:seeAlso goldbook:15934 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15934 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15934 "current"^^xsd:string)
Declaration(Class(goldbook:15935))
AnnotationAssertion(rdfs:label goldbook:15935 "occupational hygiene")
AnnotationAssertion(dcterms:description goldbook:15935 "Identification, assessment, and control of physicochemical and biological factors in the workplace that may affect the health or well-being of those at work and in the surrounding community.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15935 "industrial hygiene")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15935 "occupational safety and health")
AnnotationAssertion(rdfs:seeAlso goldbook:15935 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15935 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15935 "current"^^xsd:string)
Declaration(Class(goldbook:15936))
AnnotationAssertion(rdfs:label goldbook:15936 "occupational medicine")
AnnotationAssertion(dcterms:description goldbook:15936 "Specialty devoted to the prevention and management of occupational injury, illness, and disability, and the promotion of the health of workers, their families, and their communities.")
AnnotationAssertion(rdfs:seeAlso goldbook:15936 goldbook:15757)
AnnotationAssertion(mito:isMentionedBy goldbook:15936 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15936 "current"^^xsd:string)
Declaration(Class(goldbook:15937))
AnnotationAssertion(rdfs:label goldbook:15937 "ocular")
AnnotationAssertion(dcterms:description goldbook:15937 "Pertaining to the eye.")
AnnotationAssertion(mito:isMentionedBy goldbook:15937 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15937 "current"^^xsd:string)
Declaration(Class(goldbook:15938))
AnnotationAssertion(rdfs:label goldbook:15938 "odds")
AnnotationAssertion(dcterms:description goldbook:15938 "Ratio of the probability of occurrence of an event to that of non-occurrence, or the ratio of the probability that something is so, to the probability that it is not so.")
AnnotationAssertion(mito:isMentionedBy goldbook:15938 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15938 "current"^^xsd:string)
Declaration(Class(goldbook:15939))
AnnotationAssertion(rdfs:label goldbook:15939 "odds ratio")
AnnotationAssertion(dcterms:description goldbook:15939 "Quotient obtained by dividing one set of odds by another. The terms 'odds' or 'odds ratio' are defined differently according to the situation under discussion. Consider the following notation for the distribution of a binary exposure and a disease in a population or a sample. \\[\\begin{array}{l c c} & Exposed & Nonexposed \\\\ \\rm{Disease} & a & b \\\\ \\rm{No\\ disease} & c & d \\\\ \\end{array}\\] The odds ratio (cross-product ratio) is \\(ad/bc\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:15939 "OR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15939 "cross-product ratio")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15939 "relative odds")
AnnotationAssertion(rdfs:comment goldbook:15939 "The exposure-odds ratio for a set of case control data is the ratio of the odds in favor of exposure among the cases (\\(a/b\\)) to the odds in favor of exposure among non-cases (\\(c/d\\)), which is equal to \\(ad/(bc)\\). With incident cases, unbiased subject selection, and a \"rare\" disease (say, under \\(\\pu{2\\%}\\) cumulative incidence rate over the study period), \\(ad/bc\\) is an approximate estimate of the risk ratio. With incident cases, unbiased subject selection, and density sampling of controls, \\(ad/bc\\) is an estimate of the ratio of the person-time incidence rates (force of morbidity) in the exposed and unexposed. No rarity assumption is required for this."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:15939 "The disease-odds (rate-odds) ratio for a cohort or cross-section is the ratio of the odds in favor of disease among the exposed population (\\(a/c\\)) to the odds in favor of disease among the unexposed (\\(b/d\\)), which is equal to \\(ad/bc\\) and hence is equal to the exposure-odds ratio for the cohort or cross-section."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:15939 "The prevalence-odds ratio refers to an odds ratio derived cross-sectionally, as, for example, an odds ratio derived from studies of prevalent (rather than incident) cases."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:15939 "The risk-odds ratio is the ratio of the odds in favor of getting disease, if exposed, to the odds in favor of getting disease if not exposed. The odds ratio derived from a cohort study is an estimate of this."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15939 goldbook:15695)
AnnotationAssertion(mito:isMentionedBy goldbook:15939 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15939 "current"^^xsd:string)
Declaration(Class(goldbook:15940))
AnnotationAssertion(rdfs:label goldbook:15940 "odor threshold")
AnnotationAssertion(dcterms:description goldbook:15940 "In principle, the lowest concentration of an odorant in the air that can be detected by a human being.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15940 "odor detection threshold")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15940 "odour threshold")
AnnotationAssertion(rdfs:comment goldbook:15940 "In practice, a panel of \"sniffers\" is often used, and the threshold taken as the concentration at which $\\pu{50\\%}$ of the panel can detect the odorant (although some workers have also used $\\pu{100\\%}$ thresholds). The odor concentration at the detection threshold may be defined as one odor unit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15940 goldbook:16136)
AnnotationAssertion(mito:isMentionedBy goldbook:15940 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15940 "current"^^xsd:string)
Declaration(Class(goldbook:15941))
AnnotationAssertion(rdfs:label goldbook:15941 "olf")
AnnotationAssertion(dcterms:description goldbook:15941 "Unit used to measure scent emission of people and objects; one olf is defined as the scent emission of an 'average person', a sitting adult who takes an average of \\(\\pu{0.7}\\) baths per day and whose skin has a total area of \\(\\pu{1.8 m2}\\); the scent emission of an object or person is measured by specially trained personnel comparing it to normed scents.")
AnnotationAssertion(rdfs:comment goldbook:15941 "The olf should not be confused with the of unit of scent immission (as opposed to emission), the decipol, which also takes into account the ventilation system’s air volume flow."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:15941 goldbook:15625)
AnnotationAssertion(mito:isMentionedBy goldbook:15941 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15941 "current"^^xsd:string)
Declaration(Class(goldbook:15942))
AnnotationAssertion(rdfs:label goldbook:15942 "olfactometer")
AnnotationAssertion(dcterms:description goldbook:15942 "Apparatus for testing the power of the sense of smell.")
AnnotationAssertion(mito:isMentionedBy goldbook:15942 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15942 "current"^^xsd:string)
Declaration(Class(goldbook:15943))
AnnotationAssertion(rdfs:label goldbook:15943 "oligozoospermia")
AnnotationAssertion(dcterms:description goldbook:15943 "Sperm concentration less than a reference value.")
AnnotationAssertion(mito:isMentionedBy goldbook:15943 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15943 "current"^^xsd:string)
Declaration(Class(goldbook:15944))
AnnotationAssertion(rdfs:label goldbook:15944 "oliguria")
AnnotationAssertion(dcterms:description goldbook:15944 "Excretion of a diminished amount of urine in relation to fluid intake.")
AnnotationAssertion(mito:isMentionedBy goldbook:15944 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15944 "current"^^xsd:string)
Declaration(Class(goldbook:15945))
AnnotationAssertion(rdfs:label goldbook:15945 "-omics, -omes")
AnnotationAssertion(dcterms:description goldbook:15945 "Neologism referring to the fields of study in biology ending in the suffix -omics, such as genomics or proteomics: The related neologism -omes are the objects of study of the field such as the genome or proteome, respectively.")
AnnotationAssertion(mito:isMentionedBy goldbook:15945 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15945 "current"^^xsd:string)
Declaration(Class(goldbook:15946))
AnnotationAssertion(rdfs:label goldbook:15946 "oncogene")
AnnotationAssertion(dcterms:description goldbook:15946 "Gene that can cause neoplastic (see neoplasia) transformation of a cell; oncogenes are slightly changed equivalents of normal genes known as proto-oncogenes.")
AnnotationAssertion(rdfs:seeAlso goldbook:15946 goldbook:15913)
AnnotationAssertion(mito:isMentionedBy goldbook:15946 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15946 "current"^^xsd:string)
Declaration(Class(goldbook:15947))
AnnotationAssertion(rdfs:label goldbook:15947 "oncogenesis")
AnnotationAssertion(dcterms:description goldbook:15947 "Production or causation of tumors.")
AnnotationAssertion(mito:isMentionedBy goldbook:15947 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15947 "current"^^xsd:string)
Declaration(Class(goldbook:15948))
AnnotationAssertion(rdfs:label goldbook:15948 "oncogenic")
AnnotationAssertion(dcterms:description goldbook:15948 "Capable of producing tumors in animals, either benign (noncancerous) or malignant (cancerous).")
AnnotationAssertion(rdfs:seeAlso goldbook:15948 goldbook:15502)
AnnotationAssertion(mito:isMentionedBy goldbook:15948 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15948 "current"^^xsd:string)
Declaration(Class(goldbook:15949))
AnnotationAssertion(rdfs:label goldbook:15949 "one-hit model")
AnnotationAssertion(dcterms:description goldbook:15949 "Dose-response model of the form \\[P = 1 - {\\rm{e}}^{-bd}\\] where \\(P\\) is the probability of cancer death from a continuous dose rate, \\(d\\), and \\(b\\) is a constant.")
AnnotationAssertion(mito:isMentionedBy goldbook:15949 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15949 "current"^^xsd:string)
Declaration(Class(goldbook:15950))
AnnotationAssertion(rdfs:label goldbook:15950 "onycholysis")
AnnotationAssertion(dcterms:description goldbook:15950 "Loosening or detachment of the nail from the nail bed following some destructive process.")
AnnotationAssertion(mito:isMentionedBy goldbook:15950 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15950 "current"^^xsd:string)
Declaration(Class(goldbook:15951))
AnnotationAssertion(rdfs:label goldbook:15951 "ophthalmic")
AnnotationAssertion(dcterms:description goldbook:15951 "Pertaining to the eye.")
AnnotationAssertion(mito:isMentionedBy goldbook:15951 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15951 "current"^^xsd:string)
Declaration(Class(goldbook:15952))
AnnotationAssertion(rdfs:label goldbook:15952 "organ dose")
AnnotationAssertion(dcterms:description goldbook:15952 "Amount of a substance or physical agent (radiation) absorbed by an organ.")
AnnotationAssertion(mito:isMentionedBy goldbook:15952 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15952 "current"^^xsd:string)
Declaration(Class(goldbook:15953))
AnnotationAssertion(rdfs:label goldbook:15953 "organelle")
AnnotationAssertion(dcterms:description goldbook:15953 "Microstructure or separated compartment within a cell that has a specialized function.")
AnnotationAssertion(mito:isMentionedBy goldbook:15953 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15953 "current"^^xsd:string)
Declaration(Class(goldbook:15954))
AnnotationAssertion(rdfs:label goldbook:15954 "organic carbon partition coefficient")
AnnotationAssertion(dcterms:description goldbook:15954 "Measure of the tendency for organic substances to be adsorbed by soil or sediment, expressed as: \\[K_{\\rm{oc}} = \\frac{(\\ce{mass adsorbed substance})/(\\ce{mass organic carbon})}{(\\ce{mass concentration of absorbed substance})}\\]")
AnnotationAssertion(rdfs:comment goldbook:15954 "The \\(K_{\\rm{oc}}\\) is substance-specific and is largely independent of soil properties."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:15954 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15954 "current"^^xsd:string)
Declaration(Class(goldbook:15955))
AnnotationAssertion(rdfs:label goldbook:15955 "osteo-")
AnnotationAssertion(dcterms:description goldbook:15955 "Prefix meaning pertaining to bone.")
AnnotationAssertion(mito:isMentionedBy goldbook:15955 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15955 "current"^^xsd:string)
Declaration(Class(goldbook:15956))
AnnotationAssertion(rdfs:label goldbook:15956 "osteodystrophy")
AnnotationAssertion(dcterms:description goldbook:15956 "Abnormal development of bone.")
AnnotationAssertion(mito:isMentionedBy goldbook:15956 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15956 "current"^^xsd:string)
Declaration(Class(goldbook:15957))
AnnotationAssertion(rdfs:label goldbook:15957 "osteomalacia")
AnnotationAssertion(dcterms:description goldbook:15957 "Condition marked by softening of the bones (due to impaired mineralization, with excess accumulation of osteoid), with pain, tenderness, muscular weakness, anorexia, and loss of weight, resulting from deficiency of vitamin D and calcium.")
AnnotationAssertion(mito:isMentionedBy goldbook:15957 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15957 "current"^^xsd:string)
Declaration(Class(goldbook:15958))
AnnotationAssertion(rdfs:label goldbook:15958 "osteoporosis")
AnnotationAssertion(dcterms:description goldbook:15958 "Significant decrease in bone mass with increased porosity and increased tendency to fracture.")
AnnotationAssertion(mito:isMentionedBy goldbook:15958 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15958 "current"^^xsd:string)
Declaration(Class(goldbook:15959))
AnnotationAssertion(rdfs:label goldbook:15959 "ovicide")
AnnotationAssertion(dcterms:description goldbook:15959 "Substance intended to kill eggs.")
AnnotationAssertion(mito:isMentionedBy goldbook:15959 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15959 "current"^^xsd:string)
Declaration(Class(goldbook:15960))
AnnotationAssertion(rdfs:label goldbook:15960 "para-occupational exposure")
AnnotationAssertion(dcterms:description goldbook:15960 "Exposure of a worker’s family to substances carried from the workplace to the home. Exposure of visitors to substances in the workplace.")
AnnotationAssertion(mito:isMentionedBy goldbook:15960 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15960 "current"^^xsd:string)
Declaration(Class(goldbook:15961))
AnnotationAssertion(rdfs:label goldbook:15961 "parasympathetic")
AnnotationAssertion(dcterms:description goldbook:15961 "Of, relating to, or affecting the parasympathetic nervous system which stimulates digestive secretions, slows the heart, constricts the pupils of the eyes, and dilates blood vessels.")
AnnotationAssertion(mito:isMentionedBy goldbook:15961 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15961 "current"^^xsd:string)
Declaration(Class(goldbook:15962))
AnnotationAssertion(rdfs:label goldbook:15962 "parasympatholytic")
AnnotationAssertion(dcterms:description goldbook:15962 "Producing effects resembling those caused by interruption of the parasympathetic nerve; also called anticholinergic.")
AnnotationAssertion(mito:isMentionedBy goldbook:15962 doi:10.1351/pac200779071153)
