Declaration(Class(goldbook:F02346))
AnnotationAssertion(rdfs:label goldbook:F02346 "ferroelastic transition")
AnnotationAssertion(dcterms:description goldbook:F02346 "A transition in which a crystal switches from one stable orientation state into another that is equally stable by the application of a mechanical stress along an appropriate direction.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02346 goldbook:F02348)
AnnotationAssertion(rdfs:seeAlso goldbook:F02346 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:F02346 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02346 "current"^^xsd:string)
Declaration(Class(goldbook:F02347))
AnnotationAssertion(rdfs:label goldbook:F02347 "ferroelectric transition")
AnnotationAssertion(dcterms:description goldbook:F02347 "A transition from a ferroelectric to either another ferroelectric, or a paraelectric, or an antiferroelectric state.")
AnnotationAssertion(rdfs:comment goldbook:F02347 "In an antiferroelectric transition individual dipoles become arranged antiparallel to adjacent dipoles with the result that the net spontaneous polarization is zero."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:F02347 "Ferroelectric/antiferroelectric transitions also occur in the liquid-crystal state. These states are dependent on the alternating nature of dipoles between layers in the smectic state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:F02347 goldbook:F02348)
AnnotationAssertion(rdfs:seeAlso goldbook:F02347 goldbook:LT06854)
AnnotationAssertion(rdfs:seeAlso goldbook:F02347 goldbook:P04712)
AnnotationAssertion(rdfs:seeAlso goldbook:F02347 goldbook:S05714)
AnnotationAssertion(mito:isMentionedBy goldbook:F02347 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02347 "current"^^xsd:string)
Declaration(Class(goldbook:F02348))
AnnotationAssertion(rdfs:label goldbook:F02348 "ferroic transition")
AnnotationAssertion(dcterms:description goldbook:F02348 "A general term for ferroelastic, ferroelectric, antiferroelectric, ferromagnetic, antiferromagnetic and ferrimagnetic transitions in which a suitable driving force switches a ferroic crystal from one orientation state, or domain state, to another.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02348 goldbook:F02346)
AnnotationAssertion(rdfs:seeAlso goldbook:F02348 goldbook:F02347)
AnnotationAssertion(mito:isMentionedBy goldbook:F02348 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02348 "current"^^xsd:string)
