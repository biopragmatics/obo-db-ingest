[Term]
id: goldbook:10148
name: Ward’s minimum variance method
def: "Linkage criterion in hierarchical clustering in which the within-cluster variance is minimized."
comment: "The initial cluster distances in Ward’s minimum variance method are the squared Euclidean distance."
synonym: "Ward’s method" []
property_value: mito:isMentionedBy doi:10.1515/pac-2015-0605
property_value: hasStatus "current" xsd:string
