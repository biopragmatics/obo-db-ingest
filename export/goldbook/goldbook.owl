        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11285"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10646 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10646">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process whereby the development of one group of cells, called the competent region, is altered by an inducing factor from another group, called a signaling center or organizer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>embryonic induction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10647 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10647">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of implanting a fertilized ovum into a uterus.</dcterms:description>
