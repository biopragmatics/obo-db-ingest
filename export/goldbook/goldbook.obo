property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09577
name: surface roughness
def: "Measure of the texture of a surface that is quantified by vertical deviations from its ideal location."
property_value: mito:isMentionedBy doi:10.1515/pac-2018-1215
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09578
name: swing curve
def: "Sinusoidal variation in the lithographic clearance dose arising from changes in the phase difference between incoming and outgoing radiation that is induced by variations in resist thickness."
