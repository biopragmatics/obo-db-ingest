[Term]
id: goldbook:08380
name: net dephasing time
def: "Measured time constant associated with spin-spin relaxation for loss of magnetization in the \\\(xy\\\) plane."
comment: "\(T_{2}^{*}\) includes losses due to \(\boldsymbol{B_{0}}\) inhomogeneity as well as spin-spin relaxation and is always less than or equal to the spin-lattice relaxation time (\(T_{2}\))."
synonym: "T2-star" []
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
