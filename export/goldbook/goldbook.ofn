AnnotationAssertion(dcterms:description goldbook:12918 "Of or relating to an immune response by the body against one of its own cells or tissues.")
AnnotationAssertion(mito:isMentionedBy goldbook:12918 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12918 "current"^^xsd:string)
