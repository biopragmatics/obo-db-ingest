AnnotationAssertion(dcterms:description goldbook:10954 "Attachment of a methyl group to a molecule.")
Declaration(Class(goldbook:10955))
AnnotationAssertion(rdfs:label goldbook:10955 "microcephaly")
AnnotationAssertion(dcterms:description goldbook:10955 "Congenital occurrence of an abnormally small head.")
Declaration(Class(goldbook:10956))
AnnotationAssertion(rdfs:label goldbook:10956 "microcheiria")
AnnotationAssertion(dcterms:description goldbook:10956 "Congenital occurrence of abnormally small hands.")
Declaration(Class(goldbook:10957))
AnnotationAssertion(rdfs:label goldbook:10957 "microglossia")
AnnotationAssertion(dcterms:description goldbook:10957 "Congenital occurrence of an abnormally small tongue.")
Declaration(Class(goldbook:10958))
AnnotationAssertion(rdfs:label goldbook:10958 "micrognathia")
AnnotationAssertion(dcterms:description goldbook:10958 "Congenital occurrence of abnormally small jaws, especially effecting the mandible.")
Declaration(Class(goldbook:10959))
AnnotationAssertion(rdfs:label goldbook:10959 "micromass culture")
AnnotationAssertion(dcterms:description goldbook:10959 "Laboratory technique in which dispersed cells from an embryonic organ or tissue, such as the brain, limb bud, or cartilage, are allowed to reaggregate in culture.")
Declaration(Class(goldbook:10960))
AnnotationAssertion(rdfs:label goldbook:10960 "micronucleus test")
AnnotationAssertion(dcterms:description goldbook:10960 """Test for mutagenicity in which animals are treated with a test agent, after which time the frequency of micronucleated cells is determined.
Note: If a test group shows significantly increased levels of micronucleated cells compared to a control group, the chemical is considered capable of inducing chromosomal damage.
Procedure to detect clastogenic or aneugenic agents by microscopic examination of chromosomes.
Note: The test can be performed in vivo in rodents, or in cell culture (in vitro mammalian cell micronucleus test).""")
Declaration(Class(goldbook:10961))
AnnotationAssertion(rdfs:label goldbook:10961 "microphallus")
AnnotationAssertion(dcterms:description goldbook:10961 "Abnormally small penis.")
Declaration(Class(goldbook:10962))
