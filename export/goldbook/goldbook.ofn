AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14215 "unit twist")
Declaration(Class(goldbook:14216))
AnnotationAssertion(rdfs:label goldbook:14216 "translational chain repeating unit")
AnnotationAssertion(dcterms:description goldbook:14216 "Smallest structural unit of a polymer chain that is repeated by translation in the crystal lattice along the chain axis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14216 "fiber repeat unit")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14216 "physical repeating unit")
Declaration(Class(goldbook:14217))
AnnotationAssertion(rdfs:label goldbook:14217 "anticlined stems")
AnnotationAssertion(dcterms:description goldbook:14217 "Stems in a crystal having opposite side-group orientations with respect to the chain axis (see (a) in figure).(a) Pairs of anticlined stems and (b) pairs of isoclined stems of regioregular poly(3-butylthiophene), i.e., poly(3-n-butylthiophene-2,5-diyl). Since regioregular poly(3-n-butylthiophene-2,5-diyl) is also a directional chain, (a) is an example of antidirectional packing of two chains, while (b) is an example of isodirectional packing.")
Declaration(Class(goldbook:14218))
AnnotationAssertion(rdfs:label goldbook:14218 "antidirectional packing")
AnnotationAssertion(dcterms:description goldbook:14218 "In a parallel-chain crystal, the crystalline packing of directional stems with opposite chain axis orientations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14218 "antiparallel packing")
Declaration(Class(goldbook:14219))
AnnotationAssertion(rdfs:label goldbook:14219 "crystal polymorph")
AnnotationAssertion(dcterms:description goldbook:14219 "One of the different crystalline phases in which a given substance is able to crystallize.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14219 "crystal modification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14219 "crystalline form")
Declaration(Class(goldbook:14220))
AnnotationAssertion(rdfs:label goldbook:14220 "frustration")
AnnotationAssertion(dcterms:description goldbook:14220 "Feature of crystalline packing characterized by different crystalline arrangements of chain stems at two (or more) sites that would be expected to be equivalent.")
Declaration(Class(goldbook:14221))
AnnotationAssertion(rdfs:label goldbook:14221 "isochiral stem packing")
AnnotationAssertion(dcterms:description goldbook:14221 "Crystalline packing of stems having the same helicity.")
Declaration(Class(goldbook:14222))
AnnotationAssertion(rdfs:label goldbook:14222 "isoclined stems")
AnnotationAssertion(dcterms:description goldbook:14222 "Stems in a crystal having the same side-group orientation with respect to the chain axis (see figure (b) in anticlined stems).")
Declaration(Class(goldbook:14223))
AnnotationAssertion(rdfs:label goldbook:14223 "isodirectional packing")
AnnotationAssertion(dcterms:description goldbook:14223 "In a parallel-chain crystal, the crystalline packing of directional stems with the same chain axis orientation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14223 "parallel packing")
Declaration(Class(goldbook:14224))
AnnotationAssertion(rdfs:label goldbook:14224 "packing of chain stems")
AnnotationAssertion(dcterms:description goldbook:14224 "Spatial arrangement of polymer chain stems in a polymer crystal.")
Declaration(Class(goldbook:14225))
AnnotationAssertion(rdfs:label goldbook:14225 "polymorphic polymer crystal")
AnnotationAssertion(dcterms:description goldbook:14225 "Polymer crystal formed by domains of different crystal polymorphs of the same polymer.")
Declaration(Class(goldbook:14226))
AnnotationAssertion(rdfs:label goldbook:14226 "racemic packing")
AnnotationAssertion(dcterms:description goldbook:14226 "Packing in a polymer crystal in which stems of opposite helicity coexist in equal numbers.")
Declaration(Class(goldbook:14227))
AnnotationAssertion(rdfs:label goldbook:14227 "symmetry breaking")
AnnotationAssertion(dcterms:description goldbook:14227 "Vanishing, in a specific crystal polymorph, of selected symmetry elements present in other crystal polymorphs, or in selected minimum energy conformations of isolated molecules of a given substance.")
Declaration(Class(goldbook:14228))
AnnotationAssertion(rdfs:label goldbook:14228 "orientational disorder")
AnnotationAssertion(dcterms:description goldbook:14228 "Structural disorder at given crystallographic positions, resulting from the statistical coexistence within crystals of directional stems with opposite orientations.")
Declaration(Class(goldbook:14229))
AnnotationAssertion(rdfs:label goldbook:14229 "paracrystal")
AnnotationAssertion(dcterms:description goldbook:14229 "Crystal model characterized by lattice distortions and hence by limited order along given lattice directions.")
Declaration(Class(goldbook:14230))
AnnotationAssertion(rdfs:label goldbook:14230 "paracrystalline disorder of the first kind")
AnnotationAssertion(dcterms:description goldbook:14230 "Structural disorder in a paracrystal, resulting from uncorrelated displacements of the atoms around their average positions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14230 "uncorrelated paracrystalline disorder")
Declaration(Class(goldbook:14231))
AnnotationAssertion(rdfs:label goldbook:14231 "paracrystalline disorder of the second kind")
AnnotationAssertion(dcterms:description goldbook:14231 "Structural disorder in a paracrystal, resulting from permanent atomic displacements from the ordered crystallographic positions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14231 "correlated paracrystalline disorder")
Declaration(Class(goldbook:14232))
AnnotationAssertion(rdfs:label goldbook:14232 "paracrystalline distortion factor")
AnnotationAssertion(dcterms:description goldbook:14232 "Ratio of the statistical fluctuation \\(\\Delta a_{ik}\\) of a lattice vector \\(a_{i}\\) along the direction \\(a_{k}\\) \\[g_{ik} = \\frac{\\Delta a_{ik}}{a_{k}}\\]")
Declaration(Class(goldbook:14233))
AnnotationAssertion(rdfs:label goldbook:14233 "crystalline polymer-inclusion complex")
AnnotationAssertion(dcterms:description goldbook:14233 "Crystal comprising a polymer guest within a low-molar-mass host.")
Declaration(Class(goldbook:14234))
AnnotationAssertion(rdfs:label goldbook:14234 "crystalline-polymer molecular complex")
AnnotationAssertion(dcterms:description goldbook:14234 "Crystalline molecular complex between different polymers.")
Declaration(Class(goldbook:14235))
AnnotationAssertion(rdfs:label goldbook:14235 "isomorphous polymer co-crystal")
AnnotationAssertion(dcterms:description goldbook:14235 "Crystal consisting of two or more structurally different polymers, resulting in macromolecular isomorphism.")
Declaration(Class(goldbook:14236))
AnnotationAssertion(rdfs:label goldbook:14236 "copolymer isomorphism")
