AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11809 "2-(1H-imidazol-4-yl)ethanamine")
AnnotationAssertion(rdfs:comment goldbook:11809 "Histamine acts as a neurotransmitter in the brain. It also serves as a mediator in the regulation of various body functions such as gastric secretion, bronchial constriction, vasorelaxation, and local inflammation."^^xsd:string)
