AnnotationAssertion(dcterms:description goldbook:10778 "Mature ovarian follicle within which an oocyte attains full size and which ruptures during ovulation to release the ovum.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10778 "vesicular ovarian follicle")
Declaration(Class(goldbook:10779))
AnnotationAssertion(rdfs:label goldbook:10779 "granulocyte")
AnnotationAssertion(dcterms:description goldbook:10779 "White blood cell, distinct from a lymphocyte, containing cytoplasmic granules.")
Declaration(Class(goldbook:10780))
AnnotationAssertion(rdfs:label goldbook:10780 "granulosa")
AnnotationAssertion(dcterms:description goldbook:10780 "Pertaining to cells of the cumulus oophorus.")
Declaration(Class(goldbook:10781))
AnnotationAssertion(rdfs:label goldbook:10781 "grey matter")
AnnotationAssertion(dcterms:description goldbook:10781 "Regions of the brain and spinal cord that are made up primarily of cell bodies and dendrites of nerve cells rather than of myelinated axons.")
Declaration(Class(goldbook:10782))
AnnotationAssertion(rdfs:label goldbook:10782 "growth factor")
AnnotationAssertion(dcterms:description goldbook:10782 "Naturally occurring or genetically engineered protein or steroid hormone that binds to a receptor to regulate cell growth, proliferation, or differentiation.")
Declaration(Class(goldbook:10783))
AnnotationAssertion(rdfs:label goldbook:10783 "growth hormone")
AnnotationAssertion(dcterms:description goldbook:10783 "Peptide hormone secreted by the anterior pituitary that stimulates growth, energy metabolism, and cell proliferation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10783 "somatotropic hormone (STH)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10783 "somatotropin")
Declaration(Class(goldbook:10784))
AnnotationAssertion(rdfs:label goldbook:10784 "growth hormone releasing factor")
AnnotationAssertion(dcterms:description goldbook:10784 "Substance produced in the hypothalamus that regulates release of growth hormone by the anterior pituitary.")
Declaration(Class(goldbook:10785))
AnnotationAssertion(rdfs:label goldbook:10785 "gubernaculum")
