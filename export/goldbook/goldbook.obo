[Term]
id: goldbook:10269
name: in-needle capillary adsorption trap
def: "In-tube format device with a sorbent-coated capillary placed inside a needle."
synonym: "INCAT" RELATED OMO:0003000 []
property_value: mito:isMentionedBy doi:10.1515/pac-2015-0903
property_value: hasStatus "current" xsd:string
