[Term]
id: goldbook:10122
name: dendrogram
def: "Tree diagram used to illustrate the arrangement of clusters produced by hierarchical clustering."
comment: "The objects are successively grouped (or un-grouped) in each layer of the dendrogram, where the length of the linking lines is proportional to the dissimilarity of the objects."
property_value: mito:isMentionedBy doi:10.1515/pac-2015-0605
property_value: hasStatus "current" xsd:string
