AnnotationAssertion(rdfs:label goldbook:11791 "globoside")
AnnotationAssertion(dcterms:description goldbook:11791 "Glycosphingolipid, specifically a ceramide tetrasaccharide (tetraglycosylceramide), isolated from kidney and erythrocytes.")
AnnotationAssertion(rdfs:comment goldbook:11791 "It accumulates in people with Sandhoff disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11791 goldbook:11667)
AnnotationAssertion(mito:isMentionedBy goldbook:11791 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11791 "current"^^xsd:string)
