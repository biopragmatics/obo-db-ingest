AnnotationAssertion(obo:goldbook#hasStatus goldbook:NT07521 "current"^^xsd:string)
Declaration(Class(goldbook:NT07522))
AnnotationAssertion(rdfs:label goldbook:NT07522 "neutralized gel")
AnnotationAssertion(dcterms:description goldbook:NT07522 "Gel containing acidic or basic groups that have been neutralized.")
AnnotationAssertion(rdfs:seeAlso goldbook:NT07522 goldbook:G02600)
AnnotationAssertion(mito:isMentionedBy goldbook:NT07522 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:NT07522 "current"^^xsd:string)
Declaration(Class(goldbook:NT07562))
AnnotationAssertion(rdfs:label goldbook:NT07562 "network")
AnnotationAssertion(dcterms:description goldbook:NT07562 "Highly ramified structure in which essentially each constitutional unit is connected to each other constitutional unit and to the macroscopic phase boundary by many paths through the structure, the number of such paths increasing with the average number of intervening constitutional units; the paths must on average be co-extensive with the structure.")
AnnotationAssertion(rdfs:comment goldbook:NT07562 "Usually, and in all systems that exhibit rubber elasticity, the number of distinct paths is very high, but, in most cases, some constitutional units exist that are connected by a single path only."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:NT07562 "Modified from previous definition. The definition proposed here is a generalization to cover both polymeric networks and networks comprised of particles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:NT07562 goldbook:C01288)
AnnotationAssertion(rdfs:seeAlso goldbook:NT07562 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:NT07562 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:NT07562 "current"^^xsd:string)
Declaration(Class(goldbook:NT07603))
AnnotationAssertion(rdfs:label goldbook:NT07603 "network-chain molar mass")
AnnotationAssertion(dcterms:description goldbook:NT07603 "Number-average molar mass of polymer chains between two adjacent crosslinks or junction points in a polymer network.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:NT07603 "inter-junction molar mass")
AnnotationAssertion(rdfs:comment goldbook:NT07603 "SI units \\(\\pu{kg mol-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:NT07603 goldbook:P04742)
AnnotationAssertion(mito:isMentionedBy goldbook:NT07603 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:NT07603 "current"^^xsd:string)
Declaration(Class(goldbook:NT07604))
AnnotationAssertion(rdfs:label goldbook:NT07604 "network defect")
AnnotationAssertion(dcterms:description goldbook:NT07604 "Elastically ineffective chains in a polymer network.")
AnnotationAssertion(rdfs:comment goldbook:NT07604 "A network defect is caused by a loose end or a cyclic structure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:NT07604 goldbook:L03625)
AnnotationAssertion(rdfs:seeAlso goldbook:NT07604 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:NT07604 goldbook:P04742)
AnnotationAssertion(mito:isMentionedBy goldbook:NT07604 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:NT07604 "current"^^xsd:string)
Declaration(Class(goldbook:NT07626))
AnnotationAssertion(rdfs:label goldbook:NT07626 "net shaping")
AnnotationAssertion(dcterms:description goldbook:NT07626 "Production of an object in, or as close as possible to, its final shape prior to ceramization.")
AnnotationAssertion(rdfs:seeAlso goldbook:NT07626 goldbook:CT07610)
AnnotationAssertion(mito:isMentionedBy goldbook:NT07626 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:NT07626 "current"^^xsd:string)
Declaration(Class(goldbook:O04270))
AnnotationAssertion(rdfs:label goldbook:O04270 "observation height")
AnnotationAssertion(dcterms:description goldbook:O04270 "The difference in height between the axis of the observed space (optical axis) and the burner tip (in \\(\\mathrm{mm}\\)). The optical axis of the instrument should be the same as the optical axis of the observation space. Other definitions which express the observation height as a fraction of the whole flame height are not recommended because the height to the tip of the flame is not well defined. The observation height should be stated in the method.")
AnnotationAssertion(mito:isMentionedBy goldbook:O04270 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04270 "current"^^xsd:string)
Declaration(Class(goldbook:O04271))
AnnotationAssertion(rdfs:label goldbook:O04271 "observation pathlength")
AnnotationAssertion(dcterms:description goldbook:O04271 "The intersection of the optical axis and the observation space (in \\(\\mathrm{mm}\\)).")
AnnotationAssertion(mito:isMentionedBy goldbook:O04271 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04271 "current"^^xsd:string)
Declaration(Class(goldbook:O04272))
AnnotationAssertion(rdfs:label goldbook:O04272 "observation space")
AnnotationAssertion(dcterms:description goldbook:O04272 "The intersection of the optical beam and that part of the flame where the net signal is at least half of the maximum net signal. The characteristics of the observation space depend on the temperature of the flame, the stoichiometry of the gases and the properties of the processed fluid (presence of proteins for instance). The observation space in atomic absorption is analogous to the observation space of a cuvette in molecular absorption spectrometry.")
AnnotationAssertion(rdfs:seeAlso goldbook:O04272 goldbook:O04273)
AnnotationAssertion(rdfs:seeAlso goldbook:O04272 goldbook:P04898)
AnnotationAssertion(rdfs:seeAlso goldbook:O04272 goldbook:S05848)
AnnotationAssertion(rdfs:seeAlso goldbook:O04272 goldbook:S06026)
AnnotationAssertion(mito:isMentionedBy goldbook:O04272 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04272 "current"^^xsd:string)
Declaration(Class(goldbook:O04273))
AnnotationAssertion(rdfs:label goldbook:O04273 "observation volume")
AnnotationAssertion(dcterms:description goldbook:O04273 "The volume of that part of the flame that is observed through the optical device (in \\(\\unicode[Times]{x3BC}\\rm{l}\\)).")
AnnotationAssertion(rdfs:seeAlso goldbook:O04273 goldbook:O04272)
AnnotationAssertion(mito:isMentionedBy goldbook:O04273 doi:10.1351/pac198658121737)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04273 "current"^^xsd:string)
Declaration(Class(goldbook:O04276))
AnnotationAssertion(rdfs:label goldbook:O04276 "<i>octahedro</i>-")
AnnotationAssertion(dcterms:description goldbook:O04276 "An affix used in names to denote six atoms bound into an octahedron.")
AnnotationAssertion(mito:isMentionedBy goldbook:O04276 doi:10.1515/pac-2014-0718)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04276 "current"^^xsd:string)
Declaration(Class(goldbook:O04277))
AnnotationAssertion(rdfs:label goldbook:O04277 "odd-electron ion")
AnnotationAssertion(dcterms:description goldbook:O04277 "Synonymous with radical ion.")
AnnotationAssertion(rdfs:seeAlso goldbook:O04277 goldbook:R05073)
AnnotationAssertion(mito:isMentionedBy goldbook:O04277 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04277 "current"^^xsd:string)
Declaration(Class(goldbook:O04278))
AnnotationAssertion(rdfs:label goldbook:O04278 "optically detected magnetic resonance")
AnnotationAssertion(dcterms:description goldbook:O04278 "A double resonance technique in which transitions between spin sublevels are detected by optical means. Usually these are sublevels of a triplet and the transitions are induced by microwaves. For different types of optical detection the following expressions are used: ADMR (absorption), DEDMR (delayed emission, non-specified), DFDMR (delayed fluorescence), FDMR (fluorescence), PDMR (phosphorescence). If a reaction yield is followed the expression RYDMR (reaction yield detected magnetic resonance) is used.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:O04278 "ODMR")
AnnotationAssertion(rdfs:seeAlso goldbook:O04278 goldbook:D01579)
AnnotationAssertion(rdfs:seeAlso goldbook:O04278 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:O04278 goldbook:P04569)
AnnotationAssertion(rdfs:seeAlso goldbook:O04278 goldbook:R05326)
AnnotationAssertion(mito:isMentionedBy goldbook:O04278 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04278 "current"^^xsd:string)
Declaration(Class(goldbook:O04279))
AnnotationAssertion(rdfs:label goldbook:O04279 "odour threshold")
AnnotationAssertion(dcterms:description goldbook:O04279 "The concentration of a compound which produces an odour which is detectable by a human being (nose). For certain compounds this threshold is very low (e.g. 1 part in \\(10^{9}\\) for certain sulfides).")
AnnotationAssertion(rdfs:seeAlso goldbook:O04279 goldbook:S06102)
AnnotationAssertion(mito:isMentionedBy goldbook:O04279 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04279 "current"^^xsd:string)
Declaration(Class(goldbook:O04280))
AnnotationAssertion(rdfs:label goldbook:O04280 "ohm")
AnnotationAssertion(dcterms:description goldbook:O04280 "SI derived unit of electrical resistance, \\(\\Omega = \\pu{V A-1} = \\pu{m2 kg s-3 A-2}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:O04280 goldbook:R05315)
AnnotationAssertion(mito:isMentionedBy goldbook:O04280 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04280 "current"^^xsd:string)
Declaration(Class(goldbook:O04281))
AnnotationAssertion(rdfs:label goldbook:O04281 "olefins")
AnnotationAssertion(dcterms:description goldbook:O04281 "Acyclic and cyclic hydrocarbons having one or more carbon–carbon double bonds, apart from the formal ones in aromatic compounds. The class olefins subsumes alkenes and cycloalkenes and the corresponding polyenes.")
AnnotationAssertion(rdfs:seeAlso goldbook:O04281 goldbook:A00224)
AnnotationAssertion(rdfs:seeAlso goldbook:O04281 goldbook:A00441)
