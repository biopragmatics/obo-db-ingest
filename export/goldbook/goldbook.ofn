AnnotationAssertion(mito:isMentionedBy goldbook:OT07577 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:OT07577 "current"^^xsd:string)
Declaration(Class(goldbook:OT07578))
AnnotationAssertion(rdfs:label goldbook:OT07578 "organically-modified ceramic")
AnnotationAssertion(dcterms:description goldbook:OT07578 "Chemically bonded hybrid material which is a crosslinked inorganic–organic polymer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:OT07578 "organomodified ceramic")
AnnotationAssertion(rdfs:comment goldbook:OT07578 "Organically modified ceramics are hybrid polymers with inorganic and organic moieties linked by stable covalent bonds and based on organically modified alkoxysilanes, functionalized organic polymers or both."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:OT07578 "Though it is a commonly used acronym for organically modified ceramic, 'Ormocer' is a registered trademark and as such its terminological use is strongly discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07578 goldbook:CT07540)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07578 goldbook:GT07553)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07578 goldbook:IT07514)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07578 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:OT07578 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:OT07578 "current"^^xsd:string)
Declaration(Class(goldbook:OT07579))
AnnotationAssertion(rdfs:label goldbook:OT07579 "organically modified silica")
AnnotationAssertion(dcterms:description goldbook:OT07579 "Silica modified by organic groups.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:OT07579 "organically modified silicate")
AnnotationAssertion(rdfs:comment goldbook:OT07579 "Organically modified silicas can be obtained by sol-gel processing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:OT07579 "An organically modified silica is of general structure $\\ce{(RO)_{a}Si(B)_{b}(C)_{c}(D)_{d}}$, where ($a + b + c + d) = 4$, $\\ce{R}$ is any alkyl, aryl or heteroaryl group and $\\ce{B}$, $\\ce{C}$ and $\\ce{D}$ are generally organic groups."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:OT07579 "Though it is a commonly used acronym for organically modified silica, 'Ormosil' is a trademark and as such its terminological use is discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07579 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07579 goldbook:S05727)
AnnotationAssertion(mito:isMentionedBy goldbook:OT07579 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:OT07579 "current"^^xsd:string)
Declaration(Class(goldbook:P04385))
AnnotationAssertion(rdfs:label goldbook:P04385 "π – π* state")
AnnotationAssertion(dcterms:description goldbook:P04385 "An excited state related to the ground state by a π → π* transition.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04385 goldbook:E02257)
AnnotationAssertion(rdfs:seeAlso goldbook:P04385 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:P04385 goldbook:P04386)
