    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyamide" .

goldbook:15268 a skos:Concept ;
    skos:altLabel "polyamic acid" ;
    skos:definition "Polyamide containing pendent carboxy groups:   where \\(\\ce{R}\\) is a constitutional unit with a connectivity three or higher." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyamide acid" .

goldbook:15269 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing imino groups as linkages in the backbone: \\[\\ce{-NR\\bond{-}}\\] where \\(\\ce{R}\\) is hydrogen, alkyl, aryl, or heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyamine" .

goldbook:15270 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing carboxylic anhydride groupings as linkages in the backbone: \\[\\ce{-CO-O-CO\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyanhydride" .

