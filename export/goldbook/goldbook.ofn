Declaration(Class(goldbook:11237))
AnnotationAssertion(rdfs:label goldbook:11237 "spermatid")
AnnotationAssertion(dcterms:description goldbook:11237 "Haploid cell in the late stage of developing into a spermatozoon, derived from the secondary spermatocyte.")
