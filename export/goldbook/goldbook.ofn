Declaration(Class(goldbook:C01278))
AnnotationAssertion(rdfs:label goldbook:C01278 "consignment")
AnnotationAssertion(dcterms:description goldbook:C01278 "A quantity of material transferred on one occasion and covered by a single set of shipping documents. It may consist of one or more lots or portions of lots. The presence of different lots in a consignment is important from the point of view of the sampling plan and the interpretation of the results of analysis. The term 'population' is used as the general term for the quantity of parent material being sampled when it is immaterial if the parent body is a consignment, lot, batch, entity, etc.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01278 doi:10.1351/pac199062061193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01278 "current"^^xsd:string)
Declaration(Class(goldbook:C01279))
AnnotationAssertion(rdfs:label goldbook:C01279 "consistency")
AnnotationAssertion(dcterms:description goldbook:C01279 "A general term to describe the property of a material by which it resists permanent change of shape.")
AnnotationAssertion(mito:isMentionedBy goldbook:C01279 doi:10.1351/pac197951051213)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01279 "current"^^xsd:string)
Declaration(Class(goldbook:C01282))
AnnotationAssertion(rdfs:label goldbook:C01282 "constitution")
AnnotationAssertion(dcterms:description goldbook:C01282 "The description of the identity and connectivity (and corresponding bond multiplicities) of the atoms in a molecular entity (omitting any distinction arising from their spatial arrangement).")
AnnotationAssertion(rdfs:seeAlso goldbook:C01282 goldbook:C01274)
AnnotationAssertion(mito:isMentionedBy goldbook:C01282 doi:10.1351/pac199466051077)
