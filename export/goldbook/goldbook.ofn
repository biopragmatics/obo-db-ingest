AnnotationAssertion(obo:goldbook#hasStatus goldbook:12992 "current"^^xsd:string)
Declaration(Class(goldbook:12993))
AnnotationAssertion(rdfs:label goldbook:12993 "cell-mediated cytotoxicity")
AnnotationAssertion(dcterms:description goldbook:12993 "Lysis of a target cell initiated by a T lymphocyte binding to surface antibodies or antigen-bound major histocompatibility complex (MHC) molecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:12993 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12993 goldbook:13434)
AnnotationAssertion(rdfs:seeAlso goldbook:12993 goldbook:13727)
AnnotationAssertion(mito:isMentionedBy goldbook:12993 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12993 "current"^^xsd:string)
Declaration(Class(goldbook:12994))
AnnotationAssertion(rdfs:label goldbook:12994 "cell-mediated immune response")
AnnotationAssertion(dcterms:description goldbook:12994 "Specific immune response in which T lymphocytes mediate the effects, either through the release of cytokines or through cytotoxicity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12994 "cell-mediated response")
AnnotationAssertion(rdfs:seeAlso goldbook:12994 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12994 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:12994 goldbook:13071)
AnnotationAssertion(mito:isMentionedBy goldbook:12994 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12994 "current"^^xsd:string)
Declaration(Class(goldbook:12995))
AnnotationAssertion(rdfs:label goldbook:12995 "cell-mediated immunity")
AnnotationAssertion(dcterms:description goldbook:12995 "Immune response mediated by antigen-specific T lymphocytes, either through the release of cytokines or through cytotoxicity, in contrast with humoral immunity, which is antibody-mediated.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12995 "CMI")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12995 "cellular immunity")
AnnotationAssertion(rdfs:comment goldbook:12995 "Cell-mediated immunity may be expressed as immune regulatory activity (primarily mediated by CD4+ helper T lymphocytes (Th), possibly important in preventing autoimmune diseases) or immune effector activity (mediated largely by CD8+ cytotoxic T cells)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12995 goldbook:12974)
AnnotationAssertion(rdfs:seeAlso goldbook:12995 goldbook:12977)
AnnotationAssertion(rdfs:seeAlso goldbook:12995 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12995 goldbook:12919)
