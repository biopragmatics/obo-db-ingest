consider: goldbook:S05534

[Term]
id: goldbook:S05541
name: sedimentation volume
def: "The volume \\\(V_\{\\mathrm\{sed\}\}\\\) of sediment formed in a suspension. If the sediment is formed in a centrifugal field\, the strength of this field should be explicitly indicated\, otherwise normal gravity is understood."
property_value: mito:isMentionedBy doi:10.1351/pac197231040577
property_value: hasStatus "current" xsd:string
