[Term]
id: goldbook:09799
name: metabolic pathway
def: "All metabolic products of the main compound \(e.g. phase 1 and phase 2 metabolites\) with the routes of metabolism and the excreted metabolites in body fluids\, e.g. in urine or blood."
property_value: mito:isMentionedBy doi:10.1515/pac-2016-1120
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09800
name: metabolism quenching
def: "Physical or chemical methodology used for rapidly breaking all biochemical processes in metabolomic samples."
property_value: mito:isMentionedBy doi:10.1515/pac-2016-1120
property_value: hasStatus "current" xsd:string
