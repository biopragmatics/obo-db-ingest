AnnotationAssertion(obo:goldbook#hasStatus goldbook:10018 "current"^^xsd:string)
Declaration(Class(goldbook:10019))
AnnotationAssertion(rdfs:label goldbook:10019 "examination standard")
AnnotationAssertion(dcterms:description goldbook:10019 "Realization of the definition of a given nominal property (2.1), with stated nominal property value (3.1) and associated examination uncertainty (3.9), used as a reference.")
AnnotationAssertion(rdfs:comment goldbook:10019 "A \"realization of the definition of a given nominal property\" can be provided by an examining system or a nominal reference material."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10019 goldbook:10004)
AnnotationAssertion(rdfs:seeAlso goldbook:10019 goldbook:10000)
AnnotationAssertion(rdfs:seeAlso goldbook:10019 goldbook:09986)
