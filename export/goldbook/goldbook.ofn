AnnotationAssertion(rdfs:comment goldbook:11691 "An example of a CPT is the computer-administered Conners’ test, where, in one version, the test subject is asked to click the spacebar when presented any letter except the letter \"X\" with 360 presentations over a 14-minute period."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11691 "Continuous performance tests are often used in evaluating children with suspected attention deficit hyperactivity disorder."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11691 goldbook:11622)
AnnotationAssertion(mito:isMentionedBy goldbook:11691 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11691 "current"^^xsd:string)
