AnnotationAssertion(dcterms:description goldbook:10694 "Hernia in which bowel or omentum protrudes through the abdominal wall under the skin at the umbilicus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10694 "omphalocele")
Declaration(Class(goldbook:10695))
AnnotationAssertion(rdfs:label goldbook:10695 "exophthalmia")
