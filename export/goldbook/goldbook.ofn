AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04395 "current"^^xsd:string)
Declaration(Class(goldbook:P04396))
AnnotationAssertion(rdfs:label goldbook:P04396 "pair attenuation coefficient")
AnnotationAssertion(dcterms:description goldbook:P04396 "The attenuation coefficient when only the pair production process is taken into account.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04396 goldbook:A00516)
AnnotationAssertion(rdfs:seeAlso goldbook:P04396 goldbook:P04398)
AnnotationAssertion(mito:isMentionedBy goldbook:P04396 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04396 "current"^^xsd:string)
Declaration(Class(goldbook:P04397))
AnnotationAssertion(rdfs:label goldbook:P04397 "pair correlation length")
AnnotationAssertion(dcterms:description goldbook:P04397 "A quantity which approximates to the characteristic length associated with certain number density profiles of diffuse layers. \\(\\xi \\) is defined as the separation between two interacting entities (molecules, macromolecular segments, ions, spins), either in bulk or interfacial regions, beyond which an appropriate function, referred to as pair correlation function, either decays (e.g. to \\(\\frac{1}{e}\\) of an 'initial' value) or vanishes. A characteristic length must be confused neither with the effective thickness of the interfacial layer, nor with the range (effective distance) of the intermolecular (pair) potential. This range is defined by the distance over which this potential and the corresponding correlation function both vanish.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04397 goldbook:C00977)
AnnotationAssertion(rdfs:seeAlso goldbook:P04397 goldbook:I03085)
AnnotationAssertion(rdfs:seeAlso goldbook:P04397 goldbook:I03098)
AnnotationAssertion(rdfs:seeAlso goldbook:P04397 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:P04397 goldbook:N04262)
AnnotationAssertion(mito:isMentionedBy goldbook:P04397 doi:10.1351/pac199466081667)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04397 "current"^^xsd:string)
Declaration(Class(goldbook:P04398))
AnnotationAssertion(rdfs:label goldbook:P04398 "pair production")
AnnotationAssertion(dcterms:description goldbook:P04398 "The simultaneous formation of an electron and a positron as a result of the interaction of a photon of sufficient energy (&gt; \\(1.02\\ \\rm{MeV}\\)) with the field of a particle.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04398 goldbook:E01975)
AnnotationAssertion(rdfs:seeAlso goldbook:P04398 goldbook:N04237)
AnnotationAssertion(rdfs:seeAlso goldbook:P04398 goldbook:P04627)
AnnotationAssertion(rdfs:seeAlso goldbook:P04398 goldbook:P04769)
AnnotationAssertion(mito:isMentionedBy goldbook:P04398 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04398 "current"^^xsd:string)
