property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15820
name: intake
def: "Amount of a substance that is taken into the body\, regardless of whether or not it is absorbed\: The total daily intake is the sum of the daily intake by an individual from food\, drinking-water\, and inhaled air."
