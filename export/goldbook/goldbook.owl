        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of the embryonic neural plate and its rolling up into the neural tube.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>neurulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11002"/>
