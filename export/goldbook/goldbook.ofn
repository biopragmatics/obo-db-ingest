AnnotationAssertion(dcterms:description goldbook:11953 "Process by which a presynaptic cell, upon excitation, releases a specific agent (a neurotransmitter) that crosses the synapse to stimulate or inhibit the postsynaptic cell.")
AnnotationAssertion(rdfs:seeAlso goldbook:11953 goldbook:11955)
AnnotationAssertion(rdfs:seeAlso goldbook:11953 goldbook:12016)
AnnotationAssertion(rdfs:seeAlso goldbook:11953 goldbook:12018)
