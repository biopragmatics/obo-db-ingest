AnnotationAssertion(dcterms:description goldbook:10966 "Neurological disease caused by methylmercury, first seen in subjects ingesting contaminated fish from Minamata Bay in Japan.")
Declaration(Class(goldbook:10967))
AnnotationAssertion(rdfs:label goldbook:10967 "minisatellite")
AnnotationAssertion(dcterms:description goldbook:10967 "Non-coding segment of DNA, found throughout the genome, usually near the ends of chromosomes, that consists of tandem repeats of sequences of about \\(\\pu{10\\!{-}\\! 100}\\) base pairs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10967 "variable number tandem repeat (VNTR)")
Declaration(Class(goldbook:10968))
AnnotationAssertion(rdfs:label goldbook:10968 "miscarriage")
AnnotationAssertion(dcterms:description goldbook:10968 "Lay term for spontaneous abortion.")
Declaration(Class(goldbook:10969))
