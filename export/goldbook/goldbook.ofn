AnnotationAssertion(obo:goldbook#hasStatus goldbook:16029 "current"^^xsd:string)
Declaration(Class(goldbook:16030))
AnnotationAssertion(rdfs:label goldbook:16030 "reference concentration")
AnnotationAssertion(dcterms:description goldbook:16030 "An estimate (with uncertainty spanning perhaps an order of magnitude) of a continuous inhalation exposure to the human population (including sensitive subgroups which include children, asthmatics, and the elderly) that is likely to be without an appreciable risk of deleterious effects during a lifetime.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16030 "RfC")
AnnotationAssertion(rdfs:comment goldbook:16030 "It can be derived from various types of human or animal data such as NOAEL, LOAEL, or benchmark concentration, with uncertainty factors generally applied to reflect limitations of the data used. It is generally used in USEPA’s noncancer health assessments."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16030 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16030 "current"^^xsd:string)
Declaration(Class(goldbook:16031))
AnnotationAssertion(rdfs:label goldbook:16031 "reference distribution")
AnnotationAssertion(dcterms:description goldbook:16031 "Statistical distribution of reference values.")
AnnotationAssertion(mito:isMentionedBy goldbook:16031 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16031 "current"^^xsd:string)
Declaration(Class(goldbook:16032))
AnnotationAssertion(rdfs:label goldbook:16032 "reference individual")
AnnotationAssertion(dcterms:description goldbook:16032 "Person selected with the use of defined criteria for comparative purposes in a clinical study.")
AnnotationAssertion(mito:isMentionedBy goldbook:16032 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16032 "current"^^xsd:string)
Declaration(Class(goldbook:16033))
AnnotationAssertion(rdfs:label goldbook:16033 "reference interval")
AnnotationAssertion(dcterms:description goldbook:16033 "Area between and including two reference limits, for example, the percentiles \\(\\pu{2.5}\\) and \\(\\pu{97.5}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:16033 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16033 "current"^^xsd:string)
