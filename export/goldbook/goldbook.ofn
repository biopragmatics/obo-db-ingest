AnnotationAssertion(mito:isMentionedBy goldbook:C01377 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01377 "current"^^xsd:string)
Declaration(Class(goldbook:C01378))
AnnotationAssertion(rdfs:label goldbook:C01378 "counting loss")
AnnotationAssertion(dcterms:description goldbook:C01378 "A reduction of the counting rate resulting from phenomena such as the resolving time or the dead time.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01378 goldbook:C01379)
AnnotationAssertion(rdfs:seeAlso goldbook:C01378 goldbook:D01529)
AnnotationAssertion(mito:isMentionedBy goldbook:C01378 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01378 "current"^^xsd:string)
Declaration(Class(goldbook:C01379))
AnnotationAssertion(rdfs:label goldbook:C01379 "counting rate")
AnnotationAssertion(dcterms:description goldbook:C01379 "The number of counts occuring in unit time.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01379 goldbook:C01370)
AnnotationAssertion(mito:isMentionedBy goldbook:C01379 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01379 "current"^^xsd:string)
Declaration(Class(goldbook:C01380))
AnnotationAssertion(rdfs:label goldbook:C01380 "coupled reaction")
AnnotationAssertion(dcterms:description goldbook:C01380 "A reaction which follows the (slower) reaction of kinetic interest, so as to provide means of monitoring the formation of a reaction product. This reaction is sometimes referred to as the indicator reaction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01380 "indicator reaction")
AnnotationAssertion(rdfs:seeAlso goldbook:C01380 goldbook:MT06831)
AnnotationAssertion(mito:isMentionedBy goldbook:C01380 doi:10.1351/pac199365102291)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C01380 "current"^^xsd:string)
Declaration(Class(goldbook:C01383))
AnnotationAssertion(rdfs:label goldbook:C01383 "coupling constant")
AnnotationAssertion(dcterms:description goldbook:C01383 "A quantitative measure for nuclear spin-spin, nuclear-electron (hyperfine coupling) and electron-electron (fine coupling in EPR) coupling in magnetic resonance spectroscopy. The 'indirect' or scalar NMR coupling constants are in a first approximation independent of the external magnetic field and are expressed in \\(\\mathrm{Hz}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:C01383 "spin-spin coupling constant")
AnnotationAssertion(rdfs:seeAlso goldbook:C01383 goldbook:C01025)
AnnotationAssertion(rdfs:seeAlso goldbook:C01383 goldbook:HT07052)
AnnotationAssertion(rdfs:seeAlso goldbook:C01383 goldbook:R05326)
