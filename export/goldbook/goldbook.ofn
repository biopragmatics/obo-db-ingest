AnnotationAssertion(mito:isMentionedBy goldbook:O04315 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:O04315 "current"^^xsd:string)
Declaration(Class(goldbook:O04316))
AnnotationAssertion(rdfs:label goldbook:O04316 "optoacoustic spectroscopy")
AnnotationAssertion(dcterms:description goldbook:O04316 "Same as photoacoustic spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:O04316 "Frequently used to denominate the laser-induced production of acoustic waves combined with a piezoelectric detector and distinguish it from the amplitude-modulated excitation combined with a gas-coupled microphone as detector."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:O04316 goldbook:L03459)
AnnotationAssertion(rdfs:seeAlso goldbook:O04316 goldbook:P04576)
AnnotationAssertion(mito:isMentionedBy goldbook:O04316 doi:10.1351/pac200779030293)
