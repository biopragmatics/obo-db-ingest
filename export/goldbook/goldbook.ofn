AnnotationAssertion(obo:goldbook#hasStatus goldbook:L03519 "current"^^xsd:string)
Declaration(Class(goldbook:L03520))
AnnotationAssertion(rdfs:label goldbook:L03520 "ligand to metal charge transfer transition")
AnnotationAssertion(dcterms:description goldbook:L03520 "An electronic transition in a metal complex that corresponds to excitation populating an electronic state in which considerable electron transfer from a ligand to a metal centre has occurred.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:L03520 "LMCT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:L03520 "LMCT transition")
