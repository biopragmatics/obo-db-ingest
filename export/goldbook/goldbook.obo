property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:D01823
name: dividing surface
def: "A surface\, usually taken to be a hyperplane\, constructed at right angles to the minimum-energy path on a potential-energy surface. In conventional transition-state theory it passes through the highest point on the minimum-energy path. In generalized versions of transition-state theory the dividing surface can be at other positions; in variational transition-state theory the position of the dividing surface is varied so as to get a better estimate of the rate constant."
property_value: mito:isMentionedBy doi:10.1351/pac199668010149
property_value: hasStatus "current" xsd:string
consider: goldbook:M03931
consider: goldbook:O04322
consider: goldbook:P04780
consider: goldbook:T06470
consider: goldbook:V06603

[Term]
id: goldbook:D01824
name: DM-interference
def: "Interference in which the analytical signal is influenced by a different mechanism than the analyte e.g. the formation of non-dissociating species in emission spectroscopy."
property_value: mito:isMentionedBy doi:10.1351/pac198855030553
property_value: hasStatus "current" xsd:string
consider: goldbook:I03089
consider: goldbook:S05848

[Term]
id: goldbook:D01826
name: DNA probe
def: "A short sequence of DNA labelled isotopically or chemically that is used for the detection of a complementary nucleotide sequence."
synonym: "DNA" RELATED OMO:0003000 []
