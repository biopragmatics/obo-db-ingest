AnnotationAssertion(obo:goldbook#hasStatus goldbook:13728 "current"^^xsd:string)
Declaration(Class(goldbook:13729))
AnnotationAssertion(rdfs:label goldbook:13729 "tetanus toxoid")
AnnotationAssertion(dcterms:description goldbook:13729 "Detoxified tetanus toxin used to produce active immunity (see active immune response) against tetanus.")
AnnotationAssertion(rdfs:seeAlso goldbook:13729 goldbook:12835)
AnnotationAssertion(mito:isMentionedBy goldbook:13729 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13729 "current"^^xsd:string)
Declaration(Class(goldbook:13730))
AnnotationAssertion(rdfs:label goldbook:13730 "tetramer staining")
AnnotationAssertion(dcterms:description goldbook:13730 "Technique used for selective staining of antigen-specific T lymphocytes in vitro or in situ. The antigen is presented to T cells by peptide tetramer constructs of major histocompatibility (MHC) class I molecules. It is also used to isolate antigen-specific T-cell populations for clonal expansion.")
AnnotationAssertion(rdfs:seeAlso goldbook:13730 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13730 goldbook:13014)
AnnotationAssertion(rdfs:seeAlso goldbook:13730 goldbook:13431)
AnnotationAssertion(rdfs:seeAlso goldbook:13730 goldbook:13546)
AnnotationAssertion(mito:isMentionedBy goldbook:13730 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13730 "current"^^xsd:string)
Declaration(Class(goldbook:13731))
AnnotationAssertion(rdfs:label goldbook:13731 "tertiary lymphoid tissue")
AnnotationAssertion(dcterms:description goldbook:13731 "Ectopic lymphoid aggregates that accumulate during the process of chronic immune stimulation, and exhibit characteristics usually associated with the secondary lymphoid organs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13731 "Tertiary Lymphoid Organ")
AnnotationAssertion(rdfs:seeAlso goldbook:13731 goldbook:13663)
AnnotationAssertion(mito:isMentionedBy goldbook:13731 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13731 "current"^^xsd:string)
Declaration(Class(goldbook:13732))
AnnotationAssertion(rdfs:label goldbook:13732 "thromboxane")
AnnotationAssertion(dcterms:description goldbook:13732 "Any of several substances (predominantly thromboxanes A2 and B2) synthesized by platelets from arachidonic acid precursor, that cause vasoconstriction of vascular and bronchial smooth muscle and facilitates platelet aggregation.")
AnnotationAssertion(rdfs:seeAlso goldbook:13732 goldbook:13580)
AnnotationAssertion(mito:isMentionedBy goldbook:13732 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13732 "current"^^xsd:string)
Declaration(Class(goldbook:13733))
AnnotationAssertion(rdfs:label goldbook:13733 "thrush")
AnnotationAssertion(dcterms:description goldbook:13733 "Oral infection with Candida albicans, often in patients with immunosuppression.")
AnnotationAssertion(mito:isMentionedBy goldbook:13733 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13733 "current"^^xsd:string)
Declaration(Class(goldbook:13734))
AnnotationAssertion(rdfs:label goldbook:13734 "thymic")
AnnotationAssertion(dcterms:description goldbook:13734 "Pertaining to the thymus.")
AnnotationAssertion(mito:isMentionedBy goldbook:13734 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13734 "current"^^xsd:string)
Declaration(Class(goldbook:13735))
AnnotationAssertion(rdfs:label goldbook:13735 "thymic atrophy")
AnnotationAssertion(dcterms:description goldbook:13735 "Involution of the thymus gland leading to a diminished capacity to generate new T cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:13735 goldbook:13724)
AnnotationAssertion(mito:isMentionedBy goldbook:13735 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13735 "current"^^xsd:string)
Declaration(Class(goldbook:13736))
AnnotationAssertion(rdfs:label goldbook:13736 "thymic education")
AnnotationAssertion(dcterms:description goldbook:13736 "Process by which T cells, developing in the thymus, are screened for potentially harmful self-reactive T cells (which are removed), while potentially beneficial T cells are promoted.")
AnnotationAssertion(rdfs:seeAlso goldbook:13736 goldbook:13724)
AnnotationAssertion(mito:isMentionedBy goldbook:13736 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13736 "current"^^xsd:string)
Declaration(Class(goldbook:13737))
AnnotationAssertion(rdfs:label goldbook:13737 "thymoma")
AnnotationAssertion(dcterms:description goldbook:13737 "Rare, usually benign, tumor arising from tissue of the thymus gland.")
AnnotationAssertion(rdfs:comment goldbook:13737 "Thymoma is often associated with myasthenia gravis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13737 goldbook:13481)
AnnotationAssertion(mito:isMentionedBy goldbook:13737 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13737 "current"^^xsd:string)
Declaration(Class(goldbook:13738))
AnnotationAssertion(rdfs:label goldbook:13738 "thymus-dependent antigen")
AnnotationAssertion(dcterms:description goldbook:13738 "Antigen that requires the participation of T lymphocytes to elicit an immune response in B lymphocytes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13738 "TD")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13738 "TD antigen")
AnnotationAssertion(rdfs:seeAlso goldbook:13738 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13738 goldbook:13724)
AnnotationAssertion(mito:isMentionedBy goldbook:13738 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13738 "current"^^xsd:string)
Declaration(Class(goldbook:13739))
AnnotationAssertion(rdfs:label goldbook:13739 "thymus-independent antigen")
AnnotationAssertion(dcterms:description goldbook:13739 "Antigen that does not require the participation of T lymphocytes to elicit an immune response in B cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:13739 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13739 goldbook:13724)
AnnotationAssertion(mito:isMentionedBy goldbook:13739 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13739 "current"^^xsd:string)
Declaration(Class(goldbook:13740))
AnnotationAssertion(rdfs:label goldbook:13740 "thyroglobulin")
AnnotationAssertion(dcterms:description goldbook:13740 "Glycoprotein secreted by thyroid follicular cells that is a major autoantigen in autoimmune diseases of the thyroid.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13740 "TG")
AnnotationAssertion(rdfs:comment goldbook:13740 "Thyroglobulin autoantibodies are found in patients with autoimmune thyroiditis, and Graves disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13740 goldbook:13187)
AnnotationAssertion(rdfs:seeAlso goldbook:13740 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13740 goldbook:12914)
AnnotationAssertion(rdfs:seeAlso goldbook:13740 goldbook:12919)
AnnotationAssertion(rdfs:seeAlso goldbook:13740 goldbook:13741)
AnnotationAssertion(mito:isMentionedBy goldbook:13740 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13740 "current"^^xsd:string)
Declaration(Class(goldbook:13741))
AnnotationAssertion(rdfs:label goldbook:13741 "autoimmune thyroiditis")
AnnotationAssertion(dcterms:description goldbook:13741 "Inflammatory destruction of the thyroid gland (ranging from a mild focal thyroiditis to extensive lymphocytic infiltration and scarring) often associated with goiter and hypothyroidism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13741 "autoimmune thyroiditis")
AnnotationAssertion(rdfs:comment goldbook:13741 "The most common types of autoimmune thyroiditis are Hashimoto thyroiditis and atrophic thyroiditis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13741 goldbook:13195)
AnnotationAssertion(rdfs:seeAlso goldbook:13741 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13741 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13741 "current"^^xsd:string)
Declaration(Class(goldbook:13742))
AnnotationAssertion(rdfs:label goldbook:13742 "thyroid-stimulating hormone receptor")
AnnotationAssertion(dcterms:description goldbook:13742 "Main autoantigenic target in patients with Graves disease.")
