AnnotationAssertion(obo:goldbook#hasStatus goldbook:13089 "current"^^xsd:string)
Declaration(Class(goldbook:13090))
AnnotationAssertion(rdfs:label goldbook:13090 "dermatomyositis")
AnnotationAssertion(dcterms:description goldbook:13090 "Disease characterized by the presence of inflammation of the skin and muscles.")
AnnotationAssertion(rdfs:comment goldbook:13090 "Its cause is unknown, but it may be associated with a viral infection or some autoimmune reaction and may present also as paraneoplastic phenomena (see paraneoplastic autoimmune syndrome)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13090 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13090 goldbook:13535)
AnnotationAssertion(mito:isMentionedBy goldbook:13090 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13090 "current"^^xsd:string)
