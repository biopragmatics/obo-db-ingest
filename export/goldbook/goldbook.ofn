Declaration(Class(goldbook:11775))
AnnotationAssertion(rdfs:label goldbook:11775 "functional domain")
AnnotationAssertion(dcterms:description goldbook:11775 "In the brain, referring to the concept that discrete regions are involved in specific aspects of cognitive function, thus giving rise to modularity.")
AnnotationAssertion(rdfs:comment goldbook:11775 "A competing theory, distributive processing, holds that cognition involves more interaction of brain regions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11775 goldbook:11684)
AnnotationAssertion(mito:isMentionedBy goldbook:11775 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11775 "current"^^xsd:string)
Declaration(Class(goldbook:11776))
AnnotationAssertion(rdfs:label goldbook:11776 "functional observational battery")
AnnotationAssertion(dcterms:description goldbook:11776 "Structured set of tests to examine changes in neuromuscular, arousal, autonomic and sensory functions that assesses the presence, absence or severity of specific neurological signs.")
AnnotationAssertion(rdfs:comment goldbook:11776 "Usually performed in rodents after exposing them to potentially neurotoxic substances."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11776 goldbook:11948)
AnnotationAssertion(mito:isMentionedBy goldbook:11776 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11776 "current"^^xsd:string)
Declaration(Class(goldbook:11777))
AnnotationAssertion(rdfs:label goldbook:11777 "fused in sarcoma transcription factor")
AnnotationAssertion(dcterms:description goldbook:11777 "Nuclear DNA- and RNA-binding protein involved in transcription, splicing, and RNA-transport.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11777 "FUS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11777 "FUS transcription factor")
AnnotationAssertion(rdfs:comment goldbook:11777 "Mutation in the FUS gene is believed to have a role in several neurodegenerative diseases."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11777 goldbook:11926)
AnnotationAssertion(mito:isMentionedBy goldbook:11777 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11777 "current"^^xsd:string)
Declaration(Class(goldbook:11778))
AnnotationAssertion(rdfs:label goldbook:11778 "GABAergic")
AnnotationAssertion(dcterms:description goldbook:11778 "Pertaining to the action of $\\ce{\\upgamma\\!\\mbox{-}aminobutyric acid}$ or to neural or metabolic pathways in which it functions as a neurotransmitter.")
AnnotationAssertion(rdfs:seeAlso goldbook:11778 goldbook:11955)
AnnotationAssertion(rdfs:seeAlso goldbook:11778 goldbook:11575)
AnnotationAssertion(mito:isMentionedBy goldbook:11778 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11778 "current"^^xsd:string)
Declaration(Class(goldbook:11779))
AnnotationAssertion(rdfs:label goldbook:11779 "ganglion")
AnnotationAssertion(dcterms:description goldbook:11779 "Cluster of nerve cell bodies located outside the brain and spinal cord, i.e., in the peripheral nervous system.Note: Ganglia interconnect to form a complex network known as a plexus and serve as relay stations where different neurons can modulate the signals of each other. Compare: basal ganglion. Fibrous cyst usually attached to a tendon sheath.")
AnnotationAssertion(mito:isMentionedBy goldbook:11779 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11779 "current"^^xsd:string)
Declaration(Class(goldbook:11780))
AnnotationAssertion(rdfs:label goldbook:11780 "ganglion cell")
AnnotationAssertion(dcterms:description goldbook:11780 "Neuron located in a ganglion.")
AnnotationAssertion(rdfs:comment goldbook:11780 "Included are cells in the ganglion cell layer of the retina, cells of the sympathetic nervous system in the adrenal medulla, cells in sympathetic and parasympathetic ganglia, and cells in the spiral (cochlear) ganglion involved in hearing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11780 goldbook:11779)
AnnotationAssertion(rdfs:seeAlso goldbook:11780 goldbook:11993)
AnnotationAssertion(rdfs:seeAlso goldbook:11780 goldbook:12107)
AnnotationAssertion(mito:isMentionedBy goldbook:11780 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11780 "current"^^xsd:string)
Declaration(Class(goldbook:11781))
AnnotationAssertion(rdfs:label goldbook:11781 "ganglioside")
AnnotationAssertion(dcterms:description goldbook:11781 "Glycosphingolipid chemically similar to cerebrosides but containing one or more sialic (N-acetylneuraminic or N-glycolylneuraminic) acid residues, found principally in nerve tissue, spleen, and thymus.")
AnnotationAssertion(rdfs:comment goldbook:11781 "Accumulation can be associated with disease. Ganglioside GM1 accumulates in generalized gangliosidosis; GM2 accumulates in Tay–Sachs disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11781 goldbook:11670)
AnnotationAssertion(rdfs:seeAlso goldbook:11781 goldbook:11909)
AnnotationAssertion(mito:isMentionedBy goldbook:11781 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11781 "current"^^xsd:string)
Declaration(Class(goldbook:11782))
AnnotationAssertion(rdfs:label goldbook:11782 "giant axon")
AnnotationAssertion(dcterms:description goldbook:11782 "Very large axon (typically \\(\\pu{0.5 mm}\\) in diameter) that functions in the propulsion system of the squid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11782 "squid giant axon")
AnnotationAssertion(rdfs:comment goldbook:11782 "The large size of the axon has facilitated studies on the mechanism of the action potential."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11782 goldbook:11562)
AnnotationAssertion(rdfs:seeAlso goldbook:11782 goldbook:11627)
AnnotationAssertion(mito:isMentionedBy goldbook:11782 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11782 "current"^^xsd:string)
