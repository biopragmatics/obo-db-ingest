Declaration(Class(goldbook:D01521))
AnnotationAssertion(rdfs:label goldbook:D01521 "data reduction")
AnnotationAssertion(dcterms:description goldbook:D01521 "The process of transforming the initial representation of a spectrometer output into a form which is amenable to interpretation; for example, a bar graph or a table of ion currents.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01521 goldbook:B00596)
AnnotationAssertion(rdfs:seeAlso goldbook:D01521 goldbook:S05837)
AnnotationAssertion(mito:isMentionedBy goldbook:D01521 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01521 "current"^^xsd:string)
Declaration(Class(goldbook:D01523))
AnnotationAssertion(rdfs:label goldbook:D01523 "dative bond")
AnnotationAssertion(dcterms:description goldbook:D01523 "The coordination bond formed upon interaction between molecular species, one of which serves as a donor and the other as an acceptor of the electron pair to be shared in the complex formed, e.g, the $\\ce{N\\!\\rightarrow\\!B}$ bond in $\\ce{H3N\\!\\rightarrow\\!BH3}$. In spite of the analogy of dative bonds with covalent bonds, in that both types imply sharing a common electron pair between two vicinal atoms, the former are distinguished by their significant polarity, lesser strength, and greater length. The distinctive feature of dative bonds is that their minimum-energy rupture in the gas phase or in inert solvent follows the heterolytic bond cleavage path.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01523 goldbook:C01329)
AnnotationAssertion(rdfs:seeAlso goldbook:D01523 goldbook:I03026)
AnnotationAssertion(rdfs:seeAlso goldbook:D01523 goldbook:P04710)
AnnotationAssertion(mito:isMentionedBy goldbook:D01523 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01523 "current"^^xsd:string)
Declaration(Class(goldbook:D01524))
AnnotationAssertion(rdfs:label goldbook:D01524 "daughter ion")
AnnotationAssertion(dcterms:description goldbook:D01524 "An electrically charged product of reaction of a particular parent ion. In general such ions have a direct relationship to a particular precursor ion and indeed may relate to a unique state of the precursor ion. The reaction need not necessarily involve fragmentation. It could, for example, involve a change in the number of charges carried. Thus, all fragment ions are daughter ions, but not all daughter ions are necessarily fragment ions.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01524 goldbook:F02506)
AnnotationAssertion(mito:isMentionedBy goldbook:D01524 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01524 "current"^^xsd:string)
Declaration(Class(goldbook:D01525))
AnnotationAssertion(rdfs:label goldbook:D01525 "daughter product")
AnnotationAssertion(dcterms:description goldbook:D01525 "Any nuclide which follows a specified radionuclide in a decay chain.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01525 goldbook:D01537)
AnnotationAssertion(rdfs:seeAlso goldbook:D01525 goldbook:N04257)
AnnotationAssertion(rdfs:seeAlso goldbook:D01525 goldbook:R05116)
AnnotationAssertion(mito:isMentionedBy goldbook:D01525 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01525 "current"^^xsd:string)
Declaration(Class(goldbook:D01526))
AnnotationAssertion(rdfs:label goldbook:D01526 "Davydov splitting")
AnnotationAssertion(dcterms:description goldbook:D01526 "The splitting of bands in the electronic or vibrational spectra of crystals due to the presence of more than one (interacting) equivalent molecular entity in the unit cell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01526 "factor-group splitting")
AnnotationAssertion(rdfs:seeAlso goldbook:D01526 goldbook:U06562)
AnnotationAssertion(mito:isMentionedBy goldbook:D01526 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01526 "current"^^xsd:string)
Declaration(Class(goldbook:D01527))
AnnotationAssertion(rdfs:label goldbook:D01527 "day")
AnnotationAssertion(dcterms:description goldbook:D01527 "Non-SI unit of time, \\(\\rm{d}=86\\ 400\\ \\rm{s}\\). The day is not exactly defined in terms of the second since so-called leap seconds are added or subtracted from the day semiannually in order to keep the annual average occurrence of midnight at 24:00 on the clock.")
AnnotationAssertion(mito:isMentionedBy goldbook:D01527 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01527 "current"^^xsd:string)
Declaration(Class(goldbook:D01528))
AnnotationAssertion(rdfs:label goldbook:D01528 "deactivation")
AnnotationAssertion(dcterms:description goldbook:D01528 "Any loss of energy by an excited molecular entity.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01528 goldbook:E02056)
AnnotationAssertion(rdfs:seeAlso goldbook:D01528 goldbook:E02116)
AnnotationAssertion(rdfs:seeAlso goldbook:D01528 goldbook:I03102)
AnnotationAssertion(rdfs:seeAlso goldbook:D01528 goldbook:R05056)
AnnotationAssertion(rdfs:seeAlso goldbook:D01528 goldbook:R05057)
AnnotationAssertion(rdfs:seeAlso goldbook:D01528 goldbook:R05065)
AnnotationAssertion(mito:isMentionedBy goldbook:D01528 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01528 "current"^^xsd:string)
Declaration(Class(goldbook:D01529))
AnnotationAssertion(rdfs:label goldbook:D01529 "dead time")
AnnotationAssertion(dcterms:description goldbook:D01529 "Of a radiation counter, the constant and known value imposed on the resolving time, usually in order to make the correction for resolving time losses more accurate.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01529 goldbook:R05053)
AnnotationAssertion(mito:isMentionedBy goldbook:D01529 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01529 "current"^^xsd:string)
Declaration(Class(goldbook:D01530))
AnnotationAssertion(rdfs:label goldbook:D01530 "dead time")
AnnotationAssertion(dcterms:description goldbook:D01530 "The time which elapses between the moment at which a sudden change in concentration (or a new sample) is introduced and the moment at which the detector response indication reaches the measurement threshold of the analyser, a value conventionally fixed at 10% of the final change in indication.")
AnnotationAssertion(mito:isMentionedBy goldbook:D01530 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01530 "current"^^xsd:string)
Declaration(Class(goldbook:D01531))
AnnotationAssertion(rdfs:label goldbook:D01531 "dead time correction")
AnnotationAssertion(dcterms:description goldbook:D01531 "Correction to be applied to the observed number of pulses in order to take into account the number of pulses lost during the resolving or dead time.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01531 goldbook:D01529)
AnnotationAssertion(mito:isMentionedBy goldbook:D01531 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01531 "current"^^xsd:string)
Declaration(Class(goldbook:D01532))
AnnotationAssertion(rdfs:label goldbook:D01532 "dead-volume")
AnnotationAssertion(dcterms:description goldbook:D01532 "This term is used to express the extra-column volume. Strictly speaking, the term 'dead-volume' refers to volumes within the chromatographic system which are not swept by the mobile phase. On the other hand, mobile phase is flowing through most of the extra-column volumes. Due to this ambiguity the use of term 'dead-volume' is discouraged.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01532 goldbook:E02295)
AnnotationAssertion(mito:isMentionedBy goldbook:D01532 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01532 "current"^^xsd:string)
Declaration(Class(goldbook:D01534))
AnnotationAssertion(rdfs:label goldbook:D01534 "Debye–Hückel equation")
AnnotationAssertion(dcterms:description goldbook:D01534 "The chemical potential or activity of ions cannot be determined on a purely thermodynamic basis. This is due to the fact that the effects of an ion cannot be separated from the effects of the accompanying counter-ion, or in other terms, the electrochemical potential of the ion cannot be separated into the chemical and the electrical component. Such a separation must necessarily be based on a non-thermodynamic convention. The present convention is based on the assumption that the molal activity coefficient of the chloride ion in dilute aqueous solutions (\\(\\pu{I \\lt 0.10 mol kg-1}\\)) can be estimated by means of the Debye–Hückel equation: \\[-\\log_{10}\\gamma_{\\rm{B}}=\\frac{z_{\\rm{B}}^{2}\\ A\\ \\sqrt{I}}{1 + \\mathring{a}\\ B\\ \\sqrt{I}}\\] where \\(I\\) is ionic strength, \\(z\\) is the charge number of the ion, \\(\\mathring{a}\\) is ion size parameter and \\(A\\) and \\(B\\) are temperature-dependent constants. According to the Bates–Guggenheim convention \\(\\mathring{a}\\ B\\) is taken to be \\(1.5 \\sqrt{\\pu{mol kg-1}}\\) at all temperatures and for all compositions of the solutions.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:D01533)
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:C00993)
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:C01032)
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:C01124)
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:E01945)
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:I03180)
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:M03969)
AnnotationAssertion(rdfs:seeAlso goldbook:D01534 goldbook:P04524)
AnnotationAssertion(mito:isMentionedBy goldbook:D01534 doi:10.1351/pac198456050567)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01534 "current"^^xsd:string)
Declaration(Class(goldbook:D01536))
AnnotationAssertion(rdfs:label goldbook:D01536 "decadic absorbance")
AnnotationAssertion(dcterms:description goldbook:D01536 "The negative decadic logarithm of one minus absorptance as measured on a uniform sample: \\[A=- \\log _{10}(1- \\alpha )\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:D01536 goldbook:A00035)
AnnotationAssertion(mito:isMentionedBy goldbook:D01536 doi:10.1351/pac198557010105)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01536 "current"^^xsd:string)
Declaration(Class(goldbook:D01537))
AnnotationAssertion(rdfs:label goldbook:D01537 "decay chain")
AnnotationAssertion(dcterms:description goldbook:D01537 "A series of nuclides in which each member transforms into the next through nuclear decay until a stable nuclide has been formed. Synonymous with radioactive chain and radioactive series.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01537 "radioactive chain")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01537 "radioactive series")
AnnotationAssertion(rdfs:seeAlso goldbook:D01537 goldbook:N04227)
AnnotationAssertion(rdfs:seeAlso goldbook:D01537 goldbook:N04257)
AnnotationAssertion(rdfs:seeAlso goldbook:D01537 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:D01537 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01537 "current"^^xsd:string)
Declaration(Class(goldbook:D01539))
AnnotationAssertion(rdfs:label goldbook:D01539 "decay curve")
AnnotationAssertion(dcterms:description goldbook:D01539 "A graph showing the relative amount of radioactive substance remaining after any time interval.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01539 goldbook:R05077)
AnnotationAssertion(mito:isMentionedBy goldbook:D01539 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01539 "current"^^xsd:string)
Declaration(Class(goldbook:D01541))
AnnotationAssertion(rdfs:label goldbook:D01541 "decay rate")
AnnotationAssertion(dcterms:description goldbook:D01541 "The rate at which a pollutant is removed from the atmosphere either by reaction with reactive transient species such as the $\\ce{HO}$ radical, $\\ce{O3}$, etc., by photodecomposition initiated by light absorption by the impurity, or by loss at the surface of aerosols, the earth, etc. The decay rate as applied to radioactive materials is related to the radioactive half-life (\\(t_{1/2}\\)) of the particular isotopic species A and its concentration \\([A]_{t}\\), at the given time (\\(t\\)): \\[\\rm{Rate}=\\frac{[A]_{t}\\ \\ln 2}{t_{1/2}}\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:D01541 goldbook:R05077)
AnnotationAssertion(mito:isMentionedBy goldbook:D01541 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01541 "current"^^xsd:string)
Declaration(Class(goldbook:D01543))
AnnotationAssertion(rdfs:label goldbook:D01543 "decay scheme")
AnnotationAssertion(dcterms:description goldbook:D01543 "A graphical representation of the energy levels of the members of a decay chain showing the way along which nuclear decay occurs.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01543 goldbook:D01537)
AnnotationAssertion(rdfs:seeAlso goldbook:D01543 goldbook:N04227)
AnnotationAssertion(mito:isMentionedBy goldbook:D01543 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01543 "current"^^xsd:string)
Declaration(Class(goldbook:D01544))
AnnotationAssertion(rdfs:label goldbook:D01544 "decay time")
AnnotationAssertion(dcterms:description goldbook:D01544 "The time on stream during which the rate constant for the catalytic reaction, \\(k\\), falls to a specified fraction of its original value, often 0.5.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01544 "time of deactivation")
AnnotationAssertion(rdfs:seeAlso goldbook:D01544 goldbook:O04322)
AnnotationAssertion(mito:isMentionedBy goldbook:D01544 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01544 "current"^^xsd:string)
Declaration(Class(goldbook:D01547))
AnnotationAssertion(rdfs:label goldbook:D01547 "decomposition")
AnnotationAssertion(dcterms:description goldbook:D01547 "The breakdown of a single phase into two or more phases. The term applies also to other chemical entities such as a normal molecule and a reaction intermediate.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01547 goldbook:R05171)
AnnotationAssertion(mito:isMentionedBy goldbook:D01547 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01547 "current"^^xsd:string)
Declaration(Class(goldbook:D01549))
AnnotationAssertion(rdfs:label goldbook:D01549 "decontamination factor")
AnnotationAssertion(dcterms:description goldbook:D01549 "The ratio of the proportion of contaminant to product before treatment to the proportion after treatment. It is the reciprocal of the enrichment factor.")
AnnotationAssertion(mito:isMentionedBy goldbook:D01549 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01549 "current"^^xsd:string)
Declaration(Class(goldbook:D01553))
AnnotationAssertion(rdfs:label goldbook:D01553 "definitive method")
AnnotationAssertion(dcterms:description goldbook:D01553 "A method of exceptional scientific status which is sufficiently accurate to stand alone in the determination of a given property for the certification of a reference material. Such a method must have a firm theoretical foundation so that systematic error is negligible relative to the intended use. Analyte masses (amounts) or concentrations must be measured directly in terms of the base units of measurements, or indirectly related through sound theoretical equations. Definitive methods, together with certified reference materials, are primary means for transferring accuracy, i.e. establishing traceability.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01553 goldbook:R05230)
AnnotationAssertion(rdfs:seeAlso goldbook:D01553 goldbook:S06235)
AnnotationAssertion(rdfs:seeAlso goldbook:D01553 goldbook:T06420)
AnnotationAssertion(mito:isMentionedBy goldbook:D01553 doi:10.1351/pac199567101699)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01553 "current"^^xsd:string)
Declaration(Class(goldbook:D01555))
AnnotationAssertion(rdfs:label goldbook:D01555 "deflocculation")
AnnotationAssertion(dcterms:description goldbook:D01555 "The reversal of coagulation or flocculation, i.e. the dispersion of aggregates to form a colloidally stable suspension or emulsion.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:D01555 "peptization")
AnnotationAssertion(rdfs:seeAlso goldbook:D01555 goldbook:C01117)
AnnotationAssertion(rdfs:seeAlso goldbook:D01555 goldbook:C01176)
AnnotationAssertion(rdfs:seeAlso goldbook:D01555 goldbook:E02065)
AnnotationAssertion(rdfs:seeAlso goldbook:D01555 goldbook:F02429)
AnnotationAssertion(rdfs:seeAlso goldbook:D01555 goldbook:S06198)
AnnotationAssertion(mito:isMentionedBy goldbook:D01555 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01555 "current"^^xsd:string)
Declaration(Class(goldbook:D01557))
AnnotationAssertion(rdfs:label goldbook:D01557 "degenerate chain branching")
AnnotationAssertion(dcterms:description goldbook:D01557 "Sometimes chain branching is brought about by an intermediate which has a long lifetime compared with an ordinary free radical. If this intermediate can break down in different ways, only one of which leads to branching, there may be a relatively slow increase in the number of radicals, and there is said to be degenerate chain branching.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01557 goldbook:C00948)
AnnotationAssertion(rdfs:seeAlso goldbook:D01557 goldbook:F02519)
AnnotationAssertion(rdfs:seeAlso goldbook:D01557 goldbook:L03515)
AnnotationAssertion(mito:isMentionedBy goldbook:D01557 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:D01557 "current"^^xsd:string)
Declaration(Class(goldbook:D01559))
AnnotationAssertion(rdfs:label goldbook:D01559 "degenerate rearrangement")
AnnotationAssertion(dcterms:description goldbook:D01559 "A molecular rearrangement in which the principal product is indistinguishable (in the absence of isotopic labelling) from the principal reactant. The term includes both 'degenerate intramolecular rearrangements' and reactions that involve intermolecular transfer of atoms or groups ('degenerate intermolecular rearrangements'): both are degenerate isomerizations. The occurrence of degenerate rearrangements may be detectable by isotopic labelling or by dynamic NMR techniques. For example: thesigmatropic rearrangement of hexa-1,5-diene (Cope rearrangement):  Synonymous but less preferable terms are 'automerization', 'permutational isomerism', 'isodynamic transformation', 'topomerization'.")
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:A00528)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:F02463)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:I03098)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:I03294)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:I03295)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:I03345)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:M03997)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:R05194)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:S05660)
AnnotationAssertion(rdfs:seeAlso goldbook:D01559 goldbook:T06396)
