Declaration(Class(goldbook:R05390))
AnnotationAssertion(rdfs:label goldbook:R05390 "Rice–Ramsperger–Kassel theory")
AnnotationAssertion(dcterms:description goldbook:R05390 "A theory of unimolecular gas reactions in which the rate with which the energized reactant molecule breaks down is treated as a function of the energy \\(\\varepsilon\\) that it contains. The theory assumes that the rate is proportional to the number of ways of distributing \\(\\varepsilon\\) among the internal degrees of freedom of the reactant molecule, in such a manner that the critical energy \\(\\varepsilon_{\\rm{c}}\\) is localized in one particular degree of freedom.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:R05390 "RRK")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:R05390 "RRK theory")
AnnotationAssertion(rdfs:seeAlso goldbook:R05390 goldbook:D01572)
AnnotationAssertion(rdfs:seeAlso goldbook:R05390 goldbook:M03989)
AnnotationAssertion(mito:isMentionedBy goldbook:R05390 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05390 "current"^^xsd:string)
Declaration(Class(goldbook:R05391))
AnnotationAssertion(rdfs:label goldbook:R05391 "Rice–Ramsperger–Kassel–Marcus theory")
AnnotationAssertion(dcterms:description goldbook:R05391 "An improved form of Rice–Ramsperger–Kassel (RRK) theory in which account is taken of the way in which the various normal-mode vibrations and rotations contribute to reaction, and allowance is made for the zero-point energies. In this theory the energy \\(\\varepsilon^{\\rm{*}}\\) in an energized molecule is classified as either active, \\(\\varepsilon^{\\rm{*active}}\\), or inactive, \\(\\varepsilon^{\\rm{*inactive}}\\). The rate depends upon \\(\\frac{P(\\varepsilon^{\\rm{*active}})}{N(\\varepsilon^{\\rm{*}})}\\), where \\(N(\\varepsilon^{\\rm{*}})\\) is the density of states having energy between \\(\\varepsilon^{\\rm{*}}\\) and \\(\\varepsilon^{\\rm{*}}+\\rm{d}\\varepsilon^{\\rm{*}}\\), and \\(P(\\varepsilon^{\\rm{*active}})\\) is the sum of the active quantum states of the activated complex. This extension of RRK theory brings it in line with transition-state theory.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:R05391 "RRKM")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:R05391 "RRKM theory")
AnnotationAssertion(rdfs:seeAlso goldbook:R05391 goldbook:R05390)
AnnotationAssertion(rdfs:seeAlso goldbook:R05391 goldbook:A00092)
AnnotationAssertion(rdfs:seeAlso goldbook:R05391 goldbook:M03958)
AnnotationAssertion(rdfs:seeAlso goldbook:R05391 goldbook:T06470)
AnnotationAssertion(mito:isMentionedBy goldbook:R05391 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05391 "current"^^xsd:string)
Declaration(Class(goldbook:R05392))
AnnotationAssertion(rdfs:label goldbook:R05392 "riffling")
AnnotationAssertion(dcterms:description goldbook:R05392 "The separation of a free-flowing sample into (usually) equal parts by means of a mechanical device composed of diverter chutes.")
AnnotationAssertion(mito:isMentionedBy goldbook:R05392 doi:10.1351/pac199062061193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05392 "current"^^xsd:string)
Declaration(Class(goldbook:R05394))
AnnotationAssertion(rdfs:label goldbook:R05394 "Ringelmann chart")
AnnotationAssertion(dcterms:description goldbook:R05394 "A chart which has been used in air pollution evaluation for assigning the degree of blackness of smoke emanating from a source. The observer compares the shades of grey (white to black) with a series of shade diagrams formed by horizontal and vertical black grid lines on a white background. A corresponding number, the Ringelmann number, is then assigned to the describe the best match; numbers range from 0 (white) to 5 (black). This method of pollution evaluation, although relevant to the enforcement of legislation still in force in many countries, is not recommended for use today since more quantitative indicators of the efficiency of the combustion are now available.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05394 goldbook:A00195)
AnnotationAssertion(rdfs:seeAlso goldbook:R05394 goldbook:S05719)
AnnotationAssertion(mito:isMentionedBy goldbook:R05394 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05394 "current"^^xsd:string)
Declaration(Class(goldbook:R05395))
AnnotationAssertion(rdfs:label goldbook:R05395 "ring-opening copolymerization")
AnnotationAssertion(dcterms:description goldbook:R05395 "A copolymerization which is a ring-opening polymerization with respect to at least one monomer.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05395 goldbook:C01336)
AnnotationAssertion(rdfs:seeAlso goldbook:R05395 goldbook:M04017)
AnnotationAssertion(rdfs:seeAlso goldbook:R05395 goldbook:R05396)
AnnotationAssertion(mito:isMentionedBy goldbook:R05395 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05395 "current"^^xsd:string)
Declaration(Class(goldbook:R05396))
AnnotationAssertion(rdfs:label goldbook:R05396 "ring-opening polymerization")
AnnotationAssertion(dcterms:description goldbook:R05396 "A polymerization in which a cyclic monomer yields a monomeric unit which is acyclic or contains fewer cycles than the monomer.")
AnnotationAssertion(rdfs:comment goldbook:R05396 "If the monomer is polycyclic, the opening of a single ring is sufficient to classify the reaction as ring-opening polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:R05396 goldbook:M04017)
AnnotationAssertion(rdfs:seeAlso goldbook:R05396 goldbook:M04018)
AnnotationAssertion(rdfs:seeAlso goldbook:R05396 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:R05396 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05396 "current"^^xsd:string)
Declaration(Class(goldbook:R05397))
AnnotationAssertion(rdfs:label goldbook:R05397 "ring reversal")
AnnotationAssertion(dcterms:description goldbook:R05397 "The interconversion by rotation about single bonds (coupled with angle deformation in the transition state) of cyclic conformers having equivalent ring shapes (e.g. chair → chair) though not necessarily equivalent spatial positions of substituents (e.g. equatorial → axial).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:R05397 "ring inversion")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:R05397 "chair–chair interconversion")
AnnotationAssertion(rdfs:seeAlso goldbook:R05397 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:R05397 goldbook:A00546)
AnnotationAssertion(rdfs:seeAlso goldbook:R05397 goldbook:C00965)
AnnotationAssertion(rdfs:seeAlso goldbook:R05397 goldbook:E02174)
