[Term]
id: goldbook:13006
name: chronic granulomatous disease
def: "Immunodeficiency disease in which multiple granulomas form as a result of defective elimination of bacteria by phagocytes."
comment: "It is caused by deficiency of the NADPH oxidase system of enzymes that generates superoxide involved in bacterial killing."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-11-06-03
property_value: hasStatus "current" xsd:string
