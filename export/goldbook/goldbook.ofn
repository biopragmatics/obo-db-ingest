AnnotationAssertion(dcterms:description goldbook:13808 "Pertaining to assemblies of atoms, molecules, or ions with an overall three-dimensional order of cubic symmetry.")
AnnotationAssertion(mito:isMentionedBy goldbook:13808 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13808 "current"^^xsd:string)
