[Term]
id: goldbook:15221
name: pellet
def: "Very small tablet or pilule. Implantable polymeric matrix. Spherical granule."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-04-10-14
property_value: hasStatus "current" xsd:string
consider: goldbook:15193
consider: goldbook:15207
