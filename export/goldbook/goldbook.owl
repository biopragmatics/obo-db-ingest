    <!-- http://dx.doi.org/10.1351/goldbook.S06129 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.S06129">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tautomeric forms of sultams, having a sulfur–nitrogen double bond as part of a ring.</dcterms:description>
