[Term]
id: goldbook:08107
name: quality control material
def: "Material used for the purposes of quality control and subjected to the same or part of the same measurement procedure as that used for analytical samples."
comment: "Blank materials, analytical samples, reference materials, and certified reference materials can be used as quality control materials."
synonym: "control material" []
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0819
property_value: hasStatus "current" xsd:string
