AnnotationAssertion(mito:isMentionedBy goldbook:A00030 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00030 "current"^^xsd:string)
Declaration(Class(goldbook:A00031))
AnnotationAssertion(rdfs:label goldbook:A00031 "absorbed dose")
