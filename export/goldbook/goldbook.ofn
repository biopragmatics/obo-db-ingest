AnnotationAssertion(dcterms:description goldbook:P04905 "This term has been used synonymously with proton (hydron)-transfer reaction. Because of its misleading similarity to hydrolysis, photolysis, etc., its use is discouraged.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04905 goldbook:A00531)
AnnotationAssertion(rdfs:seeAlso goldbook:P04905 goldbook:H02902)
AnnotationAssertion(rdfs:seeAlso goldbook:P04905 goldbook:H02904)
AnnotationAssertion(rdfs:seeAlso goldbook:P04905 goldbook:P04624)
