[Term]
id: goldbook:P04446
name: passive sampler
def: "A device for preconcentration of trace substances from gaseous media based on molecular diffusion without controlled conveyance of the gas to be investigated \(e.g. work place air\)."
property_value: mito:isMentionedBy doi:10.1351/pac199062112167
property_value: hasStatus "current" xsd:string
