AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00773 "current"^^xsd:string)
Declaration(Class(goldbook:C00774))
AnnotationAssertion(rdfs:label goldbook:C00774 "calcined coke")
AnnotationAssertion(dcterms:description goldbook:C00774 "A petroleum coke or coal-derived pitch coke obtained by heat treatment of green coke to about \\(1600\\ \\rm{K}\\). It will normally have a hydrogen content of less than \\(0.1\\ \\rm{wt.}\\%\\).")
AnnotationAssertion(rdfs:comment goldbook:C00774 "Calcined coke is the main raw material for the manufacture of polygranular carbon and polygranular graphite products (e.g. carbon and graphite electrodes)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:C00774 goldbook:C01118)
