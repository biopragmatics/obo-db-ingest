AnnotationAssertion(rdfs:seeAlso goldbook:12178 goldbook:11752)
AnnotationAssertion(rdfs:seeAlso goldbook:12178 goldbook:12029)
AnnotationAssertion(mito:isMentionedBy goldbook:12178 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12178 "current"^^xsd:string)
Declaration(Class(goldbook:12179))
AnnotationAssertion(rdfs:label goldbook:12179 "Western Pacific amyotrophic lateral sclerosis and parkinsonism–dementia complex")
AnnotationAssertion(dcterms:description goldbook:12179 "Neurodegenerative disease observed in the islands of Guam, Indonesia, Japan and Papua New Guinea, showing combinations of characteristics of amyotrophic lateral sclerosis, atypical parkinsonism with dementia, or dementia alone that may present sequentially during life.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12179 "ALS-PDC")
AnnotationAssertion(rdfs:comment goldbook:12179 "Neurotoxins of the cycad plant, such as β-N-methylamino-L-alanine (L-BMAA) produced by symbiotic cyanobacteria, and methylazoxymethanol (MAM), are suspected causative agents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12179 "Polyproteinopathy, notably tauopathy, is a common causative feature underlying the different clinical manifestations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12179 goldbook:11926)
AnnotationAssertion(rdfs:seeAlso goldbook:12179 goldbook:11952)
AnnotationAssertion(rdfs:seeAlso goldbook:12179 goldbook:11704)
AnnotationAssertion(rdfs:seeAlso goldbook:12179 goldbook:11998)
AnnotationAssertion(rdfs:seeAlso goldbook:12179 goldbook:12121)
AnnotationAssertion(mito:isMentionedBy goldbook:12179 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12179 "current"^^xsd:string)
Declaration(Class(goldbook:12180))
AnnotationAssertion(rdfs:label goldbook:12180 "Wisconsin card sorting test")
AnnotationAssertion(dcterms:description goldbook:12180 "Procedure in which cards, depicting different arrangements, numbers, and colors of symbols, are presented to the test subject, who is asked to make the most appropriate match of a test card without further instructions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12180 "WCST")
AnnotationAssertion(rdfs:comment goldbook:12180 "Performance requires integration of higher level cognitive functions and the procedure is sometimes referred to as a frontal lobe test."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12180 goldbook:11684)
AnnotationAssertion(rdfs:seeAlso goldbook:12180 goldbook:11773)
AnnotationAssertion(mito:isMentionedBy goldbook:12180 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12180 "current"^^xsd:string)
