[Term]
id: goldbook:08621
name: interference record
def: "Record of the signal from the detector of a two-beam interferometer as the optical path difference between the two beams is varied."
comment: "The interference record contains a part that is constant and a part that varies with the path difference."
synonym: "interference function" []
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
