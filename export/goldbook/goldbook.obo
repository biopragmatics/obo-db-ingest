property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:IT06941
name: ideal chromatography
def: "Chromatographic process\, where no peak-broadening effects \(such as diffusion\, slow mass transfer\, etc.\) operate."
comment: "This is a hypothetical case, implying that the plate number is infinite."
property_value: mito:isMentionedBy doi:10.1351/pac199668081591
property_value: hasStatus "current" xsd:string
