Declaration(Class(goldbook:UT07280))
AnnotationAssertion(rdfs:label goldbook:UT07280 "upper critical solution temperature")
AnnotationAssertion(dcterms:description goldbook:UT07280 "Critical temperature above which a mixture is miscible.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:UT07280 "UCST")
AnnotationAssertion(rdfs:comment goldbook:UT07280 "Above the UCST and below the LCST, if it exists, a single phase exists for all compositions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:UT07280 "The UCST depends upon the pressure and molar-mass distributions of the constituent polymer(s)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:UT07280 "For a mixture containing or consisting of polymeric components, these may be different polymers or species of different molar mass of the same polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:UT07280 goldbook:C01402)
AnnotationAssertion(rdfs:seeAlso goldbook:UT07280 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:UT07280 goldbook:M03667)
