Declaration(Class(goldbook:12813))
AnnotationAssertion(rdfs:label goldbook:12813 "time–temperature superposition principle")
AnnotationAssertion(dcterms:description goldbook:12813 "Principle stating that the value of a viscoelastic property measured at a given temperature, after a given length of time or at a given frequency, is equal to the value of the property at a different temperature after a length of time or at a frequency equal to the given length of time or given frequency multiplied by a shift factor, \\(a_{T}\\) , with the value of the shift factor being independent of length of the time or frequency.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12813 "TTS Principle")
Declaration(Class(goldbook:12814))
AnnotationAssertion(rdfs:label goldbook:12814 "torsion pendulum")
AnnotationAssertion(dcterms:description goldbook:12814 "Device consisting of a disc or other body of large moment of inertia mounted on one end of a torsionally flexible elastic rod or wire, the other end of which is fixed.")
Declaration(Class(goldbook:12815))
AnnotationAssertion(rdfs:label goldbook:12815 "torsional pendulum analysis")
AnnotationAssertion(dcterms:description goldbook:12815 "Dynamic mechanical analysis performed using a torsion pendulum.")
Declaration(Class(goldbook:12816))
AnnotationAssertion(rdfs:label goldbook:12816 "Vicat softening temperature")
AnnotationAssertion(dcterms:description goldbook:12816 "Temperature at which a thermoplastic polymer reaches a specific degree of softness as measured by a standard test.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12816 "softening point")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12816 "Vicat hardness")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12816 "Vicat softening point")
Declaration(Class(goldbook:12817))
AnnotationAssertion(rdfs:label goldbook:12817 "viscoelastic spectrum")
AnnotationAssertion(dcterms:description goldbook:12817 "Double logarithmic plot of a viscoelastic property vs. frequency of measurement or interval of time of measurement at constant temperature.")
Declaration(Class(goldbook:12818))
AnnotationAssertion(rdfs:label goldbook:12818 "vitrification")
AnnotationAssertion(dcterms:description goldbook:12818 "Formation of a polymer glass from a polymer melt.")
Declaration(Class(goldbook:12819))
AnnotationAssertion(rdfs:label goldbook:12819 "Vogel–Fulcher–Tammann equation")
AnnotationAssertion(dcterms:description goldbook:12819 "Equation describing the time-dependence of a relaxation time that deviates from an Arrhenius-type temperature dependence. \\[\\tau = \\tau_{0} \\exp\\!\\left({\\frac{B}{T - T_{0}}}\\right)\\] \\(\\tau\\)/\\(\\pu{s}\\) = relaxation time; \\(\\tau_{0}\\)/\\(\\pu{s}\\) = relaxation time at the Kauzmann temperature, \\(B\\)/\\(\\pu{K}\\) = constant; \\(T\\)/\\(\\pu{K}\\) = temperature; \\(T_{0}\\)/\\(\\pu{K}\\) = Kauzmann temperature.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12819 "VFT Equation")
Declaration(Class(goldbook:12820))
AnnotationAssertion(rdfs:label goldbook:12820 "volume thermodilatometry")
AnnotationAssertion(dcterms:description goldbook:12820 "Technique in which the volume of a substance under negligible load is measured as a function of temperature while the substance is heated or cooled in a controlled programme.")
Declaration(Class(goldbook:12821))
AnnotationAssertion(rdfs:label goldbook:12821 "Williams–Landel–Ferry equation")
AnnotationAssertion(dcterms:description goldbook:12821 "Equation describing the temperature dependence of the shift factor, \\(a_{T}\\), for time–temperature superposition \\[\\log_{10}a_{\\rm{T}} = \\frac{-C_{1}(T_{1} - T_{0})}{C_{2} + (T_{1} - T_{0})}\\] \\(C_{1}\\) and \\(C_{2}\\) are empirical constants, \\(T\\) is the temperature of measurement, and \\(T_{0}\\) is the reference temperature.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12821 "WLF Equation")
Declaration(Class(goldbook:12822))
AnnotationAssertion(rdfs:label goldbook:12822 "coordination polymer")
AnnotationAssertion(dcterms:description goldbook:12822 "A coordination compound with repeating coordination entities extending in 1, 2, or 3 dimensions.")
Declaration(Class(goldbook:12823))
AnnotationAssertion(rdfs:label goldbook:12823 "coordination network")
AnnotationAssertion(dcterms:description goldbook:12823 "A coordination compound extending, through repeating coordination entities, in one dimension, but with cross-links between two or more individual chains, loops, or spiro-links, or a coordination compound extending through repeating coordination entities in two or three dimensions.")
Declaration(Class(goldbook:12824))
AnnotationAssertion(rdfs:label goldbook:12824 "metal-organic framework")
AnnotationAssertion(dcterms:description goldbook:12824 "A metal-organic framework, abbreviated to MOF, is a coordination network with organic ligands containing potential voids.")
Declaration(Class(goldbook:12825))
AnnotationAssertion(rdfs:label goldbook:12825 "α:β T-cell receptor")
AnnotationAssertion(dcterms:description goldbook:12825 "T-cell receptor (TCR) consisting of a heterodimer of two different glycoprotein chains, designated \\(\\upalpha\\) and \\(\\upbeta\\), assembled into an \\(\\upalpha{:}\\upbeta\\) heterodimer.")
Declaration(Class(goldbook:12826))
AnnotationAssertion(rdfs:label goldbook:12826 "α:β T cell")
AnnotationAssertion(dcterms:description goldbook:12826 "Lymphocyte whose T-cell receptor (TCR) is a heterodimer of an \\(\\upalpha\\) chain and a \\(\\upbeta\\) chain.")
Declaration(Class(goldbook:12827))
AnnotationAssertion(rdfs:label goldbook:12827 "ABL oncogene")
AnnotationAssertion(dcterms:description goldbook:12827 "Gene resulting from a chromosomal translocation (9;22) that fuses sequences from the BCR (breakpoint cluster region) gene with the ABL gene.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12827 "BCR-ABL")
Declaration(Class(goldbook:12828))
AnnotationAssertion(rdfs:label goldbook:12828 "ABO blood group system")
AnnotationAssertion(dcterms:description goldbook:12828 "System of antigens expressed on erythrocytes and used for typing human blood for transfusion.")
Declaration(Class(goldbook:12829))
AnnotationAssertion(rdfs:label goldbook:12829 "abzyme")
AnnotationAssertion(dcterms:description goldbook:12829 "Antibody or antibody construct with catalytic activity.")
Declaration(Class(goldbook:12830))
AnnotationAssertion(rdfs:label goldbook:12830 "accessory cell")
AnnotationAssertion(dcterms:description goldbook:12830 "Cell that assists in the adaptive immune response but does not directly mediate specific antigen recognition.")
Declaration(Class(goldbook:12831))
AnnotationAssertion(rdfs:label goldbook:12831 "accessory molecule")
AnnotationAssertion(dcterms:description goldbook:12831 "Molecule other than immunoglobulin (Ig), T-cell receptor (TCR), or major histocompatibility complex (MHC) molecule that participates in T lymphocyte recognition and response to antigen.")
Declaration(Class(goldbook:12832))
AnnotationAssertion(rdfs:label goldbook:12832 "acquired immunity")
AnnotationAssertion(dcterms:description goldbook:12832 "State of protection against pathogen-induced injury, with rapid immune elimination of pathogenic invaders owing to previous immunization or vaccination.")
Declaration(Class(goldbook:12833))
AnnotationAssertion(rdfs:label goldbook:12833 "acquired immunodeficiency syndrome")
AnnotationAssertion(dcterms:description goldbook:12833 "Disease caused by infection with the human immunodeficiency virus (HIV), assuming clinical relevance when an infected patient has lost most of his/her CD4+ T cells, so that infections with opportunistic pathogens occur.")
Declaration(Class(goldbook:12834))
AnnotationAssertion(rdfs:label goldbook:12834 "activation-induced cell death")
AnnotationAssertion(dcterms:description goldbook:12834 "Process by which immune responses end in the death of most of the responding lymphocytes, leaving only a small number of resting memory cells.")
Declaration(Class(goldbook:12835))
AnnotationAssertion(rdfs:label goldbook:12835 "active immunization")
AnnotationAssertion(dcterms:description goldbook:12835 "Immunization with antigen, as distinct from the transfer of antibody to an unimmunized individual, which is called passive immunization.")
Declaration(Class(goldbook:12836))
AnnotationAssertion(rdfs:label goldbook:12836 "active systemic anaphylaxis test")
AnnotationAssertion(dcterms:description goldbook:12836 "Test for determining whether a drug can cause anaphylactic reactions in an animal following immunization with the drug.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12836 "ASA test")
Declaration(Class(goldbook:12837))
AnnotationAssertion(rdfs:label goldbook:12837 "acute lymphoblastic leukemia")
AnnotationAssertion(dcterms:description goldbook:12837 "Highly aggressive, undifferentiated form of lymphoid malignancy derived from a progenitor cell that is thought to be able to give rise to both T- and B-cell lineages.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12837 "Acute Lymphocytic Leukemia")
Declaration(Class(goldbook:12838))
AnnotationAssertion(rdfs:label goldbook:12838 "acute myelogenous leukemia")
AnnotationAssertion(dcterms:description goldbook:12838 "Cancer characterized by rapid growth of abnormal granulocytes that accumulate in the bone marrow.")
Declaration(Class(goldbook:12839))
AnnotationAssertion(rdfs:label goldbook:12839 "acute-phase protein")
AnnotationAssertion(dcterms:description goldbook:12839 "Serum protein, mostly produced in the liver, which rapidly changes in concentration (some acute-phase proteins increase, some decrease) during the initiation of an inflammatory response.")
Declaration(Class(goldbook:12840))
AnnotationAssertion(rdfs:label goldbook:12840 "acute-phase response")
AnnotationAssertion(dcterms:description goldbook:12840 "Physiological response stimulated by cytokines including interleukin-1, interleukin-6, interferons, and tumor necrosis factor (TNF), characterized by increased vascular permeability, fever, and increased levels of proteins (thus called acute-phase proteins) such as C-reactive protein (CRP), occurring within a few hours of initiation.")
Declaration(Class(goldbook:12841))
AnnotationAssertion(rdfs:label goldbook:12841 "acute rejection")
AnnotationAssertion(dcterms:description goldbook:12841 "Rejection of a tissue or organ graft from a genetically unrelated donor, typically occurring within 10 to 13 days of transplantation.")
Declaration(Class(goldbook:12842))
AnnotationAssertion(rdfs:label goldbook:12842 "acute respiratory distress syndrome")
AnnotationAssertion(dcterms:description goldbook:12842 "Acute lung failure characterized by alveolar and interstitial edema, perivascular pulmonary edema, and hyaline membrane formation, resulting from a variety of underlying diseases that result in increased pulmonary vascular permeability.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12842 "adult respiratory distress syndrome")
Declaration(Class(goldbook:12843))
AnnotationAssertion(rdfs:label goldbook:12843 "adaptive immune response")
AnnotationAssertion(dcterms:description goldbook:12843 "Immune response based on the principle of clonal recognition, such that upon first exposure to an antigen, primed lymphocytes either differentiate into immune effector cells or form an expanded pool of memory cells that respond to secondary exposure to the same antigen by mounting an amplified and more rapid response.")
Declaration(Class(goldbook:12844))
AnnotationAssertion(rdfs:label goldbook:12844 "adaptive immune system")
AnnotationAssertion(dcterms:description goldbook:12844 "Part of the immune system responsible for the adaptive immune response.")
Declaration(Class(goldbook:12845))
AnnotationAssertion(rdfs:label goldbook:12845 "Addison disease")
AnnotationAssertion(dcterms:description goldbook:12845 "Adrenocortical hypofunction characterized by hypotension, weight loss, anorexia, and weakness. The most common form is idiopathic Addison disease, mediated by autoimmune mechanisms. Autoantibodies specific to the adrenal cortex are specific diagnostic markers of this form.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12845 "Addison autoimmune disease")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12845 "Addison's autoimmune disease")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12845 "Addison's disease")
Declaration(Class(goldbook:12846))
AnnotationAssertion(rdfs:label goldbook:12846 "addressin")
AnnotationAssertion(dcterms:description goldbook:12846 "Extracellular protein of the venular endothelium serving as a ligand to a homing receptor for lymphocytes.")
Declaration(Class(goldbook:12847))
AnnotationAssertion(rdfs:label goldbook:12847 "adenosine deaminase deficiency")
AnnotationAssertion(dcterms:description goldbook:12847 "Lack of the enzyme adenosine deaminase (ADA), which catalyzes the deamination of adenosine and deoxyadenosine to produce inosine and deoxyinosine, respectively. Affected individuals have a form of severe combined immunodeficiency (SCID).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12847 "ADA Deficiency")
Declaration(Class(goldbook:12848))
AnnotationAssertion(rdfs:label goldbook:12848 "adhesion molecule")
AnnotationAssertion(dcterms:description goldbook:12848 "Molecule belonging mainly to the immunoglobulins, integrin superfamily (e.g., LFA-1, ICAM-1) or selectins, expressed on the cell membrane of various cells including those of the immune system. Interaction of adhesion molecules with each other as receptor and corresponding ligand facilitates cooperation (cross-talk) of cells, signal transduction, and information transfer between cells.")
Declaration(Class(goldbook:12849))
AnnotationAssertion(rdfs:label goldbook:12849 "adjuvant arthritis")
AnnotationAssertion(dcterms:description goldbook:12849 "Experimental model of immunopathology with features of rheumatoid arthritis (RA), induced in rats by injection with bacterial products, which may be used to study anti-inflammatory therapies.")
Declaration(Class(goldbook:12850))
AnnotationAssertion(rdfs:label goldbook:12850 "adoptive transfer")
AnnotationAssertion(dcterms:description goldbook:12850 "Transfer, by transplantation of immunocompetent cells, of the capacity to mount an immune response.")
Declaration(Class(goldbook:12851))
AnnotationAssertion(rdfs:label goldbook:12851 "adverse drug reaction")
AnnotationAssertion(dcterms:description goldbook:12851 "Appreciably harmful or unpleasant reaction resulting from an intervention related to the administration of a pharmaceutical product.")
Declaration(Class(goldbook:12852))
AnnotationAssertion(rdfs:label goldbook:12852 "adverse immunostimulation")
AnnotationAssertion(dcterms:description goldbook:12852 "Antigen-non-specific, inappropriate, or unintended activation of a component of the immune system.")
Declaration(Class(goldbook:12853))
AnnotationAssertion(rdfs:label goldbook:12853 "aeroallergen")
AnnotationAssertion(dcterms:description goldbook:12853 "Any airborne particle, such as a pollen grain or spore, that triggers an allergic reaction in sensitive individuals.")
Declaration(Class(goldbook:12854))
AnnotationAssertion(rdfs:label goldbook:12854 "affinity maturation")
AnnotationAssertion(dcterms:description goldbook:12854 "Increase in antibody affinity for an antigen observed as the humoral immune response progresses.")
Declaration(Class(goldbook:12855))
AnnotationAssertion(rdfs:label goldbook:12855 "agranulocytosis")
AnnotationAssertion(dcterms:description goldbook:12855 "Failure of the bone marrow to make sufficient granulocytes, especially neutrophils.")
Declaration(Class(goldbook:12856))
AnnotationAssertion(rdfs:label goldbook:12856 "allelic exclusion")
AnnotationAssertion(dcterms:description goldbook:12856 "Phenomenon whereby, following successful rearrangement of one allele of an antigen receptor gene, rearrangement of the other parental allele is suppressed, thereby ensuring each lymphocyte expresses only a single specificity of antigen receptor.")
Declaration(Class(goldbook:12857))
AnnotationAssertion(rdfs:label goldbook:12857 "allergen")
AnnotationAssertion(dcterms:description goldbook:12857 "Immunostimulant antigenic substance that may or may not cause a clinically significant effect but which is capable of producing an immune reaction, often immediate-type hypersensitivity.")
Declaration(Class(goldbook:12858))
AnnotationAssertion(rdfs:label goldbook:12858 "allergic")
AnnotationAssertion(dcterms:description goldbook:12858 "Immunologically hypersensitive.")
Declaration(Class(goldbook:12859))
AnnotationAssertion(rdfs:label goldbook:12859 "allergy")
AnnotationAssertion(dcterms:description goldbook:12859 "Symptoms or signs occurring in sensitized individuals following exposure to a previously encountered substance (allergen) that would otherwise not cause such symptoms or signs in non-sensitized individuals. The most common forms of allergy are rhinitis, urticaria, asthma, and contact dermatitis.")
Declaration(Class(goldbook:12860))
AnnotationAssertion(rdfs:label goldbook:12860 "alloantibody")
AnnotationAssertion(dcterms:description goldbook:12860 "Antibody produced against an antigen from another member of the same species.")
Declaration(Class(goldbook:12861))
AnnotationAssertion(rdfs:label goldbook:12861 "alloantigen")
AnnotationAssertion(dcterms:description goldbook:12861 "Antigen, present in some but not all individuals of a particular species, that arises from polymorphisms at the major histocompatibility complex (MHC) loci and stimulates intense reactions to allograft tissues from other individuals of the same species that do not produce it.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12861 "isoantigen")
Declaration(Class(goldbook:12862))
AnnotationAssertion(rdfs:label goldbook:12862 "allogeneic")
AnnotationAssertion(dcterms:description goldbook:12862 "Genetically different, referring to individuals of the same species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12862 "allogenic")
Declaration(Class(goldbook:12863))
AnnotationAssertion(rdfs:label goldbook:12863 "allograft")
AnnotationAssertion(dcterms:description goldbook:12863 "Tissue or organ graft between allogeneic individuals.")
Declaration(Class(goldbook:12864))
AnnotationAssertion(rdfs:label goldbook:12864 "allotype")
AnnotationAssertion(dcterms:description goldbook:12864 "Allelic variant of an antigen that, because it is not present in all individuals, may be immunogenic in members of the same species that have a different version of the allele.")
Declaration(Class(goldbook:12865))
AnnotationAssertion(rdfs:label goldbook:12865 "alloreactivity")
AnnotationAssertion(dcterms:description goldbook:12865 "Reactivity of an antibody with an alloantigen.")
Declaration(Class(goldbook:12866))
AnnotationAssertion(rdfs:label goldbook:12866 "alternative pathway")
AnnotationAssertion(dcterms:description goldbook:12866 "Activation pathway involving complement components C3, Factor B, Factor D, and properdin that, in the presence of a stabilizing activator surface such as microbial polysaccharide, generates the alternative pathway C3 convertase C3bBb.")
Declaration(Class(goldbook:12867))
AnnotationAssertion(rdfs:label goldbook:12867 "alveolar macrophage")
AnnotationAssertion(dcterms:description goldbook:12867 "Macrophage found in the lung alveoli; it may remove and sometimes retain inhaled particulate matter.")
Declaration(Class(goldbook:12868))
AnnotationAssertion(rdfs:label goldbook:12868 "alveolitis")
AnnotationAssertion(dcterms:description goldbook:12868 """1) Inflammation of alveoli.
2) Inflammation of a tooth socket.""")
Declaration(Class(goldbook:12869))
AnnotationAssertion(rdfs:label goldbook:12869 "amyloid")
AnnotationAssertion(dcterms:description goldbook:12869 "Fibrous protein secreted into the extracellular space where it forms amorphous deposits in multiple organs in some pathological states.")
Declaration(Class(goldbook:12870))
AnnotationAssertion(rdfs:label goldbook:12870 "anamnestic")
AnnotationAssertion(dcterms:description goldbook:12870 "Describing immunological memory that gives rise to a rapid increase in immunological response after reexposure to antigen.")
Declaration(Class(goldbook:12871))
AnnotationAssertion(rdfs:label goldbook:12871 "anaphylactic shock")
AnnotationAssertion(dcterms:description goldbook:12871 "Immediate overreaction of the immune system to a drug or other agent in an individual who has previously encountered the agent and has produced antibodies to that agent.")
Declaration(Class(goldbook:12872))
AnnotationAssertion(rdfs:label goldbook:12872 "anaphylactoid")
AnnotationAssertion(dcterms:description goldbook:12872 "Of or resembling anaphylaxis.")
Declaration(Class(goldbook:12873))
AnnotationAssertion(rdfs:label goldbook:12873 "anaphylatoxin")
AnnotationAssertion(dcterms:description goldbook:12873 "Complement-derived protein fragment (e.g., C3a, C4a, or C5a) capable of directly triggering mast cell degranulation, chemotaxis, smooth muscle contraction, and inflammation.")
Declaration(Class(goldbook:12874))
AnnotationAssertion(rdfs:label goldbook:12874 "anaphylaxis")
AnnotationAssertion(dcterms:description goldbook:12874 "Life-threatening type I hypersensitivity allergic reaction occurring in a person or animal exposed to an antigen or hapten to which they have previously been sensitized.")
Declaration(Class(goldbook:12875))
AnnotationAssertion(rdfs:label goldbook:12875 "anergy")
AnnotationAssertion(dcterms:description goldbook:12875 "Lack of an immune response, usually taken as lack of response to common recall antigens.")
Declaration(Class(goldbook:12876))
AnnotationAssertion(rdfs:label goldbook:12876 "angioedema")
AnnotationAssertion(dcterms:description goldbook:12876 "Swelling that occurs in the tissue just below the surface of the skin, most often around the lips and eyes, the mucous membranes and occasionally the viscera.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12876 "angioneurotic edema")
Declaration(Class(goldbook:12877))
AnnotationAssertion(rdfs:label goldbook:12877 "ankylosing spondylitis")
AnnotationAssertion(dcterms:description goldbook:12877 "Chronic inflammatory disease affecting the spine, sacroiliac joints, and large peripheral joints, having a major genetic predisposition.")
Declaration(Class(goldbook:12878))
AnnotationAssertion(rdfs:label goldbook:12878 "therapeutic antibody")
AnnotationAssertion(dcterms:description goldbook:12878 "Antibody administered with the aim of treating a disease.")
Declaration(Class(goldbook:12879))
AnnotationAssertion(rdfs:label goldbook:12879 "antibody-dependent cellular cytotoxicity")
AnnotationAssertion(dcterms:description goldbook:12879 "Cytotoxic reaction in which an antibody-coated target cell is directly killed by an Fc receptor-bearing leukocyte, e.g., NK cell, macrophage, neutrophil, or eosinophil.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12879 "antibody-dependent cell-mediated cytotoxicity")
Declaration(Class(goldbook:12880))
AnnotationAssertion(rdfs:label goldbook:12880 "antibody-forming cell assay")
AnnotationAssertion(dcterms:description goldbook:12880 "Assay that measures the humoral immune response mediated by the concerted actions of antigen-presenting cells, T lymphocytes, and B lymphocytes, generally by determination of murine primary IgM or IgG antibodies directed against the T-cell-dependent sheep red blood cell (SRBC) surface antigens after in vivo sensitization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "hemolytic plaque assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "Jerne plaque assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "plaque-forming cell (PFC) assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12880 "AFC assay")
Declaration(Class(goldbook:12881))
AnnotationAssertion(rdfs:label goldbook:12881 "antibody therapy")
AnnotationAssertion(dcterms:description goldbook:12881 "Use of an antibody to target specific cells (often tumor cells) or signal transduction pathways (often via chemokines/cytokines) in the treatment of disease.")
Declaration(Class(goldbook:12882))
AnnotationAssertion(rdfs:label goldbook:12882 "lupus anticoagulant")
AnnotationAssertion(dcterms:description goldbook:12882 "Autoantibody that binds to phospholipids and/or proteins of the cell membrane in systemic lupus erythematosus (SLE), and can interfere with blood clotting and tests of clotting function.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "antibody")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "lupus")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "lupus antibody")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12882 "lupus anticoagulant")
Declaration(Class(goldbook:12883))
AnnotationAssertion(rdfs:label goldbook:12883 "anti-DNA antibody")
AnnotationAssertion(dcterms:description goldbook:12883 "Antibody directed against single-stranded or double-stranded DNA.")
Declaration(Class(goldbook:12884))
AnnotationAssertion(rdfs:label goldbook:12884 "anti-erythrocyte antibody")
AnnotationAssertion(dcterms:description goldbook:12884 "Antibody against molecules of the red blood cell, usually against membrane proteins, causing lysis of the red blood cells.")
Declaration(Class(goldbook:12885))
AnnotationAssertion(rdfs:label goldbook:12885 "antigenic")
AnnotationAssertion(dcterms:description goldbook:12885 "Capable of stimulating lymphocytes to produce antibodies.")
Declaration(Class(goldbook:12886))
AnnotationAssertion(rdfs:label goldbook:12886 "antigenicity")
AnnotationAssertion(dcterms:description goldbook:12886 "Ability of an antigen to bind to a specific antibody or T-cell receptor (TCR); often a measure of its ability to produce immunity.")
Declaration(Class(goldbook:12887))
AnnotationAssertion(rdfs:label goldbook:12887 "antigen presentation")
AnnotationAssertion(dcterms:description goldbook:12887 "Display of antigen as peptide fragments bound to major histocompatibility complex (MHC) molecules on the surface of a cell.")
Declaration(Class(goldbook:12888))
AnnotationAssertion(rdfs:label goldbook:12888 "antigen-presenting cell")
AnnotationAssertion(dcterms:description goldbook:12888 "Cell, such as a dendritic cell or macrophage, that is responsible for making antigens accessible to lymphocytes and other immune effector and regulatory cells, making possible specific recognition by receptors on the cell surface.")
Declaration(Class(goldbook:12889))
AnnotationAssertion(rdfs:label goldbook:12889 "antigen-presenting groove")
AnnotationAssertion(dcterms:description goldbook:12889 """1) Pocket in a major histocompatibility complex (MHC) molecule that binds antigen for antigen presentation.
2) Hydrophobic binding region in the CD1 protein that anchors lipid-containing antigens causing exposure of the peptide or carbohydrate moiety in a position enabling T-cell receptor (TCR) contact.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12889 "antigen-binding groove")
Declaration(Class(goldbook:12890))
AnnotationAssertion(rdfs:label goldbook:12890 "antigen processing")
AnnotationAssertion(dcterms:description goldbook:12890 "Cleavage of protein antigens in antigen-presenting cells (APCs).")
Declaration(Class(goldbook:12891))
AnnotationAssertion(rdfs:label goldbook:12891 "antigen receptor")
AnnotationAssertion(dcterms:description goldbook:12891 "Specific antigen-binding receptor on T or B lymphocytes that is transcribed and translated following rearrangements and translocation of V, D, and J genes.")
Declaration(Class(goldbook:12892))
AnnotationAssertion(rdfs:label goldbook:12892 "antigen recognition")
AnnotationAssertion(dcterms:description goldbook:12892 "Ability of highly specialized proteins of the immune system to recognize antigens and specifically bind to them.")
Declaration(Class(goldbook:12893))
AnnotationAssertion(rdfs:label goldbook:12893 "anti-idiotypic antibody")
AnnotationAssertion(dcterms:description goldbook:12893 "Antibody raised against antigenic determinants unique to the variable region of a single antibody.")
Declaration(Class(goldbook:12894))
AnnotationAssertion(rdfs:label goldbook:12894 "anti-isotypic antibody")
AnnotationAssertion(dcterms:description goldbook:12894 "Antibody against universal features of a given constant (C) region isotype (such as $\\upgamma\\!$ or $\\upmu\\!$) of one species that is made by immunizing a member of another species with that isotype.")
Declaration(Class(goldbook:12895))
AnnotationAssertion(rdfs:label goldbook:12895 "antimitochondrial antibody")
AnnotationAssertion(dcterms:description goldbook:12895 "Autoantibody producing a mitochondrial staining pattern on sections of various tissues and on tumor cell monolayers.")
Declaration(Class(goldbook:12896))
AnnotationAssertion(rdfs:label goldbook:12896 "antineutrophil cytoplasmic autoantibody")
AnnotationAssertion(dcterms:description goldbook:12896 "Antibody against antigens in the cytoplasm of neutrophils.")
Declaration(Class(goldbook:12897))
AnnotationAssertion(rdfs:label goldbook:12897 "antineutrophil cytoplasmic autoantibody associated vasculitis")
AnnotationAssertion(dcterms:description goldbook:12897 "One of a group of autoimmune systemic vasculitides associated with antineutrophil cytoplasmic autoantibodies (ANCAs), e.g., Wegener granulomatosis (WG), microscopic polyangiitis, and Churg–Strauss syndrome.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12897 "ANCA-associated vasculitis")
Declaration(Class(goldbook:12898))
AnnotationAssertion(rdfs:label goldbook:12898 "antinuclear antibody")
AnnotationAssertion(dcterms:description goldbook:12898 "Antibody, detectable in the blood, that has the capability of binding to a substance, e.g., DNA, within the nucleus of the cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12898 "antinuclear factor (ANF)")
Declaration(Class(goldbook:12899))
AnnotationAssertion(rdfs:label goldbook:12899 "antiphospholipid syndrome")
AnnotationAssertion(dcterms:description goldbook:12899 "One of the most common autoimmune diseases, characterized by thrombosis, recurrent spontaneous abortions, and the presence of antiphospholipid antibodies.")
Declaration(Class(goldbook:12900))
AnnotationAssertion(rdfs:label goldbook:12900 "anti-sheep red blood cell IgM response assay")
AnnotationAssertion(dcterms:description goldbook:12900 "Test to determine T-cell-dependent antibody response, usually by enzyme-linked immunosorbent assay (ELISA). Sheep red blood cells (SRBCs) are used as an antigen. Often referred to as the plaque assay.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12900 "plaque assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12900 "SRBC Assay")
Declaration(Class(goldbook:12901))
AnnotationAssertion(rdfs:label goldbook:12901 "antitoxin")
AnnotationAssertion(dcterms:description goldbook:12901 "Antibody specific for exotoxins produced by certain microorganisms such as the causative agents of diphtheria and tetanus.")
Declaration(Class(goldbook:12902))
AnnotationAssertion(rdfs:label goldbook:12902 "aplastic anemia")
AnnotationAssertion(dcterms:description goldbook:12902 "Greatly decreased formation of erythrocytes and hemoglobin, usually associated with pronounced granulocytopenia and thrombocytopenia, as a result of hypoplastic or aplastic bone marrow.")
Declaration(Class(goldbook:12903))
AnnotationAssertion(rdfs:label goldbook:12903 "arthritis")
AnnotationAssertion(dcterms:description goldbook:12903 "Inflammation of a joint or joints.")
Declaration(Class(goldbook:12904))
AnnotationAssertion(rdfs:label goldbook:12904 "Arthus reaction")
AnnotationAssertion(dcterms:description goldbook:12904 "Local antibody-mediated hypersensitivity reaction in which antigen-antibody complexes which fix complement are deposited in the walls of small vessels, often in the skin, causing acute inflammation with an infiltration of neutrophils.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12904 "Gell and Coombs Type III reaction")
Declaration(Class(goldbook:12905))
AnnotationAssertion(rdfs:label goldbook:12905 "asthma")
AnnotationAssertion(dcterms:description goldbook:12905 "Chronic respiratory disease characterized by bronchoconstriction, excessive mucus secretion, and edema of the pulmonary alveoli, resulting in difficulty in exhaling, wheezing, and cough.")
Declaration(Class(goldbook:12906))
AnnotationAssertion(rdfs:label goldbook:12906 "ataxia telangiectasia")
AnnotationAssertion(dcterms:description goldbook:12906 "Disease characterized by staggering gait, multiple disorganized blood vessels, and an immunodeficiency, associated with a protein called ataxia telangiectasia-mutated (ATM), a protein kinase thought to be important in detection of double-stranded DNA breaks.")
Declaration(Class(goldbook:12907))
AnnotationAssertion(rdfs:label goldbook:12907 "atopic allergy")
AnnotationAssertion(dcterms:description goldbook:12907 "Immunoglobulin E (IgE)-mediated hypersensitivity, including asthma, eczema, hay fever, and food allergy.")
Declaration(Class(goldbook:12908))
AnnotationAssertion(rdfs:label goldbook:12908 "atopic dermatitis")
AnnotationAssertion(dcterms:description goldbook:12908 "Inflammation of the skin in atopic individuals.")
Declaration(Class(goldbook:12909))
AnnotationAssertion(rdfs:label goldbook:12909 "atopic eczema")
AnnotationAssertion(dcterms:description goldbook:12909 "Chronic skin disease, often localized on flexural surfaces, in individuals with propensity to develop immunoglobulin E (IgE)-mediated allergy.")
Declaration(Class(goldbook:12910))
AnnotationAssertion(rdfs:label goldbook:12910 "atopy")
AnnotationAssertion(dcterms:description goldbook:12910 "Of, relating to, or caused by a hereditary predisposition toward developing certain hypersensitivity reactions, such as hay fever, asthma, or chronic urticaria, upon exposure to specific antigens.")
Declaration(Class(goldbook:12911))
AnnotationAssertion(rdfs:label goldbook:12911 "attenuated vaccine")
AnnotationAssertion(dcterms:description goldbook:12911 "Vaccine made from a live organism that targets cells of the immune system but has been engineered or weakened so as not to cause disease.")
Declaration(Class(goldbook:12912))
AnnotationAssertion(rdfs:label goldbook:12912 "atypical interstitial pneumonia")
AnnotationAssertion(dcterms:description goldbook:12912 "Acute or chronic respiratory distress in cattle, in the absence of toxemia or other systemic signs that are characteristic of other pneumonias.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12912 "exogen allergic alveolitis")
Declaration(Class(goldbook:12913))
AnnotationAssertion(rdfs:label goldbook:12913 "autoantibody")
AnnotationAssertion(dcterms:description goldbook:12913 "Immunoglobulin (Ig) antibody that is directed against the organism’s own antigen(s).")
Declaration(Class(goldbook:12914))
AnnotationAssertion(rdfs:label goldbook:12914 "autoantigen")
AnnotationAssertion(dcterms:description goldbook:12914 "Antigenic component of an individual’s tissues which may be a target of autoimmune responses by autoreactive B cells (autoantibodies) or T cells, including proteins (e.g., enzymes, structural proteins), glycoproteins (e.g., 2-glycoprotein I), nucleic acids, (e.g., double-stranded DNA), phospholipids (e.g., cardiolipin), and glycosphingolipids (e.g., gangliosides).")
Declaration(Class(goldbook:12915))
AnnotationAssertion(rdfs:label goldbook:12915 "autochthonous")
AnnotationAssertion(dcterms:description goldbook:12915 "Pertaining to self.")
Declaration(Class(goldbook:12916))
AnnotationAssertion(rdfs:label goldbook:12916 "autocrine")
AnnotationAssertion(dcterms:description goldbook:12916 "Type of signaling in which a cell secretes a chemical messenger that binds to receptors on the same cell, leading to changes in the cell.")
Declaration(Class(goldbook:12917))
AnnotationAssertion(rdfs:label goldbook:12917 "autograft")
AnnotationAssertion(dcterms:description goldbook:12917 "Tissue transplant from one site to another in an individual.")
Declaration(Class(goldbook:12918))
AnnotationAssertion(rdfs:label goldbook:12918 "autoimmune")
AnnotationAssertion(dcterms:description goldbook:12918 "Of or relating to an immune response by the body against one of its own cells or tissues.")
Declaration(Class(goldbook:12919))
AnnotationAssertion(rdfs:label goldbook:12919 "autoimmune disease")
AnnotationAssertion(dcterms:description goldbook:12919 "Pathological condition resulting when an organism produces antibodies or specific cells that bind to constituents of its own tissues (autoantigens) and cause tissue injury.")
Declaration(Class(goldbook:12920))
AnnotationAssertion(rdfs:label goldbook:12920 "autoimmune hemolytic anemia")
AnnotationAssertion(dcterms:description goldbook:12920 "Autoimmune disease in which antibodies initiate complement lysis of erythrocytes.")
Declaration(Class(goldbook:12921))
AnnotationAssertion(rdfs:label goldbook:12921 "autoimmune hepatitis")
AnnotationAssertion(dcterms:description goldbook:12921 "Chronic autoimmune-mediated hepatic inflammation usually characterized by antinuclear (ANA), smooth muscle (SMA)/anti-F-actin, liver-kidney microsomal (LKM), and/or soluble liver antigen (SLA) antibodies.")
Declaration(Class(goldbook:12922))
AnnotationAssertion(rdfs:label goldbook:12922 "autoimmune lymphoproliferative syndrome")
AnnotationAssertion(dcterms:description goldbook:12922 "Disease characterized by lymphadenopathy, hepatosplenomegaly, autoimmune cytopenias, and hypergammaglobulinemia.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12922 "Canale–Smith syndrome")
Declaration(Class(goldbook:12923))
AnnotationAssertion(rdfs:label goldbook:12923 "autoimmune polyendocrine syndrome type 1 or 2")
AnnotationAssertion(dcterms:description goldbook:12923 "Heterogeneous group of rare diseases characterized by autoimmune activity against more than one endocrine organ, although non-endocrine organs can also be affected.")
Declaration(Class(goldbook:12924))
AnnotationAssertion(rdfs:label goldbook:12924 "autoimmune regulator")
AnnotationAssertion(dcterms:description goldbook:12924 "DNA-binding protein involved in immunoregulation (probably in the establishment and maintenance of tolerance).")
Declaration(Class(goldbook:12925))
AnnotationAssertion(rdfs:label goldbook:12925 "autoimmunity")
AnnotationAssertion(dcterms:description goldbook:12925 "Immune response to 'self' tissues or components.")
Declaration(Class(goldbook:12926))
AnnotationAssertion(rdfs:label goldbook:12926 "autoinflammatory disease")
AnnotationAssertion(dcterms:description goldbook:12926 "Unregulated inflammation without significant levels of autoantibodies or autoactivated T cells, or evidence of infection, but rather caused by genetic disturbance of the mechanisms that initiate and control inflammation.")
Declaration(Class(goldbook:12927))
AnnotationAssertion(rdfs:label goldbook:12927 "autologous")
AnnotationAssertion(dcterms:description goldbook:12927 "From the same individual.")
Declaration(Class(goldbook:12928))
AnnotationAssertion(rdfs:label goldbook:12928 "autologous antibody")
AnnotationAssertion(dcterms:description goldbook:12928 "Antibody derived from a specific individual, acting within that individual.")
Declaration(Class(goldbook:12929))
AnnotationAssertion(rdfs:label goldbook:12929 "autophagy")
AnnotationAssertion(dcterms:description goldbook:12929 "Digestion and breakdown in lysosomes of a cell’s own proteins and/or organelles.")
Declaration(Class(goldbook:12930))
AnnotationAssertion(rdfs:label goldbook:12930 "autoreactivity")
AnnotationAssertion(dcterms:description goldbook:12930 "Immune response directed at self-antigens.")
Declaration(Class(goldbook:12931))
AnnotationAssertion(rdfs:label goldbook:12931 "β2-microglobulin")
AnnotationAssertion(dcterms:description goldbook:12931 "Small (\\(\\pu{12 kDa}\\)) protein forming part of the structure of major histocompatibility complex (MHC) class I-encoded molecules.")
Declaration(Class(goldbook:12932))
AnnotationAssertion(rdfs:label goldbook:12932 "B-1/B-2 cells")
AnnotationAssertion(dcterms:description goldbook:12932 "Two major subpopulations of B lymphocytes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12932 "B-1/B-2 lymphocytes")
Declaration(Class(goldbook:12933))
AnnotationAssertion(rdfs:label goldbook:12933 "B7 molecule")
AnnotationAssertion(dcterms:description goldbook:12933 "Co-stimulatory molecule on the surface of T-cell-activating antigen-presenting cells (APCs), allowing full activation of T cells that are bound to major histocompatibility complex (MHC)-peptide complexes.")
Declaration(Class(goldbook:12934))
AnnotationAssertion(rdfs:label goldbook:12934 "B-cell linker protein")
AnnotationAssertion(dcterms:description goldbook:12934 "Adaptor protein operating in B cells that, upon phosphorylation, recruits signaling molecules to membrane lipid rafts.")
Declaration(Class(goldbook:12935))
AnnotationAssertion(rdfs:label goldbook:12935 "B-cell stimulatory factor")
AnnotationAssertion(dcterms:description goldbook:12935 "Generic name given to B-cell-specific growth and differentiation factors involved in the T-cell-dependent activation of B cells. Many are now identified as specific interleukins (ILs).")
Declaration(Class(goldbook:12936))
AnnotationAssertion(rdfs:label goldbook:12936 "B-cell receptor")
AnnotationAssertion(dcterms:description goldbook:12936 "Receptor on the surface of a B cell consisting of transmembrane immunoglobulin (Ig) that recognizes a specific antigen.")
Declaration(Class(goldbook:12937))
AnnotationAssertion(rdfs:label goldbook:12937 "B lymphocyte")
AnnotationAssertion(dcterms:description goldbook:12937 "Bone marrow-derived lymphocyte, expressing an antigen-receptor complex composed of membrane-bound immunoglobulin (Ig) and associated molecular chains.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12937 "B cell")
Declaration(Class(goldbook:12938))
AnnotationAssertion(rdfs:label goldbook:12938 "B-lymphocyte chemokine")
AnnotationAssertion(dcterms:description goldbook:12938 "Chemokine that attracts B cells and activated T cells into the follicles of peripheral lymphoid tissues.")
Declaration(Class(goldbook:12939))
AnnotationAssertion(rdfs:label goldbook:12939 "B-lymphocyte-induced maturation protein 1")
AnnotationAssertion(dcterms:description goldbook:12939 "Transcriptional repressor in B cells, that switches off genes required for B cell proliferation in the germinal center, and for class switching and affinity maturation.")
Declaration(Class(goldbook:12940))
AnnotationAssertion(rdfs:label goldbook:12940 "bacille Calmette–Guérin")
AnnotationAssertion(dcterms:description goldbook:12940 "Attenuated Mycobacterium tuberculosis used both as a specific vaccine for tuberculosis and as an adjuvant.")
Declaration(Class(goldbook:12941))
AnnotationAssertion(rdfs:label goldbook:12941 "BALB/c mouse")
AnnotationAssertion(dcterms:description goldbook:12941 "Inbred albino mouse strain, substrains of which produce plasmacytomas on injection with mineral oil, useful for the production of monoclonal antibodies.")
Declaration(Class(goldbook:12942))
AnnotationAssertion(rdfs:label goldbook:12942 "bare lymphocyte syndrome")
AnnotationAssertion(dcterms:description goldbook:12942 "Rare, recessive genetic condition in which the products of one or more genes required to switch on major histocompatibility complex (MHC) class I or MHC class II genes are defective or absent. As a consequence, MHC class I (BLS1) or MHC class II (BLS2) genes are not expressed, leading to severe immunodeficiency.")
Declaration(Class(goldbook:12943))
AnnotationAssertion(rdfs:label goldbook:12943 "basophil")
AnnotationAssertion(dcterms:description goldbook:12943 "Type of granulocyte found in the blood and resembling the tissue mast cell.")
Declaration(Class(goldbook:12944))
AnnotationAssertion(rdfs:label goldbook:12944 "basophilic degranulation")
AnnotationAssertion(dcterms:description goldbook:12944 "Loss of granules in basophilic cells, associated with the release of active substances from the cells, characteristic of type I immediate hypersensitivity.")
Declaration(Class(goldbook:12945))
AnnotationAssertion(rdfs:label goldbook:12945 "Bcl-2")
AnnotationAssertion(dcterms:description goldbook:12945 "Member of the Bcl protein family that protects cells from apoptosis by binding to the mitochondrial membrane.")
Declaration(Class(goldbook:12946))
AnnotationAssertion(rdfs:label goldbook:12946 "Behcet disease")
AnnotationAssertion(dcterms:description goldbook:12946 "Chronic vasculitis of unknown origin, characterized by ulcerations and skin rash and treated by immunosuppression.")
Declaration(Class(goldbook:12947))
AnnotationAssertion(rdfs:label goldbook:12947 "Bence–Jones protein")
AnnotationAssertion(dcterms:description goldbook:12947 "Excess circulating kappa ($\\kappa$)-light chain found in the urine of patients with multiple myeloma.")
Declaration(Class(goldbook:12948))
AnnotationAssertion(rdfs:label goldbook:12948 "benign monoclonal gammopathy")
AnnotationAssertion(dcterms:description goldbook:12948 "Nonmalignant overproduction of $\\ce{\\upgamma\\!\\mbox{-}globulin}$ by a single clone of lymphocytes.")
Declaration(Class(goldbook:12949))
AnnotationAssertion(rdfs:label goldbook:12949 "biolistics")
AnnotationAssertion(dcterms:description goldbook:12949 "Use of small particles, e.g., colloidal gold, as a vehicle for carrying agents (drugs, nucleic acid, etc.) into a cell.")
Declaration(Class(goldbook:12950))
AnnotationAssertion(rdfs:label goldbook:12950 "biopanning")
AnnotationAssertion(dcterms:description goldbook:12950 "Technique for selection of peptides with high affinity binding to a chosen target.")
Declaration(Class(goldbook:12951))
AnnotationAssertion(rdfs:label goldbook:12951 "bispecific antibody")
AnnotationAssertion(dcterms:description goldbook:12951 "Artificially produced hybrid antibody in which each of the two antigen-binding arms is specific for a different antigenic epitope. Such antibodies, which can be produced either by chemical cross-linkage or by recombinant DNA techniques, can be used to link together two different antigens or cells, e.g., a cytotoxic T lymphocyte and a tumor cell.")
Declaration(Class(goldbook:12952))
AnnotationAssertion(rdfs:label goldbook:12952 "blast")
AnnotationAssertion(dcterms:description goldbook:12952 "Immature stage in cell development, before the appearance of the definitive characteristics of the cell; used also as a word termination, as in erythroblast, etc.")
Declaration(Class(goldbook:12953))
AnnotationAssertion(rdfs:label goldbook:12953 "Blau syndrome")
AnnotationAssertion(dcterms:description goldbook:12953 "Rare familial inflammatory disease characterized by arthritis, dermatitis, and uveitis.")
Declaration(Class(goldbook:12954))
AnnotationAssertion(rdfs:label goldbook:12954 "blocking antibody")
AnnotationAssertion(dcterms:description goldbook:12954 "Antibody that prevents other antibodies from combining with a specific antigen but does not itself produce an immunological response when combined with that antigen.")
Declaration(Class(goldbook:12955))
AnnotationAssertion(rdfs:label goldbook:12955 "blood dyscrasia")
AnnotationAssertion(dcterms:description goldbook:12955 "Presence of abnormal material in the blood, usually applied to diseases affecting blood cells or platelets.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12955 "dyscrasia")
Declaration(Class(goldbook:12956))
AnnotationAssertion(rdfs:label goldbook:12956 "blood group antigen")
AnnotationAssertion(dcterms:description goldbook:12956 "Surface antigen on erythrocytes, detectable with a specific antibody from other individuals.")
Declaration(Class(goldbook:12957))
AnnotationAssertion(rdfs:label goldbook:12957 "blood–placenta barrier")
AnnotationAssertion(dcterms:description goldbook:12957 "Physiological interface between maternal and fetal blood circulations that filters out some substances that could harm the fetus while favoring the passage of others such as nutrients.")
Declaration(Class(goldbook:12958))
AnnotationAssertion(rdfs:label goldbook:12958 "Bloom syndrome")
AnnotationAssertion(dcterms:description goldbook:12958 "Disease caused by mutations in a DNA helicase and characterized by low T cell numbers, reduced antibody levels, and an increased susceptibility to respiratory infections, cancer, and radiation damage.")
Declaration(Class(goldbook:12959))
AnnotationAssertion(rdfs:label goldbook:12959 "bone marrow")
AnnotationAssertion(dcterms:description goldbook:12959 "Soft fatty vascular substance in the cavity of bone where blood cells are formed.")
Declaration(Class(goldbook:12960))
AnnotationAssertion(rdfs:label goldbook:12960 "bone marrow transplantation")
AnnotationAssertion(dcterms:description goldbook:12960 "Transfer of bone marrow from a donor to a recipient whose bone marrow has been ablated.")
Declaration(Class(goldbook:12961))
AnnotationAssertion(rdfs:label goldbook:12961 "booster")
AnnotationAssertion(dcterms:description goldbook:12961 "Portion of an immunizing agent given at a later time to stimulate the effects of a previous dose of the same agent.")
Declaration(Class(goldbook:12962))
AnnotationAssertion(rdfs:label goldbook:12962 "bradykinin")
AnnotationAssertion(dcterms:description goldbook:12962 "Vasoactive peptide and inflammatory mediator produced at sites of tissue damage.")
Declaration(Class(goldbook:12963))
AnnotationAssertion(rdfs:label goldbook:12963 "bronchial provocation test")
AnnotationAssertion(dcterms:description goldbook:12963 "Test of alteration of lung function induced by inhalation of an allergen or airway-constricting agent, providing information on bronchial responsiveness.")
Declaration(Class(goldbook:12964))
AnnotationAssertion(rdfs:label goldbook:12964 "Buehler assay")
AnnotationAssertion(dcterms:description goldbook:12964 "Skin sensitization test for contact allergic dermatitis in which a test substance is applied to the shaved flank of a guinea pig in an occlusive patch for 6 h at 0, 1, and 2 weeks, followed by challenge of the untreated flank at 4 weeks.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12964 "Buehler test")
Declaration(Class(goldbook:12965))
AnnotationAssertion(rdfs:label goldbook:12965 "autoimmune bullous skin disease")
AnnotationAssertion(dcterms:description goldbook:12965 "Any of several autoimmune diseases characterized by intraepidermal or subepidermal blisters (e.g., pemphigus vulgaris, bullous pemphigoid) and highly specific autoantibodies against components of the desmosome or hemidesmosome (e.g., desmoglein 3, BP180).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12965 "autoimmune bullous skin disease")
Declaration(Class(goldbook:12966))
AnnotationAssertion(rdfs:label goldbook:12966 "Burkitt lymphoma")
AnnotationAssertion(dcterms:description goldbook:12966 "Lymphoma caused by Epstein–Barr virus (EBV), occurring mainly in sub-Saharan Africa.")
Declaration(Class(goldbook:12967))
AnnotationAssertion(rdfs:label goldbook:12967 "bursa of Fabricius")
AnnotationAssertion(dcterms:description goldbook:12967 "Primary lymphoid organ in avian species, located at the cloacal-hind gut junction; it is the site of B-cell maturation.")
Declaration(Class(goldbook:12968))
AnnotationAssertion(rdfs:label goldbook:12968 "bystander effect")
AnnotationAssertion(dcterms:description goldbook:12968 "Positive or negative effect on the immune system seen after exposure to certain drugs, radiation, and other agents, induced by non-immune mechanisms.")
Declaration(Class(goldbook:12969))
AnnotationAssertion(rdfs:label goldbook:12969 "bystander suppression")
AnnotationAssertion(dcterms:description goldbook:12969 "Suppression of an immune response to an antigen due to tolerance to an unrelated (hence bystander) antigen.")
Declaration(Class(goldbook:12970))
AnnotationAssertion(rdfs:label goldbook:12970 "C1 inhibitor")
AnnotationAssertion(dcterms:description goldbook:12970 "Plasma glycoprotein secreted primarily by the liver and acting as a serine proteinase inhibitor (serpin), inhibiting C1 components of the complement system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12970 "C1 esterase inhibitor")
Declaration(Class(goldbook:12971))
AnnotationAssertion(rdfs:label goldbook:12971 "CD1")
AnnotationAssertion(dcterms:description goldbook:12971 "Cell surface protein of antigen-presenting cells (APCs) involved in presentation of lipopeptide or glycolipid antigens.")
Declaration(Class(goldbook:12972))
AnnotationAssertion(rdfs:label goldbook:12972 "CD3")
AnnotationAssertion(dcterms:description goldbook:12972 "Molecule composed of five polypeptide chains associated with the heterodimer T-cell receptor (TCR), forming the T-cell receptor complex (TCR/CD3); CD3 transduces the activating signals when antigen binds to the TCR.")
Declaration(Class(goldbook:12973))
AnnotationAssertion(rdfs:label goldbook:12973 "CD4")
AnnotationAssertion(dcterms:description goldbook:12973 "Cell surface antigen belonging to the immunoglobulin (Ig) superfamily of molecules and a marker of T helper cells.")
Declaration(Class(goldbook:12974))
AnnotationAssertion(rdfs:label goldbook:12974 "CD4+/CD25+ T cell")
AnnotationAssertion(dcterms:description goldbook:12974 "Subtype of CD4+ regulatory T cell (Treg) with potential role in the regulation of immune homeostasis.")
Declaration(Class(goldbook:12975))
AnnotationAssertion(rdfs:label goldbook:12975 "CD5+ B lymphocyte")
AnnotationAssertion(dcterms:description goldbook:12975 "Lymphocyte of type B-1a, which is predominant in fetal lymphoid organs and in neonatal cord blood.")
Declaration(Class(goldbook:12976))
AnnotationAssertion(rdfs:label goldbook:12976 "CD8")
AnnotationAssertion(dcterms:description goldbook:12976 "Cell surface molecule belonging to the immunoglobulin (Ig) superfamily of molecules found, among others, on cytotoxic T cells, which binds to major histocompatibility complex (MHC) class I molecules.")
Declaration(Class(goldbook:12977))
AnnotationAssertion(rdfs:label goldbook:12977 "CD8+ T suppressor cell")
AnnotationAssertion(dcterms:description goldbook:12977 "Outdated term for CD8+ cytotoxic T lymphocyte (CTL, Tc). The term 'suppressor T cell' is nowadays reserved for regulatory T cell (Treg).")
Declaration(Class(goldbook:12978))
AnnotationAssertion(rdfs:label goldbook:12978 "CD16")
AnnotationAssertion(dcterms:description goldbook:12978 "Low-affinity $\\ce{Fc\\mbox{-}\\upgamma\\! receptor}$ ($\\ce{Fc\\mbox{-}\\upgamma\\!\\mbox{-}RIII}$) expressed mainly on natural killer (NK) cells, granulocytes, and macrophages, mediating antibody-dependent cellular cytotoxicity (ADCC).")
Declaration(Class(goldbook:12979))
AnnotationAssertion(rdfs:label goldbook:12979 "CD23")
AnnotationAssertion(dcterms:description goldbook:12979 "Low-affinity ${\\rm{Fc\\mbox{-}}}\\upvarepsilon\\!$ receptor induced by interleukin-4 (IL-4) and expressed on see activated B cells and macrophages.")
Declaration(Class(goldbook:12980))
AnnotationAssertion(rdfs:label goldbook:12980 "CD25")
AnnotationAssertion(dcterms:description goldbook:12980 "\\(\\ce{\\upalpha\\mbox{-}chain}\\) of the interleukin-2 (IL-2) receptor.")
Declaration(Class(goldbook:12981))
AnnotationAssertion(rdfs:label goldbook:12981 "CD40 ligand")
AnnotationAssertion(dcterms:description goldbook:12981 "Essential molecule for normal switching signaling through binding to CD40 on B cells. The interaction of CD40L and CD40 is also critical for optimal T cell function.")
Declaration(Class(goldbook:12982))
AnnotationAssertion(rdfs:label goldbook:12982 "C-reactive protein")
AnnotationAssertion(dcterms:description goldbook:12982 "Serum protein produced by liver cells as part of the acute-phase response, which acts as a stimulus of the classical pathway of complement activation.")
Declaration(Class(goldbook:12983))
AnnotationAssertion(rdfs:label goldbook:12983 "C-type lectin")
AnnotationAssertion(dcterms:description goldbook:12983 "Any of a large family of \\(\\ce{Ca^{2+}}\\)-dependent lectins; members of this family share primary structural homology in their carbohydrate-recognition domains and include many endocytic receptors, many proteoglycans, and all known collectins and selectins.")
Declaration(Class(goldbook:12984))
AnnotationAssertion(rdfs:label goldbook:12984 "cadherin")
AnnotationAssertion(dcterms:description goldbook:12984 "Calcium-dependent, transmembrane glycoprotein occurring in cell-cell contacts (desmosomes) and functioning as an adhesion molecule.")
Declaration(Class(goldbook:12985))
AnnotationAssertion(rdfs:label goldbook:12985 "calcineurin inhibitor")
AnnotationAssertion(dcterms:description goldbook:12985 "Any member of a group of immunomodulating drugs that bind to the cytosolic protein cyclophilin of T lymphocytes, thus inhibiting the phosphatase calcineurin, an inducer of interleukin-2 (IL-2) formation.")
Declaration(Class(goldbook:12986))
AnnotationAssertion(rdfs:label goldbook:12986 "candidiasis")
AnnotationAssertion(dcterms:description goldbook:12986 "Infection with a fungus of the genus Candida, especially C. albicans, that usually occurs in the skin and mucous membranes of the mouth, respiratory tract, or vagina but may invade the bloodstream, especially in immunocompromised individuals.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12986 "candidosis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12986 "moniliasis")
Declaration(Class(goldbook:12987))
AnnotationAssertion(rdfs:label goldbook:12987 "capping")
AnnotationAssertion(dcterms:description goldbook:12987 "Active process whereby cross-linking of cell surface molecules (e.g., by antibody) leads to aggregation and subsequent migration of the molecules to one pole of the cell.")
Declaration(Class(goldbook:12988))
AnnotationAssertion(rdfs:label goldbook:12988 "carcinoembryonic antigen")
AnnotationAssertion(dcterms:description goldbook:12988 "Membrane glycoprotein epitope normally present in the fetal gastrointestinal tract and elevated in many patients with various carcinomas.")
Declaration(Class(goldbook:12989))
AnnotationAssertion(rdfs:label goldbook:12989 "cardiolipin")
AnnotationAssertion(dcterms:description goldbook:12989 "1,3-Bis(sn-3-phosphatidyl)-sn-glycerol, the main target of antiphospholipid antibodies.")
Declaration(Class(goldbook:12990))
AnnotationAssertion(rdfs:label goldbook:12990 "caspase")
AnnotationAssertion(dcterms:description goldbook:12990 "Any member of a family of intracellular cysteine proteinases that cleave proteins at specific aspartic acid residues to initiate or promote apoptosis.")
Declaration(Class(goldbook:12991))
AnnotationAssertion(rdfs:label goldbook:12991 "caveola")
AnnotationAssertion(dcterms:description goldbook:12991 "Invagination on the cell surface (plasma membrane), enriched in caveolin proteins, cholesterol, and glycosphingolipids, important in various processes including pinocytosis and signal transduction.")
Declaration(Class(goldbook:12992))
AnnotationAssertion(rdfs:label goldbook:12992 "celiac disease")
AnnotationAssertion(dcterms:description goldbook:12992 "Autoimmune disorder occurring in genetically predisposed individuals, characterized by immune intolerance to the \\(\\ce{\\upalpha\\mbox{-}gliadin}\\) component of gluten, a protein found in wheat, barley, and rye. Resultant inflammation of the mucosa of the upper small intestine is associated with malabsorption of nutrients and a wasting illness follows from this.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12992 "gluten enteropathy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12992 "gluten intolerance")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12992 "non-tropical sprue")
Declaration(Class(goldbook:12993))
AnnotationAssertion(rdfs:label goldbook:12993 "cell-mediated cytotoxicity")
AnnotationAssertion(dcterms:description goldbook:12993 "Lysis of a target cell initiated by a T lymphocyte binding to surface antibodies or antigen-bound major histocompatibility complex (MHC) molecules.")
Declaration(Class(goldbook:12994))
AnnotationAssertion(rdfs:label goldbook:12994 "cell-mediated immune response")
AnnotationAssertion(dcterms:description goldbook:12994 "Specific immune response in which T lymphocytes mediate the effects, either through the release of cytokines or through cytotoxicity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12994 "cell-mediated response")
Declaration(Class(goldbook:12995))
AnnotationAssertion(rdfs:label goldbook:12995 "cell-mediated immunity")
AnnotationAssertion(dcterms:description goldbook:12995 "Immune response mediated by antigen-specific T lymphocytes, either through the release of cytokines or through cytotoxicity, in contrast with humoral immunity, which is antibody-mediated.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12995 "cellular immunity")
Declaration(Class(goldbook:12996))
AnnotationAssertion(rdfs:label goldbook:12996 "central tolerance")
AnnotationAssertion(dcterms:description goldbook:12996 "Specific immunological tolerance due to the induction of lymphocyte apoptosis or anergy within the primary lymphoid organs (bone marrow in the case of B cell tolerance and the thymus for T cells).")
Declaration(Class(goldbook:12997))
AnnotationAssertion(rdfs:label goldbook:12997 "challenge")
AnnotationAssertion(dcterms:description goldbook:12997 "Induction or evaluation of an immune response in an organism by administration of a specific antigen to which it has been sensitized.")
Declaration(Class(goldbook:12998))
AnnotationAssertion(rdfs:label goldbook:12998 "chaperone-mediated autophagy")
AnnotationAssertion(dcterms:description goldbook:12998 "Type of autophagy targeting only those proteins that are recognized by the binding of an hsc70-containing chaperone/co-chaperone complex.")
Declaration(Class(goldbook:12999))
AnnotationAssertion(rdfs:label goldbook:12999 "chemotactic factor")
AnnotationAssertion(dcterms:description goldbook:12999 "Biologically active substance, such as a chemokine or anaphylatoxin, that induces a concentration gradient-dependent movement of cells.")
Declaration(Class(goldbook:13000))
AnnotationAssertion(rdfs:label goldbook:13000 "chemotaxis")
AnnotationAssertion(dcterms:description goldbook:13000 """1) General. Movement of an organism or cell along a concentration gradient of a chemical.
2) In immunology. Movement of cells up a concentration gradient of a chemical attractant (chemotactic factor), such as a chemokine or other cytokine.""")
Declaration(Class(goldbook:13001))
AnnotationAssertion(rdfs:label goldbook:13001 "chemotype")
AnnotationAssertion(dcterms:description goldbook:13001 "Character of a plant or microorganism based on a metabolite distinct from that found in other members of the same species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13001 "chemovar")
Declaration(Class(goldbook:13002))
AnnotationAssertion(rdfs:label goldbook:13002 "chloracne")
AnnotationAssertion(dcterms:description goldbook:13002 "Acne-like eruption caused by exposure to certain chlorinated organic substances such as polychlorinated biphenyls or 2,3,7,8-tetrachlorodibenzo[1,4]dioxin [2,3,7,8-tetrachlorooxanthrene] and other polychlorinated dibenzodioxins and furans.")
Declaration(Class(goldbook:13003))
AnnotationAssertion(rdfs:label goldbook:13003 "chromate uptake assay")
AnnotationAssertion(dcterms:description goldbook:13003 "Method used in immunotoxicology to quantify the toxic effect of a substance on leukocytes by measuring uptake of \\(\\ce{^{51}Cr{-}labeled}\\) chromate.")
Declaration(Class(goldbook:13004))
AnnotationAssertion(rdfs:label goldbook:13004 "chromium release assay")
AnnotationAssertion(dcterms:description goldbook:13004 "Immunotoxicity assay that can be used to assess either natural killer (NK) cell or cytotoxic T cell activity or macrophage activity. When incubated with \\(\\ce{^{51}Cr{-}labeled}\\) chicken red blood cells (cRBCs), NK and cytotoxic T cells lyse the cRBC and thus induce the release of \\(\\ce{^{51}Cr}\\) into the medium. In contrast, macrophages phagocytose cRBC, and are then lysed to assess the amount of \\(\\ce{^{51}Cr}\\) they have taken up.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13004 "<sup>51</sup>Cr release assay")
Declaration(Class(goldbook:13005))
AnnotationAssertion(rdfs:label goldbook:13005 "chronic allergic inflammation")
AnnotationAssertion(dcterms:description goldbook:13005 "Disease of airways, skin, eyes and other organs, resulting from repeated or continuous exposure to an allergen and involving immunoglobulin E (IgE) formation, IgE-induced histamine-release from mast cells, liberation of mediators such as cytokines and prostaglandins, and local inflammation characterized by infiltrating leucocytes; it results in augmented susceptibility to the allergen.")
Declaration(Class(goldbook:13006))
AnnotationAssertion(rdfs:label goldbook:13006 "chronic granulomatous disease")
AnnotationAssertion(dcterms:description goldbook:13006 "Immunodeficiency disease in which multiple granulomas form as a result of defective elimination of bacteria by phagocytes.")
Declaration(Class(goldbook:13007))
AnnotationAssertion(rdfs:label goldbook:13007 "chronic lymphocytic leukemia")
AnnotationAssertion(dcterms:description goldbook:13007 "B cell tumor found in the blood.")
Declaration(Class(goldbook:13008))
AnnotationAssertion(rdfs:label goldbook:13008 "chronic myelogenous leukemia")
AnnotationAssertion(dcterms:description goldbook:13008 "Cancer characterized by overgrowth of the bone marrow with malignant white blood cells, usually exhibiting a chromosomal abnormality (Philadelphia chromosome), which causes uncontrolled proliferation of cells that are released into peripheral blood.")
Declaration(Class(goldbook:13009))
AnnotationAssertion(rdfs:label goldbook:13009 "chronic rejection")
AnnotationAssertion(dcterms:description goldbook:13009 "Immunologically triggered reaction occurring in a transplanted organ or tissue, leading to progressive destruction and finally failure of the transplanted organ occurring two months to many years after transplantation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13009 "chronic graft rejection")
Declaration(Class(goldbook:13010))
AnnotationAssertion(rdfs:label goldbook:13010 "class switching")
AnnotationAssertion(dcterms:description goldbook:13010 "Process by which a B cell changes the class but not specificity of a given antibody it produces, e.g., switching from an immunoglobulin M (IgM) to an immunoglobulin G (IgG) antibody.")
Declaration(Class(goldbook:13011))
AnnotationAssertion(rdfs:label goldbook:13011 "classical pathway")
AnnotationAssertion(dcterms:description goldbook:13011 "Activation pathway involving complement components C1, C2, and C4 which, following fixation of C1q, e.g., by antigen-antibody complexes, produces the classical pathway C3 convertase C4b2a.")
Declaration(Class(goldbook:13012))
AnnotationAssertion(rdfs:label goldbook:13012 "clonal anergy")
AnnotationAssertion(dcterms:description goldbook:13012 "Form of self-tolerance developing as a consequence of negative selection during thymic selection processes. Clones of thymocytes whose antigen receptors [T-cell receptors (TCRs)] bind with high affinity to self-antigens in association with major histocompatibility complex (MHC) molecules are inactivated.")
Declaration(Class(goldbook:13013))
AnnotationAssertion(rdfs:label goldbook:13013 "clonal deletion")
AnnotationAssertion(dcterms:description goldbook:13013 "Process by which contact with antigen (e.g., self-antigen) at an early stage of lymphocyte differentiation leads to cell death by apoptosis.")
Declaration(Class(goldbook:13014))
AnnotationAssertion(rdfs:label goldbook:13014 "clonal expansion")
AnnotationAssertion(dcterms:description goldbook:13014 "Proliferation of B lymphocytes and T lymphocytes activated by clonal selection in order to produce a clone of identical cells.")
Declaration(Class(goldbook:13015))
AnnotationAssertion(rdfs:label goldbook:13015 "clonal indifference")
AnnotationAssertion(dcterms:description goldbook:13015 "Failure of B or T cells expressing anti-self-receptors to interact with antigen (e.g., by low valency, low concentration, or sequestration of antigens; low receptor avidity; or lack of co-stimulatory molecules).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13015 "clonal ignorance")
Declaration(Class(goldbook:13016))
AnnotationAssertion(rdfs:label goldbook:13016 "clonal selection")
AnnotationAssertion(dcterms:description goldbook:13016 "Selection and activation by antigen of a lymphocyte, bearing a complementary receptor, which then proliferates to form an expanded clone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13016 "selection theory (in immunology)")
Declaration(Class(goldbook:13017))
AnnotationAssertion(rdfs:label goldbook:13017 "cluster determinant")
AnnotationAssertion(dcterms:description goldbook:13017 "Cluster of antigens representing a cell surface marker with which antibodies react. Not to be confused with cluster of differentiation (CD) antigen.")
Declaration(Class(goldbook:13018))
AnnotationAssertion(rdfs:label goldbook:13018 "cluster of differentiation antigen")
AnnotationAssertion(dcterms:description goldbook:13018 "Any of a family of molecular markers on cell surfaces that may be used operationally to define phenotype, origin, and activation state of the cell.")
Declaration(Class(goldbook:13019))
AnnotationAssertion(rdfs:label goldbook:13019 "coagulation system")
AnnotationAssertion(dcterms:description goldbook:13019 "Proteolytic cascade of plasma enzymes that triggers blood clotting when blood vessels are damaged.")
Declaration(Class(goldbook:13020))
AnnotationAssertion(rdfs:label goldbook:13020 "cognate T cell")
AnnotationAssertion(dcterms:description goldbook:13020 "Helper T lymphocyte (Th) primed by the same antigen as the B cell to which it gives help.")
Declaration(Class(goldbook:13021))
AnnotationAssertion(rdfs:label goldbook:13021 "cold autoantibody type")
AnnotationAssertion(dcterms:description goldbook:13021 "Autoantibody that reacts optimally at low temperatures (\\(\\pu{{0}{-}{5} ^{\\circ}C}\\)) with surface antigens of erythrocytes.")
Declaration(Class(goldbook:13022))
AnnotationAssertion(rdfs:label goldbook:13022 "collagen arthritis")
AnnotationAssertion(dcterms:description goldbook:13022 "Autoimmune model of rheumatoid arthritis (RA), arising from combined cellular immunity and humoral immunity against collagen type II, and characterized by rapid and severe erosions of cartilage and bone.")
Declaration(Class(goldbook:13023))
AnnotationAssertion(rdfs:label goldbook:13023 "collectin")
AnnotationAssertion(dcterms:description goldbook:13023 "Any member of a structurally related family of calcium-dependent carbohydrate-binding proteins or lectins containing collagen-like sequences, e.g., mannose-binding lectin (MBL).")
Declaration(Class(goldbook:13024))
AnnotationAssertion(rdfs:label goldbook:13024 "colony-stimulating factor")
AnnotationAssertion(dcterms:description goldbook:13024 "Factor that permits the proliferation and differentiation of hematopoietic cells.")
Declaration(Class(goldbook:13025))
AnnotationAssertion(rdfs:label goldbook:13025 "combinatorial diversity")
AnnotationAssertion(dcterms:description goldbook:13025 "Component of antibody and T-cell receptor (TCR) diversity that is generated by the recombination of variable (V), diversity (\\(D\\), for immunoglobulin heavy chains, and for TCR \\(\\upbeta\\) and \\(\\ce{\\updelta\\ chains}\\)), and joining (J) gene segments.")
Declaration(Class(goldbook:13026))
AnnotationAssertion(rdfs:label goldbook:13026 "combinatorial joining")
AnnotationAssertion(dcterms:description goldbook:13026 "Merging of DNA segments generating new genetic information.")
Declaration(Class(goldbook:13027))
AnnotationAssertion(rdfs:label goldbook:13027 "common variable immunodeficiency")
AnnotationAssertion(dcterms:description goldbook:13027 "Relatively common deficiency in antibody production, of unknown pathogenesis but strongly associated with genes mapping within the major histocompatibility complex (MHC).")
Declaration(Class(goldbook:13028))
AnnotationAssertion(rdfs:label goldbook:13028 "competitive inhibition assay")
AnnotationAssertion(dcterms:description goldbook:13028 "Method of measuring an antigen in a sample using a labeled species of the antigen as a competitive inhibitor of its binding in a specific antigen–antibody reaction.")
Declaration(Class(goldbook:13029))
AnnotationAssertion(rdfs:label goldbook:13029 "complementarity-determining region")
AnnotationAssertion(dcterms:description goldbook:13029 "Hypervariable amino acid sequence within antibody and T-cell receptor (TCR) variable (V) regions, which interacts with complementary amino acids on the antigen or major histocompatibility complex (MHC)–peptide complex.")
Declaration(Class(goldbook:13030))
AnnotationAssertion(rdfs:label goldbook:13030 "complement deficiency")
AnnotationAssertion(dcterms:description goldbook:13030 "Congenital deficiency in any of the various components of the complement system.")
Declaration(Class(goldbook:13031))
AnnotationAssertion(rdfs:label goldbook:13031 "complement reaction")
AnnotationAssertion(dcterms:description goldbook:13031 "Physiological reaction to the presence of a foreign microorganism in which a cascade of enzymatic reactions, triggered by molecular features of the microorganism, result in lysis or phagocytosis of the foreign material.")
Declaration(Class(goldbook:13032))
AnnotationAssertion(rdfs:label goldbook:13032 "complement receptor")
AnnotationAssertion(dcterms:description goldbook:13032 "Cell-surface protein that recognizes and binds complement proteins that have bound an antigen.")
Declaration(Class(goldbook:13033))
AnnotationAssertion(rdfs:label goldbook:13033 "complement system")
AnnotationAssertion(dcterms:description goldbook:13033 "Group of serum proteins with the capacity to interact with each other when activated in a chain reaction which results in formation of a lytic complex and the release of several biologically active peptides of low relative molecular mass (anaphylatoxins).")
Declaration(Class(goldbook:13034))
AnnotationAssertion(rdfs:label goldbook:13034 "concanavalin A")
AnnotationAssertion(dcterms:description goldbook:13034 "Hemagglutinin, isolated from jack bean (Canavalia ensiformis) meal, which reacts with polyglucosans in the blood of mammals, causing agglutination.")
Declaration(Class(goldbook:13035))
AnnotationAssertion(rdfs:label goldbook:13035 "conformational epitope")
AnnotationAssertion(dcterms:description goldbook:13035 "Epitope on a protein antigen formed from several separate regions in the primary sequence of a protein brought together by protein folding.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13035 "discontinuous epitope")
Declaration(Class(goldbook:13036))
AnnotationAssertion(rdfs:label goldbook:13036 "congenic")
AnnotationAssertion(dcterms:description goldbook:13036 "Differing at a single genetic locus.")
Declaration(Class(goldbook:13037))
AnnotationAssertion(rdfs:label goldbook:13037 "allergic conjunctivitis")
AnnotationAssertion(dcterms:description goldbook:13037 "Irritation of the ocular conjunctiva, resulting from the activation of conjunctival mast cells by airborne allergens such as pollens or house dust.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13037 "allergic conjunctivitis")
Declaration(Class(goldbook:13038))
AnnotationAssertion(rdfs:label goldbook:13038 "constant gene")
AnnotationAssertion(dcterms:description goldbook:13038 "Gene that encodes the constant (C) region of immunoglobulin (Ig) chains or T-cell receptor (TCR) chains.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13038 "C gene")
Declaration(Class(goldbook:13039))
AnnotationAssertion(rdfs:label goldbook:13039 "constant region")
AnnotationAssertion(dcterms:description goldbook:13039 "Part of an immunoglobulin (Ig) or T-cell receptor (TCR) that is relatively constant in amino acid sequence among different Ig or TCR molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13039 "C region")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13039 "constant (C) region")
Declaration(Class(goldbook:13040))
AnnotationAssertion(rdfs:label goldbook:13040 "contact allergen")
AnnotationAssertion(dcterms:description goldbook:13040 "Substance that causes a skin hypersensitivity reaction by direct contact.")
Declaration(Class(goldbook:13041))
AnnotationAssertion(rdfs:label goldbook:13041 "contact dermatitis")
AnnotationAssertion(dcterms:description goldbook:13041 "Skin inflammation that occurs when the skin’s surface comes in contact with a substance originating outside the body.")
Declaration(Class(goldbook:13042))
AnnotationAssertion(rdfs:label goldbook:13042 "contact hypersensitivity")
AnnotationAssertion(dcterms:description goldbook:13042 "Immune response following skin contact with an antigen.")
Declaration(Class(goldbook:13043))
AnnotationAssertion(rdfs:label goldbook:13043 "contact sensitivity")
AnnotationAssertion(dcterms:description goldbook:13043 "State of immunological sensitization in which an eczematous epidermal reaction may occur when a hapten is applied to the skin of a sensitized individual.")
Declaration(Class(goldbook:13044))
AnnotationAssertion(rdfs:label goldbook:13044 "contact urticaria")
AnnotationAssertion(dcterms:description goldbook:13044 "Urticaria provoked by contact with inducing agents.")
Declaration(Class(goldbook:13045))
AnnotationAssertion(rdfs:label goldbook:13045 "conventional dendritic cell")
AnnotationAssertion(dcterms:description goldbook:13045 "Predominant type of dendritic cell active in antigen presentation to and activation of naïve T cells.")
Declaration(Class(goldbook:13046))
AnnotationAssertion(rdfs:label goldbook:13046 "convergent evolution")
AnnotationAssertion(dcterms:description goldbook:13046 "Independent evolution of similarity between molecules or between species.")
Declaration(Class(goldbook:13047))
AnnotationAssertion(rdfs:label goldbook:13047 "convertase")
AnnotationAssertion(dcterms:description goldbook:13047 "Enzyme activity that converts complement protein into its reactive form by cleaving it.")
Declaration(Class(goldbook:13048))
AnnotationAssertion(rdfs:label goldbook:13048 "Coombs test")
AnnotationAssertion(dcterms:description goldbook:13048 "Diagnostic test using anti-immunoglobulin (Ig) to agglutinate antibody-coated erythrocytes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13048 "direct antiglobulin test (DAT)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13048 "direct Coombs test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13048 "indirect antiglobulin test (IAT)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13048 "indirect Coombs test")
Declaration(Class(goldbook:13049))
AnnotationAssertion(rdfs:label goldbook:13049 "coreceptor")
AnnotationAssertion(dcterms:description goldbook:13049 "Cell surface protein receptor that recognizes a substance bound to a primary receptor, and binds to a signaling molecule that thereby enhances the activity of another receptor.")
Declaration(Class(goldbook:13050))
AnnotationAssertion(rdfs:label goldbook:13050 "corticosteroid")
AnnotationAssertion(dcterms:description goldbook:13050 "Any of the family of steroid molecules that are produced in the adrenal cortex, or their synthetic analogs.")
Declaration(Class(goldbook:13051))
AnnotationAssertion(rdfs:label goldbook:13051 "co-stimulation")
AnnotationAssertion(dcterms:description goldbook:13051 "Delivery of a second signal, in addition to that of antigen binding or antigen presentation, that is required for lymphocyte proliferation.")
Declaration(Class(goldbook:13052))
AnnotationAssertion(rdfs:label goldbook:13052 "counter-regulation hypothesis")
AnnotationAssertion(dcterms:description goldbook:13052 "Hypothesis that all types of infection early in childhood may protect against the development of atopy by driving the production of cytokines such as interleukin-10 (IL-10) and transforming growth factor $\\ce{\\upbeta\\!}$ ($\\ce{TGF\\mbox{-}\\upbeta\\!}$), which downregulate both Th1 and Th2 responses.")
Declaration(Class(goldbook:13053))
AnnotationAssertion(rdfs:label goldbook:13053 "Crohn disease")
AnnotationAssertion(dcterms:description goldbook:13053 "Chronic inflammatory bowel disease (IBD) thought to result from an abnormal overresponsiveness to commensal gut flora.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13053 "Crohn's disease")
Declaration(Class(goldbook:13054))
AnnotationAssertion(rdfs:label goldbook:13054 "cross-matching")
AnnotationAssertion(dcterms:description goldbook:13054 """1) Test for determining the compatibility between the blood of a donor and that of a recipient before transfusion; the clumping of erythrocytes indicates incompatibility.
2) Test for determining tissue compatibility between a transplant donor and the recipient before transplantation, in which the recipient’s serum is tested for antibodies that may react with the lymphocytes or other cells of the donor.
3) Process of performing one of these tests.""")
Declaration(Class(goldbook:13055))
AnnotationAssertion(rdfs:label goldbook:13055 "cross-presentation")
AnnotationAssertion(dcterms:description goldbook:13055 "Activation of CD8+ lymphocytes by the presentation of exogenous antigens in association with major histocompatibility complex (MHC) class I molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13055 "cross-priming")
Declaration(Class(goldbook:13056))
AnnotationAssertion(rdfs:label goldbook:13056 "cross-reacting antibody")
AnnotationAssertion(dcterms:description goldbook:13056 "Antibody that is able to react with an antigen that did not specifically stimulate its production.")
Declaration(Class(goldbook:13057))
AnnotationAssertion(rdfs:label goldbook:13057 "cross-reacting antigen")
AnnotationAssertion(dcterms:description goldbook:13057 """Antigen that is able to react with an antibody induced by a different antigen.
Note: The two antigens may share the same antigenic determinants or carry determinants that are sufficiently alike stereochemically to enable the antibody to react with both.
Antigen that has an identical structure in two strains of microorganism, so that antibody raised against one strain will react with the other strain.""")
Declaration(Class(goldbook:13058))
AnnotationAssertion(rdfs:label goldbook:13058 "cross sensitivity")
AnnotationAssertion(dcterms:description goldbook:13058 "State of immunological hypersensitivity to one substance that predisposes an individual to sensitivity to other substances that are related in chemical structure (cross-reacting antigens).")
Declaration(Class(goldbook:13059))
AnnotationAssertion(rdfs:label goldbook:13059 "cross-tolerance")
AnnotationAssertion(dcterms:description goldbook:13059 "State of immunological tolerance to one substance produced by priming an animal with another substance that bears a cross-reacting antigen.")
Declaration(Class(goldbook:13060))
AnnotationAssertion(rdfs:label goldbook:13060 "cryoglobulin")
AnnotationAssertion(dcterms:description goldbook:13060 "Immunoglobulin (Ig) that forms insoluble aggregates at temperatures below body temperature.")
Declaration(Class(goldbook:13061))
AnnotationAssertion(rdfs:label goldbook:13061 "cryoglobulinemic vasculitis")
AnnotationAssertion(dcterms:description goldbook:13061 "Cutaneous or systemic vasculitis caused by cold-labile proteins (cryoglobulins, cryofibrinogen) that leads to increased viscosity, protein precipitation or gelatinification, complement activation, and endothelial cell damage, especially in the cold.")
Declaration(Class(goldbook:13062))
AnnotationAssertion(rdfs:label goldbook:13062 "cryptic epitope")
AnnotationAssertion(dcterms:description goldbook:13062 "Epitope that cannot be recognized by a lymphocyte receptor until the antigen has been broken down and processed or modified by hapten binding.")
Declaration(Class(goldbook:13063))
AnnotationAssertion(rdfs:label goldbook:13063 "cutaneous lymphocyte antigen")
AnnotationAssertion(dcterms:description goldbook:13063 "Cell-surface molecule that is involved in lymphocyte homing to the skin in humans.")
Declaration(Class(goldbook:13064))
AnnotationAssertion(rdfs:label goldbook:13064 "cutaneous T-cell lymphoma")
AnnotationAssertion(dcterms:description goldbook:13064 "Malignant growth of T cells that home to the skin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13064 "mycosis fungoides")
Declaration(Class(goldbook:13065))
AnnotationAssertion(rdfs:label goldbook:13065 "cytokine")
AnnotationAssertion(dcterms:description goldbook:13065 "Any of a group of soluble small proteins released from a variety of cells, typically of the immune system, that affect cell behavior in an autocrine or paracrine fashion.")
Declaration(Class(goldbook:13066))
AnnotationAssertion(rdfs:label goldbook:13066 "cytokine capture assay")
AnnotationAssertion(dcterms:description goldbook:13066 "Method to detect cytokine release by injecting an animal with a neutralizing biotinylated antibody to the cytokine, which inhibits its utilization and allows its accumulation in the blood. Recovered cytokineantibody complexes are then measured in an enzyme-linked immunosorbent assay (ELISA) with an antibody to a second epitope on the cytokine.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13066 "<i>in vivo</i> cytokine capture assay (IVCCA)")
Declaration(Class(goldbook:13067))
AnnotationAssertion(rdfs:label goldbook:13067 "cytokine profile")
AnnotationAssertion(dcterms:description goldbook:13067 "Characteristic pattern of cytokine production associated with a defined immunological state.")
Declaration(Class(goldbook:13068))
AnnotationAssertion(rdfs:label goldbook:13068 "cytokine release assay")
AnnotationAssertion(dcterms:description goldbook:13068 "Method of quantifying cytokines released by viable cells, using cytokine-specific antibodies.")
Declaration(Class(goldbook:13069))
AnnotationAssertion(rdfs:label goldbook:13069 "immune cytolysis")
AnnotationAssertion(dcterms:description goldbook:13069 """1) Cell lysis caused by a lesion produced by the action of complement proteins on the antibody-coated plasma membrane of a cell.
2) Cell lysis following plasma membrane reaction with perforins released by natural killer (NK) cells.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13069 "immune cytolysis")
Declaration(Class(goldbook:13070))
AnnotationAssertion(rdfs:label goldbook:13070 "cytopenia")
AnnotationAssertion(dcterms:description goldbook:13070 "Decrease in the number of one or more types of blood cells.")
Declaration(Class(goldbook:13071))
AnnotationAssertion(rdfs:label goldbook:13071 "cytotoxic")
AnnotationAssertion(dcterms:description goldbook:13071 "Causing damage to cell structure or function.")
Declaration(Class(goldbook:13072))
AnnotationAssertion(rdfs:label goldbook:13072 "cytotoxic T lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13072 "Any of a subset of T lymphocytes bearing the CD8 surface marker and able to kill target cells [infected somatic or tumor cells, recognized by the antigen receptor complex (TCR/CD3)] after induction of a specific immune response to the antigens bound to major histocompatibility complex (MHC) class I molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13072 "CD8+ T cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13072 "cytolytic T cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13072 "cytotoxic T cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13072 "killer T cell")
Declaration(Class(goldbook:13073))
AnnotationAssertion(rdfs:label goldbook:13073 "cytotoxic T lymphocyte antigen 4")
AnnotationAssertion(dcterms:description goldbook:13073 "High affinity receptor for B7 molecules expressed on T cells, binding of which inhibits T cell activation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13073 "CD152")
Declaration(Class(goldbook:13074))
AnnotationAssertion(rdfs:label goldbook:13074 "cytotoxic T lymphocyte assay")
AnnotationAssertion(dcterms:description goldbook:13074 "Assay based on quantitation of cell death caused by sensitized lymphocytes or splenocytes cultured with a fixed number of tumor or other target cells that have been prelabeled with \\(\\ce{^{51}Cr}\\). The \\(\\ce{^{51}Cr}\\) is taken up and reversibly binds to cytosolic proteins. When these target cells are incubated with sensitized lymphocytes, the target cells are killed and the \\(\\ce{^{51}Cr}\\) is released.")
Declaration(Class(goldbook:13075))
AnnotationAssertion(rdfs:label goldbook:13075 "cytotoxin")
AnnotationAssertion(dcterms:description goldbook:13075 "Substance with a specific toxic effect on certain cells.")
Declaration(Class(goldbook:13076))
AnnotationAssertion(rdfs:label goldbook:13076 "DEC-205")
AnnotationAssertion(dcterms:description goldbook:13076 "Surface antigen characteristic of dendritic cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13076 "CD205")
Declaration(Class(goldbook:13077))
AnnotationAssertion(rdfs:label goldbook:13077 "DNA vaccination")
AnnotationAssertion(dcterms:description goldbook:13077 "Injection of DNA into muscle, followed by its transcription and translation into a protein or proteins that elicit antibody and T-cell responses.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13077 "DNA immunization")
Declaration(Class(goldbook:13078))
AnnotationAssertion(rdfs:label goldbook:13078 "DP, DQ, and DR molecules")
AnnotationAssertion(dcterms:description goldbook:13078 "Major histocompatibility complex (MHC) class II molecules occurring on human B lymphocytes and antigen-presenting cells (APCs).")
Declaration(Class(goldbook:13079))
AnnotationAssertion(rdfs:label goldbook:13079 "danger hypothesis")
AnnotationAssertion(dcterms:description goldbook:13079 "Hypothesis that suggests it is not foreignness of a molecule per se but rather its ability to cause cell damage or stress that induces an immune response. Often implicated in causation of idiosyncratic drug reactions.")
Declaration(Class(goldbook:13080))
AnnotationAssertion(rdfs:label goldbook:13080 "death receptor")
AnnotationAssertion(dcterms:description goldbook:13080 "Cell-surface receptor whose binding to extracellular ligands stimulates apoptosis in the receptor-bearing cell through the extrinsic pathway.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13080 "death ligand receptor")
Declaration(Class(goldbook:13081))
AnnotationAssertion(rdfs:label goldbook:13081 "death domain")
AnnotationAssertion(dcterms:description goldbook:13081 "Protein-interaction domain originally discovered in proteins involved in programmed cell death or apoptosis.")
Declaration(Class(goldbook:13082))
AnnotationAssertion(rdfs:label goldbook:13082 "decay-accelerating factor")
AnnotationAssertion(dcterms:description goldbook:13082 "Cell-surface molecule that protects cells from lysis by complement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13082 "CD55")
Declaration(Class(goldbook:13083))
AnnotationAssertion(rdfs:label goldbook:13083 "defensin")
AnnotationAssertion(dcterms:description goldbook:13083 "Any member of a family of oligopeptides made within the body, notably by neutrophils and macrophages, and having potent antimicrobial properties.")
Declaration(Class(goldbook:13084))
AnnotationAssertion(rdfs:label goldbook:13084 "degranulation")
AnnotationAssertion(dcterms:description goldbook:13084 "Cell reaction that releases antimicrobial cytotoxic molecules and other substances (e.g., histamine) from secretory vesicles called granules found inside some cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13084 "mast cell degranulation")
Declaration(Class(goldbook:13085))
AnnotationAssertion(rdfs:label goldbook:13085 "delayed-type hypersensitivity")
AnnotationAssertion(dcterms:description goldbook:13085 "Form of T cell-mediated immunity in which the ultimate effector cell is the activated mononuclear phagocyte (macrophage); the response of DTH appears fully over \\(\\pu{24}\\) to \\(\\pu{48 h}\\). Previous exposure is required.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13085 "Gell and Coombs Type IV reaction")
Declaration(Class(goldbook:13086))
AnnotationAssertion(rdfs:label goldbook:13086 "delayed-type hypersensitivity assay")
AnnotationAssertion(dcterms:description goldbook:13086 "In vivo assay of cell-mediated immune response, elicited by antigen in the skin and mediated by CD4+ Th1 cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13086 "DTH assay")
Declaration(Class(goldbook:13087))
AnnotationAssertion(rdfs:label goldbook:13087 "dendritic cell")
AnnotationAssertion(dcterms:description goldbook:13087 "Ameboid cell that is major histocompatibility complex (MHC) class II-positive, Fc receptor-negative, and presents processed antigens to T cells in the T-cell areas of secondary lymphoid tissues.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13087 "interdigitating dendritic cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13087 "interdigitating reticular cell")
Declaration(Class(goldbook:13088))
AnnotationAssertion(rdfs:label goldbook:13088 "immune complex deposition")
AnnotationAssertion(dcterms:description goldbook:13088 "Precipitation of immune complex in organs and tissues, often causing local inflammation.")
Declaration(Class(goldbook:13089))
AnnotationAssertion(rdfs:label goldbook:13089 "dermatitis")
AnnotationAssertion(dcterms:description goldbook:13089 "Inflammation of the skin showing redness, swelling, infiltration, scaling, and sometimes vesicles and blisters: contact dermatitis is due to local exposure and may be caused by irritation, allergy, or photocontact dermatitis.")
Declaration(Class(goldbook:13090))
AnnotationAssertion(rdfs:label goldbook:13090 "dermatomyositis")
AnnotationAssertion(dcterms:description goldbook:13090 "Disease characterized by the presence of inflammation of the skin and muscles.")
Declaration(Class(goldbook:13091))
AnnotationAssertion(rdfs:label goldbook:13091 "desensitization")
AnnotationAssertion(dcterms:description goldbook:13091 "Generally transient state of specific non-reactivity in a previously sensitized individual, resulting from repeated antigen exposures.")
Declaration(Class(goldbook:13092))
AnnotationAssertion(rdfs:label goldbook:13092 "diabetes mellitus type 1")
AnnotationAssertion(dcterms:description goldbook:13092 "Disease in which the \\(\\ce{\\upbeta\\ cells}\\) of the pancreatic islets of Langerhans are destroyed with the result that no insulin is produced.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13092 "diabetes mellitus")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13092 "insulin-dependent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13092 "insulin-dependent diabetes mellitus (IDDM)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13092 "type 1 diabetes mellitus")
Declaration(Class(goldbook:13093))
AnnotationAssertion(rdfs:label goldbook:13093 "diapedesis")
AnnotationAssertion(dcterms:description goldbook:13093 "Movement of blood cells, particularly leukocytes, from the blood across blood vessel walls into tissues.")
Declaration(Class(goldbook:13094))
AnnotationAssertion(rdfs:label goldbook:13094 "differential")
AnnotationAssertion(dcterms:description goldbook:13094 "Reported blood count that distinguishes the percentages of the different blood cells present.")
Declaration(Class(goldbook:13095))
AnnotationAssertion(rdfs:label goldbook:13095 "differential splicing")
AnnotationAssertion(dcterms:description goldbook:13095 "Utilization and splicing of different exons from a primary RNA transcript in order to generate different mRNA sequences.")
Declaration(Class(goldbook:13096))
AnnotationAssertion(rdfs:label goldbook:13096 "differentiation antigen")
AnnotationAssertion(dcterms:description goldbook:13096 "Cell surface molecule expressed at a particular stage of development or on cells of a given lineage.")
Declaration(Class(goldbook:13097))
AnnotationAssertion(rdfs:label goldbook:13097 "disintegrin and metalloproteinase domain-containing protein 33")
AnnotationAssertion(dcterms:description goldbook:13097 "Member of the ADAM (A Disintegrin And Metalloproteinase domain) family of transmembrane proteins, possibly related to asthma susceptibility.")
Declaration(Class(goldbook:13098))
AnnotationAssertion(rdfs:label goldbook:13098 "diversity gene")
AnnotationAssertion(dcterms:description goldbook:13098 "Small segment of immunoglobulin (Ig) heavy-chain or T-cell receptor DNA between the variable (V) gene and joining (J) gene segments, coding for the third hypervariable region of the receptors.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13098 "D gene")
Declaration(Class(goldbook:13099))
AnnotationAssertion(rdfs:label goldbook:13099 "domain")
AnnotationAssertion(dcterms:description goldbook:13099 "Structural element of a polypeptide.")
Declaration(Class(goldbook:13100))
AnnotationAssertion(rdfs:label goldbook:13100 "dot plot")
AnnotationAssertion(dcterms:description goldbook:13100 "Two-dimensional graphical representation of individual data points.")
Declaration(Class(goldbook:13101))
AnnotationAssertion(rdfs:label goldbook:13101 "double-negative cell")
AnnotationAssertion(dcterms:description goldbook:13101 "Immature T cell in the thymus that lacks expression of the two coreceptors, CD4 and CD8.")
Declaration(Class(goldbook:13102))
AnnotationAssertion(rdfs:label goldbook:13102 "double-positive cell")
AnnotationAssertion(dcterms:description goldbook:13102 "Immature T cell in the thymus that is characterized by expression of both CD4 and CD8 coreceptor proteins.")
Declaration(Class(goldbook:13103))
AnnotationAssertion(rdfs:label goldbook:13103 "draining lymph node")
AnnotationAssertion(dcterms:description goldbook:13103 "Lymph node that is downstream of a site of infection and thus receives antigens and microbes from the site via the lymphatic system.")
Declaration(Class(goldbook:13104))
AnnotationAssertion(rdfs:label goldbook:13104 "Draize test")
AnnotationAssertion(dcterms:description goldbook:13104 """Context: ocular; Test for potential to cause irritation to the eye in which the test substance is applied directly to the eye of restrained rabbits.
Note: Widely criticized as unethical. Now often replaced with an acute eye irritation test using cadaveric chicken eyes.
Context: skin; Test for the potential of a material to cause irritation or corrosion following local dermal application. Generally performed with rabbits.""")
Declaration(Class(goldbook:13105))
AnnotationAssertion(rdfs:label goldbook:13105 "drug-induced autoimmunity")
AnnotationAssertion(dcterms:description goldbook:13105 "Immune-mediated idiosyncratic drug reaction against self-antigens.")
Declaration(Class(goldbook:13106))
AnnotationAssertion(rdfs:label goldbook:13106 "drug-induced lupus")
AnnotationAssertion(dcterms:description goldbook:13106 "Idiosyncratic drug reaction similar in character to systemic lupus erythematosus (SLE) and having antinuclear antibodies (ANA), but generally milder in nature and resolving when drug exposure is discontinued.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13106 "lupus-like syndrome")
Declaration(Class(goldbook:13107))
AnnotationAssertion(rdfs:label goldbook:13107 "eczema")
AnnotationAssertion(dcterms:description goldbook:13107 "Acute or chronic skin inflammation with erythema, papules, vesicles, pustules, scales, crusts, or scabs, alone or in combination, of varied etiology.")
Declaration(Class(goldbook:13108))
AnnotationAssertion(rdfs:label goldbook:13108 "effector cell")
AnnotationAssertion(dcterms:description goldbook:13108 "Cell that carries out an immune function, e.g., cytokine release, cytotoxicity.")
Declaration(Class(goldbook:13109))
AnnotationAssertion(rdfs:label goldbook:13109 "elicitation")
AnnotationAssertion(dcterms:description goldbook:13109 "Production of a cell-mediated or antibody-mediated allergic response by exposure of a sensitized individual to an allergen.")
Declaration(Class(goldbook:13110))
AnnotationAssertion(rdfs:label goldbook:13110 "endogenous")
AnnotationAssertion(dcterms:description goldbook:13110 "Produced within or caused by factors within an organism.")
Declaration(Class(goldbook:13111))
AnnotationAssertion(rdfs:label goldbook:13111 "endosome")
AnnotationAssertion(dcterms:description goldbook:13111 "Intracellular smooth surfaced vesicle in which endocytosed material passes on its way to the lysosomes.")
Declaration(Class(goldbook:13112))
AnnotationAssertion(rdfs:label goldbook:13112 "endotoxin")
AnnotationAssertion(dcterms:description goldbook:13112 "Pathogenic cell wall-associated lipopolysaccharides of Gram-negative bacteria.")
Declaration(Class(goldbook:13113))
AnnotationAssertion(rdfs:label goldbook:13113 "enhancing antibody")
AnnotationAssertion(dcterms:description goldbook:13113 "Antibody that binds to an antibody-antigen complex or idiotypic-anti-idiotypic antibody complex and strengthens the interaction.")
Declaration(Class(goldbook:13114))
AnnotationAssertion(rdfs:label goldbook:13114 "enterotoxin")
AnnotationAssertion(dcterms:description goldbook:13114 "Toxin affecting intestinal cells and thus causing food poisoning.")
Declaration(Class(goldbook:13115))
AnnotationAssertion(rdfs:label goldbook:13115 "enzyme-linked immunosorbent assay")
AnnotationAssertion(dcterms:description goldbook:13115 "Procedure for detection or quantitation of an antibody or antigen using a ligand (e.g., an anti-immunoglobulin) conjugated to an enzyme that changes the color of a substrate.")
Declaration(Class(goldbook:13116))
AnnotationAssertion(rdfs:label goldbook:13116 "enzyme-linked immunospot assay")
AnnotationAssertion(dcterms:description goldbook:13116 "Adaptation of enzyme-linked immunosorbent assay (ELISA) in which cells are placed over antibodies or antigens attached to a plastic surface. The antigen or antibody traps the cells’ secreted products, which can then be detected using an enzyme-coupled antibody that cleaves a colorless substrate to make a localized colored spot. This allows quantitation of the number of cells producing a given product such as a cytokine.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13116 "ELISPOT assay")
Declaration(Class(goldbook:13117))
AnnotationAssertion(rdfs:label goldbook:13117 "eosinophil")
AnnotationAssertion(dcterms:description goldbook:13117 "Circulating granular leukocyte (granulocyte) having prominent granules that stain specifically by eosin and containing numerous lysosomes.")
Declaration(Class(goldbook:13118))
AnnotationAssertion(rdfs:label goldbook:13118 "eosinophil chemotactic factor of anaphylaxis")
AnnotationAssertion(dcterms:description goldbook:13118 "Cytokine that facilitates anaphylaxis and attracts eosinophils during substrate release by mast cells.")
Declaration(Class(goldbook:13119))
AnnotationAssertion(rdfs:label goldbook:13119 "eotaxin")
AnnotationAssertion(dcterms:description goldbook:13119 "CC chemokine that acts predominantly on eosinophils.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13119 "CCL11")
Declaration(Class(goldbook:13120))
AnnotationAssertion(rdfs:label goldbook:13120 "epitope retrieval")
AnnotationAssertion(dcterms:description goldbook:13120 "Treatment of denatured antigen with heat or other agents in order to regenerate (unmask) lost antibody-binding capacity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13120 "antigen retrieval")
Declaration(Class(goldbook:13121))
AnnotationAssertion(rdfs:label goldbook:13121 "epitope spreading")
AnnotationAssertion(dcterms:description goldbook:13121 "Increase in the number of epitopes targeted by autoantibodies and/or T cells. The epitopes may be on the same autoantigen (intramolecular epitope spreading) and/or on other autoantigens (intermolecular epitope spreading).")
Declaration(Class(goldbook:13122))
AnnotationAssertion(rdfs:label goldbook:13122 "Epstein–Barr virus")
AnnotationAssertion(dcterms:description goldbook:13122 "Virus responsible for infectious mononucleosis and Burkitt’s lymphoma. This virus is used to immortalize human B lymphocytes in vitro.")
Declaration(Class(goldbook:13123))
AnnotationAssertion(rdfs:label goldbook:13123 "equivalence")
AnnotationAssertion(dcterms:description goldbook:13123 "Ratio of antibody to antigen at which immunoprecipitation of the reactants is virtually complete.")
Declaration(Class(goldbook:13124))
AnnotationAssertion(rdfs:label goldbook:13124 "equivalence zone")
AnnotationAssertion(dcterms:description goldbook:13124 "Range of concentrations of antigen and antibody in which neither is in significant excess in a precipitin reaction.")
Declaration(Class(goldbook:13125))
AnnotationAssertion(rdfs:label goldbook:13125 "erythema")
AnnotationAssertion(dcterms:description goldbook:13125 "Redness of the skin produced by congestion of the capillaries.")
Declaration(Class(goldbook:13126))
AnnotationAssertion(rdfs:label goldbook:13126 "erythroblastosis fetalis")
AnnotationAssertion(dcterms:description goldbook:13126 "Two potentially disabling or fatal blood disorders in infants: Rhesus (Rh) factor incompatibility disease and ABO blood group incompatibility disease.")
Declaration(Class(goldbook:13127))
AnnotationAssertion(rdfs:label goldbook:13127 "erythrocyte")
AnnotationAssertion(dcterms:description goldbook:13127 "Red blood cell.")
Declaration(Class(goldbook:13128))
AnnotationAssertion(rdfs:label goldbook:13128 "erythropoiesis")
AnnotationAssertion(dcterms:description goldbook:13128 "Erythrocyte production.")
Declaration(Class(goldbook:13129))
AnnotationAssertion(rdfs:label goldbook:13129 "erythropoietin")
AnnotationAssertion(dcterms:description goldbook:13129 "Glycoprotein hormone that stimulates the production of erythrocytes by stem cells in bone marrow.")
Declaration(Class(goldbook:13130))
AnnotationAssertion(rdfs:label goldbook:13130 "euglobulin")
AnnotationAssertion(dcterms:description goldbook:13130 "Member of a class of proteins insoluble in water but soluble in saline solutions.")
Declaration(Class(goldbook:13131))
AnnotationAssertion(rdfs:label goldbook:13131 "exocytosis")
AnnotationAssertion(dcterms:description goldbook:13131 "Release of the content of an intracellular vesicle to the exterior of the cell.")
Declaration(Class(goldbook:13132))
AnnotationAssertion(rdfs:label goldbook:13132 "exotoxin")
AnnotationAssertion(dcterms:description goldbook:13132 "Pathogenic protein secreted by bacteria.")
Declaration(Class(goldbook:13133))
AnnotationAssertion(rdfs:label goldbook:13133 "extravasation")
AnnotationAssertion(dcterms:description goldbook:13133 "Movement of cells or fluid from within blood vessels to the surrounding tissues.")
Declaration(Class(goldbook:13134))
AnnotationAssertion(rdfs:label goldbook:13134 "exudate")
AnnotationAssertion(dcterms:description goldbook:13134 "Extravascular fluid containing proteins and cellular debris that accumulates during inflammation.")
Declaration(Class(goldbook:13135))
AnnotationAssertion(rdfs:label goldbook:13135 "Fab fragment")
AnnotationAssertion(dcterms:description goldbook:13135 "Monovalent antigen-binding (‘ab’) fragment obtained following papain digestion of immunoglobulin (Ig). It consists of an intact light chain and the N-terminal VH and C H1 domains of the heavy chain.")
Declaration(Class(goldbook:13136))
AnnotationAssertion(rdfs:label goldbook:13136 "F(ab')2 fragment")
AnnotationAssertion(dcterms:description goldbook:13136 "Bivalent antigen-binding fragment obtained following pepsin digestion of immunoglobulin. Consists of both light chains and the N-terminal part of both heavy chains linked by disulfide bonds.")
Declaration(Class(goldbook:13137))
AnnotationAssertion(rdfs:label goldbook:13137 "Fc fragment")
AnnotationAssertion(dcterms:description goldbook:13137 "Crystallizable, non-antigen-binding fragment of an immunoglobulin (Ig) molecule obtained following papain digestion. Consists of the C-terminal portion of both heavy chains, responsible for binding to Fc receptors and complement factor C1q.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13137 "Fc region")
Declaration(Class(goldbook:13138))
AnnotationAssertion(rdfs:label goldbook:13138 "Fc receptor")
AnnotationAssertion(dcterms:description goldbook:13138 "Receptors expressed on a wide range of cells, interacting with the Fc portion of immunoglobulins (Ig) belonging to various isotypes.")
Declaration(Class(goldbook:13139))
AnnotationAssertion(rdfs:label goldbook:13139 "Fd fragment")
AnnotationAssertion(dcterms:description goldbook:13139 "Heavy chain portion of an immunoglobulin (Ig) N-terminal to the papain hydrolysis site, after reduction and separation of the light chain portion.")
Declaration(Class(goldbook:13140))
AnnotationAssertion(rdfs:label goldbook:13140 "fMLP peptide")
AnnotationAssertion(dcterms:description goldbook:13140 "Formyl-methionyl-leucyl-phenylalanine, a chemoattractant (see chemotactic factor, chemotaxis) derived from degradation of bacterial or mitochondrial proteins. It causes neutrophil activation.")
Declaration(Class(goldbook:13141))
AnnotationAssertion(rdfs:label goldbook:13141 "Foxp3")
AnnotationAssertion(dcterms:description goldbook:13141 "Transcription repressor that is specifically expressed in CD4+CD25+ T cells.")
Declaration(Class(goldbook:13142))
AnnotationAssertion(rdfs:label goldbook:13142 "Fv fragment")
AnnotationAssertion(dcterms:description goldbook:13142 "Variable (V) region fragment of an antibody heavy chain or light chain.")
Declaration(Class(goldbook:13143))
AnnotationAssertion(rdfs:label goldbook:13143 "familial cold autoinflammatory syndrome")
AnnotationAssertion(dcterms:description goldbook:13143 "Episodic autoinflammatory disease, induced by exposure to cold, and caused by mutations in the gene CSA1, encoding cryopyrin.")
Declaration(Class(goldbook:13144))
AnnotationAssertion(rdfs:label goldbook:13144 "familial hemophagocytic lymphohistiocytosis")
AnnotationAssertion(dcterms:description goldbook:13144 "Progressive and potentially lethal inflammatory disease caused by an inherited deficiency of perforin.")
Declaration(Class(goldbook:13145))
AnnotationAssertion(rdfs:label goldbook:13145 "farmer’s lung")
AnnotationAssertion(dcterms:description goldbook:13145 "Hypersensitivity disease caused by the interaction of immunoglobulin G (IgG) antibodies with large amounts of an inhaled allergen in the alveolar wall of the lung, causing alveolar wall inflammation and compromising gas exchange.")
Declaration(Class(goldbook:13146))
AnnotationAssertion(rdfs:label goldbook:13146 "Fas")
AnnotationAssertion(dcterms:description goldbook:13146 "Member of the tumor necrosis factor (TNF) receptor gene family. Engagement of Fas on the surface of the cell by the Fas ligand (CD178) present on cytotoxic cells can trigger apoptosis in the Fas-bearing target cell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13146 "CD95")
Declaration(Class(goldbook:13147))
AnnotationAssertion(rdfs:label goldbook:13147 "fetal antigens")
AnnotationAssertion(dcterms:description goldbook:13147 "Human cancer cell antigens, which cross-react serologically with antigens normally expressed by embryonic tissue, e.g., carcinoembryonic antigen (CEA), or $\\ce{\\upalpha\\!\\mbox{-}fetoprotein}$ (AFP).")
Declaration(Class(goldbook:13148))
AnnotationAssertion(rdfs:label goldbook:13148 "fetal tolerance")
AnnotationAssertion(dcterms:description goldbook:13148 "Lack of rejection of a fetal allograft carrying paternal major histocompatibility complex (MHC) and minor histocompatibility antigens that differ from those of the mother.")
Declaration(Class(goldbook:13149))
AnnotationAssertion(rdfs:label goldbook:13149 "fibrinolysis")
AnnotationAssertion(dcterms:description goldbook:13149 "Enzymatic lysis of a fibrin clot.")
Declaration(Class(goldbook:13150))
AnnotationAssertion(rdfs:label goldbook:13150 "fibrinolytic")
AnnotationAssertion(dcterms:description goldbook:13150 "Pertaining to, characterized by, or causing the breakdown of fibrin (fibrinolysis), usually by the action of plasmin.")
Declaration(Class(goldbook:13151))
AnnotationAssertion(rdfs:label goldbook:13151 "first line of defence")
AnnotationAssertion(dcterms:description goldbook:13151 "Surface tissues, notably the skin, respiratory tract, and gastrointestinal tract.")
Declaration(Class(goldbook:13152))
AnnotationAssertion(rdfs:label goldbook:13152 "flow cytometry")
AnnotationAssertion(dcterms:description goldbook:13152 "Method of sorting and measuring types of cells by fluorescent labeling of markers on the surface of the cells. It is sometimes referred to as fluorescence-assisted (or activated) cell sorting (FACS) analysis.")
Declaration(Class(goldbook:13153))
AnnotationAssertion(rdfs:label goldbook:13153 "fluorescein isothiocyanate")
AnnotationAssertion(dcterms:description goldbook:13153 "Green fluorescent dye used to 'tag' antibodies for use in immunofluorescence.")
Declaration(Class(goldbook:13154))
AnnotationAssertion(rdfs:label goldbook:13154 "fluorescence-activated cell sorting")
AnnotationAssertion(dcterms:description goldbook:13154 "Fluorescence-assisted cell sorting.")
Declaration(Class(goldbook:13155))
AnnotationAssertion(rdfs:label goldbook:13155 "fluorescent antibody")
AnnotationAssertion(dcterms:description goldbook:13155 "Antibody conjugated to a fluorescent dye such as fluorescein isothiocyanate (FITC).")
Declaration(Class(goldbook:13156))
AnnotationAssertion(rdfs:label goldbook:13156 "follicular dendritic cell")
AnnotationAssertion(dcterms:description goldbook:13156 "Major histocompatibility complex (MHC) class II-negative Fc receptor-positive dendritic cell which bears immune complexes on its surface and is probably involved in the generation of antibody-secreting cells and maintenance of B-cell memory (see memory cell) in germinal centers.")
Declaration(Class(goldbook:13157))
AnnotationAssertion(rdfs:label goldbook:13157 "footpad test")
AnnotationAssertion(dcterms:description goldbook:13157 "Test for allergic contact dermatitis in which the test substance is injected into the front footpad of a guinea pig and challenge is performed seven days later.")
Declaration(Class(goldbook:13158))
AnnotationAssertion(rdfs:label goldbook:13158 "Forssman antigen")
AnnotationAssertion(dcterms:description goldbook:13158 "Glycolipid heterophile antigen (globopentosylceramide) expressed on cell surfaces during embryonic and adult life in rodents and other mammals, and found in many pathogens, but probably not in humans.")
Declaration(Class(goldbook:13159))
AnnotationAssertion(rdfs:label goldbook:13159 "framework region")
AnnotationAssertion(dcterms:description goldbook:13159 "One of several relatively conserved amino acid sequences that flank the hypervariable regions in immunoglobulin (Ig) and T-cell receptor (TCR) variable (V) regions and maintain a common overall structure for all V region domains.")
Declaration(Class(goldbook:13160))
AnnotationAssertion(rdfs:label goldbook:13160 "Freund’s adjuvant")
AnnotationAssertion(dcterms:description goldbook:13160 "Complete Freund’s adjuvant is an emulsion of aqueous antigen in mineral oil that contains heat-killed Mycobacteria.")
Declaration(Class(goldbook:13161))
AnnotationAssertion(rdfs:label goldbook:13161 "γ:δ T cell")
AnnotationAssertion(dcterms:description goldbook:13161 "Lymphocyte whose T-cell receptor (TCR) is a heterodimer of a \\(\\ce{\\upgamma\\mbox{-}chain}\\) and a \\(\\ce{\\updelta\\mbox{-}chain}\\).")
Declaration(Class(goldbook:13162))
AnnotationAssertion(rdfs:label goldbook:13162 "γ:δ T-cell receptor")
AnnotationAssertion(dcterms:description goldbook:13162 "T-cell receptor (TCR) composed of two different glycoprotein chains, designated \\(\\upgamma\\) and \\(\\updelta\\), assembled in a \\(\\ce{\\upgamma\\mbox{:}\\updelta\\ heterodimer}\\).")
Declaration(Class(goldbook:13163))
AnnotationAssertion(rdfs:label goldbook:13163 "γ-interferon")
AnnotationAssertion(dcterms:description goldbook:13163 "Member of a group of cytokines, the interferons, which has as its primary action the activation of macrophages and can induce cells to resist viral replication.")
Declaration(Class(goldbook:13164))
AnnotationAssertion(rdfs:label goldbook:13164 "gp120")
AnnotationAssertion(dcterms:description goldbook:13164 "Viral glycoprotein, non-covalently associated with gp41 in the viral envelope of human immunodeficiency virus (HIV).")
Declaration(Class(goldbook:13165))
AnnotationAssertion(rdfs:label goldbook:13165 "gammaglobulin")
AnnotationAssertion(dcterms:description goldbook:13165 "One of a group of serum proteins, mostly immunoglobulins (Ig), which have the greatest mobility towards the cathode during electrophoresis.")
Declaration(Class(goldbook:13166))
AnnotationAssertion(rdfs:label goldbook:13166 "autoimmune gastritis")
AnnotationAssertion(dcterms:description goldbook:13166 "Autoimmune-mediated destruction of the gastric mucosa that may result in the development of pernicious anemia.")
Declaration(Class(goldbook:13167))
AnnotationAssertion(rdfs:label goldbook:13167 "Gell and Coombs classification")
AnnotationAssertion(dcterms:description goldbook:13167 "Classification of immune mechanisms of tissue injury into four types: type I, immediate-type hypersensitivity reactions, mediated by interaction of immunoglobulin E (IgE) antibody and antigen causing the release of histamine and other mediators; type II, antibody-mediated hypersensitivity reactions, due to antibody–antigen interactions on cell surfaces; type III, immune complex, local or general inflammatory responses due to formation of circulating immune complexes and their deposition in tissues; and type IV cell-mediated hypersensitivity reactions, initiated by sensitized T lymphocytes either by release of lymphokines or by T-cell-mediated cytotoxicity [see cytotoxic T lymphocyte (CTL)].")
Declaration(Class(goldbook:13168))
AnnotationAssertion(rdfs:label goldbook:13168 "gene knockout")
AnnotationAssertion(dcterms:description goldbook:13168 "Method of disabling a specific gene by homologous recombination with an introduced DNA construct designed for that purpose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13168 "gene targeting")
Declaration(Class(goldbook:13169))
AnnotationAssertion(rdfs:label goldbook:13169 "gene rearrangement")
AnnotationAssertion(dcterms:description goldbook:13169 "Structural alteration in a chromosome that changes the order of its genetic loci, occurring by DNA recombination, e.g., during development or in some cancers.")
Declaration(Class(goldbook:13170))
AnnotationAssertion(rdfs:label goldbook:13170 "germ-free")
AnnotationAssertion(dcterms:description goldbook:13170 "Descriptor applied to animals (usually mice) raised in the complete absence of intestinal and other microorganisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13170 "gnotobiotic")
Declaration(Class(goldbook:13171))
AnnotationAssertion(rdfs:label goldbook:13171 "germ line")
AnnotationAssertion(dcterms:description goldbook:13171 "Referring to genes in their unrearranged state rather than those rearranged for production of immunoglobulin (Ig) or T-cell receptor (TCR) molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13171 "in immunology")
Declaration(Class(goldbook:13172))
AnnotationAssertion(rdfs:label goldbook:13172 "germinal center")
AnnotationAssertion(dcterms:description goldbook:13172 "Discrete area within lymph nodes and spleen where B-cell maturation and memory development occur.")
Declaration(Class(goldbook:13173))
AnnotationAssertion(rdfs:label goldbook:13173 "giant cell")
AnnotationAssertion(dcterms:description goldbook:13173 "Large multinucleate cell derived from fused macrophages and often present in granulomas.")
Declaration(Class(goldbook:13174))
AnnotationAssertion(rdfs:label goldbook:13174 "glomerulonephritis")
AnnotationAssertion(dcterms:description goldbook:13174 "Any of a group of kidney diseases involving inflammation of the renal glomeruli, often as a result of antibody–antigen complexes that localize in the kidney.")
Declaration(Class(goldbook:13175))
AnnotationAssertion(rdfs:label goldbook:13175 "glomerulonephropathy")
AnnotationAssertion(dcterms:description goldbook:13175 "Disease of the renal glomeruli, which may show either thickening of the glomerular basement membrane due to the accretion of proteins or a minimal change disease, in which there is functional damage but little structural change by light microscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13175 "glomerulopathy")
Declaration(Class(goldbook:13176))
AnnotationAssertion(rdfs:label goldbook:13176 "glutamic acid decarboxylase")
AnnotationAssertion(dcterms:description goldbook:13176 "Main autoantigen in diabetes mellitus type 1 and stiff-person syndrome (a neurological autoimmune disease).")
Declaration(Class(goldbook:13177))
AnnotationAssertion(rdfs:label goldbook:13177 "gluten")
AnnotationAssertion(dcterms:description goldbook:13177 """1) Any of the prolamins found in cereal grains, especially the prolamins in wheat, rye, barley, and possibly oats, which cause digestive disorders, notably celiac disease.
2) In wheat, mixture of water-insoluble proteins, including gliadins, that give wheat dough its elastic texture.""")
Declaration(Class(goldbook:13178))
AnnotationAssertion(rdfs:label goldbook:13178 "Goodpasture syndrome")
AnnotationAssertion(dcterms:description goldbook:13178 "Autoimmune disease of humans in which glomerulonephritis and pulmonary hemorrhage are produced by complement-mediated tissue damage caused by antibodies directed against the renal glomerular and alveolar basement membranes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13178 "Goodpasture disease")
Declaration(Class(goldbook:13179))
AnnotationAssertion(rdfs:label goldbook:13179 "graft rejection")
AnnotationAssertion(dcterms:description goldbook:13179 "Destruction of grafted tissue by host lymphocytes following an adaptive immune response.")
Declaration(Class(goldbook:13180))
AnnotationAssertion(rdfs:label goldbook:13180 "graft-versus-host disease")
AnnotationAssertion(dcterms:description goldbook:13180 "Disease that occurs following bone marrow transplantation between genetically non-identical people and in which mature T cells in the transplanted bone marrow attack and destroy the recipients tissues.")
Declaration(Class(goldbook:13181))
AnnotationAssertion(rdfs:label goldbook:13181 "graft-versus-host reaction")
AnnotationAssertion(dcterms:description goldbook:13181 "Reaction occurring when T lymphocytes present in a graft recognize and attack host cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13181 "GVH reaction")
Declaration(Class(goldbook:13182))
AnnotationAssertion(rdfs:label goldbook:13182 "granulocyte colony-stimulating factor")
AnnotationAssertion(dcterms:description goldbook:13182 "Hematopoietic (see hematopoiesis) factor augmenting the production of neutrophils in the bone marrow.")
Declaration(Class(goldbook:13183))
AnnotationAssertion(rdfs:label goldbook:13183 "granulocyte–macrophage colony-stimulating factor")
AnnotationAssertion(dcterms:description goldbook:13183 "Cytokine that stimulates production of granulocytes and monocytes from stem cells.")
Declaration(Class(goldbook:13184))
AnnotationAssertion(rdfs:label goldbook:13184 "granulocytopenia")
AnnotationAssertion(dcterms:description goldbook:13184 "Decreased circulating granulocytes.")
Declaration(Class(goldbook:13185))
AnnotationAssertion(rdfs:label goldbook:13185 "granuloma")
AnnotationAssertion(dcterms:description goldbook:13185 "Mass or nodule of granulation tissue, with actively growing fibroblasts and capillary buds, characterized by the presence of aggregates of modified macrophages resembling epithelial cells (epithelioid histiocytes), and lymphocytes, surrounded by a rim of giant multinucleate cells, either of the Langerhans or foreign body type.")
Declaration(Class(goldbook:13186))
AnnotationAssertion(rdfs:label goldbook:13186 "granzyme")
AnnotationAssertion(dcterms:description goldbook:13186 "Member of a family of serine esterases present in the granules of cytotoxic T lymphocytes and natural killer (NK) cells. They induce apoptosis in the target cell that they enter through perforin channels inserted into the target cell membrane by the cytotoxic lymphocyte.")
Declaration(Class(goldbook:13187))
AnnotationAssertion(rdfs:label goldbook:13187 "Graves disease")
AnnotationAssertion(dcterms:description goldbook:13187 "Hyperthyroidism associated with diffuse hyperplastic goitre resulting from production of a thyroid-stimulating hormone receptor (TSHR)-binding autoantibody.")
Declaration(Class(goldbook:13188))
AnnotationAssertion(rdfs:label goldbook:13188 "guinea pig maximization test")
AnnotationAssertion(dcterms:description goldbook:13188 "Skin sensitization test for allergic contact dermatitis in which shaved guinea pig skin is exposed to intradermal injections of a test agent together with complete Freund’s adjuvant, followed by an occlusive patch for boosting for \\(\\pu{48 h}\\) beginning on day 7, and challenged on day 21.")
Declaration(Class(goldbook:13189))
AnnotationAssertion(rdfs:label goldbook:13189 "gut-associated lymphoid tissue")
AnnotationAssertion(dcterms:description goldbook:13189 "Lymphoid cells and tissues lining the mucosa that seem to serve as the first point of antigen contact via this route, including Peyer’s patches, the appendix, tonsils, adenoids, and mesenteric lymph nodes.")
Declaration(Class(goldbook:13190))
AnnotationAssertion(rdfs:label goldbook:13190 "H-2")
AnnotationAssertion(dcterms:description goldbook:13190 "Region of mouse chromosome 17 coding the major histocompatibility complex (MHC).")
Declaration(Class(goldbook:13191))
AnnotationAssertion(rdfs:label goldbook:13191 "H-2 complex")
AnnotationAssertion(dcterms:description goldbook:13191 "Mouse major histocompatibility complex (MHC) coded by H-2.")
Declaration(Class(goldbook:13192))
AnnotationAssertion(rdfs:label goldbook:13192 "hairy cell leukemia")
AnnotationAssertion(dcterms:description goldbook:13192 "B-cell neoplasm, usually occurring during middle age, constituting about \\(\\pu{2\\%}\\) of all leukemias and responding well to chemotherapy. The neoplastic cells have fine, hairlike surfaces.")
Declaration(Class(goldbook:13193))
AnnotationAssertion(rdfs:label goldbook:13193 "haplotype")
AnnotationAssertion(dcterms:description goldbook:13193 "Set of allelic variants present at a given genetic region.")
Declaration(Class(goldbook:13194))
AnnotationAssertion(rdfs:label goldbook:13194 "haptenic")
AnnotationAssertion(dcterms:description goldbook:13194 "Able to act as a hapten.")
Declaration(Class(goldbook:13195))
AnnotationAssertion(rdfs:label goldbook:13195 "Hashimoto thyroiditis")
AnnotationAssertion(dcterms:description goldbook:13195 "Autoimmune disease where the body’s own antibodies attack the cells of the thyroid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13195 "chronic lymphocytic thyroiditis")
Declaration(Class(goldbook:13196))
AnnotationAssertion(rdfs:label goldbook:13196 "hay fever")
AnnotationAssertion(dcterms:description goldbook:13196 "Allergic condition affecting the mucous membranes of the upper respiratory tract and the eyes, characterized by nasal discharge, sneezing, and itchy, watery eyes; and usually caused by an abnormal sensitivity to airborne pollen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13196 "pollenosis")
Declaration(Class(goldbook:13197))
AnnotationAssertion(rdfs:label goldbook:13197 "heat shock proteins")
AnnotationAssertion(dcterms:description goldbook:13197 "Evolutionarily conserved proteins, found in many organisms, that are induced upon exposure of cells to various types of stress, including heat, oxidative or hypoxic stress, and deprivation of nutrients or essential ions.")
Declaration(Class(goldbook:13198))
AnnotationAssertion(rdfs:label goldbook:13198 "heavy chain")
AnnotationAssertion(dcterms:description goldbook:13198 "Larger of the two types of polypeptide chain found in immunoglobulin (Ig) molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13198 "H-chain")
Declaration(Class(goldbook:13199))
AnnotationAssertion(rdfs:label goldbook:13199 "helper T lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13199 "Member of a subclass of T lymphocytes that provides help (in the form of cytokines and/or cognate interactions) necessary for the expression of effector function by other cells in the immune system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13199 "helper cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13199 "helper T cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13199 "T helper cell")
Declaration(Class(goldbook:13200))
AnnotationAssertion(rdfs:label goldbook:13200 "hemagglutinin")
AnnotationAssertion(dcterms:description goldbook:13200 "Any molecule that agglutinates erythrocytes.")
Declaration(Class(goldbook:13201))
AnnotationAssertion(rdfs:label goldbook:13201 "hematopoietic stem cell")
AnnotationAssertion(dcterms:description goldbook:13201 "Self-renewing stem cell that is capable of giving rise to all of the formed elements of the blood (i.e., leukocytes, erythrocytes, and platelets).")
Declaration(Class(goldbook:13202))
AnnotationAssertion(rdfs:label goldbook:13202 "hemolytic anemia")
AnnotationAssertion(dcterms:description goldbook:13202 "Anemia resulting from the lysis of erythrocytes.")
Declaration(Class(goldbook:13203))
AnnotationAssertion(rdfs:label goldbook:13203 "heparin-induced thrombocytopenia")
AnnotationAssertion(dcterms:description goldbook:13203 "Most frequent antibody-mediated drug-induced thrombocytopenia, which occurs in \\(\\pu{1-}\\pu{2\\%}\\) of patients treated with heparin intravenously for longer than four days.")
Declaration(Class(goldbook:13204))
AnnotationAssertion(rdfs:label goldbook:13204 "hereditary angioneurotic edema")
AnnotationAssertion(dcterms:description goldbook:13204 "Clinical name for a genetic deficiency of the C1 inhibitor of the complement system.")
Declaration(Class(goldbook:13205))
AnnotationAssertion(rdfs:label goldbook:13205 "heteroantigen")
AnnotationAssertion(dcterms:description goldbook:13205 "Identical or similar cross-reacting antigen shared by several species (e.g., Forssman antigen).Antibodies produced against one of these antigens will also react with the other antigens of the set even though these are derived from a different species; such antibodies are also called heterophile antibodies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13205 "heterogenetic antigen")
Declaration(Class(goldbook:13206))
AnnotationAssertion(rdfs:label goldbook:13206 "heterologous antibody")
AnnotationAssertion(dcterms:description goldbook:13206 "Antibody derived from another individual of the same species or another species.")
Declaration(Class(goldbook:13207))
AnnotationAssertion(rdfs:label goldbook:13207 "heterologous antigen")
AnnotationAssertion(dcterms:description goldbook:13207 "Antigen that reacts with an antibody other than the one whose formation it induced.")
Declaration(Class(goldbook:13208))
AnnotationAssertion(rdfs:label goldbook:13208 "heterophagy")
AnnotationAssertion(dcterms:description goldbook:13208 "Digestion of exogenous material taken up by a cell by phagocytosis or pinocytosis, following fusion of the phagocytic or pinocytic vacuole with a lysosome.")
Declaration(Class(goldbook:13209))
AnnotationAssertion(rdfs:label goldbook:13209 "heterophile antibody")
AnnotationAssertion(dcterms:description goldbook:13209 "Antibody raised against an antigen from one species, which also reacts against antigens from other species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13209 "heterophilic antibody")
Declaration(Class(goldbook:13210))
AnnotationAssertion(rdfs:label goldbook:13210 "heterophile antigen")
AnnotationAssertion(dcterms:description goldbook:13210 "Antigen that stimulates production in a vertebrate of antibodies capable of reacting with tissue components having related antigens in a wide range of other species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13210 "heterophilic antigen")
Declaration(Class(goldbook:13211))
AnnotationAssertion(rdfs:label goldbook:13211 "heterozygous")
AnnotationAssertion(dcterms:description goldbook:13211 "Possessing different alleles at a given locus on the two homologous chromosomes.")
Declaration(Class(goldbook:13212))
AnnotationAssertion(rdfs:label goldbook:13212 "high endothelial venule")
AnnotationAssertion(dcterms:description goldbook:13212 "Specialized venule in lymphoid tissues that has walls permeable to migrating lymphocytes, allowing them to move from blood into the lymphoid tissues.")
Declaration(Class(goldbook:13213))
AnnotationAssertion(rdfs:label goldbook:13213 "highly active antiretroviral therapy")
AnnotationAssertion(dcterms:description goldbook:13213 "Approach to the treatment of acquired immune deficiency syndrome (AIDS) patients involving a combination of nucleoside analogs, which prevent reverse transcription, with drugs that inhibit responses to the virus.")
Declaration(Class(goldbook:13214))
AnnotationAssertion(rdfs:label goldbook:13214 "high-mobility group box protein")
AnnotationAssertion(dcterms:description goldbook:13214 "Any of a group of universal sensors of nucleic acids, required for the induction of transmembrane and cytoplasmic receptor-mediated innate immune responses.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13214 "HMGB Protein")
Declaration(Class(goldbook:13215))
AnnotationAssertion(rdfs:label goldbook:13215 "hinge region")
AnnotationAssertion(dcterms:description goldbook:13215 "Amino acids between the Fab and Fc regions of immunoglobulin (Ig) that permit flexibility of the molecule.")
Declaration(Class(goldbook:13216))
AnnotationAssertion(rdfs:label goldbook:13216 "histaminosis")
AnnotationAssertion(dcterms:description goldbook:13216 "Histamine intolerance, which may contribute to food intolerance as part of a pseudoallergic reaction.")
Declaration(Class(goldbook:13217))
AnnotationAssertion(rdfs:label goldbook:13217 "histocompatibility")
AnnotationAssertion(dcterms:description goldbook:13217 "Relationship between a tissue or organ donor and a recipient who have sufficient similarity in major histocompatibility complex (MHC) antigens to avoid rejection of a graft.")
Declaration(Class(goldbook:13218))
AnnotationAssertion(rdfs:label goldbook:13218 "histoincompatibility")
AnnotationAssertion(dcterms:description goldbook:13218 "Relationship between a tissue or organ donor and a recipient who have sufficient differences in major histocompatibility complex (MHC) antigens to cause rejection of a graft.")
Declaration(Class(goldbook:13219))
AnnotationAssertion(rdfs:label goldbook:13219 "hives")
AnnotationAssertion(dcterms:description goldbook:13219 "Vascular reaction pattern of the skin marked by the transient appearance of smooth, slightly elevated patches (wheals) that are either more red or more pale than the surrounding skin and are accompanied by severe itching.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13219 "nettle rash")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13219 "urticaria")
Declaration(Class(goldbook:13220))
AnnotationAssertion(rdfs:label goldbook:13220 "Hodgkin disease")
AnnotationAssertion(dcterms:description goldbook:13220 "Immune system tumor characterized by large cells called Reed–Sternberg cells that derive from mutated B-lineage cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13220 "Hodgkin lymphoma")
Declaration(Class(goldbook:13221))
AnnotationAssertion(rdfs:label goldbook:13221 "homing")
AnnotationAssertion(dcterms:description goldbook:13221 "Movement of leukocytes to specific locations in the body.")
Declaration(Class(goldbook:13222))
AnnotationAssertion(rdfs:label goldbook:13222 "homing receptor")
AnnotationAssertion(dcterms:description goldbook:13222 "Cell surface molecule that directs leukocytes to specific locations in the body.")
Declaration(Class(goldbook:13223))
AnnotationAssertion(rdfs:label goldbook:13223 "homocytotropic antibody")
AnnotationAssertion(dcterms:description goldbook:13223 "Antibody that binds preferentially to cells from the same species rather than to cells from other species.")
Declaration(Class(goldbook:13224))
AnnotationAssertion(rdfs:label goldbook:13224 "homozygous")
AnnotationAssertion(dcterms:description goldbook:13224 "Possessing the same allele at a given locus on the two homologous chromosomes.")
Declaration(Class(goldbook:13225))
AnnotationAssertion(rdfs:label goldbook:13225 "horror autotoxicus")
AnnotationAssertion(dcterms:description goldbook:13225 "Term (Latin: dread of self-poisoning) to describe the body’s innate aversion to immunological self destruction.")
Declaration(Class(goldbook:13226))
AnnotationAssertion(rdfs:label goldbook:13226 "host defense")
AnnotationAssertion(dcterms:description goldbook:13226 "Ability of an individual to resist invasion by opportunistic agents and production of disease associated with exposure to microorganisms, foreign tissue, and particulates, as well as certain types of neoplasia. Host defense may be either nonspecific (innate or natural immunity) or specific (adaptive or acquired immunity) in nature.")
Declaration(Class(goldbook:13227))
AnnotationAssertion(rdfs:label goldbook:13227 "host-resistance assay")
AnnotationAssertion(dcterms:description goldbook:13227 "Evaluation of host resistance in rodents to in vivo challenge with an infectious organism under normal conditions and after pharmacological and nutritional alterations of the immune system.")
Declaration(Class(goldbook:13228))
AnnotationAssertion(rdfs:label goldbook:13228 "human immunodeficiency virus")
AnnotationAssertion(dcterms:description goldbook:13228 "Causative agent of acquired immune deficiency syndrome (AIDS).")
Declaration(Class(goldbook:13229))
AnnotationAssertion(rdfs:label goldbook:13229 "humanized antibody")
AnnotationAssertion(dcterms:description goldbook:13229 "Genetically engineered monoclonal antibody of non-human origin in which all but the antigen-binding complementarity-determining region (CDR) sequences have been replaced with sequences derived from human antibodies.")
Declaration(Class(goldbook:13230))
AnnotationAssertion(rdfs:label goldbook:13230 "human leukocyte antigen")
AnnotationAssertion(dcterms:description goldbook:13230 "Antigen coded by genes of the human major histocompatibility complex (MHC).")
Declaration(Class(goldbook:13231))
AnnotationAssertion(rdfs:label goldbook:13231 "human leukocyte antigen polymorphism")
AnnotationAssertion(dcterms:description goldbook:13231 "Discontinuous genetic variation in the major histocompatibility complex (MHC) that results in the occurrence of several different forms of MHC molecules among people.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13231 "HLA Polymorphism")
Declaration(Class(goldbook:13232))
AnnotationAssertion(rdfs:label goldbook:13232 "human leukocyte antigen type I")
AnnotationAssertion(dcterms:description goldbook:13232 "Molecules that enable the body to recognize infected cells and tumor cells and destroy them with cytotoxic T lymphocytes (CTLs).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13232 "HLA Type I")
Declaration(Class(goldbook:13233))
AnnotationAssertion(rdfs:label goldbook:13233 "human leukocyte antigen type II")
AnnotationAssertion(dcterms:description goldbook:13233 "Molecules that enable CD4+ lymphocytes to recognize epitopes of exogenous antigens and discriminate self from non-self.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13233 "HLA Type II")
Declaration(Class(goldbook:13234))
AnnotationAssertion(rdfs:label goldbook:13234 "humoral")
AnnotationAssertion(dcterms:description goldbook:13234 "Pertaining to extracellular fluid such as plasma and lymph.")
Declaration(Class(goldbook:13235))
AnnotationAssertion(rdfs:label goldbook:13235 "humoral immune response")
AnnotationAssertion(dcterms:description goldbook:13235 "Immune response in which specific antibodies induce the effector functions (such as phagocytosis and activation of the complement system).")
Declaration(Class(goldbook:13236))
AnnotationAssertion(rdfs:label goldbook:13236 "humoral immunity")
AnnotationAssertion(dcterms:description goldbook:13236 "Specific immune response that is mediated primarily by humoral factors circulating in solution in the blood plasma and lymph (i.e., antibodies and complement).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13236 "humorally mediated immunity (HMI)")
Declaration(Class(goldbook:13237))
AnnotationAssertion(rdfs:label goldbook:13237 "hypergammaglobulinemia")
AnnotationAssertion(dcterms:description goldbook:13237 "Increase of gammaglobulins in the blood by paraproteinemia or increased production of immunoglobulins (Ig).")
Declaration(Class(goldbook:13238))
AnnotationAssertion(rdfs:label goldbook:13238 "hyperimmunoglobulin E syndrome")
AnnotationAssertion(dcterms:description goldbook:13238 "Rare primary immunodeficiency syndrome characterized by recurrent severe staphylococcal skin abscesses (hence Job syndrome), lung infections, and markedly elevated serum immunoglobulin E (IgE) levels.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13238 "Job syndrome")
Declaration(Class(goldbook:13239))
AnnotationAssertion(rdfs:label goldbook:13239 "hyperimmunoglobulin M syndrome")
AnnotationAssertion(dcterms:description goldbook:13239 "Primary T cell defect due to mutations in the CD40 ligand (CD40L), characterized by recurrent (opportunistic) infections and very low levels of immunoglobulin G (IgG) and immunoglobulin A (IgA).")
Declaration(Class(goldbook:13240))
AnnotationAssertion(rdfs:label goldbook:13240 "hyperreactivity")
AnnotationAssertion(dcterms:description goldbook:13240 "Abnormally increased response to a stimulus.")
Declaration(Class(goldbook:13241))
AnnotationAssertion(rdfs:label goldbook:13241 "hypersensitivity")
AnnotationAssertion(dcterms:description goldbook:13241 "State in which an individual reacts with allergic effects following exposure to a certain substance (allergen) after having been exposed previously to the same substance. It is sometimes used loosely for any increased response.")
Declaration(Class(goldbook:13242))
AnnotationAssertion(rdfs:label goldbook:13242 "hypersensitivity pneumonitis")
AnnotationAssertion(dcterms:description goldbook:13242 "Immune-mediated inflammatory disease of the lung parenchyma caused by exposure to an inhaled chemical allergen or organic dust.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13242 "extrinsic allergic alveolitis")
Declaration(Class(goldbook:13243))
AnnotationAssertion(rdfs:label goldbook:13243 "hypersensitization")
AnnotationAssertion(dcterms:description goldbook:13243 "Development of excessive immune reactivity to an antigen.")
Declaration(Class(goldbook:13244))
AnnotationAssertion(rdfs:label goldbook:13244 "hypersusceptibility")
AnnotationAssertion(dcterms:description goldbook:13244 "Adverse immunological effects in an individual occurring under conditions of exposure to an allergen that result in no effects in the great majority of the population, or an individual exhibiting exaggerated effects in comparison with the great majority of those showing some adverse effects.")
Declaration(Class(goldbook:13245))
AnnotationAssertion(rdfs:label goldbook:13245 "hypervariable region")
AnnotationAssertion(dcterms:description goldbook:13245 "Amino acid sequence within the immunoglobulin (Ig) and T-cell receptor (TCR) variable (V) regions that shows the greatest variability and contributes most to the antigen or peptide-major histocompatibility complex (MHC) molecule binding site.")
Declaration(Class(goldbook:13246))
AnnotationAssertion(rdfs:label goldbook:13246 "hypogammaglobulinemia")
AnnotationAssertion(dcterms:description goldbook:13246 "Immunodeficiency state marked by abnormally low levels of all classes of immunoglobulins (Ig), associated with increased susceptibility to infectious diseases.")
Declaration(Class(goldbook:13247))
AnnotationAssertion(rdfs:label goldbook:13247 "hyposensitization therapy")
AnnotationAssertion(dcterms:description goldbook:13247 "Dermal application of a selected allergen to an allergic person in stepwise increasing dosage, with the aim of reducing the immune system’s tendency for the corresponding allergic reaction.")
Declaration(Class(goldbook:13248))
AnnotationAssertion(rdfs:label goldbook:13248 "Ia antigen")
AnnotationAssertion(dcterms:description goldbook:13248 "Isoantigen encoded by the Ia region of the mouse major histocompatibility complex (H-2 complex).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13248 "I region-associated antigen")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13248 "immune response-associated antigen")
Declaration(Class(goldbook:13249))
AnnotationAssertion(rdfs:label goldbook:13249 "idiopathic")
AnnotationAssertion(dcterms:description goldbook:13249 "Term that describes a 'primary' symptom or disease in which no underlying cause or associated disorder can be found.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13249 "immune thrombocytopenic purpura")
Declaration(Class(goldbook:13250))
AnnotationAssertion(rdfs:label goldbook:13250 "idiopathic thrombocytopenic purpura")
AnnotationAssertion(dcterms:description goldbook:13250 "Thrombocytopenia of unknown cause, probably related to the production of anti-platelet antibodies, and leading to bruising (purpura).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13250 "immune thrombocytopenic purpura")
Declaration(Class(goldbook:13251))
AnnotationAssertion(rdfs:label goldbook:13251 "idiosyncratic drug reaction")
AnnotationAssertion(dcterms:description goldbook:13251 "Rare and unpredictable adverse drug reaction occurring only in susceptible individuals.")
Declaration(Class(goldbook:13252))
AnnotationAssertion(rdfs:label goldbook:13252 "idiotype")
AnnotationAssertion(dcterms:description goldbook:13252 "The combined antigenic determinants (idiotopes) expressed in the variable (V) region of immunoglobulins (Ig) of an individual that determine antibody specificity to a particular antigen.")
Declaration(Class(goldbook:13253))
AnnotationAssertion(rdfs:label goldbook:13253 "idiotype network")
AnnotationAssertion(dcterms:description goldbook:13253 "Regulatory network based on interactions of anti-idiotypic antibodies and idiotypes present on antibodies and T-cell receptors (TCRs), resulting in feedback inhibition of ongoing B cell or T cell responses.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13253 "idiotypic network")
Declaration(Class(goldbook:13254))
AnnotationAssertion(rdfs:label goldbook:13254 "immature")
AnnotationAssertion(dcterms:description goldbook:13254 "Describing cells that are not fully developed and unable to participate immediately in an immune response.")
Declaration(Class(goldbook:13255))
AnnotationAssertion(rdfs:label goldbook:13255 "immediate-type hypersensitivity")
AnnotationAssertion(dcterms:description goldbook:13255 "Reaction provoked by re-exposure to an antigen (allergen) that causes plasma cells to secrete immunoglobulin E (IgE) which binds to Fc receptors on the surface of tissue mast cells and blood basophils, sensitizing them, so that later exposure to the same allergen cross-links the bound IgE, leading to degranulation and the secretion of pharmacologically active mediators such as histamine, leukotriene, and prostaglandin that act immediately on the surrounding tissues.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13255 "immediate-type allergy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13255 "type I hypersensitivity")
Declaration(Class(goldbook:13256))
AnnotationAssertion(rdfs:label goldbook:13256 "immune adherence")
AnnotationAssertion(dcterms:description goldbook:13256 "Attachment of particulate antigen coated with C3b (see complement) to cells expressing C3b receptors, which results in enhanced phagocytosis of bacteria by macrophages.")
Declaration(Class(goldbook:13257))
AnnotationAssertion(rdfs:label goldbook:13257 "immune complex")
AnnotationAssertion(dcterms:description goldbook:13257 "Product of an antigen–antibody reaction, which may also contain components of the complement system.")
Declaration(Class(goldbook:13258))
AnnotationAssertion(rdfs:label goldbook:13258 "immune complex disease")
AnnotationAssertion(dcterms:description goldbook:13258 "Illness resulting from deposition of antigen–antibody complexes in tissues.")
Declaration(Class(goldbook:13259))
AnnotationAssertion(rdfs:label goldbook:13259 "immune deviation")
AnnotationAssertion(dcterms:description goldbook:13259 "Regulatory mechanism of the preferential activation of one aspect (cellular or humoral) of the adaptive immune system at the expense of the other.")
Declaration(Class(goldbook:13260))
AnnotationAssertion(rdfs:label goldbook:13260 "immune elimination")
AnnotationAssertion(dcterms:description goldbook:13260 "Removal of pathogens or tumor cells by the immune system; the first step of immunoediting of tumors.")
Declaration(Class(goldbook:13261))
AnnotationAssertion(rdfs:label goldbook:13261 "immune enhancement")
AnnotationAssertion(dcterms:description goldbook:13261 "Therapeutic stimulation of the immune response, especially in tumor therapy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13261 "enhancement (in immunology)")
Declaration(Class(goldbook:13262))
AnnotationAssertion(rdfs:label goldbook:13262 "immune equilibrium")
AnnotationAssertion(dcterms:description goldbook:13262 "State in carcinogenesis where there is an equilibrium between elimination of tumor cells by the immune system and growth of non-immunogenic tumor cells; the second step in immunoediting.")
Declaration(Class(goldbook:13263))
AnnotationAssertion(rdfs:label goldbook:13263 "immune escape")
AnnotationAssertion(dcterms:description goldbook:13263 "Biological feature of an infectious agent or of a tumor cell that prevents its elimination by the immune system. Such a feature can be acquired by a selection process. Immune escape is the third step in immunoediting of tumors.")
Declaration(Class(goldbook:13264))
AnnotationAssertion(rdfs:label goldbook:13264 "immune evasion")
AnnotationAssertion(dcterms:description goldbook:13264 "Property of a pathogen that results in avoidance of attack by the immune system, e.g., because of reduced phagocytosis, lack of recognition by the innate immune system, or suppression of the immune response.")
Declaration(Class(goldbook:13265))
AnnotationAssertion(rdfs:label goldbook:13265 "immune modulation")
AnnotationAssertion(dcterms:description goldbook:13265 "Alteration of the immune response to alleviate harmful effects of the immune system or to promote its activity by changes in regulatory factors; often part of deliberate therapeutic intervention.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13265 "immunomodulation")
Declaration(Class(goldbook:13266))
AnnotationAssertion(rdfs:label goldbook:13266 "immune regulation")
AnnotationAssertion(dcterms:description goldbook:13266 "Capacity of the immune system to regulate itself so that an immune response does not become excessive and cause tissue damage, autoimmune reactions, or allergic reactions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13266 "immunoregulation")
Declaration(Class(goldbook:13267))
AnnotationAssertion(rdfs:label goldbook:13267 "immune reserve hypothesis")
AnnotationAssertion(dcterms:description goldbook:13267 "Hypothesis that the immune response involves multiple redundancies that are capable of compensating for acute reductions in certain immune functions.")
Declaration(Class(goldbook:13268))
AnnotationAssertion(rdfs:label goldbook:13268 "immune response-associated protein")
AnnotationAssertion(dcterms:description goldbook:13268 "Protein found in antigen-presenting cells (APCs) and B lymphocytes in mice.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13268 "Ia protein")
Declaration(Class(goldbook:13269))
AnnotationAssertion(rdfs:label goldbook:13269 "immune response genes")
AnnotationAssertion(dcterms:description goldbook:13269 "Genes, including those within the major histocompatibility complex (MHC), that together determine the overall level of immune response to a given antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13269 "ir genes")
Declaration(Class(goldbook:13270))
AnnotationAssertion(rdfs:label goldbook:13270 "immune surveillance")
AnnotationAssertion(dcterms:description goldbook:13270 "Recognition, and in some cases elimination, of tumor cells by the immune system before they become clinically detectable.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13270 "immunosurveillance")
Declaration(Class(goldbook:13271))
AnnotationAssertion(rdfs:label goldbook:13271 "immune system")
AnnotationAssertion(dcterms:description goldbook:13271 "Integrated network of organs, glands, and tissues that has evolved to protect the body from foreign substances, including bacteria, viruses, and other infection-causing parasites and pathogens.")
Declaration(Class(goldbook:13272))
AnnotationAssertion(rdfs:label goldbook:13272 "immunity")
AnnotationAssertion(dcterms:description goldbook:13272 "Inherited, acquired, or induced resistance to infection by a specific pathogen.")
Declaration(Class(goldbook:13273))
AnnotationAssertion(rdfs:label goldbook:13273 "immunoactivation")
AnnotationAssertion(dcterms:description goldbook:13273 "Activation of the immune system as a whole to react more rapidly to antigens.")
Declaration(Class(goldbook:13274))
AnnotationAssertion(rdfs:label goldbook:13274 "immunoactivator")
AnnotationAssertion(dcterms:description goldbook:13274 "Substance that activates the immune system as a whole to react more rapidly to antigens.")
Declaration(Class(goldbook:13275))
AnnotationAssertion(rdfs:label goldbook:13275 "immunoadsorption")
AnnotationAssertion(dcterms:description goldbook:13275 "Method for removal of antibody or antigen by allowing it to bind to a corresponding antigen or antibody immobilized in the solid phase.")
Declaration(Class(goldbook:13276))
AnnotationAssertion(rdfs:label goldbook:13276 "immunoblot")
AnnotationAssertion(dcterms:description goldbook:13276 "Supporting substrate [often a nitrocellulose, nylon, or poly(vinylidene fluoride) membrane] onto which proteins that have been separated by gel electrophoresis are transferred and then identified by the binding of specific antibodies.")
Declaration(Class(goldbook:13277))
AnnotationAssertion(rdfs:label goldbook:13277 "immunocompetence")
AnnotationAssertion(dcterms:description goldbook:13277 "Having the ability to exhibit an immune response.")
Declaration(Class(goldbook:13278))
AnnotationAssertion(rdfs:label goldbook:13278 "immunocompromised")
AnnotationAssertion(dcterms:description goldbook:13278 "Unable to mount a full or effective immune response.")
Declaration(Class(goldbook:13279))
AnnotationAssertion(rdfs:label goldbook:13279 "immunoconjugate")
AnnotationAssertion(dcterms:description goldbook:13279 "Antibody or antibody fragment to which a functional molecule, such as a drug, has been chemically linked.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13279 "antibody conjugate")
Declaration(Class(goldbook:13280))
AnnotationAssertion(rdfs:label goldbook:13280 "immunocytokine")
AnnotationAssertion(dcterms:description goldbook:13280 "Antibody or antibody fragment to which a cytokine has been chemically linked.")
Declaration(Class(goldbook:13281))
AnnotationAssertion(rdfs:label goldbook:13281 "immunodeficiency")
AnnotationAssertion(dcterms:description goldbook:13281 "Inability to produce a normal repertoire of antibodies or immunologically sensitized T lymphocytes, especially in response to specific antigens.")
Declaration(Class(goldbook:13282))
AnnotationAssertion(rdfs:label goldbook:13282 "immunodominant epitope")
AnnotationAssertion(dcterms:description goldbook:13282 "Epitope in an antigen that is preferentially recognized by T cells, which then come to dominate the immune response.")
Declaration(Class(goldbook:13283))
AnnotationAssertion(rdfs:label goldbook:13283 "immunodysregulation–polyendocrinopathy–enteropathy, X-linked")
AnnotationAssertion(dcterms:description goldbook:13283 "X-linked syndrome characterized by immunodysregulation, polyendocrinopathy (diabetes mellitus type 1, thyroiditis), hemolytic anemia, thrombocytopenia, dermatitis, and enteropathy, caused by mutations in the gene encoding Foxp3.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13283 "IPEX syndrome")
Declaration(Class(goldbook:13284))
AnnotationAssertion(rdfs:label goldbook:13284 "immunoediting")
AnnotationAssertion(dcterms:description goldbook:13284 "Process of continuing immunosuppression of immunogenic tumor cells, which may finally result in the selection of non-immunogenic tumor cells. It consists of the steps immune elimination, immune equilibrium, and immune escape.")
Declaration(Class(goldbook:13285))
AnnotationAssertion(rdfs:label goldbook:13285 "immunofluorescence")
AnnotationAssertion(dcterms:description goldbook:13285 "Technique for detection of cell- or tissue-associated antigens by the use of a fluorescently tagged ligand, e.g., an anti-immunoglobulin (Ig) conjugated to fluorescein isothiocyanate (FITC).")
Declaration(Class(goldbook:13286))
AnnotationAssertion(rdfs:label goldbook:13286 "immunoglobulin A")
AnnotationAssertion(dcterms:description goldbook:13286 "Class of immunoglobulin (Ig) characterized by $\\ce{\\upalpha\\!}$ heavy chains.")
Declaration(Class(goldbook:13287))
AnnotationAssertion(rdfs:label goldbook:13287 "immunoglobulin D")
AnnotationAssertion(dcterms:description goldbook:13287 "Class of immunoglobulin (Ig) characterized by $\\updelta\\!$ heavy chains.")
Declaration(Class(goldbook:13288))
AnnotationAssertion(rdfs:label goldbook:13288 "immunoglobulin E")
AnnotationAssertion(dcterms:description goldbook:13288 "Class of immunoglobulin (Ig) characterized by $\\upvarepsilon\\!$ heavy chains.")
Declaration(Class(goldbook:13289))
AnnotationAssertion(rdfs:label goldbook:13289 "immunoglobulin Y")
AnnotationAssertion(dcterms:description goldbook:13289 "Immunoglobulin (Ig) found in chickens.")
Declaration(Class(goldbook:13290))
AnnotationAssertion(rdfs:label goldbook:13290 "immunoglobulin E-binding Fc receptors")
AnnotationAssertion(dcterms:description goldbook:13290 "High-affinity IgE-binding ${\\rm{Fc\\mbox{-}}}\\upvarepsilon\\!{\\rm{\\mbox{-}R}}$ type I receptors are expressed on mast cells and basophils and interact with IgE antibodies with high affinity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13290 "IgE-binding FC receptors")
Declaration(Class(goldbook:13291))
AnnotationAssertion(rdfs:label goldbook:13291 "immunoglobulin E-mediated hypersensitivity")
AnnotationAssertion(dcterms:description goldbook:13291 "State in which an individual reacts with allergic effects caused fundamentally by the reaction of antigen-specific immunoglobulin E (IgE) following exposure to a certain substance (allergen) after having been exposed previously to the same substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13291 "IgE-Mediated Hypersensitivity")
Declaration(Class(goldbook:13292))
AnnotationAssertion(rdfs:label goldbook:13292 "immunoglobulin G")
AnnotationAssertion(dcterms:description goldbook:13292 "Class of immunoglobulin (Ig) characterized by \\(\\upgamma\\) heavy chains.")
Declaration(Class(goldbook:13293))
AnnotationAssertion(rdfs:label goldbook:13293 "immunoglobulin M")
AnnotationAssertion(dcterms:description goldbook:13293 "Class of immunoglobulin (Ig) characterized by \\(\\upmu\\) heavy chains.")
Declaration(Class(goldbook:13294))
AnnotationAssertion(rdfs:label goldbook:13294 "immunoglobulin gene superfamily")
AnnotationAssertion(dcterms:description goldbook:13294 "Genes encoding proteins containing one or more immunoglobulin (Ig) domains (homology units) that are homologous to either Ig variable (V) region or constant (C) region domains. Cell surface and soluble molecules mediating recognition, adhesion, or binding functions in and outside the immune system, derived from the same precursor, belong to this family of molecules (e.g., immunoglobulin, T-cell receptor (TCR), major histocompatibility complex (MHC) class I and class II molecules, CD4, CD8, and $\\ce{Fc\\upgamma\\!R}$).")
Declaration(Class(goldbook:13295))
AnnotationAssertion(rdfs:label goldbook:13295 "immunoglobulin superfamily")
AnnotationAssertion(dcterms:description goldbook:13295 "Large family of proteins characterized by possession of 'immunoglobulin-type' domains of approximately 110 amino acids folded into two \\(\\ce{\\upbeta\\mbox{-}pleated sheets}\\). Members include immunoglobulins \\(A\\), \\(E\\), \\(G\\), \\(M\\) (IgA, IgE, IgG, and IgM), T-cell receptors (TCRs), and human leukocyte antigen (HLA) major histocompatibility complex (MHC) molecules.")
Declaration(Class(goldbook:13296))
AnnotationAssertion(rdfs:label goldbook:13296 "immunohistochemistry")
AnnotationAssertion(dcterms:description goldbook:13296 "Detection of cell-associated molecules in the light microscope with antibodies labeled with enzymes that change a substrate into a colored precipitate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13296 "immunocytochemistry")
Declaration(Class(goldbook:13297))
AnnotationAssertion(rdfs:label goldbook:13297 "immunological ignorance")
AnnotationAssertion(dcterms:description goldbook:13297 "Absence of a pathogenic autoimmune response in spite of the concomitant presence in the host of the autoantigen and T cells bearing the specific autoreactive T-cell receptor (TCR).")
Declaration(Class(goldbook:13298))
AnnotationAssertion(rdfs:label goldbook:13298 "immunological incompetence")
AnnotationAssertion(dcterms:description goldbook:13298 "Inability of the immune system to function in a normal fashion.")
Declaration(Class(goldbook:13299))
AnnotationAssertion(rdfs:label goldbook:13299 "immunologically privileged site")
AnnotationAssertion(dcterms:description goldbook:13299 "Any of various sites in the body where foreign tissue grafts do not induce an immune reaction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13299 "privileged site")
Declaration(Class(goldbook:13300))
AnnotationAssertion(rdfs:label goldbook:13300 "immunological memory")
AnnotationAssertion(dcterms:description goldbook:13300 "Ability of the immune system to respond faster and more effectively to subsequent exposures to an antigen following a primary immune response to the same antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13300 "immunological anamnesis")
Declaration(Class(goldbook:13301))
AnnotationAssertion(rdfs:label goldbook:13301 "immunological synapse")
AnnotationAssertion(dcterms:description goldbook:13301 "Contact point between the T cell and antigen-presenting cell (APC) that is generated by reorganization and clustering of cell surface molecules in lipid rafts. The synapse facilitates interactions between T-cell receptor (TCR) and major histocompatibility complex (MHC) molecules, and between adhesion molecules, thereby potentiating a TCR-mediated activation signal.")
Declaration(Class(goldbook:13302))
AnnotationAssertion(rdfs:label goldbook:13302 "immunological tolerance")
AnnotationAssertion(dcterms:description goldbook:13302 "Persistent specific immunological unresponsiveness toward a substance that would normally be expected to elicit an immune response, resulting from previous non-sensitizing exposure to an antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13302 "tolerance")
Declaration(Class(goldbook:13303))
AnnotationAssertion(rdfs:label goldbook:13303 "immunology")
AnnotationAssertion(dcterms:description goldbook:13303 "Science that deals with the immune system including cell-mediated immunity (CMI) and humoral aspects of immunity and immune responses.")
Declaration(Class(goldbook:13304))
AnnotationAssertion(rdfs:label goldbook:13304 "immunomagnetic separation")
AnnotationAssertion(dcterms:description goldbook:13304 "Method of separating specific cell types or macromolecules with the aid of cell-specific antibodies coupled to paramagnetic beads.")
Declaration(Class(goldbook:13305))
AnnotationAssertion(rdfs:label goldbook:13305 "immunomodulation")
AnnotationAssertion(dcterms:description goldbook:13305 "Modification of the functioning of the immune system by the action of a substance that increases or reduces the ability to produce an immune response.")
Declaration(Class(goldbook:13306))
AnnotationAssertion(rdfs:label goldbook:13306 "immunopathology")
AnnotationAssertion(dcterms:description goldbook:13306 """1) Study of diseases of the immune system.
2) The occurrence of such diseases.""")
Declaration(Class(goldbook:13307))
AnnotationAssertion(rdfs:label goldbook:13307 "immunopathy")
AnnotationAssertion(dcterms:description goldbook:13307 "Disease of the immune system.")
Declaration(Class(goldbook:13308))
AnnotationAssertion(rdfs:label goldbook:13308 "immunopharmacology")
AnnotationAssertion(dcterms:description goldbook:13308 """1) Study of the immune system using drugs as diagnostic tools.
2) Use of pharmaceutical molecules to support and stimulate the immune system in patients with immunodeficiency, or to suppress or specifically influence the reactivity of the immune system in order to control a pathological immune reaction or disease.""")
Declaration(Class(goldbook:13309))
AnnotationAssertion(rdfs:label goldbook:13309 "immunophenotyping")
AnnotationAssertion(dcterms:description goldbook:13309 "Use of a panel of antibodies to determine a subset of proteins expressed on the surface of a cell or heterogeneous group of cells, often for diagnostic purposes, e.g., identifying the presence of leukemia cells in a population of lymphocytes.")
Declaration(Class(goldbook:13310))
AnnotationAssertion(rdfs:label goldbook:13310 "immunophilin")
AnnotationAssertion(dcterms:description goldbook:13310 "Any of a group of cytoplasmic proteins in T cells that are targets of the immunosuppressant drugs cyclosporin A, tacrolimus (fujimycin), rapamycin, and related compounds.")
Declaration(Class(goldbook:13311))
AnnotationAssertion(rdfs:label goldbook:13311 "immunopotentiation")
AnnotationAssertion(dcterms:description goldbook:13311 "Enhancement of the capacity of the immune system to produce an effective response.")
Declaration(Class(goldbook:13312))
AnnotationAssertion(rdfs:label goldbook:13312 "immunoprecipitate")
AnnotationAssertion(dcterms:description goldbook:13312 "Precipitate formed in an antigen–antibody reaction.")
Declaration(Class(goldbook:13313))
AnnotationAssertion(rdfs:label goldbook:13313 "immunoreceptor tyrosine-based activation motif")
AnnotationAssertion(dcterms:description goldbook:13313 "Consensus sequence for src-family tyrosine kinases, found in the cytoplasmic domains of several signaling molecules including the signal transduction units of lymphocyte antigen receptors and of Fc receptors.")
Declaration(Class(goldbook:13314))
AnnotationAssertion(rdfs:label goldbook:13314 "immunoreceptor tyrosine-based inhibitory motif")
AnnotationAssertion(dcterms:description goldbook:13314 "Consensus sequence present in the cytoplasmic domains of certain cell surface molecules [e.g., Fc \\(\\upgamma\\) RIIB, inhibitory natural killer (NK) cell receptors] and which mediates inhibitory signals.")
Declaration(Class(goldbook:13315))
AnnotationAssertion(rdfs:label goldbook:13315 "immunosensitivity")
AnnotationAssertion(dcterms:description goldbook:13315 "Reactivity to antigens.")
Declaration(Class(goldbook:13316))
AnnotationAssertion(rdfs:label goldbook:13316 "immunosensitizer")
AnnotationAssertion(dcterms:description goldbook:13316 "Substance that makes the immune system more reactive to antigens.")
Declaration(Class(goldbook:13317))
AnnotationAssertion(rdfs:label goldbook:13317 "immunostimulating complex")
AnnotationAssertion(dcterms:description goldbook:13317 "Immunological adjuvant composed of saponin, cholesterol, phospholipid, and an immunogen, usually protein.")
Declaration(Class(goldbook:13318))
AnnotationAssertion(rdfs:label goldbook:13318 "immunostimulation")
AnnotationAssertion(dcterms:description goldbook:13318 "Increase in immune function, e.g., by use of bacille Calmette–Guérin (BCG) vaccine or drugs.")
Declaration(Class(goldbook:13319))
AnnotationAssertion(rdfs:label goldbook:13319 "immunosuppressant")
AnnotationAssertion(dcterms:description goldbook:13319 "Substance that depresses the function of the immune system.")
Declaration(Class(goldbook:13320))
AnnotationAssertion(rdfs:label goldbook:13320 "immunosuppressive")
AnnotationAssertion(dcterms:description goldbook:13320 "Causing depression of the normal function of the immune system.")
Declaration(Class(goldbook:13321))
AnnotationAssertion(rdfs:label goldbook:13321 "immunosurveillance")
AnnotationAssertion(dcterms:description goldbook:13321 "Mechanisms by which the immune system is able to recognize and destroy malignant cells before the formation of an overt tumor.")
Declaration(Class(goldbook:13322))
AnnotationAssertion(rdfs:label goldbook:13322 "immunotherapy")
AnnotationAssertion(dcterms:description goldbook:13322 "Treatment or prevention of a disease using agents that can modify the immune response.")
Declaration(Class(goldbook:13323))
AnnotationAssertion(rdfs:label goldbook:13323 "immunotoxic")
AnnotationAssertion(dcterms:description goldbook:13323 "Harmful to the immune system.")
Declaration(Class(goldbook:13324))
AnnotationAssertion(rdfs:label goldbook:13324 "immunotoxicant")
AnnotationAssertion(dcterms:description goldbook:13324 "Substance that is harmful to the immune system.")
Declaration(Class(goldbook:13325))
AnnotationAssertion(rdfs:label goldbook:13325 "immunotoxicology")
AnnotationAssertion(dcterms:description goldbook:13325 "Discipline applying cardinal principals of both immunology and toxicology to study the ability of certain substances to alter the immune response.")
Declaration(Class(goldbook:13326))
AnnotationAssertion(rdfs:label goldbook:13326 "immunotoxin")
AnnotationAssertion(dcterms:description goldbook:13326 "Biochemical conjugate, or recombinant fusion protein, consisting of an immune targeting molecule such as an antibody or antibody fragment together with a cytotoxic molecule.")
Declaration(Class(goldbook:13327))
AnnotationAssertion(rdfs:label goldbook:13327 "inactivated vaccine")
AnnotationAssertion(dcterms:description goldbook:13327 "Vaccine formulated from the whole microorganism that has been rendered unable to reproduce or cause disease, often by mutation or heat denaturation.")
Declaration(Class(goldbook:13328))
AnnotationAssertion(rdfs:label goldbook:13328 "indirect immunofluorescence")
AnnotationAssertion(dcterms:description goldbook:13328 "Method of visualizing an antigen in which an unlabeled antibody against the antigen is reacted with it first, and then is detected by staining with a second fluorescently tagged immunoglobulin G (IgG) directed against the first antibody.")
Declaration(Class(goldbook:13329))
AnnotationAssertion(rdfs:label goldbook:13329 "indolamine-2,3-dioxygenase")
AnnotationAssertion(dcterms:description goldbook:13329 "Enzyme catalyzing the initial rate-limiting step of tryptophan degradation.")
Declaration(Class(goldbook:13330))
AnnotationAssertion(rdfs:label goldbook:13330 "inducible co-stimulatory protein")
AnnotationAssertion(dcterms:description goldbook:13330 "Highly specific receptor for the protein B7H/B7RP-1 that is expressed on the surface of B cells and macrophages, and also appears on the surface of T cells during the process of T-cell activation.")
Declaration(Class(goldbook:13331))
AnnotationAssertion(rdfs:label goldbook:13331 "infectious tolerance")
AnnotationAssertion(dcterms:description goldbook:13331 "Continuing state of tolerance that can be transferred by T lymphocytes from a tolerant animal.")
Declaration(Class(goldbook:13332))
AnnotationAssertion(rdfs:label goldbook:13332 "autoimmune infertility")
AnnotationAssertion(dcterms:description goldbook:13332 "Infertility caused by sperm antibodies, autoimmune ovarian inflammation (oophoritis), or autoimmune orchitis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13332 "autoimmune infertility")
Declaration(Class(goldbook:13333))
AnnotationAssertion(rdfs:label goldbook:13333 "inflammasome")
AnnotationAssertion(dcterms:description goldbook:13333 "High-molecular-weight complex that activates inflammatory caspases and the cytokines interleukin-1$\\ce{\\upbeta\\!}$ ($\\ce{IL\\mbox{-}1\\upbeta\\!}$) and IL-18.")
Declaration(Class(goldbook:13334))
AnnotationAssertion(rdfs:label goldbook:13334 "inflammatory bowel disease")
AnnotationAssertion(dcterms:description goldbook:13334 "Group of chronic inflammatory conditions resulting in the inappropriate and persistent activation of the mucosal immune system of the bowel.")
Declaration(Class(goldbook:13335))
AnnotationAssertion(rdfs:label goldbook:13335 "innate immunity")
AnnotationAssertion(dcterms:description goldbook:13335 "Immunity that is not intrinsically affected by prior contact with antigen, i.e., all aspects of immunity not directly mediated by lymphocytes.")
Declaration(Class(goldbook:13336))
AnnotationAssertion(rdfs:label goldbook:13336 "intercellular adhesion molecule")
AnnotationAssertion(dcterms:description goldbook:13336 "Member of the immunoglobulin superfamily that interacts with integrins and is found on the surface of several cell types, including antigen-presenting cells (APCs) and T cells.")
Declaration(Class(goldbook:13337))
AnnotationAssertion(rdfs:label goldbook:13337 "interclonal competition")
AnnotationAssertion(dcterms:description goldbook:13337 "Process which favors survival of foreign-specific lymphocytes at the expense of self-specific lymphocytes and is a secondary mechanism involved in the induction and maintenance of self-tolerance.")
Declaration(Class(goldbook:13338))
AnnotationAssertion(rdfs:label goldbook:13338 "interleukin")
AnnotationAssertion(dcterms:description goldbook:13338 "Member of a group of immunoregulatory glycoproteins, also called lymphokines, monokines, or cytokines.")
Declaration(Class(goldbook:13339))
AnnotationAssertion(rdfs:label goldbook:13339 "internal image")
AnnotationAssertion(dcterms:description goldbook:13339 "Epitope on an anti-idiotype that binds in a way that structurally and functionally mimics the antigen.")
Declaration(Class(goldbook:13340))
AnnotationAssertion(rdfs:label goldbook:13340 "intolerance")
AnnotationAssertion(dcterms:description goldbook:13340 "Extreme sensitivity or allergy to a drug, food, or other substance.")
Declaration(Class(goldbook:13341))
AnnotationAssertion(rdfs:label goldbook:13341 "intradermal test")
AnnotationAssertion(dcterms:description goldbook:13341 "Diagnostic test for a possible cause of hypersensitivity in an individual in which a small drop of antigen is placed on a scarified skin surface or injected intradermally.")
Declaration(Class(goldbook:13342))
AnnotationAssertion(rdfs:label goldbook:13342 "intra-epithelial lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13342 "Lymphocyte found in the epithelial layer of mammalian mucosal linings, such as those of the gastrointestinal and reproductive tracts.")
Declaration(Class(goldbook:13343))
AnnotationAssertion(rdfs:label goldbook:13343 "invariant chain")
AnnotationAssertion(dcterms:description goldbook:13343 "Protein (\\(\\pu{31 kDa}\\)) of the endoplasmic reticulum lumen that binds to newly formed major histocompatibility complex (MHC) heterodimeric proteins, preventing binding of endogenous peptides to their groove.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13343 "CD74")
Declaration(Class(goldbook:13344))
AnnotationAssertion(rdfs:label goldbook:13344 "islet cell antibodies")
AnnotationAssertion(dcterms:description goldbook:13344 "Autoantibodies reacting with endocrine (pancreatic islet) cells and detectable by indirect immunofluorescence on pancreatic cryostat sections.")
Declaration(Class(goldbook:13345))
AnnotationAssertion(rdfs:label goldbook:13345 "isograft")
AnnotationAssertion(dcterms:description goldbook:13345 "Tissue transplanted (see graft) between two genetically identical individuals.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13345 "syngraft")
Declaration(Class(goldbook:13346))
AnnotationAssertion(rdfs:label goldbook:13346 "isohemagglutinin")
AnnotationAssertion(dcterms:description goldbook:13346 "Naturally occurring immunoglobulin M (IgM) antibody specific for the erythrocyte antigens of the ABO blood groups, thought to result from immunization by bacteria in the gastrointestinal and respiratory tracts.")
Declaration(Class(goldbook:13347))
AnnotationAssertion(rdfs:label goldbook:13347 "isotype")
AnnotationAssertion(dcterms:description goldbook:13347 "Class of antibody that differs from others in the constant region of the heavy chain (Fc portion).")
Declaration(Class(goldbook:13348))
AnnotationAssertion(rdfs:label goldbook:13348 "isotype control")
AnnotationAssertion(dcterms:description goldbook:13348 "Antibody exhibiting the non-specific characteristics of the antibody-isotype but lacking any specificity for the antigen in question; used as a negative control in antibody-antigen detection assays, notably in flow cytometry.")
Declaration(Class(goldbook:13349))
AnnotationAssertion(rdfs:label goldbook:13349 "isotype switch")
AnnotationAssertion(dcterms:description goldbook:13349 "Process by which a B cell switches from making antibody of one isotype to another without altering the specificity of the antibody, producing an isotype with the same variable (V) regions but a different heavy chain constant (C) region.")
Declaration(Class(goldbook:13350))
AnnotationAssertion(rdfs:label goldbook:13350 "JAK/STAT signaling pathway")
AnnotationAssertion(dcterms:description goldbook:13350 "Mechanism that transmits information from chemical signals outside the cell to gene promoters on the DNA in the cell nucleus. The mechanism is activated by the binding of Janus-family tyrosine kinase (JAK) to the nonpolypeptide portion of occupied receptors for some interleukins (IL). JAK phosphorylates signal transducer and activator of transcription (STAT) proteins apart from STAT 5a and 5b.")
Declaration(Class(goldbook:13351))
AnnotationAssertion(rdfs:label goldbook:13351 "JAM test")
AnnotationAssertion(dcterms:description goldbook:13351 "Method which uses labeled nucleotide precursors to estimate DNA fragmentation during cell-mediated cytotoxicity or apoptosis.")
Declaration(Class(goldbook:13352))
AnnotationAssertion(rdfs:label goldbook:13352 "Janus-family tyrosine kinase")
AnnotationAssertion(dcterms:description goldbook:13352 "Tyrosine kinase activated by cytokines binding to cell receptors.")
Declaration(Class(goldbook:13353))
AnnotationAssertion(rdfs:label goldbook:13353 "joining chain")
AnnotationAssertion(dcterms:description goldbook:13353 "Polypeptide that forms part of the polymeric structure of pentameric immunoglobulin M (IgM) and dimeric immunoglobulin A (IgA).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13353 "J chain")
Declaration(Class(goldbook:13354))
AnnotationAssertion(rdfs:label goldbook:13354 "joining gene")
AnnotationAssertion(dcterms:description goldbook:13354 "Gene coding for a joining segment that connects variable (V) regions and constant (C) regions of immunoglobulin (Ig) or T-cell receptor (TCR) chains that, upon gene rearrangement, encodes part of the third hypervariable region of the antigen receptors.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13354 "J gene")
Declaration(Class(goldbook:13355))
AnnotationAssertion(rdfs:label goldbook:13355 "junctional diversity")
AnnotationAssertion(dcterms:description goldbook:13355 "Diversity of the splice junctions in the recombined variable (V) gene, diversity (D) gene [for immunoglobulin (Ig) heavy chains, and for TCR b and d chains], and joining (J) gene segments of antibody and T-cell receptor (TCR) genes.")
Declaration(Class(goldbook:13356))
AnnotationAssertion(rdfs:label goldbook:13356 "kallikrein")
AnnotationAssertion(dcterms:description goldbook:13356 "Any of a group of enzymes found in the blood and body fluids that acts on certain plasma globulins to produce bradykinins.")
Declaration(Class(goldbook:13357))
AnnotationAssertion(rdfs:label goldbook:13357 "Kaposi sarcoma")
AnnotationAssertion(dcterms:description goldbook:13357 "Form of skin cancer that can involve internal organs. It is most often found in patients with acquired immunodeficiency syndrome (AIDS) and can be fatal.")
Declaration(Class(goldbook:13358))
AnnotationAssertion(rdfs:label goldbook:13358 "kappa-light chain")
AnnotationAssertion(dcterms:description goldbook:13358 "Smaller of the two types of light chain found in human immunoglobulins (Ig), the other type being a lambda ($\\uplambda\\!$)-light chain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13358 "κ-light chain")
Declaration(Class(goldbook:13359))
AnnotationAssertion(rdfs:label goldbook:13359 "keratinocyte")
AnnotationAssertion(dcterms:description goldbook:13359 "Epidermal cell that produces keratin.")
Declaration(Class(goldbook:13360))
AnnotationAssertion(rdfs:label goldbook:13360 "killer activatory receptor")
AnnotationAssertion(dcterms:description goldbook:13360 "Receptor found on natural killer (NK) cells, and some $\\ce{\\upgamma\\!{:}\\updelta\\!}$ and $\\ce{\\upalpha\\!{:}\\upbeta\\! T cells}$.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13360 "killer cell immunoglobulin-like receptor")
Declaration(Class(goldbook:13361))
AnnotationAssertion(rdfs:label goldbook:13361 "killer cell")
AnnotationAssertion(dcterms:description goldbook:13361 "Cell that displays cell-mediated cytotoxicity, including cytotoxic T lymphocytes (CTL, Tc), natural killer (NK) cells, and natural killer T (NKT) cells. Some also consider activated macrophages, monocytes, and interferon (IFN)-activated neutrophils to be killer cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13361 "K cell")
Declaration(Class(goldbook:13362))
AnnotationAssertion(rdfs:label goldbook:13362 "killer cell immunoglobulin-like receptor")
AnnotationAssertion(dcterms:description goldbook:13362 "Receptor expressed on natural killer (NK) cells that binds to major histocompatibility complex (MHC) class I molecules on target cells; binding MHC class I inhibits the signaling that would otherwise lead to target cell killing.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13362 "killer inhibitory receptor")
Declaration(Class(goldbook:13363))
AnnotationAssertion(rdfs:label goldbook:13363 "killer lectin-like receptor")
AnnotationAssertion(dcterms:description goldbook:13363 "Killer cell receptor that binds to major histocompatibility complex (MHC) class I molecules and, like the C-type lectin receptors also found on these cells, can either inhibit or activate the killer cells.")
Declaration(Class(goldbook:13364))
AnnotationAssertion(rdfs:label goldbook:13364 "kinin")
AnnotationAssertion(dcterms:description goldbook:13364 "Any of a family of polypeptides that is released during inflammatory responses and that increases vascular permeability and smooth muscle contraction.")
Declaration(Class(goldbook:13365))
AnnotationAssertion(rdfs:label goldbook:13365 "knockout")
AnnotationAssertion(dcterms:description goldbook:13365 "Use of homologous genetic recombination in embryonic stem cells to replace a functional gene with a defective copy of the gene.")
Declaration(Class(goldbook:13366))
AnnotationAssertion(rdfs:label goldbook:13366 "knockout mouse")
AnnotationAssertion(dcterms:description goldbook:13366 "Mouse produced from embryonic cells containing DNA that has been genetically engineered so that it does not express a particular gene or group of genes.")
Declaration(Class(goldbook:13367))
AnnotationAssertion(rdfs:label goldbook:13367 "Kupffer cell")
AnnotationAssertion(dcterms:description goldbook:13367 "Fixed tissue macrophage found lining the blood sinuses in the liver.")
Declaration(Class(goldbook:13368))
AnnotationAssertion(rdfs:label goldbook:13368 "Kveim reaction")
AnnotationAssertion(dcterms:description goldbook:13368 "Test for sarcoidosis, eliciting a granuloma at the site of intrradermal injection of a lymph node extract from a person with active disease. Generally considered non-specific.")
Declaration(Class(goldbook:13369))
AnnotationAssertion(rdfs:label goldbook:13369 "L-selectin")
AnnotationAssertion(dcterms:description goldbook:13369 "Any of a group of leukocyte surface adhesion molecules; they are classed as CD62 in the cluster of differentiation (CD) antigen marker system. All have lectin family carbohydrate binding domains and epidermal growth factor (EGF) repeats.")
Declaration(Class(goldbook:13370))
AnnotationAssertion(rdfs:label goldbook:13370 "Ly-6")
AnnotationAssertion(dcterms:description goldbook:13370 "Family of multi-gene-encoded, small, generally glycosylphosphatidyl inositol-anchored membrane proteins thought to be involved in cell adhesion and signaling, and in antigen-independent activation of lymphocytes.")
Declaration(Class(goldbook:13371))
AnnotationAssertion(rdfs:label goldbook:13371 "Lambert–Eaton myasthenic syndrome")
AnnotationAssertion(dcterms:description goldbook:13371 "Paraneoplastic neurological disorder associated with small-cell lung cancer and caused by autoantibodies against voltage-gated calcium channels.")
Declaration(Class(goldbook:13372))
AnnotationAssertion(rdfs:label goldbook:13372 "lambda (λ)-light chain")
AnnotationAssertion(dcterms:description goldbook:13372 "One of the two types of light chain of human immunoglobulins (Ig), the other type being the kappa ($\\kappa$)-light chain.")
Declaration(Class(goldbook:13373))
AnnotationAssertion(rdfs:label goldbook:13373 "Langerhans cell")
AnnotationAssertion(dcterms:description goldbook:13373 "Immature, phagocytic dendritic cell of the mammalian skin, characterized by the presence of Fc receptors, major histocompatibility (MHC) class II molecules, and epidermal dendritic cell marker CD1. It contains a cytoplasmic organelle called the Birbeck granule.")
Declaration(Class(goldbook:13374))
AnnotationAssertion(rdfs:label goldbook:13374 "large granular lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13374 "Lymphocyte of greater than normal size that contains cytoplasmic granules and functions as a natural killer (NK) cell or killer (K) cell. Activated CD8+ cytotoxic T lymphocytes (CTL, Tc) also assume an LGL morphology.")
Declaration(Class(goldbook:13375))
AnnotationAssertion(rdfs:label goldbook:13375 "late phase reaction")
AnnotationAssertion(dcterms:description goldbook:13375 "Immunoglobulin E (IgE)-mediated immune response occurring \\(\\pu{5}\\) to \\(\\pu{8 h}\\) after exposure to antigen, after the 'wheal and flare' reaction of immediate hypersensitivity has diminished, with inflammation peaking around \\(\\pu{24 h}\\), and then subsiding.")
Declaration(Class(goldbook:13376))
AnnotationAssertion(rdfs:label goldbook:13376 "latex agglutination test")
AnnotationAssertion(dcterms:description goldbook:13376 "Use of latex beads coated with antibodies to detect antigen in biological samples.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13376 "latex fixation test")
Declaration(Class(goldbook:13377))
AnnotationAssertion(rdfs:label goldbook:13377 "latex allergen")
AnnotationAssertion(dcterms:description goldbook:13377 "Allergen found in natural rubber latex (NRL).")
Declaration(Class(goldbook:13378))
AnnotationAssertion(rdfs:label goldbook:13378 "leukemia")
AnnotationAssertion(dcterms:description goldbook:13378 "Progressive, malignant disease of the blood-forming organs, characterized by excessive proliferation and development of leucocytes and their precursors in the bone marrow and blood.")
Declaration(Class(goldbook:13379))
AnnotationAssertion(rdfs:label goldbook:13379 "leukocyte")
AnnotationAssertion(dcterms:description goldbook:13379 "White blood cell.")
Declaration(Class(goldbook:13380))
AnnotationAssertion(rdfs:label goldbook:13380 "leukocyte common antigen")
AnnotationAssertion(dcterms:description goldbook:13380 "Antigen common to both T lymphocytes and B lymphocytes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13380 "CD45")
Declaration(Class(goldbook:13381))
AnnotationAssertion(rdfs:label goldbook:13381 "leukocyte functional antigen")
AnnotationAssertion(dcterms:description goldbook:13381 "Any of a group of cell-surface antigens involved in intercellular adhesion.")
Declaration(Class(goldbook:13382))
AnnotationAssertion(rdfs:label goldbook:13382 "leukocytopenia")
AnnotationAssertion(dcterms:description goldbook:13382 "Amount of leukocytes below normal values that is a characteristic feature of systemic autoimmune diseases [e.g., Felty syndrome, systemic lupus erythematosus (SLE), Sjögren syndrome, mixed connective tissue disease (MCTD)].")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13382 "leukopenia")
Declaration(Class(goldbook:13383))
AnnotationAssertion(rdfs:label goldbook:13383 "leukocytosis")
AnnotationAssertion(dcterms:description goldbook:13383 "Abnormal increase in the number of leukocytes.")
Declaration(Class(goldbook:13384))
AnnotationAssertion(rdfs:label goldbook:13384 "leukotriene")
AnnotationAssertion(dcterms:description goldbook:13384 "Metabolic product of arachidonic acid that promotes inflammatory processes (e.g., chemotaxis, increased vascular permeability) and is produced by a variety of cell types including mast cells, basophils, and macrophages.")
Declaration(Class(goldbook:13385))
AnnotationAssertion(rdfs:label goldbook:13385 "ligand of inducible co-stimulatory protein")
AnnotationAssertion(dcterms:description goldbook:13385 "Protein involved, after binding to inducible co-stimulatory protein (ICOS), in several harmful immune responses, such as autoimmunity, allergy, or graft-versus-host (GVH) reaction.")
Declaration(Class(goldbook:13386))
AnnotationAssertion(rdfs:label goldbook:13386 "light chain")
AnnotationAssertion(dcterms:description goldbook:13386 "Small polypeptide subunit of an antibody or immunoglobulin (Ig).")
Declaration(Class(goldbook:13387))
AnnotationAssertion(rdfs:label goldbook:13387 "Limulus test")
AnnotationAssertion(dcterms:description goldbook:13387 "Method of detecting bacterial endotoxins based on gelation of a blood cell lysate from the horseshoe crab, Limulus polyphemus.")
Declaration(Class(goldbook:13388))
AnnotationAssertion(rdfs:label goldbook:13388 "linear epitope")
AnnotationAssertion(dcterms:description goldbook:13388 "Antigenic determinant that is contiguous in the amino acid sequence of a protein and therefore does not require the protein to be folded into its native conformation for antibody to bind.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13388 "continuous epitope")
Declaration(Class(goldbook:13389))
AnnotationAssertion(rdfs:label goldbook:13389 "linked recognition")
AnnotationAssertion(dcterms:description goldbook:13389 "Requirement for a helper T lymphocyte (Th) and B lymphocyte to interact with separate but physically linked epitopes in the same antigen, in order for an immune response to a thymus-dependent (TD) antigen.")
Declaration(Class(goldbook:13390))
AnnotationAssertion(rdfs:label goldbook:13390 "lipid raft")
AnnotationAssertion(dcterms:description goldbook:13390 "Cholesterol- and glycosphingolipid-rich membrane subdomain in which molecules involved in cellular activation become concentrated.")
Declaration(Class(goldbook:13391))
AnnotationAssertion(rdfs:label goldbook:13391 "live attenuated vaccine")
AnnotationAssertion(dcterms:description goldbook:13391 "Vaccine prepared from living attenuated organisms or from viruses that have been attenuated but can still replicate in the cells of the host organism.")
Declaration(Class(goldbook:13392))
AnnotationAssertion(rdfs:label goldbook:13392 "liver-kidney microsomal antibodies")
AnnotationAssertion(dcterms:description goldbook:13392 "Autoantibodies directed against cytochrome P450 and uridine diphosphate (UDP)-glucuronosyltransferase (UGT) antigens typically found in patients with immune-mediated hepatitis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13392 "LKM antibodies")
Declaration(Class(goldbook:13393))
AnnotationAssertion(rdfs:label goldbook:13393 "lymphadenopathy")
AnnotationAssertion(dcterms:description goldbook:13393 "Enlarged lymph nodes.")
Declaration(Class(goldbook:13394))
AnnotationAssertion(rdfs:label goldbook:13394 "lymphangion")
AnnotationAssertion(dcterms:description goldbook:13394 "Morphological or functional unit of lymphatic vessels consisting of the region between adjacent lymphatic valves.")
Declaration(Class(goldbook:13395))
AnnotationAssertion(rdfs:label goldbook:13395 "lymphatic system")
AnnotationAssertion(dcterms:description goldbook:13395 "Describing vessels whose special function is the collection of lymph and its ultimate conveyance to the blood circulation and thoracic duct.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13395 "lymphatic")
Declaration(Class(goldbook:13396))
AnnotationAssertion(rdfs:label goldbook:13396 "lymphatic tissue")
AnnotationAssertion(dcterms:description goldbook:13396 "Tissue involved in the collection, production, and handling of lymph, including the lymphatic vessels and lymph nodes.")
Declaration(Class(goldbook:13397))
AnnotationAssertion(rdfs:label goldbook:13397 "lymph node")
AnnotationAssertion(dcterms:description goldbook:13397 "Any of the small rounded gland-like structures of the lymphatic system, which occur along the lymphatic vessels and which are responsible for removing bacteria, viruses, and foreign molecules from the lymph stream and for producing lymphocytes and antibodies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13397 "lymph gland")
Declaration(Class(goldbook:13398))
AnnotationAssertion(rdfs:label goldbook:13398 "lymphoblast")
AnnotationAssertion(dcterms:description goldbook:13398 "Abnormal cell with a large nucleus and scanty cytoplasm, thought to be the precursor of the lymphocyte, found in blood and blood-forming organs in patients with lymphoblastic leukemia.")
Declaration(Class(goldbook:13399))
AnnotationAssertion(rdfs:label goldbook:13399 "lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13399 "Small leucocyte found in the blood, lymph, and lymphoid tissues that has a single round nucleus and little or no granulation in the cytoplasm.")
Declaration(Class(goldbook:13400))
AnnotationAssertion(rdfs:label goldbook:13400 "lymphocyte-activating factor")
AnnotationAssertion(dcterms:description goldbook:13400 "Interleukin-1 (IL-1)")
Declaration(Class(goldbook:13401))
AnnotationAssertion(rdfs:label goldbook:13401 "lymphocyte activation")
AnnotationAssertion(dcterms:description goldbook:13401 "Sum of the biochemical processes necessary to stimulate a resting lymphocyte to become an immune effector cell, requiring antigen and co-stimulatory molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13401 "activation")
Declaration(Class(goldbook:13402))
AnnotationAssertion(rdfs:label goldbook:13402 "lymphocyte function-associated antigen-1")
AnnotationAssertion(dcterms:description goldbook:13402 "Adhesion molecule found on lymphocytes, macrophages, and neutrophils, involved in adhesion of lymphocytes to antigen-presenting cells (APCs).")
Declaration(Class(goldbook:13403))
AnnotationAssertion(rdfs:label goldbook:13403 "lymphocyte homing")
AnnotationAssertion(dcterms:description goldbook:13403 "Process that directs lymphocyte subsets to specialized microenvironments that control their differentiation, regulate their survival, and target immune effector cells to sites of antigenic or microbial invasion.")
Declaration(Class(goldbook:13404))
AnnotationAssertion(rdfs:label goldbook:13404 "lymphocyte homing receptor")
AnnotationAssertion(dcterms:description goldbook:13404 "Cell surface glycoprotein on lymphocytes and other leukocytes that mediates adhesion to specialized blood vessels, the high endothelial venules.")
Declaration(Class(goldbook:13405))
AnnotationAssertion(rdfs:label goldbook:13405 "lymphocyte proliferation test")
AnnotationAssertion(dcterms:description goldbook:13405 "Test of immune sensitization in which white blood cells are exposed in vitro to an antigen and multiply if already sensitized to that antigen.")
Declaration(Class(goldbook:13406))
AnnotationAssertion(rdfs:label goldbook:13406 "immunoglobulin or T-cell receptor lymphocyte repertoire")
AnnotationAssertion(dcterms:description goldbook:13406 "Profile of immunoglobulins (Ig) or T-cell receptors (TCRs) available within a specified group of cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13406 "immunoglobulin lymphocyte repertoire")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13406 "T-Cell Receptor")
Declaration(Class(goldbook:13407))
AnnotationAssertion(rdfs:label goldbook:13407 "lymphocyte subpopulation")
AnnotationAssertion(dcterms:description goldbook:13407 "Population forming part of the whole population of lymphocytes, usually characterized by sensitivity to a given antigen.")
Declaration(Class(goldbook:13408))
AnnotationAssertion(rdfs:label goldbook:13408 "lymphocyte transformation test")
AnnotationAssertion(dcterms:description goldbook:13408 "Test for increased DNA synthesis followed by cell division and differentiation of lymphocytes in response to antigens or mitogens; an in vitro test of lymphocyte function.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13408 "blastogenesis assay")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13408 "lymphocyte blastogenesis assay (LBA)")
Declaration(Class(goldbook:13409))
AnnotationAssertion(rdfs:label goldbook:13409 "lymphocytopenia")
AnnotationAssertion(dcterms:description goldbook:13409 "Deficiency of lymphocytes in the blood compared with normal values.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13409 "lymphopenia")
Declaration(Class(goldbook:13410))
AnnotationAssertion(rdfs:label goldbook:13410 "lymphocytosis")
AnnotationAssertion(dcterms:description goldbook:13410 "Condition characterized by an abnormal increase in the number of lymphocytes in blood, usually a result of infection or inflammation.")
Declaration(Class(goldbook:13411))
AnnotationAssertion(rdfs:label goldbook:13411 "lymphocytotoxicity")
AnnotationAssertion(dcterms:description goldbook:13411 "Capability of lysing lymphocytes.")
Declaration(Class(goldbook:13412))
AnnotationAssertion(rdfs:label goldbook:13412 "lymphoid follicle")
AnnotationAssertion(dcterms:description goldbook:13412 "Region of clustered B cells, allowing the selection of antigen-binding B cells by dendritic cells during adaptive immune responses.")
Declaration(Class(goldbook:13413))
AnnotationAssertion(rdfs:label goldbook:13413 "lymphoid stem cell")
AnnotationAssertion(dcterms:description goldbook:13413 "Stem cell giving rise to the lineage of lymphocytes.")
Declaration(Class(goldbook:13414))
AnnotationAssertion(rdfs:label goldbook:13414 "lymphoid tissue")
AnnotationAssertion(dcterms:description goldbook:13414 "Vertebrate tissue that is made up predominantly of lymphocytes, e.g., lymph, lymph nodes, spleen, thymus, Peyer’s patches, adenoids, pharyngeal tonsils, and, in birds, bursa of Fabricius and cecal tonsils.")
Declaration(Class(goldbook:13415))
AnnotationAssertion(rdfs:label goldbook:13415 "lymphokine")
AnnotationAssertion(dcterms:description goldbook:13415 "Cytokine produced by lymphocytes.")
Declaration(Class(goldbook:13416))
AnnotationAssertion(rdfs:label goldbook:13416 "lymphokine-activated killer cell")
AnnotationAssertion(dcterms:description goldbook:13416 "Killer (K) cell or natural killer (NK) cell activated in vitro by interleukin (IL)-2 to give enhanced killing of target cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13416 "LAK cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13416 "lymphocyte-activated killer cell")
Declaration(Class(goldbook:13417))
AnnotationAssertion(rdfs:label goldbook:13417 "lymphoma")
AnnotationAssertion(dcterms:description goldbook:13417 "Neoplasm, usually malignant, of the lymphatic tissues.")
Declaration(Class(goldbook:13418))
AnnotationAssertion(rdfs:label goldbook:13418 "lymphopoiesis")
AnnotationAssertion(dcterms:description goldbook:13418 "Production of lymphocytes.")
Declaration(Class(goldbook:13419))
AnnotationAssertion(rdfs:label goldbook:13419 "lymphoproliferation")
AnnotationAssertion(dcterms:description goldbook:13419 "Proliferation of lymphocytes in response to stimulation with cellular activators, including antigens or mitogens.")
Declaration(Class(goldbook:13420))
AnnotationAssertion(rdfs:label goldbook:13420 "lymphosum")
AnnotationAssertion(dcterms:description goldbook:13420 "Sum of B cells + T cells + natural killer (NK) cells determined separately (by flow cytometry), compared to the total number of lymphocytes.")
Declaration(Class(goldbook:13421))
AnnotationAssertion(rdfs:label goldbook:13421 "lymphotoxin")
AnnotationAssertion(dcterms:description goldbook:13421 "T-cell-derived cytokine that is cytotoxic for certain tumor cells and also has immunoregulatory functions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13421 "Tumor necrosis factor β (TNF-β).")
Declaration(Class(goldbook:13422))
AnnotationAssertion(rdfs:label goldbook:13422 "lysosome")
AnnotationAssertion(dcterms:description goldbook:13422 "Cytoplasmic granule containing hydrolytic enzymes involved in the digestion of phagocytosed material.")
Declaration(Class(goldbook:13423))
AnnotationAssertion(rdfs:label goldbook:13423 "macroautophagy")
AnnotationAssertion(dcterms:description goldbook:13423 "Sequestration and breakdown of organelles and long-lived proteins in a double-membrane vesicle, called an autophagosome or autophagic vacuole, inside the cell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13423 "non-specific autophagy")
Declaration(Class(goldbook:13424))
AnnotationAssertion(rdfs:label goldbook:13424 "macrophage")
AnnotationAssertion(dcterms:description goldbook:13424 "Large (\\(\\pu{10\\!{-}\\! 20 \\upmu m}\\) diameter) ameboid and phagocytic cell found in many tissues, especially in areas of inflammation, derived from blood monocytes and playing an important role in host defense mechanisms.")
Declaration(Class(goldbook:13425))
AnnotationAssertion(rdfs:label goldbook:13425 "residential macrophage")
AnnotationAssertion(dcterms:description goldbook:13425 "Macrophage stationed at a point where microbial invasion or accumulation of dust is likely to occur.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13425 "fixed macrophage")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13425 "resident macrophage")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13425 "residential macrophage")
Declaration(Class(goldbook:13426))
AnnotationAssertion(rdfs:label goldbook:13426 "macrophage function test")
AnnotationAssertion(dcterms:description goldbook:13426 "Any assay suitable to characterize the effect of substances on macrophage function in in vivo or in vitro.")
Declaration(Class(goldbook:13427))
AnnotationAssertion(rdfs:label goldbook:13427 "macrophage mannose receptor")
AnnotationAssertion(dcterms:description goldbook:13427 "Receptor involved in pathogen recognition, in clearance of endogenous serum glycoproteins, and in antigen presentation.")
Declaration(Class(goldbook:13428))
AnnotationAssertion(rdfs:label goldbook:13428 "macropinocytosis")
AnnotationAssertion(dcterms:description goldbook:13428 "'High-volume' pinocytosis by which dendritic cells engulf relatively large volumes of fluid from their surroundings, enabling them to take in many antigens nonspecifically.")
Declaration(Class(goldbook:13429))
AnnotationAssertion(rdfs:label goldbook:13429 "major basic protein")
AnnotationAssertion(dcterms:description goldbook:13429 "Small basic arginine-rich peptide (\\(\\pu{pI 10.9}\\), molecular mass of \\(\\pu{13.8 kDa}\\)) in the granules of eosinophils that kills helminths and protozoa.")
Declaration(Class(goldbook:13430))
AnnotationAssertion(rdfs:label goldbook:13430 "major histocompatibility complex")
AnnotationAssertion(dcterms:description goldbook:13430 "Cluster of genes encoding cell surface molecules involved in antigen presentation to T cells. In humans, they are found on chromosome 6 and in mice on chromosome 17. They are polymorphic and code for antigens that lead to rapid graft rejection between members of a single species that differ at these loci.")
Declaration(Class(goldbook:13431))
AnnotationAssertion(rdfs:label goldbook:13431 "major histocompatibility complex class I molecule")
AnnotationAssertion(dcterms:description goldbook:13431 "Surface protein encoded by the major histocompatibility complex (MHC) expressed on all nucleated cells, presenting antigen-derived peptides.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13431 "class I MHC gene product")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13431 "MHC class I molecule")
Declaration(Class(goldbook:13432))
AnnotationAssertion(rdfs:label goldbook:13432 "major histocompatibility complex class II molecule")
AnnotationAssertion(dcterms:description goldbook:13432 "Surface protein encoded by the major histocompatibility complex (MHC) expressed on antigen-presenting cells (APCs), presenting antigen-derived peptides.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13432 "class II MHC gene product")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13432 "MHC class II molecule")
Declaration(Class(goldbook:13433))
AnnotationAssertion(rdfs:label goldbook:13433 "major histocompatibility complex class III molecule")
AnnotationAssertion(dcterms:description goldbook:13433 "Antigen encoded by the major histocompatibility complex (MHC) including several complement factors, tumor necrosis factor (TNF) $\\ce{\\upalpha\\!}$, and lymphotoxin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13433 "class III MHC gene product")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13433 "MHC class III molecule")
Declaration(Class(goldbook:13434))
AnnotationAssertion(rdfs:label goldbook:13434 "major histocompatibility complex molecule")
AnnotationAssertion(dcterms:description goldbook:13434 "Any of the cell-surface glycoprotein alloantigens encoded by the major histocompatibility complex (MHC) that are involved in the regulation of immune responses and can cause the rejection of grafted tissues, cells, and tumors bearing them.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13434 "MHC molecule")
Declaration(Class(goldbook:13435))
AnnotationAssertion(rdfs:label goldbook:13435 "major histocompatibility complex restriction")
AnnotationAssertion(dcterms:description goldbook:13435 "Necessity that T cells recognize processed antigen only when presented by major histocompatibility complex (MHC) molecules of the original haplotype associated with T-cell priming.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13435 "MHC restriction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13435 "restriction (in immunology)")
Declaration(Class(goldbook:13436))
AnnotationAssertion(rdfs:label goldbook:13436 "mammalian target of rapamycin")
AnnotationAssertion(dcterms:description goldbook:13436 "Intracellular signaling molecule (phosphoinositide-3-kinase) involved in control of cell growth, whose activity is negatively influenced by the immunosuppressive drug rapamycin.")
Declaration(Class(goldbook:13437))
AnnotationAssertion(rdfs:label goldbook:13437 "mannan-binding lectin-associated serine peptidase-1 and -2")
AnnotationAssertion(dcterms:description goldbook:13437 "Complement-dependent bactericidal factors that bind to the Ra and R2 polysaccharides expressed by certain enterobacterium strains, such as Ra chemotype strains of Salmonella.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13437 "mannose-binding protein-associated serine protease (MASP)")
Declaration(Class(goldbook:13438))
AnnotationAssertion(rdfs:label goldbook:13438 "mannose-binding protein")
AnnotationAssertion(dcterms:description goldbook:13438 "Member of the collectin family of calcium-dependent lectins, and an acute-phase protein.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13438 "mannose-binding lectin (MBL)")
Declaration(Class(goldbook:13439))
AnnotationAssertion(rdfs:label goldbook:13439 "mantle zone")
AnnotationAssertion(dcterms:description goldbook:13439 "Outer ring of small lymphocytes surrounding the center of a lymphatic nodule (lymphoid follicle). It contains transient lymphocytes and is the location of the lymphoma in mantle cell lymphoma.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13439 "corona")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13439 "mantle")
Declaration(Class(goldbook:13440))
AnnotationAssertion(rdfs:label goldbook:13440 "marginal zone")
AnnotationAssertion(dcterms:description goldbook:13440 "Outer area of the splenic periarteriolar lymphoid sheath (PALS) that is rich in B cells, particularly those responding to thymus-independent antigens.")
Declaration(Class(goldbook:13441))
AnnotationAssertion(rdfs:label goldbook:13441 "margination")
AnnotationAssertion(dcterms:description goldbook:13441 "Leukocyte adhesion to the endothelium of blood vessels in the early phase of an acute inflammatory response.")
Declaration(Class(goldbook:13442))
AnnotationAssertion(rdfs:label goldbook:13442 "mast cell")
AnnotationAssertion(dcterms:description goldbook:13442 "Large connective tissue cell that contains inflammatory substances such as histamine, proteases (including tryptases, chymases, and carboxypeptidase A), heparin and chondroitin sulfate proteoglycans, and eicosanoid lipid mediators (the precursors of leukotrienes and prostaglandins). These substances are released in allergic reactions or in response to injury or inflammation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13442 "mastocyte")
Declaration(Class(goldbook:13443))
AnnotationAssertion(rdfs:label goldbook:13443 "mast cell activation disorder")
AnnotationAssertion(dcterms:description goldbook:13443 "Disorder or syndrome in which there is evidence of systemic, inappropriate release of mast cell mediators.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13443 "mast cell activation syndrome")
Declaration(Class(goldbook:13444))
AnnotationAssertion(rdfs:label goldbook:13444 "mast cell stabilizer")
AnnotationAssertion(dcterms:description goldbook:13444 "Non-steroidal medication that reduces the release of substances from mast cells, e.g., sodium cromoglycate.")
Declaration(Class(goldbook:13445))
AnnotationAssertion(rdfs:label goldbook:13445 "mastocytoma")
AnnotationAssertion(dcterms:description goldbook:13445 "Nodule of mast cells that can involve the skin, subcutaneous tissue, and sometimes muscle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13445 "mast cell tumor")
Declaration(Class(goldbook:13446))
AnnotationAssertion(rdfs:label goldbook:13446 "mastocytosis")
AnnotationAssertion(dcterms:description goldbook:13446 "Rare disease characterized by the presence of too many mast cells in various organs and tissues. The condition can be a chronic, long-term illness or it can develop suddenly.")
Declaration(Class(goldbook:13447))
AnnotationAssertion(rdfs:label goldbook:13447 "maturation")
AnnotationAssertion(dcterms:description goldbook:13447 "Process by which B cells produce antibodies with increased affinity for antigen during the course of an immune response.")
Declaration(Class(goldbook:13448))
AnnotationAssertion(rdfs:label goldbook:13448 "mature B cell")
AnnotationAssertion(dcterms:description goldbook:13448 "B cell with immunoglobulin M (IgM) and immunoglobulin D (IgD) on its surface.")
Declaration(Class(goldbook:13449))
AnnotationAssertion(rdfs:label goldbook:13449 "megakaryocyte")
AnnotationAssertion(dcterms:description goldbook:13449 "Bone marrow precursor of platelets.")
Declaration(Class(goldbook:13450))
AnnotationAssertion(rdfs:label goldbook:13450 "membrane attack complex")
AnnotationAssertion(dcterms:description goldbook:13450 "Complex of complement components C5b–C9 that inserts as a pore into the membrane of target cells leading to cell lysis.")
Declaration(Class(goldbook:13451))
AnnotationAssertion(rdfs:label goldbook:13451 "memory")
AnnotationAssertion(dcterms:description goldbook:13451 "Characteristic of the acquired immune response (see acquired immunity) of lymphocytes whereby a second encounter with a given antigen produces a secondary immune response that is faster, greater, and longer lasting than the primary immune response.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13451 "immunological memory")
Declaration(Class(goldbook:13452))
AnnotationAssertion(rdfs:label goldbook:13452 "memory cell")
AnnotationAssertion(dcterms:description goldbook:13452 "Clonally expanded T cell or B cell produced during a primary immune response and which is primed to mediate a secondary immune response to the original antigen.")
Declaration(Class(goldbook:13453))
AnnotationAssertion(rdfs:label goldbook:13453 "memory lymphocyte immunostimulation assay")
AnnotationAssertion(dcterms:description goldbook:13453 "Patented modification of the lymphocyte transformation test (LTT) based on the enzyme-linked immunosorbent assay (ELISA) principle.")
Declaration(Class(goldbook:13454))
AnnotationAssertion(rdfs:label goldbook:13454 "mesenteric lymph node")
AnnotationAssertion(dcterms:description goldbook:13454 "Lymph node lying between layers of the mesentery.")
Declaration(Class(goldbook:13455))
AnnotationAssertion(rdfs:label goldbook:13455 "metabolic activation")
AnnotationAssertion(dcterms:description goldbook:13455 "Formation of one or more chemically reactive intermediate(s) as a result of modification of a molecule by the xenobiotic-metabolizing enzymes of liver and other organs.")
Declaration(Class(goldbook:13456))
AnnotationAssertion(rdfs:label goldbook:13456 "microautophagy")
AnnotationAssertion(dcterms:description goldbook:13456 "Process in which lysosomes directly engulf cytoplasm by invagination, protrusion, and/or septation of the lysosomal limiting membrane.")
Declaration(Class(goldbook:13457))
AnnotationAssertion(rdfs:label goldbook:13457 "microfold cell")
AnnotationAssertion(dcterms:description goldbook:13457 "Cell found in the follicle-associated epithelium of the Peyer’s patch that has the unique ability to sample antigen from the lumen of the small intestine and deliver it via transcytosis to antigen-presenting cells (APCs) and lymphocytes located in a unique pocket-like structure on their basolateral side.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13457 "M cell")
Declaration(Class(goldbook:13458))
AnnotationAssertion(rdfs:label goldbook:13458 "microglobulin")
AnnotationAssertion(dcterms:description goldbook:13458 "Any small globular protein found on the surface of many cells, including lymphocytes, and in the blood plasma distinct from albumin.")
Declaration(Class(goldbook:13459))
AnnotationAssertion(rdfs:label goldbook:13459 "microscopic polyangiitis")
AnnotationAssertion(dcterms:description goldbook:13459 "ANCA-associated necrotizing, pauci-immune vasculitis of the small vessels (capillaries, venules, arterioles) frequently associated with rapidly progressive glomerulonephritis and/or hemorrhagic alveolitis as well as autoantibodies against myeloperoxidase.")
Declaration(Class(goldbook:13460))
AnnotationAssertion(rdfs:label goldbook:13460 "minor histocompatibility antigen")
AnnotationAssertion(dcterms:description goldbook:13460 "Non-major histocompatibility complex (MHC)-encoded cell surface processed peptide which, in association with MHC-encoded molecules, contributes to graft rejection, albeit not usually as severe as that due to MHC mismatch.")
Declaration(Class(goldbook:13461))
AnnotationAssertion(rdfs:label goldbook:13461 "mitogen")
AnnotationAssertion(dcterms:description goldbook:13461 "Substance that induces lymphocyte transformation or, more generally, mitosis and cell proliferation.")
Declaration(Class(goldbook:13462))
AnnotationAssertion(rdfs:label goldbook:13462 "mitogen-activated protein kinase")
AnnotationAssertion(dcterms:description goldbook:13462 "Member of a kinase network in which 'upstream' kinases activate 'downstream' kinases that, in response to phosphorylation, translocate to the nucleus and activate transcription factors.")
Declaration(Class(goldbook:13463))
AnnotationAssertion(rdfs:label goldbook:13463 "mitophagy")
AnnotationAssertion(dcterms:description goldbook:13463 "Autophagy-related pathway specific for mitochondria; it can be subdivided into macromitophagy and micromitophagy depending upon the degree of mitophagy.")
Declaration(Class(goldbook:13464))
AnnotationAssertion(rdfs:label goldbook:13464 "mixed lymphocyte response")
AnnotationAssertion(dcterms:description goldbook:13464 "T-cell-proliferative response induced by cells expressing allogeneic major histocompatibility complex (MHC) molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13464 "mixed lymphocyte response")
Declaration(Class(goldbook:13465))
AnnotationAssertion(rdfs:label goldbook:13465 "mixed connective tissue disease")
AnnotationAssertion(dcterms:description goldbook:13465 "Human autoimmune disease in which the immune system attacks the body, producing symptoms that combine features of polymyositis, systemic lupus erythematosus (SLE), and systemic scleroderma, and thus being considered as an overlap syndrome.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13465 "Sharp’s syndrome")
Declaration(Class(goldbook:13466))
AnnotationAssertion(rdfs:label goldbook:13466 "molecular mimicry")
AnnotationAssertion(dcterms:description goldbook:13466 "Concept that identity or similarity of epitopes expressed by a pathogen and by a self molecule may lead to production of antibodies reacting to the self-antigen.")
Declaration(Class(goldbook:13467))
AnnotationAssertion(rdfs:label goldbook:13467 "monocyte")
AnnotationAssertion(dcterms:description goldbook:13467 "Mononuclear phagocyte found in blood and which is the precursor of the tissue macrophage.")
Declaration(Class(goldbook:13468))
AnnotationAssertion(rdfs:label goldbook:13468 "monokine")
AnnotationAssertion(dcterms:description goldbook:13468 "Alternative name for a cytokine produced by monocytes.")
Declaration(Class(goldbook:13469))
AnnotationAssertion(rdfs:label goldbook:13469 "mononuclear phagocyte system")
AnnotationAssertion(dcterms:description goldbook:13469 "Network of phagocytic cells throughout the body. System comprising blood monocytes and tissue macrophages.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13469 "reticuloendothelial system (RES)")
Declaration(Class(goldbook:13470))
AnnotationAssertion(rdfs:label goldbook:13470 "mouse IgE test")
AnnotationAssertion(dcterms:description goldbook:13470 "Procedure in which serum immunoglobulin E (IgE) levels are measured in mice following topical exposure to a test substance. Substances that cause a significant increase in IgE are considered to be potential respiratory allergens.")
Declaration(Class(goldbook:13471))
AnnotationAssertion(rdfs:label goldbook:13471 "mouse ear-swelling test")
AnnotationAssertion(dcterms:description goldbook:13471 "Test for sensitization in which the test substance is applied topically to the ear of a mouse for three consecutive days. The change in ear thickness is then measured following challenge on day 8.")
Declaration(Class(goldbook:13472))
AnnotationAssertion(rdfs:label goldbook:13472 "mucocutaneous")
AnnotationAssertion(dcterms:description goldbook:13472 "Pertaining to or affecting the mucous membranes and/or the skin.")
Declaration(Class(goldbook:13473))
AnnotationAssertion(rdfs:label goldbook:13473 "mucosa")
AnnotationAssertion(dcterms:description goldbook:13473 "Moist tissue that lines some organs and body cavities, including the nose, mouth, lungs, and digestive tract.")
Declaration(Class(goldbook:13474))
AnnotationAssertion(rdfs:label goldbook:13474 "mucosa-associated lymphoid tissue")
AnnotationAssertion(dcterms:description goldbook:13474 "Secondary lymphoid tissue present in the surface mucosa of the respiratory tract and bronchus (BALT), gastrointestinal tract (GALT), nasal passages (NALT), larynx (LALT), conjunctiva (CALT), and genitourinary tract, and in the skin sub-epidermis (SALT).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13474 "bronchus-associated lymphoid tissue (BALT)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13474 "nasal-associated lymphoid tissue (NALT)")
Declaration(Class(goldbook:13475))
AnnotationAssertion(rdfs:label goldbook:13475 "mucosal addressin cell adhesion molecule-1")
AnnotationAssertion(dcterms:description goldbook:13475 "Protein involved in trafficking of lymphocytes to mucosal endothelium.")
Declaration(Class(goldbook:13476))
AnnotationAssertion(rdfs:label goldbook:13476 "mucosal tolerance")
AnnotationAssertion(dcterms:description goldbook:13476 "State of lymphocyte hyporesponsiveness to protein antigens applied across mucosal surfaces by oral or nasal instillation.")
Declaration(Class(goldbook:13477))
AnnotationAssertion(rdfs:label goldbook:13477 "multiple myeloma")
AnnotationAssertion(dcterms:description goldbook:13477 "Plasma cell malignancy resulting in high levels of monoclonal immunoglobulin (Ig) in serum and of free light chains (Bence–Jones protein) in urine.")
Declaration(Class(goldbook:13478))
AnnotationAssertion(rdfs:label goldbook:13478 "multiplex immunoassay")
AnnotationAssertion(dcterms:description goldbook:13478 "Type of particle immunoassay employing sets of microspheres with various physicochemical features, each labeled with a different antibody. The method allows detection in a single measurement of an array of 100 or more proteins.")
Declaration(Class(goldbook:13479))
AnnotationAssertion(rdfs:label goldbook:13479 "multipotent progenitor cell")
AnnotationAssertion(dcterms:description goldbook:13479 "Undifferentiated stem cell, obtained from adult bone marrow or other non-embryonic tissue sources, that possesses the ability to differentiate into a variety of cell types, especially into cells of a closely related family of cells that are expanded in vitro and deposited in master cell banks for 'off-the-shelf' use, with potential hematopoiesis-inducing and immunomodulating activities.")
Declaration(Class(goldbook:13480))
AnnotationAssertion(rdfs:label goldbook:13480 "murine local lymph node assay")
AnnotationAssertion(dcterms:description goldbook:13480 "Predictive test of sensitization in which a test substance is applied topically to the skin of mice (usually three times at daily intervals) and the weight of the local draining lymph nodes is measured at six days. Usually lymphoproliferation in the nodes is measured following injection of [\\(\\ce{^{3}H}\\)]thymidine or bromodeoxyuridine.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13480 "local lymph node assay (LLNA)")
Declaration(Class(goldbook:13481))
AnnotationAssertion(rdfs:label goldbook:13481 "acquired myasthenia gravis")
AnnotationAssertion(dcterms:description goldbook:13481 "Autoimmune disease characterized by muscle weakness usually affecting ocular and oropharyngeal muscles due to an autoimmune attack against components of the neuromuscular junction (e.g., the nicotinic acetylcholine receptor).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13481 "acquired myasthenia gravis")
Declaration(Class(goldbook:13482))
AnnotationAssertion(rdfs:label goldbook:13482 "myelodysplastic syndrome")
AnnotationAssertion(dcterms:description goldbook:13482 "Diverse collection of hematological conditions united by ineffective production (or dysplasia) of myeloid blood cells and risk of transformation to acute myelogenous leukemia (AML). Anemia requiring chronic blood transfusion is frequently present.")
Declaration(Class(goldbook:13483))
AnnotationAssertion(rdfs:label goldbook:13483 "myeloma")
AnnotationAssertion(dcterms:description goldbook:13483 "Tumor composed of cells derived from hematopoietic cells (see hematopoiesis) of the bone marrow, or from mast cells.")
Declaration(Class(goldbook:13484))
AnnotationAssertion(rdfs:label goldbook:13484 "myeloid")
AnnotationAssertion(dcterms:description goldbook:13484 "Referring to the nonlymphocytic groups of white blood cells, including granulocytes, monocytes, and platelets.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13484 "myelogenous")
Declaration(Class(goldbook:13485))
AnnotationAssertion(rdfs:label goldbook:13485 "myeloid stem cell")
AnnotationAssertion(dcterms:description goldbook:13485 "One of two groups of stem cells produced in the bone marrow. Myeloid stem cells may mature into several types of blood cells, including acidic basophils, eosinophils, erythrocytes, macrophages, megakaryocytes, and neutrophils.")
Declaration(Class(goldbook:13486))
AnnotationAssertion(rdfs:label goldbook:13486 "myeloid tissue")
AnnotationAssertion(dcterms:description goldbook:13486 "Tissue within red bone marrow that produces the blood cells. It is found around the blood vessels and contains various cell types that are precursors of the blood cells.")
Declaration(Class(goldbook:13487))
AnnotationAssertion(rdfs:label goldbook:13487 "myeloma protein")
AnnotationAssertion(dcterms:description goldbook:13487 "Monoclonal antibody secreted by myeloma cells.")
Declaration(Class(goldbook:13488))
AnnotationAssertion(rdfs:label goldbook:13488 "myeloperoxidase")
AnnotationAssertion(dcterms:description goldbook:13488 "Enzyme found in azurophilic granules of neutrophils, the major target of antineutrophil cytoplasmic autoantibody (ANCA).")
Declaration(Class(goldbook:13489))
AnnotationAssertion(rdfs:label goldbook:13489 "myelopoiesis")
AnnotationAssertion(dcterms:description goldbook:13489 "Process of formation and development of myeloid blood cells in the bone marrow.")
Declaration(Class(goldbook:13490))
AnnotationAssertion(rdfs:label goldbook:13490 "myelosuppression")
AnnotationAssertion(dcterms:description goldbook:13490 "Decrease in myeloid cells, including pancytopenia, anemia, leukopenia, lymphopenia, thrombocytopenia, and other blood dyscrasias.")
Declaration(Class(goldbook:13491))
AnnotationAssertion(rdfs:label goldbook:13491 "autoimmune myositis")
AnnotationAssertion(dcterms:description goldbook:13491 "Rare systemic inflammatory myopathy, including primary polymyositis, primary dermatomyositis, myositis associated with malignancy, childhood dermatomyositis, and myositis with multisystem autoimmune disease [e.g., mixed connective tissue disease (MCTD), systemic sclerosis (SSc)].")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13491 "autoimmune myositis")
Declaration(Class(goldbook:13492))
AnnotationAssertion(rdfs:label goldbook:13492 "NACHT domain-, leucine-rich repeat (LRR)-, and pyrin (N-terminal homology) domain (PYD)-containing protein 3")
AnnotationAssertion(dcterms:description goldbook:13492 "NOD-like receptor (NLR), found in certain inflammasomes, that binds to aggregated proteins and the peptides that compose them. Its activation leads to the generation of inflammatory cytokines, such as interleukin (IL)-1, and neurotoxic factors.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13492 "cryopyrin")
Declaration(Class(goldbook:13493))
AnnotationAssertion(rdfs:label goldbook:13493 "N-nucleotides")
AnnotationAssertion(dcterms:description goldbook:13493 "Non-templated nucleotides added to the junctions between antibody and T-cell receptor (TCR) variable (V) gene, diversity (D) gene, and joining (J) gene segments during gene rearrangement.")
Declaration(Class(goldbook:13494))
AnnotationAssertion(rdfs:label goldbook:13494 "NOD-like receptor")
AnnotationAssertion(dcterms:description goldbook:13494 "Any of a large family of cytoplasmic proteins containing a nucleotide-binding domain and leucine-rich repeats (LRRs), involved in regulation of inflammation and apoptosis; many family members are thought to function as pattern recognition receptors (PRRs).")
Declaration(Class(goldbook:13495))
AnnotationAssertion(rdfs:label goldbook:13495 "N-region")
AnnotationAssertion(dcterms:description goldbook:13495 "Highly variable region on the H-chain of immunoglobulins.")
Declaration(Class(goldbook:13496))
AnnotationAssertion(rdfs:label goldbook:13496 "naïve lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13496 "Mature T cell or B cell that has not yet been activated (see lymphocyte activation) by encounter with antigen.")
Declaration(Class(goldbook:13497))
AnnotationAssertion(rdfs:label goldbook:13497 "natural autoantibodies")
AnnotationAssertion(dcterms:description goldbook:13497 "Part of the naturally occurring repertoire of polyreactive antibodies that bind to autoantigens with low affinity. They are mainly of immunoglobulin M (IgM) isotype and produced by CD5+ B lymphocytes.")
Declaration(Class(goldbook:13498))
AnnotationAssertion(rdfs:label goldbook:13498 "natural immunity")
AnnotationAssertion(dcterms:description goldbook:13498 "Host defense mechanisms that do not require prior exposure to antigen.")
Declaration(Class(goldbook:13499))
AnnotationAssertion(rdfs:label goldbook:13499 "natural killer cell")
AnnotationAssertion(dcterms:description goldbook:13499 "Large granular lymphocyte which does not rearrange nor express either immunoglobulin or T-cell receptor (TCR) genes but is able to recognize and destroy certain tumor and virally infected cells in a major histocompatibility complex (MHC) molecule- and antibody-independent manner.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13499 "NK cell")
Declaration(Class(goldbook:13500))
AnnotationAssertion(rdfs:label goldbook:13500 "natural killer cell activity assay")
AnnotationAssertion(dcterms:description goldbook:13500 "Immunotoxicity test in which lymphoid tissue or blood that has been treated with a test compound is co-incubated with target cells. The cytotoxic effect on target cells is measured, e.g., with the chromium release assay. It is used under circumstances where differences from untreated cells are attributed to natural killer (NK) cell activity.")
Declaration(Class(goldbook:13501))
AnnotationAssertion(rdfs:label goldbook:13501 "natural killer T cell")
AnnotationAssertion(dcterms:description goldbook:13501 "Lymphoid cells with a morphology and granule content intermediate between T cells and natural killer (NK) cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13501 "NKT cell")
Declaration(Class(goldbook:13502))
AnnotationAssertion(rdfs:label goldbook:13502 "natural resistance-associated macrophage protein")
AnnotationAssertion(dcterms:description goldbook:13502 "Iron transporter that plays a critical role in macrophage activation and differentiation.")
Declaration(Class(goldbook:13503))
AnnotationAssertion(rdfs:label goldbook:13503 "negative selection")
AnnotationAssertion(dcterms:description goldbook:13503 "Deletion by apoptosis in the thymus of T cells that recognize self-peptides presented by self-major histocompatibility complex (MHC) molecules, thus preventing the development of autoimmune T cells. Negative selection of developing B cells is also thought to occur if they encounter high levels of self-antigen in the bone marrow.")
Declaration(Class(goldbook:13504))
AnnotationAssertion(rdfs:label goldbook:13504 "neoantigen")
AnnotationAssertion(dcterms:description goldbook:13504 "Antigen newly expressed on a tumor or virally infected cell, or arising after macromolecule-hapten binding.")
Declaration(Class(goldbook:13505))
AnnotationAssertion(rdfs:label goldbook:13505 "neonatal tolerance")
AnnotationAssertion(dcterms:description goldbook:13505 "Tolerance to specific foreign antigens induced by the exposure of a bird or mammal to the foreign antigens during embryonic or neonatal life, depending upon species.")
Declaration(Class(goldbook:13506))
AnnotationAssertion(rdfs:label goldbook:13506 "autoimmune nephritis")
AnnotationAssertion(dcterms:description goldbook:13506 "Inflammation of the kidney due to immunological reaction to renal antigens.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13506 "autoimmune nephritis")
Declaration(Class(goldbook:13507))
AnnotationAssertion(rdfs:label goldbook:13507 "autoimmune neuropathy")
AnnotationAssertion(dcterms:description goldbook:13507 "Autoimmune disease of the nervous system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13507 "autoimmune neuropathy")
Declaration(Class(goldbook:13508))
AnnotationAssertion(rdfs:label goldbook:13508 "neutralization")
AnnotationAssertion(dcterms:description goldbook:13508 "Blocking by an antibody of the effects of a virus.")
Declaration(Class(goldbook:13509))
AnnotationAssertion(rdfs:label goldbook:13509 "neutropenia")
AnnotationAssertion(dcterms:description goldbook:13509 "Abnormally low concentration of neutrophils in the blood.")
Declaration(Class(goldbook:13510))
AnnotationAssertion(rdfs:label goldbook:13510 "neutrophil")
AnnotationAssertion(dcterms:description goldbook:13510 "Granular leukocyte, the major circulating phagocytic polymorphonuclear granulocyte, having a nucleus with three to five lobes and fine cytoplasmic granules stainable by neutral dyes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13510 "polymorphonuclear leucocyte")
Declaration(Class(goldbook:13511))
AnnotationAssertion(rdfs:label goldbook:13511 "neutrophil activation")
AnnotationAssertion(dcterms:description goldbook:13511 "Change in morphology and behavior of a neutrophil resulting from exposure to a cytokine, chemokine, cellular ligand, or soluble factor.")
Declaration(Class(goldbook:13512))
AnnotationAssertion(rdfs:label goldbook:13512 "nitric oxide")
AnnotationAssertion(dcterms:description goldbook:13512 "Generic term for nitrogen monoxide species, including nitrosonium ion, nitric oxide radical, etc., that can function in a cell-signaling capacity.")
Declaration(Class(goldbook:13513))
AnnotationAssertion(rdfs:label goldbook:13513 "nondepleting antibody")
AnnotationAssertion(dcterms:description goldbook:13513 "Cell surface antibody that does not provoke attack by killer cells and thus does not provoke depletion of a group of cells in the body, usually referring to B cells.")
Declaration(Class(goldbook:13514))
AnnotationAssertion(rdfs:label goldbook:13514 "non-Hodgkin lymphoma")
AnnotationAssertion(dcterms:description goldbook:13514 "Any of various malignant lymphomas characterized by the absence of Reed–Sternberg cells and producing symptoms similar to those of Hodgkin disease.")
Declaration(Class(goldbook:13515))
AnnotationAssertion(rdfs:label goldbook:13515 "non-obese diabetic mouse")
AnnotationAssertion(dcterms:description goldbook:13515 "Genetically modified mouse with a susceptibility to spontaneous development of automimmune diabetes mellitus type I.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13515 "NOD mouse")
Declaration(Class(goldbook:13516))
AnnotationAssertion(rdfs:label goldbook:13516 "non-self")
AnnotationAssertion(dcterms:description goldbook:13516 "Of, relating to, or designating a cell or tissue that has not been produced by the individual organism.")
Declaration(Class(goldbook:13517))
AnnotationAssertion(rdfs:label goldbook:13517 "nuclear factor of activated T cells")
AnnotationAssertion(dcterms:description goldbook:13517 "Transcription factor involved in rapid cell response to stress, such as injury or invading pathogens, and in cell proliferation and survival.")
Declaration(Class(goldbook:13518))
AnnotationAssertion(rdfs:label goldbook:13518 "nuclear factor kappa-light-chain-enhancer of activated B cells")
AnnotationAssertion(dcterms:description goldbook:13518 "Protein complex that controls the transcription of genes involved in cytokine production, cellular adhesion, inflammation, and apoptosis.")
Declaration(Class(goldbook:13519))
AnnotationAssertion(rdfs:label goldbook:13519 "nucleotide-binding oligomerization domain-containing protein 1, 2")
AnnotationAssertion(dcterms:description goldbook:13519 "Members of a family of human intracellular proteins involved in the detection of invasive bacteria and activation of the $\\ce{NF\\kappa B}$ transcription factor pathway.")
Declaration(Class(goldbook:13520))
AnnotationAssertion(rdfs:label goldbook:13520 "nucleotide-binding oligomerization domain-containing protein-like receptor")
AnnotationAssertion(dcterms:description goldbook:13520 "Cytosolic protein that contains a central nucleotide-binding oligomerization domain, an N-terminal effector-binding domain and C-terminal leucine-rich repeats (LRRs).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13520 "NOD-like receptor protein (NLRP)")
Declaration(Class(goldbook:13521))
AnnotationAssertion(rdfs:label goldbook:13521 "nude mouse")
AnnotationAssertion(dcterms:description goldbook:13521 "Mouse that is T-cell-deficient due to a homozygous gene defect (\\(nu/nu\\)) resulting in the absence of a thymus (and also lack of body hair).")
Declaration(Class(goldbook:13522))
AnnotationAssertion(rdfs:label goldbook:13522 "null cell")
AnnotationAssertion(dcterms:description goldbook:13522 "Lymphocyte with neither T- nor B-cell differentiation antigens on its surface.")
Declaration(Class(goldbook:13523))
AnnotationAssertion(rdfs:label goldbook:13523 "OKT3")
AnnotationAssertion(dcterms:description goldbook:13523 "Brand name for muromonab-CD3, an immunosuppressant drug given intravenously to reverse acute rejection of transplanted organs, including the heart, kidneys, and liver.")
Declaration(Class(goldbook:13524))
AnnotationAssertion(rdfs:label goldbook:13524 "oligoclonal")
AnnotationAssertion(dcterms:description goldbook:13524 "Having a few different clones, or the product of a few different clones.")
Declaration(Class(goldbook:13525))
AnnotationAssertion(rdfs:label goldbook:13525 "oncofetal antigen")
AnnotationAssertion(dcterms:description goldbook:13525 "Antigen whose expression is normally restricted to the fetus but which may be expressed during malignancy in adults.")
Declaration(Class(goldbook:13526))
AnnotationAssertion(rdfs:label goldbook:13526 "opsonization")
AnnotationAssertion(dcterms:description goldbook:13526 "Coating of antigen with an opsonin to enhance phagocytosis.")
Declaration(Class(goldbook:13527))
AnnotationAssertion(rdfs:label goldbook:13527 "oral tolerance")
AnnotationAssertion(dcterms:description goldbook:13527 "Orally induced and immune-mediated non-responsiveness.")
Declaration(Class(goldbook:13528))
AnnotationAssertion(rdfs:label goldbook:13528 "oral vaccination")
AnnotationAssertion(dcterms:description goldbook:13528 "Immunization against a pathogen with a vaccine administered by mouth.")
Declaration(Class(goldbook:13529))
AnnotationAssertion(rdfs:label goldbook:13529 "Ouchterlony technique")
AnnotationAssertion(dcterms:description goldbook:13529 "Double-radial immunodiffusion procedure for the detection of precipitating antibodies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13529 "double diffusion")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13529 "Ouchterlony double diffusion assay")
Declaration(Class(goldbook:13530))
AnnotationAssertion(rdfs:label goldbook:13530 "P-nucleotides")
AnnotationAssertion(dcterms:description goldbook:13530 "Palindromic nucleotide sequences generated at the junctions between antibody and T-cell receptor (TCR) variable (V), diversity (D), and joining (J) gene segments during gene rearrangement.")
Declaration(Class(goldbook:13531))
AnnotationAssertion(rdfs:label goldbook:13531 "P-selectin")
AnnotationAssertion(dcterms:description goldbook:13531 "Cell adhesion molecule expressed on the surface of activated endothelial cells and platelets.")
Declaration(Class(goldbook:13532))
AnnotationAssertion(rdfs:label goldbook:13532 "pancytopenia")
AnnotationAssertion(dcterms:description goldbook:13532 "Decrease in the number of red blood cells, white blood cells, and platelets.")
Declaration(Class(goldbook:13533))
AnnotationAssertion(rdfs:label goldbook:13533 "paracortical area")
AnnotationAssertion(dcterms:description goldbook:13533 "Region of a lymph node enriched in T lymphocytes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13533 "paracortex")
Declaration(Class(goldbook:13534))
AnnotationAssertion(rdfs:label goldbook:13534 "paramone")
AnnotationAssertion(dcterms:description goldbook:13534 "Paracrine agonist.")
Declaration(Class(goldbook:13535))
AnnotationAssertion(rdfs:label goldbook:13535 "paraneoplastic autoimmune syndrome")
AnnotationAssertion(dcterms:description goldbook:13535 "Any of several autoimmune diseases that are caused by tumor-induced perturbations of the immune system with damaging effects on various organ systems (e.g. cancer-associated retinopathy, paraneoplastic neurological syndromes, paraneoplastic cutaneous syndromes). In most cases, autoantibodies generated by antitumor immunity are responsible for the tissue injury.")
Declaration(Class(goldbook:13536))
AnnotationAssertion(rdfs:label goldbook:13536 "paratope")
AnnotationAssertion(dcterms:description goldbook:13536 "Site in the variable region of an antibody or T-cell receptor (TCR) that binds to an epitope of an antigen.")
Declaration(Class(goldbook:13537))
AnnotationAssertion(rdfs:label goldbook:13537 "particle immunoassay")
AnnotationAssertion(dcterms:description goldbook:13537 "Immunoassay in which antibody is bound to the surface of microspheres. After incubation with the antigen-containing biological fluid, and subsequent manipulation, detection is usually performed by flow cytometry.")
Declaration(Class(goldbook:13538))
AnnotationAssertion(rdfs:label goldbook:13538 "passive cutaneous anaphylaxis test")
AnnotationAssertion(dcterms:description goldbook:13538 "Assay for allergenicity in which an antibody is injected intradermally into a test animal followed at a later time (anywhere from \\(\\pu{3}\\) to \\(\\pu{48 h}\\)) with an intravenous injection of a mixture of a test antigen and a dye (typically Evans blue). Increased vascular permeability at the site of antigen-antibody reaction is visualized by extravasation of the dye.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13538 "PCA test")
Declaration(Class(goldbook:13539))
AnnotationAssertion(rdfs:label goldbook:13539 "passive hemagglutination")
AnnotationAssertion(dcterms:description goldbook:13539 "Method of measuring antibody titer, in which antigen-coated erythrocytes are agglutinated by adding antibody specific for the antigen.")
Declaration(Class(goldbook:13540))
AnnotationAssertion(rdfs:label goldbook:13540 "passive immunization")
AnnotationAssertion(dcterms:description goldbook:13540 "Immunization of an individual by the transfer of antibody synthesized in another individual.")
Declaration(Class(goldbook:13541))
AnnotationAssertion(rdfs:label goldbook:13541 "patch test")
AnnotationAssertion(dcterms:description goldbook:13541 "Test for allergy that is performed by placing the suspected allergen in direct contact with the skin or mucosa.")
Declaration(Class(goldbook:13542))
AnnotationAssertion(rdfs:label goldbook:13542 "pathogen-associated molecular pattern")
AnnotationAssertion(dcterms:description goldbook:13542 "Describing repetitive motifs of molecules such as lipopolysaccharide (LPS), peptidoglycan, lipoteichoic acids, and mannans, which are widely expressed by microbial pathogens but are not present on host tissues. They are therefore utilized by the pattern recognition receptors (PRRs) of the immune system to distinguish pathogens from self-antigens.")
Declaration(Class(goldbook:13543))
AnnotationAssertion(rdfs:label goldbook:13543 "pattern recognition receptor")
AnnotationAssertion(dcterms:description goldbook:13543 "Receptor found on many different cell types in the immune system that enables them to recognize pathogen-associated molecular patterns (PAMPs). Amongst the large number of different PRRs are the mannose receptor (CD206), macrophage scavenger receptor (CD204), and the toll-like receptors (TLRs).")
Declaration(Class(goldbook:13544))
AnnotationAssertion(rdfs:label goldbook:13544 "pauci-immune")
AnnotationAssertion(dcterms:description goldbook:13544 "Referring to vasculitis characterized by relatively little deposition of immunoglobulin (Ig) and complement factors, usually describing a form of glomerulonephritis.")
Declaration(Class(goldbook:13545))
AnnotationAssertion(rdfs:label goldbook:13545 "pemphigus")
AnnotationAssertion(dcterms:description goldbook:13545 "Rare, serious autoimmune disease marked by successive outbreaks of blisters, which appear suddenly and disappear, leaving pigmented spots.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13545 "pemphigus vulgaris")
Declaration(Class(goldbook:13546))
AnnotationAssertion(rdfs:label goldbook:13546 "peptide tetramer")
AnnotationAssertion(dcterms:description goldbook:13546 "Structure consisting of four identical major histocompatibility complex (MHC)-encoded peptides, presenting four binding sites for biotin attached to the tail of the MHC molecule, and held together by fluorescent streptavidin.")
Declaration(Class(goldbook:13547))
AnnotationAssertion(rdfs:label goldbook:13547 "peptide vaccine")
AnnotationAssertion(dcterms:description goldbook:13547 "Preparation of an immunologically active peptide found in a disease-causing organism or substance, or any of their products, which is specially treated for use in vaccination.")
Declaration(Class(goldbook:13548))
AnnotationAssertion(rdfs:label goldbook:13548 "peptide-binding groove")
AnnotationAssertion(dcterms:description goldbook:13548 "Structural feature found in major histocompatibility complex (MHC) class I and class II heterodimeric proteins that can bind endogenous peptides.")
Declaration(Class(goldbook:13549))
AnnotationAssertion(rdfs:label goldbook:13549 "perforin")
AnnotationAssertion(dcterms:description goldbook:13549 "Molecule produced by cytotoxic T cells and natural killer (NK) cells that, like complement component C9, polymerizes to form a pore in the membrane of the target cell leading to cell death.")
Declaration(Class(goldbook:13550))
AnnotationAssertion(rdfs:label goldbook:13550 "periarteriolar lymphoid sheath")
AnnotationAssertion(dcterms:description goldbook:13550 "Lymphoid tissue that forms the white pulp of the spleen.")
Declaration(Class(goldbook:13551))
AnnotationAssertion(rdfs:label goldbook:13551 "periodontitis")
AnnotationAssertion(dcterms:description goldbook:13551 "Inflammatory reaction of the tissues surrounding a tooth (periodontium), usually resulting from the extension of gingival inflammation (gingivitis) into the periodontium, and involving inflammation and infection of the ligaments and bones that support the teeth.")
Declaration(Class(goldbook:13552))
AnnotationAssertion(rdfs:label goldbook:13552 "peripheral blood leukocyte")
AnnotationAssertion(dcterms:description goldbook:13552 "Leukocyte derived from the peripheral circulatory system.")
Declaration(Class(goldbook:13553))
AnnotationAssertion(rdfs:label goldbook:13553 "peripheral blood mononuclear cell")
AnnotationAssertion(dcterms:description goldbook:13553 "Monocyte produced by the bone marrow from hematopoietic stem cell precursors, circulating in the bloodstream for about one to three days before moving into tissues throughout the body.")
Declaration(Class(goldbook:13554))
AnnotationAssertion(rdfs:label goldbook:13554 "peripheral lymphoid organ")
AnnotationAssertion(dcterms:description goldbook:13554 "Any of the lymphoid organs (see lymphoid tissue) other than the thymus.")
Declaration(Class(goldbook:13555))
AnnotationAssertion(rdfs:label goldbook:13555 "autoimmune peripheral neuropathy")
AnnotationAssertion(dcterms:description goldbook:13555 "Acute or chronic inflammatory neuropathy leading to demyelination and axonal damage of nerves and nerve roots associated with high-titeredautoantibodies against gangliosides [e.g., Guillain–Barré syndrome (GBS), Miller–Fisher syndrome, acute sensory ataxic neuropathy].")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13555 "autoimmune peripheral neuropathy")
Declaration(Class(goldbook:13556))
AnnotationAssertion(rdfs:label goldbook:13556 "peripheral tolerance")
AnnotationAssertion(dcterms:description goldbook:13556 "Specific immunological tolerance occurring outside of the primary lymphoid organs (see lymphoid tissue).")
Declaration(Class(goldbook:13557))
AnnotationAssertion(rdfs:label goldbook:13557 "pernicious anemia")
AnnotationAssertion(dcterms:description goldbook:13557 "Disease in which the erythrocytes are abnormally formed, due to an inability to absorb vitamin \\({\\rm{B}}_{12}\\). True pernicious anemia refers specifically to a disorder of atrophied parietal cells leading to absent intrinsic factor, resulting in an inability to absorb \\({\\rm{B}}_{12}\\).")
Declaration(Class(goldbook:13558))
AnnotationAssertion(rdfs:label goldbook:13558 "pexophagy")
AnnotationAssertion(dcterms:description goldbook:13558 "Autophagy selective for degradation of peroxisomes, which can be separated into macropexophagy and micropexophagy.")
Declaration(Class(goldbook:13559))
AnnotationAssertion(rdfs:label goldbook:13559 "Peyer’s patch")
AnnotationAssertion(dcterms:description goldbook:13559 "Part of the gut-associated lymphoid tissue (GALT) and found as a distinct lymphoid nodule, mainly in the small intestine.")
Declaration(Class(goldbook:13560))
AnnotationAssertion(rdfs:label goldbook:13560 "phagocyte")
AnnotationAssertion(dcterms:description goldbook:13560 "Cell, especially of monocyte/macrophage or neutrophil lineage, that is specialized for the engulfment of cellular and particulate matter.")
Declaration(Class(goldbook:13561))
AnnotationAssertion(rdfs:label goldbook:13561 "phagocytic activity assay")
AnnotationAssertion(dcterms:description goldbook:13561 "Method of quantifying phagocytosis in which yeast cells, stained with May–Grünwald stain, are incubated with macrophages, and subsequently, after a fixed time, yeast cells engulfed in the macrophages are counted.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13561 "phagocytosis assay")
Declaration(Class(goldbook:13562))
AnnotationAssertion(rdfs:label goldbook:13562 "phagocytosis")
AnnotationAssertion(dcterms:description goldbook:13562 "Process by which particulate material is endocytosed by a cell.")
Declaration(Class(goldbook:13563))
AnnotationAssertion(rdfs:label goldbook:13563 "phagolysosome")
AnnotationAssertion(dcterms:description goldbook:13563 "Intracellular vacuole where killing and digestion of phagocytosed material occurs following the fusion of a phagosome with a lysosome.")
Declaration(Class(goldbook:13564))
AnnotationAssertion(rdfs:label goldbook:13564 "phagosome")
AnnotationAssertion(dcterms:description goldbook:13564 "Intracellular vacuole produced following invagination of the cell membrane around phagocytosed material.")
Declaration(Class(goldbook:13565))
AnnotationAssertion(rdfs:label goldbook:13565 "Philadelphia chromosome")
AnnotationAssertion(dcterms:description goldbook:13565 "Chromosome resulting from a reciprocal translocation between human chromosomes 9 and 22, most commonly associated with chronic myelogenous leukemia (CML).")
Declaration(Class(goldbook:13566))
AnnotationAssertion(rdfs:label goldbook:13566 "phorbol 12-myristate 13-acetate")
AnnotationAssertion(dcterms:description goldbook:13566 "Mitogenic phorbol ester that directly stimulates protein kinase C (PKC) and acts as a tumor promoter.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13566 "tetradecanoyl phorbol acetate (TPA)")
Declaration(Class(goldbook:13567))
AnnotationAssertion(rdfs:label goldbook:13567 "phospholipase Cγ")
AnnotationAssertion(dcterms:description goldbook:13567 "Enzyme that cleaves phosphatidylinositol bisphosphate into diacylglycerol and inositol trisphosphate, leading to the activation of two major cell signaling pathways.")
Declaration(Class(goldbook:13568))
AnnotationAssertion(rdfs:label goldbook:13568 "photoallergy")
AnnotationAssertion(dcterms:description goldbook:13568 "Type IV hypersensitivity reaction in which photoactivation of a substance produces a hapten that then acts as a sensitizer.")
Declaration(Class(goldbook:13569))
AnnotationAssertion(rdfs:label goldbook:13569 "photocontact dermatitis")
AnnotationAssertion(dcterms:description goldbook:13569 "Type of contact dermatitis arising when substances are transformed into either irritants or allergens upon exposure to light.")
Declaration(Class(goldbook:13570))
AnnotationAssertion(rdfs:label goldbook:13570 "photosensitivity")
AnnotationAssertion(dcterms:description goldbook:13570 "Skin reddening due to an abnormal reaction to sunlight, characteristic of systemic autoimmune diseases [e.g., systemic lupus erythematosus (SLE), mixed connective tissue disease (MCTD)], and cutaneous and subacute cutaneous lupus erythematosus.")
Declaration(Class(goldbook:13571))
AnnotationAssertion(rdfs:label goldbook:13571 "phototoxicity test")
AnnotationAssertion(dcterms:description goldbook:13571 "Procedure used to identify the phototoxic potential of a test substance. The substance is administered either systemically or topically on the skin, and light is subsequently shone on the skin to photoexcite the substance.")
Declaration(Class(goldbook:13572))
AnnotationAssertion(rdfs:label goldbook:13572 "phytohemagglutinin")
AnnotationAssertion(dcterms:description goldbook:13572 "Plant lectin that acts as a T-cell mitogen.")
Declaration(Class(goldbook:13573))
AnnotationAssertion(rdfs:label goldbook:13573 "plantibody")
AnnotationAssertion(dcterms:description goldbook:13573 "Animal antibody (or fragment thereof), expressed in a genetically modified plant.")
Declaration(Class(goldbook:13574))
AnnotationAssertion(rdfs:label goldbook:13574 "plaque-forming cell")
AnnotationAssertion(dcterms:description goldbook:13574 "Antibody-secreting plasma cell detected in vitro by its ability to produce a 'plaque' of lysed antigen-sensitized erythrocytes in the presence of complement.")
Declaration(Class(goldbook:13575))
AnnotationAssertion(rdfs:label goldbook:13575 "plasmablast")
AnnotationAssertion(dcterms:description goldbook:13575 "Highly proliferative cell that is a developmental intermediate between small B lymphocytes and immunoglobulin (Ig)-secreting mature plasma cells.")
Declaration(Class(goldbook:13576))
AnnotationAssertion(rdfs:label goldbook:13576 "plasma cell")
AnnotationAssertion(dcterms:description goldbook:13576 "Terminally differentiated B lymphocyte, with little or no capacity for mitotic division, that actively secretes large amounts of antibody.")
Declaration(Class(goldbook:13577))
AnnotationAssertion(rdfs:label goldbook:13577 "plasmacytoid dendritic cell")
AnnotationAssertion(dcterms:description goldbook:13577 "Dendritic cell of distinct lineage, found in blood and peripheral lymphoid tissue, which secretes large amounts of interferon (IFN) upon activation.")
Declaration(Class(goldbook:13578))
AnnotationAssertion(rdfs:label goldbook:13578 "plasmacytoma")
AnnotationAssertion(dcterms:description goldbook:13578 "Mass of neoplastic monoclonal plasma cells growing in bone or soft tissue.")
Declaration(Class(goldbook:13579))
AnnotationAssertion(rdfs:label goldbook:13579 "plasmapheresis")
AnnotationAssertion(dcterms:description goldbook:13579 "Technique of extracorporeal separation of blood cells from plasma, with return of the cells to the patient.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13579 "plasma exchange")
Declaration(Class(goldbook:13580))
AnnotationAssertion(rdfs:label goldbook:13580 "platelet")
AnnotationAssertion(dcterms:description goldbook:13580 "Small irregular or disc-shaped cell found in large numbers in mammalian blood, essential for blood clotting.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13580 "thrombocyte")
Declaration(Class(goldbook:13581))
AnnotationAssertion(rdfs:label goldbook:13581 "platelet-activating factor")
AnnotationAssertion(dcterms:description goldbook:13581 "Alkyl phospholipid released by a variety of cell types including mast cells and basophils, which has immunoregulatory effects on lymphocytes and monocytes/macrophages, as well as causing platelet aggregation and degranulation.")
Declaration(Class(goldbook:13582))
AnnotationAssertion(rdfs:label goldbook:13582 "platelet-derived growth factor")
AnnotationAssertion(dcterms:description goldbook:13582 "Protein synthesized by platelets that is released into the serum during blood clotting.")
Declaration(Class(goldbook:13583))
AnnotationAssertion(rdfs:label goldbook:13583 "pluripotent stem cell")
AnnotationAssertion(dcterms:description goldbook:13583 "Self-replicating cell capable of developing into cells and tissues of the three primary embryonic germ layers.")
Declaration(Class(goldbook:13584))
AnnotationAssertion(rdfs:label goldbook:13584 "pokeweed mitogen")
AnnotationAssertion(dcterms:description goldbook:13584 "Plant lectin which is a T-cell-dependent B-cell mitogen.")
Declaration(Class(goldbook:13585))
AnnotationAssertion(rdfs:label goldbook:13585 "polyarteritis nodosa")
AnnotationAssertion(dcterms:description goldbook:13585 "Systemic disease characterized by widespread inflammation of small and medium-sized arteries in which many of the foci are nodular.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13585 "disseminated necrotizing periarteritis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13585 "panarteritis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13585 "periarteritis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13585 "periarteritis nodosa")
Declaration(Class(goldbook:13586))
AnnotationAssertion(rdfs:label goldbook:13586 "polyclonal activator")
AnnotationAssertion(dcterms:description goldbook:13586 "Substance that induces activation of multiple clones of B lymphocytes or T lymphocytes.")
Declaration(Class(goldbook:13587))
AnnotationAssertion(rdfs:label goldbook:13587 "autoimmune polyendocrinopathy")
AnnotationAssertion(dcterms:description goldbook:13587 "Autoimmune disease affecting multiple endocrine organs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13587 "APECED syndrome")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13587 "autoimmune polyendocrinopathy")
Declaration(Class(goldbook:13588))
AnnotationAssertion(rdfs:label goldbook:13588 "poly I:C")
AnnotationAssertion(dcterms:description goldbook:13588 "Polyinosinic:polycytidylic acid, a synthetic immunostimulant mimicking viral double-stranded RNA.")
Declaration(Class(goldbook:13589))
AnnotationAssertion(rdfs:label goldbook:13589 "poly ICLC")
AnnotationAssertion(dcterms:description goldbook:13589 "Polyinosinic:polycytidylic acid, poly-ʟ-lysine, and carboxymethylcellulose (letter roots of the acronym underlined), a synthetic immunostimulant mimicking viral double-stranded RNA.")
Declaration(Class(goldbook:13590))
AnnotationAssertion(rdfs:label goldbook:13590 "poly-Ig receptor")
AnnotationAssertion(dcterms:description goldbook:13590 "Receptor molecule that specifically binds J chain-containing polymeric immunoglobulin (Ig), i.e., dimeric secretory immunoglobulin A (IgA) and pentameric immunoglobulin M (IgM), and transports it across mucosal epithelium.")
Declaration(Class(goldbook:13591))
AnnotationAssertion(rdfs:label goldbook:13591 "polymorphonuclear leukocyte")
AnnotationAssertion(dcterms:description goldbook:13591 "Mature leukocyte with granular cytoplasm and a segmented and irregularly shaped nucleus.")
Declaration(Class(goldbook:13592))
AnnotationAssertion(rdfs:label goldbook:13592 "polymyositis")
AnnotationAssertion(dcterms:description goldbook:13592 "Disorder characterized by inflammation and degeneration of skeletal muscle, causing pain, weakness, and wasting in affected (usually proximal) muscles.")
Declaration(Class(goldbook:13593))
AnnotationAssertion(rdfs:label goldbook:13593 "popliteal lymph node assay")
AnnotationAssertion(dcterms:description goldbook:13593 "Test for immunosensitization measuring popliteal lymph node hyperplasia after subcutaneous injection of a test substance into the footpad of the hindpaw of a rodent.")
Declaration(Class(goldbook:13594))
AnnotationAssertion(rdfs:label goldbook:13594 "positive selection")
AnnotationAssertion(dcterms:description goldbook:13594 "Selection of those developing T cells in the thymus that are able to recognize self-major histocompatibility complex (MHC) molecules. This occurs by preventing apoptosis in these cells.")
Declaration(Class(goldbook:13595))
AnnotationAssertion(rdfs:label goldbook:13595 "pre-B cell")
AnnotationAssertion(dcterms:description goldbook:13595 "Cell in the B-lymphocyte lineage that has rearranged heavy chain but not light chain genes; it expresses surrogate light chains and \\(\\upmu\\) heavy chain at its surface in conjunction with immunoglobulins Ig _012643_ and Ig _012644_. All these molecules comprise the pre-B-cell receptor (pre-BCR).")
Declaration(Class(goldbook:13596))
AnnotationAssertion(rdfs:label goldbook:13596 "precipitating antibody")
AnnotationAssertion(dcterms:description goldbook:13596 "Antibody that is capable of reacting with a soluble antigen with the formation of an insoluble antigenantibody complex.")
Declaration(Class(goldbook:13597))
AnnotationAssertion(rdfs:label goldbook:13597 "precipitin")
AnnotationAssertion(dcterms:description goldbook:13597 "Precipitate of antibody and multivalent antigen due to the formation of high-molecular-weight complexes.")
Declaration(Class(goldbook:13598))
AnnotationAssertion(rdfs:label goldbook:13598 "pre-T cell")
AnnotationAssertion(dcterms:description goldbook:13598 "Cell differentiating into a T lymphocyte in the thymus gland.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13598 "single-positive cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13598 "thymocyte")
Declaration(Class(goldbook:13599))
AnnotationAssertion(rdfs:label goldbook:13599 "prick test")
AnnotationAssertion(dcterms:description goldbook:13599 "Test carried out by placing a drop of a suspected allergenic extract on the skin of the forearm and gently pricking it into the upper layer of skin. Sensitivity to a substance is indicated if the spot swells slightly and becomes red within about \\(\\pu{15 min}\\).")
Declaration(Class(goldbook:13600))
AnnotationAssertion(rdfs:label goldbook:13600 "primary biliary cirrhosis")
AnnotationAssertion(dcterms:description goldbook:13600 "Autoimmune liver disease that results in the destruction of bile ducts, leading to fibrosis and cirrhosis.")
Declaration(Class(goldbook:13601))
AnnotationAssertion(rdfs:label goldbook:13601 "primary immune response")
AnnotationAssertion(dcterms:description goldbook:13601 "Immune response to the first encounter with an antigen, characterized by slow production of antibody molecules and the priming of lymphoid tissue in readiness for the production of a secondary immune response on subsequent challenge with the same antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13601 "primary response")
Declaration(Class(goldbook:13602))
AnnotationAssertion(rdfs:label goldbook:13602 "primary immunization")
AnnotationAssertion(dcterms:description goldbook:13602 "First introduction of a vaccine into the body for the purposes of inducing immunity.")
Declaration(Class(goldbook:13603))
AnnotationAssertion(rdfs:label goldbook:13603 "primary lymphoid follicle")
AnnotationAssertion(dcterms:description goldbook:13603 "Region of a secondary lymphoid organ containing predominantly unstimulated B lymphocytes that develops into a germinal center following antigen stimulation.")
Declaration(Class(goldbook:13604))
AnnotationAssertion(rdfs:label goldbook:13604 "primary lymphoid organ")
AnnotationAssertion(dcterms:description goldbook:13604 "Site at which immunocompetent lymphocytes develop, i.e., bone marrow and thymus in mammals.")
Declaration(Class(goldbook:13605))
AnnotationAssertion(rdfs:label goldbook:13605 "primary myxedema")
AnnotationAssertion(dcterms:description goldbook:13605 "Atrophic form of diffuse autoimmune thyroiditis.")
Declaration(Class(goldbook:13606))
AnnotationAssertion(rdfs:label goldbook:13606 "primary sclerosing cholangitis")
AnnotationAssertion(dcterms:description goldbook:13606 "Chronic, non-bacterial, inflammatory narrowing of the bile ducts.")
Declaration(Class(goldbook:13607))
AnnotationAssertion(rdfs:label goldbook:13607 "prime")
AnnotationAssertion(dcterms:description goldbook:13607 "Process of giving an initial sensitization to antigen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13607 "priming")
Declaration(Class(goldbook:13608))
AnnotationAssertion(rdfs:label goldbook:13608 "professional antigen-presenting cell")
AnnotationAssertion(dcterms:description goldbook:13608 "Highly efficient antigen-presenting cell (APC), generally referring to dendritic cells, B cells, or macrophages.")
Declaration(Class(goldbook:13609))
AnnotationAssertion(rdfs:label goldbook:13609 "progressive systemic sclerosis")
AnnotationAssertion(dcterms:description goldbook:13609 "Systemic autoimmune disease marked by formation of hyalinized and thickened collagenous fibrous tissue, with thickening and adhesion of skin to underlying tissues, especially of the hands and face and vascular alterations.")
Declaration(Class(goldbook:13610))
AnnotationAssertion(rdfs:label goldbook:13610 "proinflammatory cytokine")
AnnotationAssertion(dcterms:description goldbook:13610 "Cytokine that initiates or enhances inflammation.")
Declaration(Class(goldbook:13611))
AnnotationAssertion(rdfs:label goldbook:13611 "proliferation assay")
AnnotationAssertion(dcterms:description goldbook:13611 "Any test that determines the effect on increase in cell number of a test agent such as a cytokine or mitogen.")
Declaration(Class(goldbook:13612))
AnnotationAssertion(rdfs:label goldbook:13612 "properdin")
AnnotationAssertion(dcterms:description goldbook:13612 "Relatively heat-labile, normal serum protein (a euglobulin) that, in the presence of complement component C3 and magnesium ions, is involved in the alternative pathway of complement activation, and acts nonspecifically against Gram-negative bacteria and viruses and may contribute to the lysis of erythrocytes.")
Declaration(Class(goldbook:13613))
AnnotationAssertion(rdfs:label goldbook:13613 "proteasome")
AnnotationAssertion(dcterms:description goldbook:13613 "Cytoplasmic and nuclear multiprotein proteolytic complex involved in degradation of excess, damaged, or misfolded proteins.")
Declaration(Class(goldbook:13614))
AnnotationAssertion(rdfs:label goldbook:13614 "protectin")
AnnotationAssertion(dcterms:description goldbook:13614 "Member of the Ly-6 family of cell surface molecules that prevents insertion of the membrane attack complex (MAC) into the membrane, thereby protecting cells from complement-induced lysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13614 "CD59")
Declaration(Class(goldbook:13615))
AnnotationAssertion(rdfs:label goldbook:13615 "protective immunity")
AnnotationAssertion(dcterms:description goldbook:13615 "Protection against infectious agents conferred by vaccination.")
Declaration(Class(goldbook:13616))
AnnotationAssertion(rdfs:label goldbook:13616 "protein A")
AnnotationAssertion(dcterms:description goldbook:13616 "Staphylococcus aureus cell wall protein that binds to the Fc region of immunoglobulin G (IgG).")
Declaration(Class(goldbook:13617))
AnnotationAssertion(rdfs:label goldbook:13617 "proteinase 3")
AnnotationAssertion(dcterms:description goldbook:13617 "Multifunctional enzyme of azurophilic granules of neutrophils and monocytes and the major target of antineutrophil cytoplasmic autoantibodies (ANCA).")
Declaration(Class(goldbook:13618))
AnnotationAssertion(rdfs:label goldbook:13618 "protein G")
AnnotationAssertion(dcterms:description goldbook:13618 "Streptococcal cell wall protein that binds to the Fc region of immunoglobulin G (IgG), with a wider species specificity than protein A.")
Declaration(Class(goldbook:13619))
AnnotationAssertion(rdfs:label goldbook:13619 "protein kinase C")
AnnotationAssertion(dcterms:description goldbook:13619 "Member of a kinase family with broad substrate specificity, activated by calcium, diacylglycerol, and (or) phorbol 12-myristate 13-acetate (PMA).")
Declaration(Class(goldbook:13620))
AnnotationAssertion(rdfs:label goldbook:13620 "prozone effect")
AnnotationAssertion(dcterms:description goldbook:13620 "Loss of immunoprecipitation or agglutination that occurs when antibody concentration is increased to an extent that the antibody is in such excess that it is no longer able to effectively cross-link the antigen. A similar phenomenon may occur in antigen excess.")
Declaration(Class(goldbook:13621))
AnnotationAssertion(rdfs:label goldbook:13621 "pseudoallergy")
AnnotationAssertion(dcterms:description goldbook:13621 "Inflammatory or anaphylactic reaction with symptoms similar to an allergy but not involving an antigen-specific immune response, e.g., salicylate intolerance, reaction to contrast reagents.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13621 "pseudoallergic reaction")
Declaration(Class(goldbook:13622))
AnnotationAssertion(rdfs:label goldbook:13622 "psoriasis")
AnnotationAssertion(dcterms:description goldbook:13622 "Skin disorder that has a hereditary component and is characterized by erythematous patches covered with silvery scales, especially on the elbows, knees, and scalp.")
Declaration(Class(goldbook:13623))
AnnotationAssertion(rdfs:label goldbook:13623 "psoriatic")
AnnotationAssertion(dcterms:description goldbook:13623 "Of, relating to, or associated with psoriasis; affected with psoriasis.")
Declaration(Class(goldbook:13624))
AnnotationAssertion(rdfs:label goldbook:13624 "purified protein derivative")
AnnotationAssertion(dcterms:description goldbook:13624 "Partially purified derivative of tuberculin used in the Mantoux test for tuberculosis.")
Declaration(Class(goldbook:13625))
AnnotationAssertion(rdfs:label goldbook:13625 "purpura")
AnnotationAssertion(dcterms:description goldbook:13625 "Purple discoloration occurring in patches on the skin, mucus membranes, or organs.")
Declaration(Class(goldbook:13626))
AnnotationAssertion(rdfs:label goldbook:13626 "pyrogen")
AnnotationAssertion(dcterms:description goldbook:13626 "Any substance that produces fever.")
Declaration(Class(goldbook:13627))
AnnotationAssertion(rdfs:label goldbook:13627 "pyrogen test")
AnnotationAssertion(dcterms:description goldbook:13627 "Any of various tests used to determine whether an agent, usually an infusion or injection fluid, is free of pyrogens.")
Declaration(Class(goldbook:13628))
AnnotationAssertion(rdfs:label goldbook:13628 "Qa antigen")
AnnotationAssertion(dcterms:description goldbook:13628 "'Non-classical' major histocompatibility complex (MHC) class I molecule in mice.")
Declaration(Class(goldbook:13629))
AnnotationAssertion(rdfs:label goldbook:13629 "radial immunodiffusion")
AnnotationAssertion(dcterms:description goldbook:13629 "Method for quantifying an antigen by measuring the diameters of circular precipitates around an antigen-spiked cavity in an antibody-containing agar gel.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13629 "Mancini immunodiffusion")
Declaration(Class(goldbook:13630))
AnnotationAssertion(rdfs:label goldbook:13630 "radioallergosorbent test")
AnnotationAssertion(dcterms:description goldbook:13630 "Solid-phase radioimmunoassay (RIA) for detecting immunoglobulin E (IgE) antibody specific for a particular antigen.")
Declaration(Class(goldbook:13631))
AnnotationAssertion(rdfs:label goldbook:13631 "radioimmunoconjugate")
AnnotationAssertion(dcterms:description goldbook:13631 "Biochemical conjugate consisting of an immune-targeting molecule such as an antibody or antibody fragment together with a cytotoxic radionuclide.")
Declaration(Class(goldbook:13632))
AnnotationAssertion(rdfs:label goldbook:13632 "Raynaud phenomenon")
AnnotationAssertion(dcterms:description goldbook:13632 "Intermittent bilateral attacks of vasospasm and ischemia of the fingers or toes and sometimes of the ears and nose, marked by a severe pallor and often accompanied by paresthesia and pain.")
Declaration(Class(goldbook:13633))
AnnotationAssertion(rdfs:label goldbook:13633 "reactive airways dysfunction syndrome")
AnnotationAssertion(dcterms:description goldbook:13633 "Syndrome characterized by reversible airflow limitation and complicating bronchial hyperresponsiveness induced by acute exposure to high concentrations of non-sensitizer irritant gases.")
Declaration(Class(goldbook:13634))
AnnotationAssertion(rdfs:label goldbook:13634 "reactive oxygen species")
AnnotationAssertion(dcterms:description goldbook:13634 "Intermediates in the reduction of molecular dioxygen, \\(\\ce{O2}\\), to water.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13634 "reactive oxygen intermediate (ROI)")
Declaration(Class(goldbook:13635))
AnnotationAssertion(rdfs:label goldbook:13635 "reagin")
AnnotationAssertion(dcterms:description goldbook:13635 "Historic term for antibodies of the immunoglobulin E (IgE) class.")
Declaration(Class(goldbook:13636))
AnnotationAssertion(rdfs:label goldbook:13636 "recall antigen")
AnnotationAssertion(dcterms:description goldbook:13636 "Substance recognized by memory cells that stimulates rapid (secondary) immune responses, often associated with hypersensitivity.")
Declaration(Class(goldbook:13637))
AnnotationAssertion(rdfs:label goldbook:13637 "recombinant antibody")
AnnotationAssertion(dcterms:description goldbook:13637 "Antibody fragment manufactured by use of genetically modified microorganisms.")
Declaration(Class(goldbook:13638))
AnnotationAssertion(rdfs:label goldbook:13638 "recombination-activating gene")
AnnotationAssertion(dcterms:description goldbook:13638 "Gene whose products are involved in V(D)J recombination in B cells and T cells. Two such genes that have been identified are RAG-1 and RAG-2.")
Declaration(Class(goldbook:13639))
AnnotationAssertion(rdfs:label goldbook:13639 "recombination signal sequence")
AnnotationAssertion(dcterms:description goldbook:13639 "Any conserved heptamer (7-nucleotide)-nonamer (9-nucleotide) sequence, separated by a 12 or 23 base spacer, which occurs 3′ of variable gene segments, 5′ and 3′ of diversity gene segments, and 5′ of joining gene segments, in both immunoglobulin (Ig) and T-cell receptor (TCR) genes. It functions as a recognition sequence for the recombinase enzymes that mediate the gene rearrangement process involved in the generation of lymphocyte antigen receptor diversity.")
Declaration(Class(goldbook:13640))
AnnotationAssertion(rdfs:label goldbook:13640 "red pulp")
AnnotationAssertion(dcterms:description goldbook:13640 "Parenchymal tissue of the spleen consisting of cords of cells and sinuses infiltrated with erythrocytes and responsible for removal of aged or damaged erythrocytes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13640 "splenic pulp")
Declaration(Class(goldbook:13641))
AnnotationAssertion(rdfs:label goldbook:13641 "Reed–Sternberg cell")
AnnotationAssertion(dcterms:description goldbook:13641 "Large transformed lymphocyte, often binucleate, considered pathognomonic of Hodgkin lymphoma.")
Declaration(Class(goldbook:13642))
AnnotationAssertion(rdfs:label goldbook:13642 "regulated upon activation normal T cell expressed and secreted")
AnnotationAssertion(dcterms:description goldbook:13642 "Chemokine secreted by T cells and macrophages upon stimulation by mitogens, which acts as a chemoattractant and stimulates eosinophils and basophils.")
Declaration(Class(goldbook:13643))
AnnotationAssertion(rdfs:label goldbook:13643 "regulatory idiotope")
AnnotationAssertion(dcterms:description goldbook:13643 "Antibody or T-cell receptor (TCR) idiotope capable of regulating immune responses via interaction with lymphocytes bearing complementary idiotopes (anti-idiotopes).")
Declaration(Class(goldbook:13644))
AnnotationAssertion(rdfs:label goldbook:13644 "regulatory T cell")
AnnotationAssertion(dcterms:description goldbook:13644 "T cell that controls the maintenance of normal immune homeostasis. Treg cells are involved in controlling (anergizing or counter-regulating) autoreactive cells that escaped from thymic negative selection.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13644 "natural regulatory T cell")
Declaration(Class(goldbook:13645))
AnnotationAssertion(rdfs:label goldbook:13645 "rejection")
AnnotationAssertion(dcterms:description goldbook:13645 "Immune response leading to destruction of a transplanted organ or tissue.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13645 "transplant rejection")
Declaration(Class(goldbook:13646))
AnnotationAssertion(rdfs:label goldbook:13646 "respiratory burst")
AnnotationAssertion(dcterms:description goldbook:13646 "Generation of cytotoxic superoxide from dioxygen due to increased NADPH oxidase activity, typically occurring in activated neutrophils.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13646 "NADPH oxidase")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13646 "oxidative burst")
Declaration(Class(goldbook:13647))
AnnotationAssertion(rdfs:label goldbook:13647 "respiratory hypersensitivity assay")
AnnotationAssertion(dcterms:description goldbook:13647 "Test of the ability of a substance to induce hyperreactivity in the airways, typically measured as an increase in the rate of respiration of guinea pigs during inhalation of the substance.")
Declaration(Class(goldbook:13648))
AnnotationAssertion(rdfs:label goldbook:13648 "reverse immunology")
AnnotationAssertion(dcterms:description goldbook:13648 "High-throughput procedure where information on potential immunogenic tumor proteins is gained from the amino acid sequences of gene products specifically expressed by the tumor, followed by predicted fitting of putative antigenic peptides to a peptide-binding groove, and finally experimental verification.")
Declaration(Class(goldbook:13650))
AnnotationAssertion(rdfs:label goldbook:13650 "rheumatic fever")
AnnotationAssertion(dcterms:description goldbook:13650 "Inflammatory disease that may develop following a streptococcal infection such as strep throat, and may affect the heart, joints, skin, and brain.")
Declaration(Class(goldbook:13651))
AnnotationAssertion(rdfs:label goldbook:13651 "rheumatoid arthritis")
AnnotationAssertion(dcterms:description goldbook:13651 "Episodic inflammatory systemic disease with autoimmune pathogenetic mechanisms.")
Declaration(Class(goldbook:13652))
AnnotationAssertion(rdfs:label goldbook:13652 "rheumatoid factor")
AnnotationAssertion(dcterms:description goldbook:13652 "Immunoglobulins IgM, IgG, and IgA autoantibodies to the Fc region of IgG.")
Declaration(Class(goldbook:13653))
AnnotationAssertion(rdfs:label goldbook:13653 "rhinitis")
AnnotationAssertion(dcterms:description goldbook:13653 "Inflammation of the mucous membrane of the nose.")
Declaration(Class(goldbook:13654))
AnnotationAssertion(rdfs:label goldbook:13654 "allergic rhinitis")
AnnotationAssertion(dcterms:description goldbook:13654 "Nasal discharge resulting from an allergic response.")
Declaration(Class(goldbook:13655))
AnnotationAssertion(rdfs:label goldbook:13655 "rocket electrophoresis")
AnnotationAssertion(dcterms:description goldbook:13655 "Technique in which a test antigen is electrophoretically driven through an antibody-containing gel. The rocket-shaped tails of precipitation give information on the antigen concentration.")
Declaration(Class(goldbook:13656))
AnnotationAssertion(rdfs:label goldbook:13656 "rosette")
AnnotationAssertion(dcterms:description goldbook:13656 "Particles or cells bound to the surface of a lymphocyte (e.g., sheep erythrocytes around a human T cell).")
Declaration(Class(goldbook:13657))
AnnotationAssertion(rdfs:label goldbook:13657 "scFv")
AnnotationAssertion(dcterms:description goldbook:13657 "Single-chain molecule composed of the variable (V) regions of an antibody heavy and light chain joined together by a flexible linker.")
Declaration(Class(goldbook:13658))
AnnotationAssertion(rdfs:label goldbook:13658 "sarcoidosis")
AnnotationAssertion(dcterms:description goldbook:13658 "Chronic, progressive, generalized granulomatous reticulosis of unknown etiology, involving almost any organ or tissue, including the skin, lungs, lymph nodes, liver, spleen, eyes, and small bones of the hands and feet. It is characterized histologically by the presence in all affected organs or tissues of noncaseating epithelioid cell tubercles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13658 "sarcoid")
Declaration(Class(goldbook:13659))
AnnotationAssertion(rdfs:label goldbook:13659 "scavenger receptor")
AnnotationAssertion(dcterms:description goldbook:13659 "Cell surface receptor, for example on phagocytes, which recognizes cells or molecules that require clearance from the body.")
Declaration(Class(goldbook:13660))
AnnotationAssertion(rdfs:label goldbook:13660 "scleroderma")
AnnotationAssertion(dcterms:description goldbook:13660 "Chronic progressive autoimmune disease characterized by systemic fibrosis and vascular changes.")
Declaration(Class(goldbook:13661))
AnnotationAssertion(rdfs:label goldbook:13661 "secondary challenge")
AnnotationAssertion(dcterms:description goldbook:13661 "Second exposure of primed lymphocytes to a given antigen.")
Declaration(Class(goldbook:13662))
AnnotationAssertion(rdfs:label goldbook:13662 "secondary immune response")
AnnotationAssertion(dcterms:description goldbook:13662 "Qualitatively and quantitatively improved immune response that occurs upon the second encounter of primed lymphocytes with a given antigen.")
Declaration(Class(goldbook:13663))
AnnotationAssertion(rdfs:label goldbook:13663 "secondary lymphoid tissue")
AnnotationAssertion(dcterms:description goldbook:13663 "Tissue (organ) in which antigen-driven proliferation and differentiation of mature B and T lymphocytes take place following antigen recognition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13663 "secondary lymphoid organ")
Declaration(Class(goldbook:13664))
AnnotationAssertion(rdfs:label goldbook:13664 "second set rejection")
AnnotationAssertion(dcterms:description goldbook:13664 "Accelerated rejection of an allograft in a primed recipient.")
Declaration(Class(goldbook:13665))
AnnotationAssertion(rdfs:label goldbook:13665 "secretory component")
AnnotationAssertion(dcterms:description goldbook:13665 "Proteolytic cleavage product of the poly-Ig receptor which remains associated with dimeric immunoglobulin A (IgA) in sero-mucus secretions.")
Declaration(Class(goldbook:13666))
AnnotationAssertion(rdfs:label goldbook:13666 "secretory immunoglobulin A")
AnnotationAssertion(dcterms:description goldbook:13666 "Dimeric immunoglobulin A (IgA) found in sero-mucus secretions.")
Declaration(Class(goldbook:13667))
AnnotationAssertion(rdfs:label goldbook:13667 "selectin")
AnnotationAssertion(dcterms:description goldbook:13667 "Any member of a family of cell-surface adhesion molecules found on leukocytes and endothelial cells and that bind to sugars on glycoproteins.")
Declaration(Class(goldbook:13668))
AnnotationAssertion(rdfs:label goldbook:13668 "selective IgA deficiency")
AnnotationAssertion(dcterms:description goldbook:13668 "Most common form of primary immunodeficiency.")
Declaration(Class(goldbook:13669))
AnnotationAssertion(rdfs:label goldbook:13669 "self-tolerance")
AnnotationAssertion(dcterms:description goldbook:13669 "Specific immunological unresponsiveness to a defined autoantigen.")
Declaration(Class(goldbook:13670))
AnnotationAssertion(rdfs:label goldbook:13670 "sepsis")
AnnotationAssertion(dcterms:description goldbook:13670 "Spread of bacteria or bacterial products throughout the blood, eliciting a life-threatening, systemic inflammatory reaction.")
Declaration(Class(goldbook:13671))
AnnotationAssertion(rdfs:label goldbook:13671 "seroconversion")
AnnotationAssertion(dcterms:description goldbook:13671 "The appearance in the blood serum of detectable antibodies against a specific infectious agent.")
Declaration(Class(goldbook:13672))
AnnotationAssertion(rdfs:label goldbook:13672 "serology")
AnnotationAssertion(dcterms:description goldbook:13672 "Study of serum, especially blood serum, frequently used to detect antibodies to microorganisms.")
Declaration(Class(goldbook:13673))
AnnotationAssertion(rdfs:label goldbook:13673 "serum sickness")
AnnotationAssertion(dcterms:description goldbook:13673 "Hypersensitive reaction to the administration of a foreign serum, characterized by fever, swelling, skin rash, and enlargement of the lymph nodes.")
Declaration(Class(goldbook:13674))
AnnotationAssertion(rdfs:label goldbook:13674 "severe combined immunodeficiency")
AnnotationAssertion(dcterms:description goldbook:13674 "Immunodeficiency affecting both T and B lymphocytes.")
Declaration(Class(goldbook:13675))
AnnotationAssertion(rdfs:label goldbook:13675 "sheep red blood cell antigen")
AnnotationAssertion(dcterms:description goldbook:13675 "T-cell-dependent target antigen often used in hemolytic plaque assays of immune responsiveness.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13675 "SRBC antigen")
Declaration(Class(goldbook:13676))
AnnotationAssertion(rdfs:label goldbook:13676 "signaling lectin")
AnnotationAssertion(dcterms:description goldbook:13676 "Any member of a large family of lectins that bind sialylated glycans.")
Declaration(Class(goldbook:13677))
AnnotationAssertion(rdfs:label goldbook:13677 "signal peptide")
AnnotationAssertion(dcterms:description goldbook:13677 "Any sequence of amino acid residues that, when linked to a newly synthesized protein, identifies it to transport mechanisms that guide the protein to a specific location among the organelles of a eukaryotic cell, or from the cytoplasm to the periplasmic space of prokaryotic cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13677 "signal sequence")
Declaration(Class(goldbook:13678))
AnnotationAssertion(rdfs:label goldbook:13678 "signal transducer and activator of transcription")
AnnotationAssertion(dcterms:description goldbook:13678 "Any member of a family of cytoplasmic proteins that act as second messengers to activate gene transcription in response to cytokines and growth factors.")
Declaration(Class(goldbook:13679))
AnnotationAssertion(rdfs:label goldbook:13679 "single-chain antibody")
AnnotationAssertion(dcterms:description goldbook:13679 "Small antibody construct in which the variable fragment (Fv) [see variable (V) region] of a heavy chain is linked via a synthetic peptide to the variable fragment of a light chain.")
Declaration(Class(goldbook:13680))
AnnotationAssertion(rdfs:label goldbook:13680 "Sjögren syndrome")
AnnotationAssertion(dcterms:description goldbook:13680 "Chronic inflammation of the lachrymal and salivary glands, often accompanied by rheumatoid arthritis (RA) and the presence of autoantibodies in the blood, occurring chiefly among women.")
Declaration(Class(goldbook:13681))
AnnotationAssertion(rdfs:label goldbook:13681 "skin immune system")
AnnotationAssertion(dcterms:description goldbook:13681 "Skin-associated cells that participate in an immune response, including Langerhans cells, dendritic cells, and keratinocytes (mainly responsible for production of cytokines).")
Declaration(Class(goldbook:13682))
AnnotationAssertion(rdfs:label goldbook:13682 "skin sensitization test")
AnnotationAssertion(dcterms:description goldbook:13682 "Any test used to study skin hypersensitivity such as the guinea pig maximization test or the Buehler test.")
Declaration(Class(goldbook:13683))
AnnotationAssertion(rdfs:label goldbook:13683 "skin test")
AnnotationAssertion(dcterms:description goldbook:13683 "Procedure for evaluating immunity status, involving the introduction of a reagent into or under the skin.")
Declaration(Class(goldbook:13684))
AnnotationAssertion(rdfs:label goldbook:13684 "slow-reacting substance of anaphylaxis")
AnnotationAssertion(dcterms:description goldbook:13684 "Group of leukotrienes released by mast cells during anaphylaxis, which induces a prolonged contraction of smooth muscle.")
Declaration(Class(goldbook:13685))
AnnotationAssertion(rdfs:label goldbook:13685 "small G protein")
AnnotationAssertion(dcterms:description goldbook:13685 "Any member of a family of monomeric G proteins, with molecular mass typically \\(\\pu{20\\!{-}\\! 40 kDa}\\), that also bind guanine nucleotides and are involved in signal transduction.")
Declaration(Class(goldbook:13686))
AnnotationAssertion(rdfs:label goldbook:13686 "small outer capsid protein")
AnnotationAssertion(dcterms:description goldbook:13686 "Protein from the shell of the bacteriophage T4, commonly used in construction of phage antibody libraries.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13686 "SOC protein")
Declaration(Class(goldbook:13687))
AnnotationAssertion(rdfs:label goldbook:13687 "somatic diversification theory")
AnnotationAssertion(dcterms:description goldbook:13687 "Theory that very few immunoglobulins (Ig) are inherited, but that extensive antibody diversity arises from mutations in non-reproductive cells.")
Declaration(Class(goldbook:13688))
AnnotationAssertion(rdfs:label goldbook:13688 "somatic gene conversion")
AnnotationAssertion(dcterms:description goldbook:13688 "Nonreciprocal exchange of nucleic acid sequences between genes in which part of the donor gene or genes is 'copied' into an acceptor gene, but only the acceptor gene is altered.")
Declaration(Class(goldbook:13689))
AnnotationAssertion(rdfs:label goldbook:13689 "somatic recombination")
AnnotationAssertion(dcterms:description goldbook:13689 "Process giving rise to increased antibody diversity by cutting and splicing immunoglobulin (Ig) genes during lymphocyte differentiation.")
Declaration(Class(goldbook:13690))
AnnotationAssertion(rdfs:label goldbook:13690 "spleen")
AnnotationAssertion(dcterms:description goldbook:13690 "Largest of the secondary lymphoid organs, composed of white pulp, rich in lymphoid cells, and red pulp, which contains many erythrocytes and macrophages.")
Declaration(Class(goldbook:13691))
AnnotationAssertion(rdfs:label goldbook:13691 "splenic")
AnnotationAssertion(dcterms:description goldbook:13691 "Of, pertaining to, connected with, or situated in the spleen.")
Declaration(Class(goldbook:13692))
AnnotationAssertion(rdfs:label goldbook:13692 "splenocyte")
AnnotationAssertion(dcterms:description goldbook:13692 "Any splenic cell.")
Declaration(Class(goldbook:13693))
AnnotationAssertion(rdfs:label goldbook:13693 "split adjuvant technique")
AnnotationAssertion(dcterms:description goldbook:13693 "Test for allergic contact dermatitis in which guinea pig skin is exposed to repeated applications of a test substance and intradermal injections of complete Freund’s adjuvant are administered separately.")
Declaration(Class(goldbook:13694))
AnnotationAssertion(rdfs:label goldbook:13694 "spondylitis")
AnnotationAssertion(dcterms:description goldbook:13694 "Inflammation of the vertebral column.")
Declaration(Class(goldbook:13695))
AnnotationAssertion(rdfs:label goldbook:13695 "spontaneous autoimmune thyroiditis")
AnnotationAssertion(dcterms:description goldbook:13695 "Autoimmune thyroiditis (see thyroiditis, autoimmune) that develops spontaneously (without any apparent cause or manipulation) in certain strains of mice and rats (e.g., NOD mice, BB and BUF rats) as well as in other animals (e.g., OS chickens, marmoset monkeys, beagles).")
Declaration(Class(goldbook:13696))
AnnotationAssertion(rdfs:label goldbook:13696 "Stevens–Johnson syndrome")
AnnotationAssertion(dcterms:description goldbook:13696 "Allergic reaction, often to a medication (see adverse drug reaction) or infection, characterized by blistering of the skin and ulceration of mucosal membranes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13696 "bullous erythema multiforme")
Declaration(Class(goldbook:13697))
AnnotationAssertion(rdfs:label goldbook:13697 "stroma")
AnnotationAssertion(dcterms:description goldbook:13697 "Supporting tissue of an organ.")
Declaration(Class(goldbook:13698))
AnnotationAssertion(rdfs:label goldbook:13698 "subacute cutaneous lupus erythematosus")
AnnotationAssertion(dcterms:description goldbook:13698 "Chronic remitting form of dermatitis characterized by severe photosensitivity and Ro/SS-A and La/SS-B autoantibodies.")
Declaration(Class(goldbook:13699))
AnnotationAssertion(rdfs:label goldbook:13699 "superantigen")
AnnotationAssertion(dcterms:description goldbook:13699 "Antigen which reacts with all the T cells belonging to a particular T-cell receptor (TCR) variable (V) region family, and which therefore stimulates (or deletes) a much larger number of cells than does conventional antigen.")
Declaration(Class(goldbook:13700))
AnnotationAssertion(rdfs:label goldbook:13700 "superfamily")
AnnotationAssertion(dcterms:description goldbook:13700 "Large group of proteins related by structural homology and function. The term also refers to the genes that encode them.")
Declaration(Class(goldbook:13701))
AnnotationAssertion(rdfs:label goldbook:13701 "suppression")
AnnotationAssertion(dcterms:description goldbook:13701 "Dominant immunological tolerance, a phenomenon that plays an active role in regulating T-cell and B-cell responses to both foreign antigens and autoantigens.")
Declaration(Class(goldbook:13702))
AnnotationAssertion(rdfs:label goldbook:13702 "suppressor cell")
AnnotationAssertion(dcterms:description goldbook:13702 "T cell that suppresses the immune response of B cells and other T cells to an antigen. In more current usage classified as a regulatory T cell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13702 "suppressor T cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13702 "suppressor T lymphocyte")
Declaration(Class(goldbook:13703))
AnnotationAssertion(rdfs:label goldbook:13703 "supramolecular adhesion complex")
AnnotationAssertion(dcterms:description goldbook:13703 "Collection of molecules forming at the contact point of a T cell and an antigen-presenting cell (APC), enriched in T-cell receptor (TCR), adhesion molecules, and signaling molecules.")
Declaration(Class(goldbook:13704))
AnnotationAssertion(rdfs:label goldbook:13704 "surrogate light chain")
AnnotationAssertion(dcterms:description goldbook:13704 "Light chain-like structure formed when the proteins encoded by the \\({\\rm{V}}_{\\rm{preB}}\\) and \\(\\uplambda_{5}\\) genes associate with each other. It can form immunoglobulin (Ig)-like complexes which are expressed on the surface of pre-B cells at different stages of development.")
Declaration(Class(goldbook:13705))
AnnotationAssertion(rdfs:label goldbook:13705 "switch sequence")
AnnotationAssertion(dcterms:description goldbook:13705 "Highly conserved repetitive sequence that mediates class switching in the immunoglobulin (Ig) heavy chain gene locus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13705 "switch region")
Declaration(Class(goldbook:13706))
AnnotationAssertion(rdfs:label goldbook:13706 "sympathetic ophthalmia")
AnnotationAssertion(dcterms:description goldbook:13706 "Autoimmune injury to one eye that occurs after penetrating injury or surgery to the other eye.")
Declaration(Class(goldbook:13707))
AnnotationAssertion(rdfs:label goldbook:13707 "syngeneic")
AnnotationAssertion(dcterms:description goldbook:13707 "Genetically identical, e.g., a fully inbred strain of mice.")
Declaration(Class(goldbook:13708))
AnnotationAssertion(rdfs:label goldbook:13708 "systemic")
AnnotationAssertion(dcterms:description goldbook:13708 """1) Relating to the body as a whole.
2) Occurring at a site in the body remote from the point of contact with a substance.""")
Declaration(Class(goldbook:13709))
AnnotationAssertion(rdfs:label goldbook:13709 "systemic autoimmune disease")
AnnotationAssertion(dcterms:description goldbook:13709 "Autoimmune disease affecting a number of organs or tissues, or the whole body.")
Declaration(Class(goldbook:13710))
AnnotationAssertion(rdfs:label goldbook:13710 "systemic lupus erythematosus")
AnnotationAssertion(dcterms:description goldbook:13710 "Chronic autoimmune disease that is potentially debilitating and sometimes fatal as the immune system attacks the body’s cells and tissues, with inflammation and tissue damage.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13710 "lupus")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13710 "lupus erythematosus")
Declaration(Class(goldbook:13711))
AnnotationAssertion(rdfs:label goldbook:13711 "systemic sclerosis")
AnnotationAssertion(dcterms:description goldbook:13711 "Fibrosing disease of unclear etiology that affects multiple organ systems.")
Declaration(Class(goldbook:13712))
AnnotationAssertion(rdfs:label goldbook:13712 "drug-specific T cell")
AnnotationAssertion(dcterms:description goldbook:13712 "T-memory cell that is specific for a drug allergen.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13712 "drug-specific T cell")
Declaration(Class(goldbook:13713))
AnnotationAssertion(rdfs:label goldbook:13713 "T-cell-dependent antibody response")
AnnotationAssertion(dcterms:description goldbook:13713 "Immunotoxicity test that evaluates the ability of animals to produce antibodies to a T-dependent antigen [e.g., sheep red blood cells (SRBCs) or keyhole limpet hemocyanin (KLH)].")
Declaration(Class(goldbook:13714))
AnnotationAssertion(rdfs:label goldbook:13714 "T-cell receptor")
AnnotationAssertion(dcterms:description goldbook:13714 "Antigen-specific receptor on T cells composed of one set of heterodimeric chains. Two types of TCR heterodimers are known (\\(\\upalpha/\\upbeta\\) and \\(\\upgamma/\\updelta\\)).")
Declaration(Class(goldbook:13715))
AnnotationAssertion(rdfs:label goldbook:13715 "T-dependent antigen")
AnnotationAssertion(dcterms:description goldbook:13715 "Antigen that requires helper T lymphocytes (Th) in order to elicit an antibody response.")
Declaration(Class(goldbook:13716))
AnnotationAssertion(rdfs:label goldbook:13716 "TdT-dependent dUTP-biotin nick end labeling assay")
AnnotationAssertion(dcterms:description goldbook:13716 "Method for detecting apoptotic cells in situ based on characteristic DNA fragmentation. It is based on the ability of terminal deoxynucleotidyl transferase (TdT) to transfer a labeled deoxyuridine triphosphate to the terminal ends arising from DNA cleavage.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13716 "TUNEL assay")
Declaration(Class(goldbook:13717))
AnnotationAssertion(rdfs:label goldbook:13717 "Th0 cell")
AnnotationAssertion(dcterms:description goldbook:13717 "Helper T lymphocyte (Th) with a less restricted cytokine profile than Th1 and Th2 cells.")
Declaration(Class(goldbook:13718))
AnnotationAssertion(rdfs:label goldbook:13718 "Th1 cell")
AnnotationAssertion(dcterms:description goldbook:13718 "Helper T lymphocyte (Th) producing mainly interleukin-2 (IL-2), interferon (IFN-$\\ce{\\upgamma\\!}$), and tumor necrosis factor $\\ce{\\upbeta\\!}$ ($\\ce{TNF\\mbox{-}\\upbeta\\!}$), and thereby responsible for phagocyte-dependent host responses.")
Declaration(Class(goldbook:13719))
AnnotationAssertion(rdfs:label goldbook:13719 "Th2 cell")
AnnotationAssertion(dcterms:description goldbook:13719 "Helper T lymphocyte (Th) in mice producing interleukins IL-4, IL-5, IL-6, IL-9, IL-10, and IL-13.")
Declaration(Class(goldbook:13720))
AnnotationAssertion(rdfs:label goldbook:13720 "Th3 cell")
AnnotationAssertion(dcterms:description goldbook:13720 "Helper T lymphocyte (Th) producing and responding to transforming growth factor $\\ce{\\upbeta\\!}$ ($\\ce{TGF\\mbox{-}\\upbeta\\!}$) and helping immunoglobulin A (IgA) antibody responses.")
Declaration(Class(goldbook:13721))
AnnotationAssertion(rdfs:label goldbook:13721 "Th9 cell")
AnnotationAssertion(dcterms:description goldbook:13721 "Helper T lymphocyte (Th) producing interleukin IL-9, which stimulates mast cells.")
Declaration(Class(goldbook:13722))
AnnotationAssertion(rdfs:label goldbook:13722 "Th17 cell")
AnnotationAssertion(dcterms:description goldbook:13722 "Helper T lymphocyte (Th), distinct from Th1 and Th2 cells, that secretes the interleukin IL-17.")
Declaration(Class(goldbook:13723))
AnnotationAssertion(rdfs:label goldbook:13723 "T-independent antigen")
AnnotationAssertion(dcterms:description goldbook:13723 "Antigen that is able to elicit an antibody response in the absence of T cells.")
Declaration(Class(goldbook:13724))
AnnotationAssertion(rdfs:label goldbook:13724 "T lymphocyte")
AnnotationAssertion(dcterms:description goldbook:13724 "Lymphocyte that matures in the thymus and has the ability to recognize specific peptide antigens through the receptors on its cell surface.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13724 "T cell")
Declaration(Class(goldbook:13725))
AnnotationAssertion(rdfs:label goldbook:13725 "Tr1 cell")
AnnotationAssertion(dcterms:description goldbook:13725 "T lymphocyte that regulates Th1 cell responses. It resembles the regulatory T cell (Treg) and is possibly related to the Th3 cell.")
Declaration(Class(goldbook:13726))
AnnotationAssertion(rdfs:label goldbook:13726 "tandem conjugate")
AnnotationAssertion(dcterms:description goldbook:13726 "Molecular construct with two fluorochromes where the first excites the second by its emission.")
Declaration(Class(goldbook:13727))
AnnotationAssertion(rdfs:label goldbook:13727 "target cell")
AnnotationAssertion(dcterms:description goldbook:13727 "Cell killed by one of the body’s killer cells, such as a cytotoxic T lymphocyte or natural killer (NK) cell.")
Declaration(Class(goldbook:13728))
AnnotationAssertion(rdfs:label goldbook:13728 "terminal deoxynucleotidyl transferase")
AnnotationAssertion(dcterms:description goldbook:13728 "Enzyme that inserts non-coded nucleotides at the junctions of V, D, and J gene segments of immunoglobulin (Ig) and T-cell receptor (TCR) locus DNA, thus increasing the diversity of antigen-specific recognition.")
Declaration(Class(goldbook:13729))
AnnotationAssertion(rdfs:label goldbook:13729 "tetanus toxoid")
AnnotationAssertion(dcterms:description goldbook:13729 "Detoxified tetanus toxin used to produce active immunity (see active immune response) against tetanus.")
Declaration(Class(goldbook:13730))
AnnotationAssertion(rdfs:label goldbook:13730 "tetramer staining")
AnnotationAssertion(dcterms:description goldbook:13730 "Technique used for selective staining of antigen-specific T lymphocytes in vitro or in situ. The antigen is presented to T cells by peptide tetramer constructs of major histocompatibility (MHC) class I molecules. It is also used to isolate antigen-specific T-cell populations for clonal expansion.")
Declaration(Class(goldbook:13731))
AnnotationAssertion(rdfs:label goldbook:13731 "tertiary lymphoid tissue")
AnnotationAssertion(dcterms:description goldbook:13731 "Ectopic lymphoid aggregates that accumulate during the process of chronic immune stimulation, and exhibit characteristics usually associated with the secondary lymphoid organs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13731 "Tertiary Lymphoid Organ")
Declaration(Class(goldbook:13732))
AnnotationAssertion(rdfs:label goldbook:13732 "thromboxane")
AnnotationAssertion(dcterms:description goldbook:13732 "Any of several substances (predominantly thromboxanes A2 and B2) synthesized by platelets from arachidonic acid precursor, that cause vasoconstriction of vascular and bronchial smooth muscle and facilitates platelet aggregation.")
Declaration(Class(goldbook:13733))
AnnotationAssertion(rdfs:label goldbook:13733 "thrush")
AnnotationAssertion(dcterms:description goldbook:13733 "Oral infection with Candida albicans, often in patients with immunosuppression.")
Declaration(Class(goldbook:13734))
AnnotationAssertion(rdfs:label goldbook:13734 "thymic")
AnnotationAssertion(dcterms:description goldbook:13734 "Pertaining to the thymus.")
Declaration(Class(goldbook:13735))
AnnotationAssertion(rdfs:label goldbook:13735 "thymic atrophy")
AnnotationAssertion(dcterms:description goldbook:13735 "Involution of the thymus gland leading to a diminished capacity to generate new T cells.")
Declaration(Class(goldbook:13736))
AnnotationAssertion(rdfs:label goldbook:13736 "thymic education")
AnnotationAssertion(dcterms:description goldbook:13736 "Process by which T cells, developing in the thymus, are screened for potentially harmful self-reactive T cells (which are removed), while potentially beneficial T cells are promoted.")
Declaration(Class(goldbook:13737))
AnnotationAssertion(rdfs:label goldbook:13737 "thymoma")
AnnotationAssertion(dcterms:description goldbook:13737 "Rare, usually benign, tumor arising from tissue of the thymus gland.")
Declaration(Class(goldbook:13738))
AnnotationAssertion(rdfs:label goldbook:13738 "thymus-dependent antigen")
AnnotationAssertion(dcterms:description goldbook:13738 "Antigen that requires the participation of T lymphocytes to elicit an immune response in B lymphocytes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13738 "TD antigen")
Declaration(Class(goldbook:13739))
AnnotationAssertion(rdfs:label goldbook:13739 "thymus-independent antigen")
