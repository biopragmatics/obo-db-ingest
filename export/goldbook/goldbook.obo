[Term]
id: goldbook:08653
name: optical path difference
def: "Path-length difference between the arms of a two-beam interferometer."
comment: "SI unit: \(\pu{m}\). Common unit: \(\pu{cm}\)."
comment: "The term optical retardation is derived from 'phase retardation', which refers to the change in the phase of the electromagnetic radiation in the interferometer."
synonym: "OPD" RELATED OMO:0003000 []
synonym: "optical retardation" []
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
consider: goldbook:08242
consider: goldbook:08278

[Term]
id: goldbook:08654
name: optical rotatory dispersion
def: "Wavelength dependence of the angle of rotation of the plane of linearly-polarized radiation when transmitted through optically active materials."
synonym: "ORD" RELATED OMO:0003000 []
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
