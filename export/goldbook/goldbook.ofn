AnnotationAssertion(rdfs:label goldbook:11792 "glutamate")
AnnotationAssertion(dcterms:description goldbook:11792 "Salt of glutamic acid (2-aminopentanedioic acid).")
AnnotationAssertion(rdfs:comment goldbook:11792 "Glutamate is a major excitatory neurotransmitter in the vertebrate nervous system."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11792 "Monosodium glutamate (MSG) is commonly used in the food industry as a flavor enhancer, and at high doses has given rise to reported feelings of headache and discomfort."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11792 goldbook:11800)
AnnotationAssertion(rdfs:seeAlso goldbook:11792 goldbook:11955)
AnnotationAssertion(mito:isMentionedBy goldbook:11792 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11792 "current"^^xsd:string)
Declaration(Class(goldbook:11793))
AnnotationAssertion(rdfs:label goldbook:11793 "glutamate-induced excitotoxicity")
AnnotationAssertion(dcterms:description goldbook:11793 "Form of excitotoxicity where excess glutamate release in synapses (glutamatergic storm) leads to overstimulation, followed by excess cellular calcium uptake, cytotoxicity and apoptosis.")
AnnotationAssertion(rdfs:comment goldbook:11793 "N-methyl-D-aspartic acid, kainic acid, and other ligands of the glutamate receptor induce this effect."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11793 "Excitotoxicity may occur after acute neuronalischemia and damage. It is believed to be a factor in chronic diseases of the nervous system, and in some withdrawal phenomena."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11793 goldbook:11869)
AnnotationAssertion(rdfs:seeAlso goldbook:11793 goldbook:11766)
AnnotationAssertion(rdfs:seeAlso goldbook:11793 goldbook:11792)
