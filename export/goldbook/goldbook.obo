[Term]
id: goldbook:09237
name: chromatic aberration
def: "Non-ideal focus of an electron or ion optical system for electrons or ions of different energies."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0404
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:09238
name: collision cascade
def: "Sequential energy transfer between atoms in a solid as a result of bombardment by an energetic species."
