        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.D01747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.D01870"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.E02243"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.F02514"/>
