Declaration(Class(goldbook:10973))
AnnotationAssertion(rdfs:label goldbook:10973 "morphogenesis")
AnnotationAssertion(dcterms:description goldbook:10973 "Shaping of an organism during embryological development by differentiation of cells, tissues, organs, and organ systems, according to the genetic program of the organism, and influenced by morphogens and environmental conditions.")
Declaration(Class(goldbook:10974))
AnnotationAssertion(rdfs:label goldbook:10974 "morphological")
AnnotationAssertion(dcterms:description goldbook:10974 "Pertaining to structure or form.")
Declaration(Class(goldbook:10975))
AnnotationAssertion(rdfs:label goldbook:10975 "morula")
AnnotationAssertion(dcterms:description goldbook:10975 "Early multi-celled stage of the embryo from which the blastocyst is formed.")
Declaration(Class(goldbook:10976))
AnnotationAssertion(rdfs:label goldbook:10976 "mosaicism")
AnnotationAssertion(dcterms:description goldbook:10976 "Condition in which an individual or an organism that develops from a single zygote has two or more cell populations that differ in genetic constitution.")
Declaration(Class(goldbook:10977))
AnnotationAssertion(rdfs:label goldbook:10977 "sperm motility")
AnnotationAssertion(dcterms:description goldbook:10977 "Energy-dependent forward movement of the sperm, allowing it to reach and penetrate the egg.")
Declaration(Class(goldbook:10978))
AnnotationAssertion(rdfs:label goldbook:10978 "mucous membrane")
AnnotationAssertion(dcterms:description goldbook:10978 "Layer of epithelial tissue with a thin underlying layer of connective tissue (the lamina propria) that lines many body cavities, including the gut, respiratory passages, and tubular organs; it secretes, and is covered in, mucus.")
