AnnotationAssertion(obo:goldbook#hasStatus goldbook:R05397 "current"^^xsd:string)
Declaration(Class(goldbook:R05400))
AnnotationAssertion(rdfs:label goldbook:R05400 "rise time")
AnnotationAssertion(dcterms:description goldbook:R05400 "The difference between the response time and the dead time.")
AnnotationAssertion(rdfs:seeAlso goldbook:R05400 goldbook:D01530)
AnnotationAssertion(rdfs:seeAlso goldbook:R05400 goldbook:R05346)
