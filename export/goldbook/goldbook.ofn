Declaration(Class(goldbook:10797))
AnnotationAssertion(rdfs:label goldbook:10797 "hiatal hernia")
AnnotationAssertion(dcterms:description goldbook:10797 "Hernia of a part of the stomach through a rupture of the diaphragm at the esophageal opening.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10797 "hiatus hernia")
Declaration(Class(goldbook:10798))
AnnotationAssertion(rdfs:label goldbook:10798 "herpes")
