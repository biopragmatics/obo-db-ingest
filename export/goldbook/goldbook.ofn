AnnotationAssertion(rdfs:seeAlso goldbook:13556 goldbook:13414)
AnnotationAssertion(rdfs:seeAlso goldbook:13556 goldbook:13302)
AnnotationAssertion(mito:isMentionedBy goldbook:13556 doi:10.1351/PAC-REC-11-06-03)
