AnnotationAssertion(dcterms:description goldbook:11836 "Pressure within the cranial cavity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11836 "ICP")
AnnotationAssertion(rdfs:comment goldbook:11836 "Increased ICP may result from increased volume of the cerebrospinal fluid."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11836 "Even minor increases in ICP, e.g., due to intracranial bleeding, may cause serious damage to the brain."^^xsd:string)
