Declaration(Class(goldbook:S05886))
AnnotationAssertion(rdfs:label goldbook:S05886 "spontaneous emission")
AnnotationAssertion(dcterms:description goldbook:S05886 "That mode of emission which occurs even in the absence of a perturbing external electromagnetic field. The transition between states, \\(n\\) and \\(m\\), is governed by the einstein coefficient of spontaneous emission, \\(A_{nm}\\).")
