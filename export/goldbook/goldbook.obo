[Term]
id: goldbook:T06421
name: trace element
def: "Any element having an average concentration of less than about 100 parts per million atoms \(\\\(\\rm\{ppma\}\\\)\) or less than \\\(100\\ \\frac\{\\unicode\[Times\]\{x3BC\}\\rm\{g\}\}\{\\rm\{g\}\}\\\)."
property_value: mito:isMentionedBy doi:10.1351/pac197951112243
