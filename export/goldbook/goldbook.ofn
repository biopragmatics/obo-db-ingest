AnnotationAssertion(rdfs:label goldbook:12090 "status epilepticus")
AnnotationAssertion(dcterms:description goldbook:12090 "Repeated or prolonged seizure lasting more than \\(\\pu{30 min}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:12090 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12090 "current"^^xsd:string)
Declaration(Class(goldbook:12091))
AnnotationAssertion(rdfs:label goldbook:12091 "stereology")
AnnotationAssertion(dcterms:description goldbook:12091 "Three dimensional interpretation of two dimensional cross sections of tissue and other materials.")
AnnotationAssertion(rdfs:comment goldbook:12091 "Often used for estimating the number of neurons or neuronal cell bodies in a volume of tissue."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12091 "Stereology is different from tomography; the latter requires a complete set of planes to reconstruct the internal structure whereas stereology uses statistical methods to reconstruct the image from representative plane sections."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:12091 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12091 "current"^^xsd:string)
Declaration(Class(goldbook:12092))
AnnotationAssertion(rdfs:label goldbook:12092 "unbiased stereology")
AnnotationAssertion(dcterms:description goldbook:12092 "Stereological method that uses systematic analysis of defined spatial fractions of a sample to estimate numbers of neuronal nuclei independent of changes in size and shape that may occur during tissue processing.")
AnnotationAssertion(rdfs:seeAlso goldbook:12092 goldbook:12091)
AnnotationAssertion(mito:isMentionedBy goldbook:12092 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12092 "current"^^xsd:string)
Declaration(Class(goldbook:12093))
AnnotationAssertion(rdfs:label goldbook:12093 "stimulant")
AnnotationAssertion(dcterms:description goldbook:12093 "Agent that rouses or increases mental or physical activity.")
AnnotationAssertion(mito:isMentionedBy goldbook:12093 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12093 "current"^^xsd:string)
Declaration(Class(goldbook:12094))
AnnotationAssertion(rdfs:label goldbook:12094 "stimulus")
AnnotationAssertion(dcterms:description goldbook:12094 "Anything that produces a reaction in an organism. That which causes a response in an excitable tissue such as a nerve, muscle or gland.")
AnnotationAssertion(mito:isMentionedBy goldbook:12094 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12094 "current"^^xsd:string)
Declaration(Class(goldbook:12095))
AnnotationAssertion(rdfs:label goldbook:12095 "conditioned stimulus")
AnnotationAssertion(dcterms:description goldbook:12095 "Stimulus that comes to evoke a response after repetitive pairing with another stimulus that automatically elicits that response.")
AnnotationAssertion(rdfs:seeAlso goldbook:12095 goldbook:12094)
AnnotationAssertion(rdfs:seeAlso goldbook:12095 goldbook:11687)
AnnotationAssertion(rdfs:seeAlso goldbook:12095 goldbook:12096)
AnnotationAssertion(mito:isMentionedBy goldbook:12095 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12095 "current"^^xsd:string)
Declaration(Class(goldbook:12096))
AnnotationAssertion(rdfs:label goldbook:12096 "unconditioned stimulus")
AnnotationAssertion(dcterms:description goldbook:12096 "Stimulus that automatically elicits a paired response, such as food eliciting salivation in a hungry animal.")
AnnotationAssertion(rdfs:seeAlso goldbook:12096 goldbook:12094)
AnnotationAssertion(rdfs:seeAlso goldbook:12096 goldbook:12095)
AnnotationAssertion(mito:isMentionedBy goldbook:12096 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12096 "current"^^xsd:string)
