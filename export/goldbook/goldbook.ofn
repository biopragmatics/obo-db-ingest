AnnotationAssertion(obo:goldbook#hasStatus goldbook:12121 "current"^^xsd:string)
Declaration(Class(goldbook:12122))
AnnotationAssertion(rdfs:label goldbook:12122 "tau protein")
AnnotationAssertion(dcterms:description goldbook:12122 "One of a class of proteins that stabilizes microtubules, particularly in neurons, astrocytes, and oligodendrocytes of the central nervous system.")
AnnotationAssertion(rdfs:comment goldbook:12122 "The various tau proteins are splice variants of the single gene microtubule-associated protein tau (MAPT)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12122 "Defective tau proteins are associated with dementias such as Alzheimer disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12122 goldbook:11574)
AnnotationAssertion(rdfs:seeAlso goldbook:12122 goldbook:11614)
AnnotationAssertion(rdfs:seeAlso goldbook:12122 goldbook:11704)
