AnnotationAssertion(mito:isMentionedBy goldbook:I03289 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:I03289 "current"^^xsd:string)
Declaration(Class(goldbook:I03290))
AnnotationAssertion(rdfs:label goldbook:I03290 "isomerases")
AnnotationAssertion(dcterms:description goldbook:I03290 "Enzymes that catalyse intramolecular rearrangements. Isomerases are classified into racemases and epimerases, cis-trans isomerases, intramolecular lyases and other isomerases.")
