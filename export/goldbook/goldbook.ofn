AnnotationAssertion(rdfs:seeAlso goldbook:C00878 goldbook:C00876)
AnnotationAssertion(mito:isMentionedBy goldbook:C00878 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:C00878 "current"^^xsd:string)
