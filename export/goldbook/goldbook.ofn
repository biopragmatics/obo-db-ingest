AnnotationAssertion(dcterms:description goldbook:14313 "Colloidal dispersion in which at least one of the phases is a polymer, either organic, or inorganic or some combination of the two.")
Declaration(Class(goldbook:14314))
AnnotationAssertion(rdfs:label goldbook:14314 "polymer emulsion")
AnnotationAssertion(dcterms:description goldbook:14314 "Emulsion in which the dispersed phase is a liquid polymer or a polymer solution.")
Declaration(Class(goldbook:14315))
AnnotationAssertion(rdfs:label goldbook:14315 "macro-emulsion")
AnnotationAssertion(dcterms:description goldbook:14315 "Emulsion in which the particles of the dispersed phase have diameters from approximately \\(\\pu{1 \\upmu m}\\) to \\(\\pu{100 \\upmu m}\\).")
Declaration(Class(goldbook:14316))
AnnotationAssertion(rdfs:label goldbook:14316 "mini-emulsion")
AnnotationAssertion(dcterms:description goldbook:14316 "Emulsion in which the particles of the dispersed phase have diameters in the range from approximately \\(\\pu{50 nm}\\) to \\(\\pu{1 \\upmu m}\\).")
Declaration(Class(goldbook:14317))
AnnotationAssertion(rdfs:label goldbook:14317 "micro-emulsion")
AnnotationAssertion(dcterms:description goldbook:14317 "Dispersion made of water, oil, and surfactant(s) that is an isotropic and thermodynamically stable system with dispersed domain diameter varying approximately from \\(\\pu{1 nm}\\) to \\(\\pu{100 nm}\\), usually \\(\\pu{10 nm}\\) to \\(\\pu{50 nm}\\).")
Declaration(Class(goldbook:14318))
AnnotationAssertion(rdfs:label goldbook:14318 "hemi-micelle")
AnnotationAssertion(dcterms:description goldbook:14318 "Type of micelle that exists in relatively small numbers below the critical micelle concentration.")
Declaration(Class(goldbook:14319))
AnnotationAssertion(rdfs:label goldbook:14319 "ad-micelle")
AnnotationAssertion(dcterms:description goldbook:14319 "Surfactant bilayer formed on a charged adsorbing surface.")
Declaration(Class(goldbook:14320))
AnnotationAssertion(rdfs:label goldbook:14320 "micellar aggregation number")
AnnotationAssertion(dcterms:description goldbook:14320 "Number of molecules constituting a micelle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14320 "micellar degree of association")
Declaration(Class(goldbook:14321))
AnnotationAssertion(rdfs:label goldbook:14321 "micellar charge")
AnnotationAssertion(dcterms:description goldbook:14321 "Combined charge of the surfactant ions and counterions tightly bound to a micelle.")
Declaration(Class(goldbook:14322))
AnnotationAssertion(rdfs:label goldbook:14322 "micellar relative molar mass")
AnnotationAssertion(dcterms:description goldbook:14322 "Mass of a mole of micelles divided by the molar mass constant. The relative molar mass of micelles (mic) is thus \\(M_{\\rm{r,mic}} = M_{\\rm{mic}}/M_{\\rm{u}}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14322 "micellar molecular weight")
Declaration(Class(goldbook:14323))
AnnotationAssertion(rdfs:label goldbook:14323 "particle number concentration")
AnnotationAssertion(dcterms:description goldbook:14323 "Number of particles per volume of suspending medium.")
Declaration(Class(goldbook:14324))
AnnotationAssertion(rdfs:label goldbook:14324 "solids content")
AnnotationAssertion(dcterms:description goldbook:14324 "Mass fraction of nonvolatile material in a polymer dispersion.")
Declaration(Class(goldbook:14325))
AnnotationAssertion(rdfs:label goldbook:14325 "polymer content")
AnnotationAssertion(dcterms:description goldbook:14325 "Mass fraction of polymer in a polymer dispersion.")
Declaration(Class(goldbook:14326))
AnnotationAssertion(rdfs:label goldbook:14326 "dispersed-phase concentration")
AnnotationAssertion(dcterms:description goldbook:14326 "Amount concentration of a species within the dispersed phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14326 "dispersed-phase amount concentration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14326 "particle-phase amount concentration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14326 "particle-phase concentration")
Declaration(Class(goldbook:14327))
AnnotationAssertion(rdfs:label goldbook:14327 "continuous-phase concentration")
AnnotationAssertion(dcterms:description goldbook:14327 "Concentration of species within the continuous phase of a dispersion.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14327 "continuous-phase amount concentration")
Declaration(Class(goldbook:14328))
AnnotationAssertion(rdfs:label goldbook:14328 "polymer mass fraction")
AnnotationAssertion(dcterms:description goldbook:14328 "Mass fraction of polymer within the dispersed phase.")
Declaration(Class(goldbook:14329))
AnnotationAssertion(rdfs:label goldbook:14329 "emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14329 "Polymerization whereby monomer(s), initiator, dispersion medium, and possibly colloid stabilizer constitute initially an inhomogeneous system resulting in particles of colloidal dimensions containing the formed polymer.")
Declaration(Class(goldbook:14330))
AnnotationAssertion(rdfs:label goldbook:14330 "ab initio emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14330 "Emulsion polymerization in which no seed particles are added.")
Declaration(Class(goldbook:14331))
AnnotationAssertion(rdfs:label goldbook:14331 "batch emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14331 "Emulsion polymerization in which all the ingredients are placed in a reactor prior to reaction.")
Declaration(Class(goldbook:14332))
AnnotationAssertion(rdfs:label goldbook:14332 "continuous emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14332 "Emulsion polymerization in which all the ingredients are added continuously and the product latex is removed continuously.")
Declaration(Class(goldbook:14333))
AnnotationAssertion(rdfs:label goldbook:14333 "emulsifier-free emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14333 "Emulsion polymerization carried out without the addition of a colloid stabilizer.")
Declaration(Class(goldbook:14334))
AnnotationAssertion(rdfs:label goldbook:14334 "encapsulating emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14334 "Emulsion polymerization leading to the encapsulation of a solid within polymer particles or liquid polymer droplets.")
Declaration(Class(goldbook:14335))
AnnotationAssertion(rdfs:label goldbook:14335 "inverse emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14335 "Emulsion polymerization in a nonaqueous medium in which the dispersed phase is usually an aqueous solution, initially of monomer(s), and finally of polymer.")
Declaration(Class(goldbook:14336))
AnnotationAssertion(rdfs:label goldbook:14336 "monomer-flooded emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14336 "Semi-continuous emulsion polymerization in which the monomer(s) is(are) fed to the reactor at a rate that exceeds the rate of polymerization.")
Declaration(Class(goldbook:14337))
AnnotationAssertion(rdfs:label goldbook:14337 "monomer-starved emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14337 "Semi-continuous emulsion polymerization in which the polymerization rate is controlled by the feed rate(s) of monomer(s), in such a way that, for most of the process, the polymerization rate equals the monomer(s) feed rate(s).")
Declaration(Class(goldbook:14338))
AnnotationAssertion(rdfs:label goldbook:14338 "power-feed emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14338 "Semi-continuous emulsion copolymerization in which the instantaneous composition of the formed copolymer is the same as that of the added monomer mixture(s).")
Declaration(Class(goldbook:14339))
AnnotationAssertion(rdfs:label goldbook:14339 "seeded emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14339 "Emulsion polymerization with seed particles are formed in situ or added initially to the polymerizing mixture.")
Declaration(Class(goldbook:14340))
AnnotationAssertion(rdfs:label goldbook:14340 "semi-continuous emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14340 "Emulsion polymerization in which some of the ingredients are initially placed in a reactor and the remaining ingredients are added during the polymerization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14340 "semi-batch emulsion polymerization")
Declaration(Class(goldbook:14341))
AnnotationAssertion(rdfs:label goldbook:14341 "vesicle polymerisation")
AnnotationAssertion(dcterms:description goldbook:14341 "Polymerization inside the bilayer of a vesicle leading to formation of polymer inside the bilayer.")
Declaration(Class(goldbook:14342))
AnnotationAssertion(rdfs:label goldbook:14342 "micro-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14342 "Emulsion polymerization in which the starting system is a micro-emulsion and the final latex comprises colloidal particles of polymer dispersed in an aqueous medium.")
Declaration(Class(goldbook:14343))
AnnotationAssertion(rdfs:label goldbook:14343 "inverse micro-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14343 "Emulsion polymerization in which the starting system is a micro-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase.")
Declaration(Class(goldbook:14344))
AnnotationAssertion(rdfs:label goldbook:14344 "micellar polymerisation")
AnnotationAssertion(dcterms:description goldbook:14344 "Polymerization of a polymerizable surfactant in solution above its critical micelle concentration.")
Declaration(Class(goldbook:14345))
AnnotationAssertion(rdfs:label goldbook:14345 "mini-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14345 "Polymerization of a mini-emulsion of monomer in which all of the polymerization occurs within preexisting monomer particles without the formation of new particles.")
Declaration(Class(goldbook:14346))
AnnotationAssertion(rdfs:label goldbook:14346 "inverse mini-emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14346 "Emulsion polymerization in which the starting system is a mini-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase.")
Declaration(Class(goldbook:14347))
AnnotationAssertion(rdfs:label goldbook:14347 "precipitation polymerisation")
AnnotationAssertion(dcterms:description goldbook:14347 "Polymerization in which monomer(s), initiator(s) and colloid stabilizer(s) are dissolved in a solvent and this continuous phase that is a nonsolvent for the formed polymer beyond a critical molecular weight.")
Declaration(Class(goldbook:14348))
AnnotationAssertion(rdfs:label goldbook:14348 "dispersion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14348 "Precipitation polymerization in which monomer(s), initiator(s), and colloid stabilizer(s) are dissolved in a solvent forming initially a homogeneous system that produces polymer and results in the formation of polymer particles.")
Declaration(Class(goldbook:14349))
AnnotationAssertion(rdfs:label goldbook:14349 "seeded dispersion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14349 "Dispersion polymerization in which seed particles are formed in situ or added prior to initiation of the polymerization.")
Declaration(Class(goldbook:14350))
AnnotationAssertion(rdfs:label goldbook:14350 "precipitation polycondensation")
AnnotationAssertion(dcterms:description goldbook:14350 "Precipitation polymerization proceeding by polycondensation.")
Declaration(Class(goldbook:14351))
AnnotationAssertion(rdfs:label goldbook:14351 "dispersion polycondensation")
AnnotationAssertion(dcterms:description goldbook:14351 "Dispersion polymerization proceeding by polycondensation.")
Declaration(Class(goldbook:14352))
AnnotationAssertion(rdfs:label goldbook:14352 "precipitation polyaddition")
AnnotationAssertion(dcterms:description goldbook:14352 "Precipitation polymerization proceeding by polyaddition.")
Declaration(Class(goldbook:14353))
AnnotationAssertion(rdfs:label goldbook:14353 "dispersion polyaddition")
AnnotationAssertion(dcterms:description goldbook:14353 "Dispersion polymerization proceeding by polyaddition.")
Declaration(Class(goldbook:14354))
AnnotationAssertion(rdfs:label goldbook:14354 "suspension polymerisation")
AnnotationAssertion(dcterms:description goldbook:14354 "Polymerization in which polymer is formed in monomer, or monomer-solvent droplets in a continuous phase that is a nonsolvent for both the monomer and the formed polymer.")
Declaration(Class(goldbook:14355))
AnnotationAssertion(rdfs:label goldbook:14355 "micro-suspension polymerisation")
AnnotationAssertion(dcterms:description goldbook:14355 "Suspension polymerization in which the diameter of the monomer droplets is of the order of a few \\(\\pu{\\upmu m}\\).")
Declaration(Class(goldbook:14356))
AnnotationAssertion(rdfs:label goldbook:14356 "average number of radicals per particle")
AnnotationAssertion(dcterms:description goldbook:14356 "Ratio of the total number of radicals in particles to the number of particles.")
Declaration(Class(goldbook:14357))
AnnotationAssertion(rdfs:label goldbook:14357 "critical oligomer degree of polymerisation for irreversible entry")
AnnotationAssertion(dcterms:description goldbook:14357 "Lowest degree of polymerization of aqueous-phase oligomer-radicals needed for irreversible capture by colloidal particles, micelles, or both during a polymerization.")
Declaration(Class(goldbook:14358))
AnnotationAssertion(rdfs:label goldbook:14358 "critical oligomer degree of polymerisation for precipitation")
AnnotationAssertion(dcterms:description goldbook:14358 "Lowest degree of polymerization of oligomer-radicals that precipitate from the continuous phase during a polymerization.")
Declaration(Class(goldbook:14359))
AnnotationAssertion(rdfs:label goldbook:14359 "intervals in emulsion polymerisations")
AnnotationAssertion(dcterms:description goldbook:14359 "Periods in an emulsion polymerization defined by the formation of polymer particles, and the presence or absence of monomer droplets in the polymerizing mixture.")
Declaration(Class(goldbook:14360))
AnnotationAssertion(rdfs:label goldbook:14360 "interval 1 in emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14360 "Period in a batch ab initio emulsion polymerization during which the formation of particles takes place.")
Declaration(Class(goldbook:14361))
AnnotationAssertion(rdfs:label goldbook:14361 "interval 2 in emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14361 "Period in an emulsion polymerization during which no new particles are formed and monomer droplets are present.")
Declaration(Class(goldbook:14362))
AnnotationAssertion(rdfs:label goldbook:14362 "interval 3 in emulsion polymerisation")
AnnotationAssertion(dcterms:description goldbook:14362 "Period in an emulsion polymerization during which no new particles are formed and no monomer droplets are present.")
Declaration(Class(goldbook:14363))
AnnotationAssertion(rdfs:label goldbook:14363 "zero-one behaviour")
AnnotationAssertion(dcterms:description goldbook:14363 "Limiting behaviour in an emulsion, mini-emulsion, or micro-emulsion polymerization during which the entry of a radical into a particle that contains a growing radical results in termination before significant propagation has occurred.")
Declaration(Class(goldbook:14364))
AnnotationAssertion(rdfs:label goldbook:14364 "compartmentalisation behaviour")
AnnotationAssertion(dcterms:description goldbook:14364 "Zero-one behaviour wherein radicals are isolated, each being located within a different latex particle.")
Declaration(Class(goldbook:14365))
AnnotationAssertion(rdfs:label goldbook:14365 "pseudo-bulk behaviour")
AnnotationAssertion(dcterms:description goldbook:14365 "Behaviour in an emulsion, mini-emulsion, micro-emulsion, suspension, or dispersion polymerization wherein the kinetics are such that the rate equations are the same as those for polymerization in bulk.")
Declaration(Class(goldbook:14366))
AnnotationAssertion(rdfs:label goldbook:14366 "homogeneous micellisation nucleation")
AnnotationAssertion(dcterms:description goldbook:14366 "Formation of primary particles as a result of micelle formation from surface-active oligomer radicals formed in a polymerization.")
Declaration(Class(goldbook:14367))
AnnotationAssertion(rdfs:label goldbook:14367 "micellar nucleation")
AnnotationAssertion(dcterms:description goldbook:14367 "Formation of primary particles as a result of polymerization within monomer-swollen micelles initiated by the capture of primary radicals or oligomer-radicals.")
Declaration(Class(goldbook:14368))
AnnotationAssertion(rdfs:label goldbook:14368 "coagulative nucleation")
AnnotationAssertion(dcterms:description goldbook:14368 "A process combining nucleation by any mechanism with subsequent coagulation being a significant event in formation of colloidally stable particles.")
Declaration(Class(goldbook:14369))
AnnotationAssertion(rdfs:label goldbook:14369 "phase-transfer event in a dispersed system")
AnnotationAssertion(dcterms:description goldbook:14369 "Transport of any species (radical, monomer, chain-transfer agent, etc.) from the continuous to the discrete phase and vice-versa.")
Declaration(Class(goldbook:14370))
AnnotationAssertion(rdfs:label goldbook:14370 "radical entry")
AnnotationAssertion(dcterms:description goldbook:14370 "Irreversible transport of a radical from the continuous to the dispersed phase.")
Declaration(Class(goldbook:14371))
AnnotationAssertion(rdfs:label goldbook:14371 "radical entry frequency")
AnnotationAssertion(dcterms:description goldbook:14371 "Average number of entry events per particle per unit interval of time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14371 "entry frequency")
Declaration(Class(goldbook:14372))
AnnotationAssertion(rdfs:label goldbook:14372 "radical exit")
AnnotationAssertion(dcterms:description goldbook:14372 "Reversible or irreversible transport of a radical from the dispersed to the continuous phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14372 "radical desorption")
Declaration(Class(goldbook:14373))
AnnotationAssertion(rdfs:label goldbook:14373 "radical exit frequency")
AnnotationAssertion(dcterms:description goldbook:14373 "Average number of exit events per particle per unit interval of time per radical.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14373 "exit frequency")
Declaration(Class(goldbook:14375))
AnnotationAssertion(rdfs:label goldbook:14375 "primary radical")
AnnotationAssertion(dcterms:description goldbook:14375 "Radicals formed from an initiator molecule.")
Declaration(Class(goldbook:14376))
AnnotationAssertion(rdfs:label goldbook:14376 "seed particle")
AnnotationAssertion(dcterms:description goldbook:14376 "Particle in a polymer colloid that is the locus of subsequent polymerization.")
Declaration(Class(goldbook:14377))
AnnotationAssertion(rdfs:label goldbook:14377 "surfmer")
AnnotationAssertion(dcterms:description goldbook:14377 "Monomer with the properties of a surfactant.")
Declaration(Class(goldbook:14378))
AnnotationAssertion(rdfs:label goldbook:14378 "inisurf")
AnnotationAssertion(dcterms:description goldbook:14378 "Initiator with the properties of a surfactant.")
Declaration(Class(goldbook:14379))
AnnotationAssertion(rdfs:label goldbook:14379 "transurf")
AnnotationAssertion(dcterms:description goldbook:14379 "Chain-transfer agent with the properties of a surfactant.")
Declaration(Class(goldbook:14380))
AnnotationAssertion(rdfs:label goldbook:14380 "breaking of an emulsion")
AnnotationAssertion(dcterms:description goldbook:14380 "Formation of a system with separate macrophases from an emulsion.")
Declaration(Class(goldbook:14381))
AnnotationAssertion(rdfs:label goldbook:14381 "critical coagulation concentration")
AnnotationAssertion(dcterms:description goldbook:14381 "Minimum concentration of electrolyte at and above which rapid coagulation occurs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14381 "critical coagulation amount concentration")
Declaration(Class(goldbook:14382))
AnnotationAssertion(rdfs:label goldbook:14382 "heterocoagulation")
AnnotationAssertion(dcterms:description goldbook:14382 "Coagulation of particles of different kinds or sizes, or both.")
Declaration(Class(goldbook:14383))
AnnotationAssertion(rdfs:label goldbook:14383 "homocoagulation")
AnnotationAssertion(dcterms:description goldbook:14383 "Coagulation of colloidal particles of the same size and kind.")
Declaration(Class(goldbook:14384))
AnnotationAssertion(rdfs:label goldbook:14384 "fast coagulation rate")
AnnotationAssertion(dcterms:description goldbook:14384 "Rate of coagulation in the absence of any repulsive barrier between particles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14384 "rapid coagulation rate")
Declaration(Class(goldbook:14385))
AnnotationAssertion(rdfs:label goldbook:14385 "fast coagulation rate coefficient")
AnnotationAssertion(dcterms:description goldbook:14385 "Rate coefficient for fast coagulation.")
Declaration(Class(goldbook:14387))
AnnotationAssertion(rdfs:label goldbook:14387 "flocculation rate coefficient")
AnnotationAssertion(dcterms:description goldbook:14387 "Rate coefficient for flocculation.")
Declaration(Class(goldbook:14388))
AnnotationAssertion(rdfs:label goldbook:14388 "micellisation")
AnnotationAssertion(dcterms:description goldbook:14388 "Process in which surface-active molecules or ions aggregate into micelles.")
Declaration(Class(goldbook:14389))
AnnotationAssertion(rdfs:label goldbook:14389 "orthokinetic coagulation")
AnnotationAssertion(dcterms:description goldbook:14389 "Coagulation due to collisions of particles induced by hydrodynamic motion.")
Declaration(Class(goldbook:14390))
AnnotationAssertion(rdfs:label goldbook:14390 "particle monolayer")
AnnotationAssertion(dcterms:description goldbook:14390 "Monolayer of particles deposited at an interface.")
Declaration(Class(goldbook:14391))
AnnotationAssertion(rdfs:label goldbook:14391 "perikinetic coagulation")
AnnotationAssertion(dcterms:description goldbook:14391 "Coagulation due to collisions of particles caused by their Brownian motion.")
Declaration(Class(goldbook:14392))
AnnotationAssertion(rdfs:label goldbook:14392 "slow coagulation rate")
AnnotationAssertion(dcterms:description goldbook:14392 "Rate of coagulation in presence of repulsive barriers between particles.")
Declaration(Class(goldbook:14393))
AnnotationAssertion(rdfs:label goldbook:14393 "slow coagulation rate coefficient")
AnnotationAssertion(dcterms:description goldbook:14393 "Rate coefficient for slow coagulation.")
Declaration(Class(goldbook:14394))
AnnotationAssertion(rdfs:label goldbook:14394 "stability ratio")
AnnotationAssertion(dcterms:description goldbook:14394 "Ratio \\(W = k_{\\rm{fast}}/k_{\\rm{slow}}\\) or \\(W = k_{\\rm{fast}}/k_{\\rm{floc}}\\), for coagulation or flocculation, respectively, with \\(k_{\\rm{fast}}\\), \\(k_{\\rm{slow}}\\), and \\(k_{\\rm{floc}}\\) measured under the same mixing (or hydrodynamic) conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14394 "Fuchs stability ratio")
Declaration(Class(goldbook:14395))
AnnotationAssertion(rdfs:label goldbook:14395 "colloidally stable system")
AnnotationAssertion(dcterms:description goldbook:14395 "System in which the particles essentially do not aggregate or sediment.")
Declaration(Class(goldbook:14396))
AnnotationAssertion(rdfs:label goldbook:14396 "electrostatic stabilisation")
AnnotationAssertion(dcterms:description goldbook:14396 "Stabilization of a colloid resulting from the mutual repulsion of the electrical double layers surrounding its particles.")
Declaration(Class(goldbook:14397))
AnnotationAssertion(rdfs:label goldbook:14397 "electrosteric stabilisation")
AnnotationAssertion(dcterms:description goldbook:14397 "Stabilization of a colloid that has both steric and electrostatic stabilization characteristics.")
Declaration(Class(goldbook:14398))
AnnotationAssertion(rdfs:label goldbook:14398 "steric stabilisation")
AnnotationAssertion(dcterms:description goldbook:14398 "Stabilization of a colloid resulting from covering particles with a layer of molecules solvated by the continuous medium.")
Declaration(Class(goldbook:14399))
AnnotationAssertion(rdfs:label goldbook:14399 "ecotoxicology")
AnnotationAssertion(dcterms:description goldbook:14399 "Study of the toxic effects of chemical and physical agents on all living organisms, especially on populations and communities within defined ecosystems; it includes transfer pathways of these agents and their interactions with the environment.")
Declaration(Class(goldbook:14400))
AnnotationAssertion(rdfs:label goldbook:14400 "mutagenicity")
AnnotationAssertion(dcterms:description goldbook:14400 "Ability of a physical, chemical, or biological agent to induce (or generate) heritable changes (mutations) in the genotype in a cell as a consequence of alterations or loss of genes or chromosomes (or parts thereof).")
Declaration(Class(goldbook:14401))
AnnotationAssertion(rdfs:label goldbook:14401 "ultrafine particle")
AnnotationAssertion(dcterms:description goldbook:14401 "Particle in air of aerodynamic diameter \\(\\pu{\\lt 0.1 \\upmu m}\\).")
Declaration(Class(goldbook:14402))
AnnotationAssertion(rdfs:label goldbook:14402 "toxicogenetics")
AnnotationAssertion(dcterms:description goldbook:14402 "Study of the influence of hereditary factors on the effects of potentially toxic substances on individual organisms.")
Declaration(Class(goldbook:14403))
AnnotationAssertion(rdfs:label goldbook:14403 "reproductive toxicity")
AnnotationAssertion(dcterms:description goldbook:14403 "Ability of a physical, chemical, or biological agent to induce adverse effects in the reproductive system.")
Declaration(Class(goldbook:14404))
AnnotationAssertion(rdfs:label goldbook:14404 "reproductive toxicology")
AnnotationAssertion(dcterms:description goldbook:14404 "Study of the non-heritable adverse effects of substances on male and female reproductive function or capacity and on resultant progeny.")
Declaration(Class(goldbook:14405))
AnnotationAssertion(rdfs:label goldbook:14405 "risk assessment management process")
AnnotationAssertion(dcterms:description goldbook:14405 "Global term for the whole process from hazard identification to risk management.")
Declaration(Class(goldbook:14406))
AnnotationAssertion(rdfs:label goldbook:14406 "risk management")
AnnotationAssertion(dcterms:description goldbook:14406 "Decision-making process involving considerations of political, social, economic, and engineering factors with relevant risk assessments relating to a potential hazard so as to develop, analyze, and compare regulatory options and to select the optimal regulatory response for safety from that hazard.")
Declaration(Class(goldbook:14407))
AnnotationAssertion(rdfs:label goldbook:14407 "safety")
AnnotationAssertion(dcterms:description goldbook:14407 "Reciprocal of risk: practical certainty that injury will not result from a hazard under defined conditions.")
Declaration(Class(goldbook:14408))
AnnotationAssertion(rdfs:label goldbook:14408 "safety data sheet")
AnnotationAssertion(dcterms:description goldbook:14408 "Single page giving toxicological and other safety advice, usually associated with a particular preparation, substance, process, use pattern, or exposure scenario.")
Declaration(Class(goldbook:14409))
AnnotationAssertion(rdfs:label goldbook:14409 "immunotoxicity")
AnnotationAssertion(dcterms:description goldbook:14409 "Ability of a physical, chemical, or biological agent to induce adverse effects in the immune system.")
Declaration(Class(goldbook:14410))
AnnotationAssertion(rdfs:label goldbook:14410 "dormant polymer chain")
AnnotationAssertion(dcterms:description goldbook:14410 "Temporarily deactivated chain carrier.")
Declaration(Class(goldbook:14411))
AnnotationAssertion(rdfs:label goldbook:14411 "reversible chain deactivation")
AnnotationAssertion(dcterms:description goldbook:14411 "Deactivation of a chain carrier in a chain polymerisation, reversibly converting the active center into an inactive one and then, within the lifetime of a growing macromolecule, regenerating an active center on the same original chain carrier.")
Declaration(Class(goldbook:14412))
AnnotationAssertion(rdfs:label goldbook:14412 "degenerate-transfer radical polymerisation")
AnnotationAssertion(dcterms:description goldbook:14412 "Controlled reversible-deactivation radical polymerization in which the deactivation of the radicals involves degenerative transfer (DT) of a group (or atom).")
Declaration(Class(goldbook:14413))
AnnotationAssertion(rdfs:label goldbook:14413 "absorbate")
AnnotationAssertion(dcterms:description goldbook:14413 "Substance that enters and is retained inside a solid or semisolid matrix (absorbent).")
Declaration(Class(goldbook:14414))
AnnotationAssertion(rdfs:label goldbook:14414 "absorbent")
AnnotationAssertion(dcterms:description goldbook:14414 "Solid or semisolid matrix that is able to accommodate and retain an absorbate.")
Declaration(Class(goldbook:14415))
AnnotationAssertion(rdfs:label goldbook:14415 "abundance")
AnnotationAssertion(dcterms:description goldbook:14415 """Total number of individual organisms in a population, seen over a defined period of time in a certain place.Note: For fish, an estimate of total weight may replace number.
Total number of organisms per unit of habitat space seen over a defined period.
Amount of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all elements in a given medium (e.g., the Earth’s crust).
Amount of an isotope of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all isotopes of the element.""")
Declaration(Class(goldbook:14416))
AnnotationAssertion(rdfs:label goldbook:14416 "abundant element")
AnnotationAssertion(dcterms:description goldbook:14416 "Element which is of common occurrence in the Earth’s crust.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14416 "abundant metal")
Declaration(Class(goldbook:14417))
AnnotationAssertion(rdfs:label goldbook:14417 "accessible")
AnnotationAssertion(dcterms:description goldbook:14417 "Capable of being entered or reached; easy of access; such as one can go to, come into the presence of, reach, or lay hold of; get-at-able.")
Declaration(Class(goldbook:14418))
AnnotationAssertion(rdfs:label goldbook:14418 "acclimatisation")
AnnotationAssertion(dcterms:description goldbook:14418 """Processes, including selection and adaptation, by which a population of microorganisms develops the ability to degrade a substance, or develops a tolerance to it.
In experimental systems, allowing an organism to adjust to its environment prior to undertaking a study.
Modification of biological processes or structures in the maintenance of homeostasis in response to change in some environmental quality such as temperature, salinity, light, radiation, or toxicant concentration. Note: It is an expression of phenotypic plasticity of individuals in response to a sublethal change in some environmental factor.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14418 "acclimatation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14418 "acclimation")
Declaration(Class(goldbook:14419))
AnnotationAssertion(rdfs:label goldbook:14419 "acid precipitation")
AnnotationAssertion(dcterms:description goldbook:14419 "Rain, fog, snow, sleet, or other particulate matter from the atmosphere with a _000078_ below \\(\\pu{5.6}\\) deposited from the air.")
Declaration(Class(goldbook:14420))
AnnotationAssertion(rdfs:label goldbook:14420 "acid-volatile sulfide")
AnnotationAssertion(dcterms:description goldbook:14420 "Soil- and sediment-associated solid-phase sulfides extractable with cold hydrochloric acid.")
Declaration(Class(goldbook:14421))
AnnotationAssertion(rdfs:label goldbook:14421 "acute")
AnnotationAssertion(dcterms:description goldbook:14421 """Of short duration, in relation to exposure or effect; the effect usually shows a rapid onset.
Note 1: In regulatory toxicology, 'acute' refers to studies where dosing is either single or limited to one day although the total study duration may extend to two weeks to permit appearance of toxicity in susceptible organ systems.
Note 2: In aquatic ecotoxicology, exposure of the test organisms is typically continuous and of four days or less.
In clinical medicine, sudden and severe, having a rapid onset.""")
Declaration(Class(goldbook:14422))
AnnotationAssertion(rdfs:label goldbook:14422 "acute-to-chronic toxicity ratio")
AnnotationAssertion(dcterms:description goldbook:14422 "Numerical dimensionless quantity that is the ratio of an acute toxicity test result (e.g., \\(\\pu{LC_{50}}\\)) to a chronic toxicity test result (e.g., maximum acceptable toxicant concentration, MATC) where both are expressed in the same units (e.g., \\(\\pu{mg L-1}\\)). Ideally, the data are for the same chemical species.")
Declaration(Class(goldbook:14423))
AnnotationAssertion(rdfs:label goldbook:14423 "additive effect")
AnnotationAssertion(dcterms:description goldbook:14423 "Consequence that follows exposure to two or more physicochemical agents that act jointly but do not interact: the total effect is the simple sum of the effects of separate exposures to the agents under the same conditions.")
Declaration(Class(goldbook:14424))
AnnotationAssertion(rdfs:label goldbook:14424 "additive index")
AnnotationAssertion(dcterms:description goldbook:14424 "Quantification of the joint action of toxicants in mixture by adding measures of their toxicity calculated in relation to the toxicity of a reference toxicant.")
Declaration(Class(goldbook:14425))
AnnotationAssertion(rdfs:label goldbook:14425 "adenylate energy charge")
AnnotationAssertion(dcterms:description goldbook:14425 "Index reflecting the balance of energy transfer between catabolic and anabolic processes, calculated from the equation \\[\\rm{AEC} = ([\\ce{ATP}] + ½[\\ce{ADP})/([\\ce{ATP}] + [\\ce{ADP}] + [\\ce{AMP}])\\] where \\(\\ce{ATP}\\), \\(\\ce{ADP}\\), and \\(\\ce{AMP}\\) are the amount concentrations of adenosine tri-, di-, and monophosphate, respectively.")
Declaration(Class(goldbook:14426))
AnnotationAssertion(rdfs:label goldbook:14426 "adsorption factor")
AnnotationAssertion(dcterms:description goldbook:14426 "Ratio of the amount of substance adsorbed at the interface of a condensed layer and a liquid or gaseous phase to the total amount of the substance available for adsorption.")
Declaration(Class(goldbook:14427))
AnnotationAssertion(rdfs:label goldbook:14427 "age class")
AnnotationAssertion(dcterms:description goldbook:14427 "Group of organisms of the same age within a population.")
Declaration(Class(goldbook:14428))
AnnotationAssertion(rdfs:label goldbook:14428 "age composition")
AnnotationAssertion(dcterms:description goldbook:14428 "Distribution of organisms among the various age classes present in the population. The sum of the number of individuals in all age classes equals the population size.")
Declaration(Class(goldbook:14429))
AnnotationAssertion(rdfs:label goldbook:14429 "age distribution")
AnnotationAssertion(dcterms:description goldbook:14429 "Composition of a population in terms of how its abundance is distributed across age classes.")
Declaration(Class(goldbook:14430))
AnnotationAssertion(rdfs:label goldbook:14430 "age-specific death rate")
AnnotationAssertion(dcterms:description goldbook:14430 "Mean number of deaths as tabulated for a life table interval or for a specific age class in a given year, expressed per \\(\\pu{1000}\\) in that interval or age class.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14430 "age-specific mortality")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14430 "age-specific number of individuals dying")
Declaration(Class(goldbook:14431))
AnnotationAssertion(rdfs:label goldbook:14431 "aggregation error")
AnnotationAssertion(dcterms:description goldbook:14431 "Error in Bayesian probability analysis of model systems resulting from the use of a single set of parameters to represent a collection of distinct entities, such as individuals, in a population.")
Declaration(Class(goldbook:14432))
AnnotationAssertion(rdfs:label goldbook:14432 "air pollution tolerance index")
AnnotationAssertion(dcterms:description goldbook:14432 "Empirical index used to assess the tolerance of individual plants to contaminated air. The numerical value of \\(T_{\\rm{I}}\\) is obtained by combining various quantities according to the recipe \\([A (T + P) + R]/10\\), where \\(A\\) is the mass of ascorbic acid divided by the dry mass of a leaf, expressed as \\(\\pu{mg/g}\\), \\(T\\) is the total mass of chlorophyll divided by the fresh mass, expressed as \\(\\pu{mg/g}\\), \\(P\\) is the pH of a leaf extract, and \\(R\\) is the mass of water in the leaf divided by the wet mass, expressed as percent.")
Declaration(Class(goldbook:14433))
AnnotationAssertion(rdfs:label goldbook:14433 "alga")
AnnotationAssertion(dcterms:description goldbook:14433 "Any of various chiefly aquatic, eukaryotic, photosynthetic organisms, ranging in size from single-celled forms to the giant kelp.")
Declaration(Class(goldbook:14434))
AnnotationAssertion(rdfs:label goldbook:14434 "algal bloom")
AnnotationAssertion(dcterms:description goldbook:14434 "Rapid increase in the abundance of phytoplankton or benthic algae in a given area, often as a result of an increased availability of nutrients or light, or increase in temperature (e.g., the spring bloom).")
Declaration(Class(goldbook:14435))
AnnotationAssertion(rdfs:label goldbook:14435 "algicide")
AnnotationAssertion(dcterms:description goldbook:14435 "Substance intended to kill algae.")
Declaration(Class(goldbook:14436))
AnnotationAssertion(rdfs:label goldbook:14436 "algistatic")
AnnotationAssertion(dcterms:description goldbook:14436 "Inhibiting algal population growth.")
Declaration(Class(goldbook:14437))
AnnotationAssertion(rdfs:label goldbook:14437 "allogenic succession")
AnnotationAssertion(dcterms:description goldbook:14437 "Sequential appearance of species driven by external influences that alter local conditions; e.g., silt deposits changing a marshland to woodland.")
Declaration(Class(goldbook:14438))
AnnotationAssertion(rdfs:label goldbook:14438 "ambient")
AnnotationAssertion(dcterms:description goldbook:14438 "Surrounding (applied to environmental media such as air, water, sediment, or soil).")
Declaration(Class(goldbook:14439))
AnnotationAssertion(rdfs:label goldbook:14439 "ambient monitoring")
AnnotationAssertion(dcterms:description goldbook:14439 "Continuous or repeated measurement of agents in the environment to evaluate ambient exposure and health risk by comparison with appropriate reference values based on knowledge of the probable relationship between exposure and resultant adverse health effects.")
Declaration(Class(goldbook:14440))
AnnotationAssertion(rdfs:label goldbook:14440 "anadromous")
AnnotationAssertion(dcterms:description goldbook:14440 "Showing anadromy.")
Declaration(Class(goldbook:14441))
AnnotationAssertion(rdfs:label goldbook:14441 "anadromy")
AnnotationAssertion(dcterms:description goldbook:14441 "Life-history pattern that is characterized by egg incubation and early juvenile development in freshwater, migration to seawater for adult development, and a return to freshwater for spawning.")
Declaration(Class(goldbook:14442))
AnnotationAssertion(rdfs:label goldbook:14442 "analysis plan")
AnnotationAssertion(dcterms:description goldbook:14442 "Scheme that defines the exact format and design of the assessment, explicitly states the data needed, and describes the methods and design for analyzing these data.")
Declaration(Class(goldbook:14443))
AnnotationAssertion(rdfs:label goldbook:14443 "anthropogenic")
AnnotationAssertion(dcterms:description goldbook:14443 """Caused by or influenced by human activities.
Describing a conversion factor used to calculate a dose or concentration affecting a human that has been derived from data obtained with another species, e.g., the rat.""")
Declaration(Class(goldbook:14444))
AnnotationAssertion(rdfs:label goldbook:14444 "antisymmetry")
AnnotationAssertion(dcterms:description goldbook:14444 "Quality of a population of bilaterally symmetrical individuals in which the difference in measurement of a trait made from the right and left sides of individuals from that population produces a bimodal distribution.")
Declaration(Class(goldbook:14445))
AnnotationAssertion(rdfs:label goldbook:14445 "arcsine square root transformation")
AnnotationAssertion(dcterms:description goldbook:14445 "\\(\\arcsin \\sqrt{P}\\), where \\(P\\) is the value of a measured effect, e.g., the proportion of exposed organisms in a population.")
Declaration(Class(goldbook:14446))
AnnotationAssertion(rdfs:label goldbook:14446 "artificial soil test")
AnnotationAssertion(dcterms:description goldbook:14446 "Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by adding the earthworms to an artificial soil made of sand, clay mineral, and peat, containing the substance of concern.")
Declaration(Class(goldbook:14447))
AnnotationAssertion(rdfs:label goldbook:14447 "artisol test")
AnnotationAssertion(dcterms:description goldbook:14447 "Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by placing the worms in an artificial substrate consisting of silica, water, and glass balls, containing the substance of concern.")
Declaration(Class(goldbook:14448))
AnnotationAssertion(rdfs:label goldbook:14448 "aryl hydrocarbon hydroxylase")
AnnotationAssertion(dcterms:description goldbook:14448 "Enzyme activity attributed to cytochrome P-450 monooxygenase isoforms and often measured in units of benzo[a]pyrene hydroxylation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14448 "unspecific mono-oxygenase")
Declaration(Class(goldbook:14449))
AnnotationAssertion(rdfs:label goldbook:14449 "as low as reasonably achievable")
AnnotationAssertion(dcterms:description goldbook:14449 "Describing the situation in which everything practicable is done to reduce risks to the minimum with the approval of the regulatory authorities.")
Declaration(Class(goldbook:14450))
AnnotationAssertion(rdfs:label goldbook:14450 "assemblage")
AnnotationAssertion(dcterms:description goldbook:14450 "Set of coexisting populations defined by phylogeny, location, or life style. Assemblages are intermediate between populations and communities.")
Declaration(Class(goldbook:14451))
AnnotationAssertion(rdfs:label goldbook:14451 "assessment endpoint")
AnnotationAssertion(dcterms:description goldbook:14451 "Ecological property that is to be protected and the precise parameter to be measured for this property.")
Declaration(Class(goldbook:14452))
AnnotationAssertion(rdfs:label goldbook:14452 "Association Française de Normalisation test")
AnnotationAssertion(dcterms:description goldbook:14452 "Commercially available test kit, certified by AFNOR as valid and equivalent to a standardized method.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14452 "AFNOR test")
Declaration(Class(goldbook:14453))
AnnotationAssertion(rdfs:label goldbook:14453 "asymptotic threshold concentration")
AnnotationAssertion(dcterms:description goldbook:14453 "Concentration of a chemical at which some percentage of a population of test organisms is in a state of approximate homeostasis for a prolonged period of time (\\(\\pu{48 h}\\) or more).")
Declaration(Class(goldbook:14454))
AnnotationAssertion(rdfs:label goldbook:14454 "atmospheric deposition")
AnnotationAssertion(dcterms:description goldbook:14454 "Process that transfers a chemical from the atmosphere to the Earth’s surface (land, water, or vegetation) by either dry impingement or by transport in rain or snow.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14454 "deposition")
Declaration(Class(goldbook:14456))
AnnotationAssertion(rdfs:label goldbook:14456 "aufwuchs")
AnnotationAssertion(dcterms:description goldbook:14456 "Floral and (or) or faunal communities attached to submerged surfaces in aquatic ecosystems.")
Declaration(Class(goldbook:14457))
AnnotationAssertion(rdfs:label goldbook:14457 "autogenic succession")
AnnotationAssertion(dcterms:description goldbook:14457 "Sequential appearance of species driven by processes operating within the community environment (compare allogenic succession), e.g., primary and secondary successions that occur on newly exposed land.")
Declaration(Class(goldbook:14458))
AnnotationAssertion(rdfs:label goldbook:14458 "autotroph")
AnnotationAssertion(dcterms:description goldbook:14458 "Organism that is independent of outside sources for organic food materials and manufactures its own organic material from inorganic sources.")
Declaration(Class(goldbook:14459))
AnnotationAssertion(rdfs:label goldbook:14459 "autotrophic succession")
AnnotationAssertion(dcterms:description goldbook:14459 "Sequential appearance of species in a location principally involving plants.")
Declaration(Class(goldbook:14460))
AnnotationAssertion(rdfs:label goldbook:14460 "axenic culture")
AnnotationAssertion(dcterms:description goldbook:14460 "Growth of organisms of a single species in the absence of cells or living organisms of any other species.")
Declaration(Class(goldbook:14461))
AnnotationAssertion(rdfs:label goldbook:14461 "baseline toxicity")
AnnotationAssertion(dcterms:description goldbook:14461 "General, nonspecific, reversible mode of toxic action that can be produced in most living organisms by the presence of sufficient amounts of many organic chemicals.")
Declaration(Class(goldbook:14462))
AnnotationAssertion(rdfs:label goldbook:14462 "Bayesian")
AnnotationAssertion(dcterms:description goldbook:14462 "Attributed to Thomas Bayes (1702–1761), English mathematician. The term is used to designate concepts relating to inverse probability, especially Bayes’ theorem, a theorem expressing the probability of one of a number of mutually exclusive events \\(H_{\\rm{i}}\\), given some other event \\(E\\), in terms of the probabilities of all the \\(H_{\\rm{i}}\\) independently of \\(E\\) and the probabilities of \\(E\\) given each \\(H_{\\rm{i}}\\).")
Declaration(Class(goldbook:14463))
AnnotationAssertion(rdfs:label goldbook:14463 "Bayesian probability")
AnnotationAssertion(dcterms:description goldbook:14463 "Subjective or objective concept of probability as a 'measure of the state of knowledge'.")
Declaration(Class(goldbook:14464))
AnnotationAssertion(rdfs:label goldbook:14464 "behavioural teratology")
AnnotationAssertion(dcterms:description goldbook:14464 "Study of behavioral abnormalities in otherwise apparently normal individuals after exposure in the embryonic state to a substance or physical agent.")
Declaration(Class(goldbook:14465))
AnnotationAssertion(rdfs:label goldbook:14465 "behavioural toxicology")
AnnotationAssertion(dcterms:description goldbook:14465 "Study of abnormal behavior produced by exposure to a substance or physical agent.")
Declaration(Class(goldbook:14466))
AnnotationAssertion(rdfs:label goldbook:14466 "beneficial metal")
AnnotationAssertion(dcterms:description goldbook:14466 "Non-essential metal which in some form (chemical species) at an appropriate dose can improve health of defined organisms, commonly human beings.")
Declaration(Class(goldbook:14467))
AnnotationAssertion(rdfs:label goldbook:14467 "benefit")
AnnotationAssertion(dcterms:description goldbook:14467 "Advantage to, or improvement in condition of, an individual, a population, a species, an assemblage, a community, or an ecosystem.")
Declaration(Class(goldbook:14468))
AnnotationAssertion(rdfs:label goldbook:14468 "benthic")
AnnotationAssertion(dcterms:description goldbook:14468 "Living on the bottom of an aquatic system.")
Declaration(Class(goldbook:14469))
AnnotationAssertion(rdfs:label goldbook:14469 "bioaccessible")
AnnotationAssertion(dcterms:description goldbook:14469 "Able to come in contact with a living organism and perhaps interact with it with the possibility of absorption into the organism.")
Declaration(Class(goldbook:14470))
AnnotationAssertion(rdfs:label goldbook:14470 "bioaccumulation")
AnnotationAssertion(dcterms:description goldbook:14470 "Progressive increase in the amount of a substance in an organism or part of an organism that occurs because the rate of intake from all contributing sources and by all possible routes exceeds the organism’s ability to eliminate the substance from its body.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14470 "accumulation in biology")
Declaration(Class(goldbook:14471))
AnnotationAssertion(rdfs:label goldbook:14471 "bioaccumulation factor")
AnnotationAssertion(dcterms:description goldbook:14471 "Ratio of tissue chemical residue to chemical concentration in an external environmental phase (e.g., sediment, water, soil, air, or food). BAF is measured at a steady state in situations where organisms are exposed to multiple sources (e.g., water, sediment, food), unless noted otherwise.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14471 "accumulation factor")
Declaration(Class(goldbook:14472))
AnnotationAssertion(rdfs:label goldbook:14472 "bioactivation")
AnnotationAssertion(dcterms:description goldbook:14472 "Metabolic conversion of a xenobiotic to a more toxic derivative or to one that has more of an effect on living organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14472 "activation")
Declaration(Class(goldbook:14473))
AnnotationAssertion(rdfs:label goldbook:14473 "bioavailable")
AnnotationAssertion(dcterms:description goldbook:14473 "Able to be absorbed by living organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14473 "available")
Declaration(Class(goldbook:14474))
AnnotationAssertion(rdfs:label goldbook:14474 "biocenosis")
AnnotationAssertion(dcterms:description goldbook:14474 "All the interacting organisms living together in a specified habitat.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "biocoenosis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "biological community")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "biotic community")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14474 "ecological community")
Declaration(Class(goldbook:14475))
AnnotationAssertion(rdfs:label goldbook:14475 "biocide")
AnnotationAssertion(dcterms:description goldbook:14475 """Substance intended to kill living organisms.
Nonagricultural pesticide used to control the severity and incidence of pests or diseases, e.g., algicide, slimicide, or disinfectant for the control of algal, fungal, or bacterial growth.""")
Declaration(Class(goldbook:14476))
AnnotationAssertion(rdfs:label goldbook:14476 "bioconcentration")
AnnotationAssertion(dcterms:description goldbook:14476 "Process leading to a higher concentration of a substance in an organism than in environmental media to which it is exposed.")
Declaration(Class(goldbook:14477))
AnnotationAssertion(rdfs:label goldbook:14477 "bioconcentration factor")
AnnotationAssertion(dcterms:description goldbook:14477 "Measure of the tendency for a substance in water to accumulate in aquatic organisms defined as the ratio of the concentration of the substance of concern in the organism to the concentration in water at equilibrium.")
Declaration(Class(goldbook:14478))
AnnotationAssertion(rdfs:label goldbook:14478 "lipid-based bioconcentration factor")
AnnotationAssertion(dcterms:description goldbook:14478 "Ratio of the concentration of the substance of concern in the lipid fraction of the test organism to the concentration in the ambient water.")
Declaration(Class(goldbook:14479))
AnnotationAssertion(rdfs:label goldbook:14479 "biodiversity")
AnnotationAssertion(dcterms:description goldbook:14479 "Occurrence of a number of species within a given ecosystem or biome, or the presence of a number of community types in a given area.")
Declaration(Class(goldbook:14480))
AnnotationAssertion(rdfs:label goldbook:14480 "biodiversity action plan")
AnnotationAssertion(dcterms:description goldbook:14480 "Internationally recognized program designed to protect and restore biological systems containing threatened species and habitats.")
Declaration(Class(goldbook:14481))
AnnotationAssertion(rdfs:label goldbook:14481 "biogeochemical cycle")
AnnotationAssertion(dcterms:description goldbook:14481 "Movement of elements or molecules among organisms and nonliving compartments of the atmosphere, lithosphere, and hydrosphere.")
Declaration(Class(goldbook:14482))
AnnotationAssertion(rdfs:label goldbook:14482 "biological indicator")
AnnotationAssertion(dcterms:description goldbook:14482 "Any biological species or group of species whose performance, abundance, or population status is used to determine the health of an environment or ecosystem by systematic monitoring of chemical, physiological, or behavioral changes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14482 "bioindicator")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14482 "indicator species")
Declaration(Class(goldbook:14483))
AnnotationAssertion(rdfs:label goldbook:14483 "biological determinant")
AnnotationAssertion(dcterms:description goldbook:14483 "Property of living organisms that affects human or environmental health.")
Declaration(Class(goldbook:14484))
AnnotationAssertion(rdfs:label goldbook:14484 "biomagnification")
AnnotationAssertion(dcterms:description goldbook:14484 """Sequence of processes by which higher concentrations of a substance are attained in organisms at higher trophic levels.
Result of these processes of bioconcentration and bioaccumulation by which tissue concentrations of bioaccumulated chemicals increase as the chemical passes up through two or more trophic levels.
Note: Biomagnification occurs in a food chain as a consequence of efficient transfer of a substance from food to consumer accompanied by the lack of, or very slow, excretion or degradation of the substance.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14484 "bioamplification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14484 "ecological magnification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14484 "trophic enrichment")
Declaration(Class(goldbook:14485))
AnnotationAssertion(rdfs:label goldbook:14485 "biomagnification factor")
AnnotationAssertion(dcterms:description goldbook:14485 "Ratio of concentrations of a compound at two consecutive trophic levels at steady state. It can also be expressed in terms of a rate constant-based bioaccumulation model \\[B = C_{n}/C_{n-1} = \\alpha f/k_{\\rm{e}}\\] where \\(\\alpha\\) is assimilation efficiency, \\(f\\) is feeding rate, and \\(k_{\\rm{e}}\\) is the first-order elimination constant. \\(B\\) can be calculated from field data on assumed trophic relations or from laboratory feeding experiments.")
Declaration(Class(goldbook:14486))
AnnotationAssertion(rdfs:label goldbook:14486 "biomarker of effect")
AnnotationAssertion(dcterms:description goldbook:14486 "Biomarker that, depending upon the magnitude, can be recognized as associated with an established or possible health impairment or disease.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14486 "effect biomarker")
Declaration(Class(goldbook:14487))
AnnotationAssertion(rdfs:label goldbook:14487 "biomarker of exposure")
AnnotationAssertion(dcterms:description goldbook:14487 "Biomarker that relates exposure to a xenobiotic to the levels of the substance or its metabolite, or of the product of an interaction between the substance and some target molecule or cell, that can be measured in a compartment within an organism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14487 "exposure biomarker")
Declaration(Class(goldbook:14488))
AnnotationAssertion(rdfs:label goldbook:14488 "biomarker of susceptibility")
AnnotationAssertion(dcterms:description goldbook:14488 "Biomarker of an inherent or acquired ability of an organism to respond to exposure to a specific substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14488 "susceptibility biomarker")
Declaration(Class(goldbook:14489))
AnnotationAssertion(rdfs:label goldbook:14489 "biome")
AnnotationAssertion(dcterms:description goldbook:14489 "Set of plants and animals that occupy a certain geographic area.")
Declaration(Class(goldbook:14490))
AnnotationAssertion(rdfs:label goldbook:14490 "biomodification")
AnnotationAssertion(dcterms:description goldbook:14490 "Alteration of the chemical or physical properties of a substance by the action of living organisms.")
Declaration(Class(goldbook:14491))
AnnotationAssertion(rdfs:label goldbook:14491 "biomonitor")
AnnotationAssertion(dcterms:description goldbook:14491 """n. Organism that provides quantitative information on the quality of the environment around it.Note: The ideal substance biomonitor would indicate the presence of a specific pollutant and provide additional information about the amount present.
v. To use organisms to monitor pollutants and to deduce possible effects on biota or routes of toxicant exposure to humans.""")
Declaration(Class(goldbook:14492))
AnnotationAssertion(rdfs:label goldbook:14492 "biomonitoring type 1")
AnnotationAssertion(dcterms:description goldbook:14492 "Determination of community changes along a gradient or among sites differing in levels of pollution.")
Declaration(Class(goldbook:14493))
AnnotationAssertion(rdfs:label goldbook:14493 "biomonitoring type 2")
AnnotationAssertion(dcterms:description goldbook:14493 "Determination of bioaccumulation in organisms among sites notionally varying in the level of contamination.")
Declaration(Class(goldbook:14494))
AnnotationAssertion(rdfs:label goldbook:14494 "biomonitoring type 3")
AnnotationAssertion(dcterms:description goldbook:14494 "Determination of effects on organisms using tools such as biochemical markers in sentinel species or some measure of diminished fitness or condition of individuals.")
Declaration(Class(goldbook:14495))
AnnotationAssertion(rdfs:label goldbook:14495 "biomonitoring type 4")
AnnotationAssertion(dcterms:description goldbook:14495 "Determination of genetically based resistance in populations of contaminated areas.")
Declaration(Class(goldbook:14496))
AnnotationAssertion(rdfs:label goldbook:14496 "biopesticide")
AnnotationAssertion(dcterms:description goldbook:14496 "Biological agent with pesticidal activity, e.g., the bacterium Bacillus thuringiensis when used to kill insects.")
Declaration(Class(goldbook:14497))
AnnotationAssertion(rdfs:label goldbook:14497 "bioremediation")
AnnotationAssertion(dcterms:description goldbook:14497 "Use of biological organisms such as plants or microbes to aid in removing hazardous substances from an area.")
Declaration(Class(goldbook:14498))
AnnotationAssertion(rdfs:label goldbook:14498 "biota-sediment accumulation factor")
AnnotationAssertion(dcterms:description goldbook:14498 "Ratio of lipid-normalized tissue chemical residue to carbon-normalized sediment substance concentration (units of mass lipid/mass organic carbon).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14498 "accumulation factor (AF)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14498 "bioavailability index (BI)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14498 "biota-sediment factor (BSF)")
Declaration(Class(goldbook:14499))
AnnotationAssertion(rdfs:label goldbook:14499 "biotic index")
AnnotationAssertion(dcterms:description goldbook:14499 "One of several ranking systems calculated from the presence or abundance of sensitive species relative to tolerant species.")
Declaration(Class(goldbook:14500))
AnnotationAssertion(rdfs:label goldbook:14500 "biotic ligand")
AnnotationAssertion(dcterms:description goldbook:14500 "Component of a living organism to which an ion or other substance in aqueous solution can bind, usually with subsequent beneficial or harmful effect on the physiology of the organism.")
Declaration(Class(goldbook:14501))
AnnotationAssertion(rdfs:label goldbook:14501 "biotic ligand model")
AnnotationAssertion(dcterms:description goldbook:14501 "Model that integrates the interactions of metals with ligands in water to calculate the speciation (based on hardness, salinity, and presence of other metals) and the concentration of ionic species producing toxicity. The BLM chemically and mathematically models the organism’s target site as ligand(s) competing with nonbiotic ligands, based on the concept that toxicity occurs when a metal-(biotic ligand) complex reaches a critical concentration.")
Declaration(Class(goldbook:14502))
AnnotationAssertion(rdfs:label goldbook:14502 "biotic score")
AnnotationAssertion(dcterms:description goldbook:14502 "Weighted measurement of organisms present—the weighted part is determined by each group’s pollution tolerance or intolerance. As pollution increases in a stream, the biotic score value tends to increase.")
Declaration(Class(goldbook:14503))
AnnotationAssertion(rdfs:label goldbook:14503 "biotope")
AnnotationAssertion(dcterms:description goldbook:14503 "Habitat shared by many species, most often an area that is uniform in environmental conditions and in its distribution of animal and plant life.")
Declaration(Class(goldbook:14504))
AnnotationAssertion(rdfs:label goldbook:14504 "bioturbation")
AnnotationAssertion(dcterms:description goldbook:14504 "Group of processes whereby organisms affect the structure of sediment.")
Declaration(Class(goldbook:14505))
AnnotationAssertion(rdfs:label goldbook:14505 "biphasic dose–effect model")
AnnotationAssertion(dcterms:description goldbook:14505 """Model of adverse effect vs. dose relationship that, owing to hormesis, dips down from the control level before increasing with the dose; individuals exposed to low, but nontoxic concentrations are healthier than individuals not exposed to the chemical.Note: Biphasic dose–effect curves occur for any nutrient. Hormesis is a phenomenon associated with compounds that have no nutrient properties.
Model of adverse effect vs. dose relationship that changes slope owing to a change in the mechanism of toxic action.Note: This may, e.g., be due to saturation of a transport or metabolic system.""")
Declaration(Class(goldbook:14506))
AnnotationAssertion(rdfs:label goldbook:14506 "birth rate")
AnnotationAssertion(dcterms:description goldbook:14506 """(in demography) Number of live births in a defined administrative jurisdiction in a calendar year divided by a midyear population of the jurisdiction, with the customary multiplier of \\(\\pu{1000}\\) to produce a whole number rather than a decimal or a fraction. Note: An alternative statistic is total fertility rate, the average number of children born to each woman over the course of her life. In general, the total fertility rate is a better indicator of fertility rates because, unlike the crude birth rate, it is not affected by the age distribution of the population.
(in ecology) Number of births, \\(B\\), in a population of a defined size, \\(N\\), during a specified time interval \\(\\Delta t\\). The rate is calculated from the formula \\[B = \\Delta N/\\Delta t\\] where \\(\\Delta N\\) is the change in the number of births in a limited time period \\(\\Delta t\\).""")
Declaration(Class(goldbook:14507))
AnnotationAssertion(rdfs:label goldbook:14507 "boomerang effect")
AnnotationAssertion(dcterms:description goldbook:14507 "Delayed damage from earlier environmental contamination.")
Declaration(Class(goldbook:14508))
AnnotationAssertion(rdfs:label goldbook:14508 "borderline metal ions")
AnnotationAssertion(dcterms:description goldbook:14508 "Metal ions intermediate in properties between class a and class b metal ions.")
Declaration(Class(goldbook:14509))
AnnotationAssertion(rdfs:label goldbook:14509 "bottom-up ecotoxicological study")
AnnotationAssertion(dcterms:description goldbook:14509 "Approach to investigating ecotoxicological effects that starts with a determination of the presence and nature of any adverse effects via responses at the suborganismal (cellular and biochemical) levels of organization rather than via the community and (or) ecosystem levels of organization.")
Declaration(Class(goldbook:14510))
AnnotationAssertion(rdfs:label goldbook:14510 "Brillouin index")
AnnotationAssertion(dcterms:description goldbook:14510 "Quantitative value for community species diversity calculated as \\[H_{\\rm{B}} = (\\ln N! - \\sum \\ln n_{i}!)/N\\] where \\(N\\) is the total number of individuals and \\(n_{i}\\) is the number of individuals in the \\(i^{\\rm{th}}\\) species.")
Declaration(Class(goldbook:14511))
AnnotationAssertion(rdfs:label goldbook:14511 "broodstock")
AnnotationAssertion(dcterms:description goldbook:14511 "Adult fish producing either eggs or sperm.")
Declaration(Class(goldbook:14512))
AnnotationAssertion(rdfs:label goldbook:14512 "calcinosis")
AnnotationAssertion(dcterms:description goldbook:14512 "Any pathological condition characterized by the deposition of calcium salts in tissues.")
Declaration(Class(goldbook:14513))
AnnotationAssertion(rdfs:label goldbook:14513 "calcium sink")
AnnotationAssertion(dcterms:description goldbook:14513 "Tissue such as arthropod cuticle, bivalve shell, or vertebrate bone that renders calcium or elements with similar biological behavior (such as lead or cadmium) less bioavailable during trophic interactions, thus providing a mechanism for trophic dilution.")
Declaration(Class(goldbook:14514))
AnnotationAssertion(rdfs:label goldbook:14514 "carrying capacity")
AnnotationAssertion(dcterms:description goldbook:14514 "Maximum population size expressed as total number of individuals, biomass, or population density that a given unit of habitat is capable of sustaining.")
Declaration(Class(goldbook:14515))
AnnotationAssertion(rdfs:label goldbook:14515 "catadromous")
AnnotationAssertion(dcterms:description goldbook:14515 "Describing a species exhibiting catadromy.")
Declaration(Class(goldbook:14516))
AnnotationAssertion(rdfs:label goldbook:14516 "catadromy")
AnnotationAssertion(dcterms:description goldbook:14516 "Life-history pattern that is characterized by egg incubation and early juvenile development in seawater, migration to freshwater for adult development, and return to seawater for spawning.")
Declaration(Class(goldbook:14517))
AnnotationAssertion(rdfs:label goldbook:14517 "catagenesis")
AnnotationAssertion(dcterms:description goldbook:14517 "Long-term geochemical alteration to organic matter, involving high temperatures and pressures deep below the surface of the Earth.")
Declaration(Class(goldbook:14518))
AnnotationAssertion(rdfs:label goldbook:14518 "cetaceans")
AnnotationAssertion(dcterms:description goldbook:14518 "Whales, dolphins, and porpoises, in the order Cetacea.")
Declaration(Class(goldbook:14519))
AnnotationAssertion(rdfs:label goldbook:14519 "Chapman mechanism")
AnnotationAssertion(dcterms:description goldbook:14519 "Series of reactions by which ozone is formed in the stratosphere.")
Declaration(Class(goldbook:14520))
AnnotationAssertion(rdfs:label goldbook:14520 "chemical time bomb")
AnnotationAssertion(dcterms:description goldbook:14520 "Substance or substances in a component of the environment which are not currently bioavailable but which may become bioavailable at an unknown time in the future with harmful consequences.")
Declaration(Class(goldbook:14521))
AnnotationAssertion(rdfs:label goldbook:14521 "chloride cell")
AnnotationAssertion(dcterms:description goldbook:14521 "Specialized cell with a role in ion regulation, characterized by large numbers of mitochondria, an extensive intracellular tubular network and a high concentration of \\(\\ce{Na+}\\)/\\(\\ce{K+}\\) ATPase. This cell is found in salt-secreting glands like the rectal gland of elasmobranchs, the nasal gland of seabirds, and the gills of both seawater and freshwater fish, mainly on the primary lamellae but also on the secondary lamellae.")
Declaration(Class(goldbook:14522))
AnnotationAssertion(rdfs:label goldbook:14522 "chlorinity")
AnnotationAssertion(dcterms:description goldbook:14522 "Proportion by mass of dissolved chloride ions in water.")
Declaration(Class(goldbook:14523))
AnnotationAssertion(rdfs:label goldbook:14523 "chlorofluorocarbon")
AnnotationAssertion(dcterms:description goldbook:14523 "Carbon-based chemical containing chlorine and fluorine, responsible for ozone depletion in the stratosphere.")
Declaration(Class(goldbook:14524))
AnnotationAssertion(rdfs:label goldbook:14524 "chronic effect")
AnnotationAssertion(dcterms:description goldbook:14524 "Consequence that develops slowly and (or) has a long-lasting course: may be applied to an effect which develops rapidly and is long lasting.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14524 "long-term effect")
Declaration(Class(goldbook:14525))
AnnotationAssertion(rdfs:label goldbook:14525 "chlorosis")
AnnotationAssertion(dcterms:description goldbook:14525 "Loss of green color in plants owing to the lack of production or the destruction of chlorophyll.")
Declaration(Class(goldbook:14526))
AnnotationAssertion(rdfs:label goldbook:14526 "cladistics")
AnnotationAssertion(dcterms:description goldbook:14526 "Systematic classification of groups of organisms on the basis of shared characteristics thought to derive from a common ancestor. Also, the study of the branching of evolutionary lines of descent and the relationship between branches.")
Declaration(Class(goldbook:14527))
AnnotationAssertion(rdfs:label goldbook:14527 "cladogram")
AnnotationAssertion(dcterms:description goldbook:14527 "Dendrogram illustrating the supposed evolutionary relationships between clades; a diagram showing cladistic relationships.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14527 "evolutionary tree")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14527 "phylogenetic tree")
Declaration(Class(goldbook:14528))
AnnotationAssertion(rdfs:label goldbook:14528 "climax community")
AnnotationAssertion(dcterms:description goldbook:14528 "Community of plants and animals in a steady state due to ecological succession resulting in a composition of the community best adapted to average conditions in the area. The term is sometimes applied to soil development.")
Declaration(Class(goldbook:14529))
AnnotationAssertion(rdfs:label goldbook:14529 "cold condensation theory")
AnnotationAssertion(dcterms:description goldbook:14529 "Theory that pollutants with high vapor pressure, e.g., mercury or persistent organic pollutants (POPs), in the air will condense onto soil, water, and biota at cool temperatures. Consequently, the ratios for POP concentrations in the air and on condensed phases decrease as one moves from warmer to cooler climates.")
Declaration(Class(goldbook:14530))
AnnotationAssertion(rdfs:label goldbook:14530 "cometabolism")
AnnotationAssertion(dcterms:description goldbook:14530 "Microbial transformation of a compound (that is normally unable to support cell replication) in the requisite presence of a transformable cosubstrate that supports cell replication.")
Declaration(Class(goldbook:14531))
AnnotationAssertion(rdfs:label goldbook:14531 "community")
AnnotationAssertion(dcterms:description goldbook:14531 "Assembly of populations of different species of living organisms, usually interdependent on and interacting with each other, within a specified location in space and time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14531 "biocommunity")
Declaration(Class(goldbook:14532))
AnnotationAssertion(rdfs:label goldbook:14532 "community conditioning hypothesis")
AnnotationAssertion(dcterms:description goldbook:14532 "Hypothesis that ecological communities retain information about events in their history and will not return to their original state after perturbation.")
Declaration(Class(goldbook:14533))
AnnotationAssertion(rdfs:label goldbook:14533 "community stability")
AnnotationAssertion(dcterms:description goldbook:14533 "Tendency of a community to return to its original state after a disturbance (competition, temporarily changing environment, etc.).")
Declaration(Class(goldbook:14534))
AnnotationAssertion(rdfs:label goldbook:14534 "community resilience")
AnnotationAssertion(dcterms:description goldbook:14534 "Ability of a community to return to its former state after perturbation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14534 "ecological resilience")
Declaration(Class(goldbook:14535))
AnnotationAssertion(rdfs:label goldbook:14535 "community resistance")
AnnotationAssertion(dcterms:description goldbook:14535 "Ability of a community to avoid displacement from its present state by a disturbance.")
Declaration(Class(goldbook:14536))
AnnotationAssertion(rdfs:label goldbook:14536 "community structure")
AnnotationAssertion(dcterms:description goldbook:14536 "Species present in a community and their relative abundances.")
Declaration(Class(goldbook:14537))
AnnotationAssertion(rdfs:label goldbook:14537 "compartment")
AnnotationAssertion(dcterms:description goldbook:14537 """Conceptualized part of the body (organs, tissues, cells, or fluids) considered as an independent system for purposes of modeling and assessment of distribution and clearance of a substance.
Part of an ecosystem considered as an independent system for purposes of assessment of uptake, distribution, and dissipation of a substance.""")
Declaration(Class(goldbook:14538))
AnnotationAssertion(rdfs:label goldbook:14538 "competitive exclusion")
AnnotationAssertion(dcterms:description goldbook:14538 "Outcompetition from a niche of one species by another that uses the available resources of the niche more efficiently, eventually resulting in the exclusion of the outcompeted species.")
Declaration(Class(goldbook:14539))
AnnotationAssertion(rdfs:label goldbook:14539 "complimentary niches")
AnnotationAssertion(dcterms:description goldbook:14539 "Niches where coexisting species occupy a similar position along one niche dimension, e.g., altitude, but differ along another, e.g., diet.")
Declaration(Class(goldbook:14540))
AnnotationAssertion(rdfs:label goldbook:14540 "concentration–response curve")
AnnotationAssertion(dcterms:description goldbook:14540 "Graph of the relation between exposure concentration and the proportion of individuals in a population responding with a defined effect.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14540 "exposure–response curve")
Declaration(Class(goldbook:14541))
AnnotationAssertion(rdfs:label goldbook:14541 "conceptual model")
AnnotationAssertion(dcterms:description goldbook:14541 "Linkage and interrelationship of assessment endpoint(s) and stressors.")
Declaration(Class(goldbook:14542))
AnnotationAssertion(rdfs:label goldbook:14542 "conceptual model diagram")
AnnotationAssertion(dcterms:description goldbook:14542 "Figure showing pathways of exposure of organisms and illustrating areas of uncertainty or concern.")
Declaration(Class(goldbook:14543))
AnnotationAssertion(rdfs:label goldbook:14543 "conceptual site model")
AnnotationAssertion(dcterms:description goldbook:14543 "Integration of information on contaminants of potential concern (COPCs), ecological resources, evaluated exposure routes, fate and transport mechanisms, evaluated COPC toxicity, identified assessment endpoints, and risk questions and hypotheses, into a description of all that is known and (or) expected about a contaminated site.")
Declaration(Class(goldbook:14544))
AnnotationAssertion(rdfs:label goldbook:14544 "condition")
AnnotationAssertion(dcterms:description goldbook:14544 "State of health determining potential for reproduction and growth.")
Declaration(Class(goldbook:14545))
AnnotationAssertion(rdfs:label goldbook:14545 "condition factor")
AnnotationAssertion(dcterms:description goldbook:14545 "Parameter used to describe growth in fish. It reflects real growth and nutritional status better than simple measurement of body mass.")
Declaration(Class(goldbook:14546))
AnnotationAssertion(rdfs:label goldbook:14546 "condition index")
AnnotationAssertion(dcterms:description goldbook:14546 "Any quantitative measure of the condition in relation to a defined baseline.")
Declaration(Class(goldbook:14547))
AnnotationAssertion(rdfs:label goldbook:14547 "conservation biology")
AnnotationAssertion(dcterms:description goldbook:14547 "Science applied to the conservation of genes, populations, species, and ecosystems.")
Declaration(Class(goldbook:14548))
AnnotationAssertion(rdfs:label goldbook:14548 "conservation ecology")
AnnotationAssertion(dcterms:description goldbook:14548 "Science of analyzing and protecting the Earth’s biological diversity.")
Declaration(Class(goldbook:14549))
AnnotationAssertion(rdfs:label goldbook:14549 "contaminant")
AnnotationAssertion(dcterms:description goldbook:14549 """Minor impurity present in a substance.
Extraneous material inadvertently added to a sample prior to or during chemical or biological analysis.
In some contexts, as in relation to gas cleaning equipment, used as a synonym for 'pollutant', especially on a small scale.
Unintended component in food that may pose a hazard to the consumer.
Any undesirable solid, liquid, or gaseous matter occurring, as a result of human activities, in a solid, liquid, or gaseous environmental medium, even without adverse effects being observed.""")
Declaration(Class(goldbook:14550))
AnnotationAssertion(rdfs:label goldbook:14550 "continuous effect")
AnnotationAssertion(dcterms:description goldbook:14550 "Change that can be measured on a continuum from zero (or even a negative value) to positive values such as growth and reproduction.")
Declaration(Class(goldbook:14551))
AnnotationAssertion(rdfs:label goldbook:14551 "control")
AnnotationAssertion(dcterms:description goldbook:14551 "Treatment in a toxicity test that duplicates all the conditions of the exposure treatments but contains no test material, in order to determine the absence of toxicity under basic test conditions (e.g., health of test organisms, quality of dilution water).")
Declaration(Class(goldbook:14552))
AnnotationAssertion(rdfs:label goldbook:14552 "cooxidation")
AnnotationAssertion(dcterms:description goldbook:14552 "Cometabolism whereby growing microorganisms oxidize a compound without using either carbon or energy derived from the oxidation of that compound.")
Declaration(Class(goldbook:14553))
AnnotationAssertion(rdfs:label goldbook:14553 "copepod")
AnnotationAssertion(dcterms:description goldbook:14553 "Minute marine or freshwater crustacean, usually having six pairs of limbs on the thorax; some are abundant in plankton and others are parasitic on fish, marine mammals, and macro-invertebrates.")
Declaration(Class(goldbook:14554))
AnnotationAssertion(rdfs:label goldbook:14554 "corrosive")
AnnotationAssertion(dcterms:description goldbook:14554 """n. Substance having the capability or tendency to cause slow destruction.
adj. Gradually destructive; steadily harmful.""")
Declaration(Class(goldbook:14555))
AnnotationAssertion(rdfs:label goldbook:14555 "cost–benefit analysis")
AnnotationAssertion(dcterms:description goldbook:14555 "Procedure for determining the relationship of the expected benefits of a proposed action to the expected costs in order to decide whether the action provides the best option for the investment of limited resources.")
Declaration(Class(goldbook:14556))
AnnotationAssertion(rdfs:label goldbook:14556 "cost-effectiveness analysis")
AnnotationAssertion(dcterms:description goldbook:14556 "Procedure for determining whether the expected beneficial effects of a defined course of action justify the cost when selecting among competing options for the use of limited resources.")
Declaration(Class(goldbook:14557))
AnnotationAssertion(rdfs:label goldbook:14557 "cough")
AnnotationAssertion(dcterms:description goldbook:14557 "Abrupt, periodic reversal of water flow over the gills that dislodges and eliminates excess mucus from the gills’ surfaces.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14557 "gill purge")
Declaration(Class(goldbook:14558))
AnnotationAssertion(rdfs:label goldbook:14558 "critical body residue")
AnnotationAssertion(dcterms:description goldbook:14558 "Whole-body concentration of a chemical that is associated with a given adverse biological response.")
Declaration(Class(goldbook:14559))
AnnotationAssertion(rdfs:label goldbook:14559 "critical life-stage testing")
AnnotationAssertion(dcterms:description goldbook:14559 "Toxicity testing focused on the species life stage thought to be the most sensitive to the toxicant, such as newly hatched individuals.")
Declaration(Class(goldbook:14560))
AnnotationAssertion(rdfs:label goldbook:14560 "cross-resistance")
AnnotationAssertion(dcterms:description goldbook:14560 "Condition in which enhanced tolerance to one toxicant also enhances tolerance to another.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14560 "cotolerance")
Declaration(Class(goldbook:14561))
AnnotationAssertion(rdfs:label goldbook:14561 "culture")
AnnotationAssertion(dcterms:description goldbook:14561 """n. Stock of healthy cells, tissue, microorganisms, or plants raised under well-defined and controlled conditions.
v. To maintain a stock of healthy organisms under well-defined and controlled conditions.""")
Declaration(Class(goldbook:14562))
AnnotationAssertion(rdfs:label goldbook:14562 "cumulative dose")
AnnotationAssertion(dcterms:description goldbook:14562 "Total dose resulting from repeated exposures or continuous exposure over a defined time to a substance or to radiation.")
Declaration(Class(goldbook:14563))
AnnotationAssertion(rdfs:label goldbook:14563 "cumulative exposure")
AnnotationAssertion(dcterms:description goldbook:14563 "Total exposure resulting from repeated and continuous exposure over a defined time to a substance or to radiation.")
Declaration(Class(goldbook:14564))
AnnotationAssertion(rdfs:label goldbook:14564 "Daphnia")
AnnotationAssertion(dcterms:description goldbook:14564 "Small, mostly planktonic, crustaceans, between \\(\\pu{0.2 mm}\\) and \\(\\pu{5 mm}\\) in length.")
Declaration(Class(goldbook:14565))
AnnotationAssertion(rdfs:label goldbook:14565 "dead-end metabolite")
AnnotationAssertion(dcterms:description goldbook:14565 "Substance formed by a microbe’s metabolism of a substrate (most often during cometabolism) that cannot be further metabolized by that organism.")
Declaration(Class(goldbook:14566))
AnnotationAssertion(rdfs:label goldbook:14566 "death")
AnnotationAssertion(dcterms:description goldbook:14566 "In assessing population ecology, death of an individual is loss of the ability to reproduce.")
Declaration(Class(goldbook:14567))
AnnotationAssertion(rdfs:label goldbook:14567 "death")
AnnotationAssertion(dcterms:description goldbook:14567 "Irreversible cessation of all vital functions of an organism.")
Declaration(Class(goldbook:14568))
AnnotationAssertion(rdfs:label goldbook:14568 "death rate")
AnnotationAssertion(dcterms:description goldbook:14568 "Number of deaths \\(D\\) in a closed population of size \\(N\\) during a specified time interval, \\(\\Delta t\\). The rate is calculated from the formula \\[D = -\\Delta N/\\Delta t\\] where \\(\\Delta N\\) is the change in number of deaths over a specified time period.")
Declaration(Class(goldbook:14569))
AnnotationAssertion(rdfs:label goldbook:14569 "dechlorinated water")
AnnotationAssertion(dcterms:description goldbook:14569 "Chlorinated water (usually municipal drinking water) that has been treated to remove chlorine and chlorinated compounds from solution.")
Declaration(Class(goldbook:14570))
AnnotationAssertion(rdfs:label goldbook:14570 "decomposer")
AnnotationAssertion(dcterms:description goldbook:14570 "Organism that breaks down dead matter or wastes of other organisms.")
Declaration(Class(goldbook:14571))
AnnotationAssertion(rdfs:label goldbook:14571 "defoliant")
AnnotationAssertion(dcterms:description goldbook:14571 "Substance used for removal of leaves by its toxic action on living plants.")
Declaration(Class(goldbook:14572))
AnnotationAssertion(rdfs:label goldbook:14572 "demographic stochasticity")
AnnotationAssertion(dcterms:description goldbook:14572 "Variability in population growth rates arising from random differences among individuals in survival and reproduction within a season.")
Declaration(Class(goldbook:14573))
AnnotationAssertion(rdfs:label goldbook:14573 "demography")
AnnotationAssertion(dcterms:description goldbook:14573 "Study of populations, especially their age structure and growth rates.")
Declaration(Class(goldbook:14574))
AnnotationAssertion(rdfs:label goldbook:14574 "density dependence")
AnnotationAssertion(dcterms:description goldbook:14574 "Variation in characteristics of individuals or of a population produced by changes in the density of the population.")
Declaration(Class(goldbook:14575))
AnnotationAssertion(rdfs:label goldbook:14575 "deposit feeder")
AnnotationAssertion(dcterms:description goldbook:14575 "Animal that feeds on particles of matter in the soil or sediment, usually the top soil or sediment where it is filled with organic matter. Feeding takes place either by ingesting soil or sediment or by trapping particles as they fall.")
Declaration(Class(goldbook:14576))
AnnotationAssertion(rdfs:label goldbook:14576 "depuration")
AnnotationAssertion(dcterms:description goldbook:14576 "Loss of a substance from an organism owing to elimination and degradation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14576 "depuration time")
Declaration(Class(goldbook:14577))
AnnotationAssertion(rdfs:label goldbook:14577 "derived characteristic")
AnnotationAssertion(dcterms:description goldbook:14577 "Predicted property of a substance that is dependent upon, or is an approximation of, a fundamental property and the prevailing environmental conditions.")
Declaration(Class(goldbook:14578))
AnnotationAssertion(rdfs:label goldbook:14578 "deterministic")
AnnotationAssertion(dcterms:description goldbook:14578 "Term applied to effects, of which the extent varies with the dose and for which a threshold is believed to exist.")
Declaration(Class(goldbook:14579))
AnnotationAssertion(rdfs:label goldbook:14579 "deterministic analysis")
AnnotationAssertion(dcterms:description goldbook:14579 "Detailed study in which all population and environmental parameters are assumed to be constant and accurately specified.")
Declaration(Class(goldbook:14580))
AnnotationAssertion(rdfs:label goldbook:14580 "deterministic model")
AnnotationAssertion(dcterms:description goldbook:14580 "Mathematical model that is fully specified and does not include a stochastic component.")
Declaration(Class(goldbook:14581))
AnnotationAssertion(rdfs:label goldbook:14581 "detritus")
AnnotationAssertion(dcterms:description goldbook:14581 "Organic debris from decomposing plants and animals.")
Declaration(Class(goldbook:14582))
AnnotationAssertion(rdfs:label goldbook:14582 "detrivorous")
AnnotationAssertion(dcterms:description goldbook:14582 "Describing an organism that survives by eating detritus.")
Declaration(Class(goldbook:14583))
AnnotationAssertion(rdfs:label goldbook:14583 "developmental reference dose")
AnnotationAssertion(dcterms:description goldbook:14583 "Reference dose determined for developmental consequences of a single, maternal exposure during development.")
Declaration(Class(goldbook:14584))
AnnotationAssertion(rdfs:label goldbook:14584 "developmental stability")
AnnotationAssertion(dcterms:description goldbook:14584 "Potential of an organism to develop into a consistent phenotype in an environment.")
Declaration(Class(goldbook:14585))
AnnotationAssertion(rdfs:label goldbook:14585 "diatom")
AnnotationAssertion(dcterms:description goldbook:14585 "Member of a major group of eukaryotic algae, among the most common types of phytoplankton. Unicellular, some form chains or simple colonies. Diatom cells are encased in a frustule, of widely diverse form, made of silica (hydrated silicon dioxide).")
Declaration(Class(goldbook:14586))
AnnotationAssertion(rdfs:label goldbook:14586 "diffuse source")
AnnotationAssertion(dcterms:description goldbook:14586 "Release into the environment from multiple sources covering a wide area as opposed to point source.")
Declaration(Class(goldbook:14587))
AnnotationAssertion(rdfs:label goldbook:14587 "dilution paradigm")
AnnotationAssertion(dcterms:description goldbook:14587 "Belief that pollution is alleviated by dilution.")
Declaration(Class(goldbook:14588))
AnnotationAssertion(rdfs:label goldbook:14588 "dilution water")
AnnotationAssertion(dcterms:description goldbook:14588 "Water used to dilute the test material in an aquatic toxicity test in order to prepare either different concentrations of a test chemical or different percentages of an effluent for the various test treatments.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14588 "diluent")
Declaration(Class(goldbook:14589))
AnnotationAssertion(rdfs:label goldbook:14589 "direct ecological effect")
AnnotationAssertion(dcterms:description goldbook:14589 "Effect where a stressor acts immediately on an ecological component of interest and not through the consequences of effects on other components of the ecosystem.")
Declaration(Class(goldbook:14590))
AnnotationAssertion(rdfs:label goldbook:14590 "directional asymmetry")
AnnotationAssertion(dcterms:description goldbook:14590 "Deviation within a population from a mean of zero for the difference between a trait measured from the right and left sides of bilaterally symmetrical individuals from that population.")
Declaration(Class(goldbook:14591))
AnnotationAssertion(rdfs:label goldbook:14591 "direct toxicity")
AnnotationAssertion(dcterms:description goldbook:14591 "Toxicity that results from, and is readily attributable to, substances acting at the sites of toxic action in and (or) on the exposed organisms that are exhibiting the adverse biological response in question.")
Declaration(Class(goldbook:14592))
AnnotationAssertion(rdfs:label goldbook:14592 "discharge")
AnnotationAssertion(dcterms:description goldbook:14592 "Release of any waste into the environment from a point source.")
Declaration(Class(goldbook:14593))
AnnotationAssertion(rdfs:label goldbook:14593 "discrimination ratio")
AnnotationAssertion(dcterms:description goldbook:14593 "Ratio measuring the degree of isotopic discrimination, with a ratio of 1 indicating no discrimination.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14593 "discrimination factor")
Declaration(Class(goldbook:14594))
AnnotationAssertion(rdfs:label goldbook:14594 "dispersant")
AnnotationAssertion(dcterms:description goldbook:14594 "Substance used to disperse liquid spills, e.g., oil spills in water.")
Declaration(Class(goldbook:14595))
AnnotationAssertion(rdfs:label goldbook:14595 "dissolved organic carbon")
AnnotationAssertion(dcterms:description goldbook:14595 "Amount concentration of carbon found dissolved in water samples from aquatic systems, measured as total elemental carbon.")
Declaration(Class(goldbook:14596))
AnnotationAssertion(rdfs:label goldbook:14596 "dissolved oxygen content")
AnnotationAssertion(dcterms:description goldbook:14596 "Amount concentration of oxygen dissolved in water at a particular temperature and pressure.")
Declaration(Class(goldbook:14597))
AnnotationAssertion(rdfs:label goldbook:14597 "dissolved organic matter")
AnnotationAssertion(dcterms:description goldbook:14597 "Analogous to dissolved organic carbon, but refers to the entire organic pool dissolved in water.")
Declaration(Class(goldbook:14598))
AnnotationAssertion(rdfs:label goldbook:14598 "disturbance")
AnnotationAssertion(dcterms:description goldbook:14598 "Event that introduces, removes, or redistributes organisms, changing the colonization potential of a given environment.")
Declaration(Class(goldbook:14599))
AnnotationAssertion(rdfs:label goldbook:14599 "diversity index")
AnnotationAssertion(dcterms:description goldbook:14599 "Mathematical descriptor of species variation within a community.")
Declaration(Class(goldbook:14600))
AnnotationAssertion(rdfs:label goldbook:14600 "dose–effect")
AnnotationAssertion(dcterms:description goldbook:14600 "Relation between dose and the magnitude of a measured biological change.")
Declaration(Class(goldbook:14601))
AnnotationAssertion(rdfs:label goldbook:14601 "dose–effect curve")
AnnotationAssertion(dcterms:description goldbook:14601 "Graph of the relation between dose and the magnitude of the biological change produced measured in appropriate units.")
Declaration(Class(goldbook:14602))
AnnotationAssertion(rdfs:label goldbook:14602 "dose–effect relationship")
AnnotationAssertion(dcterms:description goldbook:14602 "Association between dose and the resulting magnitude of a continuously graded change, either in an individual or in a population.")
Declaration(Class(goldbook:14603))
AnnotationAssertion(rdfs:label goldbook:14603 "dose–response curve")
AnnotationAssertion(dcterms:description goldbook:14603 "Graph of the relation between dose and the proportion of individuals in a population responding with a defined biological effect.")
Declaration(Class(goldbook:14604))
AnnotationAssertion(rdfs:label goldbook:14604 "dose–response relationship")
AnnotationAssertion(dcterms:description goldbook:14604 "Association between dose and the incidence of a defined biological effect in an exposed population usually expressed as percentage.")
Declaration(Class(goldbook:14605))
AnnotationAssertion(rdfs:label goldbook:14605 "drainage basin")
AnnotationAssertion(dcterms:description goldbook:14605 "Area of land where water from rain or snow melt drains downhill into a body of water, such as a river, lake, dam, estuary, wetland, sea, or ocean.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "catchment")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "catchment area")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "catchment basin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "drainage area")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "river basin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "water basin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14605 "watershed")
Declaration(Class(goldbook:14606))
AnnotationAssertion(rdfs:label goldbook:14606 "dynamic energy budget theory")
AnnotationAssertion(dcterms:description goldbook:14606 "Theory that simple quantitative rules may be applied to define the organization of metabolism of individual organisms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14606 "DEB theory")
Declaration(Class(goldbook:14607))
AnnotationAssertion(rdfs:label goldbook:14607 "dynamically fragile community")
AnnotationAssertion(dcterms:description goldbook:14607 "Community that is stable for only a very limited range of environmental characteristics, e.g., a stable and predictable environment with respect to predator–prey ratios or disturbances caused by humans.")
Declaration(Class(goldbook:14608))
AnnotationAssertion(rdfs:label goldbook:14608 "dynamically robust community")
AnnotationAssertion(dcterms:description goldbook:14608 "Community that is stable within a wide range of conditions, e.g., in very variable and unpredictable environments.")
Declaration(Class(goldbook:14609))
AnnotationAssertion(rdfs:label goldbook:14609 "dynamic stability hypothesis")
AnnotationAssertion(dcterms:description goldbook:14609 "Hypothesis that long food chains are less stable than short food chains.")
Declaration(Class(goldbook:14610))
AnnotationAssertion(rdfs:label goldbook:14610 "ecology")
AnnotationAssertion(dcterms:description goldbook:14610 "Branch of biology that studies the interactions between living organisms and all factors (including other organisms) in their environment. Such interactions encompass environmental factors that determine the distributions of living organisms.")
Declaration(Class(goldbook:14611))
AnnotationAssertion(rdfs:label goldbook:14611 "ecological character")
AnnotationAssertion(dcterms:description goldbook:14611 "Sum of biological, physical, and chemical components of an ecosystem and their interactions that maintain the ecosystem and its products, functions, and attributes.")
Declaration(Class(goldbook:14612))
AnnotationAssertion(rdfs:label goldbook:14612 "ecological energetics")
AnnotationAssertion(dcterms:description goldbook:14612 "Study of the flow of energy within an ecological system from the time the energy enters the living system until it is irretrievably lost from the system as heat.")
Declaration(Class(goldbook:14613))
AnnotationAssertion(rdfs:label goldbook:14613 "ecological epidemiology")
AnnotationAssertion(dcterms:description goldbook:14613 "Application of epidemiological methods to determine the cause, incidence, prevalence, and distribution of adverse effects in nonhuman species inhabiting contaminated sites; it is frequently associated with retrospective ecological risk assessment.")
Declaration(Class(goldbook:14614))
AnnotationAssertion(rdfs:label goldbook:14614 "ecological imbalance")
AnnotationAssertion(dcterms:description goldbook:14614 "Change in any biological, physical, or chemical components of an ecosystem, or in their interactions, which result in change in ecological character and its functions and attributes.")
Declaration(Class(goldbook:14615))
AnnotationAssertion(rdfs:label goldbook:14615 "ecological mortality")
AnnotationAssertion(dcterms:description goldbook:14615 "Toxicant-related diminution of fitness of an individual functioning within an ecosystem that is of a magnitude sufficient to be equivalent to somatic death.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14615 "ecological death")
Declaration(Class(goldbook:14616))
AnnotationAssertion(rdfs:label goldbook:14616 "ecological parameter")
AnnotationAssertion(dcterms:description goldbook:14616 "Measurable variable whose value is a determinant of the characteristics of an ecosystem.")
Declaration(Class(goldbook:14617))
AnnotationAssertion(rdfs:label goldbook:14617 "ecophysiology")
AnnotationAssertion(dcterms:description goldbook:14617 "Study of physiology and tolerance limits of species that enhances understanding of their distribution in relation to abiotic conditions.")
Declaration(Class(goldbook:14618))
AnnotationAssertion(rdfs:label goldbook:14618 "ecoregion")
AnnotationAssertion(dcterms:description goldbook:14618 """Any of a number of regions into which a continent, country, etc., can be divided according to their distinct environmental conditions and habitat types.
Large area of land or water with a characteristic, geographically distinct assemblage of natural communities and species comprising a recurring pattern of ecosystems associated with characteristic combinations of soil and landform.Note: The biodiversity of ecosystems in an ecoregion is often distinct from that of other ecoregions.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14618 "bioregion")
Declaration(Class(goldbook:14619))
AnnotationAssertion(rdfs:label goldbook:14619 "ecosystem")
AnnotationAssertion(dcterms:description goldbook:14619 "Grouping of organisms (microorganisms, plants, animals) interacting together, with and through their physical and chemical environments, to form a functional entity within a defined environment.")
Declaration(Class(goldbook:14620))
AnnotationAssertion(rdfs:label goldbook:14620 "ecotone")
AnnotationAssertion(dcterms:description goldbook:14620 "Area of gradual transition between two or more ecosystems.")
Declaration(Class(goldbook:14621))
AnnotationAssertion(rdfs:label goldbook:14621 "ecotoxicologically relevant concentration")
AnnotationAssertion(dcterms:description goldbook:14621 "Concentration of a pesticide (active ingredient, formulations, and relevant metabolites) that is likely to affect a determinable ecological characteristic of an exposed system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14621 "environmentally relevant concentration")
Declaration(Class(goldbook:14622))
AnnotationAssertion(rdfs:label goldbook:14622 "edaphic")
AnnotationAssertion(dcterms:description goldbook:14622 "Pertaining to the soil.")
Declaration(Class(goldbook:14623))
AnnotationAssertion(rdfs:label goldbook:14623 "eddy motion")
AnnotationAssertion(dcterms:description goldbook:14623 "Movement in a current of water or air, that is contrary to the direction of the main current, especially in a circular motion, leading to irregularity in the motion of molecules.")
Declaration(Class(goldbook:14624))
AnnotationAssertion(rdfs:label goldbook:14624 "edge effect")
AnnotationAssertion(dcterms:description goldbook:14624 "Influence of the closeness of contrasting environments on an ecosystem, seen at boundaries between natural habitats, especially forests, and disturbed or developed land.")
Declaration(Class(goldbook:14625))
AnnotationAssertion(rdfs:label goldbook:14625 "effect time")
AnnotationAssertion(dcterms:description goldbook:14625 "Time taken for a substance to produce a precisely defined effect.")
Declaration(Class(goldbook:14626))
AnnotationAssertion(rdfs:label goldbook:14626 "effects assessment")
AnnotationAssertion(dcterms:description goldbook:14626 "Component of risk assessment concerned with quantifying the manner in which the frequency and intensity of effects increase with increasing exposure to a contaminant or other source of stress (also known as dose–response assessment or toxicity assessment).")
Declaration(Class(goldbook:14627))
AnnotationAssertion(rdfs:label goldbook:14627 "elasticity")
AnnotationAssertion(dcterms:description goldbook:14627 "Ability of a community to return to its prestressed condition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14627 "community elasticity")
Declaration(Class(goldbook:14628))
AnnotationAssertion(rdfs:label goldbook:14628 "elutriate")
AnnotationAssertion(dcterms:description goldbook:14628 "Aqueous solution obtained after adding water to a solid substance (e.g., sediment, tailings, drilling mud, or dredging spoil), shaking the mixture, then centrifuging or filtering it or decanting the supernatant.")
Declaration(Class(goldbook:14629))
AnnotationAssertion(rdfs:label goldbook:14629 "elutriate test")
AnnotationAssertion(dcterms:description goldbook:14629 "Test in which a nonbenthic species, such as Daphnia magna, is exposed to an elutriate produced by mixing test sediment with water and then centrifuging the mixture.")
Declaration(Class(goldbook:14630))
AnnotationAssertion(rdfs:label goldbook:14630 "emergent properties")
AnnotationAssertion(dcterms:description goldbook:14630 "New properties emerging with upward steps in hierarchical systems, such as ecological communities or ecosystems, that cannot be predicted solely from our limited understanding of the system’s parts or components.")
Declaration(Class(goldbook:14631))
AnnotationAssertion(rdfs:label goldbook:14631 "emission standard")
AnnotationAssertion(dcterms:description goldbook:14631 "Quantitative limit on the emission or discharge of a substance from a source, usually expressed in terms of a time-weighted average concentration or a ceiling value.")
Declaration(Class(goldbook:14632))
AnnotationAssertion(rdfs:label goldbook:14632 "endemic")
AnnotationAssertion(dcterms:description goldbook:14632 "Pertaining to a species found in a discrete geographical unit, such as an island, habitat type, or other defined area or zone.")
Declaration(Class(goldbook:14633))
AnnotationAssertion(rdfs:label goldbook:14633 "endemism")
AnnotationAssertion(dcterms:description goldbook:14633 "Ecological state of being unique to a place.")
Declaration(Class(goldbook:14634))
AnnotationAssertion(rdfs:label goldbook:14634 "endotherm")
AnnotationAssertion(dcterms:description goldbook:14634 "'Warm-blooded organism' that regulates its body temperature to be (almost) constant.")
Declaration(Class(goldbook:14635))
AnnotationAssertion(rdfs:label goldbook:14635 "endpoint")
AnnotationAssertion(dcterms:description goldbook:14635 "Objective of measurement of a toxicity test.")
Declaration(Class(goldbook:14636))
AnnotationAssertion(rdfs:label goldbook:14636 "endpoint assessment")
AnnotationAssertion(dcterms:description goldbook:14636 "Quantitative or quantifiable expression of the environmental value considered to be at risk in a risk analysis.")
Declaration(Class(goldbook:14637))
AnnotationAssertion(rdfs:label goldbook:14637 "environmental assessment")
AnnotationAssertion(dcterms:description goldbook:14637 "Short, preliminary assessment of potential environmental harm used to determine if a full environmental impact statement (EIS) is required.")
Declaration(Class(goldbook:14638))
AnnotationAssertion(rdfs:label goldbook:14638 "environmental availability")
AnnotationAssertion(dcterms:description goldbook:14638 "Portion of the total amount of a substance present in the environment that is involved in a particular process and is subject to physicochemical and biological modifying influences.")
Declaration(Class(goldbook:14639))
AnnotationAssertion(rdfs:label goldbook:14639 "environmental bioavailability")
AnnotationAssertion(dcterms:description goldbook:14639 "Ratio of uptake clearance to the rate at which an organism encounters a given contaminant in an environmental medium (e.g., soil, sediment, water, food) being processed by the organism.")
Declaration(Class(goldbook:14640))
AnnotationAssertion(rdfs:label goldbook:14640 "environmental epidemiology")
AnnotationAssertion(dcterms:description goldbook:14640 "Subdiscipline of human epidemiology concerned with diseases caused by chemical or physical agents in the environment.")
Declaration(Class(goldbook:14641))
AnnotationAssertion(rdfs:label goldbook:14641 "environmental fate")
AnnotationAssertion(dcterms:description goldbook:14641 "Destiny of a chemical or biological pollutant after release into the natural environment.")
Declaration(Class(goldbook:14642))
AnnotationAssertion(rdfs:label goldbook:14642 "environmental impact assessment")
AnnotationAssertion(dcterms:description goldbook:14642 "Appraisal of the possible environmental consequences of a past, ongoing, or planned action, resulting in the production of an environmental impact statement or 'finding of no significant impact' (FONSI).")
Declaration(Class(goldbook:14643))
AnnotationAssertion(rdfs:label goldbook:14643 "environmental impact statement")
AnnotationAssertion(dcterms:description goldbook:14643 "Report resulting from an environmental impact assessment.")
Declaration(Class(goldbook:14644))
AnnotationAssertion(rdfs:label goldbook:14644 "environmental quality objective")
AnnotationAssertion(dcterms:description goldbook:14644 "Overall state to be aimed for in a particular aspect of the natural environment, for example, 'water in an estuary such that shellfish populations survive in good health'.")
Declaration(Class(goldbook:14645))
AnnotationAssertion(rdfs:label goldbook:14645 "environmental quality standard")
AnnotationAssertion(dcterms:description goldbook:14645 "Amount concentration or mass concentration of a substance that should not be exceeded in an environmental system, often expressed as a time-weighted average measurement over a defined period.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14645 "ambient standard")
Declaration(Class(goldbook:14646))
AnnotationAssertion(rdfs:label goldbook:14646 "environmental risk analysis")
AnnotationAssertion(dcterms:description goldbook:14646 "Determination of the probability of adverse effects on humans and other biota resulting from an environmental hazard (a chemical, physical, or biological agent occurring in or mediated by the environment).")
Declaration(Class(goldbook:14647))
AnnotationAssertion(rdfs:label goldbook:14647 "environmental risk assessment")
AnnotationAssertion(dcterms:description goldbook:14647 "Estimate of the probability that harm will result from a defined exposure to a substance in an environmental medium. The estimate is valid only for a given species and set of conditions.")
Declaration(Class(goldbook:14648))
AnnotationAssertion(rdfs:label goldbook:14648 "environmental security")
AnnotationAssertion(dcterms:description goldbook:14648 """United Nations concept, defined as the relative stability of Earth’s natural ecosystems against human activity, most notably

global climate change caused by human release of greenhouse gas;
deforestation caused by so-called 'clearing' of lands; or
soil depletion and desertification caused by intensive monoculture techniques.""")
Declaration(Class(goldbook:14649))
AnnotationAssertion(rdfs:label goldbook:14649 "environmental transformation")
AnnotationAssertion(dcterms:description goldbook:14649 "Chemical transformation of a substance resulting from interactions in the environment.")
Declaration(Class(goldbook:14650))
AnnotationAssertion(rdfs:label goldbook:14650 "environmental transport")
AnnotationAssertion(dcterms:description goldbook:14650 "Movement of contaminants from their point of release through the various compartments to locations where exposure is assumed to occur.")
Declaration(Class(goldbook:14651))
AnnotationAssertion(rdfs:label goldbook:14651 "enzootic")
AnnotationAssertion(dcterms:description goldbook:14651 "Present in a community or among a group of animals; term applied to a disease prevailing continually in a region.")
Declaration(Class(goldbook:14652))
AnnotationAssertion(rdfs:label goldbook:14652 "epibenthic")
AnnotationAssertion(dcterms:description goldbook:14652 "Living on the bed of an aquatic system, normally on sediment.")
Declaration(Class(goldbook:14653))
AnnotationAssertion(rdfs:label goldbook:14653 "epifauna")
AnnotationAssertion(dcterms:description goldbook:14653 "Animals that live on the surface of soil or of the bed of an aquatic system, normally on sediment.")
Declaration(Class(goldbook:14654))
AnnotationAssertion(rdfs:label goldbook:14654 "episodic")
AnnotationAssertion(dcterms:description goldbook:14654 "Discontinuous.")
Declaration(Class(goldbook:14655))
AnnotationAssertion(rdfs:label goldbook:14655 "epizootic")
AnnotationAssertion(dcterms:description goldbook:14655 "Outbreak of disease in a population or in a large number of individuals of a species.")
Declaration(Class(goldbook:14656))
AnnotationAssertion(rdfs:label goldbook:14656 "equilibrium")
AnnotationAssertion(dcterms:description goldbook:14656 "State of a system in which the macroscopic properties of the system become uniform and independent of time. If the temperature is uniform throughout the system, a state of thermal equilibrium has been reached; if the pressure is uniform, a state of hydrostatic equilibrium has been reached; and if the chemical potential of each component is uniform, a state of chemical equilibrium has been reached. If all these quantities become uniform, the system is said to be in a state of complete thermodynamic equilibrium.")
Declaration(Class(goldbook:14657))
AnnotationAssertion(rdfs:label goldbook:14657 "equilibrium partitioning")
AnnotationAssertion(dcterms:description goldbook:14657 "Tendency for a substance to achieve the same fugacity (chemical activity) in different compartments of a complex system.")
Declaration(Class(goldbook:14658))
AnnotationAssertion(rdfs:label goldbook:14658 "equilibrium partitioning approach")
AnnotationAssertion(dcterms:description goldbook:14658 "Approach to estimating the fate of chemicals in the aquatic environment that is based on equilibrium partitioning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14658 "EqP approach")
Declaration(Class(goldbook:14659))
AnnotationAssertion(rdfs:label goldbook:14659 "essential nutrient")
AnnotationAssertion(dcterms:description goldbook:14659 "Substance that is absolutely required for the normal growth and development of a defined organism throughout a complete life cycle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14659 "essential element")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14659 "essential metal")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14659 "nutrient")
Declaration(Class(goldbook:14660))
AnnotationAssertion(rdfs:label goldbook:14660 "estuarine")
AnnotationAssertion(dcterms:description goldbook:14660 "Belonging to an estuary.")
Declaration(Class(goldbook:14661))
AnnotationAssertion(rdfs:label goldbook:14661 "estuary")
AnnotationAssertion(dcterms:description goldbook:14661 """(general) Tidal opening, an inlet, or creek through which the tide enters; an arm of the sea indenting the land. Rare in modern use.
(specific) Tidal mouth of a great river, where the tide meets the current of freshwater.
Note 1: An estuary is a semi-enclosed coastal body of water with a free connection to the open sea made up of brackish water, typically the tidal mouth of rivers, often associated with sedimentation of material from terrestrial runoff.
Note 2: An estuary is often associated with a high rate of biological productivity.""")
Declaration(Class(goldbook:14662))
AnnotationAssertion(rdfs:label goldbook:14662 "etiologic agent")
AnnotationAssertion(dcterms:description goldbook:14662 "Factor contributing to the cause of a disease.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14662 "etiological agent")
Declaration(Class(goldbook:14663))
AnnotationAssertion(rdfs:label goldbook:14663 "Euler–Lotka equation")
AnnotationAssertion(dcterms:description goldbook:14663 "Equation used to estimate the intrinsic rate of increase from life-table data.")
Declaration(Class(goldbook:14664))
AnnotationAssertion(rdfs:label goldbook:14664 "eutrophic")
AnnotationAssertion(dcterms:description goldbook:14664 """Describing an environment having a high concentration of nutrients. Note: The term is usually used to describe nutrient-rich bodies of water or soil having a high or excessive rate of biological production.
In medicine, tending to promote nutrition.""")
Declaration(Class(goldbook:14665))
AnnotationAssertion(rdfs:label goldbook:14665 "eutrophication")
AnnotationAssertion(dcterms:description goldbook:14665 "Process producing a high concentration of nutrient salts and a high or excessive rate of biological production in water.")
Declaration(Class(goldbook:14666))
AnnotationAssertion(rdfs:label goldbook:14666 "eutrophy")
AnnotationAssertion(dcterms:description goldbook:14666 """State of being eutrophic.
(in medicine) Good nutrition.""")
Declaration(Class(goldbook:14667))
AnnotationAssertion(rdfs:label goldbook:14667 "evolution")
AnnotationAssertion(dcterms:description goldbook:14667 """Transformation of animals, plants, and other living organisms into different forms by the accumulation of changes over successive generations.
Transmutation of species.
Origination or transformation of an organism, organ, physiological process, biological molecule, etc., by a series of changes.
Note: The theory of evolution (in general) is the proposition that all living organisms have undergone a process of alteration and diversification from simple primordial forms during the Earth’s history; (in particular) it is a scientific theory proposing a mechanism for this process, now especially that based on Darwin’s theory of the natural selection of genetically inherited and adaptive variation (see neo-Darwinism)""")
Declaration(Class(goldbook:14668))
AnnotationAssertion(rdfs:label goldbook:14668 "exchange diffusion")
AnnotationAssertion(dcterms:description goldbook:14668 "Diffusion across a membrane by means of a carrier molecule that requires no energy and involves the exchange of two ions across the membrane.")
Declaration(Class(goldbook:14669))
AnnotationAssertion(rdfs:label goldbook:14669 "expected life span")
AnnotationAssertion(dcterms:description goldbook:14669 "Average length of time an organism can be expected to survive, or a substance can be expected to persist.")
Declaration(Class(goldbook:14670))
AnnotationAssertion(rdfs:label goldbook:14670 "experimental ecosystem")
AnnotationAssertion(dcterms:description goldbook:14670 "Manmade construction intended to simulate a natural environment.")
Declaration(Class(goldbook:14671))
AnnotationAssertion(rdfs:label goldbook:14671 "exploitation competition")
AnnotationAssertion(dcterms:description goldbook:14671 "Interspecies competition in which species compete for some limiting resource such as food.")
Declaration(Class(goldbook:14672))
AnnotationAssertion(rdfs:label goldbook:14672 "exponential growth")
AnnotationAssertion(dcterms:description goldbook:14672 "Growth of cells, organisms, or populations in which the number or mass increases exponentially and growth at any time is proportional to the number or mass present.")
Declaration(Class(goldbook:14673))
AnnotationAssertion(rdfs:label goldbook:14673 "exposure assessment")
AnnotationAssertion(dcterms:description goldbook:14673 "Process of measuring or estimating concentration (or intensity), duration, and frequency of exposures to an agent present in the environment or, if estimating hypothetical exposures, that might arise from the release of a substance, or radionuclide, into the environment.")
Declaration(Class(goldbook:14674))
AnnotationAssertion(rdfs:label goldbook:14674 "exposure characterisation")
AnnotationAssertion(dcterms:description goldbook:14674 "Description of the presence and characteristics of contact between the contaminant and the ecological entity of concern, and a summary of this information in an exposure profile.")
Declaration(Class(goldbook:14675))
AnnotationAssertion(rdfs:label goldbook:14675 "exposure pathway")
AnnotationAssertion(dcterms:description goldbook:14675 "Route by which an individual is exposed to a contaminant, including the source and point of contact.")
Declaration(Class(goldbook:14676))
AnnotationAssertion(rdfs:label goldbook:14676 "exposure profile")
AnnotationAssertion(dcterms:description goldbook:14676 "Outline of the magnitude and spatio-temporal pattern of exposure developed during the process of ecological risk assessment.")
Declaration(Class(goldbook:14677))
AnnotationAssertion(rdfs:label goldbook:14677 "exposure scenario")
AnnotationAssertion(dcterms:description goldbook:14677 "Model of the likely exposure of selected populations following release of a substance into a natural environment.")
Declaration(Class(goldbook:14678))
AnnotationAssertion(rdfs:label goldbook:14678 "extinction probability")
AnnotationAssertion(dcterms:description goldbook:14678 """Probability that a population will eventually become extinct.
Probability that a population will become extinct within a specified interval of time.""")
Declaration(Class(goldbook:14679))
AnnotationAssertion(rdfs:label goldbook:14679 "extrapolation")
AnnotationAssertion(dcterms:description goldbook:14679 "Calculation, based on quantitative observations in exposed test species or in vitro test systems, of predicted dose–effect and dose–response relationships for a substance in the same species at other doses or in humans and other species at similar doses.")
Declaration(Class(goldbook:14680))
AnnotationAssertion(rdfs:label goldbook:14680 "extrapolation factor")
AnnotationAssertion(dcterms:description goldbook:14680 "Quantity used in effect and exposure assessments to adjust estimated exposures or concentrations/doses for uncertainties, to make corrections in the data, or to improve safety.")
Declaration(Class(goldbook:14681))
AnnotationAssertion(rdfs:label goldbook:14681 "facilitated diffusion")
AnnotationAssertion(dcterms:description goldbook:14681 "Passive diffusion down a gradient, not requiring energy, but occurring at a rate faster than expected by simple diffusion alone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14681 "facilitated transport")
Declaration(Class(goldbook:14682))
AnnotationAssertion(rdfs:label goldbook:14682 "fate")
AnnotationAssertion(dcterms:description goldbook:14682 "Disposition of a material in various environmental compartments (e.g., soil or sediment, water, air, biota) as a result of transport, partitioning, transformation, and degradation.")
Declaration(Class(goldbook:14683))
AnnotationAssertion(rdfs:label goldbook:14683 "feasibility study")
AnnotationAssertion(dcterms:description goldbook:14683 "Part of a remedial investigation that compares the various options available for remediation and identifies those that are practicable.")
Declaration(Class(goldbook:14684))
AnnotationAssertion(rdfs:label goldbook:14684 "fecundity selection")
AnnotationAssertion(dcterms:description goldbook:14684 "Component of the life cycle of an individual in which natural selection can occur, involving the production of more offspring by matings of certain genotype pairs than are produced by other genotype pairs.")
Declaration(Class(goldbook:14685))
AnnotationAssertion(rdfs:label goldbook:14685 "fertilisation effect")
AnnotationAssertion(dcterms:description goldbook:14685 "Enhanced growth of plants as a result of exposure to low levels of pollutants such as nitrogen and sulfur oxides in acid precipitation.")
Declaration(Class(goldbook:14686))
AnnotationAssertion(rdfs:label goldbook:14686 "fertiliser")
AnnotationAssertion(dcterms:description goldbook:14686 "Substance applied to soil or hydroponic systems for improving the root nutrition of plants with the aim of increasing crop yields and (or) controlling production.")
Declaration(Class(goldbook:14687))
AnnotationAssertion(rdfs:label goldbook:14687 "final acute value")
AnnotationAssertion(dcterms:description goldbook:14687 "Estimate of the concentration of a substance corresponding to a cumulative probability of \\(\\pu{0.05}\\) in the acute toxicity values for all species for which acceptable acute tests have been conducted on the material.")
Declaration(Class(goldbook:14688))
AnnotationAssertion(rdfs:label goldbook:14688 "final chronic value")
AnnotationAssertion(dcterms:description goldbook:14688 "Estimate of the concentration of a substance corresponding to a cumulative probability of \\(\\pu{0.05}\\) in the chronic toxicity values for all genera for which acceptable chronic tests have been conducted on the material.")
Declaration(Class(goldbook:14689))
AnnotationAssertion(rdfs:label goldbook:14689 "finding of no significant impact")
AnnotationAssertion(dcterms:description goldbook:14689 "Statement of no significant impact of a major federal action concluded after an environmental assessment (EA).")
Declaration(Class(goldbook:14690))
AnnotationAssertion(rdfs:label goldbook:14690 "finite rate of increase")
AnnotationAssertion(dcterms:description goldbook:14690 "Rate of increase of population size measured over set intervals, such as between age classes of a life table or generations of a population with nonoverlapping generations, e.g., an annual plant.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14690 "multiplicative growth factor per generation")
Declaration(Class(goldbook:14691))
AnnotationAssertion(rdfs:label goldbook:14691 "fish acute toxicity syndromes")
AnnotationAssertion(dcterms:description goldbook:14691 "Behavioral, physiological, and biochemical responses of fish used to classify chemicals by mode of action.")
Declaration(Class(goldbook:14692))
AnnotationAssertion(rdfs:label goldbook:14692 "fitness advantage")
AnnotationAssertion(dcterms:description goldbook:14692 "Increased relative fitness of a resistant genotype in a polluted environment compared to a nonresistant genotype.")
Declaration(Class(goldbook:14693))
AnnotationAssertion(rdfs:label goldbook:14693 "fitness cost")
AnnotationAssertion(dcterms:description goldbook:14693 "Reduced relative fitness of a resistant genotype in an unpolluted environment compared to a nonresistant genotype.")
Declaration(Class(goldbook:14694))
AnnotationAssertion(rdfs:label goldbook:14694 "flow-through system")
AnnotationAssertion(dcterms:description goldbook:14694 "Exposure system for aquatic toxicity tests in which the test material solutions and control water flow into and out of test chambers on a once-through basis either intermittently or continuously.")
Declaration(Class(goldbook:14695))
AnnotationAssertion(rdfs:label goldbook:14695 "flow-through test")
AnnotationAssertion(dcterms:description goldbook:14695 "Aquatic toxicity test performed in a flow-through system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14695 "continuous flow test")
Declaration(Class(goldbook:14696))
AnnotationAssertion(rdfs:label goldbook:14696 "fluctuating asymmetry")
AnnotationAssertion(dcterms:description goldbook:14696 "Deviation from perfect bilateral symmetry for a population of a bilaterally symmetrical species that is thought to reflect developmental instability.")
Declaration(Class(goldbook:14697))
AnnotationAssertion(rdfs:label goldbook:14697 "fluid feeder")
AnnotationAssertion(dcterms:description goldbook:14697 "Organism that feeds on the fluids of other animals or of plants.")
Declaration(Class(goldbook:14698))
AnnotationAssertion(rdfs:label goldbook:14698 "food chain")
AnnotationAssertion(dcterms:description goldbook:14698 "Hierarchical sequence of transfer of substances from prey organism to predator organism.")
Declaration(Class(goldbook:14699))
AnnotationAssertion(rdfs:label goldbook:14699 "food-mass feeder")
AnnotationAssertion(dcterms:description goldbook:14699 "Animal that feeds on the body parts of other animals.")
Declaration(Class(goldbook:14700))
AnnotationAssertion(rdfs:label goldbook:14700 "fossil")
AnnotationAssertion(dcterms:description goldbook:14700 "Mineralized or otherwise preserved remnant or trace (such as a footprint) of an animal, plant, and other organism.")
Declaration(Class(goldbook:14701))
AnnotationAssertion(rdfs:label goldbook:14701 "free ion activity model")
AnnotationAssertion(dcterms:description goldbook:14701 "Model for acute metal toxicity to aquatic organisms based on the idea that toxicity occurs when the concentration of the free metal cation in solution reaches a certain level.")
Declaration(Class(goldbook:14702))
AnnotationAssertion(rdfs:label goldbook:14702 "Freundlich adsorption isotherm")
AnnotationAssertion(dcterms:description goldbook:14702 "Empirical equation that describes the adsorption of a contaminant to soil. The equation is \\[x/m = (K_{\\rm{f}} C_{\\rm{e}}) \\exp (1/n)\\] where \\(x/m\\) is the mass ratio of concentrations of adsorbed substance at equilibrium divided by the concentration of the contaminant in soil, \\(C_{\\rm{e}}\\) is the contaminant concentration in the aqueous phase at equilibrium, \\(K_{\\rm{f}}\\) is the equilibrium constant (the Freundlich adsorption constant), and \\(1/n\\) is a contaminant specific exponent.")
Declaration(Class(goldbook:14703))
AnnotationAssertion(rdfs:label goldbook:14703 "fulvic acid")
AnnotationAssertion(dcterms:description goldbook:14703 "Humic substance that is soluble at all \\(\\rm{pH}\\)s.")
Declaration(Class(goldbook:14704))
AnnotationAssertion(rdfs:label goldbook:14704 "functional redundancy")
AnnotationAssertion(dcterms:description goldbook:14704 "Apparently unaltered maintenance of community function despite changes in structure.")
Declaration(Class(goldbook:14705))
AnnotationAssertion(rdfs:label goldbook:14705 "functional response")
AnnotationAssertion(dcterms:description goldbook:14705 "Change in some predator function, such as prey consumption rate, in response to changes in prey density.")
Declaration(Class(goldbook:14706))
AnnotationAssertion(rdfs:label goldbook:14706 "fundamental niche")
AnnotationAssertion(dcterms:description goldbook:14706 "Environmental conditions under which a species can thrive.")
Declaration(Class(goldbook:14707))
AnnotationAssertion(rdfs:label goldbook:14707 "Gaia hypothesis")
AnnotationAssertion(dcterms:description goldbook:14707 "Hypothesis proposed by James Lovelock that the Earth’s temperature, albedo, and surface chemistry are homeostatically regulated by the sum of all the biota of the Earth.")
Declaration(Class(goldbook:14708))
AnnotationAssertion(rdfs:label goldbook:14708 "gametic selection")
AnnotationAssertion(dcterms:description goldbook:14708 "Natural selection resulting from differential success of gametes produced by heterozygotes.")
Declaration(Class(goldbook:14709))
AnnotationAssertion(rdfs:label goldbook:14709 "gastrointestinal excretion")
AnnotationAssertion(dcterms:description goldbook:14709 "Excretion through the intestinal mucosa by active or passive processes.")
Declaration(Class(goldbook:14710))
AnnotationAssertion(rdfs:label goldbook:14710 "general adaptation syndrome")
AnnotationAssertion(dcterms:description goldbook:14710 "Specific syndrome associated with Selyean stress composed of three phases: the alarm reaction, adaptation or resistance, and exhaustion; adaptation in all phases of the GAS results in restoration of homeostasis or reduced deviation from homeostasis.")
Declaration(Class(goldbook:14711))
AnnotationAssertion(rdfs:label goldbook:14711 "genetic adaptation")
AnnotationAssertion(dcterms:description goldbook:14711 "Result of random genetic variation due to mutation and (or) to changes in allele frequencies, causing variation in the survival and reproductive success of individuals and hence of groups of organisms, with the consequence that those best adjusted to their environment flourish.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14711 "adaptation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14711 "evolutionary adaptation")
Declaration(Class(goldbook:14712))
AnnotationAssertion(rdfs:label goldbook:14712 "genetic drift")
AnnotationAssertion(dcterms:description goldbook:14712 "Evolutionary process of change in the allele frequencies in a population due to random changes in the frequency by which different alleles are transferred to the next generation.")
Declaration(Class(goldbook:14713))
AnnotationAssertion(rdfs:label goldbook:14713 "genetic hitchhiking")
AnnotationAssertion(dcterms:description goldbook:14713 "Situation in which a scored locus is acting only as a marker for a closely linked gene that is actually responsible for the difference in tolerance among genotypes. More generally, it is the condition 'in which a given allele changes in frequency as a result of linkage or gametic phase disequilibrium with another selected locus'.")
Declaration(Class(goldbook:14714))
AnnotationAssertion(rdfs:label goldbook:14714 "genetic risk")
AnnotationAssertion(dcterms:description goldbook:14714 "Risk to the progeny of an exposed individual of an adverse effect associated with heritable genetic damage, e.g., damage to germ cells leading to a nonviable fetus or an offspring with a birth defect.")
Declaration(Class(goldbook:14716))
AnnotationAssertion(rdfs:label goldbook:14716 "genus")
AnnotationAssertion(dcterms:description goldbook:14716 "Low-level taxonomic rank used in the classification of living and fossil organisms.")
Declaration(Class(goldbook:14717))
AnnotationAssertion(rdfs:label goldbook:14717 "geographic information system")
AnnotationAssertion(dcterms:description goldbook:14717 "Computerized system to handle spatial data at a reasonable cost; most allow one to archive, organize, integrate, statistically analyze, and display many kinds of spatial information using a common coordinate system.")
Declaration(Class(goldbook:14718))
AnnotationAssertion(rdfs:label goldbook:14718 "global distillation")
AnnotationAssertion(dcterms:description goldbook:14718 "Process by which persistent and relatively volatile organochlorine compounds are distilled from warmer regions of use to cooler regions of the globe.")
Declaration(Class(goldbook:14719))
AnnotationAssertion(rdfs:label goldbook:14719 "global fractionation")
AnnotationAssertion(dcterms:description goldbook:14719 "Process by which some persistent organic pollutants (POPs) move more rapidly than others toward the polar regions. Because POPs differ in their individual rates of degradation, vapor pressure, and lipophilicity, a fractionation occurs. The net result is a redistribution of the different POPs from the equator or site of origin toward the cold polar regions of the Earth.")
Declaration(Class(goldbook:14720))
AnnotationAssertion(rdfs:label goldbook:14720 "global warming")
AnnotationAssertion(dcterms:description goldbook:14720 "Heating up of the Earth’s climate thought to result from the increased atmospheric carbon dioxide (\\(\\ce{CO2}\\)) concentrations from fossil fuel burning, release of other greenhouse gases, and the worldwide destruction of forests.")
Declaration(Class(goldbook:14721))
AnnotationAssertion(rdfs:label goldbook:14721 "good laboratory practice principles")
AnnotationAssertion(dcterms:description goldbook:14721 "Fundamental rules incorporated in Organization for Economic Cooperation and Development (OECD) guidelines and national regulations concerned with the process of effective organization and the conditions under which laboratory studies are properly planned, performed, monitored, recorded, and reported.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14721 "GLP principles")
Declaration(Class(goldbook:14722))
AnnotationAssertion(rdfs:label goldbook:14722 "graded effect")
AnnotationAssertion(dcterms:description goldbook:14722 "Consequence that can be measured on a graded scale of intensity or severity and its magnitude related directly to the dose or concentration of the substance producing it.")
Declaration(Class(goldbook:14723))
AnnotationAssertion(rdfs:label goldbook:14723 "grasshopper effect")
AnnotationAssertion(dcterms:description goldbook:14723 "Global distillation of persistent organic pollutants (POPs) involving seasonal cycling of temperatures such that movement toward the higher latitudes occurs in annual pulses.")
Declaration(Class(goldbook:14724))
AnnotationAssertion(rdfs:label goldbook:14724 "greenhouse gases")
AnnotationAssertion(dcterms:description goldbook:14724 "Atmospheric gases that are relatively transparent to sunlight entering the atmosphere but absorb infrared radiation generated at the Earth’s surface. They include water vapor, carbon dioxide (\\(\\ce{CO2}\\)), methane, dinitrogen oxide (nitrous oxide), chlorofluorocarbons (CFCs), chloroethane (methylchloroform), carbon tetrachloride, and the fire retardant, halon. Ozone in the troposphere can also act as a greenhouse gas.")
Declaration(Class(goldbook:14725))
AnnotationAssertion(rdfs:label goldbook:14725 "growth")
AnnotationAssertion(dcterms:description goldbook:14725 "Increase in size.")
Declaration(Class(goldbook:14726))
AnnotationAssertion(rdfs:label goldbook:14726 "growth dilution")
AnnotationAssertion(dcterms:description goldbook:14726 "Decrease in contaminant concentration in a growing organism because the amount of tissue in which the contaminant is distributed is increasing.")
Declaration(Class(goldbook:14727))
AnnotationAssertion(rdfs:label goldbook:14727 "guild")
AnnotationAssertion(dcterms:description goldbook:14727 "Group of functionally similar species whose members interact strongly with one another but weakly with the remainder of the community.")
Declaration(Class(goldbook:14728))
AnnotationAssertion(rdfs:label goldbook:14728 "habitat")
AnnotationAssertion(dcterms:description goldbook:14728 """Spatial area (geographical area) where a particular species population lives, large enough to comprise a breeding population.
Note: A microhabitat or microenvironment is the immediate surroundings and other physical factors of an individual plant or animal within its habitat.
Physical conditions that surround a species, or species population, or assemblage of species, or community.""")
Declaration(Class(goldbook:14729))
AnnotationAssertion(rdfs:label goldbook:14729 "hardness")
AnnotationAssertion(dcterms:description goldbook:14729 "Concentration of all metallic cations, except those of the alkali metals, present in water.")
Declaration(Class(goldbook:14730))
AnnotationAssertion(rdfs:label goldbook:14730 "hard water")
AnnotationAssertion(dcterms:description goldbook:14730 "Water that contains mineral salts of divalent cations, commonly calcium and magnesium and sometimes iron(II) (ferrous) ions, principally as hydrogencarbonates, chlorides, and sulfates.")
Declaration(Class(goldbook:14731))
AnnotationAssertion(rdfs:label goldbook:14731 "Hardy–Weinberg equilibrium")
AnnotationAssertion(dcterms:description goldbook:14731 "State of a population if the frequencies of different alleles of all genes in the genome remain constant between generations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14731 "genetic equilibrium")
Declaration(Class(goldbook:14732))
AnnotationAssertion(rdfs:label goldbook:14732 "harm")
AnnotationAssertion(dcterms:description goldbook:14732 "Adverse effect to an ecosystem, community, population, species, individual organism, organ, tissue, or cell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14732 "damage")
Declaration(Class(goldbook:14733))
AnnotationAssertion(rdfs:label goldbook:14733 "hazard assessment")
AnnotationAssertion(dcterms:description goldbook:14733 "Determination of factors controlling the likely effects of a hazard such as the dose–effect and dose–response relationships, variations in target susceptibility, bioaccumulation potential, persistence, and mechanism of toxicity.")
Declaration(Class(goldbook:14734))
AnnotationAssertion(rdfs:label goldbook:14734 "hazard evaluation")
AnnotationAssertion(dcterms:description goldbook:14734 "Identification and assessment of the potential adverse effects that could result from manufacture, use, and disposal of a material in a specified quantity and manner.")
Declaration(Class(goldbook:14735))
AnnotationAssertion(rdfs:label goldbook:14735 "hazard identification")
AnnotationAssertion(dcterms:description goldbook:14735 "Determination of substances of concern, their adverse effects, target populations, and conditions of exposure, taking into account toxicity data and knowledge of effects on human health, other organisms, and their environment.")
Declaration(Class(goldbook:14736))
AnnotationAssertion(rdfs:label goldbook:14736 "hazard index")
AnnotationAssertion(dcterms:description goldbook:14736 "Sum of the hazard quotients for substances that affect the same target organ or organ system.")
Declaration(Class(goldbook:14737))
AnnotationAssertion(rdfs:label goldbook:14737 "hazard quotient")
AnnotationAssertion(dcterms:description goldbook:14737 "Ratio of toxicant exposure (estimated or measured) to a reference value regarded as corresponding to a threshold of toxicity; often this is determined as the predicted environmental concentration (PEC) divided by the predicted no-effect concentration (PNEC).")
Declaration(Class(goldbook:14738))
AnnotationAssertion(rdfs:label goldbook:14738 "hazardous concentration")
AnnotationAssertion(dcterms:description goldbook:14738 "Concentration of a substance producing a defined effect on \\(\\pu{\\textit{p} \\%}\\) (usually \\(\\pu{5\\%}\\)) of species of concern, derived by means of a statistical extrapolation procedure.")
Declaration(Class(goldbook:14739))
AnnotationAssertion(rdfs:label goldbook:14739 "heavy metal")
AnnotationAssertion(dcterms:description goldbook:14739 "Term used commonly but erroneously when referring to metal toxicity.")
Declaration(Class(goldbook:14740))
AnnotationAssertion(rdfs:label goldbook:14740 "heterotherm")
AnnotationAssertion(dcterms:description goldbook:14740 "Animal that partially regulates body temperature, sometimes maintaining its body temperature at a certain level, e.g., when active, but at other times allowing it to fluctuate with the environment.")
Declaration(Class(goldbook:14741))
AnnotationAssertion(rdfs:label goldbook:14741 "heterotroph")
AnnotationAssertion(dcterms:description goldbook:14741 "Organism obtaining organic food by eating other organisms or their excreta.")
Declaration(Class(goldbook:14742))
AnnotationAssertion(rdfs:label goldbook:14742 "heterotrophic succession")
AnnotationAssertion(dcterms:description goldbook:14742 "Temporal sequential appearance of different heterotrophic species at a location, most often decomposer organisms.")
Declaration(Class(goldbook:14743))
AnnotationAssertion(rdfs:label goldbook:14743 "heterozygote advantage")
AnnotationAssertion(dcterms:description goldbook:14743 "Greater Darwinian fitness (reproductive output) from heterozygous than from homozygous individuals of a species. This tends to preserve variation in the population gene pool.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14743 "heterosis")
Declaration(Class(goldbook:14744))
AnnotationAssertion(rdfs:label goldbook:14744 "homeostasis")
AnnotationAssertion(dcterms:description goldbook:14744 "Totality of processes occurring in an open system or a closed system, especially a living organism, enabling it to regulate its internal environment to maintain stable, constant conditions or the outcome of these processes.")
Declaration(Class(goldbook:14745))
AnnotationAssertion(rdfs:label goldbook:14745 "hormesis")
AnnotationAssertion(dcterms:description goldbook:14745 "Unexpected and unexplained but favorable biological response to low-level exposure to a substance or physical agent generally considered to be harmful.")
Declaration(Class(goldbook:14746))
AnnotationAssertion(rdfs:label goldbook:14746 "humic substances")
AnnotationAssertion(dcterms:description goldbook:14746 "Nonvolatile organic anionic polyelectrolytes, of biological origin, in the molecular mass range \\(\\pu{500\\!{-}\\! 5000}\\), which have complex structures and are variable in composition.")
Declaration(Class(goldbook:14747))
AnnotationAssertion(rdfs:label goldbook:14747 "Hutchinsonian niche")
AnnotationAssertion(dcterms:description goldbook:14747 "Intersection of ranges of tolerances for sets of resources utilized by organisms, represented mathematically by a multidimensional hypervolume whose dimensions correspond to environmental variables. Any species is considered unimodally distributed, i.e., confined to a habitat in the niche.")
Declaration(Class(goldbook:14748))
AnnotationAssertion(rdfs:label goldbook:14748 "hybrid")
AnnotationAssertion(dcterms:description goldbook:14748 """Result of interbreeding between two animals or plants of different taxa.Note: Hybrids between different species within the same genus are sometimes known as interspecific hybrids or crosses. Hybrids between different subspecies within a species are known as intra-specific hybrids. Hybrids between different genera are sometimes known as intergeneric hybrids.
Cross-breed between populations, breeds, or cultivars within a single species.Note: Hybridization is often used in plant and animal breeding to obtain desirable characteristics not found or inconsistently present in the parent individuals or populations.""")
Declaration(Class(goldbook:14749))
AnnotationAssertion(rdfs:label goldbook:14749 "hypoxemia")
AnnotationAssertion(dcterms:description goldbook:14749 "Deficient oxygenation of the blood.")
Declaration(Class(goldbook:14750))
AnnotationAssertion(rdfs:label goldbook:14750 "hypoxic")
AnnotationAssertion(dcterms:description goldbook:14750 "Dioxygen-deficient")
Declaration(Class(goldbook:14751))
AnnotationAssertion(rdfs:label goldbook:14751 "incipient LC<sub>50</sub>")
AnnotationAssertion(dcterms:description goldbook:14751 "Concentration of a chemical which is lethal to \\(\\pu{50\\%}\\) of the test organisms as a result of exposure for periods long enough for acute lethal action to cease; in other words, the concentration below which \\(\\pu{50\\%}\\) of individuals will have a normal lifespan despite the previous exposure to a toxicant.")
Declaration(Class(goldbook:14752))
AnnotationAssertion(rdfs:label goldbook:14752 "incremental unit risk estimate")
AnnotationAssertion(dcterms:description goldbook:14752 "For an air pollutant, the additional lifetime cancer risk occurring in a hypothetical population in which all individuals are exposed continuously from birth throughout their lifetimes to a concentration of \\(\\pu{1 \\upmu g m-3}\\) of the pollutant in the air they breathe.")
Declaration(Class(goldbook:14753))
AnnotationAssertion(rdfs:label goldbook:14753 "independent joint action")
AnnotationAssertion(dcterms:description goldbook:14753 "Production of an effect by each toxicant in a given exposure that is independent of the others and occurs by a different mode of action.")
Declaration(Class(goldbook:14754))
AnnotationAssertion(rdfs:label goldbook:14754 "index of biological integrity")
AnnotationAssertion(dcterms:description goldbook:14754 "Composite index combining 12 qualities of fish communities of warm-water, low-gradient streams to determine the level of stream degradation.")
Declaration(Class(goldbook:14755))
AnnotationAssertion(rdfs:label goldbook:14755 "indicator species")
AnnotationAssertion(dcterms:description goldbook:14755 "Species whose presence shows the occurrence of defined environmental conditions.")
Declaration(Class(goldbook:14756))
AnnotationAssertion(rdfs:label goldbook:14756 "indigenous")
AnnotationAssertion(dcterms:description goldbook:14756 "Native to a given region or ecosystem.")
Declaration(Class(goldbook:14757))
AnnotationAssertion(rdfs:label goldbook:14757 "indirect ecological effect")
AnnotationAssertion(dcterms:description goldbook:14757 """Effect resulting from imposed biotic or abiotic factors which alter ecosystem properties that in turn favor or disfavor an ecological component of importance (e.g., a species) and thus indirectly lead to improved or reduced fitness of that species.
Result of imposed biotic or abiotic factors allowing indigenous or new species to dominate, thereby affecting ecosystem composition.""")
Declaration(Class(goldbook:14758))
AnnotationAssertion(rdfs:label goldbook:14758 "indirect photolysis")
AnnotationAssertion(dcterms:description goldbook:14758 "Degradation of a contaminant through interaction with other molecules in solution that have absorbed light energy. This can occur through energy transfer or by chemical reaction with short-lived reactive species.")
Declaration(Class(goldbook:14759))
AnnotationAssertion(rdfs:label goldbook:14759 "indirect toxicity")
AnnotationAssertion(dcterms:description goldbook:14759 "Adverse effects that result from agent(s) acting on and producing changes in the chemical, physical, and (or) biological environment external to the organisms under study (e.g., decrease in food for predatory species due to direct toxicity from a chemical to prey may produce adverse effects in the predator species due to starvation rather than inducing any direct chemical toxicity in predator organisms).")
Declaration(Class(goldbook:14760))
AnnotationAssertion(rdfs:label goldbook:14760 "individual")
AnnotationAssertion(dcterms:description goldbook:14760 "One whole organism.")
Declaration(Class(goldbook:14761))
AnnotationAssertion(rdfs:label goldbook:14761 "individual effective dose")
AnnotationAssertion(dcterms:description goldbook:14761 "Concept forming the basis for most dose–response models, which holds that there exists a smallest dose needed to kill any particular individual. The IED is a characteristic of an individual.")
Declaration(Class(goldbook:14762))
AnnotationAssertion(rdfs:label goldbook:14762 "industrial ecology")
AnnotationAssertion(dcterms:description goldbook:14762 "Study of the flows of materials and energy in the industrial environment and the effects of these flows on natural systems.")
Declaration(Class(goldbook:14763))
AnnotationAssertion(rdfs:label goldbook:14763 "industrial melanism")
AnnotationAssertion(dcterms:description goldbook:14763 "Gradual increase to predominance of melanic forms in populations from industrialized regions.")
Declaration(Class(goldbook:14764))
AnnotationAssertion(rdfs:label goldbook:14764 "inertia")
AnnotationAssertion(dcterms:description goldbook:14764 "Community’s ability to resist change.")
Declaration(Class(goldbook:14765))
AnnotationAssertion(rdfs:label goldbook:14765 "infauna")
AnnotationAssertion(dcterms:description goldbook:14765 "Animals living in the sediment of aquatic systems but not on the surface.")
Declaration(Class(goldbook:14766))
AnnotationAssertion(rdfs:label goldbook:14766 "initiating event")
AnnotationAssertion(dcterms:description goldbook:14766 "Specific action that results in a risk being incurred.")
Declaration(Class(goldbook:14767))
AnnotationAssertion(rdfs:label goldbook:14767 "integrated risk information system")
AnnotationAssertion(dcterms:description goldbook:14767 "USEPA database containing reference doses, slope factors, and drinking-water health advisories (one-day, ten-day, longer-term, and lifetime advisories), and associated information.")
Declaration(Class(goldbook:14768))
AnnotationAssertion(rdfs:label goldbook:14768 "interference competition")
AnnotationAssertion(dcterms:description goldbook:14768 "Interspecies competition in which one species interferes with another, as might occur with territoriality or aggressive behavior.")
Declaration(Class(goldbook:14769))
AnnotationAssertion(rdfs:label goldbook:14769 "interspecies competition")
AnnotationAssertion(dcterms:description goldbook:14769 "Interference with or inhibition of one species by another.")
Declaration(Class(goldbook:14770))
AnnotationAssertion(rdfs:label goldbook:14770 "interspecific competition")
AnnotationAssertion(dcterms:description goldbook:14770 "Competition by different species for the same (limited) resources.")
Declaration(Class(goldbook:14771))
AnnotationAssertion(rdfs:label goldbook:14771 "interspecific interaction")
AnnotationAssertion(dcterms:description goldbook:14771 "Relations between different species in a community.")
Declaration(Class(goldbook:14772))
AnnotationAssertion(rdfs:label goldbook:14772 "interstitial water")
AnnotationAssertion(dcterms:description goldbook:14772 "Water in sediment or soil that surrounds the solid particles. The amount of interstitial water is calculated and expressed as the percentage ratio of the mass of water in the sediment to the mass of the wet sediment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14772 "pore water")
Declaration(Class(goldbook:14773))
AnnotationAssertion(rdfs:label goldbook:14773 "intraspecific competition")
AnnotationAssertion(dcterms:description goldbook:14773 "Competition by individuals of the same species (population) for the same (limited) resources.")
Declaration(Class(goldbook:14774))
AnnotationAssertion(rdfs:label goldbook:14774 "intrinsic rate of growth")
AnnotationAssertion(dcterms:description goldbook:14774 "\\(r = ({\\rm{natality}} + {\\rm{immigration}}) - ({\\rm{mortality}} + {\\rm{emigration}})\\)")
Declaration(Class(goldbook:14775))
AnnotationAssertion(rdfs:label goldbook:14775 "intrinsic rate of increase")
AnnotationAssertion(dcterms:description goldbook:14775 "Rate of increase in the size of a population growing under no constraints.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14775 "Malthusian rate of increase")
Declaration(Class(goldbook:14776))
AnnotationAssertion(rdfs:label goldbook:14776 "isobole approach")
AnnotationAssertion(dcterms:description goldbook:14776 "Approach used to visualize or quantify joint action of chemical mixtures by plotting a graph (isobologram) of equally effective dose pairs (isoboles) for a single effect level. A particular effect level is selected, such as \\(\\pu{50\\%}\\) of the maximum, and doses of drugs \\(\\ce{A}\\) and \\(\\ce{B}\\) (each alone) that give this effect are plotted as axial points in a Cartesian plot. The straight line connecting \\(\\ce{A}\\) and \\(\\ce{B}\\) is the locus of points (dose pairs) that will produce this effect in a simply additive combination. This line of additivity allows a comparison with the actual dose pair that produces this effect level experimentally.")
Declaration(Class(goldbook:14777))
AnnotationAssertion(rdfs:label goldbook:14777 "isotopic discrimination")
AnnotationAssertion(dcterms:description goldbook:14777 "The differential behavior of isotopes occurring if the rate or extent of participation in some biological or chemical process depends significantly on the mass of the isotope. Also called the isotope effect.")
Declaration(Class(goldbook:14778))
AnnotationAssertion(rdfs:label goldbook:14778 "iteroparous species")
AnnotationAssertion(dcterms:description goldbook:14778 "Species that reproduces more than once.")
Declaration(Class(goldbook:14779))
AnnotationAssertion(rdfs:label goldbook:14779 "Kamofsky’s law")
AnnotationAssertion(dcterms:description goldbook:14779 "Any agent will be teratogenic if it is present at concentrations or intensities producing cell toxicity.")
Declaration(Class(goldbook:14780))
AnnotationAssertion(rdfs:label goldbook:14780 "keystone habitat")
AnnotationAssertion(dcterms:description goldbook:14780 "High-quality habitat patch essential to maintaining the vitality of the metapopulation.")
Declaration(Class(goldbook:14781))
AnnotationAssertion(rdfs:label goldbook:14781 "keystone species")
AnnotationAssertion(dcterms:description goldbook:14781 "Species, usually a top predator, that influences the ecological community by its activity or role, not its numerical dominance.")
Declaration(Class(goldbook:14782))
AnnotationAssertion(rdfs:label goldbook:14782 "k-strategy")
AnnotationAssertion(dcterms:description goldbook:14782 "Equilibrium strategy for species involving effective interactions with each other in the community, allowing coexistence of many species. Equilibrium species are more effective competitors than opportunistic species.")
Declaration(Class(goldbook:14783))
AnnotationAssertion(rdfs:label goldbook:14783 "larva")
AnnotationAssertion(dcterms:description goldbook:14783 "Recently hatched insect, fish, or other organism that has different physical characteristics than those seen in the adult, requiring metamorphosis to reach the adult body structure.")
Declaration(Class(goldbook:14784))
AnnotationAssertion(rdfs:label goldbook:14784 "law of frequence")
AnnotationAssertion(dcterms:description goldbook:14784 "According to this 'law', there are comparatively many rare (low abundance) species, and possibly comparatively many common (high abundance) species, but relatively few in the middle (of medium abundance).")
Declaration(Class(goldbook:14785))
AnnotationAssertion(rdfs:label goldbook:14785 "leach")
AnnotationAssertion(dcterms:description goldbook:14785 "With reference to a soluble chemical or mineral, drain away from soil, ash, or similar material by the action of percolating liquid, especially rainwater.")
Declaration(Class(goldbook:14786))
AnnotationAssertion(rdfs:label goldbook:14786 "leachate")
AnnotationAssertion(dcterms:description goldbook:14786 "Water or waste-water that has percolated through a column of soil or solid waste in the environment, carrying with it substances dissolved from the soil or waste.")
Declaration(Class(goldbook:14787))
AnnotationAssertion(rdfs:label goldbook:14787 "lentic")
AnnotationAssertion(dcterms:description goldbook:14787 "Related to standing water riparian-wetland areas such as lakes, ponds, seeps, bogs, and meadows.")
Declaration(Class(goldbook:14788))
AnnotationAssertion(rdfs:label goldbook:14788 "lentic water")
AnnotationAssertion(dcterms:description goldbook:14788 "Nonflowing or still inland water; e.g., lakes, ponds.")
Declaration(Class(goldbook:14789))
AnnotationAssertion(rdfs:label goldbook:14789 "Leslie matrix")
AnnotationAssertion(dcterms:description goldbook:14789 "Square matrix used in population biology to predict population growth. The top row of the matrix is the fecundity for each age class of mothers, and a subdiagonal is constructed from the number of individuals surviving from age class \\(x\\) to \\(x + 1\\). Multiplied by the population vector of the number of female offspring in each age class \\(x\\) at time \\(t\\), it predicts the age distribution of the population at the next time step \\(t + 1\\), corresponding to the age class interval \\(x + 1\\).")
Declaration(Class(goldbook:14790))
AnnotationAssertion(rdfs:label goldbook:14790 "lethal")
AnnotationAssertion(dcterms:description goldbook:14790 "Deadly; fatal; causing death.")
Declaration(Class(goldbook:14791))
AnnotationAssertion(rdfs:label goldbook:14791 "lethal body burden")
AnnotationAssertion(dcterms:description goldbook:14791 "Total body uptake of a substance that is associated with mortality in short-term exposures.")
Declaration(Class(goldbook:14792))
AnnotationAssertion(rdfs:label goldbook:14792 "lethal time")
AnnotationAssertion(dcterms:description goldbook:14792 "Time taken for a defined percentage, usually \\(\\pu{50\\%}\\), of a test population to die.")
Declaration(Class(goldbook:14793))
AnnotationAssertion(rdfs:label goldbook:14793 "lethality")
AnnotationAssertion(dcterms:description goldbook:14793 "Ability to cause death.")
Declaration(Class(goldbook:14794))
AnnotationAssertion(rdfs:label goldbook:14794 "Liebig's law of the minimum")
AnnotationAssertion(dcterms:description goldbook:14794 "Observation that a population’s size (number of individuals or biomass) is limited by some essential factor in the environment that is scarce relative to the amount of other essential factors, e.g., phosphorus-limited algal growth in a lake.")
Declaration(Class(goldbook:14795))
AnnotationAssertion(rdfs:label goldbook:14795 "life cycle")
AnnotationAssertion(dcterms:description goldbook:14795 "Series of stages, from a given point in one generation to the same point in next generation, e.g., egglarva-adult-egg (hyphenated when used as an adjective, e.g., life-cycle strategy).")
Declaration(Class(goldbook:14796))
AnnotationAssertion(rdfs:label goldbook:14796 "life-cycle study")
AnnotationAssertion(dcterms:description goldbook:14796 "Comprehensive study to determine the impact of a substance or mixture on the survival, growth, reproduction, development, or other important qualities at all stages of a species life cycle.")
Declaration(Class(goldbook:14797))
AnnotationAssertion(rdfs:label goldbook:14797 "life history")
AnnotationAssertion(dcterms:description goldbook:14797 "Description of life-cycle events through which an organism passes, with particular reference to those events that influence survival and reproduction.")
Declaration(Class(goldbook:14798))
AnnotationAssertion(rdfs:label goldbook:14798 "life table")
AnnotationAssertion(dcterms:description goldbook:14798 "Statistical table that follows a hypothetical cohort of \\(\\pu{100000}\\) persons born at the same time as they progress through successive ages, with the cohort reduced from one age to the next according to a set of death rates by age until all persons eventually die.")
Declaration(Class(goldbook:14799))
AnnotationAssertion(rdfs:label goldbook:14799 "life-table response experiment")
AnnotationAssertion(dcterms:description goldbook:14799 "Retrospective comparison of two or more populations in which the response variable is a life table or a complete set of stage-specific vital rates.")
Declaration(Class(goldbook:14800))
AnnotationAssertion(rdfs:label goldbook:14800 "limit value")
AnnotationAssertion(dcterms:description goldbook:14800 "Limit concentration at or below which Member States of the European Community must set their environmental quality standard and emission standard for a particular substance according to Community Directives.")
Declaration(Class(goldbook:14801))
AnnotationAssertion(rdfs:label goldbook:14801 "limited life-span paradigm")
AnnotationAssertion(dcterms:description goldbook:14801 "Model based on the assumption that the maximum life span of an individual organism is an inherent, genetically defined property of that organism.")
Declaration(Class(goldbook:14802))
AnnotationAssertion(rdfs:label goldbook:14802 "limnocorrals")
AnnotationAssertion(dcterms:description goldbook:14802 "Artificial enclosures placed in the pelagic region of ponds, lakes, or marine environments. These systems vary in size from as little as \\(\\pu{2 L}\\) to over \\(\\pu{2.5E6 L}\\); however, most of these systems have a volume between \\(\\pu{1000 L}\\) and \\(\\pu{E4 L}\\).")
Declaration(Class(goldbook:14803))
AnnotationAssertion(rdfs:label goldbook:14803 "limnology")
AnnotationAssertion(dcterms:description goldbook:14803 "Study incorporating the study of all aspects of inland freshwater habitats including lakes, ponds, rivers, streams, swamps, wetlands, groundwaters, and reservoirs that make up inland water systems")
Declaration(Class(goldbook:14804))
AnnotationAssertion(rdfs:label goldbook:14804 "linear free energy relationship")
AnnotationAssertion(dcterms:description goldbook:14804 "An empirical relationship in which numerical parameters are associated with small perturbations in a parent molecule and are subsequently correlated with the change in the Gibbs energy of a certain reaction of the parent molecule vs. the perturbed molecules.")
Declaration(Class(goldbook:14805))
AnnotationAssertion(rdfs:label goldbook:14805 "Litchfield method")
AnnotationAssertion(dcterms:description goldbook:14805 "Simple, semigraphical method for analyzing survival time data and estimating \\(\\pu{LT_{50}}\\) values.")
Declaration(Class(goldbook:14806))
AnnotationAssertion(rdfs:label goldbook:14806 "Litchfield–Wilcoxon method")
AnnotationAssertion(dcterms:description goldbook:14806 "Semigraphical method for estimating a median lethal concentration (\\(\\pu{LC_{50}}\\)), median lethal dose (\\(\\pu{LD_{50}}\\)), or median effective concentration (\\(\\pu{EC_{50}}\\)). Although very easy to perform, it is the most subjective method for such estimations because it involves fitting a line to data by eye.")
Declaration(Class(goldbook:14807))
AnnotationAssertion(rdfs:label goldbook:14807 "littoral")
AnnotationAssertion(dcterms:description goldbook:14807 """Belonging to the shore of a lake, river, pond, or especially the sea.
Intertidal zone, sometimes referring specifically to the shallow well-lit region along the shore.""")
Declaration(Class(goldbook:14808))
AnnotationAssertion(rdfs:label goldbook:14808 "littoral enclosures")
AnnotationAssertion(dcterms:description goldbook:14808 "Isolated shore regions of freshwater ponds separated from the main body of water by plastic dividers used for ecotoxicological testing. These test systems generally have a volume of \\(\\pu{1000 L}\\) to \\(\\pu{5E4 L}\\) and a maximum depth of \\(\\pu{2 m}\\).")
Declaration(Class(goldbook:14809))
AnnotationAssertion(rdfs:label goldbook:14809 "loading")
AnnotationAssertion(dcterms:description goldbook:14809 "Ratio of animal biomass to the volume of test solution in an exposure chamber.")
Declaration(Class(goldbook:14810))
AnnotationAssertion(rdfs:label goldbook:14810 "logistic curve")
AnnotationAssertion(dcterms:description goldbook:14810 "Function, often applied to growth curves, fitting the general equation \\[y = k/(1 + e^{a+bt})\\] where \\(t\\) represents time, \\(y\\) the body weight or population size, \\(k\\) the rate of growth, and \\(a\\) and \\(b \\gt 0\\) are constants. In the logistic equation the percentage rate of increase decreases linearly as size increases. The resulting curve continually rises, slowly at first, more rapidly in the middle phase, and slowly again near the end of growth.")
Declaration(Class(goldbook:14811))
AnnotationAssertion(rdfs:label goldbook:14811 "logistic growth")
AnnotationAssertion(dcterms:description goldbook:14811 "Growth of a population under environmental constraints that set a maximum population size, giving an S-shaped curve.")
Declaration(Class(goldbook:14812))
AnnotationAssertion(rdfs:label goldbook:14812 "logit transformation")
AnnotationAssertion(dcterms:description goldbook:14812 "In competitive binding assays, the logit-log dose relationship, in which the response is defined by \\[R = {\\rm{logit}}\\,(y) = \\ln [y/(1 - y)]\\] where \\(y = b/b_{0}\\), \\(b\\) is fraction of tracer bound and \\(b_{0}\\) is the value of \\(b\\) with no unlabelled ligand in the system.")
Declaration(Class(goldbook:14813))
AnnotationAssertion(rdfs:label goldbook:14813 "log-normal transformation")
AnnotationAssertion(dcterms:description goldbook:14813 "Transformation of data with a logarithmic function that results in a normal distribution.")
Declaration(Class(goldbook:14814))
AnnotationAssertion(rdfs:label goldbook:14814 "Lorax incongruity")
AnnotationAssertion(dcterms:description goldbook:14814 "Delusion of selfless motivation in environmental stewardship or advocacy.")
Declaration(Class(goldbook:14815))
AnnotationAssertion(rdfs:label goldbook:14815 "loss of life expectancy")
AnnotationAssertion(dcterms:description goldbook:14815 "Calculated estimate of loss in lifetime associated with a risk factor; it is estimated as the simple difference between life expectancy without the risk factor and life expectancy with the risk factor.")
Declaration(Class(goldbook:14816))
AnnotationAssertion(rdfs:label goldbook:14816 "lotic")
AnnotationAssertion(dcterms:description goldbook:14816 "Related to flowing continental waters, such as rivers and streams.")
Declaration(Class(goldbook:14817))
AnnotationAssertion(rdfs:label goldbook:14817 "lotic mesocosms")
AnnotationAssertion(dcterms:description goldbook:14817 "Streams of various sizes used to evaluate the effects of substances. Unlike lentic systems, no standardized design has been developed for flowing-water test systems.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14817 "lotic microcosms")
Declaration(Class(goldbook:14818))
AnnotationAssertion(rdfs:label goldbook:14818 "lotic water")
AnnotationAssertion(dcterms:description goldbook:14818 "Flowing continental waters, such as rivers and streams.")
Declaration(Class(goldbook:14819))
AnnotationAssertion(rdfs:label goldbook:14819 "lowest effective dose")
AnnotationAssertion(dcterms:description goldbook:14819 "Lowest dose of a chemical inducing a specified effect in a specified fraction of exposed individuals.")
Declaration(Class(goldbook:14820))
AnnotationAssertion(rdfs:label goldbook:14820 "lowest-observed-effect concentration")
AnnotationAssertion(dcterms:description goldbook:14820 "Lowest concentration of a material used in an aquatic toxicity test that has a statistically significant adverse effect on the exposed population of test organisms compared with controls.")
Declaration(Class(goldbook:14821))
AnnotationAssertion(rdfs:label goldbook:14821 "l<i>x</i> life table or schedule")
AnnotationAssertion(dcterms:description goldbook:14821 "Life table that summarizes mortality data for populations.")
Declaration(Class(goldbook:14822))
AnnotationAssertion(rdfs:label goldbook:14822 "l<i>x</i>m<i>x</i> life table")
AnnotationAssertion(dcterms:description goldbook:14822 "Life table that summarizes both mortality and natality data for populations.")
Declaration(Class(goldbook:14823))
AnnotationAssertion(rdfs:label goldbook:14823 "MacArthur–Wilson model")
AnnotationAssertion(dcterms:description goldbook:14823 "Model of island colonization giving the mathematical relationship \\[S(t) = S_{\\rm{EQ}}(1 - e^{-Gt})\\] where \\(S(t)\\) is the number of species present at time \\(t\\), \\(S_{\\rm{EQ}}\\) is the equilibrium number of species for the island, and \\(G\\) is the rate constant for colonization of the island.")
Declaration(Class(goldbook:14824))
AnnotationAssertion(rdfs:label goldbook:14824 "macrocosm")
AnnotationAssertion(dcterms:description goldbook:14824 "Large multi-species test system.")
Declaration(Class(goldbook:14825))
AnnotationAssertion(rdfs:label goldbook:14825 "macronutrient")
AnnotationAssertion(dcterms:description goldbook:14825 "Imprecise term referring to a nutrient required for survival, or present in biological fluids or compartments at a level easily measured by existing analytical techniques.")
Declaration(Class(goldbook:14826))
AnnotationAssertion(rdfs:label goldbook:14826 "macrophyte")
AnnotationAssertion(dcterms:description goldbook:14826 "Aquatic plant large enough to be seen easily with the naked eye (as distinct from phytoplankton and small algae).")
Declaration(Class(goldbook:14827))
AnnotationAssertion(rdfs:label goldbook:14827 "male-mediated toxicity")
AnnotationAssertion(dcterms:description goldbook:14827 "Disease or birth defects produced by a father’s exposure to a physical or chemical agent.")
Declaration(Class(goldbook:14828))
AnnotationAssertion(rdfs:label goldbook:14828 "Malthusian theory")
AnnotationAssertion(dcterms:description goldbook:14828 "Model, developed by Thomas R. Malthus (1766–1834), implying that, unchecked by environmental or social constraints, human populations would double every 25 years, regardless of the initial population size. Thus, if \\(X_{i}\\) denotes the population size during time period \\(i\\) and \\(r\\) the population growth rate, the Malthusian population model gives the relationship \\[X(I + 1) = (1 + r)X_{i}\\]")
Declaration(Class(goldbook:14829))
AnnotationAssertion(rdfs:label goldbook:14829 "mass balance equation")
AnnotationAssertion(dcterms:description goldbook:14829 "Equation that expresses the total mass of a chemical in terms of all the various forms and concentrations in different environmental compartments (including biota) in which it occurs.")
Declaration(Class(goldbook:14830))
AnnotationAssertion(rdfs:label goldbook:14830 "maturity index")
AnnotationAssertion(dcterms:description goldbook:14830 "Index for pollution based on the proportions of species in a soil nematode community that fall into various categories ranging from colonizers (\\(r\\mbox{-}\\rm{strategists}\\)) to persisters (\\(k\\mbox{-}\\rm{strategists}\\)).")
Declaration(Class(goldbook:14831))
AnnotationAssertion(rdfs:label goldbook:14831 "maulstick incongruity")
AnnotationAssertion(dcterms:description goldbook:14831 "Assignment of ecological or biological significance of a contaminant’s effect based primarily on statements of statistical significance but contrary to biological probability.")
Declaration(Class(goldbook:14832))
AnnotationAssertion(rdfs:label goldbook:14832 "maximum acceptable toxicant concentration")
AnnotationAssertion(dcterms:description goldbook:14832 "Geometric mean of the lowest exposure concentration that causes a statistically significant adverse effect (lowest-observed-effect concentration, LOEC) and the highest exposure concentration where no effect is observed (no-observed-effect concentration, NOEC) in a life-cycle (full chronic) or partial lifecycle (partial chronic) test.")
Declaration(Class(goldbook:14833))
AnnotationAssertion(rdfs:label goldbook:14833 "maximum likelihood estimation")
AnnotationAssertion(dcterms:description goldbook:14833 "Parametric method used to fit dose- or concentration-effect data to the log-normal, log-logistic, or other models.")
Declaration(Class(goldbook:14834))
AnnotationAssertion(rdfs:label goldbook:14834 "mean absorption time")
AnnotationAssertion(dcterms:description goldbook:14834 "Mean time required for absorption of a drug or contaminant calculated as the difference in mean residence time (MRT) of the material introduced by the (noninstantaneous) route of interest and the MRT for the same material injected intravenously.")
Declaration(Class(goldbook:14835))
AnnotationAssertion(rdfs:label goldbook:14835 "mean generation time")
AnnotationAssertion(dcterms:description goldbook:14835 "Average time interval required for a bacterial cell to divide or for the population to double under a defined set of conditions.")
Declaration(Class(goldbook:14836))
AnnotationAssertion(rdfs:label goldbook:14836 "measurement endpoint")
AnnotationAssertion(dcterms:description goldbook:14836 "Measurable response to a stressor (e.g., fledglings produced per nest each year) that is related to the valued qualities of the assessment endpoint (e.g., reproductive success of bald eagles).")
Declaration(Class(goldbook:14837))
AnnotationAssertion(rdfs:label goldbook:14837 "median effective time")
AnnotationAssertion(dcterms:description goldbook:14837 "For sublethal or ambiguously lethal effects, the median time until \\(\\pu{50\\%}\\) of the exposed individuals respond.")
Declaration(Class(goldbook:14838))
AnnotationAssertion(rdfs:label goldbook:14838 "median inhibitory time")
AnnotationAssertion(dcterms:description goldbook:14838 "Time required for a toxicant to inhibit a specified process in \\(\\pu{50\\%}\\) of a population under test conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14838 "inhibitory time (IT)")
Declaration(Class(goldbook:14839))
AnnotationAssertion(rdfs:label goldbook:14839 "median time to death")
AnnotationAssertion(dcterms:description goldbook:14839 "Median time resulting in death for \\(\\pu{50\\%}\\) of the exposed organisms.")
Declaration(Class(goldbook:14840))
AnnotationAssertion(rdfs:label goldbook:14840 "median tolerance limit")
AnnotationAssertion(dcterms:description goldbook:14840 "Concentration of a substance in air, water, sediment, or soil at which \\(\\pu{50\\%}\\) of the test organisms survive after a specified time of exposure. The \\(\\pu{TL_{50}}\\) (equivalent to the \\(\\pu{TL_{m}}\\)) is usually expressed as a time-dependent value (e.g., \\(\\pu{24\\!\\mbox{-}h}\\) or \\(\\pu{96\\!\\mbox{-}h}\\) \\(\\pu{TL_{50}}\\); the estimated concentration at which \\(\\pu{50\\%}\\) of test organisms survive after \\(\\pu{24 h}\\) or \\(\\pu{96 h}\\) of exposure).")
Declaration(Class(goldbook:14841))
AnnotationAssertion(rdfs:label goldbook:14841 "meiofauna")
AnnotationAssertion(dcterms:description goldbook:14841 "Small benthic invertebrates living in interstices of soil or sediment or in aquatic systems.")
Declaration(Class(goldbook:14842))
AnnotationAssertion(rdfs:label goldbook:14842 "meiotic drive")
AnnotationAssertion(dcterms:description goldbook:14842 "Any process that causes some alleles to be over-represented in the gametes which are formed during meiosis.")
Declaration(Class(goldbook:14843))
AnnotationAssertion(rdfs:label goldbook:14843 "melanic forms")
AnnotationAssertion(dcterms:description goldbook:14843 "Individuals or subspecies with increased dark pigmentation.")
Declaration(Class(goldbook:14844))
AnnotationAssertion(rdfs:label goldbook:14844 "melanism")
AnnotationAssertion(dcterms:description goldbook:14844 "Increased black or nearly black pigmentation of skin, feathers, or hair of an organism, resulting from (increased) synthesis of melanin.")
Declaration(Class(goldbook:14845))
AnnotationAssertion(rdfs:label goldbook:14845 "Mendelism")
AnnotationAssertion(dcterms:description goldbook:14845 "Fundamental principles of inheritance (especially the laws of segregation and independent assortment and the existence of dominant and recessive characters), propounded originally by Gregor Mendel (1822–1884) and forming the basis for the science of classical genetics.")
Declaration(Class(goldbook:14846))
AnnotationAssertion(rdfs:label goldbook:14846 "mesocosm")
AnnotationAssertion(dcterms:description goldbook:14846 "Enclosed and essentially self-sufficient (but not necessarily isolated) experimental environment or ecosystem that is on a larger scale than a laboratory microcosm.")
Declaration(Class(goldbook:14847))
AnnotationAssertion(rdfs:label goldbook:14847 "meta-analysis")
AnnotationAssertion(dcterms:description goldbook:14847 "Process of using statistical methods to combine the results of different studies. In the biomedical sciences, the systematic evaluation of a problem using information (commonly in the form of statistical tables and other data) from a number of independent studies.")
Declaration(Class(goldbook:14848))
AnnotationAssertion(rdfs:label goldbook:14848 "metallothionein-like proteins")
AnnotationAssertion(dcterms:description goldbook:14848 "Poorly characterized, cysteine-rich metal-binding proteins or proteins not conforming precisely to the classic properties of metallothioneins.")
Declaration(Class(goldbook:14849))
AnnotationAssertion(rdfs:label goldbook:14849 "metameter")
AnnotationAssertion(dcterms:description goldbook:14849 "Measurement or a transformation of a measurement used in the analysis of biological tests, e.g., the probit metameter.")
Declaration(Class(goldbook:14850))
AnnotationAssertion(rdfs:label goldbook:14850 "metapopulation")
AnnotationAssertion(dcterms:description goldbook:14850 "Set of local populations which interact via dispersing individuals among local populations; though not all local populations in a metapopulation need interact directly with every other local population.")
Declaration(Class(goldbook:14851))
AnnotationAssertion(rdfs:label goldbook:14851 "method of multiple working hypotheses")
AnnotationAssertion(dcterms:description goldbook:14851 "Method proposed to reduce precipitate explanation by considering all plausible hypotheses simultaneously in testing so that equal amounts of effort and attention are provided to each.")
Declaration(Class(goldbook:14852))
AnnotationAssertion(rdfs:label goldbook:14852 "microcosm")
AnnotationAssertion(dcterms:description goldbook:14852 "Artificial multi-species test system that simulates major characteristics of the natural environment for the purposes of ecotoxicological effects and risk assessment; such systems are normally terrestrial or aquatic and may contain plants, animals (vertebrates and invertebrates), and microorganisms.")
Declaration(Class(goldbook:14853))
AnnotationAssertion(rdfs:label goldbook:14853 "microevolution")
AnnotationAssertion(dcterms:description goldbook:14853 "Evolutionary change below the species level; a small change in the genetic make-up of a population from generation to generation.")
Declaration(Class(goldbook:14854))
AnnotationAssertion(rdfs:label goldbook:14854 "microphyte")
AnnotationAssertion(dcterms:description goldbook:14854 "Plant of microscopic size.")
Declaration(Class(goldbook:14855))
AnnotationAssertion(rdfs:label goldbook:14855 "Microtox® test")
AnnotationAssertion(dcterms:description goldbook:14855 "Test involving luminescent marine bacteria of the Vibrio sp. [e.g., V. (Photobacterium) phosphoreum, V. fischeri, V. harveyi]. A decrease in bioluminescence is thought to reflect toxic action.")
Declaration(Class(goldbook:14856))
AnnotationAssertion(rdfs:label goldbook:14856 "mineral")
AnnotationAssertion(dcterms:description goldbook:14856 "Naturally occurring substance, usually crystalline, which has a particular chemical composition and specific physical properties.")
Declaration(Class(goldbook:14857))
AnnotationAssertion(rdfs:label goldbook:14857 "minimum significant difference")
AnnotationAssertion(dcterms:description goldbook:14857 "Difference between groups (in tests with, e.g., salmonid fish, the difference in average weights or average mortality) that would have to occur before it could be concluded that there was a significant difference between the groups.")
Declaration(Class(goldbook:14858))
AnnotationAssertion(rdfs:label goldbook:14858 "minimal time to effect or response")
AnnotationAssertion(dcterms:description goldbook:14858 "Minimum time required to get an effect or response. Regardless of the toxicant concentration, the effect, or response, cannot occur any faster than this minimum time.")
Declaration(Class(goldbook:14859))
AnnotationAssertion(rdfs:label goldbook:14859 "minimum viable population")
AnnotationAssertion(dcterms:description goldbook:14859 "Smallest population size of a species allowing survival in the wild.")
Declaration(Class(goldbook:14860))
AnnotationAssertion(rdfs:label goldbook:14860 "mixing zone")
AnnotationAssertion(dcterms:description goldbook:14860 "Area where an effluent discharge undergoes initial dilution and is extended to cover the secondary mixing in the ambient water body.")
Declaration(Class(goldbook:14861))
AnnotationAssertion(rdfs:label goldbook:14861 "model error")
AnnotationAssertion(dcterms:description goldbook:14861 "Elements of uncertainty associated with the discrepancy between the model and the real world.")
Declaration(Class(goldbook:14862))
AnnotationAssertion(rdfs:label goldbook:14862 "monitoring test")
AnnotationAssertion(dcterms:description goldbook:14862 "Test designed to be applied on a routine basis, with some degree of control, to ensure that the quality of an environmental compartment, biological endpoint, or effluent has not exceeded some prescribed criteria range. In a biomonitoring test, organisms are used as 'sensors' to detect changes in the quality of water or effluent. A monitoring test implies generation of information, on a continuous or other regular basis.")
Declaration(Class(goldbook:14863))
AnnotationAssertion(rdfs:label goldbook:14863 "Montreal protocol")
AnnotationAssertion(dcterms:description goldbook:14863 "Officially the Protocol on Substances That Deplete the Ozone Layer, a treaty signed on 16 September 1987, in Montreal by 25 nations; there are now 168 subscribing nations. The protocol sets limits on the production of chlorofluorocarbons (CFCs), halons, and related substances that release chlorine or bromine to the ozone layer of the atmosphere.")
Declaration(Class(goldbook:14864))
AnnotationAssertion(rdfs:label goldbook:14864 "morphodynamics")
AnnotationAssertion(dcterms:description goldbook:14864 "Study of the interaction and adjustment of the seafloor topography and fluid hydrodynamic processes, seafloor morphologies, and sequences of change dynamics involving the motion of sediment.")
Declaration(Class(goldbook:14865))
AnnotationAssertion(rdfs:label goldbook:14865 "mortality")
AnnotationAssertion(dcterms:description goldbook:14865 "Death rate, the number of dead individuals per unit time.")
Declaration(Class(goldbook:14866))
AnnotationAssertion(rdfs:label goldbook:14866 "most-sensitive-species approach")
AnnotationAssertion(dcterms:description goldbook:14866 "Ecotoxicological approach in which results for the most sensitive of all tested species are used as an indicator of the toxicant concentration below which the entire community is protected from adverse effects.")
Declaration(Class(goldbook:14867))
AnnotationAssertion(rdfs:label goldbook:14867 "moving average method")
AnnotationAssertion(dcterms:description goldbook:14867 "Method of estimating \\(\\pu{LC_{50}}\\), \\(\\pu{EC_{50}}\\), or \\(\\pu{LD_{50}}\\). It can be implemented with straightforward equations if the toxicant concentrations are set in a geometric series and there are equal numbers of individuals exposed in each treatment.")
Declaration(Class(goldbook:14868))
AnnotationAssertion(rdfs:label goldbook:14868 "multiple heterosis")
AnnotationAssertion(dcterms:description goldbook:14868 "Higher fitness of an individual as a composite or summed effect of heterozygote superiority (heterosis) at each of a series of loci.")
Declaration(Class(goldbook:14869))
AnnotationAssertion(rdfs:label goldbook:14869 "mutualism")
AnnotationAssertion(dcterms:description goldbook:14869 "Interaction between two or more species, giving fitness benefit to all the involved species, e.g., increased carrying capacity.")
Declaration(Class(goldbook:14870))
AnnotationAssertion(rdfs:label goldbook:14870 "National Academy of Sciences paradigm of risk assessment")
AnnotationAssertion(dcterms:description goldbook:14870 "Model for risk assessment with four components—hazard identification, exposure assessment, dose–response assessment, and risk characterization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14870 "NAS paradigm of risk assessment")
Declaration(Class(goldbook:14871))
AnnotationAssertion(rdfs:label goldbook:14871 "natural selection")
AnnotationAssertion(dcterms:description goldbook:14871 "Evolutionary theory, originally proposed by Darwin, of the preferential survival and reproduction of organisms better adapted to their environment as a result of genetic adaptation.")
Declaration(Class(goldbook:14872))
AnnotationAssertion(rdfs:label goldbook:14872 "natural radiation background")
AnnotationAssertion(dcterms:description goldbook:14872 "Cosmic radiation emitted from stars and long-lived terrestrial radionuclides that are ubiquitously present in the Earth’s soils.")
Declaration(Class(goldbook:14873))
AnnotationAssertion(rdfs:label goldbook:14873 "nekton")
AnnotationAssertion(dcterms:description goldbook:14873 "Aggregate of actively swimming animals in a body of water ranging from microscopic organisms to whales.")
Declaration(Class(goldbook:14874))
AnnotationAssertion(rdfs:label goldbook:14874 "neo-Darwinism")
AnnotationAssertion(dcterms:description goldbook:14874 "Theory of biological evolution (widely accepted since the 1920s) based on Darwin’s theory of natural selection but incorporating the theories of later biologists regarding genes, inheritance, and mutation, particularly those of Weismann and Mendel.")
Declaration(Class(goldbook:14875))
AnnotationAssertion(rdfs:label goldbook:14875 "neophyte")
AnnotationAssertion(dcterms:description goldbook:14875 "Plant found newly in an area where it had not been recorded previously.")
Declaration(Class(goldbook:14876))
AnnotationAssertion(rdfs:label goldbook:14876 "net reproductive rate")
AnnotationAssertion(dcterms:description goldbook:14876 "Expected number of females to be produced during the lifetime of a newborn female as estimated with a life table.")
Declaration(Class(goldbook:14877))
AnnotationAssertion(rdfs:label goldbook:14877 "niche")
AnnotationAssertion(dcterms:description goldbook:14877 "Group of conditions and resources, facilitating but limiting survival, growth, and reproduction of a defined group of organisms or species.")
Declaration(Class(goldbook:14878))
AnnotationAssertion(rdfs:label goldbook:14878 "niche preemption")
AnnotationAssertion(dcterms:description goldbook:14878 "Rapid use and preemption of resources by a species that exploits them to the exclusion or severe disadvantage of another species.")
Declaration(Class(goldbook:14879))
AnnotationAssertion(rdfs:label goldbook:14879 "niche width")
AnnotationAssertion(dcterms:description goldbook:14879 "Term referring to the area which a species could physically inhabit.")
Declaration(Class(goldbook:14880))
AnnotationAssertion(rdfs:label goldbook:14880 "not in my backyard principle")
AnnotationAssertion(dcterms:description goldbook:14880 "Public acceptance of necessary provisions (e.g., waste incinerators) provided they do not affect the individual’s quality of life.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14880 "NIMBY principle")
Declaration(Class(goldbook:14881))
AnnotationAssertion(rdfs:label goldbook:14881 "nine aspects of disease association")
AnnotationAssertion(dcterms:description goldbook:14881 "Nine aspects of evidence, defined by Bradford-Hill (1965), fostering the accuracy of linkage between a risk factor and disease: strength of association, consistency of association, specificity of association, temporal association, biological gradient (dose-response) in the association, biological plausibility, coherence of the association, experimental support of association, and analogy.")
Declaration(Class(goldbook:14882))
AnnotationAssertion(rdfs:label goldbook:14882 "\"no action\" alternative")
AnnotationAssertion(dcterms:description goldbook:14882 "Scenario in which one assesses if the contaminants at the waste site pose, or will pose in the future, a risk if left alone.")
Declaration(Class(goldbook:14883))
AnnotationAssertion(rdfs:label goldbook:14883 "nonstochastic health effects")
AnnotationAssertion(dcterms:description goldbook:14883 "Effects that are dependent on the magnitude of the dose in excess of a threshold.")
Declaration(Class(goldbook:14884))
AnnotationAssertion(rdfs:label goldbook:14884 "nontarget organisms")
AnnotationAssertion(dcterms:description goldbook:14884 "Organisms that are not the intended targets of a particular use of a pesticide.")
Declaration(Class(goldbook:14885))
AnnotationAssertion(rdfs:label goldbook:14885 "no-observed-effect concentration")
AnnotationAssertion(dcterms:description goldbook:14885 "Special case of the no-observed-effect level (NOEL), commonly used in aquatic toxicology.")
Declaration(Class(goldbook:14886))
AnnotationAssertion(rdfs:label goldbook:14886 "no-response level")
AnnotationAssertion(dcterms:description goldbook:14886 "Maximum dose of a substance at which no specified response is observed in a defined population and under defined conditions of exposure.")
Declaration(Class(goldbook:14887))
AnnotationAssertion(rdfs:label goldbook:14887 "normit")
AnnotationAssertion(dcterms:description goldbook:14887 "Metameter equal to the normal equivalent deviation (NED). The resulting analysis of dose– or concentration-effect data with the normit metameter is often called normit analysis and is essentially equivalent to probit analysis.")
Declaration(Class(goldbook:14888))
AnnotationAssertion(rdfs:label goldbook:14888 "numerical response")
AnnotationAssertion(dcterms:description goldbook:14888 "Change in predator or grazer number through increased reproductive output, decreased mortality, or increased immigration in response to changes in prey or food densities.")
Declaration(Class(goldbook:14889))
AnnotationAssertion(rdfs:label goldbook:14889 "octanol-air partition coefficient")
AnnotationAssertion(dcterms:description goldbook:14889 "Partition coefficient for a compound between octanol and air. Like \\(K_{\\rm{ow}}\\), it is a measure of lipophilicity.")
Declaration(Class(goldbook:14890))
AnnotationAssertion(rdfs:label goldbook:14890 "octanol-water partition coefficient")
AnnotationAssertion(dcterms:description goldbook:14890 "Ratio of the solubility of a chemical in octanol to its solubility in water at equilibrium.")
Declaration(Class(goldbook:14891))
AnnotationAssertion(rdfs:label goldbook:14891 "octaves")
AnnotationAssertion(dcterms:description goldbook:14891 "Log2 classes (e.g., 1–2, 2–4, 4–8, 8–16, 16–32,... individuals) used in species-abundance curves and representing doubling of the numbers of individuals in a species.")
Declaration(Class(goldbook:14892))
AnnotationAssertion(rdfs:label goldbook:14892 "Oklo natural reactors")
AnnotationAssertion(dcterms:description goldbook:14892 "Naturally occurring nuclear reactors arising through biogeochemical processes approximately 1.8 billion years ago in Oklo (Gabon, Africa).")
Declaration(Class(goldbook:14893))
AnnotationAssertion(rdfs:label goldbook:14893 "oligotrophic")
AnnotationAssertion(dcterms:description goldbook:14893 "Describing an environment having a low concentration of nutrients.")
Declaration(Class(goldbook:14894))
AnnotationAssertion(rdfs:label goldbook:14894 "oligotrophy")
AnnotationAssertion(dcterms:description goldbook:14894 """State of being oligotrophic.
Obligate or facultative capacity to live in low-nutrient habitats.""")
Declaration(Class(goldbook:14895))
AnnotationAssertion(rdfs:label goldbook:14895 "optimal-foraging theory")
AnnotationAssertion(dcterms:description goldbook:14895 "Theory that the ideal forager will obtain a maximum net rate of energy gain by optimally allocating its time and energy to the various components of foraging.")
Declaration(Class(goldbook:14896))
AnnotationAssertion(rdfs:label goldbook:14896 "optimal stress response")
AnnotationAssertion(dcterms:description goldbook:14896 "Optimal stress response involves a shift in the balance in energy allocation between somatic growth rate and longevity (survival) to optimize Darwinian fitness under stressful conditions.")
Declaration(Class(goldbook:14897))
AnnotationAssertion(rdfs:label goldbook:14897 "ozone layer")
AnnotationAssertion(dcterms:description goldbook:14897 "Part of the Earth’s atmosphere, mainly located in the lower portion of the stratosphere, approximately \\(\\pu{15\\!-\\! 35 km}\\) above the Earth's surface, containing relatively high concentrations (a few micromoles per litre) of ozone (\\(\\ce{O3}\\)) which is higher than concentrations in the lower atmosphere. The thickness varies seasonally and geographically.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14897 "ozonosphere")
Declaration(Class(goldbook:14898))
AnnotationAssertion(rdfs:label goldbook:14898 "palaeontology")
AnnotationAssertion(dcterms:description goldbook:14898 "Branch of science that deals with extinct and fossil humans, animals, and plants, or more generally with evidence of organic life during the geological past.")
Declaration(Class(goldbook:14899))
AnnotationAssertion(rdfs:label goldbook:14899 "paradigm")
AnnotationAssertion(dcterms:description goldbook:14899 """Model or template.
Body of concepts that, in a particular branch of science, has withstood rigorous testing, and is generally accepted by scientists working in that field as offering true explanations of fact and observation.Note: This usage is derived from the work of the philosopher T. S. Kuhn (1922–1996).""")
Declaration(Class(goldbook:14900))
AnnotationAssertion(rdfs:label goldbook:14900 "partial kill")
AnnotationAssertion(dcterms:description goldbook:14900 "Treatment in a toxicity test in which some, but not all, exposed individuals are killed.")
Declaration(Class(goldbook:14901))
AnnotationAssertion(rdfs:label goldbook:14901 "pathway")
AnnotationAssertion(dcterms:description goldbook:14901 "Sequence of enzymatic or other reactions by which one biological material is converted to another.")
Declaration(Class(goldbook:14902))
AnnotationAssertion(rdfs:label goldbook:14902 "pedosphere")
AnnotationAssertion(dcterms:description goldbook:14902 "Part of the Earth made up of soils and where important soil processes are occurring.")
Declaration(Class(goldbook:14903))
AnnotationAssertion(rdfs:label goldbook:14903 "pelagic")
AnnotationAssertion(dcterms:description goldbook:14903 "Of or relating to the open sea, as distinguished from the shallow water near the coast; dwelling on or near the surface of the open sea or ocean; oceanic. Now chiefly: (Ecology) designating, relating to, or inhabiting that region of the sea which consists of open water of any depth, away from or independent of both the shore and the sea floor (and so contrasted with the littoral and benthic regions).")
Declaration(Class(goldbook:14904))
AnnotationAssertion(rdfs:label goldbook:14904 "per capita birth rate")
AnnotationAssertion(dcterms:description goldbook:14904 "Average number of offspring per population member per time unit. Calculated from birth rate \\(B\\) and population size \\(N\\) as \\[b = B/N\\]")
Declaration(Class(goldbook:14905))
AnnotationAssertion(rdfs:label goldbook:14905 "per capita death rate")
AnnotationAssertion(dcterms:description goldbook:14905 "Average number of deaths per population member per time unit. Calculated from death rate \\(D\\) and population size \\(N\\) as \\[m = D/N\\]")
Declaration(Class(goldbook:14906))
AnnotationAssertion(rdfs:label goldbook:14906 "per capita rate of increase")
AnnotationAssertion(dcterms:description goldbook:14906 "Relative increase, \\(r\\), in the population per unit of time expressed per capita. \\[r = b - m\\] where \\(b\\) is per capita birth rate and \\(m\\) is per capita death rate.")
Declaration(Class(goldbook:14907))
AnnotationAssertion(rdfs:label goldbook:14907 "periphyton")
AnnotationAssertion(dcterms:description goldbook:14907 "Matrix of algae, microbes, and detritus attached to submerged surfaces in aquatic ecosystems.")
Declaration(Class(goldbook:14908))
AnnotationAssertion(rdfs:label goldbook:14908 "persistent inorganic pollutant")
AnnotationAssertion(dcterms:description goldbook:14908 "Inorganic substance that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment.")
Declaration(Class(goldbook:14909))
AnnotationAssertion(rdfs:label goldbook:14909 "persistent organic pollutant")
AnnotationAssertion(dcterms:description goldbook:14909 "Organic chemical that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14909 "bioaccumulative chemicals of concern (BCC)")
Declaration(Class(goldbook:14910))
AnnotationAssertion(rdfs:label goldbook:14910 "phenology")
AnnotationAssertion(dcterms:description goldbook:14910 "Life history.")
Declaration(Class(goldbook:14911))
AnnotationAssertion(rdfs:label goldbook:14911 "photoperiod")
AnnotationAssertion(dcterms:description goldbook:14911 "The duration of illumination and darkness over a \\(\\pu{24\\!\\mbox{-}h}\\) day.")
Declaration(Class(goldbook:14912))
AnnotationAssertion(rdfs:label goldbook:14912 "pH-partition hypothesis")
AnnotationAssertion(dcterms:description goldbook:14912 "Hypothesis that bioavailability is governed by the diffusion of the unionized form of an ionizable substance through the gastrointestinal lumen, as determined by \\(\\pu{p}K_{\\rm{a}}\\) and \\(\\rm{pH}\\).")
Declaration(Class(goldbook:14913))
AnnotationAssertion(rdfs:label goldbook:14913 "phylogenetics")
AnnotationAssertion(dcterms:description goldbook:14913 "Branch of biology that deals with phylogeny, especially with the deduction of the historical relationships between groups of organisms.")
Declaration(Class(goldbook:14914))
AnnotationAssertion(rdfs:label goldbook:14914 "phylogeny")
AnnotationAssertion(dcterms:description goldbook:14914 "Pattern of historical relationships between species or other groups resulting from divergence during evolution.")
Declaration(Class(goldbook:14915))
AnnotationAssertion(rdfs:label goldbook:14915 "phylum")
AnnotationAssertion(dcterms:description goldbook:14915 "Taxonomic rank at the level below Kingdom and above Class")
Declaration(Class(goldbook:14916))
AnnotationAssertion(rdfs:label goldbook:14916 "physiological adaptation")
AnnotationAssertion(dcterms:description goldbook:14916 """Change in an organism, in response to changing conditions of the environment, which takes place without any irreversible disruptions of the given biological system and without exceeding normal (homeostatic) capacities of its response.
Process by which an organism stabilizes its physiological condition after an environmental change.Note: If this process exceeds the homeostatic range, it becomes pathological and results in symptoms of disease (adverse effects).""")
Declaration(Class(goldbook:14917))
AnnotationAssertion(rdfs:label goldbook:14917 "phytochelatin")
AnnotationAssertion(dcterms:description goldbook:14917 "Class of cysteine-rich peptides in plants that are induced by and bind to metals. They can function in the regulation and detoxification of metals by plants.")
Declaration(Class(goldbook:14918))
AnnotationAssertion(rdfs:label goldbook:14918 "phytoplankton")
AnnotationAssertion(dcterms:description goldbook:14918 "Photosynthesizing organisms found in the plankton.")
Declaration(Class(goldbook:14919))
AnnotationAssertion(rdfs:label goldbook:14919 "phytotoxic")
AnnotationAssertion(dcterms:description goldbook:14919 "Toxic to plants.")
Declaration(Class(goldbook:14920))
AnnotationAssertion(rdfs:label goldbook:14920 "Pielou’s <i>J</i>")
AnnotationAssertion(dcterms:description goldbook:14920 "Measure of species evenness for a sample from a community. It is calculated from the following equation: \\[{\\rm{Pielouߴs}}\\ J = \\frac{H'}{\\log S}\\] where \\(H'\\) is the Shannon–Wiener diversity measure and \\(S\\) is the average species richness.")
Declaration(Class(goldbook:14921))
AnnotationAssertion(rdfs:label goldbook:14921 "pinnipeds")
AnnotationAssertion(dcterms:description goldbook:14921 "Seals, sea lions, and walruses.")
Declaration(Class(goldbook:14922))
AnnotationAssertion(rdfs:label goldbook:14922 "piscivorous")
AnnotationAssertion(dcterms:description goldbook:14922 "Feeding on fish.")
Declaration(Class(goldbook:14923))
AnnotationAssertion(rdfs:label goldbook:14923 "planktivorous")
AnnotationAssertion(dcterms:description goldbook:14923 "Feeding on plankton.")
Declaration(Class(goldbook:14924))
AnnotationAssertion(rdfs:label goldbook:14924 "plankton")
AnnotationAssertion(dcterms:description goldbook:14924 "Organisms living suspended in the water column and incapable of moving against water currents.")
Declaration(Class(goldbook:14925))
AnnotationAssertion(rdfs:label goldbook:14925 "planktotrophic larva")
AnnotationAssertion(dcterms:description goldbook:14925 "Planktonic-dispersing larva that derives its nourishment by feeding in the plankton.")
Declaration(Class(goldbook:14926))
AnnotationAssertion(rdfs:label goldbook:14926 "poikilotherm")
AnnotationAssertion(dcterms:description goldbook:14926 "'Cold-blooded organism' (such as an amphibian, reptile, or fish) with a body temperature varying with, but usually slightly higher than, the temperature of its environment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14926 "ectotherm")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14926 "exotherm")
Declaration(Class(goldbook:14927))
AnnotationAssertion(rdfs:label goldbook:14927 "point source")
AnnotationAssertion(dcterms:description goldbook:14927 "Single emission source in a defined location.")
Declaration(Class(goldbook:14928))
AnnotationAssertion(rdfs:label goldbook:14928 "pollutant")
AnnotationAssertion(dcterms:description goldbook:14928 "Any undesirable solid, liquid, or gaseous matter occurring, as a result of human activities, in a solid, liquid, or gaseous environmental medium and causing adverse effects.")
Declaration(Class(goldbook:14929))
AnnotationAssertion(rdfs:label goldbook:14929 "pollution-induced community tolerance")
AnnotationAssertion(dcterms:description goldbook:14929 "Increase in tolerance to pollution resulting from species composition shifts in the community, acclimatization of individuals, and genetic changes in populations in the community.")
Declaration(Class(goldbook:14930))
AnnotationAssertion(rdfs:label goldbook:14930 "pollution tolerance index")
AnnotationAssertion(dcterms:description goldbook:14930 "Means of measuring environmental quality, usually water quality, by determining the presence of indicator species, classified into three groups—sensitive, facultative, and tolerant. Each group is assigned an index value 1, 2, and 3, with the sensitive group having the highest index value. The number of species present from the list included in each group is identified in a representative environmental sample and the group index multiplied by the number of species in the group. The scores for each group are finally added to give the PTI for the environmental medium under consideration. The environmental quality is directly proportional to the value of the index.")
Declaration(Class(goldbook:14931))
AnnotationAssertion(rdfs:label goldbook:14931 "polygenic control")
AnnotationAssertion(dcterms:description goldbook:14931 "Control of a phenotypic trait by several genes.")
Declaration(Class(goldbook:14932))
AnnotationAssertion(rdfs:label goldbook:14932 "population")
AnnotationAssertion(dcterms:description goldbook:14932 "In ecology, any group of interacting and interbreeding organisms of the same species occupying a given area at the same time.")
Declaration(Class(goldbook:14933))
AnnotationAssertion(rdfs:label goldbook:14933 "population biomass")
AnnotationAssertion(dcterms:description goldbook:14933 "Total mass or weight of organisms in a population, given by the sum of the masses (or weights) of all the individual members of the population.")
Declaration(Class(goldbook:14934))
AnnotationAssertion(rdfs:label goldbook:14934 "population cycle")
AnnotationAssertion(dcterms:description goldbook:14934 "Changes in the numbers of individuals in a population that repeatedly oscillate between periods of high and low density.")
Declaration(Class(goldbook:14935))
AnnotationAssertion(rdfs:label goldbook:14935 "population density")
AnnotationAssertion(dcterms:description goldbook:14935 "Number of individuals divided by area (\\(\\pu{m-2}\\)) or volume (\\(\\pu{m-3}\\)).")
Declaration(Class(goldbook:14936))
AnnotationAssertion(rdfs:label goldbook:14936 "population dynamics")
AnnotationAssertion(dcterms:description goldbook:14936 "Variations in time and space in the sizes and densities of populations.")
Declaration(Class(goldbook:14937))
AnnotationAssertion(rdfs:label goldbook:14937 "population ecology")
AnnotationAssertion(dcterms:description goldbook:14937 "Study of the variations in time and space in the sizes and densities of populations, and of the factors causing these variations.")
Declaration(Class(goldbook:14938))
AnnotationAssertion(rdfs:label goldbook:14938 "population fluctuation")
AnnotationAssertion(dcterms:description goldbook:14938 "Variations over time in the size of a population.")
Declaration(Class(goldbook:14939))
AnnotationAssertion(rdfs:label goldbook:14939 "population growth rate")
AnnotationAssertion(dcterms:description goldbook:14939 "Change in population size \\(\\Delta N\\) during a specified time period \\(\\Delta t\\) \\[\\Delta N/\\Delta t = (b - d)N\\] where \\(N\\) is population size, \\(b\\) is per capita birth rate, and \\(d\\) is per capita death rate.")
Declaration(Class(goldbook:14940))
AnnotationAssertion(rdfs:label goldbook:14940 "population pyramid")
AnnotationAssertion(dcterms:description goldbook:14940 "Diagrammatic illustration of the age structure of a population by depicting the youngest age class at the base and stacking successive age classes above it.")
Declaration(Class(goldbook:14941))
AnnotationAssertion(rdfs:label goldbook:14941 "population size")
AnnotationAssertion(dcterms:description goldbook:14941 "Total number of organisms in a population.")
Declaration(Class(goldbook:14942))
AnnotationAssertion(rdfs:label goldbook:14942 "porous pot test")
AnnotationAssertion(dcterms:description goldbook:14942 "Biodegradation test that simulates the continuous activated sludge (sewage treatment) system.")
Declaration(Class(goldbook:14943))
AnnotationAssertion(rdfs:label goldbook:14943 "precautionary principle")
AnnotationAssertion(dcterms:description goldbook:14943 "Approach to risk management that can be applied in circumstances of scientific uncertainty, reflecting a perceived need to take action in the face of a potentially serious risk without waiting for definitive results of scientific research.")
Declaration(Class(goldbook:14944))
AnnotationAssertion(rdfs:label goldbook:14944 "predicted environmental concentration")
AnnotationAssertion(dcterms:description goldbook:14944 "Concentration of a substance likely to be found in an environmental compartment calculated from estimates of quantities released, discharge patterns, and inherent disposition of the substance (fate and distribution) as well as the nature of the specific receiving ecosystems.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14944 "estimated environmental concentration (EEC)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14944 "expected environmental concentration (EEC)")
Declaration(Class(goldbook:14945))
AnnotationAssertion(rdfs:label goldbook:14945 "predicted no-effect concentration")
AnnotationAssertion(dcterms:description goldbook:14945 "Concentration that is expected to cause no adverse effect to any naturally occurring population in an environment at risk from exposure to a given substance.")
Declaration(Class(goldbook:14946))
AnnotationAssertion(rdfs:label goldbook:14946 "predictive risk assessment")
AnnotationAssertion(dcterms:description goldbook:14946 "Risk assessment performed for a proposed future action, such as the use of a new chemical or the release of a new effluent.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14946 "prospective risk assessment")
Declaration(Class(goldbook:14947))
AnnotationAssertion(rdfs:label goldbook:14947 "prevalence")
AnnotationAssertion(dcterms:description goldbook:14947 "Number of instances of existing cases of a given disease or other condition in a given population at a designated time; sometimes used to mean prevalence rate.")
Declaration(Class(goldbook:14948))
AnnotationAssertion(rdfs:label goldbook:14948 "prevalence rate")
AnnotationAssertion(dcterms:description goldbook:14948 "Total number of individuals who have an attribute or disease at a particular time (or during a particular period) divided by the population at risk of having the attribute or disease at this point in time or midway through the period.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14948 "prevalence ratio")
Declaration(Class(goldbook:14949))
AnnotationAssertion(rdfs:label goldbook:14949 "primary lamellae")
AnnotationAssertion(dcterms:description goldbook:14949 "Gill structures extending outward at right angles from the branchial arches.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14949 "filaments")
Declaration(Class(goldbook:14950))
AnnotationAssertion(rdfs:label goldbook:14950 "primary producer")
AnnotationAssertion(dcterms:description goldbook:14950 "Organism capable of using the energy derived from light or a chemical substance in order to manufacture energy-rich organic compounds.")
Declaration(Class(goldbook:14951))
AnnotationAssertion(rdfs:label goldbook:14951 "primary succession")
AnnotationAssertion(dcterms:description goldbook:14951 "Sequential colonization by species which begin to colonize the bare ground and modify the environmental conditions after a region is completely denuded; e.g., behind a retreating glacier, early colonizing organisms provide the soils needed by succeeding organisms.")
Declaration(Class(goldbook:14952))
AnnotationAssertion(rdfs:label goldbook:14952 "principle of allocation")
AnnotationAssertion(dcterms:description goldbook:14952 "Concept that there exists a cost or trade-off to every allocation of energy resources. Energy spent by an individual organism on one function, process, or structure cannot be spent on another. Optimal allocation of resources enhances Darwinian fitness.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14952 "concept of strategy")
Declaration(Class(goldbook:14953))
AnnotationAssertion(rdfs:label goldbook:14953 "probit")
AnnotationAssertion(dcterms:description goldbook:14953 "Probability unit obtained by adding 5 to the normal deviates of a standardized normal distribution of results from a dose-response study.")
Declaration(Class(goldbook:14954))
AnnotationAssertion(rdfs:label goldbook:14954 "probit log transform")
AnnotationAssertion(dcterms:description goldbook:14954 "Probability unit obtained from the standardized normal distribution plotted against the logarithm of the concentration or dose of a substance when a quantal or graded response has been measured. A linear plot provides evidence that the distribution is log-normal. Estimates of the \\(\\pu{L(E)C_{50}}\\) and \\(\\pu{L(E)D_{50}}\\), as well as the standard deviation for the distribution, can then be made.")
Declaration(Class(goldbook:14955))
AnnotationAssertion(rdfs:label goldbook:14955 "problem formulation")
AnnotationAssertion(dcterms:description goldbook:14955 "Planning and scoping phase that establishes the framework around which the risk assessment is done.")
Declaration(Class(goldbook:14956))
AnnotationAssertion(rdfs:label goldbook:14956 "product-limit method")
AnnotationAssertion(dcterms:description goldbook:14956 "Nonparametric method for analyzing time-to-death or survival-time data that does not require a specific model for the survival curve.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14956 "Kaplan–Meier method")
Declaration(Class(goldbook:14957))
AnnotationAssertion(rdfs:label goldbook:14957 "proliferation")
AnnotationAssertion(dcterms:description goldbook:14957 "Multiplication, i.e., an increase by frequent and repeated reproduction or growth by cell division.")
Declaration(Class(goldbook:14958))
AnnotationAssertion(rdfs:label goldbook:14958 "propagule")
AnnotationAssertion(dcterms:description goldbook:14958 """Portion of a plant, fungus, etc., that is capable, when detached, of giving rise to a new individual by asexual reproduction (e.g., a cutting, leaf bud, bulbil, seed, or spore).
Less commonly, any of the products of asexual reproduction in certain invertebrates.""")
Declaration(Class(goldbook:14959))
AnnotationAssertion(rdfs:label goldbook:14959 "propagule rain")
AnnotationAssertion(dcterms:description goldbook:14959 "Relative to metapopulation dynamics, the presence of a seed bank or dormant stage for a species that continually introduces individuals to the patch regardless of the density of occupancy in the surrounding patches. This propagule rain increases the likelihood of population reappearance and decreases the likelihood of patch extinction.")
Declaration(Class(goldbook:14960))
AnnotationAssertion(rdfs:label goldbook:14960 "Ptolemaic incongruity")
AnnotationAssertion(dcterms:description goldbook:14960 "False assertion that any particular level of biological organization holds a more central or important role than any other in the science of ecotoxicology.")
Declaration(Class(goldbook:14961))
AnnotationAssertion(rdfs:label goldbook:14961 "pyrogenic")
AnnotationAssertion(dcterms:description goldbook:14961 """Describing anything that causes fire.
Describing products of fire; e.g., organic compounds produced by the high-temperature combustion of complex organic substances are pyrogenic compounds.Examples: Polycyclic aromatic hydrocarbons (PAHs) are examples of pyrogenic compounds.
Describing a substance that produces fever.""")
Declaration(Class(goldbook:14962))
AnnotationAssertion(rdfs:label goldbook:14962 "quality criteria")
AnnotationAssertion(dcterms:description goldbook:14962 "Quality guidelines based on the evaluation of scientific data.")
Declaration(Class(goldbook:14963))
AnnotationAssertion(rdfs:label goldbook:14963 "quality guidelines")
AnnotationAssertion(dcterms:description goldbook:14963 "Numerical limits or text statements established to support and maintain designated uses of the environment or to protect human health.")
Declaration(Class(goldbook:14964))
AnnotationAssertion(rdfs:label goldbook:14964 "quality standards")
AnnotationAssertion(dcterms:description goldbook:14964 "Fixed upper limits for exposure to certain chemicals recognized under law by one or more levels of government. Well-known examples include the air, water, and soil quality standards, as well as threshold limit values for air pollutants in the workplace.")
Declaration(Class(goldbook:14965))
AnnotationAssertion(rdfs:label goldbook:14965 "quantal effect")
AnnotationAssertion(dcterms:description goldbook:14965 "Condition that can be expressed only as 'occurring' or 'not occurring', such as death or occurrence of a tumor.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14965 "all-or-none effect")
Declaration(Class(goldbook:14966))
AnnotationAssertion(rdfs:label goldbook:14966 "quantitative structure–metabolism relationship")
AnnotationAssertion(dcterms:description goldbook:14966 "Quantitative association between the physicochemical and (or) the structural properties of a substance and its metabolic behavior.")
Declaration(Class(goldbook:14967))
AnnotationAssertion(rdfs:label goldbook:14967 "quotient method")
AnnotationAssertion(dcterms:description goldbook:14967 "Calculation of the quotient of the measured or predicted environmental concentration (PEC) of a contaminant and the predicted no-effect level (PNEC), used as an expression of hazard or risk. Higher quotients constitute greater evidence of a hazard or a greater risk.")
Declaration(Class(goldbook:14968))
AnnotationAssertion(rdfs:label goldbook:14968 "rain-out")
AnnotationAssertion(dcterms:description goldbook:14968 "Removal of pollutants from air by incorporation into developing rain droplets of rain clouds.")
Declaration(Class(goldbook:14969))
AnnotationAssertion(rdfs:label goldbook:14969 "rarefaction estimate of richness")
AnnotationAssertion(dcterms:description goldbook:14969 "Estimate of species richness (\\(S\\)) expressed relative to that of a sample having a standard number of individuals.")
Declaration(Class(goldbook:14970))
AnnotationAssertion(rdfs:label goldbook:14970 "rate constant-based model")
AnnotationAssertion(dcterms:description goldbook:14970 "Compartment model that employs rate constants to quantify the rate of change in concentration or amount of toxicant.")
Declaration(Class(goldbook:14971))
AnnotationAssertion(rdfs:label goldbook:14971 "rate-of-living theory of aging")
AnnotationAssertion(dcterms:description goldbook:14971 "Theory that the total metabolic expenditure of a genotype is generally fixed, and longevity depends on the rate of energy expenditure.")
Declaration(Class(goldbook:14972))
AnnotationAssertion(rdfs:label goldbook:14972 "rate ratio")
AnnotationAssertion(dcterms:description goldbook:14972 "Value obtained by dividing the rate in an exposed population by the rate in an unexposed population.")
Declaration(Class(goldbook:14973))
AnnotationAssertion(rdfs:label goldbook:14973 "realised niche")
AnnotationAssertion(dcterms:description goldbook:14973 "Portion of a species’ fundamental niche that it actually occupies.")
Declaration(Class(goldbook:14974))
AnnotationAssertion(rdfs:label goldbook:14974 "reasonable worst case")
AnnotationAssertion(dcterms:description goldbook:14974 "Semiquantitative term referring to the lower portion of the high end of the exposure, dose, or risk distribution.")
Declaration(Class(goldbook:14975))
AnnotationAssertion(rdfs:label goldbook:14975 "reasonable maximum exposure")
AnnotationAssertion(dcterms:description goldbook:14975 "Highest exposure that is reasonably expected to occur.")
Declaration(Class(goldbook:14976))
AnnotationAssertion(rdfs:label goldbook:14976 "receiving water")
AnnotationAssertion(dcterms:description goldbook:14976 "Surface water (e.g., in a stream, river, or lake) that has received, or is about to receive, a discharged waste (i.e., the surface water immediately around the discharge point).")
Declaration(Class(goldbook:14977))
AnnotationAssertion(rdfs:label goldbook:14977 "recommended limit")
AnnotationAssertion(dcterms:description goldbook:14977 "Maximum concentration of a potentially toxic substance that is expected to be safe.")
Declaration(Class(goldbook:14978))
AnnotationAssertion(rdfs:label goldbook:14978 "reconstituted water")
AnnotationAssertion(dcterms:description goldbook:14978 "De-ionized or glass-distilled water to which reagent-grade chemicals have been added. The resultant synthetic freshwater is expected to be free from contaminants and have the desired \\(\\rm{pH}\\) and hardness characteristics.")
Declaration(Class(goldbook:14979))
AnnotationAssertion(rdfs:label goldbook:14979 "redundancy hypothesis")
AnnotationAssertion(dcterms:description goldbook:14979 "Hypothesis that many species are redundant, and their loss will not influence the community function as long as crucial (e.g., keystone and dominant) species populations are maintained.")
Declaration(Class(goldbook:14980))
AnnotationAssertion(rdfs:label goldbook:14980 "reference environment")
AnnotationAssertion(dcterms:description goldbook:14980 "Generalized description of the environment into which contaminants will be released and in which organisms will be exposed. Reference environments are used when there is no specific site at risk.")
Declaration(Class(goldbook:14981))
AnnotationAssertion(rdfs:label goldbook:14981 "reference sediment")
AnnotationAssertion(dcterms:description goldbook:14981 "Whole sediment near an area of concern used to assess sediment conditions in the absence of substances of concern.")
Declaration(Class(goldbook:14982))
AnnotationAssertion(rdfs:label goldbook:14982 "reference site")
AnnotationAssertion(dcterms:description goldbook:14982 "Relatively unpolluted site used for comparison with polluted sites in environmental monitoring studies, often incorrectly referred to as a control site.")
Declaration(Class(goldbook:14983))
AnnotationAssertion(rdfs:label goldbook:14983 "reference toxicant")
AnnotationAssertion(dcterms:description goldbook:14983 "Chemical used in an aquatic toxicity test as a positive control in contrast to the negative control provided by exposure water without the test chemical. Information collected is used to determine the general health and viability of the test organisms and assess consistency in testing protocol implementation.")
Declaration(Class(goldbook:14984))
AnnotationAssertion(rdfs:label goldbook:14984 "reference toxicity test")
AnnotationAssertion(dcterms:description goldbook:14984 "Test conducted in conjunction with sediment tests to determine possible changes in condition of the test species.")
Declaration(Class(goldbook:14985))
AnnotationAssertion(rdfs:label goldbook:14985 "region")
AnnotationAssertion(dcterms:description goldbook:14985 "Area of the Earth’s surface differentiated by its specific characteristics.")
Declaration(Class(goldbook:14986))
AnnotationAssertion(rdfs:label goldbook:14986 "relative risk")
AnnotationAssertion(dcterms:description goldbook:14986 """Ratio of the risk of disease or death among the exposed to the risk among the unexposed.
Ratio of the cumulative incidence rate in the exposed to the cumulative incidence rate in the unexposed.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14986 "risk ratio")
Declaration(Class(goldbook:14987))
AnnotationAssertion(rdfs:label goldbook:14987 "remedial investigation")
AnnotationAssertion(dcterms:description goldbook:14987 "Study that has three parts: characterization or the type and degree of the contamination, human risk assessment, and ecological risk assessment.")
Declaration(Class(goldbook:14988))
AnnotationAssertion(rdfs:label goldbook:14988 "remedial investigation and feasibility study")
AnnotationAssertion(dcterms:description goldbook:14988 "For an EPA Superfund site, a study that has as its goal the implementation of 'remedies that reduce, control, or eliminate risks to human health and the environment' or, more specifically, the accumulation of 'information sufficient to support an informed risk management decision regarding which remedy appears to be most appropriate for a given site'.")
Declaration(Class(goldbook:14989))
AnnotationAssertion(rdfs:label goldbook:14989 "remediation")
AnnotationAssertion(dcterms:description goldbook:14989 """Giving a remedy.
Removal of pollution or contaminants from environmental media such as soil, groundwater, sediment, or surface water for the general protection of human health and the environment.""")
Declaration(Class(goldbook:14990))
AnnotationAssertion(rdfs:label goldbook:14990 "remote sensing")
AnnotationAssertion(dcterms:description goldbook:14990 "Technologies that allow the acquisition and analysis of data without requiring physical contact with the land or water surface being studied. Most determine qualities or characteristics of areas of interest based on measurements of visible light, infrared radiation, or radio energy coming from them.")
Declaration(Class(goldbook:14991))
AnnotationAssertion(rdfs:label goldbook:14991 "reproductive value")
AnnotationAssertion(dcterms:description goldbook:14991 "Expected contribution of offspring during the life of an individual of an age class \\(x\\) in a life table.")
Declaration(Class(goldbook:14992))
AnnotationAssertion(rdfs:label goldbook:14992 "rescue effect")
AnnotationAssertion(dcterms:description goldbook:14992 "Increased probability of a vacated-patch reoccupation in a metapopulation as the number of nearby, occupied patches increases.")
Declaration(Class(goldbook:14993))
AnnotationAssertion(rdfs:label goldbook:14993 "resilience")
AnnotationAssertion(dcterms:description goldbook:14993 "Ability of a community to maintain its structure and function in the face of disturbance, and to reorganize following disturbance-driven change.")
Declaration(Class(goldbook:14994))
AnnotationAssertion(rdfs:label goldbook:14994 "retention effect")
AnnotationAssertion(dcterms:description goldbook:14994 "Observed effect of the properties of persistent organic pollutants (POPs) with high lipophilicity which causes them to be bound more firmly than less lipophilic POPs in solid phases such as soil and vegetation; consequently, they spend less time in the atmosphere and are less available for transport in that medium.")
Declaration(Class(goldbook:14995))
AnnotationAssertion(rdfs:label goldbook:14995 "retrospective risk assessment")
AnnotationAssertion(dcterms:description goldbook:14995 "Risk assessment dealing with an existing condition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14995 "retroactive risk assessment")
Declaration(Class(goldbook:14996))
AnnotationAssertion(rdfs:label goldbook:14996 "ring test")
AnnotationAssertion(dcterms:description goldbook:14996 "Part of an external quality assurance program for assessment of an analytical method or test. A reference institute sends identical samples, which have to be analyzed or tested for specified parameters, to a number of different laboratories. The laboratory has a deadline before which to provide results. Statistical evaluation and interpretation of the results permits assessment of the reliability of the methods used and a comparison of the laboratories’ proficiency.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:14996 "round-robin test")
Declaration(Class(goldbook:14997))
AnnotationAssertion(rdfs:label goldbook:14997 "riparian")
AnnotationAssertion(dcterms:description goldbook:14997 "Interface between land and a flowing body of surface water.")
Declaration(Class(goldbook:14998))
AnnotationAssertion(rdfs:label goldbook:14998 "risk analysis")
AnnotationAssertion(dcterms:description goldbook:14998 "Process for controlling situations where an organism, system, or subpopulation could be exposed to a hazard.")
Declaration(Class(goldbook:14999))
AnnotationAssertion(rdfs:label goldbook:14999 "risk characterisation")
AnnotationAssertion(dcterms:description goldbook:14999 "Outcome of hazard identification and risk estimation applied to a specific use of a substance or occurrence of an environmental health hazard.")
Declaration(Class(goldbook:15000))
AnnotationAssertion(rdfs:label goldbook:15000 "risk hypotheses")
AnnotationAssertion(dcterms:description goldbook:15000 "Clear statements of postulated or predicted adverse effects of a toxicant on an assessment endpoint.")
Declaration(Class(goldbook:15001))
AnnotationAssertion(rdfs:label goldbook:15001 "risk source")
AnnotationAssertion(dcterms:description goldbook:15001 "Agent, medium, process, procedure, or site with the potential to cause an adverse effect or effects.")
Declaration(Class(goldbook:15002))
AnnotationAssertion(rdfs:label goldbook:15002 "risk quotient")
AnnotationAssertion(dcterms:description goldbook:15002 "Ratio of predicted exposure concentration (PEC) to predicted no-effect concentration (PNEC).")
Declaration(Class(goldbook:15003))
AnnotationAssertion(rdfs:label goldbook:15003 "risk reduction")
AnnotationAssertion(dcterms:description goldbook:15003 "Taking measures to protect humans or the environment against identified risks.")
Declaration(Class(goldbook:15004))
AnnotationAssertion(rdfs:label goldbook:15004 "rivet popper hypothesis")
AnnotationAssertion(dcterms:description goldbook:15004 "Hypothesis that each species in a community contributes to its proper functioning.")
Declaration(Class(goldbook:15005))
AnnotationAssertion(rdfs:label goldbook:15005 "r-strategy")
AnnotationAssertion(dcterms:description goldbook:15005 "Opportunistic strategy favoring species that establish themselves quickly, grow quickly to exploit as many resources as possible, and produce many offspring.")
Declaration(Class(goldbook:15006))
AnnotationAssertion(rdfs:label goldbook:15006 "rules of practical causal inference")
AnnotationAssertion(dcterms:description goldbook:15006 "Fox’s rules of practical causal inference that are used in ecotoxicology (environmental epidemiology) to infer causality for toxicant exposure/effect scenarios.")
Declaration(Class(goldbook:15007))
AnnotationAssertion(rdfs:label goldbook:15007 "run-off")
AnnotationAssertion(dcterms:description goldbook:15007 "Portion of the wet precipitation on the land that ultimately reaches streams and, eventually, the sea.")
Declaration(Class(goldbook:15008))
AnnotationAssertion(rdfs:label goldbook:15008 "safe concentration")
AnnotationAssertion(dcterms:description goldbook:15008 "Concentration of a substance to which prolonged exposure will cause no adverse effect.")
Declaration(Class(goldbook:15009))
AnnotationAssertion(rdfs:label goldbook:15009 "salinity")
AnnotationAssertion(dcterms:description goldbook:15009 "Mass of dissolved salts in seawater, brackish water, brine, or other saline solution divided by the mass of the solution.")
Declaration(Class(goldbook:15010))
AnnotationAssertion(rdfs:label goldbook:15010 "salt tolerance index")
AnnotationAssertion(dcterms:description goldbook:15010 "Quotient calculated as total plant (shoot + root) dry mass at different salt concentrations compared to the total plant dry mass obtained for the controls, as indicated below: \\[S_{\\rm{T}} = m_{\\rm{d}}({\\rm{x}})/m_{\\rm{d}}({\\rm{i}})\\] where \\(m_{\\rm{d}}\\) is the total dry mass, and \\(x\\), \\(i\\) refer to a control treatment and a defined salt treatment, respectively.")
Declaration(Class(goldbook:15011))
AnnotationAssertion(rdfs:label goldbook:15011 "saprobic")
AnnotationAssertion(dcterms:description goldbook:15011 "Living in or being an environment rich in organic matter but lacking oxygen.")
Declaration(Class(goldbook:15012))
AnnotationAssertion(rdfs:label goldbook:15012 "saprobic index")
AnnotationAssertion(dcterms:description goldbook:15012 "Means of classifying the saprobic state of running waters, covering the full range from unpolluted to extremely polluted waters.")
Declaration(Class(goldbook:15013))
AnnotationAssertion(rdfs:label goldbook:15013 "saprobic water classification")
AnnotationAssertion(dcterms:description goldbook:15013 """Biological classification of water quality according to five categories:
oligosaprobic: clear, with no or only slight pollution and high dissolved oxygen (DO) content;
p-mesosaprobic: moderately polluted with still high DO content;
x-mesosaprobic: polluted with not very high DO content;
polysaprobic: strongly polluted, with negligible DO content; and
antisaprobic: so polluted that no living organism is capable of living in the water.""")
Declaration(Class(goldbook:15014))
AnnotationAssertion(rdfs:label goldbook:15014 "saprobien spectrum")
AnnotationAssertion(dcterms:description goldbook:15014 "Characteristic change in community composition at different distances below the discharge of putrescible organic waste to a river or stream.")
Declaration(Class(goldbook:15015))
AnnotationAssertion(rdfs:label goldbook:15015 "satellite groups")
AnnotationAssertion(dcterms:description goldbook:15015 "Organisms or groups of organisms treated in a similar fashion to those in standard toxicity tests for the purpose of special additional studies.")
Declaration(Class(goldbook:15016))
AnnotationAssertion(rdfs:label goldbook:15016 "scope for growth")
AnnotationAssertion(dcterms:description goldbook:15016 "Index (\\(P\\) = production) calculated as the amount of energy taken into the organism in its food (\\(A\\)) minus the energy used for respiration (\\(R\\)) and excretion (\\(U\\)): \\[P = A - R - U\\]")
Declaration(Class(goldbook:15017))
AnnotationAssertion(rdfs:label goldbook:15017 "scope of activity")
AnnotationAssertion(dcterms:description goldbook:15017 "Difference between the rates of oxygen consumption of an organism under maximal and minimal activity levels.")
Declaration(Class(goldbook:15018))
AnnotationAssertion(rdfs:label goldbook:15018 "screening level")
AnnotationAssertion(dcterms:description goldbook:15018 "Decision limit or cut-off point at which a screening test is regarded as positive.")
Declaration(Class(goldbook:15019))
AnnotationAssertion(rdfs:label goldbook:15019 "screening test")
AnnotationAssertion(dcterms:description goldbook:15019 """Test conducted to estimate the concentrations to be used for a definitive test.
Acute test used early in a testing program to evaluate the potential of a substance to produce a given adverse effect (e.g., mortality).""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15019 "preliminary test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15019 "range-finding test")
Declaration(Class(goldbook:15020))
AnnotationAssertion(rdfs:label goldbook:15020 "secondary lamellae")
AnnotationAssertion(dcterms:description goldbook:15020 "Parallel rows of projections on the dorsal and ventral sides of each primary lamella of the fish gill. They are the primary sites of gas exchange of the gills.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15020 "respiratory lamellae")
Declaration(Class(goldbook:15021))
AnnotationAssertion(rdfs:label goldbook:15021 "secondary poisoning")
AnnotationAssertion(dcterms:description goldbook:15021 "Poisoning of a predator as a result of eating prey that has accumulated a toxicant as a result of biomagnification through its food chain.")
Declaration(Class(goldbook:15022))
AnnotationAssertion(rdfs:label goldbook:15022 "secondary substrate metabolism")
AnnotationAssertion(dcterms:description goldbook:15022 "Microbial growth on a nutrient substrate while transforming another substrate without gaining energetic benefit.")
Declaration(Class(goldbook:15023))
AnnotationAssertion(rdfs:label goldbook:15023 "secondary succession")
AnnotationAssertion(dcterms:description goldbook:15023 "Sequential appearance of species following major changes to an established ecosystem.")
Declaration(Class(goldbook:15024))
AnnotationAssertion(rdfs:label goldbook:15024 "selection components")
AnnotationAssertion(dcterms:description goldbook:15024 "Components of the life cycle of an individual upon which natural selection can act. They are viability selection, sexual selection, meiotic drive, gametic selection, and fecundity selection.")
Declaration(Class(goldbook:15025))
AnnotationAssertion(rdfs:label goldbook:15025 "Selyean stress")
AnnotationAssertion(dcterms:description goldbook:15025 "Syndrome named for Hans Selye (1907–1982) that consists of all the nonspecifically induced changes within a biological system following and during environmental stress.")
Declaration(Class(goldbook:15026))
AnnotationAssertion(rdfs:label goldbook:15026 "semelparous species")
AnnotationAssertion(dcterms:description goldbook:15026 "Species that reproduces once.")
Declaration(Class(goldbook:15027))
AnnotationAssertion(rdfs:label goldbook:15027 "semi-continuous activated sludge test")
AnnotationAssertion(dcterms:description goldbook:15027 "Test for inherent biodegradability of organic substances in activated sludge by measurement of the decrease in dissolved oxygen content (DOC) in the test system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15027 "SCAS test")
Declaration(Class(goldbook:15028))
AnnotationAssertion(rdfs:label goldbook:15028 "sentinel species")
AnnotationAssertion(dcterms:description goldbook:15028 "Feral, caged, or endemic species used in measuring and indicating the level of contamination or effect during a biomonitoring exercise.")
Declaration(Class(goldbook:15029))
AnnotationAssertion(rdfs:label goldbook:15029 "seston")
AnnotationAssertion(dcterms:description goldbook:15029 "Minute living organisms and particles of nonliving matter that float in water and contribute to turbidity.")
Declaration(Class(goldbook:15030))
AnnotationAssertion(rdfs:label goldbook:15030 "sexual selection")
AnnotationAssertion(dcterms:description goldbook:15030 "Natural selection involving differential mating success of individuals.")
Declaration(Class(goldbook:15031))
AnnotationAssertion(rdfs:label goldbook:15031 "Shannon–Wiener diversity index")
AnnotationAssertion(dcterms:description goldbook:15031 "Index based on the assumption that all species are represented in the sample studied and that the sample was obtained randomly, giving the following mathematical relationship: \\[H = -\\sum \\limits_{i=1}^S p_{i} \\log p_{i}\\] where \\(p_{i}\\) is the fraction of individuals belonging to the \\(i\\)-th species and \\(S\\) is the number of species.")
Declaration(Class(goldbook:15032))
AnnotationAssertion(rdfs:label goldbook:15032 "Shelford’s law of tolerance")
AnnotationAssertion(dcterms:description goldbook:15032 "Species’ tolerance(s) along an environmental gradient (or series of environmental gradients) will determine its population distribution and size in the environment.")
Declaration(Class(goldbook:15033))
AnnotationAssertion(rdfs:label goldbook:15033 "silt")
AnnotationAssertion(dcterms:description goldbook:15033 "Sediment particles with a grain size between \\(\\pu{0.004 mm}\\) and \\(\\pu{0.062 mm}\\), i.e., coarser than clay particles but finer than sand.")
Declaration(Class(goldbook:15034))
AnnotationAssertion(rdfs:label goldbook:15034 "Simpson’s diversity index")
AnnotationAssertion(dcterms:description goldbook:15034 "Dominance index weighted toward the abundance of the most common species, giving the probability of any two individuals drawn at random from an infinitely large community belonging to different species. The bias corrected mathematical form of Simpson’s index is \\[D = \\sum \\limits_{i=1}^{S} p_{i}^{2}\\] where \\(p_{i}\\) is the fraction of all organisms which belong to the \\(i\\)-th species and \\(S\\) is the number of species.")
Declaration(Class(goldbook:15035))
AnnotationAssertion(rdfs:label goldbook:15035 "simulated field studies")
AnnotationAssertion(dcterms:description goldbook:15035 "Experimental ecosystem that should be: physically confined; self-maintaining; multitrophic; have a duration time exceeding the generation time of the penultimate trophic level present; and of size sufficient to enable pertinent sampling and measurements to be made without seriously influencing the structure and dynamics of the system.")
Declaration(Class(goldbook:15036))
AnnotationAssertion(rdfs:label goldbook:15036 "soil")
AnnotationAssertion(dcterms:description goldbook:15036 "Naturally occurring, unconsolidated mineral and (or) organic material at the surface of the Earth that is capable of supporting plant growth. It extends from the surface to \\(\\pu{15 cm}\\) below the depth at which properties produced by soil-forming processes can be detected.")
Declaration(Class(goldbook:15037))
AnnotationAssertion(rdfs:label goldbook:15037 "solvent drag")
AnnotationAssertion(dcterms:description goldbook:15037 "Movement of a solute (e.g., a contaminant) along with the bulk movement of the solvent.")
Declaration(Class(goldbook:15038))
AnnotationAssertion(rdfs:label goldbook:15038 "somatic death")
AnnotationAssertion(dcterms:description goldbook:15038 "Death of an individual organism.")
Declaration(Class(goldbook:15039))
AnnotationAssertion(rdfs:label goldbook:15039 "somatic risk")
AnnotationAssertion(dcterms:description goldbook:15039 "Risk of an adverse effect to the exposed individual associated with genetic damage to somatic cells, e.g., damage leading to cancer.")
Declaration(Class(goldbook:15040))
AnnotationAssertion(rdfs:label goldbook:15040 "sorbate")
AnnotationAssertion(dcterms:description goldbook:15040 "Noncommittal term used instead of adsorbate or absorbate when the sorption process is undefined.")
Declaration(Class(goldbook:15041))
AnnotationAssertion(rdfs:label goldbook:15041 "sorption constant")
AnnotationAssertion(dcterms:description goldbook:15041 "Quantity describing the distribution of a substance between a solvent and a sorbent, typically water and sediment, at equilibrium, e.g., \\[K_{\\rm{d}} = [\\pu{C(sediment)}]/[\\pu{C(water)}]\\]")
Declaration(Class(goldbook:15042))
AnnotationAssertion(rdfs:label goldbook:15042 "source term")
AnnotationAssertion(dcterms:description goldbook:15042 "Estimate of the total amount released, or the temporal pattern of the rate of release, of a pollutant from a source.")
Declaration(Class(goldbook:15043))
AnnotationAssertion(rdfs:label goldbook:15043 "Spearman–Karber method")
AnnotationAssertion(dcterms:description goldbook:15043 "Nonparametric method to estimate the \\(\\pu{LC_{50}}\\), \\(\\pu{EC_{50}}\\), or \\(\\pu{LD_{50}}\\) when it is difficult or unnecessary to assume a specific model for the dose- or concentration effect data.")
Declaration(Class(goldbook:15044))
AnnotationAssertion(rdfs:label goldbook:15044 "species–area relationship")
AnnotationAssertion(dcterms:description goldbook:15044 "Common pattern in which the number of species on islands decreases as island area decreases.")
Declaration(Class(goldbook:15045))
AnnotationAssertion(rdfs:label goldbook:15045 "species assemblage")
AnnotationAssertion(dcterms:description goldbook:15045 "Operationally defined subset of the entire community.")
Declaration(Class(goldbook:15046))
AnnotationAssertion(rdfs:label goldbook:15046 "species–deletion stability")
AnnotationAssertion(dcterms:description goldbook:15046 "Tendency in a model community for the remaining species to remain at locally stable equilibria after a species is made extinct.")
Declaration(Class(goldbook:15047))
AnnotationAssertion(rdfs:label goldbook:15047 "species differences in sensitivity")
AnnotationAssertion(dcterms:description goldbook:15047 "Quantitative or qualitative differences of response to the action(s) of a potentially toxic substance on various species of living organisms.")
Declaration(Class(goldbook:15048))
AnnotationAssertion(rdfs:label goldbook:15048 "species diversity")
AnnotationAssertion(dcterms:description goldbook:15048 "Heterogeneity of an ecological community, considering both species richness (\\(S\\)) and species evenness.")
Declaration(Class(goldbook:15049))
AnnotationAssertion(rdfs:label goldbook:15049 "species evenness")
AnnotationAssertion(dcterms:description goldbook:15049 "Degree to which the individuals in the community are evenly or uniformly distributed among species.")
Declaration(Class(goldbook:15050))
AnnotationAssertion(rdfs:label goldbook:15050 "species imbalance")
AnnotationAssertion(dcterms:description goldbook:15050 "Change in the species numbers or diversity in an ecosystem, or in their interactions, which results in change in ecological character and its functions and attributes.")
Declaration(Class(goldbook:15051))
AnnotationAssertion(rdfs:label goldbook:15051 "species richness")
AnnotationAssertion(dcterms:description goldbook:15051 "Total number of species in an ecosystem.")
Declaration(Class(goldbook:15052))
AnnotationAssertion(rdfs:label goldbook:15052 "species sensitivity distribution")
AnnotationAssertion(dcterms:description goldbook:15052 "Statistical relationship between exposure concentration and a defined effect derived from a combination of single-species test data to predict concentrations affecting only a certain percentage of the total number of species in a defined community.")
Declaration(Class(goldbook:15053))
AnnotationAssertion(rdfs:label goldbook:15053 "species-specific sensitivity")
AnnotationAssertion(dcterms:description goldbook:15053 "Quantitative and qualitative features of response to the action(s) of a potentially toxic substance that are characteristic for a particular species of living organism.")
Declaration(Class(goldbook:15054))
AnnotationAssertion(rdfs:label goldbook:15054 "specific action concept")
AnnotationAssertion(dcterms:description goldbook:15054 "Assumption made in radiotracer usage concerning specificity of action of a radionuclide used to trace or quantify the movement of a stable nuclide (e.g., \\(\\ce{^{14}C}\\) for stable \\(\\ce{C}\\)), implying that the radionuclide behaves identically in chemical and biological processes to its nonradioactive analog (e.g., stable \\(\\ce{C}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15054 "specific activity concept")
Declaration(Class(goldbook:15055))
AnnotationAssertion(rdfs:label goldbook:15055 "spiked bioassay approach")
AnnotationAssertion(dcterms:description goldbook:15055 "Sediment toxicity test method to generate a concentration response model for effects to individuals placed in sediments spiked with different amounts of toxicant.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15055 "SB approach")
Declaration(Class(goldbook:15056))
AnnotationAssertion(rdfs:label goldbook:15056 "spillover hypothesis")
AnnotationAssertion(dcterms:description goldbook:15056 "Hypothesis that toxic effects of metals will begin to occur after the metal concentration exceeds the capacity of the amount of metallothionein present to bind the metal. The unbound metals then 'spill over' to interact at sites of adverse action. This is based on the assumption that binding by metallothionein sequesters toxic metals away from sites of action.")
Declaration(Class(goldbook:15057))
AnnotationAssertion(rdfs:label goldbook:15057 "stable age distribution")
AnnotationAssertion(dcterms:description goldbook:15057 "Abundance of relative age classes that a population approaches if it is allowed to grow exponentially.")
Declaration(Class(goldbook:15058))
AnnotationAssertion(rdfs:label goldbook:15058 "stable population")
AnnotationAssertion(dcterms:description goldbook:15058 "Population with a constant distribution of individuals among the various age classes and a zero growth rate.")
Declaration(Class(goldbook:15059))
AnnotationAssertion(rdfs:label goldbook:15059 "standard")
AnnotationAssertion(dcterms:description goldbook:15059 "That which is established as a measure or model to which others of a similar nature should conform.")
Declaration(Class(goldbook:15060))
AnnotationAssertion(rdfs:label goldbook:15060 "standard")
AnnotationAssertion(dcterms:description goldbook:15060 "Technical specification, usually in the form of a document available to the public, drawn up with the consensus or general approval of all interests affected by it, based on the consolidated results of science, technology, and experience, aimed at the promotion of optimum community benefits and approved by a body recognized on the national, regional, or international level.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15060 "technical directive")
Declaration(Class(goldbook:15061))
AnnotationAssertion(rdfs:label goldbook:15061 "static-renewal test")
AnnotationAssertion(dcterms:description goldbook:15061 "Modified static aquatic toxicity test in which solutions are completely or partially replaced with new solutions at set periods during exposures or in which organisms are periodically transferred to new solutions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15061 "batch-replacement test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15061 "renewal test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15061 "renewed static test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15061 "semi-static test")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15061 "static-replacement test")
Declaration(Class(goldbook:15062))
AnnotationAssertion(rdfs:label goldbook:15062 "static-toxicity test")
AnnotationAssertion(dcterms:description goldbook:15062 "Aquatic toxicity test in which the exposure water is not changed during the test.")
Declaration(Class(goldbook:15063))
AnnotationAssertion(rdfs:label goldbook:15063 "stratification")
AnnotationAssertion(dcterms:description goldbook:15063 "Process by which materials form or are deposited in layers, as in sedimentary rocks and some igneous rocks. The atmosphere and the ocean also exhibit stratification, with the warmer air or water occupying the upper layers.")
Declaration(Class(goldbook:15064))
AnnotationAssertion(rdfs:label goldbook:15064 "stratified sampling")
AnnotationAssertion(dcterms:description goldbook:15064 "Sampling of individual subgroups (strata) of a population after its division into homogeneous strata.")
Declaration(Class(goldbook:15065))
AnnotationAssertion(rdfs:label goldbook:15065 "stress")
AnnotationAssertion(dcterms:description goldbook:15065 "Any condition that results in reduced growth of an organism or that prevents an organism from realizing its 'genetic potential'.")
Declaration(Class(goldbook:15066))
AnnotationAssertion(rdfs:label goldbook:15066 "stressor")
AnnotationAssertion(dcterms:description goldbook:15066 "Any physical, chemical, or biological factor causing an adverse response on any component of an ecosystem.")
Declaration(Class(goldbook:15067))
AnnotationAssertion(rdfs:label goldbook:15067 "stress-protein fingerprinting")
AnnotationAssertion(dcterms:description goldbook:15067 "Proposed use of the patterns of stress-protein induction seen in the field to suggest the particular toxicant inducing the response, after patterns from organisms sampled in the field are compared with those obtained with single-candidate toxicants in the laboratory.")
Declaration(Class(goldbook:15068))
AnnotationAssertion(rdfs:label goldbook:15068 "stress proteins")
AnnotationAssertion(dcterms:description goldbook:15068 "Several classes of proteins coded by genes transcriptionally activated by acute stresses, generally serving a protective or adaptive function.")
Declaration(Class(goldbook:15069))
AnnotationAssertion(rdfs:label goldbook:15069 "stress theory of aging")
AnnotationAssertion(dcterms:description goldbook:15069 "Theory that stress shortens longevity by accelerating energy expenditure. Selection takes place for resistance to stress, and as an epiphenomenon, individuals resistant to stress will predominate in extreme age classes of a population. The diminution of homeostasis under stress with age should be slowest in individuals with highest longevity.")
Declaration(Class(goldbook:15070))
AnnotationAssertion(rdfs:label goldbook:15070 "structural diversity")
AnnotationAssertion(dcterms:description goldbook:15070 "Range of types of physical structure in a community that may provide habitats for species.")
Declaration(Class(goldbook:15071))
AnnotationAssertion(rdfs:label goldbook:15071 "structure–metabolism relationship")
AnnotationAssertion(dcterms:description goldbook:15071 "Association between the physicochemical and (or) the structural properties of a substance and its metabolic behavior.")
Declaration(Class(goldbook:15072))
AnnotationAssertion(rdfs:label goldbook:15072 "Sturm test")
AnnotationAssertion(dcterms:description goldbook:15072 "Biodegradation test based on the measurement of \\(\\ce{CO2}\\) production.")
Declaration(Class(goldbook:15073))
AnnotationAssertion(rdfs:label goldbook:15073 "stygobiont")
AnnotationAssertion(dcterms:description goldbook:15073 "Organism that lives only in groundwater.")
Declaration(Class(goldbook:15074))
AnnotationAssertion(rdfs:label goldbook:15074 "stygophile")
AnnotationAssertion(dcterms:description goldbook:15074 "Organism that lives in groundwater and in surface water.")
Declaration(Class(goldbook:15075))
AnnotationAssertion(rdfs:label goldbook:15075 "subcooled")
AnnotationAssertion(dcterms:description goldbook:15075 "Term applied to a substance that is a liquid at a temperature lower than the saturation temperature for the existing pressure.")
Declaration(Class(goldbook:15076))
AnnotationAssertion(rdfs:label goldbook:15076 "subcooled liquid vapour pressure")
AnnotationAssertion(dcterms:description goldbook:15076 "Vapor pressure of a subcooled liquid.")
Declaration(Class(goldbook:15077))
AnnotationAssertion(rdfs:label goldbook:15077 "succession")
AnnotationAssertion(dcterms:description goldbook:15077 "Orderly sequential progression of changes in community composition that occurs during development of new populations in any area, from initial colonization to the attainment of the climax typical of a particular geographic area.")
Declaration(Class(goldbook:15078))
AnnotationAssertion(rdfs:label goldbook:15078 "supercooled")
AnnotationAssertion(dcterms:description goldbook:15078 "Term describing a substance that persists as a liquid at a temperature below its freezing point without solidification or crystallization.")
Declaration(Class(goldbook:15079))
AnnotationAssertion(rdfs:label goldbook:15079 "surrogate organism")
AnnotationAssertion(dcterms:description goldbook:15079 "Test organism, or population that is cultured under laboratory conditions to serve as a substitute in toxicity testing for indigenous organisms, communities, or populations.")
Declaration(Class(goldbook:15080))
AnnotationAssertion(rdfs:label goldbook:15080 "surrogate toxicant")
AnnotationAssertion(dcterms:description goldbook:15080 "Relatively well-studied substance whose properties are assumed to apply to an entire chemically and toxicologically related class.")
Declaration(Class(goldbook:15081))
AnnotationAssertion(rdfs:label goldbook:15081 "surveillance")
AnnotationAssertion(dcterms:description goldbook:15081 "Systematic ongoing collection, collation, and analysis of data and the timely dissemination of information to those who need to know in order that action can be taken to initiate investigative or control measures.")
Declaration(Class(goldbook:15082))
AnnotationAssertion(rdfs:label goldbook:15082 "survival time")
AnnotationAssertion(dcterms:description goldbook:15082 "Time interval between initial exposure of an organism to a harmful substance and death.")
Declaration(Class(goldbook:15083))
AnnotationAssertion(rdfs:label goldbook:15083 "survivorship")
AnnotationAssertion(dcterms:description goldbook:15083 "Proportion of animals surviving between two specified ages.")
Declaration(Class(goldbook:15084))
AnnotationAssertion(rdfs:label goldbook:15084 "survivorship curve")
AnnotationAssertion(dcterms:description goldbook:15084 "Graph showing how survivorship from birth varies with age.")
Declaration(Class(goldbook:15085))
AnnotationAssertion(rdfs:label goldbook:15085 "susceptibility")
AnnotationAssertion(dcterms:description goldbook:15085 "Condition of an organism or ecological system that makes it more vulnerable to a given exposure than the majority of the population or group of ecological systems to which it belongs.")
Declaration(Class(goldbook:15086))
AnnotationAssertion(rdfs:label goldbook:15086 "suspension feeder")
AnnotationAssertion(dcterms:description goldbook:15086 "Animal that feeds by straining suspended matter and food particles from water, typically by passing the water over a specialized structure, such as the baleen of baleen whales.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15086 "filter feeder")
Declaration(Class(goldbook:15087))
AnnotationAssertion(rdfs:label goldbook:15087 "syngenetic")
AnnotationAssertion(dcterms:description goldbook:15087 "Describing mineral deposits formed at the same time as the enclosing rocks; characterized by or pertaining to a formation contemporaneous with the enclosing or surrounding rock.")
Declaration(Class(goldbook:15088))
AnnotationAssertion(rdfs:label goldbook:15088 "systematics")
AnnotationAssertion(dcterms:description goldbook:15088 "Study of the diversity of past and present life forms and of relationships among them through time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15088 "taxonomy")
Declaration(Class(goldbook:15089))
AnnotationAssertion(rdfs:label goldbook:15089 "taxocene")
AnnotationAssertion(dcterms:description goldbook:15089 "Taxonomically defined subset of an entire community.")
Declaration(Class(goldbook:15090))
AnnotationAssertion(rdfs:label goldbook:15090 "taxonomy")
AnnotationAssertion(dcterms:description goldbook:15090 "Science applied to the allocation of biological names and the rules of naming.")
Declaration(Class(goldbook:15091))
AnnotationAssertion(rdfs:label goldbook:15091 "teratogenic")
AnnotationAssertion(dcterms:description goldbook:15091 "Capable of causing nonheritable permanent structural malformations or defects in the offspring of an exposed parent.")
Declaration(Class(goldbook:15092))
AnnotationAssertion(rdfs:label goldbook:15092 "terrestrial")
AnnotationAssertion(dcterms:description goldbook:15092 "Relating to land, as distinct from water or air.")
Declaration(Class(goldbook:15093))
AnnotationAssertion(rdfs:label goldbook:15093 "threshold-effect concentration")
AnnotationAssertion(dcterms:description goldbook:15093 "Concentration calculated as the geometric mean of no-observed-effect concentration (NOEC) and lowest-observed-effect concentration (LOEC).")
Declaration(Class(goldbook:15094))
AnnotationAssertion(rdfs:label goldbook:15094 "threshold theory")
AnnotationAssertion(dcterms:description goldbook:15094 "Theory that, for a given substance, no toxic effect can occur below a defined low dose.")
Declaration(Class(goldbook:15095))
AnnotationAssertion(rdfs:label goldbook:15095 "tiered testing")
AnnotationAssertion(dcterms:description goldbook:15095 "Structured approach to assessment of the fate and effects of substances, where a tier of relatively simple tests is used initially to select substances of concern and to define their toxicity. If the information from these tests is inadequate for regulatory decisions, further more complex tests (higher tier tests) may be required. For example, under a tiered structure, testing might progress from acute studies to chronic laboratory studies to field studies.")
Declaration(Class(goldbook:15096))
AnnotationAssertion(rdfs:label goldbook:15096 "time-independent test")
AnnotationAssertion(dcterms:description goldbook:15096 "Acute toxicity test with no predetermined temporal endpoint.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15096 "TI test")
Declaration(Class(goldbook:15097))
AnnotationAssertion(rdfs:label goldbook:15097 "tolerance index")
AnnotationAssertion(dcterms:description goldbook:15097 "Quotient of an adequate parameter acquired under treated and control environments, multiplied by \\(\\pu{100}\\), thus: \\[\\rm{TI} = (\\rm{parameter\\ treated}/\\rm{parameter\\ control}) \\times 100\\]")
Declaration(Class(goldbook:15098))
AnnotationAssertion(rdfs:label goldbook:15098 "top-down ecotoxicological study")
AnnotationAssertion(dcterms:description goldbook:15098 "Approach to investigating ecotoxicological effects that starts with a determination of the presence and nature of any adverse effects via responses at community and ecosystem levels of organization rather than the suborganismal levels of organization.")
Declaration(Class(goldbook:15099))
AnnotationAssertion(rdfs:label goldbook:15099 "total organic carbon")
AnnotationAssertion(dcterms:description goldbook:15099 "Organic matter content of soil, sediment, or water determined by measurement of organic carbon as the ratio of mass of organic carbon/mass of solid or of water.")
Declaration(Class(goldbook:15100))
AnnotationAssertion(rdfs:label goldbook:15100 "toxic")
AnnotationAssertion(dcterms:description goldbook:15100 "Able to cause injury to living organisms as a result of physicochemical interaction.")
Declaration(Class(goldbook:15101))
AnnotationAssertion(rdfs:label goldbook:15101 "toxic unit")
AnnotationAssertion(dcterms:description goldbook:15101 "Dose or concentration of a toxicant expressed in units of lethality such as units of \\(\\pu{LD_{50}}\\) or \\(\\pu{LC_{50}}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15101 "toxicity unit")
Declaration(Class(goldbook:15102))
AnnotationAssertion(rdfs:label goldbook:15102 "toxicity curve")
AnnotationAssertion(dcterms:description goldbook:15102 "Curve obtained by plotting the median survival times of a group of test organisms against the concentration of a substance on a logarithmic scale.")
Declaration(Class(goldbook:15103))
AnnotationAssertion(rdfs:label goldbook:15103 "toxicity equivalency factor")
AnnotationAssertion(dcterms:description goldbook:15103 """Ratio of the toxicity of a chemical to that of another structurally related chemical (or index compound) chosen as a reference.
In risk assessment, ratio of the toxicity of a chemical to that of another structurally related chemical (or index compound) chosen as a reference. Factor used to estimate the toxicity of a complex mixture, commonly a mixture of chlorinated dibenzo-p-dioxins [oxanthrenes], furans, and biphenyls: in this case, TEF is based on relative toxicity to 2,3,7,8-tetrachlorodibenzo-p-dioxin [2,3,7,8-tetrachlorooxanthrene] for which the \\(f = 1\\).""")
Declaration(Class(goldbook:15104))
AnnotationAssertion(rdfs:label goldbook:15104 "toxicity equivalent")
AnnotationAssertion(dcterms:description goldbook:15104 "Contribution of a specified component (or components) to the toxicity of a mixture of related substances.")
Declaration(Class(goldbook:15105))
AnnotationAssertion(rdfs:label goldbook:15105 "toxicity identification and evaluation")
AnnotationAssertion(dcterms:description goldbook:15105 "Systematic pretreatment (e.g., \\(\\rm{pH}\\) change, filtration, or aeration) of a sample to obtain defined fractions that are subsequently tested for their toxicity. This fractionation is designed to separate out defined substances and thus to identify the agent(s) primarily responsible for lethal or sublethal toxicity of a complex mixture.")
Declaration(Class(goldbook:15106))
AnnotationAssertion(rdfs:label goldbook:15106 "toxicity value")
AnnotationAssertion(dcterms:description goldbook:15106 "Factor used to estimate risk. It may be a reference dose or it may be calculated from the following equation: \\[T_{\\rm{x}} = m\\ C\\] where \\(m\\) is the slope of a published dose-effect relationship and \\(C\\) is the toxicant concentration.")
Declaration(Class(goldbook:15107))
AnnotationAssertion(rdfs:label goldbook:15107 "trace nutrient")
AnnotationAssertion(dcterms:description goldbook:15107 "Substance required in very small quantities by a defined organism to maintain health.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15107 "micronutrient")
Declaration(Class(goldbook:15108))
AnnotationAssertion(rdfs:label goldbook:15108 "trade-off")
AnnotationAssertion(dcterms:description goldbook:15108 "Exchange of one advantageous character for another.")
Declaration(Class(goldbook:15109))
AnnotationAssertion(rdfs:label goldbook:15109 "trigger values")
AnnotationAssertion(dcterms:description goldbook:15109 "Criteria applied to results from tests (for fate or effects) which prompt further studies, e.g., moving to the next tier of tests, which are generally more complex.")
Declaration(Class(goldbook:15110))
AnnotationAssertion(rdfs:label goldbook:15110 "trophic")
AnnotationAssertion(dcterms:description goldbook:15110 "Relating to nutrition.")
Declaration(Class(goldbook:15111))
AnnotationAssertion(rdfs:label goldbook:15111 "trophic cascade")
AnnotationAssertion(dcterms:description goldbook:15111 "Situation arising when predators in a food chain suppress the abundance of their prey, thereby releasing the next lower trophic level from predation (or herbivory if the intermediate trophic level is an herbivore).")
Declaration(Class(goldbook:15112))
AnnotationAssertion(rdfs:label goldbook:15112 "trophic dilution")
AnnotationAssertion(dcterms:description goldbook:15112 "Decrease in contaminant concentration as trophic level increases; this results from a net balance of ingestion rate, uptake from food, internal transformation, and elimination processes favoring loss of contaminant that enters the organism via food.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15112 "biominification")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15112 "bioreduction")
Declaration(Class(goldbook:15113))
AnnotationAssertion(rdfs:label goldbook:15113 "trophic level")
AnnotationAssertion(dcterms:description goldbook:15113 "Position in a food chain, assessed by the number of energy-transfer steps to reach that level.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15113 "trophic position")
Declaration(Class(goldbook:15114))
AnnotationAssertion(rdfs:label goldbook:15114 "trophic structure")
AnnotationAssertion(dcterms:description goldbook:15114 "Organization of an ecological community described in terms of energy flow through its various trophic levels.")
Declaration(Class(goldbook:15115))
AnnotationAssertion(rdfs:label goldbook:15115 "trophic transfer")
AnnotationAssertion(dcterms:description goldbook:15115 "Transfer of a substance from one trophic level to another.")
Declaration(Class(goldbook:15116))
AnnotationAssertion(rdfs:label goldbook:15116 "trophic transfer factor")
AnnotationAssertion(dcterms:description goldbook:15116 "Ratio between the concentration of a compound in a predator and in its prey.")
Declaration(Class(goldbook:15117))
AnnotationAssertion(rdfs:label goldbook:15117 "turbidity of water")
AnnotationAssertion(dcterms:description goldbook:15117 "Extent to which the clarity of water is reduced by the presence of suspended or other matter that causes light to be scattered and absorbed rather than transmitted (in straight lines) through the sample.")
Declaration(Class(goldbook:15118))
AnnotationAssertion(rdfs:label goldbook:15118 "twin-tracer technique")
AnnotationAssertion(dcterms:description goldbook:15118 "Experimental method for evaluating assimilation that introduces simultaneously a radiotracer of the substance being assimilated and an inert tracer that will not be assimilated, thus providing a basis for evaluating the assimilation.")
Declaration(Class(goldbook:15119))
AnnotationAssertion(rdfs:label goldbook:15119 "type A organism")
AnnotationAssertion(dcterms:description goldbook:15119 "Animal or plant living in contact with sediments but unable to ingest particulates.")
Declaration(Class(goldbook:15120))
AnnotationAssertion(rdfs:label goldbook:15120 "type B organism")
AnnotationAssertion(dcterms:description goldbook:15120 "Animal or plant living in contact with sediments and capable of ingesting particulates.")
Declaration(Class(goldbook:15121))
AnnotationAssertion(rdfs:label goldbook:15121 "uncertainty factor")
AnnotationAssertion(dcterms:description goldbook:15121 """In assay methodology, confidence interval or fiducial limit used to assess the probable precision of an estimate.
In toxicology, value used in extrapolation from experimental animals to humans (assuming that humans may be more sensitive) or from selected individuals to the general population.Example: A value applied to the no-observed-effect-level (NOEL) or no-observed-adverse-effect-level (NOAEL) to derive an acceptable daily intake (ADI) or tolerable daily intake (TDI).Note: The NOEL or NOAEL is divided by the value to calculate the ADI or TDI.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15121 "application factor (AF)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15121 "assessment factor")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15121 "modifying factor (MF)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15121 "safety factor")
Declaration(Class(goldbook:15122))
AnnotationAssertion(rdfs:label goldbook:15122 "upstream water")
AnnotationAssertion(dcterms:description goldbook:15122 "Water in a rivulet, river, or lake that is situated above a defined point, in a direction opposite to that of the current flow.")
Declaration(Class(goldbook:15123))
AnnotationAssertion(rdfs:label goldbook:15123 "uptake rate constant")
AnnotationAssertion(dcterms:description goldbook:15123 "First-order one-compartment constant to describe the uptake of a substance by an organism from water.")
Declaration(Class(goldbook:15124))
AnnotationAssertion(rdfs:label goldbook:15124 "viability selection")
AnnotationAssertion(dcterms:description goldbook:15124 "Component of the life cycle of an individual in which natural selection can occur through the differential survival of individuals. It begins at the formation of the zygote and continues throughout the life of the individual.")
Declaration(Class(goldbook:15125))
AnnotationAssertion(rdfs:label goldbook:15125 "vital rates")
AnnotationAssertion(dcterms:description goldbook:15125 "Measures of how fast vital statistics change in a population (usually expressed per \\(\\pu{1000}\\) individuals).")
Declaration(Class(goldbook:15126))
AnnotationAssertion(rdfs:label goldbook:15126 "vulnerability")
AnnotationAssertion(dcterms:description goldbook:15126 "Susceptibility to harm by toxicants.")
Declaration(Class(goldbook:15127))
AnnotationAssertion(rdfs:label goldbook:15127 "Wahlund effect")
AnnotationAssertion(dcterms:description goldbook:15127 "Net deficit of heterozygotes when two populations, each in Hardy–Weinberg equilibrium but with different allele frequencies, are mixed and the genotype frequencies quantified in a combined population sample.")
Declaration(Class(goldbook:15128))
AnnotationAssertion(rdfs:label goldbook:15128 "waldsterben")
AnnotationAssertion(dcterms:description goldbook:15128 "Widespread and substantial decline in growth and the change in behavior of many softwood and hardwood forest ecosystems in central Europe.")
Declaration(Class(goldbook:15129))
AnnotationAssertion(rdfs:label goldbook:15129 "waste-water")
AnnotationAssertion(dcterms:description goldbook:15129 "General term describing effluents, leachate, and elutriates which enter the natural environment.")
Declaration(Class(goldbook:15130))
AnnotationAssertion(rdfs:label goldbook:15130 "weakest-link incongruity")
AnnotationAssertion(dcterms:description goldbook:15130 "Questionable extension of the critical life-stage concept (see critical life-stage testing) that protection of the most sensitive life stage will ensure protection of all life stages; it assumes that exposure of field populations to concentrations identified in laboratory testing as causing significant mortality at a critical stage of life will result in significant impact on the field population")
Declaration(Class(goldbook:15131))
AnnotationAssertion(rdfs:label goldbook:15131 "Weibull model")
AnnotationAssertion(dcterms:description goldbook:15131 "Dose–response model of the form \\[P(d) = \\gamma + (1 - \\gamma)(1 - e^{-\\beta d^{\\alpha}})\\] where \\(P(d)\\) is the probability of a tumor (or other response) from lifetime, continuous exposure at dose \\(d\\) until age \\(t\\) (when tumor is fatal), \\(\\alpha\\) is a fitted dose parameter (sometimes called the Weibull parameter), \\(\\beta\\) is a fitted dose parameter, and \\(\\gamma\\) is the background response rate.")
Declaration(Class(goldbook:15132))
AnnotationAssertion(rdfs:label goldbook:15132 "weight composition")
AnnotationAssertion(dcterms:description goldbook:15132 "Distribution of organisms among the various weight classes present in a population.")
Declaration(Class(goldbook:15133))
AnnotationAssertion(rdfs:label goldbook:15133 "weight of evidence")
AnnotationAssertion(dcterms:description goldbook:15133 """(in general) Quantitative, semiquantitative, or qualitative estimate of the degree to which the evidence supports or undermines a given conclusion.
(in toxicology) Estimate of the extent to which the available biomedical data support the hypothesis that a substance causes a defined toxic effect such as cancer in humans.""")
Declaration(Class(goldbook:15134))
AnnotationAssertion(rdfs:label goldbook:15134 "Weismannism")
AnnotationAssertion(dcterms:description goldbook:15134 "Theory of evolution and heredity propounded by the German biologist, August Weismann, especially in regard to the continuity of the germ-plasm and the nontransmission of acquired characteristics.")
Declaration(Class(goldbook:15135))
AnnotationAssertion(rdfs:label goldbook:15135 "wet deposition")
AnnotationAssertion(dcterms:description goldbook:15135 "Transfer of chemicals from the atmosphere to the Earth’s surface in atmospheric water precipitation (atmospheric deposition), e.g., rain, snow, or hail, of pollutants that occur in the precipitation, e.g., as a result of Brownian capture, nucleation, dissolution, or impaction.")
Declaration(Class(goldbook:15136))
AnnotationAssertion(rdfs:label goldbook:15136 "wetland")
AnnotationAssertion(dcterms:description goldbook:15136 "Area of land consisting of soil that is saturated with moisture, such as a swamp, marsh, or bog.")
Declaration(Class(goldbook:15137))
AnnotationAssertion(rdfs:label goldbook:15137 "whole-effluent toxicity")
AnnotationAssertion(dcterms:description goldbook:15137 "Total toxic effect of an effluent measured directly with aquatic organisms in a toxicity test.")
Declaration(Class(goldbook:15138))
AnnotationAssertion(rdfs:label goldbook:15138 "whole sediment")
AnnotationAssertion(dcterms:description goldbook:15138 "Sediment and associated interstitial water that have had minimal manipulation.")
Declaration(Class(goldbook:15139))
AnnotationAssertion(rdfs:label goldbook:15139 "zooplankton")
AnnotationAssertion(dcterms:description goldbook:15139 "Small floating or weakly swimming animals that drift with water currents and which, with phytoplankton, make up the planktonic food supply upon which almost all oceanic organisms ultimately depend.")
Declaration(Class(goldbook:15140))
AnnotationAssertion(rdfs:label goldbook:15140 "normal equivalent deviation")
AnnotationAssertion(dcterms:description goldbook:15140 "Proportion dying in a toxicity test expressed in terms of standard deviations from the mean of a normal curve.")
Declaration(Class(goldbook:15141))
AnnotationAssertion(rdfs:label goldbook:15141 "absolute bioavailability")
AnnotationAssertion(dcterms:description goldbook:15141 "Fraction of the administered dose of a drug from a dosage form absorbed intact into the systemic circulation.")
Declaration(Class(goldbook:15142))
AnnotationAssertion(rdfs:label goldbook:15142 "active transport of drugs")
AnnotationAssertion(dcterms:description goldbook:15142 "Carriage of a solute across a biological membrane, which requires a suitable carrier and the expenditure of energy.")
Declaration(Class(goldbook:15143))
AnnotationAssertion(rdfs:label goldbook:15143 "administration")
AnnotationAssertion(dcterms:description goldbook:15143 "Introduction of a substance to an organism by a defined route.")
Declaration(Class(goldbook:15144))
AnnotationAssertion(rdfs:label goldbook:15144 "administration of drugs ocular route")
AnnotationAssertion(dcterms:description goldbook:15144 "Administration of drugs through the eye.")
Declaration(Class(goldbook:15145))
AnnotationAssertion(rdfs:label goldbook:15145 "administration of drugs oral route")
AnnotationAssertion(dcterms:description goldbook:15145 "Administration of drugs through the mouth to swallow.")
Declaration(Class(goldbook:15146))
AnnotationAssertion(rdfs:label goldbook:15146 "administration of drugs parenteral route")
AnnotationAssertion(dcterms:description goldbook:15146 "Method of introducing substances into an organism, avoiding the gastrointestinal tract.")
Declaration(Class(goldbook:15147))
AnnotationAssertion(rdfs:label goldbook:15147 "administration of drugs rectal route")
AnnotationAssertion(dcterms:description goldbook:15147 "Administration of drugs into the rectal cavity or through the rectum.")
Declaration(Class(goldbook:15148))
AnnotationAssertion(rdfs:label goldbook:15148 "administration of drugs respiratory route")
AnnotationAssertion(dcterms:description goldbook:15148 "Delivery to the lower respiratory tract in order to obtain a local or systemic effect.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15148 "introduction of drugs by inhalation")
Declaration(Class(goldbook:15149))
AnnotationAssertion(rdfs:label goldbook:15149 "administration of drugs topical route")
AnnotationAssertion(dcterms:description goldbook:15149 "Administration of drugs on surfaces of the body.")
Declaration(Class(goldbook:15150))
AnnotationAssertion(rdfs:label goldbook:15150 "administration of drugs transdermal route")
AnnotationAssertion(dcterms:description goldbook:15150 "Introduction of products through unbroken skin by means of a specific drug delivery system (such as a patch containing a semi-solid formulation of the drug) for systemic and/or prolonged drug effect.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15150 "diadermic administration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15150 "percutaneous administration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15150 "transcutaneous administration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15150 "transdermic administration")
Declaration(Class(goldbook:15151))
AnnotationAssertion(rdfs:label goldbook:15151 "administration of drugs vaginal route")
AnnotationAssertion(dcterms:description goldbook:15151 "Introduction of products into the vagina normally for local effect.")
Declaration(Class(goldbook:15152))
AnnotationAssertion(rdfs:label goldbook:15152 "angle of repose")
AnnotationAssertion(dcterms:description goldbook:15152 "Characteristic angle of slope formed with the horizontal by the side of a static conical mound of powder.")
Declaration(Class(goldbook:15153))
AnnotationAssertion(rdfs:label goldbook:15153 "appertisation")
AnnotationAssertion(dcterms:description goldbook:15153 "Process by which food is rendered free from pathogenic, toxigenic, and spoilage organisms.")
Declaration(Class(goldbook:15154))
AnnotationAssertion(rdfs:label goldbook:15154 "bioequivalence")
AnnotationAssertion(dcterms:description goldbook:15154 """Relationship between two preparations of the same drug in the same dosage form that have a similar bioavailability.
Dosage forms containing the same drug are said to be bioequivalent if they do not differ significantly in the bioavailability (e.g., AUC, \\(c_{\\rm{max}}\\), \\(t_{\\rm{max}}\\)) of the active constituent/ingredient, when administered in the same dose under similar experimental conditions.""")
Declaration(Class(goldbook:15155))
AnnotationAssertion(rdfs:label goldbook:15155 "biological product")
AnnotationAssertion(dcterms:description goldbook:15155 "Virus, therapeutic serum, toxin, antitoxin, or analogous product applicable to the prevention, treatment, or cure of diseases or injuries in humans and/or animals.")
Declaration(Class(goldbook:15156))
AnnotationAssertion(rdfs:label goldbook:15156 "biopharmaceutics")
AnnotationAssertion(dcterms:description goldbook:15156 "Branch of pharmaceutical science that deals with the fate of drugs in the living system; particularly the release of the drug from its dosage form into a biological medium, its passage across membranes into the systemic circulation, metabolism, and elimination, and the application of this knowledge to obtain the desired therapeutic effect.")
Declaration(Class(goldbook:15157))
AnnotationAssertion(rdfs:label goldbook:15157 "buccal tablet")
AnnotationAssertion(dcterms:description goldbook:15157 "Usually a small, flat, and soft tablet, which is designed to be placed inside the cheek to be directly absorbed through the mucosa for systemic effect.")
Declaration(Class(goldbook:15158))
AnnotationAssertion(rdfs:label goldbook:15158 "bulk density")
AnnotationAssertion(dcterms:description goldbook:15158 "Characteristic of a powder rather than of individual particles given by the mass of powder occupying a known volume.")
Declaration(Class(goldbook:15159))
AnnotationAssertion(rdfs:label goldbook:15159 "capsule")
AnnotationAssertion(dcterms:description goldbook:15159 "Small edible package made usually from gelatin or other materials that can be filled with drugs (solids or liquids) to produce a unit dose, mainly for oral use. Hard capsules consist of two pieces that fit one inside the other which are produced empty and filled in a separate operation, and soft, liquid-filled capsules, which are manufactured and filled in one operation.")
Declaration(Class(goldbook:15160))
AnnotationAssertion(rdfs:label goldbook:15160 "carrier-mediated drug transport")
AnnotationAssertion(dcterms:description goldbook:15160 "Transfer of a drug across a membrane by a transporter (often a protein) constituent of the cytosol membrane. Also known as active transport as opposed to passive diffusion/absorption.")
Declaration(Class(goldbook:15161))
AnnotationAssertion(rdfs:label goldbook:15161 "coating")
AnnotationAssertion(dcterms:description goldbook:15161 "Technological process consisting of the application of a substance, which forms a layer (e.g., to protect the drug and/or the tablet, to mask taste, to control the rate of drug release (e.g., film coating, sugar coating).")
Declaration(Class(goldbook:15162))
AnnotationAssertion(rdfs:label goldbook:15162 "compressed tablet")
AnnotationAssertion(dcterms:description goldbook:15162 "A solid dosage form prepared to a desired shape, usually in large-scale production, by means of high pressure in a punch and die.")
Declaration(Class(goldbook:15163))
AnnotationAssertion(rdfs:label goldbook:15163 "controlled-release dosage form")
AnnotationAssertion(dcterms:description goldbook:15163 "Medication, which due to its special technological construction provides for drug release having predefined kinetics (zero order, \\(t^{1/2}\\), first order, etc.) at a sufficient rate to maintain the desired therapeutic level over an extended period of time.")
Declaration(Class(goldbook:15164))
AnnotationAssertion(rdfs:label goldbook:15164 "critical moisture content")
AnnotationAssertion(dcterms:description goldbook:15164 "A stage in the drying of solids, above which the drying rate (derived from the plot of the loss of moisture content against time) is linear, at which the drying rate ceases to be linear, until it reaches the equilibrium moisture content.")
Declaration(Class(goldbook:15165))
AnnotationAssertion(rdfs:label goldbook:15165 "crossover study")
AnnotationAssertion(dcterms:description goldbook:15165 "Type of comparative bioavailability study designed in such a way as to take into account differences in bioavailability arising from differences between patients suffering from disease, participating in the study.")
Declaration(Class(goldbook:15166))
AnnotationAssertion(rdfs:label goldbook:15166 "crystalline")
AnnotationAssertion(dcterms:description goldbook:15166 "Term that describes a solid of regular shape and the presence of three-dimensional order on the level of atomic dimensions, for a given molecule.")
Declaration(Class(goldbook:15167))
AnnotationAssertion(rdfs:label goldbook:15167 "delayed-release dosage form")
AnnotationAssertion(dcterms:description goldbook:15167 "Pharmaceutical preparation that releases the drug(s) at a time other than promptly after administration.")
Declaration(Class(goldbook:15168))
AnnotationAssertion(rdfs:label goldbook:15168 "deliquescent")
AnnotationAssertion(dcterms:description goldbook:15168 "Substance that absorbs sufficient moisture from the atmosphere to dissolve itself.")
Declaration(Class(goldbook:15169))
AnnotationAssertion(rdfs:label goldbook:15169 "depot")
AnnotationAssertion(dcterms:description goldbook:15169 "Deposit of a drug in a body created by injection or by a similar mode of introduction to form a source of slow release.")
Declaration(Class(goldbook:15170))
AnnotationAssertion(rdfs:label goldbook:15170 "detergency")
AnnotationAssertion(dcterms:description goldbook:15170 "Property, which serves as basis for the process whereby surfactants are used for the removal of foreign matter from surfaces (including dirt from clothes or body surfaces).")
Declaration(Class(goldbook:15171))
AnnotationAssertion(rdfs:label goldbook:15171 "diffusion barrier")
AnnotationAssertion(dcterms:description goldbook:15171 "Obstacle such as coating or embedding, which acts as a factor controlling the rate of drug release.")
Declaration(Class(goldbook:15172))
AnnotationAssertion(rdfs:label goldbook:15172 "disperse system")
AnnotationAssertion(dcterms:description goldbook:15172 "Dosage form in which the active ingredient is insoluble in the carrier; includes aerosols (solids or liquids in gas), suspensions (solids in liquids), emulsions (liquids in liquids), and foams (gas in liquid), or ointments/creams (solid in solid or in semi-solid, or liquid in solid).")
Declaration(Class(goldbook:15173))
AnnotationAssertion(rdfs:label goldbook:15173 "divided granule")
AnnotationAssertion(dcterms:description goldbook:15173 "Formulation in which individual doses of a granulated dosage form are separated (e.g., gelatin capsules).")
Declaration(Class(goldbook:15174))
AnnotationAssertion(rdfs:label goldbook:15174 "divided powder")
AnnotationAssertion(dcterms:description goldbook:15174 "Powder formulation in which individual doses of a powdered dosage form are separately wrapped (e.g., sachets, envelopes, or gelatin capsules).")
Declaration(Class(goldbook:15175))
AnnotationAssertion(rdfs:label goldbook:15175 "dosage form")
AnnotationAssertion(dcterms:description goldbook:15175 "Formulated preparation of molecules/drugs that are rarely if ever suitable for administration to patients without additives.")
Declaration(Class(goldbook:15176))
AnnotationAssertion(rdfs:label goldbook:15176 "dosage regimen")
AnnotationAssertion(dcterms:description goldbook:15176 "Dose and dosing interval of a drug.")
Declaration(Class(goldbook:15177))
AnnotationAssertion(rdfs:label goldbook:15177 "drug delivery system")
AnnotationAssertion(dcterms:description goldbook:15177 "Sophisticated dosage form, which, by its construction, is able to modify/control the availability of the drug substance to the body by temporal or spatial considerations.")
Declaration(Class(goldbook:15178))
AnnotationAssertion(rdfs:label goldbook:15178 "drug-eluting stent")
AnnotationAssertion(dcterms:description goldbook:15178 "Refers to a stent with an active drug that is intended to produce a therapeutic effect (e.g., reduction of restenosis).")
Declaration(Class(goldbook:15179))
AnnotationAssertion(rdfs:label goldbook:15179 "dusting powder")
AnnotationAssertion(dcterms:description goldbook:15179 "Usually intended for external use.")
Declaration(Class(goldbook:15180))
AnnotationAssertion(rdfs:label goldbook:15180 "effervescent tablet")
AnnotationAssertion(dcterms:description goldbook:15180 "Solid preparation that on contact with water breaks apart by the effect of gas (usually \\(\\ce{CO2}\\)) evolution, resulting commonly from the reaction of hydrogen carbonate with citric or tartaric acid, in order to facilitate dissolution or dispersion of the active ingredient before ingestion.")
Declaration(Class(goldbook:15181))
AnnotationAssertion(rdfs:label goldbook:15181 "efflorescent")
AnnotationAssertion(dcterms:description goldbook:15181 "Substance that loses water to form a lower hydrate or becomes anhydrous spontaneously.")
Declaration(Class(goldbook:15182))
AnnotationAssertion(rdfs:label goldbook:15182 "elixir")
AnnotationAssertion(dcterms:description goldbook:15182 "Sweet (often colored) dilute alcohol-based, 'hydroalcoholic', liquid used in the compounding of drugs to be taken by mouth in order to improve palatability.")
Declaration(Class(goldbook:15183))
AnnotationAssertion(rdfs:label goldbook:15183 "embedding")
AnnotationAssertion(dcterms:description goldbook:15183 "Technological process, which consists of mixing or inclusion of the therapeutic substance with an excipient or their mixtures, typically as a matrix dosage form, in order to change the rate of release.")
Declaration(Class(goldbook:15184))
AnnotationAssertion(rdfs:label goldbook:15184 "enemas")
AnnotationAssertion(dcterms:description goldbook:15184 "Solutions (aqueous or oily), emulsions, or suspensions for rectal administration of medicaments for cleansing, diagnostic, or therapeutic purposes.")
Declaration(Class(goldbook:15185))
AnnotationAssertion(rdfs:label goldbook:15185 "enteric coating")
AnnotationAssertion(dcterms:description goldbook:15185 "Used on tablets, granules, pellets, and capsules to make them resistant to gastric fluids but designed to disintegrate, disrupt, or dissolve when the preparation enters the duodenum.")
Declaration(Class(goldbook:15186))
AnnotationAssertion(rdfs:label goldbook:15186 "equilibrium moisture content")
AnnotationAssertion(dcterms:description goldbook:15186 "Final stage reached after drying of a solid, beyond the critical moisture content.")
Declaration(Class(goldbook:15187))
AnnotationAssertion(rdfs:label goldbook:15187 "fast-dissolving tablet")
AnnotationAssertion(dcterms:description goldbook:15187 "A tablet formulation intended for a rapid release of its active agent.")
Declaration(Class(goldbook:15188))
AnnotationAssertion(rdfs:label goldbook:15188 "formulation")
AnnotationAssertion(dcterms:description goldbook:15188 "Summary of operations carried out to convert a pharmacologically active compound into a dosage form suitable for administration.")
Declaration(Class(goldbook:15189))
AnnotationAssertion(rdfs:label goldbook:15189 "gargle")
AnnotationAssertion(dcterms:description goldbook:15189 "Aqueous solution used for the prevention and treatment of mouth and throat infections.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15189 "mouthwash")
Declaration(Class(goldbook:15190))
AnnotationAssertion(rdfs:label goldbook:15190 "gastric emptying rate")
AnnotationAssertion(dcterms:description goldbook:15190 "Pace at which a drug along with the stomach content leaves and enters the duodenum.")
Declaration(Class(goldbook:15191))
AnnotationAssertion(rdfs:label goldbook:15191 "gene therapy")
AnnotationAssertion(dcterms:description goldbook:15191 "Use of products containing genetic material (e.g., pDNA, antisense DNA, siRNA) to treat a disease or condition, or to modify or manipulate the expression of genetic material or to alter the biological properties of living cells.")
Declaration(Class(goldbook:15192))
AnnotationAssertion(rdfs:label goldbook:15192 "generic")
AnnotationAssertion(dcterms:description goldbook:15192 "Drug(s) or formulation(s) of drug(s) or dosage forms, which no longer have patent protection.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15192 "generics")
Declaration(Class(goldbook:15193))
AnnotationAssertion(rdfs:label goldbook:15193 "granules")
AnnotationAssertion(dcterms:description goldbook:15193 "Powder particles, which have been aggregated to form larger irregular particles, usually of \\(\\pu{0.5\\!{-}\\! 2 mm}\\) diameter.")
Declaration(Class(goldbook:15194))
AnnotationAssertion(rdfs:label goldbook:15194 "granulation")
AnnotationAssertion(dcterms:description goldbook:15194 "Process in which powder particles are made to aggregate to larger particles called granules.")
Declaration(Class(goldbook:15195))
AnnotationAssertion(rdfs:label goldbook:15195 "hydrate")
AnnotationAssertion(dcterms:description goldbook:15195 "Crystalline form of a compound in which water molecules are part of the crystal structure.")
Declaration(Class(goldbook:15196))
AnnotationAssertion(rdfs:label goldbook:15196 "hydrophile-lipophile balance system")
AnnotationAssertion(dcterms:description goldbook:15196 "Empirical scale (of \\(0\\!-\\!20\\)) used to classify surfactants and emulsifying agents.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15196 "HLB System")
Declaration(Class(goldbook:15197))
AnnotationAssertion(rdfs:label goldbook:15197 "hygroscopicity")
AnnotationAssertion(dcterms:description goldbook:15197 "Tendency of a substance to absorb water from the atmosphere.")
Declaration(Class(goldbook:15198))
AnnotationAssertion(rdfs:label goldbook:15198 "immediate-release tablet")
AnnotationAssertion(dcterms:description goldbook:15198 "Dosage form that releases the drug immediately.")
Declaration(Class(goldbook:15199))
AnnotationAssertion(rdfs:label goldbook:15199 "inactivation factor")
AnnotationAssertion(dcterms:description goldbook:15199 "Number that expresses the reduction in the numbers of a microorganism, brought about by a sterilization process.")
Declaration(Class(goldbook:15200))
AnnotationAssertion(rdfs:label goldbook:15200 "inhalation therapy")
AnnotationAssertion(dcterms:description goldbook:15200 "Administration of drugs directly to the respiratory tract, mostly by aerosols.")
Declaration(Class(goldbook:15201))
AnnotationAssertion(rdfs:label goldbook:15201 "injection")
AnnotationAssertion(dcterms:description goldbook:15201 "Delivery of a generally sterile liquid medication into the body, or a vessel, tissue, or organ via syringe and needle.")
Declaration(Class(goldbook:15202))
AnnotationAssertion(rdfs:label goldbook:15202 "liniment")
AnnotationAssertion(dcterms:description goldbook:15202 "Liquid intended for massaging into the skin.")
Declaration(Class(goldbook:15203))
AnnotationAssertion(rdfs:label goldbook:15203 "loading dose")
AnnotationAssertion(dcterms:description goldbook:15203 "Initial, typically larger than the maintenance dose of a drug given to a patient at the start of pharmacotherapy.")
Declaration(Class(goldbook:15204))
AnnotationAssertion(rdfs:label goldbook:15204 "lotion")
AnnotationAssertion(dcterms:description goldbook:15204 "Solution, emulsion, or suspension to be applied to the skin.")
Declaration(Class(goldbook:15205))
AnnotationAssertion(rdfs:label goldbook:15205 "lozenge")
AnnotationAssertion(dcterms:description goldbook:15205 "Tablet, which does not contain a disintegrant and which is sucked to dissolve in the mouth to produce either a local (e.g., antiseptic) or systemic (e.g., vitamins) effect.")
Declaration(Class(goldbook:15206))
AnnotationAssertion(rdfs:label goldbook:15206 "lubricant")
AnnotationAssertion(dcterms:description goldbook:15206 "Used as processing aid in tablet and capsule manufacturing, to facilitate the movement of the formulation into the dye and punch and to reduce the energy of compression.")
Declaration(Class(goldbook:15207))
AnnotationAssertion(rdfs:label goldbook:15207 "matrix formulation")
AnnotationAssertion(dcterms:description goldbook:15207 "Specific case of drug embedding in insoluble excipients (typically in a polymer) in order to achieve extended release.")
Declaration(Class(goldbook:15208))
AnnotationAssertion(rdfs:label goldbook:15208 "maximum additive concentration")
AnnotationAssertion(dcterms:description goldbook:15208 "Maximum concentration of a drug, which will form a clear solution with a given concentration of surfactant.")
Declaration(Class(goldbook:15209))
AnnotationAssertion(rdfs:label goldbook:15209 "maximum safe concentration")
AnnotationAssertion(dcterms:description goldbook:15209 "Concentration of a drug in the plasma, above which side effects are likely to occur in a patient.")
Declaration(Class(goldbook:15210))
AnnotationAssertion(rdfs:label goldbook:15210 "minimum effective plasma concentration")
AnnotationAssertion(dcterms:description goldbook:15210 "Concentration of a drug that must be achieved in the plasma before any desired therapeutic or pharmacological effect can be obtained.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15210 "minimum therapeutic plasma concentration")
Declaration(Class(goldbook:15211))
AnnotationAssertion(rdfs:label goldbook:15211 "minimum inhibitory concentration")
AnnotationAssertion(dcterms:description goldbook:15211 "Lowest concentration of an antibacterial drug necessary to inhibit the growth of a microorganism.")
Declaration(Class(goldbook:15212))
AnnotationAssertion(rdfs:label goldbook:15212 "modified release")
AnnotationAssertion(dcterms:description goldbook:15212 "Release of a drug from a dosage form that it is not immediate (e.g., sustained release, retarded release, delayed-action preparations, controlled release, extended release, etc.).")
Declaration(Class(goldbook:15213))
AnnotationAssertion(rdfs:label goldbook:15213 "moistening agents")
AnnotationAssertion(dcterms:description goldbook:15213 "Usually water or low-molecular-weight alcohols or compounds, used in topical applications and in wet granulation, for the production of tablets.")
Declaration(Class(goldbook:15214))
AnnotationAssertion(rdfs:label goldbook:15214 "multicompartment formulation")
AnnotationAssertion(dcterms:description goldbook:15214 "Dosage form (capsule, tablet) comprising several elements (e.g., microspheres or coated pellets) differing in the rate of drug release.")
Declaration(Class(goldbook:15215))
AnnotationAssertion(rdfs:label goldbook:15215 "multilayer tablet")
AnnotationAssertion(dcterms:description goldbook:15215 "Consists of several different layers that are compressed on top of each other, to form a single tablet composed of two or more layers.")
Declaration(Class(goldbook:15216))
AnnotationAssertion(rdfs:label goldbook:15216 "nanoencapsulation")
AnnotationAssertion(dcterms:description goldbook:15216 "Formation of nanoparticles encapsulating a drug.")
Declaration(Class(goldbook:15217))
AnnotationAssertion(rdfs:label goldbook:15217 "ointment")
AnnotationAssertion(dcterms:description goldbook:15217 "Greasy, semi-solid preparation for external application, often anhydrous, containing dissolved or dispersed medicaments.")
Declaration(Class(goldbook:15218))
AnnotationAssertion(rdfs:label goldbook:15218 "one-compartment model")
AnnotationAssertion(dcterms:description goldbook:15218 "Kinetic model, where the whole body is thought of as a single compartment in which a substance is distributed rapidly, achieving an equilibrium between blood and tissue immediately.")
Declaration(Class(goldbook:15219))
AnnotationAssertion(rdfs:label goldbook:15219 "onset of drug action")
AnnotationAssertion(dcterms:description goldbook:15219 "Time required to achieve the minimum effective plasma concentration following administration of the dosage form.")
Declaration(Class(goldbook:15220))
AnnotationAssertion(rdfs:label goldbook:15220 "paste")
AnnotationAssertion(dcterms:description goldbook:15220 "Ointment containing \\(\\gt \\pu{0\\%}\\) of powder, dispersed in a fatty base.")
Declaration(Class(goldbook:15221))
AnnotationAssertion(rdfs:label goldbook:15221 "pellet")
AnnotationAssertion(dcterms:description goldbook:15221 """Very small tablet or pilule.
Implantable polymeric matrix.
Spherical granule.""")
Declaration(Class(goldbook:15222))
AnnotationAssertion(rdfs:label goldbook:15222 "pelletisation")
AnnotationAssertion(dcterms:description goldbook:15222 "Process of agglomeration that converts fine powders or granules of bulk drugs and excipients into small, free-flowing, spherical, or semi-spherical units, referred to as pellets.")
Declaration(Class(goldbook:15223))
AnnotationAssertion(rdfs:label goldbook:15223 "pharmaceutical equivalence")
AnnotationAssertion(dcterms:description goldbook:15223 "To be pharmaceutically equivalent, the generic and proprietary formulations must (1) contain the same amount of active ingredient; (2) contain the same active ingredient in the same dosage form; (3) be intended for the same route of administration; and (4) generally be labeled for the same conditions of use.")
Declaration(Class(goldbook:15224))
AnnotationAssertion(rdfs:label goldbook:15224 "pharmaceutics")
AnnotationAssertion(dcterms:description goldbook:15224 "Science of preparation of drugs, dosage forms, and drug delivery systems taking into account the pharmacokinetics and pharmacodynamics of the drug as well as its physical and chemical properties.")
Declaration(Class(goldbook:15225))
AnnotationAssertion(rdfs:label goldbook:15225 "polymorph")
AnnotationAssertion(dcterms:description goldbook:15225 "Solid material that exists at least in two different molecular arrangements, i.e., distinctly different crystal species.")
Declaration(Class(goldbook:15226))
AnnotationAssertion(rdfs:label goldbook:15226 "powder grades")
AnnotationAssertion(dcterms:description goldbook:15226 "Defined for powders used pharmaceutically, according to particle sizes.")
Declaration(Class(goldbook:15227))
AnnotationAssertion(rdfs:label goldbook:15227 "powder")
AnnotationAssertion(dcterms:description goldbook:15227 "Dry solid material consisting of many, usually free flowing, fine particles. Conventionally, the title 'powder' should be restricted to powder mixes for internal use and alternative terms are used for other powdered formulations presented in this way, e.g., dusting powders, which are for external use.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15227 "powders")
Declaration(Class(goldbook:15228))
AnnotationAssertion(rdfs:label goldbook:15228 "preformulation")
AnnotationAssertion(dcterms:description goldbook:15228 "Exploratory activity that begins early in pharmaceutics, involving studies designed to determine the compatibility of excipients with the active substance for a biopharmaceutical; physicochemical and bioanalytical investigation in support of promising experimental formulations.")
Declaration(Class(goldbook:15229))
AnnotationAssertion(rdfs:label goldbook:15229 "pseudopolymorph")
AnnotationAssertion(dcterms:description goldbook:15229 "Different crystalline form(s) of a solvated compound that differ in the identity and/or the stoichiometry of the solvating molecule.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15229 "pseudopolymorphs")
Declaration(Class(goldbook:15230))
AnnotationAssertion(rdfs:label goldbook:15230 "repeat action dosage form")
AnnotationAssertion(dcterms:description goldbook:15230 "Tablet or capsule distinguished from a sustained-release dosage form, by the fact that it releases the medicinal agent, or part of it, at any time other than promptly after administration as opposed to a slow, controlled manner.")
Declaration(Class(goldbook:15231))
AnnotationAssertion(rdfs:label goldbook:15231 "sieving")
AnnotationAssertion(dcterms:description goldbook:15231 "Process that differentiates or separates solid particles according to their size using a meshed or perforated device.")
Declaration(Class(goldbook:15232))
AnnotationAssertion(rdfs:label goldbook:15232 "slugging")
AnnotationAssertion(dcterms:description goldbook:15232 "Method by which powder particles are compressed into a large tablet, called a slug, which is subsequently dry-screened and compressed into a tablet.")
Declaration(Class(goldbook:15233))
AnnotationAssertion(rdfs:label goldbook:15233 "solubilising agents")
AnnotationAssertion(dcterms:description goldbook:15233 "Additives making a substance soluble or more soluble, especially in water.")
Declaration(Class(goldbook:15234))
AnnotationAssertion(rdfs:label goldbook:15234 "solvate")
AnnotationAssertion(dcterms:description goldbook:15234 "Crystalline form of a compound in which one or more solvent molecules are part of the crystal structure.")
Declaration(Class(goldbook:15235))
AnnotationAssertion(rdfs:label goldbook:15235 "spheronisation")
AnnotationAssertion(dcterms:description goldbook:15235 "Process of making dense, spherical pellets by means of special spheronizing or pelletizing equipment.")
Declaration(Class(goldbook:15236))
AnnotationAssertion(rdfs:label goldbook:15236 "stent")
AnnotationAssertion(dcterms:description goldbook:15236 "Scaffold placed into narrowed, diseased vessels (mainly coronary arteries) or a device implanted in a vessel used to help keep it open.")
Declaration(Class(goldbook:15237))
AnnotationAssertion(rdfs:label goldbook:15237 "sublingual tablets")
AnnotationAssertion(dcterms:description goldbook:15237 "Usually small, flat, and soft tablets, which are designed to be placed under the tongue to allow direct absorption of the active ingredient through the mucosa for systemic effect.")
Declaration(Class(goldbook:15238))
AnnotationAssertion(rdfs:label goldbook:15238 "suppositories")
AnnotationAssertion(dcterms:description goldbook:15238 "Dosage form, semi-solid, used for the administration of drugs via the rectal route, for systemic or local effect. When application is via other routes (e.g., the vaginal route), suppositories are termed differently, inserts, pessaries, etc.")
Declaration(Class(goldbook:15239))
AnnotationAssertion(rdfs:label goldbook:15239 "sustained release")
AnnotationAssertion(dcterms:description goldbook:15239 "Dosage form designed to release the drug contained therein at a continuous and controlled rate for a longer period of time that can normally be achieved with its conventional, nonsustained counterpart.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15239 "extended release")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15239 "gradual release")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15239 "long acting")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15239 "prolonged action")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15239 "slow release")
Declaration(Class(goldbook:15240))
AnnotationAssertion(rdfs:label goldbook:15240 "syrup")
AnnotationAssertion(dcterms:description goldbook:15240 "Liquid preparation of high sugar concentration with or without medicinal and additional flavoring substances.")
Declaration(Class(goldbook:15241))
AnnotationAssertion(rdfs:label goldbook:15241 "tablet")
AnnotationAssertion(dcterms:description goldbook:15241 "Solid dosage form compressed into a specific shape containing medicinal substances with or without suitable diluents.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15241 "pastille")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15241 "pellet")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15241 "pill")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15241 "troche")
Declaration(Class(goldbook:15242))
AnnotationAssertion(rdfs:label goldbook:15242 "tablet coating")
AnnotationAssertion(dcterms:description goldbook:15242 """Solid layers based typically on cellulose derivatives and may include plasticizers and pigments. They are usually employed for one or more of the following reasons:

Protection of the ingredients (from light or moisture).
Masking the bad taste of the drug.
Masking possible batchwise differences in the appearance of raw materials and hence allaying possible patient concern over tablets of differing appearance.
Coating confers mechanical strength and facilitates handling.
Colored coating aids in the rapid identification of a product.
Functional film coating is used to impart enteric or controlled-release properties to the tablet.""")
Declaration(Class(goldbook:15243))
AnnotationAssertion(rdfs:label goldbook:15243 "troche")
AnnotationAssertion(dcterms:description goldbook:15243 "Applied to compressed lozenges. In lay language, lozenge and troche are used interchangeably.")
Declaration(Class(goldbook:15244))
AnnotationAssertion(rdfs:label goldbook:15244 "acrylic polymer")
AnnotationAssertion(dcterms:description goldbook:15244 "Polymer prepared from acrylic acid or a derivative of acrylic acid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15244 "acrylate polymer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15244 "acrylic")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15244 "polyacrylic")
Declaration(Class(goldbook:15245))
AnnotationAssertion(rdfs:label goldbook:15245 "amino polymer")
AnnotationAssertion(dcterms:description goldbook:15245 "Polymer prepared by polycondensation of an amino component such as amine or amide with an aldehyde, or by curing reactive oligomers prepared from an amino component and an aldehyde.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15245 "amide-aldehyde polymer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15245 "amine-aldehyde polymer")
Declaration(Class(goldbook:15246))
AnnotationAssertion(rdfs:label goldbook:15246 "coumarone-indene polymer")
AnnotationAssertion(dcterms:description goldbook:15246 "Polymer prepared from a mixture containing 1-benzofuran (formerly coumarone) and indene.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15246 "1-benzofuran-indene polymer")
Declaration(Class(goldbook:15247))
AnnotationAssertion(rdfs:label goldbook:15247 "epoxy polymer")
AnnotationAssertion(dcterms:description goldbook:15247 "Polymer prepared by reaction of compounds carrying two or more epoxy groups (reactive epoxides) with curing agents.")
Declaration(Class(goldbook:15248))
AnnotationAssertion(rdfs:label goldbook:15248 "furan polymer")
AnnotationAssertion(dcterms:description goldbook:15248 "Polymer prepared from furan or a furan derivative.")
Declaration(Class(goldbook:15249))
AnnotationAssertion(rdfs:label goldbook:15249 "phenolic polymer")
AnnotationAssertion(dcterms:description goldbook:15249 "Polymer prepared by the polycondensation of phenols and aldehydes or by curing reactive oligomers prepared from phenols and aldehydes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15249 "phenol-aldehyde polymer")
Declaration(Class(goldbook:15250))
AnnotationAssertion(rdfs:label goldbook:15250 "polybismaleimide")
AnnotationAssertion(dcterms:description goldbook:15250 "Polymer prepared from a bismaleimide.")
Declaration(Class(goldbook:15251))
AnnotationAssertion(rdfs:label goldbook:15251 "polycarborane")
AnnotationAssertion(dcterms:description goldbook:15251 "Polymer prepared from a carborane.")
Declaration(Class(goldbook:15252))
AnnotationAssertion(rdfs:label goldbook:15252 "polydiene")
AnnotationAssertion(dcterms:description goldbook:15252 "Polymer prepared from a diene, or a substituted diene, or both in admixture.")
Declaration(Class(goldbook:15253))
AnnotationAssertion(rdfs:label goldbook:15253 "polyisocyanate")
AnnotationAssertion(dcterms:description goldbook:15253 "Polymer prepared from an isocyanate.")
Declaration(Class(goldbook:15254))
AnnotationAssertion(rdfs:label goldbook:15254 "polyisocyanide")
AnnotationAssertion(dcterms:description goldbook:15254 "Polymer prepared from an isocyanide.")
Declaration(Class(goldbook:15255))
AnnotationAssertion(rdfs:label goldbook:15255 "polyolefin")
AnnotationAssertion(dcterms:description goldbook:15255 "Polymer prepared from an olefin.")
Declaration(Class(goldbook:15256))
AnnotationAssertion(rdfs:label goldbook:15256 "polyvinyl acetal")
AnnotationAssertion(dcterms:description goldbook:15256 "Polymer prepared by acetalization of poly(vinyl alcohol) with an aldehyde.")
Declaration(Class(goldbook:15257))
AnnotationAssertion(rdfs:label goldbook:15257 "polyvinyl ester")
AnnotationAssertion(dcterms:description goldbook:15257 "Polymer prepared from a vinyl ester.")
Declaration(Class(goldbook:15258))
AnnotationAssertion(rdfs:label goldbook:15258 "polyvinyl ether")
AnnotationAssertion(dcterms:description goldbook:15258 "Polymer prepared from a vinyl ether.")
Declaration(Class(goldbook:15259))
AnnotationAssertion(rdfs:label goldbook:15259 "polyvinyl halide")
AnnotationAssertion(dcterms:description goldbook:15259 "Polymer prepared from a vinyl halide (monohalogenoethene).")
Declaration(Class(goldbook:15260))
AnnotationAssertion(rdfs:label goldbook:15260 "polyvinyl ketone")
AnnotationAssertion(dcterms:description goldbook:15260 "Polymer prepared from a vinyl ketone.")
Declaration(Class(goldbook:15261))
AnnotationAssertion(rdfs:label goldbook:15261 "styrene polymer")
AnnotationAssertion(dcterms:description goldbook:15261 "Polymer prepared from styrene, or a substituted styrene, or both in admixture.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15261 "polystyrene")
Declaration(Class(goldbook:15262))
AnnotationAssertion(rdfs:label goldbook:15262 "vinyl polymer")
AnnotationAssertion(dcterms:description goldbook:15262 "Polymer prepared from a monomer containing the vinyl group \\(\\ce{-CH=CH2}\\).")
Declaration(Class(goldbook:15263))
AnnotationAssertion(rdfs:label goldbook:15263 "vinylidene polymer")
AnnotationAssertion(dcterms:description goldbook:15263 "Polymer prepared from a monomer containing the ethene-1,1-diyl group \\(\\gt\\!\\ce{C=CH2}\\), formerly called vinylidene.")
Declaration(Class(goldbook:15264))
AnnotationAssertion(rdfs:label goldbook:15264 "polyalkenylene")
AnnotationAssertion(dcterms:description goldbook:15264 "Polymer composed of macromolecules containing exclusively alkene-α,ω-diyl (formerly alkenylene) constitutional repeating units: \\[\\ce{-[-CH=CH-[CH2]_{m}\\bond{-}]_{n}\\bond{-}}\\]")
