[Term]
id: goldbook:08612
name: hot transition
def: "Electronic transition between an excited state and a state in which all vibrational quantum numbers are the same or greater."
comment: "A hot band arises from a hot transition."
comment: "A hot transition has the same changes in vibrational quantum numbers as a fundamental, overtone transition, or sum transition but it originates in an excited vibrational state not the ground state."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
