Declaration(Class(goldbook:08356))
AnnotationAssertion(rdfs:label goldbook:08356 "heteronuclear Overhauser effect spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08356 "Heteronuclear variant of nuclear Overhauser effect spectroscopy (NOSEY) showing through space interaction between \\(\\ce{^{1}H}\\) and a heteronucleus, typically \\(\\ce{^{13}C}\\).")
Declaration(Class(goldbook:08357))
AnnotationAssertion(rdfs:label goldbook:08357 "heteronuclear shift correlation NMR")
AnnotationAssertion(dcterms:description goldbook:08357 "Directly-observed one-bond heteronuclear correlation experiment in nuclear magnetic resonance spectroscopy.")
Declaration(Class(goldbook:08358))
