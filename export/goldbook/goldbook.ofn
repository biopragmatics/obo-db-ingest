Declaration(Class(goldbook:S05828))
AnnotationAssertion(rdfs:label goldbook:S05828 "spectral radiant power")
AnnotationAssertion(dcterms:description goldbook:S05828 "The radiant power at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-1}\\), but a commonly used unit is \\(\\rm{W nm}^{-1}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:S05828 "total radiant power")
