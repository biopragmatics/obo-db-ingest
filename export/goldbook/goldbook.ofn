AnnotationAssertion(dcterms:description goldbook:12925 "Immune response to 'self' tissues or components.")
AnnotationAssertion(rdfs:comment goldbook:12925 "Such an immune response may have pathological consequences leading to autoimmune diseases."^^xsd:string)
