AnnotationAssertion(rdfs:label goldbook:11886 "motor endplate")
AnnotationAssertion(dcterms:description goldbook:11886 "Complex structure by which the axon of a motor neuron establishes synaptic contact with a skeletal muscle fiber.")
AnnotationAssertion(rdfs:seeAlso goldbook:11886 goldbook:11627)
AnnotationAssertion(rdfs:seeAlso goldbook:11886 goldbook:11887)
AnnotationAssertion(rdfs:seeAlso goldbook:11886 goldbook:12109)
AnnotationAssertion(mito:isMentionedBy goldbook:11886 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11886 "current"^^xsd:string)
Declaration(Class(goldbook:11887))
AnnotationAssertion(rdfs:label goldbook:11887 "motor neuron")
AnnotationAssertion(dcterms:description goldbook:11887 "Nerve cell in the spinal cord having an axon that leaves the central nervous system to establish a functional connection with an effector (muscle or glandular) tissue.")
AnnotationAssertion(rdfs:seeAlso goldbook:11887 goldbook:11627)
AnnotationAssertion(mito:isMentionedBy goldbook:11887 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11887 "current"^^xsd:string)
Declaration(Class(goldbook:11888))
AnnotationAssertion(rdfs:label goldbook:11888 "motor neuron disease")
AnnotationAssertion(dcterms:description goldbook:11888 "Generic term for a heterogeneous group of disorders, all affecting motor neurons in the brain, spinal cord, or both.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11888 "MND")
AnnotationAssertion(rdfs:seeAlso goldbook:11888 goldbook:11583)
AnnotationAssertion(rdfs:seeAlso goldbook:11888 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11888 goldbook:11887)
AnnotationAssertion(mito:isMentionedBy goldbook:11888 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11888 "current"^^xsd:string)
Declaration(Class(goldbook:11889))
AnnotationAssertion(rdfs:label goldbook:11889 "motor system")
AnnotationAssertion(dcterms:description goldbook:11889 "Part of the central nervous system responsible for control of movement, consisting of the pyramidal system controlling voluntary movement and the extrapyramidal system coordinating involuntary movement.")
AnnotationAssertion(mito:isMentionedBy goldbook:11889 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11889 "current"^^xsd:string)
Declaration(Class(goldbook:11890))
AnnotationAssertion(rdfs:label goldbook:11890 "multiple chemical sensitivity")
AnnotationAssertion(dcterms:description goldbook:11890 "Intolerance condition attributed to extreme sensitivity of individuals to various environmental chemicals, found in air, food, water, building materials, or fabrics.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11890 "MCS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11890 "environmental illness")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11890 "idiopathic environmental intolerance")
AnnotationAssertion(rdfs:comment goldbook:11890 "This syndrome is characterized by the patient’s belief that his or her symptoms are caused by very low-level exposure to environmental chemicals. The term \"chemical\" is used to refer broadly to many natural and man-made substances, some of which have several chemical constituents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11890 "Several theories have been advanced to explain the cause of multiple chemical sensitivity, including allergy, toxic effects, and neurobiological sensitization. There is insufficient scientific evidence to confirm a relationship between any of these possible causes and symptoms."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:11890 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11890 "current"^^xsd:string)
Declaration(Class(goldbook:11891))
AnnotationAssertion(rdfs:label goldbook:11891 "multiple sclerosis")
AnnotationAssertion(dcterms:description goldbook:11891 "Common demyelinating (see demyelination) disorder of the central nervous system, causing patches of sclerosis (plaques) in the brain and spinal cord.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11891 "MS")
AnnotationAssertion(rdfs:comment goldbook:11891 "Autoantibodies targeting myelin basic protein are believed to play an important role."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11891 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11891 goldbook:11707)
AnnotationAssertion(mito:isMentionedBy goldbook:11891 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11891 "current"^^xsd:string)
Declaration(Class(goldbook:11892))
AnnotationAssertion(rdfs:label goldbook:11892 "muscarinic")
AnnotationAssertion(dcterms:description goldbook:11892 "Referring to agents that stimulate the postganglionicparasympatheticreceptor, named after the prototypical mushroom alkaloid, muscarine [2,5-anhydro-1,4,6-trideoxy-6-(trimethylammonio)-D-ribo-hexitol].")
AnnotationAssertion(rdfs:comment goldbook:11892 "The muscarinic receptor has a recognition site for acetylcholine."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11892 "Muscarinic receptors are distinguished from nicotinic receptors, thus allowing classification of cholinergic receptors as muscarinic and nicotinic."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11892 "Drugs that bind with muscarinic cholinergic receptors but do not activate them, thus preventing access to acetylcholine, include atropine and scopolamine."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11892 goldbook:11557)
AnnotationAssertion(rdfs:seeAlso goldbook:11892 goldbook:11674)
AnnotationAssertion(rdfs:seeAlso goldbook:11892 goldbook:11779)
AnnotationAssertion(rdfs:seeAlso goldbook:11892 goldbook:11960)
AnnotationAssertion(rdfs:seeAlso goldbook:11892 goldbook:11993)
AnnotationAssertion(mito:isMentionedBy goldbook:11892 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11892 "current"^^xsd:string)
Declaration(Class(goldbook:11893))
AnnotationAssertion(rdfs:label goldbook:11893 "muscarinic receptor")
AnnotationAssertion(dcterms:description goldbook:11893 "One of the two main classes of acetylcholine receptors that responds to muscarinic agents.")
AnnotationAssertion(rdfs:seeAlso goldbook:11893 goldbook:11559)
AnnotationAssertion(rdfs:seeAlso goldbook:11893 goldbook:11892)
AnnotationAssertion(rdfs:seeAlso goldbook:11893 goldbook:11960)
