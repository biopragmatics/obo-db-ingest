property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15505
name: bilirubin
def: "Orange-yellow pigment\, a breakdown product of heme-containing proteins \(hemoglobin\, myoglobin\, cytochromes\)\, which circulates in the blood plasma bound to albumin or as water-soluble glucuronide conjugates\, and is excreted in the bile by the liver."
