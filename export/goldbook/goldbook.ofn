AnnotationAssertion(obo:goldbook#hasStatus goldbook:12162 "current"^^xsd:string)
Declaration(Class(goldbook:12163))
AnnotationAssertion(rdfs:label goldbook:12163 "ventricle")
AnnotationAssertion(dcterms:description goldbook:12163 "Normal cavity within an organ, as in the brain or heart.")
AnnotationAssertion(rdfs:comment goldbook:12163 "In the brain there are two lateral ventricles and two midline (called the third and fourth) ventricles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12163 "The ventricles in the brain are filled with, and produce most of, the cerebrospinal fluid, and play a critical role in its circulation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12163 goldbook:11647)
AnnotationAssertion(mito:isMentionedBy goldbook:12163 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12163 "current"^^xsd:string)
