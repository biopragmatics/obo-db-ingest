property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13846
name: orientation parameter
def: "Order parameter applied to macroscopic assemblies of ordered materials\, such as crystal assemblies in fibers."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-12
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13847
name: pendent chain
def: "Oligomeric or polymeric offshoot from a macromolecular chain."
comment: "A polymeric branch may be termed a "ong-chain branch"."
comment: "An oligomeric branch may be termed a "short-chain branch"."
synonym: "branch" []
synonym: "side-chain" []
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-12
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13848
name: polymersome
def: "Vesicle with radius ranging from \\\(\\pu\{50 nm\}\\\) to greater than \\\(\\pu\{5 \\upmu m\}\\\) constructed from an amphiphilic synthetic block copolymer."
comment: "Most reported polymersomes serve as hosts for an aqueous solution and are useful for the accommodation or temporary trapping of molecules such as drugs, enzymes, and other proteins and peptides in in vivo applications."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-12
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13849
name: polymolecular
def: "Consisting of many molecules."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-12
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:13850
name: polyrotaxane
def: "Polymer comprising mechanically interlocked molecular architectures typically of a macromolecule threaded through one or more macrocycles."
comment: "A polyrotaxane may also be composed of macromolecules comprising one or more macrocyclic main-chain or side-chain units threaded with linear chains."
comment: "The macrocycle(s) may be threaded onto the polymer backbone or side-chains."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-03-12
property_value: hasStatus "current" xsd:string
