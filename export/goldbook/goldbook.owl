    <!-- http://dx.doi.org/10.1351/goldbook.10770 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10770">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rounded mass of sensitive erectile tissue at the distal end (head) of the penis, analogous to the glans clitoridis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>glans penis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10769"/>
