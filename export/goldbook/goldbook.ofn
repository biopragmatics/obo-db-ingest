AnnotationAssertion(mito:isMentionedBy goldbook:15608 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15608 "current"^^xsd:string)
Declaration(Class(goldbook:15609))
AnnotationAssertion(rdfs:label goldbook:15609 "critical group")
AnnotationAssertion(dcterms:description goldbook:15609 "Part of a target population most in need of protection because it is most susceptible to a given toxicant.")
AnnotationAssertion(rdfs:seeAlso goldbook:15609 goldbook:16119)
AnnotationAssertion(mito:isMentionedBy goldbook:15609 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15609 "current"^^xsd:string)
Declaration(Class(goldbook:15610))
AnnotationAssertion(rdfs:label goldbook:15610 "critical organ")
AnnotationAssertion(dcterms:description goldbook:15610 "Organ that first attains the critical concentration of a substance and exhibits the critical effect under specified circumstances of exposure and for a given population.")
AnnotationAssertion(rdfs:seeAlso goldbook:15610 goldbook:15605)
AnnotationAssertion(rdfs:seeAlso goldbook:15610 goldbook:15607)
AnnotationAssertion(mito:isMentionedBy goldbook:15610 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15610 "current"^^xsd:string)
Declaration(Class(goldbook:15611))
AnnotationAssertion(rdfs:label goldbook:15611 "critical organ concentration")
AnnotationAssertion(dcterms:description goldbook:15611 "Mean concentration of a substance in the critical organ at the time the substance reaches its critical concentration in the most sensitive type of cell in the organ.")
AnnotationAssertion(rdfs:seeAlso goldbook:15611 goldbook:15605)
AnnotationAssertion(rdfs:seeAlso goldbook:15611 goldbook:15610)
AnnotationAssertion(mito:isMentionedBy goldbook:15611 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15611 "current"^^xsd:string)
