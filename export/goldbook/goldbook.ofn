AnnotationAssertion(dcterms:description goldbook:10327 "Inherited disorder where ossification of cartilage is retarded, especially affecting growth of long bones, resulting in very short limbs and a comparatively large head. Type of dwarfism.")
AnnotationAssertion(rdfs:comment goldbook:10327 "Achondroplasia results from a mutation in the fibroblast growth factor receptor FGFR3 gene, increasing its activity in suppressing endochondral ossification."^^xsd:string)
