Declaration(Class(goldbook:11254))
AnnotationAssertion(rdfs:label goldbook:11254 "stalk")
AnnotationAssertion(dcterms:description goldbook:11254 "In anatomy, narrow connection with an organ or other structure.")
Declaration(Class(goldbook:11255))
AnnotationAssertion(rdfs:label goldbook:11255 "allantoic stalk")
AnnotationAssertion(dcterms:description goldbook:11255 "Narrow connecting tube between the intra- and extra-embryonic parts of the allantois.")
Declaration(Class(goldbook:11256))
AnnotationAssertion(rdfs:label goldbook:11256 "stenosis")
