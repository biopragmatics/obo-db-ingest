AnnotationAssertion(mito:isMentionedBy goldbook:12996 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12996 "current"^^xsd:string)
Declaration(Class(goldbook:12997))
AnnotationAssertion(rdfs:label goldbook:12997 "challenge")
AnnotationAssertion(dcterms:description goldbook:12997 "Induction or evaluation of an immune response in an organism by administration of a specific antigen to which it has been sensitized.")
AnnotationAssertion(mito:isMentionedBy goldbook:12997 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12997 "current"^^xsd:string)
Declaration(Class(goldbook:12998))
AnnotationAssertion(rdfs:label goldbook:12998 "chaperone-mediated autophagy")
AnnotationAssertion(dcterms:description goldbook:12998 "Type of autophagy targeting only those proteins that are recognized by the binding of an hsc70-containing chaperone/co-chaperone complex.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12998 "CMA")
AnnotationAssertion(rdfs:seeAlso goldbook:12998 goldbook:12929)
AnnotationAssertion(mito:isMentionedBy goldbook:12998 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12998 "current"^^xsd:string)
Declaration(Class(goldbook:12999))
AnnotationAssertion(rdfs:label goldbook:12999 "chemotactic factor")
AnnotationAssertion(dcterms:description goldbook:12999 "Biologically active substance, such as a chemokine or anaphylatoxin, that induces a concentration gradient-dependent movement of cells.")
AnnotationAssertion(rdfs:seeAlso goldbook:12999 goldbook:12873)
AnnotationAssertion(rdfs:seeAlso goldbook:12999 goldbook:13000)
AnnotationAssertion(mito:isMentionedBy goldbook:12999 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12999 "current"^^xsd:string)
Declaration(Class(goldbook:13000))
AnnotationAssertion(rdfs:label goldbook:13000 "chemotaxis")
AnnotationAssertion(dcterms:description goldbook:13000 "1) General. Movement of an organism or cell along a concentration gradient of a chemical. 2) In immunology. Movement of cells up a concentration gradient of a chemical attractant (chemotactic factor), such as a chemokine or other cytokine.")
AnnotationAssertion(rdfs:seeAlso goldbook:13000 goldbook:12999)
AnnotationAssertion(rdfs:seeAlso goldbook:13000 goldbook:13065)
AnnotationAssertion(mito:isMentionedBy goldbook:13000 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13000 "current"^^xsd:string)
Declaration(Class(goldbook:13001))
AnnotationAssertion(rdfs:label goldbook:13001 "chemotype")
AnnotationAssertion(dcterms:description goldbook:13001 "Character of a plant or microorganism based on a metabolite distinct from that found in other members of the same species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13001 "chemovar")
AnnotationAssertion(mito:isMentionedBy goldbook:13001 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13001 "current"^^xsd:string)
Declaration(Class(goldbook:13002))
AnnotationAssertion(rdfs:label goldbook:13002 "chloracne")
AnnotationAssertion(dcterms:description goldbook:13002 "Acne-like eruption caused by exposure to certain chlorinated organic substances such as polychlorinated biphenyls or 2,3,7,8-tetrachlorodibenzo[1,4]dioxin [2,3,7,8-tetrachlorooxanthrene] and other polychlorinated dibenzodioxins and furans.")
AnnotationAssertion(rdfs:comment goldbook:13002 "The lesions are most frequently found on the cheeks, behind the ears, in the armpits and groin region."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13002 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13002 "current"^^xsd:string)
Declaration(Class(goldbook:13003))
AnnotationAssertion(rdfs:label goldbook:13003 "chromate uptake assay")
AnnotationAssertion(dcterms:description goldbook:13003 "Method used in immunotoxicology to quantify the toxic effect of a substance on leukocytes by measuring uptake of \\(\\ce{^{51}Cr{-}labeled}\\) chromate.")
AnnotationAssertion(rdfs:seeAlso goldbook:13003 goldbook:13325)
AnnotationAssertion(rdfs:seeAlso goldbook:13003 goldbook:13379)
AnnotationAssertion(mito:isMentionedBy goldbook:13003 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13003 "current"^^xsd:string)
Declaration(Class(goldbook:13004))
AnnotationAssertion(rdfs:label goldbook:13004 "chromium release assay")
AnnotationAssertion(dcterms:description goldbook:13004 "Immunotoxicity assay that can be used to assess either natural killer (NK) cell or cytotoxic T cell activity or macrophage activity. When incubated with \\(\\ce{^{51}Cr{-}labeled}\\) chicken red blood cells (cRBCs), NK and cytotoxic T cells lyse the cRBC and thus induce the release of \\(\\ce{^{51}Cr}\\) into the medium. In contrast, macrophages phagocytose cRBC, and are then lysed to assess the amount of \\(\\ce{^{51}Cr}\\) they have taken up.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13004 "<sup>51</sup>Cr release assay")
AnnotationAssertion(rdfs:comment goldbook:13004 "The assay is usually applied to measure parameters of innate immunity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13004 goldbook:13323)
AnnotationAssertion(rdfs:seeAlso goldbook:13004 goldbook:13003)
AnnotationAssertion(rdfs:seeAlso goldbook:13004 goldbook:13072)
AnnotationAssertion(rdfs:seeAlso goldbook:13004 goldbook:13424)
AnnotationAssertion(rdfs:seeAlso goldbook:13004 goldbook:13499)
AnnotationAssertion(mito:isMentionedBy goldbook:13004 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13004 "current"^^xsd:string)
Declaration(Class(goldbook:13005))
AnnotationAssertion(rdfs:label goldbook:13005 "chronic allergic inflammation")
AnnotationAssertion(dcterms:description goldbook:13005 "Disease of airways, skin, eyes and other organs, resulting from repeated or continuous exposure to an allergen and involving immunoglobulin E (IgE) formation, IgE-induced histamine-release from mast cells, liberation of mediators such as cytokines and prostaglandins, and local inflammation characterized by infiltrating leucocytes; it results in augmented susceptibility to the allergen.")
AnnotationAssertion(rdfs:seeAlso goldbook:13005 goldbook:12857)
AnnotationAssertion(rdfs:seeAlso goldbook:13005 goldbook:13065)
AnnotationAssertion(rdfs:seeAlso goldbook:13005 goldbook:13288)
AnnotationAssertion(rdfs:seeAlso goldbook:13005 goldbook:13379)
AnnotationAssertion(rdfs:seeAlso goldbook:13005 goldbook:13442)
AnnotationAssertion(mito:isMentionedBy goldbook:13005 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13005 "current"^^xsd:string)
Declaration(Class(goldbook:13006))
AnnotationAssertion(rdfs:label goldbook:13006 "chronic granulomatous disease")
AnnotationAssertion(dcterms:description goldbook:13006 "Immunodeficiency disease in which multiple granulomas form as a result of defective elimination of bacteria by phagocytes.")
AnnotationAssertion(rdfs:comment goldbook:13006 "It is caused by deficiency of the NADPH oxidase system of enzymes that generates superoxide involved in bacterial killing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13006 goldbook:13281)
AnnotationAssertion(rdfs:seeAlso goldbook:13006 goldbook:13646)
AnnotationAssertion(rdfs:seeAlso goldbook:13006 goldbook:13185)
AnnotationAssertion(rdfs:seeAlso goldbook:13006 goldbook:13560)
AnnotationAssertion(mito:isMentionedBy goldbook:13006 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13006 "current"^^xsd:string)
Declaration(Class(goldbook:13007))
AnnotationAssertion(rdfs:label goldbook:13007 "chronic lymphocytic leukemia")
AnnotationAssertion(dcterms:description goldbook:13007 "B cell tumor found in the blood.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13007 "CLL")
AnnotationAssertion(rdfs:comment goldbook:13007 "The great majority of these tumors express CD5 and unmutated variable (V) genes and are therefore thought to arise from B-1 cells."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13007 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13007 goldbook:12932)
AnnotationAssertion(rdfs:seeAlso goldbook:13007 goldbook:12975)
AnnotationAssertion(rdfs:seeAlso goldbook:13007 goldbook:13772)
AnnotationAssertion(mito:isMentionedBy goldbook:13007 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13007 "current"^^xsd:string)
Declaration(Class(goldbook:13008))
AnnotationAssertion(rdfs:label goldbook:13008 "chronic myelogenous leukemia")
AnnotationAssertion(dcterms:description goldbook:13008 "Cancer characterized by overgrowth of the bone marrow with malignant white blood cells, usually exhibiting a chromosomal abnormality (Philadelphia chromosome), which causes uncontrolled proliferation of cells that are released into peripheral blood.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13008 "CML")
AnnotationAssertion(rdfs:seeAlso goldbook:13008 goldbook:12959)
AnnotationAssertion(mito:isMentionedBy goldbook:13008 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13008 "current"^^xsd:string)
Declaration(Class(goldbook:13009))
AnnotationAssertion(rdfs:label goldbook:13009 "chronic rejection")
AnnotationAssertion(dcterms:description goldbook:13009 "Immunologically triggered reaction occurring in a transplanted organ or tissue, leading to progressive destruction and finally failure of the transplanted organ occurring two months to many years after transplantation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13009 "chronic graft rejection")
AnnotationAssertion(rdfs:comment goldbook:13009 "In contrast, hyperacute rejection caused by preformed antibodies starts within minutes after organ transplantation, and acute rejection occurs within 2 to 60 days."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13009 goldbook:13754)
AnnotationAssertion(mito:isMentionedBy goldbook:13009 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13009 "current"^^xsd:string)
Declaration(Class(goldbook:13010))
AnnotationAssertion(rdfs:label goldbook:13010 "class switching")
AnnotationAssertion(dcterms:description goldbook:13010 "Process by which a B cell changes the class but not specificity of a given antibody it produces, e.g., switching from an immunoglobulin M (IgM) to an immunoglobulin G (IgG) antibody.")
AnnotationAssertion(rdfs:seeAlso goldbook:13010 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13010 goldbook:13292)
AnnotationAssertion(rdfs:seeAlso goldbook:13010 goldbook:13293)
AnnotationAssertion(mito:isMentionedBy goldbook:13010 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13010 "current"^^xsd:string)
Declaration(Class(goldbook:13011))
AnnotationAssertion(rdfs:label goldbook:13011 "classical pathway")
AnnotationAssertion(dcterms:description goldbook:13011 "Activation pathway involving complement components C1, C2, and C4 which, following fixation of C1q, e.g., by antigen-antibody complexes, produces the classical pathway C3 convertase C4b2a.")
AnnotationAssertion(rdfs:seeAlso goldbook:13011 goldbook:12866)
AnnotationAssertion(mito:isMentionedBy goldbook:13011 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13011 "current"^^xsd:string)
Declaration(Class(goldbook:13012))
AnnotationAssertion(rdfs:label goldbook:13012 "clonal anergy")
AnnotationAssertion(dcterms:description goldbook:13012 "Form of self-tolerance developing as a consequence of negative selection during thymic selection processes. Clones of thymocytes whose antigen receptors [T-cell receptors (TCRs)] bind with high affinity to self-antigens in association with major histocompatibility complex (MHC) molecules are inactivated.")
AnnotationAssertion(rdfs:seeAlso goldbook:13012 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13012 goldbook:13434)
AnnotationAssertion(rdfs:seeAlso goldbook:13012 goldbook:12914)
AnnotationAssertion(rdfs:seeAlso goldbook:13012 goldbook:13669)
AnnotationAssertion(rdfs:seeAlso goldbook:13012 goldbook:13734)
AnnotationAssertion(rdfs:seeAlso goldbook:13012 goldbook:13598)
AnnotationAssertion(mito:isMentionedBy goldbook:13012 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13012 "current"^^xsd:string)
Declaration(Class(goldbook:13013))
AnnotationAssertion(rdfs:label goldbook:13013 "clonal deletion")
AnnotationAssertion(dcterms:description goldbook:13013 "Process by which contact with antigen (e.g., self-antigen) at an early stage of lymphocyte differentiation leads to cell death by apoptosis.")
AnnotationAssertion(rdfs:seeAlso goldbook:13013 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13013 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13013 "current"^^xsd:string)
Declaration(Class(goldbook:13014))
AnnotationAssertion(rdfs:label goldbook:13014 "clonal expansion")
AnnotationAssertion(dcterms:description goldbook:13014 "Proliferation of B lymphocytes and T lymphocytes activated by clonal selection in order to produce a clone of identical cells.")
AnnotationAssertion(rdfs:comment goldbook:13014 "Clonal expansion enables the body to have sufficient numbers of antigen-specific lymphocytes to mount an effective immune response."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13014 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13014 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13014 goldbook:13016)
AnnotationAssertion(rdfs:seeAlso goldbook:13014 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13014 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13014 "current"^^xsd:string)
Declaration(Class(goldbook:13015))
AnnotationAssertion(rdfs:label goldbook:13015 "clonal indifference")
AnnotationAssertion(dcterms:description goldbook:13015 "Failure of B or T cells expressing anti-self-receptors to interact with antigen (e.g., by low valency, low concentration, or sequestration of antigens; low receptor avidity; or lack of co-stimulatory molecules).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13015 "clonal ignorance")
AnnotationAssertion(rdfs:comment goldbook:13015 "This is the primary mechanism involved in the induction and maintenance of self-tolerance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13015 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13015 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13015 goldbook:13669)
AnnotationAssertion(mito:isMentionedBy goldbook:13015 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13015 "current"^^xsd:string)
Declaration(Class(goldbook:13016))
AnnotationAssertion(rdfs:label goldbook:13016 "clonal selection")
AnnotationAssertion(dcterms:description goldbook:13016 "Selection and activation by antigen of a lymphocyte, bearing a complementary receptor, which then proliferates to form an expanded clone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13016 "selection theory (in immunology)")
AnnotationAssertion(rdfs:seeAlso goldbook:13016 goldbook:13401)
AnnotationAssertion(rdfs:seeAlso goldbook:13016 goldbook:13399)
AnnotationAssertion(mito:isMentionedBy goldbook:13016 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13016 "current"^^xsd:string)
Declaration(Class(goldbook:13017))
AnnotationAssertion(rdfs:label goldbook:13017 "cluster determinant")
AnnotationAssertion(dcterms:description goldbook:13017 "Cluster of antigens representing a cell surface marker with which antibodies react. Not to be confused with cluster of differentiation (CD) antigen.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13017 "CD")
AnnotationAssertion(rdfs:seeAlso goldbook:13017 goldbook:13018)
AnnotationAssertion(mito:isMentionedBy goldbook:13017 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13017 "current"^^xsd:string)
Declaration(Class(goldbook:13018))
AnnotationAssertion(rdfs:label goldbook:13018 "cluster of differentiation antigen")
AnnotationAssertion(dcterms:description goldbook:13018 "Any of a family of molecular markers on cell surfaces that may be used operationally to define phenotype, origin, and activation state of the cell.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13018 "CD")
AnnotationAssertion(rdfs:comment goldbook:13018 "The CD antigens expressed by a T cell vary with its stage of development and thus with its role in the immune response."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13018 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:13018 goldbook:13401)
AnnotationAssertion(mito:isMentionedBy goldbook:13018 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13018 "current"^^xsd:string)
Declaration(Class(goldbook:13019))
AnnotationAssertion(rdfs:label goldbook:13019 "coagulation system")
AnnotationAssertion(dcterms:description goldbook:13019 "Proteolytic cascade of plasma enzymes that triggers blood clotting when blood vessels are damaged.")
AnnotationAssertion(mito:isMentionedBy goldbook:13019 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13019 "current"^^xsd:string)
Declaration(Class(goldbook:13020))
AnnotationAssertion(rdfs:label goldbook:13020 "cognate T cell")
AnnotationAssertion(dcterms:description goldbook:13020 "Helper T lymphocyte (Th) primed by the same antigen as the B cell to which it gives help.")
AnnotationAssertion(rdfs:seeAlso goldbook:13020 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:13020 goldbook:13199)
AnnotationAssertion(rdfs:seeAlso goldbook:13020 goldbook:13607)
AnnotationAssertion(mito:isMentionedBy goldbook:13020 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13020 "current"^^xsd:string)
Declaration(Class(goldbook:13021))
AnnotationAssertion(rdfs:label goldbook:13021 "cold autoantibody type")
AnnotationAssertion(dcterms:description goldbook:13021 "Autoantibody that reacts optimally at low temperatures (\\(\\pu{{0}{-}{5} ^{\\circ}C}\\)) with surface antigens of erythrocytes.")
AnnotationAssertion(rdfs:comment goldbook:13021 "It mediates autoimmune hemolytic anemia by either cold agglutinins (cold hemagglutinin disease) or cold hemolysins (paroxysmal cold hemoglobinuria)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13021 goldbook:12913)
AnnotationAssertion(rdfs:seeAlso goldbook:13021 goldbook:12920)
AnnotationAssertion(rdfs:seeAlso goldbook:13021 goldbook:13127)
AnnotationAssertion(mito:isMentionedBy goldbook:13021 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13021 "current"^^xsd:string)
Declaration(Class(goldbook:13022))
AnnotationAssertion(rdfs:label goldbook:13022 "collagen arthritis")
AnnotationAssertion(dcterms:description goldbook:13022 "Autoimmune model of rheumatoid arthritis (RA), arising from combined cellular immunity and humoral immunity against collagen type II, and characterized by rapid and severe erosions of cartilage and bone.")
AnnotationAssertion(rdfs:seeAlso goldbook:13022 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13022 goldbook:12995)
AnnotationAssertion(rdfs:seeAlso goldbook:13022 goldbook:13236)
AnnotationAssertion(rdfs:seeAlso goldbook:13022 goldbook:13651)
AnnotationAssertion(mito:isMentionedBy goldbook:13022 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13022 "current"^^xsd:string)
Declaration(Class(goldbook:13023))
AnnotationAssertion(rdfs:label goldbook:13023 "collectin")
AnnotationAssertion(dcterms:description goldbook:13023 "Any member of a structurally related family of calcium-dependent carbohydrate-binding proteins or lectins containing collagen-like sequences, e.g., mannose-binding lectin (MBL).")
AnnotationAssertion(rdfs:seeAlso goldbook:13023 goldbook:12983)
AnnotationAssertion(rdfs:seeAlso goldbook:13023 goldbook:13438)
AnnotationAssertion(mito:isMentionedBy goldbook:13023 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13023 "current"^^xsd:string)
Declaration(Class(goldbook:13024))
AnnotationAssertion(rdfs:label goldbook:13024 "colony-stimulating factor")
AnnotationAssertion(dcterms:description goldbook:13024 "Factor that permits the proliferation and differentiation of hematopoietic cells.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:13024 "CSF")
AnnotationAssertion(mito:isMentionedBy goldbook:13024 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13024 "current"^^xsd:string)
Declaration(Class(goldbook:13025))
AnnotationAssertion(rdfs:label goldbook:13025 "combinatorial diversity")
AnnotationAssertion(dcterms:description goldbook:13025 "Component of antibody and T-cell receptor (TCR) diversity that is generated by the recombination of variable (V), diversity (\\(D\\), for immunoglobulin heavy chains, and for TCR \\(\\upbeta\\) and \\(\\ce{\\updelta\\ chains}\\)), and joining (J) gene segments.")
AnnotationAssertion(rdfs:seeAlso goldbook:13025 goldbook:13714)
AnnotationAssertion(rdfs:seeAlso goldbook:13025 goldbook:13770)
AnnotationAssertion(rdfs:seeAlso goldbook:13025 goldbook:13098)
AnnotationAssertion(rdfs:seeAlso goldbook:13025 goldbook:13198)
AnnotationAssertion(rdfs:seeAlso goldbook:13025 goldbook:13354)
