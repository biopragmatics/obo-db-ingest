AnnotationAssertion(mito:isMentionedBy goldbook:PT06918 doi:10.1351/pac199769071475)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06918 "current"^^xsd:string)
Declaration(Class(goldbook:PT06921))
AnnotationAssertion(rdfs:label goldbook:PT06921 "perfusion stationary phase")
AnnotationAssertion(dcterms:description goldbook:PT06921 "Stationary phase in which the mobile phase primarily travels through the pores of the stationary phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:PT06921 "perfusion stationary phase material")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06921 goldbook:M03952)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06921 goldbook:S05949)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06921 doi:10.1351/pac199769071475)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06921 "current"^^xsd:string)
Declaration(Class(goldbook:PT06933))
AnnotationAssertion(rdfs:label goldbook:PT06933 "partition isotherm")
AnnotationAssertion(dcterms:description goldbook:PT06933 "Isotherm describing partition of the sample component between the bulk of a liquid stationary phase and a liquid, gaseous or supercritical mobile phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06933 goldbook:P04435)
AnnotationAssertion(rdfs:seeAlso goldbook:PT06933 goldbook:S05949)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06933 doi:10.1351/pac199668081591)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06933 "current"^^xsd:string)
Declaration(Class(goldbook:PT06975))
AnnotationAssertion(rdfs:label goldbook:PT06975 "partial least squares")
AnnotationAssertion(dcterms:description goldbook:PT06975 "Partial least squares projection to latent structures (PLS) is a robust multivariate generalized regression method using projections to summarize multitudes of potentially collinear variables.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:PT06975 "PLS")
AnnotationAssertion(mito:isMentionedBy goldbook:PT06975 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06975 "current"^^xsd:string)
Declaration(Class(goldbook:PT06976))
AnnotationAssertion(rdfs:label goldbook:PT06976 "pattern recognition")
AnnotationAssertion(dcterms:description goldbook:PT06976 "Pattern recognition is the identification of patterns in large data sets, using appropriate mathematical methodology. Examples are principal component analysis (PCA), SIMCA, partial least squares (PLS) and artificial neural networks (ANN).")
AnnotationAssertion(rdfs:seeAlso goldbook:PT06976 goldbook:AT06947)
AnnotationAssertion(mito:isMentionedBy goldbook:PT06976 doi:10.1351/pac199769051137)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT06976 "current"^^xsd:string)
Declaration(Class(goldbook:PT07088))
AnnotationAssertion(rdfs:label goldbook:PT07088 "Pariser–Parr–Pople method")
AnnotationAssertion(dcterms:description goldbook:PT07088 "A semi-empirical quantum mechanical method of calculation of the properties of conjugated molecules and ions from self-consistent-field theory and the $\\ce{\\uppi\\!\\mbox{-}electron}$ approximation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:PT07088 "PPP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:PT07088 "PPP method")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07088 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07088 "current"^^xsd:string)
Declaration(Class(goldbook:PT07089))
AnnotationAssertion(rdfs:label goldbook:PT07089 "Pauli exclusion principle")
AnnotationAssertion(dcterms:description goldbook:PT07089 "A rule, complementary to the aufbau principle, of building up the electronic configuration of atoms and molecules: a maximum of two electrons can occupy an orbital and then only providing that the spins of the electrons are paired, i.e. opposed. The principle demands that the wavefunction for a many-electron system must be asymmetric with respect to the permutation of the space-spin coordinates for every pair of electrons.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07089 goldbook:AT06989)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07089 goldbook:A00478)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07089 goldbook:AT06996)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07089 goldbook:C01248)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07089 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07089 "current"^^xsd:string)
Declaration(Class(goldbook:PT07090))
AnnotationAssertion(rdfs:label goldbook:PT07090 "perturbation theory")
AnnotationAssertion(dcterms:description goldbook:PT07090 "Along with variational method, the second major quantum-mechanical approximation method. The methods of perturbation theory are based on representation of the Hamiltonian of a system under study, \\(H\\), through the Hamiltonian, \\(H^{0}\\), of a system, whose Schroedinger equation is solvable, and its relatively small perturbation \\(H^{\\rm{'}}\\): \\(H=H^{0}+H^{\\rm{'}}\\). Numerous techniques are derived allowing one to relate the unknown eigenvalues and eigenfunctions of the perturbed system to the known eigenvalues and eigenfunctions of the unperturbed system. As distinct from the variational method, the methods of perturbation theory are applicable to all the electronic states of an atom or molecule. When \\(H^{\\rm{'}}\\) is time-dependent, the perturbed system does not have stationary states. In this case time-dependent perturbation theory, which is the method of approximate calculation of the expansion of wave-functions of the perturbed system over wave-functions of stationary states of the unperturbed system, must be employed. The applications of this method are associated mostly with studies of light emission and absorption by atoms and molecules.")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07090 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07090 "current"^^xsd:string)
Declaration(Class(goldbook:PT07091))
AnnotationAssertion(rdfs:label goldbook:PT07091 "pre-reactive complexes")
AnnotationAssertion(dcterms:description goldbook:PT07091 "Weakly bound complexes with a potential minimum that precedes the activation barrier along the reaction path. In contrast with the van der Waals complexes, which fall apart reversibly into their constituents, the pre-reactive complexes may undergo a vigorous reaction to form different products.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07091 goldbook:A00093)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07091 goldbook:R05174)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07091 doi:10.1351/pac199971101919)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07091 "current"^^xsd:string)
Declaration(Class(goldbook:PT07142))
AnnotationAssertion(rdfs:label goldbook:PT07142 "polymer complexation")
AnnotationAssertion(dcterms:description goldbook:PT07142 "Process that results in the formation of a polymer–polymer complex or a complex composed of a polymer and a low-molar-mass substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:PT07142 "polymer complex formation")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07142 goldbook:P04743)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07142 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07142 "current"^^xsd:string)
Declaration(Class(goldbook:PT07143))
AnnotationAssertion(rdfs:label goldbook:PT07143 "polymer cyclization")
AnnotationAssertion(dcterms:description goldbook:PT07143 "Chemical reaction that leads to the formation of ring structures in or from polymer chains.")
AnnotationAssertion(rdfs:comment goldbook:PT07143 "Examples of cyclization along polymer chains are: (a) cyclization of polyacrylonitrile, (b) acetalization of poly(vinyl alcohol) with an aldehyde, (c) cyclization of polymers of conjugated dienes, such as polyisoprene or polybutadiene, leading to macrocycles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07143 "Examples of cyclization of polymer molecules are: (a) cyclization of poly(dimethylsiloxane), (b) back-biting reaction during ionic polymerizations of heterocyclic monomers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07143 goldbook:C01494)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07143 goldbook:D01699)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07143 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07143 "current"^^xsd:string)
Declaration(Class(goldbook:PT07144))
AnnotationAssertion(rdfs:label goldbook:PT07144 "polymer degradation")
AnnotationAssertion(dcterms:description goldbook:PT07144 "Chemical changes in a polymeric material that usually result in undesirable changes in the in-use properties of the material.")
AnnotationAssertion(rdfs:comment goldbook:PT07144 "In most cases (e.g., in vinyl polymers, polyamides) degradation is accompanied by a decrease in molar mass. In some cases (e.g., in polymers with aromatic rings in the main chain), degradation means changes in chemical structure. It can also be accompanied by crosslinking."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07144 "Usually, degradation results in the loss of, or deterioration in, useful properties of the material. However, in the case of biodegradation (degradation by biological activity), polymers may change into environmentally acceptable substances with desirable properties."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07144 goldbook:B00656)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07144 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07144 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07144 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07144 "current"^^xsd:string)
Declaration(Class(goldbook:PT07145))
AnnotationAssertion(rdfs:label goldbook:PT07145 "polymer functionalization")
AnnotationAssertion(dcterms:description goldbook:PT07145 "Introduction of desired chemical groups into polymer molecules to create specific chemical, physical, biological, pharmacological, or other properties.")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07145 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07145 "current"^^xsd:string)
Declaration(Class(goldbook:PT07146))
AnnotationAssertion(rdfs:label goldbook:PT07146 "polymer reaction")
AnnotationAssertion(dcterms:description goldbook:PT07146 "Chemical reaction in which at least one of the reactants is a high-molar-mass substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07146 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07146 "current"^^xsd:string)
Declaration(Class(goldbook:PT07147))
AnnotationAssertion(rdfs:label goldbook:PT07147 "polymer-supported reaction")
AnnotationAssertion(dcterms:description goldbook:PT07147 "Chemical reaction in which at least one reactant or a catalyst is bound through chemical bonds or weaker interactions, such as hydrogen bonds or donor–acceptor interactions, to a polymer.")
AnnotationAssertion(rdfs:comment goldbook:PT07147 "The easy separation of low-molar-mass reactants or products from the polymer-supported species is a great advantage of polymer-supported reactions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07147 "Typical examples of polymer-supported reactions are: (a) reactions performed by use of polymer-supported catalysts, (b) solid-phase peptide synthesis, in which intermediate peptide molecules are chemically bonded to beads of a suitable polymer support."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07147 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07147 goldbook:PT07191)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07147 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07147 "current"^^xsd:string)
Declaration(Class(goldbook:PT07148))
AnnotationAssertion(rdfs:label goldbook:PT07148 "protection of a reactive group")
AnnotationAssertion(dcterms:description goldbook:PT07148 "Temporary chemical transformation of a reactive group into a group that does not react under conditions where the non-protected group reacts.")
AnnotationAssertion(rdfs:comment goldbook:PT07148 "For example, trimethylsilylation is a typical transformation used to protect reactive functional groups, such as hydroxy or amino groups, from their reaction with growing anionic species in anionic polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07148 goldbook:A00361)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07148 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07148 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07148 "current"^^xsd:string)
Declaration(Class(goldbook:PT07158))
AnnotationAssertion(rdfs:label goldbook:PT07158 "polymer catalyst")
AnnotationAssertion(dcterms:description goldbook:PT07158 "Polymer that exhibits catalytic activity.")
AnnotationAssertion(rdfs:comment goldbook:PT07158 "Certain synthetic polymer catalysts can behave like enzymes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07158 "Poly(4-vinylpyridine) in its basic form, and sulfonated polystyrene in its acid form, are examples of polymers that can act as catalysts in some base- and acid-catalyzed reactions, respectively."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07158 goldbook:E02159)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07158 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07158 "current"^^xsd:string)
Declaration(Class(goldbook:PT07159))
AnnotationAssertion(rdfs:label goldbook:PT07159 "polymer-metal complex")
AnnotationAssertion(dcterms:description goldbook:PT07159 "Complex comprising a metal and one or more polymeric ligands.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07159 goldbook:L03518)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07159 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07159 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07159 "current"^^xsd:string)
Declaration(Class(goldbook:PT07160))
AnnotationAssertion(rdfs:label goldbook:PT07160 "polymer phase-transfer catalyst")
AnnotationAssertion(dcterms:description goldbook:PT07160 "Polymer that acts as a phase-transfer catalyst and thereby causes a significant enhancement of the rate of a reaction between two reactants located in neighboring phases owing to its catalysis of the extraction of one of the reactants across the interface to the other phase where the reaction takes place.")
AnnotationAssertion(rdfs:comment goldbook:PT07160 "Polymer phase-transfer catalysts in the form of beads are often referred to as triphase catalysts because such catalysts form the third phase of the reaction system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07160 goldbook:C00874)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07160 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07160 goldbook:E02301)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07160 goldbook:I03082)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07160 goldbook:P04536)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07160 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07160 "current"^^xsd:string)
Declaration(Class(goldbook:PT07161))
AnnotationAssertion(rdfs:label goldbook:PT07161 "polymer-supported catalyst")
AnnotationAssertion(dcterms:description goldbook:PT07161 "Catalyst system comprising a polymer support in which catalytically active species are immobilized through chemical bonds or weaker interactions such as hydrogen bonds or donor–acceptor interactions.")
AnnotationAssertion(rdfs:comment goldbook:PT07161 "Polymer-supported catalysts are often based on network polymers in the form of beads. They are easy to separate from reaction media and can be used repeatedly."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07161 "Examples of polymer-supported catalysts are: (a) a polymer-metal complex that can coordinate reactants, (b) colloidal palladium dispersed in a swollen network polymer that can act as a hydrogenation catalyst."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07161 "Polymer-supported enzymes are a type of polymer-supported catalysts."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:A00110)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:E02159)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:N04113)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:PT07191)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07161 goldbook:PT07159)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07161 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07161 "current"^^xsd:string)
Declaration(Class(goldbook:PT07162))
AnnotationAssertion(rdfs:label goldbook:PT07162 "polymer reactant")
AnnotationAssertion(dcterms:description goldbook:PT07162 "Reactant (reagent) that is or is attached to a high-molar-mass linear polymer or a polymer network.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:PT07162 "polymer reagent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:PT07162 "polymer-supported reagent")
AnnotationAssertion(rdfs:comment goldbook:PT07162 "The attachment may be by chemical bonds, by weaker interactions such as hydrogen bonds, or simply by inclusion."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07162 goldbook:A00512)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07162 goldbook:L03556)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07162 goldbook:P04742)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07162 goldbook:R05190)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07162 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07162 "current"^^xsd:string)
Declaration(Class(goldbook:PT07163))
AnnotationAssertion(rdfs:label goldbook:PT07163 "prepolymer")
AnnotationAssertion(dcterms:description goldbook:PT07163 "Polymer or oligomer the molecules of which are capable of entering, through reactive groups, into further polymerization and thereby contributing more than one structural unit to at least one type of chain of the final polymer.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07163 goldbook:O04283)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07163 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07163 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07163 "current"^^xsd:string)
Declaration(Class(goldbook:PT07180))
AnnotationAssertion(rdfs:label goldbook:PT07180 "photo-elastic polymer")
AnnotationAssertion(dcterms:description goldbook:PT07180 "Polymer that, under stress, exhibits birefringence.")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07180 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07180 "current"^^xsd:string)
Declaration(Class(goldbook:PT07181))
AnnotationAssertion(rdfs:label goldbook:PT07181 "photoluminescent polymer")
AnnotationAssertion(dcterms:description goldbook:PT07181 "Polymer that exhibits luminescence (i.e., fluorescence or phosphorescence arising from photo-excitation).")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07181 goldbook:F02453)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07181 goldbook:L03641)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07181 goldbook:P04569)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07181 goldbook:P04623)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07181 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07181 "current"^^xsd:string)
Declaration(Class(goldbook:PT07182))
AnnotationAssertion(rdfs:label goldbook:PT07182 "photosensitive polymer")
AnnotationAssertion(dcterms:description goldbook:PT07182 "Polymer that responds to ultraviolet or visible light by exhibiting a change in its physical properties or its chemical constitution.")
AnnotationAssertion(rdfs:comment goldbook:PT07182 "Examples of the changes in photosensitive polymers are a change in molecular shape (photoresponsive polymer), a change in its constitution (photoreactive polymer), and a reversible change in color (photochromic polymer)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07182 "Photosensitivity in photosensitive polymers means that the polymers are sensitive to the irradiated light leading to some change in properties or structure. It is different from photosensitization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:C01282)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:MT06972)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:P04585)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:P04589)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:P04652)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:RT07164)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07182 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07182 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07182 "current"^^xsd:string)
Declaration(Class(goldbook:PT07183))
AnnotationAssertion(rdfs:label goldbook:PT07183 "piezoelectric polymer")
AnnotationAssertion(dcterms:description goldbook:PT07183 "Polymer that exhibits a change in dielectric properties on application of pressure.Polymer that shows a change in its dimensions when subjected to an electric field.")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07183 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07183 "current"^^xsd:string)
Declaration(Class(goldbook:PT07185))
AnnotationAssertion(rdfs:label goldbook:PT07185 "polymer compatibilizer")
AnnotationAssertion(dcterms:description goldbook:PT07185 "Polymeric additive that, when added to a blend of immiscible polymers, modifies their interfaces and stabilizes the blend.")
AnnotationAssertion(rdfs:comment goldbook:PT07185 "Typical polymer compatibilizers are block or graft copolymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07185 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07185 goldbook:A00134)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07185 goldbook:B00682)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07185 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07185 "current"^^xsd:string)
Declaration(Class(goldbook:PT07186))
AnnotationAssertion(rdfs:label goldbook:PT07186 "polymer drug")
AnnotationAssertion(dcterms:description goldbook:PT07186 "Polymer that contains either chemically-bound drug molecules or pharmacologically active moieties.")
AnnotationAssertion(rdfs:comment goldbook:PT07186 "A polymer drug is usually used to provide drug-delivery targeted to an organ and controlled release of an active drug at the target organ."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07186 goldbook:D01863)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07186 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07186 "current"^^xsd:string)
Declaration(Class(goldbook:PT07187))
AnnotationAssertion(rdfs:label goldbook:PT07187 "polymer gel")
AnnotationAssertion(dcterms:description goldbook:PT07187 "Gel in which the network component is a polymer.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07187 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07187 goldbook:NT07562)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07187 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07187 "current"^^xsd:string)
Declaration(Class(goldbook:PT07188))
AnnotationAssertion(rdfs:label goldbook:PT07188 "polymer membrane")
AnnotationAssertion(dcterms:description goldbook:PT07188 "Thin layer of polymeric material that acts as a barrier permitting mass transport of selected species.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07188 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07188 goldbook:M03667)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07188 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07188 "current"^^xsd:string)
Declaration(Class(goldbook:PT07189))
AnnotationAssertion(rdfs:label goldbook:PT07189 "polymer solvent")
AnnotationAssertion(dcterms:description goldbook:PT07189 "Polymer that acts like a solvent for compounds of low molar mass.")
AnnotationAssertion(rdfs:comment goldbook:PT07189 "An example of a polymer solvent is poly(oxyethylene); it can dissolve various inorganic salts by complexation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07189 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07189 "current"^^xsd:string)
Declaration(Class(goldbook:PT07190))
AnnotationAssertion(rdfs:label goldbook:PT07190 "polymer sorbent")
AnnotationAssertion(dcterms:description goldbook:PT07190 "Polymer that adsorbs or absorbs a certain substance or certain substances from a liquid or a gas.")
AnnotationAssertion(rdfs:comment goldbook:PT07190 "A polymer sorbent may be a polymer adsorbent or a polymer absorbent. The former acts by surface sorption and the latter by bulk sorption."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07190 goldbook:A00036)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07190 goldbook:A00153)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07190 goldbook:A00155)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07190 goldbook:S05769)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07190 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07190 "current"^^xsd:string)
Declaration(Class(goldbook:PT07191))
AnnotationAssertion(rdfs:label goldbook:PT07191 "polymer support")
AnnotationAssertion(dcterms:description goldbook:PT07191 "Polymer to or in which a reagent or catalyst is chemically bound, immobilized, dispersed, or associated.")
AnnotationAssertion(rdfs:comment goldbook:PT07191 "A polymer support is usually a network polymer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07191 "A polymer support is usually prepared in bead form by suspension polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07191 "The location of active sites introduced into a polymer support depends on the type of polymer support. In a swollen-gel-bead polymer support the active sites are distributed uniformly throughout the beads, whereas in a macroporous-bead polymer support they are predominantly on the internal surfaces of the macropores."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07191 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07191 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07191 goldbook:N04113)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07191 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07191 goldbook:R05190)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07191 goldbook:S06198)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07191 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07191 "current"^^xsd:string)
Declaration(Class(goldbook:PT07192))
AnnotationAssertion(rdfs:label goldbook:PT07192 "polymer surfactant")
AnnotationAssertion(dcterms:description goldbook:PT07192 "Polymer that lowers the surface tension of the medium in which it is dissolved, or the interfacial tension with another phase, or both.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07192 goldbook:I03088)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07192 goldbook:S06194)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07192 doi:10.1351/pac200476040889)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07192 "current"^^xsd:string)
Declaration(Class(goldbook:PT07217))
AnnotationAssertion(rdfs:label goldbook:PT07217 "polyacid")
AnnotationAssertion(dcterms:description goldbook:PT07217 "In polymer terminology, polyelectrolyte composed of macromolecules containing acid groups on a substantial fraction of the constitutional units.")
AnnotationAssertion(rdfs:comment goldbook:PT07217 "Most commonly, the acid groups are $\\ce{–COOH}$, $\\ce{–SO3H}$, or $\\ce{–PO3H2}$."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07217 goldbook:P04728)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07217 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07217 "current"^^xsd:string)
Declaration(Class(goldbook:PT07219))
AnnotationAssertion(rdfs:label goldbook:PT07219 "polybase")
AnnotationAssertion(dcterms:description goldbook:PT07219 "In polymer terminology, polyelectrolyte composed of macromolecules containing basic groups on a substantial fraction of the constitutional units.")
AnnotationAssertion(rdfs:comment goldbook:PT07219 "Most commonly, the basic groups are amino groups."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07219 goldbook:P04728)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07219 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07219 "current"^^xsd:string)
Declaration(Class(goldbook:PT07220))
AnnotationAssertion(rdfs:label goldbook:PT07220 "polybetaine")
AnnotationAssertion(dcterms:description goldbook:PT07220 "Ampholytic polymer in which pendant groups have a betaine-type structure.")
AnnotationAssertion(rdfs:comment goldbook:PT07220 "A polybetaine is a type of zwitterionic polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07220 goldbook:AT07196)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07220 goldbook:ZT07228)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07220 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07220 "current"^^xsd:string)
Declaration(Class(goldbook:PT07222))
AnnotationAssertion(rdfs:label goldbook:PT07222 "polyelectrolyte complex")
AnnotationAssertion(dcterms:description goldbook:PT07222 "Neutral polymer-polymer complex composed of macromolecules carrying charges of opposite sign causing the macromolecules to be bound together by electrostatic interactions.")
AnnotationAssertion(rdfs:comment goldbook:PT07222 "A polyelectrolyte complex is also called a polysalt. Use of this term is not recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07222 goldbook:P04728)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07222 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07222 "current"^^xsd:string)
Declaration(Class(goldbook:PT07223))
AnnotationAssertion(rdfs:label goldbook:PT07223 "polyelectrolyte network")
AnnotationAssertion(dcterms:description goldbook:PT07223 "Polymer network containing ionic or ionizable groups in a substantial fraction of its constitutional units.")
AnnotationAssertion(rdfs:comment goldbook:PT07223 "A polyelectrolyte network is sometimes called a crosslinked polyelectrolyte. Use of the latter term is not recommended unless the polyelectrolyte network is formed by the crosslinking of existing polyelectrolyte macromolecules rather than by non-linear polymerisation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07223 "In contrast to a polyelectrolyte, a polyelectrolyte network is always insoluble, although swelling or contraction can occur when it is immersed in a solvent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07223 "A polyelectrolyte network in contact with a solution of a salt is able to exchange counter-ions (cations or anions) with ionic species in the solution and act as an ion exchanger. Therefore, a polyelectrolyte network is frequently described as an ion-exchange polymer."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:P04742)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:C01371)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:I03171)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:IT07155)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:P04728)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07223 goldbook:S05447)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07223 doi:10.1351/pac200678112067)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07223 "current"^^xsd:string)
Declaration(Class(goldbook:PT07242))
AnnotationAssertion(rdfs:label goldbook:PT07242 "polymer composite")
AnnotationAssertion(dcterms:description goldbook:PT07242 "Composite in which at least one component is a polymer.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07242 goldbook:CT07545)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07242 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07242 "current"^^xsd:string)
Declaration(Class(goldbook:PT07247))
AnnotationAssertion(rdfs:label goldbook:PT07247 "prepreg")
AnnotationAssertion(dcterms:description goldbook:PT07247 "Sheets of a substrate that have been impregnated with a curable polymer, curable polymers, or liquid reactants, or a thermoplastic, and are ready for fabrication of laminates.")
AnnotationAssertion(rdfs:comment goldbook:PT07247 "During the impregnation, the curable polymer, curable polymers, or liquid reactants may be allowed to react to a certain extent (sometimes termed degree of ripening)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07247 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07247 "current"^^xsd:string)
Declaration(Class(goldbook:PT07264))
AnnotationAssertion(rdfs:label goldbook:PT07264 "polymer alloy")
AnnotationAssertion(dcterms:description goldbook:PT07264 "Polymeric material, exhibiting macroscopically uniform physical properties throughout its whole volume, that comprises a compatible polymer blend, a miscible polymer blend or a multiphase copolymer.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07264 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07264 goldbook:CT07581)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07264 goldbook:HT07582)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07264 goldbook:MT07287)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07264 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07264 "current"^^xsd:string)
Declaration(Class(goldbook:PT07286))
AnnotationAssertion(rdfs:label goldbook:PT07286 "phase domain")
AnnotationAssertion(dcterms:description goldbook:PT07286 "Region of a material that is uniform in chemical composition and physical state.")
AnnotationAssertion(rdfs:comment goldbook:PT07286 "A phase in a multiphase material can form domains differing in size."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07286 "The term 'domain' may be qualified by the adjective microscopic or nanoscopic or the prefix micro- or nano- according to the size of the linear dimensions of the domain."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07286 "The prefixes micro-, and nano- are frequently incorrectly used to qualify the term 'phase' instead of the term 'domain'; hence, 'microphase domain', and 'nanophase domain' are often used. The correct terminology that should be used is phase microdomain and phase nanodomain."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07286 goldbook:M03894)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07286 goldbook:N04082)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07286 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07286 "current"^^xsd:string)
Declaration(Class(goldbook:PT07291))
AnnotationAssertion(rdfs:label goldbook:PT07291 "phase interaction")
AnnotationAssertion(dcterms:description goldbook:PT07291 "Molecular interaction between the components present in the interphases of a multiphase mixture.")
AnnotationAssertion(rdfs:comment goldbook:PT07291 "The interphase elasticity is the capability of a deformed interphase to return to its original dimensions after the force causing the deformation has been removed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07291 goldbook:I03118)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07291 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07291 "current"^^xsd:string)
Declaration(Class(goldbook:PT07416))
AnnotationAssertion(rdfs:label goldbook:PT07416 "polaron")
AnnotationAssertion(dcterms:description goldbook:PT07416 "Lattice distortion or polarization caused by photoexcitation.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07416 goldbook:L03486)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07416 goldbook:P04613)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07416 goldbook:P04712)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07416 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07416 "current"^^xsd:string)
Declaration(Class(goldbook:PT07418))
AnnotationAssertion(rdfs:label goldbook:PT07418 "planar intramolecular charge transfer")
AnnotationAssertion(dcterms:description goldbook:PT07418 "In a PICT state formed by intramolecular charge transfer in an electron donor ($\\ce{D}$)/acceptor ($\\ce{A}$) molecule, the $\\ce{D}$ and $\\ce{A}$ subgroups have an overall planar configuration, with substantial electronic coupling of $\\ce{D}$ and $\\ce{A}$.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:PT07418 "PICT")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07418 goldbook:C01025)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07418 goldbook:E01988)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07418 goldbook:IT07401)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07418 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07418 "current"^^xsd:string)
Declaration(Class(goldbook:PT07440))
AnnotationAssertion(rdfs:label goldbook:PT07440 "parametric amplification")
AnnotationAssertion(dcterms:description goldbook:PT07440 "Amplification of a signal based on parametric processes.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07440 goldbook:PT07441)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07440 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07440 "current"^^xsd:string)
Declaration(Class(goldbook:PT07441))
AnnotationAssertion(rdfs:label goldbook:PT07441 "parametric processes")
AnnotationAssertion(dcterms:description goldbook:PT07441 "Interaction of photons in a non-linear medium satisfying the energy and momentum conservation laws. During the interaction the photon frequencies are mixed and photon(s) with different frequencies are created.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:PT07441 "optical parametric processes")
AnnotationAssertion(rdfs:comment goldbook:PT07441 "Optical parametric processes of three interacting beams, called frequency mixing processes, are: second-harmonic generation (SHG), sum-frequency generation (SFG), difference-frequency generation (DFG), optical parametric generation and amplification (OPG and OPA), and optical parametric oscillation (OPO)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07441 goldbook:M04007)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07441 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07441 "current"^^xsd:string)
Declaration(Class(goldbook:PT07442))
AnnotationAssertion(rdfs:label goldbook:PT07442 "Peierls distortion")
AnnotationAssertion(dcterms:description goldbook:PT07442 "Distortion of a regular one-dimensional structure with a partially occupied band to give bond alternation, eventually leading to dimerization or oligomerization. The degree of oligomerization, \\(\\lambda \\) depends on the electronic population of the conduction band indicated by the wave vector of the Fermi level \\(k_{\\mathrm{F}}\\) \\[\\lambda = 2\\ \\pi /k_{\\mathrm{F}}\\]")
AnnotationAssertion(rdfs:comment goldbook:PT07442 "A Peierls distortion opens a gap at the Fermi level, producing a net stabilization of the distorted structure. The Peierls distortion for chain compounds is analogous to the Jahn–Teller effect for molecules. The prototypical example of the Peierls distortion in organic chemistry is the bond alternation present in polyvinylene. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07442 goldbook:F02341)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07442 goldbook:J03361)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07442 goldbook:C01244)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07442 goldbook:D01744)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07442 goldbook:O04285)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07442 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07442 "current"^^xsd:string)
Declaration(Class(goldbook:PT07443))
AnnotationAssertion(rdfs:label goldbook:PT07443 "phosphorescence lifetime")
AnnotationAssertion(dcterms:description goldbook:PT07443 "Parameter describing the time evolution of the decay of the phosphorescence radiant intensity.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07443 goldbook:P04569)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07443 goldbook:R05045)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07443 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07443 "current"^^xsd:string)
Declaration(Class(goldbook:PT07444))
AnnotationAssertion(rdfs:label goldbook:PT07444 "photo-Bergman cyclization")
AnnotationAssertion(dcterms:description goldbook:PT07444 "Intramolecular photoinduced cyclization of enediynes leading to aromatic compounds.")
AnnotationAssertion(rdfs:comment goldbook:PT07444 "The solvent plays a key role in the reaction efficiency and product distribution. The reversibility of the initial photoreaction and competing radical vs ionic pathways dictate product distribution, in stark contrast to the thermal process."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07444 "This reaction is particularly attractive in molecular biology and molecular medicine. In particular, it permits the expeditious synthesis of core synthones of great diversity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07444 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07444 goldbook:C01494)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07444 goldbook:P04585)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07444 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07444 "current"^^xsd:string)
Declaration(Class(goldbook:PT07445))
AnnotationAssertion(rdfs:label goldbook:PT07445 "photobiology")
AnnotationAssertion(dcterms:description goldbook:PT07445 "Branch of biology concerned with the biological and bioenvironmental effects of ultraviolet, visible or infrared radiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07445 goldbook:IT07399)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07445 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07445 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07445 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07445 "current"^^xsd:string)
Declaration(Class(goldbook:PT07446))
AnnotationAssertion(rdfs:label goldbook:PT07446 "photocatalyst")
AnnotationAssertion(dcterms:description goldbook:PT07446 "Catalyst able to produce, upon absorption of light, chemical transformations of the reaction partners. The excited state of the photocatalyst repeatedly interacts with the reaction partners forming reaction intermediates and regenerates itself after each cycle of such interactions.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07446 goldbook:C00876)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07446 goldbook:E02257)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07446 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07446 "current"^^xsd:string)
Declaration(Class(goldbook:PT07447))
AnnotationAssertion(rdfs:label goldbook:PT07447 "photochemical funnel")
AnnotationAssertion(dcterms:description goldbook:PT07447 "Molecular structure where the excited-state reactant or intermediate is delivered to the ground state to initiate product formation.")
AnnotationAssertion(rdfs:comment goldbook:PT07447 "For a broad class of organic reactions, the structure of the funnel can take the form of a conical intersection or a singlet–triplet crossing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07447 goldbook:CT07347)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07447 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07447 goldbook:ST07477)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07447 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07447 "current"^^xsd:string)
Declaration(Class(goldbook:PT07448))
AnnotationAssertion(rdfs:label goldbook:PT07448 "photochemical reaction path")
AnnotationAssertion(dcterms:description goldbook:PT07448 "Sequence of geometries adopted by a molecule after initial electronic excitation, combined with a specification of the electronic state at each geometry, from radiation absorption to product formation. Theoretically, this usually involves the computation of the MERP connecting the Franck–Condon point, located on the potential-energy surface of the spectroscopic state, to the final photoproducts located on the ground-state potential-energy surface. Experimentally, a photochemical reaction path can be probed by detecting transient species or reaction intermediates.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:PT07448 "MERP")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07448 goldbook:ST06775)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07448 goldbook:ET07026)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07448 goldbook:P04585)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07448 goldbook:P04780)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07448 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07448 "current"^^xsd:string)
Declaration(Class(goldbook:PT07449))
AnnotationAssertion(rdfs:label goldbook:PT07449 "photo-Claisen rearrangement")
AnnotationAssertion(dcterms:description goldbook:PT07449 "Rearrangement closely related to the photo-Fries rearrangement; it is experienced by aryl ethers (instead of aryl esters) and follows an analogous mechanism.")
AnnotationAssertion(rdfs:comment goldbook:PT07449 "An example is the photoinduced rearrangement of phenyl ethers to ortho and para-alkyl phenols. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07449 goldbook:R05194)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07449 goldbook:E02219)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07449 goldbook:E02221)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07449 goldbook:P04539)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07449 goldbook:P04614)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07449 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07449 "current"^^xsd:string)
Declaration(Class(goldbook:PT07450))
AnnotationAssertion(rdfs:label goldbook:PT07450 "photocyclization")
AnnotationAssertion(dcterms:description goldbook:PT07450 "Intramolecular photochemical process leading to carbo- or hetero- cyclic ring systems by formation of one new single bond, either by a concerted process (e.g., electrocyclization) or by multi-step processes such as Norrish–Yang reaction, photoinduced electron transfer processes, Yang photocyclization and others.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07450 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07450 goldbook:NT07427)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07450 goldbook:YT07500)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07450 goldbook:C01234)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07450 goldbook:P04617)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07450 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07450 "current"^^xsd:string)
Declaration(Class(goldbook:PT07451))
AnnotationAssertion(rdfs:label goldbook:PT07451 "photocycloaddition")
AnnotationAssertion(dcterms:description goldbook:PT07451 "Intermolecular photochemical process leading to carbo- or hetero- cyclic ring systems by formation of two new single bonds, either by a concerted process (e.g., a concerted addition) or by multi-step processes (e.g., the Paternò–Büchi reaction).")
AnnotationAssertion(rdfs:comment goldbook:PT07451 "Triplet state photocycloadditions are two-step processes involving the formation of diradical intermediates."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07451 goldbook:I03098)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07451 goldbook:T06503)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07451 goldbook:C01234)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07451 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07451 "current"^^xsd:string)
Declaration(Class(goldbook:PT07452))
AnnotationAssertion(rdfs:label goldbook:PT07452 "photochemical nitrogen extrusion")
AnnotationAssertion(dcterms:description goldbook:PT07452 "Photoinduced dinitrogen ($\\ce{N2}$) elimination.")
AnnotationAssertion(rdfs:comment goldbook:PT07452 "Typical examples are the photoinduced denitrogenation of azoalkanes. The following scheme also show the diazenyl radical intermediate. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07452 goldbook:E02038)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07452 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07452 "current"^^xsd:string)
Declaration(Class(goldbook:PT07453))
AnnotationAssertion(rdfs:label goldbook:PT07453 "photodecarbonylation")
AnnotationAssertion(dcterms:description goldbook:PT07453 "Photoinduced extrusion of carbon monoxide ($\\ce{CO}$).")
AnnotationAssertion(rdfs:comment goldbook:PT07453 "Typical example is the Norrish Type I photoreaction, in which, after production of the diradical upon photoinduced α-cleavage, $\\ce{CO}$ is eliminated. This reaction has been widely exploited for the production of radicals in crystals, as well as for the synthesis of cyclic compounds. "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07453 "Another example is the photodecarbonylation of alpha-aryl aldehydes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07453 goldbook:N04219)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07453 goldbook:A00208)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07453 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07453 "current"^^xsd:string)
Declaration(Class(goldbook:PT07454))
AnnotationAssertion(rdfs:label goldbook:PT07454 "photodecarboxylation")
AnnotationAssertion(dcterms:description goldbook:PT07454 "Photoinduced extrusion of carbon dioxide ($\\ce{CO2}$).")
AnnotationAssertion(rdfs:comment goldbook:PT07454 "Typical examples are the $\\ce{CO2}$ extrusion upon excitation of anti-inflammatory 2-arylpropionic acids, such as ketoprofen. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07454 goldbook:A00381)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07454 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07454 "current"^^xsd:string)
Declaration(Class(goldbook:PT07455))
AnnotationAssertion(rdfs:label goldbook:PT07455 "photodeconjugation")
AnnotationAssertion(dcterms:description goldbook:PT07455 "Photoinduced reaction of conjugated compounds (e.g., enones and carboxylic acid derivatives) leading to loss of conjugation.")
AnnotationAssertion(rdfs:comment goldbook:PT07455 "This reaction has important synthetic applications for the synthesis of frameworks of numerous natural products, such as β,γ-unsaturated carboxylic acids from photoexcitation of α,β-unsaturated carboxylic acid derivatives, excluding the use of strong bases, as required for similar isomerizations performed in the ground state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07455 goldbook:C00852)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07455 goldbook:C01267)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07455 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07455 goldbook:P04613)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07455 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07455 "current"^^xsd:string)
Declaration(Class(goldbook:PT07456))
AnnotationAssertion(rdfs:label goldbook:PT07456 "photohydration")
AnnotationAssertion(dcterms:description goldbook:PT07456 "Photochemical process leading to the addition of water across a $\\ce{C–C}$ double (or triple) bond or to a carbonyl (or carbonyl analogue) group.")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07456 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07456 "current"^^xsd:string)
Declaration(Class(goldbook:PT07458))
AnnotationAssertion(rdfs:label goldbook:PT07458 "photon echo")
AnnotationAssertion(dcterms:description goldbook:PT07458 "Time-resolved optical spectroscopy in which the inhomogeneous broadening of absorbers is eliminated by the proper choice of geometry in a four-wave mixing experiment.")
AnnotationAssertion(rdfs:comment goldbook:PT07458 "Term applied to a group of non-linear optical techniques such as integrated echo, time-gated echo, three-pulse echo peak shift, heterodyne-detected echo and 2D-echo."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07458 "Photon echo techniques make use of the third-order optical polarization and 'hyper-susceptibility'. The main distinguishing feature of photon echo methods from all other third-order processes is the time ordering of the field interactions that leads to a rephasing process in the induced polarization to remove inhomogeneous contributions to the absorption linewidth."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07458 "In terms of mathematical description, the photon echo is equal to the spin echo (solid-state physics) from which a term 'echo' was borrowed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:PT07458 "Technique used, e.g., to probe solvation dynamics upon (ultra-short) pulse excitation of a chromophore."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07458 goldbook:C01076)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07458 goldbook:NT07426)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07458 goldbook:O04314)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07458 goldbook:P04712)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07458 goldbook:S05747)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07458 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07458 "current"^^xsd:string)
Declaration(Class(goldbook:PT07459))
AnnotationAssertion(rdfs:label goldbook:PT07459 "photon number")
AnnotationAssertion(dcterms:description goldbook:PT07459 "Total number of photons calculated as \\(N_{\\rm{p}} = n_{\\rm{p}}\\, N_{\\rm{A}}\\) with \\(N_{\\rm{p}}\\) the amount of photons in einsteins and \\(N_{\\rm{A}}\\) the Avogadro constant.")
AnnotationAssertion(rdfs:comment goldbook:PT07459 "Mathematical definition: \\(N_{\\rm{p}} = Q/h\\nu\\) for monochromatic radiation of frequency \\(\\nu\\), with \\(Q\\) the radiant energy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07459 goldbook:A00543)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07459 goldbook:R05039)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07459 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07459 "current"^^xsd:string)
Declaration(Class(goldbook:PT07460))
AnnotationAssertion(rdfs:label goldbook:PT07460 "photorearrangement")
AnnotationAssertion(dcterms:description goldbook:PT07460 "Photoisomerization involving changes in the arrangement of the atoms within the molecular species. It may lead to unstable isomers that react further by, e.g., dehydrogenation, deprotonation, or other reactions.")
AnnotationAssertion(rdfs:comment goldbook:PT07460 "Examples are photorearrangements of alkenes (other than cis-trans photoisomerization), of cyclohex-2-enones, of endoperoxides, of thioarenes, the di-π-methane rearrangement and others."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07460 goldbook:A00224)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07460 goldbook:D01745)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07460 goldbook:P04622)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07460 goldbook:C01092)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07460 goldbook:U06569)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07460 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07460 "current"^^xsd:string)
Declaration(Class(goldbook:PT07461))
AnnotationAssertion(rdfs:label goldbook:PT07461 "photoselection")
AnnotationAssertion(dcterms:description goldbook:PT07461 "Selection of an aligned subset of sample molecules by an exciting light beam. The selected subset will have an orientation distribution that is determined by the electric vector of the beam. If the beam is linearly polarized a uniaxial sample with a known orientation distribution will be produced. Also, the set of remaining molecules will be aligned with a known orientation distribution (residual anisotropy).")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07461 goldbook:AT06776)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07461 goldbook:UT07493)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07461 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07461 "current"^^xsd:string)
Declaration(Class(goldbook:PT07463))
AnnotationAssertion(rdfs:label goldbook:PT07463 "PLED")
AnnotationAssertion(dcterms:description goldbook:PT07463 "Acronym for polymer light-emitting diode.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:PT07463 "PLED")
AnnotationAssertion(mito:isMentionedBy goldbook:PT07463 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07463 "current"^^xsd:string)
Declaration(Class(goldbook:PT07465))
AnnotationAssertion(rdfs:label goldbook:PT07465 "pump-dump-probe technique")
AnnotationAssertion(dcterms:description goldbook:PT07465 "Transient absorption spectroscopy using three pulses (a strong pump, a dump pulse that can alter the course of the reaction photoinduced by the first pulse, and a weak probe). In general, femtosecond laser pulses are used.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07465 goldbook:L03459)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07465 goldbook:S05848)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07465 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07465 "current"^^xsd:string)
Declaration(Class(goldbook:PT07506))
AnnotationAssertion(rdfs:label goldbook:PT07506 "pre-gel regime")
AnnotationAssertion(dcterms:description goldbook:PT07506 "Stage of a network-forming polymerization or crosslinking process extending up to, but not beyond, the gel point.")
AnnotationAssertion(rdfs:comment goldbook:PT07506 "The pre-gel regime may be expressed as the length of time or the chemical conversion required to reach the gel point from the start of a polymerization or crosslinking process."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07506 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07506 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07506 goldbook:GT07535)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07506 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07506 goldbook:P04740)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07506 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07506 "current"^^xsd:string)
Declaration(Class(goldbook:PT07507))
AnnotationAssertion(rdfs:label goldbook:PT07507 "pre-gel state")
AnnotationAssertion(dcterms:description goldbook:PT07507 "State of a network-forming polymerization or crosslinking process in the pre-gel regime.")
AnnotationAssertion(rdfs:comment goldbook:PT07507 "In the pre-gel state, the sol fraction is equal to unity. All the molecules formed have finite (statistically definable) relative molecular masses."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07507 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07507 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07507 goldbook:NT07562)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07507 goldbook:P04740)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07507 goldbook:PT07506)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07507 goldbook:ST07513)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07507 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07507 "current"^^xsd:string)
Declaration(Class(goldbook:PT07510))
AnnotationAssertion(rdfs:label goldbook:PT07510 "particulate sol")
AnnotationAssertion(dcterms:description goldbook:PT07510 "Sol in which the dispersed phase consists of solid particles.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07510 goldbook:S05727)
AnnotationAssertion(mito:isMentionedBy goldbook:PT07510 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:PT07510 "current"^^xsd:string)
Declaration(Class(goldbook:PT07511))
AnnotationAssertion(rdfs:label goldbook:PT07511 "polymeric sol")
AnnotationAssertion(dcterms:description goldbook:PT07511 "Sol in which the dispersed phase consists of particles having a polymeric structure.")
AnnotationAssertion(rdfs:seeAlso goldbook:PT07511 goldbook:S05727)
AnnotationAssertion(rdfs:seeAlso goldbook:PT07511 goldbook:M03667)
