    <!-- http://dx.doi.org/10.1351/goldbook.10641 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10641">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Expulsion of semen from the genital ducts and urethra, usually resulting from a reflex process during sexual stimulation</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ejaculation</rdfs:label>
