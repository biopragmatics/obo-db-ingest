    <!-- http://dx.doi.org/10.1351/goldbook.15463 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15463">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance capable of specifically counteracting or reducing the effect of a potentially toxic substance in an organism by a relatively specific chemical or pharmacological action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>antidote</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15464 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15464">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that blocks or counteracts the action of histamine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>antihistamine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15465 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15465">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n., Substance inhibiting or preventing the actions of muscarine and muscarine-like agents (e.g., atropine) on the muscarinic acetylcholine receptors. adj., Inhibiting or preventing the actions of muscarine and muscarine-like agents on the muscarinic acetylcholine receptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>antimuscarinic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15466 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15466">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n., Substance inhibiting or preventing the actions of nicotine and nicotine-like agents (e.g., suxamethonium chloride) on the nicotinic acetylcholine receptors. adj., Inhibiting or preventing the actions of nicotine and nicotine-like agents on the nicotinic acetylcholine receptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>antinicotinic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15467 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15467">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that relieves or reduces fever.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>antipyretic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15468 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15468">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Common name for a harmful plant parasite in the family Aphididae, some species of which are vectors of plant virus diseases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
