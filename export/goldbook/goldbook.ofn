AnnotationAssertion(rdfs:label goldbook:11788 "glioblastoma")
AnnotationAssertion(dcterms:description goldbook:11788 "Glioma consisting chiefly of undifferentiated anaplastic cells of astrocytic origin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11788 "glioblastoma multiforme")
AnnotationAssertion(rdfs:comment goldbook:11788 "These neoplasms grow rapidly, invade extensively, and occur most frequently in the cerebrum of adults."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11788 goldbook:11789)
AnnotationAssertion(rdfs:seeAlso goldbook:11788 goldbook:11616)
AnnotationAssertion(rdfs:seeAlso goldbook:11788 goldbook:11671)
