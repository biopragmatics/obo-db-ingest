[Term]
id: goldbook:15215
name: multilayer tablet
def: "Consists of several different layers that are compressed on top of each other\, to form a single tablet composed of two or more layers."
comment: "Mainly used for incompatible substances and for sustained release."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-04-10-14
property_value: hasStatus "current" xsd:string
