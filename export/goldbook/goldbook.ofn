Declaration(Class(goldbook:HT07556))
AnnotationAssertion(rdfs:label goldbook:HT07556 "hybrid polymer")
AnnotationAssertion(dcterms:description goldbook:HT07556 "Polymer or polymer network comprised of inorganic and organic components.")
AnnotationAssertion(rdfs:comment goldbook:HT07556 "Examples include inorganic–organic polymers and organic–inorganic polymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07556 goldbook:P04742)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07556 doi:10.1351/pac200779101801)
