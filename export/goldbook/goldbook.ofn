AnnotationAssertion(rdfs:label goldbook:16101 "stability half life")
AnnotationAssertion(dcterms:description goldbook:16101 "Time required for the amount of a substance in a formulation to decrease, for any reason, by one-half (\\(\\pu{50\\%}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16101 "stability half time")
AnnotationAssertion(mito:isMentionedBy goldbook:16101 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16101 "current"^^xsd:string)
Declaration(Class(goldbook:16102))
AnnotationAssertion(rdfs:label goldbook:16102 "standard morbidity ratio")
AnnotationAssertion(dcterms:description goldbook:16102 "Ratio of the number of patients with a particular disease observed in a study group or population to the total number of people in the group or population multiplied by \\(\\pu{100}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16102 "SMR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16102 "standardized morbidity ratio")
AnnotationAssertion(rdfs:comment goldbook:16102 "This ratio is usually expressed as a percentage."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:16102 goldbook:15644)
AnnotationAssertion(mito:isMentionedBy goldbook:16102 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16102 "current"^^xsd:string)
Declaration(Class(goldbook:16103))
AnnotationAssertion(rdfs:label goldbook:16103 "standard mortality ratio")
AnnotationAssertion(dcterms:description goldbook:16103 "Ratio of the number of deaths observed in the study group or population to the number of deaths that would be expected if the study population had the same specific rates as the standard population, multiplied by \\(\\pu{100}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16103 "SMR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16103 "standardized mortality ratio")
AnnotationAssertion(rdfs:comment goldbook:16103 "This ratio is usually expressed as a percentage."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16103 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16103 "current"^^xsd:string)
