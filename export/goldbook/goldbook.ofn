AnnotationAssertion(rdfs:label goldbook:12123 "TDP-43 transcription factor")
AnnotationAssertion(dcterms:description goldbook:12123 "Cleavage product (\\(\\pu{43 kDa}\\)) of the transactive response (TAR) DNA binding protein (TARDBP) that targets TAR DNA and transcriptionally represses HIV-1.")
AnnotationAssertion(rdfs:comment goldbook:12123 "Pathological accumulation of the misfolded protein cleavage product has been associated with frontotemporal dementia and amyotrophic lateral sclerosis."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12123 goldbook:11583)
AnnotationAssertion(rdfs:seeAlso goldbook:12123 goldbook:11774)
