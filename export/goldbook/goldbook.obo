[Term]
id: goldbook:08431
name: <em>t</em><sub>1</sub> noise
def: "Streaks of spurious artefact signals in a two-dimensional nuclear magnetic resonance spectrum parallel to the \\\(\\rm\{f\}1\\\) axis at the \\\(\\rm\{f\}2\\\) of a strong resonance."
synonym: "$t_1$ noise in 2-D NMR" []
