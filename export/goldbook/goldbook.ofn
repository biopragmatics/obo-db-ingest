Declaration(Class(goldbook:08003))
AnnotationAssertion(rdfs:label goldbook:08003 "analytical chemistry")
AnnotationAssertion(dcterms:description goldbook:08003 "Scientific discipline that develops and applies strategies, instruments, and procedures to obtain information on the composition and nature of matter in space and time.")
AnnotationAssertion(rdfs:comment goldbook:08003 "The definition was coined by the Working Party on Analytical Chemistry (WPAC) of the Federation of European Chemical Societies (FECS) and is known as the \"Edinburgh Definition\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08003 "The term \"analytical science\" was coined in 1998 to emphasize the impact of informatics on analytical chemistry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08003 goldbook:08004)
AnnotationAssertion(mito:isMentionedBy goldbook:08003 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08003 "current"^^xsd:string)
Declaration(Class(goldbook:08004))
AnnotationAssertion(rdfs:label goldbook:08004 "chemical analysis")
AnnotationAssertion(dcterms:description goldbook:08004 "Application of analytical chemistry.")
AnnotationAssertion(rdfs:seeAlso goldbook:08004 goldbook:08003)
AnnotationAssertion(mito:isMentionedBy goldbook:08004 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08004 "current"^^xsd:string)
Declaration(Class(goldbook:08005))
AnnotationAssertion(rdfs:label goldbook:08005 "additive matrix effect")
AnnotationAssertion(dcterms:description goldbook:08005 "Matrix effect that is independent of the measured quantity value of the measurand.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08005 "background interference")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08005 "translational matrix effect")
AnnotationAssertion(rdfs:comment goldbook:08005 "An additive matrix effect affects the intercept, not the slope, of a linear calibration curve."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08005 "The effect is sometimes termed \"translational matrix effect\" or \"background interference\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08005 goldbook:08008)
AnnotationAssertion(mito:isMentionedBy goldbook:08005 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08005 "current"^^xsd:string)
Declaration(Class(goldbook:08006))
AnnotationAssertion(rdfs:label goldbook:08006 "analytical run")
AnnotationAssertion(dcterms:description goldbook:08006 "Set of measurements of the same quantity performed under repeatability conditions of measurement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08006 "run")
AnnotationAssertion(rdfs:comment goldbook:08006 "An analytical run may comprise measurements on one or more reference materials, blank materials, quality control materials, and analytical samples."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08006 goldbook:08010)
AnnotationAssertion(rdfs:seeAlso goldbook:08006 goldbook:08107)
AnnotationAssertion(rdfs:seeAlso goldbook:08006 goldbook:08040)
AnnotationAssertion(mito:isMentionedBy goldbook:08006 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08006 "current"^^xsd:string)
Declaration(Class(goldbook:08007))
AnnotationAssertion(rdfs:label goldbook:08007 "background indication")
AnnotationAssertion(dcterms:description goldbook:08007 "Indication obtained from a phenomenon, body, or substance similar to the one under investigation but for which a quantity of interest is supposed not to be present or is not contributing to the indication.")
AnnotationAssertion(rdfs:comment goldbook:08007 "In VIM 4.2, this concept is termed \"blank indication\" with \"background indication\" as an alternate term. However, since blank indication refers to the explicit use of a blank material in analytical chemistry, it should be distinguished from the concept \"background indication\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08007 goldbook:08003)
AnnotationAssertion(rdfs:seeAlso goldbook:08007 goldbook:08009)
AnnotationAssertion(rdfs:seeAlso goldbook:08007 goldbook:08010)
AnnotationAssertion(mito:isMentionedBy goldbook:08007 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08007 "current"^^xsd:string)
Declaration(Class(goldbook:08008))
AnnotationAssertion(rdfs:label goldbook:08008 "blank correction")
AnnotationAssertion(dcterms:description goldbook:08008 "Step in a measurement procedure in which the effect of a blank indication is removed from an indication.")
AnnotationAssertion(rdfs:comment goldbook:08008 "The blank indication and the indication must be of the same kind of quantity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08008 "A blank indication may be subtracted from an indication, or, in the case of a transmittance measurement, the indication is divided by the blank indication."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08008 goldbook:08009)
AnnotationAssertion(rdfs:seeAlso goldbook:08008 goldbook:08028)
AnnotationAssertion(mito:isMentionedBy goldbook:08008 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08008 "current"^^xsd:string)
Declaration(Class(goldbook:08009))
AnnotationAssertion(rdfs:label goldbook:08009 "blank indication")
AnnotationAssertion(dcterms:description goldbook:08009 "Indication obtained from a sample of blank material under the measurement conditions for the measurand.")
AnnotationAssertion(rdfs:comment goldbook:08009 "In VIM 4.2, \"background indication\" is given as an alternate term for \"blank indication\". However, in analytical chemistry these terms refer to different concepts."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08009 goldbook:08010)
AnnotationAssertion(mito:isMentionedBy goldbook:08009 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08009 "current"^^xsd:string)
Declaration(Class(goldbook:08010))
AnnotationAssertion(rdfs:label goldbook:08010 "blank material")
AnnotationAssertion(dcterms:description goldbook:08010 "Material which contains no, or as little as possible, of the analyte of interest used in measurement to establish a blank indication.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08010 "blank")
AnnotationAssertion(rdfs:comment goldbook:08010 "Testing, processing, and measurement of blank materials are nearly always an essential part of chemical analysis and may be part of quality assurance and quality control."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08010 "The concept may be extended to more than one analyte."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08010 "Terms such as \"solvent blank\", \"reagent blank\", or \"matrix blank\" are often used to specify the type of blank material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08010 "The term \"procedure (or procedural) blank\" is often used to denote a material that is carried through the entire measurement procedure. Terms such as \"field blank\", \"calibration blank\", and \"instrument blank\" refer to materials handled in specific parts of the measurement procedure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08010 "A blank material to which a relevant component has been added is often termed \"spiked blank\" or \"fortified blank\". Compare spike, internal standard, and measurement procedure with standard addition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08010 "If the term \"blank\" is used, for example, to denote blank indication or the related blank value or blank correction, this must be clarified by the context."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08010 goldbook:08049)
AnnotationAssertion(rdfs:seeAlso goldbook:08010 goldbook:08008)
AnnotationAssertion(rdfs:seeAlso goldbook:08010 goldbook:08009)
AnnotationAssertion(rdfs:seeAlso goldbook:08010 goldbook:08004)
AnnotationAssertion(rdfs:seeAlso goldbook:08010 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08010 goldbook:08030)
AnnotationAssertion(rdfs:seeAlso goldbook:08010 goldbook:08047)
AnnotationAssertion(mito:isMentionedBy goldbook:08010 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08010 "current"^^xsd:string)
Declaration(Class(goldbook:08011))
AnnotationAssertion(rdfs:label goldbook:08011 "calibration certificate")
AnnotationAssertion(dcterms:description goldbook:08011 "Document issued by a technically competent organization providing information about a calibration.")
AnnotationAssertion(rdfs:comment goldbook:08011 "The document may include a statement describing the calibration procedure and the calibrators (calibrants) applied along with the calibration curve, calibration diagram, or other presentations of the calibration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08011 "Calibration certificates are often valid for a stated period of time, although this is not stipulated in ISO/IEC 17025."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08011 "The authority of the organization issuing the document comes from its demonstrated technical competence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08011 goldbook:08065)
AnnotationAssertion(rdfs:seeAlso goldbook:08011 goldbook:08091)
AnnotationAssertion(mito:isMentionedBy goldbook:08011 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08011 "current"^^xsd:string)
Declaration(Class(goldbook:08012))
AnnotationAssertion(rdfs:label goldbook:08012 "calibration interval")
AnnotationAssertion(dcterms:description goldbook:08012 "Time period between calibrations over which the performance of the measuring system may be expected to meet specified requirements.")
AnnotationAssertion(rdfs:comment goldbook:08012 "Guidelines for the determination of calibration intervals of measuring systems are given in ILAC-G24."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08012 "ISO 14532 refers to a period \"between routine calibrations\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08012 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08012 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08012 "current"^^xsd:string)
Declaration(Class(goldbook:08013))
AnnotationAssertion(rdfs:label goldbook:08013 "certified property value")
AnnotationAssertion(dcterms:description goldbook:08013 "Property value of a reference material, accompanied by statements of associated uncertainty and traceability and identified as a certified property value in the reference material certificate.")
AnnotationAssertion(rdfs:comment goldbook:08013 "In this definition, \"traceability\" covers both metrological traceability of a measurement result and examination traceability but not object traceability. Similarly, \"uncertainty\" covers measurement uncertainty and examination uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08013 goldbook:08036)
AnnotationAssertion(rdfs:seeAlso goldbook:08013 goldbook:08117)
AnnotationAssertion(mito:isMentionedBy goldbook:08013 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08013 "current"^^xsd:string)
Declaration(Class(goldbook:08014))
AnnotationAssertion(rdfs:label goldbook:08014 "chemical purity")
AnnotationAssertion(dcterms:description goldbook:08014 "Mass (amount of substance or number of entities) of a specified component divided by the mass (amount of substance or number of entities, respectively) of the system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08014 "purity")
AnnotationAssertion(rdfs:comment goldbook:08014 "Purity is usually related to a major component. The other components are termed \"impurities\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08014 "The quantity, component, and system must be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08014 "The numerical quantity value of purity is often expressed as per cent or per mille."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08014 "Purity can be estimated as \\(1 - \\sum_{j=1}^{j=N} f_{j}\\), where \\(f_{j}\\) denotes fractions of the same type (mass fraction, amount of substance fraction or number fraction) of all other components \\(j = 1, \\dots, N\\). If the contributions are expressed as mass fractions, this estimation is sometimes termed \"mass balance\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08014 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08014 "current"^^xsd:string)
Declaration(Class(goldbook:08015))
AnnotationAssertion(rdfs:label goldbook:08015 "consensus property value")
AnnotationAssertion(dcterms:description goldbook:08015 "Property value derived from a collection of results.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08015 "consensus value")
AnnotationAssertion(rdfs:comment goldbook:08015 "The term \"consensus value\" is typically used to describe estimates of a measure of location, such as mean value, median or mode, and dispersion derived from results reported by participants in a proficiency testing round (see participant in an interlaboratory comparison), but may also be used to refer to values derived from results of a specified subset of such results or, for example, from a number of laboratories chosen for their expertise for the particular analysis. See performance score and standard deviation for proficiency assessment."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08015 "The consensus property value, when it is a value of a unitary quantity, may be expressed as a mean, median, or mode, and is then termed \"consensus mean\", \"consensus median\", or \"consensus mode\", respectively. The mode and the median also apply for ordinal quantities and the mode applies for nominal properties."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08015 "A consensus property value is an example of assigned value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08015 "A consensus property value could, through appropriate actions, become a certified property value; this is in analogy to the certification of a reference material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08015 "A consensus property value may be obtained in a material-certification study or by agreement between appropriate organizations or experts."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08015 goldbook:08118)
AnnotationAssertion(rdfs:seeAlso goldbook:08015 goldbook:08013)
AnnotationAssertion(rdfs:seeAlso goldbook:08015 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08015 goldbook:08093)
AnnotationAssertion(rdfs:seeAlso goldbook:08015 goldbook:08095)
AnnotationAssertion(rdfs:seeAlso goldbook:08015 goldbook:08130)
AnnotationAssertion(mito:isMentionedBy goldbook:08015 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08015 "current"^^xsd:string)
Declaration(Class(goldbook:08016))
AnnotationAssertion(rdfs:label goldbook:08016 "conventional quantity value")
AnnotationAssertion(dcterms:description goldbook:08016 "Quantity value attributed by agreement to a quantity for a given purpose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08016 "conventional value")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08016 "conventional value of a quantity")
AnnotationAssertion(rdfs:comment goldbook:08016 "Sometimes a conventional quantity value is an estimate of a true quantity value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08016 "A conventional quantity value is generally accepted as being associated with a suitably small measurement uncertainty, which might be zero."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08016 "In quality assurance and quality control in chemistry, a conventional quantity value, which may be a consensus property value, is often termed \"assigned value\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08016 goldbook:08015)
AnnotationAssertion(rdfs:seeAlso goldbook:08016 goldbook:08057)
AnnotationAssertion(rdfs:seeAlso goldbook:08016 goldbook:08081)
AnnotationAssertion(mito:isMentionedBy goldbook:08016 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08016 "current"^^xsd:string)
Declaration(Class(goldbook:08017))
AnnotationAssertion(rdfs:label goldbook:08017 "critical value")
AnnotationAssertion(dcterms:description goldbook:08017 "Measured quantity value for a quantity of a component in a material, above which the component is declared to be present.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08017 "critical level")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08017 "decision level")
AnnotationAssertion(rdfs:comment goldbook:08017 "The critical value is usually considered to be a characteristic of a particular measurement procedure performed in a particular laboratory."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08017 "In some European legislations, the term \"decision limit\" (denoted as CCα) is used for the concept 'critical value'."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08017 "The quantity measured is usually a mass fraction or a concentration but can also be, for example, a mass or an amount of substance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08017 "The critical value is chosen to give a probability α (usually 0.05) of a measured quantity value exceeding the critical value when the component is absent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08017 "The detection decision is made by comparing a measured quantity value with the critical value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08017 "Another important concept in characterizing the capability of detection of measurement procedures is the limit of detection."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08017 goldbook:08061)
AnnotationAssertion(rdfs:seeAlso goldbook:08017 goldbook:08028)
AnnotationAssertion(mito:isMentionedBy goldbook:08017 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08017 "current"^^xsd:string)
Declaration(Class(goldbook:08018))
AnnotationAssertion(rdfs:label goldbook:08018 "determination")
AnnotationAssertion(dcterms:description goldbook:08018 "Set of operations that are carried out on an object in order to provide qualitative or quantitative information about this object.")
AnnotationAssertion(rdfs:comment goldbook:08018 "\"Determination\" is a term in general usage and often implies a human decision."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08018 "\"Determination\" is a superordinate concept of measurement and examination, and so, the term \"determination\" should not be used when \"measurement\" or \"examination\" applies."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08018 "ISO 9000 defines determination as \"activity to find out one or more characteristics and their characteristic values\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08018 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08018 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08018 "current"^^xsd:string)
Declaration(Class(goldbook:08019))
AnnotationAssertion(rdfs:label goldbook:08019 "interferent")
AnnotationAssertion(dcterms:description goldbook:08019 "Component of the matrix that embodies an influence quantity.")
AnnotationAssertion(mito:isMentionedBy goldbook:08019 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08019 "current"^^xsd:string)
Declaration(Class(goldbook:08020))
AnnotationAssertion(rdfs:label goldbook:08020 "intermediate measurement precision")
AnnotationAssertion(dcterms:description goldbook:08020 "Measurement precision under intermediate precision conditions of measurement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08020 "intermediate precision")
AnnotationAssertion(rdfs:comment goldbook:08020 "\"Intralaboratory precision\" or \"within-laboratory precision\" is sometimes used as a synonym of intermediate measurement precision."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08020 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08020 "current"^^xsd:string)
Declaration(Class(goldbook:08021))
AnnotationAssertion(rdfs:label goldbook:08021 "laboratory bias")
AnnotationAssertion(dcterms:description goldbook:08021 "Contribution to measurement bias that is attributed to systematic effects on measurement results made in a laboratory.")
AnnotationAssertion(rdfs:comment goldbook:08021 "Measurement bias in analytical chemistry may be considered to include run bias, laboratory bias, and measurement procedure bias."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08021 goldbook:08003)
AnnotationAssertion(rdfs:seeAlso goldbook:08021 goldbook:08029)
AnnotationAssertion(rdfs:seeAlso goldbook:08021 goldbook:08041)
AnnotationAssertion(rdfs:seeAlso goldbook:08021 goldbook:08048)
AnnotationAssertion(mito:isMentionedBy goldbook:08021 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08021 "current"^^xsd:string)
Declaration(Class(goldbook:08022))
AnnotationAssertion(rdfs:label goldbook:08022 "limit of quantification")
AnnotationAssertion(dcterms:description goldbook:08022 "Smallest or largest measured quantity value, obtained by a given measurement procedure, which fulfils a requirement of fitness for purpose.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08022 "LOQ")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08022 "quantification limit")
AnnotationAssertion(rdfs:comment goldbook:08022 "The quantity measured is usually a mass fraction or a concentration but can also be for example, a mass or an amount of substance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08022 "The requirement can, for example, be a standard deviation under repeatability conditions of measurement or a measurement uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08022 "The smallest and largest measured quantity values correspond to the lower limit of quantification (LLOQ) and the upper limit of quantification (ULOQ), respectively. The interval between the LLOQ and ULOQ is the working interval."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08022 "If the LLOQ is estimated as a multiple of the standard deviation of measured values of a blank material (or one spiked with a small aliquot of the component) obtained under repeatability conditions of measurement, it is important to document the multiplication factor, which may be 5, 6, or 10, applied so that different values stated for the LLOQ can be compared."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08022 goldbook:08010)
AnnotationAssertion(rdfs:seeAlso goldbook:08022 goldbook:08073)
AnnotationAssertion(rdfs:seeAlso goldbook:08022 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08022 goldbook:08040)
AnnotationAssertion(rdfs:seeAlso goldbook:08022 goldbook:08122)
AnnotationAssertion(rdfs:seeAlso goldbook:08022 goldbook:08051)
AnnotationAssertion(mito:isMentionedBy goldbook:08022 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08022 "current"^^xsd:string)
Declaration(Class(goldbook:08023))
AnnotationAssertion(rdfs:label goldbook:08023 "linearity of a measuring system")
AnnotationAssertion(dcterms:description goldbook:08023 "Ability of a measuring system to provide measured quantity values that are directly proportional to the quantity value of the measurand.")
AnnotationAssertion(rdfs:comment goldbook:08023 "The linearity of a measuring system is assessed during procedure validation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08023 "The set of measured quantity values for which linearity of a measuring system applies is usually termed \"linear interval\" or \"linear range\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08023 "Linearity of a measuring system should not be confused with linearity of calibration."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08023 goldbook:08024)
AnnotationAssertion(rdfs:seeAlso goldbook:08023 goldbook:08097)
AnnotationAssertion(mito:isMentionedBy goldbook:08023 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08023 "current"^^xsd:string)
Declaration(Class(goldbook:08024))
AnnotationAssertion(rdfs:label goldbook:08024 "linearity of calibration")
AnnotationAssertion(dcterms:description goldbook:08024 "Closeness of agreement between indications obtained using calibrators in the first step of a calibration and indications predicted by the calibration function for the calibrators’ reference quantity values.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08024 "calibration linearity")
AnnotationAssertion(rdfs:comment goldbook:08024 "The concept applies to calibration functions of any mathematical form. The term \"linearity\" is historical and refers to a time when calibration graphs were constructed on paper and were invariably considered to be linear."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08024 "Linearity of calibration may be expressed by measures of agreement (for example, correlation coefficient) or deviation (for example, standard error of regression), obtained by regression of calibration data or assessed from a residual plot."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08024 "Linearity of calibration is assessed during procedure validation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08024 "Calibration linearity should not be confused with linearity of a measuring system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08024 goldbook:08023)
AnnotationAssertion(rdfs:seeAlso goldbook:08024 goldbook:08097)
AnnotationAssertion(mito:isMentionedBy goldbook:08024 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08024 "current"^^xsd:string)
Declaration(Class(goldbook:08025))
AnnotationAssertion(rdfs:label goldbook:08025 "material homogeneity")
AnnotationAssertion(dcterms:description goldbook:08025 "Uniform structure or composition of a material with respect to one or more specified properties.")
AnnotationAssertion(rdfs:comment goldbook:08025 "A material is said to be homogeneous with respect to a specified quantity if the quantity values measured using aliquots of a specified size do not fall outside a specified interval. See minimum sample size."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08025 "In the homogeneity study of a candidate reference material, it is distinguished whether the analytical samples are taken from different supply units or from a single supply unit (\"termed between-bottle homogeneity\" or \"within-bottle homogeneity\", respectively)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08025 "Inhomogeneity is a source of measurement uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08025 "Detailed guidance for the assessment of homogeneity of reference materials is given in ISO Guide 35."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08025 goldbook:08060)
AnnotationAssertion(rdfs:seeAlso goldbook:08025 goldbook:08034)
AnnotationAssertion(mito:isMentionedBy goldbook:08025 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08025 "current"^^xsd:string)
Declaration(Class(goldbook:08026))
AnnotationAssertion(rdfs:label goldbook:08026 "material recovery")
AnnotationAssertion(dcterms:description goldbook:08026 "Mass (volume, amount of substance) of a specified component isolated from a system divided by the mass (volume, amount of substance) of the system prior to isolation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08026 "recovery")
AnnotationAssertion(rdfs:comment goldbook:08026 "The measurement unit of material recovery is the measurement unit of the quantity related to the specified component divided by the unit of the quantity describing the system. When these units are the same, material recovery may be expressed as a percentage, and the quantity specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08026 "The term \"recovery\" is also used to describe a recovered quantity value ratio. Therefore, the term \"recovery\" should not be used without qualification unless the meaning is clear from the context."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08026 goldbook:08039)
AnnotationAssertion(mito:isMentionedBy goldbook:08026 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08026 "current"^^xsd:string)
Declaration(Class(goldbook:08027))
AnnotationAssertion(rdfs:label goldbook:08027 "material stability")
AnnotationAssertion(dcterms:description goldbook:08027 "Constancy of a property of a material over time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08027 "stability")
AnnotationAssertion(rdfs:comment goldbook:08027 "A material is said to be stable with respect to a specified property if its measured or examined property value does not fall outside a specified interval during storage under specified conditions over a specified period of time."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08027 "A reference material is assessed for the stability of an embodied property under conditions of transport (\"short-term stability\") and storage (\"long-term stability\")."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08027 "The variation of the property value over time adds a contribution to the uncertainty budget or the examination uncertainty, as applicable. Regarding the assessment of stability of the reference material, detailed guidance is given in ISO Guide 35."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08027 "The term \"stability\" is also used for stability of a measuring instrument or process (see control limit)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08027 goldbook:08069)
AnnotationAssertion(mito:isMentionedBy goldbook:08027 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08027 "current"^^xsd:string)
Declaration(Class(goldbook:08028))
AnnotationAssertion(rdfs:label goldbook:08028 "measurement procedure")
AnnotationAssertion(dcterms:description goldbook:08028 "Detailed description of a measurement according to one or more measurement principles and to a given measurement method, based on a measurement model and including any calculation to obtain a measurement result.")
AnnotationAssertion(rdfs:comment goldbook:08028 "A measurement procedure is usually documented in sufficient detail to enable an operator to perform a measurement."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08028 "A measurement procedure can include a statement concerning a target measurement uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08028 "Measurement procedures in chemistry can be structured according to ISO 78-2 or Annex A of the Eurachem Guide \"The Fitness for Purpose of Analytical Methods\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08028 "An authorized measurement procedure is sometimes termed \"standard operating procedure\" (SOP) or \"recommended operating procedure\" (ROP)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08028 "In ISO/IEC 17025, the term \"method\" is used for measurement procedure. \"Examination procedure\" is defined for medical laboratories."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08028 "The historical term \"assay\" is now largely obsolete as a synonym for metrological terms such as measurement procedure but still used in composite terms, for example, immunoassay and bioassay."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08028 goldbook:08131)
AnnotationAssertion(rdfs:seeAlso goldbook:08028 goldbook:08133)
AnnotationAssertion(mito:isMentionedBy goldbook:08028 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08028 "current"^^xsd:string)
Declaration(Class(goldbook:08029))
AnnotationAssertion(rdfs:label goldbook:08029 "measurement procedure bias")
AnnotationAssertion(dcterms:description goldbook:08029 "Contribution to measurement bias that is attributed to systematic effects on measurement results made according to a measurement procedure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08029 "measurement method bias")
AnnotationAssertion(rdfs:comment goldbook:08029 "Measurement procedure bias covers instrumental bias."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08029 "Contributions to measurement procedure bias are calculated during procedure validation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08029 "Measurement bias in analytical chemistry may be considered to include run bias, laboratory bias, and measurement procedure bias."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08029 goldbook:08003)
AnnotationAssertion(rdfs:seeAlso goldbook:08029 goldbook:08021)
AnnotationAssertion(rdfs:seeAlso goldbook:08029 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08029 goldbook:08097)
AnnotationAssertion(rdfs:seeAlso goldbook:08029 goldbook:08041)
AnnotationAssertion(rdfs:seeAlso goldbook:08029 goldbook:08048)
AnnotationAssertion(mito:isMentionedBy goldbook:08029 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08029 "current"^^xsd:string)
Declaration(Class(goldbook:08030))
AnnotationAssertion(rdfs:label goldbook:08030 "measurement procedure with standard addition")
AnnotationAssertion(dcterms:description goldbook:08030 "Measurement procedure in which indications are obtained for an analytical sample as well as for analytical samples with addition(s) of a measurement standard.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08030 "standard addition")
AnnotationAssertion(rdfs:comment goldbook:08030 "A measurement procedure with standard addition provides an unbiased measurement result if there is a multiplicative matrix effect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08030 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08030 goldbook:08035)
AnnotationAssertion(mito:isMentionedBy goldbook:08030 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08030 "current"^^xsd:string)
Declaration(Class(goldbook:08031))
AnnotationAssertion(rdfs:label goldbook:08031 "measurement reproducibility")
AnnotationAssertion(dcterms:description goldbook:08031 "Measurement precision under reproducibility conditions of measurement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08031 "reproducibility")
AnnotationAssertion(rdfs:comment goldbook:08031 "Relevant statistical terms are given in ISO 5725-1 and ISO 5725-2."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08031 "The term \"interlaboratory precision\" or \"between-laboratory precision\" is sometimes used as a synonym of measurement reproducibility."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08031 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08031 "current"^^xsd:string)
Declaration(Class(goldbook:08032))
AnnotationAssertion(rdfs:label goldbook:08032 "metrological compatibility of measurement results")
AnnotationAssertion(dcterms:description goldbook:08032 "Property of a set of measurement results for a specified measurand, such that the absolute value of the difference of any pair of measured quantity values from two different measurement results is smaller than some chosen multiple of the standard measurement uncertainty of that difference.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08032 "metrological compatibility")
AnnotationAssertion(rdfs:comment goldbook:08032 "Metrological compatibility of measurement results replaces the traditional concept of \"staying within the error\", as it represents the criterion for deciding whether two measurement results refer to the same measurand or not. If in a set of measurements of a measurand, thought to be constant, a measurement result is not compatible with the others, either the measurement was not correct (for example, its measurement uncertainty, was assessed as being too small), or the measured quantity changed between measurements."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08032 "Correlation between the measurements influences metrological compatibility of measurement results. If the measurements are completely uncorrelated, the standard measurement uncertainty of their difference is equal to the root square sum of their standard measurement uncertainties, while it is lower for positive covariance or higher for negative covariance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08032 "As required by the Mutual Recognition Arrangement (MRA) of the International Committee for Weights and Measures (CIPM), through which national metrology institutes demonstrate the international equivalence of their measurement standards, the concept \"degree of equivalence\" is applied in special interlaboratory comparisons termed \"key comparisons\". The degree of equivalence of each national measurement standard is expressed quantitatively by two terms: its deviation from the reference quantity value of the key comparison and the measurement uncertainty of this deviation (at a level of confidence of approximately 95 %). See also: metrological equivalence of measurement results."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08032 goldbook:08081)
AnnotationAssertion(rdfs:seeAlso goldbook:08032 goldbook:08033)
AnnotationAssertion(mito:isMentionedBy goldbook:08032 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08032 "current"^^xsd:string)
Declaration(Class(goldbook:08033))
AnnotationAssertion(rdfs:label goldbook:08033 "metrological equivalence of measurement results")
AnnotationAssertion(dcterms:description goldbook:08033 "Property of two or more measurement results for a given measurand which have metrological compatibility of measurement results, so that they are each acceptable for the same specified intended use.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08033 "equivalence of measurement results")
AnnotationAssertion(rdfs:comment goldbook:08033 "Measurement results are either metrologically equivalent or they are not."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08033 goldbook:08032)
AnnotationAssertion(mito:isMentionedBy goldbook:08033 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08033 "current"^^xsd:string)
Declaration(Class(goldbook:08034))
AnnotationAssertion(rdfs:label goldbook:08034 "minimum sample size")
AnnotationAssertion(dcterms:description goldbook:08034 "Lower limit of sample size stipulated in documentation taken for chemical analysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08034 "minimum sample intake")
AnnotationAssertion(rdfs:comment goldbook:08034 "Examples of documentation include a measurement procedure, product information sheets (see reference material), and reference material certificates."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08034 "Values associated with performance characteristics of a measurement procedure and the property values stated in documentation are rendered invalid if the minimum sample size is not taken."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08034 goldbook:08004)
AnnotationAssertion(rdfs:seeAlso goldbook:08034 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08034 goldbook:08094)
AnnotationAssertion(rdfs:seeAlso goldbook:08034 goldbook:08117)
AnnotationAssertion(mito:isMentionedBy goldbook:08034 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08034 "current"^^xsd:string)
Declaration(Class(goldbook:08035))
AnnotationAssertion(rdfs:label goldbook:08035 "multiplicative matrix effect")
AnnotationAssertion(dcterms:description goldbook:08035 "Matrix effect that is proportional to the measured quantity value of the measurand.")
AnnotationAssertion(rdfs:comment goldbook:08035 "A multiplicative matrix effect can be compensated for by following a measurement procedure with standard addition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08035 "A multiplicative matrix effect affects the slope, not the intercept, of a linear calibration curve."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08035 "The effect is sometimes termed \"rotational matrix effect\" or \"proportional interference\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08035 "A multiplicative matrix effect may originate from non-analyte components of the measurement standard if these contribute to the signal attributed to the analyte."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08035 goldbook:08030)
AnnotationAssertion(mito:isMentionedBy goldbook:08035 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08035 "current"^^xsd:string)
Declaration(Class(goldbook:08036))
AnnotationAssertion(rdfs:label goldbook:08036 "non-certified property value")
AnnotationAssertion(dcterms:description goldbook:08036 "Property value that is provided for information only but is not certified by a reference material producer.")
AnnotationAssertion(rdfs:comment goldbook:08036 "A non-certified property value cannot be used as reference in a metrological traceability chain."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08036 "A non-certified property value may be included in the reference material certificate or supplied in other form."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08036 "In ISO Guide 30, \"indicative value\", \"information value\", and \"informative value\" are admitted terms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08036 goldbook:08117)
AnnotationAssertion(rdfs:seeAlso goldbook:08036 goldbook:08120)
AnnotationAssertion(mito:isMentionedBy goldbook:08036 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08036 "current"^^xsd:string)
Declaration(Class(goldbook:08037))
AnnotationAssertion(rdfs:label goldbook:08037 "object traceability")
AnnotationAssertion(dcterms:description goldbook:08037 "Ability to trace the history, application, or location of an object.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08037 "traceability (of an object)")
AnnotationAssertion(rdfs:comment goldbook:08037 "When considering a product or a service, traceability can relate to: the origin of materials and parts, the processing history, or the distribution and location of the product or service after delivery."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08037 "In, the term defined is \"traceability\". However, because of the potential confusion with metrological traceability, it is recommended to use the full term if there is ambiguity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08037 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08037 "current"^^xsd:string)
Declaration(Class(goldbook:08038))
AnnotationAssertion(rdfs:label goldbook:08038 "property value assignment")
AnnotationAssertion(dcterms:description goldbook:08038 "Determination of property values obtained in the course of the production of a reference material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08038 "value assignment")
AnnotationAssertion(rdfs:seeAlso goldbook:08038 goldbook:08018)
AnnotationAssertion(rdfs:seeAlso goldbook:08038 goldbook:08057)
AnnotationAssertion(mito:isMentionedBy goldbook:08038 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08038 "current"^^xsd:string)
Declaration(Class(goldbook:08039))
AnnotationAssertion(rdfs:label goldbook:08039 "recovered quantity value ratio")
AnnotationAssertion(dcterms:description goldbook:08039 "Measured quantity value relating a component to a system divided by a reference value.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08039 "analytical recovery")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08039 "recovery")
AnnotationAssertion(rdfs:comment goldbook:08039 "The quantities involved are rational unitary quantities and of the same kind of quantity, usually either a concentration or content."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08039 "The respective measurement procedure must be specified."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08039 "The definition can be symbolized by \\(R_{\\rm{B}} = Q_{\\rm{B,measured}}/Q_{\\rm{B,reference}}\\), where \\(R\\) denotes the recovered ratio of the quantity values \\(Q\\), and \\(\\ce{B}\\) identifies the component."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08039 "The term \"recovery\" is also used to describe material recovery. Therefore, the term \"recovery\" should not be used without qualification unless the meaning is clear from the context."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08039 "Recovery quantity value ratio is used in procedure validation to evaluate and correct for the measurement procedure bias."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08039 "Recovered quantity value ratio may be estimated from the measured change of the quantity value of the component of interest upon the addition of a known amount of substance or mass of the component. The added material containing the component is often termed \"spike\". See also: blank material Note 5, measurement procedure with standard addition, and spike."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08010)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08026)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08029)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08030)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08097)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08047)
AnnotationAssertion(rdfs:seeAlso goldbook:08039 goldbook:08050)
AnnotationAssertion(mito:isMentionedBy goldbook:08039 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08039 "current"^^xsd:string)
Declaration(Class(goldbook:08040))
AnnotationAssertion(rdfs:label goldbook:08040 "repeatability condition of measurement")
AnnotationAssertion(dcterms:description goldbook:08040 "Condition of measurement, out of a set of conditions that includes the same measurement procedure, same operators, same measuring system, same operating conditions, and same location, and replicate measurements on the same or similar objects over a short period of time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08040 "repeatability condition")
AnnotationAssertion(rdfs:comment goldbook:08040 "A condition of measurement is a repeatability condition only with respect to a specified set of repeatability conditions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08040 "In ISO 3534-2, \"same operator\" (singular) is stipulated as a repeatability condition. The VIM request of \"same operators\" (plural) should be understood such that if two or more operators contribute to one measurement, they should be involved in the same way in repeated measurements."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08040 "In analytical chemistry, the phrase \"under repeatability conditions\" refers to the above specified set of conditions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08040 "A set of measurements under repeatability conditions is often termed \"analytical run\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08040 goldbook:08003)
AnnotationAssertion(rdfs:seeAlso goldbook:08040 goldbook:08006)
AnnotationAssertion(rdfs:seeAlso goldbook:08040 goldbook:08028)
AnnotationAssertion(mito:isMentionedBy goldbook:08040 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08040 "current"^^xsd:string)
Declaration(Class(goldbook:08041))
AnnotationAssertion(rdfs:label goldbook:08041 "run bias")
AnnotationAssertion(dcterms:description goldbook:08041 "Contribution to measurement bias that is attributed to systematic effects on measurement results made in a single analytical run.")
AnnotationAssertion(rdfs:comment goldbook:08041 "Measurement bias in analytical chemistry may be considered to include run bias, laboratory bias, and measurement procedure bias."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08041 goldbook:08003)
AnnotationAssertion(rdfs:seeAlso goldbook:08041 goldbook:08006)
AnnotationAssertion(rdfs:seeAlso goldbook:08041 goldbook:08021)
AnnotationAssertion(rdfs:seeAlso goldbook:08041 goldbook:08029)
AnnotationAssertion(rdfs:seeAlso goldbook:08041 goldbook:08048)
AnnotationAssertion(mito:isMentionedBy goldbook:08041 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08041 "current"^^xsd:string)
Declaration(Class(goldbook:08042))
AnnotationAssertion(rdfs:label goldbook:08042 "sample pre-treatment")
AnnotationAssertion(dcterms:description goldbook:08042 "Collective noun for all procedures used for conditioning a sample to a defined state which allows subsequent chemical analysis or long-term storage (see material stability).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08042 "sample preparation")
AnnotationAssertion(rdfs:comment goldbook:08042 "Sample pre-treatment includes, for example, mixing, splitting, drying, crushing, stabilization, dissolving, extracting, diluting, precipitating, and derivatizing."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08042 goldbook:08004)
AnnotationAssertion(rdfs:seeAlso goldbook:08042 goldbook:08027)
AnnotationAssertion(mito:isMentionedBy goldbook:08042 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08042 "current"^^xsd:string)
Declaration(Class(goldbook:08043))
AnnotationAssertion(rdfs:label goldbook:08043 "sampling")
AnnotationAssertion(dcterms:description goldbook:08043 "Act of taking or constituting a sample.")
AnnotationAssertion(rdfs:comment goldbook:08043 "Sampling often provides a contribution to the measurement uncertainty budget or the examination uncertainty, as applicable."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08043 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08043 "current"^^xsd:string)
Declaration(Class(goldbook:08044))
AnnotationAssertion(rdfs:label goldbook:08044 "sampling increment")
AnnotationAssertion(dcterms:description goldbook:08044 "Individual portion of material collected by a single operation of a sampling device.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08044 "increment")
AnnotationAssertion(mito:isMentionedBy goldbook:08044 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08044 "current"^^xsd:string)
Declaration(Class(goldbook:08045))
AnnotationAssertion(rdfs:label goldbook:08045 "sampling target")
AnnotationAssertion(dcterms:description goldbook:08045 "Portion of the material, at a particular time, that the sample is intended to represent.")
AnnotationAssertion(rdfs:comment goldbook:08045 "The sampling target should be defined prior to designing the sampling plan."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08045 "The sampling target may be defined by Regulations (for example, lot size)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08045 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08045 "current"^^xsd:string)
Declaration(Class(goldbook:08046))
AnnotationAssertion(rdfs:label goldbook:08046 "shelf life")
AnnotationAssertion(dcterms:description goldbook:08046 "Time interval during which a reference material producer warrants the material stability of the reference material.")
AnnotationAssertion(rdfs:comment goldbook:08046 "The shelf life is equivalent to the \"period of validity\" of the reference material certificate and is ended by the \"expiry date\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08046 goldbook:08027)
AnnotationAssertion(rdfs:seeAlso goldbook:08046 goldbook:08117)
AnnotationAssertion(rdfs:seeAlso goldbook:08046 goldbook:08120)
AnnotationAssertion(mito:isMentionedBy goldbook:08046 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08046 "current"^^xsd:string)
Declaration(Class(goldbook:08047))
AnnotationAssertion(rdfs:label goldbook:08047 "spike")
AnnotationAssertion(dcterms:description goldbook:08047 "Material with known quantity values added to an analytical sample.")
AnnotationAssertion(rdfs:comment goldbook:08047 "The material can be a reference material or a certified reference material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08047 "The known quantity value is often a fraction or concentration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08047 "A spike may be used to estimate the recovered quantity value ratio or compensate for systematic measurement error."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08047 "\"Spike\" used as a verb is the addition of a spike to a sample."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08047 goldbook:08039)
AnnotationAssertion(mito:isMentionedBy goldbook:08047 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08047 "current"^^xsd:string)
Declaration(Class(goldbook:08048))
AnnotationAssertion(rdfs:label goldbook:08048 "systematic effect")
AnnotationAssertion(dcterms:description goldbook:08048 "Recognized effect of an influence quantity on a measured quantity value.")
AnnotationAssertion(rdfs:comment goldbook:08048 "A systematic effect can be compensated for by a correction."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08048 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08048 "current"^^xsd:string)
Declaration(Class(goldbook:08049))
AnnotationAssertion(rdfs:label goldbook:08049 "testing")
AnnotationAssertion(dcterms:description goldbook:08049 "Determination of one or more characteristics of an object of conformity assessment, according to a specified procedure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08049 "test")
AnnotationAssertion(rdfs:comment goldbook:08049 "In analytical chemistry, testing may be a measurement to obtain a quantity value or an examination, such as identifying a chemical substance (see qualitative analysis)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08049 goldbook:08018)
AnnotationAssertion(rdfs:seeAlso goldbook:08049 goldbook:08003)
AnnotationAssertion(rdfs:seeAlso goldbook:08049 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08049 goldbook:08080)
AnnotationAssertion(mito:isMentionedBy goldbook:08049 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08049 "current"^^xsd:string)
Declaration(Class(goldbook:08050))
AnnotationAssertion(rdfs:label goldbook:08050 "unitary quantity")
AnnotationAssertion(dcterms:description goldbook:08050 "Quantity with a magnitude expressed as a reference quantity multiplied by a number.")
AnnotationAssertion(rdfs:comment goldbook:08050 "In the VIM, the concept is denoted as \"quantity expressed by a measurement unit\" in the concept diagram Figure A.1 and is referred to as \"quantities other than ordinal quantities\", for example, in entry 1.21, and as \"non-ordinal quantity\" in Note 1 to entry 2.41."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08050 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08050 "current"^^xsd:string)
Declaration(Class(goldbook:08051))
AnnotationAssertion(rdfs:label goldbook:08051 "working interval")
AnnotationAssertion(dcterms:description goldbook:08051 "Set of quantity values over which a measuring instrument or measuring system provides measurement results with acceptable measurement uncertainty under defined conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08051 "working range")
AnnotationAssertion(rdfs:comment goldbook:08051 "In some fields, the term is \"measurement range\". In entry 4.7 of VIM, a similar concept termed \"measuring interval\" is defined."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08051 "The working interval is bounded by the lower and upper limit of quantification."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08051 "The lower limit of a working interval should not be confused with the detection limit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08051 goldbook:08022)
AnnotationAssertion(rdfs:seeAlso goldbook:08051 goldbook:08023)
AnnotationAssertion(mito:isMentionedBy goldbook:08051 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08051 "current"^^xsd:string)
Declaration(Class(goldbook:08052))
AnnotationAssertion(rdfs:label goldbook:08052 "acceptance interval")
AnnotationAssertion(dcterms:description goldbook:08052 "Interval of permissible measured quantity values.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08052 "acceptance zone")
AnnotationAssertion(rdfs:comment goldbook:08052 "Unless otherwise stated in the specification, the acceptance limits belong to the acceptance interval."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08052 "An acceptance interval is termed an \"acceptance zone\" in the Eurachem guide on compliance assessment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08052 goldbook:08053)
AnnotationAssertion(rdfs:seeAlso goldbook:08052 goldbook:08072)
AnnotationAssertion(rdfs:seeAlso goldbook:08052 goldbook:08121)
AnnotationAssertion(mito:isMentionedBy goldbook:08052 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08052 "current"^^xsd:string)
Declaration(Class(goldbook:08053))
AnnotationAssertion(rdfs:label goldbook:08053 "acceptance limit")
AnnotationAssertion(dcterms:description goldbook:08053 "Specified upper or lower bound of permissible measured quantity values.")
AnnotationAssertion(rdfs:comment goldbook:08053 "Permissible measured quantity values are associated with items that conform to specified requirements with at least a predetermined conformance probability and lie within the acceptance interval."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08053 goldbook:08052)
AnnotationAssertion(rdfs:seeAlso goldbook:08053 goldbook:08066)
AnnotationAssertion(rdfs:seeAlso goldbook:08053 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08053 goldbook:08129)
AnnotationAssertion(mito:isMentionedBy goldbook:08053 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08053 "current"^^xsd:string)
Declaration(Class(goldbook:08054))
AnnotationAssertion(rdfs:label goldbook:08054 "accreditation of a laboratory")
AnnotationAssertion(dcterms:description goldbook:08054 "Third-party attestation related to a laboratory conveying formal demonstration of its competence to carry out specific conformity assessment tasks.")
AnnotationAssertion(rdfs:comment goldbook:08054 "Examples of conformity assessment tasks for which accreditation can be granted are measurement, testing, inspection, provision of proficiency testing schemes, and production of reference materials."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08054 "The criteria for determining a laboratory's competence are based on relevant international standards, for example, ISO/IEC 17025, ISO 15189, or ISO 15195, and include adequate quality assurance and quality control procedures, such as qualifications, training and experience of staff, appropriate equipment that is properly calibrated and maintained, use of validated measurement procedures, participation in interlaboratory comparisons, and appropriate sampling practices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08003)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08065)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08080)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08081)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08104)
AnnotationAssertion(rdfs:seeAlso goldbook:08054 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08054 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08054 "current"^^xsd:string)
Declaration(Class(goldbook:08055))
AnnotationAssertion(rdfs:label goldbook:08055 "analytical selectivity")
AnnotationAssertion(dcterms:description goldbook:08055 "Selectivity of a measuring system in analytical chemistry.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08055 "selectivity")
AnnotationAssertion(rdfs:comment goldbook:08055 "Selectivity should be qualified by \"analytical\" if there is potential confusion with selectivity in catalysis or in organic reaction mechanisms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08055 goldbook:08003)
AnnotationAssertion(mito:isMentionedBy goldbook:08055 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08055 "current"^^xsd:string)
Declaration(Class(goldbook:08056))
AnnotationAssertion(rdfs:label goldbook:08056 "assessor")
AnnotationAssertion(dcterms:description goldbook:08056 "Person, assigned by an accreditation body, with relevant professional expertise and experience who can determine the competence of a laboratory.")
AnnotationAssertion(rdfs:comment goldbook:08056 "The assessor may work alone or as part of a team and be engaged in a voluntary or paid capacity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08056 "The work of an assessor is often referred to as \"assessment\" and sometimes as \"peer review\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08056 "Depending on the role and responsibilities of an assessor, terms such as \"lead assessor\" and \"technical assessor\" are often used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08056 goldbook:08065)
AnnotationAssertion(mito:isMentionedBy goldbook:08056 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08056 "current"^^xsd:string)
Declaration(Class(goldbook:08057))
AnnotationAssertion(rdfs:label goldbook:08057 "assigned value")
AnnotationAssertion(dcterms:description goldbook:08057 "Value attributed to a particular property of an item and that serves as an agreed reference for comparison.")
AnnotationAssertion(rdfs:comment goldbook:08057 "The value may be a reference quantity value or a value of a nominal property."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08057 "Options for establishing an assigned value for some types of proficiency testing schemes are detailed in ISO/IEC 17043 and ISO 13528."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08057 goldbook:08104)
AnnotationAssertion(rdfs:seeAlso goldbook:08057 goldbook:08038)
AnnotationAssertion(mito:isMentionedBy goldbook:08057 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08057 "current"^^xsd:string)
Declaration(Class(goldbook:08058))
AnnotationAssertion(rdfs:label goldbook:08058 "audit")
AnnotationAssertion(dcterms:description goldbook:08058 "Systematic, independent, and documented process for obtaining objective evidence and evaluating it objectively to determine the extent to which the audit criteria are fulfilled.")
AnnotationAssertion(rdfs:comment goldbook:08058 "The fundamental elements of an audit include the determination of the conformity of an object according to a procedure carried out by personnel not being responsible for the object audited."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08058 "An audit can be an internal audit (first party) or an external audit (second party or third party), and it can be a combined audit or a joint audit."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08058 "Internal audits, sometimes termed first-party audits, are conducted by, or on behalf of, the organization itself for management review and other internal purposes and can form the basis for an organization's declaration of conformity. Independence can be demonstrated by the freedom from responsibility for the activity being audited."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08058 "External audits include those generally termed second and third-party audits. Second-party audits are conducted by parties having an interest in the organization, such as customers, or by other persons on their behalf. Third-party audits are conducted by external, independent auditing organizations such as those providing certification/registration of conformity or governmental agencies."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08058 goldbook:08063)
AnnotationAssertion(rdfs:seeAlso goldbook:08058 goldbook:08018)
AnnotationAssertion(rdfs:seeAlso goldbook:08058 goldbook:08091)
AnnotationAssertion(mito:isMentionedBy goldbook:08058 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08058 "current"^^xsd:string)
Declaration(Class(goldbook:08059))
AnnotationAssertion(rdfs:label goldbook:08059 "candidate certified reference material")
AnnotationAssertion(dcterms:description goldbook:08059 "Reference material subjected to a process of reference material certification.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08059 "candidate CRM")
AnnotationAssertion(rdfs:seeAlso goldbook:08059 goldbook:08118)
AnnotationAssertion(mito:isMentionedBy goldbook:08059 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08059 "current"^^xsd:string)
Declaration(Class(goldbook:08060))
AnnotationAssertion(rdfs:label goldbook:08060 "candidate reference material")
AnnotationAssertion(dcterms:description goldbook:08060 "Material subjected to the procedures necessary to show its fitness for intended use (see fitness for purpose).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08060 "candidate RM")
AnnotationAssertion(rdfs:comment goldbook:08060 "A candidate reference material for a given property may already be a reference material for other properties."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08060 goldbook:08073)
AnnotationAssertion(mito:isMentionedBy goldbook:08060 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08060 "current"^^xsd:string)
Declaration(Class(goldbook:08061))
AnnotationAssertion(rdfs:label goldbook:08061 "capability")
AnnotationAssertion(dcterms:description goldbook:08061 "Ability of an object to realize an output that will fulfil the requirements for that output.")
AnnotationAssertion(rdfs:comment goldbook:08061 "Process capability terms in the field of statistics are defined in ISO 3534-2."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08061 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08061 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08061 "current"^^xsd:string)
Declaration(Class(goldbook:08062))
AnnotationAssertion(rdfs:label goldbook:08062 "cause-and-effect diagram")
AnnotationAssertion(dcterms:description goldbook:08062 "Diagram indicating the causes of a specific event or condition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08062 "fishbone diagram")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08062 "herringbone diagram")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08062 "Ishikawa diagram")
AnnotationAssertion(rdfs:comment goldbook:08062 "In analytical chemistry, Ishikawa diagrams are used to indicate sources of measurement uncertainty. See Fig. 1. Figure 1: Ishikawa diagram for the titration of a hydrochloric acid solution with sodium hydroxide solution that has been standardized using potassium hydrogen phthalate (KHP). When used for identification of sources of measurement uncertainty, the diagram illustrates how the quantity value of the measurand (\\(c_{\\ce{HCl}}\\)) depends on input quantities in a measurement model (symbols in bold), which in turn depend on other quantities. Symbols have their usual meanings. \\(f_{\\rm{precision}}\\) is a is a factor in the measurement function to account for measurement precision with value 1 and standard measurement uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08062 goldbook:08003)
AnnotationAssertion(mito:isMentionedBy goldbook:08062 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08062 "current"^^xsd:string)
Declaration(Class(goldbook:08063))
AnnotationAssertion(rdfs:label goldbook:08063 "certification")
AnnotationAssertion(dcterms:description goldbook:08063 "Third-party attestation related to products, processes, systems, or persons.")
AnnotationAssertion(rdfs:comment goldbook:08063 "Certification of a management system is sometimes also termed registration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08063 "Certification is applicable to all objects of conformity assessment except for conformity assessment bodies themselves, to which accreditation is applicable."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08063 goldbook:08067)
AnnotationAssertion(mito:isMentionedBy goldbook:08063 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08063 "current"^^xsd:string)
Declaration(Class(goldbook:08064))
AnnotationAssertion(rdfs:label goldbook:08064 "commutability of a reference material")
AnnotationAssertion(dcterms:description goldbook:08064 "Property of a reference material, demonstrated by the closeness of agreement between the relation among the measurement results for a stated quantity in this material, obtained according to two given measurement procedures, and the relation obtained among the measurement results for other specified materials.")
AnnotationAssertion(rdfs:comment goldbook:08064 "The reference material in question is usually a calibrator and the other specified materials are usually routine samples."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08064 "The measurement procedures referred to in the definition are the one preceding and the one following the reference material (calibrator) in question in a calibration hierarchy (see ISO 17511)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08064 "The material stability of commutable reference materials should be monitored regularly."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08064 "Cases in which a reference material producer is required to conduct assessment of commutability are outlined in ISO 15194."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08064 "Guidance for assessment of commutability of reference material in laboratory medicine is provided by IFCC."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08064 goldbook:08028)
AnnotationAssertion(mito:isMentionedBy goldbook:08064 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08064 "current"^^xsd:string)
Declaration(Class(goldbook:08065))
AnnotationAssertion(rdfs:label goldbook:08065 "competence")
AnnotationAssertion(dcterms:description goldbook:08065 "Ability to apply knowledge and skills to achieve intended results.")
AnnotationAssertion(rdfs:comment goldbook:08065 "Demonstrated competence is sometimes referred to as \"qualification\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08065 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08065 "current"^^xsd:string)
Declaration(Class(goldbook:08066))
AnnotationAssertion(rdfs:label goldbook:08066 "conformance probability")
AnnotationAssertion(dcterms:description goldbook:08066 "Probability that an item fulfils a specified requirement.")
AnnotationAssertion(rdfs:seeAlso goldbook:08066 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08066 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08066 "current"^^xsd:string)
Declaration(Class(goldbook:08067))
AnnotationAssertion(rdfs:label goldbook:08067 "conformity assessment")
AnnotationAssertion(dcterms:description goldbook:08067 "Activity to determine whether specified requirements relating to a product, process, system, person, or body are fulfilled.")
AnnotationAssertion(rdfs:comment goldbook:08067 "The subject field of conformity assessment includes activities, such as testing, calibration, carrying out an audit, inspection, and certification, as well as the accreditation of conformity assessment bodies."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08067 "The expression \"object of conformity assessment\" or \"object\" is used to encompass any particular material, product, installation, process, system, person, or body to which conformity assessment is applied."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08067 "\"Body\" refers to an organization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08052)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08058)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08063)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08072)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08076)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08080)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08121)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08129)
AnnotationAssertion(rdfs:seeAlso goldbook:08067 goldbook:08135)
AnnotationAssertion(mito:isMentionedBy goldbook:08067 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08067 "current"^^xsd:string)
Declaration(Class(goldbook:08068))
AnnotationAssertion(rdfs:label goldbook:08068 "control chart")
AnnotationAssertion(dcterms:description goldbook:08068 "Chart with control limits on which some statistical measure related to a series of samples is plotted in a particular order to steer the process with respect to that measure.")
AnnotationAssertion(rdfs:comment goldbook:08068 "The particular order is usually based on time or sample number order. Repeated sampling may be avoided where in-situ measurements are applicable."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08068 "The control chart operates most effectively when the measure is a process variable which is correlated with an ultimate product or service characteristic."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08068 "Examples of control charts are Shewhart means chart, Shewhart range chart, and cumulative sum control chart."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08068 "Control charts are commonly used in the regular monitoring of the performance of a measurement procedure, as part of the laboratory's internal quality control."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08068 goldbook:08127)
AnnotationAssertion(rdfs:seeAlso goldbook:08068 goldbook:08128)
AnnotationAssertion(rdfs:seeAlso goldbook:08068 goldbook:08069)
AnnotationAssertion(rdfs:seeAlso goldbook:08068 goldbook:08071)
AnnotationAssertion(rdfs:seeAlso goldbook:08068 goldbook:08082)
AnnotationAssertion(rdfs:seeAlso goldbook:08068 goldbook:08028)
AnnotationAssertion(mito:isMentionedBy goldbook:08068 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08068 "current"^^xsd:string)
Declaration(Class(goldbook:08069))
AnnotationAssertion(rdfs:label goldbook:08069 "control limit")
AnnotationAssertion(dcterms:description goldbook:08069 "Value defining an intended level of stability for a process.")
AnnotationAssertion(rdfs:comment goldbook:08069 "A control limit may be a statistical value or be related to a predetermined target value, calculated, for example, from a target measurement uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08069 "A typical control chart will consist of a centre line that reflects the level around which the plotted value can be expected to vary. In addition, this control chart will have two lines, called control limits, placed one on each side of the centre line, which define a band within which the value can be expected to lie randomly for a process in a state of statistical control."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08069 "Control limits on a Shewhart control chart are placed at a distance of ±2σ and ±3σ where σ is the known or estimated standard deviation of the population. This gives approximate probabilities of 0.05 and 0.003, respectively, of finding values outside the control limits. These limits are known as the upper and lower warning limit (UWL and LWL) and upper and lower action limit (UAL and LAL), respectively. See Shewart means chart - Fig. 1."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08069 "A typical response to a value outside a warning limit is to monitor the process and, if this condition is repeated, to stop and investigate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08069 "A value outside an action limit is normally taken as evidence that the process is no longer in statistical control. A typical response to such a value is to stop and investigate. (See process in a state of statistical control)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08069 goldbook:08125)
AnnotationAssertion(rdfs:seeAlso goldbook:08069 goldbook:08068)
AnnotationAssertion(rdfs:seeAlso goldbook:08069 goldbook:08099)
AnnotationAssertion(rdfs:seeAlso goldbook:08069 goldbook:08133)
AnnotationAssertion(mito:isMentionedBy goldbook:08069 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08069 "current"^^xsd:string)
Declaration(Class(goldbook:08070))
AnnotationAssertion(rdfs:label goldbook:08070 "coordinator of an interlaboratory comparison")
AnnotationAssertion(dcterms:description goldbook:08070 "Person(s) with responsibility for organizing and managing all of the activities involved in the operation of an interlaboratory comparison.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08070 "coordinator")
AnnotationAssertion(rdfs:seeAlso goldbook:08070 goldbook:08081)
AnnotationAssertion(mito:isMentionedBy goldbook:08070 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08070 "current"^^xsd:string)
Declaration(Class(goldbook:08071))
AnnotationAssertion(rdfs:label goldbook:08071 "cumulative sum control chart")
AnnotationAssertion(dcterms:description goldbook:08071 "Control chart where the cumulative sum of deviations of successive measured quantity values from a reference quantity value is plotted to detect shifts in the level of the measurand.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08071 "CUSUM chart")
AnnotationAssertion(rdfs:comment goldbook:08071 "The ordinate of each plotted point represents the algebraic sum of the previous ordinate and the most recent deviation from the reference, target, or control value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08071 "The best discrimination of changes in the level is achieved when the reference quantity value is equal to the overall mean value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08071 "The chart can be used for control, diagnostic, or predictive purposes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08071 "When used for process control, it can be interpreted graphically using a mask (for example, V-mask) superimposed on the graph. An out-of-control criterion is when the path of the cumulative sum intersects or touches the boundary of the mask."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08071 "More suited to spreadsheet analysis, the following quantities are calculated for N measured quantity values \\(x_{i} (i=1; …, N)\\) \\(S_{\\rm{hi}}(i) = {\\rm{max}}(0,S_{\\rm{hi}}(i - 1) + x_{i} - \\mu - k)\\); \\(S_{\\rm{hi}}(0) = 0\\) \\(S_{\\rm{lo}}(i) = \\rm{max}(0,S_{\\rm{lo}}(i - 1) - {x}_{i} + \\mu - k)\\); \\(S_{\\rm{lo}}(0) = 0\\). \\(\\mu\\) is a suitably chosen target value and \\(k\\) is a reference quantity value such that only shifts away from the target value greater than \\(k\\) will add to the cumulative sum. \\(k\\) is usually taken as half the shift in the process mean that is required to be detected divided by the standard deviation (\\(\\sigma\\)) obtained under repeatability conditions of measurement. An out-of-control criterion is when \\(S_{\\rm{hi}}(i)\\) or \\(S_{\\rm{lo}}(i)\\) becomes greater than a limiting value \\(h\\) (usually \\(h = 4\\sigma\\)). (Note that the reference quantity value \\(k\\) is not a coverage factor)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08071 "CUSUM charts are particularly sensitive to reveal a small measurement bias."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08071 goldbook:08068)
AnnotationAssertion(rdfs:seeAlso goldbook:08071 goldbook:08092)
AnnotationAssertion(rdfs:seeAlso goldbook:08071 goldbook:08040)
AnnotationAssertion(mito:isMentionedBy goldbook:08071 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08071 "current"^^xsd:string)
Declaration(Class(goldbook:08072))
AnnotationAssertion(rdfs:label goldbook:08072 "decision rule in conformity assessment")
AnnotationAssertion(dcterms:description goldbook:08072 "Documented rule that describes how measurement uncertainty will be accounted for with regard to accepting or rejecting an item, given a specified requirement and a measured quantity value.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08072 "decision rule")
AnnotationAssertion(rdfs:comment goldbook:08072 "Decision rules in conformity assessment give a prescription for the acceptance or rejection of an item based on the measured quantity value and the associated measurement uncertainty and limit(s) expressed or implied by specified requirements, taking into account the acceptable level of the probability of making a wrong decision. On the basis of the decision rules, an \"acceptance interval\" and \"rejection interval(s)\" are determined, such that if the measured quantity value lies in the acceptance interval, the item is declared as conforming and if in the rejection interval, it is declared as non-conforming."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08072 goldbook:08052)
AnnotationAssertion(rdfs:seeAlso goldbook:08072 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08072 goldbook:08076)
AnnotationAssertion(rdfs:seeAlso goldbook:08072 goldbook:08121)
AnnotationAssertion(rdfs:seeAlso goldbook:08072 goldbook:08122)
AnnotationAssertion(rdfs:seeAlso goldbook:08072 goldbook:08129)
AnnotationAssertion(mito:isMentionedBy goldbook:08072 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08072 "current"^^xsd:string)
Declaration(Class(goldbook:08073))
AnnotationAssertion(rdfs:label goldbook:08073 "fitness for purpose")
AnnotationAssertion(dcterms:description goldbook:08073 "Ability of a product, process, or service to serve a defined purpose under specific conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08073 "fitness for intended use")
AnnotationAssertion(mito:isMentionedBy goldbook:08073 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08073 "current"^^xsd:string)
Declaration(Class(goldbook:08074))
AnnotationAssertion(rdfs:label goldbook:08074 "good laboratory practice")
AnnotationAssertion(dcterms:description goldbook:08074 "Quality system concerned with the organizational process, and conditions under which non-clinical health and environmental safety studies are planned, performed, monitored, recorded, archived, and reported.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08074 "GLP")
AnnotationAssertion(rdfs:comment goldbook:08074 "GLP is generally associated with the guidelines laid down by the Organization for Economic Co-operation and Development (OECD). The use of the term GLP outside these guidelines is not recommended."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08074 "A GLP approval should not be confused with accreditation of a laboratory."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08074 goldbook:08054)
AnnotationAssertion(mito:isMentionedBy goldbook:08074 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08074 "current"^^xsd:string)
Declaration(Class(goldbook:08075))
AnnotationAssertion(rdfs:label goldbook:08075 "good manufacturing practice")
AnnotationAssertion(dcterms:description goldbook:08075 "Combination of manufacturing and quality procedures aimed at ensuring that products are consistently manufactured to their specified requirements and to avoid contamination of the product by internal or external sources.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08075 "GMP")
AnnotationAssertion(rdfs:seeAlso goldbook:08075 goldbook:08129)
AnnotationAssertion(mito:isMentionedBy goldbook:08075 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08075 "current"^^xsd:string)
Declaration(Class(goldbook:08076))
AnnotationAssertion(rdfs:label goldbook:08076 "guard band")
AnnotationAssertion(dcterms:description goldbook:08076 "Interval between a tolerance limit and a corresponding acceptance limit. Figure 1: Guarded acceptance. Two-sided acceptance interval created by reducing the tolerance interval on either side by a guard band, thus reducing the probability of falsely accepting a non-conforming item.Figure 2: Guarded rejection. Two-sided acceptance interval created by increasing the tolerance interval on either side by a guard band, thus reducing the probability of falsely rejecting a conforming item.")
AnnotationAssertion(rdfs:comment goldbook:08076 "A guard band is used to restrict or to extend an acceptance interval to reduce the probability of an unwanted decision on conformance due to the measurement uncertainty of the actual measurement. The width of a guard band is scaled with the measurement uncertainty. (See: decision rule in conformity assessment)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08076 "If the acceptance limits lie within the tolerance limits, the decision for conformity of the item is known as guarded acceptance. The probability of falsely accepting a non-conforming item is reduced. This is most often found in chemistry. See Fig. 1."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08076 "If the acceptance limits lie outside the tolerance limits, the decision for conformity of the item is known as guarded rejection. The probability of falsely rejecting a conforming item is reduced. See Fig. 2."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08076 goldbook:08052)
AnnotationAssertion(rdfs:seeAlso goldbook:08076 goldbook:08053)
AnnotationAssertion(rdfs:seeAlso goldbook:08076 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08076 goldbook:08072)
AnnotationAssertion(rdfs:seeAlso goldbook:08076 goldbook:08135)
AnnotationAssertion(rdfs:seeAlso goldbook:08076 goldbook:08136)
AnnotationAssertion(mito:isMentionedBy goldbook:08076 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08076 "current"^^xsd:string)
Declaration(Class(goldbook:08077))
AnnotationAssertion(rdfs:label goldbook:08077 "Horwitz equation")
AnnotationAssertion(dcterms:description goldbook:08077 "Empirical relationship providing a standard deviation under reproducibility conditions of measurement (\\(s_{\\rm{R,H}}\\)) to be expected for typical measurements of the mass fraction (\\(w\\)) of a component in a material: \\(s_{\\rm{R,H}} = 0.02 w^{0.8495}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08077 "Horwitz curve")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08077 "Horwitz horn curve")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08077 "Horwitz trumpet curve")
AnnotationAssertion(rdfs:comment goldbook:08077 "The shape of the curve is called a trumpet when the relative standard deviation is plotted against the logarithm of the mass fraction as shown in Fig. 1. The reference justifies the mirror curve for negative ordinate values by \"… the lines are best regarded as confidence boundaries.\""^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08077 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08077 "current"^^xsd:string)
Declaration(Class(goldbook:08078))
AnnotationAssertion(rdfs:label goldbook:08078 "Horwitz ratio")
AnnotationAssertion(dcterms:description goldbook:08078 "Standard deviation of a mass fraction of a component under reproducibility conditions of measurement divided by the corresponding standard deviation calculated from the Horwitz equation. Figure 1: Horwitz curve (trumpet, horn). Expected relative standard deviation under reproducibility conditions of measurement, \\(\\pm s_{\\rm{R,H}}/w\\) plotted against logarithm of mass fraction, \\(w\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08078 "HORRAT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08078 "Horrat")
AnnotationAssertion(rdfs:comment goldbook:08078 "The Horwitz ratio is used as a test of the fitness for purpose of methods of chemical analysis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08078 "The experimental measurement precision is better than to be expected from the Horwitz equation if the Horwitz ratio is less than 1 and poorer if greater than 1. In practice, ratios between 0.5 and 2.0 are acceptable."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08078 "In, the \"Horwitz ratio\" is defined as the ratio of the standard deviation under reproducibility conditions of measurement and standard deviation under repeatability conditions of measurement. This use is discouraged because of the possibility of confusion with the older usage."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08078 goldbook:08077)
AnnotationAssertion(rdfs:seeAlso goldbook:08078 goldbook:08004)
AnnotationAssertion(rdfs:seeAlso goldbook:08078 goldbook:08073)
AnnotationAssertion(rdfs:seeAlso goldbook:08078 goldbook:08040)
AnnotationAssertion(mito:isMentionedBy goldbook:08078 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08078 "current"^^xsd:string)
Declaration(Class(goldbook:08079))
AnnotationAssertion(rdfs:label goldbook:08079 "in-house reference material")
AnnotationAssertion(dcterms:description goldbook:08079 "Reference material produced and used by an analytical laboratory.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08079 "laboratory reference material")
AnnotationAssertion(rdfs:comment goldbook:08079 "The preparation, characterization, and use of in-house reference materials for quality control purposes are described in ISO Guide 80."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08079 "Various terms are used to distinguish among reference materials intended for different uses and with assigned values established applying different procedures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08079 goldbook:08057)
AnnotationAssertion(rdfs:seeAlso goldbook:08079 goldbook:08016)
AnnotationAssertion(rdfs:seeAlso goldbook:08079 goldbook:08038)
AnnotationAssertion(mito:isMentionedBy goldbook:08079 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08079 "current"^^xsd:string)
Declaration(Class(goldbook:08080))
AnnotationAssertion(rdfs:label goldbook:08080 "inspection")
AnnotationAssertion(dcterms:description goldbook:08080 "Examination of a product, process, service, or installation or their design and determination of conformity with specific requirements or on the basis of professional judgment, with general requirements.")
AnnotationAssertion(rdfs:comment goldbook:08080 "Inspection of processes can include personnel, facilities, technology, or methodology."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08080 "Inspection procedures or schemes can restrict inspection to examination only."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08080 "If the result of an inspection shows conformity, it can be used for purposes of verification."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08080 "The result of an inspection can show conformity or non-conformity or a degree of conformity, where conformity is defined as fulfilment of a requirement."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08080 goldbook:08018)
AnnotationAssertion(rdfs:seeAlso goldbook:08080 goldbook:08122)
AnnotationAssertion(rdfs:seeAlso goldbook:08080 goldbook:08139)
AnnotationAssertion(mito:isMentionedBy goldbook:08080 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08080 "current"^^xsd:string)
Declaration(Class(goldbook:08081))
AnnotationAssertion(rdfs:label goldbook:08081 "interlaboratory comparison")
AnnotationAssertion(dcterms:description goldbook:08081 "Organization, performance, and evaluation of measurements or tests on the same or similar items by two or more laboratories in accordance with predetermined conditions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08081 "ILC")
AnnotationAssertion(rdfs:comment goldbook:08081 "Interlaboratory comparison is a generic term, and the purpose and detailed objectives of an interlaboratory comparison must be specified. Some types of interlaboratory comparisons have special names, for example, proficiency testing scheme and key comparison."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08081 "Interlaboratory comparisons are organized at all metrological levels and have the following steps in common. a) A coordinator of an interlaboratory comparison plans the interlaboratory comparison; b) One or more items are sourced by the coordinator, assessed as appropriate, and distributed to the participants in an interlaboratory comparison with instructions; c) The participants conduct measurements, tests, examinations, or other work on the item(s) and report the results back to the coordinator; d) The coordinator evaluates the results and provides feedback to the participants; and e) The coordinator and/or the participants act on the results."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08081 "In some circumstances, one of the laboratories involved in an interlaboratory comparison may be the laboratory that provides the assigned value for the item. The assignment enables the determination of the metrological equivalence of measurement results of the participants but does not, by itself, establish metrological traceability."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08081 "The minimum number of laboratories participating in an interlaboratory comparison will depend on the metrological properties of the measurement procedures used, for example, measurement precision and analytical selectivity. See, performance characteristics of a measurement procedure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08081 "Determination of performance characteristics of a measurement procedure as part of procedure validation or characterization of a candidate reference material can be done by means of an interlaboratory comparison. (See method performance study and material characterization study.)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08081 "Key comparisons and supplementary comparisons are organized by the International Bureau of Weights and Measures (BIPM) in support of the International Committee for Weights and Measures (CIPM) Mutual Recognition Arrangement (MRA) in which National Metrology Institutes demonstrate the international equivalence of their measurement standards and the calibration certificates and measurement certificates they issue."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08081 "Accredited laboratories and laboratories seeking accreditation are expected to participate in interlaboratory comparisons, for example, proficiency testing schemes, where available and appropriate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08081 "The use of terms such as \"ring test\", \"round robin\", \"intercalibration\", \"intercomparison\", \"collaborative study\", etc. for interlaboratory comparisons is not recommended in formal documents."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08055)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08057)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08011)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08060)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08070)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08018)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08085)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08090)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08033)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08093)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08094)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08097)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08102)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08104)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08131)
AnnotationAssertion(rdfs:seeAlso goldbook:08081 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08081 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08081 "current"^^xsd:string)
Declaration(Class(goldbook:08082))
AnnotationAssertion(rdfs:label goldbook:08082 "internal quality control")
AnnotationAssertion(dcterms:description goldbook:08082 "Quality control within a specified laboratory.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08082 "IQC")
AnnotationAssertion(mito:isMentionedBy goldbook:08082 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08082 "current"^^xsd:string)
Declaration(Class(goldbook:08083))
AnnotationAssertion(rdfs:label goldbook:08083 "intralaboratory comparison")
AnnotationAssertion(dcterms:description goldbook:08083 "Organization, performance, and evaluation of measurements or tests on the same or similar items within the same laboratory in accordance with predetermined conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:08083 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08083 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08083 "current"^^xsd:string)
Declaration(Class(goldbook:08084))
AnnotationAssertion(rdfs:label goldbook:08084 "laboratory information management system")
AnnotationAssertion(dcterms:description goldbook:08084 "Information system which can provide services to one or more measuring systems.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08084 "laboratory information system")
AnnotationAssertion(rdfs:comment goldbook:08084 "Services include the control of automated analyses and collecting, processing, storing, and managing of data."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08084 "LIMS functionality can include sample registration and tracking (through barcodes, chips, etc.), electronic laboratory notebooks, report generation, quality control, and financial control."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08084 "In laboratory medicine, the term \"Laboratory Information System\" is common."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08084 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08084 "current"^^xsd:string)
Declaration(Class(goldbook:08085))
AnnotationAssertion(rdfs:label goldbook:08085 "material characterization study")
AnnotationAssertion(dcterms:description goldbook:08085 "Intralaboratory comparison or interlaboratory comparison with the aim of assigning a reference quantity value to a quantity with stated measurement uncertainty or value to a reference nominal property value with stated examination uncertainty.")
AnnotationAssertion(rdfs:comment goldbook:08085 "A material characterization study often utilizes selected (routine or reference) laboratories to measure quantity values of a candidate reference material by measurement procedure(s) judged most likely to provide the smallest associated measurement uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08085 "Although proficiency testing is not primarily intended as a material characterization study, reference materials are sometimes certified on the basis of results from a proficiency testing scheme after appropriate quality assurance procedures."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08085 goldbook:08083)
AnnotationAssertion(rdfs:seeAlso goldbook:08085 goldbook:08060)
AnnotationAssertion(rdfs:seeAlso goldbook:08085 goldbook:08081)
AnnotationAssertion(rdfs:seeAlso goldbook:08085 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08085 goldbook:08101)
AnnotationAssertion(rdfs:seeAlso goldbook:08085 goldbook:08104)
AnnotationAssertion(mito:isMentionedBy goldbook:08085 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08085 "current"^^xsd:string)
Declaration(Class(goldbook:08086))
AnnotationAssertion(rdfs:label goldbook:08086 "matrix reference material")
AnnotationAssertion(dcterms:description goldbook:08086 "Reference material that is characteristic of a real sample.")
AnnotationAssertion(rdfs:comment goldbook:08086 "Matrix reference materials may be obtained directly from biological, environmental, or industrial sources."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08086 "Matrix reference materials may also be prepared by a spike of the component(s) of interest into an existing material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08086 "A chemical substance dissolved in a pure solvent is not a matrix reference material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08086 "Matrix reference materials are intended to be used in conjunction with the chemical analysis of real samples of the same or a similar matrix."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08086 goldbook:08004)
AnnotationAssertion(rdfs:seeAlso goldbook:08086 goldbook:08122)
AnnotationAssertion(rdfs:seeAlso goldbook:08086 goldbook:08047)
AnnotationAssertion(mito:isMentionedBy goldbook:08086 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08086 "current"^^xsd:string)
Declaration(Class(goldbook:08087))
AnnotationAssertion(rdfs:label goldbook:08087 "measurement capability")
AnnotationAssertion(dcterms:description goldbook:08087 "Ability to measure a quantity in a specified interval of quantity values, embodied in a specified material, as demonstrated by measurement uncertainty.")
AnnotationAssertion(rdfs:comment goldbook:08087 "A comparison of the measurement uncertainty in the measurement result obtained by one laboratory to that of the measurement result obtained by another laboratory for the same quantity in the same material compares their respective measurement capabilities."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08087 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08087 "current"^^xsd:string)
Declaration(Class(goldbook:08088))
AnnotationAssertion(rdfs:label goldbook:08088 "measurement precision control material")
AnnotationAssertion(dcterms:description goldbook:08088 "Quality control material with or without reference quantity value used in quality control to assess measurement precision.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08088 "precision control material")
AnnotationAssertion(rdfs:seeAlso goldbook:08088 goldbook:08107)
AnnotationAssertion(mito:isMentionedBy goldbook:08088 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08088 "current"^^xsd:string)
Declaration(Class(goldbook:08089))
AnnotationAssertion(rdfs:label goldbook:08089 "measurement trueness control material")
AnnotationAssertion(dcterms:description goldbook:08089 "Quality control material with reference quantity value used in quality control to estimate a systematic measurement error.")
AnnotationAssertion(rdfs:seeAlso goldbook:08089 goldbook:08107)
AnnotationAssertion(mito:isMentionedBy goldbook:08089 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08089 "current"^^xsd:string)
Declaration(Class(goldbook:08090))
AnnotationAssertion(rdfs:label goldbook:08090 "method performance study")
AnnotationAssertion(dcterms:description goldbook:08090 "Intra- or interlaboratory study of one or more performance characteristics of a measurement procedure.")
AnnotationAssertion(rdfs:comment goldbook:08090 "The study is normally conducted in the frame of procedure validation or procedure verification."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08090 "Details regarding organizing and conducting the study, for example, type of samples and number of measurements, are specified in a validation plan or in a protocol for interlaboratory comparison."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08090 "The general term \"collaborative study\" should not be used for an interlaboratory method performance study."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08090 goldbook:08094)
AnnotationAssertion(rdfs:seeAlso goldbook:08090 goldbook:08097)
AnnotationAssertion(rdfs:seeAlso goldbook:08090 goldbook:08105)
AnnotationAssertion(rdfs:seeAlso goldbook:08090 goldbook:08138)
AnnotationAssertion(mito:isMentionedBy goldbook:08090 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08090 "current"^^xsd:string)
Declaration(Class(goldbook:08091))
AnnotationAssertion(rdfs:label goldbook:08091 "organization")
AnnotationAssertion(dcterms:description goldbook:08091 "Person or group of people that has its own functions with responsibilities, authorities, and relationships to achieve its objectives.")
AnnotationAssertion(rdfs:comment goldbook:08091 "The concept of \"organization\" includes, but is not limited to, sole-trader, company, corporation, firm, enterprise, authority, partnership, association, charity, or institution, or part or combination thereof, whether incorporated or not, public or private."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08091 "In formal documents, the term \"body\" is often used to denote an organization, for example, \"accreditation body\", \"certification body\", \"inspection body\", \"legislative body\", and \"regulatory body\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08091 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08091 "current"^^xsd:string)
Declaration(Class(goldbook:08092))
AnnotationAssertion(rdfs:label goldbook:08092 "out-of-control criteria")
AnnotationAssertion(dcterms:description goldbook:08092 "Set of decision rules for identifying the presence of special causes.")
AnnotationAssertion(rdfs:comment goldbook:08092 "Decision rules may include those relating to measured quantity values inside and outside of control limits in a control chart. They cover runs, trends, cycles, periodicity, concentration of points near the centre line or control limits, unusual spread of points within control limits (large or small dispersion), and relationships among values within subgroups."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08092 "Examples of decision rules and guidelines for the daily interpretation of a control chart are provided by Nordtest."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08092 goldbook:08068)
AnnotationAssertion(rdfs:seeAlso goldbook:08092 goldbook:08069)
AnnotationAssertion(mito:isMentionedBy goldbook:08092 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08092 "current"^^xsd:string)
Declaration(Class(goldbook:08093))
AnnotationAssertion(rdfs:label goldbook:08093 "participant in an interlaboratory comparison")
AnnotationAssertion(dcterms:description goldbook:08093 "Laboratory, organization, or person that receives test items and submits results for review by the coordinator of an interlaboratory comparison.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08093 "participant")
AnnotationAssertion(rdfs:seeAlso goldbook:08093 goldbook:08070)
AnnotationAssertion(rdfs:seeAlso goldbook:08093 goldbook:08091)
AnnotationAssertion(mito:isMentionedBy goldbook:08093 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08093 "current"^^xsd:string)
Declaration(Class(goldbook:08094))
AnnotationAssertion(rdfs:label goldbook:08094 "performance characteristic of a measurement procedure")
AnnotationAssertion(dcterms:description goldbook:08094 "Aspect of a measurement procedure that may be quantitatively investigated and assessed as part of procedure validation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08094 "performance characteristic")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08094 "performance characteristic of a measurement method")
AnnotationAssertion(rdfs:comment goldbook:08094 "Performance characteristics that may be considered in procedure validation are analytical selectivity, sensitivity of a measuring system, working interval, ruggedness of a measurement procedure, linearity of a measuring system, linearity of calibration, critical value, limit of detection, limit of quantification, measurement trueness, and measurement precision."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08094 "Measurement uncertainty is not a performance characteristic of a particular measurement procedure but a property of the measurement result obtained using that measurement procedure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08055)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08017)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08022)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08023)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08024)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08097)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08123)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08124)
AnnotationAssertion(rdfs:seeAlso goldbook:08094 goldbook:08051)
AnnotationAssertion(mito:isMentionedBy goldbook:08094 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08094 "current"^^xsd:string)
Declaration(Class(goldbook:08095))
AnnotationAssertion(rdfs:label goldbook:08095 "performance score")
AnnotationAssertion(dcterms:description goldbook:08095 "Statistic, derived from a result reported by a participant in a proficiency testing scheme, used in interpretation of participant performance and to allow comparison with defined objectives.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08095 "performance statistic")
AnnotationAssertion(rdfs:comment goldbook:08095 "The purpose of a performance score is to express the deviation of the reported value from the assigned value in a proficiency testing scheme in a manner that allows comparison with performance criteria."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08095 "Names and defining equations of frequently used performance scores are listed in Table 1. Their definitions and interpretations are given in ISO/IEC 17043 and ISO 13528."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08095 goldbook:08101)
AnnotationAssertion(rdfs:seeAlso goldbook:08095 goldbook:08104)
AnnotationAssertion(mito:isMentionedBy goldbook:08095 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08095 "current"^^xsd:string)
Declaration(Class(goldbook:08096))
AnnotationAssertion(rdfs:label goldbook:08096 "precision limit")
AnnotationAssertion(dcterms:description goldbook:08096 "Quantity value, less than or equal to what the absolute difference between two measured quantity values obtained under specified conditions of measurement is expected to be with a given probability.")
AnnotationAssertion(rdfs:comment goldbook:08096 "ISO 3534-2 defines three kinds of precision limit: repeatability limit (\\(r\\)), intermediate precision limit, and reproducibility limit (\\(R\\)) obtained under repeatability conditions of measurement, intermediate precision conditions of measurement, and reproducibility conditions of measurement, respectively. The recommended probability is \\(\\pu{95\\%}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08096 "Precision limit at approximately \\(\\pu{95\\%}\\) is estimated by multiplying the standard deviation obtained under the specified conditions of measurement by \\(2\\sqrt{2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08096 goldbook:08040)
AnnotationAssertion(mito:isMentionedBy goldbook:08096 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08096 "current"^^xsd:string)
Declaration(Class(goldbook:08097))
AnnotationAssertion(rdfs:label goldbook:08097 "procedure validation")
AnnotationAssertion(dcterms:description goldbook:08097 "Process of defining an analytical requirement and confirming that the procedure under consideration has capabilities consistent with that requirement.")
AnnotationAssertion(rdfs:comment goldbook:08097 "Inherent in procedure validation is the need to evaluate performance characteristics of a measurement procedure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08097 "The corresponding term in ISO 15189 is \"validation of examination procedures\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08097 "In ISO/IEC 17025, the term \"method\" is used as a synonym for measurement procedure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08097 "Procedure validation is either done in a single laboratory or in the framework of an interlaboratory comparison."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08097 goldbook:08061)
AnnotationAssertion(rdfs:seeAlso goldbook:08097 goldbook:08081)
AnnotationAssertion(rdfs:seeAlso goldbook:08097 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08097 goldbook:08094)
AnnotationAssertion(rdfs:seeAlso goldbook:08097 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08097 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08097 "current"^^xsd:string)
Declaration(Class(goldbook:08098))
AnnotationAssertion(rdfs:label goldbook:08098 "procedure verification")
AnnotationAssertion(dcterms:description goldbook:08098 "Confirmation, through the provision of objective evidence, that the procedure fulfils specified requirements.")
AnnotationAssertion(rdfs:comment goldbook:08098 "A laboratory that implements a procedure described in, for example, an international standard or in a manufacturer\"s documentation needs to verify that the procedure fulfils the specified requirements."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08098 "The corresponding term in ISO 15189 is \"verification of examination procedures\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08098 "In ISO/IEC 17025, the term \"method\" is used as a synonym for measurement procedure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08098 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08098 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08098 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08098 "current"^^xsd:string)
Declaration(Class(goldbook:08099))
AnnotationAssertion(rdfs:label goldbook:08099 "process in a state of statistical control")
AnnotationAssertion(dcterms:description goldbook:08099 "Process subject only to random causes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08099 "process in statistical control")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08099 "stable process")
AnnotationAssertion(rdfs:comment goldbook:08099 "The random variation is considered to follow a Gaussian distribution and is characterized by its variance (standard deviation)"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08099 "This state does not imply that the random variation is large or small, within or outside of specification, but rather that the variation is predictable using statistical techniques."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08099 "A control chart can be used to monitor a process and to determine whether the process is, or is not, in a state of statistical control. See out-of-control criteria and control limit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08099 goldbook:08068)
AnnotationAssertion(rdfs:seeAlso goldbook:08099 goldbook:08069)
AnnotationAssertion(rdfs:seeAlso goldbook:08099 goldbook:08092)
AnnotationAssertion(mito:isMentionedBy goldbook:08099 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08099 "current"^^xsd:string)
Declaration(Class(goldbook:08100))
AnnotationAssertion(rdfs:label goldbook:08100 "proficiency test item")
AnnotationAssertion(dcterms:description goldbook:08100 "Sample, product, artefact, reference material, piece of equipment, measurement standard, data set, or other information used for proficiency testing.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08100 "PT item")
AnnotationAssertion(rdfs:seeAlso goldbook:08100 goldbook:08101)
AnnotationAssertion(mito:isMentionedBy goldbook:08100 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08100 "current"^^xsd:string)
Declaration(Class(goldbook:08101))
AnnotationAssertion(rdfs:label goldbook:08101 "proficiency testing")
AnnotationAssertion(dcterms:description goldbook:08101 "Evaluation of the performance of a participant in an interlaboratory comparison against pre-established criteria.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08101 "PT")
AnnotationAssertion(rdfs:comment goldbook:08101 "Proficiency testing is achieved by the distribution of proficiency test items for unsupervised measurement or examination by the participants."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08101 "Participation in proficiency testing schemes is not a substitute for internal quality control measures or vice versa."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08101 "The evaluation of quantitative results of a participant in a proficiency testing scheme may be given as a \\(z\\) score, \\(z'\\) score, \\(\\zeta\\) score, or \\(E_{\\rm{n}}\\) score (see performance score)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08101 "The term \"proficiency testing\" includes, but is not limited to, a) quantitative scheme—where the objective is to quantify one or more measurands of the proficiency test item; b) qualitative scheme—where the objective is to identify or describe one or more characteristics of the proficiency test item; c) sequential scheme—where one or more proficiency test items are distributed sequentially for testing or measurement and results returned to the proficiency testing provider at intervals; d) simultaneous scheme—where proficiency test items are distributed for concurrent testing or measurement within a defined time period; e) single occasion exercise—where proficiency test items are provided on a single occasion; f) continuous scheme—where proficiency test items are provided at regular intervals; g) sampling—where samples are taken for subsequent chemical analysis; and h) data transformation and interpretation—where sets of data or other information are furnished
						and the information is processed to provide an interpretation (or other outcome)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08101 "Some proficiency testing providers in the laboratory medicine area use the term \"external quality assessment (EQA)\" for their proficiency testing schemes or for their broader programmes, or both."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08004)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08082)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08093)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08095)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08100)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08102)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08104)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08043)
AnnotationAssertion(rdfs:seeAlso goldbook:08101 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08101 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08101 "current"^^xsd:string)
Declaration(Class(goldbook:08102))
AnnotationAssertion(rdfs:label goldbook:08102 "proficiency testing provider")
AnnotationAssertion(dcterms:description goldbook:08102 "Organization which takes responsibility for all tasks in the development and operation of a proficiency testing scheme.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08102 "PT provider")
AnnotationAssertion(rdfs:seeAlso goldbook:08102 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08102 goldbook:08104)
AnnotationAssertion(mito:isMentionedBy goldbook:08102 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08102 "current"^^xsd:string)
Declaration(Class(goldbook:08103))
AnnotationAssertion(rdfs:label goldbook:08103 "proficiency testing round")
AnnotationAssertion(dcterms:description goldbook:08103 "Single complete sequence from distribution of proficiency test items to reporting of the evaluation results to the participants.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08103 "PT round")
AnnotationAssertion(rdfs:seeAlso goldbook:08103 goldbook:08093)
AnnotationAssertion(rdfs:seeAlso goldbook:08103 goldbook:08100)
AnnotationAssertion(mito:isMentionedBy goldbook:08103 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08103 "current"^^xsd:string)
Declaration(Class(goldbook:08104))
AnnotationAssertion(rdfs:label goldbook:08104 "proficiency testing scheme")
AnnotationAssertion(dcterms:description goldbook:08104 "Proficiency testing designed and operated in one or more proficiency testing rounds for a specified area of testing, measurement, calibration, or inspection.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08104 "PT scheme")
AnnotationAssertion(rdfs:comment goldbook:08104 "A proficiency testing scheme might cover a particular type or number of tests, measurements, calibrations or inspections on proficiency test items."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08104 "The use of terms such as \"ring test\", \"round robin\", \"intercalibration\", \"intercomparison\", \"collaborative study\", etc. for proficiency testing schemes is not recommended in formal documents."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08104 goldbook:08101)
AnnotationAssertion(rdfs:seeAlso goldbook:08104 goldbook:08080)
AnnotationAssertion(rdfs:seeAlso goldbook:08104 goldbook:08100)
AnnotationAssertion(rdfs:seeAlso goldbook:08104 goldbook:08103)
AnnotationAssertion(rdfs:seeAlso goldbook:08104 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08104 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08104 "current"^^xsd:string)
Declaration(Class(goldbook:08105))
AnnotationAssertion(rdfs:label goldbook:08105 "protocol for interlaboratory comparison")
AnnotationAssertion(dcterms:description goldbook:08105 "Detailed set of instructions describing the objectives, design, conduct, and reporting of an interlaboratory comparison.")
AnnotationAssertion(rdfs:seeAlso goldbook:08105 goldbook:08081)
AnnotationAssertion(mito:isMentionedBy goldbook:08105 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08105 "current"^^xsd:string)
Declaration(Class(goldbook:08106))
AnnotationAssertion(rdfs:label goldbook:08106 "quality")
AnnotationAssertion(dcterms:description goldbook:08106 "Degree to which a set of inherent characteristics of an object fulfils requirements.")
AnnotationAssertion(rdfs:comment goldbook:08106 "The term \"quality\" can be used with adjectives such as poor, good, or excellent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08106 "\"Inherent\", as opposed to \"assigned\", means existing in the object."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08106 "Measurement uncertainty provides a quantitative measure of the quality of a measurement result."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08106 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08106 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08106 "current"^^xsd:string)
Declaration(Class(goldbook:08107))
AnnotationAssertion(rdfs:label goldbook:08107 "quality control material")
AnnotationAssertion(dcterms:description goldbook:08107 "Material used for the purposes of quality control and subjected to the same or part of the same measurement procedure as that used for analytical samples.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08107 "control material")
AnnotationAssertion(rdfs:comment goldbook:08107 "Blank materials, analytical samples, reference materials, and certified reference materials can be used as quality control materials."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08107 goldbook:08010)
AnnotationAssertion(rdfs:seeAlso goldbook:08107 goldbook:08028)
AnnotationAssertion(mito:isMentionedBy goldbook:08107 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08107 "current"^^xsd:string)
Declaration(Class(goldbook:08108))
AnnotationAssertion(rdfs:label goldbook:08108 "quality improvement")
AnnotationAssertion(dcterms:description goldbook:08108 "Part of quality management focused on increasing the ability to fulfil requirements for quality.")
AnnotationAssertion(rdfs:comment goldbook:08108 "The requirements can be related to any aspect such as effectiveness, efficiency, or object traceability."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08108 goldbook:08037)
AnnotationAssertion(rdfs:seeAlso goldbook:08108 goldbook:08106)
AnnotationAssertion(rdfs:seeAlso goldbook:08108 goldbook:08109)
AnnotationAssertion(rdfs:seeAlso goldbook:08108 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08108 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08108 "current"^^xsd:string)
Declaration(Class(goldbook:08109))
AnnotationAssertion(rdfs:label goldbook:08109 "quality management")
AnnotationAssertion(dcterms:description goldbook:08109 "Coordinated activities to direct and control an organization with regard to quality.")
AnnotationAssertion(rdfs:comment goldbook:08109 "Quality management can include establishing quality policies and quality objectives."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08109 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08109 goldbook:08106)
AnnotationAssertion(rdfs:seeAlso goldbook:08109 goldbook:08112)
AnnotationAssertion(rdfs:seeAlso goldbook:08109 goldbook:08115)
AnnotationAssertion(mito:isMentionedBy goldbook:08109 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08109 "current"^^xsd:string)
Declaration(Class(goldbook:08110))
AnnotationAssertion(rdfs:label goldbook:08110 "quality management system")
AnnotationAssertion(dcterms:description goldbook:08110 "Part of a set of interrelated or interacting elements of an organization to establish quality policies and quality objectives and processes to achieve those objectives.")
AnnotationAssertion(rdfs:comment goldbook:08110 "A laboratory's structure, roles and responsibilities, planning, operation, practices, rules, and beliefs are also established within the quality management system."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08110 "Other common parts of a laboratory's management system are financial management and environmental management. These management systems should not be confused with a laboratory information management system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08110 goldbook:08084)
AnnotationAssertion(rdfs:seeAlso goldbook:08110 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08110 goldbook:08112)
AnnotationAssertion(rdfs:seeAlso goldbook:08110 goldbook:08115)
AnnotationAssertion(mito:isMentionedBy goldbook:08110 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08110 "current"^^xsd:string)
Declaration(Class(goldbook:08111))
AnnotationAssertion(rdfs:label goldbook:08111 "quality manual")
AnnotationAssertion(dcterms:description goldbook:08111 "Specification for the quality management system of an organization.")
AnnotationAssertion(rdfs:comment goldbook:08111 "Quality manuals can vary in detail and format to suit the size and complexity of an individual organization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08111 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08111 goldbook:08110)
AnnotationAssertion(mito:isMentionedBy goldbook:08111 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08111 "current"^^xsd:string)
Declaration(Class(goldbook:08112))
AnnotationAssertion(rdfs:label goldbook:08112 "quality objective")
AnnotationAssertion(dcterms:description goldbook:08112 "Result to be achieved related to quality.")
AnnotationAssertion(rdfs:comment goldbook:08112 "Quality objectives are generally based on the quality policy of the organization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08112 "Quality objectives are generally specified for relevant functions, levels and processes in the organization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08112 "In the context of quality management systems, quality objectives are set by the laboratory, consistent with the quality policy, to achieve specific results."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08112 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08112 goldbook:08106)
AnnotationAssertion(rdfs:seeAlso goldbook:08112 goldbook:08115)
AnnotationAssertion(mito:isMentionedBy goldbook:08112 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08112 "current"^^xsd:string)
Declaration(Class(goldbook:08113))
AnnotationAssertion(rdfs:label goldbook:08113 "quality plan")
AnnotationAssertion(dcterms:description goldbook:08113 "Specification of the procedures and associated resources to be applied when and by whom to a specific object.")
AnnotationAssertion(rdfs:comment goldbook:08113 "These procedures generally include those referring to quality management processes and to product and service realization processes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08113 "A quality plan often refers to parts of the quality manual or to procedure documents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08113 "A quality plan is generally one of the results of quality planning."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08113 goldbook:08109)
AnnotationAssertion(rdfs:seeAlso goldbook:08113 goldbook:08111)
AnnotationAssertion(rdfs:seeAlso goldbook:08113 goldbook:08114)
AnnotationAssertion(mito:isMentionedBy goldbook:08113 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08113 "current"^^xsd:string)
Declaration(Class(goldbook:08114))
AnnotationAssertion(rdfs:label goldbook:08114 "quality planning")
AnnotationAssertion(dcterms:description goldbook:08114 "Part of quality management focused on setting quality objectives and specifying necessary operational processes and related resources to achieve the quality objectives.")
AnnotationAssertion(rdfs:comment goldbook:08114 "Establishing quality plans can be part of quality planning."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08114 goldbook:08109)
AnnotationAssertion(rdfs:seeAlso goldbook:08114 goldbook:08112)
AnnotationAssertion(rdfs:seeAlso goldbook:08114 goldbook:08113)
AnnotationAssertion(mito:isMentionedBy goldbook:08114 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08114 "current"^^xsd:string)
Declaration(Class(goldbook:08115))
AnnotationAssertion(rdfs:label goldbook:08115 "quality policy")
AnnotationAssertion(dcterms:description goldbook:08115 "Intentions and direction of a laboratory as formally expressed by its top management related to quality.")
AnnotationAssertion(rdfs:comment goldbook:08115 "Generally, the quality policy is consistent with the overall policy of the laboratory, can be aligned with the laboratory's vision and mission, and provides a framework for the setting of quality objectives."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08115 goldbook:08106)
AnnotationAssertion(rdfs:seeAlso goldbook:08115 goldbook:08112)
AnnotationAssertion(mito:isMentionedBy goldbook:08115 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08115 "current"^^xsd:string)
Declaration(Class(goldbook:08116))
AnnotationAssertion(rdfs:label goldbook:08116 "reference laboratory")
AnnotationAssertion(dcterms:description goldbook:08116 "Laboratory that applies a reference measurement procedure, a reference examination procedure, or performs a calibration.")
AnnotationAssertion(rdfs:comment goldbook:08116 "The term \"reference laboratory\" may have other connotations in a national context."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08116 "In laboratory medicine, a reference measurement laboratory is defined in ISO 15195."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08116 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08116 "current"^^xsd:string)
Declaration(Class(goldbook:08117))
AnnotationAssertion(rdfs:label goldbook:08117 "reference material certificate")
AnnotationAssertion(dcterms:description goldbook:08117 "Document, issued by a reference material producer, containing the essential information for the use of a certified reference material and confirming that the necessary procedures have been carried out to ensure the validity and traceability of the stated property values.")
AnnotationAssertion(rdfs:comment goldbook:08117 "A reference material certificate is usually valid for a stated period of time (\"period of validity\" or as described by its \"expiry date\"), which defines the shelf life of the certified reference material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08117 "Documents containing the information described above may not, for legal or other (non-technical) reasons, be termed \"certificate\" (compare Note 1 to certified reference material)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08117 "ISO Guide 31 is the guidance document to the required and recommended content of a reference material certificate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08117 "In this definition, \"traceability\" covers both metrological traceability of a measurement result and examination traceability, but not object traceability."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08117 goldbook:08037)
AnnotationAssertion(rdfs:seeAlso goldbook:08117 goldbook:08120)
AnnotationAssertion(rdfs:seeAlso goldbook:08117 goldbook:08046)
AnnotationAssertion(mito:isMentionedBy goldbook:08117 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08117 "current"^^xsd:string)
Declaration(Class(goldbook:08118))
AnnotationAssertion(rdfs:label goldbook:08118 "reference material certification")
AnnotationAssertion(dcterms:description goldbook:08118 "Process that formally establishes the certified property value(s) of a candidate certified reference material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08118 "certification of a reference material")
AnnotationAssertion(rdfs:comment goldbook:08118 "The process is the responsibility of the reference material producer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08118 "Properties of a material include qualitative properties such as identities of chemical substances and quantitative properties such as mass concentration."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08118 "The outcome of the process is a reference material certificate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08118 "Reference material certification is a \"first-party attestation\" in accordance with the definition of the term \"declaration\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08118 goldbook:08059)
AnnotationAssertion(rdfs:seeAlso goldbook:08118 goldbook:08013)
AnnotationAssertion(rdfs:seeAlso goldbook:08118 goldbook:08117)
AnnotationAssertion(rdfs:seeAlso goldbook:08118 goldbook:08120)
AnnotationAssertion(mito:isMentionedBy goldbook:08118 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08118 "current"^^xsd:string)
Declaration(Class(goldbook:08119))
AnnotationAssertion(rdfs:label goldbook:08119 "reference material certification report")
AnnotationAssertion(dcterms:description goldbook:08119 "Document giving detailed information, in addition to that contained in a reference material certificate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08119 "certification report")
AnnotationAssertion(rdfs:comment goldbook:08119 "The information may refer to, for example, the preparation of the reference material, measurement procedures, factors affecting measurement accuracy, statistical treatment of measurement results, and the way in which metrological traceability was established."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08119 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08119 goldbook:08117)
AnnotationAssertion(mito:isMentionedBy goldbook:08119 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08119 "current"^^xsd:string)
Declaration(Class(goldbook:08120))
AnnotationAssertion(rdfs:label goldbook:08120 "reference material producer")
AnnotationAssertion(dcterms:description goldbook:08120 "Technically competent body that produces a reference material compliant with the appropriate guidance documents and issues the reference material documentation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08120 "RM producer")
AnnotationAssertion(rdfs:comment goldbook:08120 "\"Body\" refers to an organization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08120 "The relevant guidance documents are the ISO Guides 31 and 35."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08120 "ISO 17034 provides the general requirements for the competence of reference material producers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08120 goldbook:08065)
AnnotationAssertion(rdfs:seeAlso goldbook:08120 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08120 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08120 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08120 "current"^^xsd:string)
Declaration(Class(goldbook:08121))
AnnotationAssertion(rdfs:label goldbook:08121 "rejection interval")
AnnotationAssertion(dcterms:description goldbook:08121 "Interval of non-permissible measured quantity values.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08121 "rejection zone")
AnnotationAssertion(rdfs:comment goldbook:08121 "Non-permissible measured quantity values are associated with items that do not conform to specified requirements and lie outside the acceptance interval."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08121 goldbook:08052)
AnnotationAssertion(rdfs:seeAlso goldbook:08121 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08121 goldbook:08129)
AnnotationAssertion(mito:isMentionedBy goldbook:08121 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08121 "current"^^xsd:string)
Declaration(Class(goldbook:08122))
AnnotationAssertion(rdfs:label goldbook:08122 "requirement")
AnnotationAssertion(dcterms:description goldbook:08122 "Need or expectation that is stated, generally implied or obligatory.")
AnnotationAssertion(rdfs:comment goldbook:08122 "\"Generally implied\" means that it is custom or common practice for the organization and interested parties that the need or expectation under consideration is implied."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08122 "A specified requirement is one that is stated, for example, in documented information."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08122 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08122 goldbook:08129)
AnnotationAssertion(mito:isMentionedBy goldbook:08122 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08122 "current"^^xsd:string)
Declaration(Class(goldbook:08123))
AnnotationAssertion(rdfs:label goldbook:08123 "ruggedness of a measurement procedure")
AnnotationAssertion(dcterms:description goldbook:08123 "Ability of a measurement procedure to maintain acceptable performance under minor changes in operating conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08123 "robustness of a measurement procedure")
AnnotationAssertion(rdfs:comment goldbook:08123 "Ruggedness is normally investigated as a part of procedure development and may be part of procedure validation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08123 "The outcome of a ruggedness test provides objective evidence of the applicability of the measurement procedure during normal usage."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08123 "A measurement procedure, the performance of which remains unaffected by minor changes in operating conditions, is usually said to be \"rugged\" or \"robust\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08123 goldbook:08028)
AnnotationAssertion(rdfs:seeAlso goldbook:08123 goldbook:08097)
AnnotationAssertion(rdfs:seeAlso goldbook:08123 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08123 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08123 "current"^^xsd:string)
Declaration(Class(goldbook:08124))
AnnotationAssertion(rdfs:label goldbook:08124 "sensitivity of a measuring system")
AnnotationAssertion(dcterms:description goldbook:08124 "Quotient of the change in an indication of a measuring system and the corresponding change in a quantity being measured.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08124 "analytical sensitivity")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08124 "sensitivity")
AnnotationAssertion(rdfs:comment goldbook:08124 "Sensitivity of a measuring system can depend on the value of the quantity being measured."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08124 "The change considered in a value of a quantity being measured must be large compared with the resolution."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08124 "Sensitivity of a measuring system can be obtained from the slope of the calibration curve."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08124 "Sensitivity of a measuring system should not be confused with diagnostic sensitivity in laboratory medicine."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08124 "Sensitivity of a measuring system should not be confused with limit of detection or limit of quantification."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08124 goldbook:08022)
AnnotationAssertion(mito:isMentionedBy goldbook:08124 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08124 "current"^^xsd:string)
Declaration(Class(goldbook:08125))
AnnotationAssertion(rdfs:label goldbook:08125 "Shewhart control chart")
AnnotationAssertion(dcterms:description goldbook:08125 "Control chart with Shewhart control limits intended primarily to distinguish between the variation in the plotted measure due to random causes and that due to special causes.")
AnnotationAssertion(rdfs:seeAlso goldbook:08125 goldbook:08068)
AnnotationAssertion(rdfs:seeAlso goldbook:08125 goldbook:08126)
AnnotationAssertion(mito:isMentionedBy goldbook:08125 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08125 "current"^^xsd:string)
Declaration(Class(goldbook:08126))
AnnotationAssertion(rdfs:label goldbook:08126 "Shewhart control limit")
AnnotationAssertion(dcterms:description goldbook:08126 "Control limit determined statistically from the variation of the process due to random causes alone.")
AnnotationAssertion(rdfs:seeAlso goldbook:08126 goldbook:08069)
AnnotationAssertion(mito:isMentionedBy goldbook:08126 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08126 "current"^^xsd:string)
Declaration(Class(goldbook:08127))
AnnotationAssertion(rdfs:label goldbook:08127 "Shewhart means chart")
AnnotationAssertion(dcterms:description goldbook:08127 "Shewhart control chart in which the means of measured quantity values are plotted against time. Figure 1: Shewhart means chart of the means of duplicate analyses of a quality control material, twice per day (d) over 20 days. Each point is the mean of the day’s four results (\\(n = 4\\)). Upper and lower warning limits (UWL and LWL) are at \\(\\bar{x} \\pm 2s/\\sqrt{n}\\), where \\(\\bar{x}\\) is the process mean, \\(s\\) is the standard deviation under repeatability conditions of measurement, and upper and lower action limits (UAL and LAL) are at \\(\\bar{x} \\pm 3s/\\sqrt{n}\\). A simulated measurement bias of one standard deviation is applied after day 10.")
AnnotationAssertion(rdfs:comment goldbook:08127 "Nordtest terms a control chart with measured quantity values scaled by the mean or target value an \"X-chart\". ISO uses the term \"X-control chart\" for a control chart which plots single values."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08127 goldbook:08125)
AnnotationAssertion(rdfs:seeAlso goldbook:08127 goldbook:08107)
AnnotationAssertion(rdfs:seeAlso goldbook:08127 goldbook:08040)
AnnotationAssertion(mito:isMentionedBy goldbook:08127 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08127 "current"^^xsd:string)
Declaration(Class(goldbook:08128))
AnnotationAssertion(rdfs:label goldbook:08128 "Shewhart range chart")
AnnotationAssertion(dcterms:description goldbook:08128 "Shewhart control chart in which the ranges of measured quantity values are plotted against time.")
AnnotationAssertion(rdfs:comment goldbook:08128 "The range is the greatest measured quantity value minus the least measured quantity value."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08128 "Warning and action limits are given in tables (for example) as a function of the number of measured quantity values (\\(n\\)) taken to obtain the range and of the expected average range."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08128 "Nordtest advises that for Shewhart range charts, the best samples to be used are test samples selected from among the samples to be analysed in that analytical run."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08128 goldbook:08125)
AnnotationAssertion(rdfs:seeAlso goldbook:08128 goldbook:08006)
AnnotationAssertion(mito:isMentionedBy goldbook:08128 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08128 "current"^^xsd:string)
Declaration(Class(goldbook:08129))
AnnotationAssertion(rdfs:label goldbook:08129 "specified requirement")
AnnotationAssertion(dcterms:description goldbook:08129 "Need or expectation that is stated.")
AnnotationAssertion(rdfs:seeAlso goldbook:08129 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08129 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08129 "current"^^xsd:string)
Declaration(Class(goldbook:08130))
AnnotationAssertion(rdfs:label goldbook:08130 "standard deviation for proficiency assessment")
AnnotationAssertion(dcterms:description goldbook:08130 "Measure of dispersion used in the evaluation of results of proficiency testing.")
AnnotationAssertion(rdfs:comment goldbook:08130 "Not all proficiency testing schemes evaluate proficiency based on the dispersion of results."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08130 goldbook:08101)
AnnotationAssertion(rdfs:seeAlso goldbook:08130 goldbook:08104)
AnnotationAssertion(mito:isMentionedBy goldbook:08130 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08130 "current"^^xsd:string)
Declaration(Class(goldbook:08131))
AnnotationAssertion(rdfs:label goldbook:08131 "standard operating procedure")
AnnotationAssertion(dcterms:description goldbook:08131 "Authorized, documented procedure or set of procedures with detailed instructions for specified activities.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08131 "recommended operating procedure")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08131 "standard method")
AnnotationAssertion(rdfs:comment goldbook:08131 "Laboratory activities for which standard operating procedures are issued include sampling, measurement, testing, and examination."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08131 goldbook:08043)
AnnotationAssertion(rdfs:seeAlso goldbook:08131 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08131 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08131 "current"^^xsd:string)
Declaration(Class(goldbook:08132))
AnnotationAssertion(rdfs:label goldbook:08132 "statistical process control")
AnnotationAssertion(dcterms:description goldbook:08132 "Activities focused on the use of statistical techniques to reduce variation, increase knowledge about the process, and steer the process in the desired way.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08132 "SPC")
AnnotationAssertion(rdfs:comment goldbook:08132 "Although statistical process control originally was concerned primarily with manufactured goods, it is also equally applicable to processes producing services, for example, a measurement procedure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08132 goldbook:08028)
AnnotationAssertion(mito:isMentionedBy goldbook:08132 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08132 "current"^^xsd:string)
Declaration(Class(goldbook:08133))
AnnotationAssertion(rdfs:label goldbook:08133 "target measurement uncertainty")
AnnotationAssertion(dcterms:description goldbook:08133 "Measurement uncertainty specified as an upper limit and decided on the basis of the intended use of measurement results.")
AnnotationAssertion(rdfs:comment goldbook:08133 "Setting and using target uncertainty is described in."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08133 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08133 "current"^^xsd:string)
Declaration(Class(goldbook:08134))
AnnotationAssertion(rdfs:label goldbook:08134 "tolerance")
AnnotationAssertion(dcterms:description goldbook:08134 "Difference between upper and lower tolerance limits.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08134 "specified tolerance")
AnnotationAssertion(rdfs:comment goldbook:08134 "Tolerance should not be confused with measurement uncertainty."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08134 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08134 goldbook:08136)
AnnotationAssertion(mito:isMentionedBy goldbook:08134 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08134 "current"^^xsd:string)
Declaration(Class(goldbook:08135))
AnnotationAssertion(rdfs:label goldbook:08135 "tolerance interval")
AnnotationAssertion(dcterms:description goldbook:08135 "Interval of permissible quantity values.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08135 "specification zone")
AnnotationAssertion(rdfs:comment goldbook:08135 "Unless otherwise stated in a specified requirement, the tolerance limits belong to the tolerance interval."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08135 "The term \"tolerance interval\" as used in conformity assessment has a different meaning from the same term as it is used in statistics."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08135 "A permissible quantity value of a specified quantity is required of an item fulfilling a specified requirement."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08135 "Permissible quantity values must not be confused with permissible measured quantity value of an acceptance interval."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08135 goldbook:08052)
AnnotationAssertion(rdfs:seeAlso goldbook:08135 goldbook:08067)
AnnotationAssertion(rdfs:seeAlso goldbook:08135 goldbook:08129)
AnnotationAssertion(rdfs:seeAlso goldbook:08135 goldbook:08136)
AnnotationAssertion(mito:isMentionedBy goldbook:08135 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08135 "current"^^xsd:string)
Declaration(Class(goldbook:08136))
AnnotationAssertion(rdfs:label goldbook:08136 "tolerance limit")
AnnotationAssertion(dcterms:description goldbook:08136 "Specified upper or lower bound of permissible quantity values of a property.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08136 "specification limit")
AnnotationAssertion(rdfs:seeAlso goldbook:08136 goldbook:08067)
AnnotationAssertion(mito:isMentionedBy goldbook:08136 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08136 "current"^^xsd:string)
Declaration(Class(goldbook:08137))
AnnotationAssertion(rdfs:label goldbook:08137 "total quality management")
AnnotationAssertion(dcterms:description goldbook:08137 "Organization-wide efforts to install a permanent climate in which an organization continuously improves its ability to deliver high-quality products and services to customers.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08137 "TQM")
AnnotationAssertion(rdfs:seeAlso goldbook:08137 goldbook:08091)
AnnotationAssertion(rdfs:seeAlso goldbook:08137 goldbook:08106)
AnnotationAssertion(mito:isMentionedBy goldbook:08137 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08137 "current"^^xsd:string)
Declaration(Class(goldbook:08138))
AnnotationAssertion(rdfs:label goldbook:08138 "validation")
AnnotationAssertion(dcterms:description goldbook:08138 "Confirmation, through the provision of objective evidence, that the requirements for a specific intended use or application have been fulfilled.")
AnnotationAssertion(rdfs:comment goldbook:08138 "The objective evidence needed for a validation is the result of a test or other form of determination such as performing alternative calculations or reviewing documents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08138 "The term \"validated\" is used to designate the corresponding status."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08138 "The use conditions for validation can be real or simulated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08138 "In the VIM, \"validation\" is defined as \"verification, where the specified requirements are adequate for an intended use\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08138 goldbook:08018)
AnnotationAssertion(rdfs:seeAlso goldbook:08138 goldbook:08097)
AnnotationAssertion(rdfs:seeAlso goldbook:08138 goldbook:08122)
AnnotationAssertion(rdfs:seeAlso goldbook:08138 goldbook:08049)
AnnotationAssertion(mito:isMentionedBy goldbook:08138 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08138 "current"^^xsd:string)
Declaration(Class(goldbook:08139))
AnnotationAssertion(rdfs:label goldbook:08139 "verification")
AnnotationAssertion(dcterms:description goldbook:08139 "Confirmation, through the provision of objective evidence, that specified requirements have been fulfilled.")
AnnotationAssertion(rdfs:comment goldbook:08139 "The objective evidence needed for verification can be the result of an inspection or of other forms of determination such as performing alternative calculations or reviewing documents."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08139 "The activities carried out for verification are sometimes termed \"qualification process\"."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08139 "The term \"verified\" is used to designate the corresponding status."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08139 "In the VIM, \"verification\" is defined as \"provision of objective evidence that a given item fulfils specified requirements\"."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08139 goldbook:08018)
AnnotationAssertion(rdfs:seeAlso goldbook:08139 goldbook:08080)
AnnotationAssertion(rdfs:seeAlso goldbook:08139 goldbook:08122)
AnnotationAssertion(mito:isMentionedBy goldbook:08139 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08139 "current"^^xsd:string)
Declaration(Class(goldbook:08140))
AnnotationAssertion(rdfs:label goldbook:08140 "Youden plot")
AnnotationAssertion(dcterms:description goldbook:08140 "Graphical technique for evaluating an interlaboratory comparison when each participant has made two measurements on the same sample or one measurement on each of two different samples.Figure 1: Youden plot of the \\(z\\) scores of samples #9 and #10 of Round 5 of U39 of the proficiency testing program held by the RCPA Australia for the analysis of creatinine in urine by 218 laboratories. (Reproduced with permission).")
AnnotationAssertion(rdfs:comment goldbook:08140 "The coordinates of each point may be the measured quantity values themselves or any transformation thereof such as a performance score, for example, a \\(z\\) score (see Fig. 1)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08140 "The Youden plot is a simple but effective method for comparing both within-laboratory variability and between-laboratory variability."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08140 goldbook:08081)
AnnotationAssertion(rdfs:seeAlso goldbook:08140 goldbook:08095)
AnnotationAssertion(rdfs:seeAlso goldbook:08140 goldbook:08101)
AnnotationAssertion(mito:isMentionedBy goldbook:08140 doi:10.1515/pac-2019-0819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08140 "current"^^xsd:string)
Declaration(Class(goldbook:08141))
AnnotationAssertion(rdfs:label goldbook:08141 "activated state")
AnnotationAssertion(dcterms:description goldbook:08141 "In theories of unimolecular reactions an energized chemical species, often characterized by the superscript \\(^{\\ddagger}\\), where the excitation is specific and the molecule is poised for reaction.")
AnnotationAssertion(rdfs:comment goldbook:08141 "Often used as a synonym for activated complex or transition state, but not restricted to transition-state theory."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08141 "This is distinct from an energized molecule, often characterized by the superscript \\(^{\\ast}\\), in which excitation energy is dispersed among internal degrees of freedom."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08141 "This is not a complex according to the definition in this Glossary."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08141 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08141 "current"^^xsd:string)
Declaration(Class(goldbook:08142))
AnnotationAssertion(rdfs:label goldbook:08142 "ambiphilic")
AnnotationAssertion(dcterms:description goldbook:08142 "Both nucleophilic and electrophilic.")
AnnotationAssertion(rdfs:comment goldbook:08142 "The distinction between ambi (Latin: both) and amphi (Greek: both) and the application to hydrophilic and lipophilic or to nucleophilic and electrophilic is arbitrary."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08142 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08142 "current"^^xsd:string)
Declaration(Class(goldbook:08143))
AnnotationAssertion(rdfs:label goldbook:08143 "α")
AnnotationAssertion(dcterms:description goldbook:08143 "1) Designation applied to the carbon to which a functional group is attached. 2) In carbohydrate nomenclature, a stereochemical designation of the configuration at the anomeric carbon. 3) Parameter in a Brønsted relation expressing the sensitivity of the rate of protonation to acidity. 4) Parameter in Leffler’s relation expressing the sensitivity of changes in Gibbs activation energy to changes in overall Gibbs energy for an elementary reaction.")
AnnotationAssertion(rdfs:seeAlso goldbook:08143 goldbook:08183)
AnnotationAssertion(mito:isMentionedBy goldbook:08143 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08143 "current"^^xsd:string)
Declaration(Class(goldbook:08144))
AnnotationAssertion(rdfs:label goldbook:08144 "bidentate")
AnnotationAssertion(dcterms:description goldbook:08144 "Feature of a ligand with two potential binding sites.")
AnnotationAssertion(mito:isMentionedBy goldbook:08144 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08144 "current"^^xsd:string)
Declaration(Class(goldbook:08145))
AnnotationAssertion(rdfs:label goldbook:08145 "bifurcation")
AnnotationAssertion(dcterms:description goldbook:08145 "Feature on a potential-energy surface whereby a minimum-energy reaction path (MERP) emanating from a saddle point (corresponding to a transition structure) splits in two and leads to alternative products without intervening minima or secondary barriers to overcome. A bifurcation arises when the curvature of the surface in a direction perpendicular to the MERP becomes zero and then negative; it implies the existence of a lower-energy transition structure with a transition vector orthogonal to the original MERP.")
AnnotationAssertion(mito:isMentionedBy goldbook:08145 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08145 "current"^^xsd:string)
Declaration(Class(goldbook:08146))
AnnotationAssertion(rdfs:label goldbook:08146 "bond-dissociation enthalpy")
AnnotationAssertion(dcterms:description goldbook:08146 "Standard molar enthalpy required to break a given bond of some specific molecular entity by homolysis.")
AnnotationAssertion(rdfs:comment goldbook:08146 "Although \\({\\rm{D}}H^{\\circ}\\) is commonly used, \\(\\Delta_{\\rm{diss}} H^{\\circ}\\) is more consistent with the notation for other thermodynamic quantities."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08146 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08146 "current"^^xsd:string)
Declaration(Class(goldbook:08147))
AnnotationAssertion(rdfs:label goldbook:08147 "bond enthalpy")
AnnotationAssertion(dcterms:description goldbook:08147 "Average value of the gas-phase bond-dissociation enthalpies (usually at a temperature of \\(\\pu{298 K}\\)) for all bonds of the same type within the same chemical species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08147 "mean bond energy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08147 "mean bond enthalpy")
AnnotationAssertion(rdfs:comment goldbook:08147 "More commonly, tabulated mean bond energies (which are really enthalpies) are values of bond enthalpies averaged over a number of selected chemical species containing that type of bond, such as \\(\\pu{414 kJ mol-1}\\) for \\(\\ce{C-H}\\) bonds in a group of \\(\\ce{R3CH}\\) (\\(\\ce{R = H}\\), alkyl)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08147 goldbook:08146)
AnnotationAssertion(mito:isMentionedBy goldbook:08147 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08147 "current"^^xsd:string)
Declaration(Class(goldbook:08148))
AnnotationAssertion(rdfs:label goldbook:08148 "bond-stretch isomers")
AnnotationAssertion(dcterms:description goldbook:08148 "Two (or more) molecules with the same spin multiplicity but with different lengths for one or more bonds.")
AnnotationAssertion(rdfs:comment goldbook:08148 "This feature arises because the potential-energy surface, which describes how the energy of the molecule depends on geometry, shows two (or more) minima that are not merely symmetry-related."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08148 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08148 "current"^^xsd:string)
Declaration(Class(goldbook:08149))
AnnotationAssertion(rdfs:label goldbook:08149 "<i>β</i>, <i>β</i><sub>nuc</sub>, <i>β</i><sub>lg</sub>")
AnnotationAssertion(dcterms:description goldbook:08149 "Parameter in a Brønsted relation expressing the sensitivity of the rate of deprotonation to basicity.")
AnnotationAssertion(rdfs:comment goldbook:08149 "\\(\\beta_{\\rm{nuc}}\\) and \\(\\beta_{\\lg}\\) are used to correlate nucleophilic reactivity and leaving-group ability, respectively."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08149 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08149 "current"^^xsd:string)
Declaration(Class(goldbook:08150))
AnnotationAssertion(rdfs:label goldbook:08150 "β-elimination")
AnnotationAssertion(dcterms:description goldbook:08150 "Transformation of the general type \\[\\ce{XABY -> A=B + XY (or X + Y, or X^{+} + Y^{-})}\\] where the central atoms \\(\\ce{A}\\) and \\(\\ce{B}\\) are commonly, but not necessarily, carbon.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08150 "1,2-elimination")
AnnotationAssertion(mito:isMentionedBy goldbook:08150 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08150 "current"^^xsd:string)
Declaration(Class(goldbook:08151))
AnnotationAssertion(rdfs:label goldbook:08151 "Catalán solvent parameters")
AnnotationAssertion(dcterms:description goldbook:08151 "Quantitative measure of solvent polarity, based on the solvent’s hydrogen-bond-donor ability, hydrogen-bond-acceptor ability, polarizability, and dipolarity.")
AnnotationAssertion(mito:isMentionedBy goldbook:08151 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08151 "current"^^xsd:string)
Declaration(Class(goldbook:08152))
AnnotationAssertion(rdfs:label goldbook:08152 "catalytic antibody")
AnnotationAssertion(dcterms:description goldbook:08152 "Monoclonal antibody with enzymatic activity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08152 "abzyme")
AnnotationAssertion(rdfs:comment goldbook:08152 "A catalytic antibody acts by binding its antigen and catalyzing a chemical reaction that converts the antigen into desired products. Despite the existence of natural catalytic antibodies, most of them were specifically designed to catalyze desired chemical reactions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08152 "Catalytic antibodies are produced through immunization against a transition-state analogue for the reaction of interest. The resulting antibodies bind strongly and specifically the transition-state analogue, so that they become catalysts for the desired reaction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08152 "The concept of catalytic antibodies and the strategy for obtaining them were advanced by W. P. Jencks. The first catalytic antibodies were finally produced in 1986."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08152 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08152 "current"^^xsd:string)
Declaration(Class(goldbook:08153))
AnnotationAssertion(rdfs:label goldbook:08153 "catalytic cycle")
AnnotationAssertion(dcterms:description goldbook:08153 "Sequence of reaction steps in the form of a loop. One step is binding of a reactant to the active catalyst (sometimes formed from a precatalyst), and another step is the release of product and regeneration of the catalyst.")
AnnotationAssertion(mito:isMentionedBy goldbook:08153 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08153 "current"^^xsd:string)
Declaration(Class(goldbook:08154))
AnnotationAssertion(rdfs:label goldbook:08154 "cation-π interaction")
AnnotationAssertion(dcterms:description goldbook:08154 "Noncovalent attractive force between a positive ion (metal cation, protonated Brønsted base, etc.) and a \\(\\ce{\\uppi\\ electron}\\) system.")
AnnotationAssertion(mito:isMentionedBy goldbook:08154 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08154 "current"^^xsd:string)
Declaration(Class(goldbook:08155))
AnnotationAssertion(rdfs:label goldbook:08155 "chiral feature")
AnnotationAssertion(dcterms:description goldbook:08155 "Structural characteristic rendering a molecule chiral.")
AnnotationAssertion(mito:isMentionedBy goldbook:08155 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08155 "current"^^xsd:string)
Declaration(Class(goldbook:08156))
AnnotationAssertion(rdfs:label goldbook:08156 "chiral recognition")
AnnotationAssertion(dcterms:description goldbook:08156 "Attraction between molecules through noncovalent interactions that exhibit complementarity only between partners with specific chirality.")
AnnotationAssertion(rdfs:seeAlso goldbook:08156 goldbook:08187)
AnnotationAssertion(mito:isMentionedBy goldbook:08156 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08156 "current"^^xsd:string)
Declaration(Class(goldbook:08157))
AnnotationAssertion(rdfs:label goldbook:08157 "coarctate")
AnnotationAssertion(dcterms:description goldbook:08157 "Feature of a concerted transformation in which the primary changes in bonding occur within a cyclic array of atoms but in which two nonbonding atomic orbitals on an atom interchange roles with two bonding orbitals.")
AnnotationAssertion(rdfs:comment goldbook:08157 "Because the atomic orbitals that interchange roles are orthogonal, such a reaction does not proceed through a fully conjugated transition state and is thus not a pericyclic reaction. It is therefore not governed by the rules that express orbital symmetry restrictions applicable to pericyclic reactions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08157 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08157 "current"^^xsd:string)
Declaration(Class(goldbook:08158))
AnnotationAssertion(rdfs:label goldbook:08158 "condensed formula")
AnnotationAssertion(dcterms:description goldbook:08158 "Linear representation of the structure of a molecular entity in which bonds are omitted.")
AnnotationAssertion(rdfs:comment goldbook:08158 "This term is sometimes also called a line formula, because it can be written on a single line, but the line formula explicitly shows all bonds."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08158 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08158 "current"^^xsd:string)
Declaration(Class(goldbook:08160))
AnnotationAssertion(rdfs:label goldbook:08160 "curly arrows")
AnnotationAssertion(dcterms:description goldbook:08160 "Symbols for depicting the flow of electrons in a chemical reaction or to generate additional resonance forms.")
AnnotationAssertion(rdfs:comment goldbook:08160 "The tail of the curly arrow shows where an electron pair originates, and the head of the curly arrow shows where the electron pair goes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08160 "Single-headed curly arrows are used to depict the flow of unpaired electrons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08160 goldbook:08166)
AnnotationAssertion(rdfs:seeAlso goldbook:08160 goldbook:08205)
AnnotationAssertion(mito:isMentionedBy goldbook:08160 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08160 "current"^^xsd:string)
Declaration(Class(goldbook:08161))
AnnotationAssertion(rdfs:label goldbook:08161 "dendrimer")
AnnotationAssertion(dcterms:description goldbook:08161 "Large molecule constructed from a central core with repetitive branching and multiple functional groups at the periphery.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08161 "arborol")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08161 "cascade molecule")
AnnotationAssertion(rdfs:comment goldbook:08161 "The name comes from the Greek δενδρον (dendron), which translates to \"tree\". Synonymous terms include arborols and cascade molecules."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08161 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08161 "current"^^xsd:string)
Declaration(Class(goldbook:08163))
AnnotationAssertion(rdfs:label goldbook:08163 "distortion interaction model")
AnnotationAssertion(dcterms:description goldbook:08163 "Method for analyzing activation energy as the sum of the energies to distort the reactants into the geometries they have in transition states plus the energy of interaction between the two distorted reactants.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08163 "activation strain model")
AnnotationAssertion(mito:isMentionedBy goldbook:08163 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08163 "current"^^xsd:string)
Declaration(Class(goldbook:08164))
AnnotationAssertion(rdfs:label goldbook:08164 "donicity")
AnnotationAssertion(dcterms:description goldbook:08164 "Quantitative experimental measure of the Lewis basicity of a molecule \\(\\ce{B}\\), expressed as the negative enthalpy of the formation of the 1:1 complex \\(\\ce{B.SbCl5}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08164 "donor number DN (misnomer)")
AnnotationAssertion(rdfs:comment goldbook:08164 "Donicity is often used as a measure of a solvent’s basicity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08164 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08164 "current"^^xsd:string)
Declaration(Class(goldbook:08165))
AnnotationAssertion(rdfs:label goldbook:08165 "dynamic NMR")
AnnotationAssertion(dcterms:description goldbook:08165 "NMR spectroscopy of samples undergoing chemical reactions.")
AnnotationAssertion(rdfs:comment goldbook:08165 "Customarily, this does not apply to samples where the composition of the sample, and thus its NMR spectrum, changes with time, but rather to samples at equilibrium, without any net reaction. The occurrence of chemical reactions is manifested by features of the NMR line-shape or by magnetization transfer."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08165 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08165 "current"^^xsd:string)
Declaration(Class(goldbook:08166))
AnnotationAssertion(rdfs:label goldbook:08166 "electron pushing")
AnnotationAssertion(dcterms:description goldbook:08166 "Method using curly arrows for showing the formal movement of an electron pair (from a lone pair or a \\(\\upsigma\\) or \\(\\ce{\\uppi\\ bond}\\)) or of an unpaired electron, in order to generate additional resonance forms or to denote a chemical reaction.")
AnnotationAssertion(rdfs:comment goldbook:08166 "The electron movement may be intramolecular or intermolecular."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08166 "When a single electron is transferred, a single-headed curly arrow or \"fish-hook\" is used, but the electron movement in the opposite direction is redundant and sometimes omitted."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08166 goldbook:08160)
AnnotationAssertion(rdfs:seeAlso goldbook:08166 goldbook:08205)
AnnotationAssertion(mito:isMentionedBy goldbook:08166 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08166 "current"^^xsd:string)
Declaration(Class(goldbook:08167))
AnnotationAssertion(rdfs:label goldbook:08167 "electrophilic substitution")
AnnotationAssertion(dcterms:description goldbook:08167 "Heterolytic reaction in which the entering group adds to a nucleophile and in which the leaving group, or electrofuge, relinquishes both electrons to its reaction partner, whereupon it becomes another potential electrophile.")
AnnotationAssertion(rdfs:comment goldbook:08167 "It is arbitrary to emphasize the electrophile and ignore the feature that this is also a nucleophilic substitution, but the distinction depends on the electrophilic nature of the reactant that is considered to react with the substrate."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08167 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08167 "current"^^xsd:string)
Declaration(Class(goldbook:08168))
AnnotationAssertion(rdfs:label goldbook:08168 "NMR exchange spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08168 "Two-dimensional NMR technique producing cross peaks corresponding to site-to site chemical exchange. The cross-peak amplitudes carry information about exchange rates.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08168 "EXSY")
AnnotationAssertion(mito:isMentionedBy goldbook:08168 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08168 "current"^^xsd:string)
Declaration(Class(goldbook:08169))
AnnotationAssertion(rdfs:label goldbook:08169 "formal charge")
AnnotationAssertion(dcterms:description goldbook:08169 "Quantity (omitted if zero) attached to each atom in a Lewis structure according to \\[Z_{\\rm{formal}} = N_{\\rm{valence}} - N_{\\rm{lonepairs}} - ½N_{\\rm{bonds}}\\]")
AnnotationAssertion(rdfs:comment goldbook:08169 "This formalism assumes that electrons in bonds are shared equally, regardless of electronegativity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08169 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08169 "current"^^xsd:string)
Declaration(Class(goldbook:08170))
AnnotationAssertion(rdfs:label goldbook:08170 "frustrated Lewis acid-base pair")
AnnotationAssertion(dcterms:description goldbook:08170 "Acid and base for which adduct formation is prevented by steric hindrance.")
AnnotationAssertion(mito:isMentionedBy goldbook:08170 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08170 "current"^^xsd:string)
Declaration(Class(goldbook:08171))
AnnotationAssertion(rdfs:label goldbook:08171 "Gaussian orbital")
AnnotationAssertion(dcterms:description goldbook:08171 "Function centered on an atom of the form \\(\\phi(r) \\propto x^{i} y^{j} z^{k} \\exp (-\\zeta r^{2})\\), used to approximate atomic orbitals in the LCAO-MO method.")
AnnotationAssertion(mito:isMentionedBy goldbook:08171 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08171 "current"^^xsd:string)
Declaration(Class(goldbook:08172))
AnnotationAssertion(rdfs:label goldbook:08172 "graphene")
AnnotationAssertion(dcterms:description goldbook:08172 "Allotrope of carbon, whose structure is a one-atom-thick planar sheet of \\(\\ce{sp^{2}{-}bonded}\\) carbon atoms in a honeycomb (hexagonal) crystal lattice.")
AnnotationAssertion(mito:isMentionedBy goldbook:08172 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08172 "current"^^xsd:string)
Declaration(Class(goldbook:08173))
AnnotationAssertion(rdfs:label goldbook:08173 "halogen bond")
AnnotationAssertion(dcterms:description goldbook:08173 "Association between a Lewis-acidic halogen atom in a molecular entity and a Lewis-basic region in another, or the same, molecular entity, which acts as an electron-pair donor, such that the balance of forces of attraction and repulsion results in net stabilization.")
AnnotationAssertion(rdfs:comment goldbook:08173 "Typical halogen-bond donors are \\(\\ce{I2}\\), \\(\\ce{Br2}\\), \\(\\ce{ICN}\\), and \\(\\ce{IC#CH}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08173 "This is analogous to a hydrogen bond, in which the \\(\\ce{H}\\) is the acidic atom."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08173 "The interaction provides a stabilization of a few \\(\\pu{kJ mol-1}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08173 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08173 "current"^^xsd:string)
Declaration(Class(goldbook:08174))
AnnotationAssertion(rdfs:label goldbook:08174 "hapticity")
AnnotationAssertion(dcterms:description goldbook:08174 "Topological description for the number of contiguous atoms of a ligand that are bonded to a central metal atom.")
AnnotationAssertion(rdfs:comment goldbook:08174 "The hapticity is indicated as a superscript following the Greek letter \\(\\upeta\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08174 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08174 "current"^^xsd:string)
Declaration(Class(goldbook:08175))
AnnotationAssertion(rdfs:label goldbook:08175 "HBA solvent")
AnnotationAssertion(dcterms:description goldbook:08175 "Strongly or weakly basic solvent capable of acting as a hydrogen-bond acceptor (HBA) and forming strong intermolecular solute-solvent hydrogen bonds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08175 "hydrogen-bond acceptor solvent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08175 "protophilic solvent")
AnnotationAssertion(rdfs:comment goldbook:08175 "A solvent that is not capable of acting as a hydrogen-bond acceptor is called a non-HBA solvent."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08175 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08175 "current"^^xsd:string)
Declaration(Class(goldbook:08176))
AnnotationAssertion(rdfs:label goldbook:08176 "HBD solvent")
AnnotationAssertion(dcterms:description goldbook:08176 "Solvent with a sizable permanent dipole moment that bears suitably acidic hydrogen atoms to form strong intermolecular solvent-solute hydrogen bonds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08176 "dipolar HBD solvent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08176 "hydrogen-bond donating solvent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08176 "protic solvent")
AnnotationAssertion(rdfs:comment goldbook:08176 "A solvent that is not capable of acting as hydrogen-bond donor is called a non-HBD solvent (formerly aprotic solvent)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08176 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08176 "current"^^xsd:string)
Declaration(Class(goldbook:08177))
AnnotationAssertion(rdfs:label goldbook:08177 "high-throughput screening")
AnnotationAssertion(dcterms:description goldbook:08177 "Automated method to quickly assay large libraries of chemical species for the affinity of small organic molecules toward a target of interest.")
AnnotationAssertion(rdfs:comment goldbook:08177 "Currently more than \\(\\pu{E5}\\) different compounds can be tested per day."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08177 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08177 "current"^^xsd:string)
Declaration(Class(goldbook:08178))
AnnotationAssertion(rdfs:label goldbook:08178 "Huisgen reaction")
AnnotationAssertion(dcterms:description goldbook:08178 "Cycloaddition of 1,3 dipolar compounds.")
AnnotationAssertion(mito:isMentionedBy goldbook:08178 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08178 "current"^^xsd:string)
Declaration(Class(goldbook:08179))
AnnotationAssertion(rdfs:label goldbook:08179 "hydronation")
AnnotationAssertion(dcterms:description goldbook:08179 "Attachment of the ion \\(\\ce{H^{+}}\\) either in natural abundance or where it is not desired to distinguish between the isotopes.")
AnnotationAssertion(mito:isMentionedBy goldbook:08179 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08179 "current"^^xsd:string)
Declaration(Class(goldbook:08180))
AnnotationAssertion(rdfs:label goldbook:08180 "ionic liquid")
AnnotationAssertion(dcterms:description goldbook:08180 "Liquid that consists exclusively or almost exclusively of equivalent amounts of oppositely charged ions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08180 "ionic solvent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08180 "molten salt")
AnnotationAssertion(rdfs:comment goldbook:08180 "In practice, the ions are monocations and monoanions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08180 "Ionic liquids that are liquid at or around room temperature are called room-temperature ionic liquids (RTILs)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08180 "The term ionic liquid has been often restricted to those water-free liquids that have melting points (or glass-transition temperatures) below \\(\\pu{100^{\\circ}C}\\), following a definition given by Walden, who prepared the first ionic liquid, ethylammonium nitrate, \\(\\ce{CH3CH2NH3^{+}NO3^{-}}\\), mp. \\(\\pu{13\\!-\\! 14^{\\circ}C}\\), for conductivity measurements."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08180 "The terminology for ionic liquids is not yet settled, as stated by Welton. Room-temperature ionic liquid, non-aqueous ionic liquid, molten salt, liquid organic salt, and fused salt are often synonymous."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08180 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08180 "current"^^xsd:string)
Declaration(Class(goldbook:08181))
AnnotationAssertion(rdfs:label goldbook:08181 "keto-enol tautomerization")
AnnotationAssertion(dcterms:description goldbook:08181 "Interconversion of ketone and enol tautomers by hydron migration, accelerated by acid or base catalysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:08181 goldbook:08213)
AnnotationAssertion(mito:isMentionedBy goldbook:08181 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08181 "current"^^xsd:string)
Declaration(Class(goldbook:08182))
AnnotationAssertion(rdfs:label goldbook:08182 "Laurence solvent parameters")
AnnotationAssertion(dcterms:description goldbook:08182 "Quantitative measures of solvent polarity, based on the solvent’s dispersion/induction interactions, electrostatic interactions between permanent multipoles, solute Lewis base/solvent Lewis acid interactions, and solute HBD/solvent HBA interactions.")
AnnotationAssertion(mito:isMentionedBy goldbook:08182 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08182 "current"^^xsd:string)
Declaration(Class(goldbook:08183))
AnnotationAssertion(rdfs:label goldbook:08183 "Leffler’s relation")
AnnotationAssertion(dcterms:description goldbook:08183 "In a series of elementary reactions, the changes in Gibbs activation energies are often found to be proportional to the changes in Gibbs energies for the overall reaction.\\[\\updelta \\Delta^{\\ddagger} G = \\alpha \\Delta_{\\rm{r}} G^{\\circ}\\] This relation was interpreted in terms of the simple assumption that a small change in any transition-state property \\(P_{\\ddagger}\\) is a linear combination of changes in reactant- and product-state properties, \\(P_{\\ce{R}}\\) and \\(P_{\\ce{P}}\\). \\[\\updelta P_{\\ddagger} = \\alpha \\updelta P_{\\ce{P}} + (1-\\alpha)\\updelta P_{\\ce{R}}\\] Within the limits of this assumption, the parameter \\(\\alpha\\) is an approximate measure of the fractional displacement of the transition state along the minimum-energy reaction path from reactants to products.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08183 "Leffler’s assumption")
AnnotationAssertion(rdfs:comment goldbook:08183 "There are many exceptions to the validity of Leffler’s assumption that \\(\\alpha\\) is a measure of the position of the transition state."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08183 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08183 "current"^^xsd:string)
Declaration(Class(goldbook:08184))
AnnotationAssertion(rdfs:label goldbook:08184 "mass action, law of")
AnnotationAssertion(dcterms:description goldbook:08184 "Statement that the velocity of a reaction depends on the active mass, i.e., the concentrations of the reactants.")
AnnotationAssertion(rdfs:comment goldbook:08184 "First recognized in 1864 as the kinetic law of mass action by Guldberg and Waage, who first introduced the concept of dynamic equilibrium, but incorrectly assumed that the rates could be deduced from the stoichiometric equation. Only after the work of Horstmann and van’t Hoff a mathematical derivation of the reaction rates considering the order of the reaction involved was correctly made."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08184 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08184 "current"^^xsd:string)
Declaration(Class(goldbook:08185))
AnnotationAssertion(rdfs:label goldbook:08185 "Mayr–Patz equation")
AnnotationAssertion(dcterms:description goldbook:08185 "Rate constants for the reactions of \\(\\ce{sp^{2}{-}hybridized}\\) electrophiles with nucleophiles can be expressed by the correlation \\[\\lg [k/(\\pu{dm3 mol-1 s-1})] = s_{\\rm{N}}(E + N)\\] where \\(E\\) is the nucleophile-independent electrophilicity parameter, \\(N\\) is the electrophile-independent nucleophilicity parameter, and \\(s_{\\rm{N}}\\) is the electrophile-independent nucleophile-specific susceptibility parameter.")
AnnotationAssertion(rdfs:comment goldbook:08185 "This equation is equivalent to the conventional linear Gibbs energy relationship \\(\\lg k = Nu + s_{\\rm{N}}E\\), where \\(Nu = s_{\\rm{N}}N\\). The use of \\(N\\) is preferred, because it provides an approximate ranking of relative reactivities of nucleophiles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08185 "The correlation should not be applied to reactions with bulky electrophiles, where steric effects cannot be neglected. Because of the way of parametrization, the correlation is applicable only if one or both reaction centers are carbon."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08185 "As the \\(E\\) parameters of the reference electrophiles are defined as solvent-independent, all solvent effects are shifted into the parameters \\(N\\) and \\(s_{\\rm{N}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08185 "The equation transforms into the Ritchie equation for \\(s_{\\rm{N}} = 1\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08185 "Applications to \\(\\rm{S}_{\\rm{N}}2\\mbox{-}type\\) reactions are possible if an electrophile-specific susceptibility parameter is introduced."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08185 "The Mayr scale is available at https://www.cup.lmu.de/oc/mayr/DBintro.html."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08185 goldbook:08203)
AnnotationAssertion(mito:isMentionedBy goldbook:08185 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08185 "current"^^xsd:string)
Declaration(Class(goldbook:08186))
AnnotationAssertion(rdfs:label goldbook:08186 "minimum structural change, principle of")
AnnotationAssertion(dcterms:description goldbook:08186 "Principle that a chemical reaction is expected to occur with a minimum of bond changes or with a minimum redistribution of electrons (although more complex reaction cascades are also possible).")
AnnotationAssertion(mito:isMentionedBy goldbook:08186 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08186 "current"^^xsd:string)
Declaration(Class(goldbook:08187))
AnnotationAssertion(rdfs:label goldbook:08187 "molecular recognition")
AnnotationAssertion(dcterms:description goldbook:08187 "Attraction between specific molecules through noncovalent interactions that often exhibit electrostatic and stereochemical complementarity between the partners.")
AnnotationAssertion(rdfs:comment goldbook:08187 "The partners are usually designated as host and guest, where the host recognizes and binds the guest with high selectivity over other molecules of similar size and shape."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08187 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08187 "current"^^xsd:string)
Declaration(Class(goldbook:08188))
AnnotationAssertion(rdfs:label goldbook:08188 "nanomaterial")
AnnotationAssertion(dcterms:description goldbook:08188 "Substance whose particles are in the size range of 1 to \\(\\pu{100 nm}\\).")
AnnotationAssertion(rdfs:comment goldbook:08188 "This may have chemical properties different from those of the corresponding bulk material."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08188 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08188 "current"^^xsd:string)
Declaration(Class(goldbook:08190))
AnnotationAssertion(rdfs:label goldbook:08190 "non-Kekulé structure")
AnnotationAssertion(dcterms:description goldbook:08190 "Compound with unpaired electrons for which no Lewis structures are possible with all bonding electrons paired in single or double bonds.")
AnnotationAssertion(rdfs:comment goldbook:08190 "The isomer shown on the right (valence tautomer methylidenecyclopropane) is a Kekulé structure."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08190 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08190 "current"^^xsd:string)
Declaration(Class(goldbook:08191))
AnnotationAssertion(rdfs:label goldbook:08191 "nucleophilic substitution")
AnnotationAssertion(dcterms:description goldbook:08191 "Heterolytic reaction in which an entering group adds to the electrophilic part of the substrate and in which the leaving group, or nucleofuge, retains both electrons of the bond that is broken, whereupon it becomes another potential nucleophile.")
AnnotationAssertion(rdfs:comment goldbook:08191 "It is arbitrary to emphasize the nucleophile and ignore the feature that this is also an electrophilic substitution, but the distinction depends on the nucleophilic nature of the reactant that is considered to react with the substrate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08191 "Nucleophilic substitution reactions are designated as \\(\\rm{S}_{\\rm{N}}1\\) or \\(\\rm{S}_{\\rm{N}}2\\), depending on whether they are unimolecular or bimolecular, respectively. Mechanistically, these correspond to two-step and one-step processes, respectively. \\(\\rm{S}_{\\rm{N}}1\\) reactions follow first-order kinetics but \\(\\rm{S}_{\\rm{N}}2\\) reactions do not always follow second-order kinetics."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08191 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08191 "current"^^xsd:string)
Declaration(Class(goldbook:08192))
AnnotationAssertion(rdfs:label goldbook:08192 "octanol-water partition ratio")
AnnotationAssertion(dcterms:description goldbook:08192 "Equilibrium concentration of a substance in octan-1-ol divided by its equilibrium concentration in water.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08192 "partition ratio")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08192 "water/octanol partition coefficient")
AnnotationAssertion(rdfs:comment goldbook:08192 "This is a measure of the lipophilicity of a substance. It is used in pharmacological studies and in the assessment of environmental fate and transport of organic chemicals."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08192 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08192 "current"^^xsd:string)
Declaration(Class(goldbook:08193))
AnnotationAssertion(rdfs:label goldbook:08193 "organocatalysis")
AnnotationAssertion(dcterms:description goldbook:08193 "Catalysis by small organic molecules, as distinguished from catalysis by (transition) metals or enzymes.")
AnnotationAssertion(rdfs:comment goldbook:08193 "Frequently used organocatalysts are secondary amines (covalent catalysis by generation of enamines or of iminium ions as reactive intermediates) and thioureas (hydrogen-bonding catalysis)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08193 "Organocatalysts are often employed for enantioselectivity."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08193 "The mechanisms employed by organocatalysts are examples of general acid catalysis, general base catalysis, nucleophilic catalysis, specific acid catalysis, specific base catalysis."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08193 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08193 "current"^^xsd:string)
Declaration(Class(goldbook:08194))
AnnotationAssertion(rdfs:label goldbook:08194 "parallel effect")
AnnotationAssertion(dcterms:description goldbook:08194 "Change of the position of the transition state upon stabilization or destabilization of a structure (or structures) along the assumed minimum-energy reaction path.")
AnnotationAssertion(mito:isMentionedBy goldbook:08194 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08194 "current"^^xsd:string)
Declaration(Class(goldbook:08195))
AnnotationAssertion(rdfs:label goldbook:08195 "polarity")
AnnotationAssertion(dcterms:description goldbook:08195 "Characteristic of a bond between atoms of different electronegativity, such that the electrons in that bond are not shared equally.")
AnnotationAssertion(mito:isMentionedBy goldbook:08195 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08195 "current"^^xsd:string)
Declaration(Class(goldbook:08196))
AnnotationAssertion(rdfs:label goldbook:08196 "potential of mean force")
AnnotationAssertion(dcterms:description goldbook:08196 "Free energy as a function of a set of coordinates, the negative gradient of which gives the average force acting on that configuration averaged over all other coordinates and momenta within a statistical distribution. If the averaging is performed within a canonical ensemble (constant volume, temperature, and number of particles), the PMF is equivalent to the Helmholtz energy, but if it is performed within an isobaric-isothermal ensemble (constant pressure, temperature, and number of particles), the PMF is equivalent to the Gibbs energy.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08196 "PMF")
AnnotationAssertion(rdfs:comment goldbook:08196 "Commonly, the PMF acting upon a selected geometric variable and averaged over the coordinates and momenta of all other geometric variables is evaluated for a succession of constrained values of the selected variable, thereby generating (generically) a free-energy profile with respect to the selected reaction coordinate (e.g., a bond distance or angle or a combination of internal coordinates); specifically, this is either a Helmholtz-energy or a Gibbs-energy profile, depending upon the choice of ensemble for the statistical averaging within a computational simulation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08196 "Selection of two geometric variables as reaction coordinates allows a free-energy surface to be computed as a two-dimensional PMF."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08196 "Molecular simulations often yield Helmholtz energies, not Gibbs energies, but for condensed phases the difference is usually neglected."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08196 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08196 "current"^^xsd:string)
Declaration(Class(goldbook:08197))
AnnotationAssertion(rdfs:label goldbook:08197 "protofugality")
AnnotationAssertion(dcterms:description goldbook:08197 "Special case of nucleofugality, describing the relative rates of transfer of a proton (more generally: hydron) from a series of Brønsted acids \\(\\ce{H-X}\\) to a common Brønsted base.")
AnnotationAssertion(rdfs:comment goldbook:08197 "This term has the advantage over the commonly used \"kinetic acidity\" that philicity and fugality are associated with kinetics, while acidity and basicity are associated with thermodynamics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08197 goldbook:08199)
AnnotationAssertion(mito:isMentionedBy goldbook:08197 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08197 "current"^^xsd:string)
Declaration(Class(goldbook:08198))
AnnotationAssertion(rdfs:label goldbook:08198 "protonation")
AnnotationAssertion(dcterms:description goldbook:08198 "Attachment of the ion \\(\\ce{^{1}H^{+}}\\) of relative isotopic mass approximately equal to 1.")
AnnotationAssertion(rdfs:seeAlso goldbook:08198 goldbook:08179)
AnnotationAssertion(mito:isMentionedBy goldbook:08198 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08198 "current"^^xsd:string)
Declaration(Class(goldbook:08199))
AnnotationAssertion(rdfs:label goldbook:08199 "protophilicity")
AnnotationAssertion(dcterms:description goldbook:08199 "Special case of nucleophilicity, describing the relative rates of reactions of a series of Lewis bases with a common Brønsted acid. This term has the advantage over the commonly used 'kinetic basicity' that philicity and fugality are associated with kinetics, while acidity and basicity are associated with thermodynamics.")
AnnotationAssertion(rdfs:seeAlso goldbook:08199 goldbook:08197)
AnnotationAssertion(mito:isMentionedBy goldbook:08199 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08199 "current"^^xsd:string)
Declaration(Class(goldbook:08200))
AnnotationAssertion(rdfs:label goldbook:08200 "push-pull conjugation")
AnnotationAssertion(dcterms:description goldbook:08200 "Feature of an extended conjugated \\(\\ce{\\uppi\\ system}\\) bearing an electron donor group at one end and an electron acceptor group at the other end.")
AnnotationAssertion(mito:isMentionedBy goldbook:08200 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08200 "current"^^xsd:string)
Declaration(Class(goldbook:08201))
AnnotationAssertion(rdfs:label goldbook:08201 "π-electron donor")
AnnotationAssertion(dcterms:description goldbook:08201 "Substituent capable of electron donation by resonance (e.g., \\(\\ce{OCH3}\\)).")
AnnotationAssertion(mito:isMentionedBy goldbook:08201 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08201 "current"^^xsd:string)
Declaration(Class(goldbook:08202))
AnnotationAssertion(rdfs:label goldbook:08202 "quantitative structure–property relationship")
AnnotationAssertion(dcterms:description goldbook:08202 "Regression model to correlate chemical properties such as boiling point or chromatographic retention time with predictor parameters based on measured or calculated features of molecular structure.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08202 "QSPR")
AnnotationAssertion(mito:isMentionedBy goldbook:08202 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08202 "current"^^xsd:string)
Declaration(Class(goldbook:08205))
AnnotationAssertion(rdfs:label goldbook:08205 "resonance form")
AnnotationAssertion(dcterms:description goldbook:08205 "One of at least two Lewis structures, with fixed single, double, and triple bonds, that is a contributing structure to the valence-bond wavefunction of a molecule that cannot be described by a single Lewis structure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08205 "canonical form")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08205 "contributing structure")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08205 "resonance structure")
AnnotationAssertion(rdfs:comment goldbook:08205 "Although the valence-bond wavefunction is a linear combination of the wavefunctions of the individual resonance forms, the coefficients and the relative contributions of the various resonance forms are usually kept qualitative. For example, the major resonance forms for the conjugate base of acetone are \\(\\ce{CH2=C(CH3)-O^{-}}\\) and \\(\\ce{H2C^{-}-C(CH3)=O}\\), with the former contributing more."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08205 "Resonance forms are connected by a double-headed arrow (\\(\\leftrightarrow\\)). This must not be confused with the double arrow connecting species in equilibrium (\\(\\ce{}\\))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08205 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08205 "current"^^xsd:string)
Declaration(Class(goldbook:08206))
AnnotationAssertion(rdfs:label goldbook:08206 "self-assembly")
AnnotationAssertion(dcterms:description goldbook:08206 "Process whereby a system of single-molecule components spontaneously forms an organized structure, owing to molecular recognition.")
AnnotationAssertion(rdfs:seeAlso goldbook:08206 goldbook:08187)
AnnotationAssertion(mito:isMentionedBy goldbook:08206 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08206 "current"^^xsd:string)
Declaration(Class(goldbook:08207))
AnnotationAssertion(rdfs:label goldbook:08207 "shift reagent")
AnnotationAssertion(dcterms:description goldbook:08207 "Paramagnetic substance that induces an additional change of the NMR resonance frequency of a nucleus near any site in a molecule to which the substance binds.")
AnnotationAssertion(mito:isMentionedBy goldbook:08207 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08207 "current"^^xsd:string)
Declaration(Class(goldbook:08208))
AnnotationAssertion(rdfs:label goldbook:08208 "skeletal formula")
AnnotationAssertion(dcterms:description goldbook:08208 "Two-dimensional representation of a molecular entity in which bonds are indicated as lines between vertices representing octet carbon atoms with attached hydrogens omitted and in which other atoms are represented by their chemical symbols.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08208 "bond-line formula")
AnnotationAssertion(mito:isMentionedBy goldbook:08208 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08208 "current"^^xsd:string)
Declaration(Class(goldbook:08209))
AnnotationAssertion(rdfs:label goldbook:08209 "solvatomers")
AnnotationAssertion(dcterms:description goldbook:08209 "Isomers that differ in their solvation environment.")
AnnotationAssertion(rdfs:comment goldbook:08209 "Because the solvation environment fluctuates rapidly, solvatomers interconvert rapidly."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08209 "Species that differ in the type of solvent molecules should not be called solvatomers because they are not isomers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08209 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08209 "current"^^xsd:string)
Declaration(Class(goldbook:08210))
AnnotationAssertion(rdfs:label goldbook:08210 "stereogenic center")
AnnotationAssertion(dcterms:description goldbook:08210 "Atom within a molecule bearing groups such that interchanging any two of them leads to a stereoisomer of the original molecule.")
AnnotationAssertion(mito:isMentionedBy goldbook:08210 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08210 "current"^^xsd:string)
Declaration(Class(goldbook:08212))
AnnotationAssertion(rdfs:label goldbook:08212 "superjacent orbital")
AnnotationAssertion(dcterms:description goldbook:08212 "Second Lowest Unoccupied Molecular Orbital (SLUMO).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08212 "SLUMO")
AnnotationAssertion(rdfs:comment goldbook:08212 "Subjacent and superjacent orbitals sometimes play an important role in the interpretation of molecular interactions according to the frontier orbital approach."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08212 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08212 "current"^^xsd:string)
Declaration(Class(goldbook:08213))
AnnotationAssertion(rdfs:label goldbook:08213 "tautomers")
AnnotationAssertion(dcterms:description goldbook:08213 "Constitutional isomers that can interconvert more or less rapidly, often by migration of a hydron.")
AnnotationAssertion(mito:isMentionedBy goldbook:08213 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08213 "current"^^xsd:string)
Declaration(Class(goldbook:08214))
AnnotationAssertion(rdfs:label goldbook:08214 "through-conjugation")
AnnotationAssertion(dcterms:description goldbook:08214 "Phenomenon whereby electrons can be delocalized from any of three (or more) groups to any other.")
AnnotationAssertion(rdfs:comment goldbook:08214 "This may be contrasted with cross-conjugation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08214 "In Hammett-type correlations (linear Gibbs-energy relationships), this situation can lead to exalted substituent constants \\(\\sigma^{+}\\) or \\(\\sigma^{-}\\), as in solvolysis of \\(\\ce{p-CH3OC6H4C(CH3)2Cl}\\) or acidity of \\(\\ce{p-nitrophenol}\\), respectively."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08214 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08214 "current"^^xsd:string)
Declaration(Class(goldbook:08215))
AnnotationAssertion(rdfs:label goldbook:08215 "zero-point energy")
AnnotationAssertion(dcterms:description goldbook:08215 "Extent, in consequence of Heisenberg’s Uncertainty Principle, by which a particle or a set of particles has an energy greater than that of the minimum on the potential-energy surface.")
AnnotationAssertion(rdfs:comment goldbook:08215 "Because of zero-point energy, a molecular entity has a nonzero probability of adopting a geometry whose energy is greater than that of the energy minimum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08215 "A molecular entity with zero-point energy may even adopt a geometry with a potential energy greater than its total energy, a possibility that permits tunnelling."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08215 "Because the magnitude of zero-point energy increases with decreasing mass, it is significant in the context of isotope effects, especially of hydrogen isotopes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08215 doi:10.1515/pac-2018-1010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08215 "current"^^xsd:string)
Declaration(Class(goldbook:08216))
AnnotationAssertion(rdfs:label goldbook:08216 "atomic spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08216 "Measurement principle of spectroscopy for the study of electromagnetic radiation absorbed and emitted by atoms.")
AnnotationAssertion(rdfs:comment goldbook:08216 "Atomic spectra may be emission or absorption spectra."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08216 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08216 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08216 "current"^^xsd:string)
Declaration(Class(goldbook:08217))
AnnotationAssertion(rdfs:label goldbook:08217 "molecular spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08217 "Measurement principle of spectroscopy for the study of rotational, vibrational, and electronic transitions of molecules.")
AnnotationAssertion(rdfs:comment goldbook:08217 "Molecular spectra may be emission or absorption spectra."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08217 goldbook:08245)
AnnotationAssertion(mito:isMentionedBy goldbook:08217 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08217 "current"^^xsd:string)
Declaration(Class(goldbook:08218))
AnnotationAssertion(rdfs:label goldbook:08218 "nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08218 "Measurement principle of spectroscopy to measure the precession of magnetic moments placed in a magnetic induction based on absorption of electromagnetic radiation of a specific frequency by an atomic nucleus.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08218 "NMR")
AnnotationAssertion(rdfs:comment goldbook:08218 "Nuclei having a suitable magnetic moment include \\(\\ce{^{1}H}\\), \\(\\ce{^{13}C}\\), \\(\\ce{^{15}N}\\), \\(\\ce{^{19}F}\\), \\(\\ce{^{31}P}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08218 "The technique is used as a method of determining structure of organic molecules, or as a mechanism for quantification."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08218 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08218 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08218 "current"^^xsd:string)
Declaration(Class(goldbook:08220))
AnnotationAssertion(rdfs:label goldbook:08220 "absorption index")
AnnotationAssertion(dcterms:description goldbook:08220 "Imaginary part of the complex refractive index describing absorption of electromagnetic radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08220 "imaginary refractive index")
AnnotationAssertion(rdfs:seeAlso goldbook:08220 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08220 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08220 "current"^^xsd:string)
Declaration(Class(goldbook:08221))
AnnotationAssertion(rdfs:label goldbook:08221 "accidental degeneracy")
AnnotationAssertion(dcterms:description goldbook:08221 "Condition that occurs when two or more normal transitions have the same energy as a matter of coincidence, as opposed to because of symmetry conditions.")
AnnotationAssertion(mito:isMentionedBy goldbook:08221 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08221 "current"^^xsd:string)
Declaration(Class(goldbook:08222))
AnnotationAssertion(rdfs:label goldbook:08222 "angle of incidence")
AnnotationAssertion(dcterms:description goldbook:08222 "Angle between a beam of electromagnetic radiation and a line normal to a surface.")
AnnotationAssertion(rdfs:seeAlso goldbook:08222 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08222 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08222 "current"^^xsd:string)
Declaration(Class(goldbook:08223))
AnnotationAssertion(rdfs:label goldbook:08223 "anisotropic")
AnnotationAssertion(dcterms:description goldbook:08223 "Having properties that depend on direction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08223 "nonisotropic")
AnnotationAssertion(mito:isMentionedBy goldbook:08223 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08223 "current"^^xsd:string)
Declaration(Class(goldbook:08224))
AnnotationAssertion(rdfs:label goldbook:08224 "apodization")
AnnotationAssertion(dcterms:description goldbook:08224 "Technical term for changing the shape of a mathematical function, electrical signal, or optical transmission to remove or smooth a discontinuity at the edges, literally meaning 'removing the foot'.")
AnnotationAssertion(rdfs:comment goldbook:08224 "Originally, 'apodization' described the procedure by which Fourier-transform infrared spectra are corrected for the side lobes that appear in the wings of spectral bands when the interferogram is not zero at its limits, by multiplying the interferogram prior to Fourier transformation by a weighting function that is zero at its limits (see Fourier-transform spectroscopy). Its use has broadened in recent years to include weighting functions that are not zero at their limits."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08224 "Apodization is also used for manipulating FIDs (free induction decay) to enhance specific components of the signal, for example to improve signal-to-noise or resolution, and is achieved by application of specific shapes to the FID, e.g., in nuclear magnetic resonance spectroscopy: exponential, Gaussian or sine-bell; in infrared spectroscopy: Boxcar, Happ-Genzel, Norton-Beer, cosine."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08224 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08224 goldbook:08618)
AnnotationAssertion(rdfs:seeAlso goldbook:08224 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08224 goldbook:08282)
AnnotationAssertion(rdfs:seeAlso goldbook:08224 goldbook:08285)
AnnotationAssertion(mito:isMentionedBy goldbook:08224 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08224 "current"^^xsd:string)
Declaration(Class(goldbook:08225))
AnnotationAssertion(rdfs:label goldbook:08225 "apodization function")
AnnotationAssertion(dcterms:description goldbook:08225 "Mathematical function that effects apodization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08225 "window function")
AnnotationAssertion(rdfs:seeAlso goldbook:08225 goldbook:08224)
AnnotationAssertion(mito:isMentionedBy goldbook:08225 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08225 "current"^^xsd:string)
Declaration(Class(goldbook:08226))
AnnotationAssertion(rdfs:label goldbook:08226 "array detector")
AnnotationAssertion(dcterms:description goldbook:08226 "Photoelectric detector in which a large number of pixels are distributed, usually in regularly spaced lines and usually over a rectangular area.")
AnnotationAssertion(mito:isMentionedBy goldbook:08226 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08226 "current"^^xsd:string)
Declaration(Class(goldbook:08227))
AnnotationAssertion(rdfs:label goldbook:08227 "attenuated total reflection")
AnnotationAssertion(dcterms:description goldbook:08227 "Internal reflection from an absorbing material at angles of incidence at or above the critical angle.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08227 "ATR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08227 "frustrated total internal reflection")
AnnotationAssertion(rdfs:seeAlso goldbook:08227 goldbook:08623)
AnnotationAssertion(rdfs:seeAlso goldbook:08227 goldbook:08222)
AnnotationAssertion(rdfs:seeAlso goldbook:08227 goldbook:08573)
AnnotationAssertion(rdfs:seeAlso goldbook:08227 goldbook:08584)
AnnotationAssertion(rdfs:seeAlso goldbook:08227 goldbook:08271)
AnnotationAssertion(mito:isMentionedBy goldbook:08227 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08227 "current"^^xsd:string)
Declaration(Class(goldbook:08228))
AnnotationAssertion(rdfs:label goldbook:08228 "beam splitter")
AnnotationAssertion(dcterms:description goldbook:08228 "Device to split a beam of electromagnetic radiation into two parts.")
AnnotationAssertion(rdfs:comment goldbook:08228 "In an ideal two-beam Fourier-transform spectrometer, the beam splitter would transmit half of the radiation and reflect half of it to create the two beams."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08228 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08228 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08228 "current"^^xsd:string)
Declaration(Class(goldbook:08229))
AnnotationAssertion(rdfs:label goldbook:08229 "Cauchy function")
AnnotationAssertion(dcterms:description goldbook:08229 "Function \\(y = a/(b^{2} + x^{2})\\) where \\(a\\) and \\(b\\) are constants.")
AnnotationAssertion(rdfs:comment goldbook:08229 "If \\(x\\) is replaced by \\(\\tilde{\\nu} - \\tilde \\nu_{0}\\) this function yields a Lorentzian band centered at \\(\\tilde{\\nu}_{0}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08229 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08229 "current"^^xsd:string)
Declaration(Class(goldbook:08230))
AnnotationAssertion(rdfs:label goldbook:08230 "charge coupled device")
AnnotationAssertion(dcterms:description goldbook:08230 "Device that stores information in the form of charge packets in an array of closely spaced capacitors.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08230 "CCD")
AnnotationAssertion(rdfs:comment goldbook:08230 "The packets can be transferred from one capacitor to the next sequentially by electronic manipulation, so that the information contained in the array can be sequentially read electronically."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08230 "In spectroscopy, the charge packets are created by interaction with electromagnetic radiation and the devices are extremely sensitive detectors for near infrared and visible radiation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08230 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08230 goldbook:08642)
AnnotationAssertion(mito:isMentionedBy goldbook:08230 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08230 "current"^^xsd:string)
Declaration(Class(goldbook:08231))
AnnotationAssertion(rdfs:label goldbook:08231 "circular birefringence")
AnnotationAssertion(dcterms:description goldbook:08231 "Difference between the refractive indices of an optically active medium for left, \\(n^{\\rm{L}}\\), and right, \\(n^{\\rm{R}}\\), circularly polarized radiation (\\(n^{\\rm{L}}-n^{\\rm{R}}\\)).")
AnnotationAssertion(rdfs:comment goldbook:08231 "\"Circular birefringence\" is also used to describe the phenomenon of having different refractive indices for left and right circularly polarized radiation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08231 "Like the refractive indices (\\(n^{\\rm{L}}\\), \\(n^{\\rm{R}}\\)), circular birefringence changes with wavenumber."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08231 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08231 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08231 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08231 "current"^^xsd:string)
Declaration(Class(goldbook:08232))
AnnotationAssertion(rdfs:label goldbook:08232 "dephasing")
AnnotationAssertion(dcterms:description goldbook:08232 "Loss of coherence between the upper and lower states of a transition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08232 "phase relaxation")
AnnotationAssertion(rdfs:comment goldbook:08232 "The term 'dephasing' arises from the density matrix formalism that is used in a phenomenological approach to simplify the description of the relaxation dynamics of a molecule coupled to its surroundings."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08232 "Dephasing leads to either homogeneous broadening or inhomogeneous broadening depending on the system. The continually changing intermolecular interactions cause a shift of the frequency of the intramolecular vibration. If these interactions change much more slowly than the amplitude of this shift, heterogeneous broadening results and causes a Gaussian band. If these interactions change much faster than the amplitude of this shift, homogeneous broadening occurs and the observed spectral band is a notionally narrowed Lorentzian band. In the general case, the broadening due to dephasing is neither homogeneous nor heterogeneous and the line shape is neither Gaussian nor Lorentzian."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08232 goldbook:08252)
AnnotationAssertion(rdfs:seeAlso goldbook:08232 goldbook:08611)
AnnotationAssertion(rdfs:seeAlso goldbook:08232 goldbook:08619)
AnnotationAssertion(rdfs:seeAlso goldbook:08232 goldbook:08285)
AnnotationAssertion(mito:isMentionedBy goldbook:08232 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08232 "current"^^xsd:string)
Declaration(Class(goldbook:08233))
AnnotationAssertion(rdfs:label goldbook:08233 "detector gate width")
AnnotationAssertion(dcterms:description goldbook:08233 "Time for signal integration after start of detection.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08233 "detector integration time")
AnnotationAssertion(rdfs:comment goldbook:08233 "Optimization of gate width allows detection of species with different decay rates."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08233 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08233 "current"^^xsd:string)
Declaration(Class(goldbook:08234))
AnnotationAssertion(rdfs:label goldbook:08234 "difference spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08234 "Measurement method of spectroscopy in which spectral subtraction is used to help the study and identification of individual species in a mixture.")
AnnotationAssertion(rdfs:seeAlso goldbook:08234 goldbook:08290)
AnnotationAssertion(mito:isMentionedBy goldbook:08234 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08234 "current"^^xsd:string)
Declaration(Class(goldbook:08235))
AnnotationAssertion(rdfs:label goldbook:08235 "diffuse reflectance")
AnnotationAssertion(dcterms:description goldbook:08235 "Diffuse reflected (remitted) radiant power (\\(P_{\\rm{rem}}\\)) divided by incident radiant power (\\(P_{0}\\)). \\(R = P_{\\rm{rem}}/P_{0}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08235 "remission fraction")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08235 "remittance")
AnnotationAssertion(rdfs:comment goldbook:08235 "The sum of remittance, transmittance, and absorptance equals one."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08235 "Some authors distinguish between remittance and diffuse reflectance by excluding specular reflection in the latter."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08235 goldbook:08292)
AnnotationAssertion(mito:isMentionedBy goldbook:08235 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08235 "current"^^xsd:string)
Declaration(Class(goldbook:08236))
AnnotationAssertion(rdfs:label goldbook:08236 "diffuse reflection")
AnnotationAssertion(dcterms:description goldbook:08236 "Reflection in which electromagnetic radiation incident on a scattering surface at a certain angle is reflected (remitted) over all angles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08236 "remission")
AnnotationAssertion(rdfs:comment goldbook:08236 "Diffuse reflection is a complicated process and involves transmission, reflection, and scattering."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08236 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08236 goldbook:08281)
AnnotationAssertion(rdfs:seeAlso goldbook:08236 goldbook:08235)
AnnotationAssertion(mito:isMentionedBy goldbook:08236 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08236 "current"^^xsd:string)
Declaration(Class(goldbook:08237))
AnnotationAssertion(rdfs:label goldbook:08237 "diffuse transmission")
AnnotationAssertion(dcterms:description goldbook:08237 "Process in which radiation is transmitted by a scattering sample and leaves the sample in directions other than that required by Snell’s law of refraction. The process is complicated and involves transmission, reflection, and scattering.")
AnnotationAssertion(mito:isMentionedBy goldbook:08237 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08237 "current"^^xsd:string)
Declaration(Class(goldbook:08238))
AnnotationAssertion(rdfs:label goldbook:08238 "dipole coupling")
AnnotationAssertion(dcterms:description goldbook:08238 "Coupling of different motions through dipole-dipole forces.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08238 "transition-dipole transition dipole coupling")
AnnotationAssertion(rdfs:comment goldbook:08238 "In vibrational spectroscopy of crystals, intermolecular vibrational coupling through interaction of resonant transition dipoles throughout the whole crystal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08238 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08238 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08238 "current"^^xsd:string)
Declaration(Class(goldbook:08239))
AnnotationAssertion(rdfs:label goldbook:08239 "dispersive Fourier-transform spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08239 "Fourier-transform spectroscopy using a Michelson or other two-beam interferometer with the sample placed in one arm of the interferometer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08239 "asymmetric Fourier-transform spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:08239 "This method provides information about the phase change as well as the amplitude change caused by the sample."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08239 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08239 "current"^^xsd:string)
Declaration(Class(goldbook:08240))
AnnotationAssertion(rdfs:label goldbook:08240 "dispersive spectrometer")
AnnotationAssertion(dcterms:description goldbook:08240 "Spectrometer in which electromagnetic radiation is separated spatially into its component wavenumbers by a dispersive element, such as a prism or a diffraction grating.")
AnnotationAssertion(rdfs:seeAlso goldbook:08240 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08240 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08240 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08240 "current"^^xsd:string)
Declaration(Class(goldbook:08242))
AnnotationAssertion(rdfs:label goldbook:08242 "electromagnetic radiation")
AnnotationAssertion(dcterms:description goldbook:08242 "Flow of energy through space propagated as synchronized sinusoidal waves of the electric field, \\(\\boldsymbol{E}\\), and the magnetic field \\(\\boldsymbol{H}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08242 "EM")
AnnotationAssertion(rdfs:comment goldbook:08242 "Electromagnetic radiation is characterized by frequency \\(\\nu\\), wavelength \\(\\lambda\\), and speed \\(c\\), where \\(\\nu\\lambda = c\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08242 "The wavelength and velocity change when radiation enters a medium. In its interaction with atoms and molecules, radiation behaves like particles, called photons, with zero mass, energy \\(h\\nu\\), and momentum \\(h/\\lambda\\), where \\(h\\) is the Planck constant \\(h = \\pu{6.62607015E-34 J s}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08242 goldbook:08299)
AnnotationAssertion(mito:isMentionedBy goldbook:08242 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08242 "current"^^xsd:string)
Declaration(Class(goldbook:08243))
AnnotationAssertion(rdfs:label goldbook:08243 "electromagnetic transition")
AnnotationAssertion(dcterms:description goldbook:08243 "Transition accompanied by the emission or absorption of a photon.")
AnnotationAssertion(rdfs:comment goldbook:08243 "The frequency of the photon (\\(\\nu\\)) is related to the energy difference of the transition by \\(h\\nu = \\Delta E = |E_{2} – E_{1}|\\), where \\(h\\) is the Planck constant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08243 "In general, an electromagnetic transition obeys certain rules called \"electromagnetic selection rules\"."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08243 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08243 "current"^^xsd:string)
Declaration(Class(goldbook:08244))
AnnotationAssertion(rdfs:label goldbook:08244 "electron emission spectrometry")
AnnotationAssertion(dcterms:description goldbook:08244 "Measurement principle of spectrometry for the study of electrons emitted by atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:08244 goldbook:08219)
AnnotationAssertion(mito:isMentionedBy goldbook:08244 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08244 "current"^^xsd:string)
Declaration(Class(goldbook:08245))
AnnotationAssertion(rdfs:label goldbook:08245 "electronic transition")
AnnotationAssertion(dcterms:description goldbook:08245 "Transition in an atom, ion, or molecule from an electronic energy level \\(E_{1}\\) to another energy level \\(E_{2}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08245 "transition")
AnnotationAssertion(rdfs:seeAlso goldbook:08245 goldbook:N04081)
AnnotationAssertion(rdfs:seeAlso goldbook:08245 goldbook:P04386)
AnnotationAssertion(rdfs:seeAlso goldbook:08245 goldbook:S04387)
AnnotationAssertion(rdfs:seeAlso goldbook:08245 goldbook:S05435)
AnnotationAssertion(mito:isMentionedBy goldbook:08245 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08245 "current"^^xsd:string)
Declaration(Class(goldbook:08246))
AnnotationAssertion(rdfs:label goldbook:08246 "energy level")
AnnotationAssertion(dcterms:description goldbook:08246 "Set of one or more stationary quantum states of a free atom, ion, or molecule having a particular internal energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08246 "energy state")
AnnotationAssertion(rdfs:comment goldbook:08246 "SI unit: \\(\\pu{J}\\). Common unit: electron volt, symbol \\(\\pu{eV}\\), where \\(\\pu{1 eV} = \\pu{1.602176634E-19 J}\\). Energy levels are also expressed as \\(\\pu{kJ mol-1}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08246 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08246 "current"^^xsd:string)
Declaration(Class(goldbook:08247))
AnnotationAssertion(rdfs:label goldbook:08247 "experimental absorbance")
AnnotationAssertion(dcterms:description goldbook:08247 "Decadic absorbance as measured with no corrections for other processes.")
AnnotationAssertion(rdfs:comment goldbook:08247 "The term emphasizes that radiation might be lost from the beam by reflection, luminescence, scattering, and possibly vignetting (e.g., spectral shifts introduced from changing a radiation beam diameter or shape), and not solely by absorption."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08247 "Internal absorbance is used to term absorbance corrected for other processes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08247 goldbook:08261)
AnnotationAssertion(rdfs:seeAlso goldbook:08247 goldbook:08281)
AnnotationAssertion(mito:isMentionedBy goldbook:08247 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08247 "current"^^xsd:string)
Declaration(Class(goldbook:08248))
AnnotationAssertion(rdfs:label goldbook:08248 "folding")
AnnotationAssertion(dcterms:description goldbook:08248 "The appearance of peaks at incorrect frequencies in a mathematically-processed spectrum due to insufficient density of datapoints in the time-domain spectrum or from peaks outside of the sampled frequency range.This process can be simulated by folding a spectrum that shows the correct wavenumbers back onto itself at \\(\\tilde{ u}_{\\rm{M}}\\) and its multiples.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08248 "aliasing")
AnnotationAssertion(rdfs:comment goldbook:08248 "Folding is a consequence of undersampling in spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08248 "In vibrational spectroscopy, when a spectrum is sampled correctly only up to a wavenumber \\(\\tilde{\\nu}_{\\rm{M}}\\), radiation of wavenumber \\(\\tilde{\\nu} \\gt \\tilde{\\nu}_{\\rm{M}}\\) appears to have a wavenumber between 0 and \\(\\tilde{\\nu}_{\\rm{M}}\\), per the table below:"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08248 goldbook:08275)
AnnotationAssertion(rdfs:seeAlso goldbook:08248 goldbook:08297)
AnnotationAssertion(rdfs:seeAlso goldbook:08248 goldbook:08708)
AnnotationAssertion(rdfs:seeAlso goldbook:08248 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08248 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08248 "current"^^xsd:string)
Declaration(Class(goldbook:08249))
AnnotationAssertion(rdfs:label goldbook:08249 "free induction decay")
AnnotationAssertion(dcterms:description goldbook:08249 "Indication from a pulsed spectroscopy experiment that takes the form of damped sine waves arising from the excited system returning to equilibrium.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08249 "FID")
AnnotationAssertion(rdfs:comment goldbook:08249 "In nuclear magnetic resonance spectroscopy, the FID consists of sine waves oscillating at the Larmor angular frequency (\\(\\omega\\)) and dampened by net dephasing time relaxation (\\(T_{2}^{*}\\)), \\(\\sin (\\omega t) \\exp(-t/T_{2}^{*})\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08249 goldbook:08375)
AnnotationAssertion(rdfs:seeAlso goldbook:08249 goldbook:08380)
AnnotationAssertion(rdfs:seeAlso goldbook:08249 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08249 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08249 "current"^^xsd:string)
Declaration(Class(goldbook:08250))
AnnotationAssertion(rdfs:label goldbook:08250 "Fresnel reflection")
AnnotationAssertion(dcterms:description goldbook:08250 "Reflection of radiation from a surface that is smooth and large with respect to the wavelength of the radiation. A reflected beam, of intensity governed by the Fresnel equations, is produced at an angle of reflection equal to the angle of incidence.")
AnnotationAssertion(rdfs:comment goldbook:08250 "May be termed specular reflection for non-scattering samples."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08250 goldbook:08281)
AnnotationAssertion(rdfs:seeAlso goldbook:08250 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08250 goldbook:08292)
AnnotationAssertion(rdfs:seeAlso goldbook:08250 goldbook:08299)
AnnotationAssertion(mito:isMentionedBy goldbook:08250 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08250 "current"^^xsd:string)
Declaration(Class(goldbook:08252))
AnnotationAssertion(rdfs:label goldbook:08252 "Gaussian band")
AnnotationAssertion(dcterms:description goldbook:08252 "Spectral band with the shape \\(H_{\\rm{G}} \\exp[-4\\ln 2{(\\tilde{ u} - \\tilde{ u}_{0})}^{2}/W^{2}]\\), where \\(H_{\\rm{G}}\\) is the band maximum (peak height), \\(W\\) is the full width at half maximum, and \\(\\tilde{ u}_{0}\\) is the peak wavenumber.")
AnnotationAssertion(rdfs:seeAlso goldbook:08252 goldbook:08285)
AnnotationAssertion(rdfs:seeAlso goldbook:08252 goldbook:08251)
AnnotationAssertion(rdfs:seeAlso goldbook:08252 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08252 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08252 "current"^^xsd:string)
Declaration(Class(goldbook:08253))
AnnotationAssertion(rdfs:label goldbook:08253 "Hadamard transform spectrometer")
AnnotationAssertion(dcterms:description goldbook:08253 "Multiplexing spectrometer that uses the optical components of a dispersive spectrometer with a Hadamard encoding mask.")
AnnotationAssertion(rdfs:seeAlso goldbook:08253 goldbook:08240)
AnnotationAssertion(mito:isMentionedBy goldbook:08253 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08253 "current"^^xsd:string)
Declaration(Class(goldbook:08255))
AnnotationAssertion(rdfs:label goldbook:08255 "high-pass filter")
AnnotationAssertion(dcterms:description goldbook:08255 "Optical filter that excludes radiation of wavenumber lower (wavelength higher) than a certain value and passes radiation of wavenumber above (wavelength lower) than this value. Electrical filter that blocks signal with a modulation frequency lower than a certain cut-on value and passes signals of frequency above this value.")
AnnotationAssertion(rdfs:seeAlso goldbook:08255 goldbook:08268)
AnnotationAssertion(rdfs:seeAlso goldbook:08255 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08255 goldbook:08300)
AnnotationAssertion(rdfs:seeAlso goldbook:08255 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08255 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08255 "current"^^xsd:string)
Declaration(Class(goldbook:08256))
AnnotationAssertion(rdfs:label goldbook:08256 "Hilbert transforms")
AnnotationAssertion(dcterms:description goldbook:08256 "Functions that interrelate the real part, \\(f'\\), and imaginary part, \\(f''\\), of the refractive index, \\(\\boldsymbol{\\hat{n}} = n + {\\rm{i}}k\\), or relative permittivity, \\(\\boldsymbol{\\hat{\\epsilon}} = \\epsilon' + \\rm{i}\\epsilon''\\), through \\[f'(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}' = \\frac{1}{\\pi} P \\int_{-\\infty}^{\\infty} \\frac{f''(\\tilde{ u})}{\\tilde{ u} - \\tilde{ u}_{\\rm{a}}}\\rm{d}\\tilde{ u}\\] \\[f''(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}' = \\frac{-1}{\\pi} P \\int_{-\\infty}^{\\infty} \\frac{f'(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}'}{\\tilde{ u} - \\tilde{ u}_{\\rm{a}}}\\rm{d}\\tilde{ u}\\] where \\(P\\) means that the principal part of the integral is taken at the singularity.")
AnnotationAssertion(mito:isMentionedBy goldbook:08256 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08256 "current"^^xsd:string)
Declaration(Class(goldbook:08257))
AnnotationAssertion(rdfs:label goldbook:08257 "instrument line shape")
AnnotationAssertion(dcterms:description goldbook:08257 "Idealized form of a feature in a spectrometer corresponding to a transition.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08257 "ILS")
AnnotationAssertion(rdfs:comment goldbook:08257 "Ideal line shapes include Lorentzian, Gaussian, and Voigt functions, whose parameters are the line position, maximum height, and half-width."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08257 "For Fourier-transform spectra, ILS varies with the apodization function used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08257 goldbook:08252)
AnnotationAssertion(rdfs:seeAlso goldbook:08257 goldbook:08298)
AnnotationAssertion(rdfs:seeAlso goldbook:08257 goldbook:08225)
AnnotationAssertion(rdfs:seeAlso goldbook:08257 goldbook:08254)
AnnotationAssertion(mito:isMentionedBy goldbook:08257 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08257 "current"^^xsd:string)
Declaration(Class(goldbook:08258))
AnnotationAssertion(rdfs:label goldbook:08258 "integrated intensity")
AnnotationAssertion(dcterms:description goldbook:08258 "Area under a spectral band in an absorption spectrum where the absorption is linearly proportional to the amount of absorber in unit area.")
AnnotationAssertion(rdfs:comment goldbook:08258 "The area under a band in a transmittance spectrum is not linearly proportional to the amount of absorber."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08258 "The absorption quantity is usually a Beer-Lambert absorption coefficient, but recently \\(\\tilde{\\nu} \\alpha_{\\rm{m}}''(\\tilde{\\nu})\\), the wavenumber times the imaginary part of local molar polarizability, has been used for neat liquids to correct for dielectric effects."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08258 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08258 goldbook:08285)
AnnotationAssertion(rdfs:seeAlso goldbook:08258 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08258 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08258 "current"^^xsd:string)
Declaration(Class(goldbook:08259))
AnnotationAssertion(rdfs:label goldbook:08259 "integration range")
AnnotationAssertion(dcterms:description goldbook:08259 "Frequency or wavenumber range over which the integrated intensity of an absorption band is measured by numerical integration of the area under the band.")
AnnotationAssertion(rdfs:comment goldbook:08259 "For Gaussian bands, integration over one full width half maximum to each side of the band centre yields \\(\\pu{98\\%}\\) of the area under the band."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08259 "Lorentzian bands integration over \\(\\pu{3.1}\\) or \\(\\pu{15.9}\\) full width half maximum to each side yields \\(\\pu{90\\%}\\) and \\(\\pu{98\\%}\\) of the band area."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08259 goldbook:08252)
AnnotationAssertion(rdfs:seeAlso goldbook:08259 goldbook:08285)
AnnotationAssertion(rdfs:seeAlso goldbook:08259 goldbook:08251)
AnnotationAssertion(rdfs:seeAlso goldbook:08259 goldbook:08258)
AnnotationAssertion(rdfs:seeAlso goldbook:08259 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08259 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08259 "current"^^xsd:string)
Declaration(Class(goldbook:08260))
AnnotationAssertion(rdfs:label goldbook:08260 "intensified charge coupled device detector")
AnnotationAssertion(dcterms:description goldbook:08260 "Charge coupled device with a prior amplification system to improve sensitivity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08260 "ICCD")
AnnotationAssertion(rdfs:comment goldbook:08260 "The intensifier used is based on a microchannel plate (MCP), which converts the incoming photons to electrons by means of a photocathode. Generated electrons are multiplied in a second step by the MCP and then reconverted to photons using a phosphorous screen. Finally, derived photons are detected with a CCD device."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08260 goldbook:08230)
AnnotationAssertion(mito:isMentionedBy goldbook:08260 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08260 "current"^^xsd:string)
Declaration(Class(goldbook:08261))
AnnotationAssertion(rdfs:label goldbook:08261 "internal absorbance")
AnnotationAssertion(dcterms:description goldbook:08261 "Absorbance in the absence of reflection, scattering or luminescence.")
AnnotationAssertion(rdfs:comment goldbook:08261 "Internal absorbance is a rarely used term in quantitative absolute intensity studies to emphasize that the necessary corrections of the transmittance for reflection and other cell effects have been made. Instrument manufacturers usually use the raw, uncorrected transmittance when calculating the absorbance. See experimental absorbance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08261 "Formally, \\(A_{\\rm{i}} = -\\log_{10}(1 - \\alpha_{\\rm{i}})\\), \\(A_{\\rm{i}} = -\\log_{10}(T_{\\rm{i}})\\) for a sample that does not scatter or luminesce, where \\(A_{\\rm{i}}\\) is the internal absorptance and \\(T_{\\rm{i}}\\) is the internal transmittance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08261 goldbook:08247)
AnnotationAssertion(rdfs:seeAlso goldbook:08261 goldbook:08262)
AnnotationAssertion(rdfs:seeAlso goldbook:08261 goldbook:08281)
AnnotationAssertion(mito:isMentionedBy goldbook:08261 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08261 "current"^^xsd:string)
Declaration(Class(goldbook:08263))
AnnotationAssertion(rdfs:label goldbook:08263 "Kramers–Kronig transforms")
AnnotationAssertion(dcterms:description goldbook:08263 "Functions based on the physical principle of causality that interconvert the real and imaginary parts of complex optical quantities when they are known over a sufficiently wide (strictly infinite) wavenumber range. They are frequently used to interconvert the real part, \\(f'\\), and imaginary part, \\(f''\\), of the refractive index, \\(\\boldsymbol{\\hat{n}} = n + {\\rm{i}}k\\), the dielectric constant (relative permittivity), \\(\\boldsymbol{\\hat{\\epsilon}_{r}} = \\epsilon_{r}' + \\rm{i}\\epsilon_{r}''\\), or the logarithm of the complex reflection coefficient \\(re^{i\\varphi}\\) through \\[f'(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}' = \\frac{2}{\\pi} P \\int_{0}^{\\infty} \\frac{\\tilde{ u} f''(\\tilde  u)}{\\tilde{ u}^{2} - \\tilde{ u}_{\\rm{a}}^{2}} {\\rm{d}}\\tilde{ u}\\] \\[f''(\\tilde{ u}_{\\rm{a}}) = \\frac{-2\\tilde{ u}_{\\rm{a}}}{\\pi} P \\int_{0}^{\\infty} \\frac{f'(\\tilde{ u}) - f_{\\infty}'}{\\tilde{ u}^2 - \\tilde{ u}_{\\rm{a}}^2} \\rm{d}\\tilde{ u}\\] where \\(P\\) means that the principal part of the integral is taken at the singularity.")
AnnotationAssertion(rdfs:comment goldbook:08263 "All functions used to model vibrational spectra obey the Kramers–Kronig transforms as long as the real parts are even functions of wavenumber and the imaginary parts are odd functions of wavenumber, so that the Kramers–Kronig transforms are equivalent to the Hilbert transforms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08263 goldbook:08256)
AnnotationAssertion(rdfs:seeAlso goldbook:08263 goldbook:08708)
AnnotationAssertion(rdfs:seeAlso goldbook:08263 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08263 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08263 "current"^^xsd:string)
Declaration(Class(goldbook:08264))
AnnotationAssertion(rdfs:label goldbook:08264 "light")
AnnotationAssertion(dcterms:description goldbook:08264 "Electromagnetic radiation visible to the human eye.")
AnnotationAssertion(rdfs:comment goldbook:08264 "In general, spectroscopic usage, 'light' is synonymous with 'radiation' when the specific wavelength is not relevant."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08264 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08264 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08264 "current"^^xsd:string)
Declaration(Class(goldbook:08265))
AnnotationAssertion(rdfs:label goldbook:08265 "linear Napierian absorption coefficient")
AnnotationAssertion(dcterms:description goldbook:08265 "Napierian absorbance (\\(A_{\\rm{e}}\\)) divided by path-length (\\(l\\)). \\(\\alpha = A_{\\rm{e}}/l\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08265 "absorption coefficient")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08265 "Napierian absorption coefficient")
AnnotationAssertion(rdfs:comment goldbook:08265 "\\(\\alpha\\) is the reciprocal of the optical absorption depth."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08265 goldbook:08272)
AnnotationAssertion(rdfs:seeAlso goldbook:08265 goldbook:08270)
AnnotationAssertion(rdfs:seeAlso goldbook:08265 goldbook:08269)
AnnotationAssertion(rdfs:seeAlso goldbook:08265 goldbook:08650)
AnnotationAssertion(mito:isMentionedBy goldbook:08265 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08265 "current"^^xsd:string)
Declaration(Class(goldbook:08266))
AnnotationAssertion(rdfs:label goldbook:08266 "liquid crystal tunable filter")
AnnotationAssertion(dcterms:description goldbook:08266 "Optical device based on polarization interference caused by transmission through a series of birefringent liquid crystal layers of different thicknesses that allow a narrow wavelength region to be selected and tuned over a broad spectral range.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08266 "LCTF")
AnnotationAssertion(rdfs:seeAlso goldbook:08266 goldbook:08299)
AnnotationAssertion(mito:isMentionedBy goldbook:08266 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08266 "current"^^xsd:string)
Declaration(Class(goldbook:08267))
AnnotationAssertion(rdfs:label goldbook:08267 "lock-in amplifier")
AnnotationAssertion(dcterms:description goldbook:08267 "Amplifier that amplifies only those signals that have, within a specified spectral bandwidth, the same frequency as, and a specified phase relation with, the selected reference signal.")
AnnotationAssertion(rdfs:seeAlso goldbook:08267 goldbook:08286)
AnnotationAssertion(mito:isMentionedBy goldbook:08267 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08267 "current"^^xsd:string)
Declaration(Class(goldbook:08268))
AnnotationAssertion(rdfs:label goldbook:08268 "low-pass filter")
AnnotationAssertion(dcterms:description goldbook:08268 "Optical filter that excludes radiation of wavenumber greater (wavelength lower) than a certain value and passes radiation of wavenumber below (wavelength greater than) this value. Electrical filter that blocks signal with a modulation frequency above a certain cut-on value and passes signals of frequency below this value.")
AnnotationAssertion(rdfs:seeAlso goldbook:08268 goldbook:08255)
AnnotationAssertion(rdfs:seeAlso goldbook:08268 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08268 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08268 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08268 "current"^^xsd:string)
Declaration(Class(goldbook:08269))
AnnotationAssertion(rdfs:label goldbook:08269 "molar decadic absorption coefficient")
AnnotationAssertion(dcterms:description goldbook:08269 "Decadic absorbance (\\(A_{10}\\)) divided by path-length (\\(l\\)) and amount concentration (\\(c\\)). \\(\\varepsilon = A_{10}/(cl)\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08269 "molar absorption coefficient")
AnnotationAssertion(rdfs:comment goldbook:08269 "'Extinction coefficient' or 'molar absorptivity' have been widely used for the molar absorption coefficient, unfortunately often with values given in ill-defined units. Use of these terms has been discouraged since the 1960s, when international agreement with non-chemical societies reserved the word where the absorption is linearly proportional to the amount of absorber in unit area 'extinction' for diffusion of radiation, i.e., the sum of the effects of absorption, scattering and luminescence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08269 goldbook:08265)
AnnotationAssertion(rdfs:seeAlso goldbook:08269 goldbook:08270)
AnnotationAssertion(mito:isMentionedBy goldbook:08269 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08269 "current"^^xsd:string)
Declaration(Class(goldbook:08270))
AnnotationAssertion(rdfs:label goldbook:08270 "molar Napierian absorption coefficient")
AnnotationAssertion(dcterms:description goldbook:08270 "Napierian absorbance (\\(A_{\\rm{e}}\\)) divided by path-length (\\(l\\)) and amount concentration (\\(c\\)). \\(\\kappa = A_{\\rm{e}}/(cl)\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08270 "absorption coefficient")
AnnotationAssertion(rdfs:seeAlso goldbook:08270 goldbook:08272)
AnnotationAssertion(rdfs:seeAlso goldbook:08270 goldbook:08265)
AnnotationAssertion(rdfs:seeAlso goldbook:08270 goldbook:08269)
AnnotationAssertion(mito:isMentionedBy goldbook:08270 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08270 "current"^^xsd:string)
Declaration(Class(goldbook:08271))
AnnotationAssertion(rdfs:label goldbook:08271 "multiple attenuated total reflection")
AnnotationAssertion(dcterms:description goldbook:08271 "Process in which attenuated total reflection occurs sequentially several times with the same sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08271 "MATR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08271 "frustrated multiple internal reflection (FMIR)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08271 "multiple internal reflection (MIR)")
AnnotationAssertion(rdfs:seeAlso goldbook:08271 goldbook:08227)
AnnotationAssertion(mito:isMentionedBy goldbook:08271 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08271 "current"^^xsd:string)
Declaration(Class(goldbook:08272))
AnnotationAssertion(rdfs:label goldbook:08272 "Napierian absorbance")
AnnotationAssertion(dcterms:description goldbook:08272 "Absorbance calculated with logarithm base \\(e\\) (natural or Napierian logarithm).")
AnnotationAssertion(rdfs:comment goldbook:08272 "Confusion with the decadic absorbance must be avoided."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08272 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08272 "current"^^xsd:string)
Declaration(Class(goldbook:08273))
AnnotationAssertion(rdfs:label goldbook:08273 "net absorption cross-section")
AnnotationAssertion(dcterms:description goldbook:08273 "Molar Napierian absorption coefficient divided by the Avogadro constant. \\(\\sigma_{\\rm{net}} = \\kappa/N_{\\rm{A}}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08273 "absorption cross-section ($\\upsigma$)")
AnnotationAssertion(rdfs:seeAlso goldbook:08273 goldbook:08270)
AnnotationAssertion(mito:isMentionedBy goldbook:08273 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08273 "current"^^xsd:string)
Declaration(Class(goldbook:08274))
AnnotationAssertion(rdfs:label goldbook:08274 "nominal spectral resolution")
AnnotationAssertion(dcterms:description goldbook:08274 "Spectral resolution setting on an instrument that a user sets to record a spectrum.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08274 "nominal resolution")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08274 "resolution")
AnnotationAssertion(rdfs:comment goldbook:08274 "The actual resolution achieved is related to this, to the width of the bands studied and to the alignment of the instrument."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08274 goldbook:08289)
AnnotationAssertion(rdfs:seeAlso goldbook:08274 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08274 goldbook:08286)
AnnotationAssertion(mito:isMentionedBy goldbook:08274 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08274 "current"^^xsd:string)
Declaration(Class(goldbook:08275))
AnnotationAssertion(rdfs:label goldbook:08275 "Nyquist criterion")
AnnotationAssertion(dcterms:description goldbook:08275 "Result of information theory that a sine wave can be completely reconstructed if its ordinate is known at two or more points in a cycle.")
AnnotationAssertion(mito:isMentionedBy goldbook:08275 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08275 "current"^^xsd:string)
Declaration(Class(goldbook:08276))
AnnotationAssertion(rdfs:label goldbook:08276 "Nyquist frequency")
AnnotationAssertion(dcterms:description goldbook:08276 "Highest frequency or wavenumber that can be characterized by sampling at a given rate in order to be able to fully reconstruct the signal without artefacts.")
AnnotationAssertion(rdfs:comment goldbook:08276 "The Nyquist sampling theorem states that an FID or interferogram must be sampled at a rate at least twice the highest frequency in the FID or interferogram in order to reproduce the correct frequencies in an NMR or Fourier-transform infrared spectrum, respectively, without folding (folding (in spectroscopy)) artefacts. \\(f_{\\rm{Nyquist}} = &half;\\nu\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08276 goldbook:08275)
AnnotationAssertion(rdfs:seeAlso goldbook:08276 goldbook:08248)
AnnotationAssertion(rdfs:seeAlso goldbook:08276 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08276 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08276 "current"^^xsd:string)
Declaration(Class(goldbook:08277))
AnnotationAssertion(rdfs:label goldbook:08277 "optical throughput")
AnnotationAssertion(dcterms:description goldbook:08277 "Volume in phase space, a function of the area of the emitting source (\\(S\\)) and the solid angle into which it propagates \\((\\mathit{\\Omega}).{\\rm{d}}^{2} G = {\\rm{d}}S {\\rm{d}}\\mathit{\\Omega}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08277 "étendue")
AnnotationAssertion(mito:isMentionedBy goldbook:08277 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08277 "current"^^xsd:string)
Declaration(Class(goldbook:08278))
AnnotationAssertion(rdfs:label goldbook:08278 "path-length")
AnnotationAssertion(dcterms:description goldbook:08278 "Length of the optical path through the sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08278 "path length")
AnnotationAssertion(rdfs:comment goldbook:08278 "In a transmission cell the path-length is usually taken as the distance between the windows."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08278 "SI unit: \\(\\pu{m}\\). Commonly used units: \\(\\pu{\\upmu m}\\), \\(\\pu{mm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08278 goldbook:08653)
AnnotationAssertion(mito:isMentionedBy goldbook:08278 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08278 "current"^^xsd:string)
Declaration(Class(goldbook:08279))
AnnotationAssertion(rdfs:label goldbook:08279 "radiofrequency")
AnnotationAssertion(dcterms:description goldbook:08279 "Frequency or band of frequencies in the range \\(\\pu{E4}\\) to \\(\\pu{E12 Hz}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08279 "RF")
AnnotationAssertion(mito:isMentionedBy goldbook:08279 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08279 "current"^^xsd:string)
Declaration(Class(goldbook:08280))
AnnotationAssertion(rdfs:label goldbook:08280 "received radiant flux density")
AnnotationAssertion(dcterms:description goldbook:08280 "Radiant power incident on unit area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08280 "incident flux density")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08280 "irradiance")
AnnotationAssertion(rdfs:comment goldbook:08280 "SI unit: \\(\\pu{W m-2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08280 "In atomic absorption spectroscopy incident flux density at a given wavelength is given the symbol \\(\\phi_{0}(\\lambda)\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08280 goldbook:08451)
AnnotationAssertion(rdfs:seeAlso goldbook:08280 goldbook:08299)
AnnotationAssertion(mito:isMentionedBy goldbook:08280 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08280 "current"^^xsd:string)
Declaration(Class(goldbook:08281))
AnnotationAssertion(rdfs:label goldbook:08281 "reflection")
AnnotationAssertion(dcterms:description goldbook:08281 "Process by which electromagnetic radiation is reflected by a sample. For non-scattering samples the term means Fresnel reflection; for scattering samples the term includes regular reflection and volume reflection or diffuse reflection.")
AnnotationAssertion(rdfs:seeAlso goldbook:08281 goldbook:08250)
AnnotationAssertion(rdfs:seeAlso goldbook:08281 goldbook:08236)
AnnotationAssertion(rdfs:seeAlso goldbook:08281 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08281 goldbook:08710)
AnnotationAssertion(mito:isMentionedBy goldbook:08281 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08281 "current"^^xsd:string)
Declaration(Class(goldbook:08282))
AnnotationAssertion(rdfs:label goldbook:08282 "signal-to-noise ratio")
AnnotationAssertion(dcterms:description goldbook:08282 "Power of signal divided by power of noise.")
AnnotationAssertion(rdfs:comment goldbook:08282 "When signal and noise are measured across the same impedance, SNR is often calculated as the root-mean-squared amplitude of the signal divided by the root-mean-squared amplitude of the noise."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08282 "The value of signal-to-noise ratio may be expressed in decibel (\\(\\rm{SNR}_{\\rm{dB}}\\)) as ten times the logarithm to base 10 of signal-to-noise ratio."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08282 "Initialisms should not be used to denote a quantity in expressions and formulae. \\(R_{\\rm{S/N}}\\) is recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08282 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08282 "current"^^xsd:string)
Declaration(Class(goldbook:08283))
AnnotationAssertion(rdfs:label goldbook:08283 "single beam spectrum")
AnnotationAssertion(dcterms:description goldbook:08283 "Output of a single beam spectrometer as a function of wavenumber or wavelength.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08283 "intensity spectrum")
AnnotationAssertion(rdfs:comment goldbook:08283 "A single-beam spectrum is often termed an 'intensity spectrum' (the measured radiant power is the intensity times the area of the detector) and does not have a flat baseline."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08283 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08283 goldbook:08299)
AnnotationAssertion(rdfs:seeAlso goldbook:08283 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08283 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08283 "current"^^xsd:string)
Declaration(Class(goldbook:08284))
AnnotationAssertion(rdfs:label goldbook:08284 "slit width")
AnnotationAssertion(dcterms:description goldbook:08284 "Distance between the blades of the entrance or exit slits in a monochromator.")
AnnotationAssertion(rdfs:comment goldbook:08284 "Spectral slit width is the range of wavenumbers/wavelengths or frequencies that the physical slit widths allow to be passed by the monochromator and is often determined as the full width at half maximum measured by the instrument for a line that is known to be extremely sharp."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08284 goldbook:08251)
AnnotationAssertion(rdfs:seeAlso goldbook:08284 goldbook:08299)
AnnotationAssertion(rdfs:seeAlso goldbook:08284 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08284 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08284 "current"^^xsd:string)
Declaration(Class(goldbook:08285))
AnnotationAssertion(rdfs:label goldbook:08285 "spectral band")
AnnotationAssertion(dcterms:description goldbook:08285 "Region of the absorption/transmission spectrum in which the absorbance/transmission passes through a maximum/minimum.")
AnnotationAssertion(rdfs:comment goldbook:08285 "The use of the term \"spectral band\" implies a wider region of the spectrum than \"spectral line\" (see spectral line of an atom)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08285 goldbook:08550)
AnnotationAssertion(mito:isMentionedBy goldbook:08285 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08285 "current"^^xsd:string)
Declaration(Class(goldbook:08286))
AnnotationAssertion(rdfs:label goldbook:08286 "spectral bandwidth")
AnnotationAssertion(dcterms:description goldbook:08286 "Upper frequency minus lower frequency in a continuous band of frequencies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08286 "bandwidth")
AnnotationAssertion(rdfs:comment goldbook:08286 "SI unit: hertz, \\(\\pu{Hz}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08286 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08286 "current"^^xsd:string)
Declaration(Class(goldbook:08287))
AnnotationAssertion(rdfs:label goldbook:08287 "spectral radiant energy density")
AnnotationAssertion(dcterms:description goldbook:08287 "Radiant energy density in unit wavenumber (wavelength) interval at wavenumber \\(\\tilde{ u}\\) (wavelength \\(\\lambda\\)).")
AnnotationAssertion(rdfs:comment goldbook:08287 "SI unit: \\(\\pu{J m-2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08287 goldbook:08299)
AnnotationAssertion(rdfs:seeAlso goldbook:08287 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08287 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08287 "current"^^xsd:string)
Declaration(Class(goldbook:08288))
AnnotationAssertion(rdfs:label goldbook:08288 "spectral range")
AnnotationAssertion(dcterms:description goldbook:08288 "Wavelength range for which a spectrometer can be used.")
AnnotationAssertion(rdfs:comment goldbook:08288 "Spectral range depends essentially on the radiation source, the optical components of the wavelength selector, and the detector."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08288 goldbook:08299)
AnnotationAssertion(mito:isMentionedBy goldbook:08288 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08288 "current"^^xsd:string)
Declaration(Class(goldbook:08289))
AnnotationAssertion(rdfs:label goldbook:08289 "spectral resolution")
AnnotationAssertion(dcterms:description goldbook:08289 "Smallest difference between wavenumbers (or wavelengths or frequencies) at which different spectral properties may be distinguished, measured as the full width at half maximum.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08289 "resolution")
AnnotationAssertion(rdfs:comment goldbook:08289 "An equivalent definition is the minimum separation of two infinitely sharp lines of equal intensity of radiation that allows the presence of two lines to be seen in the measured spectrum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08289 "Resolution depends strongly on the instrument line shape \"function\" of the spectrometer and on the natural line width."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08289 goldbook:08251)
AnnotationAssertion(rdfs:seeAlso goldbook:08289 goldbook:08257)
AnnotationAssertion(rdfs:seeAlso goldbook:08289 goldbook:08641)
AnnotationAssertion(rdfs:seeAlso goldbook:08289 goldbook:08274)
AnnotationAssertion(rdfs:seeAlso goldbook:08289 goldbook:08299)
AnnotationAssertion(rdfs:seeAlso goldbook:08289 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08289 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08289 "current"^^xsd:string)
Declaration(Class(goldbook:08290))
AnnotationAssertion(rdfs:label goldbook:08290 "spectral subtraction")
AnnotationAssertion(dcterms:description goldbook:08290 "Ordinate of one spectrum minus ordinate of another spectrum.")
AnnotationAssertion(rdfs:comment goldbook:08290 "Spectral subtraction may be used to improve the ability to detect of minor components in the spectrum of a mixture."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08290 "Successful use of the technique requires spectra, such as absorbance and Raman spectra, in which the ordinate is linear in concentration; a precisely agreeing wavenumber scale; and a very high signal-to-noise ratio."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08290 goldbook:08670)
AnnotationAssertion(rdfs:seeAlso goldbook:08290 goldbook:08282)
AnnotationAssertion(rdfs:seeAlso goldbook:08290 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08290 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08290 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08290 "current"^^xsd:string)
Declaration(Class(goldbook:08291))
AnnotationAssertion(rdfs:label goldbook:08291 "spectrum")
AnnotationAssertion(dcterms:description goldbook:08291 "Graph of a quantity derived from the radiant power at each wavelength (frequency or wavenumber) as ordinate plotted against the wavelength (frequency or wavenumber) of electromagnetic radiation as abscissa.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08291 "vibrational spectrum")
AnnotationAssertion(rdfs:comment goldbook:08291 "In mid-infrared and Raman spectroscopy, wavenumber is mostly used today, while it is more commonly replaced by wavelength in near infrared spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08291 "Quantities plotted include absorbance, absorption coefficient, transmittance, reflectance, luminescence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08291 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08291 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08291 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08291 goldbook:08642)
AnnotationAssertion(rdfs:seeAlso goldbook:08291 goldbook:08300)
AnnotationAssertion(rdfs:seeAlso goldbook:08291 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08291 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08291 "current"^^xsd:string)
Declaration(Class(goldbook:08292))
AnnotationAssertion(rdfs:label goldbook:08292 "specular reflection")
AnnotationAssertion(dcterms:description goldbook:08292 "Reflection of electromagnetic radiation from a surface such that each incident ray is reflected at the same angle to the surface normal as the incident ray, but on the opposing side of the surface normal in the plane formed by incident and reflected rays.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08292 "regular reflection")
AnnotationAssertion(rdfs:comment goldbook:08292 "An image reflected by the surface in this way is reproduced in mirror-like (specular) fashion."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08292 goldbook:08281)
AnnotationAssertion(rdfs:seeAlso goldbook:08292 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08292 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08292 "current"^^xsd:string)
Declaration(Class(goldbook:08293))
AnnotationAssertion(rdfs:label goldbook:08293 "stray light")
AnnotationAssertion(dcterms:description goldbook:08293 "Electromagnetic radiation that does not follow the usual path through a spectrometer and consequently appears in a spectrum at a frequency or wavenumber different from its initial value. The term is also used to refer to radiation that passes around the sample instead of through it, and consequently is not modified by the sample and seriously affects absolute and relative intensities.")
AnnotationAssertion(rdfs:seeAlso goldbook:08293 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08293 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08293 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08293 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08293 "current"^^xsd:string)
Declaration(Class(goldbook:08294))
AnnotationAssertion(rdfs:label goldbook:08294 "transmission spectrum")
AnnotationAssertion(dcterms:description goldbook:08294 "General term for the spectrum of transmitted electromagnetic radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08294 "transmittance spectrum")
AnnotationAssertion(rdfs:comment goldbook:08294 "The ordinate quantity is usually the percentage of the incident radiation that is transmitted, usually called the percent transmission, with range \\(\\pu{0}\\) to \\(\\pu{100\\%}\\). If the ordinate quantity is the fraction transmitted, i.e., the transmittance, the ordinate range is \\(\\pu{0}\\) to \\(\\pu{1}\\) and the spectrum may be called a transmittance spectrum."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08294 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08294 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08294 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08294 "current"^^xsd:string)
Declaration(Class(goldbook:08295))
AnnotationAssertion(rdfs:label goldbook:08295 "two-dimensional correlation spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08295 "Measurement principle of spectroscopy in which spectra are recorded at different magnitudes of an applied external perturbation of the sample and are processed to yield a 2-D correlation spectrum.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08295 "2-D correlation spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:08295 "The external perturbation may be time dependent (chemical reactions, physical relaxation processes), or static (temperature change, concentration change)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08295 "Correlation spectroscopy is used in infrared spectroscopy, nuclear magnetic resonance spectroscopy (COSY, TOCSY), fluorescence spectroscopy and others."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08295 goldbook:08296)
AnnotationAssertion(rdfs:seeAlso goldbook:08295 goldbook:08323)
AnnotationAssertion(rdfs:seeAlso goldbook:08295 goldbook:08435)
AnnotationAssertion(rdfs:seeAlso goldbook:08295 goldbook:08454)
AnnotationAssertion(rdfs:seeAlso goldbook:08295 goldbook:08618)
AnnotationAssertion(rdfs:seeAlso goldbook:08295 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08295 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08295 "current"^^xsd:string)
Declaration(Class(goldbook:08296))
AnnotationAssertion(rdfs:label goldbook:08296 "two-dimensional correlation spectrum")
AnnotationAssertion(dcterms:description goldbook:08296 "Three-dimensional surface in which two of the dimensions show frequency axes (\\( u_{1}\\), \\( u_{2}\\)) and the third axis shows a correlation function of the spectral intensities observed at \\( u_{1}\\) and \\( u_{2}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08296 "2-D correlation spectrum")
AnnotationAssertion(rdfs:comment goldbook:08296 "The shape of the surface shows whether the bands at the two wavenumbers are or are not correlated, and hence allows deductions to be made about the extent to which the different parts of the molecule are linked in their response to the applied external perturbation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08296 goldbook:08590)
AnnotationAssertion(mito:isMentionedBy goldbook:08296 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08296 "current"^^xsd:string)
Declaration(Class(goldbook:08297))
AnnotationAssertion(rdfs:label goldbook:08297 "undersampling")
AnnotationAssertion(dcterms:description goldbook:08297 "Sampling less frequently than is required by the Nyquist criterion.")
AnnotationAssertion(rdfs:comment goldbook:08297 "Undersampling occurs when an analogue signal is digitized with less than two data points per wavelength of the shortest wavelength (highest wavenumber) radiation that reaches the detector."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08297 goldbook:08275)
AnnotationAssertion(rdfs:seeAlso goldbook:08297 goldbook:08248)
AnnotationAssertion(rdfs:seeAlso goldbook:08297 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08297 goldbook:08299)
AnnotationAssertion(rdfs:seeAlso goldbook:08297 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08297 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08297 "current"^^xsd:string)
Declaration(Class(goldbook:08298))
AnnotationAssertion(rdfs:label goldbook:08298 "Voigt function")
AnnotationAssertion(dcterms:description goldbook:08298 "Convolution of Gaussian and Lorentzian (Cauchy) functions.")
AnnotationAssertion(rdfs:seeAlso goldbook:08298 goldbook:08229)
AnnotationAssertion(rdfs:seeAlso goldbook:08298 goldbook:08252)
AnnotationAssertion(mito:isMentionedBy goldbook:08298 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08298 "current"^^xsd:string)
Declaration(Class(goldbook:08299))
AnnotationAssertion(rdfs:label goldbook:08299 "wavelength in medium")
AnnotationAssertion(dcterms:description goldbook:08299 "Distance travelled by a wave of electromagnetic radiation in one cycle in a non-absorbing medium of real refractive index \\(n\\). \\(\\lambda = \\lambda_{0}/n\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08299 "wavelength")
AnnotationAssertion(rdfs:comment goldbook:08299 "In spectroscopy, the unqualified term 'wavelength' frequently means the vacuum wavelength, and symbol \\(\\lambda\\) frequently means \\(\\lambda_{0}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08299 "SI unit: \\(\\pu{m}\\). Common unit: \\(\\pu{nm}\\) or \\(\\pu{\\upmu m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08299 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08299 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08299 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08299 "current"^^xsd:string)
Declaration(Class(goldbook:08300))
AnnotationAssertion(rdfs:label goldbook:08300 "wavelength in vacuum")
AnnotationAssertion(dcterms:description goldbook:08300 "Distance travelled by a wave of electromagnetic radiation in one cycle in vacuum.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08300 "vacuum wavelength")
AnnotationAssertion(rdfs:comment goldbook:08300 "SI unit: \\(\\pu{m}\\). Common unit: \\(\\pu{nm}\\) or \\(\\pu{\\upmu m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08300 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08300 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08300 "current"^^xsd:string)
Declaration(Class(goldbook:08301))
AnnotationAssertion(rdfs:label goldbook:08301 "wavenumber in medium")
AnnotationAssertion(dcterms:description goldbook:08301 "Reciprocal of wavelength of electromagnetic radiation. \\(\\sigma = 1/\\lambda\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08301 "wavenumber")
AnnotationAssertion(rdfs:comment goldbook:08301 "In spectroscopy, the unqualified term 'wavenumber' (sometimes referred to as \"reciprocal centimetre\" \\(\\pu{cm-1}\\)) often means vacuum wavenumber, and symbol \\(\\sigma\\) often means \\(\\tilde{\\nu}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08301 "SI unit: \\(\\pu{m-1}\\). Common unit: \\(\\pu{cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08301 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08301 goldbook:08302)
AnnotationAssertion(rdfs:seeAlso goldbook:08301 goldbook:08299)
AnnotationAssertion(mito:isMentionedBy goldbook:08301 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08301 "current"^^xsd:string)
Declaration(Class(goldbook:08302))
AnnotationAssertion(rdfs:label goldbook:08302 "wavenumber in vacuum")
AnnotationAssertion(dcterms:description goldbook:08302 "Reciprocal of the vacuum wavelength of electromagnetic radiation. \\(\\tilde{ u} = 1/\\lambda_{0}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08302 "vacuum wavenumber")
AnnotationAssertion(rdfs:comment goldbook:08302 "Wavenumber is related to the energy change, \\(\\Delta E\\), induced when the radiation is absorbed by \\(\\Delta E = hc_{0}\\tilde{\\nu}\\), where \\(h\\) is the Planck constant and \\(c_{0}\\) the speed of the radiation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08302 "Wavenumber should only be used when no confusion with frequency is possible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08302 "The symbol \\(\\nu\\) is often used instead of \\(\\tilde{\\nu}\\); this usage should be discouraged."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08302 "SI unit: \\(\\pu{m-1}\\). Common unit: \\(\\pu{cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08302 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08302 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08302 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08302 "current"^^xsd:string)
Declaration(Class(goldbook:08303))
AnnotationAssertion(rdfs:label goldbook:08303 "working range")
AnnotationAssertion(dcterms:description goldbook:08303 "Range of absorbance or intensity which a spectrometer can measure with accuracy and precision.")
AnnotationAssertion(rdfs:comment goldbook:08303 "Working range varies in different parts of the spectral range."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08303 goldbook:08288)
AnnotationAssertion(mito:isMentionedBy goldbook:08303 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08303 "current"^^xsd:string)
Declaration(Class(goldbook:08304))
AnnotationAssertion(rdfs:label goldbook:08304 "zero filling")
AnnotationAssertion(dcterms:description goldbook:08304 "Addition of zeros to a free induction decay or interferogram to decrease the frequency or wavenumber spacing between points in the Fourier-transformed spectrum.")
AnnotationAssertion(rdfs:seeAlso goldbook:08304 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08304 goldbook:08622)
AnnotationAssertion(rdfs:seeAlso goldbook:08304 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08304 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08304 "current"^^xsd:string)
Declaration(Class(goldbook:08305))
AnnotationAssertion(rdfs:label goldbook:08305 "zero path difference")
AnnotationAssertion(dcterms:description goldbook:08305 "In a Michelson interferometer or other two-beam interferometer, the position of the moving mirror at which the optical paths are equal.")
AnnotationAssertion(mito:isMentionedBy goldbook:08305 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08305 "current"^^xsd:string)
Declaration(Class(goldbook:08306))
AnnotationAssertion(rdfs:label goldbook:08306 "<sup>13</sup>C-HMQC-NOESY")
AnnotationAssertion(dcterms:description goldbook:08306 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08306 "In the initial HMQC step, magnetization is transferred from \\(\\ce{^{1}H}\\) to \\(\\ce{^{13}C}\\) and back again. This is then followed by a NOESY step in which the magnetization is transferred to any other hydrogen nucleus close by before detection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08306 "The technique requires \\(\\ce{^{13}C}\\) labelling."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08306 "The spectrum is used to obtain restraints for structure calculations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08306 goldbook:08387)
AnnotationAssertion(rdfs:seeAlso goldbook:08306 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08306 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08306 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08306 "current"^^xsd:string)
Declaration(Class(goldbook:08307))
AnnotationAssertion(rdfs:label goldbook:08307 "<sup>13</sup>C-NOESY-HSQC")
AnnotationAssertion(dcterms:description goldbook:08307 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08307 "Magnetization is exchanged between all hydrogens using the nuclear Overhauser effect before being transferred to neighbouring \\(\\ce{^{13}C}\\) nuclei and then back to \\(\\ce{^{1}H}\\) for detection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08307 "The spectrum is used to obtain restraints for structure calculations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08307 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08307 goldbook:08385)
AnnotationAssertion(rdfs:seeAlso goldbook:08307 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08307 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08307 "current"^^xsd:string)
Declaration(Class(goldbook:08308))
AnnotationAssertion(rdfs:label goldbook:08308 "<sup>15</sup>N-NOESY-HSQC")
AnnotationAssertion(dcterms:description goldbook:08308 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08308 "Magnetization is exchanged between all hydrogens using the nuclear Overhauser effect before being transferred to neighbouring \\(\\ce{^{15}N}\\) nuclei and then back to \\(\\ce{^{1}H}\\) for detection. This spectrum can be used to obtain restraints for structure calculations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08308 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08308 goldbook:08385)
AnnotationAssertion(rdfs:seeAlso goldbook:08308 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08308 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08308 "current"^^xsd:string)
Declaration(Class(goldbook:08309))
AnnotationAssertion(rdfs:label goldbook:08309 "<sup>15</sup>N-TOCSY-HSQC")
AnnotationAssertion(dcterms:description goldbook:08309 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08309 "An isotropic mixing step transfers magnetization between \\(\\ce{^{1}H}\\) spins. Then the magnetization is transferred to neighbouring \\(\\ce{^{15}N}\\) nuclei and back to \\(\\ce{^{1}H}\\) for detection. This can help identify amino acid types."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08309 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08309 goldbook:08435)
AnnotationAssertion(mito:isMentionedBy goldbook:08309 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08309 "current"^^xsd:string)
Declaration(Class(goldbook:08310))
AnnotationAssertion(rdfs:label goldbook:08310 "180° pulse")
AnnotationAssertion(dcterms:description goldbook:08310 "Pulsed radiofrequency signal in NMR that rotates the bulk magnetization vector (\\(\\boldsymbol{M}_{0}\\)) of a nuclear spin to its opposing direction, effectively inverting the signal, (e.g., from the \\(+z\\) to \\(-z\\) axis).")
AnnotationAssertion(rdfs:seeAlso goldbook:08310 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08310 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08310 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08310 "current"^^xsd:string)
Declaration(Class(goldbook:08311))
AnnotationAssertion(rdfs:label goldbook:08311 "90° pulse")
AnnotationAssertion(dcterms:description goldbook:08311 "Pulsed radiofrequency signal that rotates the bulk magnetization vector (\\(\\boldsymbol{M}_{0}\\)) of a nuclear spin to its orthogonal plane.")
AnnotationAssertion(rdfs:comment goldbook:08311 "In a simple 1D NMR experiment, this is from the \\(z\\) axis to the \\(xy\\) plane."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08311 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08311 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08311 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08311 "current"^^xsd:string)
Declaration(Class(goldbook:08312))
AnnotationAssertion(rdfs:label goldbook:08312 "acquisition time")
AnnotationAssertion(dcterms:description goldbook:08312 "Duration of the digitization of a free induction decay.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08312 "AT")
AnnotationAssertion(rdfs:comment goldbook:08312 "\\(t_{\\rm{a}} = &#189N/f_{\\rm{SW}}\\) with number of data points \\(N\\) and NMR spectral width \\(f_{\\rm{SW}}\\) ."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08312 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08312 goldbook:08336)
AnnotationAssertion(rdfs:seeAlso goldbook:08312 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08312 goldbook:08417)
AnnotationAssertion(mito:isMentionedBy goldbook:08312 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08312 "current"^^xsd:string)
Declaration(Class(goldbook:08313))
AnnotationAssertion(rdfs:label goldbook:08313 "adiabatic pulse")
AnnotationAssertion(dcterms:description goldbook:08313 "Radiofrequency pulse that inverts spins by using a frequency sweep during the pulse.")
AnnotationAssertion(rdfs:comment goldbook:08313 "Adiabatic pulse allows very high spectral bandwidth and accurate flip angles to be achieved with high tolerance to spatial variations in RF field intensity and is thus of value in excitation of nuclei with frequency ranges."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08313 "The sweep must be slow enough to satisfy the adiabatic condition \\({\\rm{d}}\\theta/{\\rm{d}}t \\ll \\gamma \\boldsymbol{B}_{\\rm{eff}}\\) where \\(\\boldsymbol{B}_{\\rm{eff}}\\) is the effective radiofrequency magnetic flux density and \\(\\theta\\) is the angle between \\(\\boldsymbol{B}_{\\rm{eff}}\\) and abscissa."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08313 goldbook:08279)
AnnotationAssertion(rdfs:seeAlso goldbook:08313 goldbook:08286)
AnnotationAssertion(mito:isMentionedBy goldbook:08313 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08313 "current"^^xsd:string)
Declaration(Class(goldbook:08314))
AnnotationAssertion(rdfs:label goldbook:08314 "Bloch equations")
AnnotationAssertion(dcterms:description goldbook:08314 "Set of coupled differential equations which can be used to describe the behaviour of a magnetization vector under any conditions.")
AnnotationAssertion(rdfs:comment goldbook:08314 "When properly integrated, Bloch equations yield \\(X'\\), \\(Y^{\\prime}\\), and \\(Z^{\\prime}\\) components of magnetization within the rotating frame of reference as a function of time."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08314 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08314 "current"^^xsd:string)
Declaration(Class(goldbook:08315))
AnnotationAssertion(rdfs:label goldbook:08315 "Bloch–Siegert shift")
AnnotationAssertion(dcterms:description goldbook:08315 "Frequency difference seen for a nuclear magnetic resonance signal when a radiofrequency field is applied during the acquisition time.")
AnnotationAssertion(rdfs:comment goldbook:08315 "The shift arises from the effective magnetic field generated by the applied RF field. The resonances are always moved away from the frequency of the irradiating field and are inversely proportional to the difference in frequency between the irradiation and the resonance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08315 goldbook:08312)
AnnotationAssertion(rdfs:seeAlso goldbook:08315 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08315 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08315 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08315 "current"^^xsd:string)
Declaration(Class(goldbook:08316))
AnnotationAssertion(rdfs:label goldbook:08316 "Boltzmann distribution of nuclear spins")
AnnotationAssertion(dcterms:description goldbook:08316 "Distribution of nuclear spins among their possible energy levels at thermal equilibrium.")
AnnotationAssertion(rdfs:comment goldbook:08316 "For a positive magnetogyric ratio, produces population excess (polarization) in the direction of \\(\\boldsymbol{B_{0}}\\). The population difference between the spin state can be expressed as \\[\\frac{N_i}{N} = \\frac{e^{-{\\varepsilon}_{i}/kT}}{\\sum_{j=1}^{M}{e}^{-{\\varepsilon}_{j}/kT}}\\] where \\(T\\) is the thermodynamic temperature, \\(k\\) is the Boltzmann constant, \\(N_{\\rm{i}}\\) is the number of spins in excited state \\(i\\), \\(N\\) is the total number of spins and \\(\\varepsilon_{i}\\) and \\(\\varepsilon_{j}\\) are the energies of states \\(i\\) and \\(j\\) respectively, and \\(M\\) is the number of possible energy levels."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08316 goldbook:08246)
AnnotationAssertion(mito:isMentionedBy goldbook:08316 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08316 "current"^^xsd:string)
Declaration(Class(goldbook:08317))
AnnotationAssertion(rdfs:label goldbook:08317 "CBCA(CO)NH/HN(CO)CACB")
AnnotationAssertion(dcterms:description goldbook:08317 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08317 "Magnetization is transferred from \\(\\ce{^{1}H\\upalpha}\\) and \\(\\ce{^{1}H\\upbeta}\\) to \\(\\ce{^{13}C\\upalpha}\\) and \\(\\ce{^{13}C\\upbeta}\\), respectively, and then from \\(\\ce{^{13}C\\upbeta}\\) to \\(\\ce{^{13}C\\upalpha}\\). From here it is transferred first to \\(\\ce{^{13}CO}\\), then to \\(\\ce{^{15}NH}\\) and then to \\(\\ce{^{1}HN}\\) for detection. Along with CBCANH and HSQC this forms the standard set of experiments needed for backbone assignment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08317 goldbook:08318)
AnnotationAssertion(rdfs:seeAlso goldbook:08317 goldbook:08358)
AnnotationAssertion(rdfs:seeAlso goldbook:08317 goldbook:08432)
AnnotationAssertion(mito:isMentionedBy goldbook:08317 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08317 "current"^^xsd:string)
Declaration(Class(goldbook:08318))
AnnotationAssertion(rdfs:label goldbook:08318 "CBCANH/HNCACB")
AnnotationAssertion(dcterms:description goldbook:08318 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08318 "Magnetization is transferred from \\(\\ce{^{1}H\\upalpha}\\) and \\(\\ce{^{1}H\\upbeta}\\) to \\(\\ce{^{13}C\\upalpha}\\) and \\(\\ce{^{13}C\\upbeta}\\), respectively, and then from \\(\\ce{^{13}C\\upbeta}\\) to \\(\\ce{^{13}C\\upalpha}\\). From here it is transferred first to \\(\\ce{^{15}NH}\\) and then to \\(\\ce{^{1}HN}\\) for detection. For each \\(\\ce{NH}\\) group there are two \\(\\ce{C\\upalpha}\\) and \\(\\ce{C\\upbeta}\\) peaks visible. Along with the CBCA(CO)NH and HSQC this forms the standard set of experiments needed for backbone assignment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08318 goldbook:08317)
AnnotationAssertion(rdfs:seeAlso goldbook:08318 goldbook:08358)
AnnotationAssertion(rdfs:seeAlso goldbook:08318 goldbook:08432)
AnnotationAssertion(mito:isMentionedBy goldbook:08318 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08318 "current"^^xsd:string)
Declaration(Class(goldbook:08319))
AnnotationAssertion(rdfs:label goldbook:08319 "CC(CO)NH")
AnnotationAssertion(dcterms:description goldbook:08319 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08319 "Magnetization is transferred from the side-chain hydrogen nuclei to their attached \\(\\ce{^{13}C}\\) nuclei. Then isotropic \\(\\ce{^{13}C}\\) mixing is used to transfer magnetization between the carbon nuclei. From here, magnetization is transferred to the carbonyl carbon, on to the amide nitrogen and finally the amide hydrogen for detection. The chemical shift is evolved simultaneously on all side-chain carbon nuclei, as well as on the amide nitrogen and hydrogen nuclei, resulting in a three-dimensional spectrum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08319 "This method is a useful spectrum for obtaining carbon side-chain assignment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08319 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08319 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08319 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08319 "current"^^xsd:string)
Declaration(Class(goldbook:08320))
AnnotationAssertion(rdfs:label goldbook:08320 "chemical shift anisotropy")
AnnotationAssertion(dcterms:description goldbook:08320 "Chemical shift difference between isotropic and anisotropic states in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08320 "CSA")
AnnotationAssertion(rdfs:comment goldbook:08320 "Nuclei which are part of a specific functional group resonate at different frequencies depending on shielding by the local electronic environment and thus can give information on their relative orientation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08320 "Chemical shift anisotropy also contributes to nuclear spin relaxation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08320 goldbook:08223)
AnnotationAssertion(rdfs:seeAlso goldbook:08320 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08320 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08320 "current"^^xsd:string)
Declaration(Class(goldbook:08321))
AnnotationAssertion(rdfs:label goldbook:08321 "combined rotation and multiple pulse spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08321 "Measurement method of nuclear magnetic resonance spectroscopy for obtaining high-resolution solid-state nuclear magnetic resonance spectra on nuclei with high gyromagnetic ratio such as \\(\\ce{^{1}H}\\) and \\(\\ce{^{19}F}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08321 "CRAMPS")
AnnotationAssertion(rdfs:comment goldbook:08321 "CRAMPS is based on coherent-averaging theory, which attempts to describe the time evolution of a system in terms of an average Hamiltonian derived from the density matrix formalism of quantum mechanics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08321 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08321 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08321 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08321 "current"^^xsd:string)
Declaration(Class(goldbook:08322))
AnnotationAssertion(rdfs:label goldbook:08322 "constant time evolution")
AnnotationAssertion(dcterms:description goldbook:08322 "Segment of a pulse sequence in nuclear magnetic resonance spectroscopy that allows evolution of chemical shift during a fixed time period rather than through the traditional symmetrical incremented delays.")
AnnotationAssertion(rdfs:seeAlso goldbook:08322 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08322 goldbook:08396)
AnnotationAssertion(mito:isMentionedBy goldbook:08322 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08322 "current"^^xsd:string)
Declaration(Class(goldbook:08323))
AnnotationAssertion(rdfs:label goldbook:08323 "correlation spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08323 "Homonuclear two-dimensional nuclear magnetic resonance spectroscopy correlation experiment showing cross peaks representing spin-spin coupling between pairs of nuclei.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08323 "COSY")
AnnotationAssertion(rdfs:comment goldbook:08323 "COSY is the simplest and original 2D experiment, but still one of the most common along with its many variations including those with multiple quantum filters, solvent suppression and optimization for long range couplings."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08323 "COSY is often used to show the spin-spin coupling between hydrogen nuclei 2 or 3 bonds apart (\\(\\ce{H,H}\\mbox{-}\\rm{COSY}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08323 goldbook:08324)
AnnotationAssertion(rdfs:seeAlso goldbook:08323 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08323 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08323 "current"^^xsd:string)
Declaration(Class(goldbook:08324))
AnnotationAssertion(rdfs:label goldbook:08324 "correlation spectroscopy through long-range coupling")
AnnotationAssertion(dcterms:description goldbook:08324 "Heteronuclear (typically \\(\\ce{^{13}C}\\)) detected long range 2D correlation experiment in nuclear magnetic resonance spectroscopy that has mostly been superseded by heteronuclear multiple bond correlation (HMBC) experiments and its variants.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08324 "COLOC")
AnnotationAssertion(rdfs:comment goldbook:08324 "COLOC is often used to show spin-spin coupling between hydrogen and carbon nuclei 2 and 3 bonds apart."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08324 goldbook:08323)
AnnotationAssertion(rdfs:seeAlso goldbook:08324 goldbook:08352)
AnnotationAssertion(rdfs:seeAlso goldbook:08324 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08324 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08324 "current"^^xsd:string)
Declaration(Class(goldbook:08325))
AnnotationAssertion(rdfs:label goldbook:08325 "correlation time")
AnnotationAssertion(dcterms:description goldbook:08325 "Parameter related to the mean time during which a molecule maintains its spatial geometry.")
AnnotationAssertion(rdfs:comment goldbook:08325 "For an internuclear vector, correlation time is approximately equal to the average time for it to rotate through an angle of one radian."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08325 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08325 "current"^^xsd:string)
Declaration(Class(goldbook:08326))
AnnotationAssertion(rdfs:label goldbook:08326 "cross polarization with magic angle spinning NMR")
AnnotationAssertion(dcterms:description goldbook:08326 "Combined use of cross polarization with magic-angle spinning for solid-state nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08326 "CP/MAS")
AnnotationAssertion(rdfs:seeAlso goldbook:08326 goldbook:08327)
AnnotationAssertion(rdfs:seeAlso goldbook:08326 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08326 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08326 "current"^^xsd:string)
Declaration(Class(goldbook:08327))
AnnotationAssertion(rdfs:label goldbook:08327 "cross polarization")
AnnotationAssertion(dcterms:description goldbook:08327 "Technique in solid-state nuclear magnetic resonance spectroscopy that enables polarization from abundant spins such as \\(\\ce{^{1}H}\\) or \\(\\ce{^{19}F}\\) to be transferred to dilute spins such as \\(\\ce{^{13}C}\\) or \\(\\ce{^{15}N}\\) to enhance signal-to-noise ratio.")
AnnotationAssertion(rdfs:comment goldbook:08327 "Cross polarization requires that nuclei are dipolar coupled to one another."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08327 goldbook:08282)
AnnotationAssertion(rdfs:seeAlso goldbook:08327 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08327 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08327 "current"^^xsd:string)
Declaration(Class(goldbook:08328))
AnnotationAssertion(rdfs:label goldbook:08328 "decoupling in the presence of scalar interactions")
AnnotationAssertion(dcterms:description goldbook:08328 "Pulse sequence in nuclear magnetic resonance spectroscopy often used for isotropic mixing in total correlation spectroscopy (TOCSY) experiments due to its efficiency over large spectral bandwidths.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08328 "DIPSI")
AnnotationAssertion(rdfs:seeAlso goldbook:08328 goldbook:08396)
AnnotationAssertion(rdfs:seeAlso goldbook:08328 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08328 goldbook:08286)
AnnotationAssertion(rdfs:seeAlso goldbook:08328 goldbook:08435)
AnnotationAssertion(mito:isMentionedBy goldbook:08328 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08328 "current"^^xsd:string)
Declaration(Class(goldbook:08329))
AnnotationAssertion(rdfs:label goldbook:08329 "diffusion ordered spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08329 "Pseudo-two-dimensional nuclear magnetic resonance spectroscopy experiment that resolves NMR signals of a one-dimensional nuclear magnetic resonance spectrum in a second dimension through the diffusion times of their corresponding molecules.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08329 "DOSY")
AnnotationAssertion(rdfs:comment goldbook:08329 "DOSY is used to differentiate signals from different molecules based on their effective sizes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08329 "DOSY relies on spatially encoding the analyte by use of pulsed-field gradients."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08329 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08329 goldbook:08397)
AnnotationAssertion(rdfs:seeAlso goldbook:08329 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08329 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08329 "current"^^xsd:string)
Declaration(Class(goldbook:08330))
AnnotationAssertion(rdfs:label goldbook:08330 "dipolar coupling")
AnnotationAssertion(dcterms:description goldbook:08330 "Direct though-space interactions of nuclear magnetic moment vectors proportional to the inverse cube of internuclear distance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08330 "magnetic dipole–dipole interaction in NMR")
AnnotationAssertion(rdfs:comment goldbook:08330 "In isotropic solution, dipolar couplings average to zero as a result of diffusion but are present in solid-state nuclear magnetic resonance spectroscopy and their effect on nuclear spin relaxation are measurable through nuclear Overhauser effects (NOEs)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08330 goldbook:08385)
AnnotationAssertion(rdfs:seeAlso goldbook:08330 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08330 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08330 "current"^^xsd:string)
Declaration(Class(goldbook:08331))
AnnotationAssertion(rdfs:label goldbook:08331 "distortionless enhancement by polarization transfer")
AnnotationAssertion(dcterms:description goldbook:08331 "Measurement method of nuclear magnetic resonance spectroscopy used for determining the presence of primary, secondary and tertiary heteronuclei.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08331 "DEPT")
AnnotationAssertion(rdfs:comment goldbook:08331 "DEPT is a 1D technique which is used typically for \\(\\ce{^{13}C}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08331 "The DEPT experiment for \\(\\ce{^{13}C}\\) differentiates between \\(\\ce{CH}\\), \\(\\ce{CH2}\\) and \\(\\ce{CH3}\\) groups by variation of the selection angle parameter (the flip angle of the final \\(\\ce{^{1}H}\\) pulse): \\(\\pu{135\\!^{\\circ}}\\) angle gives all \\(\\ce{CH}\\) and \\(\\ce{CH3}\\) in a phase opposite to \\(\\ce{CH2}\\); \\(\\pu{90\\!^{\\circ}}\\) angle gives only \\(\\ce{CH}\\) groups, the others being suppressed; \\(\\pu{45\\!^{\\circ}}\\) angle gives all carbons with attached protons with the same phase."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08331 goldbook:08343)
AnnotationAssertion(rdfs:seeAlso goldbook:08331 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08331 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08331 "current"^^xsd:string)
Declaration(Class(goldbook:08332))
AnnotationAssertion(rdfs:label goldbook:08332 "double pulsed-field gradient spin-echo excitation")
AnnotationAssertion(dcterms:description goldbook:08332 "Pulse sequence in nuclear magnetic resonance spectroscopy in which pulsed-field gradients are applied to a doubled spin echo sequence to cleanly and precisely excite particular resonances.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08332 "DPFGSE")
AnnotationAssertion(rdfs:seeAlso goldbook:08332 goldbook:08396)
AnnotationAssertion(rdfs:seeAlso goldbook:08332 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08332 goldbook:08397)
AnnotationAssertion(rdfs:seeAlso goldbook:08332 goldbook:08420)
AnnotationAssertion(mito:isMentionedBy goldbook:08332 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08332 "current"^^xsd:string)
Declaration(Class(goldbook:08333))
AnnotationAssertion(rdfs:label goldbook:08333 "double resonance")
AnnotationAssertion(dcterms:description goldbook:08333 "Nuclear magnetic resonance spectroscopy experiment where excitation is applied independently to two distinct frequency ranges.")
AnnotationAssertion(rdfs:comment goldbook:08333 "Double resonance is most commonly applied for spin decoupling."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08333 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08333 goldbook:08419)
AnnotationAssertion(mito:isMentionedBy goldbook:08333 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08333 "current"^^xsd:string)
Declaration(Class(goldbook:08334))
AnnotationAssertion(rdfs:label goldbook:08334 "double-labelled protein")
AnnotationAssertion(dcterms:description goldbook:08334 "Shorthand for a protein which has been uniformly \\(\\ce{^{15}N{-}}\\) and \\(\\ce{^{13}C{-}labelled}\\).")
AnnotationAssertion(mito:isMentionedBy goldbook:08334 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08334 "current"^^xsd:string)
Declaration(Class(goldbook:08335))
AnnotationAssertion(rdfs:label goldbook:08335 "double-quantum filtered correlation spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08335 "Variant of the COSY experiment with a double quantum filter to remove, or at least reduce, impact of large singlet peaks on dynamic range and artefacts.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08335 "DQF-COSY")
AnnotationAssertion(rdfs:seeAlso goldbook:08335 goldbook:08323)
AnnotationAssertion(mito:isMentionedBy goldbook:08335 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08335 "current"^^xsd:string)
Declaration(Class(goldbook:08336))
AnnotationAssertion(rdfs:label goldbook:08336 "dwell time")
AnnotationAssertion(dcterms:description goldbook:08336 "Time interval between sampled data points.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08336 "DW")
AnnotationAssertion(rdfs:comment goldbook:08336 "\\(\\tau_{\\rm{d}} = 1/f_{\\rm{SW}}\\), where \\(f_{\\rm{SW}}\\) is the NMR spectral width."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08336 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08336 goldbook:08312)
AnnotationAssertion(rdfs:seeAlso goldbook:08336 goldbook:08417)
AnnotationAssertion(mito:isMentionedBy goldbook:08336 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08336 "current"^^xsd:string)
Declaration(Class(goldbook:08337))
AnnotationAssertion(rdfs:label goldbook:08337 "echo time")
AnnotationAssertion(dcterms:description goldbook:08337 "In nuclear magnetic resonance spectroscopy, time interval between the middle of the first radiofrequency pulse and the peak of the spin echo.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08337 "TE")
AnnotationAssertion(rdfs:seeAlso goldbook:08337 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08337 goldbook:08279)
AnnotationAssertion(rdfs:seeAlso goldbook:08337 goldbook:08420)
AnnotationAssertion(mito:isMentionedBy goldbook:08337 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08337 "current"^^xsd:string)
Declaration(Class(goldbook:08338))
AnnotationAssertion(rdfs:label goldbook:08338 "electronic reference to access in vivo concentrations")
AnnotationAssertion(dcterms:description goldbook:08338 "Measurement method of nuclear magnetic resonance spectroscopy that generates an electronic signal in a nuclear magnetic resonance spectrometer which is detected simultaneously to the sample free induction decay during the acquisition.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08338 "ERETIC")
AnnotationAssertion(rdfs:comment goldbook:08338 "This approach is used to simplify the quantification of signals in the resulting NMR spectra by avoiding the need for the use of internal or external reference materials."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08338 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08338 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08338 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08338 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08338 "current"^^xsd:string)
Declaration(Class(goldbook:08339))
AnnotationAssertion(rdfs:label goldbook:08339 "Ernst angle")
AnnotationAssertion(dcterms:description goldbook:08339 "When signal averaging in a single-pulse nuclear magnetic resonance spectroscopy experiment, flip angle giving the best signal-to-noise ratio for a given combination of spin-lattice relaxation time and repetition rate.")
AnnotationAssertion(rdfs:comment goldbook:08339 "Named after Richard Ernst. It is employed to allow the maximum signal to noise to be generated in a fixed amount of time, \\(\\cos (\\theta_{\\rm{E}}) = e^{-(t_{\\rm{d}} + t_{\\rm{a}})/T_{1}}\\), where \\(t_{\\rm{d}}\\) is the interpulse delay, \\(t_{\\rm{a}}\\) is the acquisition time, and \\(T_{1}\\) is longitudinal relaxation time."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08339 goldbook:08343)
AnnotationAssertion(rdfs:seeAlso goldbook:08339 goldbook:08423)
AnnotationAssertion(rdfs:seeAlso goldbook:08339 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08339 goldbook:08282)
AnnotationAssertion(mito:isMentionedBy goldbook:08339 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08339 "current"^^xsd:string)
Declaration(Class(goldbook:08340))
AnnotationAssertion(rdfs:label goldbook:08340 "exchange spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08340 "Nuclear magnetic resonance spectroscopy experiment, which is the same as a NOESY, but for the purposes of observing nuclei exchanging chemical environments during the course of the experiment through conformational or chemical exchange.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08340 "EXSY")
AnnotationAssertion(rdfs:seeAlso goldbook:08340 goldbook:08387)
AnnotationAssertion(rdfs:seeAlso goldbook:08340 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08340 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08340 "current"^^xsd:string)
Declaration(Class(goldbook:08341))
AnnotationAssertion(rdfs:label goldbook:08341 "excitation sculpting")
AnnotationAssertion(dcterms:description goldbook:08341 "Robust method of generating selective excitation through combination of shaped pulses and pulsed-field gradients in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08341 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08341 goldbook:08397)
AnnotationAssertion(mito:isMentionedBy goldbook:08341 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08341 "current"^^xsd:string)
Declaration(Class(goldbook:08342))
AnnotationAssertion(rdfs:label goldbook:08342 "fast field cycling NMR relaxometry")
AnnotationAssertion(dcterms:description goldbook:08342 "Relaxometry to measure the nuclear spin-lattice relaxation rate constant as a function of the applied magnetic field strength in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08342 "FFC-NMR")
AnnotationAssertion(rdfs:comment goldbook:08342 "FFC-NMR is used to study molecular dynamics of molecules across a range of applications including molecular motion in solids and ligand-metal binding."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08342 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08342 goldbook:08422)
AnnotationAssertion(mito:isMentionedBy goldbook:08342 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08342 "current"^^xsd:string)
Declaration(Class(goldbook:08343))
AnnotationAssertion(rdfs:label goldbook:08343 "flip angle")
AnnotationAssertion(dcterms:description goldbook:08343 "Rotation that the net magnetization experiences during the application of a radiofrequency pulse in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08343 "tip angle")
AnnotationAssertion(rdfs:comment goldbook:08343 "For a strong and rectangular RF-pulse of constant amplitude (\\(B_{1}\\)) and duration (\\(t_{\\rm{p}}\\)), the resultant flip angle is approximately proportional to the frequency (\\(f_{1}\\)) of the \\(B_{1}\\) field: \\(\\alpha = \\gamma B_{1} t_{\\rm{p}}\\), where \\(\\gamma\\) is the gyromagnetic ratio."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08343 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08343 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08343 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08343 "current"^^xsd:string)
Declaration(Class(goldbook:08344))
AnnotationAssertion(rdfs:label goldbook:08344 "gated decoupling")
AnnotationAssertion(dcterms:description goldbook:08344 "Application of spin decoupling only during selected time periods in a pulse experiment in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:08344 "Gated decoupling is used to eliminate either \\(\\ce{^{1}H}\\) – \\(\\ce{^{13}C}\\) spin-spin coupling or the nuclear Overhauser effect from a 1D \\(\\ce{^{13}C}\\) spectrum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08344 "If the decoupler is turned off during acquisition this is usually referred to as 'gated decoupling' while decoupling turned on during acquisition is usually referred to as 'inverse gated decoupling'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08344 goldbook:08385)
AnnotationAssertion(rdfs:seeAlso goldbook:08344 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08344 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08344 goldbook:08419)
AnnotationAssertion(mito:isMentionedBy goldbook:08344 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08344 "current"^^xsd:string)
Declaration(Class(goldbook:08345))
AnnotationAssertion(rdfs:label goldbook:08345 "globally optimized alternating-phase rectangular pulses")
AnnotationAssertion(dcterms:description goldbook:08345 "Spin decoupling pulse sequence in nuclear magnetic resonance spectroscopy used to provide decoupling over a large frequency range.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08345 "GARP")
AnnotationAssertion(rdfs:comment goldbook:08345 "GARP is typically used to remove \\(\\ce{^{13}C}\\) sidebands in \\(\\ce{^{1}H}\\) nuclear magnetic resonance spectra."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08345 goldbook:08419)
AnnotationAssertion(rdfs:seeAlso goldbook:08345 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08345 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08345 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08345 "current"^^xsd:string)
Declaration(Class(goldbook:08346))
AnnotationAssertion(rdfs:label goldbook:08346 "gradient-selected experiment")
AnnotationAssertion(dcterms:description goldbook:08346 "Nuclear magnetic resonance spectroscopy experiment where pulsed-field gradients are employed to filter out unwanted resonances from a spectrum rather than the classic phase-cycling approach.")
AnnotationAssertion(rdfs:seeAlso goldbook:08346 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08346 goldbook:08397)
AnnotationAssertion(rdfs:seeAlso goldbook:08346 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08346 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08346 "current"^^xsd:string)
Declaration(Class(goldbook:08347))
AnnotationAssertion(rdfs:label goldbook:08347 "H(CCO)NH")
AnnotationAssertion(dcterms:description goldbook:08347 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen, and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08347 "Magnetization is transferred from the side-chain hydrogen nuclei to their attached \\(\\ce{^{13}C}\\) nuclei. Then isotropic \\(\\ce{^{13}C}\\) mixing is used to transfer magnetization between the carbon nuclei. From here, magnetization is transferred to the carbonyl carbon, on to the amide nitrogen and finally the amide hydrogen for detection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08347 "Requires \\(\\ce{^{15}N}\\) and \\(\\ce{^{13}C}\\) labelling."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08347 "Useful spectrum for obtaining hydrogen side-chain assignments."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08347 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08347 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08347 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08347 "current"^^xsd:string)
Declaration(Class(goldbook:08348))
AnnotationAssertion(rdfs:label goldbook:08348 "HBHA(CO)NH")
AnnotationAssertion(dcterms:description goldbook:08348 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08348 "Magnetization is transferred from \\(\\ce{^{1}H\\upalpha}\\) and \\(\\ce{^{1}H\\upbeta}\\) to \\(\\ce{^{13}C\\upalpha}\\) and \\(\\ce{^{13}C\\upbeta}\\), respectively, and then from \\(\\ce{^{13}C\\upbeta}\\) to \\(\\ce{^{13}C\\upalpha}\\). From here it is transferred first to \\(\\ce{^{13}CO}\\), then to \\(\\ce{^{15}NH}\\) and then to \\(\\ce{^{1}HN}\\) for detection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08348 "Requires \\(\\ce{^{15}N}\\) and \\(\\ce{^{13}C}\\) labelling."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08348 "Useful spectrum for obtaining \\(\\ce{H\\upalpha}\\) and \\(\\ce{H\\upbeta}\\) assignments."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08348 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08348 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08348 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08348 "current"^^xsd:string)
Declaration(Class(goldbook:08349))
AnnotationAssertion(rdfs:label goldbook:08349 "HCCH-COSY")
AnnotationAssertion(dcterms:description goldbook:08349 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08349 "Magnetization is transferred from the side-chain hydrogen nuclei to their attached \\(\\ce{^{13}C}\\) nuclei. Magnetization is then exchanged between neighbouring \\(\\ce{^{13}C}\\) nuclei via the J-coupling and finally transferred back to the side-chain hydrogen atoms for detection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08349 "The nuclear magnetic resonance spectrum can be useful in aiding side-chain assignment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08349 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08349 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08349 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08349 "current"^^xsd:string)
Declaration(Class(goldbook:08350))
AnnotationAssertion(rdfs:label goldbook:08350 "HCCH-TOCSY")
AnnotationAssertion(dcterms:description goldbook:08350 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08350 "Magnetization is transferred from the side-chain hydrogen nuclei to their attached \\(\\ce{^{13}C}\\) nuclei. This is followed by isotropic \\(\\ce{^{13}C}\\) mixing and finally the transfer back to the side-chain hydrogen atoms for detection."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08350 "The nuclear magnetic resonance spectrum is used for side-chain assignment."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08350 goldbook:08432)
AnnotationAssertion(rdfs:seeAlso goldbook:08350 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08350 goldbook:08435)
AnnotationAssertion(mito:isMentionedBy goldbook:08350 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08350 "current"^^xsd:string)
Declaration(Class(goldbook:08351))
AnnotationAssertion(rdfs:label goldbook:08351 "heteronuclear decoupling")
AnnotationAssertion(dcterms:description goldbook:08351 "Spin decoupling in nuclear magnetic resonance spectroscopy between two different nuclei (e.g., \\(\\ce{^{13}C}\\) and \\(\\ce{^{1}H}\\)) by appropriate excitation of the decoupled nucleus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08351 "decoupling")
AnnotationAssertion(rdfs:comment goldbook:08351 "Heteronuclear decoupling is normally performed to simplify spectra or to enhance signal-to-noise ratio by combining individual components of the NMR signal."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08351 "Notation: \\(\\ce{^{13}C\\{^{1}H}\\}\\) denotes observation of \\(\\ce{^{13}C}\\) nucleus with simultaneous decoupling of \\(\\ce{^{1}H}\\) nuclei."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08351 goldbook:08419)
AnnotationAssertion(rdfs:seeAlso goldbook:08351 goldbook:08365)
AnnotationAssertion(rdfs:seeAlso goldbook:08351 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08351 goldbook:08282)
AnnotationAssertion(mito:isMentionedBy goldbook:08351 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08351 "current"^^xsd:string)
Declaration(Class(goldbook:08352))
AnnotationAssertion(rdfs:label goldbook:08352 "heteronuclear multiple bond correlation NMR")
AnnotationAssertion(dcterms:description goldbook:08352 "Two-dimensional nuclear magnetic resonance spectroscopy that gives correlations between carbons and protons that are separated by two, three, and, sometimes in conjugated systems, four bonds.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08352 "HMBC")
AnnotationAssertion(rdfs:comment goldbook:08352 "Direct one-bond correlations are suppressed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08352 "HMBC gives connectivity information much like a proton-proton COSY."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08352 "The intensity of cross peaks depends on the spin-spin coupling constant, which for three-bond couplings follows the Karplus relationship. For dihedral angles near \\(\\pu{90\\!^{\\circ}}\\), the coupling is near zero. Thus, the absence of a cross peak does not confirm that carbon-proton pairs are many bonds apart."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08352 "Because of the wide range (\\(\\pu{0}\\) to \\(\\pu{14 Hz}\\)) of possible carbon-proton couplings, two experiments are often performed. One optimized for \\(\\pu{5 Hz}\\) couplings and the second optimized for \\(\\pu{10 Hz}\\). This gives the optimum signal-to-noise ratio. Alternatively, a comprise value of \\(\\pu{7}\\) to \\(\\pu{8 Hz}\\) can be used. There are also \"accordion\" versions that attempt to sample the full range of couplings."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08352 goldbook:08439)
AnnotationAssertion(rdfs:seeAlso goldbook:08352 goldbook:08282)
AnnotationAssertion(mito:isMentionedBy goldbook:08352 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08352 "current"^^xsd:string)
Declaration(Class(goldbook:08353))
AnnotationAssertion(rdfs:label goldbook:08353 "heteronuclear multiple-bond correlation over two bonds")
AnnotationAssertion(dcterms:description goldbook:08353 "Variant of the heteronuclear single quantum correlation (HSQC) and heteronuclear multiple bond correlation (HMBC) experiment in nuclear magnetic resonance spectroscopy that almost exclusively correlates \\(\\ce{^{1}H}\\) nuclei with heteronuclei separated by two covalent bonds.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08353 "H2BC")
AnnotationAssertion(rdfs:seeAlso goldbook:08353 goldbook:08352)
AnnotationAssertion(rdfs:seeAlso goldbook:08353 goldbook:08358)
AnnotationAssertion(rdfs:seeAlso goldbook:08353 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08353 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08353 "current"^^xsd:string)
Declaration(Class(goldbook:08354))
AnnotationAssertion(rdfs:label goldbook:08354 "heteronuclear multiple-quantum correlation NMR")
AnnotationAssertion(dcterms:description goldbook:08354 "Simplest implementation of an inverse detected \\(\\ce{^{1}H}\\) heteronuclear correlation nuclear magnetic resonance spectroscopy experiment.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08354 "HMQC")
AnnotationAssertion(rdfs:seeAlso goldbook:08354 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08354 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08354 "current"^^xsd:string)
Declaration(Class(goldbook:08355))
AnnotationAssertion(rdfs:label goldbook:08355 "heteronuclear multiple-quantum correlation with additional TOCSY transfer")
AnnotationAssertion(dcterms:description goldbook:08355 "Variant of heteronuclear multiple bond correlation (HMBC) spectroscopy that shows correlations from a heteronucleus (e.g., \\(\\ce{^{13}C}\\)) to not only its directly bound \\(\\ce{^{1}H}\\) but also to all other \\(\\ce{^{1}H}\\) nuclei within the spin system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08355 "HMQC-TOCSY")
AnnotationAssertion(rdfs:seeAlso goldbook:08355 goldbook:08352)
AnnotationAssertion(rdfs:seeAlso goldbook:08355 goldbook:08421)
AnnotationAssertion(rdfs:seeAlso goldbook:08355 goldbook:08435)
AnnotationAssertion(mito:isMentionedBy goldbook:08355 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08355 "current"^^xsd:string)
Declaration(Class(goldbook:08356))
AnnotationAssertion(rdfs:label goldbook:08356 "heteronuclear Overhauser effect spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08356 "Heteronuclear variant of nuclear Overhauser effect spectroscopy (NOSEY) showing through space interaction between \\(\\ce{^{1}H}\\) and a heteronucleus, typically \\(\\ce{^{13}C}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08356 "HOESY")
AnnotationAssertion(rdfs:seeAlso goldbook:08356 goldbook:08387)
AnnotationAssertion(mito:isMentionedBy goldbook:08356 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08356 "current"^^xsd:string)
Declaration(Class(goldbook:08357))
AnnotationAssertion(rdfs:label goldbook:08357 "heteronuclear shift correlation NMR")
AnnotationAssertion(dcterms:description goldbook:08357 "Directly-observed one-bond heteronuclear correlation experiment in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08357 "HETCOR")
AnnotationAssertion(rdfs:comment goldbook:08357 "HETCOR has largely been replaced by the indirectly observed heteronuclear single quantum correlation experiment due to its greater sensitivity. It does however have the advantage of greater resolution in the heteronuclear dimension."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08357 goldbook:08358)
AnnotationAssertion(rdfs:seeAlso goldbook:08357 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08357 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08357 "current"^^xsd:string)
Declaration(Class(goldbook:08358))
AnnotationAssertion(rdfs:label goldbook:08358 "heteronuclear single quantum correlation")
AnnotationAssertion(dcterms:description goldbook:08358 "\\(\\ce{^{1}H}\\) (inverse) detected two-dimensional nuclear magnetic resonance spectroscopy heteronuclear experiment that correlates \\(\\ce{^{1}H}\\) nuclei with their directly coupled nucleus through a single bond.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08358 "HSQC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08358 "heteronuclear single quantum coherence")
AnnotationAssertion(rdfs:seeAlso goldbook:08358 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08358 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08358 "current"^^xsd:string)
Declaration(Class(goldbook:08359))
AnnotationAssertion(rdfs:label goldbook:08359 "heteronuclear single quantum correlation with additional TOCSY transfer")
AnnotationAssertion(dcterms:description goldbook:08359 "Variant of the heteronuclear single quantum correlation (HSQC) experiment that shows correlations from a heteronucleus (e.g., \\(\\ce{^{13}C}\\)) to not only its directly bound \\(\\ce{^{1}H}\\) but also to all other \\(\\ce{^{1}H}\\) nuclei within the spin system.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08359 "HSQC-TOCSY")
AnnotationAssertion(rdfs:seeAlso goldbook:08359 goldbook:08358)
AnnotationAssertion(rdfs:seeAlso goldbook:08359 goldbook:08421)
AnnotationAssertion(rdfs:seeAlso goldbook:08359 goldbook:08435)
AnnotationAssertion(mito:isMentionedBy goldbook:08359 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08359 "current"^^xsd:string)
Declaration(Class(goldbook:08360))
AnnotationAssertion(rdfs:label goldbook:08360 "heteronuclear single quantum multiple-bond correlation")
AnnotationAssertion(dcterms:description goldbook:08360 "Variant of the heteronuclear single quantum correlation (HSQC) experiment that provides pure absorption, antiphase line shapes for precise, direct measurement of \\(^{n}J(\\ce{C,H})\\) spin-spin coupling constants.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08360 "HSQMBC")
AnnotationAssertion(rdfs:seeAlso goldbook:08360 goldbook:08358)
AnnotationAssertion(mito:isMentionedBy goldbook:08360 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08360 "current"^^xsd:string)
Declaration(Class(goldbook:08361))
AnnotationAssertion(rdfs:label goldbook:08361 "HN(CA)CO")
AnnotationAssertion(dcterms:description goldbook:08361 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08361 "the magnetization is transferred from \\(\\ce{^{1}H}\\) to \\(\\ce{^{15}N}\\) and then via the \\(\\ce{N-C\\upalpha\\ J{-}coupling}\\) to the \\(\\ce{^{13}C\\upalpha}\\). From there it is transferred to the \\(\\ce{^{13}CO}\\) via the \\(\\ce{^{13}C\\upalpha\\mbox{-}\\!^{13}CO J\\mbox{-}coupling}\\). For detection the magnetization is transferred back the same way: from \\(\\ce{^{13}CO}\\) to \\(\\ce{^{13}C\\upalpha}\\), \\(\\ce{^{15}N}\\) and finally \\(\\ce{^{1}H}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08361 "Each \\(\\ce{NH}\\) group will show correlations to both their own and adjacent carbonyls group."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08361 goldbook:08432)
AnnotationAssertion(mito:isMentionedBy goldbook:08361 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08361 "current"^^xsd:string)
Declaration(Class(goldbook:08362))
AnnotationAssertion(rdfs:label goldbook:08362 "HN(CO)CA")
AnnotationAssertion(dcterms:description goldbook:08362 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08362 "The magnetization is passed from \\(\\ce{^{1}H}\\) to \\(\\ce{^{15}N}\\) and then to \\(\\ce{^{13}CO}\\). From here it is transferred to \\(\\ce{^{13}C\\upalpha}\\) and the chemical shift is evolved. The magnetization is then transferred back via \\(\\ce{^{13}CO}\\) to \\(\\ce{^{15}N}\\) and \\(\\ce{^{1}H}\\) for detection. This is similar to the HNCA, but is selective for the \\(\\ce{C\\upalpha}\\) of the preceding residue."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08362 goldbook:08432)
AnnotationAssertion(mito:isMentionedBy goldbook:08362 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08362 "current"^^xsd:string)
Declaration(Class(goldbook:08363))
AnnotationAssertion(rdfs:label goldbook:08363 "HNCA")
AnnotationAssertion(dcterms:description goldbook:08363 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08363 "The magnetization is passed from \\(\\ce{^{1}H}\\) to \\(\\ce{^{15}N}\\) and then via the \\(\\ce{N-C\\upalpha}\\) \\(\\rm{J}\\mbox{-}\\rm{coupling}\\) to the \\(\\ce{^{13}C\\upalpha}\\) and then back again to \\(\\ce{^{15}N}\\) and \\(\\ce{^{1}H}\\) hydrogen for detection. Each \\(\\ce{NH}\\) group will show correlations to both their own and the previous residue’s \\(\\ce{^{13}C\\upalpha}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08363 goldbook:08432)
AnnotationAssertion(mito:isMentionedBy goldbook:08363 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08363 "current"^^xsd:string)
Declaration(Class(goldbook:08364))
AnnotationAssertion(rdfs:label goldbook:08364 "HNCO")
AnnotationAssertion(dcterms:description goldbook:08364 "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions.")
AnnotationAssertion(rdfs:comment goldbook:08364 "Magnetization is passed from \\(\\ce{^{1}H}\\) to \\(\\ce{^{15}N}\\) and then selectively to the carbonyl \\(\\ce{^{13}C}\\) via the \\(\\ce{NH-^{13}CO}\\) \\(\\rm{J}\\mbox{-}\\rm{coupling}\\). Magnetization is then passed back via \\(\\ce{^{15}N}\\) to \\(\\ce{^{1}H}\\) for detection."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08364 goldbook:08432)
AnnotationAssertion(mito:isMentionedBy goldbook:08364 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08364 "current"^^xsd:string)
Declaration(Class(goldbook:08365))
AnnotationAssertion(rdfs:label goldbook:08365 "homonuclear decoupling")
AnnotationAssertion(dcterms:description goldbook:08365 "Spin decoupling in nuclear magnetic resonance spectroscopy between two signals of the same nuclear isotope.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08365 "decoupling")
AnnotationAssertion(rdfs:comment goldbook:08365 "Homonuclear decoupling is normally performed through selective excitation of specific NMR signals within a spectrum or through pure shift experiments such as PSYCHE."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08365 goldbook:08398)
AnnotationAssertion(rdfs:seeAlso goldbook:08365 goldbook:08419)
AnnotationAssertion(rdfs:seeAlso goldbook:08365 goldbook:08351)
AnnotationAssertion(rdfs:seeAlso goldbook:08365 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08365 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08365 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08365 "current"^^xsd:string)
Declaration(Class(goldbook:08366))
AnnotationAssertion(rdfs:label goldbook:08366 "imaginary NMR spectrum")
AnnotationAssertion(dcterms:description goldbook:08366 "In nuclear magnetic resonance spectroscopy, one of two equally sized blocks of frequency data \\(\\pu{90\\!^{\\circ}}\\) out of phase to each other produced by Fourier transformation of the time domain signal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08366 "imaginary spectrum")
AnnotationAssertion(rdfs:comment goldbook:08366 "Usually the imaginary frequency data is not displayed and is used for phase correction of the real spectrum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08366 "In simple 1D spectra this equates to the NMR signals being in dispersion mode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08366 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08366 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08366 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08366 "current"^^xsd:string)
Declaration(Class(goldbook:08367))
AnnotationAssertion(rdfs:label goldbook:08367 "incredible natural-abundance double-quantum transfer experiment")
AnnotationAssertion(dcterms:description goldbook:08367 "Nuclear magnetic resonance spectroscopy experiment designed to show homonuclear spin-spin coupling correlations between low natural abundance nuclei such as \\(\\ce{^{13}C}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08367 "INADEQUATE")
AnnotationAssertion(rdfs:comment goldbook:08367 "2D variant shows each coupled pair of nuclei gives a pair of peaks on the INADEQUATE spectrum which both have the same vertical coordinate, which is the sum of the chemical shifts of the nuclei; the horizontal coordinate of each peak is the chemical shift for each of the nuclei separately."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08367 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08367 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08367 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08367 "current"^^xsd:string)
Declaration(Class(goldbook:08368))
AnnotationAssertion(rdfs:label goldbook:08368 "insensitive nuclei enhanced by polarization transfer")
AnnotationAssertion(dcterms:description goldbook:08368 "Pulse sequence in nuclear magnetic resonance spectroscopy that involves the transfer of nuclear spin polarization from spins with large Boltzmann population differences to nuclear spins of interest with low Boltzmann population differences.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08368 "INEPT")
AnnotationAssertion(rdfs:comment goldbook:08368 "INEPT uses  for the polarization transfer in contrast to nuclear Overhauser effect (NOE) which arises from dipolar cross-relaxation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08368 "INEPT is a building block for many heteronuclear NMR experiments."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08368 goldbook:08396)
AnnotationAssertion(rdfs:seeAlso goldbook:08368 goldbook:08385)
AnnotationAssertion(rdfs:seeAlso goldbook:08368 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08368 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08368 "current"^^xsd:string)
Declaration(Class(goldbook:08369))
AnnotationAssertion(rdfs:label goldbook:08369 "inversion pulse")
AnnotationAssertion(dcterms:description goldbook:08369 "Pulse in nuclear magnetic resonance spectroscopy that completely inverts the magnetization of a spin, e.g., \\(+z\\) to \\(-z\\).")
AnnotationAssertion(rdfs:comment goldbook:08369 "The inversion pulse can be a simple \\(\\pu{180\\!^{\\circ}}\\) or composite pulse."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08369 goldbook:08310)
AnnotationAssertion(rdfs:seeAlso goldbook:08369 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08369 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08369 "current"^^xsd:string)
Declaration(Class(goldbook:08370))
AnnotationAssertion(rdfs:label goldbook:08370 "inversion recovery sequence")
AnnotationAssertion(dcterms:description goldbook:08370 "Spin echo sequence preceded by a \\(\\pu{180\\!^{\\circ}}\\) inversion pulse used to determine spin-lattice relaxation times in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08370 "inversion recovery")
AnnotationAssertion(rdfs:comment goldbook:08370 "The sequence is typically denoted as \\(\\pu{180\\!^{\\circ}} - \\uptau - \\pu{90\\!^{\\circ}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08370 goldbook:08420)
AnnotationAssertion(rdfs:seeAlso goldbook:08370 goldbook:08310)
AnnotationAssertion(rdfs:seeAlso goldbook:08370 goldbook:08371)
AnnotationAssertion(rdfs:seeAlso goldbook:08370 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08370 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08370 "current"^^xsd:string)
Declaration(Class(goldbook:08371))
AnnotationAssertion(rdfs:label goldbook:08371 "inversion time")
AnnotationAssertion(dcterms:description goldbook:08371 "Time between the inversion pulse and the sampling pulse(s) in an inversion recovery sequence.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08371 "TI")
AnnotationAssertion(rdfs:comment goldbook:08371 "\\(T_{\\rm{I,null}}\\) is the value of \\(T_{\\rm{I}}\\) when longitudinal magnetization (\\(M_{\\rm{z}}\\)) is close to zero at the end of the \\(\\ce{TI}\\) interval."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08371 goldbook:08370)
AnnotationAssertion(mito:isMentionedBy goldbook:08371 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08371 "current"^^xsd:string)
Declaration(Class(goldbook:08372))
AnnotationAssertion(rdfs:label goldbook:08372 "J-modulated spin-echo")
AnnotationAssertion(dcterms:description goldbook:08372 "Nuclear magnetic resonance pulse sequence that refocuses spin vectors that have fanned out due to field inhomogeneity or chemical shift differences.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08372 "J-MOD")
AnnotationAssertion(rdfs:comment goldbook:08372 "J-MOD is typically denoted as \\(\\pu{90\\!^{\\circ}} - \\uptau - \\pu{180\\!^{\\circ}} - \\uptau(\\rm{echo})\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08372 goldbook:08396)
AnnotationAssertion(rdfs:seeAlso goldbook:08372 goldbook:08420)
AnnotationAssertion(mito:isMentionedBy goldbook:08372 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08372 "current"^^xsd:string)
Declaration(Class(goldbook:08373))
AnnotationAssertion(rdfs:label goldbook:08373 "J-resolved spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08373 "Two-dimensional nuclear magnetic resonance spectroscopy resolving chemical shift information in one dimension and spin-spin coupling in the second.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08373 "J-RES")
AnnotationAssertion(rdfs:comment goldbook:08373 "J-RES exists as both homonuclear and heteronuclear variants."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08373 "The homonuclear variant can generate homonuclear decoupled projection when processed with a tilt function."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08373 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08373 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08373 "current"^^xsd:string)
Declaration(Class(goldbook:08374))
AnnotationAssertion(rdfs:label goldbook:08374 "Knight shift")
AnnotationAssertion(dcterms:description goldbook:08374 "Frequency shift in the nuclear magnetic resonance spectrum of a paramagnetic species that refers to the relative shift \\(\\boldsymbol{K}\\) in NMR frequency for atoms in a metal (e.g., sodium) compared with the same atoms in a nonmetallic environment (e.g., as a salt).")
AnnotationAssertion(rdfs:comment goldbook:08374 "The observed shift reflects the local magnetic field produced at the metal nucleus by the magnetization of the conduction electrons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08374 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08374 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08374 "current"^^xsd:string)
Declaration(Class(goldbook:08375))
AnnotationAssertion(rdfs:label goldbook:08375 "Larmor angular frequency")
AnnotationAssertion(dcterms:description goldbook:08375 "Frequency at which nuclei with a nuclear spin precess (Larmor precession) around the direction of an external magnetic induction \\(\\boldsymbol{B}_{0}\\). \\(\\boldsymbol{\\omega}_{\\rm{L}} = -\\gamma \\boldsymbol{B}_{0}\\), where \\(\\gamma\\) is the magnetogyric ratio of the nucleus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08375 "Larmor frequency")
AnnotationAssertion(rdfs:seeAlso goldbook:08375 goldbook:08376)
AnnotationAssertion(mito:isMentionedBy goldbook:08375 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08375 "current"^^xsd:string)
Declaration(Class(goldbook:08376))
AnnotationAssertion(rdfs:label goldbook:08376 "Larmor precession")
AnnotationAssertion(dcterms:description goldbook:08376 "Precession of the magnetic moment (\\(\\boldsymbol{M}\\)) of an object at an angular frequency, \\(\\boldsymbol{\\omega}_{\\rm{L}}\\), about a static magnetic induction (\\(\\boldsymbol{B_{0}}\\)), named after Joseph Larmor.")
AnnotationAssertion(rdfs:comment goldbook:08376 "Larmor precession can be visually compared to the precession of a tilted gyroscope in an external torque-exerting gravitational field."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08376 goldbook:08394)
AnnotationAssertion(mito:isMentionedBy goldbook:08376 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08376 "current"^^xsd:string)
Declaration(Class(goldbook:08377))
AnnotationAssertion(rdfs:label goldbook:08377 "magic angle spinning")
AnnotationAssertion(dcterms:description goldbook:08377 "Technique in solid-state nuclear magnetic resonance spectroscopy to remove or reduce the influence of anisotropic interactions by rapid sample rotation about the magic angle, where \\(\\boldsymbol{B_{0}}\\) is external magnetic induction and \\(\\uptheta\\) is the axis of rotation of the sample at an angle of approx. \\(\\pu{54.74\\!^{\\circ}}\\) to the external magnetic induction.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08377 "MAS")
AnnotationAssertion(rdfs:comment goldbook:08377 "Much like in the case of solutions, MAS effectively averages orientation-dependent interactions and allow high resolution spectra."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08377 "The rate of spinning must be greater than or equal to the magnitude of the anisotropic interaction to average it to zero."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08377 goldbook:08223)
AnnotationAssertion(rdfs:seeAlso goldbook:08377 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08377 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08377 "current"^^xsd:string)
Declaration(Class(goldbook:08378))
AnnotationAssertion(rdfs:label goldbook:08378 "multiple-quantum magic angle spinning NMR")
AnnotationAssertion(dcterms:description goldbook:08378 "Measurement method of nuclear magnetic resonance spectroscopy used to obtain high-resolution NMR spectra of quadrupolar nuclei by removal of the anisotropy of the quadrupole interaction, involving creating a triple-quantum (or \\(5{\\rm{Q}}\\)) coherence.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08378 "MQMAS")
AnnotationAssertion(rdfs:seeAlso goldbook:08378 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08378 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08378 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08378 "current"^^xsd:string)
Declaration(Class(goldbook:08379))
AnnotationAssertion(rdfs:label goldbook:08379 "multiplet")
AnnotationAssertion(dcterms:description goldbook:08379 "Feature in a nuclear magnetic resonance spectrum that is split but is too complex to easily interpret.")
AnnotationAssertion(rdfs:comment goldbook:08379 "A multiplet is distinguished from multiplicity of NMR peaks that give well-resolved doublet, triplet, quartet, quintet etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08379 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08379 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08379 "current"^^xsd:string)
Declaration(Class(goldbook:08380))
AnnotationAssertion(rdfs:label goldbook:08380 "net dephasing time")
AnnotationAssertion(dcterms:description goldbook:08380 "Measured time constant associated with spin-spin relaxation for loss of magnetization in the \\(xy\\) plane.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08380 "T2-star")
AnnotationAssertion(rdfs:comment goldbook:08380 "\\(T_{2}^{*}\\) includes losses due to \\(\\boldsymbol{B_{0}}\\) inhomogeneity as well as spin-spin relaxation and is always less than or equal to the spin-lattice relaxation time (\\(T_{2}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08380 goldbook:08423)
AnnotationAssertion(rdfs:seeAlso goldbook:08380 goldbook:08425)
AnnotationAssertion(mito:isMentionedBy goldbook:08380 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08380 "current"^^xsd:string)
Declaration(Class(goldbook:08381))
AnnotationAssertion(rdfs:label goldbook:08381 "non-uniform sampling")
AnnotationAssertion(dcterms:description goldbook:08381 "Technique employed within a high dimensionality nuclear magnetic resonance spectroscopy experiment that acquires only a subset of the data points traditionally acquired linearly thus enabling a reduction in experiment time or an increased resolution in the resultant spectra.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08381 "NUS")
AnnotationAssertion(rdfs:comment goldbook:08381 "NUS uses reconstruction methods to allow the extraction of complete sets of chemical shift information."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08381 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08381 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08381 "current"^^xsd:string)
Declaration(Class(goldbook:08382))
AnnotationAssertion(rdfs:label goldbook:08382 "nuclear electric quadrupole moment")
AnnotationAssertion(dcterms:description goldbook:08382 "Parameter that describes the effective shape of the ellipsoid of nuclear charge distribution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08382 "quadrupole moment of a nucleus")
AnnotationAssertion(rdfs:comment goldbook:08382 "Non-zero quadrupole moment indicates that the charge distribution is not spherically symmetric."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08382 "By convention, the value of \\(eQ\\) is taken to be positive if the ellipsoid is prolate and negative if it is oblate."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08382 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08382 "current"^^xsd:string)
Declaration(Class(goldbook:08383))
AnnotationAssertion(rdfs:label goldbook:08383 "nuclear magnetic resonance relaxometry")
AnnotationAssertion(dcterms:description goldbook:08383 "Measurement method of nuclear magnetic resonance spectroscopy to measure nuclear relaxation variables.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08383 "NMRR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08383 "relaxometry")
AnnotationAssertion(rdfs:comment goldbook:08383 "NMRR generally involves analysis of time domain NMR signals to generate simplified NMR data rather than conventional full frequency resolved NMR spectra."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08383 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08383 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08383 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08383 "current"^^xsd:string)
Declaration(Class(goldbook:08384))
AnnotationAssertion(rdfs:label goldbook:08384 "nuclear magnetic resonance spectrum")
AnnotationAssertion(dcterms:description goldbook:08384 "Representation of nuclear magnetic resonance spectroscopy data with at least one dimension a frequency domain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08384 "NMR spectrum")
AnnotationAssertion(rdfs:comment goldbook:08384 "An NMR spectrum typically involves the Fourier transform of a free induction decay. See Fourier-transform spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08384 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08384 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08384 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08384 "current"^^xsd:string)
Declaration(Class(goldbook:08385))
AnnotationAssertion(rdfs:label goldbook:08385 "nuclear Overhauser effect")
AnnotationAssertion(dcterms:description goldbook:08385 "Change of intensity of one resonance when the spin transitions of another are somehow perturbed from their equilibrium populations.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08385 "nOe")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08385 "nuclear Overhauser enhancement")
AnnotationAssertion(rdfs:comment goldbook:08385 "The nuclear Overhauser effect at nucleus \\(i\\) for perturbation of spin \\(S\\) is expressed as a relative intensity change between the equilibrium intensity (\\(I\\)) and that in the presence of the nOe (\\(I_{\\rm{o}}\\)). \\(\\eta_{i}({\\rm{S}}) = (I - I_{o})/I_{o}\\). The effect may be given as a percentage \\(\\eta \\times \\pu{100 \\%}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08385 "nOe allows a measure of through space rather than through bond interactions between nuclei and is proportional to the inverse \\(6^{\\rm{th}}\\) power of the internuclear distance."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08385 "\\(\\eta\\) can be positive or negative depending on the motional properties of the molecule and the signs of the gyromagnetic ratios."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08385 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08385 "current"^^xsd:string)
Declaration(Class(goldbook:08386))
AnnotationAssertion(rdfs:label goldbook:08386 "nuclear Overhauser effect difference spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08386 "One dimensional nuclear magnetic resonance spectroscopy that yields, through subtraction of spectra generated with and without selective excitation of a specific resonance, the nuclear Overhauser enhancement of nuclei spatially close to a selectively excited nucleus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08386 "nOe difference spectroscopy")
AnnotationAssertion(rdfs:seeAlso goldbook:08386 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08386 goldbook:08385)
AnnotationAssertion(mito:isMentionedBy goldbook:08386 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08386 "current"^^xsd:string)
Declaration(Class(goldbook:08387))
AnnotationAssertion(rdfs:label goldbook:08387 "nuclear Overhauser effect spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08387 "Measurement method of nuclear magnetic resonance spectroscopy based on the nuclear Overhauser effect to observe nuclei that are close to each other in space.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08387 "NOESY")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08387 "nuclear Overhauser enhancement spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:08387 "NOESY is typically run as a homonuclear \\(\\ce{^{1}H}\\) experiment."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08387 "A NOESY spectrum yields through space correlations via dipolar cross-relaxation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08387 "For small molecules, NOE may be observed between protons that are up to \\(\\pu{0.4 nm}\\) apart, while the upper limit for large molecules is about \\(\\pu{0.5 nm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08387 "NOESY also detects chemical and conformational exchange, when it is termed exchange spectroscopy (EXSY)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08387 goldbook:08340)
AnnotationAssertion(rdfs:seeAlso goldbook:08387 goldbook:08385)
AnnotationAssertion(rdfs:seeAlso goldbook:08387 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08387 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08387 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08387 "current"^^xsd:string)
Declaration(Class(goldbook:08388))
AnnotationAssertion(rdfs:label goldbook:08388 "nuclear quadrupole resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08388 "Measurement method of nuclear magnetic resonance spectroscopy where splitting of the nuclear spin states is determined by the electrostatic interaction of the nuclear charge density with the external electric potential of the surrounding electron cloud.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08388 "NQR")
AnnotationAssertion(rdfs:comment goldbook:08388 "Unlike NMR, NQR transitions of nuclei can be detected in the absence of a magnetic field."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08388 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08388 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08388 "current"^^xsd:string)
Declaration(Class(goldbook:08389))
AnnotationAssertion(rdfs:label goldbook:08389 "observation frequency")
AnnotationAssertion(dcterms:description goldbook:08389 "Frequency corresponding to the centre of the spectrum window for a given nucleus under observation and the nominal frequency used to generate the hard, full spectrum pulses.")
AnnotationAssertion(rdfs:seeAlso goldbook:08389 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08389 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08389 "current"^^xsd:string)
Declaration(Class(goldbook:08390))
AnnotationAssertion(rdfs:label goldbook:08390 "Pake doublet")
AnnotationAssertion(dcterms:description goldbook:08390 "Characteristic line shape seen in solid-state nuclear magnetic resonance spectroscopy arising from dipolar coupling between two nuclei.")
AnnotationAssertion(rdfs:seeAlso goldbook:08390 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08390 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08390 "current"^^xsd:string)
Declaration(Class(goldbook:08391))
AnnotationAssertion(rdfs:label goldbook:08391 "phase correction")
AnnotationAssertion(dcterms:description goldbook:08391 "Linear combination of the real and imaginary parts of a 1-D nuclear magnetic resonance spectrum to produce peaks with pure absorption mode line shape.")
AnnotationAssertion(rdfs:comment goldbook:08391 "The phase correction is normally described by the automatic or manual setting of a fixed zero order and a frequency dependent first order phase constant."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08391 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08391 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08391 "current"^^xsd:string)
Declaration(Class(goldbook:08392))
AnnotationAssertion(rdfs:label goldbook:08392 "phase cycling")
AnnotationAssertion(dcterms:description goldbook:08392 "Component of nuclear magnetic resonance spectroscopy experiment that repeats a pulse sequence changing only the phases of the pulse(s) and the phase-sensitive detector reference.")
AnnotationAssertion(rdfs:comment goldbook:08392 "The resultant FID’s are then added to suppress undesirable signal components and/or to produce the desired effect of a pulse sequence (e.g., multiple quantum filter)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08392 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08392 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08392 goldbook:08396)
AnnotationAssertion(mito:isMentionedBy goldbook:08392 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08392 "current"^^xsd:string)
Declaration(Class(goldbook:08393))
AnnotationAssertion(rdfs:label goldbook:08393 "powder pattern")
AnnotationAssertion(dcterms:description goldbook:08393 "Very broad and distinctive line shape seen in a static solid-state nuclear magnetic resonance spectroscopy experiment with a typical magnitude of \\(\\pu{E2}\\) to \\(\\pu{E5 Hz}\\).")
AnnotationAssertion(rdfs:comment goldbook:08393 "A powder pattern is a summation of the multitude of signals arising from crystals with different orientations within the magnetic induction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08393 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08393 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08393 "current"^^xsd:string)
Declaration(Class(goldbook:08394))
AnnotationAssertion(rdfs:label goldbook:08394 "precession")
AnnotationAssertion(dcterms:description goldbook:08394 "Classical description of the behaviour of nuclear magnetic moments, in which the vectors rotate about the \\(\\boldsymbol{B_{0}}\\) axis at their Larmor angular frequencies.")
AnnotationAssertion(rdfs:seeAlso goldbook:08394 goldbook:08375)
AnnotationAssertion(mito:isMentionedBy goldbook:08394 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08394 "current"^^xsd:string)
Declaration(Class(goldbook:08395))
AnnotationAssertion(rdfs:label goldbook:08395 "presaturation")
AnnotationAssertion(dcterms:description goldbook:08395 "Technique to suppress a particular nuclear magnetic resonance spectroscopy signal where a long low-power pulse is applied to that specific resonance prior to the main pulse sequence.")
AnnotationAssertion(rdfs:comment goldbook:08395 "Presaturation is typically used as a method for solvent suppression."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08395 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08395 goldbook:08396)
AnnotationAssertion(mito:isMentionedBy goldbook:08395 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08395 "current"^^xsd:string)
Declaration(Class(goldbook:08396))
AnnotationAssertion(rdfs:label goldbook:08396 "pulse sequence")
AnnotationAssertion(dcterms:description goldbook:08396 "Timed series of radiofrequency pulses and magnetic field gradients that define a part or whole of a nuclear magnetic resonance spectroscopy experiment.")
AnnotationAssertion(rdfs:seeAlso goldbook:08396 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08396 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08396 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08396 "current"^^xsd:string)
Declaration(Class(goldbook:08397))
AnnotationAssertion(rdfs:label goldbook:08397 "pulsed-field gradient")
AnnotationAssertion(dcterms:description goldbook:08397 "Short, timed pulse in nuclear magnetic resonance spectroscopy that momentarily destroys the magnetic field homogeneity within the sample through a spatial-dependent field intensity.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08397 "PFG")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08397 "gradient pulse")
AnnotationAssertion(rdfs:comment goldbook:08397 "The net result of the pulse is that spins are dispersed in the transverse plane (defocussed) and produce zero net magnetization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08397 "A PFG is characterized by its power, shape, duration and axis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08397 "PFG techniques are used in magnetic resonance imaging, spatially-selective NMR, and diffusion ordered NMR spectroscopy (DOSY)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08397 goldbook:08329)
AnnotationAssertion(rdfs:seeAlso goldbook:08397 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08397 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08397 "current"^^xsd:string)
Declaration(Class(goldbook:08398))
AnnotationAssertion(rdfs:label goldbook:08398 "pure shift yielded by chirp excitation")
AnnotationAssertion(dcterms:description goldbook:08398 "Nuclear magnetic resonance spectroscopy experiment generating homonuclear spin-spin decoupled spectra.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08398 "PSYCHE")
AnnotationAssertion(rdfs:comment goldbook:08398 "The effect is achieved through the concatenation of partial free induction decays generated with a series of swept adiabatic pulses."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08398 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08398 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08398 goldbook:08384)
AnnotationAssertion(mito:isMentionedBy goldbook:08398 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08398 "current"^^xsd:string)
Declaration(Class(goldbook:08399))
AnnotationAssertion(rdfs:label goldbook:08399 "quadrature detection")
AnnotationAssertion(dcterms:description goldbook:08399 "Collection of time domain nuclear magnetic resonance spectroscopy data on both the \\(x\\) and \\(y\\ (\\rm{g})\\) axes of the rotating frame of reference to allow discrimination of positive and negative frequencies.")
AnnotationAssertion(rdfs:seeAlso goldbook:08399 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08399 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08399 "current"^^xsd:string)
Declaration(Class(goldbook:08400))
AnnotationAssertion(rdfs:label goldbook:08400 "quadrupolar nuclide")
AnnotationAssertion(dcterms:description goldbook:08400 "Nuclide with spin quantum number \\(I \\gt &half;\\) and a non-spherical distribution of charge in the nucleus giving rise to a nuclear electric quadrupole moment (\\(eQ\\)).")
AnnotationAssertion(rdfs:seeAlso goldbook:08400 goldbook:08382)
AnnotationAssertion(mito:isMentionedBy goldbook:08400 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08400 "current"^^xsd:string)
Declaration(Class(goldbook:08401))
AnnotationAssertion(rdfs:label goldbook:08401 "quadrupolar relaxation")
AnnotationAssertion(dcterms:description goldbook:08401 "Relaxation mechanism in nuclear magnetic resonance spectroscopy arising from intramolecular quadrupolar interactions with electric field gradients.")
AnnotationAssertion(rdfs:seeAlso goldbook:08401 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08401 goldbook:08400)
AnnotationAssertion(mito:isMentionedBy goldbook:08401 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08401 "current"^^xsd:string)
Declaration(Class(goldbook:08402))
AnnotationAssertion(rdfs:label goldbook:08402 "radiation damping")
AnnotationAssertion(dcterms:description goldbook:08402 "Line-broadening effect on intense signals in high field nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:08402 "Radiation damping occurs when the rotating transverse magnetization of the sample is intense enough to induce large enough electromotive force in the radiofrequency coil strong enough that it feeds back to the sample. This causes a rotation of magnetization back to the \\(+z\\) axis and results in line-broadening of the intense peak."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08402 "Radiation damping can also produce other effects including changes to amplitude and phase of adjacent peaks."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08402 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08402 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08402 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08402 "current"^^xsd:string)
Declaration(Class(goldbook:08403))
AnnotationAssertion(rdfs:label goldbook:08403 "radiofrequency coil")
AnnotationAssertion(dcterms:description goldbook:08403 "In nuclear magnetic resonance spectroscopy, an inductor-capacitor resonant circuit used to set up \\(B_{1}\\) magnetic inductions in a sample and to detect the signal from the sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08403 "RF coil")
AnnotationAssertion(rdfs:seeAlso goldbook:08403 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08403 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08403 "current"^^xsd:string)
Declaration(Class(goldbook:08404))
AnnotationAssertion(rdfs:label goldbook:08404 "real spectrum")
AnnotationAssertion(dcterms:description goldbook:08404 "In nuclear magnetic resonance spectroscopy, one of two equally sized blocks of frequency data \\(\\pu{90\\!^{\\circ}}\\) out of phase to each other produced by Fourier transformation of the time domain signal.")
AnnotationAssertion(rdfs:comment goldbook:08404 "Usually only the real frequency data is displayed and in simple 1D spectra equates to the NMR signals being absorption mode (in-phase)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08404 goldbook:08366)
AnnotationAssertion(rdfs:seeAlso goldbook:08404 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08404 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08404 "current"^^xsd:string)
Declaration(Class(goldbook:08405))
AnnotationAssertion(rdfs:label goldbook:08405 "relaxation reagent")
AnnotationAssertion(dcterms:description goldbook:08405 "Paramagnetic species added to a sample in a nuclear magnetic resonance spectroscopy experiment to promote more rapid spin-lattice relaxation and allow a faster pulse repetition rate.")
AnnotationAssertion(rdfs:seeAlso goldbook:08405 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08405 goldbook:08422)
AnnotationAssertion(mito:isMentionedBy goldbook:08405 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08405 "current"^^xsd:string)
Declaration(Class(goldbook:08406))
AnnotationAssertion(rdfs:label goldbook:08406 "repetition time")
AnnotationAssertion(dcterms:description goldbook:08406 "Time duration between repetitions of a nuclear magnetic resonance pulse sequence including the pulse sequence, acquisition time and relaxation delay.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08406 "TR")
AnnotationAssertion(rdfs:seeAlso goldbook:08406 goldbook:08312)
AnnotationAssertion(rdfs:seeAlso goldbook:08406 goldbook:08396)
AnnotationAssertion(rdfs:seeAlso goldbook:08406 goldbook:08422)
AnnotationAssertion(mito:isMentionedBy goldbook:08406 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08406 "current"^^xsd:string)
Declaration(Class(goldbook:08407))
AnnotationAssertion(rdfs:label goldbook:08407 "residual dipolar coupling")
AnnotationAssertion(dcterms:description goldbook:08407 "Dipolar coupling, but of a reduced magnitude to that seen in solids, observed in a liquid sample between spins in a molecule where there is incomplete averaging of spatially anisotropic dipolar couplings.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08407 "RDC")
AnnotationAssertion(rdfs:comment goldbook:08407 "RDC is typically achieved through partial alignment of molecules in the liquid state through spatially aligned gels or liquids."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08407 "RDC is used to provide 3D structural information on molecules."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08407 goldbook:08330)
AnnotationAssertion(rdfs:seeAlso goldbook:08407 goldbook:08223)
AnnotationAssertion(mito:isMentionedBy goldbook:08407 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08407 "current"^^xsd:string)
Declaration(Class(goldbook:08408))
AnnotationAssertion(rdfs:label goldbook:08408 "rotating-frame NOE spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08408 "Measurement method of nuclear magnetic resonance spectroscopy yielding through-space correlations via spin-spin relaxation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08408 "ROESY")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08408 "cross-relaxation appropriate for minimolecules emulated by locked spins (CAMELPSIN)")
AnnotationAssertion(rdfs:comment goldbook:08408 "ROESY is similar to the NOESY experiment (see nuclear Overhauser effect spectroscopy) and is useful for determining which signals arise from protons that are close to each other in space even if they are not bonded."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08408 "ROESY has the advantage over the NOESY experiment that its response does not go through a null at specific correlation times and is thus preferred for molecules having molecular masses of a few thousand \\(\\pu{Da}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08408 goldbook:08387)
AnnotationAssertion(rdfs:seeAlso goldbook:08408 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08408 goldbook:08425)
AnnotationAssertion(mito:isMentionedBy goldbook:08408 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08408 "current"^^xsd:string)
Declaration(Class(goldbook:08409))
AnnotationAssertion(rdfs:label goldbook:08409 "rotational echo double resonance")
AnnotationAssertion(dcterms:description goldbook:08409 "Measurement method of nuclear magnetic resonance spectroscopy allowing recoupling of heteronuclear dipolar coupling under magic angle spinning.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08409 "REDOR")
AnnotationAssertion(rdfs:seeAlso goldbook:08409 goldbook:08377)
AnnotationAssertion(rdfs:seeAlso goldbook:08409 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08409 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08409 "current"^^xsd:string)
Declaration(Class(goldbook:08410))
AnnotationAssertion(rdfs:label goldbook:08410 "saturation transfer difference spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08410 "Measurement method of nuclear magnetic resonance spectroscopy that allows detection of transient binding of small molecule ligands to macromolecular receptors.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08410 "STD")
AnnotationAssertion(rdfs:comment goldbook:08410 "Range of applicable dissociation constants is approximately \\(\\pu{E-3 M}\\) to \\(\\pu{E-8 M}\\). The experiment relies on ligand-signal attenuation through spin diffusion saturation propagating from the macromolecule."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08410 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08410 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08410 "current"^^xsd:string)
Declaration(Class(goldbook:08411))
AnnotationAssertion(rdfs:label goldbook:08411 "selective decoupling")
AnnotationAssertion(dcterms:description goldbook:08411 "Spin decoupling of a specific resonance by selective irradiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:08411 goldbook:08419)
AnnotationAssertion(mito:isMentionedBy goldbook:08411 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08411 "current"^^xsd:string)
Declaration(Class(goldbook:08412))
AnnotationAssertion(rdfs:label goldbook:08412 "selective excitation")
AnnotationAssertion(dcterms:description goldbook:08412 "Application of a frequency selective radiofrequency pulse(s) to a single resonance or a discrete band of frequencies.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08412 "selective irradiation")
AnnotationAssertion(rdfs:comment goldbook:08412 "Selective excitation is usually achieved through the application of long, low power (soft) pulses."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08412 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08412 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08412 "current"^^xsd:string)
Declaration(Class(goldbook:08413))
AnnotationAssertion(rdfs:label goldbook:08413 "selective pulse")
AnnotationAssertion(dcterms:description goldbook:08413 "Radiofrequency pulse with a narrow frequency spectral bandwidth (long, low-power pulse) to excite nuclei in a limited chemical shift range (see selective excitation).")
AnnotationAssertion(rdfs:seeAlso goldbook:08413 goldbook:08279)
AnnotationAssertion(rdfs:seeAlso goldbook:08413 goldbook:08412)
AnnotationAssertion(rdfs:seeAlso goldbook:08413 goldbook:08286)
AnnotationAssertion(mito:isMentionedBy goldbook:08413 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08413 "current"^^xsd:string)
Declaration(Class(goldbook:08414))
AnnotationAssertion(rdfs:label goldbook:08414 "single crystal nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08414 "Solid-state nuclear magnetic resonance spectroscopy on a single crystal in a similar manner to that used in X-ray diffraction.")
AnnotationAssertion(rdfs:comment goldbook:08414 "A large crystal is mounted on a 'tenon', which is in turn mounted on a goniometer head. If the orientation of the unit cell is known with respect to the tenon, then it is possible to determine the orientation of the NMR interaction tensors with respect to the molecular frame."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08414 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08414 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08414 "current"^^xsd:string)
Declaration(Class(goldbook:08415))
AnnotationAssertion(rdfs:label goldbook:08415 "solid-state nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08415 "Application of nuclear magnetic resonance spectroscopy to solids.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08415 "SSNMR")
AnnotationAssertion(rdfs:comment goldbook:08415 "SSNMR is characterized by the presence of anisotropic (directionally dependent) interactions. Chemical shift anisotropy (CSA) and internuclear dipolar coupling result in severe line-broadening of the corresponding NMR signals and specific hardware and methods are required to perform SSNMR to mitigate some of these issues including magic angle spinning (MAS)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08415 goldbook:08320)
AnnotationAssertion(rdfs:seeAlso goldbook:08415 goldbook:08377)
AnnotationAssertion(rdfs:seeAlso goldbook:08415 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08415 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08415 "current"^^xsd:string)
Declaration(Class(goldbook:08416))
AnnotationAssertion(rdfs:label goldbook:08416 "solvent suppression")
AnnotationAssertion(dcterms:description goldbook:08416 "In nuclear magnetic resonance spectroscopy reduction or removal of large, unwanted resonances from solvents to improve spectrum quality and dynamic range through selective excitation and exploiting differences in relaxation times between solvent and analyte signals.")
AnnotationAssertion(rdfs:seeAlso goldbook:08416 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08416 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08416 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08416 "current"^^xsd:string)
Declaration(Class(goldbook:08417))
AnnotationAssertion(rdfs:label goldbook:08417 "spectral width")
AnnotationAssertion(dcterms:description goldbook:08417 "Frequency range that describes the width of the spectrum window of a specific nucleus in nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08417 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08417 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08417 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08417 "current"^^xsd:string)
Declaration(Class(goldbook:08418))
AnnotationAssertion(rdfs:label goldbook:08418 "spin")
AnnotationAssertion(dcterms:description goldbook:08418 "Intrinsic angular momentum of a nucleus (or other sub-atomic particle).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08418 "nuclear spin")
AnnotationAssertion(rdfs:comment goldbook:08418 "The magnitude of nuclear spin is \\((h/2\\pi)\\sqrt{I(I + 1)}\\) where \\(I\\) is the spin quantum number and \\(h\\) is the Planck constant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08418 "In nuclear magnetic resonance spectroscopy, only nuclei with spin \\(I \\gt 0\\) are observable."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08418 "The spin of a nucleus is dependent on the numbers and alignments of the spins of its individual protons and neutrons."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08418 "Nuclei with a spin of \\(½\\) generate the simplest nuclear magnetic resonance spectra and are thus the most commonly studied."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08418 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08418 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08418 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08418 "current"^^xsd:string)
Declaration(Class(goldbook:08419))
AnnotationAssertion(rdfs:label goldbook:08419 "spin decoupling")
AnnotationAssertion(dcterms:description goldbook:08419 "Irradiation of a nucleus in nuclear magnetic resonance spectroscopy to prevent spin-spin coupling.")
AnnotationAssertion(rdfs:seeAlso goldbook:08419 goldbook:08351)
AnnotationAssertion(rdfs:seeAlso goldbook:08419 goldbook:08365)
AnnotationAssertion(rdfs:seeAlso goldbook:08419 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08419 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08419 "current"^^xsd:string)
Declaration(Class(goldbook:08420))
AnnotationAssertion(rdfs:label goldbook:08420 "spin echo")
AnnotationAssertion(dcterms:description goldbook:08420 "Refocusing of spin magnetization usually by two consecutive radiofrequency pulses.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08420 "SE")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08420 "Hahn echo")
AnnotationAssertion(rdfs:comment goldbook:08420 "The simplest form of the spin-echo pulse sequence consists of \\(\\pu{90\\!^{\\circ}}\\ \\rm{pulse}\\), a \\(\\pu{180\\!^{\\circ}}\\ \\rm{pulse}\\), and then an echo. The time between the middle of the first RF pulse and the peak of the spin echo is called the echo time (\\(T_{\\rm{E}}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08420 "SE is typically used within a pulse sequence to refocus chemical shift by pulses \\(\\pu{90\\!^{\\circ}}\\), \\(T_{\\rm{E}}/2\\), \\(\\pu{180\\!^{\\circ}}\\), \\(T_{\\rm{E}}/2\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08420 goldbook:08310)
AnnotationAssertion(rdfs:seeAlso goldbook:08420 goldbook:08311)
AnnotationAssertion(rdfs:seeAlso goldbook:08420 goldbook:08337)
AnnotationAssertion(rdfs:seeAlso goldbook:08420 goldbook:08343)
AnnotationAssertion(rdfs:seeAlso goldbook:08420 goldbook:08396)
AnnotationAssertion(rdfs:seeAlso goldbook:08420 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08420 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08420 "current"^^xsd:string)
Declaration(Class(goldbook:08421))
AnnotationAssertion(rdfs:label goldbook:08421 "spin system")
AnnotationAssertion(dcterms:description goldbook:08421 "Group of magnetic nuclei that interact amongst themselves through spin-spin coupling but do not interact with any nuclei outside the spin system.")
AnnotationAssertion(mito:isMentionedBy goldbook:08421 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08421 "current"^^xsd:string)
Declaration(Class(goldbook:08422))
AnnotationAssertion(rdfs:label goldbook:08422 "spin-lattice relaxation")
AnnotationAssertion(dcterms:description goldbook:08422 "Mechanism in nuclear magnetic resonance spectroscopy by which the component of the magnetization vector along the direction of the static magnetic induction reaches thermodynamic equilibrium with its surroundings through loss of energy of the excited nuclear spins to the surrounding molecular lattice. The resultant exponential decay of signal is characterized by the spin-lattice relaxation time \\(T_{1}\\) (reciprocal of the rate constant of this mechanism).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08422 "$T_1$ relaxation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08422 "$T1$ relaxation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08422 "longitudinal relaxation")
AnnotationAssertion(rdfs:comment goldbook:08422 "\\(T_{1}\\) dictates the time required between individual NMR scans to ensure the system has returned to equilibrium."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08422 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08422 goldbook:08423)
AnnotationAssertion(mito:isMentionedBy goldbook:08422 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08422 "current"^^xsd:string)
Declaration(Class(goldbook:08423))
AnnotationAssertion(rdfs:label goldbook:08423 "spin-lattice relaxation time")
AnnotationAssertion(dcterms:description goldbook:08423 "Reciprocal of the rate constant of longitudinal relaxation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08423 "spin-lattice time constant")
AnnotationAssertion(rdfs:seeAlso goldbook:08423 goldbook:08422)
AnnotationAssertion(rdfs:seeAlso goldbook:08423 goldbook:08380)
AnnotationAssertion(rdfs:seeAlso goldbook:08423 goldbook:08426)
AnnotationAssertion(mito:isMentionedBy goldbook:08423 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08423 "current"^^xsd:string)
Declaration(Class(goldbook:08424))
AnnotationAssertion(rdfs:label goldbook:08424 "spinning sidebands")
AnnotationAssertion(dcterms:description goldbook:08424 "Satellite peaks in a nuclear magnetic resonance spectrum symetrically spaced either side of a main peak at a frequency offset related to the rate of spinning of the sample.")
AnnotationAssertion(rdfs:comment goldbook:08424 "In solid state nuclear magnetic resonance spectroscopy this occurs if the sample is spun at a rate less than the magnitude of the anisotropic interaction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08424 goldbook:08223)
AnnotationAssertion(rdfs:seeAlso goldbook:08424 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08424 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08424 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08424 "current"^^xsd:string)
Declaration(Class(goldbook:08425))
AnnotationAssertion(rdfs:label goldbook:08425 "spin-spin relaxation")
AnnotationAssertion(dcterms:description goldbook:08425 "Loss of magnetization in the \\(xy\\) plane (in the absence of \\(\\boldsymbol{B_{0}}\\) inhomogeneities) through the interchange of energy between nuclear spins resulting in some precessing faster than the Larmor angular frequency and some slower.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08425 "T2 relaxation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08425 "transverse relaxation")
AnnotationAssertion(rdfs:comment goldbook:08425 "The resultant exponential decay of signal is characterized by the spin-spin relaxation time \\(T_{2}\\) (reciprocal of the rate constant of this mechanism)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08425 goldbook:08375)
AnnotationAssertion(rdfs:seeAlso goldbook:08425 goldbook:08380)
AnnotationAssertion(rdfs:seeAlso goldbook:08425 goldbook:08426)
AnnotationAssertion(mito:isMentionedBy goldbook:08425 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08425 "current"^^xsd:string)
Declaration(Class(goldbook:08426))
AnnotationAssertion(rdfs:label goldbook:08426 "spin-spin relaxation time")
AnnotationAssertion(dcterms:description goldbook:08426 "Reciprocal of the rate constant of spin-spin relaxation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08426 "transverse relaxation time")
AnnotationAssertion(rdfs:seeAlso goldbook:08426 goldbook:08380)
AnnotationAssertion(rdfs:seeAlso goldbook:08426 goldbook:08423)
AnnotationAssertion(rdfs:seeAlso goldbook:08426 goldbook:08425)
AnnotationAssertion(mito:isMentionedBy goldbook:08426 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08426 "current"^^xsd:string)
Declaration(Class(goldbook:08427))
AnnotationAssertion(rdfs:label goldbook:08427 "static magnetic flux density")
AnnotationAssertion(dcterms:description goldbook:08427 "Flux density of the magnetic field of a nuclear magnetic resonance spectrometer about whose direction the nuclear magnetic moment precesses.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08427 "magnetic flux density")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08427 "static magnetic field")
AnnotationAssertion(rdfs:comment goldbook:08427 "The value of \\(\\boldsymbol{B_{0}}\\) is expressed in Tesla or as the nominal proton precession frequency (e.g., \\(\\pu{14 T}\\) or \\(\\pu{600 MHz}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08427 "Static magnetic induction is related to the magnetic field \\(\\boldsymbol{H}\\) through the equation \\(\\boldsymbol{B} = \\mu \\boldsymbol{H}\\) where \\(\\mu\\) is the permeability of the material."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08427 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08427 goldbook:08394)
AnnotationAssertion(mito:isMentionedBy goldbook:08427 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08427 "current"^^xsd:string)
Declaration(Class(goldbook:08428))
AnnotationAssertion(rdfs:label goldbook:08428 "symmetrization")
AnnotationAssertion(dcterms:description goldbook:08428 "Method of removing artefacts from a two-dimensional nuclear magnetic resonance spectrum that are symmetrical about the diagonal (e.g., HH COSY) or the \\(\\rm{f}1\\) axis (e.g., tilted J-resolved spectra). Values equidistant from midline are compared and replaced the lower (or average) value of the two.")
AnnotationAssertion(rdfs:seeAlso goldbook:08428 goldbook:08323)
AnnotationAssertion(rdfs:seeAlso goldbook:08428 goldbook:08373)
AnnotationAssertion(rdfs:seeAlso goldbook:08428 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08428 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08428 "current"^^xsd:string)
Declaration(Class(goldbook:08429))
AnnotationAssertion(rdfs:label goldbook:08429 "<em>t</em><sub>1</sub>")
AnnotationAssertion(dcterms:description goldbook:08429 "Time domain arising from the regular increments of the delay period in two-dimensional nuclear magnetic resonance spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08429 "$t_1$ in 2-D NMR")
AnnotationAssertion(rdfs:seeAlso goldbook:08429 goldbook:08433)
AnnotationAssertion(rdfs:seeAlso goldbook:08429 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08429 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08429 "current"^^xsd:string)
Declaration(Class(goldbook:08430))
AnnotationAssertion(rdfs:label goldbook:08430 "<em>t</em><sub>2</sub>")
AnnotationAssertion(dcterms:description goldbook:08430 "Time domain in two-dimensional nuclear magnetic resonance spectroscopy arising from direct free induction decay detection.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08430 "$t_2$ in 2-D NMR")
AnnotationAssertion(rdfs:seeAlso goldbook:08430 goldbook:08433)
AnnotationAssertion(rdfs:seeAlso goldbook:08430 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08430 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08430 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08430 "current"^^xsd:string)
Declaration(Class(goldbook:08431))
AnnotationAssertion(rdfs:label goldbook:08431 "<em>t</em><sub>1</sub> noise")
AnnotationAssertion(dcterms:description goldbook:08431 "Streaks of spurious artefact signals in a two-dimensional nuclear magnetic resonance spectrum parallel to the \\(\\rm{f}1\\) axis at the \\(\\rm{f}2\\) of a strong resonance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08431 "$t_1$ noise in 2-D NMR")
AnnotationAssertion(rdfs:seeAlso goldbook:08431 goldbook:08439)
AnnotationAssertion(mito:isMentionedBy goldbook:08431 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08431 "current"^^xsd:string)
Declaration(Class(goldbook:08432))
AnnotationAssertion(rdfs:label goldbook:08432 "three-dimensional nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08432 "Measurement method of nuclear magnetic resonance spectroscopy in which data are collected in three time domains.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08432 "3-D NMR")
AnnotationAssertion(rdfs:comment goldbook:08432 "A 3-D NMR experiment may be constructed from a 2-D NMR experiment by inserting an additional indirect evolution time and a second mixing period between the first mixing period and the direct data acquisition."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08432 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08432 goldbook:08438)
AnnotationAssertion(mito:isMentionedBy goldbook:08432 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08432 "current"^^xsd:string)
Declaration(Class(goldbook:08433))
AnnotationAssertion(rdfs:label goldbook:08433 "time domain")
AnnotationAssertion(dcterms:description goldbook:08433 "Condition in nuclear magnetic resonance spectroscopy where the independent variable of all functions is time.")
AnnotationAssertion(rdfs:seeAlso goldbook:08433 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08433 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08433 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08433 "current"^^xsd:string)
Declaration(Class(goldbook:08434))
AnnotationAssertion(rdfs:label goldbook:08434 "time domain nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08434 "Measurement method of nuclear magnetic resonance spectroscopy run at low magnetic field strengths where data analysis is performed directly on the free induction decay, often through the extraction of relaxation time constants")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08434 "TD-NMR")
AnnotationAssertion(rdfs:seeAlso goldbook:08434 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08434 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08434 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08434 "current"^^xsd:string)
Declaration(Class(goldbook:08435))
AnnotationAssertion(rdfs:label goldbook:08435 "total correlation spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08435 "Two-dimensional nuclear magnetic resonance homonuclear correlation experiment, which creates correlations between all protons within a given spin system, not just between geminal or vicinal protons as in COSY.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08435 "TOCSY")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08435 "homonuclear Hartmann-Hahn spectroscopy (HOHAHA)")
AnnotationAssertion(rdfs:comment goldbook:08435 "TOCSY uses a spin lock to allow propagation of magnetization through scalar couplings."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08435 goldbook:08323)
AnnotationAssertion(rdfs:seeAlso goldbook:08435 goldbook:08439)
AnnotationAssertion(rdfs:seeAlso goldbook:08435 goldbook:08421)
AnnotationAssertion(mito:isMentionedBy goldbook:08435 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08435 "current"^^xsd:string)
Declaration(Class(goldbook:08436))
AnnotationAssertion(rdfs:label goldbook:08436 "total suppression of spinning sidebands")
AnnotationAssertion(dcterms:description goldbook:08436 "Technique to suppress spinning sidebands in solid-state nuclear magnetic resonance spectroscopy with cross polarization in magic angle spinning experiments.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08436 "TOSS")
AnnotationAssertion(rdfs:seeAlso goldbook:08436 goldbook:08327)
AnnotationAssertion(rdfs:seeAlso goldbook:08436 goldbook:08377)
AnnotationAssertion(rdfs:seeAlso goldbook:08436 goldbook:08415)
AnnotationAssertion(mito:isMentionedBy goldbook:08436 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08436 "current"^^xsd:string)
Declaration(Class(goldbook:08437))
AnnotationAssertion(rdfs:label goldbook:08437 "transverse relaxation optimized spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08437 "Measurement method of nuclear magnetic resonance spectroscopy, usually in protein NMR, that improves peak sharpness for molecules having a molecular mass of greater than \\(\\pu{100 kDa}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08437 "TROSY")
AnnotationAssertion(rdfs:comment goldbook:08437 "TROSY relies on the cancellation of the dipolar coupling and chemical shift anisotropy (CSA) components of the transverse relaxation (see spin-spin relaxation)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08437 goldbook:08320)
AnnotationAssertion(rdfs:seeAlso goldbook:08437 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08437 goldbook:08425)
AnnotationAssertion(mito:isMentionedBy goldbook:08437 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08437 "current"^^xsd:string)
Declaration(Class(goldbook:08438))
AnnotationAssertion(rdfs:label goldbook:08438 "triple-resonance nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08438 "Measurement method of nuclear magnetic resonance spectroscopy using three NMR-active nuclei.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08438 "triple-resonance NMR")
AnnotationAssertion(rdfs:comment goldbook:08438 "For proteins the three nuclei are usually \\(\\ce{^{1}H}\\) hydrogen, \\(\\ce{^{13}C}\\) carbon, and \\(\\ce{^{15}N}\\) nitrogen, which requires suitable labelling of the sample."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08438 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08438 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08438 "current"^^xsd:string)
Declaration(Class(goldbook:08439))
AnnotationAssertion(rdfs:label goldbook:08439 "two-dimensional nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08439 "Measurement method of nuclear magnetic resonance spectroscopy in which data are collected in two time domains: acquisition of the free induction decay (\\(t_{2}\\)) and a successively incremented delay (\\(t_{1}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08439 "2-D NMR")
AnnotationAssertion(rdfs:comment goldbook:08439 "The resulting data matrix is subjected to two successive Fourier transforms to produce a spectrum with two frequency axes, usually either chemical shift/chemical shift (correlation spectroscopy) or chemical shift/J-coupling (see J-resolved spectroscopy)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08439 goldbook:08373)
AnnotationAssertion(rdfs:seeAlso goldbook:08439 goldbook:08249)
AnnotationAssertion(rdfs:seeAlso goldbook:08439 goldbook:08218)
AnnotationAssertion(rdfs:seeAlso goldbook:08439 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08439 goldbook:08433)
AnnotationAssertion(mito:isMentionedBy goldbook:08439 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08439 "current"^^xsd:string)
Declaration(Class(goldbook:08440))
AnnotationAssertion(rdfs:label goldbook:08440 "wideband, alternating-phase, low-power technique for residual splitting")
AnnotationAssertion(dcterms:description goldbook:08440 "Cluster of pulses applied repeatedly for heteronuclear decoupling.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08440 "WALTZ decoupling")
AnnotationAssertion(rdfs:comment goldbook:08440 "WALTZ is commonly used for proton decoupling during the acquisition of \\(\\ce{^{13}C}\\) spectra."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08440 goldbook:08351)
AnnotationAssertion(mito:isMentionedBy goldbook:08440 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08440 "current"^^xsd:string)
Declaration(Class(goldbook:08441))
AnnotationAssertion(rdfs:label goldbook:08441 "Zeeman levels")
AnnotationAssertion(dcterms:description goldbook:08441 "Energy levels of a nucleus arising from the interaction of its magnetic dipole with an external magnetic field.")
AnnotationAssertion(rdfs:seeAlso goldbook:08441 goldbook:08246)
AnnotationAssertion(mito:isMentionedBy goldbook:08441 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08441 "current"^^xsd:string)
Declaration(Class(goldbook:08442))
AnnotationAssertion(rdfs:label goldbook:08442 "zero-field nuclear magnetic resonance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08442 "Measurement method of nuclear magnetic resonance spectroscopy in which nuclear magnetic resonance spectra are acquired in an environment carefully screened from magnetic fields, including from the Earth’s field allowing the direct detection of J-spectra in the absence of Zeeman interactions (see Zeeman levels).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08442 "zero-field NMR")
AnnotationAssertion(rdfs:seeAlso goldbook:08442 goldbook:08441)
AnnotationAssertion(rdfs:seeAlso goldbook:08442 goldbook:08384)
AnnotationAssertion(rdfs:seeAlso goldbook:08442 goldbook:08218)
AnnotationAssertion(mito:isMentionedBy goldbook:08442 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08442 "current"^^xsd:string)
Declaration(Class(goldbook:08443))
AnnotationAssertion(rdfs:label goldbook:08443 "ablation by sputtering")
AnnotationAssertion(dcterms:description goldbook:08443 "Bombardment of a sample surface with ions resulting in the removal of atoms from their lattice sites, and thus an ongoing discharge process that causes continuous ablation of the sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:08443 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08443 "current"^^xsd:string)
Declaration(Class(goldbook:08444))
AnnotationAssertion(rdfs:label goldbook:08444 "ablation efficiency")
AnnotationAssertion(dcterms:description goldbook:08444 "Mass of sample removed in laser-induced breakdown spectroscopy divided by the energy delivered by the laser beam.")
AnnotationAssertion(rdfs:seeAlso goldbook:08444 goldbook:08500)
AnnotationAssertion(mito:isMentionedBy goldbook:08444 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08444 "current"^^xsd:string)
Declaration(Class(goldbook:08445))
AnnotationAssertion(rdfs:label goldbook:08445 "ablation rate")
AnnotationAssertion(dcterms:description goldbook:08445 "Depth of sample layer removed in the glow discharge process per unit time.")
AnnotationAssertion(rdfs:comment goldbook:08445 "Ablation rate is usually expressed in \\(\\pu{nm s-1}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08445 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08445 "current"^^xsd:string)
Declaration(Class(goldbook:08446))
AnnotationAssertion(rdfs:label goldbook:08446 "ablation threshold fluence")
AnnotationAssertion(dcterms:description goldbook:08446 "Minimum fluence required to achieve ablation of the sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:08446 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08446 "current"^^xsd:string)
Declaration(Class(goldbook:08447))
AnnotationAssertion(rdfs:label goldbook:08447 "acid transient effects")
AnnotationAssertion(dcterms:description goldbook:08447 "Increase in signal equilibration time or in wash out time caused by a modification in inorganic acid concentration.")
AnnotationAssertion(mito:isMentionedBy goldbook:08447 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08447 "current"^^xsd:string)
Declaration(Class(goldbook:08448))
AnnotationAssertion(rdfs:label goldbook:08448 "additional gases")
AnnotationAssertion(dcterms:description goldbook:08448 "Gases added to a combustion mixture.")
AnnotationAssertion(rdfs:comment goldbook:08448 "An inert diluent is non-reactive, an auxiliary gas is reactive."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08448 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08448 "current"^^xsd:string)
Declaration(Class(goldbook:08449))
AnnotationAssertion(rdfs:label goldbook:08449 "aerosol transport phenomena")
AnnotationAssertion(dcterms:description goldbook:08449 "Processes occurring inside the spray chamber or desolvation system responsible for the modification of the primary aerosol to finally yield the tertiary aerosol.")
AnnotationAssertion(rdfs:comment goldbook:08449 "These phenomena include solvent evaporation, droplet coalescence or coagulation, inertial droplet losses, gravitational settling and turbulence losses."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08449 goldbook:08529)
AnnotationAssertion(rdfs:seeAlso goldbook:08449 goldbook:08551)
AnnotationAssertion(mito:isMentionedBy goldbook:08449 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08449 "current"^^xsd:string)
Declaration(Class(goldbook:08450))
AnnotationAssertion(rdfs:label goldbook:08450 "analyte transport rate")
AnnotationAssertion(dcterms:description goldbook:08450 "Mass of analyte reaching the plasma per unit time.")
AnnotationAssertion(mito:isMentionedBy goldbook:08450 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08450 "current"^^xsd:string)
Declaration(Class(goldbook:08451))
AnnotationAssertion(rdfs:label goldbook:08451 "atomic absorption spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08451 "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the absorption of characteristic electromagnetic radiation by atoms in the vapour phase.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08451 "AAS")
AnnotationAssertion(rdfs:seeAlso goldbook:08451 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08451 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08451 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08451 "current"^^xsd:string)
Declaration(Class(goldbook:08452))
AnnotationAssertion(rdfs:label goldbook:08452 "atomic emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08452 "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the intensity of characteristic electromagnetic radiation emitted by atoms or molecules.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08452 "AES")
AnnotationAssertion(rdfs:seeAlso goldbook:08452 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08452 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08452 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08452 "current"^^xsd:string)
Declaration(Class(goldbook:08453))
AnnotationAssertion(rdfs:label goldbook:08453 "atomic excitation source")
AnnotationAssertion(dcterms:description goldbook:08453 "Atomizer intended to convert free atoms to an excited state.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08453 "excitation source")
AnnotationAssertion(mito:isMentionedBy goldbook:08453 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08453 "current"^^xsd:string)
Declaration(Class(goldbook:08454))
AnnotationAssertion(rdfs:label goldbook:08454 "atomic fluorescence spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08454 "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the re-emission of characteristic electromagnetic radiation by atoms, following the absorption of radiation in the vapour phase.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08454 "AFS")
AnnotationAssertion(rdfs:comment goldbook:08454 "The wavelengths of the absorbed and re-emitted radiation may be identical (atomic resonance fluorescence spectroscopy) or different."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08454 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08454 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08454 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08454 "current"^^xsd:string)
Declaration(Class(goldbook:08455))
AnnotationAssertion(rdfs:label goldbook:08455 "atomic vapour")
AnnotationAssertion(dcterms:description goldbook:08455 "Vapour containing free atoms of analyte.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08455 "atomic vapor")
AnnotationAssertion(mito:isMentionedBy goldbook:08455 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08455 "current"^^xsd:string)
Declaration(Class(goldbook:08456))
AnnotationAssertion(rdfs:label goldbook:08456 "atomization curve")
AnnotationAssertion(dcterms:description goldbook:08456 "Graph of absorbance against atomization temperature.")
AnnotationAssertion(mito:isMentionedBy goldbook:08456 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08456 "current"^^xsd:string)
Declaration(Class(goldbook:08457))
AnnotationAssertion(rdfs:label goldbook:08457 "axial viewing mode")
AnnotationAssertion(dcterms:description goldbook:08457 "Inductively-coupled plasma optical emission spectrometer configuration in which the entrance slit is aligned with the main plasma axis.")
AnnotationAssertion(rdfs:comment goldbook:08457 "The large amount of light captured in this method, includes information from the sample of interest plus background, which can be considerable."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08457 "Matrix interferences, which originate in the cooler plasma tail, can degrade precision and accuracy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08457 goldbook:08491)
AnnotationAssertion(mito:isMentionedBy goldbook:08457 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08457 "current"^^xsd:string)
Declaration(Class(goldbook:08458))
AnnotationAssertion(rdfs:label goldbook:08458 "background continuum emission")
AnnotationAssertion(dcterms:description goldbook:08458 "Intense continuous background usually observed in laser-induced breakdown spectra.")
AnnotationAssertion(rdfs:comment goldbook:08458 "The continuum emission originates from Bremsstrahlung radiation, which predominates the first part of the plasma life time and decreases with further plasma evolution."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08458 goldbook:08501)
AnnotationAssertion(mito:isMentionedBy goldbook:08458 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08458 "current"^^xsd:string)
Declaration(Class(goldbook:08459))
AnnotationAssertion(rdfs:label goldbook:08459 "background equivalent concentration")
AnnotationAssertion(dcterms:description goldbook:08459 "Concentration of a given element measured at a given wavelength providing the same intensity as the background.")
AnnotationAssertion(rdfs:seeAlso goldbook:08459 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08459 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08459 "current"^^xsd:string)
Declaration(Class(goldbook:08460))
AnnotationAssertion(rdfs:label goldbook:08460 "breakdown threshold fluence")
AnnotationAssertion(dcterms:description goldbook:08460 "Minimum fluence required to achieve measurable emission signals")
AnnotationAssertion(rdfs:comment goldbook:08460 "Usually the breakdown-threshold fluence is orders of magnitude higher than the ablation-threshold fluence."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08460 goldbook:08446)
AnnotationAssertion(mito:isMentionedBy goldbook:08460 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08460 "current"^^xsd:string)
Declaration(Class(goldbook:08461))
AnnotationAssertion(rdfs:label goldbook:08461 "capacitive microwave plasma")
AnnotationAssertion(dcterms:description goldbook:08461 "Plasma generated by a capacitor in presence of a microwave field.")
AnnotationAssertion(mito:isMentionedBy goldbook:08461 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08461 "current"^^xsd:string)
Declaration(Class(goldbook:08462))
AnnotationAssertion(rdfs:label goldbook:08462 "characteristic line")
AnnotationAssertion(dcterms:description goldbook:08462 "Spectral line of an atom used for the measurement of analyte concentration by atomic spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:08462 "Characteristic lines include resonance and non-resonance lines."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08462 goldbook:08550)
AnnotationAssertion(rdfs:seeAlso goldbook:08462 goldbook:08216)
AnnotationAssertion(mito:isMentionedBy goldbook:08462 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08462 "current"^^xsd:string)
Declaration(Class(goldbook:08463))
AnnotationAssertion(rdfs:label goldbook:08463 "continuum source")
AnnotationAssertion(dcterms:description goldbook:08463 "Source that emits electromagnetic radiation with relatively constant intensity over a broad spectral region.")
AnnotationAssertion(rdfs:comment goldbook:08463 "The use of such a source allows for correction of spectral interferences."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08463 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08463 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08463 "current"^^xsd:string)
Declaration(Class(goldbook:08464))
AnnotationAssertion(rdfs:label goldbook:08464 "depth-profiling")
AnnotationAssertion(dcterms:description goldbook:08464 "Process by which the sample is sputtered 'atomic layer by layer' using suitable conditions.")
AnnotationAssertion(rdfs:comment goldbook:08464 "Depth profile analysis can be accomplished by time resolved measurement of the generated emission signals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08464 "Depth profiling using signal versus time measurement requires knowledge of the ablation rate, which must be known, or has to be calculated, from measurements of suitable materials."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08464 goldbook:08445)
AnnotationAssertion(mito:isMentionedBy goldbook:08464 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08464 "current"^^xsd:string)
Declaration(Class(goldbook:08465))
AnnotationAssertion(rdfs:label goldbook:08465 "direct current glow discharge optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08465 "Measurement method using optical emission spectroscopy in which atomization and excitation occur in a glow electric discharge sustained by a direct current electric field.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08465 "DC GD-OES")
AnnotationAssertion(rdfs:comment goldbook:08465 "Generated argon ions impact with high energy on to the surface of the cathode, which can thus be ablated in a purely mechanical way (cathodic sputtering) or the cathode can be heated to assist evaporation (thermal volatilization)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08465 "DC GD-OES is only applicable for electrically conducting samples."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08465 goldbook:08482)
AnnotationAssertion(rdfs:seeAlso goldbook:08465 goldbook:08513)
AnnotationAssertion(mito:isMentionedBy goldbook:08465 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08465 "current"^^xsd:string)
Declaration(Class(goldbook:08466))
AnnotationAssertion(rdfs:label goldbook:08466 "dispersion of a sample")
AnnotationAssertion(dcterms:description goldbook:08466 "Conversion of the whole or part of a liquid or solid sample into a physical form sufficiently finely divided to allow it to be atomized (see atomization) upon introduction into the atomizer.")
AnnotationAssertion(mito:isMentionedBy goldbook:08466 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08466 "current"^^xsd:string)
Declaration(Class(goldbook:08467))
AnnotationAssertion(rdfs:label goldbook:08467 "double-pulse laser-induced breakdown spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08467 "Measurement method of laser-induced breakdown spectroscopy in which reactions are induced by the interaction of the evolved plasma and the remaining part of the laser pulse, or with a following laser pulse provided from a second laser system.")
AnnotationAssertion(rdfs:seeAlso goldbook:08467 goldbook:08500)
AnnotationAssertion(mito:isMentionedBy goldbook:08467 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08467 "current"^^xsd:string)
Declaration(Class(goldbook:08468))
AnnotationAssertion(rdfs:label goldbook:08468 "dual viewing mode")
AnnotationAssertion(dcterms:description goldbook:08468 "Inductively-coupled plasma spectrometer that allows axial viewing mode or radial viewing mode.")
AnnotationAssertion(rdfs:seeAlso goldbook:08468 goldbook:08489)
AnnotationAssertion(mito:isMentionedBy goldbook:08468 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08468 "current"^^xsd:string)
Declaration(Class(goldbook:08469))
AnnotationAssertion(rdfs:label goldbook:08469 "electric discharge")
AnnotationAssertion(dcterms:description goldbook:08469 "Transmission of electrical current by a plasma in an applied electric field through a normally non-conducting medium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08469 "discharge")
AnnotationAssertion(rdfs:comment goldbook:08469 "An inductively-coupled plasma is a kind of electric discharge."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08469 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08469 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08469 "current"^^xsd:string)
Declaration(Class(goldbook:08470))
AnnotationAssertion(rdfs:label goldbook:08470 "electron number density")
AnnotationAssertion(dcterms:description goldbook:08470 "Number of free electrons in vapour phase per volume unit.")
AnnotationAssertion(rdfs:comment goldbook:08470 "SI unit: \\(\\pu{m-3}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08470 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08470 "current"^^xsd:string)
Declaration(Class(goldbook:08471))
AnnotationAssertion(rdfs:label goldbook:08471 "electrothermal atomic absorption spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08471 "Measurement method of atomic absorption spectroscopy in which the sample is atomized by an electrothermal atomizer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08471 "ETAAS")
AnnotationAssertion(rdfs:seeAlso goldbook:08471 goldbook:08451)
AnnotationAssertion(mito:isMentionedBy goldbook:08471 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08471 "current"^^xsd:string)
Declaration(Class(goldbook:08472))
AnnotationAssertion(rdfs:label goldbook:08472 "electrothermal vaporization")
AnnotationAssertion(dcterms:description goldbook:08472 "Technique for sample introduction based on the use of a solid furnace heated at a controlled temperature to vaporize the sample prior to its introduction into an inductively-coupled plasma.")
AnnotationAssertion(rdfs:seeAlso goldbook:08472 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08472 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08472 "current"^^xsd:string)
Declaration(Class(goldbook:08473))
AnnotationAssertion(rdfs:label goldbook:08473 "<em>E</em><sub>sum</sub>")
AnnotationAssertion(dcterms:description goldbook:08473 "Energy that must be supplied to an atom to transfer it from the ground atomic state to a given ionic excited state.")
AnnotationAssertion(mito:isMentionedBy goldbook:08473 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08473 "current"^^xsd:string)
Declaration(Class(goldbook:08474))
AnnotationAssertion(rdfs:label goldbook:08474 "flame atomic spectrometer")
AnnotationAssertion(dcterms:description goldbook:08474 "Spectrometer to make measurements by flame atomic spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08474 goldbook:08475)
AnnotationAssertion(mito:isMentionedBy goldbook:08474 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08474 "current"^^xsd:string)
Declaration(Class(goldbook:08475))
AnnotationAssertion(rdfs:label goldbook:08475 "flame atomic spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08475 "Measurement method of atomic spectroscopy that uses a flame to excite atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08475 "flame atomic spectrometry")
AnnotationAssertion(rdfs:seeAlso goldbook:08475 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08475 goldbook:08476)
AnnotationAssertion(mito:isMentionedBy goldbook:08475 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08475 "current"^^xsd:string)
Declaration(Class(goldbook:08476))
AnnotationAssertion(rdfs:label goldbook:08476 "flame")
AnnotationAssertion(dcterms:description goldbook:08476 "Continuously flowing mixture of hot gases with a stationary position that derives its heat content from a strongly exothermic, irreversible chemical reaction between a fuel and an oxidant.")
AnnotationAssertion(rdfs:comment goldbook:08476 "The flame in general consists of a primary-combustion zone, a secondary-combustion zone and an interconal zone."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08476 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08476 "current"^^xsd:string)
Declaration(Class(goldbook:08477))
AnnotationAssertion(rdfs:label goldbook:08477 "flow spoiler")
AnnotationAssertion(dcterms:description goldbook:08477 "Component of a flame atomic spectrometer for creating turbulence in the stream of mist in the spray chamber and removing the largest droplets from this mist by deposition.")
AnnotationAssertion(rdfs:seeAlso goldbook:08477 goldbook:08474)
AnnotationAssertion(mito:isMentionedBy goldbook:08477 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08477 "current"^^xsd:string)
Declaration(Class(goldbook:08478))
AnnotationAssertion(rdfs:label goldbook:08478 "gate delay")
AnnotationAssertion(dcterms:description goldbook:08478 "Time between the application of a laser pulse and the start of detection in laser-induced breakdown spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08478 "time delay in laser induced breakdown spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:08478 "The gate delay varies from some hundreds of nanoseconds to several microseconds."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08478 "Use of a suitable gate delay allows the high intensity background continuum emission present in the early stages of plasma formation to be removed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08478 goldbook:08500)
AnnotationAssertion(mito:isMentionedBy goldbook:08478 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08478 "current"^^xsd:string)
Declaration(Class(goldbook:08479))
AnnotationAssertion(rdfs:label goldbook:08479 "GD-OES spectrometers with simultaneous detection")
AnnotationAssertion(dcterms:description goldbook:08479 "Spectrometers for glow discharge optical emission spectroscopy that allow simultaneous monitoring of selected spectral ranges or the whole emission spectra.")
AnnotationAssertion(rdfs:comment goldbook:08479 "GD-OES spectrometers mostly use the so called Paschen–Runge mounting, where the entrance slit, the curved grating and different detectors are aligned along the Rowland circle. Alternatively, Echelle spectrometers (see GD-OES spectrometers with simultaneous detection) are used, which use an Echelle grating in combination with a prism for wavelength separation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08479 goldbook:08483)
AnnotationAssertion(mito:isMentionedBy goldbook:08479 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08479 "current"^^xsd:string)
Declaration(Class(goldbook:08480))
AnnotationAssertion(rdfs:label goldbook:08480 "generator coupling efficiency")
AnnotationAssertion(dcterms:description goldbook:08480 "Fraction of the energy generated being used for creating and maintaining the plasma in an inductively-coupled plasma spectrometer.")
AnnotationAssertion(rdfs:seeAlso goldbook:08480 goldbook:08489)
AnnotationAssertion(mito:isMentionedBy goldbook:08480 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08480 "current"^^xsd:string)
Declaration(Class(goldbook:08481))
AnnotationAssertion(rdfs:label goldbook:08481 "glow discharge source")
AnnotationAssertion(dcterms:description goldbook:08481 "Component of an atomic emission spectrometer employing a glow electric discharge used in atomic emission spectroscopy for qualitative and quantitative analysis of solid materials.")
AnnotationAssertion(rdfs:comment goldbook:08481 "Glow discharge allows volatilization as well as excitation of analytes and sample matrices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08481 goldbook:08452)
AnnotationAssertion(rdfs:seeAlso goldbook:08481 goldbook:08482)
AnnotationAssertion(mito:isMentionedBy goldbook:08481 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08481 "current"^^xsd:string)
Declaration(Class(goldbook:08482))
AnnotationAssertion(rdfs:label goldbook:08482 "glow electric discharge")
AnnotationAssertion(dcterms:description goldbook:08482 "Electric discharge in gas at low pressure (\\(\\pu{100}\\) to \\(\\pu{1000 Pa}\\)).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08482 "glow discharge")
AnnotationAssertion(rdfs:comment goldbook:08482 "In atomic emission spectroscopy argon is used as the inert working gas that generates the plasma."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08482 "In the prevailing electrical field the produced ions are accelerated towards the cathode, resulting in a continuous bombardment of the sample surface."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08482 goldbook:08469)
AnnotationAssertion(rdfs:seeAlso goldbook:08482 goldbook:08452)
AnnotationAssertion(mito:isMentionedBy goldbook:08482 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08482 "current"^^xsd:string)
Declaration(Class(goldbook:08483))
AnnotationAssertion(rdfs:label goldbook:08483 "glow-discharge optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08483 "Optical emission spectroscopy in which a glow electric discharge excites atoms at the surface of a sample, which is made the cathode of the discharge.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08483 "GD-OES")
AnnotationAssertion(rdfs:seeAlso goldbook:08483 goldbook:08513)
AnnotationAssertion(rdfs:seeAlso goldbook:08483 goldbook:08465)
AnnotationAssertion(rdfs:seeAlso goldbook:08483 goldbook:08482)
AnnotationAssertion(rdfs:seeAlso goldbook:08483 goldbook:08537)
AnnotationAssertion(mito:isMentionedBy goldbook:08483 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08483 "current"^^xsd:string)
Declaration(Class(goldbook:08484))
AnnotationAssertion(rdfs:label goldbook:08484 "Grimm-type cathode")
AnnotationAssertion(dcterms:description goldbook:08484 "Cathode for a glow electric discharge consisting of a flat sample, which is cooled during the discharge process so that thermal volatilization is suppressed and the sample material is removed by sputtering only.")
AnnotationAssertion(rdfs:seeAlso goldbook:08484 goldbook:08482)
AnnotationAssertion(rdfs:seeAlso goldbook:08484 goldbook:08557)
AnnotationAssertion(mito:isMentionedBy goldbook:08484 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08484 "current"^^xsd:string)
Declaration(Class(goldbook:08485))
AnnotationAssertion(rdfs:label goldbook:08485 "hollow-cathode discharge source")
AnnotationAssertion(dcterms:description goldbook:08485 "Glow discharge source with a graphite cathode, into which the sample is inserted in the form of drillings, a pressed pellet or a dry solution residue.")
AnnotationAssertion(rdfs:comment goldbook:08485 "For this source, sample volatilization takes place mainly by thermal effects."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08485 goldbook:08481)
AnnotationAssertion(mito:isMentionedBy goldbook:08485 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08485 "current"^^xsd:string)
Declaration(Class(goldbook:08486))
AnnotationAssertion(rdfs:label goldbook:08486 "hollow-cathode lamp")
AnnotationAssertion(dcterms:description goldbook:08486 "Glow discharge source of spectral lines of an atom in which the cathode is made of the desired element.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08486 "line source")
AnnotationAssertion(rdfs:comment goldbook:08486 "It is often referred to as line source, as opposed to a continuum source."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08486 goldbook:08481)
AnnotationAssertion(rdfs:seeAlso goldbook:08486 goldbook:08463)
AnnotationAssertion(rdfs:seeAlso goldbook:08486 goldbook:08550)
AnnotationAssertion(mito:isMentionedBy goldbook:08486 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08486 "current"^^xsd:string)
Declaration(Class(goldbook:08487))
AnnotationAssertion(rdfs:label goldbook:08487 "incident power")
AnnotationAssertion(dcterms:description goldbook:08487 "Power supplied by a generator to the plasma.")
AnnotationAssertion(mito:isMentionedBy goldbook:08487 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08487 "current"^^xsd:string)
Declaration(Class(goldbook:08488))
AnnotationAssertion(rdfs:label goldbook:08488 "inductively-coupled plasma")
AnnotationAssertion(dcterms:description goldbook:08488 "Plasma produced by induction by means of a high-frequency (about \\(\\pu{2500 Hz}\\)) electromagnetic field. The region of gas at high temperature and free from the field is taken as the region of observation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08488 "ICP")
AnnotationAssertion(rdfs:seeAlso goldbook:08488 goldbook:08490)
AnnotationAssertion(rdfs:seeAlso goldbook:08488 goldbook:08491)
AnnotationAssertion(mito:isMentionedBy goldbook:08488 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08488 "current"^^xsd:string)
Declaration(Class(goldbook:08489))
AnnotationAssertion(rdfs:label goldbook:08489 "inductively-coupled plasma spectrometry")
AnnotationAssertion(dcterms:description goldbook:08489 "Measurement method of atomic spectroscopy that uses an inductively-coupled plasma to excite and ionize atoms.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08489 "ICP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08489 "inductively-coupled plasma spectroscopy")
AnnotationAssertion(rdfs:comment goldbook:08489 "ICP methods are described by their method of detection of ions in the plasma and include inductively-coupled plasma optical emission spectroscopy, and inductively-coupled plasma mass spectrometry."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08489 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08489 goldbook:08488)
AnnotationAssertion(rdfs:seeAlso goldbook:08489 goldbook:08490)
AnnotationAssertion(rdfs:seeAlso goldbook:08489 goldbook:08491)
AnnotationAssertion(mito:isMentionedBy goldbook:08489 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08489 "current"^^xsd:string)
Declaration(Class(goldbook:08490))
AnnotationAssertion(rdfs:label goldbook:08490 "inductively-coupled plasma mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:08490 "Measurement method of atomic spectrometry that uses an inductively-coupled plasma to excite and ionize atoms with measurement of the number and kind of ions in the plasma using mass spectrometry.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08490 "ICP-MS")
AnnotationAssertion(rdfs:seeAlso goldbook:08490 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08490 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08490 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08490 "current"^^xsd:string)
Declaration(Class(goldbook:08491))
AnnotationAssertion(rdfs:label goldbook:08491 "inductively-coupled plasma optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08491 "Measurement method of atomic spectroscopy that uses an inductively-coupled plasma to excite and ionize atoms with measurement of the number and kind of ions in the plasma from their emission of electromagnetic radiation (see optical emission spectroscopy).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08491 "ICP-OES")
AnnotationAssertion(rdfs:seeAlso goldbook:08491 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08491 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08491 goldbook:08488)
AnnotationAssertion(rdfs:seeAlso goldbook:08491 goldbook:08513)
AnnotationAssertion(mito:isMentionedBy goldbook:08491 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08491 "current"^^xsd:string)
Declaration(Class(goldbook:08492))
AnnotationAssertion(rdfs:label goldbook:08492 "inductively-coupled plasma robustness")
AnnotationAssertion(dcterms:description goldbook:08492 "Ability of an inductively-coupled plasma to withstand slight modification in the operating conditions and/or matrix composition with no significant changes in its fundamental characteristics (i.e., temperatures, electron number density) or the analytical figures of merit (i.e., sensitivity, detection limits or signal-to-noise ratio)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08492 "plasma robustness")
AnnotationAssertion(rdfs:seeAlso goldbook:08492 goldbook:08488)
AnnotationAssertion(rdfs:seeAlso goldbook:08492 goldbook:08282)
AnnotationAssertion(mito:isMentionedBy goldbook:08492 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08492 "current"^^xsd:string)
Declaration(Class(goldbook:08493))
AnnotationAssertion(rdfs:label goldbook:08493 "inductively-coupled plasma thermal pinch")
AnnotationAssertion(dcterms:description goldbook:08493 "Decrease in the inductively-coupled plasma volume normally caused when an organic volatile solution is delivered to it. Organic vapours diffuse towards the outermost area of the plasma and its volume decreases.")
AnnotationAssertion(rdfs:seeAlso goldbook:08493 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08493 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08493 "current"^^xsd:string)
Declaration(Class(goldbook:08494))
AnnotationAssertion(rdfs:label goldbook:08494 "inductively-coupled plasma torch")
AnnotationAssertion(dcterms:description goldbook:08494 "Quartz component of an inductively-coupled plasma spectrometer where the plasma is generated and stabilized.")
AnnotationAssertion(rdfs:comment goldbook:08494 "In ICP the torch is an open three concentric tubes assembly allowing the introduction of the three gas streams constituting the plasma. The inner tube of the torch can be made of a different material such as alumina and is usually called the injector."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08494 goldbook:08489)
AnnotationAssertion(mito:isMentionedBy goldbook:08494 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08494 "current"^^xsd:string)
Declaration(Class(goldbook:08495))
AnnotationAssertion(rdfs:label goldbook:08495 "initial plasma radiation zone")
AnnotationAssertion(dcterms:description goldbook:08495 "Inductively-coupled plasma volume in inductively-coupled plasma optical emission spectroscopy where the analytically-relevant light emission begins to be observed.")
AnnotationAssertion(rdfs:seeAlso goldbook:08495 goldbook:08488)
AnnotationAssertion(rdfs:seeAlso goldbook:08495 goldbook:08491)
AnnotationAssertion(mito:isMentionedBy goldbook:08495 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08495 "current"^^xsd:string)
Declaration(Class(goldbook:08496))
AnnotationAssertion(rdfs:label goldbook:08496 "interference curve")
AnnotationAssertion(dcterms:description goldbook:08496 "Graph of absorbance or intensity plotted as a function of the concentration of an interfering element in an atomic spectroscopy experiment.")
AnnotationAssertion(rdfs:seeAlso goldbook:08496 goldbook:08216)
AnnotationAssertion(mito:isMentionedBy goldbook:08496 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08496 "current"^^xsd:string)
Declaration(Class(goldbook:08497))
AnnotationAssertion(rdfs:label goldbook:08497 "inverse Bremsstrahlung")
AnnotationAssertion(dcterms:description goldbook:08497 "Absorption of photon energy by free electrons.")
AnnotationAssertion(rdfs:comment goldbook:08497 "Inverse Bremsstrahlung increases the kinetic energy of the electrons, which is important for heating the plasma."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08497 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08497 "current"^^xsd:string)
Declaration(Class(goldbook:08498))
AnnotationAssertion(rdfs:label goldbook:08498 "ionic cloud")
AnnotationAssertion(dcterms:description goldbook:08498 "Gas phase containing free ions of analyte.")
AnnotationAssertion(mito:isMentionedBy goldbook:08498 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08498 "current"^^xsd:string)
Declaration(Class(goldbook:08499))
AnnotationAssertion(rdfs:label goldbook:08499 "laser ablation")
AnnotationAssertion(dcterms:description goldbook:08499 "Removal of material as an aerosol from a surface on irradiation by a laser beam.")
AnnotationAssertion(mito:isMentionedBy goldbook:08499 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08499 "current"^^xsd:string)
Declaration(Class(goldbook:08500))
AnnotationAssertion(rdfs:label goldbook:08500 "laser induced breakdown spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08500 "Measurement method of atomic spectroscopy that uses a focused laser beam to ablate, atomize and excite atoms from a sample surface with subsequent measurement of the generated electromagnetic radiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08500 "LIBS")
AnnotationAssertion(rdfs:seeAlso goldbook:08500 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08500 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08500 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08500 "current"^^xsd:string)
Declaration(Class(goldbook:08501))
AnnotationAssertion(rdfs:label goldbook:08501 "laser-induced breakdown spectrum")
AnnotationAssertion(dcterms:description goldbook:08501 "Emission spectrum generated as a consequence of the decay of the excited states generated in a laser-induced plasma that consists of a continuous background and element-specific atomic or ionic lines and molecular bands.")
AnnotationAssertion(rdfs:comment goldbook:08501 "LIBS spectra cover a wide wavelength range. Commonly, LIBS measurements are taken between the wavelengths of \\(\\pu{200 nm}\\) and \\(\\pu{1000 nm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08501 goldbook:08502)
AnnotationAssertion(rdfs:seeAlso goldbook:08501 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08501 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08501 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08501 "current"^^xsd:string)
Declaration(Class(goldbook:08502))
AnnotationAssertion(rdfs:label goldbook:08502 "laser-induced plasma")
AnnotationAssertion(dcterms:description goldbook:08502 "Local plasma formed by the interaction between a laser beam and a solid sample and initiated by the production of primary electrons by multiphoton ionization and thermionic photoemission mechanisms.")
AnnotationAssertion(rdfs:comment goldbook:08502 "As well as electrons, laser-induced plasma contains ions, and neutral atoms as well as excited species of the ablated matter. Decay of these excited species generates the light emission analysed in laser-induced breakdown spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08502 goldbook:08500)
AnnotationAssertion(mito:isMentionedBy goldbook:08502 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08502 "current"^^xsd:string)
Declaration(Class(goldbook:08503))
AnnotationAssertion(rdfs:label goldbook:08503 "line-broadening")
AnnotationAssertion(dcterms:description goldbook:08503 "Increase in the theoretical width of a spectral line owing to thermal motion of emitting atoms (Doppler effect), to electric field (Stark effect), to self-absorption and to pressure (Lorentz effect).")
AnnotationAssertion(rdfs:comment goldbook:08503 "Line-broadening increases the measurement uncertainty of a measurement."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08503 goldbook:08550)
AnnotationAssertion(mito:isMentionedBy goldbook:08503 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08503 "current"^^xsd:string)
Declaration(Class(goldbook:08504))
AnnotationAssertion(rdfs:label goldbook:08504 "line profile")
AnnotationAssertion(dcterms:description goldbook:08504 "Graph of the variation of emitted radiation intensity as a function of wavelength (emission line) or the variation of the absorption factor as a function of wavelength (absorption line).")
AnnotationAssertion(rdfs:seeAlso goldbook:08504 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08504 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08504 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08504 "current"^^xsd:string)
Declaration(Class(goldbook:08505))
AnnotationAssertion(rdfs:label goldbook:08505 "low sample consumption system")
AnnotationAssertion(dcterms:description goldbook:08505 "Liquid-sample introduction system to an inductively-coupled plasma spectrometer adapted to work at sample flow rates below \\(\\pu{100 \\upmu L min-1}\\).")
AnnotationAssertion(rdfs:comment goldbook:08505 "The system is normally composed of a micro-nebulizer and a low inner volume spray chamber."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08505 goldbook:08489)
AnnotationAssertion(rdfs:seeAlso goldbook:08505 goldbook:08510)
AnnotationAssertion(mito:isMentionedBy goldbook:08505 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08505 "current"^^xsd:string)
Declaration(Class(goldbook:08506))
AnnotationAssertion(rdfs:label goldbook:08506 "measurement efficiency")
AnnotationAssertion(dcterms:description goldbook:08506 "Number of detector events per atom in the sample.")
AnnotationAssertion(mito:isMentionedBy goldbook:08506 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08506 "current"^^xsd:string)
Declaration(Class(goldbook:08507))
AnnotationAssertion(rdfs:label goldbook:08507 "microwave cavity")
AnnotationAssertion(dcterms:description goldbook:08507 "Resonant cavity that permits focusing a microwave field inside a discharge tube thus giving rise to a standing wave.")
AnnotationAssertion(mito:isMentionedBy goldbook:08507 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08507 "current"^^xsd:string)
Declaration(Class(goldbook:08508))
AnnotationAssertion(rdfs:label goldbook:08508 "microwave-induced plasma")
AnnotationAssertion(dcterms:description goldbook:08508 "Plasma generated in a microwave cavity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08508 "microwave plasma")
AnnotationAssertion(rdfs:comment goldbook:08508 "The plasma results as a consequence of ionization of a given gas in presence of electrons and a microwave field."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08508 goldbook:08507)
AnnotationAssertion(mito:isMentionedBy goldbook:08508 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08508 "current"^^xsd:string)
Declaration(Class(goldbook:08509))
AnnotationAssertion(rdfs:label goldbook:08509 "nebulization")
AnnotationAssertion(dcterms:description goldbook:08509 "Conversion of a liquid into an aerosol consisting of droplets suspended in a gas stream.")
AnnotationAssertion(mito:isMentionedBy goldbook:08509 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08509 "current"^^xsd:string)
Declaration(Class(goldbook:08510))
AnnotationAssertion(rdfs:label goldbook:08510 "nebulizer")
AnnotationAssertion(dcterms:description goldbook:08510 "Device for producing nebulization.")
AnnotationAssertion(rdfs:seeAlso goldbook:08510 goldbook:08509)
AnnotationAssertion(mito:isMentionedBy goldbook:08510 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08510 "current"^^xsd:string)
Declaration(Class(goldbook:08511))
AnnotationAssertion(rdfs:label goldbook:08511 "non-specific emission or attenuation")
AnnotationAssertion(dcterms:description goldbook:08511 "Electromagnetic radiation, within the bandpass filter used, emitted by, or absorption caused by, atoms, molecules and radicals that are subject to the atomizer by all components, apart from the analyte, that are present there during measurement.")
AnnotationAssertion(rdfs:comment goldbook:08511 "These effects include scattering or absorption effects by solid particles."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08511 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08511 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08511 "current"^^xsd:string)
Declaration(Class(goldbook:08512))
AnnotationAssertion(rdfs:label goldbook:08512 "normal plasma analytical zone")
AnnotationAssertion(dcterms:description goldbook:08512 "Inductively-coupled plasma volume mainly responsible for emission of analytically-useful light because processes leading to excited species, such as droplet desolvation, element vaporization, atomization (or ionization) and excitation have been completed.")
AnnotationAssertion(rdfs:seeAlso goldbook:08512 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08512 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08512 "current"^^xsd:string)
Declaration(Class(goldbook:08513))
AnnotationAssertion(rdfs:label goldbook:08513 "optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08513 "Measurement principle of atomic emission spectroscopy in which the emitted electromagnetic radiation is in the range of frequencies from the infrared, through visible, to the ultra-violet region.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08513 "OES")
AnnotationAssertion(rdfs:comment goldbook:08513 "OES is used as the detector in inductively-coupled plasma optical emission spectroscopy, and glow-discharge optical emission spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08513 goldbook:08452)
AnnotationAssertion(rdfs:seeAlso goldbook:08513 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08513 goldbook:08483)
AnnotationAssertion(rdfs:seeAlso goldbook:08513 goldbook:08491)
AnnotationAssertion(mito:isMentionedBy goldbook:08513 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08513 "current"^^xsd:string)
Declaration(Class(goldbook:08514))
AnnotationAssertion(rdfs:label goldbook:08514 "overall efficiency of atomization")
AnnotationAssertion(dcterms:description goldbook:08514 "In atomic spectroscopy, mass of analyte converted into free atoms in the atomizer divided by mass of analyte entering the dispersion device.")
AnnotationAssertion(rdfs:seeAlso goldbook:08514 goldbook:08216)
AnnotationAssertion(mito:isMentionedBy goldbook:08514 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08514 "current"^^xsd:string)
Declaration(Class(goldbook:08515))
AnnotationAssertion(rdfs:label goldbook:08515 "Penning excitation")
AnnotationAssertion(dcterms:description goldbook:08515 "Collisional excitation and ionization mechanism of inductively-coupled plasma spectrometry involving analyte atoms and metastable argon atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08515 "Penning ionization")
AnnotationAssertion(rdfs:seeAlso goldbook:08515 goldbook:08489)
AnnotationAssertion(mito:isMentionedBy goldbook:08515 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08515 "current"^^xsd:string)
Declaration(Class(goldbook:08516))
AnnotationAssertion(rdfs:label goldbook:08516 "percentage transmission")
AnnotationAssertion(dcterms:description goldbook:08516 "In atomic spectroscopy, flux of mass of sample divided by the flux of mass of solvent blank, measured under the same conditions, expressed as a percentage.")
AnnotationAssertion(rdfs:seeAlso goldbook:08516 goldbook:08216)
AnnotationAssertion(mito:isMentionedBy goldbook:08516 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08516 "current"^^xsd:string)
Declaration(Class(goldbook:08517))
AnnotationAssertion(rdfs:label goldbook:08517 "permanent modifier")
AnnotationAssertion(dcterms:description goldbook:08517 "Substance added together with the sample or standards in electrothermal atomic absorption spectroscopy that is refractory, or forms a refractory species (e.g., a carbide), and thus does not need to be renewed for several atomization cycles.")
AnnotationAssertion(rdfs:comment goldbook:08517 "This is a particular type of chemical modifier for electrothermal AAS."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08517 goldbook:08471)
AnnotationAssertion(mito:isMentionedBy goldbook:08517 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08517 "current"^^xsd:string)
Declaration(Class(goldbook:08518))
AnnotationAssertion(rdfs:label goldbook:08518 "plasma arc")
AnnotationAssertion(dcterms:description goldbook:08518 "Plasma formed by an arc-discharge.")
AnnotationAssertion(rdfs:comment goldbook:08518 "The discharge is blown through a suitable orifice to form a plasma jet. The high-temperature, electric field-free gaseous region is designed as the region of observation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08518 goldbook:08469)
AnnotationAssertion(mito:isMentionedBy goldbook:08518 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08518 "current"^^xsd:string)
Declaration(Class(goldbook:08519))
AnnotationAssertion(rdfs:label goldbook:08519 "plasma excitation temperature")
AnnotationAssertion(dcterms:description goldbook:08519 "Temperature governing the number density of atomic species in their ground state and excited states following a Boltzmann distribution.")
AnnotationAssertion(mito:isMentionedBy goldbook:08519 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08519 "current"^^xsd:string)
Declaration(Class(goldbook:08520))
AnnotationAssertion(rdfs:label goldbook:08520 "plasma gases")
AnnotationAssertion(dcterms:description goldbook:08520 "Gas streams used to maintain and stabilize the inductively-coupled plasma. The external stream is the main constituent of the plasma and confines the plasma avoiding melting of the torch walls; the intermediate gas stream keeps the plasma at a given height above the top of the torch and, the central stream carries the aerosol and promotes its injection in the plasma central channel.")
AnnotationAssertion(rdfs:seeAlso goldbook:08520 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08520 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08520 "current"^^xsd:string)
Declaration(Class(goldbook:08521))
AnnotationAssertion(rdfs:label goldbook:08521 "plasma induction zone")
AnnotationAssertion(dcterms:description goldbook:08521 "Inductively-coupled plasma volume where there is a maximum interaction between the electromagnetic field and the plasma gas (mostly argon). This is the plasma’s hottest area and has a toroidal configuration.")
AnnotationAssertion(rdfs:seeAlso goldbook:08521 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08521 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08521 "current"^^xsd:string)
Declaration(Class(goldbook:08522))
AnnotationAssertion(rdfs:label goldbook:08522 "plasma ionization temperature")
AnnotationAssertion(dcterms:description goldbook:08522 "Temperature associated with the energy level of plasma ions.")
AnnotationAssertion(rdfs:seeAlso goldbook:08522 goldbook:08246)
AnnotationAssertion(mito:isMentionedBy goldbook:08522 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08522 "current"^^xsd:string)
Declaration(Class(goldbook:08523))
AnnotationAssertion(rdfs:label goldbook:08523 "plasma local thermodynamic equilibrium")
AnnotationAssertion(dcterms:description goldbook:08523 "Condition for which the temperatures estimated from different particles (atoms, molecules, ions, electrons) constituting a plasma are locally coincident.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08523 "LTE")
AnnotationAssertion(mito:isMentionedBy goldbook:08523 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08523 "current"^^xsd:string)
Declaration(Class(goldbook:08524))
AnnotationAssertion(rdfs:label goldbook:08524 "plasma shielding")
AnnotationAssertion(dcterms:description goldbook:08524 "Prevention of laser pulse energy from reaching a sample surface as a result of the presence of a laser-induced plasma.")
AnnotationAssertion(rdfs:comment goldbook:08524 "The main process leading to plasma shielding is the absorption of the laser energy by electrons (inverse Bremsstrahlung) and multiphoton ionization (mainly relevant for shorter laser wavelengths)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08524 goldbook:08497)
AnnotationAssertion(rdfs:seeAlso goldbook:08524 goldbook:08502)
AnnotationAssertion(mito:isMentionedBy goldbook:08524 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08524 "current"^^xsd:string)
Declaration(Class(goldbook:08525))
AnnotationAssertion(rdfs:label goldbook:08525 "plasma termination")
AnnotationAssertion(dcterms:description goldbook:08525 "Extinction of the plasma after a laser pulse as a consequence of self-absorption (quenching) and recombination of electrons and ions.")
AnnotationAssertion(rdfs:comment goldbook:08525 "The time elapsed between initiation and extinction of the plasma ranges from tenths of microseconds to a few milliseconds."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08525 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08525 "current"^^xsd:string)
Declaration(Class(goldbook:08526))
AnnotationAssertion(rdfs:label goldbook:08526 "platform atomization")
AnnotationAssertion(dcterms:description goldbook:08526 "Sample support made of graphite that is inserted into the atomizer tube in electrothermal atomic absorption spectroscopy. The sample, a liquid or a solid, is deposited onto this platform, from which it undergoes all the transformations leading to atomization. The use of a platform delays atomization, until a more stabilized temperature in the gas phase is reached.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08526 "L’vov platform")
AnnotationAssertion(rdfs:seeAlso goldbook:08526 goldbook:08471)
AnnotationAssertion(mito:isMentionedBy goldbook:08526 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08526 "current"^^xsd:string)
Declaration(Class(goldbook:08527))
AnnotationAssertion(rdfs:label goldbook:08527 "pneumatic nebulizers")
AnnotationAssertion(dcterms:description goldbook:08527 "Nebulizers for which the aerosol generation principle is based on the exposure of the liquid sample to a high velocity gas stream.")
AnnotationAssertion(rdfs:comment goldbook:08527 "Most common designs include cross flow, concentric, parallel path, entrained and Babington and V Groove."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08527 goldbook:08510)
AnnotationAssertion(mito:isMentionedBy goldbook:08527 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08527 "current"^^xsd:string)
Declaration(Class(goldbook:08528))
AnnotationAssertion(rdfs:label goldbook:08528 "preheating inductively-coupled plasma zone")
AnnotationAssertion(dcterms:description goldbook:08528 "Inductively-coupled plasma volume where tertiary aerosols suffer from complete solvent evaporation, element salt vaporization and dissociation into atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08528 "preheating plasma zone")
AnnotationAssertion(rdfs:seeAlso goldbook:08528 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08528 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08528 "current"^^xsd:string)
Declaration(Class(goldbook:08529))
AnnotationAssertion(rdfs:label goldbook:08529 "primary aerosol")
AnnotationAssertion(dcterms:description goldbook:08529 "Aerosol generated by a nebulizer.")
AnnotationAssertion(rdfs:comment goldbook:08529 "Usually, primary aerosols contain coarse droplets, they are polydisperse in terms of drop diameters and they are turbulent."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08529 goldbook:08510)
AnnotationAssertion(mito:isMentionedBy goldbook:08529 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08529 "current"^^xsd:string)
Declaration(Class(goldbook:08531))
AnnotationAssertion(rdfs:label goldbook:08531 "pulse energy")
AnnotationAssertion(dcterms:description goldbook:08531 "Total optical energy content of a laser pulse. Integral of optical power over pulse duration.")
AnnotationAssertion(rdfs:comment goldbook:08531 "Pulse energies range from microjoules to millijoules for Q-switched lasers, whereas mode-locked lasers achieve much lower pulse energies (picojoules, nanojoules or sometimes several microjoules)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08531 goldbook:08530)
AnnotationAssertion(mito:isMentionedBy goldbook:08531 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08531 "current"^^xsd:string)
Declaration(Class(goldbook:08532))
AnnotationAssertion(rdfs:label goldbook:08532 "pulsed laser")
AnnotationAssertion(dcterms:description goldbook:08532 "Laser system that emits electromagnetic radiation in the form of pulses of a defined and constant duration.")
AnnotationAssertion(rdfs:comment goldbook:08532 "A pulsed laser produces no continuous optical wave."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08532 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08532 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08532 "current"^^xsd:string)
Declaration(Class(goldbook:08533))
AnnotationAssertion(rdfs:label goldbook:08533 "pyrolysis curve")
AnnotationAssertion(dcterms:description goldbook:08533 "Graph of absorbance against pyrolysis temperature in electrothermal atomic absorption spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08533 goldbook:08471)
AnnotationAssertion(mito:isMentionedBy goldbook:08533 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08533 "current"^^xsd:string)
Declaration(Class(goldbook:08534))
AnnotationAssertion(rdfs:label goldbook:08534 "quartz atomizer")
AnnotationAssertion(dcterms:description goldbook:08534 "Atomizer that is used to atomize those elements that form volatile species (e.g., hydrides) at relatively low temperatures (e.g., \\(\\pu{1000^{\\circ}C}\\) or below).")
AnnotationAssertion(rdfs:comment goldbook:08534 "These can be heated externally or positioned in a flame (see flame in flame atomic spectroscopy)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08534 goldbook:08476)
AnnotationAssertion(mito:isMentionedBy goldbook:08534 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08534 "current"^^xsd:string)
Declaration(Class(goldbook:08535))
AnnotationAssertion(rdfs:label goldbook:08535 "radial viewing mode")
AnnotationAssertion(dcterms:description goldbook:08535 "Inductively-coupled plasma optical emission spectrometer configuration in which the plasma and the entrance slit are perpendicular and from which the signal is taken perpendicularly to the main plasma axis.")
AnnotationAssertion(rdfs:comment goldbook:08535 "This configuration yields lower sensitivities than the axial viewing mode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08535 goldbook:08491)
AnnotationAssertion(rdfs:seeAlso goldbook:08535 goldbook:08457)
AnnotationAssertion(mito:isMentionedBy goldbook:08535 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08535 "current"^^xsd:string)
Declaration(Class(goldbook:08536))
AnnotationAssertion(rdfs:label goldbook:08536 "radiofrequency generator")
AnnotationAssertion(dcterms:description goldbook:08536 "Component of an inductively-coupled plasma spectrometer responsible for the generation of alternating current in the radiofrequency portion of the electromagnetic spectrum (see table).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08536 "RF generator")
AnnotationAssertion(rdfs:seeAlso goldbook:08536 goldbook:08489)
AnnotationAssertion(rdfs:seeAlso goldbook:08536 goldbook:08279)
AnnotationAssertion(mito:isMentionedBy goldbook:08536 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08536 "current"^^xsd:string)
Declaration(Class(goldbook:08537))
AnnotationAssertion(rdfs:label goldbook:08537 "radiofrequency glow discharge optical emission spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08537 "Optical emission spectroscopy in which a radiofrequency-powered glow discharge is operated with frequencies in the low megahertz range.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08537 "RF-GD-OES")
AnnotationAssertion(rdfs:comment goldbook:08537 "The use of these frequencies establishes a negative direct current (DC)-bias voltage on the sample surface. The DC-bias is the result of an alternating current waveform that is centered about negative potential; as such it more or less represents the average potential residing on the sample surface. Radio-frequency has ability to appear to flow through insulators (non-conductive materials)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08537 goldbook:08513)
AnnotationAssertion(rdfs:seeAlso goldbook:08537 goldbook:08481)
AnnotationAssertion(mito:isMentionedBy goldbook:08537 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08537 "current"^^xsd:string)
Declaration(Class(goldbook:08538))
AnnotationAssertion(rdfs:label goldbook:08538 "reference flux density")
AnnotationAssertion(dcterms:description goldbook:08538 "Intensity transmitted by the reference medium in a double-beam spectrometer.")
AnnotationAssertion(rdfs:seeAlso goldbook:08538 goldbook:08241)
AnnotationAssertion(mito:isMentionedBy goldbook:08538 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08538 "current"^^xsd:string)
Declaration(Class(goldbook:08539))
AnnotationAssertion(rdfs:label goldbook:08539 "reflected power")
AnnotationAssertion(dcterms:description goldbook:08539 "Incident power that is not absorbed by the plasma.")
AnnotationAssertion(rdfs:seeAlso goldbook:08539 goldbook:08487)
AnnotationAssertion(mito:isMentionedBy goldbook:08539 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08539 "current"^^xsd:string)
Declaration(Class(goldbook:08540))
AnnotationAssertion(rdfs:label goldbook:08540 "repetition rate")
AnnotationAssertion(dcterms:description goldbook:08540 "Number of laser pulses emitted by a pulsed laser system per unit time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08540 "pulse frequency")
AnnotationAssertion(rdfs:comment goldbook:08540 "For laser systems with pulse duration in the nanosecond regime repetition rates range from \\(\\pu{1 Hz}\\) to \\(\\pu{20 Hz}\\), whereas for femtosecond laser systems increased repetition rates up to \\(\\pu{1000 Hz}\\) are possible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08540 "SI unit: \\(\\pu{Hz}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08540 goldbook:08530)
AnnotationAssertion(rdfs:seeAlso goldbook:08540 goldbook:08532)
AnnotationAssertion(mito:isMentionedBy goldbook:08540 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08540 "current"^^xsd:string)
Declaration(Class(goldbook:08541))
AnnotationAssertion(rdfs:label goldbook:08541 "resonant inelastic X-ray scattering")
AnnotationAssertion(dcterms:description goldbook:08541 "Measurement method of inelastic X-ray spectroscopy that uses a hard or soft X-ray beam to excite transitions of core-level electrons into empty energy levels. The subsequent transition of an electron into the core state is accompanied by X-ray emission with characteristic momentum and energy.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08541 "RIXS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08541 "resonant X-ray emission")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08541 "resonant X-ray Raman")
AnnotationAssertion(rdfs:comment goldbook:08541 "The incident photon energy is selected for resonance with an X-ray absorption edge of the system, such that the observed shifts in momentum and energy provide element-specific chemical sensitivity, with the capacity to distinguish the same element located at inequivalent sites."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08541 goldbook:08246)
AnnotationAssertion(mito:isMentionedBy goldbook:08541 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08541 "current"^^xsd:string)
Declaration(Class(goldbook:08542))
AnnotationAssertion(rdfs:label goldbook:08542 "Saha’s ionization equation")
AnnotationAssertion(dcterms:description goldbook:08542 "Equation that relates the ionization state of an element present in a gas in thermal equilibrium to the temperature and the pressure of the medium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08542 "Saha–Langmuir equation")
AnnotationAssertion(rdfs:comment goldbook:08542 "For a gas composed of a single atomic species, the Saha equation is written: \\[(n_{i+1}/n_{i}) n_{\\rm{e}} = 2\\lambda^{-3}(g_{i+1}/g_{i}) \\exp[-(\\epsilon_{i + 1} - \\epsilon_{i})/kT]\\] where \\(n_{i}\\) is the number density of atoms with \\(i\\) electrons removed, \\(g_{i}\\) is the degeneracy of the \\(i^{\\rm{th}}\\) state, \\(\\epsilon_{i}\\) is the ionization energy of the \\(i^{\\rm{th}}\\) state, \\(n_{\\rm{e}}\\) is the number density of electrons, \\(\\lambda\\) is the thermal de Broglie wavelength of an electron, \\(k\\) is the Boltzmann constant, and \\(T\\) is the thermodynamic temperature of the gas."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08542 "The thermal de Broglie wavelength is given by: \\[\\lambda = \\sqrt{\\frac{h^{2}}{2\\uppi m_{\\rm{e}} kT}}\\] where \\(h\\) is the Planck constant, \\(k\\) the Boltzmann constant, \\(T\\) temperature, and \\(m_{\\rm{e}}\\) the mass of an electron."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08542 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08542 "current"^^xsd:string)
Declaration(Class(goldbook:08543))
AnnotationAssertion(rdfs:label goldbook:08543 "sample flux density")
AnnotationAssertion(dcterms:description goldbook:08543 "Intensity transmitted by the atomizer when the latter is supplied with the sample solution or a reference solution.")
AnnotationAssertion(rdfs:seeAlso goldbook:08543 goldbook:08538)
AnnotationAssertion(mito:isMentionedBy goldbook:08543 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08543 "current"^^xsd:string)
Declaration(Class(goldbook:08544))
AnnotationAssertion(rdfs:label goldbook:08544 "saturator")
AnnotationAssertion(dcterms:description goldbook:08544 "Buffer containing interfering element(s) in sufficient quantity to reach the limit of enhancement or dispersion (i.e., saturation) of the interference curve.")
AnnotationAssertion(mito:isMentionedBy goldbook:08544 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08544 "current"^^xsd:string)
Declaration(Class(goldbook:08545))
AnnotationAssertion(rdfs:label goldbook:08545 "sequential detection")
AnnotationAssertion(dcterms:description goldbook:08545 "Sequential spectrometers use a dispersive element (grating) in combination with entrance and exit slits for selection of specific wavelengths. Geometric arrangements include the Czerny-Turner and the Ebert-geometry, both offering high resolution measurements. However, they do not permit simultaneous recording of different spectral lines, even for single emission line intensity, and adjacent spectral background has also to be measured sequentially.")
AnnotationAssertion(rdfs:seeAlso goldbook:08545 goldbook:08549)
AnnotationAssertion(rdfs:seeAlso goldbook:08545 goldbook:08550)
AnnotationAssertion(mito:isMentionedBy goldbook:08545 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08545 "current"^^xsd:string)
Declaration(Class(goldbook:08546))
AnnotationAssertion(rdfs:label goldbook:08546 "solvent blank flux density")
AnnotationAssertion(dcterms:description goldbook:08546 "Intensity transmitted by the atomizer when the latter is supplied with the solvent blank.")
AnnotationAssertion(mito:isMentionedBy goldbook:08546 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08546 "current"^^xsd:string)
Declaration(Class(goldbook:08547))
AnnotationAssertion(rdfs:label goldbook:08547 "solvent nucleation")
AnnotationAssertion(dcterms:description goldbook:08547 "Solvent condensation on solid particles or droplets contained in an aerosol.")
AnnotationAssertion(mito:isMentionedBy goldbook:08547 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08547 "current"^^xsd:string)
Declaration(Class(goldbook:08548))
AnnotationAssertion(rdfs:label goldbook:08548 "solvent transport rate")
AnnotationAssertion(dcterms:description goldbook:08548 "Mass of solvent, both in liquid and vapour forms, reaching an inductively-coupled plasma per unit of time.")
AnnotationAssertion(rdfs:seeAlso goldbook:08548 goldbook:08488)
AnnotationAssertion(mito:isMentionedBy goldbook:08548 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08548 "current"^^xsd:string)
Declaration(Class(goldbook:08549))
AnnotationAssertion(rdfs:label goldbook:08549 "spectral background")
AnnotationAssertion(dcterms:description goldbook:08549 "Electromagnetic radiation, within the bandpass used, emitted by, and/or in the case of atomic absorption spectroscopy, absorbed in, the atomizer when nothing is supplied to the atomizer but the gases involved in its operation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08549 "flame background")
AnnotationAssertion(rdfs:comment goldbook:08549 "In the case of flame atomic spectroscopy, the term \"flame background\" is used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08549 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08549 goldbook:08451)
AnnotationAssertion(rdfs:seeAlso goldbook:08549 goldbook:08475)
AnnotationAssertion(mito:isMentionedBy goldbook:08549 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08549 "current"^^xsd:string)
Declaration(Class(goldbook:08550))
AnnotationAssertion(rdfs:label goldbook:08550 "spectral line")
AnnotationAssertion(dcterms:description goldbook:08550 "In atomic spectroscopy, a very narrow band of frequencies of electromagnetic radiation emitted or absorbed by atoms, which undergo a single electronic transition.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08550 "line")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08550 "spectral line")
AnnotationAssertion(rdfs:comment goldbook:08550 "The radiation is centred on a peak whose wavelength characterizes the line and which corresponds to the emission or absorption maximum."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08550 "A distinction is made between lines corresponding to transition of neutral atoms (e.g., \\(\\ce{Ba I}\\ \\pu{553.548 nm}\\) and \\(\\pu{577.762 nm}\\)) and ions (e.g., \\(\\ce{Ba II}\\ \\pu{455.403 nm}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08550 goldbook:08216)
AnnotationAssertion(rdfs:seeAlso goldbook:08550 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08550 goldbook:08245)
AnnotationAssertion(rdfs:seeAlso goldbook:08550 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08550 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08550 "current"^^xsd:string)
Declaration(Class(goldbook:08551))
AnnotationAssertion(rdfs:label goldbook:08551 "spray chamber")
AnnotationAssertion(dcterms:description goldbook:08551 "Chamber of a nebulizer in which the sprayed liquid is converted to mist. Some of the droplets of this mist may evaporate, coalesce, or deposit in the chamber and subsequently drain away as waste.")
AnnotationAssertion(rdfs:seeAlso goldbook:08551 goldbook:08510)
AnnotationAssertion(mito:isMentionedBy goldbook:08551 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08551 "current"^^xsd:string)
Declaration(Class(goldbook:08552))
AnnotationAssertion(rdfs:label goldbook:08552 "sputter rate")
AnnotationAssertion(dcterms:description goldbook:08552 "Mass of material removed from a sample surface in unit time.")
AnnotationAssertion(rdfs:comment goldbook:08552 "Si unit \\(\\pu{kg s-1}\\). Common unit \\(\\pu{\\upmu g s-1}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08552 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08552 "current"^^xsd:string)
Declaration(Class(goldbook:08553))
AnnotationAssertion(rdfs:label goldbook:08553 "stop-flow conditions")
AnnotationAssertion(dcterms:description goldbook:08553 "Stoppage to the otherwise constant flow of argon gas to the atomizer in electrothermal atomic absorption spectroscopy, that can be programmed to occur during atomization, for the purpose of increasing the residence time of the analyte atoms and thus the associated signal.")
AnnotationAssertion(rdfs:seeAlso goldbook:08553 goldbook:08471)
AnnotationAssertion(mito:isMentionedBy goldbook:08553 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08553 "current"^^xsd:string)
Declaration(Class(goldbook:08554))
AnnotationAssertion(rdfs:label goldbook:08554 "synchrotron X-ray spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08554 "X-ray spectroscopy performed using a high intensity, continuous polychromatic synchrotron X-ray source.")
AnnotationAssertion(mito:isMentionedBy goldbook:08554 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08554 "current"^^xsd:string)
Declaration(Class(goldbook:08555))
AnnotationAssertion(rdfs:label goldbook:08555 "tertiary aerosol")
AnnotationAssertion(dcterms:description goldbook:08555 "Aerosol that reaches an inductively-coupled plasma.")
AnnotationAssertion(rdfs:comment goldbook:08555 "Such aerosols are finer, less polydispersed and less turbulent than primary aerosols."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08555 goldbook:08488)
AnnotationAssertion(rdfs:seeAlso goldbook:08555 goldbook:08529)
AnnotationAssertion(mito:isMentionedBy goldbook:08555 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08555 "current"^^xsd:string)
Declaration(Class(goldbook:08556))
AnnotationAssertion(rdfs:label goldbook:08556 "thermal dispersion")
AnnotationAssertion(dcterms:description goldbook:08556 "Procedures whereby an aerosol is produced at a high temperature, for example by sparks, arcs, furnaces, lasers, cathodic sputtering or electron-beam.")
AnnotationAssertion(mito:isMentionedBy goldbook:08556 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08556 "current"^^xsd:string)
Declaration(Class(goldbook:08557))
AnnotationAssertion(rdfs:label goldbook:08557 "thermal volatilization")
AnnotationAssertion(dcterms:description goldbook:08557 "Process in glow-discharge atomic emission spectroscopy in which sample volatilization occurs by heating due to sample bombardment with argon ions.")
AnnotationAssertion(rdfs:comment goldbook:08557 "The process causes evaporation of the sample constituents in accordance to their boiling-points."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08557 "Although this technique offers highest detection power for most volatile elements its use in routine applications is still limited by the analytical challenges posed by the transient nature of the analyte signal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08557 goldbook:08483)
AnnotationAssertion(mito:isMentionedBy goldbook:08557 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08557 "current"^^xsd:string)
Declaration(Class(goldbook:08558))
AnnotationAssertion(rdfs:label goldbook:08558 "time-resolved laser-induced breakdown spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08558 "Measurement method of laser-induced breakdown spectroscopy in which the emitted radiation is monitored with time resolution sufficiently high to resolve different stages in the lifetime of the laser-induced plasma.")
AnnotationAssertion(rdfs:seeAlso goldbook:08558 goldbook:08500)
AnnotationAssertion(rdfs:seeAlso goldbook:08558 goldbook:08502)
AnnotationAssertion(mito:isMentionedBy goldbook:08558 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08558 "current"^^xsd:string)
Declaration(Class(goldbook:08559))
AnnotationAssertion(rdfs:label goldbook:08559 "total sample consumption system")
AnnotationAssertion(dcterms:description goldbook:08559 "Liquid-sample introduction system able to achieve \\(\\pu{100\\%}\\) transport efficiency.")
AnnotationAssertion(mito:isMentionedBy goldbook:08559 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08559 "current"^^xsd:string)
Declaration(Class(goldbook:08560))
AnnotationAssertion(rdfs:label goldbook:08560 "transport efficiency")
AnnotationAssertion(dcterms:description goldbook:08560 "Mass of analyte entering the atomizer of a flame atomic spectrometer or the plasma of an inductively-coupled plasma spectrometer divided by the mass of analyte entering the dispersion device.")
AnnotationAssertion(rdfs:seeAlso goldbook:08560 goldbook:08474)
AnnotationAssertion(mito:isMentionedBy goldbook:08560 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08560 "current"^^xsd:string)
Declaration(Class(goldbook:08561))
AnnotationAssertion(rdfs:label goldbook:08561 "ultrasonic nebulizers")
AnnotationAssertion(dcterms:description goldbook:08561 "Nebulizers whose aerosol generation principle is based on the transfer of the energy from a vibrating transducer to the liquid sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:08561 goldbook:08510)
AnnotationAssertion(mito:isMentionedBy goldbook:08561 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08561 "current"^^xsd:string)
Declaration(Class(goldbook:08562))
AnnotationAssertion(rdfs:label goldbook:08562 "wall atomization")
AnnotationAssertion(dcterms:description goldbook:08562 "Electrothermal atomic absorption spectroscopy in which the sample is deposited directly onto the wall of the electrothermal atomizer tube, from which it undergoes all the transformations leading to atomization.")
AnnotationAssertion(rdfs:seeAlso goldbook:08562 goldbook:08471)
AnnotationAssertion(mito:isMentionedBy goldbook:08562 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08562 "current"^^xsd:string)
Declaration(Class(goldbook:08563))
AnnotationAssertion(rdfs:label goldbook:08563 "wash out time")
AnnotationAssertion(dcterms:description goldbook:08563 "Time required for the output signal of an inductively-coupled plasma spectrometer for a given analyte to fall back to baseline levels from the end of sampling time and/or after introducing a blank solution.")
AnnotationAssertion(rdfs:seeAlso goldbook:08563 goldbook:08489)
AnnotationAssertion(mito:isMentionedBy goldbook:08563 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08563 "current"^^xsd:string)
Declaration(Class(goldbook:08564))
AnnotationAssertion(rdfs:label goldbook:08564 "X-ray emission spectrum")
AnnotationAssertion(dcterms:description goldbook:08564 "Spectrum comprising the continuum Bremsstrahlung and the most energetic characteristic spectral lines defined by differences in binding energy between electron energy levels.")
AnnotationAssertion(rdfs:seeAlso goldbook:08564 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08564 goldbook:08246)
AnnotationAssertion(rdfs:seeAlso goldbook:08564 goldbook:08550)
AnnotationAssertion(mito:isMentionedBy goldbook:08564 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08564 "current"^^xsd:string)
Declaration(Class(goldbook:08565))
AnnotationAssertion(rdfs:label goldbook:08565 "amorphous material transmitting infrared radiation")
AnnotationAssertion(dcterms:description goldbook:08565 "Amorphous glasses made from elements of groups 4, 5 and 6 of the Periodic Table that transmit infrared radiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08565 "AMTIR")
AnnotationAssertion(rdfs:comment goldbook:08565 "AMTIRs are hard but can be brittle."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08565 goldbook:08617)
AnnotationAssertion(mito:isMentionedBy goldbook:08565 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08565 "current"^^xsd:string)
Declaration(Class(goldbook:08566))
AnnotationAssertion(rdfs:label goldbook:08566 "amplitude modulation")
AnnotationAssertion(dcterms:description goldbook:08566 "Modulation of the amplitude of a beam of electromagnetic radiation; by the movement of a moving mirror in a rapid scan Fourier-transform spectrometer or by a mechanical chopper in other spectrometers.")
AnnotationAssertion(rdfs:seeAlso goldbook:08566 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08566 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08566 "current"^^xsd:string)
Declaration(Class(goldbook:08567))
AnnotationAssertion(rdfs:label goldbook:08567 "anisotropic Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08567 "Raman scattering by the anisotropic part of the derived polarizability tensor.")
AnnotationAssertion(rdfs:seeAlso goldbook:08567 goldbook:08667)
AnnotationAssertion(mito:isMentionedBy goldbook:08567 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08567 "current"^^xsd:string)
Declaration(Class(goldbook:08568))
AnnotationAssertion(rdfs:label goldbook:08568 "anomalous dispersion")
AnnotationAssertion(dcterms:description goldbook:08568 "Changes in real refractive index of a material in the vicinity of an absorption band in which real refractive index decreases markedly with decreasing wavenumber on the high wavenumber side of an absorption band, then increases rapidly through the band centre and decreases markedly on the low wavenumber side of the band, before resuming normal dispersion at wavenumbers far from the band.")
AnnotationAssertion(rdfs:seeAlso goldbook:08568 goldbook:08646)
AnnotationAssertion(rdfs:seeAlso goldbook:08568 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08568 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08568 "current"^^xsd:string)
Declaration(Class(goldbook:08569))
AnnotationAssertion(rdfs:label goldbook:08569 "anomalously polarized Raman band")
AnnotationAssertion(dcterms:description goldbook:08569 "Raman band with a depolarization ratio greater than \\(\\pu{0.75}\\), as is frequently observed in surface-enhanced resonance Raman spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08569 goldbook:08665)
AnnotationAssertion(rdfs:seeAlso goldbook:08569 goldbook:08586)
AnnotationAssertion(rdfs:seeAlso goldbook:08569 goldbook:08690)
AnnotationAssertion(mito:isMentionedBy goldbook:08569 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08569 "current"^^xsd:string)
Declaration(Class(goldbook:08570))
AnnotationAssertion(rdfs:label goldbook:08570 "anti-Stokes Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08570 "Raman scattering of electromagnetic radiation in which the scattered radiation has greater energy (greater wavenumber) than the exciting radiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:08570 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08570 goldbook:08683)
AnnotationAssertion(rdfs:seeAlso goldbook:08570 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08570 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08570 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08570 "current"^^xsd:string)
Declaration(Class(goldbook:08571))
AnnotationAssertion(rdfs:label goldbook:08571 "asymmetric top")
AnnotationAssertion(dcterms:description goldbook:08571 "Rotor whose three principal moments of inertia are all different.")
AnnotationAssertion(rdfs:seeAlso goldbook:08571 goldbook:08693)
AnnotationAssertion(mito:isMentionedBy goldbook:08571 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08571 "current"^^xsd:string)
Declaration(Class(goldbook:08572))
AnnotationAssertion(rdfs:label goldbook:08572 "atomic polar tensor")
AnnotationAssertion(dcterms:description goldbook:08572 "3 × 3 tensor that gives the change in the components of the molecular dipole moment when the atom is displaced in three-dimensional space.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08572 "APT")
AnnotationAssertion(rdfs:comment goldbook:08572 "The rows correspond to different components of the dipole moment and the columns to \\(x\\), \\(y\\ (\\rm{g})\\) and \\(z\\) displacements."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08572 "APTs have been widely used in the analysis of infrared absorption intensities."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08572 "SI unit: \\(\\pu{C}\\). Common unit: \\(\\pu{D Å-1 \\approx 3.33564E-30 C}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08572 goldbook:08618)
AnnotationAssertion(mito:isMentionedBy goldbook:08572 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08572 "current"^^xsd:string)
Declaration(Class(goldbook:08573))
AnnotationAssertion(rdfs:label goldbook:08573 "attenuated total reflection spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08573 "Measurement method of vibrational spectroscopy based on internal reflection from an absorbing material at angles of incidence at or above the critical angle (attenuated total reflection).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08573 "frustrated total internal reflection spectroscopy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08573 "internal reflection spectroscopy (IRS)")
AnnotationAssertion(rdfs:comment goldbook:08573 "Attenuated total reflection occurs where the material absorbs. The resulting spectrum resembles an absorption spectrum of the sample."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08573 goldbook:08227)
AnnotationAssertion(rdfs:seeAlso goldbook:08573 goldbook:08623)
AnnotationAssertion(rdfs:seeAlso goldbook:08573 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08573 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08573 "current"^^xsd:string)
Declaration(Class(goldbook:08574))
AnnotationAssertion(rdfs:label goldbook:08574 "band shape")
AnnotationAssertion(dcterms:description goldbook:08574 "Description of the profile of a spectral band.")
AnnotationAssertion(rdfs:comment goldbook:08574 "For a given band, the band shape is independent of the band height in Raman spectra, infrared absorption spectra and pATR spectra. The band shape changes if the band height changes in infrared transmission spectra or attenuated total reflection spectra."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08574 goldbook:08670)
AnnotationAssertion(rdfs:seeAlso goldbook:08574 goldbook:08227)
AnnotationAssertion(rdfs:seeAlso goldbook:08574 goldbook:08657)
AnnotationAssertion(rdfs:seeAlso goldbook:08574 goldbook:08285)
AnnotationAssertion(mito:isMentionedBy goldbook:08574 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08574 "current"^^xsd:string)
Declaration(Class(goldbook:08575))
AnnotationAssertion(rdfs:label goldbook:08575 "Bragg filter")
AnnotationAssertion(dcterms:description goldbook:08575 "Optical filter used, for example, to attenuate Rayleigh scattering while transmitting light subject to Raman shift.")
AnnotationAssertion(rdfs:comment goldbook:08575 "Historically, a Bragg filter was a colloidal dispersion of spheres in a regular close packed array, which selectively diffracts/reflects wavelengths that satisfy the Bragg diffraction criterion for the lattice but transmits all other wavelengths. Now largely superseded by Volume Bragg Gratings, where photo-induced modulation of the refractive index of the filter medium is used to form a volume phase hologram with reflecting planes separated by a well-defined spacing. In each case, angle tuning is used to match the laser wavelength to the Bragg diffraction condition. The filter can be manufactured either as a notch filter, which transmits wavelengths either side of the laser line, or as an edge filter, which only transmits wavelengths longer than the laser line (i.e., Raman light subject to Stokes scattering)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08575 goldbook:08668)
AnnotationAssertion(rdfs:seeAlso goldbook:08575 goldbook:08683)
AnnotationAssertion(rdfs:seeAlso goldbook:08575 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08575 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08575 "current"^^xsd:string)
Declaration(Class(goldbook:08576))
AnnotationAssertion(rdfs:label goldbook:08576 "centre burst")
AnnotationAssertion(dcterms:description goldbook:08576 "Spectral region of an interferogram around zero-path-difference where intensity is greatest.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08576 "center burst")
AnnotationAssertion(rdfs:seeAlso goldbook:08576 goldbook:08622)
AnnotationAssertion(mito:isMentionedBy goldbook:08576 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08576 "current"^^xsd:string)
Declaration(Class(goldbook:08577))
AnnotationAssertion(rdfs:label goldbook:08577 "Christiansen effect")
AnnotationAssertion(dcterms:description goldbook:08577 "Collections of solid particles that are transparent to electromagnetic radiation of a particular wavelength and are slightly larger than the wavelength of the radiation transmit poorly due to reflection and scattering from the interfaces. The transmission increases markedly at wavenumbers at which the refractive index of the particles is close to that of the surrounding medium.")
AnnotationAssertion(rdfs:comment goldbook:08577 "The Christiansen effect frequently causes strong absorption bands from coarsely ground particles to be distorted due to the change in refractive index associated with the anomalous dispersion of the refractive index through the absorption region."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08577 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08577 goldbook:08281)
AnnotationAssertion(rdfs:seeAlso goldbook:08577 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08577 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08577 "current"^^xsd:string)
Declaration(Class(goldbook:08578))
AnnotationAssertion(rdfs:label goldbook:08578 "Christiansen filter")
AnnotationAssertion(dcterms:description goldbook:08578 "Optical filter based on the Christiansen effect.")
AnnotationAssertion(rdfs:comment goldbook:08578 "Such filters have been made from quartz particles in air, immersed in \\(\\ce{CCl4}\\), or immersed in mixtures of \\(\\ce{CCl4}\\) and \\(\\ce{CS2}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08578 goldbook:08577)
AnnotationAssertion(mito:isMentionedBy goldbook:08578 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08578 "current"^^xsd:string)
Declaration(Class(goldbook:08579))
AnnotationAssertion(rdfs:label goldbook:08579 "coherent anti-Stokes Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08579 "Measurement method of Raman spectroscopy that uses third-order susceptibility and is one of several four-wave mixing spectroscopies. The excitation is through lasers of wavenumber \\(\\tilde{ u}_{1}\\) and \\(\\tilde{ u}_{2}\\), which coincide spatially and temporally in the sample and produce an output laser of wavenumber \\(\\tilde{ u}_{3} = 2\\tilde{ u}_{1} - \\tilde{ u}_{2}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08579 "CARS")
AnnotationAssertion(rdfs:comment goldbook:08579 "Experimentally, \\(\\tilde{\\nu}_{1}\\) is kept constant and \\(\\tilde{\\nu}_{2}\\) is scanned. A laser beam output is observed at the wavenumber for anti-Stokes Raman scattering \\(\\tilde{\\nu}_{1} + \\tilde{\\nu}_{\\rm{M}}\\) when \\(\\tilde{\\nu}_{1} - \\tilde{\\nu}_{2} = \\tilde{\\nu}_{\\rm{M}}\\), where \\(\\tilde{\\nu}_{\\rm{M}}\\) is the wavenumber of an active vibration in the sample."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08579 "The Raman scattered radiation emerges as a laser beam instead of being scattered into three dimensions, thus greatly enhancing the sensitivity over that in normal Raman scattering."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08579 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08579 goldbook:08570)
AnnotationAssertion(rdfs:seeAlso goldbook:08579 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08579 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08579 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08579 "current"^^xsd:string)
Declaration(Class(goldbook:08580))
AnnotationAssertion(rdfs:label goldbook:08580 "combination transition")
AnnotationAssertion(dcterms:description goldbook:08580 "Transition in which more than one vibration changes its degree of excitation; i.e., in which more than one vibrational quantum number changes.")
AnnotationAssertion(rdfs:comment goldbook:08580 "Combination band results from a combination transition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08580 "Combination transitions are either sum or difference transitions, although some authors restrict them to sum transitions."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08580 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08580 "current"^^xsd:string)
Declaration(Class(goldbook:08581))
AnnotationAssertion(rdfs:label goldbook:08581 "continuous scan interferometer")
AnnotationAssertion(dcterms:description goldbook:08581 "Interferometer in which the optical path difference is continually changed.")
AnnotationAssertion(rdfs:comment goldbook:08581 "Continuous scan interferometer is typically used for Fourier-transform infrared spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08581 "In slow scan interferometers, the rate of change of optical path difference is less than \\(\\pu{0.05 cm s-1}\\) and a mechanical chopper or some other ancillary modulation is frequently used to provide an adequate modulation frequency."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08581 "In rapid-scan interferometers, the rate of change of optical path difference is above \\(\\pu{0.05 cm s-1}\\), high enough that no additional modulation is needed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08581 goldbook:08605)
AnnotationAssertion(rdfs:seeAlso goldbook:08581 goldbook:08653)
AnnotationAssertion(rdfs:seeAlso goldbook:08581 goldbook:08681)
AnnotationAssertion(mito:isMentionedBy goldbook:08581 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08581 "current"^^xsd:string)
Declaration(Class(goldbook:08582))
AnnotationAssertion(rdfs:label goldbook:08582 "Coriolis coupling")
AnnotationAssertion(dcterms:description goldbook:08582 "Coupling between rotational and vibrational molecular motion caused by Coriolis forces.")
AnnotationAssertion(rdfs:seeAlso goldbook:08582 goldbook:08583)
AnnotationAssertion(mito:isMentionedBy goldbook:08582 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08582 "current"^^xsd:string)
Declaration(Class(goldbook:08583))
AnnotationAssertion(rdfs:label goldbook:08583 "Coriolis force")
AnnotationAssertion(dcterms:description goldbook:08583 "In vibrational theory, the motion of a polyatomic molecule is usually initially regarded as the independent superposition of a rotation and a vibration, with the vibration considered in a coordinate system that rotates with the molecule. This initial treatment must be corrected for centrifugal forces and for Coriolis forces. The Coriolis force on an atom is given by \\(F_{\\rm{Coriolis}} = 2m v_{\\rm{a}} \\omega \\sin \\varphi\\), where \\(m\\) is the mass of the atom, \\(v_{\\rm{a}}\\) is its apparent velocity in the rotating coordinate system, \\(\\omega\\) is the angular velocity of the coordinate system, and \\(\\varphi\\) is the angle between the velocity vector and the axis of rotation.")
AnnotationAssertion(rdfs:comment goldbook:08583 "SI unit: \\(\\ce{N}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08583 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08583 "current"^^xsd:string)
Declaration(Class(goldbook:08584))
AnnotationAssertion(rdfs:label goldbook:08584 "critical angle")
AnnotationAssertion(dcterms:description goldbook:08584 "Smallest angle of incidence at which total internal reflection occurs.")
AnnotationAssertion(rdfs:comment goldbook:08584 "If \\(n_{2}\\) and \\(n_{1}\\) are the refractive indices, and \\(n_{2} > n_{1}\\), at the boundary, \\(\\sin \\theta_{\\rm{c}} = n_1/n_2\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08584 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08584 "current"^^xsd:string)
Declaration(Class(goldbook:08585))
AnnotationAssertion(rdfs:label goldbook:08585 "deformation vibration")
AnnotationAssertion(dcterms:description goldbook:08585 "Vibration in which the dominant change from equilibrium is in one or more valence angles.")
AnnotationAssertion(mito:isMentionedBy goldbook:08585 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08585 "current"^^xsd:string)
Declaration(Class(goldbook:08586))
AnnotationAssertion(rdfs:label goldbook:08586 "depolarization ratio")
AnnotationAssertion(dcterms:description goldbook:08586 "Raman intensity with the electric vector of the scattered electromagnetic radiation perpendicular to that of the incident radiation divided by the Raman intensity with electric vectors parallel.")
AnnotationAssertion(rdfs:comment goldbook:08586 "In normal Raman scattering with linearly polarized exciting radiation, \\(\\rho \\le 0.75\\) for totally symmetric vibrations and \\(\\rho = 0.75\\) for all other vibrations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08586 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08586 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08586 goldbook:08667)
AnnotationAssertion(mito:isMentionedBy goldbook:08586 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08586 "current"^^xsd:string)
Declaration(Class(goldbook:08587))
AnnotationAssertion(rdfs:label goldbook:08587 "depolarized Raman band")
AnnotationAssertion(dcterms:description goldbook:08587 "Raman band with depolarization ratio \\(\\rho = 0.75\\) for linear polarized incident radiation in normal Raman spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08587 goldbook:08665)
AnnotationAssertion(rdfs:seeAlso goldbook:08587 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08587 goldbook:08586)
AnnotationAssertion(rdfs:seeAlso goldbook:08587 goldbook:08660)
AnnotationAssertion(mito:isMentionedBy goldbook:08587 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08587 "current"^^xsd:string)
Declaration(Class(goldbook:08588))
AnnotationAssertion(rdfs:label goldbook:08588 "difference transition")
AnnotationAssertion(dcterms:description goldbook:08588 "Combination transition that does not start at the ground state and in which at least one vibration decreases and at least one vibration increases its degree of excitation; i.e., a transition in which more than one vibrational quantum number changes and at least one becomes smaller.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08588 "difference band")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08588 "difference tone")
AnnotationAssertion(rdfs:comment goldbook:08588 "A difference band or difference tone results from a difference transition."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08588 goldbook:08580)
AnnotationAssertion(mito:isMentionedBy goldbook:08588 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08588 "current"^^xsd:string)
Declaration(Class(goldbook:08589))
AnnotationAssertion(rdfs:label goldbook:08589 "divided spinning cell")
AnnotationAssertion(dcterms:description goldbook:08589 "Measuring instrument for Raman spectroscopy incorporating a dish-shaped cell that is divided by a vertical partition through its middle to allow different liquids in its two halves. It is rotated about a vertical axis through its centre and the Raman scattered radiation from each half is measured alternately. With a standard liquid in one half and a sample in the other it is used to determine Raman scattering intensities relative to the standard.")
AnnotationAssertion(rdfs:seeAlso goldbook:08589 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08589 goldbook:08669)
AnnotationAssertion(mito:isMentionedBy goldbook:08589 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08589 "current"^^xsd:string)
Declaration(Class(goldbook:08590))
AnnotationAssertion(rdfs:label goldbook:08590 "dynamic spectrum")
AnnotationAssertion(dcterms:description goldbook:08590 "Spectrum of a material under the influence of an applied external perturbation represented by a variable \\(\\tau\\), relative to a reference spectrum.")
AnnotationAssertion(rdfs:comment goldbook:08590 "The reference spectrum may be chosen in many ways; e.g., it may be the average over \\(\\tau\\), of the observed spectrum, or it may be zero."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08590 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08590 goldbook:08295)
AnnotationAssertion(rdfs:seeAlso goldbook:08590 goldbook:08296)
AnnotationAssertion(mito:isMentionedBy goldbook:08590 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08590 "current"^^xsd:string)
Declaration(Class(goldbook:08591))
AnnotationAssertion(rdfs:label goldbook:08591 "electrical anharmonicity")
AnnotationAssertion(dcterms:description goldbook:08591 "Influence of terms that are of \\(2^{\\rm{nd}}\\) and higher order in the normal coordinate \\(Q\\) in the expansion of the electric dipole moment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08591 "anharmonicity")
AnnotationAssertion(rdfs:comment goldbook:08591 "Electrical anharmonicity should not be confused with mechanical anharmonicity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08591 goldbook:08592)
AnnotationAssertion(rdfs:seeAlso goldbook:08591 goldbook:08635)
AnnotationAssertion(rdfs:seeAlso goldbook:08591 goldbook:08644)
AnnotationAssertion(mito:isMentionedBy goldbook:08591 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08591 "current"^^xsd:string)
Declaration(Class(goldbook:08592))
AnnotationAssertion(rdfs:label goldbook:08592 "electrical harmonicity")
AnnotationAssertion(dcterms:description goldbook:08592 "Influence of the linear term, \\(\\Sigma_{k} (\\partial \\boldsymbol{\\mu}/\\partial Q_{k}) Q_{k}\\), in the expansion of the electric dipole moment. \\(Q\\) is the normal coordinate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08592 "harmonicity")
AnnotationAssertion(rdfs:comment goldbook:08592 "Electrical harmonicity should not be confused with mechanical harmonicity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08592 goldbook:08636)
AnnotationAssertion(rdfs:seeAlso goldbook:08592 goldbook:08644)
AnnotationAssertion(mito:isMentionedBy goldbook:08592 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08592 "current"^^xsd:string)
Declaration(Class(goldbook:08593))
AnnotationAssertion(rdfs:label goldbook:08593 "electron energy loss spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08593 "Measurement method of vibrational spectroscopy in which a constant-energy beam of electrons passes through or is reflected from a sample and the energy distribution in the transmitted or reflected beam is analysed to give a spectrum of number of electrons against electron energy loss.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08593 "EELS")
AnnotationAssertion(rdfs:comment goldbook:08593 "EELS is used for the study of electronic states and has an energy resolution of \\(\\pu{0.25 eV}\\) or better (corresponding to an approximate wavenumber of \\(\\pu{2000 cm-1}\\))."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08593 goldbook:08291)
AnnotationAssertion(rdfs:seeAlso goldbook:08593 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08593 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08593 "current"^^xsd:string)
Declaration(Class(goldbook:08594))
AnnotationAssertion(rdfs:label goldbook:08594 "electro-optic parameter")
AnnotationAssertion(dcterms:description goldbook:08594 "Characteristic quantity used in the analysis of absolute infrared intensity data chosen on the assumption that the electric dipole moment of the molecule can be described as the vector sum of bond dipole moments.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08594 "EOP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08594 "equilibrium charge, charge flux (ECCF)")
AnnotationAssertion(rdfs:comment goldbook:08594 "The original EOPs were \\(\\mu_{k}^{\\circ}\\), the equilibrium bond moment, and \\(\\partial \\mu_{k}/\\partial R_{t}\\), the change in the electric dipole moment of bond \\(k\\) with change in internal displacement coordinate \\(t\\). A later and completely equivalent formulation uses equilibrium atomic charges, \\(q_{\\alpha}^{\\rm{o}}\\), and charge fluxes, \\(\\partial q_{\\alpha}/\\partial R_{t}\\), which are also called EOPs as well as ECCF for equilibrium charge, charge flux."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08594 "In Note 1, \\(R\\), are vibrational coordinates such as bond stretching, angle deformation, or torsion about a bond."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08594 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08594 "current"^^xsd:string)
Declaration(Class(goldbook:08595))
AnnotationAssertion(rdfs:label goldbook:08595 "ellipticity")
AnnotationAssertion(dcterms:description goldbook:08595 "Degree to which linearly polarized incident electromagnetic radiation becomes elliptically polarized in an absorbing optically active medium. \\[\\tan\\;\\psi = (E_{\\rm{R}} - E_{\\rm{L}})/(E_{\\rm{R}} + E_{\\rm{L}}) = \\tanh (k^{\\rm{L}} - k^{\\rm{R}})\\pi l/\\lambda\\] where \\(E_{\\rm{R}}\\) and \\(E_{\\rm{L}}\\) are the electric vectors of right and left circularly polarized radiation, \\(k^{\\rm{L}}\\) and \\(k^{\\rm{R}}\\) are the absorption indices of the sample for left and right circularly polarized radiation, \\(\\lambda\\) is the wavelength of the radiation and \\(l\\) is the path-length through the medium.")
AnnotationAssertion(rdfs:comment goldbook:08595 "SI unit: rad = 1."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08595 goldbook:08220)
AnnotationAssertion(rdfs:seeAlso goldbook:08595 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08595 goldbook:08278)
AnnotationAssertion(rdfs:seeAlso goldbook:08595 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08595 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08595 "current"^^xsd:string)
Declaration(Class(goldbook:08596))
AnnotationAssertion(rdfs:label goldbook:08596 "evanescent wave")
AnnotationAssertion(dcterms:description goldbook:08596 "Part of a standing-wave normal to a reflecting surface that extends beyond the reflecting surface when an electromagnetic wave undergoes total internal reflection.")
AnnotationAssertion(rdfs:seeAlso goldbook:08596 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08596 goldbook:08700)
AnnotationAssertion(mito:isMentionedBy goldbook:08596 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08596 "current"^^xsd:string)
Declaration(Class(goldbook:08597))
AnnotationAssertion(rdfs:label goldbook:08597 "Evans hole")
AnnotationAssertion(dcterms:description goldbook:08597 "Unexpected minimum or hole in a broad absorption band due to a gap being created in a broad distribution of states by Fermi resonance.")
AnnotationAssertion(rdfs:seeAlso goldbook:08597 goldbook:08601)
AnnotationAssertion(mito:isMentionedBy goldbook:08597 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08597 "current"^^xsd:string)
Declaration(Class(goldbook:08598))
AnnotationAssertion(rdfs:label goldbook:08598 "excitation profile")
AnnotationAssertion(dcterms:description goldbook:08598 "Graph of Raman intensity at the desired Raman shift against wavenumber of the excitation.")
AnnotationAssertion(rdfs:seeAlso goldbook:08598 goldbook:08668)
AnnotationAssertion(rdfs:seeAlso goldbook:08598 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08598 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08598 "current"^^xsd:string)
Declaration(Class(goldbook:08599))
AnnotationAssertion(rdfs:label goldbook:08599 "external reflection spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08599 "Measurement method of spectroscopy in which radiation is reflected from a sample of higher refractive index than that of the incident medium.")
AnnotationAssertion(mito:isMentionedBy goldbook:08599 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08599 "current"^^xsd:string)
Declaration(Class(goldbook:08600))
AnnotationAssertion(rdfs:label goldbook:08600 "extraordinary wave")
AnnotationAssertion(dcterms:description goldbook:08600 "In a uniaxial crystal electromagnetic radiation with electric vector oblique to the optic axis and which does not obey the normal laws of refraction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08600 "extraordinary ray")
AnnotationAssertion(rdfs:comment goldbook:08600 "In uniaxial crystals the optic axis coincides with the symmetry axis. The refractive index of the crystal is the same in all directions perpendicular to the optic axis but is different along the optic axis. Consequently, electromagnetic rays or waves that do not travel along the optic axis experience different refractive indices in different directions perpendicular to their direction of propagation. Two waves result, one has its electric vector perpendicular to the optic axis and forms the ordinary wave. The other is the extraordinary wave."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08600 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08600 goldbook:08655)
AnnotationAssertion(mito:isMentionedBy goldbook:08600 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08600 "current"^^xsd:string)
Declaration(Class(goldbook:08601))
AnnotationAssertion(rdfs:label goldbook:08601 "Fermi resonance")
AnnotationAssertion(dcterms:description goldbook:08601 "Cubic anharmonic resonance (see anharmonicity), i.e., any interaction caused by cubic terms in the vibrational potential energy.")
AnnotationAssertion(rdfs:comment goldbook:08601 "Traditionally, Fermi resonance was defined as the anharmonic interaction between a fundamental state and one or more overtone or combination transitions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08601 "Fermi resonance is usually identified by the presence of more than one band of comparable intensity when only one fundamental is expected. Also seen as an Evans hole."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08601 goldbook:08597)
AnnotationAssertion(rdfs:seeAlso goldbook:08601 goldbook:08635)
AnnotationAssertion(rdfs:seeAlso goldbook:08601 goldbook:08580)
AnnotationAssertion(rdfs:seeAlso goldbook:08601 goldbook:08707)
AnnotationAssertion(mito:isMentionedBy goldbook:08601 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08601 "current"^^xsd:string)
Declaration(Class(goldbook:08602))
AnnotationAssertion(rdfs:label goldbook:08602 "finesse")
AnnotationAssertion(dcterms:description goldbook:08602 "Free spectral range divided by resolution.")
AnnotationAssertion(rdfs:seeAlso goldbook:08602 goldbook:08607)
AnnotationAssertion(mito:isMentionedBy goldbook:08602 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08602 "current"^^xsd:string)
Declaration(Class(goldbook:08603))
AnnotationAssertion(rdfs:label goldbook:08603 "fingerprint bands")
AnnotationAssertion(dcterms:description goldbook:08603 "Infrared and Raman bands that are characteristic of a particular molecule rather than a functional group.")
AnnotationAssertion(rdfs:seeAlso goldbook:08603 goldbook:08665)
AnnotationAssertion(mito:isMentionedBy goldbook:08603 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08603 "current"^^xsd:string)
Declaration(Class(goldbook:08604))
AnnotationAssertion(rdfs:label goldbook:08604 "fingerprint region")
AnnotationAssertion(dcterms:description goldbook:08604 "Region of a spectrum that contains fingerprint bands as well as bands with characteristic group frequencies.")
AnnotationAssertion(rdfs:comment goldbook:08604 "The fingerprint region is often associated with the region of the mid-infrared or Raman spectrum of wavenumbers between \\(\\pu{1500 cm-1}\\) and \\(\\pu{400 cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08604 goldbook:08670)
AnnotationAssertion(rdfs:seeAlso goldbook:08604 goldbook:08603)
AnnotationAssertion(rdfs:seeAlso goldbook:08604 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08604 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08604 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08604 "current"^^xsd:string)
Declaration(Class(goldbook:08605))
AnnotationAssertion(rdfs:label goldbook:08605 "Fourier-transform infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08605 "Infrared spectroscopy in which a Fourier-transform spectrometer is used to separate the transmitted electromagnetic radiation into its component wavenumbers.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08605 "FT-IR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08605 "Fourier-transform infrared spectrometry")
AnnotationAssertion(rdfs:seeAlso goldbook:08605 goldbook:08618)
AnnotationAssertion(rdfs:seeAlso goldbook:08605 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08605 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08605 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08605 "current"^^xsd:string)
Declaration(Class(goldbook:08606))
AnnotationAssertion(rdfs:label goldbook:08606 "Fourier-transform Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08606 "Raman spectroscopy in which a Fourier-transform spectrometer is used to separate the scattered electromagnetic radiation into its component wavenumbers.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08606 "Fourier-transform Raman spectrometry")
AnnotationAssertion(rdfs:comment goldbook:08606 "This technique usually uses near-infrared excitation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08606 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08606 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08606 goldbook:08642)
AnnotationAssertion(rdfs:seeAlso goldbook:08606 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08606 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08606 "current"^^xsd:string)
Declaration(Class(goldbook:08607))
AnnotationAssertion(rdfs:label goldbook:08607 "free spectral range")
AnnotationAssertion(dcterms:description goldbook:08607 "For a Fabry-Perot or laser cavity, wavenumber interval between successive longitudinal cavity modes of vibration; \\(\\Delta \\tilde{ u} = 1/(2nl)\\), where \\(l\\) is the cavity spacing and \\(n\\) is the refractive index of the material in the cavity.")
AnnotationAssertion(rdfs:comment goldbook:08607 "SI unit: \\(\\pu{m-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08607 goldbook:08637)
AnnotationAssertion(rdfs:seeAlso goldbook:08607 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08607 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08607 "current"^^xsd:string)
Declaration(Class(goldbook:08608))
AnnotationAssertion(rdfs:label goldbook:08608 "grazing incidence")
AnnotationAssertion(dcterms:description goldbook:08608 "Angle of incidence of a beam of electromagnetic radiation greater than \\(\\pu{70\\!^{\\circ}}\\).")
AnnotationAssertion(rdfs:comment goldbook:08608 "Ideally the angle of incidence should be greater than \\(\\pu{80\\!^{\\circ}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08608 goldbook:08222)
AnnotationAssertion(rdfs:seeAlso goldbook:08608 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08608 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08608 "current"^^xsd:string)
Declaration(Class(goldbook:08609))
AnnotationAssertion(rdfs:label goldbook:08609 "group frequency")
AnnotationAssertion(dcterms:description goldbook:08609 "Frequency in vibrational spectroscopy that is characteristic of a particular chemical functional group.")
AnnotationAssertion(rdfs:comment goldbook:08609 "The frequency is usually given as a wavenumber."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08609 goldbook:08708)
AnnotationAssertion(rdfs:seeAlso goldbook:08609 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08609 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08609 "current"^^xsd:string)
Declaration(Class(goldbook:08610))
AnnotationAssertion(rdfs:label goldbook:08610 "harmonic constant")
AnnotationAssertion(dcterms:description goldbook:08610 "Coefficient of (\\( u + &half;\\)) in the vibrational term value, determined by the harmonic terms in the vibrational potential energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08610 "harmonic wavenumber")
AnnotationAssertion(rdfs:comment goldbook:08610 "SI unit: \\(\\pu{m-1}\\). Common unit: \\(\\pu{cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08610 goldbook:08707)
AnnotationAssertion(rdfs:seeAlso goldbook:08610 goldbook:08709)
AnnotationAssertion(mito:isMentionedBy goldbook:08610 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08610 "current"^^xsd:string)
Declaration(Class(goldbook:08611))
AnnotationAssertion(rdfs:label goldbook:08611 "homogeneous line-broadening")
AnnotationAssertion(dcterms:description goldbook:08611 "Line-broadening by mechanisms that affect every molecule of the same species in the sample in the same way.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08611 "homogeneous broadening")
AnnotationAssertion(rdfs:comment goldbook:08611 "Such mechanisms do not require an ensemble of spectroscopically non-equivalent molecules of the same species. Such mechanisms are the natural line width, which is usually negligible in vibrational spectroscopy, and intra- or inter- molecular interactions, including anharmonic vibrational interactions (see anharmonicity), that reduce the lifetime of the excited state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08611 goldbook:08503)
AnnotationAssertion(rdfs:seeAlso goldbook:08611 goldbook:08635)
AnnotationAssertion(rdfs:seeAlso goldbook:08611 goldbook:08641)
AnnotationAssertion(rdfs:seeAlso goldbook:08611 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08611 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08611 "current"^^xsd:string)
Declaration(Class(goldbook:08612))
AnnotationAssertion(rdfs:label goldbook:08612 "hot transition")
AnnotationAssertion(dcterms:description goldbook:08612 "Electronic transition between an excited state and a state in which all vibrational quantum numbers are the same or greater.")
AnnotationAssertion(rdfs:comment goldbook:08612 "A hot band arises from a hot transition."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08612 "A hot transition has the same changes in vibrational quantum numbers as a fundamental, overtone transition, or sum transition but it originates in an excited vibrational state not the ground state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08612 goldbook:08245)
AnnotationAssertion(rdfs:seeAlso goldbook:08612 goldbook:08656)
AnnotationAssertion(rdfs:seeAlso goldbook:08612 goldbook:08685)
AnnotationAssertion(mito:isMentionedBy goldbook:08612 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08612 "current"^^xsd:string)
Declaration(Class(goldbook:08613))
AnnotationAssertion(rdfs:label goldbook:08613 "hyper-Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08613 "Raman spectroscopy in which scattering occurs through hyperpolarizabilities. A two-photon technique in which an intense pulsed beam of electromagnetic radiation is focused onto the sample. When sufficient power is present in the pulse, two photons may interact with the one molecule to create a virtual state at double the frequency of the laser excitation. Raman scattering from this virtual state to an excited vibrational state of the ground state then occurs.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08613 "HRS")
AnnotationAssertion(rdfs:seeAlso goldbook:08613 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08613 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08613 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08613 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08613 "current"^^xsd:string)
Declaration(Class(goldbook:08614))
AnnotationAssertion(rdfs:label goldbook:08614 "hyperspectral imaging")
AnnotationAssertion(dcterms:description goldbook:08614 "Measurement method to obtain information about the spatial composition of a sample by obtaining a spectrum at each spatially resolved point of the sample.")
AnnotationAssertion(rdfs:seeAlso goldbook:08614 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08614 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08614 "current"^^xsd:string)
Declaration(Class(goldbook:08615))
AnnotationAssertion(rdfs:label goldbook:08615 "improper rotation axis")
AnnotationAssertion(dcterms:description goldbook:08615 "In spectroscopy, a rotation-reflection axis, which is a symmetry element such that rotation by \\(2\\pi/n\\) about the axis followed by reflection through a plane perpendicular to the axis transforms an object into itself.")
AnnotationAssertion(rdfs:comment goldbook:08615 "In crystallography, a rotation-inversion axis, which is a symmetry element such that rotation by \\(2\\pi/n\\) about the axis followed by inversion through the centre of symmetry transforms an object into itself."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08615 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08615 "current"^^xsd:string)
Declaration(Class(goldbook:08616))
AnnotationAssertion(rdfs:label goldbook:08616 "inelastic electron tunnelling spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08616 "Measurement method of vibrational spectroscopy to obtain spectra of molecules on metal oxide surfaces.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08616 "IETS")
AnnotationAssertion(rdfs:comment goldbook:08616 "IETS yields vibrational spectra of adsorbates with high resolution (better than \\(\\pu{0.5 meV}\\)) and low limit of detection (below \\(\\pu{E13}\\) molecules are required to provide a spectrum)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08616 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08616 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08616 "current"^^xsd:string)
Declaration(Class(goldbook:08617))
AnnotationAssertion(rdfs:label goldbook:08617 "infrared radiation")
AnnotationAssertion(dcterms:description goldbook:08617 "Electromagnetic radiation of wavelength between approximately \\(\\pu{780 nm}\\) and \\(\\pu{1000 \\upmu m}\\) or of wavenumber between approximately \\(\\pu{13000 cm-1}\\) and \\(\\pu{10 cm-1}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08617 "IR")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08617 "infrared")
AnnotationAssertion(rdfs:comment goldbook:08617 "The infrared range is sub-divided into three regions: near-infrared: \\(\\pu{780 nm}\\) to \\(\\pu{2.5 \\upmu m}\\) (\\(\\pu{12800 cm-1}\\) to \\(\\pu{400 cm-1}\\)); mid-infrared: \\(\\pu{2.5 \\upmu m}\\) to \\(\\pu{25 \\upmu m}\\) (\\(\\pu{4000 cm-1}\\) to \\(\\pu{400 cm-1}\\)) and far infrared: \\(\\pu{25 \\upmu m}\\) to \\(\\pu{1000 \\upmu m}\\) (\\(\\pu{400 cm-1}\\) to \\(\\pu{10 cm-1}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08617 "The wavelength regions given are commonly used in chemistry and relate to working ranges of infrared spectrometers. Note that in other disciplines (e.g., astronomy) the terms are defined for different ranges."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08617 "If there is no ambiguity the term 'infrared' is used for the mid-infrared region."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08617 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08617 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08617 goldbook:08618)
AnnotationAssertion(rdfs:seeAlso goldbook:08617 goldbook:08642)
AnnotationAssertion(rdfs:seeAlso goldbook:08617 goldbook:08300)
AnnotationAssertion(rdfs:seeAlso goldbook:08617 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08617 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08617 "current"^^xsd:string)
Declaration(Class(goldbook:08618))
AnnotationAssertion(rdfs:label goldbook:08618 "infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08618 "Measurement principle of vibrational spectroscopy using infrared radiation.")
AnnotationAssertion(rdfs:comment goldbook:08618 "Without qualification, 'infrared spectroscopy' usually refers to use of the mid-infrared (wavelength range \\(\\pu{2.5}\\) to \\(\\pu{25 \\upmu m}\\), wavenumber range (\\(\\pu{4000 cm-1}\\) to \\(\\pu{400 cm-1}\\)) region of the electromagnetic spectrum (see table)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08618 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08618 goldbook:08708)
AnnotationAssertion(rdfs:seeAlso goldbook:08618 goldbook:08300)
AnnotationAssertion(rdfs:seeAlso goldbook:08618 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08618 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08618 "current"^^xsd:string)
Declaration(Class(goldbook:08619))
AnnotationAssertion(rdfs:label goldbook:08619 "inhomogeneous broadening")
AnnotationAssertion(dcterms:description goldbook:08619 "Line-broadening by mechanisms that arise from an ensemble of spectroscopically non-equivalent molecules of the same species. Such molecules exist, for example, when molecules occupy non-equivalent sites in a condensed phase, and when gaseous molecules have different velocities and, thus, shift the observed wavenumber differently through the Doppler effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:08619 goldbook:08503)
AnnotationAssertion(rdfs:seeAlso goldbook:08619 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08619 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08619 "current"^^xsd:string)
Declaration(Class(goldbook:08620))
AnnotationAssertion(rdfs:label goldbook:08620 "interference fringes")
AnnotationAssertion(dcterms:description goldbook:08620 "Sinusoidal intensity variation due to interference of electromagnetic radiation that undergoes multiple reflection between two flat and parallel surfaces.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08620 "channel fringes")
AnnotationAssertion(rdfs:comment goldbook:08620 "Interference fringes are frequently observed in the transmission spectrum of a cell with flat windows and in non-scattering polymer films."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08620 "A spectrum of interference fringes is termed a channel spectrum."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08620 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08620 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08620 "current"^^xsd:string)
Declaration(Class(goldbook:08621))
AnnotationAssertion(rdfs:label goldbook:08621 "interference record")
AnnotationAssertion(dcterms:description goldbook:08621 "Record of the signal from the detector of a two-beam interferometer as the optical path difference between the two beams is varied.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08621 "interference function")
AnnotationAssertion(rdfs:comment goldbook:08621 "The interference record contains a part that is constant and a part that varies with the path difference."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08621 goldbook:08653)
AnnotationAssertion(mito:isMentionedBy goldbook:08621 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08621 "current"^^xsd:string)
Declaration(Class(goldbook:08622))
AnnotationAssertion(rdfs:label goldbook:08622 "interferogram")
AnnotationAssertion(dcterms:description goldbook:08622 "Pattern formed by wave interference produced by an interferometer, especially one represented on a screen or chart recorder.")
AnnotationAssertion(mito:isMentionedBy goldbook:08622 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08622 "current"^^xsd:string)
Declaration(Class(goldbook:08623))
AnnotationAssertion(rdfs:label goldbook:08623 "internal reflection")
AnnotationAssertion(dcterms:description goldbook:08623 "Reflection of electromagnetic radiation from a material of lesser refractive index than that of the incident medium.")
AnnotationAssertion(rdfs:seeAlso goldbook:08623 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08623 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08623 "current"^^xsd:string)
Declaration(Class(goldbook:08624))
AnnotationAssertion(rdfs:label goldbook:08624 "internal reflection element")
AnnotationAssertion(dcterms:description goldbook:08624 "Transparent or semi-transparent material of high refractive index that carries infrared radiation to a sample in internal reflection and attenuated total reflection measurements.")
AnnotationAssertion(rdfs:comment goldbook:08624 "The sample is mounted in optical contact with the element."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08624 goldbook:08227)
AnnotationAssertion(rdfs:seeAlso goldbook:08624 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08624 goldbook:08623)
AnnotationAssertion(mito:isMentionedBy goldbook:08624 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08624 "current"^^xsd:string)
Declaration(Class(goldbook:08625))
AnnotationAssertion(rdfs:label goldbook:08625 "inverse Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08625 "Raman scattering showing absorption when Stokes Raman scattering exceeds anti-Stokes Raman scattering, in an experiment in which a sample is simultaneously illuminated by coincident beams from a continuum source and a pulse laser at \\(\\tilde{ u}_{0}\\). Energy is absorbed from the continuum at \\(\\tilde{ u}_{0} + \\tilde{ u}_{\\rm{s}}\\) where \\(\\tilde{ u}_{\\rm{s}}\\) is the wavenumber of a Raman-active vibration in the sample that is excited by this process, and this energy is emitted at \\(\\tilde{ u}_{0}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:08625 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08625 goldbook:08683)
AnnotationAssertion(rdfs:seeAlso goldbook:08625 goldbook:08570)
AnnotationAssertion(rdfs:seeAlso goldbook:08625 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08625 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08625 "current"^^xsd:string)
Declaration(Class(goldbook:08626))
AnnotationAssertion(rdfs:label goldbook:08626 "inverse spatially offset Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08626 "Variant of spatially offset Raman spectroscopy in which a sample is illuminated with a ring of laser light and the Raman scattering is collected from the centre of the ring.")
AnnotationAssertion(rdfs:seeAlso goldbook:08626 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08626 goldbook:08679)
AnnotationAssertion(mito:isMentionedBy goldbook:08626 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08626 "current"^^xsd:string)
Declaration(Class(goldbook:08627))
AnnotationAssertion(rdfs:label goldbook:08627 "IRTRAN™")
AnnotationAssertion(dcterms:description goldbook:08627 "Kinds of crystal transparent to infrared radiation used as windows and filters in infrared spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:08627 "IRTRAN 1 to IRTRAN 5 are hot-pressed forms of \\(\\ce{MgF2}\\), \\(\\ce{CdF2}\\), \\(\\ce{MgO}\\), \\(\\ce{ZnSe}\\) and \\(\\ce{ZnS}\\), respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08627 "IRTRAN is a registered trade mark of Eastman Kodak Co."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08627 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08627 goldbook:08618)
AnnotationAssertion(mito:isMentionedBy goldbook:08627 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08627 "current"^^xsd:string)
Declaration(Class(goldbook:08628))
AnnotationAssertion(rdfs:label goldbook:08628 "Jacquinot stop")
AnnotationAssertion(dcterms:description goldbook:08628 "Aperture in the optics of a Fourier-transform spectrometer, typically between the source and the interferometer, designed to be the limiting aperture when no other optical element such as the detector serves this purpose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08628 "J-stop")
AnnotationAssertion(mito:isMentionedBy goldbook:08628 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08628 "current"^^xsd:string)
Declaration(Class(goldbook:08629))
AnnotationAssertion(rdfs:label goldbook:08629 "kinetic coupling")
AnnotationAssertion(dcterms:description goldbook:08629 "Coupling of vibrational displacements through terms in the vibrational kinetic energy.")
AnnotationAssertion(rdfs:comment goldbook:08629 "Two displacement coordinates must share a common atom if they are to undergo kinetic coupling."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08629 goldbook:08706)
AnnotationAssertion(mito:isMentionedBy goldbook:08629 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08629 "current"^^xsd:string)
Declaration(Class(goldbook:08630))
AnnotationAssertion(rdfs:label goldbook:08630 "KRS-5")
AnnotationAssertion(dcterms:description goldbook:08630 "Eutectic (\\(\\pu{42 \\% TlBr, 58 \\% TlI}\\)) mixture of thallium bromide and thallium iodide transparent to infrared radiation used as window in infrared spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:08630 "KRS-5 transmits well down to \\(\\pu{200 cm-1}\\). It is practically insoluble in water but its refractive index is rather high (approximately 2.35). It is rather plastic and deforms with time, and it is poisonous."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08630 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08630 goldbook:08618)
AnnotationAssertion(mito:isMentionedBy goldbook:08630 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08630 "current"^^xsd:string)
Declaration(Class(goldbook:08631))
AnnotationAssertion(rdfs:label goldbook:08631 "Kubelka–Munk function")
AnnotationAssertion(dcterms:description goldbook:08631 "\\(f(R_{\\infty}) = (1 – R_{\\infty})^{2}/2R_{\\infty}\\), where \\(R_{\\infty}\\) is the diffuse reflectance from a sample of infinite depth.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08631 "remission function")
AnnotationAssertion(rdfs:comment goldbook:08631 "Theoretically \\(f(R_{\\infty})\\) equals the ratio of the linear decadic absorption coefficient to the scattering coefficient. Under the assumptions of the Kubelka Munk theory, if the scattering coefficient at a given wavenumber is a constant for a given set of samples, \\(f(R_{\\infty})\\) is directly proportional to the product of the absorption coefficient and concentration of each component of a mixture, analogous to the behaviour of absorbance under Beer’s law."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08631 goldbook:08235)
AnnotationAssertion(rdfs:seeAlso goldbook:08631 goldbook:08710)
AnnotationAssertion(rdfs:seeAlso goldbook:08631 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08631 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08631 "current"^^xsd:string)
Declaration(Class(goldbook:08632))
AnnotationAssertion(rdfs:label goldbook:08632 "lifetime broadening")
AnnotationAssertion(dcterms:description goldbook:08632 "Homogeneous line-broadening due to the limited lifetime of energy states involved in a transition.")
AnnotationAssertion(rdfs:comment goldbook:08632 "The lifetime may be limited by the natural lifetime, by collisions, as in pressure broadening, or by anharmonic vibrational interactions as in phonon-phonon collisions in solids."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08632 goldbook:08611)
AnnotationAssertion(rdfs:seeAlso goldbook:08632 goldbook:08591)
AnnotationAssertion(rdfs:seeAlso goldbook:08632 goldbook:08663)
AnnotationAssertion(mito:isMentionedBy goldbook:08632 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08632 "current"^^xsd:string)
Declaration(Class(goldbook:08633))
AnnotationAssertion(rdfs:label goldbook:08633 "local mode")
AnnotationAssertion(dcterms:description goldbook:08633 "Mode of vibration localized in one type of bond.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08633 "local mode")
AnnotationAssertion(rdfs:comment goldbook:08633 "For highly excited \\(\\ce{CH}\\) stretching vibrations anharmonic interactions mix the normal modes of vibration to the point that each observed mode of vibration behaves as a local mode."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08633 goldbook:08637)
AnnotationAssertion(rdfs:seeAlso goldbook:08633 goldbook:08648)
AnnotationAssertion(mito:isMentionedBy goldbook:08633 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08633 "current"^^xsd:string)
Declaration(Class(goldbook:08634))
AnnotationAssertion(rdfs:label goldbook:08634 "local molar polarizability")
AnnotationAssertion(dcterms:description goldbook:08634 "Defined under the assumption of the Lorentz local field by the Lorentz-Lorenz formula: \\[\\hat{\\alpha}_{\\rm{m}}(\\tilde{ u}) = 3V_{\\rm{m}}\\epsilon_{0} \\frac{\\hat{\\epsilon}(\\tilde{ u}) - 1}{\\hat{\\epsilon}(\\tilde{ u}) + 2} = 3V_{\\rm{m}}{\\epsilon}_{0}\\,\\frac{\\hat{n}^{2}(\\tilde{ u}) - 1}{\\hat{n}^{2}(\\tilde{ u}) + 2}\\] where \\(V_{\\rm{m}}\\) is the molar volume and \\(\\hat{\\epsilon}\\) and \\(\\boldsymbol{\\hat{n}}\\) are the complex dielectric constant and refractive index, respectively. To allow description of absorption, \\(\\hat{\\alpha}_{\\rm{m}}(\\tilde{ u})\\) is complex: \\(\\hat{\\alpha}_{\\rm{m}}(\\tilde{ u}) = \\alpha_{\\rm{m}}'(\\tilde{ u}) + \\rm{i}\\alpha_{\\rm{m}}''(\\tilde{ u})\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08634 "molar polarizability")
AnnotationAssertion(rdfs:comment goldbook:08634 "The imaginary molar polarizability shows the absorption band free from long range dielectric effects that distort the band shapes of very strong absorptions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08634 "SI unit: \\(\\pu{J-1 C2 m2 mol-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08634 goldbook:08574)
AnnotationAssertion(mito:isMentionedBy goldbook:08634 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08634 "current"^^xsd:string)
Declaration(Class(goldbook:08635))
AnnotationAssertion(rdfs:label goldbook:08635 "mechanical anharmonicity")
AnnotationAssertion(dcterms:description goldbook:08635 "Influence of cubic and higher-order terms in vibrational potential energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08635 "anharmonicity")
AnnotationAssertion(rdfs:comment goldbook:08635 "Mechanical anharmonicity should not be confused with electrical anharmonicity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08635 goldbook:08591)
AnnotationAssertion(rdfs:seeAlso goldbook:08635 goldbook:08707)
AnnotationAssertion(mito:isMentionedBy goldbook:08635 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08635 "current"^^xsd:string)
Declaration(Class(goldbook:08636))
AnnotationAssertion(rdfs:label goldbook:08636 "mechanical harmonicity")
AnnotationAssertion(dcterms:description goldbook:08636 "Influence of quadratic terms in vibrational potential energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08636 "harmonicity")
AnnotationAssertion(rdfs:comment goldbook:08636 "Mechanical harmonicity should not be confused with electrical harmonicity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08636 goldbook:08592)
AnnotationAssertion(rdfs:seeAlso goldbook:08636 goldbook:08707)
AnnotationAssertion(mito:isMentionedBy goldbook:08636 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08636 "current"^^xsd:string)
Declaration(Class(goldbook:08638))
AnnotationAssertion(rdfs:label goldbook:08638 "molar ellipticity")
AnnotationAssertion(dcterms:description goldbook:08638 "Ellipticity divided by the amount concentration of the optically active absorbing material and by the path-length at temperature (\\(t\\)) and wavelength (\\(\\lambda\\)).")
AnnotationAssertion(rdfs:comment goldbook:08638 "SI unit: \\(\\pu{rad m2 mol-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08638 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08638 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08638 "current"^^xsd:string)
Declaration(Class(goldbook:08639))
AnnotationAssertion(rdfs:label goldbook:08639 "multiplex advantage")
AnnotationAssertion(dcterms:description goldbook:08639 "Decrease in measurement uncertainty obtained by measuring intensity at many different wavelengths simultaneously, as is done, for example, in Fourier-transform spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08639 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08639 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08639 "current"^^xsd:string)
Declaration(Class(goldbook:08641))
AnnotationAssertion(rdfs:label goldbook:08641 "natural linewidth")
AnnotationAssertion(dcterms:description goldbook:08641 "Line width of a molecular spectral band that arises from the probability of spontaneous emission in the absence of radiation fields and interaction with other molecules or entities.")
AnnotationAssertion(rdfs:comment goldbook:08641 "The natural linewidth, measured as the full width half maximum equals \\(1/(2\\pi c_{0} \\Delta t)\\), where \\(\\Delta t\\) is the natural lifetime of the excited state."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08641 "If the excited state \\(n\\) can only emit spontaneously to a single lower state \\(m\\) the natural linewidth is \\(\\pu{1.86E-38}\\ \\tilde{\\nu}_{mn}^3 \\langle m|\\boldsymbol{\\mu}|n \\rangle^{2}\\), when the transition wavenumber \\(\\tilde{\\nu}_{mn}\\) is in \\(\\pu{cm-1}\\) and the dipole moment \\(\\mu\\) is in Debye (\\(\\pu{1D \\approx 3.335E-30 C m}\\)). In the infrared, typical natural linewidths are approximately \\(\\pu{E-7 cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08641 goldbook:08251)
AnnotationAssertion(rdfs:seeAlso goldbook:08641 goldbook:08640)
AnnotationAssertion(rdfs:seeAlso goldbook:08641 goldbook:08285)
AnnotationAssertion(mito:isMentionedBy goldbook:08641 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08641 "current"^^xsd:string)
Declaration(Class(goldbook:08642))
AnnotationAssertion(rdfs:label goldbook:08642 "near-infrared radiation")
AnnotationAssertion(dcterms:description goldbook:08642 "Infrared radiation of which vacuum wavenumbers range from approximately \\(\\pu{12800 cm-1}\\) to \\(\\pu{4800 cm-1}\\) and wavelengths range from approximately \\(\\pu{780 nm}\\) to \\(\\pu{2500 nm}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08642 "near-IR")
AnnotationAssertion(rdfs:comment goldbook:08642 "The region is often divided into the silicon region between \\(\\pu{12800 cm-1}\\) and \\(\\pu{9000 cm-1}\\) (\\(\\pu{800 nm}\\) and \\(\\pu{1100 nm}\\)) and the lead sulfide region between \\(\\pu{9000 cm-1}\\) and \\(\\pu{4000 cm-1}\\) (\\(\\pu{1100 nm}\\) and \\(\\pu{2500 nm}\\)), where the names reflect the common detector for the region."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08642 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08642 goldbook:08302)
AnnotationAssertion(rdfs:seeAlso goldbook:08642 goldbook:08299)
AnnotationAssertion(mito:isMentionedBy goldbook:08642 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08642 "current"^^xsd:string)
Declaration(Class(goldbook:08643))
AnnotationAssertion(rdfs:label goldbook:08643 "non-dispersive infrared spectroscopies")
AnnotationAssertion(dcterms:description goldbook:08643 "Kinds of infrared spectroscopy in which the effect of the sample on the radiation from the source is measured as a whole without exploring the dependence on wavenumber.")
AnnotationAssertion(rdfs:comment goldbook:08643 "These methods are mainly used to obtain adequate optical throughput for process measurement and monitoring."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08643 goldbook:08618)
AnnotationAssertion(rdfs:seeAlso goldbook:08643 goldbook:08277)
AnnotationAssertion(rdfs:seeAlso goldbook:08643 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08643 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08643 "current"^^xsd:string)
Declaration(Class(goldbook:08644))
AnnotationAssertion(rdfs:label goldbook:08644 "normal coordinate")
AnnotationAssertion(dcterms:description goldbook:08644 "Formal mathematical description of a normal vibration. When the potential energy, \\(V\\), is harmonic and the kinetic energy, \\(T\\), is calculated in the limit of infinitesimally small displacements, the normal coordinates are defined as independent entities such that '(for non-linear molecules)'\\[V = &half;\\sum_{k=1}^{3N-6}\\lambda_{k}Q_{k}^{2}\\ {\\rm{and}}\\ T = &half;\\sum_{k=1}^{3N-6}\\dot Q_{k}^{2}\\]where \\(\\lambda_{k}\\) is the \\(k^{\\rm{th}}\\) eigenvalue and \\(\\dot {Q}\\) is \\(\\partial Q/\\partial t\\). Normal coordinate \\(Q_{k}\\) is related to the internal displacement coordinates, \\(R_{i}\\), through the elements, \\(L_{ik} = \\partial R_{i}/\\partial Q_{k}\\) of the \\(k^{\\rm{th}}\\) column of the eigenvector matrix \\(\\boldsymbol{L}\\). Normal coordinates are not independent when the potential energy is anharmonic, or the displacements are not infinitesimal.")
AnnotationAssertion(rdfs:comment goldbook:08644 "SI unit: \\(\\pu{kg^{-1/2} m}\\). Common unit: \\(\\pu{u^{1/2} &#8491; \\approx 4.07497E-24 kg^{1/2} m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08644 goldbook:08645)
AnnotationAssertion(rdfs:seeAlso goldbook:08644 goldbook:08705)
AnnotationAssertion(mito:isMentionedBy goldbook:08644 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08644 "current"^^xsd:string)
Declaration(Class(goldbook:08645))
AnnotationAssertion(rdfs:label goldbook:08645 "normal coordinate analysis")
AnnotationAssertion(dcterms:description goldbook:08645 "Calculation of the normal modes of vibrations of a molecule or crystal under the assumptions that the potential energy is harmonic and the displacements from equilibrium are infinitesimal.")
AnnotationAssertion(rdfs:seeAlso goldbook:08645 goldbook:08644)
AnnotationAssertion(rdfs:seeAlso goldbook:08645 goldbook:08648)
AnnotationAssertion(rdfs:seeAlso goldbook:08645 goldbook:08705)
AnnotationAssertion(mito:isMentionedBy goldbook:08645 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08645 "current"^^xsd:string)
Declaration(Class(goldbook:08646))
AnnotationAssertion(rdfs:label goldbook:08646 "normal dispersion of the refractive index")
AnnotationAssertion(dcterms:description goldbook:08646 "Slow decrease of real refractive index of a material in a non-absorbing spectral region far from regions of strong absorption as the wavenumber decreases.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08646 "normal dispersion")
AnnotationAssertion(rdfs:seeAlso goldbook:08646 goldbook:08288)
AnnotationAssertion(rdfs:seeAlso goldbook:08646 goldbook:08301)
AnnotationAssertion(mito:isMentionedBy goldbook:08646 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08646 "current"^^xsd:string)
Declaration(Class(goldbook:08647))
AnnotationAssertion(rdfs:label goldbook:08647 "normal incidence")
AnnotationAssertion(dcterms:description goldbook:08647 "Incidence of a beam of electromagnetic radiation when the angle of incidence \\(\\theta = \\pu{0\\!^{\\circ}}\\), i.e., the incident radiation beam is normal to the surface.")
AnnotationAssertion(rdfs:seeAlso goldbook:08647 goldbook:08222)
AnnotationAssertion(rdfs:seeAlso goldbook:08647 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08647 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08647 "current"^^xsd:string)
Declaration(Class(goldbook:08648))
AnnotationAssertion(rdfs:label goldbook:08648 "normal mode")
AnnotationAssertion(dcterms:description goldbook:08648 "One of the \\(3N - 6\\) (\\(3N - 5\\) for a linear molecule) modes of vibration that would add to give the total vibrational motion in a molecule if the interatomic potential were strictly quadratic in the displacements from equilibrium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08648 "normal mode")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08648 "normal vibration")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08648 "normal vibration mode")
AnnotationAssertion(rdfs:comment goldbook:08648 "Normal modes of vibration is an idealized concept that has proved extremely useful in analysing spectra in vibrational spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08648 goldbook:08637)
AnnotationAssertion(rdfs:seeAlso goldbook:08648 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08648 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08648 "current"^^xsd:string)
Declaration(Class(goldbook:08649))
AnnotationAssertion(rdfs:label goldbook:08649 "normalized tunnelling intensity")
AnnotationAssertion(dcterms:description goldbook:08649 "Second differential of intensity with respect to bias voltage divided by first differential of intensity with respect to bias voltage.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08649 "NTI")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08649 "constant resolution tunnelling intensity")
AnnotationAssertion(rdfs:comment goldbook:08649 "Normalized tunnelling intensity is plotted against the bias voltage to report inelastic electron tunnelling spectroscopy data."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08649 goldbook:08616)
AnnotationAssertion(mito:isMentionedBy goldbook:08649 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08649 "current"^^xsd:string)
Declaration(Class(goldbook:08650))
AnnotationAssertion(rdfs:label goldbook:08650 "optical absorption depth")
AnnotationAssertion(dcterms:description goldbook:08650 "Depth in a sample at which the intensity of an incident beam is reduced to \\(1/\\rm{e}\\) of its value at the surface of the sample.")
AnnotationAssertion(rdfs:comment goldbook:08650 "\\(\\mu_{\\beta}\\) is the reciprocal of the linear Napierian absorption coefficient."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08650 "SI unit: \\(\\pu{m}\\). Common unit: \\(\\pu{\\upmu m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08650 goldbook:08265)
AnnotationAssertion(mito:isMentionedBy goldbook:08650 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08650 "current"^^xsd:string)
Declaration(Class(goldbook:08651))
AnnotationAssertion(rdfs:label goldbook:08651 "optical constants")
AnnotationAssertion(dcterms:description goldbook:08651 "Collective name for the real refractive index, \\(n\\) and the absorption index (imaginary refractive index), \\(k\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:08651 goldbook:08220)
AnnotationAssertion(mito:isMentionedBy goldbook:08651 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08651 "current"^^xsd:string)
Declaration(Class(goldbook:08652))
AnnotationAssertion(rdfs:label goldbook:08652 "optical null double beam spectrometer")
AnnotationAssertion(dcterms:description goldbook:08652 "Spectrometer in which the ratio of the radiant power in the two beams at each wavenumber is measured opto-mechanically by inserting a linear optical attenuator into the reference beam until the two signals measured by the detector are equal, then measuring the displacement of the optical attenuator.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08652 "NTI double beam spectrometer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08652 "null-balance double beam spectrometer")
AnnotationAssertion(rdfs:seeAlso goldbook:08652 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08652 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08652 "current"^^xsd:string)
Declaration(Class(goldbook:08653))
AnnotationAssertion(rdfs:label goldbook:08653 "optical path difference")
AnnotationAssertion(dcterms:description goldbook:08653 "Path-length difference between the arms of a two-beam interferometer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08653 "OPD")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08653 "optical retardation")
AnnotationAssertion(rdfs:comment goldbook:08653 "The term optical retardation is derived from 'phase retardation', which refers to the change in the phase of the electromagnetic radiation in the interferometer."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08653 "SI unit: \\(\\pu{m}\\). Common unit: \\(\\pu{cm}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08653 goldbook:08278)
AnnotationAssertion(rdfs:seeAlso goldbook:08653 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08653 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08653 "current"^^xsd:string)
Declaration(Class(goldbook:08654))
AnnotationAssertion(rdfs:label goldbook:08654 "optical rotatory dispersion")
AnnotationAssertion(dcterms:description goldbook:08654 "Wavelength dependence of the angle of rotation of the plane of linearly-polarized radiation when transmitted through optically active materials.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08654 "ORD")
AnnotationAssertion(rdfs:seeAlso goldbook:08654 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08654 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08654 "current"^^xsd:string)
Declaration(Class(goldbook:08655))
AnnotationAssertion(rdfs:label goldbook:08655 "ordinary wave")
AnnotationAssertion(dcterms:description goldbook:08655 "In a uniaxial crystal electromagnetic radiation with electric vector perpendicular to the optic axis and which obeys the normal laws of refraction.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08655 "ordinary ray")
AnnotationAssertion(rdfs:comment goldbook:08655 "In uniaxial crystals the optic axis coincides with the symmetry axis. The refractive index of the crystal is the same in all directions perpendicular to the optic axis but is different along the optic axis. Consequently, electromagnetic rays or waves that do not travel along the optic axis experience different refractive indices in different directions perpendicular to their direction of propagation. Two waves result, one has its electric vector perpendicular to the optic axis and forms the ordinary wave. The other is the extraordinary wave."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08655 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08655 goldbook:08600)
AnnotationAssertion(mito:isMentionedBy goldbook:08655 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08655 "current"^^xsd:string)
Declaration(Class(goldbook:08656))
AnnotationAssertion(rdfs:label goldbook:08656 "overtone transition")
AnnotationAssertion(dcterms:description goldbook:08656 "Transition between the ground state and a state in which a single mode of vibration is multiply excited.")
AnnotationAssertion(rdfs:comment goldbook:08656 "An overtone band results from an overtone transition."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08656 goldbook:08637)
AnnotationAssertion(mito:isMentionedBy goldbook:08656 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08656 "current"^^xsd:string)
Declaration(Class(goldbook:08657))
AnnotationAssertion(rdfs:label goldbook:08657 "pATR spectrum")
AnnotationAssertion(dcterms:description goldbook:08657 "\\(-\\log_{10}\\) of the spectrum obtained in attenuated total reflection spectroscopy.")
AnnotationAssertion(rdfs:comment goldbook:08657 "The term is used to avoid the confusing, but common and incorrect, practice of calling it the absorbance spectrum."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08657 goldbook:08573)
AnnotationAssertion(rdfs:seeAlso goldbook:08657 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08657 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08657 "current"^^xsd:string)
Declaration(Class(goldbook:08658))
AnnotationAssertion(rdfs:label goldbook:08658 "photoacoustic saturation")
AnnotationAssertion(dcterms:description goldbook:08658 "Condition in photoacoustic spectroscopy in which all bands with greater than a certain absorption intensity appear to have the same intensity.")
AnnotationAssertion(rdfs:comment goldbook:08658 "Photoacoustic saturation arises when the sample is optically opaque and thermally thin, i.e., when the thermal diffusion depth, \\(L\\), is greater than the optical absorption depth, \\(\\mu_{\\beta}\\), and less than the sample thickness. The condition may be relieved by increasing the modulation frequency sufficiently that \\(L\\) becomes less than \\(\\mu_{\\beta}\\), i.e., that the sample becomes thermally thick."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08658 goldbook:08650)
AnnotationAssertion(rdfs:seeAlso goldbook:08658 goldbook:08696)
AnnotationAssertion(mito:isMentionedBy goldbook:08658 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08658 "current"^^xsd:string)
Declaration(Class(goldbook:08659))
AnnotationAssertion(rdfs:label goldbook:08659 "photothermal spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08659 "Measurement method of spectroscopy in which the absorption of electromagnetic radiation by a sample is detected as a result of the heat generated by the absorption.")
AnnotationAssertion(rdfs:seeAlso goldbook:08659 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08659 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08659 "current"^^xsd:string)
Declaration(Class(goldbook:08660))
AnnotationAssertion(rdfs:label goldbook:08660 "polarized Raman band")
AnnotationAssertion(dcterms:description goldbook:08660 "Raman band with depolarization ratio \\(\\rho \\le 0.75\\) for linear polarized incident radiation in normal Raman spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08660 goldbook:08665)
AnnotationAssertion(rdfs:seeAlso goldbook:08660 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08660 goldbook:08586)
AnnotationAssertion(rdfs:seeAlso goldbook:08660 goldbook:08587)
AnnotationAssertion(mito:isMentionedBy goldbook:08660 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08660 "current"^^xsd:string)
Declaration(Class(goldbook:08661))
AnnotationAssertion(rdfs:label goldbook:08661 "potential coupling")
AnnotationAssertion(dcterms:description goldbook:08661 "Coupling of vibrational displacements through terms in the vibrational potential energy. The second-order (quadratic) terms cause harmonic potential coupling while the cubic and higher terms cause anharmonic potential coupling.")
AnnotationAssertion(rdfs:seeAlso goldbook:08661 goldbook:08635)
AnnotationAssertion(rdfs:seeAlso goldbook:08661 goldbook:08636)
AnnotationAssertion(rdfs:seeAlso goldbook:08661 goldbook:08707)
AnnotationAssertion(mito:isMentionedBy goldbook:08661 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08661 "current"^^xsd:string)
Declaration(Class(goldbook:08662))
AnnotationAssertion(rdfs:label goldbook:08662 "p-polarization")
AnnotationAssertion(dcterms:description goldbook:08662 "Polarization when electromagnetic radiation is incident upon a surface with its electric vector in the plane of incidence and, therefore, inclined to the reflecting surface unless the incidence is normal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08662 "TM polarization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08662 "transverse magnetic polarization")
AnnotationAssertion(rdfs:seeAlso goldbook:08662 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08662 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08662 "current"^^xsd:string)
Declaration(Class(goldbook:08663))
AnnotationAssertion(rdfs:label goldbook:08663 "pressure broadening")
AnnotationAssertion(dcterms:description goldbook:08663 "Increase in the line width of a spectral line of a gas due to molecular collisions and other intermolecular interactions that reduce the lifetime of an excited state.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08663 "collision broadening")
AnnotationAssertion(rdfs:comment goldbook:08663 "At pressures sufficiently low that the line width is far smaller than the line wavelength, the line width increases linearly with pressure, the broadening is homogeneous and the line shape is Lorentzian."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08663 goldbook:08550)
AnnotationAssertion(rdfs:seeAlso goldbook:08663 goldbook:08300)
AnnotationAssertion(mito:isMentionedBy goldbook:08663 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08663 "current"^^xsd:string)
Declaration(Class(goldbook:08664))
AnnotationAssertion(rdfs:label goldbook:08664 "quantum cascade laser")
AnnotationAssertion(dcterms:description goldbook:08664 "Laser that emits mid-infrared radiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08664 "QCL")
AnnotationAssertion(rdfs:comment goldbook:08664 "A QCL can be used as a source for infrared spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08664 goldbook:08618)
AnnotationAssertion(rdfs:seeAlso goldbook:08664 goldbook:08617)
AnnotationAssertion(mito:isMentionedBy goldbook:08664 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08664 "current"^^xsd:string)
Declaration(Class(goldbook:08665))
AnnotationAssertion(rdfs:label goldbook:08665 "Raman band")
AnnotationAssertion(dcterms:description goldbook:08665 "Spectral band in Raman spectroscopy.")
AnnotationAssertion(rdfs:seeAlso goldbook:08665 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08665 goldbook:08285)
AnnotationAssertion(mito:isMentionedBy goldbook:08665 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08665 "current"^^xsd:string)
Declaration(Class(goldbook:08666))
AnnotationAssertion(rdfs:label goldbook:08666 "Raman optical activity")
AnnotationAssertion(dcterms:description goldbook:08666 "Phenomenon that vibrations in chiral molecules and materials Raman scattering right circularly polarized incident radiation to a different extent than left circularly polarized incident radiation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08666 "ROA")
AnnotationAssertion(rdfs:comment goldbook:08666 "In practice, the circular polarization of the exciting beam, or of the scattered beam, or of both beams simultaneously, may be selected. Raman optical activity is usually specified as 'right minus left' circular polarizations, in unfortunate contrast to the 'left minus right' specification that is universal in vibrational circular polarization and other forms of optical activity."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08666 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08666 "current"^^xsd:string)
Declaration(Class(goldbook:08667))
AnnotationAssertion(rdfs:label goldbook:08667 "Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08667 "Inelastic scattering of electromagnetic radiation by molecules that are excited to higher energy levels.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08667 "normal Raman scattering")
AnnotationAssertion(rdfs:comment goldbook:08667 "Normal Raman scattering occurs through changes in polarizability of a molecule during a vibration, not the hyper-polarizabilities, and is excited by radiation that is not in resonance with electronic transitions in the sample."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08667 "The energy of the scattered photon can be lesser (Stokes Raman scattering) or greater (anti-Stokes Raman scattering) than that of the incident photon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08667 goldbook:08683)
AnnotationAssertion(rdfs:seeAlso goldbook:08667 goldbook:08570)
AnnotationAssertion(rdfs:seeAlso goldbook:08667 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08667 goldbook:08245)
AnnotationAssertion(rdfs:seeAlso goldbook:08667 goldbook:08246)
AnnotationAssertion(mito:isMentionedBy goldbook:08667 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08667 "current"^^xsd:string)
Declaration(Class(goldbook:08668))
AnnotationAssertion(rdfs:label goldbook:08668 "Raman shift")
AnnotationAssertion(dcterms:description goldbook:08668 "Difference in wavenumber between the incident and scattered electromagnetic radiation in Raman spectroscopy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08668 "Raman wavenumber shift")
AnnotationAssertion(rdfs:comment goldbook:08668 "SI unit: \\(\\pu{m-1}\\). Common unit: \\(\\pu{cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08668 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08668 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08668 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08668 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08668 "current"^^xsd:string)
Declaration(Class(goldbook:08669))
AnnotationAssertion(rdfs:label goldbook:08669 "Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08669 "Measurement principle of vibrational spectroscopy based on Raman scattering.")
AnnotationAssertion(rdfs:comment goldbook:08669 "Raman scattered light occurs at wavelengths that are shifted from the incident light by the energies of molecular vibrations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08669 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08669 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08669 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08669 "current"^^xsd:string)
Declaration(Class(goldbook:08670))
AnnotationAssertion(rdfs:label goldbook:08670 "Raman spectrum")
AnnotationAssertion(dcterms:description goldbook:08670 "Graph of the intensity of scattered electromagnetic radiation in Raman spectroscopy against Raman shift.")
AnnotationAssertion(rdfs:comment goldbook:08670 "Commonly a Raman spectrum is obtained between approximately \\(\\pu{100 cm-1}\\) and \\(\\pu{3500 cm-1}\\) and is a complement to its counterpart mid-infrared spectrum."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08670 goldbook:08668)
AnnotationAssertion(rdfs:seeAlso goldbook:08670 goldbook:08669)
AnnotationAssertion(mito:isMentionedBy goldbook:08670 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08670 "current"^^xsd:string)
Declaration(Class(goldbook:08671))
AnnotationAssertion(rdfs:label goldbook:08671 "Raman wavenumber shift")
AnnotationAssertion(dcterms:description goldbook:08671 "Wavenumber of exciting electromagnetic radiation minus wavenumber of the scattered radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08671 "Raman shift")
AnnotationAssertion(rdfs:comment goldbook:08671 "SI unit: \\(\\pu{m-1}\\). Common unit: \\(\\pu{cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08671 "\\(\\Delta \\tilde{\\nu}\\) is positive for Stokes Raman scattering and negative for anti-Stokes Raman scattering."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08671 goldbook:08683)
AnnotationAssertion(rdfs:seeAlso goldbook:08671 goldbook:08302)
AnnotationAssertion(rdfs:seeAlso goldbook:08671 goldbook:08570)
AnnotationAssertion(rdfs:seeAlso goldbook:08671 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08671 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08671 "current"^^xsd:string)
Declaration(Class(goldbook:08672))
AnnotationAssertion(rdfs:label goldbook:08672 "rapid-scan Fourier-transform infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08672 "Fourier-transform infrared spectroscopy in which the optical path difference is continually changed at a rate of \\(\\pu{0.05 cm s-1}\\) or greater.")
AnnotationAssertion(rdfs:seeAlso goldbook:08672 goldbook:08605)
AnnotationAssertion(rdfs:seeAlso goldbook:08672 goldbook:08581)
AnnotationAssertion(rdfs:seeAlso goldbook:08672 goldbook:08653)
AnnotationAssertion(mito:isMentionedBy goldbook:08672 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08672 "current"^^xsd:string)
Declaration(Class(goldbook:08673))
AnnotationAssertion(rdfs:label goldbook:08673 "reflection-absorption at grazing incidence")
AnnotationAssertion(dcterms:description goldbook:08673 "Reflection-absorption with very thin layers of an absorbing material on a metallic substrate and the angle of incidence between \\(\\pu{70\\!^{\\circ}}\\) and \\(\\pu{90\\!^{\\circ}}\\).")
AnnotationAssertion(rdfs:comment goldbook:08673 "As the incident radiation beam travels nearly parallel to the sample surface, the electric vector of the radiation is then either parallel or nearly perpendicular to the surface."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08673 goldbook:08222)
AnnotationAssertion(mito:isMentionedBy goldbook:08673 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08673 "current"^^xsd:string)
Declaration(Class(goldbook:08674))
AnnotationAssertion(rdfs:label goldbook:08674 "resonance Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08674 "Raman scattering that occurs through the polarizability of a molecule, (not the hyperpolarizabilities) and is excited by electromagnetic radiation that is in resonance with electronic transitions or vibronic transitions in the sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08674 "RR")
AnnotationAssertion(rdfs:seeAlso goldbook:08674 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08674 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08674 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08674 "current"^^xsd:string)
Declaration(Class(goldbook:08675))
AnnotationAssertion(rdfs:label goldbook:08675 "rotational branch")
AnnotationAssertion(dcterms:description goldbook:08675 "Spectral lines in the rotation-vibration spectrum of a gas that derive from the same change in rotation quantum number, \\(J\\).")
AnnotationAssertion(rdfs:comment goldbook:08675 "\\(\\Delta J = J_{\\rm{upper}} - J_{\\rm{lower}} = -2, -1, 0, +1\\ \\rm{and}\\ +2\\) for the \\(\\rm{O}\\), \\(\\rm{P}\\), \\(\\rm{Q}\\), \\(\\rm{R}\\) and \\(\\rm{S}\\) branches, respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08675 "The most commonly observed branches for simple molecules are the \\(\\rm{P}\\), \\(\\rm{Q}\\) and \\(\\rm{R}\\) branches in infrared spectroscopy and the \\(\\rm{O}\\), \\(\\rm{Q}\\) and \\(\\rm{S}\\) branches in Raman spectroscopy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08675 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08675 goldbook:08550)
AnnotationAssertion(rdfs:seeAlso goldbook:08675 goldbook:08618)
AnnotationAssertion(rdfs:seeAlso goldbook:08675 goldbook:08676)
AnnotationAssertion(mito:isMentionedBy goldbook:08675 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08675 "current"^^xsd:string)
Declaration(Class(goldbook:08676))
AnnotationAssertion(rdfs:label goldbook:08676 "rotation-vibration spectrum")
AnnotationAssertion(dcterms:description goldbook:08676 "Spectrum that shows absorption or emission of radiation during transitions between rotational-vibrational states of a molecule.")
AnnotationAssertion(rdfs:seeAlso goldbook:08676 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08676 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08676 "current"^^xsd:string)
Declaration(Class(goldbook:08677))
AnnotationAssertion(rdfs:label goldbook:08677 "scattering geometry")
AnnotationAssertion(dcterms:description goldbook:08677 "Relation between the propagation directions, \\(k_{\\rm{i}}\\), \\(k_{\\rm{s}}\\), and the polarization directions, \\(p_{\\rm{i}}\\), \\(p_{\\rm{s}}\\), of the incident and scattered radiation, usually expressed in terms of laboratory-fixed or crystal-fixed Cartesian axes.")
AnnotationAssertion(rdfs:comment goldbook:08677 "A common notation, due to Porto, is \\(k_{\\rm{i}}(p_{\\rm{i}}\\,p_{\\rm{s}})k_{\\rm{s}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08677 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08677 "current"^^xsd:string)
Declaration(Class(goldbook:08678))
AnnotationAssertion(rdfs:label goldbook:08678 "site splitting")
AnnotationAssertion(dcterms:description goldbook:08678 "Appearance of more than one band in the spectrum of a crystal when only one is seen in that of the gas, when this splitting is attributed to either the molecule lying on a crystal site of lower symmetry than that of the gaseous molecule or to molecules occupying more than one type of crystal site. See crystal field splitting.")
AnnotationAssertion(rdfs:comment goldbook:08678 "Site splitting arises from the static intermolecular forces in the crystal."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08678 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08678 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08678 "current"^^xsd:string)
Declaration(Class(goldbook:08679))
AnnotationAssertion(rdfs:label goldbook:08679 "spatially offset Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08679 "Measurement method of Raman spectroscopy in which the sample is illuminated at one location, and the Raman signal is collected from a different location on the sample surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08679 "SORS")
AnnotationAssertion(rdfs:comment goldbook:08679 "SORS allows chemical analysis of objects beneath diffusely scattering surfaces, such as tissue, powders and translucent plastics."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08679 goldbook:08669)
AnnotationAssertion(mito:isMentionedBy goldbook:08679 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08679 "current"^^xsd:string)
Declaration(Class(goldbook:08680))
AnnotationAssertion(rdfs:label goldbook:08680 "spherical top")
AnnotationAssertion(dcterms:description goldbook:08680 "Molecule whose three principal moments of inertia are all the same. An isotropic molecule.")
AnnotationAssertion(mito:isMentionedBy goldbook:08680 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08680 "current"^^xsd:string)
Declaration(Class(goldbook:08681))
AnnotationAssertion(rdfs:label goldbook:08681 "step-scan interferometer")
AnnotationAssertion(dcterms:description goldbook:08681 "Interferometer (typically used for Fourier-transform infrared spectroscopy) in which the optical path difference is changed by a certain amount, held constant, or modulated if phase modulation is desired, while the signal at the current path difference is recorded, then the process is repeated.")
AnnotationAssertion(rdfs:seeAlso goldbook:08681 goldbook:08605)
AnnotationAssertion(rdfs:seeAlso goldbook:08681 goldbook:08653)
AnnotationAssertion(mito:isMentionedBy goldbook:08681 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08681 "current"^^xsd:string)
Declaration(Class(goldbook:08682))
AnnotationAssertion(rdfs:label goldbook:08682 "stimulated Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08682 "Two-photon Raman scattering occurs when a picosecond pump beam is used to create a virtual state and a probe beam of a frequency to match the frequency of Stokes Raman scattering from the virtual state to a specific vibrational level. The Stokes emission is stimulated thus depopulating the virtual state very quickly and increasing the scattering efficiency for the chosen vibration by orders of magnitude. SRS is a non-linear process, so sufficient photons from both the pump and probe beams must be present on the molecule at the one time.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08682 "SRS")
AnnotationAssertion(rdfs:seeAlso goldbook:08682 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08682 goldbook:08683)
AnnotationAssertion(mito:isMentionedBy goldbook:08682 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08682 "current"^^xsd:string)
Declaration(Class(goldbook:08683))
AnnotationAssertion(rdfs:label goldbook:08683 "Stokes–Raman scattering")
AnnotationAssertion(dcterms:description goldbook:08683 "Raman scattering of electromagnetic radiation in which the scattered radiation has lesser energy (lesser wavenumber) than the exciting radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08683 "Stokes scattering")
AnnotationAssertion(rdfs:seeAlso goldbook:08683 goldbook:08667)
AnnotationAssertion(rdfs:seeAlso goldbook:08683 goldbook:08570)
AnnotationAssertion(rdfs:seeAlso goldbook:08683 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08683 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08683 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08683 "current"^^xsd:string)
Declaration(Class(goldbook:08684))
AnnotationAssertion(rdfs:label goldbook:08684 "sum band")
AnnotationAssertion(dcterms:description goldbook:08684 "Band resulting from a sum transition.")
AnnotationAssertion(rdfs:seeAlso goldbook:08684 goldbook:08685)
AnnotationAssertion(mito:isMentionedBy goldbook:08684 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08684 "current"^^xsd:string)
Declaration(Class(goldbook:08685))
AnnotationAssertion(rdfs:label goldbook:08685 "sum transition")
AnnotationAssertion(dcterms:description goldbook:08685 "Combination transition between the ground state and a state in which more than one vibration is excited; i.e., a transition from the ground state in which more than one quantum number increases.")
AnnotationAssertion(rdfs:seeAlso goldbook:08685 goldbook:08580)
AnnotationAssertion(mito:isMentionedBy goldbook:08685 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08685 "current"^^xsd:string)
Declaration(Class(goldbook:08686))
AnnotationAssertion(rdfs:label goldbook:08686 "sum-frequency spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08686 "Nonlinear optical technique in which pulsed lasers at frequencies \\(\\omega_{1}\\) and \\(\\omega_{2}\\) are overlapped at a surface and light emitted at the sum of the two frequencies, \\(\\omega_{1} + \\omega_{2}\\), is detected. One laser is normally in the mid-infrared and the other in the visible or near-infrared.")
AnnotationAssertion(rdfs:seeAlso goldbook:08686 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08686 goldbook:08532)
AnnotationAssertion(mito:isMentionedBy goldbook:08686 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08686 "current"^^xsd:string)
Declaration(Class(goldbook:08687))
AnnotationAssertion(rdfs:label goldbook:08687 "surface-enhanced hyper-Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08687 "Measurement method of Raman spectroscopy by which the Raman spectrum is significantly enhanced simultaneously by both the hyper-Raman (see hyper-Raman spectroscopy) and surface-enhanced Raman (see surface-enhanced Raman spectroscopy) effects.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08687 "SEHRS")
AnnotationAssertion(rdfs:comment goldbook:08687 "Very high enhancement factors of \\(\\pu{E20}\\) have been claimed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08687 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08687 goldbook:08670)
AnnotationAssertion(rdfs:seeAlso goldbook:08687 goldbook:08613)
AnnotationAssertion(rdfs:seeAlso goldbook:08687 goldbook:08689)
AnnotationAssertion(mito:isMentionedBy goldbook:08687 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08687 "current"^^xsd:string)
Declaration(Class(goldbook:08688))
AnnotationAssertion(rdfs:label goldbook:08688 "surface-enhanced infrared absorption")
AnnotationAssertion(dcterms:description goldbook:08688 "Measurement method of infrared spectroscopy by which the intensity of absorption bands of molecules within a few nanometers of the surface of metal particles is increased by interactions with surface plasmons (the collective resonance of electrons near the surface of metal islands).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08688 "SEIRA")
AnnotationAssertion(rdfs:comment goldbook:08688 "The metals that give the largest enhancement are silver and gold, but this phenomenon has been reported to occur with at least eight other metals."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08688 goldbook:08618)
AnnotationAssertion(mito:isMentionedBy goldbook:08688 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08688 "current"^^xsd:string)
Declaration(Class(goldbook:08689))
AnnotationAssertion(rdfs:label goldbook:08689 "surface-enhanced Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08689 "Measurement method of Raman spectroscopy by which the intensity of vibrational bands in the Raman spectra of molecules within a few nanometers of the surface of microscopically rough metals, metal colloids and metal nanoparticles is increased by several orders of magnitude.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08689 "SERS")
AnnotationAssertion(rdfs:comment goldbook:08689 "The metals that give the largest enhancement are silver, gold and copper, but this phenomenon has been reported to occur with a range of other metals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08689 "Other mechanisms of enhancement are known but the common usage of SERS is with a metal or with related systems and implies enhancement through interaction with a surface plasmon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08689 goldbook:08670)
AnnotationAssertion(rdfs:seeAlso goldbook:08689 goldbook:08669)
AnnotationAssertion(mito:isMentionedBy goldbook:08689 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08689 "current"^^xsd:string)
Declaration(Class(goldbook:08690))
AnnotationAssertion(rdfs:label goldbook:08690 "surface-enhanced resonance Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08690 "Measurement method of surface-enhanced Raman spectroscopy (SERS) by which the Raman spectrum is significantly enhanced when the conditions occur that whilst undergoing SERS the molecules are excited by radiation that is in resonance with electronic transitions in the sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08690 "SERRS")
AnnotationAssertion(rdfs:comment goldbook:08690 "Enhancements of \\(\\pu{E14}\\) to \\(\\pu{E15}\\) have been measured."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08690 goldbook:08670)
AnnotationAssertion(rdfs:seeAlso goldbook:08690 goldbook:08245)
AnnotationAssertion(rdfs:seeAlso goldbook:08690 goldbook:08689)
AnnotationAssertion(mito:isMentionedBy goldbook:08690 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08690 "current"^^xsd:string)
Declaration(Class(goldbook:08691))
AnnotationAssertion(rdfs:label goldbook:08691 "surface-enhanced, spatially offset Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08691 "Measurement method of Raman spectroscopy that combines spatially offset Raman spectroscopy and surface-enhanced Raman spectroscopy (SERS) enabling the detection of a SERS signal deep within diffusely scattering samples.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08691 "SESORS")
AnnotationAssertion(rdfs:seeAlso goldbook:08691 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08691 goldbook:08679)
AnnotationAssertion(rdfs:seeAlso goldbook:08691 goldbook:08689)
AnnotationAssertion(mito:isMentionedBy goldbook:08691 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08691 "current"^^xsd:string)
Declaration(Class(goldbook:08692))
AnnotationAssertion(rdfs:label goldbook:08692 "symmetric")
AnnotationAssertion(dcterms:description goldbook:08692 "Term used in at least two senses in vibrational spectroscopy. In general usage, a symmetric molecule is a molecule with high symmetry. In more specific usage, a property is symmetric with respect to a symmetry element if it remains unchanged by the action of the corresponding symmetry operation.")
AnnotationAssertion(rdfs:seeAlso goldbook:08692 goldbook:08708)
AnnotationAssertion(mito:isMentionedBy goldbook:08692 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08692 "current"^^xsd:string)
Declaration(Class(goldbook:08693))
AnnotationAssertion(rdfs:label goldbook:08693 "symmetric top")
AnnotationAssertion(dcterms:description goldbook:08693 "Molecule that has two equal principal moments of inertia with the third one different.")
AnnotationAssertion(rdfs:seeAlso goldbook:08693 goldbook:08571)
AnnotationAssertion(mito:isMentionedBy goldbook:08693 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08693 "current"^^xsd:string)
Declaration(Class(goldbook:08694))
AnnotationAssertion(rdfs:label goldbook:08694 "symmetry coordinate")
AnnotationAssertion(dcterms:description goldbook:08694 "Each \\(S_{i}\\) is a linear combination of general coordinates, usually internal coordinates, constructed to take advantage of the molecular symmetry. The \\(S_{i}\\) are elements of the vector \\(\\boldsymbol{S}\\). They have the same units as the general coordinates from which they were constructed.")
AnnotationAssertion(mito:isMentionedBy goldbook:08694 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08694 "current"^^xsd:string)
Declaration(Class(goldbook:08695))
AnnotationAssertion(rdfs:label goldbook:08695 "symmorphic space group")
AnnotationAssertion(dcterms:description goldbook:08695 "Space group that does not contain screw-axes and glide planes.")
AnnotationAssertion(mito:isMentionedBy goldbook:08695 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08695 "current"^^xsd:string)
Declaration(Class(goldbook:08696))
AnnotationAssertion(rdfs:label goldbook:08696 "thermal diffusion depth")
AnnotationAssertion(dcterms:description goldbook:08696 "In photoacoustic spectroscopy, \\(L = \\sqrt{(D/\\pi f)}\\), where \\(D\\) is thermal diffusivity and \\(f\\) is modulation frequency of the electromagnetic radiation.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08696 "thermal wave decay length")
AnnotationAssertion(rdfs:comment goldbook:08696 "SI unit: \\(\\pu{m}\\). Common unit: \\(\\pu{\\upmu m}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08696 "\\(\\pu{63 \\%}\\) of the PAS signal originates within the thermal diffusion depth."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08696 goldbook:08242)
AnnotationAssertion(rdfs:seeAlso goldbook:08696 goldbook:08697)
AnnotationAssertion(mito:isMentionedBy goldbook:08696 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08696 "current"^^xsd:string)
Declaration(Class(goldbook:08697))
AnnotationAssertion(rdfs:label goldbook:08697 "thermal diffusivity")
AnnotationAssertion(dcterms:description goldbook:08697 "Thermal conductivity divided by the product of the specific heat and the density.")
AnnotationAssertion(rdfs:comment goldbook:08697 "SI unit: \\(\\pu{m2 s-1}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08697 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08697 "current"^^xsd:string)
Declaration(Class(goldbook:08698))
AnnotationAssertion(rdfs:label goldbook:08698 "thermal wave decay coefficient")
AnnotationAssertion(dcterms:description goldbook:08698 "Reciprocal of the thermal diffusion depth (\\(L\\)). \\(a_{\\rm{s}} = 1/L\\).")
AnnotationAssertion(rdfs:comment goldbook:08698 "SI unit: \\(\\pu{m-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08698 goldbook:08696)
AnnotationAssertion(mito:isMentionedBy goldbook:08698 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08698 "current"^^xsd:string)
Declaration(Class(goldbook:08699))
AnnotationAssertion(rdfs:label goldbook:08699 "tip-enhanced Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08699 "Measurement method of Raman spectroscopy combining surface-enhanced Raman spectroscopy and scanning using an atomic force microscope or scanning tunnelling microscope to give complementary maps of a surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08699 "TERS")
AnnotationAssertion(rdfs:seeAlso goldbook:08699 goldbook:08669)
AnnotationAssertion(rdfs:seeAlso goldbook:08699 goldbook:08689)
AnnotationAssertion(mito:isMentionedBy goldbook:08699 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08699 "current"^^xsd:string)
Declaration(Class(goldbook:08700))
AnnotationAssertion(rdfs:label goldbook:08700 "total internal reflection")
AnnotationAssertion(dcterms:description goldbook:08700 "Internal reflection from a non-absorbing material at angles of incidence at or above the critical angle.")
AnnotationAssertion(mito:isMentionedBy goldbook:08700 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08700 "current"^^xsd:string)
Declaration(Class(goldbook:08701))
AnnotationAssertion(rdfs:label goldbook:08701 "transflectance")
AnnotationAssertion(dcterms:description goldbook:08701 "Spectral intensity of a transflected beam divided by spectral intensity of the incident beam in a transflection experiment.")
AnnotationAssertion(rdfs:comment goldbook:08701 "'Transflectance' has also been used to mean transflection, and this usage is strongly discouraged."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08701 goldbook:08702)
AnnotationAssertion(mito:isMentionedBy goldbook:08701 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08701 "current"^^xsd:string)
Declaration(Class(goldbook:08702))
AnnotationAssertion(rdfs:label goldbook:08702 "transflection")
AnnotationAssertion(dcterms:description goldbook:08702 "Reflection absorption at near-normal incidence when the thickness of the absorbing medium is large enough to yield an interpretable spectrum. The substrate is usually a mirror for mid-infrared measurements and a ceramic disk for near-infrared measurements. The angle of incidence is typically between \\(\\pu{0\\!^{\\circ}}\\) and \\(\\pu{45\\!^{\\circ}}\\).")
AnnotationAssertion(rdfs:comment goldbook:08702 "Transflection is widely used in IR microscopy and is particularly convenient for measuring transmission-like spectra in a near-infrared instrument configured for diffuse reflection measurements by mounting the sample on a non-absorbing diffusely reflecting substrate."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08702 goldbook:08222)
AnnotationAssertion(rdfs:seeAlso goldbook:08702 goldbook:08236)
AnnotationAssertion(rdfs:seeAlso goldbook:08702 goldbook:08647)
AnnotationAssertion(rdfs:seeAlso goldbook:08702 goldbook:08291)
AnnotationAssertion(mito:isMentionedBy goldbook:08702 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08702 "current"^^xsd:string)
Declaration(Class(goldbook:08703))
AnnotationAssertion(rdfs:label goldbook:08703 "transmission Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08703 "Measurement method of Raman spectroscopy in which the sample is illuminated on one side and the Raman signal is collected from the opposite side.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08703 "TRS")
AnnotationAssertion(rdfs:comment goldbook:08703 "text"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08703 goldbook:08669)
AnnotationAssertion(mito:isMentionedBy goldbook:08703 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08703 "current"^^xsd:string)
Declaration(Class(goldbook:08704))
AnnotationAssertion(rdfs:label goldbook:08704 "vibrational circular dichroism")
AnnotationAssertion(dcterms:description goldbook:08704 "Circular dichroism, \\(k^{\\rm{L}} – k^{\\rm{R}}\\), for vibrational transitions.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08704 "VCD")
AnnotationAssertion(rdfs:comment goldbook:08704 "Vibrations in chiral molecules and materials absorb left circularly polarized radiation to a different extent than right circularly polarized radiation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08704 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08704 "current"^^xsd:string)
Declaration(Class(goldbook:08705))
AnnotationAssertion(rdfs:label goldbook:08705 "vibrational eigenvector")
AnnotationAssertion(dcterms:description goldbook:08705 "Part of the solution of the matrix equation of normal coordinate analysis, \\(\\boldsymbol{G\\!F\\!L} = \\boldsymbol{L \\lambda}\\). Each element \\(L_{ik}\\) of \\(\\boldsymbol{L}\\) is a vibrational eigenvector, and gives the change in internal coordinate \\(R_{i}\\) during unit change in the normal coordinate \\(Q_{k}\\), as shown in matrix form by \\(\\boldsymbol{R} = \\boldsymbol{LQ}\\), i.e., \\(L_{ik} = \\partial R_{i}/\\partial Q_{k}\\). Eigenvectors are sometimes expressed in terms of symmetry coordinates or Cartesian coordinates.")
AnnotationAssertion(rdfs:comment goldbook:08705 "SI unit: \\(\\pu{kg^{-1/2}}\\). Common unit: \\(u^{-1/2} = \\pu{2.45400E13 kg^{-1/2}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08705 goldbook:08644)
AnnotationAssertion(rdfs:seeAlso goldbook:08705 goldbook:08645)
AnnotationAssertion(mito:isMentionedBy goldbook:08705 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08705 "current"^^xsd:string)
Declaration(Class(goldbook:08706))
AnnotationAssertion(rdfs:label goldbook:08706 "vibrational kinetic energy")
AnnotationAssertion(dcterms:description goldbook:08706 "Kinetic energy of the molecule as a function of the displacements of the atoms from equilibrium positions. For Cartesian displacement coordinates (\\(x, y, z\\)), \\[T = \\sum_{\\alpha}&frac12;m_{\\alpha}(\\dot x_{\\alpha}^{2} + \\dot y_{\\alpha}^{2} + \\dot z_{\\alpha}^{2})\\] where the sum is over all atoms and \\(\\dot{x}_{\\alpha}\\), etc., are the displacement velocities. For internal coordinates \\[T = &frac12;\\boldsymbol{P}^{t}\\boldsymbol{GP} = &frac12;\\dot{\\boldsymbol{R}}^{t}{\\boldsymbol{G}}^{-1}\\dot {\\boldsymbol{R}} = &frac12;\\sum_{ij}G_{ij}^{-1}\\dot R_{i}\\dot R_{j}\\] where \\(\\dot {\\boldsymbol{R}}^{t}\\) and \\(\\dot {\\boldsymbol{R}}\\) are the row and column vector, respectively, of the \\(\\partial R_{i}/\\partial t\\), \\(\\boldsymbol{P}^{t}\\) and \\(\\boldsymbol{P}\\) are the row and column vector, respectively, of the momenta conjugate to the \\(R_{i}\\), \\(\\boldsymbol{G}^{-1}\\) is the inverse of the \\(\\boldsymbol{G}\\) matrix and \\(G_{ij}^{-1}\\) is the \\(ij^{\\rm{th}}\\) element of \\(\\boldsymbol{G}^{-1}\\). The elements of the \\(\\boldsymbol{G}\\) matrix are defined by \\[G_{ij} = \\sum_{\\alpha} \\frac{1}{m_{\\alpha}} B_{i\\alpha} B_{j\\alpha}\\] where \\(B_{i\\alpha}\\) and \\(B_{j\\alpha}\\) relate the \\(i^{\\rm{th}}\\) and \\(j^{\\rm{th}}\\) internal coordinate to the \\(\\alpha^{\\rm{th}}\\) Cartesian coordinate through the equation \\(\\boldsymbol{R} = \\boldsymbol{BX}\\) in which \\(\\boldsymbol{X}\\) is the column vector of the Cartesian coordinates.")
AnnotationAssertion(mito:isMentionedBy goldbook:08706 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08706 "current"^^xsd:string)
Declaration(Class(goldbook:08707))
AnnotationAssertion(rdfs:label goldbook:08707 "vibrational potential energy")
AnnotationAssertion(dcterms:description goldbook:08707 "Potential energy of the molecule as a function of the displacements of the atoms from equilibrium positions. The harmonic terms are quadratic in the displacements and the anharmonic terms are of cubic, quartic and higher orders in the displacements. \\(Q\\) are normal coordinates \\[2V = \\sum\\limits_{k}\\lambda_{k}Q_{k}^{2} + \\sum\\limits_{ijk}k_{ijk}Q_{i}Q_{j}Q_{k} + higher\\,order\\,terms\\] In terms of internal coordinates, \\[2V = \\sum\\limits_{i} F_{ii} R_i^{2} + \\sum\\limits_{i,j e i} F_{ij} R_{i} R_{j} + \\sum\\limits_{i,j,k} F_{ijk} R_{i} R_{j} R_{k} + higher\\,order\\,terms\\]")
AnnotationAssertion(rdfs:comment goldbook:08707 "SI unit: \\(\\pu{J}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08707 goldbook:08644)
AnnotationAssertion(mito:isMentionedBy goldbook:08707 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08707 "current"^^xsd:string)
Declaration(Class(goldbook:08708))
AnnotationAssertion(rdfs:label goldbook:08708 "vibrational spectroscopy")
AnnotationAssertion(dcterms:description goldbook:08708 "Measurement principle of spectroscopy to analyse molecular properties based on vibrations (bond stretching or deformation modes) in chemical species.")
AnnotationAssertion(rdfs:comment goldbook:08708 "Typically, vibrational spectroscopy uses electromagnetic radiation lower in energy than the visible spectrum i.e., infrared or near infrared (see table)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08708 goldbook:08617)
AnnotationAssertion(rdfs:seeAlso goldbook:08708 goldbook:08642)
AnnotationAssertion(mito:isMentionedBy goldbook:08708 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08708 "current"^^xsd:string)
Declaration(Class(goldbook:08709))
AnnotationAssertion(rdfs:label goldbook:08709 "vibrational term value")
AnnotationAssertion(dcterms:description goldbook:08709 "Vibrational energy, \\(E\\), expressed in wavenumber units. \\(G = E/(hc)\\), where \\(h\\) is the Planck constant and \\(c\\) is the speed of light in vacuum.")
AnnotationAssertion(rdfs:comment goldbook:08709 "\\(G\\) is usually written with zero-energy at the minimum of the potential energy curve for a diatomic molecule as: \\[G = \\omega_{\\rm{e}}(\\nu +1/2) - \\omega_{\\rm{e}} x_{\\rm{e}}(\\nu +1/2)^{2} + \\omega_{\\rm{e}} y_{\\rm{e}}(\\nu + 1/2)^{3} + higher\\ order\\ terms,\\] and for a polyatomic molecule \\[G = \\sum_{k} \\omega_{k}(\\nu_{k} + g_{k}/2) + \\sum_{i\\le j} X_{ij}(\\nu_{i} + g_{i}/2)(\\nu_{j} + g_{j}/2) + higher\\ order\\ terms,\\] where \\(\\nu\\), \\(\\nu_{k}\\), etc. = 0, 1, 2, 3,··· , and \\(g\\) is the degeneracy of a vibration. \\(X_{ij}\\) are the anharmonic constants."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08709 "SI unit: \\(\\pu{m-1}\\). Common unit: \\(\\pu{cm-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08709 goldbook:08302)
AnnotationAssertion(mito:isMentionedBy goldbook:08709 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08709 "current"^^xsd:string)
Declaration(Class(goldbook:08710))
AnnotationAssertion(rdfs:label goldbook:08710 "volume reflection")
AnnotationAssertion(dcterms:description goldbook:08710 "Re-emergence of electromagnetic radiation from the surface of incidence after penetrating into a powdered sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08710 "Kubelka–Munk reflection")
AnnotationAssertion(rdfs:seeAlso goldbook:08710 goldbook:08242)
AnnotationAssertion(mito:isMentionedBy goldbook:08710 doi:10.1515/pac-2019-0203)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08710 "current"^^xsd:string)
Declaration(Class(goldbook:08711))
AnnotationAssertion(rdfs:label goldbook:08711 "absolute counting efficiency")
AnnotationAssertion(dcterms:description goldbook:08711 "Number of particles or photons counted by a radiation detector divided by the number emitted by a radiation source.")
AnnotationAssertion(mito:isMentionedBy goldbook:08711 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08711 "current"^^xsd:string)
Declaration(Class(goldbook:08712))
AnnotationAssertion(rdfs:label goldbook:08712 "accelerator mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:08712 "Mass spectrometry technique in which atoms and molecules from a sample are ionized, accelerated to mega-electron volt (\\(\\pu{1 MeV} = \\pu{1.602176634E-13 J}\\)) energies, and separated according to their momentum, charge, and energy, allowing high discrimination for the measurement of nuclide abundances.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08712 "AMS")
AnnotationAssertion(rdfs:comment goldbook:08712 "AMS is typically used for (but not limited to) the measurement of radionuclides with long half-lives, such as \\(\\ce{^{10}Be}\\), \\(\\ce{^{14}C}\\), \\(\\ce{^{26}Al}\\), \\(\\ce{^{36}Cl}\\), \\(\\ce{^{53}Mn}\\), and \\(\\ce{^{129}I}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08712 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08712 "current"^^xsd:string)
Declaration(Class(goldbook:08713))
AnnotationAssertion(rdfs:label goldbook:08713 "activity growth curve")
AnnotationAssertion(dcterms:description goldbook:08713 "Graph of the activity of a radioactive nuclide as a function of time and showing the increase of activity through the decay of the precursor or as a result of activation.")
AnnotationAssertion(mito:isMentionedBy goldbook:08713 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08713 "current"^^xsd:string)
Declaration(Class(goldbook:08714))
AnnotationAssertion(rdfs:label goldbook:08714 "backscattering analysis")
AnnotationAssertion(dcterms:description goldbook:08714 "Measurement principle in which the backscattering of nuclear radiation impinging on a sample is applied to measure the structure and composition of materials.")
AnnotationAssertion(mito:isMentionedBy goldbook:08714 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08714 "current"^^xsd:string)
Declaration(Class(goldbook:08716))
AnnotationAssertion(rdfs:label goldbook:08716 "calibration, k0 method")
AnnotationAssertion(dcterms:description goldbook:08716 "Calibration method of neutron activation analysis in which the \\(k_{0}\\) proportionality factors, together with a value of the neutron flux (as a function of the neutron energy) and with a value of the radiation detector's response for gamma radiation (as a function of the gamma-ray energy) are used for establishing a relationship between the number of counts measured and the corresponding amounts of elements in a material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08716 "<em>k</em><sub>0</sub> method of calibration")
AnnotationAssertion(rdfs:comment goldbook:08716 "The \\(k_{0}\\) proportionality factor is a ratio of the experimentally measured nuclear parameters of the (radio)nuclides and those parameters of the respective (radio)isotopes of a calibrator (often based on Au)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08716 goldbook:08717)
AnnotationAssertion(rdfs:seeAlso goldbook:08716 goldbook:08739)
AnnotationAssertion(mito:isMentionedBy goldbook:08716 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08716 "current"^^xsd:string)
Declaration(Class(goldbook:08717))
AnnotationAssertion(rdfs:label goldbook:08717 "calibrator")
AnnotationAssertion(dcterms:description goldbook:08717 "Measured amount of an element with stated measurement uncertainty that is simultaneously irradiated with the sample during activation analysis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08717 "comparator (obsolete)")
AnnotationAssertion(rdfs:comment goldbook:08717 "The term 'calibrator' is preferred over 'comparator'."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08717 "If one calibrator is used (single calibrator method, which is preferred over 'single comparator method'), it is essentially identical to a flux monitor (except that the latter is not necessarily linked to activation analysis)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08717 goldbook:08726)
AnnotationAssertion(mito:isMentionedBy goldbook:08717 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08717 "current"^^xsd:string)
Declaration(Class(goldbook:08718))
AnnotationAssertion(rdfs:label goldbook:08718 "channeling effect")
AnnotationAssertion(dcterms:description goldbook:08718 "Range- (traveling distance) increasing effect caused by the decrease in interaction cross sections of the incident particles with atoms in a single crystal when a highly collimated particle beam impinges on a crystal along its principal axis or principal plane.")
AnnotationAssertion(mito:isMentionedBy goldbook:08718 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08718 "current"^^xsd:string)
Declaration(Class(goldbook:08719))
AnnotationAssertion(rdfs:label goldbook:08719 "channels ratio method")
AnnotationAssertion(dcterms:description goldbook:08719 "Measurement method to obtain a quenching correction by counting the spectrum in two separate channels, the ratio of which gives the degree of quenching.")
AnnotationAssertion(mito:isMentionedBy goldbook:08719 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08719 "current"^^xsd:string)
Declaration(Class(goldbook:08720))
AnnotationAssertion(rdfs:label goldbook:08720 "Compton scattering analysis")
AnnotationAssertion(dcterms:description goldbook:08720 "Measurement principle in which wavelengths and angular distribution of Compton scattered electrons is applied in order to reconstruct X-ray and gamma-ray spectra.")
AnnotationAssertion(rdfs:comment goldbook:08720 "Compton scattering analysis is applied, for example, in mammography."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08720 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08720 "current"^^xsd:string)
Declaration(Class(goldbook:08721))
AnnotationAssertion(rdfs:label goldbook:08721 "cross reactivity")
AnnotationAssertion(dcterms:description goldbook:08721 "Ability of substances other than the analyte to bind to the binding reagent and ability of substances other than the binding reagent to bind the analyte in competitive binding assays.")
AnnotationAssertion(rdfs:comment goldbook:08721 "The binding described here is known as cross reaction."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08721 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08721 "current"^^xsd:string)
Declaration(Class(goldbook:08722))
AnnotationAssertion(rdfs:label goldbook:08722 "cross section")
AnnotationAssertion(dcterms:description goldbook:08722 "Characteristic area related to the probability of a specified interaction or reaction between an incident nuclear radiation and a target particle or system of particles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08722 "microscopic cross section")
AnnotationAssertion(rdfs:comment goldbook:08722 "Cross section is the reaction rate per target particle for a specified process divided by the flux density of the incident radiation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08722 "In general, the type of nuclear radiation (e.g. neutron, photon), the energy of the incident radiation (e.g. thermal, epithermal, fast (see: neutron energy)) and the type of interaction of reaction (e.g. activation, fission, scattering) are specified."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08722 goldbook:08742)
AnnotationAssertion(mito:isMentionedBy goldbook:08722 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08722 "current"^^xsd:string)
Declaration(Class(goldbook:08723))
AnnotationAssertion(rdfs:label goldbook:08723 "delayed-neutron activation analysis")
AnnotationAssertion(dcterms:description goldbook:08723 "Neutron activation analysis where neutrons are counted after a delay to allow interfering species to decay.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08723 "DNAA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08723 "delayed-neutron analysis (DNA)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08723 "delayed-neutron counting (DNC)")
AnnotationAssertion(rdfs:seeAlso goldbook:08723 goldbook:08739)
AnnotationAssertion(mito:isMentionedBy goldbook:08723 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08723 "current"^^xsd:string)
Declaration(Class(goldbook:08724))
AnnotationAssertion(rdfs:label goldbook:08724 "directly-ionizing radiation")
AnnotationAssertion(dcterms:description goldbook:08724 "Beam of particles capable of removing one or more orbital electrons in a single quantum event from a specified atom resulting in an ion.")
AnnotationAssertion(rdfs:comment goldbook:08724 "To have sufficient energy for direct ionization, most ionizing particles are electrically charged, for example, alpha particles, beta particles, electrons, positrons, protons. Photons can ionize atoms directly through the photoelectric effect or the Compton effect."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08724 "When considering the health effects of radiation, the distinction may be made between multiple ionizations by charged particles as they move through a material (called 'direct ionization') and a single event of ionization caused by a photon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08724 goldbook:08730)
AnnotationAssertion(mito:isMentionedBy goldbook:08724 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08724 "current"^^xsd:string)
Declaration(Class(goldbook:08725))
AnnotationAssertion(rdfs:label goldbook:08725 "external standardization for quenching correction")
AnnotationAssertion(dcterms:description goldbook:08725 "Measurement method to obtain a quenching correction through the use of a gamma-radiation source to generate a spectrum of Compton electrons within the sample vial.")
AnnotationAssertion(rdfs:seeAlso goldbook:08725 goldbook:08720)
AnnotationAssertion(mito:isMentionedBy goldbook:08725 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08725 "current"^^xsd:string)
Declaration(Class(goldbook:08726))
AnnotationAssertion(rdfs:label goldbook:08726 "flux monitor")
AnnotationAssertion(dcterms:description goldbook:08726 "Radiation detector to measure energy flux density.")
AnnotationAssertion(rdfs:comment goldbook:08726 "A flux monitor may be a known amount of material irradiated together with a sample; the induced radioactivity is used to measure the flux density during the irradiation."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08726 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08726 "current"^^xsd:string)
Declaration(Class(goldbook:08727))
AnnotationAssertion(rdfs:label goldbook:08727 "flux perturbation")
AnnotationAssertion(dcterms:description goldbook:08727 "Change of energy flux density or energy distribution of particles or photons in an object as a result of effects such as flux depression and/or self-shielding.")
AnnotationAssertion(mito:isMentionedBy goldbook:08727 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08727 "current"^^xsd:string)
Declaration(Class(goldbook:08728))
AnnotationAssertion(rdfs:label goldbook:08728 "gamma-ray spectrometry")
AnnotationAssertion(dcterms:description goldbook:08728 "Measurement principle of the quantitative study of the energy spectra of gamma-ray sources.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08728 "gamma-ray spectroscopy (obsolete)")
AnnotationAssertion(mito:isMentionedBy goldbook:08728 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08728 "current"^^xsd:string)
Declaration(Class(goldbook:08729))
AnnotationAssertion(rdfs:label goldbook:08729 "half-value thickness")
AnnotationAssertion(dcterms:description goldbook:08729 "Thickness of a specified material that, when introduced into the path of a given beam of radiation, reduces the intensity of a specified radiation by one half.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08729 "half thickness")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08729 "half-value layer thickness")
AnnotationAssertion(mito:isMentionedBy goldbook:08729 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08729 "current"^^xsd:string)
Declaration(Class(goldbook:08730))
AnnotationAssertion(rdfs:label goldbook:08730 "indirectly-ionizing radiation")
AnnotationAssertion(dcterms:description goldbook:08730 "Beam of electrically neutral particles that cause ionization by interacting with atoms in a material, producing electrically-charged particles that subsequently cause direct ionization in the material.")
AnnotationAssertion(rdfs:seeAlso goldbook:08730 goldbook:08724)
AnnotationAssertion(mito:isMentionedBy goldbook:08730 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08730 "current"^^xsd:string)
Declaration(Class(goldbook:08731))
AnnotationAssertion(rdfs:label goldbook:08731 "<em>in-vivo</em> neutron activation analysis")
AnnotationAssertion(dcterms:description goldbook:08731 "Measurement method of neutron activation analysis in which a living organism is exposed to neutrons to measure the concentrations of elements in that living organism.")
AnnotationAssertion(rdfs:comment goldbook:08731 "The neutrons are typically provided by a neutron beam."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08731 "Often prompt gamma-ray analysis is used to measure half-value thickness, rather than the activity of neutrons produced."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08731 goldbook:08729)
AnnotationAssertion(rdfs:seeAlso goldbook:08731 goldbook:08739)
AnnotationAssertion(rdfs:seeAlso goldbook:08731 goldbook:08754)
AnnotationAssertion(mito:isMentionedBy goldbook:08731 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08731 "current"^^xsd:string)
Declaration(Class(goldbook:08732))
AnnotationAssertion(rdfs:label goldbook:08732 "ion beam analysis")
AnnotationAssertion(dcterms:description goldbook:08732 "Measurement principle in which elementary particles resulting from nuclear reactions of charged particles with nuclei in a material are applied in order to measure the amount and depth distribution of elements in materials.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08732 "IBA")
AnnotationAssertion(mito:isMentionedBy goldbook:08732 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08732 "current"^^xsd:string)
Declaration(Class(goldbook:08733))
AnnotationAssertion(rdfs:label goldbook:08733 "isotopic label")
AnnotationAssertion(dcterms:description goldbook:08733 "Radioactive or stable isotope of a specified element distinguishable by the observer but not by the system used to identify an isotopic tracer.")
AnnotationAssertion(rdfs:comment goldbook:08733 "'Isotopic labelling' is the incorporation of an isotopic label in a substance. It may be qualified by the manner of introduction of the label, e.g. exchange labelling, conjugation labelling, recoil labelling."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08733 "In general usage, 'label' and 'tracer' are used synonymously."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08733 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08733 "current"^^xsd:string)
Declaration(Class(goldbook:08735))
AnnotationAssertion(rdfs:label goldbook:08735 "monoisotopic element")
AnnotationAssertion(dcterms:description goldbook:08735 "Chemical element having only one stable nuclide.")
AnnotationAssertion(rdfs:comment goldbook:08735 "There are 26 elements that follow the definition: \\(\\ce{^{9}Be}\\), \\(\\ce{^{19}F}\\), \\(\\ce{^{23}Na}\\), \\(\\ce{^{27}Al}\\), \\(\\ce{^{31}P}\\), \\(\\ce{^{45}Sc}\\), \\(\\ce{^{51}V}\\), \\(\\ce{^{55}Mn}\\), \\(\\ce{^{59}Co}\\), \\(\\ce{^{75}As}\\), \\(\\ce{^{85}Rb}\\), \\(\\ce{^{89}Y}\\), \\(\\ce{^{93}Nb}\\), \\(\\ce{^{103}Rh}\\), \\(\\ce{^{113}In}\\), \\(\\ce{^{127}I}\\), \\(\\ce{^{133}Cs}\\), \\(\\ce{^{139}La}\\), \\(\\ce{^{141}Pr}\\), \\(\\ce{^{153}Eu}\\), \\(\\ce{^{159}Tb}\\), \\(\\ce{^{165}Ho}\\), \\(\\ce{^{169}Tm}\\), \\(\\ce{^{175}Lu}\\), \\(\\ce{^{185}Re}\\), \\(\\ce{^{197}Au}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08735 "General usage of the term 'monoisotopic' refers to the 21 elements with one isotope determining their relative atomic masses, i.e. \\(\\ce{^{9}Be}\\), \\(\\ce{^{19}F}\\), \\(\\ce{^{23}Na}\\), \\(\\ce{^{27}Al}\\), \\(\\ce{^{31}P}\\), \\(\\ce{^{45}Sc}\\), \\(\\ce{^{55}Mn}\\), \\(\\ce{^{59}Co}\\), \\(\\ce{^{75}As}\\), \\(\\ce{^{89}Y}\\), \\(\\ce{^{93}Nb}\\), \\(\\ce{^{103}Rh}\\), \\(\\ce{^{127}I}\\), \\(\\ce{^{133}Cs}\\), \\(\\ce{^{141}Pr}\\), \\(\\ce{^{159}Tb}\\), \\(\\ce{^{165}Ho}\\), \\(\\ce{^{169}Tm}\\), \\(\\ce{^{197}Au}\\), \\(\\ce{^{209}Bi}\\), \\(\\ce{^{231}Pa}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08735 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08735 "current"^^xsd:string)
Declaration(Class(goldbook:08736))
AnnotationAssertion(rdfs:label goldbook:08736 "Mössbauer spectrometry")
AnnotationAssertion(dcterms:description goldbook:08736 "Measurement method in which recoil-less resonance gamma ray scattering and absorption in solids is applied to measure the nuclear environment of atoms of elements in a material.")
AnnotationAssertion(mito:isMentionedBy goldbook:08736 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08736 "current"^^xsd:string)
Declaration(Class(goldbook:08737))
AnnotationAssertion(rdfs:label goldbook:08737 "muon induced X-ray emission analysis")
AnnotationAssertion(dcterms:description goldbook:08737 "Measurement method of X-ray analysis in which characteristic X-radiation emitted upon irradiation of a material with a beam of muons of certain energy is used to measure the chemical composition and chemical state of an element.")
AnnotationAssertion(rdfs:seeAlso goldbook:08737 goldbook:08769)
AnnotationAssertion(mito:isMentionedBy goldbook:08737 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08737 "current"^^xsd:string)
Declaration(Class(goldbook:08738))
AnnotationAssertion(rdfs:label goldbook:08738 "near edge X-ray absorption fine structure")
AnnotationAssertion(dcterms:description goldbook:08738 "Measurement method of X-ray absorption analysis similar to X-ray absorption near edge structure, but usually reserved for soft X-rays with photon energy less than \\(\\pu{1 keV}\\).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08738 "NEXAFS")
AnnotationAssertion(rdfs:comment goldbook:08738 "NEXAFS is generally used in surface and molecular science."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08738 goldbook:08766)
AnnotationAssertion(rdfs:seeAlso goldbook:08738 goldbook:08768)
AnnotationAssertion(mito:isMentionedBy goldbook:08738 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08738 "current"^^xsd:string)
Declaration(Class(goldbook:08739))
AnnotationAssertion(rdfs:label goldbook:08739 "neutron activation analysis")
AnnotationAssertion(dcterms:description goldbook:08739 "Activation analysis using neutrons as the incident particles.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08739 "NAA")
AnnotationAssertion(rdfs:seeAlso goldbook:08739 goldbook:08723)
AnnotationAssertion(rdfs:seeAlso goldbook:08739 goldbook:08731)
AnnotationAssertion(mito:isMentionedBy goldbook:08739 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08739 "current"^^xsd:string)
Declaration(Class(goldbook:08740))
AnnotationAssertion(rdfs:label goldbook:08740 "neutron depth profiling")
AnnotationAssertion(dcterms:description goldbook:08740 "Measurement method of activation analysis for near-surface-depth light elements in which a thermal neutron or cold neutron (see: neutron energy) beam passes through a material with target nuclei that emit monoenergetic charged particles upon neutron absorption. The reduction of the energy of an emitted charged particle measures the depth of the target nuclei in a material.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08740 "NDP")
AnnotationAssertion(rdfs:seeAlso goldbook:08740 goldbook:08742)
AnnotationAssertion(mito:isMentionedBy goldbook:08740 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08740 "current"^^xsd:string)
Declaration(Class(goldbook:08741))
AnnotationAssertion(rdfs:label goldbook:08741 "neutron diffraction analysis")
AnnotationAssertion(dcterms:description goldbook:08741 "Measurement method in which the diffraction of neutrons is applied to measure parameters of the atomic and/or magnetic structure of a material.")
AnnotationAssertion(mito:isMentionedBy goldbook:08741 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08741 "current"^^xsd:string)
Declaration(Class(goldbook:08742))
AnnotationAssertion(rdfs:label goldbook:08742 "neutron energy")
AnnotationAssertion(dcterms:description goldbook:08742 "Kinetic energy of a free neutron.")
AnnotationAssertion(rdfs:comment goldbook:08742 "Neutron energy is usually given with unit electronvolt (\\(\\pu{eV}\\)). \\(\\pu{1 eV} = \\pu{1.602176634E-19 J}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08742 "Neutron temperature has unit kelvin, and the term should not be used for the neutron energy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08742 "Neutrons are classified according to their energies as follows:"^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08742 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08742 "current"^^xsd:string)
Declaration(Class(goldbook:08743))
AnnotationAssertion(rdfs:label goldbook:08743 "neutron scattering analysis")
AnnotationAssertion(dcterms:description goldbook:08743 "Measurement method in which the elastic or inelastic scattering of neutrons by the target nuclei is applied to study the composition and structure of a material.")
AnnotationAssertion(mito:isMentionedBy goldbook:08743 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08743 "current"^^xsd:string)
Declaration(Class(goldbook:08744))
AnnotationAssertion(rdfs:label goldbook:08744 "non-radiative quenching")
AnnotationAssertion(dcterms:description goldbook:08744 "Deactivation of an electronically-excited state by interaction with the external environment through a non-radiative process.")
AnnotationAssertion(rdfs:comment goldbook:08744 "Non-radiative quenching may lead to spectral shift or counting losses."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08744 "The effects of quenching may be taken into account by a quenching correction."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08744 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08744 "current"^^xsd:string)
Declaration(Class(goldbook:08745))
AnnotationAssertion(rdfs:label goldbook:08745 "nuclear capture")
AnnotationAssertion(dcterms:description goldbook:08745 "Process in which an atomic nucleus acquires an additional particle.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08745 "capture")
AnnotationAssertion(rdfs:comment goldbook:08745 "The captured particle may be an elementary particle and may be charged or neutral."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08745 "In general, a specification is added of the type of the captured particle or its energy."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08745 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08745 "current"^^xsd:string)
Declaration(Class(goldbook:08746))
AnnotationAssertion(rdfs:label goldbook:08746 "nuclide precursor")
AnnotationAssertion(dcterms:description goldbook:08746 "Radionuclide which precedes a nuclide in a decay chain.")
AnnotationAssertion(mito:isMentionedBy goldbook:08746 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08746 "current"^^xsd:string)
Declaration(Class(goldbook:08747))
AnnotationAssertion(rdfs:label goldbook:08747 "particle flux density")
AnnotationAssertion(dcterms:description goldbook:08747 "Number of particles (or photons) incident on a plane perpendicular to the incident radiation per unit time per unit area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08747 "fluence rate (obsolete)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08747 "photon flux density")
AnnotationAssertion(rdfs:comment goldbook:08747 "Particle flux density is identical with the product of the particle density and the average speed of the particles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08747 "The SI unit of flux density is \\(\\pu{m-2 s-1}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08747 "Often an indication of the type of incident particles is wrongly added to the unit of flux density, e.g., the neutron flux density is sometimes indicated as n \\(\\pu{cm-2 s-1}\\). As 'n' is not a unit, it is metrologically unacceptable and therefore not recommended."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08747 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08747 "current"^^xsd:string)
Declaration(Class(goldbook:08748))
AnnotationAssertion(rdfs:label goldbook:08748 "particle-induced gamma-ray-emission analysis")
AnnotationAssertion(dcterms:description goldbook:08748 "Measurement principle in which the energies and intensities of characteristic prompt gamma-radiation emitted during nuclear reactions with charged particles other than electrons is used to measure the amounts of elements in a material.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08748 "PIGE")
AnnotationAssertion(rdfs:comment goldbook:08748 "The particle that induces gamma-rays may be explicitly mentioned, e.g. 'proton-induced gamma-ray-emission analysis'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08748 goldbook:08753)
AnnotationAssertion(mito:isMentionedBy goldbook:08748 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08748 "current"^^xsd:string)
Declaration(Class(goldbook:08749))
AnnotationAssertion(rdfs:label goldbook:08749 "perturbed angular correlation spectrometry")
AnnotationAssertion(dcterms:description goldbook:08749 "Measurement method of gamma-ray spectrometry in which coincidence counting is used for the measurement of parameters describing hyperfine interactions, with internal or external electrical or magnetic field gradients, of the spin of an intermediate level between two gamma-ray transitions in cascade emitted in the decay of a radionuclide.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08749 "PAC")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08749 "perturbed directional correlation spectrometry")
AnnotationAssertion(rdfs:comment goldbook:08749 "Perturbed angular correlation spectrometry can be performed both in a time-differential (TDPAC) and in a time-integrated (TIPAC) mode of measurement."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08749 "The parameters describing hyperfine interactions provide information on the chemical atomic environment of the decaying nucleus."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08749 goldbook:08728)
AnnotationAssertion(mito:isMentionedBy goldbook:08749 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08749 "current"^^xsd:string)
Declaration(Class(goldbook:08750))
AnnotationAssertion(rdfs:label goldbook:08750 "positron annihilation analysis")
AnnotationAssertion(dcterms:description goldbook:08750 "Measurement principle in which the annihilation of positrons is applied to study the microscopic structure of materials.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08750 "PAA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08750 "positron annihilation spectroscopy for chemical analysis (PASCA)")
AnnotationAssertion(rdfs:comment goldbook:08750 "Annihilation lifetime (see: positron lifetime spectrometry), Doppler broadening, and the angular correlation of annihilation radiation are measured in this technique."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08750 "In the most common case of positron annihilation, two photons are created, each with energy equal to the rest energy of the electron or positron (\\(\\pu{0.511 MeV} = \\pu{8.187122600E-14 J}\\))."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08750 "Techniques based on PAA have been used particularly for the study polymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08750 goldbook:08752)
AnnotationAssertion(mito:isMentionedBy goldbook:08750 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08750 "current"^^xsd:string)
Declaration(Class(goldbook:08751))
AnnotationAssertion(rdfs:label goldbook:08751 "positron emission tomography")
AnnotationAssertion(dcterms:description goldbook:08751 "Imaging method based on the detection of pairs of gamma rays emitted indirectly by a positron-emitting isotopic tracer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08751 "PET")
AnnotationAssertion(rdfs:comment goldbook:08751 "A commonly used nuclide is fluorine-18."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08751 "Three-dimensional imaging is obtained using computed tomography."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08751 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08751 "current"^^xsd:string)
Declaration(Class(goldbook:08752))
AnnotationAssertion(rdfs:label goldbook:08752 "positron lifetime spectrometry")
AnnotationAssertion(dcterms:description goldbook:08752 "Measurement method of positron annihilation analysis in which the time interval between the emission of positrons from a radioactive source and the detection of gamma rays due to the annihilation of these positrons with electrons from the surrounding matter is the lifetime of the positron or positronium.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08752 "PLS")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08752 "positron annihilation lifetime spectrometry (PALS)")
AnnotationAssertion(rdfs:seeAlso goldbook:08752 goldbook:08750)
AnnotationAssertion(mito:isMentionedBy goldbook:08752 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08752 "current"^^xsd:string)
Declaration(Class(goldbook:08753))
AnnotationAssertion(rdfs:label goldbook:08753 "prompt gamma radiation")
AnnotationAssertion(dcterms:description goldbook:08753 "Gamma radiation emitted during the de-excitation of a compound nucleus formed in a nuclear capture reaction.")
AnnotationAssertion(mito:isMentionedBy goldbook:08753 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08753 "current"^^xsd:string)
Declaration(Class(goldbook:08754))
AnnotationAssertion(rdfs:label goldbook:08754 "prompt gamma-ray analysis")
AnnotationAssertion(dcterms:description goldbook:08754 "Measurement principle in which gamma radiation emitted during the de-excitation of the compound nucleus formed by neutron capture is applied to measure the amounts of elements in a material.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08754 "PGA")
AnnotationAssertion(rdfs:comment goldbook:08754 "The measurement method is often denoted as prompt gamma-ray neutron activation analysis (PGNAA) or prompt gamma-ray activation analysis (PGAA), though the measurement method is not in agreement with the definition of activation analysis. The term prompt gamma-ray analysis (PGA) is therefore preferred."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08754 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08754 "current"^^xsd:string)
Declaration(Class(goldbook:08755))
AnnotationAssertion(rdfs:label goldbook:08755 "pulse pile-up")
AnnotationAssertion(dcterms:description goldbook:08755 "Processing by a radiation counter of pulses resulting from the simultaneous absorption of independent particles or photons in a radiation detector, resulting in them being counted as one single particle or photon with energy between the individual energies and the sum of these energies.")
AnnotationAssertion(mito:isMentionedBy goldbook:08755 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08755 "current"^^xsd:string)
Declaration(Class(goldbook:08757))
AnnotationAssertion(rdfs:label goldbook:08757 "radiation filter")
AnnotationAssertion(dcterms:description goldbook:08757 "Material interposed in the path of radiation to modify the energy distribution of the radiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:08757 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08757 "current"^^xsd:string)
Declaration(Class(goldbook:08758))
AnnotationAssertion(rdfs:label goldbook:08758 "radioactive steady state")
AnnotationAssertion(dcterms:description goldbook:08758 "Among the radionuclides of a decay chain, the state that prevails when the ratios between the activities of successive radionuclides remain constant.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08758 "radioactive equilibrium")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08758 "secular equilibrium")
AnnotationAssertion(rdfs:comment goldbook:08758 "This is not equilibrium in the strict sense, since radioactive decay is an irreversible process."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08758 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08758 "current"^^xsd:string)
Declaration(Class(goldbook:08759))
AnnotationAssertion(rdfs:label goldbook:08759 "recovery time")
AnnotationAssertion(dcterms:description goldbook:08759 "Period of time after the dead time of a radiation counter during which the output pulses are smaller than the original.")
AnnotationAssertion(rdfs:comment goldbook:08759 "Depending on the sensitivity of the counter, some pulses in this period will not be counted."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08759 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08759 "current"^^xsd:string)
Declaration(Class(goldbook:08760))
AnnotationAssertion(rdfs:label goldbook:08760 "relative counting efficiency")
AnnotationAssertion(dcterms:description goldbook:08760 "Absolute counting efficiency of a given radiation counter divided by the absolute counting efficiency of a reference radiation counter.")
AnnotationAssertion(rdfs:seeAlso goldbook:08760 goldbook:08711)
AnnotationAssertion(mito:isMentionedBy goldbook:08760 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08760 "current"^^xsd:string)
Declaration(Class(goldbook:08761))
AnnotationAssertion(rdfs:label goldbook:08761 "scanning proton microscopy")
AnnotationAssertion(dcterms:description goldbook:08761 "Measurement method of X-ray fluorescence analysis in which protons are focused and collimated to form a micro beam to obtain an image of a surface.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08761 "SPM")
AnnotationAssertion(mito:isMentionedBy goldbook:08761 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08761 "current"^^xsd:string)
Declaration(Class(goldbook:08762))
AnnotationAssertion(rdfs:label goldbook:08762 "selectively-labelled isotopic tracer")
AnnotationAssertion(dcterms:description goldbook:08762 "An isotopically labelled compound is designated as selectively labelled when a mixture of isotopically substituted compounds is formally added to the analogous isotopically unmodified compound in such a way that the position(s), but not necessarily the number, of each labelling nuclide is defined.")
AnnotationAssertion(rdfs:comment goldbook:08762 "A selectively labelled compound may be considered a mixture of specifically-labelled isotopic tracers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08762 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08762 "current"^^xsd:string)
Declaration(Class(goldbook:08763))
AnnotationAssertion(rdfs:label goldbook:08763 "specific activity (radionuclide)")
AnnotationAssertion(dcterms:description goldbook:08763 "Activity of a specified radionuclide (\\(\\ce{R}\\)) per unit mass of that nuclide.")
AnnotationAssertion(rdfs:comment goldbook:08763 "If the term 'specific activity' is used without qualification, it should be made clear whether it is of a material or of a radionuclide. See: specific activity of a radionuclide in a material."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08763 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08763 "current"^^xsd:string)
Declaration(Class(goldbook:08764))
AnnotationAssertion(rdfs:label goldbook:08764 "synchrotron radiation induced X-ray fluorescence analysis")
AnnotationAssertion(dcterms:description goldbook:08764 "Measurement method of X-ray fluorescence analysis in which synchrotron X-radiation is used to irradiate the substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:08764 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08764 "current"^^xsd:string)
Declaration(Class(goldbook:08765))
AnnotationAssertion(rdfs:label goldbook:08765 "total reflection X-ray fluorescence analysis")
AnnotationAssertion(dcterms:description goldbook:08765 "Measurement method of X-ray fluorescence analysis in which a collimated X-ray flux impinges on a smooth surface under a grazing angle; rendering total reflection is used to excite atoms in the top layers of the material for measurement of the amounts of elements.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08765 "TXRF")
AnnotationAssertion(rdfs:comment goldbook:08765 "The method is highly sensitive because interfering X-rays of higher energies are refracted or adsorbed. Mass fractions of \\(\\pu{E-12}\\:(\\pu{ng kg-1})\\) may be measured."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08765 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08765 "current"^^xsd:string)
Declaration(Class(goldbook:08766))
AnnotationAssertion(rdfs:label goldbook:08766 "X-ray absorption analysis")
AnnotationAssertion(dcterms:description goldbook:08766 "Measurement principle of X-ray analysis in which the absorption spectrum is used to measure the number of atoms, species, and other parameters of chemical elements.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08766 "XAA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08766 "X-ray absorption spectroscopy (XAS)")
AnnotationAssertion(rdfs:comment goldbook:08766 "XAS measures changes in the linear absorption coefficient of an element in a sample as a function of incident photon energy."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08766 "XAS requires a highly monochromatic (with \\(\\Delta E/E \\approx \\pu{E-4}\\) to \\(\\pu{E-5}\\)), high flux X-ray beam."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08766 goldbook:08768)
AnnotationAssertion(rdfs:seeAlso goldbook:08766 goldbook:08769)
AnnotationAssertion(mito:isMentionedBy goldbook:08766 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08766 "current"^^xsd:string)
Declaration(Class(goldbook:08767))
AnnotationAssertion(rdfs:label goldbook:08767 "X-ray absorption edge")
AnnotationAssertion(dcterms:description goldbook:08767 "Increase in X-ray absorption observed at the energy at which a strongly bound electron is released.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08767 "absorption edge")
AnnotationAssertion(mito:isMentionedBy goldbook:08767 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08767 "current"^^xsd:string)
Declaration(Class(goldbook:08768))
AnnotationAssertion(rdfs:label goldbook:08768 "X-ray absorption near edge structure")
AnnotationAssertion(dcterms:description goldbook:08768 "Measurement method of X-ray absorption analysis in which the fine structure of the adsorption spectrum in the range \\(\\pu{30 eV}\\) below to \\(\\pu{50 eV}\\) above the absorption edge is used to measure parameters describing the chemical state, coordination environment, and local geometry distortion for the X-ray absorbing atom.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08768 "XANES")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08768 "X-ray absorption near edge fine structure")
AnnotationAssertion(rdfs:comment goldbook:08768 "The method uses synchrotron radiation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08768 "The wavelength of the emitted photoelectrons is longer than the interatomic distances between the absorbing atom and its nearest neighbours."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08768 goldbook:08766)
AnnotationAssertion(rdfs:seeAlso goldbook:08768 goldbook:08738)
AnnotationAssertion(mito:isMentionedBy goldbook:08768 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08768 "current"^^xsd:string)
Declaration(Class(goldbook:08769))
AnnotationAssertion(rdfs:label goldbook:08769 "X-ray analysis")
AnnotationAssertion(dcterms:description goldbook:08769 "Measurement principle in which characteristic X-radiation, produced upon irradiation of a material with elementary particles or photons, is applied to measure amounts of elements in a material.")
AnnotationAssertion(mito:isMentionedBy goldbook:08769 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08769 "current"^^xsd:string)
Declaration(Class(goldbook:08770))
AnnotationAssertion(rdfs:label goldbook:08770 "X-ray computed micro-tomography")
AnnotationAssertion(dcterms:description goldbook:08770 "Measurement method based on the transmission of X-rays to obtain three-dimensional images of a sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08770 "XCMT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08770 "X-ray micro-tomography (XMT)")
AnnotationAssertion(rdfs:comment goldbook:08770 "Spatial resolution is in the range \\(\\pu{100 nm}\\) to \\(\\pu{10 \\upmu m}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08770 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08770 "current"^^xsd:string)
Declaration(Class(goldbook:08771))
AnnotationAssertion(rdfs:label goldbook:08771 "X-ray diffraction analysis")
AnnotationAssertion(dcterms:description goldbook:08771 "Measurement method using diffraction of X-radiation to obtain the spatial arrangement of atoms in a crystalline sample.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08771 "X-ray diffraction (XRD)")
AnnotationAssertion(rdfs:comment goldbook:08771 "Bragg reflection follows \\(n\\lambda = 2 d \\sin \\theta\\), where \\(\\lambda\\) is the X-ray wavelength, \\(d\\) is the spacing between atomic planes, and \\(\\theta\\) is the angle of diffraction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08771 "Copper \\(\\ce{K}\\upalpha_{1}\\) radiation (\\(\\lambda = \\pu{0.15406 nm}\\), \\(E = \\pu{8.04 keV}\\)) is typically used for routine XRD."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08771 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08771 "current"^^xsd:string)
Declaration(Class(goldbook:08772))
AnnotationAssertion(rdfs:label goldbook:08772 "X-ray fluorescence microscopy")
AnnotationAssertion(dcterms:description goldbook:08772 "Measurement method of X-ray fluorescence to obtain quantitative and spatial information about elements in a sample.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08772 "XRM")
AnnotationAssertion(rdfs:comment goldbook:08772 "X-ray beam energies of \\(\\pu{5 keV}\\) excite core level vacancies and promote hard X-ray emission, for which the fluorescence yield is high."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08772 "Spatial resolution is typically in the range from \\(\\pu{200 nm}\\) to \\(\\pu{10 \\upmu m}\\), but, using specialised probes at synchrotron facilities, the lower limit can be decreased to tens of nanometers."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08772 doi:10.1515/pac-2019-0302)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08772 "current"^^xsd:string)
Declaration(Class(goldbook:08773))
AnnotationAssertion(rdfs:label goldbook:08773 "actuator")
AnnotationAssertion(dcterms:description goldbook:08773 "Transducer that converts the energy supplied or taken from the surroundings into some mechanical motion.")
AnnotationAssertion(rdfs:comment goldbook:08773 "Human muscles, motors, loudspeakers and various piezoelectric devices are examples of actuators."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08773 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08773 "current"^^xsd:string)
Declaration(Class(goldbook:08774))
AnnotationAssertion(rdfs:label goldbook:08774 "antisoliton")
AnnotationAssertion(dcterms:description goldbook:08774 "Soliton with the negative amplitude or opposite spin with respect to a given soliton.")
AnnotationAssertion(mito:isMentionedBy goldbook:08774 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08774 "current"^^xsd:string)
Declaration(Class(goldbook:08775))
AnnotationAssertion(rdfs:label goldbook:08775 "charge carrier")
AnnotationAssertion(dcterms:description goldbook:08775 "Particle or quasiparticle capable of transporting an electric charge.")
AnnotationAssertion(rdfs:comment goldbook:08775 "A charge carrier can be free (mobile) or trapped (immobile)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08775 goldbook:08787)
AnnotationAssertion(rdfs:seeAlso goldbook:08775 goldbook:08826)
AnnotationAssertion(rdfs:seeAlso goldbook:08775 goldbook:08863)
AnnotationAssertion(mito:isMentionedBy goldbook:08775 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08775 "current"^^xsd:string)
Declaration(Class(goldbook:08776))
AnnotationAssertion(rdfs:label goldbook:08776 "charge carrier concentration")
AnnotationAssertion(dcterms:description goldbook:08776 "Number of charge carriers per unit volume.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08776 "concentration of charge carriers")
AnnotationAssertion(rdfs:comment goldbook:08776 "A use of the term 'charge carrier density' is depricated since it can easily be confused with the term charge density whose meaning is different, see charge density."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08776 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08776 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08776 "current"^^xsd:string)
Declaration(Class(goldbook:08777))
AnnotationAssertion(rdfs:label goldbook:08777 "charge carrier diffusion")
AnnotationAssertion(dcterms:description goldbook:08777 "Purely random, thermally induced motion of charge carriers.")
AnnotationAssertion(rdfs:comment goldbook:08777 "According to the type of charge carriers undergoing diffusion, it is subdivided into electron diffusion, hole diffusion, polaron diffusion, soliton diffusion, etc."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08777 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08777 goldbook:08797)
AnnotationAssertion(rdfs:seeAlso goldbook:08777 goldbook:08826)
AnnotationAssertion(mito:isMentionedBy goldbook:08777 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08777 "current"^^xsd:string)
Declaration(Class(goldbook:08778))
AnnotationAssertion(rdfs:label goldbook:08778 "charge carrier generation")
AnnotationAssertion(dcterms:description goldbook:08778 "Process whereby charge carriers are created.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08778 "charge generation")
AnnotationAssertion(rdfs:comment goldbook:08778 "The charge carrier generation in the low-permittivity organic semiconductors usually proceeds in two steps: (i) formation of an exciton, and (ii) the exciton dissociation to mobile charge carriers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08778 "The energy needed for the charge carrier generation can be gained from photon absorption (photogeneration), from thermal motion of lattice atoms (thermal generation), from an electric field discharge or from another charge carrier with sufficiently high kinetic energy (impact ionization)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08778 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08778 goldbook:08815)
AnnotationAssertion(rdfs:seeAlso goldbook:08778 goldbook:08831)
AnnotationAssertion(rdfs:seeAlso goldbook:08778 goldbook:08835)
AnnotationAssertion(mito:isMentionedBy goldbook:08778 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08778 "current"^^xsd:string)
Declaration(Class(goldbook:08779))
AnnotationAssertion(rdfs:label goldbook:08779 "charge carrier injection")
AnnotationAssertion(dcterms:description goldbook:08779 "Process whereby charge carriers in excess of the thermodynamic equilibrium level are introduced into a conductor, a semiconductor or an insulator from another material.")
AnnotationAssertion(rdfs:seeAlso goldbook:08779 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08779 goldbook:08774)
AnnotationAssertion(rdfs:seeAlso goldbook:08779 goldbook:08792)
AnnotationAssertion(rdfs:seeAlso goldbook:08779 goldbook:08801)
AnnotationAssertion(rdfs:seeAlso goldbook:08779 goldbook:08853)
AnnotationAssertion(rdfs:seeAlso goldbook:08779 goldbook:08877)
AnnotationAssertion(mito:isMentionedBy goldbook:08779 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08779 "current"^^xsd:string)
Declaration(Class(goldbook:08780))
AnnotationAssertion(rdfs:label goldbook:08780 "charge carrier mobility")
AnnotationAssertion(dcterms:description goldbook:08780 "Drift velocity (\\(v_{\\rm{d}}\\)) of charge carriers divided by the electric field strength (\\(E\\)). \\[\\mu = v_{\\rm{d}}/E \\quad (\\rm{unit}{:}\\ \\pu{m2 V-1 s-1})\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08780 "charge mobility")
AnnotationAssertion(rdfs:seeAlso goldbook:08780 goldbook:08794)
AnnotationAssertion(rdfs:seeAlso goldbook:08780 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08780 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08780 "current"^^xsd:string)
Declaration(Class(goldbook:08781))
AnnotationAssertion(rdfs:label goldbook:08781 "charge carrier recombination")
AnnotationAssertion(dcterms:description goldbook:08781 "Process whereby an electron in the conduction band (in LUMO level) loses its excess energy and re-occupies the energy state of a hole in the valence band (in HOMO level).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08781 "charge recombination")
AnnotationAssertion(rdfs:comment goldbook:08781 "In a thermally equilibrated material, generation and recombination of charge carriers are balanced yielding an equilibrium charge carrier concentration that is predictable from Fermi-Dirac statistics."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08781 "Based on the mechanism of the charge carrier recombination we distinguish: Auger recombination, geminate recombination, radiative charge carrier recombination, stimulated radiative charge carrier recombination, band-to-band recombination and localized-level-assisted (trap-assisted) recombination that dominate in organic semiconductors. See also doping."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08781 goldbook:08776)
AnnotationAssertion(rdfs:seeAlso goldbook:08781 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08781 goldbook:08864)
AnnotationAssertion(rdfs:seeAlso goldbook:08781 goldbook:08876)
AnnotationAssertion(mito:isMentionedBy goldbook:08781 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08781 "current"^^xsd:string)
Declaration(Class(goldbook:08782))
AnnotationAssertion(rdfs:label goldbook:08782 "charge transfer")
AnnotationAssertion(dcterms:description goldbook:08782 "Transfer of charge carriers between two sites of the same molecular entity (intramolecular CT) or between two molecular entities occurring in close proximity (intermolecular CT).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08782 "CT")
AnnotationAssertion(rdfs:comment goldbook:08782 "Electrons are implicitly considered as the charge carriers subject to a transfer. If other charge carriers (protons, quasiparticles) are considered, they should be explicitly mentioned."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08782 "The molecular entity or the entity region from which electron(s) is(are) released is an electron donor while the molecular entity or the entity region accepting electron(s) is an electron acceptor."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08782 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08782 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08782 "current"^^xsd:string)
Declaration(Class(goldbook:08783))
AnnotationAssertion(rdfs:label goldbook:08783 "charge-transfer exciton")
AnnotationAssertion(dcterms:description goldbook:08783 "Exciton formed by a charge-transfer transition.")
AnnotationAssertion(mito:isMentionedBy goldbook:08783 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08783 "current"^^xsd:string)
Declaration(Class(goldbook:08784))
AnnotationAssertion(rdfs:label goldbook:08784 "conductor")
AnnotationAssertion(dcterms:description goldbook:08784 "Material having the ability to transmit energy or charge carriers or both.")
AnnotationAssertion(rdfs:comment goldbook:08784 "The nature of the conductor is specified by the entity transmitted, e.g., electric (electron, hole, ion), thermal (heat) and acoustic."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08784 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08784 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08784 "current"^^xsd:string)
Declaration(Class(goldbook:08785))
AnnotationAssertion(rdfs:label goldbook:08785 "conjugated polymer")
AnnotationAssertion(dcterms:description goldbook:08785 "A polymer composed of molecules whose backbone is a sequence of alternating single and multiple bonds:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen, alkyl, aryl or heteroaryl and Ar is arenediyl (formerly: arylene) or heteroarenediyl (formerly: heteroarylene).")
AnnotationAssertion(rdfs:comment goldbook:08785 "Overlaps of neighboring \\(\\ce{\\uppi\\mbox{-}orbitals}\\) across intervening \\(\\ce{\\upsigma\\mbox{-}bonds}\\) in a conjugated molecule results in delocalization of π-electrons along the molecule backbone. This effect which, however, is limited by Peierls distortion gives the electric conductivity to conjugated polymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08785 "Conjugated polymers are mostly linear or branched polymers. However, they can also have a dendritic, hyperbranched, network, rotaxane or metallo-supramolecular chain architecture."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08785 "Polymers such as polysilanes, polygermanes and polystannanes with significantly occupied LUMO orbitals due to low bandgap energy and thus show the delocalization of electrons sometimes called \\(\\ce{\\uppi\\mbox{-}conjugated polymers}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08785 goldbook:08789)
AnnotationAssertion(rdfs:seeAlso goldbook:08785 goldbook:08899)
AnnotationAssertion(mito:isMentionedBy goldbook:08785 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08785 "current"^^xsd:string)
Declaration(Class(goldbook:08786))
AnnotationAssertion(rdfs:label goldbook:08786 "π-conjugated system")
AnnotationAssertion(dcterms:description goldbook:08786 "Molecule or a part of a molecule, of which structure may be represented as a system of alternating single and multiple bonds, in which, eventually, a multiple bond can be replaced by an atom with a pair of non-bonding electrons or an atom carrying a negative charge.")
AnnotationAssertion(rdfs:comment goldbook:08786 "Examples of conjugated systems are conjugated polymers and molecule species whose formulas drawn in terms of the valence bond theory are as follows: "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08786 "Alternating arrangement of the single and multiple bonds allows the delocalization of electrons, which stabilizes conjugated systems. The most effective stabilization show planary cyclic systems with \\(2n + 2\\) delocalized electrons (where \\(n\\) is integer), so-called aromatic systems. The last two examples above are the species where the pair non-bonding electrons (thiophene) or electrons of negatively charged atom are delocalized together with \\(\\ce{\\uppi\\mbox{-}electrons}\\) giving an aromatic system."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08786 "Due to the delocalization of electrons a formula drawn in terms of the valence bond theory does not fully describe the structure of a conjugated species, which actually is a combination of two or more limiting or intermediate resonance structures that are in a dynamic equilibrium. The molecular orbital theory which directly provides extended molecular orbitals spread over all contributing atoms allows better understanding of the electronic and optical properties of a conjugated system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08786 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08786 goldbook:08789)
AnnotationAssertion(rdfs:seeAlso goldbook:08786 goldbook:08841)
AnnotationAssertion(rdfs:seeAlso goldbook:08786 goldbook:08878)
AnnotationAssertion(mito:isMentionedBy goldbook:08786 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08786 "current"^^xsd:string)
Declaration(Class(goldbook:08787))
AnnotationAssertion(rdfs:label goldbook:08787 "coulomb radius")
AnnotationAssertion(dcterms:description goldbook:08787 "Distance between two oppositely charged charge carriers at which the energy of their Coulombic attraction is equal to \\(kT\\), where \\(k\\) is the Boltzmann constant and \\(T\\) the absolute temperature.")
AnnotationAssertion(rdfs:seeAlso goldbook:08787 goldbook:08781)
AnnotationAssertion(rdfs:seeAlso goldbook:08787 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08787 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08787 "current"^^xsd:string)
Declaration(Class(goldbook:08788))
AnnotationAssertion(rdfs:label goldbook:08788 "dark electric conductivity")
AnnotationAssertion(dcterms:description goldbook:08788 "Electric conductivity of a material in the dark where the free charge-carrier photogeneration is excluded.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08788 "dark conductivity")
AnnotationAssertion(rdfs:comment goldbook:08788 "The dark electric conductivity of a material in thermal equilibrium is proportional to the product of the concentration of free charge carriers and the charge carrier mobility."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08788 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08788 goldbook:08823)
AnnotationAssertion(mito:isMentionedBy goldbook:08788 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08788 "current"^^xsd:string)
Declaration(Class(goldbook:08789))
AnnotationAssertion(rdfs:label goldbook:08789 "delocalization of electrons")
AnnotationAssertion(dcterms:description goldbook:08789 "Redistribution of electron density in a molecular entity as compared with a model assuming individual atoms in the same valence states connected by localized bonds.")
AnnotationAssertion(rdfs:comment goldbook:08789 "Topological modes of the electron delocalization include: ribbon (one-dimensional) delocalization of \\(\\ce{\\uppi\\mbox{-}}\\) or \\(\\ce{\\upsigma\\mbox{-}electrons}\\) or both, which is typical of linear conjugated polymers that are therefore termed one-dimensional conductors;surface delocalization of \\(\\ce{\\uppi\\mbox{-}}\\) or \\(\\ce{\\upsigma\\mbox{-}electrons}\\) or both through an overlap of radially oriented orbitals of a cyclic molecule such as a molecule of cyclopropane or benzene;volume delocalization of \\(\\ce{\\upsigma\\mbox{-}electrons}\\) through an overlap of \\(\\ce{\\upsigma\\mbox{-}orbitals}\\) directed inside a molecular polyhedron, e.g., in tetrahedrane or carboranes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08789 "A delocalized electron is not associated with a particular atom or particular covalent bond but occupies an extended orbital spread over several to many atoms or the whole lattice."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08789 "Extensive delocalization of electrons is typical of metals, semiconductors, graphite, conjugated polymers, polysilanes, boranes, conjugated compounds such as organic dyes and others."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08789 goldbook:08774)
AnnotationAssertion(rdfs:seeAlso goldbook:08789 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08789 goldbook:08818)
AnnotationAssertion(rdfs:seeAlso goldbook:08789 goldbook:08835)
AnnotationAssertion(rdfs:seeAlso goldbook:08789 goldbook:08841)
AnnotationAssertion(rdfs:seeAlso goldbook:08789 goldbook:08899)
AnnotationAssertion(mito:isMentionedBy goldbook:08789 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08789 "current"^^xsd:string)
Declaration(Class(goldbook:08790))
AnnotationAssertion(rdfs:label goldbook:08790 "dielectric material")
AnnotationAssertion(dcterms:description goldbook:08790 "Material which polarizes when exposed to an external electric field, because it creates its own internal electric field oriented against the external field.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08790 "dielectric")
AnnotationAssertion(rdfs:comment goldbook:08790 "Dielectrics are divided into polar and nonpolar. The polar ones contain dipolar groups and their poling (polarization process) consists in the orientation of these dipoles by an external electric field. It is the so-called orientation polarization, which can but may not be complete due to competitive thermal motion. Poling of some polar dielectrics such as fluoropolymers gives materials with a stabilized polarized structure known as electrets. Poling of a non-polar dielectric is always temporary since it consists in displacements of electrons (electronic polarization) or ions in crystals (ionic polarization) giving induced dipoles that decay immediately after the removal of the field."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08790 "Dielectrics are key materials for the construction of capacitors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08790 goldbook:08857)
AnnotationAssertion(rdfs:seeAlso goldbook:08790 goldbook:08795)
AnnotationAssertion(rdfs:seeAlso goldbook:08790 goldbook:08810)
AnnotationAssertion(rdfs:seeAlso goldbook:08790 goldbook:08856)
AnnotationAssertion(mito:isMentionedBy goldbook:08790 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08790 "current"^^xsd:string)
Declaration(Class(goldbook:08791))
AnnotationAssertion(rdfs:label goldbook:08791 "dispersive transport")
AnnotationAssertion(dcterms:description goldbook:08791 "Irregular charge transport in which charge carriers move with an ill-defined mean velocity owing to the high variety of dwell times spent at different transport sites.")
AnnotationAssertion(rdfs:seeAlso goldbook:08791 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08791 goldbook:08829)
AnnotationAssertion(mito:isMentionedBy goldbook:08791 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08791 "current"^^xsd:string)
Declaration(Class(goldbook:08792))
AnnotationAssertion(rdfs:label goldbook:08792 "double injection")
AnnotationAssertion(dcterms:description goldbook:08792 "Simultaneous injection of both types of charge carriers (electrons and holes) into a material or a device.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08792 "double charge carrier injection")
AnnotationAssertion(rdfs:comment goldbook:08792 "Double injection is used in production of electrets and function of light-emitting diodes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08792 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08792 goldbook:08795)
AnnotationAssertion(rdfs:seeAlso goldbook:08792 goldbook:08826)
AnnotationAssertion(rdfs:seeAlso goldbook:08792 goldbook:08836)
AnnotationAssertion(mito:isMentionedBy goldbook:08792 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08792 "current"^^xsd:string)
Declaration(Class(goldbook:08793))
AnnotationAssertion(rdfs:label goldbook:08793 "drift current")
AnnotationAssertion(dcterms:description goldbook:08793 "Electric current caused by electric drift.")
AnnotationAssertion(rdfs:seeAlso goldbook:08793 goldbook:08777)
AnnotationAssertion(rdfs:seeAlso goldbook:08793 goldbook:08797)
AnnotationAssertion(mito:isMentionedBy goldbook:08793 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08793 "current"^^xsd:string)
Declaration(Class(goldbook:08794))
AnnotationAssertion(rdfs:label goldbook:08794 "drift velocity")
AnnotationAssertion(dcterms:description goldbook:08794 "Average velocity that a charge carrier attains due to an applied electric field.")
AnnotationAssertion(rdfs:comment goldbook:08794 "If an electric field is absent, charge carriers move randomly. An applied electric field induces drift (net movement) of charge carriers in a preferred direction. Average net velocity of this movement is called the drift velocity \\(v_{\\rm{d}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08794 "The drift velocity of a charge carrier is directly proportional to the applied electric field strength \\(E\\):  \\[v_{\\rm{d}} = \\mu E\\]  where constant \\(\\mu\\) is the charge carrier mobility in the given material."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08794 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08794 goldbook:08780)
AnnotationAssertion(mito:isMentionedBy goldbook:08794 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08794 "current"^^xsd:string)
Declaration(Class(goldbook:08795))
AnnotationAssertion(rdfs:label goldbook:08795 "electret")
AnnotationAssertion(dcterms:description goldbook:08795 "Dielectric material with a permanent or quasi-permanent electric dipole.")
AnnotationAssertion(rdfs:comment goldbook:08795 "A real-charge electret is obtained by the charge carrier injection onto the surface or into a parent dielectric material. It may contain either positive or negative excess charges or both, which must be trapped so that a good insulating parent dielectric material such as a fluoropolymer must be used."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08795 "An oriented-dipole electret is obtained by poling a parent dielectric material with dipolar groups at a temperature above the glass transition temperature \\(T_{\\rm{g}}\\), and eventual next stabilization of the structure by cooling the electret down below \\(T_{\\rm{g}}\\) or by crosslinking."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08795 "Electrets are electric equivalents of magnets; electric magnets. Some oriented-dipole electrets are ferroelectric polymers and piezoelectric polymers. Quartz is an example of the natural electret."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08795 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08795 goldbook:08790)
AnnotationAssertion(rdfs:seeAlso goldbook:08795 goldbook:08857)
AnnotationAssertion(mito:isMentionedBy goldbook:08795 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08795 "current"^^xsd:string)
Declaration(Class(goldbook:08796))
AnnotationAssertion(rdfs:label goldbook:08796 "electric conductor")
AnnotationAssertion(dcterms:description goldbook:08796 "Material that is able to transmit electric current.")
AnnotationAssertion(mito:isMentionedBy goldbook:08796 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08796 "current"^^xsd:string)
Declaration(Class(goldbook:08797))
AnnotationAssertion(rdfs:label goldbook:08797 "electric drift")
AnnotationAssertion(dcterms:description goldbook:08797 "Oriented flow of otherwise randomly moving charge carriers induced by an applied external electric field.")
AnnotationAssertion(rdfs:seeAlso goldbook:08797 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08797 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08797 "current"^^xsd:string)
Declaration(Class(goldbook:08798))
AnnotationAssertion(rdfs:label goldbook:08798 "electrically conducting polymer composite")
AnnotationAssertion(dcterms:description goldbook:08798 "Composite composed of a non-conducting polymer matrix in which irregular powdered or fibrous particles of an electrically conducting material are evenly dispersed in an amount exceeding the percolation threshold for electric conductivity and so the composite exhibits electric conductivity close to that of the conducting filler.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08798 "conducting polymer composite")
AnnotationAssertion(rdfs:comment goldbook:08798 "Conventional rubbery polymers are mostly used as the insulating matrix and powdered metals or carbon black as the dispersed phase in commercialized conducting polymer composites."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08798 "Conducting polymer composites are extrinsically conducting polymeric materials since the matrix does not act as an electric conductor but only as a container for the active electric conductor."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08798 goldbook:08796)
AnnotationAssertion(rdfs:seeAlso goldbook:08798 goldbook:08848)
AnnotationAssertion(mito:isMentionedBy goldbook:08798 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08798 "current"^^xsd:string)
Declaration(Class(goldbook:08799))
AnnotationAssertion(rdfs:label goldbook:08799 "electrochromic polymer")
AnnotationAssertion(dcterms:description goldbook:08799 "Polymer that exhibits electrochromism.")
AnnotationAssertion(mito:isMentionedBy goldbook:08799 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08799 "current"^^xsd:string)
Declaration(Class(goldbook:08800))
AnnotationAssertion(rdfs:label goldbook:08800 "electrofluorescence")
AnnotationAssertion(dcterms:description goldbook:08800 "Electroluminescence originated from singlet-state excitons.")
AnnotationAssertion(mito:isMentionedBy goldbook:08800 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08800 "current"^^xsd:string)
Declaration(Class(goldbook:08801))
AnnotationAssertion(rdfs:label goldbook:08801 "electroinjection")
AnnotationAssertion(dcterms:description goldbook:08801 "Process of charge carrier injection induced by an applied external electric field.")
AnnotationAssertion(rdfs:seeAlso goldbook:08801 goldbook:08779)
AnnotationAssertion(mito:isMentionedBy goldbook:08801 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08801 "current"^^xsd:string)
Declaration(Class(goldbook:08802))
AnnotationAssertion(rdfs:label goldbook:08802 "electromagnetic field")
AnnotationAssertion(dcterms:description goldbook:08802 "Physical field composed of two interconnected, mutually orthogonal fields, an electric field and a magnetic field, which mediates interactions of charged, dipolar and multipolar objects.")
AnnotationAssertion(rdfs:comment goldbook:08802 "The electromagnetic field produced by one charged or polar object affects other charged or polar objects, which is the essence of electromagnetic interaction - one of the four basic forces in nature."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08802 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08802 "current"^^xsd:string)
Declaration(Class(goldbook:08803))
AnnotationAssertion(rdfs:label goldbook:08803 "electromagnetic field responsive polymer")
AnnotationAssertion(dcterms:description goldbook:08803 "Polymer showing a noticeable response of its physical or chemical properties during or upon exposure to an electromagnetic field or one of its components: electric field and magnetic field.")
AnnotationAssertion(rdfs:seeAlso goldbook:08803 goldbook:08802)
AnnotationAssertion(mito:isMentionedBy goldbook:08803 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08803 "current"^^xsd:string)
Declaration(Class(goldbook:08804))
AnnotationAssertion(rdfs:label goldbook:08804 "electron-deficient molecule")
AnnotationAssertion(dcterms:description goldbook:08804 "Molecule that has fewer valence electrons than required for forming normal two-center two-electron chemical bonds and thus contains multicenter chemical bonds.")
AnnotationAssertion(rdfs:comment goldbook:08804 "Binding of atoms into molecules, clusters and macroscopic bodies in electron-deficient compounds is mediated by delocalized electrons, each being shared by three or more atoms."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08804 "Metals are typical electron-deficient compounds in which extreme delocalization of electrons across the whole macroscopic body exists."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08804 "Boron, boranes, carboranes and related compounds are typical compounds with electron-deficient molecules in which boron and some other atoms are bound by multicenter two-electron bonds, such as by the two-electron three-center bond in which two electrons bind three atoms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08804 goldbook:08789)
AnnotationAssertion(rdfs:seeAlso goldbook:08804 goldbook:08805)
AnnotationAssertion(rdfs:seeAlso goldbook:08804 goldbook:08818)
AnnotationAssertion(mito:isMentionedBy goldbook:08804 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08804 "current"^^xsd:string)
Declaration(Class(goldbook:08805))
AnnotationAssertion(rdfs:label goldbook:08805 "electron-rich molecule")
AnnotationAssertion(dcterms:description goldbook:08805 "Molecule that has more valence electrons than is needed to link its atoms by single covalent bonds.")
AnnotationAssertion(rdfs:comment goldbook:08805 "Molecules of unsaturated hydrocarbons or aromatic and heteroaromatic compounds are typical electron-rich molecules. Such compounds can be called electron-rich compounds."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08805 "Formally excess electrons present in a molecule containing conjugated multiple bonds are delocalized electrons. Non-bonding valence electrons present in molecules with heteroatoms, such non-bonding electrons of nitrogen, phosphorus and sulfur atoms, are also taken into account."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08805 goldbook:08789)
AnnotationAssertion(mito:isMentionedBy goldbook:08805 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08805 "current"^^xsd:string)
Declaration(Class(goldbook:08806))
AnnotationAssertion(rdfs:label goldbook:08806 "electron tunneling")
AnnotationAssertion(dcterms:description goldbook:08806 "Quantum mechanical effect of passing an electron through a potential energy barrier separating two energy equivalent regions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08806 "electron quantum tunneling")
AnnotationAssertion(rdfs:comment goldbook:08806 "The electron tunneling effect is exploited, e.g., in scanning tunneling microscopes, pressure sensors based on quantum tunneling polymer composites and in touchable panels of electronic devices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08806 goldbook:08862)
AnnotationAssertion(mito:isMentionedBy goldbook:08806 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08806 "current"^^xsd:string)
Declaration(Class(goldbook:08807))
AnnotationAssertion(rdfs:label goldbook:08807 "electro-optic effect")
AnnotationAssertion(dcterms:description goldbook:08807 "Change in the optical properties of a material in response to a change in an external electric field strength.")
AnnotationAssertion(rdfs:comment goldbook:08807 "Changes in the absorption coefficient, color, refractive index, permittivity or optical activity of a material are typical examples of electro-optic effects."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08807 "Electro-optic is not a synonym for optoelectronic."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08807 goldbook:08846)
AnnotationAssertion(mito:isMentionedBy goldbook:08807 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08807 "current"^^xsd:string)
Declaration(Class(goldbook:08808))
AnnotationAssertion(rdfs:label goldbook:08808 "electrophosphorescence")
AnnotationAssertion(dcterms:description goldbook:08808 "Electroluminescence originated from triplet-state excitons.")
AnnotationAssertion(mito:isMentionedBy goldbook:08808 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08808 "current"^^xsd:string)
Declaration(Class(goldbook:08809))
AnnotationAssertion(rdfs:label goldbook:08809 "electrorheological effect")
AnnotationAssertion(dcterms:description goldbook:08809 "Reversible change in the apparent viscosity of a liquid system such as suspension of polar or good polarizable microparticles in an oil, upon exposure of an electric field.")
AnnotationAssertion(rdfs:comment goldbook:08809 "Interaction of electric dipoles induced on suspended particles produces strands of particles spanning between electrodes, which results in a giant increase in the viscosity of the suspension (up to five orders of magnitude) during its exposure to an electric field."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08809 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08809 "current"^^xsd:string)
Declaration(Class(goldbook:08810))
AnnotationAssertion(rdfs:label goldbook:08810 "energy band")
AnnotationAssertion(dcterms:description goldbook:08810 "Quasi-continuous range of discrete energy levels that an electron is either allowed (an occupied band) or forbidden (forbidden band or band gap) to occupy in a molecule or solid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08810 "electronic band")
AnnotationAssertion(rdfs:seeAlso goldbook:08810 goldbook:08811)
AnnotationAssertion(rdfs:seeAlso goldbook:08810 goldbook:08812)
AnnotationAssertion(mito:isMentionedBy goldbook:08810 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08810 "current"^^xsd:string)
Declaration(Class(goldbook:08811))
AnnotationAssertion(rdfs:label goldbook:08811 "energy band theory")
AnnotationAssertion(dcterms:description goldbook:08811 "Theory describing the electronic structure of a solid in terms of energy intervals, called energy bands that are allowed or forbidden for occupation by electrons.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08811 "electronic band theory")
AnnotationAssertion(rdfs:comment goldbook:08811 "The energy band theory stems from the solution of the Schrödinger equation for electron waves moving in a periodic crystal lattice where, due to the wave diffractions, only some directions of the wave propagation characterized by the wave vector (so-called \\(k\\mbox{-}\\rm{vector}\\)) are allowed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08811 "When several atoms form a molecule, their atomic orbitals are transformed into a set of discrete bonding and antibonding molecular orbitals (energy levels), the number of which is proportional to the number of involved atoms. The energy levels that an electron is allowed to occupy are separated by energy intervals without any energy levels that an electron can occupy. If many atoms are linked together to form a lattice, the number of energy levels that the electrons are allowed to occupy becomes exceedingly large. Among these energy levels, large subsets of energy levels exist in which energy differences between individual levels are so small that they may be regarded as a quasi-continuum (individual energy levels are of no importance). The subset of energy levels that can be occupied by electrons is named allowed energy bands. The allowed bands are separated by energy intervals that electrons cannot occupy, which are called forbidden bands or energy bandgaps."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08811 goldbook:08835)
AnnotationAssertion(mito:isMentionedBy goldbook:08811 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08811 "current"^^xsd:string)
Declaration(Class(goldbook:08812))
AnnotationAssertion(rdfs:label goldbook:08812 "energy gap")
AnnotationAssertion(dcterms:description goldbook:08812 "Energy interval in a lattice where no electronic state exists.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08812 "bandgap")
AnnotationAssertion(rdfs:seeAlso goldbook:08812 goldbook:08835)
AnnotationAssertion(mito:isMentionedBy goldbook:08812 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08812 "current"^^xsd:string)
Declaration(Class(goldbook:08813))
AnnotationAssertion(rdfs:label goldbook:08813 "exciton annihilation")
AnnotationAssertion(dcterms:description goldbook:08813 "Interaction of two excitons resulting in their decay and radiative emission of the stored excitation energy.")
AnnotationAssertion(mito:isMentionedBy goldbook:08813 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08813 "current"^^xsd:string)
Declaration(Class(goldbook:08814))
AnnotationAssertion(rdfs:label goldbook:08814 "exciton diffusion")
AnnotationAssertion(dcterms:description goldbook:08814 "Random movement of an exciton from one molecular entity to another or from one part of a molecular entity or a lattice to another part of the same kind.")
AnnotationAssertion(rdfs:seeAlso goldbook:08814 goldbook:08835)
AnnotationAssertion(mito:isMentionedBy goldbook:08814 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08814 "current"^^xsd:string)
Declaration(Class(goldbook:08815))
AnnotationAssertion(rdfs:label goldbook:08815 "exciton dissociation")
AnnotationAssertion(dcterms:description goldbook:08815 "Fission of an exciton into independent, Coulombically unbound mobile charge carriers: an electron and a hole, or a negative and a positive polaron.")
AnnotationAssertion(rdfs:seeAlso goldbook:08815 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08815 goldbook:08826)
AnnotationAssertion(mito:isMentionedBy goldbook:08815 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08815 "current"^^xsd:string)
Declaration(Class(goldbook:08816))
AnnotationAssertion(rdfs:label goldbook:08816 "exciton mean free path")
AnnotationAssertion(dcterms:description goldbook:08816 "Mean distance that an exciton travels from the site of its creation to the site where it radiatively or non-radiatively decays or dissociates into charge carriers.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08816 "exciton mean pathway")
AnnotationAssertion(rdfs:seeAlso goldbook:08816 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08816 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08816 "current"^^xsd:string)
Declaration(Class(goldbook:08817))
AnnotationAssertion(rdfs:label goldbook:08817 "exciton–phonon coupling")
AnnotationAssertion(dcterms:description goldbook:08817 "Interaction in which a part of the exciton energy is converted into the lattice vibrational energy and vice versa.")
AnnotationAssertion(rdfs:seeAlso goldbook:08817 goldbook:08835)
AnnotationAssertion(mito:isMentionedBy goldbook:08817 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08817 "current"^^xsd:string)
Declaration(Class(goldbook:08818))
AnnotationAssertion(rdfs:label goldbook:08818 "extent of electron delocalization")
AnnotationAssertion(dcterms:description goldbook:08818 "Magnitude of the region in a molecule over which a molecular orbital occupied with delocalized electrons is extended.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08818 "effective conjugation length")
AnnotationAssertion(rdfs:comment goldbook:08818 "In a small molecule, the extent of electron delocalization is usually quantified by the number of delocalized electrons included in the extended orbital or by the number of bonds or atoms or both over which the extended molecular orbital is spread."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08818 "In a larger molecule or macromolecule, delocalized electrons are mostly divided over several to many extended orbitals of various magnitudes separated by orbitals where electrons are practically localized. Therefore, the average number of delocalized electrons per one extended orbital, or the average number of bonds or atoms or both over which a mean extended orbital is spread, are used as a measure of the extent of the electron delocalization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08818 "The extent of electron delocalization in a conjugated molecule is often termed effective conjugation length or effective extent of conjugation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08818 goldbook:08789)
AnnotationAssertion(mito:isMentionedBy goldbook:08818 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08818 "current"^^xsd:string)
Declaration(Class(goldbook:08819))
AnnotationAssertion(rdfs:label goldbook:08819 "external quantum yield")
AnnotationAssertion(dcterms:description goldbook:08819 "Quantum yield relating to the whole device or the overall process involved.")
AnnotationAssertion(rdfs:seeAlso goldbook:08819 goldbook:08832)
AnnotationAssertion(mito:isMentionedBy goldbook:08819 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08819 "current"^^xsd:string)
Declaration(Class(goldbook:08820))
AnnotationAssertion(rdfs:label goldbook:08820 "extrinsic semiconductor")
AnnotationAssertion(dcterms:description goldbook:08820 "Semiconductor whose electric properties are largely determined by the dopant 'impurities' present.")
AnnotationAssertion(rdfs:comment goldbook:08820 "Phosphorus-doped silicon, i.e., silicon, in which some Si atoms are replaced with phosphorus atoms, or iodine doped poly(acetylene) are examples of extrinsic semiconductors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08820 goldbook:08778)
AnnotationAssertion(rdfs:seeAlso goldbook:08820 goldbook:08833)
AnnotationAssertion(rdfs:seeAlso goldbook:08820 goldbook:08882)
AnnotationAssertion(mito:isMentionedBy goldbook:08820 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08820 "current"^^xsd:string)
Declaration(Class(goldbook:08821))
AnnotationAssertion(rdfs:label goldbook:08821 "field-effect transistor")
AnnotationAssertion(dcterms:description goldbook:08821 "Transistor in which the flow of charge carriers from source to drain is controlled by the potential applied to the gate.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08821 "FET")
AnnotationAssertion(rdfs:seeAlso goldbook:08821 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08821 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08821 "current"^^xsd:string)
Declaration(Class(goldbook:08822))
AnnotationAssertion(rdfs:label goldbook:08822 "fill factor")
AnnotationAssertion(dcterms:description goldbook:08822 "Ratio of the real maximum output power, \\(P_{\\rm{max}}\\), that can be obtained with an actual solar cell to the product of the open-circuit potential, \\(V_{\\rm{oc}}\\), and short-circuit photocurrent, \\(I_{\\rm{sc}}\\): \\[f_{\\rm{FF}} = P_{\\rm{max}}/V_{\\rm{oc}}I_{\\rm{sc}}\\]")
AnnotationAssertion(rdfs:comment goldbook:08822 "The \\(P_{\\rm{max}}\\) value is obtained from the cell volt-ampere characteristic as the maximum of the product \\(V\\!\\cdot\\!I = P\\). Note that the product \\(V_{\\rm{oc}}\\!\\cdot\\!I_{\\rm{sc}}\\) is not a theoretical maximum output power of the cell, since the product is zero at both these values as \\(I = 0\\) for the open circuit and \\(V = 0\\) for short circuit."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08822 goldbook:08875)
AnnotationAssertion(mito:isMentionedBy goldbook:08822 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08822 "current"^^xsd:string)
Declaration(Class(goldbook:08823))
AnnotationAssertion(rdfs:label goldbook:08823 "free charge-carrier photogeneration")
AnnotationAssertion(dcterms:description goldbook:08823 "Generation of free charge carriers by photons.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08823 "charge-carrier photogeneration")
AnnotationAssertion(rdfs:seeAlso goldbook:08823 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08823 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08823 "current"^^xsd:string)
Declaration(Class(goldbook:08824))
AnnotationAssertion(rdfs:label goldbook:08824 "head-tail isomerism")
AnnotationAssertion(dcterms:description goldbook:08824 "Constitutional isomerism of polymeric (oligomeric) chains composed of identical non symmetric repeating units consisting in different orientations of the units.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08824 "HT-isomerism")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08824 "regioisomerism")
AnnotationAssertion(rdfs:comment goldbook:08824 "In the repeating unit of a vinyl polymer: \\(\\ce{-CHR-CH2\\bond{-}}\\), the substituent-bearing group \\(\\ce{CHR}\\) is denoted 'head' (H) while the other one 'tail' (T). There exist three modes how two such units can be linked in a chain: head-to-tail (HT), head-to-head (HH) and tail-to-tail (TT). "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08824 "The uniformity/non-uniformity of repeating units’ orientation determines the regularity/irregularity of macromolecules."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08824 goldbook:08868)
AnnotationAssertion(mito:isMentionedBy goldbook:08824 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08824 "current"^^xsd:string)
Declaration(Class(goldbook:08825))
AnnotationAssertion(rdfs:label goldbook:08825 "heterojunction")
AnnotationAssertion(dcterms:description goldbook:08825 "Interface between dissimilar crystalline or amorphous solid phases that have unequal bandgap levels.")
AnnotationAssertion(rdfs:comment goldbook:08825 "Heterojunction allows efficient dissociation of charge carriers, which is utilized, e.g., in diode lasers, heterojunction bipolar transistors and high electron mobility transistors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08825 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08825 goldbook:08828)
AnnotationAssertion(mito:isMentionedBy goldbook:08825 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08825 "current"^^xsd:string)
Declaration(Class(goldbook:08826))
AnnotationAssertion(rdfs:label goldbook:08826 "hole")
AnnotationAssertion(dcterms:description goldbook:08826 "Quasiparticle, a conceptual charge carrier opposite to electron, defined as the absence of electron at a position where it should be present if a lattice is in its ground state (valence band normally filled).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08826 "electron hole")
AnnotationAssertion(rdfs:comment goldbook:08826 "An electron hole is a conceptual (mathematical) opposite of an electron, while a positron is the antimatter analog of an electron."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08826 "In condensed matter, a hole is created if an electron originally occurring in the valence band is excited into conduction band thus leaving a positively charged site in its previous position."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08826 "The hole has a positive electric charge (\\(+e\\), where \\(e\\) is an elementary charge) and also an effective mass which, in most semiconductors is higher than the mass of the electron."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08826 goldbook:08863)
AnnotationAssertion(rdfs:seeAlso goldbook:08826 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08826 goldbook:08835)
AnnotationAssertion(mito:isMentionedBy goldbook:08826 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08826 "current"^^xsd:string)
Declaration(Class(goldbook:08827))
AnnotationAssertion(rdfs:label goldbook:08827 "hole-transporting material")
AnnotationAssertion(dcterms:description goldbook:08827 "Material, typically a semiconductor, in which holes are predominant mobile charge carriers.")
AnnotationAssertion(rdfs:seeAlso goldbook:08827 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08827 goldbook:08826)
AnnotationAssertion(mito:isMentionedBy goldbook:08827 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08827 "current"^^xsd:string)
Declaration(Class(goldbook:08828))
AnnotationAssertion(rdfs:label goldbook:08828 "homojunction")
AnnotationAssertion(dcterms:description goldbook:08828 "Interface occurring between two similar semiconductors with equal bandgaps.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08828 "pn-junction")
AnnotationAssertion(rdfs:comment goldbook:08828 "Homojunction mostly occurs at the interface between n-doped and p-doped semiconductor of the same nature, typically silicon. This type of homojunction is currently called a pn-junction."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08828 goldbook:08825)
AnnotationAssertion(mito:isMentionedBy goldbook:08828 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08828 "current"^^xsd:string)
Declaration(Class(goldbook:08829))
AnnotationAssertion(rdfs:label goldbook:08829 "hopping transport")
AnnotationAssertion(dcterms:description goldbook:08829 "Incoherent transport of charge carriers by hopping between adjacent energetically nearly equivalent localized sites.")
AnnotationAssertion(rdfs:comment goldbook:08829 "Hopping transport is typical of molecular solids and polycrystalline and amorphous semiconductors. It takes place via electron tunneling or by overcoming energy barriers (typical of ions), and is the opposite of intra-molecular transport (band transport) of charge carriers in metallic conductors."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08829 "A hopping charge carrier spends most of time sitting idle on a localized site and then hops (tunnel) to an adjacent site. As a result, the charge carrier mobility at hopping transport is low (typically below \\(\\pu{0.01 cm2 V s}\\)) and is an increasing function of temperature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08829 goldbook:08780)
AnnotationAssertion(rdfs:seeAlso goldbook:08829 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08829 goldbook:08791)
AnnotationAssertion(rdfs:seeAlso goldbook:08829 goldbook:08806)
AnnotationAssertion(mito:isMentionedBy goldbook:08829 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08829 "current"^^xsd:string)
Declaration(Class(goldbook:08830))
AnnotationAssertion(rdfs:label goldbook:08830 "hot electron")
AnnotationAssertion(dcterms:description goldbook:08830 "Electron that is out of the thermal equilibrium with its environment and has enough kinetic energy to overcome potential barriers to travel between different regions of a molecule or lattice.")
AnnotationAssertion(rdfs:seeAlso goldbook:08830 goldbook:08835)
AnnotationAssertion(mito:isMentionedBy goldbook:08830 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08830 "current"^^xsd:string)
Declaration(Class(goldbook:08831))
AnnotationAssertion(rdfs:label goldbook:08831 "impact ionization")
AnnotationAssertion(dcterms:description goldbook:08831 "Charge carrier generation by another charge carrier possessing a high kinetic energy, which knocks an electron out of the HOMO into the LUMO or still higher state so creating a new electron-hole pair.")
AnnotationAssertion(rdfs:seeAlso goldbook:08831 goldbook:08778)
AnnotationAssertion(rdfs:seeAlso goldbook:08831 goldbook:08837)
AnnotationAssertion(rdfs:seeAlso goldbook:08831 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08831 goldbook:08826)
AnnotationAssertion(mito:isMentionedBy goldbook:08831 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08831 "current"^^xsd:string)
Declaration(Class(goldbook:08832))
AnnotationAssertion(rdfs:label goldbook:08832 "internal quantum yield")
AnnotationAssertion(dcterms:description goldbook:08832 "Quantum yield relating to a single component or a part of a device or a partial step of an overall process.")
AnnotationAssertion(mito:isMentionedBy goldbook:08832 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08832 "current"^^xsd:string)
Declaration(Class(goldbook:08833))
AnnotationAssertion(rdfs:label goldbook:08833 "intrinsic semiconductor")
AnnotationAssertion(dcterms:description goldbook:08833 "Semiconductor in which mobile charge carriers are generated solely by thermal excitation of electrons.")
AnnotationAssertion(rdfs:comment goldbook:08833 "Intrinsic semiconductor is free of dopants, so that it has no energy states in the bandgap."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08833 "Pure conjugated polymers such as poly(ethene-1,2-diyl) or poly(pyrrole-2,5-diyl) and other polymers with delocalized valence electrons such as polysilanes are examples of intrinsic semiconductors."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08833 goldbook:08778)
AnnotationAssertion(rdfs:seeAlso goldbook:08833 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08833 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08833 goldbook:08820)
AnnotationAssertion(rdfs:seeAlso goldbook:08833 goldbook:08890)
AnnotationAssertion(rdfs:seeAlso goldbook:08833 goldbook:08899)
AnnotationAssertion(mito:isMentionedBy goldbook:08833 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08833 "current"^^xsd:string)
Declaration(Class(goldbook:08834))
AnnotationAssertion(rdfs:label goldbook:08834 "ion-conducting polymer")
AnnotationAssertion(dcterms:description goldbook:08834 "Conducting polymer in which ionic species are mobile charge carriers.")
AnnotationAssertion(rdfs:comment goldbook:08834 "Protons are typical charge carriers in ion-conducting polymers. Such polymers are currently referred to as proton-conducting polymers. Examples are polyanilines."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08834 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08834 goldbook:08883)
AnnotationAssertion(mito:isMentionedBy goldbook:08834 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08834 "current"^^xsd:string)
Declaration(Class(goldbook:08835))
AnnotationAssertion(rdfs:label goldbook:08835 "lattice")
AnnotationAssertion(dcterms:description goldbook:08835 "Periodic grid-like ideal structure consisting of regularly arranged elementary repeating units.")
AnnotationAssertion(rdfs:comment goldbook:08835 "In the condensed matter physics, lattice models are currently used for modeling and theoretical studying of electric, magnetic and optical phenomena as well as materials properties. 1-Dimensional (1-D) lattice is used for modeling linear objects such as linear conjugated polymers (see Peierls distortion), 2-D and 3-D lattices for modeling planar and spatial objects, respectively."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08835 "Crystal (Bravais) lattices are the most famous examples of physical 3-D lattice models."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08835 goldbook:08785)
AnnotationAssertion(mito:isMentionedBy goldbook:08835 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08835 "current"^^xsd:string)
Declaration(Class(goldbook:08836))
AnnotationAssertion(rdfs:label goldbook:08836 "light emitting diode")
AnnotationAssertion(dcterms:description goldbook:08836 "Transducer-type device that converts an electric current into luminescence light.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08836 "LED")
AnnotationAssertion(mito:isMentionedBy goldbook:08836 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08836 "current"^^xsd:string)
Declaration(Class(goldbook:08837))
AnnotationAssertion(rdfs:label goldbook:08837 "lowest unoccupied molecular orbital")
AnnotationAssertion(dcterms:description goldbook:08837 "Lowest-energy molecular orbital that is unoccupied in the ground state but occupied by one or more electrons if the molecular entity occurs in its first electronically excited state.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08837 "LUMO")
AnnotationAssertion(rdfs:seeAlso goldbook:08837 goldbook:08811)
AnnotationAssertion(rdfs:seeAlso goldbook:08837 goldbook:08841)
AnnotationAssertion(mito:isMentionedBy goldbook:08837 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08837 "current"^^xsd:string)
Declaration(Class(goldbook:08838))
AnnotationAssertion(rdfs:label goldbook:08838 "luminescent material")
AnnotationAssertion(dcterms:description goldbook:08838 "Material (polymer) that exhibits a luminescence.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08838 "luminescent polymer")
AnnotationAssertion(rdfs:comment goldbook:08838 "Luminescent is in general a material, in which radiative charge carrier recombination represents a significant mode of the overall charge carrier recombination."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08838 goldbook:08781)
AnnotationAssertion(rdfs:seeAlso goldbook:08838 goldbook:08864)
AnnotationAssertion(mito:isMentionedBy goldbook:08838 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08838 "current"^^xsd:string)
Declaration(Class(goldbook:08839))
AnnotationAssertion(rdfs:label goldbook:08839 "magnetoresistance")
AnnotationAssertion(dcterms:description goldbook:08839 "Change in the electric resistance of a material in response to an external magnetic field.")
AnnotationAssertion(mito:isMentionedBy goldbook:08839 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08839 "current"^^xsd:string)
Declaration(Class(goldbook:08840))
AnnotationAssertion(rdfs:label goldbook:08840 "memristor")
AnnotationAssertion(dcterms:description goldbook:08840 "Electric component that can be reversibly switched between stable low- and high-resistive states.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08840 "memristive system")
AnnotationAssertion(rdfs:comment goldbook:08840 "The term memristor is derived from the phrase memory resistor."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08840 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08840 "current"^^xsd:string)
Declaration(Class(goldbook:08841))
AnnotationAssertion(rdfs:label goldbook:08841 "molecular orbital theory")
AnnotationAssertion(dcterms:description goldbook:08841 "Theory of quantum mechanics in which electrons in a molecule (lattice) are not assigned to particular bonds between atoms but move under the influence of all atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08841 "MO theory")
AnnotationAssertion(rdfs:comment goldbook:08841 "Within the MO theory, the wave function of \\(i\\mbox{-}\\rm{th}\\) MO, \\(\\varphi_{i}\\), is expressed as a weighted sum of all atomic orbitals, \\(\\chi_{r}\\) (method known as the linear combination of atomic orbitals, LCAO): \\[\\varphi_{i} = \\sum_{r=1}^{N}c_{ri}\\chi_{r}\\] where the coefficient \\(c_{ri}\\) is the contribution of the \\(r\\mbox{-}\\rm{th}\\) atomic orbital to the \\(i\\mbox{-}\\rm{th}\\) MO."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08841 "MO theory is a counterpart of the valence bond theory in which electrons are assigned to individual bonds. MO theory fits perfectly for systems with delocalized electrons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08841 goldbook:08835)
AnnotationAssertion(rdfs:seeAlso goldbook:08841 goldbook:08878)
AnnotationAssertion(mito:isMentionedBy goldbook:08841 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08841 "current"^^xsd:string)
Declaration(Class(goldbook:08842))
AnnotationAssertion(rdfs:label goldbook:08842 "molecular switch")
AnnotationAssertion(dcterms:description goldbook:08842 "Molecule that can be reversibly switched between two or more stable states in response to a change in, e.g., its microenvironment (pH, the presence of a ligand, temperature etc.), illumination or electric current.")
AnnotationAssertion(rdfs:comment goldbook:08842 "Molecules undergoing photoinduced reversible cis-trans isomerization or switching between redox state or protonation states (pH indicators) are examples of molecular switches."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08842 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08842 "current"^^xsd:string)
Declaration(Class(goldbook:08843))
AnnotationAssertion(rdfs:label goldbook:08843 "occupied band")
AnnotationAssertion(dcterms:description goldbook:08843 "Energy band occupied by electrons, typically the valence band.")
AnnotationAssertion(rdfs:seeAlso goldbook:08843 goldbook:08810)
AnnotationAssertion(mito:isMentionedBy goldbook:08843 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08843 "current"^^xsd:string)
Declaration(Class(goldbook:08844))
AnnotationAssertion(rdfs:label goldbook:08844 "ohmic contact")
AnnotationAssertion(dcterms:description goldbook:08844 "Electric junction which exhibits linear and symmetric current-potential dependence.")
AnnotationAssertion(rdfs:comment goldbook:08844 "The current is not rectified at an ohmic contact unlike the case of a Schottky barrier."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08844 goldbook:08870)
AnnotationAssertion(mito:isMentionedBy goldbook:08844 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08844 "current"^^xsd:string)
Declaration(Class(goldbook:08845))
AnnotationAssertion(rdfs:label goldbook:08845 "optically nonlinear polymer")
AnnotationAssertion(dcterms:description goldbook:08845 "Polymer that exhibits a nonlinear optical effect.")
AnnotationAssertion(mito:isMentionedBy goldbook:08845 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08845 "current"^^xsd:string)
Declaration(Class(goldbook:08846))
AnnotationAssertion(rdfs:label goldbook:08846 "optoelectronics")
AnnotationAssertion(dcterms:description goldbook:08846 "Branch of physics that deals with the optical-to-electric and electric-to-optical transducers.")
AnnotationAssertion(rdfs:comment goldbook:08846 "Optoelectronics should not be confused with electro-optics that deals with alteration of optical properties in response to an applied electric field (see electrooptic effect)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08846 "Optoelectronic effects are electroluminescence, photoconductivity and photovoltaic effect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08846 goldbook:08855)
AnnotationAssertion(mito:isMentionedBy goldbook:08846 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08846 "current"^^xsd:string)
Declaration(Class(goldbook:08847))
AnnotationAssertion(rdfs:label goldbook:08847 "percolation")
AnnotationAssertion(dcterms:description goldbook:08847 "Formation of the long-range (infinite) functional connectivity in a disperse system composed of small active particles evenly dispersed in an inactive matrix, which makes the system penetrable for a fluid or current.")
AnnotationAssertion(rdfs:comment goldbook:08847 "The term percolation is derived from latin word percōlāre that means to filter. Porous materials in which percolation of pores exists can act as filters (pores are “active particles”). In hydrology and geology percolation relates to a slow penetration of water (liquids) through a porous material."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08847 "Percolation is achieved at so-called percolation threshold and exists above it."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08847 goldbook:08848)
AnnotationAssertion(mito:isMentionedBy goldbook:08847 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08847 "current"^^xsd:string)
Declaration(Class(goldbook:08848))
AnnotationAssertion(rdfs:label goldbook:08848 "percolation threshold")
AnnotationAssertion(dcterms:description goldbook:08848 "Minimal volume fraction of functionally active small particles evenly dispersed in a non-active matrix, at which the long-range (infinite) functional connectivity in the system is achieved.")
AnnotationAssertion(rdfs:comment goldbook:08848 "A desired transport through the composite material is not possible below the percolation threshold. Percolation threshold is about \\(\\pu{0.3}\\) to \\(\\pu{0.35}\\) (by volume) for composites with nearly spherical disperse particles while it can be even below \\(\\pu{0.10}\\) for composites with short fibers, depending on the fibers’ aspect ratio (the length to diameter ratio)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08848 "Electrically conducting polymer composites composed of carbon black microparticles dispersed in a rubbery matrix are transposed in the electrically conducting state above percolation threshold."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08848 goldbook:08798)
AnnotationAssertion(mito:isMentionedBy goldbook:08848 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08848 "current"^^xsd:string)
Declaration(Class(goldbook:08849))
AnnotationAssertion(rdfs:label goldbook:08849 "photochromic polymer")
AnnotationAssertion(dcterms:description goldbook:08849 "Polymer exhibiting photochromism.")
AnnotationAssertion(mito:isMentionedBy goldbook:08849 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08849 "current"^^xsd:string)
Declaration(Class(goldbook:08850))
AnnotationAssertion(rdfs:label goldbook:08850 "photoconducting polymer")
AnnotationAssertion(dcterms:description goldbook:08850 "Polymer exhibiting electrical conductivity or a clear increase in electrical conductivity under irradiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:08850 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08850 "current"^^xsd:string)
Declaration(Class(goldbook:08851))
AnnotationAssertion(rdfs:label goldbook:08851 "photodetrapping")
AnnotationAssertion(dcterms:description goldbook:08851 "Removal of charge carriers from traps in the bandgap by irradiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:08851 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08851 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08851 "current"^^xsd:string)
Declaration(Class(goldbook:08852))
AnnotationAssertion(rdfs:label goldbook:08852 "photoinduced discharge")
AnnotationAssertion(dcterms:description goldbook:08852 "Discharging of an electrically charged material by irradiation.")
AnnotationAssertion(mito:isMentionedBy goldbook:08852 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08852 "current"^^xsd:string)
Declaration(Class(goldbook:08853))
AnnotationAssertion(rdfs:label goldbook:08853 "photoinjection")
AnnotationAssertion(dcterms:description goldbook:08853 "Charge carrier injection by a process induced by irradiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:08853 goldbook:08779)
AnnotationAssertion(mito:isMentionedBy goldbook:08853 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08853 "current"^^xsd:string)
Declaration(Class(goldbook:08854))
AnnotationAssertion(rdfs:label goldbook:08854 "photorefractive polymer")
AnnotationAssertion(dcterms:description goldbook:08854 "Optically nonlinear polymer that changes refractive index when exposed to light.")
AnnotationAssertion(rdfs:seeAlso goldbook:08854 goldbook:08845)
AnnotationAssertion(mito:isMentionedBy goldbook:08854 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08854 "current"^^xsd:string)
Declaration(Class(goldbook:08855))
AnnotationAssertion(rdfs:label goldbook:08855 "photovoltaic effect")
AnnotationAssertion(dcterms:description goldbook:08855 "Phenomenon consisting in converting light to electricity.")
AnnotationAssertion(mito:isMentionedBy goldbook:08855 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08855 "current"^^xsd:string)
Declaration(Class(goldbook:08856))
AnnotationAssertion(rdfs:label goldbook:08856 "polarization density")
AnnotationAssertion(dcterms:description goldbook:08856 "Change in electric dipole moment per unit volume of dielectric material in response to its exposure to an electric field.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08856 "dielectric polarization")
AnnotationAssertion(rdfs:comment goldbook:08856 "The electric field causes limited reversible displacements of charged particles that cannot move freely in the dielectric material. Electronic polarization (displacements of electrons) takes a femtosecond. So it is in phase with an alternating electric field, such as that of light. Ionic polarization (of ions in ionic crystals) is also instantaneous. However orientation polarization based on reorientation of permanent dipoles is significantly slower (delayed) and thus often out of phase with the light field."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08856 "Polarization density (unit \\(\\pu{C m-2}\\)) is defined as \\(P = \\varepsilon E - \\varepsilon_{0} E\\), where \\(\\varepsilon E {=D}\\) is so-called electric displacement, \\(E\\) the electric field strength, \\(\\epsilon_{0}\\) the vacuum permittivity and \\(\\varepsilon = \\varepsilon_{\\rm{r}}\\varepsilon_0\\) permittivity of the dielectric material. The ideal dependence of \\(P\\) on \\(E\\) is linear: \\(P = \\varepsilon_{0}\\chi E\\), where \\(\\chi = \\varepsilon_{\\rm{r}} - 1\\) is electric susceptibility. Non-linearity of this dependence gives rise to non-linear optical effects."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08856 goldbook:08790)
AnnotationAssertion(mito:isMentionedBy goldbook:08856 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08856 "current"^^xsd:string)
Declaration(Class(goldbook:08857))
AnnotationAssertion(rdfs:label goldbook:08857 "poling")
AnnotationAssertion(dcterms:description goldbook:08857 "Orientation of dipoles or dipolar domains inside a material by using a sufficiently strong electric field.")
AnnotationAssertion(rdfs:comment goldbook:08857 "Poling is usually achieved by applying a high strength electric field to the opposite surfaces of a polymer film to obtain piezoelectric polymer or ferroelectric polymer."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08857 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08857 "current"^^xsd:string)
Declaration(Class(goldbook:08858))
AnnotationAssertion(rdfs:label goldbook:08858 "Poole–Frenkel effect")
AnnotationAssertion(dcterms:description goldbook:08858 "Increase in the electric conductivity of a semiconductor or insulator by exposing it to an electric field.")
AnnotationAssertion(rdfs:comment goldbook:08858 "Valence electrons in an insulator or poor semiconductor that is exposed to an external electric field obtain a part of the excitation energy from an external electric field."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08858 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08858 "current"^^xsd:string)
Declaration(Class(goldbook:08859))
AnnotationAssertion(rdfs:label goldbook:08859 "protonic conductivity")
AnnotationAssertion(dcterms:description goldbook:08859 "Ionic conductivity mediated by protons (more exactly by hydrogen cations properly called hydrons).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08859 "hydronic conductivity")
AnnotationAssertion(mito:isMentionedBy goldbook:08859 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08859 "current"^^xsd:string)
Declaration(Class(goldbook:08860))
AnnotationAssertion(rdfs:label goldbook:08860 "proton doping")
AnnotationAssertion(dcterms:description goldbook:08860 "Transformation of a semiconducting or insulating material to conducting state by protonation (hydronation) of its molecules.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08860 "hydron doping")
AnnotationAssertion(rdfs:comment goldbook:08860 "The proton doping is crucial for polyanilines that are good conductors only in the protonated state. Deprotonation (dehydronation), as a reverse transformation is achieved by treating the doped polymer with an alkali."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08860 goldbook:08883)
AnnotationAssertion(mito:isMentionedBy goldbook:08860 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08860 "current"^^xsd:string)
Declaration(Class(goldbook:08861))
AnnotationAssertion(rdfs:label goldbook:08861 "quantum confinement effect")
AnnotationAssertion(dcterms:description goldbook:08861 "Effect occurring if at least one dimension of a structure is comparable to the de Broglie wavelength of the electron-hole pair and the motion of charge carriers is thus quantized by the structure boundary.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08861 "quantum size effect")
AnnotationAssertion(rdfs:comment goldbook:08861 "A material composed of quantum-size structures exhibits electronic and optic properties different from those of bigger structures. A quantum size effect can be thus detected as an alteration of electronic and optical properties of a solid when reducing its particle size down to nanometer scale."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08861 "Based on the confinement dimensionality the following quantum-size objects are distinguished: quantum dot: three-dimensional confinement; example: nanoparticles of CdS;quantum wire: two-dimensional confinement; example: carbon nanotubes;quantum well: one-dimensional (linear) confinement; example: nanoscale layer of GaAs sandwiched between two layers of a wide-band-gap semiconductor such as AlAs."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08861 goldbook:08775)
AnnotationAssertion(mito:isMentionedBy goldbook:08861 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08861 "current"^^xsd:string)
Declaration(Class(goldbook:08862))
AnnotationAssertion(rdfs:label goldbook:08862 "quantum tunneling polymer composite")
AnnotationAssertion(dcterms:description goldbook:08862 "Electrically conducting polymer composite that, however, is conducting only when pressed due to thinning the insulating polymer matrix membranes so much that they allow electron tunneling through them.")
AnnotationAssertion(rdfs:comment goldbook:08862 "Quantum tunneling polymer composites are utilized as pressure sensors and touchable control panels of electronic devices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08862 goldbook:08798)
AnnotationAssertion(rdfs:seeAlso goldbook:08862 goldbook:08806)
AnnotationAssertion(rdfs:seeAlso goldbook:08862 goldbook:08847)
AnnotationAssertion(rdfs:seeAlso goldbook:08862 goldbook:08848)
AnnotationAssertion(rdfs:seeAlso goldbook:08862 goldbook:08872)
AnnotationAssertion(mito:isMentionedBy goldbook:08862 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08862 "current"^^xsd:string)
Declaration(Class(goldbook:08863))
AnnotationAssertion(rdfs:label goldbook:08863 "quasiparticle")
AnnotationAssertion(dcterms:description goldbook:08863 "Discrete disorder in a multi-particulate system that exhibits particle-specific behavior and properties.")
AnnotationAssertion(rdfs:comment goldbook:08863 "A real particle can exist by itself, out of other real particles, while a quasiparticle cannot. It exists only within a multi-particulate system, like a gas bubble inside water or beer. It looks and behaves like a particle, but it does not exist outside liquid. Such a bubble is a macroscopic quasiparticle."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08863 "Characteristics typical of particles, such as the mass (referred to as effective mass), momentum, energy, velocity, mobility and ability to undergo collisions can be assigned to quasiparticles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08863 "Examples of quasiparticles related to electromagnetic field responsive materials are electron hole, exciton, magnon, phonon, plasmon, polaron and soliton."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08863 "There are two main classes of quasiparticles: those of the excitation type whose motion corresponds to a motion of individual particles interacting with other parts of the system; examples are exciton, hole, soliton and polaron;those that originate from a synchronized collective motion of the whole system, referred to as collective excitations or collective modes; examples are magnon, plasmon and phonon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08863 goldbook:08803)
AnnotationAssertion(rdfs:seeAlso goldbook:08863 goldbook:08826)
AnnotationAssertion(mito:isMentionedBy goldbook:08863 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08863 "current"^^xsd:string)
Declaration(Class(goldbook:08864))
AnnotationAssertion(rdfs:label goldbook:08864 "radiative charge carrier recombination")
AnnotationAssertion(dcterms:description goldbook:08864 "Charge carrier recombination in which the energy released is emitted as a photon of corresponding energy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08864 "radiative recombination")
AnnotationAssertion(rdfs:comment goldbook:08864 "Radiative charge carrier recombination occurs if a mobile electron meets a hole with which it forms an exciton that then decays by the radiative electron transition to the ground state."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08864 goldbook:08781)
AnnotationAssertion(rdfs:seeAlso goldbook:08864 goldbook:08826)
AnnotationAssertion(rdfs:seeAlso goldbook:08864 goldbook:08876)
AnnotationAssertion(mito:isMentionedBy goldbook:08864 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08864 "current"^^xsd:string)
Declaration(Class(goldbook:08865))
AnnotationAssertion(rdfs:label goldbook:08865 "redox doping")
AnnotationAssertion(dcterms:description goldbook:08865 "Doping of a parent polymer consisting in oxidation or reduction of its molecules.")
AnnotationAssertion(rdfs:comment goldbook:08865 "Redox doping can be accomplished by a chemical reaction or an electrode redox process."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08865 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08865 "current"^^xsd:string)
Declaration(Class(goldbook:08866))
AnnotationAssertion(rdfs:label goldbook:08866 "regioirregular polymer")
AnnotationAssertion(dcterms:description goldbook:08866 "Regular polymer or an irregular polymer whose macromolecules contain non-uniformly oriented simple asymmetric repeating units.")
AnnotationAssertion(rdfs:comment goldbook:08866 "The difference between regioirregular, irregular and regular chains is shown in the following chart.  "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08866 goldbook:08824)
AnnotationAssertion(rdfs:seeAlso goldbook:08866 goldbook:08868)
AnnotationAssertion(mito:isMentionedBy goldbook:08866 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08866 "current"^^xsd:string)
Declaration(Class(goldbook:08867))
AnnotationAssertion(rdfs:label goldbook:08867 "regiorandom polymer")
AnnotationAssertion(dcterms:description goldbook:08867 "Regioirregular polymer with randomly oriented asymmetric constitutional repeating units in its chains.")
AnnotationAssertion(rdfs:seeAlso goldbook:08867 goldbook:08868)
AnnotationAssertion(mito:isMentionedBy goldbook:08867 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08867 "current"^^xsd:string)
Declaration(Class(goldbook:08868))
AnnotationAssertion(rdfs:label goldbook:08868 "regioregular polymer")
AnnotationAssertion(dcterms:description goldbook:08868 "Regular polymer whose chains are composed of uniformly oriented asymmetric constitutional repeating units.")
AnnotationAssertion(rdfs:comment goldbook:08868 "The difference between regioregular and regioirregular poly(3-alkylthiophene) chains is as follows: "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08868 goldbook:08866)
AnnotationAssertion(mito:isMentionedBy goldbook:08868 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08868 "current"^^xsd:string)
Declaration(Class(goldbook:08869))
AnnotationAssertion(rdfs:label goldbook:08869 "reticulate doped polymer")
AnnotationAssertion(dcterms:description goldbook:08869 "Surface-conducting polymer composite obtained by crystallization of a low-molar-mass organic conductor on an insulating or semiconducting polymer support.")
AnnotationAssertion(rdfs:seeAlso goldbook:08869 goldbook:08774)
AnnotationAssertion(mito:isMentionedBy goldbook:08869 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08869 "current"^^xsd:string)
Declaration(Class(goldbook:08870))
AnnotationAssertion(rdfs:label goldbook:08870 "Schottky barrier")
AnnotationAssertion(dcterms:description goldbook:08870 "Potential energy barrier at a semiconductor-metal junction with the current rectifying characteristics.")
AnnotationAssertion(rdfs:comment goldbook:08870 "The diode based on the Schottky barrier is a Schottky diode or a hot carrier diode. Schottky diodes show switching times down to below \\(\\pu{1 ns}\\) and a low applied potential drop (\\(\\pu{0.15}\\) to \\(\\pu{0.45 V}\\))."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08870 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08870 "current"^^xsd:string)
Declaration(Class(goldbook:08871))
AnnotationAssertion(rdfs:label goldbook:08871 "second harmonic generation")
AnnotationAssertion(dcterms:description goldbook:08871 "Transformation of the input monochromatic radiation beam into a double frequency (half wavelength) beam.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08871 "frequency doubling")
AnnotationAssertion(rdfs:comment goldbook:08871 "Frequency doubling is a nonlinear optic effect typical of non-centrosymmetric crystals with a high second-order electric susceptibility. It is utilized in the laser and radio-communication techniques to obtain higher frequency signals, e.g., that of the wavelength \\(\\pu{533 nm}\\) from the signal of \\(\\pu{1066 nm}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08871 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08871 "current"^^xsd:string)
Declaration(Class(goldbook:08872))
AnnotationAssertion(rdfs:label goldbook:08872 "sensor")
AnnotationAssertion(dcterms:description goldbook:08872 "Transducer-type device that responds to a specific property of its surroundings or to a coming stimulus by a visually readable change in its state or by generation of a signal that can be read by an observer or instrument.")
AnnotationAssertion(mito:isMentionedBy goldbook:08872 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08872 "current"^^xsd:string)
Declaration(Class(goldbook:08873))
AnnotationAssertion(rdfs:label goldbook:08873 "short circuit photocurrent")
AnnotationAssertion(dcterms:description goldbook:08873 "Photocurrent flowing through a short circuited solar cell (if the electric potential across the cell is zero).")
AnnotationAssertion(rdfs:seeAlso goldbook:08873 goldbook:08875)
AnnotationAssertion(mito:isMentionedBy goldbook:08873 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08873 "current"^^xsd:string)
Declaration(Class(goldbook:08874))
AnnotationAssertion(rdfs:label goldbook:08874 "size effect")
AnnotationAssertion(dcterms:description goldbook:08874 "Effect of size on properties of the material or device which incorporates it.")
AnnotationAssertion(mito:isMentionedBy goldbook:08874 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08874 "current"^^xsd:string)
Declaration(Class(goldbook:08875))
AnnotationAssertion(rdfs:label goldbook:08875 "solar cell")
AnnotationAssertion(dcterms:description goldbook:08875 "Device that directly transduces electromagnetic radiation into electricity based on the photovoltaic effect.")
AnnotationAssertion(rdfs:seeAlso goldbook:08875 goldbook:08855)
AnnotationAssertion(mito:isMentionedBy goldbook:08875 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08875 "current"^^xsd:string)
Declaration(Class(goldbook:08876))
AnnotationAssertion(rdfs:label goldbook:08876 "stimulated radiative charge carrier recombination")
AnnotationAssertion(dcterms:description goldbook:08876 "Radiative charge carrier recombination induced by incident photons of appropriate wavelength, which synchronize emission of other photons as to their wavelength, phase, polarization and direction of travel.")
AnnotationAssertion(rdfs:comment goldbook:08876 "If this process takes place in a system with a high population of excited states, it leads to stimulated emission, the principle of the function of lasers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08876 goldbook:08864)
AnnotationAssertion(mito:isMentionedBy goldbook:08876 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08876 "current"^^xsd:string)
Declaration(Class(goldbook:08877))
AnnotationAssertion(rdfs:label goldbook:08877 "thermal injection")
AnnotationAssertion(dcterms:description goldbook:08877 "Charge carrier injection by a thermally activated processes.")
AnnotationAssertion(rdfs:seeAlso goldbook:08877 goldbook:08779)
AnnotationAssertion(mito:isMentionedBy goldbook:08877 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08877 "current"^^xsd:string)
Declaration(Class(goldbook:08878))
AnnotationAssertion(rdfs:label goldbook:08878 "valence bond theory")
AnnotationAssertion(dcterms:description goldbook:08878 "Quantum mechanics theory of chemical bonding that treats electrons as being assigned to individual bonds between particular atoms.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08878 "VB theory")
AnnotationAssertion(rdfs:comment goldbook:08878 "The VB theory views a chemical bond as a result of weak coupling (overlapping) of atomic or hybridized atomic orbitals or of both and describes delocalization of electrons (inherent in molecular orbital theory) as a result of resonance mixing of two or more possible energetically equivalent or nearly equivalent structures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08878 "VB theory and molecular orbital theory are closely related methods that become equivalent when extended enough. Increasing mixing of VB orbitals gives in the limit extended molecular orbitals."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08878 goldbook:08789)
AnnotationAssertion(rdfs:seeAlso goldbook:08878 goldbook:08841)
AnnotationAssertion(mito:isMentionedBy goldbook:08878 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08878 "current"^^xsd:string)
Declaration(Class(goldbook:08879))
AnnotationAssertion(rdfs:label goldbook:08879 "work function")
AnnotationAssertion(dcterms:description goldbook:08879 "Minimum thermodynamic work (energy) needed to remove an electron from a solid to a point in the vacuum nearby the solid surface.\\[\\mathit{\\Phi} = -e{\\mathit{\\Psi}} - \\mu\\]where \\(e\\) is the elementary charge (\\(-e\\) is charge of electron), \\(\\mathit{\\Psi}\\) is the electric potential nearby the surface and \\(\\mu\\) is the energy of Fermi level.")
AnnotationAssertion(rdfs:comment goldbook:08879 "Nearby the solid surface means that the released electron remains so close to the solid that it interacts with the surface. Hence the work function depends on the crystal face and contamination."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08879 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08879 "current"^^xsd:string)
Declaration(Class(goldbook:08880))
AnnotationAssertion(rdfs:label goldbook:08880 "fluoropolymers")
AnnotationAssertion(dcterms:description goldbook:08880 "Polymers whose macromolecules are rich in fluorocarbon groups (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08880 "Fluoropolymers are often used as electrets. Membranes from ionomeric fluoropolymers are used in electrochemical cells."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08880 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08880 "current"^^xsd:string)
Declaration(Class(goldbook:08881))
AnnotationAssertion(rdfs:label goldbook:08881 "metallo-supramolecular polymer")
AnnotationAssertion(dcterms:description goldbook:08881 "Dynamic polymeric entity whose macromolecules are composed of alternating simple or oligomeric molecules with two or more chelate end-groups (so-called unimers) and metal ions (so-called ion couplers) that are linked to chains by reversible coordination bonds (structure-based polymer class name):")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08881 "MSP")
AnnotationAssertion(rdfs:comment goldbook:08881 "An MSP is spontaneously formed upon mixing unimer(s) with ion couplers, because the activation energy of coordination binding is low. Therefore, the degree of polymerization of MSP is controlled by thermodynamics: it is low in a solution and/or at increased temperature but high in the solid state at room temperature. Due to these features, MSPs belong to the family of constitutional dynamic polymers, so-called dynamers. Constitutional dynamics gives to MSPs processing advantages and capability of self-healing."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08881 "Examples are MSPs formed by self-assembly of 2,5″-bis(-2,2′:6′,2″-terpyridin-4′-yl)-5,2′:5′,2″- terthiophene with metal ions \\(\\ce{M}\\). The MSP with \\(\\ce{Fe^{2+}}\\) ions exhibited electrochromism while that with \\(\\ce{Zn^{2+}}\\) ions showed the singlet fission. "^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08881 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08881 "current"^^xsd:string)
Declaration(Class(goldbook:08882))
AnnotationAssertion(rdfs:label goldbook:08882 "polyacetylenes")
AnnotationAssertion(dcterms:description goldbook:08882 "Polymers prepared from acetylene (ethyne), a substituted acetylene, or both in admixture by a polymerization involving one or more triple bonds (source-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08882 "Polymers of buta-1,3-diyne and its derivatives are a subclass of polyacetylenes referred to as polydiacetylenes."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08882 "Polymers prepared by polycondensations from diols, triols, diamines, dicarboxylic acids etc. containing triple bonds (e.g., from but-2-yne-1,4-diol) are excluded. Such polymers are classified as unsaturated polyesters, unsaturated polyamides, etc."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08882 "Although polyacetylenes opened the boom in organic electronics, they did not find commercial application due to insufficient stability under workload and in air. However, polymers of diarylacetylenes are stable and found applications as materials for gas separation membranes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08882 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08882 "current"^^xsd:string)
Declaration(Class(goldbook:08883))
AnnotationAssertion(rdfs:label goldbook:08883 "polyanilines")
AnnotationAssertion(dcterms:description goldbook:08883 "Polymers prepared exclusively from aniline, or substituted aniline, or both in admixture (source-based class name).")
AnnotationAssertion(rdfs:comment goldbook:08883 "Examples of polyanilines (PANI) in the leucoemeraldine base form (see Note 2) are:  (the first name is the structure-based while the second one is the source-based name of the polymer)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08883 "Polyanilines exist in various forms (see scheme) differing in the degrees of oxidation (p-doping) and protonation (proton doping). Gem-based names (leucoemeraldine, emeraldine, pernigraniline) were given to particular PANI forms in 1910 by Green and Woodhead. "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08883 "Redox doping of PANI-LB by the electron transfer (left branch in the scheme) directly gives PANI salts ES and PS, whereas dehydrogenation of LB (right branch in the scheme) gives PANI bases: EB and PB. PANI bases are reversibly transformed to corresponding PANI salts by proton doping. The intermediate oxidation state forms, protoemeraldine (product of one-electron oxidation) and nigraniline (product of three-electron oxidation of LB) are sometimes recognized in the literature."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08883 "PANIs carrying strongly acidic group such as sulfonic or phosphonic group attached to benzene rings are referred to as self-doped PANIs, since the attached acidic groups afford protons ensuring proton doping of main chains."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08883 "The PANI ES form is an intrinsically conducting polymer (conductivity of \\(\\pu{1-10 S cm-1}\\)) in which positive polarons and protons are major charge carriers. It is easy accessible by electrochemical or chemical oxidation of anilines in an acidic aqueous medium and it found many applications in electrochemical and photovoltaic cells, batteries, displays and others."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08883 goldbook:08775)
AnnotationAssertion(rdfs:seeAlso goldbook:08883 goldbook:08860)
AnnotationAssertion(mito:isMentionedBy goldbook:08883 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08883 "current"^^xsd:string)
Declaration(Class(goldbook:08884))
AnnotationAssertion(rdfs:label goldbook:08884 "polyarylenes")
AnnotationAssertion(dcterms:description goldbook:08884 "Polymers composed of macromolecules containing exclusively arenediyl (formerly arylene) or heteroarenediyl (formerly heteroarylene) units in the backbone:  where Ar is a divalent arenediyl or heteroarenediyl group (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08884 "Polyphenylenes (Ar is phenylene or substituted phenylene) are a subclass of polyarylenes."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08884 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08884 "current"^^xsd:string)
Declaration(Class(goldbook:08885))
AnnotationAssertion(rdfs:label goldbook:08885 "polyarylenethynylenes")
AnnotationAssertion(dcterms:description goldbook:08885 "Polymers composed of macromolecules containing exclusively alternating arenediyl or heterarenediyl (formerly arylene or heteroarylene, respectively) and ethynediyl (formerly ethynylene) constitutional repeating units in the backbone:  where Ar is a divalent arenediyl or heterarenediyl group (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08885 "A polymer for which Ar is phenylene is a polyphenyleneethynylene."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08885 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08885 "current"^^xsd:string)
Declaration(Class(goldbook:08886))
AnnotationAssertion(rdfs:label goldbook:08886 "polyarylenevinylenes")
AnnotationAssertion(dcterms:description goldbook:08886 "Polymers composed of macromolecules containing exclusively alternating arenediyl or heteroarenediyl (formerly arylene or heteroarylene, respectively) and ethene-1,2-diyl (formerly vinylene) or substituted vinylene constitutional repeating units in the backbone:  where Ar is a divalent arenediyl or heteroarenediyl group and \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen, or an alkyl, aryl or heteroaryl group (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08886 "Polyarylenevinylenes are a subclass of conjugated polymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08886 "Polyarylenevinylenes are of interest mainly due to their electroluminescent properties."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08886 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08886 goldbook:08897)
AnnotationAssertion(mito:isMentionedBy goldbook:08886 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08886 "current"^^xsd:string)
Declaration(Class(goldbook:08887))
AnnotationAssertion(rdfs:label goldbook:08887 "polyazomethines")
AnnotationAssertion(dcterms:description goldbook:08887 "Polymers composed of macromolecules containing azomethine (azanylylidenemethanylylidene) linkages in the backbone: \\[\\ce{-N=CR-}\\] where \\(\\ce{R}\\) is hydrogen, or an alkyl or aryl group (structure-based polymer class name).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08887 "poly (Schiff bases)")
AnnotationAssertion(rdfs:comment goldbook:08887 "A polymer with only pendant azomethine groups is excluded."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08887 "The name azomethine is derived from the traditional names 'azo' for azanylylidene group \\(\\ce{-N=}\\) and methine' for the methanylylidene group \\(\\ce{-CH=}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08887 "The original distinction between polyazomethines and poly(Schiff base)s, which is that a group \\(\\ce{R}\\) in \\(\\ce{-N=CR-}\\) linkage cannot be hydrogen in a polyazomethine but can be hydrogen in a poly(Schiff base), making polyazomethines a subclass of poly(Schiff base)s, has nearly completely disappeared."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08887 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08887 "current"^^xsd:string)
Declaration(Class(goldbook:08888))
AnnotationAssertion(rdfs:label goldbook:08888 "polybenzimidazoles")
AnnotationAssertion(dcterms:description goldbook:08888 "Polymers composed of macromolecules containing benzimidazole groups in the backbone, such as groups (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08888 "Polybenzimidazoles are proton-conducting polymers with a high thermal stability that found applications as membranes for example in fuel cells or fibers for flame resistant clothes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08888 goldbook:08834)
AnnotationAssertion(mito:isMentionedBy goldbook:08888 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08888 "current"^^xsd:string)
Declaration(Class(goldbook:08889))
AnnotationAssertion(rdfs:label goldbook:08889 "polydiacetylenes")
AnnotationAssertion(dcterms:description goldbook:08889 "Polymer prepared from buta-1,3-diyne (diacetylene) or a substituted buta-1,3-diyne or both in admixture (source-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08889 "General formula of a regular polydiacetylene that is prepared by the photo-induced topochemical polymerization of a crystalline 1,3-diyne is as follows:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen or an alkyl, aryl or heteroaryl group."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08889 "Polydiacetylenes are a subclass of conjugated polymers and of polyacetylenes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08889 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08889 goldbook:08882)
AnnotationAssertion(mito:isMentionedBy goldbook:08889 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08889 "current"^^xsd:string)
Declaration(Class(goldbook:08890))
AnnotationAssertion(rdfs:label goldbook:08890 "poly(ethene-1,2-diyl)")
AnnotationAssertion(dcterms:description goldbook:08890 "Polymer composed of macromolecules exclusively consisting of ethene-1,2-diyl (formerly called vinylene) constitutional repeating units.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08890 "poly(acetylene) (source-based name)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08890 "poly(vinylene) (former structure-based name)")
AnnotationAssertion(rdfs:seeAlso goldbook:08890 goldbook:08882)
AnnotationAssertion(mito:isMentionedBy goldbook:08890 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08890 "current"^^xsd:string)
Declaration(Class(goldbook:08891))
AnnotationAssertion(rdfs:label goldbook:08891 "poly[3,4-(ethylenedioxy)thiophene]")
AnnotationAssertion(dcterms:description goldbook:08891 "Polymer prepared from 3,4-(ethylenedioxy)thiophene (source-based polymer name).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:08891 "PEDOT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08891 "poly{3,4-[ethylene-1,2-bis(oxy)]thiophene-2,5-diyl}")
AnnotationAssertion(rdfs:comment goldbook:08891 "PEDOT is an intrinsically conducting polythiophene class polymer that is mostly used as a blend with sulfonated polystyrene (PEDOT-PSS), which is produced by oxidative polymerization of 3,4-[ethylene-1,2-bis(oxy)]thiophene (traditional name 3,4-(ethylenedioxy)thiophene, therefore abbreviated as EDOT) in an aqueous solution of partly neutralized sulfonated polystyrene."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08891 "The PEDOT-PSS is stable in ambient environment, water-dispersible thus processable from aqueous systems and considered as a non-toxic material for the flexible and printed organic electronics and photovoltaics. PEDOT-PSS belongs among the most often used materials for organic as well as organic/inorganic electronic and photovoltaic devices, for antistatic and electrochromic coatings and films, and also exhibits the thermoelectric effect."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08891 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08891 "current"^^xsd:string)
Declaration(Class(goldbook:08892))
AnnotationAssertion(rdfs:label goldbook:08892 "polyfluorenes")
AnnotationAssertion(dcterms:description goldbook:08892 "Polymers composed of macromolecules containing fluorenediyl or substituted fluorenediyl (mainly 2,7-diyl) constitutional repeating units in the backbone (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08892 "Polyfluorenes are used as photoconducting, photoluminescent and electroluminescent materials for organic light-emitting diodes, organic thin film transistors and polymer solar cells."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08892 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08892 "current"^^xsd:string)
Declaration(Class(goldbook:08893))
AnnotationAssertion(rdfs:label goldbook:08893 "polyimides")
AnnotationAssertion(dcterms:description goldbook:08893 "Polymers composed of macromolecules containing cyclic dicarboximide groupings in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\) and \\(\\ce{R^{4}}\\) are groups with connectivity one, two, three, and four, respectively (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08893 "In electronics, polyimides are mainly used as highly flexible insulating and passivation layers in integrated circuits and microelectronic chips."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08893 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08893 "current"^^xsd:string)
Declaration(Class(goldbook:08894))
AnnotationAssertion(rdfs:label goldbook:08894 "polyoxadiazoles")
AnnotationAssertion(dcterms:description goldbook:08894 "Polymers composed of macromolecules containing exclusively oxadiazole rings in the backbone (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08894 "Poly(1,2,3-oxadiazole-4,5-diyl) and poly(1,3,4-oxadiazole-2,5-diyl) are conjugated polymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08894 goldbook:08785)
AnnotationAssertion(mito:isMentionedBy goldbook:08894 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08894 "current"^^xsd:string)
Declaration(Class(goldbook:08895))
AnnotationAssertion(rdfs:label goldbook:08895 "polyphenylenes")
AnnotationAssertion(dcterms:description goldbook:08895 "Polymers composed of macromolecules containing exclusively \\(\\upsigma\\)-bonded benzene or substituted benzene rings in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\) and \\(\\ce{R^{4}}\\) are each hydrogen or an univalent group (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08895 "Polyphenylenes are a subclass of polyarylenes and also a subclass of conjugated polymers except for poly(1,3-phenylene)s which are not conjugated polymers. "^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08895 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08895 goldbook:08884)
AnnotationAssertion(mito:isMentionedBy goldbook:08895 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08895 "current"^^xsd:string)
Declaration(Class(goldbook:08896))
AnnotationAssertion(rdfs:label goldbook:08896 "polyphenylenethynylenes")
AnnotationAssertion(dcterms:description goldbook:08896 "Polymer composed of macromolecules containing exclusively alternating phenylene or substituted phenylene and ethynediyl (formerly ethynylene) constitutional repeating units in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\) and \\(\\ce{R^{4}}\\) are each hydrogen, alkyl, aryl, halogen, trialkylsilyl etc. (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08896 "Polyphenylenethynylenes are a subclass of polyarylenethynylenes and also a subclass of conjugated polymers (except for those containing 1,3-phenylene constitutional repeating units)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08896 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08896 goldbook:08885)
AnnotationAssertion(mito:isMentionedBy goldbook:08896 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08896 "current"^^xsd:string)
Declaration(Class(goldbook:08897))
AnnotationAssertion(rdfs:label goldbook:08897 "polyphenylenevinylenes")
AnnotationAssertion(dcterms:description goldbook:08897 "Polymers composed of macromolecules containing exclusively alternating phenylene or substituted phenylene and ethene-1,2-diyl (formerly vinylene) or substituted ethene-1,2-diyl constitutional repeating units in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\), \\(\\ce{R^{4}}\\), \\(\\ce{R^{5}}\\) and \\(\\ce{R^{6}}\\) are each hydrogen, alkyl, aryl, heteroaryl, halogen, trialkylsilyl, etc. (structure-based polymer class name).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08897 "PPV")
AnnotationAssertion(rdfs:comment goldbook:08897 "Polyphenylenevinylenes are a subclass of polyarylenevinylenes and also a subclass of conjugated polymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08897 "PPVs found applications mainly in the fields of photovoltaic cells and electroluminescent devices."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08897 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08897 goldbook:08886)
AnnotationAssertion(mito:isMentionedBy goldbook:08897 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08897 "current"^^xsd:string)
Declaration(Class(goldbook:08898))
AnnotationAssertion(rdfs:label goldbook:08898 "polypyrroles")
AnnotationAssertion(dcterms:description goldbook:08898 "Polymers composed of macromolecules with backbones composed of pyrrole rings (structure-based polymer class name definition).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08898 "Ppy")
AnnotationAssertion(rdfs:comment goldbook:08898 "Polypyrroles belong among conjugated polymers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08898 "Polypyrroles found applications mainly in the field of sensors. Applications in electronic devices are still limited owing to insufficient stability of PPy."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08898 goldbook:08785)
AnnotationAssertion(mito:isMentionedBy goldbook:08898 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08898 "current"^^xsd:string)
Declaration(Class(goldbook:08899))
AnnotationAssertion(rdfs:label goldbook:08899 "polysilanes")
AnnotationAssertion(dcterms:description goldbook:08899 "Polymers composed of macromolecules containing exclusively silicon atoms in the backbone:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen or an alkyl, aryl or heteroaryl group (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08899 "Polysilanes were earlier named polysilylenes. A use of this term is discouraged."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08899 "Polysilanes are \\(\\upsigma\\)-conjugated polymers which show a good photoconductivity, however, they degrade when exposed to UV light."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08899 goldbook:08785)
AnnotationAssertion(mito:isMentionedBy goldbook:08899 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08899 "current"^^xsd:string)
Declaration(Class(goldbook:08900))
AnnotationAssertion(rdfs:label goldbook:08900 "polytetrazines")
AnnotationAssertion(dcterms:description goldbook:08900 "Polymers composed of macromolecules containing tetrazine or hydrogenated tetrazine rings in the backbone (structure-based polymer class name):")
AnnotationAssertion(rdfs:comment goldbook:08900 "A typical polytetrazine contains 1,2,4,5-tetrazine or hydrogenated 1,2,4,5-tetrazine rings since 1,2,3,4- as well as 1,2,3,5-tetrazine rings are unstable."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08900 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08900 "current"^^xsd:string)
Declaration(Class(goldbook:08901))
AnnotationAssertion(rdfs:label goldbook:08901 "polythiadiazoles")
AnnotationAssertion(dcterms:description goldbook:08901 "Polymers composed of macromolecules containing thiadiazole rings in the backbone (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08901 "Poly(1,2,3-thiadiazole-4,5-diyl) and poly(1,3,4-thiadiazole-2,5-diyl) are conjugated polymers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08901 goldbook:08785)
AnnotationAssertion(mito:isMentionedBy goldbook:08901 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08901 "current"^^xsd:string)
Declaration(Class(goldbook:08902))
AnnotationAssertion(rdfs:label goldbook:08902 "polythiazoles")
AnnotationAssertion(dcterms:description goldbook:08902 "Polymers composed of macromolecules containing thiazole rings in the backbone:  where R is hydrogen, alkyl, aryl, heteroaryl, substituted alkyl, substituted aryl or substituted heteroaryl (structure-based polymer class name).")
AnnotationAssertion(mito:isMentionedBy goldbook:08902 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08902 "current"^^xsd:string)
Declaration(Class(goldbook:08903))
AnnotationAssertion(rdfs:label goldbook:08903 "polythiophenes")
AnnotationAssertion(dcterms:description goldbook:08903 "Polymers composed of macromolecules containing exclusively thiophene rings in the backbone (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08903 "Poly(thiophene-2,5-diyl), often written as poly(thiophene), is the generic polythiophene."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08903 "Regular polymers of a monosubstituted thiophene are prepared by catalytic coupling polymerization of the corresponding thiophene derivative or its defined dimers (dimers mostly provide regular but regioirregular polymers, see the chart below). Oxidative polymerization of an asymmetric thiophene monomer gives an irregular polythiophene with considerably worse functional properties. "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08903 "Polythiophenes are a subclass of conjugated polymers. The highest practical applications has found poly[3,4-(ethylenedioxy)thiophene] (PEDOT). Regioregular poly(3-alkylthiophenes) are studied as materials for organic solar cells. They become conducting upon oxidative doping."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08903 goldbook:08785)
AnnotationAssertion(rdfs:seeAlso goldbook:08903 goldbook:08866)
AnnotationAssertion(rdfs:seeAlso goldbook:08903 goldbook:08875)
AnnotationAssertion(mito:isMentionedBy goldbook:08903 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08903 "current"^^xsd:string)
Declaration(Class(goldbook:08904))
AnnotationAssertion(rdfs:label goldbook:08904 "polyvinylcarbazoles")
AnnotationAssertion(dcterms:description goldbook:08904 "Polymers prepared from a vinylcarbazole or a substituted vinylcarbazole or both in admixture (source-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08904 "A typical polyvinylcarbazole is poly(N-vinylcarbazole) that is usually prepared by a radical or a coordination chain polymerization of N-vinylcarbazole."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08904 "Polyvinylcarbazoles are photoconducting polymers that transport charge carriers via carbazolyl pendant groups. They found wide applications, for example, in xerographic photocopying."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08904 goldbook:08850)
AnnotationAssertion(mito:isMentionedBy goldbook:08904 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08904 "current"^^xsd:string)
Declaration(Class(goldbook:08905))
AnnotationAssertion(rdfs:label goldbook:08905 "polyvinylenes")
AnnotationAssertion(dcterms:description goldbook:08905 "Polymers composed of macromolecules containing exclusively ethene-1,2-diyl (formerly vinylene) or substituted ethene-1,2-diyl constitutional repeating units in the backbone: \\[\\ce{-CR^{1}=CR^{2}-}\\] where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen or an alkyl, aryl, or heteroaryl group (structure-based polymer class name).")
AnnotationAssertion(rdfs:comment goldbook:08905 "Delocalization of electrons in conjugated chains gives to main-chain single bonds a partial character of double bonds, which restrict free rotations around these bonds which, therefore, show the cis-trans like isomerism. Four basic stereoregular polyvinylene chains can be derived: "^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08905 "Polyvinylenes are almost exclusively prepared by polymerization of acetylene derivatives. Therefore, based on the source, they are mostly polyacetylenes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08905 goldbook:08789)
AnnotationAssertion(rdfs:seeAlso goldbook:08905 goldbook:08882)
AnnotationAssertion(mito:isMentionedBy goldbook:08905 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08905 "current"^^xsd:string)
Declaration(Class(goldbook:08906))
AnnotationAssertion(rdfs:label goldbook:08906 "polyzwitterions")
AnnotationAssertion(dcterms:description goldbook:08906 "Polymers composed of macromolecules consisting of zwitterionic repeating units (structure-based polymer class name).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08906 "poly(inner salts)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08906 "polyamphions")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08906 "zwitterionic polymers")
AnnotationAssertion(rdfs:comment goldbook:08906 "Polyzwitterions are mostly polyelectrolytes, since their zwitterionic groups are usually located in pendant groups (not in main-chain groups)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08906 "Polybetaines are a subclass of polyzwitterions."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08906 "Unlike polyampholytes, polyzwitterions have anions and cations in the same monomeric unit."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08906 "From the chemical structure point of view, a zwitterionic polymer is an ampholytic polymer containing ionic groups of opposite sign, commonly in the same pendant group."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08906 doi:10.1515/pac-2020-0501)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08906 "current"^^xsd:string)
Declaration(Class(goldbook:08907))
AnnotationAssertion(rdfs:label goldbook:08907 "activated-monomer polymerization")
AnnotationAssertion(dcterms:description goldbook:08907 "Chain polymerization in which propagation involves reaction between a growing-chain end and an activated monomer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08907 "AMP")
AnnotationAssertion(rdfs:comment goldbook:08907 "The activator in activated-monomer polymerization should not be referred to as a catalyst unless it is established that it is a catalyst."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08907 "The activator in activated-monomer polymerization should not be referred to as a catalyst unless it is established that it is a catalyst."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08907 goldbook:08936)
AnnotationAssertion(rdfs:seeAlso goldbook:08907 goldbook:08989)
AnnotationAssertion(rdfs:seeAlso goldbook:08907 goldbook:08990)
AnnotationAssertion(rdfs:seeAlso goldbook:08907 goldbook:08966)
AnnotationAssertion(rdfs:seeAlso goldbook:08907 goldbook:08944)
AnnotationAssertion(mito:isMentionedBy goldbook:08907 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08907 "current"^^xsd:string)
Declaration(Class(goldbook:08908))
AnnotationAssertion(rdfs:label goldbook:08908 "controlled polymerization")
AnnotationAssertion(dcterms:description goldbook:08908 "Term indicating control of a certain kinetic feature of a polymerization or structural aspect of the polymer molecules formed, or both.")
AnnotationAssertion(rdfs:comment goldbook:08908 "The expression 'controlled polymerization' is sometimes used to describe a radical or ionic polymerization in which reversible deactivation of the chain carriers is an essential component of the mechanism, interrupting the propagation to secure control of one or more kinetic features of the polymerization or one or more structural aspects of the macromolecules formed, or both."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08908 "The expression controlled radical polymerization is sometimes used to describe a radical polymerization conducted in the presence of reagents that lead to, e.g., atom-transfer radical polymerization (ATRP), aminoxyl-mediated radical polymerization (AMRP), or reversible-addition-fragmentation chain transfer (RAFT) polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08908 "Generally, the adjective 'controlled' should not be used without specifying the particular kinetic or structural feature that is subject to control."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08917)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08979)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08985)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08973)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08913)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08912)
AnnotationAssertion(rdfs:seeAlso goldbook:08908 goldbook:08935)
AnnotationAssertion(mito:isMentionedBy goldbook:08908 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08908 "current"^^xsd:string)
Declaration(Class(goldbook:08909))
AnnotationAssertion(rdfs:label goldbook:08909 "degenerative-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:08909 "Reversible-deactivation polymerization in which the deactivation of the active species involves degenerative chain transfer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08909 "DTP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08909 "degenerate-transfer polymerization")
AnnotationAssertion(rdfs:comment goldbook:08909 "This term has often been specifically associated with degenerative chain-transfer radical polymerization. However, there are also degenerative chain-transfer processes involving non-radical mechanisms (e.g., cationic, anionic, or coordination polymerization)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08909 goldbook:08912)
AnnotationAssertion(rdfs:seeAlso goldbook:08909 goldbook:08995)
AnnotationAssertion(rdfs:seeAlso goldbook:08909 goldbook:08951)
AnnotationAssertion(rdfs:seeAlso goldbook:08909 goldbook:08929)
AnnotationAssertion(mito:isMentionedBy goldbook:08909 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08909 "current"^^xsd:string)
Declaration(Class(goldbook:08910))
AnnotationAssertion(rdfs:label goldbook:08910 "group-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:08910 "Chain polymerization in which a specific atom or group is intramolecularly transferred to remain associated with the active chain-end during the course of polymerization.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08910 "GTP")
AnnotationAssertion(rdfs:comment goldbook:08910 "Group-transfer polymerization is most often a reversible-deactivation polymerization or a coordination addition polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08910 "The term group-transfer polymerization is often specifically associated with polymerization of (meth)acrylates and acrylamides initiated by silyl ketene acetals such as 1-methoxy-2-methyl-1-(trimethylsiloxy)prop-1-ene (traditional name is methyl trimethylsilyl dimethylketene acetal) and catalysed by nucleophiles."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08910 "Other forms of chain polymerization commonly referred to as group-transfer polymerizations include catalyst-transfer polymerization and rare-earth-mediated or lanthanide-mediated coordination polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08910 goldbook:08977)
AnnotationAssertion(rdfs:seeAlso goldbook:08910 goldbook:09010)
AnnotationAssertion(rdfs:seeAlso goldbook:08910 goldbook:08996)
AnnotationAssertion(rdfs:seeAlso goldbook:08910 goldbook:09008)
AnnotationAssertion(rdfs:seeAlso goldbook:08910 goldbook:08912)
AnnotationAssertion(mito:isMentionedBy goldbook:08910 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08910 "current"^^xsd:string)
Declaration(Class(goldbook:08911))
AnnotationAssertion(rdfs:label goldbook:08911 "insertion polymerization")
AnnotationAssertion(dcterms:description goldbook:08911 "Chain polymerization in which monomer units are sequentially inserted into a specific site within a polymer structure with retention of chain-end functionality.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08911 "polyinsertion")
AnnotationAssertion(rdfs:comment goldbook:08911 "The term insertion polymerization is most commonly used in the context of coordination polymerization but is occasionally also used to describe some forms of reversible-deactivation radical polymerization such as RAFT polymerization and aminoxyl-mediated radical polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08911 "The term polyinsertion is almost exclusively used in the context of coordination polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08911 goldbook:08935)
AnnotationAssertion(rdfs:seeAlso goldbook:08911 goldbook:08917)
AnnotationAssertion(rdfs:seeAlso goldbook:08911 goldbook:08995)
AnnotationAssertion(rdfs:seeAlso goldbook:08911 goldbook:08997)
AnnotationAssertion(rdfs:seeAlso goldbook:08911 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08911 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08911 "current"^^xsd:string)
Declaration(Class(goldbook:08912))
AnnotationAssertion(rdfs:label goldbook:08912 "reversible-deactivation polymerization")
AnnotationAssertion(dcterms:description goldbook:08912 "Chain polymerization, propagated by chain carriers that are deactivated reversibly, bringing them into active-dormant equilibria of which there might be more than one.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08912 "RDP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08912 "controlled reversible-deactivation polymerization.")
AnnotationAssertion(rdfs:seeAlso goldbook:08912 goldbook:08910)
AnnotationAssertion(rdfs:seeAlso goldbook:08912 goldbook:08981)
AnnotationAssertion(rdfs:seeAlso goldbook:08912 goldbook:08988)
AnnotationAssertion(rdfs:seeAlso goldbook:08912 goldbook:08999)
AnnotationAssertion(rdfs:seeAlso goldbook:08912 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08912 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08912 "current"^^xsd:string)
Declaration(Class(goldbook:08913))
AnnotationAssertion(rdfs:label goldbook:08913 "controlled radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08913 "Term indicating control of a certain kinetic feature of a radical polymerization or structural aspect of the polymer molecules formed by radical polymerization, or both.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08913 "CRP")
AnnotationAssertion(rdfs:comment goldbook:08913 "The adjective 'controlled' should not be used without specifying the particular kinetic or structural feature that is subject to control."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08913 "The expression 'controlled radical polymerization' is sometimes used as a synonym for reversible-deactivation radical polymerization (RDRP), e.g., atom-transfer radical polymerization (ATRP), aminoxyl-mediated radical polymerization (AMRP), or reversible-addition-fragmentation chain-transfer (RAFT) polymerization. This is acceptable subject to the proviso stated in Note 1."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08913 "The term diffusion-controlled radical polymerization is sometimes used to indicate that the rate of termination is determined by the rate of diffusion of the active sites."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08913 goldbook:08917)
AnnotationAssertion(rdfs:seeAlso goldbook:08913 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08913 goldbook:08908)
AnnotationAssertion(rdfs:seeAlso goldbook:08913 goldbook:08935)
AnnotationAssertion(rdfs:seeAlso goldbook:08913 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08913 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08913 "current"^^xsd:string)
Declaration(Class(goldbook:08914))
AnnotationAssertion(rdfs:label goldbook:08914 "living radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08914 "Radical polymerization in which chain termination and irreversible chain transfer are absent.")
AnnotationAssertion(rdfs:comment goldbook:08914 "Radical polymerizations, controlled radical polymerizations and reversible-deactivation radical polymerizations are not living radical polymerizations as there is a non-zero probability of chain termination."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08914 "The term living radical polymerization can be used to refer to a hypothetical radical polymerization that occurs without chain termination."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08914 "Use of the adjectives pseudo-living, quasi-living, 'living' (within quotation marks) or other terms that containing the word living to describe a radical polymerization with only some living characteristics is deprecated."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08914 goldbook:08946)
AnnotationAssertion(rdfs:seeAlso goldbook:08914 goldbook:08913)
AnnotationAssertion(rdfs:seeAlso goldbook:08914 goldbook:08966)
AnnotationAssertion(rdfs:seeAlso goldbook:08914 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08914 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08914 "current"^^xsd:string)
Declaration(Class(goldbook:08915))
AnnotationAssertion(rdfs:label goldbook:08915 "radical ring-opening polymerization")
AnnotationAssertion(dcterms:description goldbook:08915 "Radical polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer.")
AnnotationAssertion(mito:isMentionedBy goldbook:08915 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08915 "current"^^xsd:string)
Declaration(Class(goldbook:08916))
AnnotationAssertion(rdfs:label goldbook:08916 "reversible-deactivation radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08916 "Chain polymerization, propagated by radicals that are deactivated reversibly, bringing them into active-dormant equilibria of which there might be more than one.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08916 "RDRP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08916 "controlled reversible-deactivation radical polymerization")
AnnotationAssertion(rdfs:comment goldbook:08916 "The abbreviated term controlled radical polymerization shall be permitted, provided that its context (i.e., the nature of the control) is specified at the first occurrence."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08916 "Names containing the word 'living' are deprecated. Definition 84 in the kinetics document stipulates that chain termination and irreversible chain transfer must be absent if a polymerization is to be regarded as living. Examples of deprecated terms include living radical polymerization, controlled/living polymerization and quasi-living polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08916 "Atom-transfer radical polymerization, reversible-addition-fragmentation chain-transfer polymerization, and stable-radical-mediated polymerization all fall into this polymerization category."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08916 "When the equilibria are established rapidly compared to the rate of propagation, the process may show many of the observable characteristics associated with living polymerization. One consequence of rapid equilibration is that it may become possible to exert control over the shape of the chain-length distribution, prepare polymers of low dispersity (i.e., polymers with a high degree of uniformity), and extend chains to form block copolymers, the block lengths of which are of low dispersity, by the sequential addition of monomers. Although some termination is inevitably taking place, the equilibrium between the remaining propagating radicals and dormant species is maintained."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08916 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08916 goldbook:08913)
AnnotationAssertion(rdfs:seeAlso goldbook:08916 goldbook:08952)
AnnotationAssertion(rdfs:seeAlso goldbook:08916 goldbook:08914)
AnnotationAssertion(rdfs:seeAlso goldbook:08916 goldbook:08935)
AnnotationAssertion(rdfs:seeAlso goldbook:08916 goldbook:08921)
AnnotationAssertion(mito:isMentionedBy goldbook:08916 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08916 "current"^^xsd:string)
Declaration(Class(goldbook:08917))
AnnotationAssertion(rdfs:label goldbook:08917 "aminoxyl-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08917 "Stable-radical-mediated polymerization in which the deactivation of the radicals involves reversible coupling with aminoxyl radicals.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08917 "AMRP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08917 "aminoxyl-mediated polymerization")
AnnotationAssertion(rdfs:comment goldbook:08917 "The term 'nitroxide' is deprecated in IUPAC nomenclature. The recommended term is 'aminoxyl'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08917 goldbook:08921)
AnnotationAssertion(mito:isMentionedBy goldbook:08917 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08917 "current"^^xsd:string)
Declaration(Class(goldbook:08918))
AnnotationAssertion(rdfs:label goldbook:08918 "cobalt-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08918 "Reversible-deactivation radical polymerization mediated by a cobalt complex.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08918 "CMRP")
AnnotationAssertion(rdfs:comment goldbook:08918 "The mechanism of cobalt-mediated radical polymerization may involve stable-radical-mediated polymerization (SRMP), degenerative chain-transfer radical polymerization, (DTRP), atom-transfer radical polymerization (ATRP) or some combination of these depending on the specific reagents and reaction conditions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08918 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08918 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08918 goldbook:08929)
AnnotationAssertion(rdfs:seeAlso goldbook:08918 goldbook:08920)
AnnotationAssertion(rdfs:seeAlso goldbook:08918 goldbook:08921)
AnnotationAssertion(mito:isMentionedBy goldbook:08918 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08918 "current"^^xsd:string)
Declaration(Class(goldbook:08919))
AnnotationAssertion(rdfs:label goldbook:08919 "iniferter process")
AnnotationAssertion(dcterms:description goldbook:08919 "Stable-radical-mediated polymerization where the initiator and dormant species are iniferters.")
AnnotationAssertion(rdfs:comment goldbook:08919 "In the iniferter process the dominant mechanism for control is stable-radical mediated polymerization (SRMP) but the control mechanism may also involve degenerate chain transfer radical polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08919 goldbook:08921)
AnnotationAssertion(rdfs:seeAlso goldbook:08919 goldbook:08929)
AnnotationAssertion(rdfs:seeAlso goldbook:08919 goldbook:08952)
AnnotationAssertion(rdfs:seeAlso goldbook:08919 goldbook:08955)
AnnotationAssertion(rdfs:seeAlso goldbook:08919 goldbook:08964)
AnnotationAssertion(mito:isMentionedBy goldbook:08919 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08919 "current"^^xsd:string)
Declaration(Class(goldbook:08920))
AnnotationAssertion(rdfs:label goldbook:08920 "organometallic-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08920 "Reversible-deactivation radical polymerization mediated by an organometallic reagent.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08920 "OMRP")
AnnotationAssertion(rdfs:comment goldbook:08920 "The term organometallic-meditated radical polymerization is not usually used in describing an atom-transfer radical polymerization process."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08920 "The mechanism of organometallic-meditated radical polymerization may involve stable-radical-mediated polymerization (SRMP), degenerative chain-transfer radical polymerization (DTRP), atom-transfer radical polymerization (ATRP) or some combination of these depending on the specific reagents and reaction conditions."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08920 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08920 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08920 goldbook:08918)
AnnotationAssertion(rdfs:seeAlso goldbook:08920 goldbook:08929)
AnnotationAssertion(rdfs:seeAlso goldbook:08920 goldbook:08921)
AnnotationAssertion(mito:isMentionedBy goldbook:08920 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08920 "current"^^xsd:string)
Declaration(Class(goldbook:08921))
AnnotationAssertion(rdfs:label goldbook:08921 "stable-radical-mediated polymerization")
AnnotationAssertion(dcterms:description goldbook:08921 "Reversible-deactivation radical polymerization in which the deactivation involves reversible coupling with stable (persistent) radicals.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08921 "SRMP")
AnnotationAssertion(rdfs:comment goldbook:08921 "Processes known to involve stable-radical-mediated polymerization include aminoxyl-mediated radical polymerization and some forms of organometallic-mediated radical polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08921 "The use of the term 'free radical' is deprecated in IUPAC terminology."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08921 "Initialization may involve decomposition of an initiator in the presence of monomer and the stable radical. Polymerization then starts when there is complete consumption of the stable radical."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08921 "The species identified as stable radicals in stable-radical-mediated polymerization are not necessarily stable in a thermodynamic sense."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08921 goldbook:08956)
AnnotationAssertion(rdfs:seeAlso goldbook:08921 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08921 goldbook:08917)
AnnotationAssertion(rdfs:seeAlso goldbook:08921 goldbook:08920)
AnnotationAssertion(rdfs:seeAlso goldbook:08921 goldbook:08970)
AnnotationAssertion(mito:isMentionedBy goldbook:08921 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08921 "current"^^xsd:string)
Declaration(Class(goldbook:08922))
AnnotationAssertion(rdfs:label goldbook:08922 "reversible-addition-fragmentation radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08922 "Reversible-deactivation radical polymerization in which the dormant species is a stable (persistent) radical and the deactivation step involves reversible fragmentation.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08922 "RAFRP")
AnnotationAssertion(rdfs:comment goldbook:08922 "In some cases, the dormant polymer may undergo reversible coupling."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08922 "Initialization usually involves decomposition of an initiator in the presence of monomer and the reagent. Polymerization commences when there is complete consumption of the mediator by initiator-derived radicals."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08922 goldbook:08956)
AnnotationAssertion(rdfs:seeAlso goldbook:08922 goldbook:08935)
AnnotationAssertion(rdfs:seeAlso goldbook:08922 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08922 goldbook:08952)
AnnotationAssertion(mito:isMentionedBy goldbook:08922 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08922 "current"^^xsd:string)
Declaration(Class(goldbook:08923))
AnnotationAssertion(rdfs:label goldbook:08923 "carbonothioyl-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08923 "Reversible-addition-fragmentation radical polymerization mediated by a carbonothioyl compound.")
AnnotationAssertion(rdfs:comment goldbook:08923 "The commonly used term, thiocarbonyl, is not consistent with IUPAC nomenclature."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08923 goldbook:08922)
AnnotationAssertion(mito:isMentionedBy goldbook:08923 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08923 "current"^^xsd:string)
Declaration(Class(goldbook:08924))
AnnotationAssertion(rdfs:label goldbook:08924 "atom-transfer radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08924 "Reversible-deactivation radical polymerization in which the deactivation of the radicals involves reversible atom-transfer or reversible group transfer to usually, though not exclusively, transition-metal complexes.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08924 "ATRP")
AnnotationAssertion(rdfs:comment goldbook:08924 "The activator is often incorrectly termed a catalyst. The term catalyst should only be used when referring to a species which is not changed as a consequence of reaction."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08924 "There are various forms of ATRP that differ in details of the intimate mechanism, the reaction conditions and/or the reagents used. These include:Conventional, traditional or normal ATRP where the initial reaction mixture comprises an initiator (typically an alkyl halide) and an activator (the species on right-hand side of Figure).Reverse ATRP where the initial reaction mixture comprises a conventional initiator as a source of radicals (e.g., a dialkyldiazene or a peroxide) and a deactivator (the species on left hand side of Figure).AGET-ATRP (Activator Generated by Electron Transfer) where the activator is generated in situ by an electron transfer from a reducing agent at the commencement of the polymerization.ARGET-ATRP (Activator ReGenerated by Electron Transfer) where the activator is continuously regenerated by electron transfer from a reducing agent.lICAR-ATRP (Initiators for Continuous Activator Regeneration) - ARGET-ATRP where the reducing agent is a radical derived from a conventional initiator (e.g., a dialkyldiazene).SARA-ATRP (Supplemental Activators and Reducing Agents) where the polymerization commences with the activator (e.g., a zero-valent metal or an inorganic sulfite) which is a both a supplemental activator and a reducing agent for the deactivator.eATRP (electrochemically-mediated ATRP) where the activator is continuously regenerated by electrical current.photoATRP (photochemically-mediated ATRP) where the activator is continuously regenerated by photoreduction. The reduction can be facilitated by the presence of electron donors.mechanoATRP (mechanically-mediated ATRP) where the activator is continuously regenerated by mechanical forces through the use of the piezoelectric effect or ultrasound.PET-ATRP (photoinduced electron transfer ATRP) where activation involves electron-transfer from a photo-excited activator to an initiator which then dissociates to give an initiating species.O-ATRP (organic ATRP), a form of PET-ATRP where the activator is an organic photoredox catalyst."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08924 "The term ATRP (unqualified) usually refers to copper-mediated ISET-ATRP."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08924 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08924 goldbook:08949)
AnnotationAssertion(rdfs:seeAlso goldbook:08924 goldbook:08959)
AnnotationAssertion(rdfs:seeAlso goldbook:08924 goldbook:08925)
AnnotationAssertion(rdfs:seeAlso goldbook:08924 goldbook:08926)
AnnotationAssertion(rdfs:seeAlso goldbook:08924 goldbook:08927)
AnnotationAssertion(mito:isMentionedBy goldbook:08924 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08924 "current"^^xsd:string)
Declaration(Class(goldbook:08925))
AnnotationAssertion(rdfs:label goldbook:08925 "inner-sphere electron transfer atom-transfer radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08925 "Atom-transfer radical polymerization where the activation step involves direct atom or group transfer.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08925 "ISET-ATRP")
AnnotationAssertion(rdfs:comment goldbook:08925 "ATRP is sometimes used as a synonym for ISET-ATRP. The term ISET-ATRP can be used to specify that the mechanism of ATRP involves direct atom or group transfer as distinct from single electron transfer followed by atom or group transfer or OSET-ATRP."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08925 goldbook:08927)
AnnotationAssertion(rdfs:seeAlso goldbook:08925 goldbook:08924)
AnnotationAssertion(mito:isMentionedBy goldbook:08925 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08925 "current"^^xsd:string)
Declaration(Class(goldbook:08926))
AnnotationAssertion(rdfs:label goldbook:08926 "non-metal-mediated atom-transfer radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08926 "Atom-transfer radical polymerization in which the deactivation of the radicals involves reversible atom transfer or reversible group transfer to a non-metallic reagent.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08926 "NM-ATRP")
AnnotationAssertion(rdfs:comment goldbook:08926 "The activator is often incorrectly termed a catalyst. The term catalyst should only be used when referring to a species which is not changed as a consequence of reaction being considered."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08926 "NM-ATRP may be referred to as ATRP."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08926 "There are various forms of NM-ATRP that differ in details of the intimate mechanism, the reaction conditions and/or the reagents used. These include: RCTP (reversible chain-transfer-catalyzed polymerization). The group transferred (\\(\\ce{X}\\)) is often iodine and examples of the activator (\\(\\ce{R-X}\\)) are certain nitrogen, phosphorus, germanium, or tin compounds, which include germanium tetraiodide and 1-iodopyrrolidine-2,5-dione (traditional name is N-iodosuccinimide). Use of the term RCTP is deprecated. The mechanism is proposed to involve inner-sphere electron transfer atom-transfer radical polymerization (ISET-ATRP).RCMP (reversible-complexation-mediated radical polymerization) where the activator (typically an alkyl amine) reacts with an initiator (typically an alkyl iodide) by molecule-assisted homolysis to form the initiating species and an activator-complex.O-ATRP (organocatalyzed atom-transfer radical polymerization). A photochemically-mediated ATRP in which an organic photoredox catalyst such as perylene, a 5,10-diaryl-5,10-dihydrophenazine or a 10-aryl-10H-phenoxazine is used as the activator. The mechanism is proposed to involve outer-sphere electron transfer atom-transfer radical polymerization (OSET-ATRP)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08926 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08926 goldbook:08949)
AnnotationAssertion(rdfs:seeAlso goldbook:08926 goldbook:08959)
AnnotationAssertion(rdfs:seeAlso goldbook:08926 goldbook:08925)
AnnotationAssertion(rdfs:seeAlso goldbook:08926 goldbook:08927)
AnnotationAssertion(mito:isMentionedBy goldbook:08926 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08926 "current"^^xsd:string)
Declaration(Class(goldbook:08927))
AnnotationAssertion(rdfs:label goldbook:08927 "outer-sphere electron transfer ATRP")
AnnotationAssertion(dcterms:description goldbook:08927 "Atom-transfer radical polymerization where the activation step involves consecutive single electron transfer and atom or group transfer.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08927 "OSET-ATRP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08927 "single-electron-transfer RDRP (SET-RDRP)")
AnnotationAssertion(rdfs:comment goldbook:08927 "The terms SET-RDRP (single-electron-transfer reversible-deactivation radical polymerization), SET-LRP (single-electron-transfer living radical polymerization), and zero-valent metal-mediated polymerization (e.g., \\(\\ce{Cu^{0}}\\)-mediated radical polymerization) are sometimes used to describe a process where the polymerization commences with the activator in the form of a zero-valent metal, e.g., \\(\\ce{Cu^{0}}\\). The use of terms that might imply an outer sphere electron-transfer mechanism without evidence that the reaction proceeds by OSET-ATRP is deprecated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08927 "Terms containing the phrase 'living radical polymerization' are deprecated."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08927 "OSET-ATRP may be referred to as ATRP."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08927 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08927 goldbook:08925)
AnnotationAssertion(mito:isMentionedBy goldbook:08927 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08927 "current"^^xsd:string)
Declaration(Class(goldbook:08928))
AnnotationAssertion(rdfs:label goldbook:08928 "transition-metal-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08928 "Reversible-deactivation radical polymerization mediated by transition-metal complexes or organometallic compounds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08928 "transition-metal-mediated reversible-deactivation radical polymerization")
AnnotationAssertion(rdfs:comment goldbook:08928 "Transition metal mediated polymerization is an overarching term for atom-transfer radical polymerization (ATRP) and organometallic-mediated radical polymerization (OMRP). It is sometimes used as a synonym for transition-metal-mediated atom-transfer radical polymerization. This use of the term in that context without explanation is deprecated since it also includes organometallic-mediated radical polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08928 "Cobalt-mediated radical polymerization is usually a form of organometallic-mediated radical polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08928 goldbook:08918)
AnnotationAssertion(rdfs:seeAlso goldbook:08928 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08928 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08928 goldbook:08920)
AnnotationAssertion(mito:isMentionedBy goldbook:08928 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08928 "current"^^xsd:string)
Declaration(Class(goldbook:08929))
AnnotationAssertion(rdfs:label goldbook:08929 "degenerative chain-transfer radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08929 "Reversible-deactivation radical polymerization in which the deactivation of the radicals involves degenerative transfer (DT) of a group (or atom).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08929 "DTRP")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08929 "degenerate chain-transfer radical polymerization")
AnnotationAssertion(rdfs:comment goldbook:08929 "Intermediate species may be present as, for example, in reversible-addition-fragmentation chain-transfer polymerization (RAFT polymerization)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08929 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08929 goldbook:08951)
AnnotationAssertion(rdfs:seeAlso goldbook:08929 goldbook:08930)
AnnotationAssertion(rdfs:seeAlso goldbook:08929 goldbook:08931)
AnnotationAssertion(rdfs:seeAlso goldbook:08929 goldbook:08932)
AnnotationAssertion(rdfs:seeAlso goldbook:08929 goldbook:08933)
AnnotationAssertion(rdfs:seeAlso goldbook:08929 goldbook:08935)
AnnotationAssertion(mito:isMentionedBy goldbook:08929 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08929 "current"^^xsd:string)
Declaration(Class(goldbook:08930))
AnnotationAssertion(rdfs:label goldbook:08930 "iodine-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:08930 "Reversible-deactivation radical polymerization mediated by an iodo-compound.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08930 "ITP")
AnnotationAssertion(rdfs:comment goldbook:08930 "Where the initial polymerization mixture comprises a conventional initiator (e.g., a dialkyldiazene or a peroxide) and molecular iodine, the term RITP is commonly used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08930 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08930 goldbook:08934)
AnnotationAssertion(mito:isMentionedBy goldbook:08930 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08930 "current"^^xsd:string)
Declaration(Class(goldbook:08931))
AnnotationAssertion(rdfs:label goldbook:08931 "organobismuthane-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08931 "Reversible-deactivation radical polymerization mediated by an organobismuthane compound.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08931 "BIRP")
AnnotationAssertion(rdfs:seeAlso goldbook:08931 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08931 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08931 "current"^^xsd:string)
Declaration(Class(goldbook:08932))
AnnotationAssertion(rdfs:label goldbook:08932 "organostibane-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08932 "Reversible-deactivation radical polymerization mediated by an organostibane compound.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08932 "SBRP")
AnnotationAssertion(rdfs:seeAlso goldbook:08932 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08932 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08932 "current"^^xsd:string)
Declaration(Class(goldbook:08933))
AnnotationAssertion(rdfs:label goldbook:08933 "organotellurium-mediated radical polymerization")
AnnotationAssertion(dcterms:description goldbook:08933 "Reversible-deactivation radical polymerization mediated by an organotellurium compound.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08933 "TERP")
AnnotationAssertion(rdfs:comment goldbook:08933 "The dominant mechanism of TERP thought to be degenerative chain-transfer radical polymerization (DTRP). However, at high temperature conditions or under photochemical irradiation the mechanism may involve stable-radical-mediated polymerization (SRMP)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08933 goldbook:08916)
AnnotationAssertion(rdfs:seeAlso goldbook:08933 goldbook:08929)
AnnotationAssertion(rdfs:seeAlso goldbook:08933 goldbook:08921)
AnnotationAssertion(mito:isMentionedBy goldbook:08933 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08933 "current"^^xsd:string)
Declaration(Class(goldbook:08934))
AnnotationAssertion(rdfs:label goldbook:08934 "reverse iodine-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:08934 "Iodine-transfer polymerization where the initial polymerization mixture comprises a conventional initiator (e.g., an azo-compound or a peroxide) and molecular iodine.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08934 "RITP")
AnnotationAssertion(rdfs:seeAlso goldbook:08934 goldbook:08930)
AnnotationAssertion(mito:isMentionedBy goldbook:08934 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08934 "current"^^xsd:string)
Declaration(Class(goldbook:08935))
AnnotationAssertion(rdfs:label goldbook:08935 "reversible-addition-fragmentation chain-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:08935 "Degenerate-transfer radical polymerization in which chain activation and chain deactivation involve a degenerative chain-transfer process, which occurs by a two-step addition-fragmentation mechanism.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08935 "RAFT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08935 "RAFT polymerization")
AnnotationAssertion(rdfs:comment goldbook:08935 "The term RAFT polymerization (unqualified) usually refers to polymerization mediated by a carbonothioylsulfanyl RAFT agent."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08935 "There are various forms of RAFT polymerization that differ in details of the initiation mechanism, the reaction conditions and/or the reagents used. These include: Carbonothioylsulfanyl RAFT polymerization. The more commonly used term thiocarbonylthio RAFT polymerization is deprecated as it is inconsistent with IUPAC nomenclature. Examples of carbonothioylsulfanyl RAFT agents include certain dithioesters, trithiocarbonates, xanthates (dithiocarbonates), and dithiocarbamates with structure \\(\\ce{S=C(Z)-SR}\\), where \\(\\ce{Z}\\) is aryl, alkylsulfanyl, alkyloxy, or dialkylamino, respectively, and \\(\\ce{R}\\) is a homolytic leaving group.Macromonomer RAFT polymerization where the RAFT agent is a 'macromonomer' with structure \\(\\ce{CH2=C(Z)-CH2R}\\), where \\(\\ce{Z}\\) is usually \\(\\ce{-CO2alkyl}\\) or \\(\\ce{-CO2aryl}\\) and \\(\\ce{R}\\) is a homolytic leaving group. This form of RAFT polymerization is also known as sulfur-free RAFT polymerization.MADIX (macromolecular design by interchange of xanthate) where the RAFT agent is a xanthate.PhotoRAFT polymerization where radical generation involves direct photolysis of a carbonothioylsulfanyl-RAFT agent to give an initiating species and a carbonothioylsulfanyl radical.PET-RAFT (photo-induced energy or photo-electron-transfer RAFT) polymerization where radical generation involves photo-induced energy or electron transfer from a photoredox catalyst or a photosensitizer, respectively, to a carbonothioylsulfanyl-RAFT agent which then dissociates to give an initiating species.redoxRAFT where radical generation involves ISET or OSET between the RAFT agent and a reducing agent agent to give an initiating species.eRAFT polymerization where radical generation involves electrochemical reduction of the RAFT agent either directly or through a redox mediator."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08935 goldbook:08929)
AnnotationAssertion(rdfs:seeAlso goldbook:08935 goldbook:08968)
AnnotationAssertion(rdfs:seeAlso goldbook:08935 goldbook:08941)
AnnotationAssertion(rdfs:seeAlso goldbook:08935 goldbook:08943)
AnnotationAssertion(rdfs:seeAlso goldbook:08935 goldbook:08951)
AnnotationAssertion(rdfs:seeAlso goldbook:08935 goldbook:08959)
AnnotationAssertion(mito:isMentionedBy goldbook:08935 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08935 "current"^^xsd:string)
Declaration(Class(goldbook:08936))
AnnotationAssertion(rdfs:label goldbook:08936 "activated monomer")
AnnotationAssertion(dcterms:description goldbook:08936 "Reactive species generated reversibly from a monomer.")
AnnotationAssertion(rdfs:comment goldbook:08936 "Most frequently, the activated monomer is an anionic or cationic species."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08936 goldbook:08907)
AnnotationAssertion(rdfs:seeAlso goldbook:08936 goldbook:08989)
AnnotationAssertion(rdfs:seeAlso goldbook:08936 goldbook:08990)
AnnotationAssertion(mito:isMentionedBy goldbook:08936 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08936 "current"^^xsd:string)
Declaration(Class(goldbook:08937))
AnnotationAssertion(rdfs:label goldbook:08937 "addition-fragmentation chain transfer")
AnnotationAssertion(dcterms:description goldbook:08937 "Chain-transfer process that proceeds by a propagating species adding to a chain-transfer agent to form an intermediate that then fragments to provide an initiating species.")
AnnotationAssertion(rdfs:seeAlso goldbook:08937 goldbook:08959)
AnnotationAssertion(rdfs:seeAlso goldbook:08937 goldbook:08966)
AnnotationAssertion(mito:isMentionedBy goldbook:08937 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08937 "current"^^xsd:string)
Declaration(Class(goldbook:08938))
AnnotationAssertion(rdfs:label goldbook:08938 "catalyst precursor")
AnnotationAssertion(dcterms:description goldbook:08938 "Coordination compound that by reaction with an activator or cocatalyst provides an active catalyst during initialization of coordination polymerization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08938 "initiator (in coordination polymerization)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08938 "precatalyst (in coordination polymerization)")
AnnotationAssertion(rdfs:seeAlso goldbook:08938 goldbook:08995)
AnnotationAssertion(rdfs:seeAlso goldbook:08938 goldbook:08956)
AnnotationAssertion(mito:isMentionedBy goldbook:08938 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08938 "current"^^xsd:string)
Declaration(Class(goldbook:08939))
AnnotationAssertion(rdfs:label goldbook:08939 "catalytic chain transfer")
AnnotationAssertion(dcterms:description goldbook:08939 "Chain-transfer process involving transfer of an atom or group to a reagent (the catalyst) that in turn transfers that group to a monomer to reinitiate polymerization and regenerate the original reagent.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08939 "CCT")
AnnotationAssertion(rdfs:comment goldbook:08939 "An example of polymerization with catalytic chain transfer is radical polymerization in the presence of certain square-planar cobalt complexes."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08939 goldbook:08920)
AnnotationAssertion(rdfs:seeAlso goldbook:08939 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08939 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08939 "current"^^xsd:string)
Declaration(Class(goldbook:08940))
AnnotationAssertion(rdfs:label goldbook:08940 "catalytic chain termination")
AnnotationAssertion(dcterms:description goldbook:08940 "Chain termination process involving transfer of a group to a reagent (the catalyst) that in turn transfers that group to a propagating species to terminate a chain and regenerate the original reagent.")
AnnotationAssertion(rdfs:comment goldbook:08940 "Catalytic chain termination may be observed as a side reaction in certain reversible-deactivation radical polymerizations."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08940 goldbook:08966)
AnnotationAssertion(rdfs:seeAlso goldbook:08940 goldbook:08916)
AnnotationAssertion(mito:isMentionedBy goldbook:08940 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08940 "current"^^xsd:string)
Declaration(Class(goldbook:08941))
AnnotationAssertion(rdfs:label goldbook:08941 "chain activation")
AnnotationAssertion(dcterms:description goldbook:08941 "Unimolecular dissociation of a dormant species to form a mediating agent and a propagating species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08941 "activation (in SRMP)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08941 "unimolecular activation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08941 "unimolecular chain activation")
AnnotationAssertion(rdfs:comment goldbook:08941 "In aminoxyl-mediated radical polymerization [nitroxide-mediated polymerization (NMP)], the dormant species is an alkoxyamine and the mediating agent is an aminoxyl radical."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08941 "In organometallic-mediated radical polymerization (OMRP), the domant species and the mediating agent are organometallic species."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08941 "In reversible addition-fragmentation radical polymerization (RAFRP), the dormant species is a stable radical and the mediating agent is a non-propagating olefin, e.g., 1,1-diphenylethylene."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08941 "Chain deactivation (in SRMP) is the reverse of chain activation (in SRMP)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08943)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08921)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08917)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08952)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08964)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08920)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08966)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08922)
AnnotationAssertion(rdfs:seeAlso goldbook:08941 goldbook:08970)
AnnotationAssertion(mito:isMentionedBy goldbook:08941 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08941 "current"^^xsd:string)
Declaration(Class(goldbook:08942))
AnnotationAssertion(rdfs:label goldbook:08942 "chain activation")
AnnotationAssertion(dcterms:description goldbook:08942 "Reaction of an activator with a dormant species to form a deactivator and a propagating species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08942 "activation (in ATRP)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08942 "bimolecular activation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08942 "bimolecular chain activation")
AnnotationAssertion(rdfs:comment goldbook:08942 "The activation and deactivation process may form part of a catalytic cycle. However, in general, the activator should not be called a catalyst."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08942 "Chain deactivation (in ATRP) is the reverse of chain activation (in ATRP)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08942 goldbook:08943)
AnnotationAssertion(rdfs:seeAlso goldbook:08942 goldbook:08949)
AnnotationAssertion(rdfs:seeAlso goldbook:08942 goldbook:08952)
AnnotationAssertion(rdfs:seeAlso goldbook:08942 goldbook:08966)
AnnotationAssertion(mito:isMentionedBy goldbook:08942 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08942 "current"^^xsd:string)
Declaration(Class(goldbook:08943))
AnnotationAssertion(rdfs:label goldbook:08943 "chain deactivation")
AnnotationAssertion(dcterms:description goldbook:08943 "Conversion of a chain carrier into an inactive species.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08943 "deactivation")
AnnotationAssertion(rdfs:comment goldbook:08943 "Chain deactivation, unlike chain termination, may be reversible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08943 "The reverse of chain deactivation is chain activation or chain reactivation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08943 "The recommended symbol for the rate coefficient for chain deactivation in a polymerization is \\(k_{\\rm{deact}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08943 goldbook:08941)
AnnotationAssertion(rdfs:seeAlso goldbook:08943 goldbook:08945)
AnnotationAssertion(rdfs:seeAlso goldbook:08943 goldbook:08946)
AnnotationAssertion(mito:isMentionedBy goldbook:08943 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08943 "current"^^xsd:string)
Declaration(Class(goldbook:08944))
AnnotationAssertion(rdfs:label goldbook:08944 "chain propagation")
AnnotationAssertion(dcterms:description goldbook:08944 "Chemical reaction between a chain carrier and a monomer that results in the growth of a polymer chain and the regeneration of at least one chain carrier.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08944 "propagation")
AnnotationAssertion(rdfs:comment goldbook:08944 "The recommended symbol for the rate coefficient for chain propagation in a homopolymerization is \\(k_{\\rm{p}}\\)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08944 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08944 "current"^^xsd:string)
Declaration(Class(goldbook:08945))
AnnotationAssertion(rdfs:label goldbook:08945 "chain reactivation")
AnnotationAssertion(dcterms:description goldbook:08945 "Conversion of an inactive chain into a chain carrier.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08945 "activation (in a chain polymerization)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08945 "reactivation")
AnnotationAssertion(rdfs:comment goldbook:08945 "The term is usually used to refer to the reactivation of previously deactivated or dormant chains."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08945 "Chain reactivation can be reversible or irreversible."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08945 "The reverse of chain reactivation is chain deactivation."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08945 "The recommended symbol for the rate coefficient for chain reactivation in a polymerization is \\(k_{\\rm{act}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08945 goldbook:08941)
AnnotationAssertion(rdfs:seeAlso goldbook:08945 goldbook:08943)
AnnotationAssertion(rdfs:seeAlso goldbook:08945 goldbook:08952)
AnnotationAssertion(rdfs:seeAlso goldbook:08945 goldbook:08953)
AnnotationAssertion(mito:isMentionedBy goldbook:08945 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08945 "current"^^xsd:string)
Declaration(Class(goldbook:08946))
AnnotationAssertion(rdfs:label goldbook:08946 "chain termination")
AnnotationAssertion(dcterms:description goldbook:08946 "Chemical reaction in which a chain carrier is converted irreversibly into a non-propagating species without the formation of a new chain carrier.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08946 "irreversible chain deactivation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08946 "termination")
AnnotationAssertion(rdfs:comment goldbook:08946 "The recommended symbol for the rate coefficient for chain termination in a polymerization is \\(k_{\\rm{t}}\\)."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08946 "The term 'chain deactivation' is often used to stress that, in contrast to chain termination, the formation of non-propagating species may be reversible; see chain deactivation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08946 goldbook:08943)
AnnotationAssertion(rdfs:seeAlso goldbook:08946 goldbook:08948)
AnnotationAssertion(rdfs:seeAlso goldbook:08946 goldbook:08953)
AnnotationAssertion(mito:isMentionedBy goldbook:08946 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08946 "current"^^xsd:string)
Declaration(Class(goldbook:08947))
AnnotationAssertion(rdfs:label goldbook:08947 "chain-transfer agent")
AnnotationAssertion(dcterms:description goldbook:08947 "Substance able to react with a chain carrier by a reaction in which the original chain carrier is deactivated and a new chain carrier is generated.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:08947 "CTA")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08947 "transfer agent")
AnnotationAssertion(rdfs:comment goldbook:08947 "In a polymerization, the common occurrence is that a new chain carrier of lower molar mass is generated."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:08947 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08947 "current"^^xsd:string)
Declaration(Class(goldbook:08948))
AnnotationAssertion(rdfs:label goldbook:08948 "combination")
AnnotationAssertion(dcterms:description goldbook:08948 "Chain termination, in a chain polymerization, between two propagating macromolecules that gives rise to a single macromolecule of molar mass equal to the sum of the molar masses of the two macromolecules.")
AnnotationAssertion(rdfs:comment goldbook:08948 "Combination is often incorrectly called 'recombination'. The term recombination should only be used to refer to the reaction, with each other, of two transient species produced from a common precursor."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08948 "Combination is also called colligation, although this terminology is not commonly used in the context of chain polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08948 goldbook:08946)
AnnotationAssertion(mito:isMentionedBy goldbook:08948 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08948 "current"^^xsd:string)
Declaration(Class(goldbook:08949))
AnnotationAssertion(rdfs:label goldbook:08949 "deactivator")
AnnotationAssertion(dcterms:description goldbook:08949 "Reagent that reacts reversibly with the initiating species or propagating species to form an initiator or a dormant chain, respectively, and an activator.")
AnnotationAssertion(rdfs:seeAlso goldbook:08949 goldbook:08952)
AnnotationAssertion(rdfs:seeAlso goldbook:08949 goldbook:08959)
AnnotationAssertion(rdfs:seeAlso goldbook:08949 goldbook:08966)
AnnotationAssertion(mito:isMentionedBy goldbook:08949 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08949 "current"^^xsd:string)
Declaration(Class(goldbook:08950))
AnnotationAssertion(rdfs:label goldbook:08950 "dead polymer chain")
AnnotationAssertion(dcterms:description goldbook:08950 "Polymer chain which plays no active role in the polymerization.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08950 "dead macromolecule (in RDP)")
AnnotationAssertion(rdfs:comment goldbook:08950 "A dead polymer chain is a chain unlikely to be activated or reactivated to form a propagating species under the polymerization conditions within the timescale of the polymerization."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:08950 "The products of chain termination and irreversible chain transfer comprise dead polymer chains."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08950 goldbook:08946)
AnnotationAssertion(rdfs:seeAlso goldbook:08950 goldbook:08966)
AnnotationAssertion(mito:isMentionedBy goldbook:08950 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08950 "current"^^xsd:string)
Declaration(Class(goldbook:08951))
AnnotationAssertion(rdfs:label goldbook:08951 "degenerative chain transfer")
AnnotationAssertion(dcterms:description goldbook:08951 "Chain-transfer reaction that generates a new chain carrier and a new chain-transfer agent with the same reactivity as the original chain carrier and chain-transfer agent.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08951 "degenerate chain transfer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08951 "degenerate transfer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08951 "degenerative transfer")
AnnotationAssertion(rdfs:seeAlso goldbook:08951 goldbook:08947)
AnnotationAssertion(mito:isMentionedBy goldbook:08951 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08951 "current"^^xsd:string)
Declaration(Class(goldbook:08952))
AnnotationAssertion(rdfs:label goldbook:08952 "dormant species")
AnnotationAssertion(dcterms:description goldbook:08952 "Temporarily deactivated chain carrier.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08952 "dormant macromolecule (in RDP)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08952 "dormant polymer chain")
AnnotationAssertion(rdfs:comment goldbook:08952 "A dormant polymer chain can be reactivated to a propagating chain under the polymerization conditions within the timescale of the polymerization."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:08952 goldbook:08917)
AnnotationAssertion(rdfs:seeAlso goldbook:08952 goldbook:08924)
AnnotationAssertion(rdfs:seeAlso goldbook:08952 goldbook:08935)
AnnotationAssertion(rdfs:seeAlso goldbook:08952 goldbook:08964)
AnnotationAssertion(rdfs:seeAlso goldbook:08952 goldbook:08963)
AnnotationAssertion(mito:isMentionedBy goldbook:08952 doi:10.1515/pac-2020-1211)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:08952 "current"^^xsd:string)
Declaration(Class(goldbook:08953))
AnnotationAssertion(rdfs:label goldbook:08953 "inactive chain")
AnnotationAssertion(dcterms:description goldbook:08953 "Dead chains or dormant chains.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08953 "inactive macromolecule (in RDP)")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08953 "non-propagating species")
AnnotationAssertion(rdfs:seeAlso goldbook:08953 goldbook:08950)
