AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02616 "current"^^xsd:string)
Declaration(Class(goldbook:G02617))
AnnotationAssertion(rdfs:label goldbook:G02617 "genotype")
AnnotationAssertion(dcterms:description goldbook:G02617 "The genetic constitution of an organism as revealed by genetic or molecular analysis, i.e. the complete set of genes, both dominant and recessive, possessed by a particular cell or organism.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02617 goldbook:C01282)
AnnotationAssertion(rdfs:seeAlso goldbook:G02617 goldbook:G02604)
AnnotationAssertion(mito:isMentionedBy goldbook:G02617 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02617 "current"^^xsd:string)
Declaration(Class(goldbook:G02619))
AnnotationAssertion(rdfs:label goldbook:G02619 "geometric attenuation")
AnnotationAssertion(dcterms:description goldbook:G02619 "The reduction of a radiation quantity due to the effect only of the distance between the point of interest and the source, excluding the effect of any matter present.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02619 goldbook:R05048)
AnnotationAssertion(mito:isMentionedBy goldbook:G02619 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02619 "current"^^xsd:string)
Declaration(Class(goldbook:G02621))
AnnotationAssertion(rdfs:label goldbook:G02621 "geometric mean")
AnnotationAssertion(dcterms:description goldbook:G02621 "The nth root of the product of the absolute values of the observations, taken with the proper sign. It can be calculated with the formula: \\[\\bar{x}_{\\rm{g}} = (\\Pi |x_{i}|)^{\\frac{1}{n}}\\] The \\(\\mathit{\\Pi}\\) product is taken from i = 1 to n.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:G02621 "logarithmic mean")
AnnotationAssertion(rdfs:comment goldbook:G02621 "This quantity is often calculated directly from experimental measurements (e.g. determination of concentrations by electrode potential measurements, or \\(\\rm{pH}\\)), although its significance may not always have been recognized. The problem is that the average value of a variable (such as \\(\\rm{pH}\\)) that is a function of concentration is not the same as the value of the function at the average concentration. In the case of electrode potentials, the average potential is equivalent to the geometric mean concentration. The correct procedure is to transform to units of concentration before averaging. There is one notable case where the geometric mean is appropriate, namely, when the analyte itself is distributed in a log-normal fashion, as in certain environmental and geological samples."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02621 goldbook:E01956)
AnnotationAssertion(rdfs:seeAlso goldbook:G02621 goldbook:V06600)
AnnotationAssertion(mito:isMentionedBy goldbook:G02621 doi:10.1351/pac199466030595)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02621 "current"^^xsd:string)
Declaration(Class(goldbook:G02623))
AnnotationAssertion(rdfs:label goldbook:G02623 "geometry")
AnnotationAssertion(dcterms:description goldbook:G02623 "A term used colloquially to signify the arrangement in space of the various components in an experiment, particularly the source and the detector in radiation measurements.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:G02623 "counting geometry")
AnnotationAssertion(rdfs:seeAlso goldbook:G02623 goldbook:R05054)
AnnotationAssertion(rdfs:seeAlso goldbook:G02623 goldbook:R05088)
AnnotationAssertion(mito:isMentionedBy goldbook:G02623 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02623 "current"^^xsd:string)
Declaration(Class(goldbook:G02624))
AnnotationAssertion(rdfs:label goldbook:G02624 "geometry factor")
AnnotationAssertion(dcterms:description goldbook:G02624 "The average solid angle in steradians at source subtended by the aperture or sensitive volume of the detector, divided by $4\\uppi\\!$.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02624 goldbook:A00346)
AnnotationAssertion(mito:isMentionedBy goldbook:G02624 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02624 "current"^^xsd:string)
Declaration(Class(goldbook:G02626))
AnnotationAssertion(rdfs:label goldbook:G02626 "germylidenes")
AnnotationAssertion(dcterms:description goldbook:G02626 "Carbene analogues having the structure $\\ce{R2Ge{:}}$. The older synonym germylenes is no longer recommended.")
