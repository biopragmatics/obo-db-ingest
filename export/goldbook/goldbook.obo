consider: goldbook:W06659

[Term]
id: goldbook:S06047
name: streak tube
def: "An image converter adapted to provide scanning or time-resolved images. If the image is recorded the whole device is an example of a streak camera."
property_value: mito:isMentionedBy doi:10.1351/pac199567101745
property_value: hasStatus "current" xsd:string
