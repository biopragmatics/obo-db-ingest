Declaration(Class(goldbook:12133))
AnnotationAssertion(rdfs:label goldbook:12133 "tetrodotoxin")
AnnotationAssertion(dcterms:description goldbook:12133 "Neurotoxin that inhibits action potentials by blocking sodium ion channels.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:12133 "TTX")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12133 "4R,4aR,5R,6S,7S,8S,8aR,10S,12S)-2-azaniumylidene-4,6,8,12-tetrahydroxy-6-(hydroxymethyl)-2,3,4,4a,5,6,7,8-octahydro-1H-8a,10-methano-5,7-(epoxymethanooxy)quinazolin-10-olate")
AnnotationAssertion(rdfs:comment goldbook:12133 "It is produced by bacteria living in symbiosis with fish of the order Tetraodontiformes, including trigger fish and puffer fish."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12133 goldbook:11952)
AnnotationAssertion(rdfs:seeAlso goldbook:12133 goldbook:11562)
AnnotationAssertion(rdfs:seeAlso goldbook:12133 goldbook:11838)
