AnnotationAssertion(obo:goldbook#hasStatus goldbook:16035 "current"^^xsd:string)
Declaration(Class(goldbook:16036))
AnnotationAssertion(rdfs:label goldbook:16036 "reference sample group")
AnnotationAssertion(dcterms:description goldbook:16036 "Selected reference individuals, statistically adequate numerically to represent the reference population.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:16036 "reference group")
AnnotationAssertion(mito:isMentionedBy goldbook:16036 doi:10.1351/pac200779071153)
