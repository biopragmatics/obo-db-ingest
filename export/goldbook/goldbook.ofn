Declaration(Class(goldbook:I03319))
AnnotationAssertion(rdfs:label goldbook:I03319 "isothermal chromatography")
AnnotationAssertion(dcterms:description goldbook:I03319 "A procedure in which the temperature of the column is kept constant during the separation.")
