AnnotationAssertion(rdfs:label goldbook:IT07514 "inorganic–organic polymer")
AnnotationAssertion(dcterms:description goldbook:IT07514 "Polymer or polymer network with a skeletal structure comprising inorganic and organic units.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:IT07514 "IOP")
AnnotationAssertion(rdfs:comment goldbook:IT07514 "Examples include poly(carbasilane)s, poly(phenylenesilanediyl)s, poly(phenylenesulfide)s, etc."^^xsd:string)
