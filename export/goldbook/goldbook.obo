[Term]
id: goldbook:08672
name: rapid-scan Fourier-transform infrared spectroscopy
def: "Fourier-transform infrared spectroscopy in which the optical path difference is continually changed at a rate of \\\(\\pu\{0.05 cm s-1\}\\\) or greater."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
