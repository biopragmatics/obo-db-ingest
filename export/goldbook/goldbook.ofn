Declaration(Class(goldbook:H02775))
AnnotationAssertion(rdfs:label goldbook:H02775 "hemiaminals")
AnnotationAssertion(dcterms:description goldbook:H02775 "$\\ce{\\upalpha\\!\\mbox{-}Amino}$ alcohols, improperly called carbinolamines (the adducts of ammonia, or of primary or secondary amines to the carbonyl group of aldehydes and ketones) $\\ce{R2C(OH)NR2}$. Compounds of structure $\\ce{R2C(OR')NR2}$ ($\\ce{R}  eq \\ce{H}$) are hemiaminal ethers, or $\\ce{\\upalpha\\!\\mbox{-}amino}$ ethers.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02775 goldbook:A00204)
AnnotationAssertion(rdfs:seeAlso goldbook:H02775 goldbook:A00208)
