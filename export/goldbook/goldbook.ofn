AnnotationAssertion(dcterms:description goldbook:10965 "Middle section of the digestive tract in a vertebrate embryo, from which the ileum, jejunum, and portions of the duodenum and colon develop.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10965 "mesenteron")
Declaration(Class(goldbook:10966))
