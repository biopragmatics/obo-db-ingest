AnnotationAssertion(rdfs:seeAlso goldbook:11896 goldbook:11971)
AnnotationAssertion(rdfs:seeAlso goldbook:11896 goldbook:12003)
AnnotationAssertion(mito:isMentionedBy goldbook:11896 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11896 "current"^^xsd:string)
Declaration(Class(goldbook:11897))
AnnotationAssertion(rdfs:label goldbook:11897 "myelin basic protein")
AnnotationAssertion(dcterms:description goldbook:11897 "Major component of myelin, that helps organizing the correct assembly of the lipids and proteins in myelin sheets.")
AnnotationAssertion(rdfs:comment goldbook:11897 "Absence of myelin basic protein in animals results in seizures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11897 "Myelin basic protein levels in the cerebrospinal fluid are elevated in various demyelinizing disorders, including multiple sclerosis where autoantibodies against myelin basic protein are believed to play a role."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11897 goldbook:11707)
AnnotationAssertion(rdfs:seeAlso goldbook:11897 goldbook:11891)
AnnotationAssertion(rdfs:seeAlso goldbook:11897 goldbook:11896)
