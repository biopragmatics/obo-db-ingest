    <!-- http://dx.doi.org/10.1351/goldbook.11048 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11048">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation and development of organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>organogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11049 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11049">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of the lip or palate to fuse properly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>orofacial cleft</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10704"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11062"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11050 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11050">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large multinucleate cell that resorbs bone, allowing for the deposition of new bone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Osteoclasts secrete enzymes and acids that dissolve the calcium phosphate matrix of old bone tissue.</rdfs:comment>
        <rdfs:label>osteoclast</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11051 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11051">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Laying down of new bone tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ossification</oboInOwl:hasRelatedSynonym>
        <rdfs:label>osteogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11052 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11052">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Opening into a vessel or cavity of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>introitus</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ostium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11053 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11053">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to, or located near the ear.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>auricular</oboInOwl:hasRelatedSynonym>
        <rdfs:label>otic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11054 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11054">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital anomaly characterized by the absence or extreme underdevelopment of the lower jaw, producing closeness of the ears below the face.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>otocephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10352"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11279"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11055 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11055">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of events occurring in the ovary involved in ovulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>It consists of the follicular phase with maturation of the ovarian follicle under control of follicle-stimulating hormone (FSH), ovulation with release of the secondary oocyte, and the luteal phase in which FSH and luteinizing hormone drive formation of the progesterone-producing corpus luteum.</rdfs:comment>
        <rdfs:comment>Together with the uterine cycle, it comprises the menstrual cycle.</rdfs:comment>
        <rdfs:label>ovarian cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10730"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10733"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10902"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10936"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11042"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11056"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11136"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11056 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11056">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cavity in the ovary containing a maturing ovum, at any stage of development, surrounded by its encasing cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ovarian follicle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11057 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11057">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the paired female reproductive glands containing the ova (see ovum).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ovary</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11058 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11058">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal gonad in which both ovarian and testicular tissues are present, and thus a form of hermaphroditism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ovotestis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11059 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11059">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Release of a mature ovum from the ovary into the Fallopian tube.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ovulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11060 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11060">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mature female sex cell, capable of undergoing fertilization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ovum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11061 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11061">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Peptide hormone secreted by the neurohypophysis that stimulates contraction of the myometrium during labor and secretion of milk during lactation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Oxytocin is used clinically in the induction of labor and in the management of postpartum hemorrhage.</rdfs:comment>
        <rdfs:label>oxytocin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10880"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10881"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10991"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11112"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11062 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11062">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Roof of the mouth, separating the oral and nasal cavities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>In embryonic development an anterior, primary palate is distinguished from a posterior, secondary palate.</rdfs:comment>
        <rdfs:comment>The embryonic primary palate gives rise to an anterior bony part called the hard palate, and a posterior muscular part called the soft palate.</rdfs:comment>
        <rdfs:label>palate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10994"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11049"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11063 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11063">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Medial central ridge of the palate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>palatine raphe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11062"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11064 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11064">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Examination by light microscopy of a sample of cells scraped from the uterine cervix, used to screen for cervical cancer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Pap smear</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pap test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Papanicolaou stain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cervical smear</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Papanicolaou smear</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10507"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11065 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11065">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of signaling in which a cell secretes into the intercellular space a molecular messenger that diffuses and binds to receptors on nearby target cells, producing a signal in those cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>paracrine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11066 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11066">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuroendocrine cell that migrates into the thyroid gland during embryonic development and secretes the hormone calcitonin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>C cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>parafollicular cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11010"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11305"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11067 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11067">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of two paired embryonic ducts of mesodermal origin that will become the Fallopian tubes, uterus, cervix and upper part of the vagina in the female, and will regress in the male.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Müllerian duct</oboInOwl:hasRelatedSynonym>
        <rdfs:label>paramesonephric duct</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10507"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11068 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11068">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Connective tissue of the floor of the female pelvis that lies in front of the uterine cervix and separates it from the bladder.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>parametrium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10507"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11069 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11069">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Smaller of unequal conjoined twins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>parasitic twin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10446"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11070 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11070">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area of mesoderm in the embryo that forms during neurulation, lies along both sides of the neural tube, and gives rise to the somites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>somitic mesoderm</oboInOwl:hasRelatedSynonym>
        <rdfs:label>paraxial mesoderm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11015"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11231"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11071 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11071">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Distinguishing or specific type of cell of an organ or gland, contained in, or supported by, the connective tissue framework provided by the stromal cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>parenchymal cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11264"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11072 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11072">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to or denoting the wall of the body or of a body cavity or hollow structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>parietal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11073 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11073">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acid-producing cell in the stomach.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>gastric parietal cell</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11074 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11074">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of nonsexual reproduction in which an unfertilized ovum develops into an embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>apogamia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>parthenogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11217"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11075 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11075">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of giving birth by a maternal organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>parturition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11076 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11076">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder wherein the ductus arteriosis fails to close after birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This may lead to failure to thrive and increased breathing in early life.</rdfs:comment>
        <rdfs:label>patent ductus arteriosus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10618"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11077 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11077">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital abnormality in which a kidney develops and remains in the pelvic area.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ectopic kidney</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Pelvic kidney is generally asymptomatic but may produce complications.</rdfs:comment>
        <rdfs:label>pelvic kidney</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11078 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11078">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serous membranous sac that surrounds the heart, consisting of an inner visceral layer (the epicardium), and an outer parietal pericardium that is attached to the sternum and diaphragm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pericardium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10604"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10665"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11207"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11079 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11079">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to the period from shortly before to shortly after birth, in humans usually from the 20th to the 29th week of gestation to one to four weeks after birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>perinatal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10764"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11080 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11080">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Muscular structure of the lower pelvis, between the legs and extending from the anus to the pubic symphysis, or alternatively including the anus and vagina in the female and the region from the anus to the base of the scrotum in the male.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>perineum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11155"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11197"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11081 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11081">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Potential space between the two layers (visceral and parietal) of the peritoneum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>peritoneal cavity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11082"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11082 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11082">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thin double layer of mesothelium and irregular connective tissue that lines the abdominal cavity and covers most of the abdominal organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>peritoneal membrane</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The two layers of the peritoneum consist of the parietal peritoneum that lines the abdominal wall and the visceral peritoneum that covers the abdominal organs.</rdfs:comment>
        <rdfs:label>peritoneum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10318"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10948"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11081"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11083 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11083">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method that enables the presentation of large peptide libraries on the surface of phage particles, from which proteins with desired functional properties can be selected rapidly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>phage display</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11084 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11084">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of several paired grooves in the embryonic endoderm, lateral to the corresponding pharyngeal pouch in the ectoderm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pharyngeal groove</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11085"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11085 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11085">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of several paired evaginations in the embryonic endoderm that develop into epithelial tissues and organs such as the thymus and thyroid gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>branchial pouch</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pharyngeal pouch</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11303"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11305"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11086 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11086">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the digestive tube lying between the esophagus (below) and the mouth and nasal cavity (above and anterior).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The pharynx is subdivided into the nasopharynx lying at the base of the nasal cavity, the oropharynx behind the mouth, and the laryngopharynx posterior to the larynx.</rdfs:comment>
        <rdfs:label>pharynx</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10994"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11087 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11087">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autosomal recessive disorder resulting from mutations that impair the function of the enzyme phenylalanine 4-monooxygenase (EC 1.14.16.1).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>PKU</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The excess phenylalanine is metabolized to phenyl pyruvate (&quot;phenylketone&quot;) that is detected in the urine and is used for screening newborns.</rdfs:comment>
        <rdfs:comment>The resulting failure of phenylalanine metabolism in the liver leads to its accumulation, causing mental retardation, seizures, and other neurological disorders in untreated individuals.</rdfs:comment>
        <rdfs:label>phenylketonuria</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10448"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11087"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PKU</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11088 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11088">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Groove in the midline of the upper lip below the nose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>philtrum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11089 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11089">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital abnormality in which one or more of the hands or feet is attached to an underdeveloped limb, and therefore too close to the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This very rare disorder is associated with prenatal exposure to thalidomide.</rdfs:comment>
        <rdfs:label>phocomelia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11299"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11090 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11090">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-steroidal natural product from a plant that, because of a structural similarity to 17\(\upbeta\)-estradiol can exert mild estrogenic effects, or antagonize them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Examples include isoflavones and coumestans.</rdfs:comment>
        <rdfs:comment>While foods containing phyto-estrogens are often promoted as beneficial, medical benefits are not well established.</rdfs:comment>
        <rdfs:label>phytoestrogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10678"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10683"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11091 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11091">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Patchy absence of pigmentation of the hair or skin or, depending on the species, of feathers, scales, or other body surfaces.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>piebaldism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11092 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11092">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pea-sized conical mass of tissue behind the third ventricle of the brain, secreting the hormone-like substance melatonin in some mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>epiphysis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pineal gland</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11093 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11093">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Externally visible portion of the ear.See also: auricle Feather or fin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pinna</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10444"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11094 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11094">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small endocrine gland sitting in a bony cavity (the sella turcica) at the base of the brain and connected to the hypothalamus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>hypophysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pituitary gland</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The pituitary is structurally and functionally divided into anterior and posterior lobes. The anterior lobe secretes growth hormone (somatotropin), thyroid-stimulating hormone (TSH), adrenocortocotropic hormone (ACTH), prolactin (PRL), luteinizing hormone (LH), and follicle-stimulating hormone (FSH). The posterior lobe develops from the hypothalamus and secretes oxytocin and antidiuretic hormone (ADH) (also called arginine vasopressin (AVP)). An intermediate lobe (indistinct in humans) secretes melanocyte-stimulating hormone (MSH).</rdfs:comment>
        <rdfs:label>pituitary</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10346"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10657"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10730"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10783"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11061"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11139"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11201"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11230"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11360"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11095 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11095">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organ of exchange of nutrients and waste products between mother and fetus, having parts derived from both.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>placenta</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11096"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11096 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11096">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multilayered membrane of fetal tissue within the placenta that separates the maternal blood from the fetal blood and allows selective passage of substances between the two.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>placental membrane</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This membrane blocks only a few xenobiotics.</rdfs:comment>
        <rdfs:label>placental barrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11097 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11097">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Circulation of blood through the placenta during intrauterine life, serving the needs of the fetus for oxygenation, nutrition, and elimination of waste.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>placental circulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10862"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11098 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11098">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inadequate blood flow through the placenta to maintain the needs of the fetus for oxygenation and metabolic balance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>placental insufficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11097"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11099 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11099">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delivery of substances from the maternal circulation to the fetus, across the placental barrier.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>placental transfer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11096"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11100 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11100">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having more than one effect. Relating to a gene, expression of which gives rise to multiple phenotypic traits.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pleiotropism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11101 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11101">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Each of a pair of serous membranes lining the thorax and enveloping the lungs in humans and other mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The pleural membrane covering the lungs and extending into the fissures of the lobes is called the visceral pleura and lacks a nerve supply. That lining the chest cavity, mediastinum, and diaphragm is called the parietal pleura; it is innervated and sensitive to pain.</rdfs:comment>
        <rdfs:label>pleura</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10604"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10924"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11207"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11102 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11102">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Potential space between the pleural membranes lining the chest cavity (parietal pleura) and covering the lungs (visceral pleura).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>In pathological conditions, fluid may accumulate in the pleural cavity, between the visceral and parietal pleura.</rdfs:comment>
        <rdfs:label>pleural cavity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11101"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11103 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11103">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Able to differentiate into a variety of cell types.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Examples are the ovum and embryonic stem cells.</rdfs:comment>
        <rdfs:label>pluripotent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11104 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11104">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Composed of many cysts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>polycystic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10582"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11105 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11105">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of supernumerary fingers or toes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>polydactyly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11269"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11106 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11106">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence of a gene in more than one distinct nucleotide sequence in a population, resulting from mutation(s) and potentially producing gene products with different levels of function. Note: It is sometimes considered that the least frequent of polymorphic gene sequences should be present in at least \(\pu{1\%}\) of the population; otherwise the variant is a mutation rather than a polymorphism. Occurrence of different phenotypes of a single trait.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>polymorphism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10751"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11107 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11107">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence of more than two complete sets of chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>polyploidy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11108 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11108">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence of a cyst in the substance of the brain that usually communicates with one of the lateral ventricles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>These abnormal cavities may result from brain tissue destruction or maldevelopment.</rdfs:comment>
        <rdfs:label>porencephaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10582"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11109 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11109">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurring after the early embryo embeds in the lining of the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>post-implantation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11110 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11110">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>After death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>postmortem</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10410"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11111 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11111">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to events in the life of the mother or fetus following birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>postnatal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11112 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11112">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period following the birth of an infant, often considered to be about six weeks in the human.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>postpartum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11113 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11113">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which adult females of the predatory mite (_027814_ considered representative of soil fauna) are exposed to a test substance in artificial soil and the number of surviving females and of juveniles is determined.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>predatory mite test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11114 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11114">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological condition in pregnancy with symptoms of high blood pressure, kidney dysfunction and edema.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pre-eclampsia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10630"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10638"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11115 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11115">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fertilized ovum up to \(\pu{14 days}\) of age and before implantation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pre-embryo</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11116 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11116">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of a female between conception and the termination of gestation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pregnancy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10550"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10764"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11117 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11117">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurring before the early embryo embeds in the lining of the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>pre-implantation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11118 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11118">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delivery before the expected length of gestation for the species; in humans taken as birth before a gestational age of \(\pu{37 weeks}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>premature birth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10764"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11119 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11119">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to events in the life of the mother or fetus preceding birth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>antenatal</oboInOwl:hasRelatedSynonym>
        <rdfs:label>prenatal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11120 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11120">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a substance is administered to pregnant animals (usually rodents or rabbits) from the time of implantation until closure of the hard palate. The animals are killed one to two days before a scheduled delivery, whereupon uterine contents and the fetuses are evaluated for abnormalities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>prenatal development study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11121 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11121">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of the anterior hypothalamus primarily involved in regulating body temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>preoptic region</oboInOwl:hasRelatedSynonym>
        <rdfs:label>preoptic area</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11122 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11122">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stage of human development before the onset of puberty.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>prepubertal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11123"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11152"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11123 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11123">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period before pubescence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Whereas prepubertal refers to any time before puberty, prepubescence refers less specifically to a time closely preceding early puberty.</rdfs:comment>
        <rdfs:label>prepubescence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11122"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11152"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11124 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11124">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin protecting the glans penis in the male (foreskin) or the clitoris in the female (clitoral hood).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>clitoral hood</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>foreskin</oboInOwl:hasRelatedSynonym>
        <rdfs:label>prepuce</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10536"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10770"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11125 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11125">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Separation of the prepuce from the glans penis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>preputial separation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10770"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11124"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11126 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11126">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gonads, which form gametes; ovaries in the female and testes in the male.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primary sex organ</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11127 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11127">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thickening of the embryonic tissue extending forward from the primitive streak.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primitive axis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11131"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11128 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11128">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Shallow depression in the primitive streak that extends anteriorly to communicate with the yolk sac.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primitive groove</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11131"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11389"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11129 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11129">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of cells at the anterior end of the primitive streak, involved in secreting chemical signals that regulate differentiation of the germ layers during gastrulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>primitive knot</oboInOwl:hasRelatedSynonym>
        <rdfs:label>primitive node</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10750"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10763"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11131"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11130 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11130">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Depression in the primitive node contiguous with the notochord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primitive pit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11021"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11129"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11131 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11131">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structure forming in the blastula during early embryogenesis that establishes bilateral symmetry and determines the site of gastrulation and germ layer formation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primitive streak</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10464"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10750"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10763"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11132 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11132">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Early stage of the oocyte in which it is surrounded by a single layer of follicular cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primordial follicle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10729"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11040"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11133 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11133">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Germ cell in the earliest stages of development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primordial germ cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11134 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11134">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organ or tissue at its earliest recognizable stage of development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>primordium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11135 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11135">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ectodermal depression of the caudal end of the embryo, where later the anus is formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>anal pit</oboInOwl:hasRelatedSynonym>
        <rdfs:label>proctodeum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11136 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11136">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Steroidal hormone produced in the ovary by the corpus luteum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>pregn-4-ene-3,20-dione</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Progesterone is involved in sexual development and the ovarian cycle, and essential for maintenance of pregnancy.</rdfs:comment>
        <rdfs:label>progesterone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11055"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11137 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11137">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Synthetic variant of progesterone, often used in oral contraceptive pills or to suppress hyperplasia of the endometrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>progestin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10557"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
