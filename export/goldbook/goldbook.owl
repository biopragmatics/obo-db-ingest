    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10654 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10654">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subset of cells in the primordial tube-like heart that is essential to the development of the ventricular septum and the atrioventricular valves of the heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>atrioventricular canal cushion</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Endocardial cushion defects may cause various types of heart malformation.</rdfs:comment>
        <rdfs:label>endocardial cushion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10440"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11364"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10655 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10655">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Endothelial lining of the heart chambers, also containing small blood vessels and a few bundles of smooth muscle, continuous with the endothelium of the great blood vessels.</dcterms:description>
