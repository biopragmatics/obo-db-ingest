consider: goldbook:13293

[Term]
id: goldbook:13011
name: classical pathway
def: "Activation pathway involving complement components C1\, C2\, and C4 which\, following fixation of C1q\, e.g.\, by antigen-antibody complexes\, produces the classical pathway C3 convertase C4b2a."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-11-06-03
property_value: hasStatus "current" xsd:string
