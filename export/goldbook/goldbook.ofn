AnnotationAssertion(rdfs:label goldbook:08988 "reversible-deactivation cationic polymerization")
AnnotationAssertion(dcterms:description goldbook:08988 "Reversible-deactivation polymerization in which the chain carriers are cations.")
Declaration(Class(goldbook:08989))
AnnotationAssertion(rdfs:label goldbook:08989 "anion-activated-monomer polymerization")
AnnotationAssertion(dcterms:description goldbook:08989 "Activated-monomer polymerization where the propagating species is an electrophile and activating species is anionic.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08989 "anionic activated-monomer polymerization")
Declaration(Class(goldbook:08990))
AnnotationAssertion(rdfs:label goldbook:08990 "cation-activated-monomer polymerization")
AnnotationAssertion(dcterms:description goldbook:08990 "Activated-monomer polymerization where the propagating species is a nucleophile and the activating species is cationic.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08990 "cationic activated-monomer polymerization")
Declaration(Class(goldbook:08991))
AnnotationAssertion(rdfs:label goldbook:08991 "living ring-opening metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08991 "Ring-opening metathesis polymerization in which chain termination and irreversible chain transfer are absent.")
Declaration(Class(goldbook:08992))
AnnotationAssertion(rdfs:label goldbook:08992 "metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08992 "Polymerization in which unsaturated monomers are transformed into unsaturated polymers by a process of bond redistribution.")
Declaration(Class(goldbook:08993))
AnnotationAssertion(rdfs:label goldbook:08993 "ring-opening metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08993 "Metathesis polymerization in which an unsaturated cyclic monomer is converted into an unsaturated monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer.")
Declaration(Class(goldbook:08994))
AnnotationAssertion(rdfs:label goldbook:08994 "electron-transfer ring-opening metathesis polymerization")
AnnotationAssertion(dcterms:description goldbook:08994 "Ring-opening metathesis polymerization (ROMP) proceeding through one-electron redox processes in the absence of a metal carbene initiator.")
Declaration(Class(goldbook:08995))
AnnotationAssertion(rdfs:label goldbook:08995 "coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:08995 "Chain polymerization that involves the preliminary coordination of a monomer molecule with a chain carrier.")
Declaration(Class(goldbook:08996))
AnnotationAssertion(rdfs:label goldbook:08996 "coordination-addition polymerization")
AnnotationAssertion(dcterms:description goldbook:08996 "Coordination polymerization of \\(\\ce{\\upalpha\\!,\\!\\upbeta\\mbox{-}unsaturated}\\) amides or esters that proceeds by sequential monomer coordination and Michael addition events.")
Declaration(Class(goldbook:08997))
AnnotationAssertion(rdfs:label goldbook:08997 "coordination-insertion polymerization")
AnnotationAssertion(dcterms:description goldbook:08997 "Coordination polymerization of olefins that proceeds by insertion of the olefin into a metal–carbon bond")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08997 "insertion polymerization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:08997 "polyinsertion")
Declaration(Class(goldbook:08998))
AnnotationAssertion(rdfs:label goldbook:08998 "living coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:08998 "Coordination polymerization in which chain termination and irreversible chain transfer are absent.")
Declaration(Class(goldbook:08999))
AnnotationAssertion(rdfs:label goldbook:08999 "reversible-deactivation coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:08999 "Reversible-deactivation polymerization in which the chain carriers are coordination complexes.")
Declaration(Class(goldbook:09000))
AnnotationAssertion(rdfs:label goldbook:09000 "coordination ring-opening polymerization")
AnnotationAssertion(dcterms:description goldbook:09000 "Coordination polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer.")
Declaration(Class(goldbook:09001))
AnnotationAssertion(rdfs:label goldbook:09001 "chain-shuttling polymerization")
AnnotationAssertion(dcterms:description goldbook:09001 "Coordinative chain-transfer polymerization that involves two different catalysts showing different specificity, where chain propagation occurs sequentially on the two catalysts, allowing for the formation of segmented or multiblock copolymers.")
Declaration(Class(goldbook:09002))
AnnotationAssertion(rdfs:label goldbook:09002 "chain-walking polymerization")
AnnotationAssertion(dcterms:description goldbook:09002 "Coordination polymerization in which the chain carrier migrates along the formed polymer chain through a series of \\(\\ce{\\upbeta\\mbox{-}hydrogen}\\) eliminations and reinsertions with inversion of stereochemistry.")
Declaration(Class(goldbook:09003))
AnnotationAssertion(rdfs:label goldbook:09003 "coordinative chain-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:09003 "Coordination polymerization in which a propagating chain is able to transfer reversibly between the catalyst and a chain-transfer agent, thereby converting the active species into a dormant species.")
Declaration(Class(goldbook:09004))
AnnotationAssertion(rdfs:label goldbook:09004 "heterogeneous catalysis coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:09004 "Coordination polymerization making use of a heterogeneous catalyst.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09004 "heterogeneous coordination polymerization")
Declaration(Class(goldbook:09005))
AnnotationAssertion(rdfs:label goldbook:09005 "homogeneous catalysis coordination polymerization")
AnnotationAssertion(dcterms:description goldbook:09005 "Coordination polymerization making use of a homogeneous catalyst.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09005 "homogeneous coordination polymerization")
Declaration(Class(goldbook:09006))
AnnotationAssertion(rdfs:label goldbook:09006 "metallocene polymerization")
AnnotationAssertion(dcterms:description goldbook:09006 "Coordination polymerization making use of a metallocene catalyst.")
Declaration(Class(goldbook:09007))
AnnotationAssertion(rdfs:label goldbook:09007 "pseudo-ionic polymerization")
AnnotationAssertion(dcterms:description goldbook:09007 "Polymerization proceeding by insertion of a monomer into a polar bond without the generation of ions.")
Declaration(Class(goldbook:09008))
AnnotationAssertion(rdfs:label goldbook:09008 "rare-earth-metal-mediated coordination-addition polymerization")
AnnotationAssertion(dcterms:description goldbook:09008 "Coordination-addition polymerization with propagation occurring within the coordination sphere of a rare-earth metal complex.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09008 "lanthanide-mediated group-transfer polymerization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09008 "rare-earth-metal-mediated coordination polymerization")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09008 "rare-earth-metal-mediated group-transfer polymerization")
Declaration(Class(goldbook:09010))
AnnotationAssertion(rdfs:label goldbook:09010 "catalyst-transfer polymerization")
AnnotationAssertion(dcterms:description goldbook:09010 "Catalysed condensative chain polymerization where the catalyst is transferred from reactant polymer to product polymer with high efficiency.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09010 "catalyst-transfer chain polymerization")
Declaration(Class(goldbook:09011))
AnnotationAssertion(rdfs:label goldbook:09011 "catalyst-transfer cross-coupling polymerization")
AnnotationAssertion(dcterms:description goldbook:09011 "Catalyst-transfer polymerization where the propagation steps comprise cross-coupling reactions.")
Declaration(Class(goldbook:09012))
AnnotationAssertion(rdfs:label goldbook:09012 "living condensative chain polymerization")
AnnotationAssertion(dcterms:description goldbook:09012 "Condensative chain polymerization in which chain termination and irreversible chain transfer are absent.")
Declaration(Class(goldbook:09013))
AnnotationAssertion(rdfs:label goldbook:09013 "brush polymer")
AnnotationAssertion(dcterms:description goldbook:09013 "Polymer composed of brush macromolecules.")
Declaration(Class(goldbook:09014))
AnnotationAssertion(rdfs:label goldbook:09014 "locant")
AnnotationAssertion(dcterms:description goldbook:09014 "Numeral or letter or a combination of both that identifies position(s) in a structure.")
Declaration(Class(goldbook:09015))
AnnotationAssertion(rdfs:label goldbook:09015 "senior constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09015 "More (most) senior CRU of a structure of a macromolecule or oligomer molecule containing two or more different types of CRUs.")
Declaration(Class(goldbook:09016))
AnnotationAssertion(rdfs:label goldbook:09016 "preferred constitutional repeating unit")
AnnotationAssertion(dcterms:description goldbook:09016 "Constitutional repeating unit (CRU) written with the subunits in a linear series from the highest (higher) seniority to the lowest (lower) or as close as possible by the shortest path.")
Declaration(Class(goldbook:09017))
AnnotationAssertion(rdfs:label goldbook:09017 "subunit")
AnnotationAssertion(dcterms:description goldbook:09017 "Largest main-chain (backbone) segment of the constitutional repeating unit (CRU) that can be named a single unit under organic nomenclature rules. This may be a ring or a ring system, a heteroatom or a heteroatom chain, or an acyclic carbon chain.")
Declaration(Class(goldbook:09018))
AnnotationAssertion(rdfs:label goldbook:09018 "dimensionless Henry’s law solubility constant")
AnnotationAssertion(dcterms:description goldbook:09018 "Amount concentration \\(c_{\\rm{l}}\\) of a species in the liquid phase divided by the amount concentration \\(c_{\\rm{g}}\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{cc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{l}}}{c_{\\rm{g}}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09018 "dimensionless Henry solubility")
Declaration(Class(goldbook:09019))
AnnotationAssertion(rdfs:label goldbook:09019 "dimensionless Henry’s law volatility constant")
AnnotationAssertion(dcterms:description goldbook:09019 "Amount concentration \\(c_{\\rm{g}}\\) of a species in the gas phase divided by the amount concentration \\(c_{\\rm{g}}\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{cc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{g}}}{c_{\\rm{l}}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09019 "dimensionless Henry volatility")
Declaration(Class(goldbook:09020))
AnnotationAssertion(rdfs:label goldbook:09020 "Henry’s law constant")
AnnotationAssertion(dcterms:description goldbook:09020 "Proportionality factor describing the equilibrium distribution of a chemical species between the gas phase and a liquid solution at infinite dilution of the solute according to Henry’s law. It is an umbrella term for the reciprocal quantities Henry’s law solubility constant and Henry’s law volatility constant. Because of its ambiguity, it is strongly recommended to specify whether a solubility or volatility constant is intended.")
Declaration(Class(goldbook:09021))
AnnotationAssertion(rdfs:label goldbook:09021 "Henry’s law solubility constant")
AnnotationAssertion(dcterms:description goldbook:09021 "Umbrella term for all variants of Henry’s law constants that are defined in such a way that the numerical value increases with increasing solubility of the solute. Variants include \\(H_{\\rm{s}}^{cp}\\), \\(H_{\\rm{s}}^{xp}\\), \\(H_{\\rm{s}}^{bp}\\), and \\(H_{\\rm{s}}^{cc}\\), as discussed elsewhere in this section.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09021 "Henry solubility")
Declaration(Class(goldbook:09022))
AnnotationAssertion(rdfs:label goldbook:09022 "Henry’s law volatility constant")
AnnotationAssertion(dcterms:description goldbook:09022 "Umbrella term for all variants of Henry’s law constants that are defined in such a way that the numerical value increases with increasing volatility of the solute. Variants include \\(H_{\\rm{v}}^{pc}\\), \\(H_{\\rm{v}}^{px}\\), \\(H_{\\rm{v}}^{pw}\\), and \\(H_{\\rm{v}}^{cc}\\), as discussed elsewhere in this section.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09022 "Henry volatility")
Declaration(Class(goldbook:09023))
AnnotationAssertion(rdfs:label goldbook:09023 "Henry’s law volatility constant (via p and c)")
AnnotationAssertion(dcterms:description goldbook:09023 "Partial pressure \\(p\\) of a species in the gas phase divided by the amount concentration \\(c_{\\rm{l}}\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{pc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{p}{c_{\\rm{l}}}\\]")
Declaration(Class(goldbook:09024))
AnnotationAssertion(rdfs:label goldbook:09024 "Henry’s law solubility constant (via c and p)")
AnnotationAssertion(dcterms:description goldbook:09024 "Amount concentration \\(c_{\\rm{l}}\\) of a species in the liquid phase divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{cp}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{l}}}{p}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09024 "Henry solubility (defined via amount concentration and partial pressure)")
Declaration(Class(goldbook:09025))
AnnotationAssertion(rdfs:label goldbook:09025 "Henry’s law solubility constant (via x and p)")
AnnotationAssertion(dcterms:description goldbook:09025 "Amount fraction \\(x\\) of a species in the liquid phase divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{xp}: = \\underset{x \\to 0}{\\rm{lim}}\\frac{x}{p}\\]")
Declaration(Class(goldbook:09026))
AnnotationAssertion(rdfs:label goldbook:09026 "Henry’s law solubility constant (via b and p)")
AnnotationAssertion(dcterms:description goldbook:09026 "Molality \\(b\\) of a species divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{bp}: = \\underset{b \\to 0}{\\rm{lim}}\\frac{b}{p}\\]")
Declaration(Class(goldbook:09027))
AnnotationAssertion(rdfs:label goldbook:09027 "Henry’s law volatility constant (via p and x)")
AnnotationAssertion(dcterms:description goldbook:09027 "Partial pressure \\(p\\) of a species in the gas phase divided by the amount fraction \\(x\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{px}: = \\underset{x \\to 0}{\\rm{lim}}\\frac{p}{x}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09027 "Henry volatility (defined via partial pressure and liquid-phase amount fraction)")
Declaration(Class(goldbook:09028))
AnnotationAssertion(rdfs:label goldbook:09028 "Henry’s law volatility constant (via p and w)")
AnnotationAssertion(dcterms:description goldbook:09028 "Partial pressure \\(p\\) of a species in the gas phase divided by the mass fraction \\(w\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{pw}: = \\underset{w \\to 0}{\\rm{lim}}\\frac{p}{w}\\]")
Declaration(Class(goldbook:09029))
AnnotationAssertion(rdfs:label goldbook:09029 "link")
AnnotationAssertion(dcterms:description goldbook:09029 "Constitutive part of a conjugation that binds an active species to a substrate.")
Declaration(Class(goldbook:09030))
AnnotationAssertion(rdfs:label goldbook:09030 "prodrug conjugate")
AnnotationAssertion(dcterms:description goldbook:09030 "Conjugate in which at least one conjugation includes a bioactive active species to be released by cleavage of the link where its action is desired.")
Declaration(Class(goldbook:09031))
AnnotationAssertion(rdfs:label goldbook:09031 "spacer arm")
AnnotationAssertion(dcterms:description goldbook:09031 "Link used in a conjugation to distance the substrate from the active species that otherwise would have its activity affected by steric or other influences.")
Declaration(Class(goldbook:09032))
AnnotationAssertion(rdfs:label goldbook:09032 "materials chemistry")
AnnotationAssertion(dcterms:description goldbook:09032 "Materials chemistry is the scientific discipline that designs, synthesizes, and characterizes materials with particular interest on both their processing and the understanding of useful or potentially useful properties displayed by the materials designed and synthesized for specific applications.")
Declaration(Class(goldbook:09033))
AnnotationAssertion(rdfs:label goldbook:09033 "pnictogen bond")
AnnotationAssertion(dcterms:description goldbook:09033 "Weak attractive interaction between an electrophilic region on a pnictogen atom in a molecular entity (wherein the pnictogen is involved in other stronger bonds) and a nucleophilic region in another, or the same, molecular entity.")
Declaration(Class(goldbook:09034))
AnnotationAssertion(rdfs:label goldbook:09034 "alkalinity")
AnnotationAssertion(dcterms:description goldbook:09034 "Measure of the capacity of aqueous media to react with hydrogen ions.")
Declaration(Class(goldbook:09035))
AnnotationAssertion(rdfs:label goldbook:09035 "back titration")
AnnotationAssertion(dcterms:description goldbook:09035 "Titration of remaining reagent after addition of excess reagent to the titrand.")
Declaration(Class(goldbook:09036))
AnnotationAssertion(rdfs:label goldbook:09036 "blank titration")
AnnotationAssertion(dcterms:description goldbook:09036 "Titration performed with titrand containing no analyte.")
Declaration(Class(goldbook:09037))
AnnotationAssertion(rdfs:label goldbook:09037 "cerimetric titration")
AnnotationAssertion(dcterms:description goldbook:09037 "Redox titration using cerium(IV), in which an iron(II)-1,10-phenanthroline complex (ferroin) color change indicates the end-point.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09037 "cerimetry")
Declaration(Class(goldbook:09038))
AnnotationAssertion(rdfs:label goldbook:09038 "composite alkalinity")
AnnotationAssertion(dcterms:description goldbook:09038 "Measurement by titration to the phenolphthalein end-point (pH 8.3) of that portion of alkalinity arbitrarily attributed to all the hydroxyl content and half the carbonate content of a titrand.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09038 "phenolphthalein end-point alkalinity")
Declaration(Class(goldbook:09039))
AnnotationAssertion(rdfs:label goldbook:09039 "conventional mass")
AnnotationAssertion(dcterms:description goldbook:09039 "Mass of a body that is balanced by a standard mass under conventionally chosen conditions.")
Declaration(Class(goldbook:09040))
AnnotationAssertion(rdfs:label goldbook:09040 "direct titration")
AnnotationAssertion(dcterms:description goldbook:09040 "Titration in which titrant is added directly to titrand.")
Declaration(Class(goldbook:09041))
AnnotationAssertion(rdfs:label goldbook:09041 "end-point error")
AnnotationAssertion(dcterms:description goldbook:09041 "Difference in the volume or mass of titrant, or the corresponding difference in the volume or mass of titrand, between the end-point value and equivalence-point value.")
Declaration(Class(goldbook:09042))
AnnotationAssertion(rdfs:label goldbook:09042 "equivalence-point")
AnnotationAssertion(dcterms:description goldbook:09042 "Stage of a titration at which the titrant has completely reacted with the titrand according to the stoichiometry of the reaction.")
Declaration(Class(goldbook:09043))
AnnotationAssertion(rdfs:label goldbook:09043 "gravimetric analysis")
AnnotationAssertion(dcterms:description goldbook:09043 "Measurement principle of quantitative chemical analysis based on measurement of mass.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09043 "gravimetry")
Declaration(Class(goldbook:09044))
AnnotationAssertion(rdfs:label goldbook:09044 "gravimetric factor")
AnnotationAssertion(dcterms:description goldbook:09044 "Mass fraction of analyte in a precipitate (see precipitation) obtained in a gravimetric analysis.")
Declaration(Class(goldbook:09045))
AnnotationAssertion(rdfs:label goldbook:09045 "homogeneous precipitation")
AnnotationAssertion(dcterms:description goldbook:09045 "Precipitation in gravimetric analysis in which the precipitating agent is produced from a homogeneously dissolved precursor to minimise local excesses and supersaturation.")
Declaration(Class(goldbook:09046))
AnnotationAssertion(rdfs:label goldbook:09046 "indicator consumption error")
AnnotationAssertion(dcterms:description goldbook:09046 "Systematic measurement error from the reaction of a visual indicator with a reactant in a titration.")
Declaration(Class(goldbook:09047))
AnnotationAssertion(rdfs:label goldbook:09047 "potentiometric titration")
AnnotationAssertion(dcterms:description goldbook:09047 "Redox titration in which the course of the reaction is followed by potentiometry.")
Declaration(Class(goldbook:09048))
AnnotationAssertion(rdfs:label goldbook:09048 "precipitation indicator")
AnnotationAssertion(dcterms:description goldbook:09048 "Visual indicator precipitated, with concomitant color change, by reaction with excess titrant at the end-point of a titration.")
Declaration(Class(goldbook:09049))
AnnotationAssertion(rdfs:label goldbook:09049 "redox indicator")
AnnotationAssertion(dcterms:description goldbook:09049 "Visual indicator that reacts with excess titrant or titrand with a color change at the end-point of a redox titration.")
Declaration(Class(goldbook:09050))
AnnotationAssertion(rdfs:label goldbook:09050 "stock solution")
AnnotationAssertion(dcterms:description goldbook:09050 "Solution prepared by weighing an appropriate portion of a solid or by measuring out an appropriate volume of a liquid and dissolving it in the weighed mass of solvent or by adding solvent to a given volume.")
Declaration(Class(goldbook:09051))
AnnotationAssertion(rdfs:label goldbook:09051 "titrand")
AnnotationAssertion(dcterms:description goldbook:09051 "Reactant solution being titrated in a titration.")
Declaration(Class(goldbook:09052))
AnnotationAssertion(rdfs:label goldbook:09052 "titrimetric analysis")
AnnotationAssertion(dcterms:description goldbook:09052 "Methods of quantitative analysis employing titration.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09052 "titrimetry")
Declaration(Class(goldbook:09053))
AnnotationAssertion(rdfs:label goldbook:09053 "transition potential")
AnnotationAssertion(dcterms:description goldbook:09053 "Potential at the end-point of a redox titration.")
Declaration(Class(goldbook:09054))
AnnotationAssertion(rdfs:label goldbook:09054 "universal indicator")
AnnotationAssertion(dcterms:description goldbook:09054 "Visual indicator composed of a solution of several pH indicators (main components are thymol blue, methyl red, bromothymol blue and phenolphthalein) that changes color through a range of pH values, usually from 1 to 14.")
Declaration(Class(goldbook:09055))
AnnotationAssertion(rdfs:label goldbook:09055 "volumetric titration")
AnnotationAssertion(dcterms:description goldbook:09055 "Titration in which the titrant is added by volume.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09055 "volumetry")
Declaration(Class(goldbook:09056))
AnnotationAssertion(rdfs:label goldbook:09056 "von Weimarn ratio")
AnnotationAssertion(dcterms:description goldbook:09056 "Difference between the concentration of the supersaturated solution (see supersaturation) required for nucleation (\\(Q\\)) and its solubility (\\(S\\)), divided by the solubility, \\((Q − S)/S\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09056 "relative supersaturation")
Declaration(Class(goldbook:09057))
AnnotationAssertion(rdfs:label goldbook:09057 "net faradaic current")
AnnotationAssertion(dcterms:description goldbook:09057 "Algebraic sum of faradaic currents flowing through an electrode.")
Declaration(Class(goldbook:09058))
AnnotationAssertion(rdfs:label goldbook:09058 "electrochemical cell")
AnnotationAssertion(dcterms:description goldbook:09058 "System that consists of at least two electron conductors (electrodes) in contact with ionic conductors (electrolytes).")
Declaration(Class(goldbook:09059))
AnnotationAssertion(rdfs:label goldbook:09059 "electrochemical constants")
AnnotationAssertion(dcterms:description goldbook:09059 "In May 2019, certain fundamental constants that had been measured in SI units have had their numerical values fixed, with no uncertainty, thus defining the units. Of importance to electroanalytical chemistry are the values of the Boltzmann constant, the elementary charge, and the Avogadro constant. These are given in the table below, with calculated values of the Faraday constant (\\(F = e·N_{\\rm{A}}\\)) and gas constant (\\(R = k\\cdot\\!N_{\\rm{A}}\\)).")
Declaration(Class(goldbook:09060))
AnnotationAssertion(rdfs:label goldbook:09060 "electrode")
AnnotationAssertion(dcterms:description goldbook:09060 """Electron conductor in an electrochemical cell connected to the external circuit.\r
Half-cell consisting of at least one electron conductor and at least one ionic conductor (electrolyte).""")
Declaration(Class(goldbook:09061))
AnnotationAssertion(rdfs:label goldbook:09061 "electrolyte")
AnnotationAssertion(dcterms:description goldbook:09061 """Conducting medium in which the flow of electric current is accompanied by the movement of ions.\r
Substance that provides ions on dissolution in a solvent or on melting.""")
Declaration(Class(goldbook:09062))
AnnotationAssertion(rdfs:label goldbook:09062 "electrolytic cell")
AnnotationAssertion(dcterms:description goldbook:09062 "Electrochemical cell in which electrical energy is converted into chemical energy.")
Declaration(Class(goldbook:09063))
AnnotationAssertion(rdfs:label goldbook:09063 "electron number of an electrochemical reaction")
AnnotationAssertion(dcterms:description goldbook:09063 "Number of electrons transferred in a charge transfer reaction between an electrode and a single entity (ion, radical-ion, or molecule) of an electroactive substance, whose identity must be specified.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09063 "charge number")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09063 "number of electrons transferred")
Declaration(Class(goldbook:09064))
AnnotationAssertion(rdfs:label goldbook:09064 "equilibrium electrode potential")
AnnotationAssertion(dcterms:description goldbook:09064 "Potential of an electrode when no electric current flows through the cell and all local charge transfer equilibria across phase boundaries that are represented in the cell diagram (except at possible electrolyte-electrolyte junctions) and local chemical equilibria are established.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09064 "Nernst potential")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09064 "reversible potential")
Declaration(Class(goldbook:09065))
AnnotationAssertion(rdfs:label goldbook:09065 "formal electrode potential")
AnnotationAssertion(dcterms:description goldbook:09065 """Equilibrium electrode potential under conditions of unit concentration of species involved in the electrode reaction. \\[E_{\\rm{eq}} = E^{\\circ\\prime} - (RT/zF) \\mathop \\sum \\limits_{i} 
u_{i} \\ln(c_{i}/c^{\\circ)\\] where \\(E_{\\rm{eq}}\\) is the equilibrium electrode potential, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(F\\) the Faraday constant, \\(z\\) the electron number of an electrochemical reaction, \\(
u_{\\rm{i}}\\) the stoichiometric coefficients (numbers of species) in the equation of the electrode reaction (positive for products and negative for reactants), and \\(c_{\\rm{i}}\\) are the amount concentrations of the species involved (most usually ions).""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09065 "formal potential")
Declaration(Class(goldbook:09066))
AnnotationAssertion(rdfs:label goldbook:09066 "galvanic cell")
AnnotationAssertion(dcterms:description goldbook:09066 "Electrochemical cell in which chemical reactions occur spontaneously and chemical energy is converted into electrical energy.")
Declaration(Class(goldbook:09067))
AnnotationAssertion(rdfs:label goldbook:09067 "line representation of electrochemical cells")
AnnotationAssertion(dcterms:description goldbook:09067 """Notation giving electrodes, electroactive substances, and other relevant information for an electrochemical cell.
The notation starts and finishes with an electrode. Phase boundaries are denoted with a solid vertical bar \\(|\\), boundaries between miscible liquids by a vertical dashed bar \\(¦\\), and a liquid junction by double vertical dashed bars \\(¦¦\\).""")
Declaration(Class(goldbook:09068))
AnnotationAssertion(rdfs:label goldbook:09068 "Nernst equation")
AnnotationAssertion(dcterms:description goldbook:09068 """Fundamental equation in electrochemistry that describes the dependence of the equilibrium electrode potential on the composition of the contacting phases, written as a reduction: \\[E_{\\rm{eq}} = E^{\\circ}\\!-\\!(RT/zF)\\mathop \\sum \\limits_i 
u_i \\ln(a_i)\\] where \\(E_{\\rm{eq}}\\) is the equilibrium electrode potential, \\(E^{\\circ}\\) the standard electrode potential of the reaction, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(F\\) the Faraday constant, \\(z\\) the electron number of an electrochemical reaction, and \\(
u_{\\rm{i}}\\) are the stoichiometric coefficients (numbers of species) in the equation of the electrode reaction, positive for products and negative for reactants, while \\(a_{\\rm{i}}\\) represents the activities of the species involved (most usually ions).""")
Declaration(Class(goldbook:09069))
AnnotationAssertion(rdfs:label goldbook:09069 "Cottrell equation")
AnnotationAssertion(dcterms:description goldbook:09069 "Equation for diffusion current \\(I_{\\rm{d}}\\) at time \\(t\\) at a large planar electrode in contact with a semi-infinite layer of unstirred solution containing excess supporting (inert) electrolyte and an electroactive substance of bulk concentration \\(c\\) when, at the instant \\(t = 0\\), the potential of the electrode is suddenly changed to a value at which a mass-transport limited electrochemical reaction occurs and the concentration of the electroactive species at the electrode is zero, \\[I_{\\rm{d}} = zFA{D^{1/2}}c/(\\pi^{1/2} t^{1/2})\\] where \\(z\\) is the electron number of an electrochemical reaction in the charge transfer step of the species (being positive for an oxidation and negative for a reduction), \\(F\\) the Faraday constant, \\(A\\) the electrode surface area, and \\(D\\) the diffusion coefficient of the electroactive substance.")
Declaration(Class(goldbook:09070))
AnnotationAssertion(rdfs:label goldbook:09070 "current-potential curve")
AnnotationAssertion(dcterms:description goldbook:09070 "Plot of current versus applied potential (\\(I\\!{-}\\!E\\)) for a given system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09070 "I-E curve")
Declaration(Class(goldbook:09071))
AnnotationAssertion(rdfs:label goldbook:09071 "electrochemical biosensor")
AnnotationAssertion(dcterms:description goldbook:09071 "Electrochemical sensor that has a biological recognition element.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09071 "bioanalytical sensor")
Declaration(Class(goldbook:09072))
AnnotationAssertion(rdfs:label goldbook:09072 "electrochemical sensor")
AnnotationAssertion(dcterms:description goldbook:09072 "Measuring system in which the response to an electrochemical reaction is converted, via a suitable transducer, into a measurable electrical signal.")
Declaration(Class(goldbook:09073))
AnnotationAssertion(rdfs:label goldbook:09073 "electrode coverage density")
AnnotationAssertion(dcterms:description goldbook:09073 "Amount of a chemical modifier at an electrode surface per unit area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09073 "electrode coverage")
Declaration(Class(goldbook:09074))
AnnotationAssertion(rdfs:label goldbook:09074 "electrode surface area")
AnnotationAssertion(dcterms:description goldbook:09074 "Area of electrode–solution interface.")
Declaration(Class(goldbook:09075))
AnnotationAssertion(rdfs:label goldbook:09075 "Faraday’s laws of electrolysis")
AnnotationAssertion(dcterms:description goldbook:09075 """Faraday’s First Law of electrolysis: Mass \\(m\\) of electrochemically-transformed substance is proportional to the charge \\(Q\\) passed, \\(m\\! \\propto\\! Q\\).
Faraday’s Second Law of electrolysis: When the same electric charge (quantity of electricity) \\(Q\\) is passed through several electrolytes, the mass \\(m_{\\rm{i}}\\) of the substances deposited are proportional to their respective chemical equivalent molar mass, \\(M_{\\rm{i}}/z_{\\rm{i}}\\). \\[m_{1}/m_{2} = (M_{1}/z_{1})/(M_{2}/z_{2})\\]""")
Declaration(Class(goldbook:09076))
AnnotationAssertion(rdfs:label goldbook:09076 "galvanostat")
AnnotationAssertion(dcterms:description goldbook:09076 "Instrument which controls the electric current between the working electrode and the auxiliary electrode.")
Declaration(Class(goldbook:09077))
AnnotationAssertion(rdfs:label goldbook:09077 "open circuit potential")
AnnotationAssertion(dcterms:description goldbook:09077 "Electrode potential of working electrode relative to the reference electrode when no potential or electric current is being applied to the electrochemical cell.")
Declaration(Class(goldbook:09078))
AnnotationAssertion(rdfs:label goldbook:09078 "polarizable electrode")
AnnotationAssertion(dcterms:description goldbook:09078 "Electrode whose potential changes with an applied potential.")
Declaration(Class(goldbook:09079))
AnnotationAssertion(rdfs:label goldbook:09079 "potentiostat")
AnnotationAssertion(dcterms:description goldbook:09079 "Measuring instrument for electric current that controls the potential difference between a working electrode and a reference electrode and measures the electric current between a working electrode and an auxiliary electrode.")
Declaration(Class(goldbook:09080))
AnnotationAssertion(rdfs:label goldbook:09080 "salt bridge")
AnnotationAssertion(dcterms:description goldbook:09080 "Means of making electrolytic connection between two half cells without introducing a significant liquid junction potential.")
Declaration(Class(goldbook:09081))
AnnotationAssertion(rdfs:label goldbook:09081 "three-electrode cell")
AnnotationAssertion(dcterms:description goldbook:09081 "Electrochemical cell with a working electrode, reference electrode, and auxiliary electrode.Schematic of a three-electrode cell. 1 - working electrode, 2 - reference electrode, 3 - auxiliary electrode. The potential between 1 and 2 is set while passing and measuring current between 1 and 3.")
Declaration(Class(goldbook:09082))
AnnotationAssertion(rdfs:label goldbook:09082 "working potential range")
AnnotationAssertion(dcterms:description goldbook:09082 "Range of electrode potentials of a given working electrode in a given electrolyte, where the electric current from reactions of the electrode or electrolyte is negligible compared with the current from reactions of the system under investigation.")
Declaration(Class(goldbook:09083))
AnnotationAssertion(rdfs:label goldbook:09083 "macroelectrode")
AnnotationAssertion(dcterms:description goldbook:09083 "Electrode with smallest dimension of order millimetre or greater.")
Declaration(Class(goldbook:09084))
AnnotationAssertion(rdfs:label goldbook:09084 "microelectrode")
AnnotationAssertion(dcterms:description goldbook:09084 "Electrode with smallest dimension of less than 1 millimetre and greater than 1 micrometre.")
Declaration(Class(goldbook:09085))
AnnotationAssertion(rdfs:label goldbook:09085 "ultramicroelectrode")
AnnotationAssertion(dcterms:description goldbook:09085 "Electrode with smallest dimension of less than 25 micrometre.")
Declaration(Class(goldbook:09086))
AnnotationAssertion(rdfs:label goldbook:09086 "nanoelectrode")
AnnotationAssertion(dcterms:description goldbook:09086 "Electrode with smallest dimension less than 1 micrometre")
Declaration(Class(goldbook:09087))
AnnotationAssertion(rdfs:label goldbook:09087 "quasi-reference electrode")
AnnotationAssertion(dcterms:description goldbook:09087 "Electrode that maintains a constant, but not generally well-defined, potential in an electrochemical cell.")
Declaration(Class(goldbook:09088))
AnnotationAssertion(rdfs:label goldbook:09088 "glassy carbon electrode")
AnnotationAssertion(dcterms:description goldbook:09088 "Electrode made of glassy carbon material with an intertwined graphitic ribbon structure, formed by pyrolysis of a resol precursor at temperatures up to \\(\\pu{3000^{\\circ}C}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09088 "vitreous carbon electrode")
Declaration(Class(goldbook:09089))
AnnotationAssertion(rdfs:label goldbook:09089 "highly oriented pyrolytic graphite electrode")
AnnotationAssertion(dcterms:description goldbook:09089 "Graphite electrode of material produced by high temperature deposition of carbon on a ceramic surface and subject to graphitization at \\(\\pu{3000^{\\circ}C}\\)")
Declaration(Class(goldbook:09090))
AnnotationAssertion(rdfs:label goldbook:09090 "paraffin impregnated graphite electrode")
AnnotationAssertion(dcterms:description goldbook:09090 "Graphite electrode based on a graphitic material impregnated with paraffin having a high melting point.")
Declaration(Class(goldbook:09091))
AnnotationAssertion(rdfs:label goldbook:09091 "boron-doped diamond electrode")
AnnotationAssertion(dcterms:description goldbook:09091 "Electrode composed of a boron-doped diamond film on an electron-conducting substrate.")
Declaration(Class(goldbook:09092))
AnnotationAssertion(rdfs:label goldbook:09092 "biorecognition")
AnnotationAssertion(dcterms:description goldbook:09092 "Detection principle for a chemically modified electrode (CME) in which the electrode is modified by a biological recognition element.")
Declaration(Class(goldbook:09093))
AnnotationAssertion(rdfs:label goldbook:09093 "change of mass")
AnnotationAssertion(dcterms:description goldbook:09093 "Detection principle for a chemically modified electrode (CME) in which the signal originates from accumulation and/or release of an analyte or reagent as well as other electrochemical processes which can result in changes in the mass of the CME.")
Declaration(Class(goldbook:09094))
AnnotationAssertion(rdfs:label goldbook:09094 "electrocatalysis")
AnnotationAssertion(dcterms:description goldbook:09094 "Detection principle for a chemically modified electrode (CME) in which a charge transfer reaction between a CME and analyte proceeds at a lower overpotential than at the bare electrode. Usually, the effect of electrocatalysis is also an increase of faradaic current.")
Declaration(Class(goldbook:09095))
AnnotationAssertion(rdfs:label goldbook:09095 "redox mediation")
AnnotationAssertion(dcterms:description goldbook:09095 "Detection principle for a chemically modified electrode (CME) in which an immobilized redox couple can shuttle electrons between the electrode and an analyte, for instance, one with difficult access to the electrode surface because of steric reasons.")
Declaration(Class(goldbook:09096))
AnnotationAssertion(rdfs:label goldbook:09096 "carbon paste electrode")
AnnotationAssertion(dcterms:description goldbook:09096 "Electrode of a composite of carbon powder and a pasting liquid (including mineral oil, Nujol, bromoform, bromonaphthalene).")
Declaration(Class(goldbook:09097))
AnnotationAssertion(rdfs:label goldbook:09097 "carbon ink electrode")
AnnotationAssertion(dcterms:description goldbook:09097 "Development of a carbon paste electrode that is screen printed using a carbon/polymer mixture of suitable composition.")
Declaration(Class(goldbook:09098))
AnnotationAssertion(rdfs:label goldbook:09098 "solid amalgam electrode")
AnnotationAssertion(dcterms:description goldbook:09098 "Electrode made of a solid amalgam of an appropriate metal.")
Declaration(Class(goldbook:09099))
AnnotationAssertion(rdfs:label goldbook:09099 "gold electrode")
AnnotationAssertion(dcterms:description goldbook:09099 "Foil, wire or disc electrode made of gold which is easily fabricated into a variety of electrode geometries.")
Declaration(Class(goldbook:09100))
AnnotationAssertion(rdfs:label goldbook:09100 "platinum electrode")
AnnotationAssertion(dcterms:description goldbook:09100 "Foil, wire, disc, or mesh electrode made of platinum, which is the most commonly used metallic working electrode in electrochemistry.")
Declaration(Class(goldbook:09101))
AnnotationAssertion(rdfs:label goldbook:09101 "silver electrode")
AnnotationAssertion(dcterms:description goldbook:09101 "Electrode in the form of foil, mesh, wire, rod, tube, powder, pellets, or single crystal of silver.")
Declaration(Class(goldbook:09102))
AnnotationAssertion(rdfs:label goldbook:09102 "mercury electrode")
AnnotationAssertion(dcterms:description goldbook:09102 "Liquid metal electrode used in polarography.")
Declaration(Class(goldbook:09103))
AnnotationAssertion(rdfs:label goldbook:09103 "dropping mercury electrode")
AnnotationAssertion(dcterms:description goldbook:09103 "Mercury electrode formed by sequence of mercury drops falling from a small aperture.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09103 "DME")
Declaration(Class(goldbook:09104))
AnnotationAssertion(rdfs:label goldbook:09104 "bimetallic electrode")
AnnotationAssertion(dcterms:description goldbook:09104 "Electrode containing two different metals (e.g. platinum and ruthenium) on its surface (e.g. to modify its electrocatalytic properties).")
Declaration(Class(goldbook:09105))
AnnotationAssertion(rdfs:label goldbook:09105 "chemically-sensitive field effect transistor")
AnnotationAssertion(dcterms:description goldbook:09105 "Non-faradaic electrode system in which electric field variations in the semiconductor gate region control the magnitude of the source-drain current.")
Declaration(Class(goldbook:09106))
AnnotationAssertion(rdfs:label goldbook:09106 "chemically-modified electrode")
AnnotationAssertion(dcterms:description goldbook:09106 "Electrode coated with a thin layer of a substance that exhibits particular chemical, electrochemical, and/or optical properties.")
Declaration(Class(goldbook:09107))
AnnotationAssertion(rdfs:label goldbook:09107 "enzyme-modified electrode")
AnnotationAssertion(dcterms:description goldbook:09107 "Chemically-modified electrode in which the products of a reaction between enzymes in an immobilized enzyme layer and the enzyme reaction substrate are electrochemically active and are measured usually by amperometry or potentiometry.Schematic of the mediated oxidation of glucose to gluconolactone by glucose oxidase. The current passed to re-oxidise the mediator is proportional to the amount concentration of glucose.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09107 "enzyme electrode")
Declaration(Class(goldbook:09108))
AnnotationAssertion(rdfs:label goldbook:09108 "homogeneous crystalline membrane electrodes")
AnnotationAssertion(dcterms:description goldbook:09108 "ISE in which the membrane is a crystalline material prepared from either a single compound or a homogeneous mixture of compounds.")
Declaration(Class(goldbook:09109))
AnnotationAssertion(rdfs:label goldbook:09109 "heterogeneous crystalline membrane electrodes")
AnnotationAssertion(dcterms:description goldbook:09109 "ISE prepared of an active substance, or mixture of active substances, mixed with an inert matrix (such as silicone rubber or \\(\\ce{PVC}\\)), or placed on hydrophobized graphite or conducting epoxy resin, to form a heterogeneous sensing membrane.")
Declaration(Class(goldbook:09110))
AnnotationAssertion(rdfs:label goldbook:09110 "non-crystalline membrane")
AnnotationAssertion(dcterms:description goldbook:09110 "Kind of ion-selective membranes used in an ISE which is a support matrix, containing an ion exchanger (either cationic or anionic), a plasticizer solvent, and possibly an uncharged, selectivity-enhancing species, form the ion-selective membrane which is usually interposed between two aqueous solutions. The matrix can be either macroporous (e.g., poly(propylene carbonate) filter, glass frit, etc.) or microporous (e.g., “thirsty” glass or polymeric material such as \\(\\ce{PVC}\\)) yielding with the ion-exchanger and the solvent a “solidified” homogeneous mixture.")
Declaration(Class(goldbook:09111))
AnnotationAssertion(rdfs:label goldbook:09111 "rigid membranes")
AnnotationAssertion(dcterms:description goldbook:09111 "Kind of ion-selective membranes used in an ISE comprising synthetic cross-linked polymer with fixed sites or thin glass membrane.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09111 "matrix membranes")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09111 "self-supporting membranes")
Declaration(Class(goldbook:09112))
AnnotationAssertion(rdfs:label goldbook:09112 "membranes with mobile charged sites")
AnnotationAssertion(dcterms:description goldbook:09112 """Kind of ion-selective membranes used in an ISE comprising:

Positively-charged, hydrophobic cations which, when dissolved in a suitable organic solvent and held in an inert support (e.g., poly(propylenecarbonate) filter or \\(\\ce{PVC}\\)), provide membranes which are sensitive to changes in the activities of anions.
Negatively-charged hydrophobic anions which, when dissolved in a suitable organic solvent and held in an inert support (e.g., poly(propylene carbonate) filter or \\(\\ce{PVC}\\)), provide membranes which are sensitive to changes of cation activities.
Uncharged “carrier” electrodes based on solutions of molecular complexing agents of cations and anions, which can be used for preparing ion exchanger membranes sensitive and selective to certain cations and anions.
Hydrophobic ion-pair electrodes of plasticized polymers (e.g., \\(\\ce{PVC}\\)) containing a dissolved hydrophobic ion-pair respond to the ion activities of those components, which are relevant to the ion-pairs incorporated in the membrane. The responses can be Nernstian.""")
Declaration(Class(goldbook:09113))
AnnotationAssertion(rdfs:label goldbook:09113 "combined electrode")
AnnotationAssertion(dcterms:description goldbook:09113 "Ion-selective electrode cell in which the ion-selective electrode and reference electrode are combined in a single sensor assembly, thereby avoiding the need for a separate external reference electrode.")
Declaration(Class(goldbook:09114))
AnnotationAssertion(rdfs:label goldbook:09114 "electrode array")
AnnotationAssertion(dcterms:description goldbook:09114 "Assembly of linked electrodes (usually microelectrodes, ultramicroelectrodes or nanoelectrodes) acting as a single electrode.")
Declaration(Class(goldbook:09115))
AnnotationAssertion(rdfs:label goldbook:09115 "glass pH-sensitive electrode")
AnnotationAssertion(dcterms:description goldbook:09115 "pH-sensitive electrode, usually consisting of a bulb, or other suitable form, of special glass attached to a stem of high-resistance glass, complete with an internal reference electrode and internal filling solution system.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09115 "glass electrode")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09115 "pH electrode")
Declaration(Class(goldbook:09116))
AnnotationAssertion(rdfs:label goldbook:09116 "heterogeneous crystalline membrane ion-selective electrode")
AnnotationAssertion(dcterms:description goldbook:09116 "Ion-selective electrode in which the ion-selective membrane is a crystalline material mixed with an inert matrix (such as silicone rubber or polyvinyl chloride), or placed on hydrophobized graphite or conducting epoxy resin, to form a heterogeneous sensing membrane.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09116 "heterogeneous crystalline membrane electrode")
Declaration(Class(goldbook:09117))
AnnotationAssertion(rdfs:label goldbook:09117 "homogeneous crystalline membrane ion-selective electrode")
AnnotationAssertion(dcterms:description goldbook:09117 "Ion-selective electrode in which the ion-selective membrane is a crystalline material prepared from either a single compound or homogeneous mixture of compounds.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09117 "homogeneous crystalline membrane electrode")
Declaration(Class(goldbook:09118))
AnnotationAssertion(rdfs:label goldbook:09118 "ion-selective field effect transistor")
AnnotationAssertion(dcterms:description goldbook:09118 "Electrochemical sensor based on the principle of the field effect transistor (FET) in which the surface of the gate is modified in a way that makes the response ion-selective.")
Declaration(Class(goldbook:09119))
AnnotationAssertion(rdfs:label goldbook:09119 "ion-selective membrane")
AnnotationAssertion(dcterms:description goldbook:09119 "Membrane with controlled permeability to a particular ion covering an electrode, or separating two electrolyte solutions.")
Declaration(Class(goldbook:09120))
AnnotationAssertion(rdfs:label goldbook:09120 "Nikolsky–Eisenman equation")
AnnotationAssertion(dcterms:description goldbook:09120 "Equation describing the contribution of interfering ions, \\(i\\), to the electrode potential of an ion-selective electrode that is mainly dominated by the primary ion \\(\\ce{X}\\). \\[E = {\\rm{const}} + \\frac{RT}{z_{\\rm{X}}F} \\ln \\left(a_{\\ce{X}} + \\sum\\limits_i K_{{\\ce{X}},i}^{\\rm{pot}}a_{i}^{(z_{\\ce{X}}/z_i)} \\right)\\] where \\(E\\) is the measured electrode potential of an ISE when the only variables are activities in the test solution. \\(R\\) is the gas constant, \\(T\\) the thermodynamic temperature, \\(z_{\\rm{X}}\\) and \\(z_{\\rm{i}}\\) are the numbers of electrons transferred by the analyte ion \\(\\ce{X}\\) and \\(i\\), respectively, \\(F\\) is the Faraday constant, \\(a_{\\rm{X}}\\) and \\(a_{\\rm{i}}\\) the activity of \\(\\ce{X}\\) and \\(i\\), respectively, and \\(K_{\\ce{X},i}^{\\rm{pot}}\\) is the potentiometric selectivity coefficient for interfering ion \\(i\\) with respect to the primary ion \\(\\ce{X}\\).")
Declaration(Class(goldbook:09121))
AnnotationAssertion(rdfs:label goldbook:09121 "pH-sensitive electrode")
AnnotationAssertion(dcterms:description goldbook:09121 "Potentiometric electrochemical sensor that measures pH as a linear function of electrode potential.")
Declaration(Class(goldbook:09122))
AnnotationAssertion(rdfs:label goldbook:09122 "potentiometric enzyme electrode")
AnnotationAssertion(dcterms:description goldbook:09122 "Enzyme-modified electrode, or an electrode modified by a substrate, cofactor or inhibitor, in which the activity of a product of the enzyme reaction is measured by an ion-selective electrode.")
Declaration(Class(goldbook:09123))
AnnotationAssertion(rdfs:label goldbook:09123 "potentiometric gas sensor")
AnnotationAssertion(dcterms:description goldbook:09123 "Ion-selective electrode cell that is responsive to an analyte gas.")
Declaration(Class(goldbook:09124))
AnnotationAssertion(rdfs:label goldbook:09124 "rotating disc electrode")
AnnotationAssertion(dcterms:description goldbook:09124 "A disc electrode that is embedded in the centre of a cylinder which rotates in solution around the longitudinal cylinder axis.")
Declaration(Class(goldbook:09125))
AnnotationAssertion(rdfs:label goldbook:09125 "wall-jet electrode")
AnnotationAssertion(dcterms:description goldbook:09125 "A disc electrode with a thin circular jet of fluid impinging on its centre.")
Declaration(Class(goldbook:09126))
AnnotationAssertion(rdfs:label goldbook:09126 "chronopotentiometry")
AnnotationAssertion(dcterms:description goldbook:09126 "Potentiometry in which the potential is measured with time following a change in applied current.")
Declaration(Class(goldbook:09127))
AnnotationAssertion(rdfs:label goldbook:09127 "potentiometry")
AnnotationAssertion(dcterms:description goldbook:09127 "Electrochemical measurement principle where the potential difference between an indicator electrode and a reference electrode is measured.")
Declaration(Class(goldbook:09128))
AnnotationAssertion(rdfs:label goldbook:09128 "amperometry")
AnnotationAssertion(dcterms:description goldbook:09128 "Electrochemical measurement principle based on measurement of current at a controlled applied potential.")
Declaration(Class(goldbook:09129))
AnnotationAssertion(rdfs:label goldbook:09129 "chronoamperometry")
AnnotationAssertion(dcterms:description goldbook:09129 "Amperometry in which the current is measured as a function of time after a change in the applied potential.")
Declaration(Class(goldbook:09130))
AnnotationAssertion(rdfs:label goldbook:09130 "AC voltammetry")
AnnotationAssertion(dcterms:description goldbook:09130 "Voltammetry in which a sinusoidal alternating potential of small amplitude (\\(\\pu{10 to 50 mV}\\)) of constant frequency (\\(\\pu{10 Hz to 100 kHz}\\)) is superimposed on a slowly and linearly varying potential ramp. The resulting alternating current is plotted versus imposed DC potential. The obtained AC voltammogram is peak-shaped.Waveform for AC voltammetry. The applied potential as a function of time is a sinusoidal alternating potential superimposed on a linearly increasing ramp.")
Declaration(Class(goldbook:09131))
AnnotationAssertion(rdfs:label goldbook:09131 "chronocoulometric constant")
AnnotationAssertion(dcterms:description goldbook:09131 "Empirically-determined quantity defined by the equation \\[{\\cal Q} = (1/Ac)\\Delta Q/\\Delta (t^{1/2})\\] where \\(A\\) is the electrode surface area, \\(c\\) is the bulk concentration of the electroactive substance, \\(Q\\) is the charge passed, and \\(\\Delta Q/\\Delta(t^{1/2})\\) is the slope of a plot of \\(Q\\) against \\(t^{1/2}\\).")
Declaration(Class(goldbook:09132))
AnnotationAssertion(rdfs:label goldbook:09132 "chronopotentiometric constant")
AnnotationAssertion(dcterms:description goldbook:09132 "Empirically-evaluated quantity defined by the equation \\[{\\cal T} = I\\tau^{1/2}/(A c_{B}) = j\\tau^{1/2}/c_{\\ce{B}}\\] where \\(I\\) is the electric current, \\(\\tau\\) is the transition time, \\(A\\) is the electrode surface area, \\(\\ce{B}\\) is the bulk concentration of the electroactive substance \\(\\ce{B}\\), and \\(j=I/A\\) is the current density.")
Declaration(Class(goldbook:09133))
AnnotationAssertion(rdfs:label goldbook:09133 "current sampling")
AnnotationAssertion(dcterms:description goldbook:09133 "Measurement of electric current in voltammetry.")
Declaration(Class(goldbook:09134))
AnnotationAssertion(rdfs:label goldbook:09134 "cyclic voltammetry")
AnnotationAssertion(dcterms:description goldbook:09134 "Voltammetry in which the electric current is recorded as the electrode potential is varied with time cyclically between two potential limits, normally at a constant scan rate.Cyclic voltammetry. (a) Variation of applied potential with time. (b) Cyclic voltammogram of current against applied potential for a reversible redox couple.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09134 "cyclic linear scan voltammetry")
Declaration(Class(goldbook:09135))
AnnotationAssertion(rdfs:label goldbook:09135 "DC polarography")
AnnotationAssertion(dcterms:description goldbook:09135 "Linear scan voltammetry with slow scan rate in which a dropping mercury electrode is used as the working electrode. See figure.Electric current as a function of applied potential for DC polarography, showing oscillations of current as the dropping mercury electrode grows and is detached.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09135 "classical polarography")
Declaration(Class(goldbook:09136))
AnnotationAssertion(rdfs:label goldbook:09136 "differential pulse voltammetry")
AnnotationAssertion(dcterms:description goldbook:09136 "Voltammetry in which small potential pulses (constant height \\(\\pu{10 to 100 mV}\\), constant width \\(\\pu{10 to 100 ms}\\)) are superimposed onto a linearly varying potential or onto a staircase potential ramp. The current is sampled just before the onset of the pulse (e.g. \\(\\pu{10 to 20 ms}\\)) and for the same sampling time just before the end of the pulse. The difference between the two sampled currents is plotted versus the potential applied before the pulse. Thus, a differential pulse voltammogram is peak-shaped.(a) Potential waveform for differential pulse voltammetry (not to scale). Typical values for pulse parameters are $\\tau$=1 s, $t_{\\rm{p}}$=50 ms, $E_{\\tau}$=50 mV, $E_{\\rm{p}}$=2 mV. Sampling interval indicated by horizontal curly brackets is typically 15 ms. (b) Differential pulse voltammogram. $I$ is the difference between currents sampled at ‘2’ and ‘1’.")
Declaration(Class(goldbook:09137))
AnnotationAssertion(rdfs:label goldbook:09137 "Heyrovský–Ilkovič equation")
AnnotationAssertion(dcterms:description goldbook:09137 "The relationship that describes the electrode potential as a function of the current of a reversible redox system (reversible electrode reaction) in the steady state in voltammetry \\[E = E^{\\circ\\prime} - \\frac{RT}{zF} \\ln \\left(\\frac{D_{\\rm{red}}}{D_{\\rm{ox}}}\\right)^{s} \\pm \\frac{RT}{zF} \\ln\\!\\left(\\frac{I_{\\rm{d,lim}} - I}{I}\\right)\\] where \\(E^{\\circ\\prime}\\) is the formal electrode potential, \\(z\\) the electron number of an electrochemical reaction, \\(D_{\\rm{red}}\\) and \\(D_{\\rm{ox}}\\) the diffusion coefficients of the reduced and oxidized forms of the electroactive substance, respectively, \\(I_{\\rm{d,lim}}\\) is the limiting diffusion current, and \\(I\\) is the current at the potential being applied. The value of the exponent \\(s\\) is ½ for a stationary or dropping mercury electrode, ⅔ for a hydrodynamic electrode (see hydrodynamic voltammetry), or 1 for a microelectrode. In the equation, the last term is added for reduction and subtracted for oxidation.")
Declaration(Class(goldbook:09138))
AnnotationAssertion(rdfs:label goldbook:09138 "hydrodynamic voltammetry")
AnnotationAssertion(dcterms:description goldbook:09138 "Voltammetry with forced flow of the solution towards the electrode surface.")
Declaration(Class(goldbook:09139))
AnnotationAssertion(rdfs:label goldbook:09139 "Ilkovič equation")
AnnotationAssertion(dcterms:description goldbook:09139 "Equation relating electric current at a dropping mercury electrode under purely diffusional control, \\(I_{{\\rm{d,}}t}\\), the amount concentration of an electroactive substance at the drop surface \\(c\\), and the concentration in bulk solution \\(c_{\\rm{0}}\\), \\[I_{{\\rm{d}},t} = -k\\,z\\,F\\,D^{1/2}q_{\\rm{m}}^{2/3} t^{1/6}(c - c_{0})\\] where \\(k\\) is a numerical constant, $z$ the electron number of an electrochemical reaction, \\(F\\) the Faraday constant, \\(D\\) the diffusion coefficient of the electroactive substance, \\(q_{\\rm{m}}\\) the mass flux of mercury at the dropping electrode, and \\(t\\) the time elapsed from the beginning of the drop.")
Declaration(Class(goldbook:09140))
AnnotationAssertion(rdfs:label goldbook:09140 "Levich equation")
AnnotationAssertion(dcterms:description goldbook:09140 """Equation relating limiting current at a rotating disc electrode (see hydrodynamic voltammetry) to the amount concentration of an electroactive substance in bulk solution \\(c_{0}\\), \\[I_{\\rm{lim}} = k\\,z\\,F\\,A\\,D^{2/3} \\omega^{1/2} 
u^{−1/6} c_{0}\\] where \\(k\\) is a numerical factor, \\(z\\) the electron number of an electrochemical reaction, \\(F\\) the Faraday constant, \\(A\\) the electrode surface area, \\(D\\) the diffusion coefficient of the electroactive substance, \\(\\omega\\) the angular velocity (rotation rate), and \\(
u\\) the kinematic viscosity of the solution.""")
Declaration(Class(goldbook:09141))
AnnotationAssertion(rdfs:label goldbook:09141 "linear-scan voltammetry")
AnnotationAssertion(dcterms:description goldbook:09141 "Voltammetry in which the electric current is recorded as the electrode potential is varied linearly with time. See figure.Linear scan voltammogram of current against applied potential for a reversible redox couple.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09141 "linear-sweep voltammetry")
Declaration(Class(goldbook:09142))
AnnotationAssertion(rdfs:label goldbook:09142 "normal pulse voltammetry")
AnnotationAssertion(dcterms:description goldbook:09142 "Voltammetry in which potential pulses of amplitude increasing by a constant increment and with a pulse width of \\(\\pu{2 to 200 ms}\\) are superimposed on a constant initial potential. The current is sampled at the end of the pulse and then plotted versus the potential of the pulse. Sigmoidal wave-shaped voltammograms are obtained. See figure.(a) Waveform for normal pulse voltammetry (not to scale). Typical values for pulse parameters are \\(\\tau = \\pu{1 s}\\), \\(t_{\\rm{p}} = \\pu{50 ms}\\), \\(E_{\\rm{p}} = \\pu{2 mV}\\), \\(E_{\\rm{step}} = \\pu{2 mV}\\). Sampling interval indicated by horizontal curly brackets is typically \\(\\pu{15 ms}\\). (b) Normal pulse voltammogram.")
Declaration(Class(goldbook:09143))
AnnotationAssertion(rdfs:label goldbook:09143 "Randles–Ševčík equations")
AnnotationAssertion(dcterms:description goldbook:09143 """Equations describing the peak current \\(I_{\\rm{p}}\\) in linear scan voltammetry and cyclic voltammetry as a function of the amount concentration, \\(c_{\\rm{0}}\\), of electroactive species in bulk solution. For a reversible charge transfer: \\[I_{\\rm{p,rev}} = k\\,z\\,F\\,A\\,c_0 (z\\,F\\,D
u/RT)^{1/2}\\] for irreversible charge transfer: \\[I_{\\rm{p,irrev}} = k^{\\prime}(\\alpha z^{\\prime})^{1/2} zFA{c_0}(FD
u/RT)^{1/2}\\] where \\(k\\) and \\(k^{\\prime}\\) are numerical constants, \\(\\alpha\\) is the charge transfer coefficient (usually assumed to be close to 0.5), \\(z\\) the electron number of an electrochemical reaction, \\(z^{\\prime}\\) the number of electrons transferred before the rate determining step, \\(F\\) the Faraday constant, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(A\\) the electrode surface area, \\(D\\) the diffusion coefficient, and \\(
u\\) the scan rate.""")
Declaration(Class(goldbook:09144))
AnnotationAssertion(rdfs:label goldbook:09144 "rate of flow of liquid metal in polarography")
AnnotationAssertion(dcterms:description goldbook:09144 "Mass of a drop of liquid metal in polarography at the instant when it is detached from the tip of the capillary divided by the drop time \\(t_{\\rm{d}}\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09144 "mass flux")
Declaration(Class(goldbook:09145))
AnnotationAssertion(rdfs:label goldbook:09145 "sampled DC polarography")
AnnotationAssertion(dcterms:description goldbook:09145 "DC polarography with current sampling at the end of each drop life mechanically enforced by a knocker at a preset drop time value. The current sampling and mechanical drop dislodge are synchronized.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09145 "TAST polarography")
Declaration(Class(goldbook:09146))
AnnotationAssertion(rdfs:label goldbook:09146 "scan rate")
AnnotationAssertion(dcterms:description goldbook:09146 "The rate of change of applied potential with time.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09146 "potential scan rate")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09146 "potential sweep rate")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09146 "sweep rate")
Declaration(Class(goldbook:09147))
AnnotationAssertion(rdfs:label goldbook:09147 "square-wave voltammetry")
AnnotationAssertion(dcterms:description goldbook:09147 "Voltammetry in which a square-wave potential waveform is superimposed on an underlying linearlyhyphen‐varying potential ramp or staircase ramp. The current is sampled just before the end of the forward-going pulse and of the backward-going pulse and the difference of the two sampled currents is plotted versus the applied potential of the potential or staircase ramp. The square-wave voltammogram is peak-shaped. See figure.(a) Waveform for square wave voltammetry (not to scale). Typical values for pulse parameters are \\(\\tau = \\pu{10 ms}\\), \\(t_{\\rm{p}} = \\pu{5 ms}\\), \\(E_{\\rm{\\tau}} = \\pu{25 mV}\\), \\(E_{\\rm{step}} = \\pu{4 mV}\\). Sampling interval indicated by horizontal curly brackets is typically \\(\\pu{1 ms}\\). (b) Square wave voltammogram of the difference between currents sampled at ‘2’ and ‘1’ against applied potential.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09147 "Osteryoung square-wave voltammetry (OSWV)")
Declaration(Class(goldbook:09148))
AnnotationAssertion(rdfs:label goldbook:09148 "voltammetry")
AnnotationAssertion(dcterms:description goldbook:09148 "Electrochemical measurement principle in which the electrode potential of a working electrode is controlled and the electric current measured.")
Declaration(Class(goldbook:09149))
AnnotationAssertion(rdfs:label goldbook:09149 "voltammogram")
AnnotationAssertion(dcterms:description goldbook:09149 "Current-potential curve in a voltammetry experiment.")
Declaration(Class(goldbook:09150))
AnnotationAssertion(rdfs:label goldbook:09150 "accumulation in stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09150 "Transfer of an analyte from a test solution to an electrode surface as the first step in stripping voltammetry.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09150 "accumulation")
Declaration(Class(goldbook:09151))
AnnotationAssertion(rdfs:label goldbook:09151 "adsorptive stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09151 "Stripping voltammetry involving pre-concentration by adsorption of the analyte (in contrast to electrochemical accumulation).")
Declaration(Class(goldbook:09152))
AnnotationAssertion(rdfs:label goldbook:09152 "anodic stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09152 "Stripping voltammetry in which material accumulated at the working electrode is electrochemically oxidized in the stripping step.")
Declaration(Class(goldbook:09153))
AnnotationAssertion(rdfs:label goldbook:09153 "cathodic stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09153 "Stripping voltammetry in which material accumulated at the working electrode is electrochemically reduced in the stripping step. See figure.Applied potential against time during the accumulation and stripping steps in cathodic stripping voltammetry.")
Declaration(Class(goldbook:09154))
AnnotationAssertion(rdfs:label goldbook:09154 "potentiometric stripping analysis")
AnnotationAssertion(dcterms:description goldbook:09154 "Two-step electrochemical measurement in which 1) material is accumulated at an electrode and 2) the material is removed by chemical reaction or electrochemically at constant current with measurement of electrode potential. The time between changes in potential in step two is related to the concentration of analyte in the solution.")
Declaration(Class(goldbook:09155))
AnnotationAssertion(rdfs:label goldbook:09155 "stripping voltammetry")
AnnotationAssertion(dcterms:description goldbook:09155 "Two-step electrochemical measurement in which 1) material is accumulated at an electrode and 2) the amount of an accumulated species is measured by voltammetry. The measured electric current in step 2 is related to the concentration of analyte in the solution by calibration.")
Declaration(Class(goldbook:09156))
AnnotationAssertion(rdfs:label goldbook:09156 "chronocoulometry")
AnnotationAssertion(dcterms:description goldbook:09156 "Direct coulometry at controlled potential in which the electric charge passed after the application of a potential step perturbation is measured as a function of time (\\(Q{-}t\\) curve).")
Declaration(Class(goldbook:09157))
AnnotationAssertion(rdfs:label goldbook:09157 "coulometer")
AnnotationAssertion(dcterms:description goldbook:09157 "Measuring instrument to obtain the electrical charge passed in an experiment, or to produce a known amount of substance in a titration.")
Declaration(Class(goldbook:09159))
AnnotationAssertion(rdfs:label goldbook:09159 "coulometry")
AnnotationAssertion(dcterms:description goldbook:09159 "Electrochemical measurement principle in which the electric charge required to carry out a known electrochemical reaction is measured. By Faraday’s laws of electrolysis, the amount of substance is proportional to the charge.")
Declaration(Class(goldbook:09160))
AnnotationAssertion(rdfs:label goldbook:09160 "direct coulometry at controlled current")
AnnotationAssertion(dcterms:description goldbook:09160 "Coulometry at an imposed, constant electric current in the electrochemical cell.")
Declaration(Class(goldbook:09161))
AnnotationAssertion(rdfs:label goldbook:09161 "direct coulometry at controlled potential")
AnnotationAssertion(dcterms:description goldbook:09161 "Coulometry at a preselected constant potential of the working electrode.Electric current against time showing the representation of the electric charge in direct coulometry at controlled potential as the area under the graph.")
Declaration(Class(goldbook:09162))
AnnotationAssertion(rdfs:label goldbook:09162 "electrochemical piezoelectric microgravimetry")
AnnotationAssertion(dcterms:description goldbook:09162 "Electrogravimetry using an electrochemical quartz crystal microbalance.")
Declaration(Class(goldbook:09163))
AnnotationAssertion(rdfs:label goldbook:09163 "electrochemical quartz crystal microbalance")
AnnotationAssertion(dcterms:description goldbook:09163 "Electrochemical cell in which the working electrode is located on one surface of a piezoelectric quartz crystal, the oscillation frequency of which is measured.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09163 "electrochemical quartz crystal nanobalance (EQCN)")
Declaration(Class(goldbook:09164))
AnnotationAssertion(rdfs:label goldbook:09164 "electrogravimetry")
AnnotationAssertion(dcterms:description goldbook:09164 "Gravimetry in which the material to be weighed is obtained by electrochemical reaction.")
Declaration(Class(goldbook:09165))
AnnotationAssertion(rdfs:label goldbook:09165 "conductometric titration")
AnnotationAssertion(dcterms:description goldbook:09165 "Titration in which the electric conductivity of a solution is measured as a function of the amount of titrant added.Conductimetric titration curve of conductance ($G$) against volume of titrant. The end-point of the titration is indicated by a change in slope of the graph.")
Declaration(Class(goldbook:09166))
AnnotationAssertion(rdfs:label goldbook:09166 "conductometry")
AnnotationAssertion(dcterms:description goldbook:09166 "Measurement principle in which the electric conductivity of a solution is measured.")
Declaration(Class(goldbook:09167))
AnnotationAssertion(rdfs:label goldbook:09167 "dielectrometry")
AnnotationAssertion(dcterms:description goldbook:09167 "Electrochemical measurement principle based on the measurement of the dielectric constant of a sample resulting from the orientation of particles (molecules or ions) that have a dipole moment in an electric field.")
Declaration(Class(goldbook:09168))
AnnotationAssertion(rdfs:label goldbook:09168 "electrochemical impedance spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09168 "Electrochemical measurement method of the complex impedance of an electrochemical system as a function of the frequency of a small amplitude (normally \\(\\pu{5 to 10 mV}\\)) sinusoidal voltage perturbation superimposed on a fixed value of applied potential or on the open circuit potential.")
Declaration(Class(goldbook:09169))
AnnotationAssertion(rdfs:label goldbook:09169 "impedimetry")
AnnotationAssertion(dcterms:description goldbook:09169 "Measurement principle in which the complex electric impedance of a system is measured, usually as a function of a small amplitude sinusoidal electrode potential.")
Declaration(Class(goldbook:09170))
AnnotationAssertion(rdfs:label goldbook:09170 "electrochemical detection in flowing systems")
AnnotationAssertion(dcterms:description goldbook:09170 "Electrochemical techniques (potentiometry, amperometry, voltammetry, coulometry, conductimetry) used for analyte detection in flowing systems.")
Declaration(Class(goldbook:09171))
AnnotationAssertion(rdfs:label goldbook:09171 "spectroelectrochemistry")
AnnotationAssertion(dcterms:description goldbook:09171 "Measurement methods combining spectrometric and electrochemical measurements.")
Declaration(Class(goldbook:09172))
AnnotationAssertion(rdfs:label goldbook:09172 "Auger spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09172 "Measurement method of electron emission spectroscopy that utilizes Auger electrons emitted from the target following excitation with an electron beam or X-ray beam.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09172 "Auger electron spectroscopy")
Declaration(Class(goldbook:09173))
AnnotationAssertion(rdfs:label goldbook:09173 "Auger photoelectron coincidence spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09173 "Detection of an Auger electron and a core-level photoelectron, emitted from a solid irradiated by mono-energetic X-rays, within a sufficiently short time that the Auger electron shall arise from the decay of the particular core-hole associated with the photoelectron.")
Declaration(Class(goldbook:09174))
AnnotationAssertion(rdfs:label goldbook:09174 "elastic peak electron spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09174 "Measurement method in which an electron spectrometer is used to measure the energy, intensity, and/or energy broadening distribution of quasi-elastically scattered electrons from a solid or liquid surface.")
Declaration(Class(goldbook:09175))
AnnotationAssertion(rdfs:label goldbook:09175 "direct recoil spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09175 "Measurement method to elucidate composition and structure of the outermost atomic layers of a solid material, in which principally monoenergetic neutral atoms or singly charged probe ions are used to sputter atoms or ions out of the solid surface, their energy being recorded at one or more angle of scattering.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09175 "elastic recoil detection")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09175 "elastic recoil detection analysis")
Declaration(Class(goldbook:09176))
AnnotationAssertion(rdfs:label goldbook:09176 "low-energy ion scattering spectrometry")
AnnotationAssertion(dcterms:description goldbook:09176 "Measurement method to elucidate the composition and structure of the very outermost atomic layers of a solid material, in which principally monoenergetic, singly-charged probe ions scattered from the surface are detected and recorded as a function of their energy, angle of scattering, or both.")
Declaration(Class(goldbook:09177))
AnnotationAssertion(rdfs:label goldbook:09177 "medium-energy ion scattering spectrometry")
AnnotationAssertion(dcterms:description goldbook:09177 "Measurement method to elucidate the composition and structure of the outermost atomic layers of a solid material, in which principally monoenergetic, singly-charged probe ions scattered from the surface are detected and recorded as a function of their energy, angle of scattering, or both.")
Declaration(Class(goldbook:09178))
AnnotationAssertion(rdfs:label goldbook:09178 "Rutherford backscattering spectrometry")
AnnotationAssertion(dcterms:description goldbook:09178 "Measurement method to elucidate composition and structure of layers at the surface of a solid material, in which principally monoenergetic, singly charged probe ions scattered from the surface with a Rutherford cross section are detected and recorded as a function of their energy or angle of scattering, or both.")
Declaration(Class(goldbook:09179))
AnnotationAssertion(rdfs:label goldbook:09179 "desorption atmospheric pressure chemical ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09179 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of a nearby corona discharge in a humid carrier gas.")
Declaration(Class(goldbook:09180))
AnnotationAssertion(rdfs:label goldbook:09180 "desorption atmospheric pressure photoionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09180 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of desorption by a jet of hot solvent vapour and ionization by ultraviolet light.")
Declaration(Class(goldbook:09181))
AnnotationAssertion(rdfs:label goldbook:09181 "desorption electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09181 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the bombardment by ionized solvent droplets generated by pneumatically assisted electrospray ionization.")
Declaration(Class(goldbook:09182))
AnnotationAssertion(rdfs:label goldbook:09182 "direct analysis in real time")
AnnotationAssertion(dcterms:description goldbook:09182 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the interaction with a beam containing metastable, excited atoms heated to about \\(\\pu{500^{\\circ}C}\\).")
Declaration(Class(goldbook:09183))
AnnotationAssertion(rdfs:label goldbook:09183 "dynamic secondary-ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09183 "Secondary-ion mass spectrometry analysis with primary ion current density sufficiently high for use in the analysis of sample surface layers in the depth direction.")
Declaration(Class(goldbook:09184))
AnnotationAssertion(rdfs:label goldbook:09184 "electrospray laser desorption ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09184 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge quotient and the abundance of ionized entities emitted from a sample in air via ablation by a focused pulsed laser while simultaneously directing an electrospray jet through the desorbed plume to enhance sample ionization.")
Declaration(Class(goldbook:09185))
AnnotationAssertion(rdfs:label goldbook:09185 "extractive electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09185 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of an inert gas being passed over the sample to pick up the molecules, which are subsequently ionized by ionized solvent droplets generated by pneumatically assisted electrospray ionization.")
Declaration(Class(goldbook:09186))
AnnotationAssertion(rdfs:label goldbook:09186 "G-SIMS")
AnnotationAssertion(dcterms:description goldbook:09186 "Variant of static secondary-ion mass spectrometry in which the intensities for each mass in two spectra from the same area, recorded with different beam energies or different bombarding ions, are ratioed to each other and the result is used to scale one of the spectra to generate a new spectrum.")
Declaration(Class(goldbook:09187))
AnnotationAssertion(rdfs:label goldbook:09187 "laser ablation electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09187 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of laser ablation and electrospray ionization.")
Declaration(Class(goldbook:09188))
AnnotationAssertion(rdfs:label goldbook:09188 "matrix-assisted laser desorption electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09188 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities from a sample that has been mixed with a matrix whose role is enhancing the ion yield produced by laser ablation and electrospray ionization.")
Declaration(Class(goldbook:09189))
AnnotationAssertion(rdfs:label goldbook:09189 "matrix-assisted laser desorption/ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09189 "Measurement method in which a time-of-flight mass spectrometer is used to measure the ratio of mass to charge and the abundance of ions emitted, as a result of a short pulse of laser illumination, from a sample whose analyte is contained in a matrix that assists the formation of ions.")
Declaration(Class(goldbook:09190))
AnnotationAssertion(rdfs:label goldbook:09190 "plasma assisted desorption ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09190 "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the bombardment by a focused plasma.")
Declaration(Class(goldbook:09191))
AnnotationAssertion(rdfs:label goldbook:09191 "reactive desorption electrospray ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09191 "Mode of desorption electrospray ionization mass spectrometry with reactive chemicals within the spray solution to enhance the analytical specificity.")
Declaration(Class(goldbook:09192))
AnnotationAssertion(rdfs:label goldbook:09192 "secondary-ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09192 "Measurement method in which a focused beam of primary ions produces secondary ions by sputtering from a solid surface. The secondary ions are analysed by mass spectrometry.")
Declaration(Class(goldbook:09193))
AnnotationAssertion(rdfs:label goldbook:09193 "static secondary-ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09193 "Method of secondary-ion mass spectrometry using low current densities for analysis of sample surface components, in contrast with dynamic secondary-ion mass spectrometry, which is used for analysis of components in the depth direction.")
Declaration(Class(goldbook:09194))
AnnotationAssertion(rdfs:label goldbook:09194 "surface-assisted laser desorption/ionization mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09194 "Matrix-assisted laser desorption/ionization mass spectrometry using a combined liquid and particulate matrix.")
Declaration(Class(goldbook:09195))
AnnotationAssertion(rdfs:label goldbook:09195 "attenuated total reflection infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09195 "Attenuated total reflection spectroscopy in which the infrared absorption spectrum of a sample in contact with a prism is measured.")
Declaration(Class(goldbook:09196))
AnnotationAssertion(rdfs:label goldbook:09196 "diffuse reflection-absorption infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09196 "Measurement method in which the infrared absorption spectrum of light reflected and transmitted from powdered samples is measured.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09196 "diffuse reflectance infrared Fourier transform spectroscopy")
Declaration(Class(goldbook:09197))
AnnotationAssertion(rdfs:label goldbook:09197 "ellipsometry")
AnnotationAssertion(dcterms:description goldbook:09197 "Measurement method for the thickness of transparent surface films and layers and for the refractive index of a reflecting material.")
Declaration(Class(goldbook:09198))
AnnotationAssertion(rdfs:label goldbook:09198 "extended X-ray absorption fine structure spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09198 "X-ray absorption fine structure spectroscopy in the energy region from the core-level edge to an energy several hundred $\\pu{eV}$ greater.")
Declaration(Class(goldbook:09199))
AnnotationAssertion(rdfs:label goldbook:09199 "grazing-incidence small-angle X-ray scattering analysis")
AnnotationAssertion(dcterms:description goldbook:09199 "Measurement method in which the elastically scattered intensity of X-rays from a reflecting surface is measured for small-angle deflections at grazing incidence.")
Declaration(Class(goldbook:09200))
AnnotationAssertion(rdfs:label goldbook:09200 "off-specular X-ray reflectometry")
AnnotationAssertion(dcterms:description goldbook:09200 "X-ray reflectometry in which significant scattered intensity arises from imperfections in the specimen, the scattered intensity falling outside the specular condition (see specular X-ray reflectometry).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09200 "diffuse X-ray reflectometry")
Declaration(Class(goldbook:09201))
AnnotationAssertion(rdfs:label goldbook:09201 "reflection-absorption infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09201 "Spectroscopy based on reflection-absorption.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09201 "infrared reflection-absorption spectroscopy")
Declaration(Class(goldbook:09202))
AnnotationAssertion(rdfs:label goldbook:09202 "scanning near-field optical microscopy")
AnnotationAssertion(dcterms:description goldbook:09202 "Measurement method in microscopy in which spectroscopic data may be collected with the detector closer to the sample than the optical wavelength employed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09202 "near-field optical microscopy")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09202 "near-field scanning optical microscopy (NSOM)")
Declaration(Class(goldbook:09203))
AnnotationAssertion(rdfs:label goldbook:09203 "small-angle X-ray scattering")
AnnotationAssertion(dcterms:description goldbook:09203 "Measurement method in which the elastically scattered intensity of X-rays is measured for small-angle deflections.")
Declaration(Class(goldbook:09204))
AnnotationAssertion(rdfs:label goldbook:09204 "specular X-ray reflectrometry")
AnnotationAssertion(dcterms:description goldbook:09204 "Mode of X-ray reflectrometry in which the angle between the detected beam and the sample surface is equal to that of the incident beam and the sample surface.")
Declaration(Class(goldbook:09205))
AnnotationAssertion(rdfs:label goldbook:09205 "sum frequency generation spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09205 "Measurement method from non-linear optics in which a structurally-ordered sample at an interface between two phases is irradiated by single frequency visible and variable frequency infrared pulses of light to generate a sum frequency vibrational spectrum of the interfacial species without any bulk phase contribution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09205 "vibrational sum frequency spectroscopy (VSFS)")
Declaration(Class(goldbook:09206))
AnnotationAssertion(rdfs:label goldbook:09206 "surface extended X-ray absorption fine structure spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09206 "Extended X-ray absorption fine structure spectroscopy in which, instead of measuring X-ray absorption, electron emission arising from that absorption is measured.")
Declaration(Class(goldbook:09207))
AnnotationAssertion(rdfs:label goldbook:09207 "surface-enhanced infrared spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09207 "Measurement method giving enhanced infrared absorption in the measured infrared spectrum of a sample adsorbed on a roughened thin metal substrate. The metal substrate is deposited onto a prism and data is collected by total internal reflection.")
Declaration(Class(goldbook:09209))
AnnotationAssertion(rdfs:label goldbook:09209 "surface-enhanced resonant Raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09209 "Measurement method of surface-enhanced Raman spectroscopy (SERS) by which the Raman spectrum is significantly enhanced under the conditions that, whilst undergoing SERS, the molecules are excited by radiation that is in resonance with electronic transitions in the sample.")
Declaration(Class(goldbook:09210))
AnnotationAssertion(rdfs:label goldbook:09210 "tip enhanced raman spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09210 "Measurement method of Raman spectroscopy combining surface-enhanced Raman spectroscopy and scanning using an atomic force microscope or scanning tunnelling microscope to produce maps of a surface.")
Declaration(Class(goldbook:09211))
AnnotationAssertion(rdfs:label goldbook:09211 "total reflection X-ray fluorescence spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09211 "Measurement method in which an X-ray spectrometer is used to measure the energy distribution of fluorescence X-rays emitted from a surface irradiated by primary X-rays under the condition of total reflection.")
Declaration(Class(goldbook:09212))
AnnotationAssertion(rdfs:label goldbook:09212 "X-ray absorption fine structure spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09212 "Measurement method to measure the absorption of X-rays at energies near and above (typically several hundred \\(\\pu{eV}\\) greater) an absorption edge, over which fine structure (modulation of the X-ray absorption coefficient) can be detected.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09212 "XAFS")
Declaration(Class(goldbook:09213))
AnnotationAssertion(rdfs:label goldbook:09213 "X-ray absorption near-edge spectroscopy")
AnnotationAssertion(dcterms:description goldbook:09213 "X-ray absorption fine structure spectroscopy in the energy region near (within approximately \\(\\pu{100 eV}\\)) an absorption edge.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09213 "near-edge extended X-ray absorption fine structure spectroscopy (NEXAFS)")
Declaration(Class(goldbook:09214))
AnnotationAssertion(rdfs:label goldbook:09214 "X-ray reflectometry")
AnnotationAssertion(dcterms:description goldbook:09214 "Measurement method for surface and interface roughness and density, layer thickness of thin layers, and electron density profile achieved by reflecting X-rays from a flat sample and analysing the reflected intensity as a function of angle.")
Declaration(Class(goldbook:09215))
AnnotationAssertion(rdfs:label goldbook:09215 "X-ray standing waves")
AnnotationAssertion(dcterms:description goldbook:09215 "Measurement method based on the interference of X-rays that occurs near the Bragg condition at the surface of a crystalline solid, which leads to intensity maxima in yields of photoelectrons as the Bragg condition is scanned by tilting the sample.")
Declaration(Class(goldbook:09216))
AnnotationAssertion(rdfs:label goldbook:09216 "absolute elemental sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09216 "Coefficient for an element by which the measured intensity for that element is divided to yield the atomic concentration or atomic fraction of the element present in the sample.")
Declaration(Class(goldbook:09217))
AnnotationAssertion(rdfs:label goldbook:09217 "altered layer")
AnnotationAssertion(dcterms:description goldbook:09217 "Surface region of a material under particle bombardment where the chemical state or physical structure is modified by the effects of the bombardment.")
Declaration(Class(goldbook:09218))
AnnotationAssertion(rdfs:label goldbook:09218 "analysis area")
AnnotationAssertion(dcterms:description goldbook:09218 "Two-dimensional region of a sample surface measured in the plane of that surface, from which the entire analytical signal or a specified fraction of that signal is detected.")
Declaration(Class(goldbook:09219))
AnnotationAssertion(rdfs:label goldbook:09219 "analysis area")
AnnotationAssertion(dcterms:description goldbook:09219 "Two-dimensional region of a sample surface at the analytical point, but set in the plane at right angles to the spectrometer axis, from which the entire analytical signal or a specified fraction of that signal is detected.")
Declaration(Class(goldbook:09220))
AnnotationAssertion(rdfs:label goldbook:09220 "angle lapping")
AnnotationAssertion(dcterms:description goldbook:09220 "Sample preparation in which a sample is mechanically polished at an angle to the original surface.")
Declaration(Class(goldbook:09221))
AnnotationAssertion(rdfs:label goldbook:09221 "angle of emission")
AnnotationAssertion(dcterms:description goldbook:09221 "Angle between the trajectory of a particle or photon, as it leaves a surface, and the local or average surface normal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09221 "emission angle")
Declaration(Class(goldbook:09222))
AnnotationAssertion(rdfs:label goldbook:09222 "areic dose rate")
AnnotationAssertion(dcterms:description goldbook:09222 "Areic dose introduced into a solid in time interval \\(t\\) divided by \\(t\\).")
Declaration(Class(goldbook:09223))
AnnotationAssertion(rdfs:label goldbook:09223 "areic dose")
AnnotationAssertion(dcterms:description goldbook:09223 "Number, \\(N\\), of energetic particles of a specified type introduced into a solid through a surface area \\(A\\) divided by \\(A\\). \\(D = N/A\\).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09223 "dose")
Declaration(Class(goldbook:09224))
AnnotationAssertion(rdfs:label goldbook:09224 "areic surface energy")
AnnotationAssertion(dcterms:description goldbook:09224 "Energy required to increase a surface area at thermodynamic equilibrium divided by that increase in area.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09224 "surface energy")
Declaration(Class(goldbook:09225))
AnnotationAssertion(rdfs:label goldbook:09225 "atomic mixing")
AnnotationAssertion(dcterms:description goldbook:09225 "Migration of sample atoms due to energy transfer with incident particles in the surface region.")
Declaration(Class(goldbook:09226))
AnnotationAssertion(rdfs:label goldbook:09226 "Auger neutralization")
AnnotationAssertion(dcterms:description goldbook:09226 "Process in which an electron, tunnelling from the conduction band of a solid, neutralizes an incoming ion and an electron is ejected from a surface atom.")
Declaration(Class(goldbook:09227))
AnnotationAssertion(rdfs:label goldbook:09227 "average beam current")
AnnotationAssertion(dcterms:description goldbook:09227 "Electric charge of specified polarity in a beam passing in time interval \\(t\\), divided by \\(t\\).")
Declaration(Class(goldbook:09228))
AnnotationAssertion(rdfs:label goldbook:09228 "backscattering energy")
AnnotationAssertion(dcterms:description goldbook:09228 "Energy of a particle from the primary beam after it has undergone a backscattering collision and escaped from the sample.")
Declaration(Class(goldbook:09229))
AnnotationAssertion(rdfs:label goldbook:09229 "ball cratering")
AnnotationAssertion(dcterms:description goldbook:09229 "Procedure in which the sample is abraded by a sphere in order to expose compositional changes in layers below the original surface, with the intent that the depth of those layers can be related to the lateral position in the crater created by the abrasion.")
Declaration(Class(goldbook:09230))
AnnotationAssertion(rdfs:label goldbook:09230 "binary elastic scattering")
AnnotationAssertion(dcterms:description goldbook:09230 "Collision between a moving particle and a second particle in which total kinetic energy and total momentum are conserved.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09230 "elastic scattering")
Declaration(Class(goldbook:09231))
AnnotationAssertion(rdfs:label goldbook:09231 "Bragg’s rule")
AnnotationAssertion(dcterms:description goldbook:09231 "Empirical rule formulated by W.H. Bragg and R. Kleeman that states that the stopping cross section of a compound sample is equal to the sum of the products of the elemental stopping cross sections for each constituent and its atomic fraction. \\[S_{\\ce{AB}}(\\varepsilon) = xS_{\\ce{A}}(\\varepsilon) + yS_{\\ce{B}}(\\varepsilon)\\] where \\(S_{\\ce{AB}}(\\varepsilon)\\) is the stopping cross section of the compound \\(\\ce{A}_{x}\\ce{B}_{y}\\), and \\(S_{\\ce{A}}(\\varepsilon)\\) and \\(S_{\\ce{B}}(\\varepsilon)\\) are the stopping cross sections of elements \\(\\ce{A}\\) and \\(\\ce{B}\\), respectively.")
Declaration(Class(goldbook:09232))
AnnotationAssertion(rdfs:label goldbook:09232 "cascade mixing")
AnnotationAssertion(dcterms:description goldbook:09232 "Diffusion-like process in which atoms of material are moved randomly by energy deposited by incident particles slowing down in the sample surface region.")
Declaration(Class(goldbook:09233))
AnnotationAssertion(rdfs:label goldbook:09233 "channeling")
AnnotationAssertion(dcterms:description goldbook:09233 "Preferential motion of energetic particles along the crystal axes of a crystalline solid as the particles move through the sample.")
Declaration(Class(goldbook:09234))
AnnotationAssertion(rdfs:label goldbook:09234 "charge neutralization")
AnnotationAssertion(dcterms:description goldbook:09234 "Maintenance at a fixed potential, usually near neutrality, of the surface of a non-conducting or poorly conducting sample material under bombardment by primary particles or photons.")
Declaration(Class(goldbook:09235))
AnnotationAssertion(rdfs:label goldbook:09235 "charging potential")
AnnotationAssertion(dcterms:description goldbook:09235 "Electric potential of the surface region of an insulating sample, caused by irradiation.")
Declaration(Class(goldbook:09236))
AnnotationAssertion(rdfs:label goldbook:09236 "chemical map")
AnnotationAssertion(dcterms:description goldbook:09236 "Surface map using signals proportional to the amount of an element in a particular chemical state in the sample.")
Declaration(Class(goldbook:09237))
AnnotationAssertion(rdfs:label goldbook:09237 "chromatic aberration")
AnnotationAssertion(dcterms:description goldbook:09237 "Non-ideal focus of an electron or ion optical system for electrons or ions of different energies.")
Declaration(Class(goldbook:09238))
AnnotationAssertion(rdfs:label goldbook:09238 "collision cascade")
AnnotationAssertion(dcterms:description goldbook:09238 "Sequential energy transfer between atoms in a solid as a result of bombardment by an energetic species.")
Declaration(Class(goldbook:09239))
AnnotationAssertion(rdfs:label goldbook:09239 "compositional depth profile")
AnnotationAssertion(dcterms:description goldbook:09239 "Chemical composition measured as a function of distance normal to the surface.")
Declaration(Class(goldbook:09240))
AnnotationAssertion(rdfs:label goldbook:09240 "crater depth")
AnnotationAssertion(dcterms:description goldbook:09240 "Average depth of the region of a crater from which the measured signal is derived.")
Declaration(Class(goldbook:09241))
AnnotationAssertion(rdfs:label goldbook:09241 "cross-sectioning")
AnnotationAssertion(dcterms:description goldbook:09241 "Sample preparation in which the sample is cleaved, cut, or polished in a plane perpendicular to the interface under study, so that associated compositional differences or gradients can be observed in that plane.")
Declaration(Class(goldbook:09242))
AnnotationAssertion(rdfs:label goldbook:09242 "damage limit")
AnnotationAssertion(dcterms:description goldbook:09242 "Particle fluence above which significant changes in the spectrum or in a stated peak, arising from damage processes, are observed.")
Declaration(Class(goldbook:09243))
AnnotationAssertion(rdfs:label goldbook:09243 "delta layer")
AnnotationAssertion(dcterms:description goldbook:09243 "Layer of discrete composition, one atom thick, formed during the growth of material on a substrate.")
Declaration(Class(goldbook:09244))
AnnotationAssertion(rdfs:label goldbook:09244 "depth profiling")
AnnotationAssertion(dcterms:description goldbook:09244 "Monitoring of signal intensity as a function of a variable that can be related to distance normal to the surface.")
Declaration(Class(goldbook:09245))
AnnotationAssertion(rdfs:label goldbook:09245 "depth resolution parameter")
AnnotationAssertion(dcterms:description goldbook:09245 "Parameter that can be used as a coefficient in an analytic fit to a measured compositional depth profile or as a qualitative way of describing that profile.")
Declaration(Class(goldbook:09246))
AnnotationAssertion(rdfs:label goldbook:09246 "elastic scattering cross section")
AnnotationAssertion(dcterms:description goldbook:09246 "Cross section for binary elastic scattering.")
Declaration(Class(goldbook:09247))
AnnotationAssertion(rdfs:label goldbook:09247 "electron flooding")
AnnotationAssertion(dcterms:description goldbook:09247 "Irradiation of a sample with low-energy electrons in order to change or stabilize the charging potential.")
Declaration(Class(goldbook:09248))
AnnotationAssertion(rdfs:label goldbook:09248 "elemental map")
AnnotationAssertion(dcterms:description goldbook:09248 "Surface map using signals proportional to the amount of an element present in a sample.")
Declaration(Class(goldbook:09249))
AnnotationAssertion(rdfs:label goldbook:09249 "erosion rate")
AnnotationAssertion(dcterms:description goldbook:09249 "Change in the position of the surface as a result of particle or photon irradiation divided by time of irradiation.")
Declaration(Class(goldbook:09250))
AnnotationAssertion(rdfs:label goldbook:09250 "field-induced migration")
AnnotationAssertion(dcterms:description goldbook:09250 "Effect occurring in insulators or semi-conductors where internal electric fields cause the migration of sample atoms.")
Declaration(Class(goldbook:09251))
AnnotationAssertion(rdfs:label goldbook:09251 "flux of a beam of particles")
AnnotationAssertion(dcterms:description goldbook:09251 "\\(\\mathit{\\Phi} = {\\rm{d}}N/{\\rm{d}}t\\), where \\(N\\) is number of particles of a specified type and \\(t\\) is time.")
Declaration(Class(goldbook:09252))
AnnotationAssertion(rdfs:label goldbook:09252 "focused ion beam system")
AnnotationAssertion(dcterms:description goldbook:09252 "Ion beam system used for machining small regions with sub-micron precision.")
Declaration(Class(goldbook:09253))
AnnotationAssertion(rdfs:label goldbook:09253 "fractional sputtering yield")
AnnotationAssertion(dcterms:description goldbook:09253 "Number of atoms and ions of a particular species sputtered from a sample divided by the total number of atoms and ions sputtered from the sample.")
Declaration(Class(goldbook:09254))
AnnotationAssertion(rdfs:label goldbook:09254 "image depth profile")
AnnotationAssertion(dcterms:description goldbook:09254 "Three-dimensional representation of the spatial distribution of a particular elemental or molecular species, as indicated by emitted secondary ions or electrons, as a function of depth or material removed by sputtering.")
Declaration(Class(goldbook:09255))
AnnotationAssertion(rdfs:label goldbook:09255 "impact energy")
AnnotationAssertion(dcterms:description goldbook:09255 "Kinetic energy of particles on impact with a sample surface.")
Declaration(Class(goldbook:09256))
AnnotationAssertion(rdfs:label goldbook:09256 "implanted areic dose")
AnnotationAssertion(dcterms:description goldbook:09256 "Number, \\(N_{\\rm{imp}}\\), of energetic particles of a specified type incident on a solid within a surface area \\(A\\) and stopped within the solid divided by \\(A\\). \\(D_{\\rm{imp}} = N_{\\rm{imp}}/A\\).")
Declaration(Class(goldbook:09257))
AnnotationAssertion(rdfs:label goldbook:09257 "information depth")
AnnotationAssertion(dcterms:description goldbook:09257 "Maximum depth, normal to the surface, from which useful information is obtained.")
Declaration(Class(goldbook:09258))
AnnotationAssertion(rdfs:label goldbook:09258 "information radius")
AnnotationAssertion(dcterms:description goldbook:09258 "Maximum radius of a circular region, in the plane of the surface, from which useful information is obtained.")
Declaration(Class(goldbook:09259))
AnnotationAssertion(rdfs:label goldbook:09259 "instrumental depth resolution")
AnnotationAssertion(dcterms:description goldbook:09259 "Depth resolution in a sample arising from parameters of the instrument.")
Declaration(Class(goldbook:09260))
AnnotationAssertion(rdfs:label goldbook:09260 "ion beam")
AnnotationAssertion(dcterms:description goldbook:09260 "Directed flux of charged atoms or molecules.")
Declaration(Class(goldbook:09261))
AnnotationAssertion(rdfs:label goldbook:09261 "ion implantation")
AnnotationAssertion(dcterms:description goldbook:09261 "Injection of ions into a sample.")
Declaration(Class(goldbook:09262))
AnnotationAssertion(rdfs:label goldbook:09262 "line scan")
AnnotationAssertion(dcterms:description goldbook:09262 "Plot of output signal intensity from a spectrometer, signal intensity from another detector, or processed intensity information from the available software along a line corresponding to a line on the sample surface.")
Declaration(Class(goldbook:09263))
AnnotationAssertion(rdfs:label goldbook:09263 "matrix factor")
AnnotationAssertion(dcterms:description goldbook:09263 "Factors, arising from the composition of the matrix, for multiplying the quotient of the measured intensity and the appropriate sensitivity factor in formulae to determine the composition using surface analytical techniques.")
Declaration(Class(goldbook:09264))
AnnotationAssertion(rdfs:label goldbook:09264 "mean escape depth")
AnnotationAssertion(dcterms:description goldbook:09264 "Average depth normal to the surface from which specified particles or radiations escape.")
Declaration(Class(goldbook:09265))
AnnotationAssertion(rdfs:label goldbook:09265 "partial sputtering yield")
AnnotationAssertion(dcterms:description goldbook:09265 "Number of atoms and ions of a particular species sputtered from a sample divided by the total number of incident particles.")
Declaration(Class(goldbook:09266))
AnnotationAssertion(rdfs:label goldbook:09266 "peak energy")
AnnotationAssertion(dcterms:description goldbook:09266 "Energy value corresponding to the intensity maximum in a direct spectrum or to the intensity minimum (i.e. the negative excursion) for a differential spectrum.")
Declaration(Class(goldbook:09267))
AnnotationAssertion(rdfs:label goldbook:09267 "photoionization cross section")
AnnotationAssertion(dcterms:description goldbook:09267 "Total ionization cross section for an incident photon of a given energy interacting with a material to produce one or more photoelectrons from all sub-shells that are energetically accessible.")
Declaration(Class(goldbook:09268))
AnnotationAssertion(rdfs:label goldbook:09268 "plasmon")
AnnotationAssertion(dcterms:description goldbook:09268 "Excitation of valence-band electrons in a solid in which collective oscillations are generated.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09268 "bulk plasmon")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09268 "volume plasmon")
Declaration(Class(goldbook:09269))
AnnotationAssertion(rdfs:label goldbook:09269 "preferential sputtering")
AnnotationAssertion(dcterms:description goldbook:09269 "Change in equilibrium surface composition of the sample, which can occur when sputtering multicomponent samples.")
Declaration(Class(goldbook:09270))
AnnotationAssertion(rdfs:label goldbook:09270 "primary beam")
AnnotationAssertion(dcterms:description goldbook:09270 "Directed flux of beam particles or photons incident on a sample.")
Declaration(Class(goldbook:09271))
AnnotationAssertion(rdfs:label goldbook:09271 "projected range")
AnnotationAssertion(dcterms:description goldbook:09271 "Distance from the surface at which an energetic ion or atom comes to rest in the sample, projected along the direction of the beam.")
Declaration(Class(goldbook:09272))
AnnotationAssertion(rdfs:label goldbook:09272 "radial sectioning")
AnnotationAssertion(dcterms:description goldbook:09272 "Sample preparation in which a sample is polished by a cylinder in order to expose compositional changes below the original sample surface, with the intent that the depth of these layers can be related to the position on the surface created by the cylinder.")
Declaration(Class(goldbook:09273))
AnnotationAssertion(rdfs:label goldbook:09273 "range straggling")
AnnotationAssertion(dcterms:description goldbook:09273 "Standard deviation of the projected ranges of energetic ions or atoms of a given energy.")
Declaration(Class(goldbook:09274))
AnnotationAssertion(rdfs:label goldbook:09274 "raster")
AnnotationAssertion(dcterms:description goldbook:09274 "Two-dimensional pattern generated by the deflection of a primary beam.")
Declaration(Class(goldbook:09275))
AnnotationAssertion(rdfs:label goldbook:09275 "redeposition")
AnnotationAssertion(dcterms:description goldbook:09275 "Deposition of sputtered sample material back onto the sample surface.")
Declaration(Class(goldbook:09276))
AnnotationAssertion(rdfs:label goldbook:09276 "relative instrument spectral response function")
AnnotationAssertion(dcterms:description goldbook:09276 "In Auger electron spectroscopy (AES), secondary-ion mass spectrometry, and X-ray photoelectron spectroscopy, the spectrometer response function divided by the response function of a reference instrument, or the average for several such instruments, as a function of energy (AES, XPS, etc.) or mass (SIMS).")
Declaration(Class(goldbook:09277))
AnnotationAssertion(rdfs:label goldbook:09277 "relative resolution")
AnnotationAssertion(dcterms:description goldbook:09277 "Resolution of a spectrometer at a given energy, mass, or wavelength divided by that energy, mass, or wavelength.")
Declaration(Class(goldbook:09278))
AnnotationAssertion(rdfs:label goldbook:09278 "relative sputtering rate")
AnnotationAssertion(dcterms:description goldbook:09278 "Sputtering rate of a sample divided by the sputtering rate of a reference sample sputtered under the same conditions.")
Declaration(Class(goldbook:09279))
AnnotationAssertion(rdfs:label goldbook:09279 "sample bias")
AnnotationAssertion(dcterms:description goldbook:09279 "Electric potential applied to the whole or part of the sample, referenced to the electric potential of the sample holder.")
Declaration(Class(goldbook:09280))
AnnotationAssertion(rdfs:label goldbook:09280 "sample charging")
AnnotationAssertion(dcterms:description goldbook:09280 "Change in the electrical potential in the sample or on the sample surface caused by particle or photon bombardment.")
Declaration(Class(goldbook:09281))
AnnotationAssertion(rdfs:label goldbook:09281 "sample voltage")
AnnotationAssertion(dcterms:description goldbook:09281 "Electric potential difference of the sample referenced to ground.")
Declaration(Class(goldbook:09282))
AnnotationAssertion(rdfs:label goldbook:09282 "solid angle of analyser")
AnnotationAssertion(dcterms:description goldbook:09282 "Solid angle allowing particles or photons to be transmitted from a point on the sample to the detector.")
Declaration(Class(goldbook:09283))
AnnotationAssertion(rdfs:label goldbook:09283 "spectrometer response function")
AnnotationAssertion(dcterms:description goldbook:09283 "Number of particles detected with a spectrometer divided by the number of such particles per solid angle and per interval of the dispersing parameter available for measurement as a function of the dispersing parameter.")
Declaration(Class(goldbook:09284))
AnnotationAssertion(rdfs:label goldbook:09284 "spectrometer transmission function")
AnnotationAssertion(dcterms:description goldbook:09284 "Number of particles transmitted by the analyser divided by the number of such particles per solid angle and per interval of the dispersing parameter (e.g. energy, mass, or wavelength) available for measurement as a function of the dispersing parameter.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09284 "analyser transmission function")
Declaration(Class(goldbook:09285))
AnnotationAssertion(rdfs:label goldbook:09285 "sputter depth profile")
AnnotationAssertion(dcterms:description goldbook:09285 "Compositional depth profile obtained when the surface composition is measured while material is removed by sputtering.")
Declaration(Class(goldbook:09286))
AnnotationAssertion(rdfs:label goldbook:09286 "sputtering rate")
AnnotationAssertion(dcterms:description goldbook:09286 "Amount, mass, or number of entities of sample material removed, as a result of particle bombardment, per unit time.")
Declaration(Class(goldbook:09287))
AnnotationAssertion(rdfs:label goldbook:09287 "sputtering yield")
AnnotationAssertion(dcterms:description goldbook:09287 "Number of atoms and ions sputtered from a sample divided by the total number of incident primary particles.")
Declaration(Class(goldbook:09288))
AnnotationAssertion(rdfs:label goldbook:09288 "standard vacuum level")
AnnotationAssertion(dcterms:description goldbook:09288 "Electric potential \\(\\pu{4.500 eV}\\) above the Fermi level.")
Declaration(Class(goldbook:09289))
AnnotationAssertion(rdfs:label goldbook:09289 "steady-state sputtering")
AnnotationAssertion(dcterms:description goldbook:09289 "State of the sputtering process in which important operational and analytical parameters are unchanging over a meaningful timescale.")
Declaration(Class(goldbook:09290))
AnnotationAssertion(rdfs:label goldbook:09290 "steady-state surface composition sputtering")
AnnotationAssertion(dcterms:description goldbook:09290 "Steady-state surface composition produced by sputtering a homogeneous sample under non-varying conditions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09290 "equilibrium surface composition sputtering")
Declaration(Class(goldbook:09291))
AnnotationAssertion(rdfs:label goldbook:09291 "stoichiometric sputtering")
AnnotationAssertion(dcterms:description goldbook:09291 "State of the sputtering process in which the relative amounts of the elemental components sputtered from a sample are equal to their stoichiometry within the sample.")
Declaration(Class(goldbook:09292))
AnnotationAssertion(rdfs:label goldbook:09292 "surface excess amount")
AnnotationAssertion(dcterms:description goldbook:09292 "For an interface, the difference between the amount of component actually present in the system and that which would be present (in a reference system) if the bulk concentration in the adjoining phases were maintained up to a chosen geometrical dividing surface (Gibbs dividing surface).")
Declaration(Class(goldbook:09293))
AnnotationAssertion(rdfs:label goldbook:09293 "surface map")
AnnotationAssertion(dcterms:description goldbook:09293 "Two- or three-dimensional representation of the sample surface where the information at each point in the representation, given by a brightness or colour or as a length in a third dimension, is related to the output signal from a detector or processed intensity information from the available software.")
Declaration(Class(goldbook:09294))
AnnotationAssertion(rdfs:label goldbook:09294 "surface plasmon")
AnnotationAssertion(dcterms:description goldbook:09294 "Collective motion of electrons on an interface of two phases which have different permittivity, of which one must have electrical conductivity to sustain the collective motion.")
Declaration(Class(goldbook:09295))
AnnotationAssertion(rdfs:label goldbook:09295 "surface segregation")
AnnotationAssertion(dcterms:description goldbook:09295 "Partitioning of a species from the bulk of a material to the surface as a result of kinetic or thermodynamic effects.")
Declaration(Class(goldbook:09296))
AnnotationAssertion(rdfs:label goldbook:09296 "take-off angle")
AnnotationAssertion(dcterms:description goldbook:09296 "Angle between the trajectory of a particle as it leaves a surface and the local or average surface plane.")
Declaration(Class(goldbook:09297))
AnnotationAssertion(rdfs:label goldbook:09297 "thermionic work function")
AnnotationAssertion(dcterms:description goldbook:09297 "Parameter describing the apparent work function of a solid that controls the electronic current density, \\(J\\), emitted from a conductor at temperature \\(T\\). \\(W = -kT\\ln(J/AT^{2})\\), where \\(k\\) is the Boltzmann constant and \\(A\\) is the Richardson constant.")
Declaration(Class(goldbook:09298))
AnnotationAssertion(rdfs:label goldbook:09298 "topographic contrast")
AnnotationAssertion(dcterms:description goldbook:09298 "Contrast in a surface map or image arising from the topography of the sample surface.")
Declaration(Class(goldbook:09299))
AnnotationAssertion(rdfs:label goldbook:09299 "total ion yield")
AnnotationAssertion(dcterms:description goldbook:09299 "Number of ions of both signs sputtered from a sample divided by the number of incident particles.")
Declaration(Class(goldbook:09300))
AnnotationAssertion(rdfs:label goldbook:09300 "vacuum level")
AnnotationAssertion(dcterms:description goldbook:09300 "Energy level of an electron positioned at rest just outside a solid, i.e. with zero kinetic energy with respect to the sample surface.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09300 "local vacuum level")
Declaration(Class(goldbook:09301))
AnnotationAssertion(rdfs:label goldbook:09301 "vacuum level at infinity")
AnnotationAssertion(dcterms:description goldbook:09301 "Electric potential of the vacuum at a point in space.")
Declaration(Class(goldbook:09302))
AnnotationAssertion(rdfs:label goldbook:09302 "volume yield")
AnnotationAssertion(dcterms:description goldbook:09302 "Volume sputtered from a sample divided by number of incident particles.")
Declaration(Class(goldbook:09303))
AnnotationAssertion(rdfs:label goldbook:09303 "X-ray linewidth")
AnnotationAssertion(dcterms:description goldbook:09303 "Energy width of the principal characteristic X-ray line.")
Declaration(Class(goldbook:09304))
AnnotationAssertion(rdfs:label goldbook:09304 "X-ray monochromator")
AnnotationAssertion(dcterms:description goldbook:09304 "Device used to eliminate photons of energies other than those in a narrow energy or wavelength band.")
Declaration(Class(goldbook:09305))
AnnotationAssertion(rdfs:label goldbook:09305 "adventitious carbon referencing")
AnnotationAssertion(dcterms:description goldbook:09305 "In X-ray photoelectron spectroscopy, measurement of the charging potential of a particular sample from a comparison of the experimentally measured \\(\\ce{C 1s}\\) binding energy, arising from adsorbed hydrocarbons on the sample, with a standard binding energy value.")
Declaration(Class(goldbook:09306))
AnnotationAssertion(rdfs:label goldbook:09306 "asymmetry parameter")
AnnotationAssertion(dcterms:description goldbook:09306 "In X-ray photoelectron spectroscopy factor which characterizes the intensity distribution, \\(L(\\gamma)\\), of photoelectrons ejected by X-rays from isolated atoms at an angle \\(\\gamma\\) from the incident X-ray direction. In the dipole approximation, \\(L(\\gamma) = 1 + ½\\beta [3(\\sin^{2}\\gamma)/2-1]\\).")
Declaration(Class(goldbook:09307))
AnnotationAssertion(rdfs:label goldbook:09307 "Auger electron spectrum")
AnnotationAssertion(dcterms:description goldbook:09307 "Plot of intensity of Auger electrons as a function of the electron kinetic energy, usually as part of the energy distribution of detected electrons.")
Declaration(Class(goldbook:09308))
AnnotationAssertion(rdfs:label goldbook:09308 "Auger parameter")
AnnotationAssertion(dcterms:description goldbook:09308 "Kinetic energy of a narrow Auger electron peak in a spectrum minus the kinetic energy of the most intense X-ray photoelectron peak from the same element.")
Declaration(Class(goldbook:09309))
AnnotationAssertion(rdfs:label goldbook:09309 "Auger vacancy satellite")
AnnotationAssertion(dcterms:description goldbook:09309 "Emission of an Auger electron in which additional spectator holes are present in the initial state or the final state) for the transition.")
Declaration(Class(goldbook:09310))
AnnotationAssertion(rdfs:label goldbook:09310 "average matrix relative sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09310 "Coefficient, proportional to the intensity, calculated for an element in an average matrix, by which the measured intensity for that element is divided in calculations to yield the atomic concentration or atomic fraction of the element present in the sample.")
Declaration(Class(goldbook:09311))
AnnotationAssertion(rdfs:label goldbook:09311 "backscattered electron")
AnnotationAssertion(dcterms:description goldbook:09311 "Electron, originating in the incident beam, which is emitted after interaction with the sample.")
Declaration(Class(goldbook:09312))
AnnotationAssertion(rdfs:label goldbook:09312 "backscattering correction factor")
AnnotationAssertion(dcterms:description goldbook:09312 "In Auger electron spectroscopy, factor equal to the total Auger-electron current arising from ionizations in the sample caused by both primary electrons and backscattered electrons divided by the Auger-electron current arising directly from the primary electrons.")
Declaration(Class(goldbook:09313))
AnnotationAssertion(rdfs:label goldbook:09313 "backscattering fraction")
AnnotationAssertion(dcterms:description goldbook:09313 "In Auger electron spectroscopy, Auger-electron current arising from ionizations in the sample caused by backscattered electrons divided by Auger-electron current arising directly from the primary electrons.")
Declaration(Class(goldbook:09314))
AnnotationAssertion(rdfs:label goldbook:09314 "backscattering yield")
AnnotationAssertion(dcterms:description goldbook:09314 "Number of electrons emitted from the sample with energies greater than \\(\\pu{50 eV}\\) divided by the number of electrons incident at a given energy and angle of incidence.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09314 "backscattering coefficient")
Declaration(Class(goldbook:09315))
AnnotationAssertion(rdfs:label goldbook:09315 "characteristic electron energy losses")
AnnotationAssertion(dcterms:description goldbook:09315 "Inelastic scattering of electrons in solids that produces a non-uniform energy loss spectrum determined by the characteristics of the material.")
Declaration(Class(goldbook:09316))
AnnotationAssertion(rdfs:label goldbook:09316 "charge referencing")
AnnotationAssertion(dcterms:description goldbook:09316 "Measurement of charging potential of a sample in order to correct the measured energies so that those energies correspond to a sample with no surface charge.")
Declaration(Class(goldbook:09317))
AnnotationAssertion(rdfs:label goldbook:09317 "chemical state")
AnnotationAssertion(dcterms:description goldbook:09317 "State of an atom arising from its chemical interaction with neighbouring atoms in a molecule, compound, solid, liquid, or gas that leads to a characteristic energy or feature observable in electron spectroscopy.")
Declaration(Class(goldbook:09318))
AnnotationAssertion(rdfs:label goldbook:09318 "chemical state plot")
AnnotationAssertion(dcterms:description goldbook:09318 "In X-ray photoelectron spectroscopy, plot of the measured kinetic energy of a sharp Auger electron peak versus the binding energy of a photoelectron peak for the same element.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09318 "Wagner plot")
Declaration(Class(goldbook:09319))
AnnotationAssertion(rdfs:label goldbook:09319 "differential spectrum")
AnnotationAssertion(dcterms:description goldbook:09319 "Differential of a direct spectrum with respect to energy by an analogue electrode modulation method or by the numerical differentiation of that spectrum.")
Declaration(Class(goldbook:09320))
AnnotationAssertion(rdfs:label goldbook:09320 "direct spectrum")
AnnotationAssertion(dcterms:description goldbook:09320 "Spectrum of intensity of electrons transmitted and detected by a spectrometer with a dispersing energy analyser as a function of energy, \\(E\\).")
Declaration(Class(goldbook:09321))
AnnotationAssertion(rdfs:label goldbook:09321 "dynamic emittance matching")
AnnotationAssertion(dcterms:description goldbook:09321 "Electron or ion optical method of steering a spectrometer axis to align with the impact area of the primary beam at all points of a raster scan on the sample surface.")
Declaration(Class(goldbook:09322))
AnnotationAssertion(rdfs:label goldbook:09322 "effective attenuation length")
AnnotationAssertion(dcterms:description goldbook:09322 "Parameter that, when introduced in place of the electron inelastic mean free path into an expression derived for Auger electron spectroscopy and X-ray photoelectron spectroscopy on the assumption that elastic scattering effects are negligible for a given quantitative application, will correct that expression for elastic scattering effects.")
Declaration(Class(goldbook:09323))
AnnotationAssertion(rdfs:label goldbook:09323 "Einstein photoelectric equation")
AnnotationAssertion(dcterms:description goldbook:09323 """Equation relating the kinetic energy of an electron, emitted from a conductor illuminated by monochromatic photons, and the photon energy and work function of the surface from which the photoelectron is emitted. \\(½m_{\\rm{e}} 
u_{\\rm{max}}^{2} = h
u - \\phi_{0}\\), where \\(m_{\\rm{e}}\\) is the mass of an electron, \\(
u_{\\rm{max}}\\) the maximum velocity of the emitted electron, \\(h\\) the Planck constant, \\(
u\\) the frequency of the illuminating photons, and \\(\\phi_{0}\\) the photoelectric work function of the surface.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09323 "Einstein equation")
Declaration(Class(goldbook:09324))
AnnotationAssertion(rdfs:label goldbook:09324 "elastic peak")
AnnotationAssertion(dcterms:description goldbook:09324 "Peak in the electron spectrum, produced by quasi-elastically scattered electrons detected by an electron spectrometer.")
Declaration(Class(goldbook:09325))
AnnotationAssertion(rdfs:label goldbook:09325 "electron energy analyser")
AnnotationAssertion(dcterms:description goldbook:09325 "Measuring instrument for measuring the number of electrons, or an intensity proportional to that number, as a function of the electron kinetic energy.")
Declaration(Class(goldbook:09326))
AnnotationAssertion(rdfs:label goldbook:09326 "electron energy loss spectrum")
AnnotationAssertion(dcterms:description goldbook:09326 "Energy spectrum of electrons from a nominally monoenergetic source emitted after inelastic interactions with the sample, often exhibiting peaks due to specific inelastic loss processes (see characteristic electron energy losses and plasmon).")
Declaration(Class(goldbook:09327))
AnnotationAssertion(rdfs:label goldbook:09327 "electron inelastic mean free path")
AnnotationAssertion(dcterms:description goldbook:09327 "Average distance that an electron with a given energy travels between successive inelastic collisions.")
Declaration(Class(goldbook:09328))
AnnotationAssertion(rdfs:label goldbook:09328 "electron retardation")
AnnotationAssertion(dcterms:description goldbook:09328 "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, measurement method for kinetic energy distribution by retarding the emitted electrons before or within the electron energy analyser.")
Declaration(Class(goldbook:09329))
AnnotationAssertion(rdfs:label goldbook:09329 "electron spectrometer")
AnnotationAssertion(dcterms:description goldbook:09329 "Measuring system, the essential part of which is an electron energy analyser.")
Declaration(Class(goldbook:09330))
AnnotationAssertion(rdfs:label goldbook:09330 "elemental relative sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09330 "In dynamic secondary-ion mass spectrometry, coefficient for an element by which the measured intensity of a mass peak for that element, divided by the measured intensity of a mass peak for the matrix, is multiplied to yield the atomic concentration of the element present in the sample.")
Declaration(Class(goldbook:09331))
AnnotationAssertion(rdfs:label goldbook:09331 "extrinsic plasmon")
AnnotationAssertion(dcterms:description goldbook:09331 "Plasmon excited as an electron travels through a condensed medium.")
Declaration(Class(goldbook:09332))
AnnotationAssertion(rdfs:label goldbook:09332 "Fermi level referencing")
AnnotationAssertion(dcterms:description goldbook:09332 "Process for establishing the binding energy scale for a particular sample by assigning the kinetic energy corresponding to the Fermi level, as determined by analysis of the spectrum obtained from X-ray photoelectron spectroscopy or ultraviolet photoelectron spectroscopy, as the point of zero binding energy.")
Declaration(Class(goldbook:09333))
AnnotationAssertion(rdfs:label goldbook:09333 "final energy state")
AnnotationAssertion(dcterms:description goldbook:09333 "Energy state of an atom after a particular Auger, X-ray, or photoemission process.")
Declaration(Class(goldbook:09334))
AnnotationAssertion(rdfs:label goldbook:09334 "inelastic electron scattering background")
AnnotationAssertion(dcterms:description goldbook:09334 "Intensity distribution in a spectrum for particles originally at one energy but which are emitted at lower energies due to one or more inelastic scattering processes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09334 "inelastic background")
Declaration(Class(goldbook:09335))
AnnotationAssertion(rdfs:label goldbook:09335 "inelastic electron scattering background subtraction")
AnnotationAssertion(dcterms:description goldbook:09335 "Subtraction of a chosen inelastic electron scattering background from a measured spectrum in Auger electron spectroscopy and X-ray photoelectron spectroscopy.")
Declaration(Class(goldbook:09336))
AnnotationAssertion(rdfs:label goldbook:09336 "inelastic scattering cross section")
AnnotationAssertion(dcterms:description goldbook:09336 "Cross section for inelastic scattering by an electron traversing a material.")
Declaration(Class(goldbook:09337))
AnnotationAssertion(rdfs:label goldbook:09337 "initial energy state")
AnnotationAssertion(dcterms:description goldbook:09337 "Core-hole excited state of an atom prior to Auger transition or to X-ray emission.")
Declaration(Class(goldbook:09338))
AnnotationAssertion(rdfs:label goldbook:09338 "initial energy state")
AnnotationAssertion(dcterms:description goldbook:09338 "Ground state of an atom prior to photoelectron emission.")
Declaration(Class(goldbook:09339))
AnnotationAssertion(rdfs:label goldbook:09339 "initial-state Auger parameter")
AnnotationAssertion(dcterms:description goldbook:09339 "\\(\\beta = 3E_{\\rm{B}} + E_{\\rm{K}}\\), where \\(E_{\\rm{B}}\\) and \\(E_{\\rm{K}}\\) are, respectively, the binding energy of a photoelectron peak and the Fermi level referenced (see Fermi level referencing) kinetic energy of an Auger electron peak, each involving the same initial core level of the same element.")
Declaration(Class(goldbook:09340))
AnnotationAssertion(rdfs:label goldbook:09340 "interatomic Auger process")
AnnotationAssertion(dcterms:description goldbook:09340 "Auger transition in which at least one of the final electron vacancies is localized in valence levels or molecular orbitals of atoms adjacent to the atom in which the initial vacancy occurred.")
Declaration(Class(goldbook:09341))
AnnotationAssertion(rdfs:label goldbook:09341 "interface core-level shift")
AnnotationAssertion(dcterms:description goldbook:09341 "Energy shift observed in core-level photoelectron spectroscopy arising from the changed bonding and/or from the displacements of atoms from their bulk positions near an interface between two materials.")
Declaration(Class(goldbook:09342))
AnnotationAssertion(rdfs:label goldbook:09342 "intrinsic plasmon")
AnnotationAssertion(dcterms:description goldbook:09342 "Plasmon excited at the same time as the excitation of a core-level photoelectron or an Auger electron associated with the same locality as the excitation of the photoelectron or Auger electron.")
Declaration(Class(goldbook:09343))
AnnotationAssertion(rdfs:label goldbook:09343 "modified Auger parameter")
AnnotationAssertion(dcterms:description goldbook:09343 "Sum of the Fermi level referenced (see Fermi level referencing) kinetic energy of a narrow Auger electron peak in the spectrum and the binding energy of the most intense photoelectron peak from the same element.")
Declaration(Class(goldbook:09344))
AnnotationAssertion(rdfs:label goldbook:09344 "pass energy")
AnnotationAssertion(dcterms:description goldbook:09344 "Mean kinetic energy of detected particles in the energy-dispersive portion of an electron energy analyser.")
Declaration(Class(goldbook:09345))
AnnotationAssertion(rdfs:label goldbook:09345 "photoelectric work function")
AnnotationAssertion(dcterms:description goldbook:09345 "Minimum photon energy required to liberate an electron from the surface of a conducting solid by absorption of that photon.")
Declaration(Class(goldbook:09346))
AnnotationAssertion(rdfs:label goldbook:09346 "photoelectron X-ray satellite peaks")
AnnotationAssertion(dcterms:description goldbook:09346 "Photoelectron peaks in a spectrum resulting from photoemission induced by characteristic minor X-ray lines associated with the X-ray spectrum of the anode material.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09346 "satellite peaks")
Declaration(Class(goldbook:09347))
AnnotationAssertion(rdfs:label goldbook:09347 "photoelectron X-ray satellite subtraction")
AnnotationAssertion(dcterms:description goldbook:09347 "Removal of photoelectron X-ray satellite peaks from a spectrum.")
Declaration(Class(goldbook:09348))
AnnotationAssertion(rdfs:label goldbook:09348 "photoemission")
AnnotationAssertion(dcterms:description goldbook:09348 "Emission of electrons from atoms or molecules caused by the photoelectric effect.")
Declaration(Class(goldbook:09349))
AnnotationAssertion(rdfs:label goldbook:09349 "pure-element relative sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09349 "In electron spectroscopy, coefficient, proportional to the intensity measured for a pure sample of an element, by which the measured intensity for that element is divided in calculations to yield the atomic concentration or atomic fraction of the element present in the sample.")
Declaration(Class(goldbook:09350))
AnnotationAssertion(rdfs:label goldbook:09350 "relaxation energy")
AnnotationAssertion(dcterms:description goldbook:09350 "Energy associated with intra-atomic or extra-atomic electronic readjustment to the removal of an atomic electron, so as to minimize the energy of the final state of the system.")
Declaration(Class(goldbook:09352))
AnnotationAssertion(rdfs:label goldbook:09352 "selected-area aperture")
AnnotationAssertion(dcterms:description goldbook:09352 "Aperture in the electron or ion optical system restricting the detected signal to a small area of the sample surface.")
Declaration(Class(goldbook:09353))
AnnotationAssertion(rdfs:label goldbook:09353 "shakeoff")
AnnotationAssertion(dcterms:description goldbook:09353 "Multi-electron process in which two or more electrons are emitted, partitioning between them the excess kinetic energy.")
Declaration(Class(goldbook:09354))
AnnotationAssertion(rdfs:label goldbook:09354 "shakeup")
AnnotationAssertion(dcterms:description goldbook:09354 "Multi-electron process in which an atom is left in an excited state following a photoionization or Auger electron process, so that the outgoing electron has a characteristic kinetic energy slightly less than that of the parent photoelectron.")
Declaration(Class(goldbook:09355))
AnnotationAssertion(rdfs:label goldbook:09355 "Shirley background")
AnnotationAssertion(dcterms:description goldbook:09355 "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, background calculated to fit the measured spectrum at points at greater and lesser kinetic energy than the peak or peaks of interest, such that the background contribution at a given kinetic energy is in a fixed proportion to the total peak area above that background for greater kinetic energies.")
Declaration(Class(goldbook:09356))
AnnotationAssertion(rdfs:label goldbook:09356 "spectator hole")
AnnotationAssertion(dcterms:description goldbook:09356 "Electronic configuration of an atom containing an electronic vacancy that can be present during processes, such as Auger electron and X-ray photoelectron emission, but is not created or destroyed in the process.")
Declaration(Class(goldbook:09357))
AnnotationAssertion(rdfs:label goldbook:09357 "sub-shell photoionization cross section")
AnnotationAssertion(dcterms:description goldbook:09357 "Cross section for an incident photon interacting with a material to produce one or more photoelectrons from a given sub-shell.")
Declaration(Class(goldbook:09358))
AnnotationAssertion(rdfs:label goldbook:09358 "surface core-level shift")
AnnotationAssertion(dcterms:description goldbook:09358 "Energy shift observed in core-level photoelectron spectroscopy arising from the reduced coordination of the surface or near-surface atoms compared to bulk atoms.")
Declaration(Class(goldbook:09359))
AnnotationAssertion(rdfs:label goldbook:09359 "total secondary-electron yield")
AnnotationAssertion(dcterms:description goldbook:09359 "Total number of electrons emitted from a sample divided by the total number of electrons incident at a given energy and angle of incidence. \\(\\sigma = \\delta + \\eta\\), where \\(\\delta\\) is the secondary-electron yield and \\(\\eta\\) is the backscattering coefficient.")
Declaration(Class(goldbook:09360))
AnnotationAssertion(rdfs:label goldbook:09360 "Tougaard background")
AnnotationAssertion(dcterms:description goldbook:09360 "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, intensity distribution of the background due to inelastic scattering obtained from the differential inelastic scattering cross section with respect to energy loss and the three-dimensional distribution of the emitting atoms in the surface region.")
Declaration(Class(goldbook:09361))
AnnotationAssertion(rdfs:label goldbook:09361 "vacuum level referencing")
AnnotationAssertion(dcterms:description goldbook:09361 "Method of establishing the kinetic energy scale in which the zero point corresponds to an electron at rest at the vacuum level.")
Declaration(Class(goldbook:09362))
AnnotationAssertion(rdfs:label goldbook:09362 "valence-band spectrum")
AnnotationAssertion(dcterms:description goldbook:09362 "X-ray photoelectron energy distribution arising from the excitation of electrons from the valence band of the sample material.")
Declaration(Class(goldbook:09363))
AnnotationAssertion(rdfs:label goldbook:09363 "aligned incidence spectrum")
AnnotationAssertion(dcterms:description goldbook:09363 "Backscattering spectrum recorded with the analysing beam aligned with crystallographic axes or planes of the sample that produce channelling.")
Declaration(Class(goldbook:09364))
AnnotationAssertion(rdfs:label goldbook:09364 "backscattering spectrum")
AnnotationAssertion(dcterms:description goldbook:09364 "Plot of backscattering yield versus backscattering energy.")
Declaration(Class(goldbook:09365))
AnnotationAssertion(rdfs:label goldbook:09365 "beam chopper")
AnnotationAssertion(dcterms:description goldbook:09365 "Electrostatic or electromagnetic device used to generate pulses of ions from a continuous ion beam.")
Declaration(Class(goldbook:09366))
AnnotationAssertion(rdfs:label goldbook:09366 "binary elastic scattering peak")
AnnotationAssertion(dcterms:description goldbook:09366 "In ion-scattering spectrometry, increase in the spectrometer detection system response above the background signal, which can be attributed to the binary elastic scattering of an incident ion by a surface atom of a particular mass.")
Declaration(Class(goldbook:09367))
AnnotationAssertion(rdfs:label goldbook:09367 "blocking geometry")
AnnotationAssertion(dcterms:description goldbook:09367 "Experimental arrangement wherein the atom rows or planes of a single-crystal target are aligned parallel to a vector from the sample to the detector.")
Declaration(Class(goldbook:09368))
AnnotationAssertion(rdfs:label goldbook:09368 "electronic stopping cross section")
AnnotationAssertion(dcterms:description goldbook:09368 "Stopping cross section arising from energy transfer to the electrons of the sample.")
Declaration(Class(goldbook:09369))
AnnotationAssertion(rdfs:label goldbook:09369 "energy edge")
AnnotationAssertion(dcterms:description goldbook:09369 "Values of the backscattering energy for an element, or for an isotope, that is located at the surface of a sample.")
Declaration(Class(goldbook:09370))
AnnotationAssertion(rdfs:label goldbook:09370 "surface approximation energy")
AnnotationAssertion(dcterms:description goldbook:09370 "Simplification of calculations involving the energy of an ion passing through a solid sample, where the energy of the ion at the surface is used in place of a properly averaged energy.")
Declaration(Class(goldbook:09371))
AnnotationAssertion(rdfs:label goldbook:09371 "enhanced elastic cross section")
AnnotationAssertion(dcterms:description goldbook:09371 "Cross section of an atom for elastic scattering that is greater than the Rutherford cross section due to partial penetration of a nucleus in the sample by the incident particle.")
Declaration(Class(goldbook:09372))
AnnotationAssertion(rdfs:label goldbook:09372 "experimental scattered-ion intensity")
AnnotationAssertion(dcterms:description goldbook:09372 "Measured response of the energy filtering and detection system as a consequence of bombarding the sample material with an ion beam, usually presented as the ordinate of an ion-scattering spectrum.")
Declaration(Class(goldbook:09373))
AnnotationAssertion(rdfs:label goldbook:09373 "ion-scattering spectrum")
AnnotationAssertion(dcterms:description goldbook:09373 "Plot of the intensities of ions, scattered from a sample, as a function of the scattered-ion energy divided by the incident-ion energy.")
Declaration(Class(goldbook:09374))
AnnotationAssertion(rdfs:label goldbook:09374 "kinematic factor")
AnnotationAssertion(dcterms:description goldbook:09374 "Particle energy after an elastic collision divided by the energy before the collision, in the laboratory frame of reference.")
Declaration(Class(goldbook:09375))
AnnotationAssertion(rdfs:label goldbook:09375 "nuclear reaction cross section")
AnnotationAssertion(dcterms:description goldbook:09375 "Cross section at a given beam energy and emission direction of the detected product for a particular nuclear reaction per atom.")
Declaration(Class(goldbook:09376))
AnnotationAssertion(rdfs:label goldbook:09376 "nuclear stopping cross section")
AnnotationAssertion(dcterms:description goldbook:09376 "Stopping cross section arising from energy transfer to atomic nuclei of the sample.")
Declaration(Class(goldbook:09377))
AnnotationAssertion(rdfs:label goldbook:09377 "pileup")
AnnotationAssertion(dcterms:description goldbook:09377 "Counts in a backscattering spectrum arising from two or more separate events that occur so closely in time that the signals are not resolved by the detection system and cause counts to be recorded in erroneous channels.")
Declaration(Class(goldbook:09378))
AnnotationAssertion(rdfs:label goldbook:09378 "probe ion")
AnnotationAssertion(dcterms:description goldbook:09378 "Ion intentionally produced by an ion source and directed onto the sample surface at a known angle of incidence and a known energy.")
Declaration(Class(goldbook:09379))
AnnotationAssertion(rdfs:label goldbook:09379 "random incidence spectrum")
AnnotationAssertion(dcterms:description goldbook:09379 "Backscattering spectrum recorded with the analysing beam incident on the sample in a direction such as to produce no channelling.")
Declaration(Class(goldbook:09380))
AnnotationAssertion(rdfs:label goldbook:09380 "resonance reaction")
AnnotationAssertion(dcterms:description goldbook:09380 "Nuclear reaction that has a narrow peak in the nuclear reaction cross section as a function of energy, the nuclear reaction cross section at the peak being so much larger than the nuclear reaction cross sections at adjacent energies on either side of the peak that essentially all the particles detected from the reaction are due to the peak.")
Declaration(Class(goldbook:09381))
AnnotationAssertion(rdfs:label goldbook:09381 "Rutherford cross section")
AnnotationAssertion(dcterms:description goldbook:09381 "Elastic scattering cross section calculated using classical mechanics and a Coulomb potential.")
Declaration(Class(goldbook:09382))
AnnotationAssertion(rdfs:label goldbook:09382 "scattered-ion energy")
AnnotationAssertion(dcterms:description goldbook:09382 "Kinetic energy of a primary ion after a collision.")
Declaration(Class(goldbook:09383))
AnnotationAssertion(rdfs:label goldbook:09383 "scattered-ion energy ratio")
AnnotationAssertion(dcterms:description goldbook:09383 "Scattered-ion energy divided by energy of the incident probe ion prior to a collision.")
Declaration(Class(goldbook:09384))
AnnotationAssertion(rdfs:label goldbook:09384 "screening")
AnnotationAssertion(dcterms:description goldbook:09384 "Response arising from electrons in an atom causing an apparent reduction in the coulomb potential of the nucleus.")
Declaration(Class(goldbook:09385))
AnnotationAssertion(rdfs:label goldbook:09385 "screening function")
AnnotationAssertion(dcterms:description goldbook:09385 "Factor by which the Rutherford cross section is reduced as a result of screening in a given experiment.")
Declaration(Class(goldbook:09386))
AnnotationAssertion(rdfs:label goldbook:09386 "stopping cross section factor")
AnnotationAssertion(dcterms:description goldbook:09386 "Energy loss of a particle scattered at a given depth in the sample, and detected at a given angle, by the product of the atomic density of the sample atoms and the depth of scattering.")
Declaration(Class(goldbook:09387))
AnnotationAssertion(rdfs:label goldbook:09387 "stopping cross section")
AnnotationAssertion(dcterms:description goldbook:09387 "Rate of energy loss of a particle with distance along its trajectory in a sample divided by the atomic density of sample atoms for a sample of infinitesimal thickness.")
Declaration(Class(goldbook:09388))
AnnotationAssertion(rdfs:label goldbook:09388 "swift ion")
AnnotationAssertion(dcterms:description goldbook:09388 "Ion moving with a velocity exceeding the Bohr speed of \\(c/137\\), where \\(c\\) is the velocity of light.")
Declaration(Class(goldbook:09389))
AnnotationAssertion(rdfs:label goldbook:09389 "system resolution")
AnnotationAssertion(dcterms:description goldbook:09389 "Energy resolution or depth resolution measured in a backscattering spectrum for a monoenergetic incident-ion beam.")
Declaration(Class(goldbook:09390))
AnnotationAssertion(rdfs:label goldbook:09390 "theoretical scattered-ion intensity")
AnnotationAssertion(dcterms:description goldbook:09390 "Calculated intensity for probe ions scattered into a specified solid angle at a given direction.")
Declaration(Class(goldbook:09391))
AnnotationAssertion(rdfs:label goldbook:09391 "thin target")
AnnotationAssertion(dcterms:description goldbook:09391 "In energetic-ion analysis and Rutherford backscattering spectrometry, sample whose thickness is sufficiently small that the variation in energy of particles backscattered from atoms of each constitutive element is small with respect to the system resolution.")
Declaration(Class(goldbook:09392))
AnnotationAssertion(rdfs:label goldbook:09392 "analyser blanking")
AnnotationAssertion(dcterms:description goldbook:09392 "Action to prevent secondary ions from travelling through the mass spectrometer and being detected.")
Declaration(Class(goldbook:09393))
AnnotationAssertion(rdfs:label goldbook:09393 "beam bunching")
AnnotationAssertion(dcterms:description goldbook:09393 "Reduction in the spread of arrival times of an ion pulse by reduction in the speed of the leading ions or acceleration of those at the trailing edge of the pulse.")
Declaration(Class(goldbook:09394))
AnnotationAssertion(rdfs:label goldbook:09394 "buncher")
AnnotationAssertion(dcterms:description goldbook:09394 "Device to shorten the time length of a pulse of ions so that they arrive at a point over a reduced time interval.")
Declaration(Class(goldbook:09395))
AnnotationAssertion(rdfs:label goldbook:09395 "dilute limit")
AnnotationAssertion(dcterms:description goldbook:09395 "Atomic fraction or concentration of impurity species in a homogeneous matrix below which the secondary-ion mass spectrometry can safely be assumed to be linear with composition.")
Declaration(Class(goldbook:09396))
AnnotationAssertion(rdfs:label goldbook:09396 "disappearance cross section")
AnnotationAssertion(dcterms:description goldbook:09396 "Cross section for the loss of intensity of an ion signal observed as a result of the bombardment by primary ions.")
Declaration(Class(goldbook:09397))
AnnotationAssertion(rdfs:label goldbook:09397 "dual-beam profiling")
AnnotationAssertion(dcterms:description goldbook:09397 "In secondary-ion mass spectrometry, sputter depth profiling involving two ion guns.")
Declaration(Class(goldbook:09398))
AnnotationAssertion(rdfs:label goldbook:09398 "extraction field")
AnnotationAssertion(dcterms:description goldbook:09398 "In secondary-ion mass spectrometry, electric field above a sample, operational during ion emission from the sample.")
Declaration(Class(goldbook:09399))
AnnotationAssertion(rdfs:label goldbook:09399 "extractor voltage")
AnnotationAssertion(dcterms:description goldbook:09399 "Electric potential, referenced to the sample, of the electrode defining the field above the sample and used to facilitate introduction of emitted ions into the mass spectrometer.")
Declaration(Class(goldbook:09400))
AnnotationAssertion(rdfs:label goldbook:09400 "fast-atom bombardment secondary ion mass spectrometry")
AnnotationAssertion(dcterms:description goldbook:09400 "Secondary ion mass spectrometry in which the primary-ion beam is replaced by a fast-atom beam.")
Declaration(Class(goldbook:09401))
AnnotationAssertion(rdfs:label goldbook:09401 "fractional ion yield")
AnnotationAssertion(dcterms:description goldbook:09401 "Number of ions of a particular species sputtered from a sample divided by number of particles of that species sputtered from that sample.")
Declaration(Class(goldbook:09402))
AnnotationAssertion(rdfs:label goldbook:09402 "g index")
AnnotationAssertion(dcterms:description goldbook:09402 "Power for the ratio of mass intensities in two mass spectra measured for two different primary ion conditions, used to generate the G-SIMS spectrum.")
Declaration(Class(goldbook:09403))
AnnotationAssertion(rdfs:label goldbook:09403 "G-SIMS with fragmentation pathway mapping")
AnnotationAssertion(dcterms:description goldbook:09403 "Development of G-SIMS in which the g index is varied in order to deduce the linkages between product ions and precursor ion.")
Declaration(Class(goldbook:09404))
AnnotationAssertion(rdfs:label goldbook:09404 "ion beam ratio")
AnnotationAssertion(dcterms:description goldbook:09404 "Intensity of analyte ion divided by intensity of matrix ion, both corrected for isotopic abundance.")
Declaration(Class(goldbook:09405))
AnnotationAssertion(rdfs:label goldbook:09405 "liquid-metal ion gun")
AnnotationAssertion(dcterms:description goldbook:09405 "Ion gun utilizing a liquid-metal Taylor cone as the source of the primary ions.")
Declaration(Class(goldbook:09406))
AnnotationAssertion(rdfs:label goldbook:09406 "mass accuracy")
AnnotationAssertion(dcterms:description goldbook:09406 "Measured mass minus reference value for that mass.")
Declaration(Class(goldbook:09407))
AnnotationAssertion(rdfs:label goldbook:09407 "metastable background")
AnnotationAssertion(dcterms:description goldbook:09407 "Intensity in a mass spectrum arising from ions that spontaneously fragment between emission and detection.")
Declaration(Class(goldbook:09408))
AnnotationAssertion(rdfs:label goldbook:09408 "molecular fragment")
AnnotationAssertion(dcterms:description goldbook:09408 "Ion or neutral particle that was part of a larger molecular structure and contains information about that structure.")
Declaration(Class(goldbook:09409))
AnnotationAssertion(rdfs:label goldbook:09409 "molecular image")
AnnotationAssertion(dcterms:description goldbook:09409 "Image of a surface formed from ions characteristic of a particular molecule.")
Declaration(Class(goldbook:09410))
AnnotationAssertion(rdfs:label goldbook:09410 "negative-ion yield")
AnnotationAssertion(dcterms:description goldbook:09410 "Number of negatively-charged secondary ions sputtered from a sample divided by total number of incident primary particles.")
Declaration(Class(goldbook:09411))
AnnotationAssertion(rdfs:label goldbook:09411 "partial ion yield")
AnnotationAssertion(dcterms:description goldbook:09411 "Number of ions of a particular species sputtered from a sample divided by the number of incident particles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:09411 "partial ion sputtering yield")
Declaration(Class(goldbook:09412))
AnnotationAssertion(rdfs:label goldbook:09412 "polyatomic fragment")
AnnotationAssertion(dcterms:description goldbook:09412 "Ion or neutral particle composed of three or more atoms.")
Declaration(Class(goldbook:09413))
AnnotationAssertion(rdfs:label goldbook:09413 "positive-ion yield")
AnnotationAssertion(dcterms:description goldbook:09413 "Number of positively-charged secondary ions sputtered from a sample divided by the total number of incident primary particles.")
Declaration(Class(goldbook:09414))
AnnotationAssertion(rdfs:label goldbook:09414 "primary ion")
AnnotationAssertion(dcterms:description goldbook:09414 "Ion extracted from a source and directed at a sample.")
Declaration(Class(goldbook:09415))
AnnotationAssertion(rdfs:label goldbook:09415 "pulse rate")
AnnotationAssertion(dcterms:description goldbook:09415 "Number of ion pulse cycles per second in secondary ion mass spectrometry.")
Declaration(Class(goldbook:09416))
AnnotationAssertion(rdfs:label goldbook:09416 "pulse width")
AnnotationAssertion(dcterms:description goldbook:09416 "Full width at half maximum of the time distribution of the pulse of ions generated by a beam chopper and, optionally, the use of beam bunching in secondary ion mass spectrometry.")
Declaration(Class(goldbook:09417))
AnnotationAssertion(rdfs:label goldbook:09417 "pulsed extraction field")
AnnotationAssertion(dcterms:description goldbook:09417 "Extraction field around the sample that is pulsed to the working value for extracting ions for the time necessary for operation of a time-of-flight mass spectrometer, but is otherwise at a low value.")
Declaration(Class(goldbook:09418))
AnnotationAssertion(rdfs:label goldbook:09418 "reflector voltage")
AnnotationAssertion(dcterms:description goldbook:09418 "Electric potential set on the reflector electrode of a reflectron mass spectrometer with the zero referenced, such that an ion emitted from the sample with an energy numerically equal to the reflector voltage would just be on the point of reflection or transmission by the reflector electrode.")
Declaration(Class(goldbook:09419))
AnnotationAssertion(rdfs:label goldbook:09419 "relative isotopic sensitivity factor")
AnnotationAssertion(dcterms:description goldbook:09419 "In dynamic secondary-ion mass spectrometry, coefficient for an element by which the measured intensity for an isotope of that element, divided by the measured intensity for a matrix ion, is multiplied to yield the atomic concentration of that isotope of the element present in the sample.")
Declaration(Class(goldbook:09420))
AnnotationAssertion(rdfs:label goldbook:09420 "relative mass accuracy")
AnnotationAssertion(dcterms:description goldbook:09420 "Mass accuracy divided by reference mass.")
Declaration(Class(goldbook:09422))
AnnotationAssertion(rdfs:label goldbook:09422 "secondary ion")
AnnotationAssertion(dcterms:description goldbook:09422 "Ion ejected from a sample surface as a result of energy and momentum transfer from a primary ion.")
Declaration(Class(goldbook:09424))
AnnotationAssertion(rdfs:label goldbook:09424 "secondary-ion angular distribution")
AnnotationAssertion(dcterms:description goldbook:09424 "Number of secondary ions as a function of angle of emission.")
Declaration(Class(goldbook:09425))
AnnotationAssertion(rdfs:label goldbook:09425 "secondary-ion energy distribution")
AnnotationAssertion(dcterms:description goldbook:09425 "Number of secondary ions as a function of kinetic energy at a specified collection angle.")
Declaration(Class(goldbook:09426))
AnnotationAssertion(rdfs:label goldbook:09426 "secondary-ion yield")
