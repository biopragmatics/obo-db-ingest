Declaration(Class(goldbook:10544))
AnnotationAssertion(rdfs:label goldbook:10544 "collagenous")
AnnotationAssertion(dcterms:description goldbook:10544 "Rich in the fibrous connective tissue protein, collagen.")
Declaration(Class(goldbook:10545))
AnnotationAssertion(rdfs:label goldbook:10545 "collembolan reproduction test")
AnnotationAssertion(dcterms:description goldbook:10545 "Procedure in which collembolans (small soil-inhabiting insects) are exposed to soil that has been treated with a test substance, and adult mortality and reproductive output are studied.")
Declaration(Class(goldbook:10546))
AnnotationAssertion(rdfs:label goldbook:10546 "coloboma")
