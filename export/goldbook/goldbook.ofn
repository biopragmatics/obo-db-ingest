AnnotationAssertion(rdfs:label goldbook:C01106 "<i>closo</i>-")
AnnotationAssertion(dcterms:description goldbook:C01106 "An affix used in names to denote a cage or closed structure, especially a boron skeleton that is a polyhedron having all triangular faces.")
AnnotationAssertion(rdfs:seeAlso goldbook:C01106 goldbook:C00770)
