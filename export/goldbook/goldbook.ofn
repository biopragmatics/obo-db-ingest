Declaration(Class(goldbook:FT07550))
AnnotationAssertion(rdfs:label goldbook:FT07550 "fractal dimension")
AnnotationAssertion(dcterms:description goldbook:FT07550 "Parameter that provides a mathematical description of the fractal structure of a polymer network, an aggregated particulate sol, or of the particles that comprise them.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:FT07550 "Hausdorff dimension")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:FT07550 "mass fractal dimension")
AnnotationAssertion(rdfs:comment goldbook:FT07550 "\\(m \\propto r^{d}\\) in which \\(m\\) is the mass contained within a radius, \\(r\\), measured from any site or bond within a fractal structure."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07550 "For a Euclidean object of constant density, \\(d = 3\\), but for a fractal object, \\(d"^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07550 "For the surface area of a fractal object, \\(s \\propto r^{d'}\\) in which \\(s\\) is the surface area contained within a radius, \\(r\\), measured from any site or bond and \\(d'\\) is termed the surface fractal dimension."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07550 goldbook:PT07510)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07550 goldbook:P04742)
AnnotationAssertion(mito:isMentionedBy goldbook:FT07550 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:FT07550 "current"^^xsd:string)
