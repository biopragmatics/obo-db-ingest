AnnotationAssertion(mito:isMentionedBy goldbook:16026 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16026 "current"^^xsd:string)
Declaration(Class(goldbook:16027))
AnnotationAssertion(rdfs:label goldbook:16027 "recommended exposure level")
AnnotationAssertion(dcterms:description goldbook:16027 "Highest allowable regulatory airborne concentration.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:16027 "REL")
AnnotationAssertion(rdfs:comment goldbook:16027 "This exposure concentration is not expected to injure workers. It may be expressed as a ceiling limit or as a time-weighted average (TWA)."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:16027 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:16027 "current"^^xsd:string)
Declaration(Class(goldbook:16028))
